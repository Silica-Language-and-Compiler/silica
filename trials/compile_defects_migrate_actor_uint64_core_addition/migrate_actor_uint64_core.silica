// migrate_actor_uint64_core  (OPEN compile defect: staged in
// compile_defects_migrate_actor_uint64_core_addition, see README.md)
//
// Spec §15.1.2 (Actor Pinning Policy) and §15.1.2.4: migrate_actor(actor_ref, target_core: uint64)
// -> :ok | :invalid_target | :actor_not_found | :migration_blocked. The core is a uint64.
// Found in project BEES triage (SD-19, repro bees_triage/sd19u).
// Today (the stable compiler used for the BEES triage, Mac, 2026-10-23): rejected with E2003 ("type
// mismatch: core") at the uint64 core argument; the type checker accepts only an int64 core.
// The same program with `core: int64` compiles and prints the expected lines below.
// The program migrates an idle actor to core 1 (present on every hosted target and on the
// two-core ESP32-S3), then casts it -1; the actor prints "done" and ends main's wait_for_exit with
// cast_exit(0).
// Expected:
//   ok
//   done
//   0

fn idle(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: boolean <- case msg == 0 - 1 of {
            true -> { println("done"); cast_exit(0) };
            false -> true
        }
    produces pure (:no_reply, state) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- start_reporter();
        a: actor_ref <- spawn(0, idle, stack_policy(0, :keep_last_message));
        core: uint64 <- 1;
        m: atom <- migrate_actor(a, core);
        _: atom <- println(case m == :ok of { true -> "ok"; false -> "not ok" });
        stop: int64 <- 0 - 1;
        _: boolean <- cast(a, stop impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces pure code end
}

fn region_dump_limit() -> int64 {
    0
}

// One line per report; any failure ends main's wait_for_exit with cast_exit(70).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println("failure report");
        _: boolean <- cast_exit(70)
    produces
        pure (:no_reply, state + 1)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
