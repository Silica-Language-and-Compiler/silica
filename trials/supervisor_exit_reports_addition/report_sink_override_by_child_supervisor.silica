// Spec §15.4.10.5: a child supervisor inherits its supervisor's sink "unless it names its own". The
// root starts :inner2 from its init list; main names sink1 for the root and restarts inner2 with
// :restart_child, so the replacement inherits sink1, then names sink2 for that replacement (through
// the reference :get_child gives). inner2 allows no restart (initial state 2,
// ReportInnerSup.silica), so when its worker :gw2 fails the exit is handled with no restart and
// inner2 breaches its restart intensity (§15.4.13.2): the report of gw2's exit (restarted false) goes
// to sink2 only, and inner2 ends with (:explicit, :restart_intensity_breach). The root restarts inner2
// (:permanent) and reports that exit to sink1 with child_id :inner2 and the breach reason. Each sink
// tells a counter actor after its one report; the counter ends main's wait after both. The two sinks
// print independently, so the order is checked as a multiset.
//
// Expected output (multiset):
//   sink set
//   inner2 restarted
//   sink2 set
//   sink2: report: child=gw2 restarted=false same_ref=true reason=explicit boom
//   sink1: report: child=inner2 restarted=true same_ref=false reason=explicit restart_intensity_breach
//   done
//   0

use Supervisor;
use ReportInnerSup;

impl ReportOverrideRootSup for Supervisor;

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 10000000000 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :inner2, agent_type: :supervisor, initial_state: 2, behavior: ReportInnerSup@ReportInnerSup_child_start, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

// The failure_reason of a report, spelled out (spec §15.4.11.2: an inline sum type).
fn reason_text(fr: :normal | :language_error | :memory_fault | (:explicit, atom) | :noproc | :unknown) -> string {
    case fr of {
        :normal -> "normal";
        :language_error -> "language_error";
        :memory_fault -> "memory_fault";
        :noproc -> "noproc";
        :unknown -> "unknown";
        (:explicit, a: atom) -> case a of {
            :boom -> "explicit boom";
            :bang -> "explicit bang";
            :done -> "explicit done";
            :restart_intensity_breach -> "explicit restart_intensity_breach";
            _: atom -> "explicit other"
        }
    }
}

fn child_text(id: atom) -> string {
    case id of {
        :w -> "w";
        :w1 -> "w1";
        :w2 -> "w2";
        :gw1 -> "gw1";
        :gw2 -> "gw2";
        :inner1 -> "inner1";
        :inner2 -> "inner2";
        _: atom -> "?"
    }
}

// The report sink (spec §15.4.10.5): a cast-only actor whose message is the exit_report record,
// spelled as the spec gives it. One line per report, then a cast to the counter actor its state
// names.
fn sink1(r: { child: actor_ref, child_id: atom, failure_reason: :normal | :language_error | :memory_fault | (:explicit, atom) | :noproc | :unknown, restarted: boolean, new_child: actor_ref }, state: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency, device_io]
        same: boolean <- r.new_child == r.child;
        print("sink1: report: child=");
        print(child_text(r.child_id));
        print(" restarted=");
        print_boolean(r.restarted);
        print(" same_ref=");
        print_boolean(same);
        print(" reason=");
        println(reason_text(r.failure_reason));
        _: boolean <- cast(state, 1 impl ActorMessage {})
    produces pure (:no_reply, state) end
}

// A second sink, the one inner2 names for itself.
fn sink2(r: { child: actor_ref, child_id: atom, failure_reason: :normal | :language_error | :memory_fault | (:explicit, atom) | :noproc | :unknown, restarted: boolean, new_child: actor_ref }, state: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency, device_io]
        same: boolean <- r.new_child == r.child;
        print("sink2: report: child=");
        print(child_text(r.child_id));
        print(" restarted=");
        print_boolean(r.restarted);
        print(" same_ref=");
        print_boolean(same);
        print(" reason=");
        println(reason_text(r.failure_reason));
        _: boolean <- cast(state, 1 impl ActorMessage {})
    produces pure (:no_reply, state) end
}

// Counts the sinks' reports; the second ends main's wait with cast_exit(0). The sinks reach it
// through their state (its reference), not a registered name.
fn counter(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        left: int64 <- state - msg;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces pure (:no_reply, left) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter(0);
        c: actor_ref <- spawn(2, counter, stack_policy(0, :keep_last_message));
        s1: actor_ref <- spawn(c, sink1, stack_policy(0, :keep_last_message));
        s2: actor_ref <- spawn(c, sink2, stack_policy(0, :keep_last_message));
        rt: supervisor_ref <- spawn_registered_supervisor(ReportOverrideRootSup, 0, :root, stack_policy(0, :keep_last_message));
        set: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(rt, { op: :set_report_sink, sink: s1 } impl SupervisorMessage {});
        _: atom <- case set.status of {
            :sink_set -> println("sink set");
            _: atom -> println("sink NOT set")
        };
        rs: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(rt, { op: :restart_child, id: :inner2 } impl SupervisorMessage {});
        _: atom <- case rs.tag of {
            :child_started -> println("inner2 restarted");
            _: atom -> println("inner2 restarted FAILED")
        };
        inner2: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(rt, { op: :get_child, id: :inner2 } impl SupervisorMessage {});
        set2: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(inner2.child_info.child, { op: :set_report_sink, sink: s2 } impl SupervisorMessage {});
        _: atom <- case set2.status of {
            :sink_set -> println("sink2 set");
            _: atom -> println("sink2 NOT set")
        };
        _: boolean <- cast_registered(:gw2, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        _: atom <- println("done")
    produces pure 0 end
}

fn region_dump_limit() -> int64 {
    0
}

// A FailureReporter (spec §15.4.13.4) that keeps every report to itself, so the output holds only
// main's and the sink's lines; without one the reports would go to standard error. Started with a
// positive count, it ends main's wait_for_exit() with cast_exit(0) after that many reports.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces pure (:no_reply, left) end
}

fn start_reporter(expected: int64) -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
