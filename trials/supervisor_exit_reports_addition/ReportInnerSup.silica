// Inner supervisor of the supervisor_exit_reports_addition trials (report_sink_inherited_by_child_supervisor,
// report_sink_override_by_child_supervisor): one :permanent cast-only worker, named :gw1 when the
// supervisor's initial state is 1 and :gw2 otherwise (two inner supervisors live under one root, and
// a child id is a registered name, spec §20.3.1), which fails with fail_self(:boom) on message 0.
// With initial state 2 the supervisor allows no restart (allowed_restart_count 0 within a frame,
// §15.4.13.2): its worker's first failure breaches the intensity and ends the supervisor itself with
// (:explicit, :restart_intensity_breach).

use Supervisor;

export ReportInnerSup_child_start/1;

impl ReportInnerSup for Supervisor;

// Cast-only worker: 0 ends it at once with (:explicit, :boom) (§15.1.2.3).
fn inner_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    case msg of {
        0 -> {
            sequence proc[concurrency]
                _: atom <- fail_self(:boom)
            produces pure (:no_reply, state) end
        };
        _: int64 -> (:no_reply, state + msg)
    }
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        allowed: int64 <- case initial_state of {
            2 -> 0;
            _: int64 -> 3
        };
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: allowed, restarts_time_frame: 10000000000 };
        id: atom <- case initial_state of {
            1 -> :gw1;
            _: int64 -> :gw2
        };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: id, agent_type: :worker, initial_state: 10, behavior: inner_worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn ReportInnerSup_child_start(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    init(initial_state)
}
