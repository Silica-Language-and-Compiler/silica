    LDR X3, [X0, #16]
    ADD X3, X3, #25
    BL Lw_copy
    LDR X9, [X0, #8]
    ADD X10, X0, #24
    CMP X9, X10
    B.EQ Lw_str_fix
    LDR X11, [X0, #16]
    ADD X11, X11, #1
    ADD X12, X6, #24
Lw_str_bytes:
    CBZ X11, Lw_str_fix
    LDRB W13, [X9], #1
    STRB W13, [X12], #1
    SUB X11, X11, #1
    B Lw_str_bytes
Lw_str_fix:
    MOV X9, X5
    BL L_str_forget
    ADD X9, X5, #24
    STR X9, [X6, #8]
    ORR X9, X5, #0x8000000000000000
    STR X9, [X0]
    MOV X0, X5
    RET X28
Lw_copy:
    MOV X27, X30
    ADD X7, X3, #7
    AND X7, X7, #0xfffffffffffffff8
    CBNZ X22, Lw_copy_heap
    ADD X8, X3, #15
    AND X8, X8, #0xfffffffffffffff0
    SUB X21, X21, X8
    MOV X5, X21
    ADD X9, X8, #48
    MOV X10, SP
    SUB X10, X10, X9
    MOV SP, X10
    MOV X6, X10
    ADD X11, X10, X8
    STP X0, X5, [X11]
    STP X1, X2, [X11, #16]
    STP X3, X8, [X11, #32]
    B Lw_copy_bytes
Lw_copy_heap:
    STP X0, X1, [SP, #-48]!
    STP X2, X3, [SP, #16]
    STR X7, [SP, #32]
    MOV X0, X7
    BL L_ev_region_alloc
    MOV X5, X0
    LDR X7, [SP, #32]
    LDP X2, X3, [SP, #16]
    LDP X0, X1, [SP], #48
    MOV X6, X5
    SUB SP, SP, #48
    MOV X11, SP
    STP X0, X5, [X11]
    STP X1, X2, [X11, #16]
    STP X3, XZR, [X11, #32]
Lw_copy_bytes:
    MOV X12, #0
Lw_copy_loop:
    CMP X12, X7
    B.HS Lw_copy_done
    LDR X13, [X0, X12]
    STR X13, [X6, X12]
    ADD X12, X12, #8
    B Lw_copy_loop
Lw_copy_done:
    RET X27
L_ev_region_alloc:
    B _silica_rt_region_alloc
L_stack_top:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    BL _silica_rt_tls_current_actor_get
    CBZ X0, 1f
    LDR X1, [X0, #272]
    CBZ X1, 1f
    LDR X2, [X0, #280]
    ADD X0, X1, X2
    B 2f
