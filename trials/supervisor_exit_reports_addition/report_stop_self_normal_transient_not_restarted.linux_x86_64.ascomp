    test r9, r9
    jz L_lph_new_scalar
    xor r13d, r13d
L_lph_new_agg:
    cmp r13, rcx
    jge L_lph_new_stored
    mov rax, QWORD PTR [rsi + r13]
    mov QWORD PTR [r11 + r13], rax
    add r13, 8
    jmp L_lph_new_agg
    jmp L_lph_new_stored
L_lph_new_scalar:
    cmp rcx, 8
    je L_lph_ns8
    cmp rcx, 4
    je L_lph_ns4
    cmp rcx, 2
    je L_lph_ns2
    mov BYTE PTR [r11], sil
    jmp L_lph_new_stored
L_lph_ns2:
    mov WORD PTR [r11], si
    jmp L_lph_new_stored
L_lph_ns4:
    mov DWORD PTR [r11], esi
    jmp L_lph_new_stored
L_lph_ns8:
    mov QWORD PTR [r11], rsi
L_lph_new_stored:
    test rdx, rdx
    jz L_lph_next_nil
    mov r10, QWORD PTR [rdx + 8]
    mov QWORD PTR [r14 + r8], r10
    jmp L_lph_alloc_handle
L_lph_next_nil:
    mov QWORD PTR [r14 + r8], 0
