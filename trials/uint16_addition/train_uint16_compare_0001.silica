// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(12 * 15 != 48);
                println("");
                _: atom <- print_boolean(1 % 34 < (31 + 30));
                println("");
                _: atom <- print_boolean(10 % 12 == 22 * 18);
                println("");
                _: atom <- print_boolean((49 + 42) > 25);
                println("");
                result: atom <- print_boolean((25 / 22) == (53 + 15))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
