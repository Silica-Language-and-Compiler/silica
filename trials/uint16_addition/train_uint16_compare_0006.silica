// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((19 / 40) <= 8 * 13);
                println("");
                _: atom <- print_boolean(19 / 40 != 17 % 41);
                println("");
                _: atom <- print_boolean(3 % 6 > (5 * 42));
                println("");
                _: atom <- print_boolean((25 + 50) >= 46);
                println("");
                result: atom <- print_boolean(57 / 10 < (18 + 55))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
