// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(58 / 3 < (25 + 21));
                println("");
                _: atom <- print_boolean(29 / 13 >= 56 * 48);
                println("");
                _: atom <- print_boolean((20 + 15) > (48 - 38));
                println("");
                result: atom <- print_boolean(8 != (24 - 22))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
