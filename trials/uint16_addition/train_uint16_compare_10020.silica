// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((23 + 13) >= 11);
                println("");
                _: atom <- print_boolean(53 == 44 % 11);
                println("");
                _: atom <- print_boolean(16 / 45 != (57 + 26));
                println("");
                _: atom <- print_boolean(26 / 7 >= (7 + 10));
                println("");
                result: atom <- print_boolean(5 / 51 != (41 + 5))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
