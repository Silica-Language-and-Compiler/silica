// chained print_uint16 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_uint16((21 % 42) + 21 / 58);
                println("");
                _: atom <- print_uint16((54 % 16 / (18 / 10)));
                println("");
                _: atom <- print_uint16(27 % 8 + 54 % 21);
                println("");
                result: atom <- print_uint16((57 * 33))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
