// uint16 arithmetic: 5 = 5
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            5
        });
        _: int64 <- wait_for_exit()
    produces
        pure 5
    end
}
