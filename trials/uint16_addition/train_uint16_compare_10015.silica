// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(50 * 40 == (13 + 11));
                println("");
                _: atom <- print_boolean(21 / 8 > 20 * 10);
                println("");
                _: atom <- print_boolean(58 % 20 != (35 % 32));
                println("");
                _: atom <- print_boolean((12 + 36) <= (14 + 55));
                println("");
                result: atom <- print_boolean(18 / 30 != 17 % 19)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
