// main returns boolean true and false; exit code 0
use trial_support_boolean;

fn main() -> boolean {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_boolean@start();
        _: boolean <- trial_support_boolean@run(fn() -> boolean {
            true and false
        });
        _: int64 <- wait_for_exit()
    produces
        pure false
    end
}
