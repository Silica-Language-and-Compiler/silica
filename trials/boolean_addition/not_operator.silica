// Unary `not` (spec §2.2.1 keyword list; §3.3.1 `unary_operator` includes logical `not`; §3.9 precedence 2,
// right associative) as an ordinary expression, here on the right of a `<-` binding. Until 2026-09-24 `not`
// was not a lexer keyword at all: every position outside a guard clause was E2002 "undefined identifier: not",
// E2005 or E1069, and guard clauses (`n: int64 if not is_even(n)`) failed the same way. It is now lexed as a
// keyword, parsed like `bnot` into a unary node, typed boolean -> boolean, and lowered as the boolean `eq`
// prim against `false`. Formerly compile_defects_not_operator_addition.
// Expected: prints "false", exit 0.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                flipped: boolean <- not true;
                _: atom <- print_boolean(flipped);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
