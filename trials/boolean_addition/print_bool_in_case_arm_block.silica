// print_boolean inside a case-arm block: the boolean rodata (L_pb_true / L_pb_false) and the
// L_pb_helper are emitted for a print_boolean anywhere in the module. atoms/boolean_rodata searched
// only let, call and prim nodes, so a print_boolean that sat in a case arm (kinds 3/7/8) left the
// labels undefined and the module did not assemble. Moved here from codegen_defects_addition when
// the defect was fixed (2026-09-19).
// Expected: true, exit 0.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- case 1 == 1 of {
                    true -> { _: atom <- print_boolean(true); println(""); :ok };
                    false -> :ok
                }
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
