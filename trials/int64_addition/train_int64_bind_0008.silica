// int64 bindings then expression; expect 0
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            step: int64 <- 49;
            count: int64 <- 35 / 31 + 11 * step;
            total: int64 <- 20;
            m: int64 <- count;
            m / count / (count + step) + total - total
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
