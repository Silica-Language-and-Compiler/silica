// chained print_int64 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_int64(30 - 11 + (41 + 2));
                println("");
                _: atom <- print_int64(49 % (30 % 12));
                println("");
                _: atom <- print_int64((34 + 5) % 31);
                println("");
                result: atom <- print_int64(5 / (35 * 36))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
