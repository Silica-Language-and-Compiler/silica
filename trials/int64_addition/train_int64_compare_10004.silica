// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(24 > 12);
                println("");
                _: atom <- print_boolean((43 - 8) == 57 * 59);
                println("");
                _: atom <- print_boolean((58 + 39) <= 33);
                println("");
                _: atom <- print_boolean((39 + 48) < 19);
                println("");
                result: atom <- print_boolean((21 - 19) <= 31 % 53)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
