// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((25 + 39) >= 38);
                println("");
                _: atom <- print_boolean(25 / 13 != 52 % 32);
                println("");
                _: atom <- print_boolean(51 * 12 <= 54 / 15);
                println("");
                _: atom <- print_boolean(60 % 24 < 48 % 7);
                println("");
                result: atom <- print_boolean(45 / 50 <= 49 % 8)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
