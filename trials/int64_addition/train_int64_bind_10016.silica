// int64 bindings then expression; expect 10
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            count: int64 <- 30 / 16 * (7 + 20);
            k: int64 <- count + count + (45 + 7);
            total: int64 <- (53 + k) / (k / count);
            step: int64 <- k - 43;
            10 + total - total + step - step
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
