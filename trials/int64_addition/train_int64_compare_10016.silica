// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(31 != 40 * 50);
                println("");
                _: atom <- print_boolean((36 + 40) >= (32 - 25));
                println("");
                _: atom <- print_boolean((0 * 18) != 38 / 54);
                println("");
                _: atom <- print_boolean(31 > (50 + 20));
                println("");
                result: atom <- print_boolean(34 * 41 > (11 + 36))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
