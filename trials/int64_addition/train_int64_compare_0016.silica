// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((28 + 42) > 55 * 12);
                println("");
                _: atom <- print_boolean(22 != 59);
                println("");
                _: atom <- print_boolean((42 * 9) >= 52);
                println("");
                _: atom <- print_boolean((36 + 47) <= (1 + 20));
                println("");
                result: atom <- print_boolean((56 + 51) <= 40 / 10)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
