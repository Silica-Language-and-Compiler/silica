// chained print_int64 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_int64(17 % (45 - 16));
                println("");
                _: atom <- print_int64(54 / 39);
                println("");
                _: atom <- print_int64(((41 + 3) * (29 / 54)));
                println("");
                result: atom <- print_int64(8)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
