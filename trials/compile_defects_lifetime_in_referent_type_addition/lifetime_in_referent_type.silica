// lifetime_in_referent_type  (OPEN compile defect: staged in
// compile_defects_lifetime_in_referent_type_addition, see README.md)
//
// Spec §12.1.4: lifetime names in a function signature are implicitly quantified per signature and
// instantiated at each call, consistently across the arguments and the result (decision Q10 a).
// count/1 below is written over L; main calls it with a ref whose lifetime is M. L := M must be
// instantiated everywhere L occurs, including inside the referent type
// (atom, int64, ref?(L, normal, rec)). Found in project BEES triage (SD-6, repro bees_triage/sd6).
// memory_region_addition/lifetime_parameter_name covers the top-level case (ref(L, normal, int64)
// against ref(L1, normal, int64)), which compiles; this trial is the nested case.
// Today (the stable compiler used for the BEES triage, Mac, 2026-10-23): rejected with E2003
// "type mismatch: cell" at the argument of count (the BEES repro's notes record the message
// "field has type ref?(M,normal,rec), expected ref?(L, normal, rec)"): the lifetime inside the
// referent type is still compared by name. Renaming M to L in main makes it compile and print
// the lines below.
// Expected: count reads the cell (:ok, 7, :none) back and returns 7.
//   7
//   0

fn count(root: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> int64 {
    sequence proc[mem(normal)]
        node: (atom, int64, ref?(L, normal, rec)) <- read_ref(root);
        (_: atom, v: int64, _: ref?(L, normal, rec)) <- node
    produces pure v end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        M: lifetime <- fresh_lifetime();
        r: region(M, normal) <- alloc_region(normal);
        cell: ref(M, normal, (atom, int64, ref?(M, normal, rec))) <- alloc_rec(r, (:ok, 7, :none));
        n: int64 <- count(cell);
        print_int64(n);
        println("")
    produces pure 0 end
}
