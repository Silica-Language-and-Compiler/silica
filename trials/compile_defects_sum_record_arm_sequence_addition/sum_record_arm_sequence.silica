// A case arm over a sum's record variant that opens a nested sequence block: the string field
// read inside the block is corrupted at run time (fault), while the same arm calling a helper
// function with the two bindings prints "3" and "yy" (transport_etf_list_sum, show_xy). Found
// 2026-11-05 deriving record variants for transport. Expected: 3, yy, 0.

fn show(w: (:a, int64) | { x: int64, y: string } | :none) -> atom {
    case w of {
        :none -> println("none");
        (:a, n: int64) -> print_int64(n);
        { x: wx, y: wy } -> {
            sequence proc[device_io]
                _: atom <- print_int64(wx);
                o: atom <- println(wy)
            produces
                pure o
            end
        }
    }
}

fn mk(n: int64) -> (:a, int64) | { x: int64, y: string } | :none {
    sequence
        r: { x: int64, y: string } <- { x: n, y: "yy" };
        sv: (:a, int64) | { x: int64, y: string } | :none <- r
    produces
        pure sv
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        v: (:a, int64) | { x: int64, y: string } | :none <- mk(3);
        _: atom <- show(v)
    produces
        pure 0
    end
}
