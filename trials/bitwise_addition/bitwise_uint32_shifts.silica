// shl / shr on uint32, with an int64 amount and with a uint32 amount computed from another uint32
// (`one shl (pin band 31)`, the GPIO mask idiom). Expected exit status 4.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            one: uint32 <- 1;
            pin: uint32 <- 46;
            top: uint32 <- one shl 31;
            back: uint32 <- top shr 31;
            x: uint32 <- 3758096384;
            mask: uint32 <- one shl (pin band 31);
            c1: int64 <- case top == 2147483648 of { true -> 1; false -> 0 };
            c2: int64 <- case back == 1 of { true -> 1; false -> 0 };
            c3: int64 <- case (x shr 29) == 7 of { true -> 1; false -> 0 };
            c4: int64 <- case mask == 16384 of { true -> 1; false -> 0 };
            c1 + c2 + c3 + c4
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
