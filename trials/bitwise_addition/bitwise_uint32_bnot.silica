// bnot on uint32, and a literal on the left of band taking the other operand's width
// (`1023 band status`). Expected exit status 3.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            z: uint32 <- 0;
            y: uint32 <- 4294967040;
            status: uint32 <- 7929856;
            nz: uint32 <- bnot z;
            ny: uint32 <- bnot y;
            queued: uint32 <- 1023 band (status shr 16);
            c1: int64 <- case nz == 4294967295 of { true -> 1; false -> 0 };
            c2: int64 <- case ny == 255 of { true -> 1; false -> 0 };
            c3: int64 <- case queued == 121 of { true -> 1; false -> 0 };
            c1 + c2 + c3
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
