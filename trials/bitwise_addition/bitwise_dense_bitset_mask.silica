use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            node_count: int64 <- 8;
            from: int64 <- 1;
            to: int64 <- 2;
            bit_index: int64 <- from * node_count + to;
            bit_offset: int64 <- bit_index % 64;
            one: uint64 <- 1;
            zero: uint64 <- 0;
            mask: uint64 <- one shl bit_offset;
            set_word: uint64 <- zero bor mask;
            present: uint64 <- (set_word band mask) shr bit_offset;
            cleared: uint64 <- set_word band (bnot mask);
            present + cleared
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
