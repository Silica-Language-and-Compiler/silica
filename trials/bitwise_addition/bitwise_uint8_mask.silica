// shl and bnot on uint8 stay within eight bits: 3 shl 7 is 128, bnot 2 is 253. Expected exit status 3.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: uint8 <- 3;
            b: uint8 <- 2;
            s: uint8 <- a shl 7;
            n: uint8 <- bnot b;
            high: uint8 <- n shr 4;
            c1: int64 <- case s == 128 of { true -> 1; false -> 0 };
            c2: int64 <- case n == 253 of { true -> 1; false -> 0 };
            c3: int64 <- case high == 15 of { true -> 1; false -> 0 };
            c1 + c2 + c3
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
