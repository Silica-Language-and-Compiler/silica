module dangerous_cast_worker_registered_legacy_add;

use dangerous_legacy_stub;
use trial_wait_int64;

fn result_sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn ffi_worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        sum: int64 <- dangerous_legacy_stub@add(2, msg);
        _: boolean <- cast(reply_to, sum impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                sink_ref: actor_ref <- spawn(0, result_sink, stack_policy(0, :keep_last_message));
                worker_ref: dangerous_actor_ref <- spawn_dangerous_registered(sink_ref, ffi_worker, :dangerous_legacy_worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast_dangerous_registered(:dangerous_legacy_worker, 2 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
