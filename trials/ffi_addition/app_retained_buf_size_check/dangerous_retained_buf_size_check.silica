module dangerous_retained_buf_size_check;

// Size check on alloc_buf_retained: a dangerous actor asks for a retained uint8 buffer whose byte size is
// far beyond any memory (2^47 + 1 bytes, from the message). The size check refuses it and ends THAT actor
// with (:explicit, :buf_invalid); the failure report goes to the registered reporter, which prints one line
// and ends main's wait_for_exit(). The process keeps running. The buffer is handed to C as in
// dangerous_retained_buf_keep_state_area (a retained buffer outside FFI is E2323), but the allocation
// fails first.
// Expected: "worker ended", "done", then status 0.

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_retain_keep"
fn keep_raw(data_ptr: uint8, data_len: uint64) -> int64;

fn region_dump_limit() -> int64 {
    0
}

fn ffi_worker(msg: int64, state: (region(L1, normal), int64)) -> (:no_reply, (region(L1, normal), int64)) {
    sequence proc[external_danger, mem(normal)]
        (r, n): (region(L1, normal), int64) <- state;
        bf: buf(L1, normal, uint8, msg) <- alloc_buf_retained(msg);
        _: atom <- write_buf(bf, 0, 1);
        _: int64 <- keep_raw(bf)
    produces
        pure (:no_reply, (r, n + 1))
    end
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        println("worker ended");
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        w: dangerous_actor_ref <- spawn_dangerous((r, 0), ffi_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(w, 140737488355329 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        println("done")
    produces
        pure 0
    end
}
