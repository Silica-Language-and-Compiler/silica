// A (:udp) loopback: two endpoints on 127.0.0.1, each bound to a port the system picks and told the
// other's port; a bare ETF datagram (:ping, 7) one way and (:pong, 8) back (design §5, §6.3).
module dangerous_udp_loopback;

use wire_etf;
use wireframe;
use carrier;
use dangerous_sockets;
use dangerous_udp_carrier;
use trial_wait_int64;

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn send_term(car: dangerous_actor_ref, v: (:ping, int64) | (:pong, int64)) -> boolean {
    sequence proc[mem(normal), concurrency]
        frame: string <- encode((:etf), v);
        segs: List[string, mem(normal)] <- wireframe@frame(frame, carrier@mtu((:udp)), carrier@boundaries((:udp)));
        seg: string <- first_segment(segs);
        sent: boolean <- cast(car, (:tx, seg, self()) impl ActorMessage {})
    produces
        pure sent
    end
}

fn show_term(v: (:ping, int64) | (:pong, int64)) -> atom {
    sequence
        o: atom <- case v of {
            (:ping, n: int64) -> {
                sequence proc[device_io]
                    _: atom <- print("ping ");
                    _: atom <- print_int64(n);
                    o2: atom <- println("")
                produces pure o2 end
            };
            (:pong, n: int64) -> {
                sequence proc[device_io]
                    _: atom <- print("pong ");
                    _: atom <- print_int64(n);
                    o2: atom <- println("")
                produces pure o2 end
            }
        }
    produces
        pure o
    end
}

// The receiving side: bound first; when it learns its port it starts the sender bound to another
// free port, aimed at this one. The sender's endpoint learns this side's port from the address, and
// this side learns the sender's port from the first datagram? No: UDP carries no peer in :rx, so
// the sender tells this side its port inside the ping payload (a plain int64 after the term).
fn server(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, port: int64 })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, port: int64 }) {
    case msg of {
        (:link_up, info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {});
                cli_car: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, peer_host: "", peer_port: 0 }, dangerous_udp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                cli: actor_ref <- spawn({ car: cli_car, rx: wireframe@fresh(carrier@boundaries((:udp))), port: 0 }, client, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(cli_car, (:open, cli, concat(concat("127.0.0.1:", substring(info, 5, length_bytes(info))), "@0")) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:rx, segment: string) -> {
            sequence proc[concurrency]
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), device_io, concurrency]
                            decoded: (:ok, (:ping, int64) | (:pong, int64)) | (:rejected, atom) <- decode((:etf), frame);
                            _: atom <- case decoded of {
                                (:ok, v: (:ping, int64) | (:pong, int64)) -> show_term(v);
                                (:rejected, why: atom) -> print_atom(why)
                            };
                            _: atom <- println("done");
                            _: boolean <- cast_exit(0)
                        produces pure r2 end
                    };
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why2)
                        produces pure state.rx end
                    }
                };
                _: boolean <- cast(state.car, (:credit, 1) impl ActorMessage {})
            produces
                pure (:no_reply, { car: state.car, rx: rx2, port: state.port })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// The sender: once bound it sends (:ping, 7) to the server, which prints it and ends the trial
// (UDP carries no reply address in this phase, so no pong comes back).
fn client(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, port: int64 })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, port: int64 }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence
                _: boolean <- send_term(state.car, (:ping, 7))
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                srv_car: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, peer_host: "", peer_port: 0 }, dangerous_udp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                srv: actor_ref <- spawn({ car: srv_car, rx: wireframe@fresh(carrier@boundaries((:udp))), port: 0 }, server, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(srv_car, (:open, srv, "127.0.0.1:1@0") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
