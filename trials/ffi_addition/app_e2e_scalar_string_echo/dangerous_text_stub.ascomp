.text
.global dangerous_text_stub_text_echo
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.extern _silica_text_echo
.extern _free
.extern _malloc


dangerous_text_stub_text_echo:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0

    SUB SP, SP, #32
    STR XZR, [SP, #8]
    STR XZR, [SP, #16]
    STR XZR, [SP, #24]
    MOV X0, #32
    BL _silica_rt_ffi_arena_bump
    STR X0, [SP, #0]
    MOV X8, X0
    MOV X16, X19
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o318|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    BL _silica_rt_ffi_string_in
    LDR X8, [SP, #0]
    SUB SP, SP, #80
    STP X0, X1, [SP, #0]
    STP X2, X3, [SP, #16]
    STP X4, X5, [SP, #32]
    STP X6, X7, [SP, #48]
    STR X8, [SP, #64]
    BL _silica_rt_ffi_guarded_enter
    BL _silica_rt_ffi_guarded_setjmp
    CBNZ X0, 1f
    LDR X8, [SP, #64]
    LDP X6, X7, [SP, #48]
    LDP X4, X5, [SP, #32]
    LDP X2, X3, [SP, #16]
    LDP X0, X1, [SP, #0]
    BL _silica_text_echo
    STR X0, [SP, #0]
    BL _silica_rt_ffi_guarded_exit
    LDR X0, [SP, #0]
    ADD SP, SP, #80
    B 2f
1:
    BL _silica_rt_ffi_guarded_fault_finish
2:
    LDR X0, [SP, #0]
    BL _silica_rt_ffi_string_out_and_free
    STR X0, [SP, #16]
    STR XZR, [SP, #0]
    LDR X0, [SP, #16]
    ADD SP, SP, #32


    MOV X20, X0
    MOV X0, X20

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #23
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

_silica_rt_ffi_string_in:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    MOV X19, X0
    CBZ X19, L_ffi_in_empty
    LDR X9, [X19]
    MOV X10, #-1
    CMP X9, X10
    B.NE L_ffi_in_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    B L_ffi_in_have_src
L_ffi_in_empty:
    MOV X21, #0
    MOV X22, #0
L_ffi_in_have_src:
    ADD X0, X22, #1
    BL _silica_rt_tls_current_actor_get
    CBZ X0, L_ffi_in_heap
    MOV X23, X0
    ADD X0, X22, #1
    BL _silica_rt_ffi_arena_bump
    CBZ X0, L_ffi_in_oom
    MOV X24, X0
    CBZ X22, L_ffi_in_nul_arena
    MOV X9, X24
    MOV X10, X21
    MOV X11, X22
L_ffi_in_cp_arena:
    LDRB W12, [X10], #1
    STRB W12, [X9], #1
    SUBS X11, X11, #1
    B.NE L_ffi_in_cp_arena
L_ffi_in_nul_arena:
    STRB WZR, [X24, X22]
    MOV X0, X24
    MOV X1, X22
    MOV X2, XZR
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_in_heap:
    ADD X0, X22, #1
    BL _malloc
    CBZ X0, L_ffi_in_oom
    CBZ X22, L_ffi_in_done
    MOV X9, X0
    MOV X10, X21
    MOV X11, X22
L_ffi_in_cp:
    LDRB W12, [X10], #1
    STRB W12, [X9], #1
    SUBS X11, X11, #1
    B.NE L_ffi_in_cp
L_ffi_in_done:
    MOV X1, X22
    MOV X2, X0
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_in_oom:
    MOV X0, #0
    MOV X1, #0
    MOV X2, #0
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

L_ffi_in_bad:
    BRK #1
_silica_rt_ffi_string_from_bytes:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X20, L_ffi_from_empty
    ADD X0, X20, #25
    BL _malloc
    CBZ X0, L_ffi_from_empty
    MOV X9, #-1
    STR X9, [X0]
    ADD X9, X0, #24
    STR X9, [X0, #8]
    STR X20, [X0, #16]
    MOV X10, X19
    MOV X11, X20
L_ffi_from_cp:
    CBZ X11, L_ffi_from_nul
    LDRB W12, [X10], #1
    STRB W12, [X9], #1
    SUB X11, X11, #1
    B L_ffi_from_cp
L_ffi_from_nul:
    STRB WZR, [X9]
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_from_empty:
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
_silica_rt_ffi_string_out_and_free:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    CBZ X0, L_ffi_out_no_sret
    MOV X19, X0
    LDR X9, [X19, #0]
    CBNZ X9, L_ffi_out_err
    LDR X0, [X19, #8]
    LDR X1, [X19, #16]
    BL _silica_rt_ffi_string_from_bytes
    MOV X20, X0
    LDR X0, [X19, #8]
    CBZ X0, L_ffi_out_no_cfree
    BL _silica_rt_ffi_ptr_in_active_arena
    CBNZ X0, L_ffi_out_no_cfree
    LDR X0, [X19, #8]
    BL _free
L_ffi_out_no_cfree:
    MOV X0, X19
    BL _silica_rt_ffi_ptr_in_active_arena
    CBNZ X0, L_ffi_out_no_sret_free
    MOV X0, X19
    BL _free
L_ffi_out_no_sret_free:
    MOV X0, X20
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_out_err:
    LDR X0, [X19, #8]
    CBZ X0, L_ffi_out_err_skip
    BL _silica_rt_ffi_ptr_in_active_arena
    CBNZ X0, L_ffi_out_err_skip
    LDR X0, [X19, #8]
    BL _free
L_ffi_out_err_skip:
    MOV X0, X19
    BL _silica_rt_ffi_ptr_in_active_arena
    CBNZ X0, L_ffi_out_err_done
    MOV X0, X19
    BL _free
L_ffi_out_err_done:
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_out_no_sret:
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

