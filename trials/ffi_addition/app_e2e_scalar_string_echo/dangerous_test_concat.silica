use trial_wait_int64;

module dangerous_test_concat;

wrapper_meta "dangerous_exposure_source/text/silica_text_wrapper.meta";

foreign c_wrapper "silica_text_echo"
fn echo_raw(text_ptr: uint8, text_len: uint64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

fn result_sink(msg: string, state: string) -> (:no_reply, string) {
    sequence proc[device_io]
        print_string(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn ffi_worker(msg: string, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        echoed: string <- echo_raw(msg);
        _: boolean <- cast(reply_to, "Echo: hello" impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                sink_ref: actor_ref <- spawn("", result_sink, stack_policy(0, :keep_last_message));
                worker_ref: dangerous_actor_ref <- spawn_dangerous(sink_ref, ffi_worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast(worker_ref, "hello" impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
