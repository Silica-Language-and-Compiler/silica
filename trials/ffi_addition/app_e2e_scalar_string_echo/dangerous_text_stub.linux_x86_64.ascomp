    .intel_syntax noprefix
    .text
.global dangerous_text_stub_text_echo
.extern silica_rt_ffi_guarded_enter
.extern silica_rt_ffi_guarded_exit
.extern silica_rt_ffi_guarded_setjmp
.extern silica_rt_ffi_guarded_fault_finish
.extern silica_rt_ffi_arena_bump
.extern silica_text_echo
.extern free
.extern malloc


.set SVR_AREA, 32
.set SVR_X16, 8
.set SVR_X19, 16
.set SVR_X20, 24
.globl dangerous_text_stub_text_echo
dangerous_text_stub_text_echo:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA
    mov QWORD PTR [rbp - SVR_X19], rdi
    mov QWORD PTR [rbp - SVR_X19], rdi

    lea rsp, [rsp + -32]
    mov QWORD PTR [rsp + 8], 0
    mov QWORD PTR [rsp + 16], 0
    mov QWORD PTR [rsp + 24], 0
    mov rdi, 32
    call silica_rt_ffi_arena_bump
    mov QWORD PTR [rsp], rdi
    mov rbx, rdi
    mov rax, QWORD PTR [rbp - SVR_X19]
    mov QWORD PTR [rbp - SVR_X16], rax

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    // effects []|sir_rec:o318|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    call silica_rt_ffi_string_in
    mov rbx, QWORD PTR [rsp]
    lea rsp, [rsp + -80]
    mov QWORD PTR [rsp], rdi
    mov QWORD PTR [rsp + 8], rsi
    mov QWORD PTR [rsp + 16], rdx
    mov QWORD PTR [rsp + 16 + 8], rcx
    mov QWORD PTR [rsp + 32], r8
    mov QWORD PTR [rsp + 32 + 8], r9
    mov QWORD PTR [rsp + 48], r14
    mov QWORD PTR [rsp + 48 + 8], r15
    mov QWORD PTR [rsp + 64], rbx
    call silica_rt_ffi_guarded_enter
    call silica_rt_ffi_guarded_setjmp
    test rdi, rdi
    jne 1f
    mov rbx, QWORD PTR [rsp + 64]
    mov r14, QWORD PTR [rsp + 48]
    mov r15, QWORD PTR [rsp + 48 + 8]
    mov r8, QWORD PTR [rsp + 32]
    mov r9, QWORD PTR [rsp + 32 + 8]
    mov rdx, QWORD PTR [rsp + 16]
    mov rcx, QWORD PTR [rsp + 16 + 8]
    mov rdi, QWORD PTR [rsp]
    mov rsi, QWORD PTR [rsp + 8]
    mov rdx, rsi
    mov rsi, rdi
    mov rdi, rbx
    mov eax, 0
    call silica_text_echo
    mov rdi, rax
    mov QWORD PTR [rsp], rdi
    call silica_rt_ffi_guarded_exit
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 80]
    jmp 2f
1:
    call silica_rt_ffi_guarded_fault_finish
2:
    mov rdi, QWORD PTR [rsp]
    call silica_rt_ffi_string_out_and_free
    mov QWORD PTR [rsp + 16], rdi
    mov QWORD PTR [rsp], 0
    mov rdi, QWORD PTR [rsp + 16]
    lea rsp, [rsp + 32]


    mov QWORD PTR [rbp - SVR_X20], rdi
    mov rdi, QWORD PTR [rbp - SVR_X20]


    leave
    ret
L_pa_helper:
    test rdi, rdi
    js L_pa_oob
    cmp rdi, 23
    jge L_pa_oob
    lea r9, [rip + L_pa_table]
    mov r10, rdi
    shl r10, 4
    add r9, r10
    mov rsi, QWORD PTR [r9]
    mov rdx, QWORD PTR [r9 + 8]
    mov edi, 1
    mov eax, 1
    syscall
    xor edi, edi
    ret
L_pa_oob:
    xor edi, edi
    ret

silica_rt_ffi_string_in:
    push rbp
    mov rbp, rsp
    sub rsp, 80
    mov QWORD PTR [rbp - 8], rdi
    test rdi, rdi
    jz L_ffi_in_empty
    mov r10, QWORD PTR [rdi]
    cmp r10, -1
    jne L_ffi_in_bad
    mov r10, QWORD PTR [rdi + 8]
    mov QWORD PTR [rbp - 24], r10
    mov r10, QWORD PTR [rdi + 16]
    mov QWORD PTR [rbp - 32], r10
    jmp L_ffi_in_have_src
L_ffi_in_empty:
    mov QWORD PTR [rbp - 24], 0
    mov QWORD PTR [rbp - 32], 0
L_ffi_in_have_src:
    call silica_rt_tls_current_actor_get
    test rdi, rdi
    jz L_ffi_in_heap
    mov QWORD PTR [rbp - 40], rdi
    mov rdi, QWORD PTR [rbp - 32]
    inc rdi
    call silica_rt_ffi_arena_bump
    test rdi, rdi
    jz L_ffi_in_oom
    mov QWORD PTR [rbp - 48], rdi
    mov r11, QWORD PTR [rbp - 32]
    test r11, r11
    jz L_ffi_in_nul_arena
    mov r10, rdi
    mov r8, QWORD PTR [rbp - 24]
L_ffi_in_cp_arena:
    movzx eax, BYTE PTR [r8]
    inc r8
    mov BYTE PTR [r10], al
    inc r10
    dec r11
    jnz L_ffi_in_cp_arena
L_ffi_in_nul_arena:
    mov rdi, QWORD PTR [rbp - 48]
    mov rsi, QWORD PTR [rbp - 32]
    mov BYTE PTR [rdi + rsi], 0
    xor edx, edx
    leave
    ret
L_ffi_in_heap:
    mov rdi, QWORD PTR [rbp - 32]
    inc rdi
    call malloc
    mov rdi, rax
    test rdi, rdi
    jz L_ffi_in_oom
    mov r11, QWORD PTR [rbp - 32]
    test r11, r11
    jz L_ffi_in_done
    mov r10, rdi
    mov r8, QWORD PTR [rbp - 24]
L_ffi_in_cp:
    movzx eax, BYTE PTR [r8]
    inc r8
    mov BYTE PTR [r10], al
    inc r10
    dec r11
    jnz L_ffi_in_cp
L_ffi_in_done:
    mov rsi, QWORD PTR [rbp - 32]
    mov rdx, rdi
    leave
    ret
L_ffi_in_oom:
    xor edi, edi
    xor esi, esi
    xor edx, edx
    leave
    ret

L_ffi_in_bad:
    ud2
silica_rt_ffi_string_from_bytes:
    push rbp
    mov rbp, rsp
    sub rsp, 80
    mov QWORD PTR [rbp - 8], rdi
    mov QWORD PTR [rbp - 16], rsi
    test rsi, rsi
    jz L_ffi_from_empty
    lea rdi, [rsi + 25]
    call malloc
    test rax, rax
    jz L_ffi_from_empty
    mov QWORD PTR [rax], -1
    lea r10, [rax + 24]
    mov QWORD PTR [rax + 8], r10
    mov r11, QWORD PTR [rbp - 16]
    mov QWORD PTR [rax + 16], r11
    mov r8, QWORD PTR [rbp - 8]
L_ffi_from_cp:
    test r11, r11
    jz L_ffi_from_nul
    movzx ecx, BYTE PTR [r8]
    inc r8
    mov BYTE PTR [r10], cl
    inc r10
    dec r11
    jmp L_ffi_from_cp
L_ffi_from_nul:
    mov BYTE PTR [r10], 0
    mov rdi, rax
    leave
    ret
L_ffi_from_empty:
    xor edi, edi
    leave
    ret
silica_rt_ffi_string_out_and_free:
    push rbp
    mov rbp, rsp
    sub rsp, 80
    test rdi, rdi
    jz L_ffi_out_no_sret
    mov QWORD PTR [rbp - 8], rdi
    mov r10, QWORD PTR [rdi]
    test r10, r10
    jnz L_ffi_out_err
    mov rsi, QWORD PTR [rdi + 16]
    mov rdi, QWORD PTR [rdi + 8]
    call silica_rt_ffi_string_from_bytes
    mov QWORD PTR [rbp - 16], rdi
    mov rax, QWORD PTR [rbp - 8]
    mov rdi, QWORD PTR [rax + 8]
    test rdi, rdi
    jz L_ffi_out_no_cfree
    call silica_rt_ffi_ptr_in_active_arena
    test rdi, rdi
    jnz L_ffi_out_no_cfree
    mov rax, QWORD PTR [rbp - 8]
    mov rdi, QWORD PTR [rax + 8]
    call free
L_ffi_out_no_cfree:
    mov rdi, QWORD PTR [rbp - 8]
    call silica_rt_ffi_ptr_in_active_arena
    test rdi, rdi
    jnz L_ffi_out_no_sret_free
    mov rdi, QWORD PTR [rbp - 8]
    call free
L_ffi_out_no_sret_free:
    mov rdi, QWORD PTR [rbp - 16]
    leave
    ret
L_ffi_out_err:
    mov rdi, QWORD PTR [rdi + 8]
    test rdi, rdi
    jz L_ffi_out_err_skip
    call silica_rt_ffi_ptr_in_active_arena
    test rdi, rdi
    jnz L_ffi_out_err_skip
    mov rax, QWORD PTR [rbp - 8]
    mov rdi, QWORD PTR [rax + 8]
    call free
L_ffi_out_err_skip:
    mov rdi, QWORD PTR [rbp - 8]
    call silica_rt_ffi_ptr_in_active_arena
    test rdi, rdi
    jnz L_ffi_out_err_done
    mov rdi, QWORD PTR [rbp - 8]
    call free
L_ffi_out_err_done:
    xor edi, edi
    leave
    ret
L_ffi_out_no_sret:
    xor edi, edi
    leave
    ret

