// A spawn_dangerous worker answering more than one message (SD-18). The worker's
// `w: dangerous_actor_ref <- spawn_dangerous(...)` was left in X0: dangerous_actor_ref was missing
// from term_reg_spill@let_rhs_type_spills_across_io, so it had no callee-saved home, and the second
// `cast(w, ...)` read back the boolean the first cast had returned and locked address 0x11
// ("[silica] fault ... in os_unfair_lock_lock", and silica_rt_lock_lock on Linux x86-64 -- the
// defect was host-independent). FFI wrapper spec §4.4: the worker "receives foreign-call request
// casts" and §4.2's cast-mediated model puts no limit on their number. Reconstructed from
// project-bees trials/s04_native_edge/dangerous_sd18_second_message_faults.silica on Silica's
// legacy_math fixture (the original calls a BEES clock wrapper).
// Expected: 41 / done / 42 / done
use trial_wait_int64;

module dangerous_worker_second_message;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(left: int64, right: int64) -> int64;

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state + 1)
    end
}

fn worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        t: int64 <- add_raw(40, msg);
        _: boolean <- cast(reply_to, t impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
                w: dangerous_actor_ref <- spawn_dangerous(s, worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast(w, 1 impl ActorMessage {});
                _: boolean <- cast(w, 2 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
