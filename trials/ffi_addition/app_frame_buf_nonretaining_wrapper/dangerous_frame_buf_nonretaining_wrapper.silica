use trial_wait_int64;

module dangerous_frame_buf_nonretaining_wrapper;

// Chunk 15 phase 7 (design §7, "Buffers for the call"): a buffer that is only used during a call is a
// frame allocation. silica_call_only_sum declares no retains, so passing it a frame buffer made with
// alloc_buf(n) is legal (no E2300), C reads it during the call, and the frame pops after.
// The worker fills 5, 6, 7, 8 and casts the wrapper's sum (26) to the sink.
// Expected: 26, then "done", then status 0.

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_call_only_sum"
fn sum_raw(data_ptr: uint8, data_len: uint64) -> int64;

fn result_sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn ffi_worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency, mem(normal)]
        L1: lifetime <- fresh_lifetime();
        bf: buf(L1, normal, uint8, 4) <- alloc_buf(4);
        _: atom <- write_buf(bf, 0, 5);
        _: atom <- write_buf(bf, 1, 6);
        _: atom <- write_buf(bf, 2, 7);
        _: atom <- write_buf(bf, 3, 8);
        total: int64 <- sum_raw(bf);
        _: boolean <- cast(reply_to, total impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                sink_ref: actor_ref <- spawn(0, result_sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                worker_ref: dangerous_actor_ref <- spawn_dangerous(sink_ref, ffi_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(worker_ref, 0 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
