use trial_support_int64;

module dangerous_string_two_layer_valid;

wrapper_meta "dangerous_exposure_source/net/silica_net_wrapper.meta";

foreign c_wrapper "silica_net_parse_port"
fn parse_port_raw(text_ptr: uint8, text_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
