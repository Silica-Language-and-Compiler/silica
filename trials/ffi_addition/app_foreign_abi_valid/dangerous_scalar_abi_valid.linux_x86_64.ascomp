    .intel_syntax noprefix
    .text
    // use trial_support_int64
.extern silica_rt_ffi_guarded_enter
.extern silica_rt_ffi_guarded_exit
.extern silica_rt_ffi_guarded_setjmp
.extern silica_rt_ffi_guarded_fault_finish
.extern silica_rt_ffi_arena_bump
.extern silica_legacy_math_add_int64
.extern free
.extern malloc
.global main


.set SVR_AREA, 64
.set SVR_X16, 8
.set SVR_X19, 16
.set SVR_CS0, 24
.set SVR_CS1, 32
.set SVR_CS2, 40
.set SVR_CS3, 48
.set SVR_CS4, 56
.globl main
main:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA
    mov QWORD PTR [rbp - SVR_CS0], rbx
    mov QWORD PTR [rbp - SVR_CS1], r12
    mov QWORD PTR [rbp - SVR_CS2], r13
    mov QWORD PTR [rbp - SVR_CS3], r14
    mov QWORD PTR [rbp - SVR_CS4], r15

    call silica_pid_registry_init
    call silica_dangerous_pid_registry_init
    call silica_device_pid_registry_init
    // push dummy argument slot
    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    // effects []|sir_rec:o334|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    mov rbx, 0
    lea r10, [rip + trial_support_int64_start]
    call r10

    lea rax, [rip + dangerous_scalar_abi_valid.__lam0]
    mov QWORD PTR [rbp - SVR_X16], rax

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    // effects []|sir_rec:o385|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    mov rbx, 0
    lea r10, [rip + trial_support_int64_run]
    call r10

    call silica_rt_wait_for_exit

    mov QWORD PTR [rbp - SVR_X19], rdi
    mov rdi, QWORD PTR [rbp - SVR_X19]




    mov rax, rdi
    mov rbx, QWORD PTR [rbp - SVR_CS0]
    mov r12, QWORD PTR [rbp - SVR_CS1]
    mov r13, QWORD PTR [rbp - SVR_CS2]
    mov r14, QWORD PTR [rbp - SVR_CS3]
    mov r15, QWORD PTR [rbp - SVR_CS4]
    leave
    ret

.set SVR_AREA, 0
.globl dangerous_scalar_abi_valid.__lam0
dangerous_scalar_abi_valid.__lam0:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA

    mov rdi, 0

    leave
    ret
L_pa_helper:
    test rdi, rdi
    js L_pa_oob
    cmp rdi, 28
    jge L_pa_oob
    lea r9, [rip + L_pa_table]
    mov r10, rdi
    shl r10, 4
    add r9, r10
    mov rsi, QWORD PTR [r9]
    mov rdx, QWORD PTR [r9 + 8]
    mov edi, 1
    mov eax, 1
    syscall
    xor edi, edi
    ret
L_pa_oob:
    xor edi, edi
    ret

silica_rt_ffi_string_in:
    push rbp
    mov rbp, rsp
    sub rsp, 80
    mov QWORD PTR [rbp - 8], rdi
    test rdi, rdi
    jz L_ffi_in_empty
    mov r10, QWORD PTR [rdi]
    cmp r10, -1
    jne L_ffi_in_bad
    mov r10, QWORD PTR [rdi + 8]
    mov QWORD PTR [rbp - 24], r10
    mov r10, QWORD PTR [rdi + 16]
    mov QWORD PTR [rbp - 32], r10
    jmp L_ffi_in_have_src
L_ffi_in_empty:
    mov QWORD PTR [rbp - 24], 0
    mov QWORD PTR [rbp - 32], 0
L_ffi_in_have_src:
    call silica_rt_tls_current_actor_get
    test rdi, rdi
    jz L_ffi_in_heap
    mov QWORD PTR [rbp - 40], rdi
    mov rdi, QWORD PTR [rbp - 32]
    inc rdi
    call silica_rt_ffi_arena_bump
    test rdi, rdi
    jz L_ffi_in_oom
    mov QWORD PTR [rbp - 48], rdi
    mov r11, QWORD PTR [rbp - 32]
    test r11, r11
    jz L_ffi_in_nul_arena
    mov r10, rdi
    mov r8, QWORD PTR [rbp - 24]
L_ffi_in_cp_arena:
    movzx eax, BYTE PTR [r8]
    inc r8
    mov BYTE PTR [r10], al
    inc r10
    dec r11
    jnz L_ffi_in_cp_arena
L_ffi_in_nul_arena:
    mov rdi, QWORD PTR [rbp - 48]
    mov rsi, QWORD PTR [rbp - 32]
    mov BYTE PTR [rdi + rsi], 0
    xor edx, edx
    leave
    ret
L_ffi_in_heap:
    mov rdi, QWORD PTR [rbp - 32]
    inc rdi
    call malloc
    mov rdi, rax
    test rdi, rdi
    jz L_ffi_in_oom
    mov r11, QWORD PTR [rbp - 32]
    test r11, r11
    jz L_ffi_in_done
    mov r10, rdi
    mov r8, QWORD PTR [rbp - 24]
L_ffi_in_cp:
    movzx eax, BYTE PTR [r8]
    inc r8
    mov BYTE PTR [r10], al
    inc r10
    dec r11
    jnz L_ffi_in_cp
L_ffi_in_done:
    mov rsi, QWORD PTR [rbp - 32]
    mov rdx, rdi
    leave
    ret
L_ffi_in_oom:
    xor edi, edi
    xor esi, esi
    xor edx, edx
    leave
    ret

L_ffi_in_bad:
    ud2
silica_rt_ffi_string_from_bytes:
    push rbp
    mov rbp, rsp
    sub rsp, 80
    mov QWORD PTR [rbp - 8], rdi
    mov QWORD PTR [rbp - 16], rsi
    test rsi, rsi
    jz L_ffi_from_empty
    lea rdi, [rsi + 25]
    call malloc
    test rax, rax
    jz L_ffi_from_empty
    mov QWORD PTR [rax], -1
    lea r10, [rax + 24]
    mov QWORD PTR [rax + 8], r10
    mov r11, QWORD PTR [rbp - 16]
    mov QWORD PTR [rax + 16], r11
    mov r8, QWORD PTR [rbp - 8]
L_ffi_from_cp:
    test r11, r11
    jz L_ffi_from_nul
    movzx ecx, BYTE PTR [r8]
    inc r8
    mov BYTE PTR [r10], cl
    inc r10
    dec r11
    jmp L_ffi_from_cp
L_ffi_from_nul:
    mov BYTE PTR [r10], 0
    mov rdi, rax
    leave
    ret
L_ffi_from_empty:
    xor edi, edi
    leave
    ret
silica_rt_ffi_string_out_and_free:
    push rbp
    mov rbp, rsp
    sub rsp, 80
    test rdi, rdi
    jz L_ffi_out_no_sret
    mov QWORD PTR [rbp - 8], rdi
    mov r10, QWORD PTR [rdi]
    test r10, r10
    jnz L_ffi_out_err
    mov rsi, QWORD PTR [rdi + 16]
    mov rdi, QWORD PTR [rdi + 8]
    call silica_rt_ffi_string_from_bytes
    mov QWORD PTR [rbp - 16], rdi
    mov rax, QWORD PTR [rbp - 8]
    mov rdi, QWORD PTR [rax + 8]
    test rdi, rdi
    jz L_ffi_out_no_cfree
    call silica_rt_ffi_ptr_in_active_arena
    test rdi, rdi
    jnz L_ffi_out_no_cfree
    mov rax, QWORD PTR [rbp - 8]
    mov rdi, QWORD PTR [rax + 8]
    call free
L_ffi_out_no_cfree:
    mov rdi, QWORD PTR [rbp - 8]
    call silica_rt_ffi_ptr_in_active_arena
    test rdi, rdi
    jnz L_ffi_out_no_sret_free
    mov rdi, QWORD PTR [rbp - 8]
    call free
L_ffi_out_no_sret_free:
    mov rdi, QWORD PTR [rbp - 16]
    leave
    ret
L_ffi_out_err:
    mov rdi, QWORD PTR [rdi + 8]
    test rdi, rdi
    jz L_ffi_out_err_skip
    call silica_rt_ffi_ptr_in_active_arena
    test rdi, rdi
    jnz L_ffi_out_err_skip
    mov rax, QWORD PTR [rbp - 8]
    mov rdi, QWORD PTR [rax + 8]
    call free
L_ffi_out_err_skip:
    mov rdi, QWORD PTR [rbp - 8]
    call silica_rt_ffi_ptr_in_active_arena
    test rdi, rdi
    jnz L_ffi_out_err_done
    mov rdi, QWORD PTR [rbp - 8]
    call free
L_ffi_out_err_done:
    xor edi, edi
    leave
    ret
L_ffi_out_no_sret:
    xor edi, edi
    leave
    ret

