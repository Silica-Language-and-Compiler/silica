.text
    ; use trial_wait_int64
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.extern _silica_ffi_sigill_probe
.extern _free
.extern _malloc
.global main


    .p2align 2
    .long 0x5C1AC0F2
dangerous_guarded_sigill_fault_result_sink:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    SUB SP, SP, #16
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2

    MOV X0, X19
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #2

    ; effects [device_io]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    ; effects [device_io]
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #4
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    MOV X9, #23
    STR X9, [X21, #0]
    MOV X9, X20
    STR X9, [X21, #8]
    MOV X0, X21



    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    ADD SP, SP, #16
    LDP X29, X30, [SP], #16
    RET

    .p2align 2
    .long 0x5C1AC0F2
dangerous_guarded_sigill_fault_ffi_worker:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    SUB SP, SP, #16
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2

    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o586|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    SUB SP, SP, #80
    STP X0, X1, [SP, #0]
    STP X2, X3, [SP, #16]
    STP X4, X5, [SP, #32]
    STP X6, X7, [SP, #48]
    STR X8, [SP, #64]
    BL _silica_rt_ffi_guarded_enter
    BL _silica_rt_ffi_guarded_setjmp
    CBNZ X0, 1f
    LDR X8, [SP, #64]
    LDP X6, X7, [SP, #48]
    LDP X4, X5, [SP, #32]
    LDP X2, X3, [SP, #16]
    LDP X0, X1, [SP, #0]
    BL _silica_ffi_sigill_probe
    STR X0, [SP, #0]
    BL _silica_rt_ffi_guarded_exit
    LDR X0, [SP, #0]
    ADD SP, SP, #80
    B 2f
1:
    BL _silica_rt_ffi_guarded_fault_finish
2:


    MOV X9, X20
    MOV X11, X9
    MOV X10, #0
    MOV X0, X11
    MOV X1, X10
    BL _silica_rt_actor_cast


    MOV X9, #23
    STR X9, [X21, #0]
    MOV X9, X20
    STR X9, [X21, #8]
    MOV X0, X21


    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    ADD SP, SP, #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o818|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_wait_int64_start@PAGE
    ADD X9, X9, trial_wait_int64_start@PAGEOFF
    BLR X9

    ADRP X16, dangerous_guarded_sigill_fault.__lam0@PAGE
    ADD X16, X16, dangerous_guarded_sigill_fault.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o866|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_wait_int64_run@PAGE
    ADD X9, X9, trial_wait_int64_run@PAGEOFF
    BLR X9

    BL _silica_rt_wait_for_exit

    MOV X0, #0



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

dangerous_guarded_sigill_fault.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    SUB SP, SP, #16
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!

    MOV X9, #0
    MOV X11, X9
    ADRP X9, dangerous_guarded_sigill_fault_result_sink@PAGE
    ADD X9, X9, dangerous_guarded_sigill_fault_result_sink@PAGEOFF

    STR X9, [X29, #-16]
    MOV X9, #0
    MOV X10, #27
    ADD X9, X9, #15
    AND X9, X9, #0xfffffffffffffff0
    MOV X10, #2
    ORR X9, X9, X10


    STR X9, [X29, #-8]
    SUB X10, X29, #16
    MOV X3, XZR
    MOV X0, X11
    LDR X1, [X10]
    LDR X4, [X10, #8]
    MOV W2, WZR
    BL _silica_rt_actor_spawn


    MOV X19, X0
    MOV X9, X19
    MOV X11, X9
    ADRP X9, dangerous_guarded_sigill_fault_ffi_worker@PAGE
    ADD X9, X9, dangerous_guarded_sigill_fault_ffi_worker@PAGEOFF

    STR X9, [X29, #-16]
    MOV X9, #0
    MOV X10, #27
    ADD X9, X9, #15
    AND X9, X9, #0xfffffffffffffff0
    MOV X10, #2
    ORR X9, X9, X10


    STR X9, [X29, #-8]
    SUB X10, X29, #16
    MOV X3, XZR
    MOV X0, X11
    LDR X1, [X10]
    LDR X4, [X10, #8]
    MOV W2, WZR
    BL _silica_rt_actor_spawn_dangerous


    MOV X20, X0
    MOV X9, X20
    MOV X11, X9
    MOV X10, #0
    MOV X0, X11
    MOV X1, X10
    BL _silica_rt_actor_cast


    MOV X0, #0



    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    ADD SP, SP, #16
    LDP X29, X30, [SP], #16
    RET
L_pi_helper:
    SUB SP, SP, #32
    MOV X10, SP
    ADD X10, X10, #24
    MOV X11, #0
    CMP X0, #0
    B.ge L_pi_pos
    MOV X11, #1
    NEG X0, X0
L_pi_pos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pi_zero
    MOV X9, #10
L_pi_loop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pi_loop
    B L_pi_maybe_neg
L_pi_zero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pi_maybe_neg:
    CBNZ X11, L_pi_prepend_minus
    B L_pi_do_write
L_pi_prepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pi_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #32
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

_silica_rt_ffi_string_in:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    MOV X19, X0
    CBZ X19, L_ffi_in_empty
    LDR X9, [X19]
    MVN X10, X9
    CMP X10, #1
    B.HI L_ffi_in_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    B L_ffi_in_have_src
L_ffi_in_empty:
    MOV X21, #0
    MOV X22, #0
L_ffi_in_have_src:
    ADD X0, X22, #1
    BL _silica_rt_tls_current_actor_get
    CBZ X0, L_ffi_in_heap
    MOV X23, X0
    ADD X0, X22, #1
    BL _silica_rt_ffi_arena_bump
    CBZ X0, L_ffi_in_oom
    MOV X24, X0
    CBZ X22, L_ffi_in_nul_arena
    MOV X9, X24
    MOV X10, X21
    MOV X11, X22
L_ffi_in_cp_arena:
    LDRB W12, [X10], #1
    STRB W12, [X9], #1
    SUBS X11, X11, #1
    B.NE L_ffi_in_cp_arena
L_ffi_in_nul_arena:
    STRB WZR, [X24, X22]
    MOV X0, X24
    MOV X1, X22
    MOV X2, XZR
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_in_heap:
    ADD X0, X22, #1
    BL _malloc
    CBZ X0, L_ffi_in_oom
    CBZ X22, L_ffi_in_done
    MOV X9, X0
    MOV X10, X21
    MOV X11, X22
L_ffi_in_cp:
    LDRB W12, [X10], #1
    STRB W12, [X9], #1
    SUBS X11, X11, #1
    B.NE L_ffi_in_cp
L_ffi_in_done:
    MOV X1, X22
    MOV X2, X0
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_in_oom:
    MOV X0, #0
    MOV X1, #0
    MOV X2, #0
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

L_ffi_in_bad:
    BRK #1
_silica_rt_ffi_string_from_bytes:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X20, L_ffi_from_empty
    ADD X0, X20, #25
    BL _malloc
    CBZ X0, L_ffi_from_empty
    MOV X9, #-1
    STR X9, [X0]
    ADD X9, X0, #24
    STR X9, [X0, #8]
    STR X20, [X0, #16]
    MOV X10, X19
    MOV X11, X20
L_ffi_from_cp:
    CBZ X11, L_ffi_from_nul
    LDRB W12, [X10], #1
    STRB W12, [X9], #1
    SUB X11, X11, #1
    B L_ffi_from_cp
L_ffi_from_nul:
    STRB WZR, [X9]
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_from_empty:
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
_silica_rt_ffi_string_out_and_free:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    CBZ X0, L_ffi_out_no_sret
    MOV X19, X0
    LDR X9, [X19, #0]
    CBNZ X9, L_ffi_out_err
    LDR X0, [X19, #8]
    LDR X1, [X19, #16]
    BL _silica_rt_ffi_string_from_bytes
    MOV X20, X0
    LDR X0, [X19, #8]
    CBZ X0, L_ffi_out_no_cfree
    BL _silica_rt_ffi_ptr_in_active_arena
    CBNZ X0, L_ffi_out_no_cfree
    LDR X0, [X19, #8]
    BL _free
L_ffi_out_no_cfree:
    MOV X0, X19
    BL _silica_rt_ffi_ptr_in_active_arena
    CBNZ X0, L_ffi_out_no_sret_free
    MOV X0, X19
    BL _free
L_ffi_out_no_sret_free:
    MOV X0, X20
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_out_err:
    LDR X0, [X19, #8]
    CBZ X0, L_ffi_out_err_skip
    BL _silica_rt_ffi_ptr_in_active_arena
    CBNZ X0, L_ffi_out_err_skip
    LDR X0, [X19, #8]
    BL _free
L_ffi_out_err_skip:
    MOV X0, X19
    BL _silica_rt_ffi_ptr_in_active_arena
    CBNZ X0, L_ffi_out_err_done
    MOV X0, X19
    BL _free
L_ffi_out_err_done:
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ffi_out_no_sret:
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

