// Supervisor + guarded FFI fault trial:
// A statically materialized :dangerous child calls silica_supervisor_trial_guarded_fault (trial C)
// under the guarded external_danger boundary. The root supervisor uses :one_for_one with :permanent
// restart. Static init materializes one :dangerous child. Main uses get_child + cast twice:
// first cast faults; second cast (via a fresh get_child ref) runs legacy-math FFI and reports 42.
// Child counting is left to a separate supervisor trial.

module dangerous_supervisor_guarded_restart;

use Supervisor;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_supervisor_trial_guarded_fault"
fn fault_raw() -> int64;

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(left: int64, right: int64) -> int64;

impl DangerousSupervisorGuardedRestartSup for Supervisor;

fn result_sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn dangerous_ffi_worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        _: int64 <- case msg == 0 of {
            true -> fault_raw();
            false -> 0
        };
        sum: int64 <- case msg == 1 of {
            true -> add_raw(40, 2);
            false -> 0
        };
        _: boolean <- case msg == 1 of {
            true -> cast_registered(:sup_result_sink, sum impl ActorMessage {});
            false -> true
        }
    produces
        pure (:no_reply, reply_to)
    end
}

fn init(_initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 60 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            {
                id: :dangerous_guarded_ffi_worker,
                agent_type: :worker,
                initial_state: 0,
                behavior: dangerous_ffi_worker,
                restart: :permanent,
                shutdown: 0,
                flavor: :dangerous
            }
        ]
    produces
        pure (flags, children)
    end
}

// Reads the supervisor's current reference for the faulting child. Split out of the poll loop below
// so that the recursive frames carry only the reference, not this whole reply record: holding the
// record per frame overflowed the stack long before the poll count ran out.
fn current_child_ref(sup: supervisor_ref) -> actor_ref {
    sequence
        g: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :dangerous_guarded_ffi_worker } impl SupervisorMessage {})
    produces
        pure g.child
    end
}

// Waits for the supervisor to replace the child that faulted, then hands back the replacement.
// A cast is asynchronous, so main can reach a second get_child before the child has even dequeued
// the faulting message; comparing the two references straight away would then compare the child
// with itself. Each poll is a supervisor round trip rather than a spin, and the count is bounded so
// a regression that never restarts ends the trial with false instead of hanging it. The
// budget is a million because each poll is one supervisor round trip, which is fast, while a
// faulted child's teardown and restart is slow when the machine is busy: at 20,000 polls the
// restart was missed in a third of loaded runs on the Pi, at 400,000 never.
fn get_child_after_restart(sup: supervisor_ref, original: actor_ref, tries_left: int64) -> actor_ref {
    sequence
        current: actor_ref <- current_child_ref(sup);

        replacement: actor_ref <- case actor_ref_not_equal(current, original) of {
            true -> current;
            false -> case tries_left <= 0 of {
                true -> current;
                false -> get_child_after_restart(sup, original, tries_left - 1)
            }
        }
    produces
        pure replacement
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: actor_ref <- spawn_registered(0, result_sink, :sup_result_sink, stack_policy(0, :keep_last_message));
        sup: supervisor_ref <- spawn_registered_supervisor(
            DangerousSupervisorGuardedRestartSup,
            0,
            :dangerous_sup_guarded_restart, stack_policy(0, :keep_last_message)
        );

        first_get: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :dangerous_guarded_ffi_worker } impl SupervisorMessage {});

        _: boolean <- cast(first_get.child, 0 impl ActorMessage {});

        second_child: actor_ref <- get_child_after_restart(sup, first_get.child, 1000000);

        // The restart is asserted, not inferred: a supervised restart replaces the child, so the
        // reference fetched after the failure must differ from the one that faulted. Identities are
        // never reused, so actor_ref_not_equal on the two references answers that directly (spec 7.4,
        // 15.1.4, 22.4). Printing it keeps the assertion in the trial output, where a regression that
        // silently skips the restart -- or hands back the dead child -- shows up as false instead of
        // a missing line.
        restarted: boolean <- actor_ref_not_equal(second_child, first_get.child);
        _: atom <- print_boolean(restarted);
        _: atom <- println("");

        // When the poll budget runs out the reference is still the faulted child's. Casting to it
        // would vanish into a dead mailbox and the trial would hang until the harness watchdog
        // killed it, telling nobody anything. Say what happened and exit instead, so a missed
        // restart is a named failure rather than a silent one.
        code: int64 <- case restarted of {
            true -> {
                _: boolean <- cast(second_child, 1 impl ActorMessage {});
                _: int64 <- wait_for_exit();
                0
            };
            false -> {
                _: atom <- println("restart not observed: the supervisor did not replace the faulted child within the poll budget");
                1
            }
        }
    produces
        pure code
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
