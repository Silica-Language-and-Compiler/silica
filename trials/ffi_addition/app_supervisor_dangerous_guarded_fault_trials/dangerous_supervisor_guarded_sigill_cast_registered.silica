// Supervisor + guarded FFI SIGILL trial (cast_registered variant):
// Two static :dangerous children; main uses cast_registered on each child id.
// Integrate compares presorted .scout lines (banner details covered elsewhere).

module dangerous_supervisor_guarded_sigill_cast_registered;

use Supervisor;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_ffi_sigill_probe"
fn sigill_probe_raw() -> int64;

impl DangerousSupervisorGuardedSigillCastRegisteredSup for Supervisor;

fn result_sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn dangerous_ffi_sigill_fault_worker(_msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger]
        _: int64 <- sigill_probe_raw()
    produces
        pure (:no_reply, reply_to)
    end
}

fn dangerous_ffi_sigill_add_worker(_msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        _: boolean <- cast_registered(:sup_result_sink, 42 impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn init(_initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 60 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            {
                id: :dangerous_guarded_ffi_sigill_fault_worker,
                agent_type: :worker,
                initial_state: 0,
                behavior: dangerous_ffi_sigill_fault_worker,
                restart: :permanent,
                shutdown: 0,
                flavor: :dangerous
            },
            {
                id: :dangerous_guarded_ffi_sigill_add_worker,
                agent_type: :worker,
                initial_state: 0,
                behavior: dangerous_ffi_sigill_add_worker,
                restart: :permanent,
                shutdown: 0,
                flavor: :dangerous
            }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: actor_ref <- spawn_registered(0, result_sink, :sup_result_sink, stack_policy(0, :keep_last_message));
        _: supervisor_ref <- spawn_registered_supervisor(
            DangerousSupervisorGuardedSigillCastRegisteredSup,
            0,
            :dangerous_sup_guarded_sigill_cast_registered, stack_policy(0, :keep_last_message)
        );

        _: boolean <- cast_dangerous_registered(:dangerous_guarded_ffi_sigill_add_worker, 0 impl ActorMessage {});
        _: boolean <- cast_dangerous_registered(:dangerous_guarded_ffi_sigill_fault_worker, 0 impl ActorMessage {});

        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
