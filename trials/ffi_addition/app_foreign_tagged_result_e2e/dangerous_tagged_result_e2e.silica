// A foreign call whose C function returns a struct, taken as a Silica record and read field by field:
// the hosted wrappers' tagged result { tag, value, error_code } (24 bytes; on the ESP32-S3 it comes back
// through a hidden pointer and is copied field by field into a record of the caller's frame, because the
// record's layout is the emitter's and not C's). The worker checks the tag and adds the three fields:
// value 42, tag 0 and error_code 0.
// Expected: 42 / done, then status 0 on the `exit` line.
use trial_wait_int64;

module dangerous_tagged_result_e2e;

wrapper_meta "dangerous_exposure_source/abi/silica_abi_types_wrapper.meta";

foreign c_wrapper "silica_abi_i64_result_ok"
fn result_ok(input: int64) -> { tag: int64, value: int64, error_code: int64 };

fn result_sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn ffi_worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        r: { tag: int64, value: int64, error_code: int64 } <- result_ok(msg + 42);
        first: int64 <- case r.tag == 0 of {
            true -> r.value + r.tag + r.error_code;
            false -> 0 - 1
        };
        _: boolean <- cast(reply_to, first impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                sink_ref: actor_ref <- spawn(0, result_sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                worker_ref: dangerous_actor_ref <- spawn_dangerous(sink_ref, ffi_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(worker_ref, 0 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
