// A nested supervisor whose start function is in the same unit as the root (spec §15.4.13): the
// root's init lists one child { id: :s1_rec_sup, agent_type: :supervisor, behavior: inner_start },
// and inner_start, defined in this file, returns one worker :s1_rec_worker (state 40, replies
// msg + state). main asks the root for count_children (1: the inner supervisor), gets the inner
// supervisor with get_child and asks it for count_children (1: the worker), then calls the worker by
// its registered id with 2.
// Expected, by hand: 1, 1, 40 + 2 = 42, done; exit status 0.
// Atoms: the ids and the registered name are reused, already numbered earlier in supervisors_addition
// (the suite shares one atom table), so no other trial's atoms are renumbered.

use Supervisor;

impl SameUnitNestedRootSup for Supervisor;

fn inner_worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn inner_start(initial_state: int64) -> ({
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    }, List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)]) {
    sequence proc[mem(normal)]
        flags: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 10, restarts_time_frame: 5 };
        children: List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)] <- [
            { id: :s1_rec_worker, agent_type: :worker, initial_state: 40, behavior: inner_worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn init(initial_state: int64) -> ({
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    }, List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(initial_state: int64) -> ({
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    }, List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)]),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)]) {
    sequence proc[mem(normal)]
        flags: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 10, restarts_time_frame: 5 };
        children: List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(initial_state: int64) -> ({
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    }, List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)]),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)] <- [
            { id: :s1_rec_sup, agent_type: :supervisor, initial_state: 0, behavior: inner_start, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- start_reporter();
        root: supervisor_ref <- spawn_registered_supervisor(SameUnitNestedRootSup, 0, :phase_e_decl_10_ofo_sup, stack_policy(0, :keep_last_message));
        cnt: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(root, { op: :count_children } impl SupervisorMessage {});
        print_int64(cnt.count);
        println("");
        ci: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(root, { op: :get_child, id: :s1_rec_sup } impl SupervisorMessage {});
        icnt: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(ci.child, { op: :count_children } impl SupervisorMessage {});
        print_int64(icnt.count);
        println("");
        r: int64 <- call_registered(:s1_rec_worker, 2 impl ActorMessage {});
        print_int64(r);
        println("");
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn report_kind(report: string) -> string {
    case contains(report, "reason_tag:      1\n") of {
        true -> "failure report: reason_tag 1";
        false -> "failure report: other reason"
    }
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case contains(report, "=== Silica Actor Failure ===") of {
            true -> println(report_kind(report));
            false -> println(concat(report, "\ndone"))
        }
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
