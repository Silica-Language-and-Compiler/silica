// A record message cast from inside running code rather than from main (book-verification repro
// r_cb, defect D11): `asker` casts a record to `doubler` from a helper it calls, and `doubler` casts
// its answer back directly from its own behaviour. Each record lived in the sending function's frame
// region, which was popped (and reused) before the receiver ran, so the doubler read value 0 and the
// answer arrived with an unknown kind (every run). Spec §15.4.7.3 / §16.3.5: a message is copied at
// send time -- the emitter now copies a tuple or record message into the sender's region before the
// runtime enqueues it.
// Expected: 21 arrives at the doubler; it replies with 42. The asker prints its line before it
// casts, so the doubler's line always comes second (the two actors print one after the other).
//   Question sent. Getting on with other things.
//   21 arrived at the doubler
//   The answer came back: 42
//   done
//   0

use Supervisor;

impl BookSupervisor for Supervisor;

fn asker(msg: { kind: atom, reply_to: atom, value: int64 }, state: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- case msg.kind of {
            :start -> ask_doubler(msg.value);
            :answer -> hear_answer(msg.value);
            :request -> hear_answer(1000 + msg.value);
            :asker -> hear_answer(2000 + msg.value);
            :doubler -> hear_answer(3000 + msg.value);
            _: atom -> hear_answer(9000 + msg.value)
        }
    produces
        pure (:no_reply, state)
    end
}

fn ask_doubler(number: int64) -> atom {
    sequence proc[concurrency, device_io]
        request: { kind: atom, reply_to: atom, value: int64 } <- { kind: :request, reply_to: :asker, value: number };
        println("Question sent. Getting on with other things.");  // printed first: the doubler prints next
        _: boolean <- cast_registered(:doubler, request impl ActorMessage {})  // send the question, and do not wait
    produces
        pure :ok
    end
}

fn hear_answer(answer: int64) -> atom {
    sequence proc[device_io]
        print_string("The answer came back: ");
        _: atom <- print_int64(answer);
        println("");
        println("done")
    produces
        pure :ok
    end
}

fn doubler(msg: { kind: atom, reply_to: atom, value: int64 }, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- print_int64(msg.value);
        println(" arrived at the doubler");
        _: boolean <- cast_registered(:asker, { kind: :answer, reply_to: :doubler, value: msg.value * 2 } impl ActorMessage {})  // cast the answer back to whoever asked
    produces
        pure (:no_reply, state)
    end
}
fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: { kind: atom, reply_to: atom, value: int64 }, state: int64) -> (:no_reply, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
        children: List[
        {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: { kind: atom, reply_to: atom, value: int64 }, state: int64) -> (:no_reply, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            {
                id: :asker,
                agent_type: :worker,
                initial_state: 0,
                behavior: asker,
                restart: :permanent,
                shutdown: 0,
                flavor: :plain
            },
            {
                id: :doubler,
                agent_type: :worker,
                initial_state: 0,
                behavior: doubler,
                restart: :permanent,
                shutdown: 0,
                flavor: :plain
            }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: supervisor_ref <- spawn_registered_supervisor(BookSupervisor, 0, :book_supervisor, stack_policy(0, :keep_last_message));
        start: { kind: atom, reply_to: atom, value: int64 } <- { kind: :start, reply_to: :asker, value: 21 };
        _: boolean <- cast_registered(:asker, start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
