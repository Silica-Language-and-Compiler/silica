// Spec §20.3.1 "Supervised children with the same id": restarting a child whose name another actor
// took between the child's end and its restart is a run-time error with the duplicate-child
// indicator: no child is started under a name it does not hold, and the supervisor doing the
// restart fails with failure_reason (:explicit, :duplicate_child_id), escalating as a failed
// supervisor does (here a root supervisor: its failure report, then the root note).
//
// The window is made deterministic with the supervisor protocol: :terminate_child ends the child
// :dup_restart_worker and returns once it is gone, so its name is free; main then takes the name
// with spawn_registered; :restart_child is the restart. A supervisor's automatic restart after a
// crash respawns through the same runtime path, but its window (between the registry removal and
// the respawn, both on the ending child's thread) cannot be hit deterministically from a program.
//
// Expected output:
//   11                    the init child, state 10
//   1                     :terminate_child replied :ok
//   101                   the name now reaches main's worker, state 100
//   <failure report of the supervisor: reason_tag 4, agent_type_atom 0, <unknown behavior>>
//   [silica] root actor exited (no supervisor)
//   102                   main's worker still holds the name; no replacement was started
//   done                  after main's wait_for_exit, which the reporter's cast_exit ends on the
//                         root supervisor's report (reports are asynchronous; unordered compare)

use Supervisor;

impl DupRestartSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 3600 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            { id: :dup_restart_worker, agent_type: :worker, initial_state: 10, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(DupRestartSup, 0, :dup_restart_sup, stack_policy(0, :keep_last_message));
        r1: int64 <- call_registered(:dup_restart_worker, 1 impl ActorMessage {});
        print_int64(r1);
        println("");
        ended: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :terminate_child, id: :dup_restart_worker } impl SupervisorMessage {});
        print_int64(case ended.tag of {
            :ok -> 1;
            _: atom -> 0
        });
        println("");
        taker: actor_ref <- spawn_registered(100, worker, :dup_restart_worker, stack_policy(0, :keep_last_message));
        r2: int64 <- call_registered(:dup_restart_worker, 1 impl ActorMessage {});
        print_int64(r2);
        println("");
        restarted: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :restart_child, id: :dup_restart_worker } impl SupervisorMessage {});
        r3: int64 <- call_registered(:dup_restart_worker, 2 impl ActorMessage {});
        print_int64(r3);
        println("");
        // The reporter's cast_exit on the root supervisor's report ends this wait, so "done" (the
        // harness's exit marker) comes only after both reports.
        _: int64 <- wait_for_exit();
        println("done")
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
