	ldp	x12, x13, [sp], #16
	cbz	x0, Lcal_abort_nomem
	add	x14, x0, #32
	str	x14, [x0]
	mov	x15, #4128
	add	x14, x0, x15
	str	x14, [x0, #8]
	str	xzr, [x0, #16]
	str	x14, [x0, #24]
	str	x19, [x12]
	str	x0, [x12, #8]
	adrp	x13, _silica_rt_canonical_arena_count@PAGE
	add	x13, x13, _silica_rt_canonical_arena_count@PAGEOFF
	ldr	x14, [x13]
	add	x14, x14, #1
	str	x14, [x13]
	ldp	x19, x30, [sp, #16]
