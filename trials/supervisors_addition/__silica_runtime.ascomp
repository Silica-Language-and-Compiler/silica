	.p2align	2
_silica_rt_stack_runtime_init:
; Read the platform page and the default reservation (physical memory + swap) once.
	stp	x29, x30, [sp, #-96]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	adrp	x19, _silica_rt_stack_init_done@PAGE
	add	x19, x19, _silica_rt_stack_init_done@PAGEOFF
	ldr	x8, [x19]
	cbnz	x8, Lsri_done
	mov	w0, #29
	bl	_sysconf
	cmp	x0, #0
	b.gt	Lsri_have_page
	mov	x0, #16384
Lsri_have_page:
	mov	x20, x0
	adrp	x8, _silica_rt_stack_page@PAGE
	add	x8, x8, _silica_rt_stack_page@PAGEOFF
	str	x20, [x8]
	str	xzr, [sp, #32]
	mov	x8, #8
	str	x8, [sp, #40]
	adrp	x0, L_srt_hw_memsize@PAGE
	add	x0, x0, L_srt_hw_memsize@PAGEOFF
	add	x1, sp, #32
	add	x2, sp, #40
	mov	x3, xzr
	mov	x4, xzr
	bl	_sysctlbyname
	ldr	x9, [sp, #32]
	str	x9, [sp, #88]
	str	xzr, [sp, #48]
	mov	x8, #32
	str	x8, [sp, #80]
	adrp	x0, L_srt_vm_swapusage@PAGE
	add	x0, x0, L_srt_vm_swapusage@PAGEOFF
	add	x1, sp, #48
	add	x2, sp, #80
	mov	x3, xzr
	mov	x4, xzr
	bl	_sysctlbyname
	cbz	w0, Lsri_swap_ok
	str	xzr, [sp, #48]
Lsri_swap_ok:
	ldr	x9, [sp, #88]
	ldr	x10, [sp, #48]
	add	x9, x9, x10
	cbnz	x9, Lsri_have_total
	mov	x9, #1
	lsl	x9, x9, #34
Lsri_have_total:
	sub	x10, x20, #1
	add	x9, x9, x10
	bic	x9, x9, x10
	adrp	x8, _silica_rt_stack_default_reserve@PAGE
	add	x8, x8, _silica_rt_stack_default_reserve@PAGEOFF
	str	x9, [x8]
	mov	x8, #1
	str	x8, [x19]
Lsri_done:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #96
	ret
	.globl	_silica_rt_stack_prefix_for
	.p2align	2
_silica_rt_stack_prefix_for:
; X0 = bytes to keep -> X0 = the smallest chunk-sequence prefix sum >= X0, X1 = the chunk after it.
	adrp	x8, _silica_rt_stack_page@PAGE
	add	x8, x8, _silica_rt_stack_page@PAGEOFF
