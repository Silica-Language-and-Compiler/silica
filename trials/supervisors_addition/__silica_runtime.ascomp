	mov	x0, x19
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
L_arena_ensure_fail:
	mov	x0, xzr
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
