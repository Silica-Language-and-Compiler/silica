LBBrd_cscan:
	ldr	x11, [x9, #8]
	cmp	x11, x0
	b.eq	LBBrd_canonical
	add	x9, x9, #16
	subs	w10, w10, #1
	b.ne	LBBrd_cscan
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	str	x21, [sp, #-16]!
	mov	x19, x0
	ldr	x20, [x19, #16]
LBBrd_loop:
	cbz	x20, LBBrd_hdr
	ldr	x21, [x20, #16]
	sub	x0, x20, #16
	bl	_free
	mov	x20, x21
	b	LBBrd_loop
LBBrd_hdr:
	sub	x0, x19, #16
	bl	_free
	ldr	x21, [sp], #16
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
LBBrd_ret:
	ret
LBBrd_canonical:
; Deliberate no-op: the canonical arena stays registered and usable by its key.
	ret
	.globl	_silica_rt_region_mark
_silica_rt_region_mark:
	adrp	x16, _silica_rt_region_list@PAGE
	add	x16, x16, _silica_rt_region_list@PAGEOFF
	ldr	x16, [x16]
	ret
	.globl	_silica_rt_region_release_to
_silica_rt_region_release_to:
	stp	x29, x30, [sp, #-16]!
