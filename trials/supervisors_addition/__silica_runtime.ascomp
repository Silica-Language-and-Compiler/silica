; sixteenths, down to half of the default.
	adrp	x8, _silica_rt_stack_default_reserve@PAGE
	add	x8, x8, _silica_rt_stack_default_reserve@PAGEOFF
	ldr	x9, [x8]
	lsr	x10, x9, #4
	sub	x11, x23, #1
	add	x10, x10, x11
	bic	x10, x10, x11
	sub	x22, x22, x10
	lsr	x9, x9, #1
	cmp	x22, x9
	b.lo	Lasr_fail
	b	Lasr_try
Lasr_mapped:
	str	x0, [x19, #272]
	str	x22, [x19, #280]
	str	xzr, [x19, #288]
	str	xzr, [x19, #296]
	str	x23, [x19, #304]
	str	x21, [x19, #312]
	str	xzr, [x19, #320]
	str	xzr, [x19, #328]
	str	xzr, [x19, #336]
	str	xzr, [x19, #344]
	str	xzr, [x19, #352]
	and	x9, x20, #0xfffffffffffffff0
	orr	x9, x9, x21
	str	x9, [x19, #360]
	str	xzr, [x19, #368]
	str	x24, [x19, #376]
	str	xzr, [x19, #384]
	cmp	x21, #3
	b.ne	Lasr_no_ring
	mov	w0, #32
	mov	w1, #8
	bl	_calloc
	str	x0, [x19, #328]
Lasr_no_ring:
	mov	x0, xzr
	b	Lasr_ret
Lasr_fail:
	str	xzr, [x19, #272]
	mov	x0, #1
Lasr_ret:
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	_silica_rt_actor_altstack_install
	.p2align	2
_silica_rt_actor_altstack_install:
; X0 = ACB. Every actor thread faults with SP inside its own inaccessible reservation, so the
; handler needs an alternate stack of its own on this thread.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	mov	x0, xzr
	mov	x1, #65536
	mov	w2, #3
	movz	w3, #0x1002
	mov	w4, #-1
	mov	x5, xzr
	bl	_mmap
	cmn	x0, #1
	b.eq	Lsai_ret
	str	x0, [x19, #352]
	str	x0, [sp, #24]
	mov	x8, #65536
	str	x8, [sp, #32]
	str	wzr, [sp, #40]
	add	x0, sp, #24
	mov	x1, xzr
	bl	_sigaltstack
Lsai_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_actor_stack_free
	.p2align	2
_silica_rt_actor_stack_free:
; X0 = ACB, X1 = 1 when called on the alt stack (keep it mapped). Unmaps the reservation.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	ldr	x0, [x19, #272]
	cbz	x0, Lsaf_alt
	ldr	x1, [x19, #280]
	bl	_munmap
	str	xzr, [x19, #272]
Lsaf_alt:
	cbnz	x20, Lsaf_ring
	ldr	x0, [x19, #352]
	cbz	x0, Lsaf_ring
	mov	x1, #65536
	bl	_munmap
	str	xzr, [x19, #352]
Lsaf_ring:
	ldr	x0, [x19, #328]
	cbz	x0, Lsaf_done
	bl	_free
	str	xzr, [x19, #328]
Lsaf_done:
	str	xzr, [x19, #288]
	str	xzr, [x19, #320]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_stack_grow_to
	.p2align	2
_silica_rt_stack_grow_to:
; X0 = ACB, X1 = faulting address inside the reservation. Commits chunks below the committed run
; until the address is covered. X0 = 0 grown, 1 the lowered reservation is exhausted, 2 the host
; refused the commit, 3 the address was already committed (not stack growth).
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	str	x23, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	mov	x23, xzr
Lsgt_loop:
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	ldr	x10, [x19, #288]
	sub	x21, x9, x10
	cmp	x20, x21
