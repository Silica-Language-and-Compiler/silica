	sub	x0, x21, x22
	mov	x1, x22
	mov	w2, #3
	bl	_mprotect
	cbnz	w0, Lsgt_commit_failed
	mov	x23, #1
	ldr	x10, [x19, #288]
	add	x10, x10, x22
	str	x10, [x19, #288]
	ldr	x11, [x19, #296]
	cmp	x10, x11
	b.ls	Lsgt_no_hw
	str	x10, [x19, #296]
Lsgt_no_hw:
	ldr	x11, [x19, #304]
	movz	x12, #0x10, lsl #16
	cmp	x11, x12
	b.hs	Lsgt_loop
	lsl	x11, x11, #1
	str	x11, [x19, #304]
	b	Lsgt_loop
Lsgt_covered:
	cbz	x23, Lsgt_not_ours
	mov	x0, xzr
	b	Lsgt_ret
Lsgt_not_ours:
	mov	x0, #3
	b	Lsgt_ret
Lsgt_exhausted:
	mov	x0, #1
	b	Lsgt_ret
Lsgt_commit_failed:
	mov	x0, #2
Lsgt_ret:
	ldr	x23, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	_silica_rt_stack_measure
	.p2align	2
_silica_rt_stack_measure:
; X0 = ACB -> X0 = bytes from the top down to the lowest page holding a nonzero word (0 = none).
	ldr	x8, [x0, #272]
	ldr	x9, [x0, #280]
	add	x9, x8, x9
	ldr	x10, [x0, #288]
	sub	x11, x9, x10
	adrp	x12, _silica_rt_stack_page@PAGE
	add	x12, x12, _silica_rt_stack_page@PAGEOFF
	ldr	x12, [x12]
Lsm_page:
	cmp	x11, x9
	b.hs	Lsm_none
	mov	x13, x11
	add	x14, x11, x12
Lsm_word:
	ldp	x15, x16, [x13], #16
	orr	x15, x15, x16
	cbnz	x15, Lsm_found
	cmp	x13, x14
	b.lo	Lsm_word
	mov	x11, x14
	b	Lsm_page
Lsm_found:
	sub	x0, x9, x11
	ret
Lsm_none:
	mov	x0, xzr
	ret
	.globl	_silica_rt_stack_release_to
	.p2align	2
_silica_rt_stack_release_to:
; X0 = ACB, X1 = bytes to keep, X2 = bytes at the top the last message used (zeroed if kept).
; Releases whole chunks below the smallest chunk prefix that covers X1, in the sizes they grew by.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x21, x2
	mov	x0, x1
	cbz	x0, Lsrt_zero_keep
	bl	_silica_rt_stack_prefix_for
	b	Lsrt_have
Lsrt_zero_keep:
	mov	x0, xzr
	adrp	x8, _silica_rt_stack_page@PAGE
	add	x8, x8, _silica_rt_stack_page@PAGEOFF
	ldr	x1, [x8]
Lsrt_have:
	mov	x20, x0
	mov	x22, x1
	ldr	x10, [x19, #288]
	cmp	x20, x10
	b.hs	Lsrt_zero
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	sub	x0, x9, x10
	sub	x1, x10, x20
	mov	w2, #0
	movz	w3, #0x1052
	mov	w4, #-1
	mov	x5, xzr
	bl	_mmap
	str	x20, [x19, #288]
	str	x22, [x19, #304]
	cbnz	x20, Lsrt_zero
	ldr	x0, [x19, #352]
	cbz	x0, Lsrt_zero
	mov	x1, #65536
	mov	w2, #7
	bl	_madvise
Lsrt_zero:
	ldr	x10, [x19, #288]
	str	x10, [x19, #320]
	cbz	x21, Lsrt_ret
	cmp	x21, x10
	csel	x21, x10, x21, hi
	cbz	x21, Lsrt_ret
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	sub	x0, x9, x21
	mov	x1, xzr
	mov	x2, x21
	bl	_memset
Lsrt_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_stack_on_message_return
	.p2align	2
_silica_rt_stack_on_message_return:
; X0 = ACB. The behavior has returned and the stack is empty: apply the actor's release algorithm.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	ldr	x8, [x19, #272]
	cbz	x8, Lsmr_ret
	ldr	x9, [x19, #312]
	cmp	x9, #5
	b.eq	Lsmr_keep_all
	cmp	x9, #4
	b.eq	Lsmr_idle_stamp
	cmp	x9, #1
	b.eq	Lsmr_release_all
	mov	x0, x19
	bl	_silica_rt_stack_measure
	mov	x20, x0
	ldr	x9, [x19, #312]
	cmp	x9, #3
	b.ne	Lsmr_keep_depth
	ldr	x10, [x19, #328]
	cbz	x10, Lsmr_keep_depth
	ldr	x11, [x19, #336]
	and	x12, x11, #31
	str	x20, [x10, x12, lsl #3]
	add	x11, x11, #1
	str	x11, [x19, #336]
	mov	x12, xzr
	mov	x21, xzr
Lsmr_ring_max:
	ldr	x13, [x10, x12, lsl #3]
	cmp	x13, x21
	csel	x21, x13, x21, hi
	add	x12, x12, #1
	cmp	x12, #32
	b.lo	Lsmr_ring_max
	b	Lsmr_release_keep
Lsmr_keep_depth:
	mov	x21, x20
Lsmr_release_keep:
	mov	x0, x19
	mov	x1, x21
	mov	x2, x20
	bl	_silica_rt_stack_release_to
	b	Lsmr_ret
Lsmr_keep_all:
	ldr	x10, [x19, #288]
	str	x10, [x19, #320]
	b	Lsmr_ret
Lsmr_idle_stamp:
	ldr	x10, [x19, #288]
	str	x10, [x19, #320]
	bl	_silica_rt_stack_now_ns
	str	x0, [x19, #344]
	b	Lsmr_ret
Lsmr_release_all:
	mov	x0, x19
	mov	x1, xzr
	mov	x2, xzr
	bl	_silica_rt_stack_release_to
Lsmr_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_stack_idle_check
	.p2align	2
_silica_rt_stack_idle_check:
; X0 = ACB -> X0 = mailbox wait timeout in microseconds (0 = wait without a timeout). Only
; :release_when_idle actors holding committed stack wait with a timeout; once a second has passed
; since the last message the stack is released and the wait becomes untimed.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	ldr	x9, [x19, #312]
	cmp	x9, #4
	b.ne	Lsic_none
	ldr	x10, [x19, #288]
	cbz	x10, Lsic_none
	bl	_silica_rt_stack_now_ns
	ldr	x11, [x19, #344]
	sub	x12, x0, x11
	movz	x13, #0xCA00
	movk	x13, #0x3B9A, lsl #16
	cmp	x12, x13
	b.lo	Lsic_wait
	mov	x0, x19
	mov	x1, xzr
	mov	x2, xzr
	bl	_silica_rt_stack_release_to
	b	Lsic_none
Lsic_wait:
	sub	x12, x13, x12
	mov	x13, #1000
	udiv	x0, x12, x13
	add	x0, x0, #1
	b	Lsic_ret
Lsic_none:
	mov	x0, xzr
Lsic_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_cv_wait_timeout
	.p2align	2
_silica_rt_cv_wait_timeout:
; X0 = cv_addr, X1 = lock_addr, X2 = timeout in microseconds (0 = none). Caller holds the lock;
; the lock is held again on return, whether woken or timed out.
	stp	x29, x30, [sp, #-48]!
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	add	x29, sp, #0
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	ldr	w22, [x19]
	mov	x0, x20
	bl	_os_unfair_lock_unlock
	mov	w0, #3
	mov	x1, x19
	mov	x2, x22
	mov	w3, w21
	bl	___ulock_wait
	mov	x0, x20
	bl	_os_unfair_lock_lock
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_actor_fail_current
	.p2align	2
_silica_rt_actor_fail_current:
; X0 = the current actor's ACB, X1 = reason atom. Ends the actor with (:explicit, atom): wakes its
; waiters, delivers the exit to its supervisor, frees what it owns and exits the thread. Runs on the
; signal alt stack (stack exhaustion) or on the actor stack (a spawn whose reservation failed).
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	str	x1, [x19, #384]
; Move onto the thread's alt stack (its top; nothing there is needed again) so the actor stack
; this may be running on can be unmapped now. On the exhaustion path we are already there.
; The stack is given back before any waiter is woken, as at a message boundary: a caller that
; wakes on the death and asks get_actor_memory_usage must already see the reservation gone.
	ldr	x9, [x19, #352]
	cbz	x9, Lafc_on_stack
	mov	x10, #65536
	add	x9, x9, x10
	mov	sp, x9
Lafc_on_stack:
	mov	x0, x19
	mov	x1, #1
	bl	_silica_rt_actor_stack_free
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x8, #4
	str	x8, [x19, #232]
	str	wzr, [x19, #152]
	add	x0, x19, #80
	bl	_silica_rt_cv_signal
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x8, [x19, #216]
	cbz	x8, Lsbg_5
	ldr	x8, [x8, #40]
Lsbg_5:
	cbnz	x8, Lafc_report_done
	mov	x0, x19
	bl	_silica_rt_actor_deliver_exit
	mov	x0, x19
	bl	_silica_rt_actor_deliver_unwind_report
Lafc_report_done:
	mov	x0, x19
	bl	_silica_rt_actor_signal_pending_call_deaths
	ldr	x20, [x19, #208]
	ldr	x21, [x19, #192]
	cbz	x21, Lafc_thread_exit
	mov	x0, x19
	bl	_silica_rt_ffi_arena_teardown
	mov	x0, x19
	bl	_silica_rt_child_table_free
	mov	x0, x19
	bl	_silica_rt_actor_dealloc_region
	mov	x0, x19
	bl	_free
	cbz	x20, Lafc_thread_exit
	mov	x9, #1
	str	x9, [x20, #56]
Lafc_thread_exit:
	mov	x0, xzr
	bl	_pthread_exit
	b	Lafc_thread_exit
	.globl	_silica_rt_spawn_reserve_failed
	.p2align	2
_silica_rt_spawn_reserve_failed:
; A spawn could not make its reservation. The spawning actor fails with
; (:explicit, :stack_reserve_failed). `main` is not an actor and has no supervisor, so there the
; process ends with a runtime abort, reason stack reservation failed, status 71 (spec §15.1.2.2,
; §15.4.5.5), reported at the spawn routine's call to this function. Never returns.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, Lsrf_main
	adrp	x8, _silica_rt_stack_reserve_failed_atom@PAGE
	add	x8, x8, _silica_rt_stack_reserve_failed_atom@PAGEOFF
	ldr	x1, [x8]
	bl	_silica_rt_actor_fail_current
Lsrf_main:
	ldp	x29, x30, [sp], #16
	b	_silica_rt_abort_stack_reserve
	.globl	_silica_rt_get_actor_memory_usage
	.p2align	2
_silica_rt_get_actor_memory_usage:
; X0 = actor_ref -> X0 = heap { reserved, committed, retained, high_water } (bytes; all zero once
; the actor has ended).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	mov	x0, #40
	bl	_malloc
	cbz	x0, Lgmu_ret
	movz	x8, #1, lsl #16
	movk	x8, #7
	str	x8, [x0]
	cmp	x19, #4096
	b.lo	Lgmu_zero
	ldr	x8, [x19, #272]
	cbz	x8, Lgmu_zero
	ldr	x8, [x19, #280]
	str	x8, [x0, #8]
	ldr	x8, [x19, #288]
	str	x8, [x0, #16]
	ldr	x8, [x19, #320]
	str	x8, [x0, #24]
	ldr	x8, [x19, #296]
	str	x8, [x0, #32]
	b	Lgmu_ret
Lgmu_zero:
	str	xzr, [x0, #8]
	str	xzr, [x0, #16]
	str	xzr, [x0, #24]
	str	xzr, [x0, #32]
Lgmu_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret

