	.globl	_silica_rt_actor_failure_reason_tag
	.p2align	2
_silica_rt_actor_failure_reason_tag:    ; X0=payload ptr -> X0=int64 reason_tag (0 :normal)
	.cfi_startproc
	cbz	x0, Lfrt_zero
	ldr	x0, [x0, #8]
	ret
Lfrt_zero:
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_reason_atom
	.p2align	2
_silica_rt_actor_failure_reason_atom:   ; X0=payload ptr -> X0=atom failure_reason variant
	.cfi_startproc
	cbz	x0, Lfra_unknown
	ldr	x8, [x0, #8]
	cbz	x8, Lfra_normal
	cmp	x8, #2
	b.eq	Lfra_language_error
	cmp	x8, #3
	b.eq	Lfra_memory_fault
	cmp	x8, #4
	b.eq	Lfra_explicit
	cmp	x8, #5
	b.eq	Lfra_foreign_fault
	b	Lfra_unknown
Lfra_normal:
	mov	x0, #3
	ret
Lfra_language_error:
	mov	x0, #4
	ret
Lfra_memory_fault:
	mov	x0, #5
	ret
Lfra_explicit:
	mov	x0, #6
	ret
Lfra_foreign_fault:
	mov	x0, #-1
	ret
Lfra_unknown:
	mov	x0, #7
	ret
	.cfi_endproc
                                        ; -- End function
