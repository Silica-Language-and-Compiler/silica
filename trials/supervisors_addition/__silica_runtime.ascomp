	cbz	x8, Lkab_not_found
	ldr	x9, [x8]
	cbz	x9, Lkab_not_found
	ldr	x10, [x9, x11, lsl #3]
	cmp	x10, #1
	b.ne	Lkab_not_found
	add	x9, x9, x13, lsl #3
	ldr	x0, [x9, x11, lsl #3]
	cbz	x0, Lkab_not_found
	b	Lkab_resolved
Lkab_use_direct:
