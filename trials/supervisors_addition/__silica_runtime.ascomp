	add	x10, x10, x9
	cmp	x9, x11
	b.hs	Lspf_loop
	lsl	x9, x9, #1
	b	Lspf_loop
Lspf_done:
	mov	x0, x10
	mov	x1, x9
	ret
	.globl	_silica_rt_stack_now_ns
	.p2align	2
_silica_rt_stack_now_ns:
	stp	x29, x30, [sp, #-32]!
