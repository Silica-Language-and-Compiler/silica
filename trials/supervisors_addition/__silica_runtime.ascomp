	add	x1, x1, #16384
	mov	x2, #3
	mov	x3, #4098
	mov	x4, #-1
	mov	x5, xzr
	bl	_mmap
	cmn	x0, #1
	b.eq	L_arena_ensure_fail
	cbz	x0, L_arena_ensure_fail
	mov	x8, x0
	add	x9, x8, #262144
	stp	x8, x9, [sp, #-16]!
	mov	x0, x9
	mov	x1, #16384
	mov	x2, xzr
	bl	_mprotect
	ldp	x8, x9, [sp], #16
	str	x8, [x19, #248]
	str	x9, [x19, #256]
	str	x8, [x19, #264]
