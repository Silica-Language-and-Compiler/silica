	adrp	x12, _silica_rt_canonical_arena_table@PAGE
	add	x12, x12, _silica_rt_canonical_arena_table@PAGEOFF
	add	x12, x12, x11
	ldr	x13, [x12]
	cbz	x13, Lcal_insert
	cmp	x13, x19
	b.eq	Lcal_found
	add	w8, w8, #1
	cmp	w8, w20
	csel	w8, wzr, w8, eq
	add	w21, w21, #1
