	add	x0, x0, x1
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_actor_stack_reserve
	.p2align	2
_silica_rt_actor_stack_reserve:
; X0 = ACB, X1 = packed stack_policy (0 = inherit the spawning actor's, else the default with
; :keep_last_message). Returns X0 = 0 on success, 1 when no reservation could be made.
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	bl	_silica_rt_stack_runtime_init
	cbnz	x20, Lasr_have_policy
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, Lasr_default_policy
	ldr	x20, [x0, #360]
	cbnz	x20, Lasr_have_policy
Lasr_default_policy:
	mov	x20, #2
Lasr_have_policy:
	and	x21, x20, #0xf
	cbnz	x21, Lasr_alg_ok
	mov	x21, #2
Lasr_alg_ok:
	and	x22, x20, #0xfffffffffffffff0
	adrp	x8, _silica_rt_stack_page@PAGE
	add	x8, x8, _silica_rt_stack_page@PAGEOFF
	ldr	x23, [x8]
	mov	x24, xzr
	cbz	x22, Lasr_default
	mov	x24, #1
	sub	x9, x23, #1
	add	x22, x22, x9
	bic	x22, x22, x9
	b	Lasr_try
Lasr_default:
	adrp	x8, _silica_rt_stack_default_reserve@PAGE
	add	x8, x8, _silica_rt_stack_default_reserve@PAGEOFF
	ldr	x22, [x8]
Lasr_try:
	mov	x0, xzr
	mov	x1, x22
	mov	w2, #0
	movz	w3, #0x1042
	mov	w4, #-1
	mov	x5, xzr
	bl	_mmap
	cmn	x0, #1
	b.ne	Lasr_mapped
