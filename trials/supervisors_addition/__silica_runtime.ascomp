	str	x1, [x0, #8]
	str	x0, [x20, #160]
	add	x9, x0, x1
	str	x9, [x20, #184]
	ldr	x10, [x20, #168]
	add	x10, x10, x1
	str	x10, [x20, #168]
	add	x8, x0, #16
	add	x10, x8, x19
	str	x10, [x20, #176]
