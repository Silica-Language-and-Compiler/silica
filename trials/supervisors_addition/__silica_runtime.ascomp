	.globl	_silica_rt_wait_for_exit
	.p2align	2
_silica_rt_wait_for_exit:               ; §15.1.2.5 - returns 0 for a stdin line e-x-i-t, or the value of the
	.cfi_startproc                      ; first recorded cast_exit; main then continues. At the end of stdin
	stp	x29, x30, [sp, #-80]!       ; only the exit pipe is watched; the wait does not end on idleness.
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
; Layout: fd_set 128 B @0, timeval 16 B @128, line buf 256 B @144, scratch @400 -- 416 B total.
; poll(2) on macOS often never signals POLLIN for tty stdin; select(2) is reliable (Phase I trial / interactive main).
; x19 = 1 while standard input is still read (0 after its end), x20 = line length, x22 = exit pipe read end.
	sub	sp, sp, #416
	mov	x20, xzr
	mov	x19, #1
	adrp	x22, _silica_rt_exit_pipe@PAGE
	add	x22, x22, _silica_rt_exit_pipe@PAGEOFF
	ldr	w22, [x22]
Lwi_loop:
	mov	x0, sp
	mov	x1, xzr
	mov	x2, #128
	bl	_memset
	cbz	x19, Lwi_set_pipe
	ldr	w8, [sp]
	orr	w8, w8, #0x1
	str	w8, [sp]
Lwi_set_pipe:
	lsr	x9, x22, #3
	and	x10, x22, #7
	mov	w11, #1
	lsl	w11, w11, w10
	add	x9, sp, x9
	ldrb	w8, [x9]
	orr	w8, w8, w11
	strb	w8, [x9]
	str	xzr, [sp, #128]
	movz	w9, #0xd090
	movk	w9, #3, lsl #16
	str	w9, [sp, #136]
	add	w0, w22, #1
	mov	x1, sp
	mov	x2, xzr
	mov	x3, xzr
	add	x4, sp, #128
	bl	_select
	cmp	w0, #-1
	b.eq	Lwi_select_sleep
	cmp	w0, #0
	b.eq	Lwi_loop
; The exit pipe is readable once a cast_exit request is recorded: return its value.
	lsr	x9, x22, #3
	and	x10, x22, #7
	add	x9, sp, x9
	ldrb	w8, [x9]
	lsr	w8, w8, w10
	tbnz	w8, #0, Lwi_cast_exit
	cbz	x19, Lwi_loop
	ldr	w8, [sp]
	tbz	w8, #0, Lwi_loop
	cmp	x20, #255
	b.hs	Lwi_overflow_discard
	add	x21, sp, #144
	add	x21, x21, x20
	mov	x0, xzr
	mov	x2, #1
	mov	x1, x21
	bl	_read
	cmp	x0, #0
	b.ne	Lwi_line_read_nz
	mov	x19, xzr
	b	Lwi_loop
Lwi_line_read_nz:
	cmp	x0, #1
	b.ne	Lwi_select_sleep
	ldrb	w9, [x21]
	cmp	w9, #10
	b.eq	Lwi_line_done
	strb	w9, [x21]
	add	x20, x20, #1
	b	Lwi_loop
Lwi_line_done:
Lwi_trim_cr:
	cmp	x20, #0
	b.le	Lwi_cmp_exit
	sub	x21, x20, #1
	add	x9, sp, #144
	ldrb	w9, [x9, x21]
	cmp	w9, #13
	b.ne	Lwi_cmp_exit
	mov	x20, x21
	b	Lwi_trim_cr
Lwi_cmp_exit:
	cmp	x20, #4
	b.ne	Lwi_line_reset
	add	x21, sp, #144
	ldrb	w9, [x21]
	cmp	w9, #101
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #1]
	cmp	w9, #120
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #2]
	cmp	w9, #105
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #3]
	cmp	w9, #116
	b.ne	Lwi_line_reset
	b	Lwi_process_exit
Lwi_line_reset:
	mov	x20, xzr
	b	Lwi_loop
Lwi_overflow_discard:
	mov	x0, xzr
	add	x1, sp, #400
	mov	x2, #1
	bl	_read
	cmp	x0, #0
	b.ne	Lwi_overflow_read_nz
	mov	x19, xzr
	b	Lwi_loop
Lwi_overflow_read_nz:
	cmp	x0, #1
	b.ne	Lwi_select_sleep
	ldrb	w9, [sp, #400]
	cmp	w9, #10
	b.eq	Lwi_overflow_reset
	b	Lwi_overflow_discard
Lwi_overflow_reset:
	mov	x20, xzr
	b	Lwi_loop
Lwi_select_sleep:
	mov	x0, xzr
	mov	w1, wzr
	mov	w2, #100
	bl	_poll
	b	Lwi_loop
Lwi_cast_exit:
	adrp	x9, _silica_rt_exit_request@PAGE
	add	x9, x9, _silica_rt_exit_request@PAGEOFF
	ldar	x0, [x9]
	b	Lwi_return
Lwi_process_exit:
	mov	x0, xzr
Lwi_return:
	add	sp, sp, #416
	ldp	x19, x20, [sp, #16]
	ldp	x21, x22, [sp, #32]
	ldp	x29, x30, [sp], #80
	ret
	.cfi_endproc
; §15.1.2.5 runtime start: no exit request yet (flag 0) and a private close-on-exec pipe from cast_exit to
; wait_for_exit. Called from _silica_pid_registry_init before any actor exists.
	.globl	_silica_rt_exit_request_init
	.p2align	2
_silica_rt_exit_request_init:
	.cfi_startproc
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	adrp	x9, _silica_rt_exit_flag@PAGE
	add	x9, x9, _silica_rt_exit_flag@PAGEOFF
	str	xzr, [x9]
	adrp	x9, _silica_rt_exit_request@PAGE
	add	x9, x9, _silica_rt_exit_request@PAGEOFF
	str	xzr, [x9]
	adrp	x19, _silica_rt_exit_pipe@PAGE
	add	x19, x19, _silica_rt_exit_pipe@PAGEOFF
	mov	x0, x19
	bl	_pipe
; fcntl(fd, F_SETFD, FD_CLOEXEC) for both ends; the third argument is variadic, so Apple arm64 passes it on the stack.
	sub	sp, sp, #16
	mov	x8, #1
	str	x8, [sp]
	ldr	w0, [x19]
	mov	w1, #2
	mov	x2, #1
	bl	_fcntl
	mov	x8, #1
	str	x8, [sp]
	ldr	w0, [x19, #4]
	mov	w1, #2
	mov	x2, #1
	bl	_fcntl
	add	sp, sp, #16
	mov	x0, #0
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.cfi_endproc
; §15.1.2.5 cast_exit(value: int64) -> boolean. X0 = value. Compare-and-swap _silica_rt_exit_flag from 0 to 1:
; the winner stores its value in _silica_rt_exit_request (release), writes one byte to the exit pipe so main's
; wait_for_exit wakes and returns that value, and returns 1. A later request returns 0 and changes nothing. Any
; actor thread may call this; nothing here allocates.
	.globl	_silica_rt_cast_exit
	.p2align	2
_silica_rt_cast_exit:
	.cfi_startproc
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x0, [sp, #16]
	adrp	x1, _silica_rt_exit_flag@PAGE
	add	x1, x1, _silica_rt_exit_flag@PAGEOFF
	mov	x4, #1
Lce_cas:
	ldaxr	x2, [x1]
	cbnz	x2, Lce_lost
	stlxr	w3, x4, [x1]
	cbnz	w3, Lce_cas
	adrp	x1, _silica_rt_exit_request@PAGE
	add	x1, x1, _silica_rt_exit_request@PAGEOFF
	stlr	x0, [x1]
	adrp	x1, _silica_rt_exit_pipe@PAGE
	add	x1, x1, _silica_rt_exit_pipe@PAGEOFF
	ldr	w0, [x1, #4]
	add	x1, sp, #16
	mov	x2, #1
	bl	_write
	mov	x0, #1
	ldp	x29, x30, [sp], #32
	ret
Lce_lost:
	clrex
	mov	x0, #0
	ldp	x29, x30, [sp], #32
	ret
	.cfi_endproc
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_actor_deliver_exit   ; Phase C — §15.4.10 unified delivery
	.p2align	2
_silica_rt_actor_deliver_exit:          ; X0=child self; X0 out: 0 delivered, 1 drop (no sup / dead / OOM)
	.cfi_startproc
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0
; §20.3.1: the registered name goes before the exit reaches the supervisor, on every exit path.
	bl	_silica_rt_registry_forget_actor
	ldr	x20, [x19, #192]
	cbz	x20, Lde_nosup
	mov	w0, #1
	mov	w1, #32
	bl	_calloc
	cbz	x0, Lde_nosup
	mov	x21, x0
	str	x19, [x21]
	ldr	x9, [x19, #232]
	str	x9, [x21, #8]
	ldr	x9, [x19, #384]
	str	x9, [x21, #16]
	ldr	x8, [x19, #200]
	str	x8, [x21, #24]
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	ldr	w9, [x20, #152]
	cbz	w9, Lde_dead
	mov	x0, x20
	bl	_silica_rt_sb_require
	ldr	w9, [x0, #16]
	cmp	w9, #1024
	b.hs	Lde_abort
	mov	w0, #1
	mov	w1, #152
	bl	_calloc
	cbz	x0, Lde_dead
	mov	x22, x0
	str	x21, [x22, #8]
	str	wzr, [x22, #16]
	ldr	x0, [x20, #216]
	mov	x1, x22
	bl	_silica_rt_q_enqueue_locked
	ldr	x8, [x20, #216]
	ldr	w9, [x8, #16]
	add	w9, w9, #1
	str	w9, [x8, #16]
	add	x0, x20, #80
	bl	_silica_rt_cv_signal
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x0, #0
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lde_dead:
	mov	x0, x21
	bl	_free
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x0, #1
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lde_nosup:
	mov	x0, #1
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lde_abort:
	bl	_silica_rt_abort_exit_queue_full
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_supervision_wait_and_drain_one ; Phase C trial accessor — behavior-only
	.p2align	2
_silica_rt_actor_supervision_wait_and_drain_one:
	.cfi_startproc
; No args; returns X0 = failure payload pointer dequeued from self's supervision ingress, blocks until one is available.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	cbz	x19, Lswd_null
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
Lswd_try:
	ldr	x0, [x19, #216]
	cbz	x0, Lswd_wait
	bl	_silica_rt_q_dequeue_locked
	cbz	x0, Lswd_wait
	mov	x20, x0
	ldr	x8, [x19, #216]
	ldr	w9, [x8, #16]
	sub	w9, w9, #1
	str	w9, [x8, #16]
	ldr	x21, [x20, #8]
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
; Phase E: mirror LBB1_free (mutex must not be held — maybe_restart may spawn / take table locks). X2 = reason_tag (e4b).
	cbz	x21, Lswd_free_wrap
	ldr	x8, [x21]
	cbz	x8, Lswd_free_wrap
	mov	x0, x8
	mov	x1, x19
	ldr	x2, [x21, #8]
	bl	_silica_rt_supervisor_maybe_restart
Lswd_free_wrap:
	mov	x0, x20
	bl	_free
	mov	x0, x21
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lswd_wait:
; Phase E e4f: blocking pthread_cond_wait. Same rationale as in _silica_rt_actor_call /
; actor_thread_main wait paths — the 1 ms timedwait was a missed-signal band-aid that drove
; libpthread internal kwq malloc churn racing with new-actor TLS instantiation (mfm_alloc
; SIGBUS). All paths that enqueue a failure (LBB1_free's _silica_rt_actor_deliver_exit, etc.)
; signal sup#80 cond while holding sup#16 mutex, so plain cond_wait is correctly delivered.
