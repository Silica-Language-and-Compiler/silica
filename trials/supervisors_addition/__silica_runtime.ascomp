	add	x1, x19, #16
	bl	_silica_rt_cv_wait
	b	Lswd_try
Lswd_null:
	mov	x0, #0
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.cfi_endproc
