	ldr	x20, [x19, #208]
	ldr	x21, [x19, #192]
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x8, #1
	str	x8, [x19, #232]
	str	wzr, [x19, #152]
