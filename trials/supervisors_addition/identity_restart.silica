// Spec §15.1.4 Actor Identity under a supervisor: a root supervisor is a spawner with its own
// position; its children are numbered from 0 at that position; a restarted child gets the next
// number, so its identity differs from the old child's and sorts after it, and a child's name
// follows the replacement (§20.3.1 "Names across restarts").
// Child w has id :s1_rec_worker, child v has id :s1_tuple_worker, the supervisor is :s1_rec_sup:
// atoms already in this suite's table, so adding the trial renumbers no other trial's atoms.
// main waits for the three failure reports once, in wait_for_exit(), which the reporter ends with
// cast_exit(0) on the third report (no polling: every call reply stays on the heap while main runs).
// The c2 line and the three comparisons are taken before the crash but printed after that wait, so
// no report line lands inside them; the final wait_for_exit() then returns at once.
//
// Expected output (compared as a multiset: the failure reports are asynchronous):
//   rep <0.0>     main's first spawn
//   sup <0.1>     main's second spawn; the supervisor itself holds position 1   (position counter)
//   c1 <1.0>      child w, the supervisor's child number 0                      (position counter)
//   v1 <1.1>      child v, child number 1                                       (position counter)
//   100           call_registered(v's id, 2): 200 / 2
//   failure report: other    restart_child ends c1
//   c2 <1.2>      the restarted w gets the next number, 2                       (position counter)
//   true          c1 != c2
//   true          c1 < c2                                                       (child numbering)
//   true          get_child(w's id) == c2
//   failure report: other    v1 fails dividing by zero
//   failure report: reason_tag 4    the crasher's call(v1, 0) raises actor_not_found (§16.1.1)
//   v2 <1.3>      the restarted v gets number 3                                 (position counter)
//   false         v2 == v1: a replacement never equals the old reference
//   50            call_registered(v's id, 4): the name now reaches v2, 200 / 4
//   40            call(v2, 5): 200 / 5
//   done
//
// Position numbering: the lines marked (position counter) print position 1, which the runtime takes
// from a global run-time counter (the first spawner to get a position). The spec numbers positions at
// build time in tree order (§15.1.4 "Positions"); for a root supervisor started from straight-line
// main both give 1, but the run-time scheme is an open spec question.
// main never calls an actor that ends mid-call: v1 is crashed by a separate crasher actor that main
// casts to and that main spawns after the supervisor (child number 2 at position 0, so it takes no
// position and leaves the supervisor's numbering alone). v1 ends before replying to the crasher's
// call, so the call raises actor_not_found in the crasher (spec §16.1.1), which fails with
// (:explicit, :actor_not_found), reason_tag 4.

use Supervisor;

impl IdentityRestartSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state / msg, state)
}

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 3600 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            { id: :s1_rec_worker, agent_type: :worker, initial_state: 100, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :s1_tuple_worker, agent_type: :worker, initial_state: 200, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

// Calls the actor in its state with the message; when that actor ends before replying, the call
// raises actor_not_found and the crasher fails with reason_tag 4 (§16.1.1).
fn crasher(msg: int64, state: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        _: int64 <- call(state, msg impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn child_of(sup: supervisor_ref, id: atom) -> actor_ref {
    sequence
        g: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: id } impl SupervisorMessage {})
    produces
        pure g.child
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- start_reporter(3);
        sup: supervisor_ref <- spawn_registered_supervisor(IdentityRestartSup, 0, :s1_rec_sup, stack_policy(0, :keep_last_message));
        _: int64 <- print_id("rep", rep);
        i_sup: uint64 <- actor_id(sup);
        print("sup <");
        print_uint64(i_sup shr 32);
        print(".");
        print_uint64(i_sup band 4294967295);
        println(">");
        c1: actor_ref <- child_of(sup, :s1_rec_worker);
        v1: actor_ref <- child_of(sup, :s1_tuple_worker);
        _: int64 <- print_id("c1", c1);
        _: int64 <- print_id("v1", v1);
        r1: int64 <- call_registered(:s1_tuple_worker, 2 impl ActorMessage {});
        print_int64(r1);
        println("");
        rs: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(sup, { op: :restart_child, id: :s1_rec_worker } impl SupervisorMessage {});
        c2: actor_ref <- rs.child;
        // c1's failure report arrives while main runs on, so main prints nothing until its wait has
        // ended (a report line could land inside a line printed in pieces): the comparisons are taken
        // here and printed after the wait.
        differs: boolean <- c1 != c2;
        sorts_after: boolean <- c1 < c2;
        name_follows: boolean <- child_of(sup, :s1_rec_worker) == c2;
        k: actor_ref <- spawn(v1, crasher, stack_policy(0, :keep_last_message));
        _: boolean <- cast(k, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        _: int64 <- print_id("c2", c2);
        print_boolean(differs);
        println("");
        print_boolean(sorts_after);
        println("");
        print_boolean(name_follows);
        println("");
        v2: actor_ref <- child_of(sup, :s1_tuple_worker);
        _: int64 <- print_id("v2", v2);
        print_boolean(v2 == v1);
        println("");
        r2: int64 <- call_registered(:s1_tuple_worker, 4 impl ActorMessage {});
        print_int64(r2);
        println("");
        r3: int64 <- call(v2, 5 impl ActorMessage {});
        print_int64(r3);
        println("");
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

fn print_id(label: string, r: actor_ref) -> int64 {
    sequence proc[concurrency, device_io]
        i: uint64 <- actor_id(r);
        print(label);
        print(" <");
        print_uint64(i shr 32);
        print(".");
        print_uint64(i band 4294967295);
        println(">")
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

// The failure reporter prints one line per report. A FailureReporter is cast-only (spec §15.4.13.4),
// so main cannot ask it how many reports it has had. Instead its state counts down from the number of
// reports main waits for (start_reporter's argument), and the last of them ends main's single
// wait_for_exit() with cast_exit(0) (spec §15.1.2.5). main waits once and polls nothing, so no call
// reply piles up on the heap while main runs. The line is printed before the cast_exit, so no report
// line lands inside a line main prints.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print(report_kind(report));
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, left)
    end
}

fn report_kind(report: string) -> string {
    case contains(report, "reason_tag:      4") of {
        true -> "failure report: reason_tag 4\n";
        false -> "failure report: other\n"
    }
}

// The registry-polling version of this trial named these atoms here (and, in supervisors_addition,
// built the registry's { op, name, pid } message); atoms and record shapes are numbered per suite in
// first-use order, so this never-called function keeps them at the same place in the suite's tables
// and no later trial's numbering moves.
fn table_places(n: int64) -> atom {
    case n of {
        1 -> :start;
        2 -> :answer;
        _: int64 -> :request
    }
}

fn table_places_message(me: actor_ref) -> { op: atom, name: atom, pid: actor_ref } {
    { op: :delete, name: table_places(1), pid: me }
}

fn start_reporter(expected: int64) -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
