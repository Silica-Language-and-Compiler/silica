// A supervised child whose initial state is a tuple, restarted three times through
// call_supervisor :restart_child. Every spawn of the row hands the child its own copy of the
// spec's init (rt_supervisors.S ROW_INIT_BYTES; on the host the init lives in the supervisor's
// arena), so each restarted child answers 31 then 32 from (10, 20) again, and the previous
// child's changed state never leaks into the next.

impl CompositeInitRestartSup for Supervisor;

fn worker(msg: int64, state: (int64, int64)) -> (:reply, int64, (int64, int64)) {
    (a: int64, b: int64) <- state;
    (:reply, a + b + msg, (a + msg, b))
}

fn init(initial_state: (int64, int64)) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: (int64, int64), behavior: fn(msg: int64, state: (int64, int64)) -> (:reply, int64, (int64, int64)), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 20, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: (int64, int64), behavior: fn(msg: int64, state: (int64, int64)) -> (:reply, int64, (int64, int64)), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :composite_init_worker, agent_type: :worker, initial_state: initial_state, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn restart_n(sup: supervisor_ref, n: int64) -> int64 {
    sequence proc[concurrency]
        r: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :restart_child, id: :composite_init_worker } impl SupervisorMessage {});
        v1: int64 <- call(r.child, 1 impl ActorMessage {});
        v2: int64 <- call(r.child, 1 impl ActorMessage {});
        bad: int64 <- case v1 == 31 and v2 == 32 of {
            true -> 0;
            false -> 1
        };
        left: int64 <- case n == 1 of {
            true -> bad;
            false -> bad + restart_n(sup, n - 1)
        }
    produces
        pure left
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(CompositeInitRestartSup, (10, 20), :composite_init_restart_sup, stack_policy(0, :keep_last_message));
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: :composite_init_worker } impl SupervisorMessage {});
        first: int64 <- call(got.child, 5 impl ActorMessage {});
        bad: int64 <- restart_n(sup, 3);
        _: atom <- print_int64(first);
        println("");
        _: atom <- print_int64(bad);
        println("");
        println("done")
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
