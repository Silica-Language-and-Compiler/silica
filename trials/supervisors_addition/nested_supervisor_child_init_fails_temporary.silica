// A root supervisor whose only child is a :temporary nested supervisor
// (traits/NestedChildInitBadarithSup) whose init fails with badarith. The child's failure goes to the
// registered FailureReporter (reason_tag 1, printed as "failure report: child init badarith"); a
// :temporary child is not restarted, the root keeps running, spawn_registered_supervisor returns, and
// main casts "spawn returned" to the reporter, which prints it and "done". The report and the cast
// reach the reporter in either order (.scout.multiset); ESP32-S3_raw printed a root note
// until 16 Oct 2026, and prints none now (its .ESP32-S3_raw.scout = .scout).
// Atoms: :dup_add_top_sup and :dup_add_inner_sup are reused names already numbered earlier in
// supervisors_addition (the suite shares one atom table), so no other trial's atoms are renumbered.

use Supervisor;
use NestedChildInitBadarithSup;

impl NestedChildInitFailsRootSup for Supervisor;

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(initial_state: int64) -> (
                {
                    strategy: :one_for_one | :one_for_all | :rest_for_one,
                    allowed_restart_count: int64,
                    restarts_time_frame: int64
                },
                List[
                    {
                        id: atom,
                        agent_type: :worker | :supervisor,
                        initial_state: int64,
                        behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                        restart: :permanent | :temporary | :transient,
                        shutdown: int64,
                        flavor: :plain | :dangerous
                    },
                    mem(normal)
                ]
            ),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 2, restarts_time_frame: 3600 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(initial_state: int64) -> (
                    {
                        strategy: :one_for_one | :one_for_all | :rest_for_one,
                        allowed_restart_count: int64,
                        restarts_time_frame: int64
                    },
                    List[
                        {
                            id: atom,
                            agent_type: :worker | :supervisor,
                            initial_state: int64,
                            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                            restart: :permanent | :temporary | :transient,
                            shutdown: int64,
                            flavor: :plain | :dangerous
                        },
                        mem(normal)
                    ]
                ),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            {
                id: :dup_add_inner_sup,
                agent_type: :supervisor,
                initial_state: 0,
                behavior: NestedChildInitBadarithSup@NestedChildInitBadarithSup_child_start,
                restart: :temporary,
                shutdown: 0,
                flavor: :plain
            }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(NestedChildInitFailsRootSup, 0, :dup_add_top_sup, stack_policy(0, :keep_last_message));
        _: boolean <- cast(rep, "spawn returned" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn report_kind(report: string) -> string {
    case contains(report, "reason_tag:      1\n") of {
        true -> "failure report: child init badarith";
        false -> "failure report: other"
    }
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case contains(report, "=== Silica Actor Failure ===") of {
            true -> println(report_kind(report));
            false -> println(concat(report, "\ndone"))
        }
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
