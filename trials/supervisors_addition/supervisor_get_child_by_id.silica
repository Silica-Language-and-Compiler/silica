// call_supervisor { op: :get_child, id } answers with the child that has that id, not with the first
// live child. Three workers reply msg + state: :phase_e_decl_00 starts at 100, :phase_e_decl_01 at 200,
// :phase_e_decl_02 (:temporary) at 300. Asking for the second, the third, then the first child, and
// calling each with 1, prints 201, 301, true (the third child's child_info.restart is :temporary), 101.
// Atoms: the ids and the registered name are reused, already numbered earlier in supervisors_addition
// (the suite shares one atom table), so no other trial's atoms are renumbered.

use Supervisor;

impl GetChildByIdSup for Supervisor;

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 3600 };
        children: List[
            {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
            mem(normal)
        ] <- [
            { id: :phase_e_decl_00, agent_type: :worker, initial_state: 100, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :phase_e_decl_01, agent_type: :worker, initial_state: 200, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :phase_e_decl_02, agent_type: :worker, initial_state: 300, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(GetChildByIdSup, 0, :phase_e_decl_10_table_sup, stack_policy(0, :keep_last_message));
        b: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :phase_e_decl_01 } impl SupervisorMessage {});
        vb: int64 <- call(b.child, 1 impl ActorMessage {});
        print_int64(vb);
        println("");
        c: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :phase_e_decl_02 } impl SupervisorMessage {});
        vc: int64 <- call(c.child, 1 impl ActorMessage {});
        print_int64(vc);
        println("");
        print_boolean(c.child_info.restart == :temporary);
        println("");
        a: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :phase_e_decl_00 } impl SupervisorMessage {});
        va: int64 <- call(a.child, 1 impl ActorMessage {});
        print_int64(va);
        println("");
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn report_kind(report: string) -> string {
    case contains(report, "reason_tag:      1\n") of {
        true -> "failure report: reason_tag 1";
        false -> "failure report: other reason"
    }
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case contains(report, "=== Silica Actor Failure ===") of {
            true -> println(report_kind(report));
            false -> println(concat(report, "\ndone"))
        }
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
