// N2 of supervisors_addition/spawn_not_resumed_by_exit_notice: its init kills N1's worker (so N1
// ends while the root waits for this start), waits on a call to main's gate actor (:asker), then
// casts "n2 init finished" to the FailureReporter (:dup_caller). spawn must not return to the root
// before that. Atoms reuse names already numbered in this suite.
use Supervisor;

export SpawnNotResumedN2Sup_child_start/1;

impl SpawnNotResumedN2Sup for Supervisor;

// Cast-only, like N1's worker: the root's child-spec type is shared by N1 and N2.
fn quiet(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, msg + state)
}

fn init(initial_state: int64) -> ({
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    }, List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:no_reply, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)]) {
    sequence proc[mem(normal), concurrency]
        _k: boolean <- cast_registered(:dup_add_worker, 0 impl ActorMessage {});
        _c: int64 <- call_registered(:asker, "n2 init waiting" impl ActorMessage {});
        _d: boolean <- cast_registered(:dup_caller, "n2 init finished" impl ActorMessage {});
        flags: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
        children: List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:no_reply, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)] <- [
            { id: :s1_rec_worker, agent_type: :worker, initial_state: 0, behavior: quiet, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn SpawnNotResumedN2Sup_child_start(initial_state: int64) -> ({
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    }, List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:no_reply, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)]) {
    init(initial_state)
}
