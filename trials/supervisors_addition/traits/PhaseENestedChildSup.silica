// Helper supervisor for the Phase E nested-supervisor declarative trial.

use Supervisor;

export PhaseENestedChildSup_child_start/1;

impl PhaseENestedChildSup for Supervisor;

fn nested_worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state + 1)
}

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous, state_policy: state_policy
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 10, restarts_time_frame: 5 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous, state_policy: state_policy
            },
            mem(normal)
        ] <- [
            { id: :phase_e_nested_worker_00, agent_type: :worker, initial_state: initial_state + 0, behavior: nested_worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) },
            { id: :phase_e_nested_worker_01, agent_type: :worker, initial_state: initial_state + 1, behavior: nested_worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) },
            { id: :phase_e_nested_worker_02, agent_type: :worker, initial_state: initial_state + 2, behavior: nested_worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) },
            { id: :phase_e_nested_worker_03, agent_type: :worker, initial_state: initial_state + 3, behavior: nested_worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) },
            { id: :phase_e_nested_worker_04, agent_type: :worker, initial_state: initial_state + 4, behavior: nested_worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces
        pure (flags, children)
    end
}

fn PhaseENestedChildSup_child_start(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous, state_policy: state_policy
        },
        mem(normal)
    ]
) {
    init(initial_state)
}
