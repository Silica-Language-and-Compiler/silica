// The ten-worker child supervisor of supervisor_shutdown_reason_orderly: ten cast-only
// :temporary workers that never receive a message, so all ten are still running when the root's
// :terminate_child ends this supervisor. The first five (:phase_e_ofo_00..04) have shutdown 50, an
// orderly shutdown (reason (:explicit, :shutdown), reason_tag 4); the other five have shutdown 0.
// The child ids are atoms this suite already numbers ahead of this module
// (phase_e_decl_10_one_for_one_restart_child); a new atom would renumber the atom tables of the
// trials compiled after it.

use Supervisor;

export OrderlyShutdownTenSup_child_start/1;

impl OrderlyShutdownTenSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :phase_e_ofo_00, agent_type: :worker, initial_state: 1, behavior: worker, restart: :temporary, shutdown: 50, flavor: :plain },
            { id: :phase_e_ofo_01, agent_type: :worker, initial_state: 2, behavior: worker, restart: :temporary, shutdown: 50, flavor: :plain },
            { id: :phase_e_ofo_02, agent_type: :worker, initial_state: 3, behavior: worker, restart: :temporary, shutdown: 50, flavor: :plain },
            { id: :phase_e_ofo_03, agent_type: :worker, initial_state: 4, behavior: worker, restart: :temporary, shutdown: 50, flavor: :plain },
            { id: :phase_e_ofo_04, agent_type: :worker, initial_state: 5, behavior: worker, restart: :temporary, shutdown: 50, flavor: :plain },
            { id: :phase_e_ofo_05, agent_type: :worker, initial_state: 6, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :phase_e_ofo_06, agent_type: :worker, initial_state: 7, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :phase_e_ofo_07, agent_type: :worker, initial_state: 8, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :phase_e_ofo_08, agent_type: :worker, initial_state: 9, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :phase_e_ofo_09, agent_type: :worker, initial_state: 10, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn OrderlyShutdownTenSup_child_start(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    init(initial_state)
}
