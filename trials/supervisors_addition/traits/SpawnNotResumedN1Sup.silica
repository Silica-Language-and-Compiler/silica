// N1 of supervisors_addition/spawn_not_resumed_by_exit_notice: one worker, no restarts allowed.
// Its worker's death (42 / 0, badarith) ends N1, whose exit notice reaches the root supervisor while
// the root waits in spawn for N2's start. Atoms reuse names already numbered in this suite.
use Supervisor;

export SpawnNotResumedN1Sup_child_start/1;

impl SpawnNotResumedN1Sup for Supervisor;

// Cast-only: N2's init kills it with cast_registered, and a cast to a call-only actor is rejected
// at compile time (spec §16.1.2).
fn victim(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, 42 / msg + state)
}

fn init(initial_state: int64) -> ({
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    }, List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:no_reply, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)]) {
    sequence proc[mem(normal)]
        flags: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 5 };
        children: List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:no_reply, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)] <- [
            { id: :dup_add_worker, agent_type: :worker, initial_state: 0, behavior: victim, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn SpawnNotResumedN1Sup_child_start(initial_state: int64) -> ({
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    }, List[{
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:no_reply, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        }, mem(normal)]) {
    init(initial_state)
}
