// The shutdown reason a supervisor gives the children it ends (Lee, 2026-10-15). A supervisor ends
// its children when it ends, last row first: a child with shutdown 0 is ended at once (reason_tag
// 1); a child with shutdown > 0 is asked to shut down, an orderly end with the reason
// (:explicit, :shutdown) (reason_tag 4). The shutdown time itself is not enforced. The root
// supervisor below holds one child, the ten-worker supervisor of traits/OrderlyShutdownTenSup.silica:
// ten :temporary workers, the first five with shutdown 50 and the other five with shutdown 0. Six
// cycles: :terminate_child of that supervisor while all ten workers still run, :restart_child, and
// :count_children of the new one, printed.
// Each cycle sends eleven reports to the FailureReporter: five workers with reason_tag 4, five with
// reason_tag 1 and the supervisor's (reason_tag 0), 66 in all; the reporter prints "done" and ends
// the program with cast_exit(0) after the 66th. The reports are printed asynchronously (multiset
// golden).
// The child ids and supervisor names are atoms this suite already numbers ahead of this trial.
// Expected output (as a multiset):
//   10 (six times)
//   66 failure reports: 30 with reason_tag 4 and 30 with reason_tag 1 (frame #0
//     OrderlyShutdownTenSup_worker), 6 with reason_tag 0 (frame #0
//     OrderlyShutdownTenSup_OrderlyShutdownTenSup_child_start)
//   done
//   0

use Supervisor;
use OrderlyShutdownTenSup;

impl OrderlyShutdownRootSup for Supervisor;

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 100, restarts_time_frame: 1000 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :phase_e_decl_10_ofa_sup, agent_type: :supervisor, initial_state: 0, behavior: OrderlyShutdownTenSup@OrderlyShutdownTenSup_child_start, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

// One cycle: end the ten-worker supervisor (its workers still running), start it again, and return
// how many children the new one holds.
fn cycle(root: supervisor_ref) -> int64 {
    sequence
        _t: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(root, { op: :terminate_child, id: :phase_e_decl_10_ofa_sup } impl SupervisorMessage {});
        _r: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(root, { op: :restart_child, id: :phase_e_decl_10_ofa_sup } impl SupervisorMessage {});
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(root, { op: :get_child, id: :phase_e_decl_10_ofa_sup } impl SupervisorMessage {});
        n: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(got.child, { op: :count_children } impl SupervisorMessage {})
    produces pure n.count end
}

// Prints a count as one line with one write. The FailureReporter prints "done" concurrently, and
// print_int64 followed by println("") is two writes, so "done" could land between them ("10done").
// println writes its string and the newline together, so the expected count is printed as a string
// literal; any other count is printed digit by digit and fails the golden either way.
fn print_count(c: int64) -> atom {
    sequence proc[device_io]
        printed: atom <- case c == 10 of {
            true -> println("10");
            false -> print_count_digits(c)
        }
    produces pure printed end
}

fn print_count_digits(c: int64) -> atom {
    sequence proc[device_io]
        print_int64(c);
        printed: atom <- println("")
    produces pure printed end
}

fn repeat_print(root: supervisor_ref, n: int64) -> int64 {
    sequence
        c: int64 <- cycle(root);
        _: atom <- print_count(c);
        r: int64 <- case n == 1 of { true -> 0; false -> repeat_print(root, n - 1) }
    produces pure r end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        root: supervisor_ref <- spawn_registered_supervisor(OrderlyShutdownRootSup, 0, :phase_e_decl_10_ofo_sup, stack_policy(0, :keep_last_message));
        _: int64 <- repeat_print(root, 6);
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

fn finish() -> boolean {
    sequence proc[concurrency, device_io]
        _: atom <- println("done");
        ended: boolean <- cast_exit(0)
    produces pure ended end
}

// Writes each report to stderr; state counts them. The 66th (six cycles of ten workers and their
// supervisor) prints the done marker and ends the program with status 0.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case state + 1 == 66 of {
            true -> finish();
            false -> true
        }
    produces
        pure (:no_reply, state + 1)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
