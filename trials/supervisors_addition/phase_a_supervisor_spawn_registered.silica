// Phase A supervisor trial: source-level supervisor creation must be explicit.
//
// New design target:
// - `Supervisor.silica` is the canonical trait.
// - A supervisor is created with `spawn_registered_supervisor`, not ordinary `spawn`.
// - The result is `supervisor_ref`, not `actor_ref`.
// - The programmer provides `init/1`; the supervisor behavior is runtime-owned.
// - Dynamic children are added with `call_supervisor` and a `child_spec`.
// - There is no public `spawn_linked` and no manual `add_child(parent_ref, child_ref)` path.
//
// Expect `40` on stdout once the new supervisor surface is implemented.

use Supervisor;

impl PhaseASup for Supervisor;

fn child_worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- empty[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ]()
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(PhaseASup, 0, :phase_a_sup, stack_policy(0, :keep_last_message));
        reply: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, {
            op: :add_child,
            child: {
                id: :phase_a_worker,
                agent_type: :worker,
                initial_state: 0,
                behavior: child_worker,
                restart: :permanent,
                shutdown: 0,
                flavor: :plain
            }
        } impl SupervisorMessage {});
        sum: int64 <- case reply.tag of {
            :child_started -> {
                sequence proc[concurrency]
                    value: int64 <- call(reply.child, 40 impl ActorMessage {})
                produces
                    pure value
                end
            }
            :error -> {
                sequence proc[device_io]
                    print_string("supervisor error: ");
                    print_atom(reply.error);
                    println("")
                produces
                    pure -1
                end
            }
            _: atom -> {
                sequence proc[device_io]
                    print_string("unexpected supervisor reply");
                    println("")
                produces
                    pure -1
                end
            }
        };
        print_string("sum: ");  // effects [device_io]
        _: atom <- print_int64(sum);
        println("");
        _: atom <- print_int64(sum);
        println("");
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure sum
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
