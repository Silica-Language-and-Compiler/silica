// Supervisor exit-queue limit: a supervised actor's supervision ingress queue holds at most 1,024 notices.
// The 1,025th enqueue ends THAT actor with (:explicit, :ingress_full); its supervisor is notified through
// the ordinary exit path (W is :temporary, so it is not restarted) and the program keeps running.
// The worker puts 1,025 hook nodes (supervision_ingress_enqueue, an inline int64 the target's behaviour
// runs on) on its own ingress inside ONE dispatch, so it cannot drain them (casts to self would go to the
// unbounded standard mailbox, not this queue).
// Expected output: "worker ended: ingress_full", "done", then status 0.

use Supervisor;

impl IngressLimitSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        _: atom <- supervision_ingress_enqueue(me, 1);
        _: atom <- supervision_ingress_enqueue(me, 2);
        _: atom <- supervision_ingress_enqueue(me, 3);
        _: atom <- supervision_ingress_enqueue(me, 4);
        _: atom <- supervision_ingress_enqueue(me, 5);
        _: atom <- supervision_ingress_enqueue(me, 6);
        _: atom <- supervision_ingress_enqueue(me, 7);
        _: atom <- supervision_ingress_enqueue(me, 8);
        _: atom <- supervision_ingress_enqueue(me, 9);
        _: atom <- supervision_ingress_enqueue(me, 10);
