fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 3600 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)] <- [
            { id: :il_worker, agent_type: :worker, initial_state: initial_state, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces pure (flags, children) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        _: supervisor_ref <- spawn_registered_supervisor(IngressLimitSup, 0, :il_sup, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast_registered(:il_worker, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        println("done")
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn kind(report: string) -> string {
    case contains(report, ":ingress_full") of {
        true -> "worker ended: ingress_full\n";
        false -> "worker ended: other reason\n"
    }
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print(kind(report));
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}
