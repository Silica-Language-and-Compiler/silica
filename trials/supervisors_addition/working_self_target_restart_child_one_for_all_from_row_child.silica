// A row child's restart group includes itself (prims_actors_child_table_asm.silica
// restart_child_acb; carriers_addition/workers_zzzgap_row_asks_one_for_all_group_restart is the
// same check driven from a carrier actor): a row child (the asker) of a :one_for_all supervisor
// asks it to restart a SIBLING with :restart_child. The group that restart stops and respawns
// includes the asker, which would wait for its own exit: before the fix this hung; now the asker
// gets the error reply at once (tag :error, error :language_error) and nothing is stopped. The
// same request from main (not a row of this supervisor) still restarts the whole group (tag
// :child_started, every counter back at its initial state, three failure reports). Every row takes
// the supervisor's reference as its message (the counters ignore it and add 5).
//
//   call the asker              -> 99 (tag :error, error :language_error)
//   :count_children             -> 3, printed as 9
//   call b                      -> 605 (nothing was stopped)
//   main :restart_child of b    -> tag :child_started, 9
//   call b                      -> 605 (restarted: initial state again)
//   call c, c                   -> 705, then 710 printed as 9 (c restarted too: one_for_all)
//
// Expected output: 99, 9, 605, 9, 605, 705, 9, three failure reports (asker, b, c, reason_tag 0:
// the supervisor's own stop sets no reason), exit status 0, compared as a multiset. Printed values
// avoid the digits 1-4 (compare_scout_multiset.sh folds those): 9 is a check that holds, 6 one that
// does not. Atoms: the trial sorts after every other one in supervisors_addition, so its new atoms
// are numbered last and no other trial's atoms are renumbered.

use Supervisor;

impl SelfTargetRestartOfaSup for Supervisor;

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

fn counter(msg: supervisor_ref, state: int64) -> (:reply, int64, int64) {
    (:reply, state + 5, state + 5)
}

// Asks the supervisor (its message) to restart sibling b: the :one_for_all group includes the asker.
fn asker(msg: supervisor_ref, state: int64) -> (:reply, int64, int64) {
    sequence
        r: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(msg, { op: :restart_child, id: :self_target_ofa_b } impl SupervisorMessage {});
        t: int64 <- verdict(case r.tag of { :error -> true; _: atom -> false });
        e: int64 <- verdict(case r.error of { :language_error -> true; _: atom -> false })
    produces
        pure (:reply, t * 10 + e, state + 1)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: supervisor_ref, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_all, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: supervisor_ref, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :self_target_ofa_asker, agent_type: :worker, initial_state: initial_state, behavior: asker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :self_target_ofa_b, agent_type: :worker, initial_state: initial_state + 600, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :self_target_ofa_c, agent_type: :worker, initial_state: initial_state + 700, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(SelfTargetRestartOfaSup, 0, :self_target_ofa_sup, stack_policy(0, :keep_last_message));
        a: int64 <- call_registered(:self_target_ofa_asker, sup impl ActorMessage {});
        counted: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :count_children } impl SupervisorMessage {});
        b1: int64 <- call_registered(:self_target_ofa_b, sup impl ActorMessage {});
        restarted: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :restart_child, id: :self_target_ofa_b } impl SupervisorMessage {});
        b2: int64 <- call_registered(:self_target_ofa_b, sup impl ActorMessage {});
        c1: int64 <- call_registered(:self_target_ofa_c, sup impl ActorMessage {});
        c2: int64 <- call_registered(:self_target_ofa_c, sup impl ActorMessage {});
        print_int64(a);
        println("");
        print_int64(verdict(counted.count == 3));
        println("");
        print_int64(b1);
        println("");
        print_int64(verdict(case restarted.tag of { :child_started -> true; _: atom -> false }));
        println("");
        print_int64(b2);
        println("");
        print_int64(c1);
        println("");
        print_int64(verdict(c2 == 710));
        println("")
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
