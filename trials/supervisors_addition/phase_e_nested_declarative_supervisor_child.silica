// Phase E nested declarative supervisor trial:
// root supervisor -> child supervisor -> five declarative worker actors.

use Supervisor;
use PhaseENestedChildSup;

impl PhaseENestedRootSup for Supervisor;

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(initial_state: int64) -> (
                {
                    strategy: :one_for_one | :one_for_all | :rest_for_one,
                    allowed_restart_count: int64,
                    restarts_time_frame: int64
                },
                List[
                    {
                        id: atom,
                        agent_type: :worker | :supervisor,
                        initial_state: int64,
                        behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                        restart: :permanent | :temporary | :transient,
                        shutdown: int64,
                        flavor: :plain | :dangerous
                    },
                    mem(normal)
                ]
            ),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 10, restarts_time_frame: 5 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(initial_state: int64) -> (
                    {
                        strategy: :one_for_one | :one_for_all | :rest_for_one,
                        allowed_restart_count: int64,
                        restarts_time_frame: int64
                    },
                    List[
                        {
                            id: atom,
                            agent_type: :worker | :supervisor,
                            initial_state: int64,
                            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                            restart: :permanent | :temporary | :transient,
                            shutdown: int64,
                            flavor: :plain | :dangerous
                        },
                        mem(normal)
                    ]
                ),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            {
                id: :phase_e_nested_child_sup,
                agent_type: :supervisor,
                initial_state: initial_state + 10,
                behavior: PhaseENestedChildSup@PhaseENestedChildSup_child_start,
                restart: :permanent,
                shutdown: 0,
                flavor: :plain
            }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        _: atom <- start_reporter();
        root: supervisor_ref <- spawn_registered_supervisor(PhaseENestedRootSup, 500, :phase_e_nested_root_sup, stack_policy(0, :keep_last_message));
        root_count: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(root, { op: :count_children } impl SupervisorMessage {});
        child_lookup: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(root, { op: :get_child, id: :phase_e_nested_child_sup } impl SupervisorMessage {});
        nested_probe: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(child_lookup.child, { op: :count_children } impl SupervisorMessage {});
        nested_count: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(child_lookup.child, { op: :count_children } impl SupervisorMessage {});
        nested_children: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(child_lookup.child, { op: :which_children } impl SupervisorMessage {});
        worker_lookup: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)],
            count: int64,
            child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient },
            error: atom
        } <- call_supervisor(child_lookup.child, { op: :get_child, id: :phase_e_nested_worker_00 } impl SupervisorMessage {});
        worker_value: int64 <- call(worker_lookup.child, 1 impl ActorMessage {});

        _: atom <- print_int64(case root_count.count == 1 of { true -> 1; false -> 0 });
        println("");
        _: atom <- print_int64(case nested_probe.count == 5 or nested_count.count == 5 of { true -> 1; false -> 0 });
        println("");
        _: atom <- print_int64(case length[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)](nested_children.children) == 5 of { true -> 1; false -> 0 });
        println("");
        _: atom <- print_int64(case worker_value == 511 of { true -> 1; false -> 0 });
        println("");
        println("done")
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
