    .syntax unified
    .cpu cortex-m4
    .fpu fpv4-sp-d16
    .thumb
.macro MOVI32 r, v
.if ((\v) >= 0) && ((\v) <= 65535)
movw \r, #(\v)
.else
movw \r, #((\v) & 0xffff)
movt \r, #(((\v) >> 16) & 0xffff)
.endif
.endm
.macro XADDR r, off
.if ((\off) >= 0) && ((\off) <= 4095)
add \r, sp, #(\off)
.else
MOVI32 \r, \off
add \r, \r, sp
.endif
.endm
.macro XL32 r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldr \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldr \r, [sp, \r]
.endif
.endm
.macro XS32 r, off, t
.if ((\off) >= 0) && ((\off) <= 4095)
str \r, [sp, #(\off)]
.else
MOVI32 \t, \off
str \r, [sp, \t]
.endif
.endm
.macro XL16U r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrh \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrh \r, [sp, \r]
.endif
.endm
.macro XL16S r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrsh \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrsh \r, [sp, \r]
.endif
.endm
.macro XS16 r, off, t
.if ((\off) >= 0) && ((\off) <= 4095)
strh \r, [sp, #(\off)]
.else
MOVI32 \t, \off
strh \r, [sp, \t]
.endif
.endm
.macro XL8U r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrb \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrb \r, [sp, \r]
.endif
.endm
.macro XS8 r, off, t
.if ((\off) >= 0) && ((\off) <= 4095)
strb \r, [sp, #(\off)]
.else
MOVI32 \t, \off
strb \r, [sp, \t]
.endif
.endm
.macro XL8S r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrsb \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrsb \r, [sp, \r]
.endif
.endm
.macro FRAME_ENTER n
.if (\n) <= 4095
subw r10, sp, #(\n)
.else
MOVI32 r10, \n
sub r10, sp, r10
.endif
ldr r11, [r9, #116]
cmp r10, r11
bhs.w 1f
mov r11, lr
MOVI32 r10, \n
bl silica_rt_stack_grow
mov lr, r11
b.w 2f
1:
mov sp, r10
2:
.if ((\n) - 4) <= 4095
str lr, [sp, #((\n) - 4)]
.else
MOVI32 r10, (\n) - 4
str lr, [sp, r10]
.endif
.endm
.macro FRAME_LEAVE n
.if ((\n) - 4) <= 4095
ldr lr, [sp, #((\n) - 4)]
.else
MOVI32 r10, (\n) - 4
ldr lr, [sp, r10]
.endif
.if (\n) <= 4095
addw sp, sp, #(\n)
.else
MOVI32 r10, \n
add sp, sp, r10
.endif
bx lr
.endm
