// Root supervisor init divides by zero (allowed_restart_count: 3 / initial_state, initial_state 0):
// badarith, reason_tag 2.
// spawn_registered_supervisor must return when the root supervisor's init fails: the spawner is not
// left waiting, the failure goes to the registered FailureReporter, and main then casts
// "spawn returned" to the reporter, which prints it and "done". The report and the cast reach the
// reporter in either order (.scout.multiset). ESP32-S3_raw printed a root note here until 16 Oct 2026; it now
// prints none (the .ESP32-S3_raw.scout matches the .scout).
// Atoms: every atom here is already numbered by an earlier unit of supervisors_addition (the suite
// shares one atom table), so adding this trial renumbers no other trial's atoms.

use Supervisor;

impl InitBadarithSup for Supervisor;

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 3 / initial_state, restarts_time_frame: 3600 };
        children: List[
            {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
            mem(normal)
        ] <- [
            { id: :phase_a_worker, agent_type: :worker, initial_state: 0, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + 1, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(InitBadarithSup, 0, :phase_a_sup, stack_policy(0, :keep_last_message));
        _: boolean <- cast(rep, "spawn returned" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn report_kind(report: string) -> string {
    case contains(report, "reason_tag:      2\n") of {
        true -> "failure report: reason_tag 2";
        false -> "failure report: other reason"
    }
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case contains(report, "=== Silica Actor Failure ===") of {
            true -> println(report_kind(report));
            false -> println(concat(report, "\ndone"))
        }
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
