// Spec §20.3.1 register: a name held by a live actor is :name_taken, and an actor that already holds
// a name is :already_registered (one name per actor in the ordinary registry). The registry actor's
// :insert operation is the register of this runtime; its reply is the (status, actor_ref) pair.
// A live name is never overwritten: after the refused insert, :worker_one still resolves to wa.
//
// Expected output:
//   :ok                  wa takes :worker_one
//   :name_taken          wb cannot take :worker_one while wa holds it
//   :already_registered  wa cannot also take :worker_two
//   :ok                  wb takes :worker_two
//   :ok                  wa inserting its own name again is not a duplicate
//   11                   call_registered(:worker_one) reaches wa (state 10)
//   22                   call_registered(:worker_two) reaches wb (state 20)

use trial_support_int64;

fn worker_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

// The registry's reply atoms are named here so they are in this program's atom table (an atom a
// program never spells has no printable name in its table; the runtime still replies with it).
fn show(s: atom) -> atom {
    case s of {
        :name_taken -> :name_taken;
        :already_registered -> :already_registered;
        :actor_not_found -> :actor_not_found;
        _: atom -> s
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                wa: actor_ref <- spawn(10, worker_beh, stack_policy(0, :keep_last_message));
                wb: actor_ref <- spawn(20, worker_beh, stack_policy(0, :keep_last_message));
                reg: actor_ref <- get_pid_registry();
                i1: (atom, actor_ref) <- call(reg, { op: :insert, name: :worker_one, pid: wa } impl ActorMessage {});
                (s1: atom, _p1: actor_ref) <- i1;
                _: atom <- print_atom(show(s1));
                println("");
                i2: (atom, actor_ref) <- call(reg, { op: :insert, name: :worker_one, pid: wb } impl ActorMessage {});
                (s2: atom, _p2: actor_ref) <- i2;
                _: atom <- print_atom(show(s2));
                println("");
                i3: (atom, actor_ref) <- call(reg, { op: :insert, name: :worker_two, pid: wa } impl ActorMessage {});
                (s3: atom, _p3: actor_ref) <- i3;
                _: atom <- print_atom(show(s3));
                println("");
                i4: (atom, actor_ref) <- call(reg, { op: :insert, name: :worker_two, pid: wb } impl ActorMessage {});
                (s4: atom, _p4: actor_ref) <- i4;
                _: atom <- print_atom(show(s4));
                println("");
                i5: (atom, actor_ref) <- call(reg, { op: :insert, name: :worker_one, pid: wa } impl ActorMessage {});
                (s5: atom, _p5: actor_ref) <- i5;
                _: atom <- print_atom(show(s5));
                println("");
                r1: int64 <- call_registered(:worker_one, 1 impl ActorMessage {});
                print_int64(r1);
                println("");
                r2: int64 <- call_registered(:worker_two, 2 impl ActorMessage {});
                print_int64(r2);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
