// Item J (actor_memory_budget_plan.md): the registries are sized per image, one slot per atom, so
// more than 240 distinct registered names resolve. 270 actors are registered under :n_001..:n_270
// (the runtime prefix and this program's other atoms push the last index well past 240); the first,
// a middle one and the last are reached by name through call_registered, and the last is looked up
// through the registry actor. Each worker's state is its number, and it replies msg + state.
//
// Expected output:
//   1001
//   1150
//   1270
//   :found

use trial_support_int64;

fn worker_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

