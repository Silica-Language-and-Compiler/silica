fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                _: int64 <- spawn_batch_1();
                _: int64 <- spawn_batch_2();
                _: int64 <- spawn_batch_3();
                _: int64 <- spawn_batch_4();
                _: int64 <- spawn_batch_5();
                _: int64 <- spawn_batch_6();
                r1: int64 <- call_registered(:n_001, 1000 impl ActorMessage {});
                print_int64(r1);
                println("");
                r150: int64 <- call_registered(:n_150, 1000 impl ActorMessage {});
                print_int64(r150);
                println("");
                r270: int64 <- call_registered(:n_270, 1000 impl ActorMessage {});
                print_int64(r270);
                println("");
                reg: actor_ref <- get_pid_registry();
                lr: (atom, actor_ref) <- call(reg, { op: :lookup, name: :n_270, pid: reg } impl ActorMessage {});
                (st: atom, _p: actor_ref) <- lr;
                _: atom <- print_atom(st);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
