// Spec §22.14.2 with region design §18.7: a timer's message follows the cast rules at the send_after
// call, so a message that carries an owned region (here { r, root }: a fresh ~4 KB region holding a
// two-cell chain) is the timer's to release when the timer is cancelled. main arms 100,000 such
// timers (delays of 100 s, never due) and cancels each at once; a leak of the messages would be
// ~400 MB, which the peak-RSS ceiling (cancelled_timers_release_messages.max_rss_mb) catches. The
// receiver never gets a message; a final delay-0 timer carrying sum 0 ends the program.
// Expected (by hand):
//   armed and cancelled: 100000
//   0
//   done
// exit status 0
fn some_term(c: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> ref?(L, normal, rec) {
    c
}

fn sum_chain(root: ref?(L, normal, rec)) -> int64 {
    sequence proc[mem(normal)]
        total: int64 <- case root of {
            :none -> 0;
            c: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> {
                node: (atom, int64, ref?(L, normal, rec)) <- read_ref(c);
                (_: atom, v: int64, nxt: ref?(L, normal, rec)) <- node;
                v + sum_chain(nxt)
            }
        }
    produces pure total end
}

fn beh(msg: { r: region(L, normal), root: ref?(L, normal, rec) }, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        got: int64 <- sum_chain(msg.root);
        new_total: int64 <- state + got;
        _: atom <- case got == 0 of {
            true -> { _: atom <- print_int64(new_total); println(""); println("done"); :ok };
            false -> :ok
        };
        _: boolean <- case got == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces pure (:no_reply, new_total) end
}

fn build_message(a: int64, b: int64) -> { r: region(L, normal), root: ref?(L, normal, rec) } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        n2: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, b, :none));
        n1: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, a, n2))
    produces pure { r: r, root: some_term(n1) } end
}

// Arms a never-due timer carrying a fresh region and cancels it, n times; counts the :cancelled
// answers. Batches of 1000 keep main's recursion shallow (100,000 frames overflowed main's stack).
fn arm_cancel_batch(a: actor_ref, n: int64) -> int64 {
    sequence proc[concurrency]
        m: { r: region(L, normal), root: ref?(L, normal, rec) } <- build_message(1, 2);
        t: timer_ref <- send_after(100000, a, m impl ActorMessage {});
        c: atom <- cancel_timer(t);
        here: int64 <- case c == :cancelled of {
            true -> 1;
            false -> 0
        };
        rest: int64 <- case n <= 1 of {
            true -> 0;
            false -> arm_cancel_batch(a, n - 1)
        }
    produces pure here + rest end
}

fn arm_cancel_batches(a: actor_ref, batches: int64) -> int64 {
    here: int64 <- arm_cancel_batch(a, 1000);
    rest: int64 <- case batches <= 1 of {
        true -> 0;
        false -> arm_cancel_batches(a, batches - 1)
    };
    here + rest
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        a: actor_ref <- spawn(0, beh, stack_policy(0, :keep_last_message));
        cancelled: int64 <- arm_cancel_batches(a, 100);
        print("armed and cancelled: ");
        print_int64(cancelled);
        println("");
        last: { r: region(L, normal), root: ref?(L, normal, rec) } <- build_message(0, 0);
        _: timer_ref <- send_after(0, a, last impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
