// Spec §22.14.2: timers are delivered in deadline order whatever the order they were armed in. One
// actor arms 120 ms (message 3), 40 ms (message 1) and 80 ms (message 2) in that order, in one
// dispatch; the service delivers 1, 2, 3. The order holds however late a loaded machine runs the
// deliveries, because every delivery takes the earliest pending deadline.
// Expected (by hand):
//   fired 1 after 0
//   fired 2 after 1
//   fired 3 after 2
// exit status 0
fn orderer(msg: int64, last: int64) -> (:no_reply, int64) {
    case msg of {
        0 -> {
            sequence proc[concurrency]
                _: timer_ref <- send_after(120, self(), 3 impl ActorMessage {});
                _: timer_ref <- send_after(40, self(), 1 impl ActorMessage {});
                _: timer_ref <- send_after(80, self(), 2 impl ActorMessage {})
            produces pure (:no_reply, 0) end
        };
        _: int64 -> {
            sequence proc[concurrency, device_io]
                print("fired ");
                print_int64(msg);
                print(" after ");
                print_int64(last);
                println("");
                _: boolean <- case msg == 3 of {
                    true -> cast_exit(0);
                    false -> true
                }
            produces pure (:no_reply, msg) end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        a: actor_ref <- spawn(0, orderer, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
