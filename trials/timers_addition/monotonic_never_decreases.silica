// Spec §22.14.1: monotonic_time never decreases while the program runs. main reads it 2000 times in
// a row, and an actor reads it across 20 dispatches, each reading compared with the one before.
// No time is printed (times are not reproducible); only the comparisons are.
// Expected (by hand):
//   monotonic non-decreasing over 2000 reads: true
//   monotonic non-decreasing across 20 dispatches: true
// exit status 0
fn reads_non_decreasing(prev: int64, left: int64) -> boolean {
    case left == 0 of {
        true -> true;
        false -> {
            sequence proc[concurrency]
                now: int64 <- monotonic_time();
                ok: boolean <- case now >= prev of {
                    true -> reads_non_decreasing(now, left - 1);
                    false -> false
                }
            produces pure ok end
        }
    }
}

fn ticker(msg: int64, state: { prev: int64, all_ok: boolean }) -> (:no_reply, { prev: int64, all_ok: boolean }) {
    sequence proc[concurrency]
        now: int64 <- monotonic_time();
        ok: boolean <- state.all_ok and now >= state.prev;
        _: boolean <- case msg == 20 of {
            true -> {
                sequence proc[concurrency, device_io]
                    print("monotonic non-decreasing across 20 dispatches: ");
                    print_boolean(ok);
                    println("");
                    r: boolean <- cast_exit(0)
                produces pure r end
            };
            false -> true
        }
    produces pure (:no_reply, { prev: now, all_ok: ok }) end
}

fn cast_up_to(a: actor_ref, i: int64, n: int64) -> boolean {
    case i > n of {
        true -> true;
        false -> {
            sequence proc[concurrency]
                _: boolean <- cast(a, i impl ActorMessage {});
                r: boolean <- cast_up_to(a, i + 1, n)
            produces pure r end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        first: int64 <- monotonic_time();
        print("monotonic non-decreasing over 2000 reads: ");
        print_boolean(reads_non_decreasing(first, 2000));
        println("");
        a: actor_ref <- spawn({ prev: first, all_ok: true }, ticker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_up_to(a, 1, 20);
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
