// Spec §22.14.2: send_after casts its message once delay_ms have passed on the monotonic clock, no
// earlier (and possibly later). An actor arms a 50 ms timer to itself and a 300 ms check; the tick
// counts and is compared with the arming time, the check reports the count. A loaded machine can
// only make the tick later, never earlier or more than once.
// Expected (by hand):
//   tick elapsed >= 50ms: true
//   tick fired exactly once: true
// exit status 0
fn waiter(msg: atom, state: { armed_at: int64, fires: int64 }) -> (:no_reply, { armed_at: int64, fires: int64 }) {
    case msg of {
        :start -> {
            sequence proc[concurrency]
                t0: int64 <- monotonic_time();
                _: timer_ref <- send_after(50, self(), :tick impl ActorMessage {});
                _: timer_ref <- send_after(300, self(), :check impl ActorMessage {})
            produces pure (:no_reply, { armed_at: t0, fires: 0 }) end
        };
        :tick -> {
            sequence proc[concurrency, device_io]
                now: int64 <- monotonic_time();
                print("tick elapsed >= 50ms: ");
                print_boolean(now - state.armed_at >= 50000000);
                println("")
            produces pure (:no_reply, { armed_at: state.armed_at, fires: state.fires + 1 }) end
        };
        _: atom -> {
            sequence proc[concurrency, device_io]
                print("tick fired exactly once: ");
                print_boolean(state.fires == 1);
                println("");
                _: boolean <- cast_exit(0)
            produces pure (:no_reply, state) end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        a: actor_ref <- spawn({ armed_at: 0, fires: 0 }, waiter, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, :start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
