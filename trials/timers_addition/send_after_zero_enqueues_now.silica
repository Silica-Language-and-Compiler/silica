// Spec §22.14.2: a delay_ms of 0 enqueues the message at once. The sender arms send_after(0, peer, 1)
// and then casts 2 to the same peer: 1 is already in the peer's mailbox when 2 is cast, so the peer
// sees 1 before 2 (the mailbox is FIFO, §16.1.3). Cancelling the delay-0 timer afterwards finds
// nothing: it has fired; the sender reports that answer through the receiver too (3 for :not_found,
// 4 for anything else), so every line is printed by the one receiver, in mailbox order.
// Expected (by hand):
//   receiver got 1
//   receiver got 2
//   cancel after delay 0: :not_found
// exit status 0
fn sender(msg: atom, peer: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        t: timer_ref <- send_after(0, peer, 1 impl ActorMessage {});
        _: boolean <- cast(peer, 2 impl ActorMessage {});
        c: atom <- cancel_timer(t);
        code: int64 <- case c == :not_found of {
            true -> 3;
            false -> 4
        };
        _: boolean <- cast(peer, code impl ActorMessage {})
    produces pure (:no_reply, peer) end
}

fn receiver(msg: int64, count: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- case msg of {
            3 -> { println("cancel after delay 0: :not_found"); :ok };
            4 -> { println("cancel after delay 0: not :not_found"); :ok };
            _: int64 -> { _: atom <- print("receiver got "); _: atom <- print_int64(msg); println(""); :ok }
        };
        _: boolean <- case msg >= 3 of {
            true -> cast_exit(0);
            false -> true
        }
    produces pure (:no_reply, count + 1) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        r: actor_ref <- spawn(0, receiver, stack_policy(0, :keep_last_message));
        s: actor_ref <- spawn(r, sender, stack_policy(0, :keep_last_message));
        _: boolean <- cast(s, :go impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
