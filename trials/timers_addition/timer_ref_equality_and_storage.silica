// Spec §4.5.2: a timer_ref is an opaque primitive with == and != only, and may live in variables,
// state and messages. Two pending timers are compared with themselves and each other, one is kept
// in the actor's state and cancelled from a later dispatch, the other travels in a message record
// { t: timer_ref, n: int64 } to a second actor, which cancels it.
// Expected (by hand):
//   t1 == t1: true
//   t1 == t2: false
//   t1 != t2: true
//   t1 == initial: false
//   cancel from state: :cancelled
//   cancel from message field 2: :cancelled
// exit status 0
fn keeper(msg: atom, state: { pending: timer_ref, sink: actor_ref }) -> (:no_reply, { pending: timer_ref, sink: actor_ref }) {
    case msg of {
        :start -> {
            sequence proc[concurrency, device_io]
                t1: timer_ref <- send_after(5000, self(), :never impl ActorMessage {});
                t2: timer_ref <- send_after(6000, self(), :never impl ActorMessage {});
                print("t1 == t1: ");
                print_boolean(t1 == t1);
                println("");
                print("t1 == t2: ");
                print_boolean(t1 == t2);
                println("");
                print("t1 != t2: ");
                print_boolean(t1 != t2);
                println("");
                print("t1 == initial: ");
                print_boolean(t1 == state.pending);
                println("");
                _: boolean <- cast(self(), :cancel_stored impl ActorMessage {});
                _: boolean <- cast(state.sink, { t: t2, n: 2 } impl ActorMessage {})
            produces pure (:no_reply, { pending: t1, sink: state.sink }) end
        };
        _: atom -> {
            sequence proc[concurrency, device_io]
                c: atom <- cancel_timer(state.pending);
                print("cancel from state: ");
                print_atom(c);
                println("")
            produces pure (:no_reply, state) end
        }
    }
}

fn sink(msg: { t: timer_ref, n: int64 }, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        c: atom <- cancel_timer(msg.t);
        print("cancel from message field ");
        print_int64(msg.n);
        print(": ");
        print_atom(c);
        println("");
        _: boolean <- cast_exit(0)
    produces pure (:no_reply, state) end
}

fn idle(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        d: actor_ref <- spawn(0, idle, stack_policy(0, :keep_last_message));
        t0: timer_ref <- send_after(0, d, 0 impl ActorMessage {});
        s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        k: actor_ref <- spawn({ pending: t0, sink: s }, keeper, stack_policy(0, :keep_last_message));
        _: boolean <- cast(k, :start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
