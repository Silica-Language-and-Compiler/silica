// Spec §22.14.2: cancel_timer answers :not_found once the timer has fired. The actor keeps the
// reference of a 20 ms timer in its state (a record field of type timer_ref) and cancels it from the
// dispatch that handles the timer's own message.
// Expected (by hand):
//   cancel after the message arrived: :not_found
// exit status 0
fn late(msg: atom, state: { pending: timer_ref, armed: boolean }) -> (:no_reply, { pending: timer_ref, armed: boolean }) {
    case msg of {
        :start -> {
            sequence proc[concurrency]
                t: timer_ref <- send_after(20, self(), :tick impl ActorMessage {})
            produces pure (:no_reply, { pending: t, armed: true }) end
        };
        _: atom -> {
            sequence proc[concurrency, device_io]
                c: atom <- cancel_timer(state.pending);
                print("cancel after the message arrived: ");
                print_atom(c);
                println("");
                _: boolean <- cast_exit(0)
            produces pure (:no_reply, state) end
        }
    }
}

fn idle(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        // A timer_ref has no literal: the initial state's field holds a delay-0 timer to an idle actor.
        d: actor_ref <- spawn(0, idle, stack_policy(0, :keep_last_message));
        t0: timer_ref <- send_after(0, d, 0 impl ActorMessage {});
        a: actor_ref <- spawn({ pending: t0, armed: false }, late, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, :start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
