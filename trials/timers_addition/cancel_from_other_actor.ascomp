    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    CMP X1, X2
    B.NE Lsc_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Lsc_n2_done:
    CBZ X24, Lsc_true
    CMP X24, X22
    B.HI Lsc_false
    SUB X25, X22, X24
    ADD X25, X25, #1
    MOV X26, X21
Lsc_outer:
    MOV X27, X26
    MOV X28, X23
    MOV X0, X24
Lsc_inner:
    LDRB W1, [X27], #1
    LDRB W2, [X28], #1
    CMP W1, W2
    B.NE Lsc_next
    SUBS X0, X0, #1
    B.NE Lsc_inner
    B Lsc_true
Lsc_next:
    ADD X26, X26, #1
    SUBS X25, X25, #1
    B.NE Lsc_outer
    B Lsc_false
Lsc_true:
    MOV W0, #1
    B Lsc_exit
Lsc_false:
    MOV W0, #0
Lsc_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

Lsc_bad:
    BRK #1

