// Spec §22.14.2: if the target has ended when the timer fires, the message is dropped and nothing
// is raised. The sender arms a 60 ms timer to a worker and tells the worker to stop (stop_self,
// §15.1.2.3, at its next dispatch boundary, long before 60 ms); a 300 ms check shows the sender is
// unaffected, and cancelling the dropped timer then finds nothing.
// Expected (by hand):
//   worker stopping
//   sender alive after the target ended: true
//   cancel after the drop: :not_found
// exit status 0
fn worker(msg: atom, state: int64) -> (:no_reply, int64) {
    case msg of {
        :stop -> {
            sequence proc[concurrency, device_io]
                println("worker stopping");
                _: atom <- stop_self(:normal)
            produces pure (:no_reply, state) end
        };
        _: atom -> (:no_reply, state)
    }
}

fn sender(msg: atom, state: { target: actor_ref, pending: timer_ref }) -> (:no_reply, { target: actor_ref, pending: timer_ref }) {
    case msg of {
        :start -> {
            sequence proc[concurrency]
                t: timer_ref <- send_after(60, state.target, :late impl ActorMessage {});
                _: boolean <- cast(state.target, :stop impl ActorMessage {});
                _: timer_ref <- send_after(300, self(), :check impl ActorMessage {})
            produces pure (:no_reply, { target: state.target, pending: t }) end
        };
        _: atom -> {
            sequence proc[concurrency, device_io]
                println("sender alive after the target ended: true");
                c: atom <- cancel_timer(state.pending);
                print("cancel after the drop: ");
                print_atom(c);
                println("");
                _: boolean <- cast_exit(0)
            produces pure (:no_reply, state) end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        t0: timer_ref <- send_after(0, w, :warm impl ActorMessage {});
        s: actor_ref <- spawn({ target: w, pending: t0 }, sender, stack_policy(0, :keep_last_message));
        _: boolean <- cast(s, :start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
