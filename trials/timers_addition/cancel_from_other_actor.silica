// Spec §22.14.2: any actor holding the timer_ref may cancel it. The owner arms a 400 ms timer to
// itself and sends the reference, as a message, to a second actor, which cancels it; the owner then
// arms a 200 ms check and reports whether the cancelled message came.
// Expected (by hand):
//   other actor cancels: :cancelled
//   cancelled message delivered to owner: false
// exit status 0
fn owner(msg: atom, state: { helper: actor_ref, got_never: boolean }) -> (:no_reply, { helper: actor_ref, got_never: boolean }) {
    case msg of {
        :start -> {
            sequence proc[concurrency]
                t: timer_ref <- send_after(400, self(), :never impl ActorMessage {});
                _: boolean <- cast(state.helper, t impl ActorMessage {});
                _: timer_ref <- send_after(200, self(), :check impl ActorMessage {})
            produces pure (:no_reply, state) end
        };
        :never -> (:no_reply, { helper: state.helper, got_never: true });
        _: atom -> {
            sequence proc[concurrency, device_io]
                print("cancelled message delivered to owner: ");
                print_boolean(state.got_never);
                println("");
                _: boolean <- cast_exit(0)
            produces pure (:no_reply, state) end
        }
    }
}

fn helper(t: timer_ref, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        c: atom <- cancel_timer(t);
        print("other actor cancels: ");
        print_atom(c);
        println("")
    produces pure (:no_reply, state + 1) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        h: actor_ref <- spawn(0, helper, stack_policy(0, :keep_last_message));
        o: actor_ref <- spawn({ helper: h, got_never: false }, owner, stack_policy(0, :keep_last_message));
        _: boolean <- cast(o, :start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
