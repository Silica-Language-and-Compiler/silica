// Spec §22.14.2: a timer is cancelled automatically when its target ends. The sender arms a 10 s
// timer to a worker and tells the worker to stop; 200 ms later (a check timer to itself) it cancels
// the long timer and gets :not_found, not :cancelled: the timer was already gone with its target.
// Expected (by hand):
//   worker stopping
//   cancel after the target ended: :not_found
// exit status 0
fn worker(msg: atom, state: int64) -> (:no_reply, int64) {
    case msg of {
        :stop -> {
            sequence proc[concurrency, device_io]
                println("worker stopping");
                _: atom <- stop_self(:normal)
            produces pure (:no_reply, state) end
        };
        _: atom -> (:no_reply, state)
    }
}

fn sender(msg: atom, state: { target: actor_ref, pending: timer_ref }) -> (:no_reply, { target: actor_ref, pending: timer_ref }) {
    case msg of {
        :start -> {
            sequence proc[concurrency]
                t: timer_ref <- send_after(10000, state.target, :late impl ActorMessage {});
                _: boolean <- cast(state.target, :stop impl ActorMessage {});
                _: timer_ref <- send_after(200, self(), :check impl ActorMessage {})
            produces pure (:no_reply, { target: state.target, pending: t }) end
        };
        _: atom -> {
            sequence proc[concurrency, device_io]
                c: atom <- cancel_timer(state.pending);
                print("cancel after the target ended: ");
                print_atom(c);
                println("");
                _: boolean <- cast_exit(0)
            produces pure (:no_reply, state) end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        t0: timer_ref <- send_after(0, w, :warm impl ActorMessage {});
        s: actor_ref <- spawn({ target: w, pending: t0 }, sender, stack_policy(0, :keep_last_message));
        _: boolean <- cast(s, :start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
