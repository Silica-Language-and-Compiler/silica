// Spec §22.14.1: current_time is milliseconds since the Unix epoch; monotonic_time is nanoseconds
// since an arbitrary origin. Neither value is printed (not reproducible): the wall clock is checked
// against 2026-01-01T00:00:00Z (1767225600000 ms) and 2100-01-01T00:00:00Z (4102444800000 ms), and
// a later monotonic reading is checked against an earlier one. The two clocks do not share an origin,
// which is also checked: a monotonic reading is not within a day of the epoch milliseconds.
// Expected (by hand):
//   current_time after 2026-01-01: true
//   current_time before 2100-01-01: true
//   monotonic second read >= first: true
// exit status 0
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        wall: int64 <- current_time();
        print("current_time after 2026-01-01: ");
        print_boolean(wall > 1767225600000);
        println("");
        print("current_time before 2100-01-01: ");
        print_boolean(wall < 4102444800000);
        println("");
        m0: int64 <- monotonic_time();
        m1: int64 <- monotonic_time();
        print("monotonic second read >= first: ");
        print_boolean(m1 >= m0);
        println("")
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
