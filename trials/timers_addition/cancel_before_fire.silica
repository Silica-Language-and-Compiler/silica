// Spec §22.14.2: cancel_timer answers :cancelled when the message has not been delivered yet, and
// the message then never is. The actor arms an 80 ms timer and cancels it in the same dispatch,
// then arms a 300 ms check; when the check arrives it reports whether the cancelled message came.
// Expected (by hand):
//   cancel pending timer: :cancelled
//   cancelled message delivered: false
// exit status 0
fn canceller(msg: atom, got_never: boolean) -> (:no_reply, boolean) {
    case msg of {
        :start -> {
            sequence proc[concurrency, device_io]
                t: timer_ref <- send_after(80, self(), :never impl ActorMessage {});
                c: atom <- cancel_timer(t);
                print("cancel pending timer: ");
                print_atom(c);
                println("");
                _: timer_ref <- send_after(300, self(), :check impl ActorMessage {})
            produces pure (:no_reply, got_never) end
        };
        :never -> (:no_reply, true);
        _: atom -> {
            sequence proc[concurrency, device_io]
                print("cancelled message delivered: ");
                print_boolean(got_never);
                println("");
                _: boolean <- cast_exit(0)
            produces pure (:no_reply, got_never) end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        a: actor_ref <- spawn(false, canceller, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, :start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70, so a
// failure can never pass as a timing miss. A normal end (reason_tag 0: an actor that stopped itself)
// is only written.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
