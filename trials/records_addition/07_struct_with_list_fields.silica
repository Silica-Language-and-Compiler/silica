// Trial 07: Structs whose fields are lists
//
// Demonstrates:
// - Inline record types with one or more fields of type List[T, mem(normal)]
// - Allocating list fields inside sequence proc[mem(normal)]
// - Accessing row.field and folding over list-typed fields

use trial_support_int64;

fn sum_int64_list(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> acc
        [h: int64, t: List[int64, mem(normal)]] -> sum_int64_list(t, acc + h)
        _: List[int64, mem(normal)] -> acc
    }
}

fn build_row_with_two_lists() -> {
    row_id: int64,
    primary: List[int64, mem(normal)],
    secondary: List[int64, mem(normal)]
} {
    sequence proc[mem(normal)]
        e0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        p_a: List[int64, mem(normal)] <- prepend[int64, mem(normal)](1, e0);
        p_b: List[int64, mem(normal)] <- prepend[int64, mem(normal)](2, p_a);
        p1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](3, p_b);
        e1: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        s_a: List[int64, mem(normal)] <- prepend[int64, mem(normal)](10, e1);
        s1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](40, s_a);
        row: {
            row_id: int64,
            primary: List[int64, mem(normal)],
            secondary: List[int64, mem(normal)]
        } <- {
            row_id: 7,
            primary: p1,
            secondary: s1
        }
    produces
        pure row
    end
}

fn combined_sum(
    row: {
        row_id: int64,
        primary: List[int64, mem(normal)],
        secondary: List[int64, mem(normal)]
    }
) -> int64 {
    a: int64 <- sum_int64_list(row.primary, 0);
    b: int64 <- sum_int64_list(row.secondary, 0);
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            row: {
                row_id: int64,
                primary: List[int64, mem(normal)],
                secondary: List[int64, mem(normal)]
            } <- build_row_with_two_lists();
            combined_sum(row)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
