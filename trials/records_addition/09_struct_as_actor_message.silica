// Trial 09: Inline Structs as Actor Message Payloads
//
// Demonstrates:
// - Using inline struct types as message-shaped and state-shaped values
// - Sending/receiving structured data between functional components (state + commands + responses)

use trial_support_atom;

fn increment_actor(state: { counter: int64, data: string }, msg: { command: string, value: int64 }) -> { counter: int64, data: string } {
    case msg.command of {
        "increment" -> {
            new_state: { counter: int64, data: string } <- {
                counter: state.counter + msg.value,
                data: state.data
            };
            new_state
        }
        "reset" -> {
            new_state: { counter: int64, data: string } <- {
                counter: 0,
                data: state.data
            };
            new_state
        }
        _: string -> state
    }
}

fn respond_to_query(state: { counter: int64, data: string }) -> { status: string, result: int64 } {
    response: { status: string, result: int64 } <- {
        status: "ok",
        result: state.counter
    };
    response
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            state: { counter: int64, data: string } <- {
                counter: 0,
                data: "initial"
            };

            cmd1: { command: string, value: int64 } <- {
                command: "increment",
                value: 5
            };

            new_state: { counter: int64, data: string } <- increment_actor(state, cmd1);

            cmd2: { command: string, value: int64 } <- {
                command: "increment",
                value: 3
            };

            final_state: { counter: int64, data: string } <- increment_actor(new_state, cmd2);

            _: { status: string, result: int64 } <- respond_to_query(final_state);

            :ok
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
