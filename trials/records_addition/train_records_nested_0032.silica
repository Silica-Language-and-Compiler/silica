// nested inline records; width = 21
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
                top_left: { x: 7, y: 8 },
                bottom_right: { x: 28, y: 29 }
            };
            rect.bottom_right.x - rect.top_left.x
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
