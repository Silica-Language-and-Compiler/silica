// Trial 06: Inline Structs in Sequence Expressions
//
// Demonstrates:
// - Using structs within sequence blocks (with effects)
// - Struct mutation patterns (creating new instances with updated values)
// - Sequence expressions while working with structs and lists

use trial_support_atom;

fn update_and_print(p: { x: int64, y: int64 }) -> { x: int64, y: int64 } {
    // Update struct by creating a new instance
    updated: { x: int64, y: int64 } <- { x: p.x + 1, y: p.y + 1 };
    updated
}

fn process_points(points: List[{ x: int64, y: int64 }, mem(normal)]) -> List[{ x: int64, y: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        // Process list of structs with effects
        result: List[{ x: int64, y: int64 }, mem(normal)] <-
            case points of {
                []: List[{ x: int64, y: int64 }, mem(normal)] -> empty[{ x: int64, y: int64 }, mem(normal)]()
                [head: { x: int64, y: int64 }, tail: List[{ x: int64, y: int64 }, mem(normal)]] -> {
                    updated_head: { x: int64, y: int64 } <- { x: head.x * 2, y: head.y * 2 };
                    rest: List[{ x: int64, y: int64 }, mem(normal)] <- process_points(tail);
                    prepend[{ x: int64, y: int64 }, mem(normal)](updated_head, rest)
                }
                _: List[{ x: int64, y: int64 }, mem(normal)] -> empty[{ x: int64, y: int64 }, mem(normal)]()
            }

        produces
            pure result
        end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)]
                // Create and update struct with sequence
                point: { x: int64, y: int64 } <- { x: 1, y: 2 };

                updated: { x: int64, y: int64 } <- update_and_print(point);

                // Create list and process
                empty: List[{ x: int64, y: int64 }, mem(normal)] <- empty[{ x: int64, y: int64 }, mem(normal)]();
                p1: { x: int64, y: int64 } <- { x: 1, y: 1 };
                p2: { x: int64, y: int64 } <- { x: 2, y: 2 };
                list2: List[{ x: int64, y: int64 }, mem(normal)] <- prepend[{ x: int64, y: int64 }, mem(normal)](p2, empty);
                list: List[{ x: int64, y: int64 }, mem(normal)] <- prepend[{ x: int64, y: int64 }, mem(normal)](p1, list2);

                processed: List[{ x: int64, y: int64 }, mem(normal)] <- process_points(list)

                produces
                    pure :ok
                end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
