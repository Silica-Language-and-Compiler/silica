// record pattern matching (axis); expect 1
use trial_support_int64;

fn classify(p: { x: int64, y: int64 }) -> int64 {
    case p of {
        { x: 0, y: 0 } -> 0;
        { x: 0, y: _ } -> 1;
        { x: _, y: 0 } -> 2;
        _ -> 3
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            p: { x: int64, y: int64 } <- { x: 0, y: 5 };
            classify(p)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
