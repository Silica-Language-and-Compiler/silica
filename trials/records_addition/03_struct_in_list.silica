// Trial 03: Inline Structs in Lists
//
// Demonstrates:
// - Storing inline struct values in lists (element type is the inline record shape)
// - Storing structs in List[StructType]
// - Working with collections of structs

use trial_support_int64;

fn create_point_list() -> List[{ x: int64, y: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        empty: List[{ x: int64, y: int64 }, mem(normal)] <- empty[{ x: int64, y: int64 }, mem(normal)]();

        p1: { x: int64, y: int64 } <- { x: 1, y: 2 };
        list1: List[{ x: int64, y: int64 }, mem(normal)] <- prepend[{ x: int64, y: int64 }, mem(normal)](p1, empty);

        p2: { x: int64, y: int64 } <- { x: 3, y: 4 };
        list2: List[{ x: int64, y: int64 }, mem(normal)] <- prepend[{ x: int64, y: int64 }, mem(normal)](p2, list1);

        list3: List[{ x: int64, y: int64 }, mem(normal)] <- prepend[{ x: int64, y: int64 }, mem(normal)]({ x: 5, y: 6 }, list2)
    produces
        pure list3
    end
}

fn sum_all_x_coordinates(points: List[{ x: int64, y: int64 }, mem(normal)], accumulator: int64) -> int64 {
   case points of {
        []: List[{ x: int64, y: int64 }, mem(normal)] -> 0
        [h: { x: int64, y: int64 }, t: List[{ x: int64, y: int64 }, mem(normal)]] -> {
            sum_all_x_coordinates(t, accumulator + h.x)
        }
        _: List[{ x: int64, y: int64 }, mem(normal)] -> 0
   }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            points: List[{ x: int64, y: int64 }, mem(normal)] <- create_point_list();
            total_x: int64 <- sum_all_x_coordinates(points, 0);
            total_x
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
