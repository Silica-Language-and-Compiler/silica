// record passed to a function; perimeter({ width: 2, height: 15 }) = 34
use trial_support_int64;

fn perimeter(r: { width: int64, height: int64 }) -> int64 {
    2 * (r.width + r.height)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            perimeter({ width: 2, height: 15 })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
