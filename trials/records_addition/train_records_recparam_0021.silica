// record passed to a function; area(make_rect(9, 6)) = 54
use trial_support_int64;

fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    { width: w, height: h }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            area(make_rect(9, 6))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
