// Trial 02: Inline Structs as Function Parameters
//
// Demonstrates:
// - Passing inline struct types to functions
// - Multiple fields in structs
// - Returning modified structs

use trial_support_atom;

fn calculate_distance(p: { x: int64, y: int64 }) -> int64 {
    x_sq: int64 <- p.x * p.x;
    y_sq: int64 <- p.y * p.y;
    x_sq + y_sq
}

fn move_point(p: { x: int64, y: int64 }, dx: int64, dy: int64) -> { x: int64, y: int64 } {
    moved: { x: int64, y: int64 } <- { x: p.x + dx, y: p.y + dy };
    moved
}

fn describe_person(person: { name: string, age: int64 }) -> string {
    name: string <- person.name;
    _age: int64 <- person.age;
    name
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            // Create a point and calculate distance
            point: { x: int64, y: int64 } <- { x: 3, y: 4 };
            dist: int64 <- calculate_distance(point);

            // Move the point
            _moved: { x: int64, y: int64 } <- move_point(point, 5, 6);

            // Work with person struct
            person: { name: string, age: int64 } <- { name: "Alice", age: 30 };
            _name_result: string <- describe_person(person);

            :ok
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
