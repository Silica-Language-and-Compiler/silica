// nested inline records; sum = 47
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
                top_left: { x: 30, y: 4 },
                bottom_right: { x: 6, y: 7 }
            };
            rect.top_left.x + rect.top_left.y + rect.bottom_right.x + rect.bottom_right.y
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
