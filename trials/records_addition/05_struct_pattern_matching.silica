// Trial 05: Pattern Matching with Inline Structs
//
// Demonstrates:
// - Destructuring structs in pattern matching
// - Pattern matching on struct fields
// - Type annotations in patterns

use trial_support_atom;

fn check_origin(p: { x: int64, y: int64 }) -> boolean {
    case p of {
        { x: 0, y: 0 } -> true;
        _ -> false
    }
}

fn classify_point(p: { x: int64, y: int64 }) -> atom {
    case p of {
        { x: 0, y: 0 } -> :origin;
        { x: 0, y: _ } -> :on_y_axis;
        { x: _, y: 0 } -> :on_x_axis;
        _ -> :general
    }
}

fn process_coordinate(p: { x: int64, y: int64 }) -> int64 {
    case p of {
        { x: x_val, y: y_val } if x_val > 0 -> x_val + y_val;
        { x: x_val, y: y_val } if y_val > 0 -> x_val + y_val;
        { x: x_val, y: y_val } -> x_val * y_val
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            origin: { x: int64, y: int64 } <- { x: 0, y: 0 };
            is_origin: boolean <- check_origin(origin);

            point: { x: int64, y: int64 } <- { x: 5, y: 10 };
            classification: atom <- classify_point(point);

            result: int64 <- process_coordinate(point);

            :ok
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
