// nested inline records; width = 13
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
                top_left: { x: 30, y: 23 },
                bottom_right: { x: 17, y: 3 }
            };
            rect.top_left.x - rect.bottom_right.x
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
