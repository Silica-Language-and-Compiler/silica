// Covering trial: a record with a function-valued field passed as a call
// argument. Once bound to a name and passed first, once as a record literal
// `{ f: inc }` written directly as the second argument of a two-argument call.
// The literal-argument form used to compile to a `{}` shape with unresolved
// field offsets.

use trial_support_int64;

fn inc(x: int64) -> int64 {
    x + 1
}

fn apply(w: { f: fn(int64) -> int64 }, x: int64) -> int64 {
    ff: fn(int64) -> int64 <- w.f;
    ff(x)
}

fn apply2(x: int64, w: { f: fn(int64) -> int64 }) -> int64 {
    ff: fn(int64) -> int64 <- w.f;
    ff(x)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                w: { f: fn(int64) -> int64 } <- { f: inc };
                a: int64 <- apply(w, 4);
                b: int64 <- apply2(4, { f: inc });
                print_int64(a);
                println("");
                print_int64(b);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
