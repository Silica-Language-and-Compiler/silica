// dangerous_ffi_same_unit_adapter  (OPEN compile defect: staged in
// compile_defects_ffi_same_unit_adapter_addition, see README.md)
//
// FFI spec §3.3 and §4.5: a call to any function of a dangerous_* module, its own adapters
// included, must sit in the sequence part of a `sequence proc[external_danger] ... end` block
// inside an FFI worker behaviour. Here the adapter add/2 lives in the same dangerous_* unit as the
// worker, which calls it unqualified inside its external_danger sequence: legal, and the effect is
// required. Found in project BEES triage (repro bees_triage/sd15c).
// Today (the stable compiler used for the BEES triage, Mac, 2026-10-23): rejected with E3010
// "unused effect external_danger" on the worker: the effect checker does not see the foreign
// call through a same-unit adapter (it does through a qualified call into another dangerous_*
// unit, ffi_addition/app_cast_worker_legacy_add).
// The adapter binds the foreign result before returning it, so this trial does not also hit the
// open tail-call defect (bees_gaps_open_addition/dangerous_ffi_adapter_tail_call).
// Expected: the worker adds 2 + 3 in C and casts 5 to the sink, which prints it and ends main's
// wait_for_exit with cast_exit(0).
//   5
//   done
//   0
module dangerous_ffi_same_unit_adapter;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(left: int64, right: int64) -> int64;

fn add(left: int64, right: int64) -> int64 {
    sum: int64 <- add_raw(left, right);
    sum + 0
}

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print_int64(msg);
        println("");
        println("done");
        _: boolean <- cast_exit(0)
    produces pure (:no_reply, state + 1) end
}

fn worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        sum: int64 <- add(2, msg);
        _: boolean <- cast(reply_to, sum impl ActorMessage {})
    produces pure (:no_reply, reply_to) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- start_reporter();
        s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        w: dangerous_actor_ref <- spawn_dangerous(s, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 3 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces pure code end
}

fn region_dump_limit() -> int64 {
    0
}

// One line per report; any failure ends main's wait_for_exit with cast_exit(70).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println("failure report");
        _: boolean <- cast_exit(70)
    produces
        pure (:no_reply, state + 1)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
