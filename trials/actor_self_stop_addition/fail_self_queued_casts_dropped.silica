// Spec §15.1.2.3: when an actor ends, the remaining non-call messages in its mailbox are dropped,
// and fail_self ends the actor at once. A cast-only worker under a :permanent supervisor, on
// message 0, casts 2 and 3 to itself (queued behind the message it is serving, §16.2.6.5) and then
// calls fail_self(:boom): the two queued casts are dropped, never printed, and the replacement
// (restarted with the initial state 10, after the driver's call_supervisor has synced with it) prints
// 7 -> 17 for main's later cast.
//
// Expected output (order checked as a multiset: the report is written by the FailureReporter):
//   worker 5 -> 15
//   worker failing
//   one failure report: reason_tag 4, frame #0 ..._worker   (:explicit, :boom)
//   children after the failure: 1
//   worker 7 -> 17
//   queued casts were dropped
// exit status 0; "worker 2" and "worker 3" never appear

use Supervisor;

impl FailSelfCastSup for Supervisor;

// The root supervisor: one child, :w, the worker, under restart policy :permanent; three restarts
// allowed in ten seconds.
fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 10000000000 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :w, agent_type: :worker, initial_state: 10, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

// Cast-only worker. 0 queues 2 and 3 to itself and fails; 7 prints and ends main's second wait;
// anything else prints.
fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    case msg of {
        0 -> {
            sequence proc[concurrency, device_io]
                _: atom <- println("worker failing");
                _: boolean <- cast(self(), 2 impl ActorMessage {});
                _: boolean <- cast(self(), 3 impl ActorMessage {});
                _: atom <- fail_self(:boom)
            produces
                pure (:no_reply, state)
            end
        };
        _: int64 -> {
            sequence proc[concurrency, device_io]
                next: int64 <- state + msg;
                print("worker ");
                print_int64(msg);
                print(" -> ");
                print_int64(next);
                println("");
                _: boolean <- case msg == 7 of {
                    true -> cast_exit(0);
                    false -> true
                }
            produces
                pure (:no_reply, next)
            end
        }
    }
}

// cast_exit is one request per program (§15.1.2.5) and main waits once, so the restarted worker is
// probed from an actor: the reporter pings the driver after the worker's report; the driver's
// call_supervisor reply drains the supervisor's ingress before it is sent, so once it returns the
// exit has been handled and the restart has settled; then the driver casts 7 to :w.
fn driver(msg: int64, state: supervisor_ref) -> (:no_reply, supervisor_ref) {
    sequence proc[concurrency, device_io]
        n: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(state, { op: :count_children } impl SupervisorMessage {});
        print("children after the ");
        print("failure");
        print(": ");
        print_int64(n.count);
        println("");
        _: boolean <- cast_registered(:w, 7 impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        rt: supervisor_ref <- spawn_registered_supervisor(FailSelfCastSup, 0, :root, stack_policy(0, :keep_last_message));
        _: actor_ref <- spawn_registered(rt, driver, :driver, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:w, 5 impl ActorMessage {});
        _: boolean <- cast_registered(:w, 0 impl ActorMessage {});
        code: int64 <- wait_for_exit();
        println("queued casts were dropped")
    produces
        pure code
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started. region_dump_limit is
// called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// The reporter writes every report to standard error and pings the driver; the root supervisor's
// own report ends the program with status 70 instead.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> cast_registered(:driver, 1 impl ActorMessage {})
        }
    produces
        pure (:no_reply, state + 1)
    end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
