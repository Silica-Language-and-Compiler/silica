// expected failure E1040: missing ';' between two statements
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((25.5 - 24.0) == (26.75 + 30.5));
                println("");
                _: atom <- print_boolean((8.0 - 15.125) <= (41.5 + 33.0));
                println("")
                done: atom <- print_boolean((24.75 + 7.0) != 4.0 * 35.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
