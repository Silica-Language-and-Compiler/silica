// expected failure E1047: named struct declaration 'Point' is not allowed
// sequence prints and returns the same sum 31
use trial_support_int64;

struct Point { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                a: int64 <- 24;
                b: int64 <- 7;
                print_int64(a + b);
                println("");
                total: int64 <- a + b
            produces pure total end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
