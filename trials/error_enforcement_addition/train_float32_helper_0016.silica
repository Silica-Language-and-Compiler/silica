// expected failure E2003: combine returns float64 but its result feeds print_float32
// float32 helper combine; prints -17.75
use trial_support_atom;

fn combine(x: float32) -> float64 {
    x - 36.5 + 2.0
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float32(combine(16.75))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
