// expected failure E2001: integer literal operand to and
// and/or truth table bits (bool alias accepted); want 28
use trial_support_int64;

fn tt() -> bool {
    true
}

fn ff() -> bool {
    false
}

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            r0: int64 <- bit(1 and tt(), 1);
            r1: int64 <- bit(ff() or ff(), 2);
            r2: int64 <- bit(tt() and tt(), 4);
            r3: int64 <- bit(tt() or ff(), 8);
            r4: int64 <- bit(ff() or tt(), 16);
            r0 + r1 + r2 + r3 + r4
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
