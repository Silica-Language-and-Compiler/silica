// expected failure E2005: call to unknown function 'pairx'
// pair returns a pair; p + q = 60
use trial_support_int64;

fn pair(x: int64, y: int64) -> (int64, int64) {
    (x + 1, y * 2)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (p: int64, q: int64) <- pairx(31, 14);
            p + q
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
