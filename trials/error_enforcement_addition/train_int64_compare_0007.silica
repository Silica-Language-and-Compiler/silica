// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == (8 + 45) >= (41 + 46));
                println("");
                _: atom <- print_boolean(35 < 51 / 57);
                println("");
                _: atom <- print_boolean(6 * 30 <= (51 + 60));
                println("");
                result: atom <- print_boolean((12 + 18) != (36 - 23))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
