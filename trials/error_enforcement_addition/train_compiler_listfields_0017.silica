// expected failure E2005: unknown list field
// list field accessors is_nil/head; want 37
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [37, 10, 46];
                r: int64 <- case xs.is_nil of {
                    true -> 0;
                    false -> xs.first
                }
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
