// expected failure E2015: list pattern without its mem(Space)
// case on an empty list; expect 8
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                r: int64 <- case xs of {
                    []: List[int64] -> 8;
                    [h: int64, _: List[int64, mem(normal)]] -> h + 97;
                    _: List[int64, mem(normal)] -> 8
                }
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
