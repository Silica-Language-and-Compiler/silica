// expected failure E1055: block-local binding never used
// case arms with multi-statement block bodies; expect 29
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- 2;
            case x of {
                0 -> {
                    base: int64 <- 18;
                    18 * 2
                }
                _: int64 -> {
                    step: int64 <- 14;
                    x * step + 1
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
