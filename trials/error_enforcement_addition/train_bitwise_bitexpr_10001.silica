// expected failure E2018: binding 'five' has no type annotation
// uint64 bitwise: (flags bor five) band mask = 4
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            flags: uint64 <- 1;
            five <- 4;
            mask: uint64 <- 14;
            (flags bor five) band mask
        });
        _: int64 <- wait_for_exit()
    produces
        pure 4
    end
}
