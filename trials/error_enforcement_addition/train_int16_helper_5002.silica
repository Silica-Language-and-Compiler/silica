// expected failure E2003: parameter x declared int8 in a int16 helper
// helper adjust/1 on int16; adjust(20) = 27
use trial_support_int16;

fn adjust(x: int8) -> int16 {
    x + 40 - (x + 13)
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            adjust(20)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 27
    end
}
