// expected failure E2001: string literal used as a list index
// list_at index 0 of [22, 5, 24, 12, 2] is 22
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [22, 5, 24, 12, 2];
                v: int64 <- list_at[int64, mem(normal)](xs, "0")
                produces pure v end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
