// expected failure E1042: function 'main' has no return type
// float16 comparisons
use trial_support_atom;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((20.75 - 18.5) <= (6.25 + 25.0));
                println("");
                _: atom <- print_boolean((27.75 + 25.5) != (28.75 + 37.0));
                println("");
                done: atom <- print_boolean(20.0 * 32.5 < 18.25)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
