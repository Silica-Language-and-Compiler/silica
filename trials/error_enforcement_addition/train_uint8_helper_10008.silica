// expected failure E2001: string literal passed where an integer parameter is expected
// helper blend/3 on uint8; blend(4, 4, 12) = 0
use trial_support_uint8;

fn blend(x: uint8, y: uint8, z: uint8) -> uint8 {
    (32 * x) * (z % y)
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            blend("4", 4, 12)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
