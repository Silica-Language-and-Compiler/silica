// expected failure E1045: function 'main' declared without the fn keyword
// case on an empty list; expect 66
use trial_support_int64;

main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                r: int64 <- case xs of {
                    []: List[int64, mem(normal)] -> 66;
                    [h: int64, _: List[int64, mem(normal)]] -> h + 49;
                    _: List[int64, mem(normal)] -> 66
                }
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
