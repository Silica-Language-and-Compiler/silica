// expected failure E3009: proc[...] written on the function return type instead of the sequence
// float16 comparisons
use trial_support_atom;

fn main() -> atom proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(5.5 != (7.0 - 4.75));
                println("");
                _: atom <- print_boolean((14.0 - 35.5) <= 5.5);
                println("");
                _: atom <- print_boolean(20.0 <= (1.0 + 37.5));
                println("");
                done: atom <- print_boolean((1.5 - 18.25) < 10.5)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
