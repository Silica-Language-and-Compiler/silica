// expected failure E1042: function 'main' has no return type
// uint64 bitwise: (((bnot bits) band three) + hi) = 13
use trial_support_uint64;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            bits: uint64 <- 7;
            three: uint64 <- 4;
            hi: uint64 <- 13;
            (((bnot bits) band three) + hi)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
