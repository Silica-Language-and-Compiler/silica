// expected failure E2018: binding 'mode' has no type annotation
// case over atoms; :green selects 59
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode <- :green;
            case mode of {
                :idle -> 3;
                :gamma -> 59;
                :green -> 59;
                _: atom -> 93
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
