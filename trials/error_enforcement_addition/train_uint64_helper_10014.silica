// expected failure E4015: function 'scale' defined twice
// helper scale/2 on uint64; scale(2, 5) = 127
use trial_support_uint64;

fn scale(x: uint64, y: uint64) -> uint64 {
    (y + x + x * 60)
}

fn scale(x: uint64, y: uint64) -> uint64 {
    (y + x + x * 60)
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            scale(2, 5)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 127
    end
}
