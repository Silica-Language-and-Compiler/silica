// expected failure E1043: whitespace between binding name 'v' and ':'
// case on uint64 value 29; expect 35
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v :uint64 <- 29;
            case v of {
                25 -> 198;
                31 -> 118;
                39 -> 15;
                n: uint64 if n > 3 -> 35;
                _: uint64 -> 35
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 35
    end
}
