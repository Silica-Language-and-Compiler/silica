// expected failure E1055: binding 'spare' is never used
// head on [8, 32, 17, 28] gives 8
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            spare: int64 <- 41;
            sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [8, 32, 17, 28];
                first: int64 <- head[int64, mem(normal)](xs)
                produces pure first end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
