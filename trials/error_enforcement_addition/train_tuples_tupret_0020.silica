// expected failure E2005: call to unknown function 'my_divmod'
// divmod returns a pair; p + q = 7
use trial_support_int64;

fn divmod(x: int64, y: int64) -> (int64, int64) {
    (x / y, x % y)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (p: int64, q: int64) <- my_divmod(47, 9);
            p + q
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
