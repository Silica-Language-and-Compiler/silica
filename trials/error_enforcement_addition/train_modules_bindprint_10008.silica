// expected failure E1049: sequence block without produces
// qualified call bound then printed; prints 28
use lib_beta;
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] v: int64 <- lib_beta@twice(14);
                result: atom <- print_int64(v)
                pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
