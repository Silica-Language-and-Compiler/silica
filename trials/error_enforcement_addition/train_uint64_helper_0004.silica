// expected failure E1045: function 'blend' declared without the fn keyword
// helper blend/1 on uint64; blend(2) = 40
use trial_support_uint64;

blend(x: uint64) -> uint64 {
    ((37 + 3) * (x / x))
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            blend(2)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 40
    end
}
