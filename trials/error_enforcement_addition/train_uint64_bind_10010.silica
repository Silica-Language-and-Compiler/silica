// expected failure E2013: unary minus on a variable instead of negate_uint64
// uint64 bindings then expression; expect 52
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            base: uint64 <- 47 + 1 + (58 + 43);
            a: uint64 <- 26;
            -base + (a + a) % (23 * 9) + base - base
        });
        _: int64 <- wait_for_exit()
    produces
        pure 52
    end
}
