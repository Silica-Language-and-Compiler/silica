// expected failure E2003: binding total declared uint16 but used as int64
// int64 bindings then expression; expect 1
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            total: uint16 <- 32;
            step: int64 <- total / total;
            d: int64 <- total + 33 + (12 - 27);
            count: int64 <- total;
            (23 + d) / d + step - step + count - count
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
