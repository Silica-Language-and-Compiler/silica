// expected failure E2013: unary minus on a variable instead of negate_int32
// int32 bindings then expression; expect 1
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            count: int32 <- 32;
            a: int32 <- (4 + 6) + count;
            c: int32 <- 31;
            -count + (56 - 42) / (a % c)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
