// expected failure E2001: string element prepended to an integer list
// 1 prepends after empty; head is 3
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)]("3", xs0);
                h: int64 <- head[int64, mem(normal)](xs1)
            produces pure h end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
