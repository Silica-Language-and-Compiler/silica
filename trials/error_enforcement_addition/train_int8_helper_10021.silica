// expected failure E2003: parameter x declared uint8 in a int8 helper
// helper adjust/2 on int8; adjust(14, 4) = 2
use trial_support_int8;

fn adjust(x: uint8, y: int8) -> int8 {
    (y * 6 / (52 % x))
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            adjust(14, 4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
