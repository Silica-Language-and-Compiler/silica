// expected failure E2011: -0x8000000000000001 is one below the int64 minimum -0x8000000000000000
use trial_support_atom;

fn low() -> int64 {
    -0x8000000000000001
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_int64(low())
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
