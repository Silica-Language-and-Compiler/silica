// expected failure E2005: call to unknown function 'print_int6z'
// print_int64 two; prints 73 then 13
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: int64 <- 29 + 44;
                b: int64 <- 13;
                _: atom <- print_int6z(a);
                println("");
                result: atom <- print_int64(b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
