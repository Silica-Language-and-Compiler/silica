// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on int16; digit_count(120) = 3
use trial_support_int16;

fn digit_count(n: int16) -> int16 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            digit_count(120)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
