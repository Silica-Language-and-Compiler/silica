// E2412: a carrier declaration names a link this target's transport pack does not provide (links design
// §5.1, §5.2): a UART is a board link; a hosted serial port is (:serial_port, path, baud). The
// declaration is rejected by the target's verifier wherever it appears, even when nothing uses it.
carried_on host_line: (:serial) (:uart, 1, 115200);

fn main() -> int64 {
    0
}
