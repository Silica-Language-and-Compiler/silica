// expected failure E2005: call to unknown function 'print_stringx'
// effectful sequence used as a statement before the return value 60
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_stringx("apple");
                println("")
            produces pure :ok end;
            60
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
