// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// sequence prints and returns the same sum 35
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                a: int64 <- 5;
                b: int64 <- 30;
                print_int64(a + b);
                println("");
                total: int64 <- a + b
            produces
                pure total
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
