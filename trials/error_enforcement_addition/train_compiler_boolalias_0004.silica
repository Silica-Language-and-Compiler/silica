// expected failure E1055: binding 'leftover' is never used
// bool and boolean name the same type
use trial_support_int64;

fn both(x: bool, y: boolean) -> bool {
    leftover: int64 <- 41;
    x and y
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case both(false, true) of {
                true -> 1;
                false -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
