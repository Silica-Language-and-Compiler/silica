// expected failure E2001: atom literal returned from a float16 function
// main returns float16; exit code is trunc(0.75 + (27.5 - 22.0)) = 6
use trial_support_float16;

fn main() -> float16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            :done
        });
        _: int64 <- wait_for_exit()
    produces
        pure 6.25
    end
}
