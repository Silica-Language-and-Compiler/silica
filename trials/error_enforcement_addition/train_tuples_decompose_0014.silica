// expected failure E2005: decomposition element typed as string against an int64 slot
// decompose a 2-tuple from a binding; a + b = 47
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            t: (int64, int64) <- (18, 29);
            (a: int64, b: string) <- t;
            a + b
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
