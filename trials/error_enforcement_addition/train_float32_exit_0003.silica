// expected failure E1045: function 'main' declared without the fn keyword
// main returns float32; exit code is trunc(40.375) = 40
use trial_support_float32;

main() -> float32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float32@start();
        _: boolean <- trial_support_float32@run(fn() -> float32 {
            40.375
        });
        _: int64 <- wait_for_exit()
    produces
        pure 40.375
    end
}
