// expected failure E1070: compute given nine parameters
// helper compute/2 on int32; compute(5, 3) = 0
use trial_support_int32;

fn compute9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn compute(x: int32, y: int32) -> int32 {
    (x - x) * (22 / y)
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            compute(5, 3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
