// expected failure E1055: binding 'scratch' is never used
// main returns the runtime-seeded atom :normal; exit code 3
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            scratch: int64 <- 41;
            :normal
        });
        _: int64 <- wait_for_exit()
    produces
        pure :normal
    end
}
