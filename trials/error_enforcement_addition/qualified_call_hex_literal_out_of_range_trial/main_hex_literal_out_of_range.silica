// A hexadecimal literal argument through a module-qualified call is checked against the uint32
// parameter's range by its radix: 0xFFFFFFFFF has 36 bits, so this is E2011 like the same-module
// let and argument forms (hex_literal_uint32_let_out_of_range, hex_literal_uint32_arg_out_of_range).
use LiteralLib;
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            LiteralLib@next_u32(0xFFFFFFFFF)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
