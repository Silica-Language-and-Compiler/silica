// E2418: An (:interface, name) link with a "listen:any:<port>" literal: the carrier would refuse it at :open (hosted Ethernet plan E2 items 1 and 4, links design §3.2). The checker sees the
// declaration, the spawn and the address literal in one function, so the program is rejected here instead of
// ending at run time with (:explicit, :link_unavailable).
carried_on net: (:tcp) (:interface, "lo0");

fn main() -> int64 {
    sequence proc[concurrency]
        car: dangerous_actor_ref <- spawn_dangerous_carrier(net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(car, (:open, actor_ref_of_word(0), "listen:any:0") impl ActorMessage {})
    produces
        pure 0
    end
}
