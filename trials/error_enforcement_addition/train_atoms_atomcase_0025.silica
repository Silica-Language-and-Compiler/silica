// expected failure E2018: binding 'mode' has no type annotation
// case over atoms; :up selects 70
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode <- :up;
            case mode of {
                :idle -> 12;
                :up -> 70;
                :start -> 16;
                _: atom -> 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
