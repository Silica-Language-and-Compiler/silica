// Spec §15.4.13.4 "Handler before any start" (E2236): starts are followed transitively, through local
// functions and into other modules. main calls boot, which calls e2236_start_lib@start(), which
// starts a supervisor; nothing has registered a FailureReporter, so the error is reported at main's
// call to boot.

use e2236_start_lib;

fn boot() -> supervisor_ref {
    e2236_start_lib@start()
}

fn main() -> int64 {
    sequence proc[concurrency]
        _: supervisor_ref <- boot();
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
