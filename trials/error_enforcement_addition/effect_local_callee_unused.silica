// E3010: effects are local (silica-specification §9.3.1 rule 4). say declares device_io for its
// own prints. pick calls say from a case arm and declares device_io as if say's effect propagated
// to it; pick performs no device_io operation of its own, so the declaration is unused.
// The accepted form is trials/effect_check_addition/effect_local_callee_in_case_arm.
// Expected: E3010 "Unused effect declaration: device_io" at pick's sequence.

use trial_support_int64;

fn say(n: int64) -> int64 {
    sequence proc[device_io]
        print_int64(n);
        println("")
    produces
        pure n
    end
}

fn pick(b: boolean) -> int64 {
    sequence proc[device_io]
        r: int64 <- case b of {
            true -> say(1);
            false -> 0
        }
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(pick(true));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
