// expected failure E1049: sequence block without produces
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(1 == 3 * 15);
                println("");
                _: atom <- print_boolean(13 <= 31);
                println("");
                result: atom <- print_boolean((57 + 57) < 30 % 6)
                pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
