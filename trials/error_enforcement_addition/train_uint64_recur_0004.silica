// expected failure E2005: boolean case missing its false branch
// recursive pow2 on uint64; pow2(0) = 1
use trial_support_uint64;

fn pow2(n: uint64) -> uint64 {
    case n == 0 of {
        true -> 1
    }
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            pow2(0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
