// expected failure E1065: parameter list of 'double_len' is not closed
// double_len("cherry") = 12
use trial_support_int64;

fn double_len(s: string -> int64 {
    length_chars(s) * 2
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            double_len("cherry")
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
