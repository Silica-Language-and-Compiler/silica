// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == 17 % 24 <= (1 + 38));
                println("");
                _: atom <- print_boolean((48 + 54) <= (51 + 55));
                println("");
                _: atom <- print_boolean(35 == 49 * 52);
                println("");
                result: atom <- print_boolean(25 == 10 / 55)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
