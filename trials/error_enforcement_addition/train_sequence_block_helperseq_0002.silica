// expected failure E2005: call to unknown function 'length_bytesx'
// pure sequence inside a helper; churn(5) = 13
use trial_support_int64;

fn churn(n: int64) -> int64 {
    sequence
        a: string <- concatenate("xx", "yy");
        b: string <- concatenate(a, a)
    produces
        pure length_bytesx(b) + n
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            churn(5)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
