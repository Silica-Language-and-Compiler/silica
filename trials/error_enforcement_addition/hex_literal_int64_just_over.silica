// expected failure E2011: 0x8000000000000000 is one past the int64 maximum 0x7FFFFFFFFFFFFFFF
use trial_support_atom;

fn big() -> int64 {
    0x8000000000000000
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_int64(big())
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
