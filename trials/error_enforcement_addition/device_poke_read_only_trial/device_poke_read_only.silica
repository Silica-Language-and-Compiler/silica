// expected failure E2215: poke to a :read_only register (device spec §4.9)
use DeviceDescription;
use trial_support_int64;

impl fn registers(device: (:test_uart)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :fifo,    offset: 0x00, width: 32, access: :read_write },
        { name: :int_raw, offset: 0x04, width: 32, access: :write_one_to_clear },
        { name: :status,  offset: 0x1C, width: 32, access: :read_only },
        { name: :ctrl,    offset: 0x20, width: 32, access: :write_only }
    ]
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        w: device_window(L, (:test_uart)) <- map_device((:test_uart), 0x60000000);
        _: atom <- poke(w, :status, 1 impl Register32 {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                d: device_actor_ref <- spawn_device(0, worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast_device(d, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
