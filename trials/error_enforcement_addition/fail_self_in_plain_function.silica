// Spec §15.1.2.3: fail_self ends the calling actor; it is a behaviour-only builtin, as kill_abnormal
// is. A plain function has no actor of its own, so fail_self there is rejected at compile time with
// E2091 ActorOperationPlacement, even though the function is only ever called from a behaviour.

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn give_up(reason: atom) -> atom {
    sequence proc[concurrency]
        r: atom <- fail_self(reason)
    produces
        pure r
    end
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    case msg of {
        0 -> (:no_reply, give_up_state(state));
        _: int64 -> (:no_reply, state + msg)
    }
}

fn give_up_state(state: int64) -> int64 {
    sequence proc[concurrency]
        _: atom <- give_up(:badarg)
    produces
        pure state
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
