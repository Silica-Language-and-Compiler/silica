// expected failure E2003: a declared float64 but combined with a float16 value
// float16 bindings 11.25 + 23.5 printed as 34.75
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: float64 <- 11.25;
                b: float16 <- 23.5;
                result: atom <- print_float16(a + b)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
