// expected failure E1070: adjust given nine parameters
// helper adjust/2 on uint16; adjust(11, 2) = 121
use trial_support_uint16;

fn adjust9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn adjust(x: uint16, y: uint16) -> uint16 {
    (9 + y) * x
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            adjust(11, 2)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 121
    end
}
