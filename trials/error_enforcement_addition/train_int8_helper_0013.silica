// expected failure E1045: function 'adjust' declared without the fn keyword
// helper adjust/1 on int8; adjust(16) = 30
use trial_support_int8;

adjust(x: int8) -> int8 {
    ((x + 44) / (18 % x))
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            adjust(16)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 30
    end
}
