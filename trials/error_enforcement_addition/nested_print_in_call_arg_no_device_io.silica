// E3002: a print built-in nested in a call argument, show(print_int8(1)), needs device_io from an
// enclosing sequence exactly as a direct call does (silica-specification.md §9.3.1). main's sequence
// declares (and uses) concurrency only, so the nested call is the error, reported at its own
// location. The accepted form is trials/compile_defects_nested_print_in_call_arg_addition.

use trial_support_atom;

fn peer(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn show(r: atom) -> atom {
    r
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency]
                _: actor_ref <- spawn(0, peer, stack_policy(0, :keep_last_message));
                last: atom <- show(print_int8(1))
            produces
                pure last
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
