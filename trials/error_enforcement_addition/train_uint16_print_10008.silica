// expected failure E2003: amount is uint16 but passed to print_uint32
// print_uint16 var; prints 76
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] amount: uint16 <- 36 + 40;
                result: atom <- print_uint32(amount)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
