// expected failure E2013: unary minus on a variable instead of negate_uint32
// uint32 bindings then expression; expect 52
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            width: uint32 <- 26 + 16;
            b: uint32 <- width;
            a: uint32 <- 26;
            -width + 52 + b - b + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 52
    end
}
