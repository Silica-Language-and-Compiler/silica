// Spec §15.1.4: actor_id has the effect proc[concurrency]. A sequence that calls it without
// declaring concurrency is an effect error.

fn show_id(r: actor_ref) -> int64 {
    sequence proc[device_io]
        print_uint64(actor_id(r));
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    0
}
