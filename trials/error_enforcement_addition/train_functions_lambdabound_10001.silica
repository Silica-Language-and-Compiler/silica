// expected failure E1055: binding 'unused_value' is never used
// function literal bound to a typed variable; f(9) = 12
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            unused_value: int64 <- 41;
            f: fn(int64) -> int64 <- fn(x: int64) -> int64 { x + 3 };
            f(9)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
