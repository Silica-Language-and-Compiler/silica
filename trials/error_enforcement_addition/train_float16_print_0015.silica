// expected failure E1051: sequence block without a closing end
// print_float16 of 40.5 + 32.0 - 6.5; prints 66.0
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float16(40.5 + 32.0 - 6.5)
                produces pure result
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
