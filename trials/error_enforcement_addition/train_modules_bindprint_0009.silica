// expected failure E1050: produces clause without pure
// qualified call bound then printed; prints 10
use lib_middle;
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                v: int64 <- lib_middle@ten();
                result: atom <- print_int64(v)
            produces result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
