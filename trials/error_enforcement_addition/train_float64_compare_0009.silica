// expected failure E1055: binding 'unused_value' is never used
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            unused_value: int64 <- 41;
            sequence proc[device_io]
                _: atom <- print_boolean(11.25 >= (17.25 - 3.5));
                println("");
                _: atom <- print_boolean((22.0 + 2.5) != 24.125);
                println("");
                done: atom <- print_boolean(4.75 >= (18.5 + 31.0))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
