// Spec §16.3.2 / §5: the arm markers of a case bound to a name do not travel with the name. m is
// bound from a case whose arms are all marked, but `call(w, m)` passes m without a marker at the
// call site, so the operand does not implement ActorMessage: E2005.
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + 1, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
                flag: boolean <- true;
                m: int64 <- case flag of {
                    true -> 5 impl ActorMessage {};
                    false -> 7 impl ActorMessage {}
                };
                r: int64 <- call(w, m)
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
