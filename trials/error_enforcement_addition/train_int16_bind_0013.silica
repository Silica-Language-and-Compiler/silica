// expected failure E2018: binding 'count' has no type annotation
// int16 bindings then expression; expect 28
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            count <- (51 + 56) * (34 + 51);
            width: int16 <- count;
            a: int16 <- (48 + 25) / 44;
            (44 - 16) % (count + count) + width - width + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 28
    end
}
