// expected failure E2002: undefined identifier 'nx'
// guards partition int64 into three ranges; n = 76 gives 152
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 76;
            case n of {
                n: int64 if n < 53 -> n - 1;
                n: int64 if n >= 53 and nx < 86 -> n * 2;
                n: int64 if n >= 86 -> n - 1
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
