// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == 33 % 59 > (9 + 32));
                println("");
                _: atom <- print_boolean((27 + 12) <= 17 / 56);
                println("");
                _: atom <- print_boolean(22 * 5 == 29 / 7);
                println("");
                _: atom <- print_boolean((35 + 44) != 7);
                println("");
                result: atom <- print_boolean(17 >= (60 - 9))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
