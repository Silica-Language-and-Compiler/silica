// expected failure E4015: function 'is_positive' defined twice
// guard calls a boolean helper; z = -18 gives 0
use trial_support_int64;

fn is_positive(v: int64) -> boolean {
    v > 0
}

fn is_positive(v: int64) -> boolean {
    v > 0
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            z: int64 <- -18;
            case z of {
                z: int64 if is_positive(z) -> z * 2;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
