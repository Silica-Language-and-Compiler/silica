// expected failure E1043: whitespace between binding name 'result' and ':'
// float64 helper combine; prints 635.0625
use trial_support_atom;

fn combine(x: float64) -> float64 {
    x * 29.375 + 3.5
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result :atom <- print_float64(combine(21.5))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
