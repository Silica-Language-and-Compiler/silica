// expected failure E2005: boolean case missing its false branch
// recursive pow2 on int32; pow2(6) = 64
use trial_support_int32;

fn pow2(n: int32) -> int32 {
    case n == 0 of {
        true -> 1
    }
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            pow2(6)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 64
    end
}
