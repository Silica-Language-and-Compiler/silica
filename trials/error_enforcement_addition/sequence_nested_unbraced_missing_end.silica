// E1051 at the nested block's boundary: the unbraced nested sequence block has no `end`, so its pure
// expression runs into the enclosing block's `produces`; reported there, not as a defect of the
// enclosing block (which before 2026-10-08 took the nested block's keywords as its own).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("outer");
                v: int64 <- sequence proc[device_io]
                    println("inner")
                produces
                    pure 41;
                w: int64 <- v + 1
            produces
                pure w
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
