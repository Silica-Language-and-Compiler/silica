// expected failure E2003: string field printed with print_int64
// print each field of a mixed record
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                person: { name: string, age: int64, active: boolean } <- { name: "hello", age: 12, active: true };
                print_int64(person.name);
                println("");
                print_int64(person.age);
                println("");
                print_boolean(person.active);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
