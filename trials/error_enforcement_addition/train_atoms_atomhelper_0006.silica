// expected failure E1047: named struct declaration 'Pair' is not allowed
// helper returning :ok for positive input
use trial_support_atom;

struct Pair { x: int64, y: int64 }

fn status(n: int64) -> atom {
    case n > 0 of {
        true -> :ok;
        false -> :red
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            status(9)
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
