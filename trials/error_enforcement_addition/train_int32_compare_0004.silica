// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == (17 - 5) > (25 + 53));
                println("");
                _: atom <- print_boolean((42 + 3) == 16 % 57);
                println("");
                _: atom <- print_boolean(53 <= 33);
                println("");
                _: atom <- print_boolean(37 > 57 * 43);
                println("");
                result: atom <- print_boolean(7 * 17 >= (1 + 11))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
