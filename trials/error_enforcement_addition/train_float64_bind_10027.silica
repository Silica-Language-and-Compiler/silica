// expected failure E1050: produces clause without pure
// float64 bindings 4.0 - 32.0 printed as -28.0
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: float64 <- 4.0;
                b: float64 <- 32.0;
                result: atom <- print_float64(a - b)
            produces
                result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
