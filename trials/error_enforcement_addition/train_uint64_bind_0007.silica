// expected failure E2013: unary minus on a variable instead of negate_uint64
// uint64 bindings then expression; expect 27
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            d: uint64 <- 44 / 19;
            height: uint64 <- d;
            width: uint64 <- 54 + 37 + 41;
            a: uint64 <- (4 % height) + 42;
            -d + 27 + width - width + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 27
    end
}
