// Spec §5.1.4: the boolean print built-in is print_boolean. print_bool, its pre-spec
// spelling, is no longer an accepted name; a call to it is E2007, like any other undefined name.
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            print_bool(true)
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
