// expected failure E1045: function 'div' declared without the fn keyword
// four arithmetic helpers; add(5, 9) + mul(8, 1) = 22
use trial_support_int64;

fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add(5, 9) + mul(8, 1)//22
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
