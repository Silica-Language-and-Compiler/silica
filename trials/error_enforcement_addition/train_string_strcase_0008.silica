// expected failure E2005: integer pattern against a string scrutinee
// case on string literals; "banana" gives 58
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "banana";
            case mode of {
                1 -> 38;
                "south" -> 48;
                "banana" -> 58;
                _: string -> 91
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
