// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// case on a non-empty list; expect 106
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                xs: List[int64, mem(normal)] <- [35];
                r: int64 <- case xs of {
                    []: List[int64, mem(normal)] -> 96;
                    [h: int64, _: List[int64, mem(normal)]] -> h + 71;
                    _: List[int64, mem(normal)] -> 96
                }
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
