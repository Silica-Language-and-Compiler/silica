// expected failure E2018: binding 'result' has no type annotation
// float64 bindings 4.75 - 28.5 printed as -23.75
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: float64 <- 4.75;
                b: float64 <- 28.5;
                result <- print_float64(a - b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
