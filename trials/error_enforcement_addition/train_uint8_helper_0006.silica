// expected failure E1070: combine given nine parameters
// helper combine/3 on uint8; combine(9, 15, 7) = 0
use trial_support_uint8;

fn combine9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn combine(x: uint8, y: uint8, z: uint8) -> uint8 {
    x / y * (y + z)
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            combine(9, 15, 7)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
