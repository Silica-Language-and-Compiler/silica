// expected failure E1055: binding 'spare' is never used
// uint64 bindings then expression; expect 2
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            spare: int64 <- 41;
            total: uint64 <- 4;
            b: uint64 <- 1;
            d: uint64 <- 27;
            height: uint64 <- 42 / total;
            40 / 17 + b - b + d - d + height - height
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
