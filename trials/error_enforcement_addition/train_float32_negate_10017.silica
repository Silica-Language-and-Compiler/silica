// expected failure E1049: sequence block without produces
// negate_float32 applied 3 time(s); prints -6.0
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float32(negate_float32(negate_float32(negate_float32(6.0))))
            pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
