// expected failure E1071: a function literal must declare its return type with `->` (spec 3.3.6).
// `fn(a: int64) { a + 41 }` has no `-> int64`; the type is never inferred. Before E1071 the literal
// was lifted to main.__lam0 with an empty return type and reported as E2003 "type mismatch: main.__lam0".
use trial_support_int64;

fn take(op: fn(a: int64) -> int64) -> int64 {
    op(1)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            take(fn(a: int64) { a + 41 })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
