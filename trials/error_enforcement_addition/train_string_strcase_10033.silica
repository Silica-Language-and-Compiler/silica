// expected failure E2001: string result in an integer case arm
// case on string literals; "actor" gives 55
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "actor";
            case mode of {
                "cloud" -> "cloud";
                "actor" -> 55;
                "north" -> 0;
                _: string -> 78
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
