// expected failure E1042: function 'main' has no return type
// helper blend/2 on uint64; blend(17, 1) = 102
use trial_support_uint64;

fn blend(x: uint64, y: uint64) -> uint64 {
    (y + 2) * (x + x)
}

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            blend(17, 1)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 102
    end
}
