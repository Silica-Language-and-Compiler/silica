// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint64 value 38; expect 191
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 38;
            case v of {
                "one" -> 18;
                _: uint64 -> 191
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 191
    end
}
