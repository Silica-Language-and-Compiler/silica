// expected failure E1055: binding 'unused_value' is never used
// power(6, 1) = 6
use trial_support_int64;

fn power(b: int64, e: int64) -> int64 {
    unused_value: int64 <- 41;
    case e == 0 of {
        true -> 1;
        false -> b * power(b, e - 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            power(6, 1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
