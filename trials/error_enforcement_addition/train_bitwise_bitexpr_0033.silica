// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (bits bor seven) bor flags = 15
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            bits: uint64 <- true;
            seven: uint64 <- 2;
            flags: uint64 <- 12;
            (bits bor seven) bor flags
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
