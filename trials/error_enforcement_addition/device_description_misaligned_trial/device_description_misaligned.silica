// expected failure E2205: a register offset that is not a multiple of its width in bytes (device spec §4.9)
use DeviceDescription;
use trial_support_int64;

impl fn registers(device: (:test_uart)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :fifo, offset: 0x02, width: 32, access: :read_write }
    ]
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        w: device_window(L, (:test_uart)) <- map_device((:test_uart), 0x60000000);
        _: uint32 <- peek(w, :fifo) impl Register32 {}
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                d: device_actor_ref <- spawn_device(0, worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast_device(d, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
