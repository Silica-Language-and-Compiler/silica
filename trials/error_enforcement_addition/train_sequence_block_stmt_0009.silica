// expected failure E1050: produces clause without pure
// effectful sequence used as a statement before the return value 63
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_string("world");
                println("")
            produces :ok end;
            63
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
