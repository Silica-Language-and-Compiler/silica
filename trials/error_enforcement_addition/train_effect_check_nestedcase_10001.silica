// expected failure E1045: function 'main' declared without the fn keyword
// Positive: device_io only in a nested case arm inside sequence proc[device_io] still counts as used
use trial_support_atom;

main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            outer: int64 <- 2;
            inner: int64 <- 0;
            sequence proc[device_io]
                result: atom <- case outer of {
                    0 -> print_int64(3);
                    _: int64 -> case inner of {
                        2 -> print_int64(4);
                        _: int64 -> print_int64(4)
                    }
                }
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
