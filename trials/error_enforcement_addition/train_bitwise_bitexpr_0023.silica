// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (((bnot lo) band three) + flags) = 15
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            lo: uint64 <- true;
            three: uint64 <- 11;
            flags: uint64 <- 5;
            (((bnot lo) band three) + flags)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
