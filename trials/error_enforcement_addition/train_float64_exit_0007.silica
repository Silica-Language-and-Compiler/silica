// expected failure E2001: atom literal returned from a float64 function
// main returns float64; exit code is trunc(9.0) = 9
use trial_support_float64;

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            :done
        });
        _: int64 <- wait_for_exit()
    produces
        pure 9.0
    end
}
