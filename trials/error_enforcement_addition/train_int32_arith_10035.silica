// expected failure E1047: named struct declaration 'Pair' is not allowed
// int32 arithmetic: 6 / 20 - (24 - 20) + 21 % 44 = 17
use trial_support_int32;

struct Pair { x: int64, y: int64 }

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            6 / 20 - (24 - 20) + 21 % 44
        });
        _: int64 <- wait_for_exit()
    produces
        pure 17
    end
}
