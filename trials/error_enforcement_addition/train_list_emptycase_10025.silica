// expected failure E1045: function 'main' declared without the fn keyword
// case on a non-empty list; expect 59
use trial_support_int64;

main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [14, 38, 38];
                r: int64 <- case xs of {
                    []: List[int64, mem(normal)] -> 63;
                    [h: int64, _: List[int64, mem(normal)]] -> h + 45;
                    _: List[int64, mem(normal)] -> 63
                }
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
