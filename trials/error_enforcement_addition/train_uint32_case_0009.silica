// expected failure E1042: function 'main' has no return type
// case on uint32 value 20; expect 50
use trial_support_uint32;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            v: uint32 <- 20;
            case v of {
                0 -> 9;
                16 -> 187;
                6 -> 181;
                34 -> 10;
                n: uint32 if n > 31 -> 12;
                _: uint32 -> 50
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 50
    end
}
