// expected failure E2003: binding width declared uint16 but used as int64
// int64 bindings then expression; expect 46
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            width: uint16 <- 42;
            height: int64 <- width;
            a: int64 <- 36 / 14 % (width * 4);
            height + 4 % height + a - a
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
