// expected failure E2003: parameter x declared int64 in a int16 helper
// helper blend/3 on int16; blend(12, 12, 14) = 3
use trial_support_int16;

fn blend(x: int64, y: int16, z: int16) -> int16 {
    z / 5 + y / x
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            blend(12, 12, 14)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
