// expected failure E1043: whitespace between binding name 'rect' and ':'
// nested inline records; sum = 69
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            rect :{ top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
                top_left: { x: 25, y: 21 },
                bottom_right: { x: 3, y: 20 }
            };
            rect.top_left.x + rect.top_left.y + rect.bottom_right.x + rect.bottom_right.y
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
