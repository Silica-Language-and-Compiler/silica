// expected failure E2005: call to unknown function 'stepsx'
// recursive steps on uint64; steps(38, 0) = 38
use trial_support_uint64;

fn steps(n: uint64, acc: uint64) -> uint64 {
    case n == 0 of {
        true -> acc;
        false -> stepsx(n - 1, acc + 1)
    }
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            steps(38, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 38
    end
}
