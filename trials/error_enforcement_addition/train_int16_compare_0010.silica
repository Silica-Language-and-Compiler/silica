// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == 36 * 34 > 53 % 15);
                println("");
                _: atom <- print_boolean((22 + 44) > 48 * 8);
                println("");
                _: atom <- print_boolean(24 <= 21 / 27);
                println("");
                result: atom <- print_boolean((18 / 41) >= (19 + 2))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
