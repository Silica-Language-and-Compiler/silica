// expected failure E2002: undefined identifier 'n2'
// guards partition int64 into three ranges; n = 8 gives 16
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 8;
            case n of {
                n: int64 if n2 < 5 -> n - 1;
                n: int64 if n >= 5 and n < 29 -> n * 2;
                n: int64 if n >= 29 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
