// Spec §2 lexer error E0003 UnterminatedStringLiteral (2026-10-16): the closing quote of "abc is missing, so the literal
// runs to the end of the file.

fn main() -> int64 {
    sequence proc[device_io]
        s: string <- "abc;
        _: atom <- println(s)
    produces
        pure 0
    end
}
