// E1056: a pure sequence block must not declare empty proc[] — omit proc when no effects are required (spec §9.3.1).

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[]
                x: int64 <- 1
            produces
                pure x
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
