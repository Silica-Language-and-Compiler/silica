// expected failure E2005: call to unknown function 'adjust_all'
// helper adjust/2 on uint8; adjust(4, 2) = 0
use trial_support_uint8;

fn adjust(x: uint8, y: uint8) -> uint8 {
    (10 % x / (y + 47))
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            adjust_all(4, 2)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
