// Spec §15.1.4: actor_id takes an actor reference (actor_ref, dangerous_actor_ref, device_actor_ref
// or supervisor_ref). An int64 argument is a type error (E2003).

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        i: uint64 <- actor_id(5);
        print_uint64(i);
        println("")
    produces
        pure 0
    end
}
