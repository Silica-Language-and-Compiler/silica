// expected failure E1067: a closure that captures a local is returned (interim diagnostic for defect A2)
use trial_support_int64;

fn make_adder(k: int64) -> fn(int64) -> int64 {
    fn(x: int64) -> int64 { x + k }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add_k: fn(int64) -> int64 <- make_adder(10);
            add_k(5)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
