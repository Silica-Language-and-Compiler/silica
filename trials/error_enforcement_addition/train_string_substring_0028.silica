// expected failure E1050: produces clause without pure
// substring uses character indices [4, 4) of "Zürich"
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                s: string <- substring("Zürich", 4, 4);
                print_string(s);
                println("")
            produces :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
