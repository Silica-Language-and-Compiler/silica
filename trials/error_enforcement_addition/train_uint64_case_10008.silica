// expected failure E2001: string literal in one case arm of an integer case
// case on uint64 value 28; expect 196
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 28;
            case v of {
                32 -> "159";
                25 -> 36;
                n: uint64 if n > 36 -> 43;
                _: uint64 -> 196
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 196
    end
}
