// expected failure E1042: function 'main' has no return type
// decompose a mixed tuple and print each element
use trial_support_atom;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                t: (int64, string, boolean) <- (46, "cloud", true);
                (k: int64, name: string, flag: boolean) <- t;
                print_int64(k);
                println("");
                print_string(name);
                println("");
                print_boolean(flag);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
