// expected failure E1055: binding 'scratch' is never used
// nested boolean cases; (false, false) selects 14
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            scratch: int64 <- 41;
            a: boolean <- false;
            b: boolean <- false;
            case a of {
                true -> case b of {
                    true -> 78;
                    false -> 28
                };
                false -> case b of {
                    true -> 65;
                    false -> 14
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
