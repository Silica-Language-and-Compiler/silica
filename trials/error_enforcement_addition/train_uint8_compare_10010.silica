// expected failure E1049: sequence block without produces
// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((36 + 13) != (46 + 9));
                println("");
                _: atom <- print_boolean(22 / 55 >= 1);
                println("");
                _: atom <- print_boolean((25 + 60) != 30 % 22);
                println("");
                _: atom <- print_boolean(31 > 0 % 58);
                println("");
                result: atom <- print_boolean(31 / 37 != 9)
            pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
