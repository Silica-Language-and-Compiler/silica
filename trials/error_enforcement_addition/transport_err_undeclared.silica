// expected failure E2411: encode of a type that is not declared Transportable
fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        v: (:p, int64, int64) <- (:p, 1, 2);
        f: string <- encode((:etf), v);
        n: int64 <- length_bytes(f);
        _: atom <- print_int64(n)
    produces
        pure 0
    end
}
