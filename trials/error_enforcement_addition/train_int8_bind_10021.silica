// expected failure E2013: unary minus on a variable instead of negate_int8
// int8 bindings then expression; expect 2
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            d: int8 <- 35 / 21 / (43 - 3);
            m: int8 <- (d + 52) % (56 + d);
            b: int8 <- d;
            a: int8 <- d + 15;
            -d + 2 / (6 - 5) + m - m + b - b + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
