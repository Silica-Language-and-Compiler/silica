// expected failure E2001: atom literal returned from the recursion base case
// recursive sum_to on int32; sum_to(10) = 55
use trial_support_int32;

fn sum_to(n: int32) -> int32 {
    case n == 0 of {
        true -> :zero;
        false -> n + sum_to(n - 1)
    }
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sum_to(10)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 55
    end
}
