// expected failure E1060: unbalanced braces
// Spec §16.1.2: cast enqueues asynchronously and returns boolean; behavior returns (:no_reply, new_state)
fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(4, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        enqueued: boolean <- cast(w, 1 impl ActorMessage {});
        print_bool(enqueued);
        println("")
    produces
        pure :ok
    end
