// expected failure E2003: binding c declared uint32 but used as int16
// int16 bindings then expression; expect 54
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            c: uint32 <- 37;
            a: int16 <- c + c;
            (a + c) % (48 + 9)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 54
    end
}
