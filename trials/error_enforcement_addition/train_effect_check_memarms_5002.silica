// expected failure E2015: List type without its mem(Space)
// Positive: mem(normal) list ops only inside case arms still justify sequence proc[mem(normal)]
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            flag: boolean <- false;
            sequence proc[mem(normal)]
                n: int64 <- case flag of {
                    true -> {
                        xs: List[int64] <- [19, 5, 2];
                        length[int64, mem(normal)](xs)
                    };
                    false -> {
                        ys: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                        length[int64, mem(normal)](ys)
                    }
                }
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
