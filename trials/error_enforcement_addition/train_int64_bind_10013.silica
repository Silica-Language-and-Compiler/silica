// expected failure E2013: unary minus on a variable instead of negate_int64
// int64 bindings then expression; expect 45
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            step: int64 <- 51;
            c: int64 <- 32 * 35;
            count: int64 <- 10 + c % 45;
            total: int64 <- count;
            -step + (17 + 28) % 48 + step - step + total - total
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
