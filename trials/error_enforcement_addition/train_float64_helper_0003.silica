// expected failure E2003: combine returns float32 but its result feeds print_float64
// float64 helper combine; prints -27.5
use trial_support_atom;

fn combine(x: float64) -> float32 {
    x - 28.25 + 0.0
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float64(combine(0.75))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
