// expected failure E2018: binding 'outcome' has no type annotation
// true or false printed
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: boolean <- true or false;
                outcome <- print_boolean(result)
            produces pure outcome end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
