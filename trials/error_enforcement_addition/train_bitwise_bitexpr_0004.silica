// expected failure E1047: named struct declaration 'Node' is not allowed
// uint64 bitwise: (two band five) band bits = 4
use trial_support_uint64;

struct Node { x: int64, y: int64 }

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            two: uint64 <- 6;
            five: uint64 <- 4;
            bits: uint64 <- 6;
            (two band five) band bits
        });
        _: int64 <- wait_for_exit()
    produces
        pure 4
    end
}
