// expected failure E3009: proc[...] written on the function return type instead of the sequence
// float16 helper combine; prints 15.5
use trial_support_atom;

fn combine(x: float16) -> float16 {
    x + 14.25 + 0.0
}

fn main() -> atom proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float16(combine(1.25))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
