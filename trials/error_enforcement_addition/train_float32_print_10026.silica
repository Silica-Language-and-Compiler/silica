// expected failure E3001: print_float32 called outside a sequence block
// print_float32 of 19.75 + 14.0 - (11.75 - 1.5); prints 23.5
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            print_float32(19.75 + 14.0 - (11.75 - 1.5))
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
