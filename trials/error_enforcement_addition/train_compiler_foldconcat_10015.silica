// expected failure E2005: call to unknown function 'build_all'
// fold a string list with concat; byte length 5
use trial_support_int64;

fn build(xs: List[string, mem(normal)]) -> string {
    sequence proc[mem(normal)]
        result: string <- case xs of {
            []: List[string, mem(normal)] -> "";
            [h: string, t: List[string, mem(normal)]] -> concat(h, build_all(t));
            _: List[string, mem(normal)] -> ""
        }
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[string, mem(normal)] <- ["hello"];
                s: string <- build(xs)
            produces
                pure length_bytes(s)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
