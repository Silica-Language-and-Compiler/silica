// expected failure E1043: whitespace between binding name 'result' and ':'
// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(52 > (43 + 27));
                println("");
                _: atom <- print_boolean(10 == 50 / 33);
                println("");
                result :atom <- print_boolean((52 + 4) != (54 + 19))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
