// expected failure E1047: named struct declaration 'Node' is not allowed
// print_uint16 two; prints 12 then 4
use trial_support_atom;

struct Node { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: uint16 <- 38 - 26;
                b: uint16 <- 46 % 6;
                _: atom <- print_uint16(a);
                println("");
                result: atom <- print_uint16(b)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
