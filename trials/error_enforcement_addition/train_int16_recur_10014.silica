// expected failure E1045: function 'main' declared without the fn keyword
// recursive sum_to on int16; sum_to(16) = 136
use trial_support_int16;

fn sum_to(n: int16) -> int16 {
    case n == 0 of {
        true -> 0;
        false -> n + sum_to(n - 1)
    }
}

main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            sum_to(16)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 136
    end
}
