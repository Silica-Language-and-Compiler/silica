// expected failure E2003: comparison against a string binding
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == 45 / 22 > 28);
                println("");
                _: atom <- print_boolean((59 - 29) != 59 / 13);
                println("");
                _: atom <- print_boolean((56 - 35) > 7);
                println("");
                _: atom <- print_boolean(57 * 0 <= (57 + 33));
                println("");
                result: atom <- print_boolean(20 != (51 + 16))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
