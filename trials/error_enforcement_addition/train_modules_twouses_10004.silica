// expected failure E1055: binding 'leftover' is never used
// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_alpha@bump(10) + lib_arity@add3(3, 4, 2) = 20
use trial_support_int64;

use lib_alpha, lib_arity;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            leftover: int64 <- 41;
            lib_alpha@bump(10) + lib_arity@add3(3, 4, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
