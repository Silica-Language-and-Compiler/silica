// expected failure E1045: function 'main' declared without the fn keyword
// float16 comparisons
use trial_support_atom;

main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((4.5 + 11.0) <= 18.5 * 22.0);
                println("");
                _: atom <- print_boolean((33.5 - 4.75) == (11.5 + 10.0));
                println("");
                _: atom <- print_boolean((27.5 + 6.25) != 36.5);
                println("");
                done: atom <- print_boolean((23.5 + 22.5) < 8.25)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
