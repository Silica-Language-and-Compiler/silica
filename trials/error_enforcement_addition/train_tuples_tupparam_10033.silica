// expected failure E1055: binding 'leftover' is never used
// tuple parameter pattern_param; add_pair((3, 25)) = 28
use trial_support_int64;

fn add_pair((a: int64, b: int64)) -> int64 {
    leftover: int64 <- 41;
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add_pair((3, 25))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
