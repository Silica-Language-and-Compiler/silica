// expected failure E2403: decode needs a binding typed (:ok, T) | (:rejected, atom)

use wire_etf;

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        f: string <- encode((:etf), 7);
        v: int64 <- decode((:etf), f);
        _: atom <- print_int64(v)
    produces
        pure 0
    end
}
