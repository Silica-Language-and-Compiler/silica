// E1040: a binding with nothing after `<-` has no expression to end the statement with.
// Plain function body; the function-literal and sequence-body twins must report the same.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- ;
            x
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
