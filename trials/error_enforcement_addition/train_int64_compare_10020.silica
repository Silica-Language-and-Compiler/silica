// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == (37 + 20) >= (5 / 21));
                println("");
                _: atom <- print_boolean(4 != (54 + 25));
                println("");
                _: atom <- print_boolean((47 + 57) < (24 / 15));
                println("");
                result: atom <- print_boolean(20 * 36 == (13 + 37))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
