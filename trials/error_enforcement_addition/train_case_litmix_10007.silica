// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 13 gives 20
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 13;
            case v of {
                :9 -> 4;
                7 -> 31;
                3 -> 44;
                m: int32 if m > 12 -> 20;
                _: int32 -> 19
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 20
    end
}
