// expected failure E2001: atom literal returned from the recursion base case
// recursive steps on uint8; steps(35, 0) = 35
use trial_support_uint8;

fn steps(n: uint8, acc: uint8) -> uint8 {
    case n == 0 of {
        true -> :done;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            steps(35, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 35
    end
}
