// expected failure E1043: whitespace between binding name 'b' and ':'
// uint8 bindings then expression; expect 1
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            height: uint8 <- 58;
            b :uint8 <- 14;
            d: uint8 <- 1;
            height * 2 / (height + 51) + b - b + d - d
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
