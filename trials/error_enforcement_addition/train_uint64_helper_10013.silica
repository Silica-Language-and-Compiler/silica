// expected failure E2003: parameter x declared uint16 in a uint64 helper
// helper compute/2 on uint64; compute(1, 13) = 59
use trial_support_uint64;

fn compute(x: uint16, y: uint64) -> uint64 {
    (y + x) + (46 - x)
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            compute(1, 13)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 59
    end
}
