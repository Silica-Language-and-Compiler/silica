// expected failure E1045: function 'pair' declared without the fn keyword
// case scrutinee is a tuple-returning call; expect 10
use trial_support_int64;

pair(n: int64) -> (int64, int64) {
    (n, n + 1)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case pair(2) of {
                t: (int64, int64) -> {
                    (x: int64, y: int64) <- t;
                    x + y + 5
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
