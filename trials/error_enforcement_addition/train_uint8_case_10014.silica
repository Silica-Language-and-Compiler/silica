// expected failure E1047: named struct declaration 'Pair' is not allowed
// case on uint8 value 2; expect 52
use trial_support_uint8;

struct Pair { x: int64, y: int64 }

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            v: uint8 <- 2;
            case v of {
                25 -> 184;
                _: uint8 -> 52
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 52
    end
}
