// E2402: decode of a variable-sized type (it holds a string) without a limits argument (design §4.1).
fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        v: { name: string, n: int64 } <- { name: "x", n: 1 };
        frame: string <- encode((:etf), v);
        r: (:ok, { name: string, n: int64 }) | (:rejected, atom) <- decode((:etf), frame);
        _: atom <- case r of {
            (:ok, w: { name: string, n: int64 }) -> print_int64(w.n);
            (:rejected, _why: atom) -> print_int64(0 - 1)
        }
    produces
        pure 0
    end
}
