// expected failure E2013: unary minus on a variable instead of negate_int32
// int32 bindings then expression; expect 36
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            k: int32 <- 45 % 3;
            m: int32 <- 36 + 0;
            total: int32 <- k;
            height: int32 <- (13 % 4 % (m + 44));
            -k + k + m + (total - total) + height - height
        });
        _: int64 <- wait_for_exit()
    produces
        pure 36
    end
}
