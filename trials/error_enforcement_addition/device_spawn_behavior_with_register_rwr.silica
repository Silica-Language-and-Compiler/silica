// expected failure E2223: spawn starting a behavior that declares register_rwr (device spec §4.2)
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        x: int64 <- state + msg
    produces
        pure (:no_reply, x)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                r: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast(r, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
