// expected failure E2018: binding 'xs' has no type annotation
// case on a non-empty list; expect 106
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs <- [9, 26];
                r: int64 <- case xs of {
                    []: List[int64, mem(normal)] -> 29;
                    [h: int64, _: List[int64, mem(normal)]] -> h + 97;
                    _: List[int64, mem(normal)] -> 29
                }
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
