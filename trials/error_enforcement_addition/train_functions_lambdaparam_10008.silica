// expected failure E1047: named struct declaration 'Pair' is not allowed
// function literal passed as a parameter, capturing z; expect 27
use trial_support_int64;

struct Pair { x: int64, y: int64 }

fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            z: int64 <- 17;
            apply_pair(5, fn(a: int64, b: int64) -> int64 {
                a + b + z
            })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
