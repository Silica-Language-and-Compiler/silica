// expected failure E2003: parameter x declared uint16 in a int64 helper
// helper adjust/3 on int64; adjust(11, 8, 12) = 107
use trial_support_int64;

fn adjust(x: uint16, y: int64, z: int64) -> int64 {
    x % 54 + y * z
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            adjust(11, 8, 12)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
