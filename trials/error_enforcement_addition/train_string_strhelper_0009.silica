// expected failure E2005: wrong argument count in call to 'wrap'
// string helper wrap; prints [chair]

use trial_support_atom;

fn wrap(s: string) -> string {
    concatenate("[", concatenate(s, "]"))
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] print_string(wrap());
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
