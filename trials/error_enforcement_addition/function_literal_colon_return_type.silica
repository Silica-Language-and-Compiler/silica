// expected failure E1071: a function literal writes its return type with `->`, not the retired
// `: type` form (spec 3.3.6). `fn(a: int64): int64 { a + 41 }` used to parse and compile.
use trial_support_int64;

fn take(op: fn(a: int64) -> int64) -> int64 {
    op(1)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            take(fn(a: int64): int64 { a + 41 })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
