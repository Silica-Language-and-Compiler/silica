// expected failure E1060: unbalanced braces
// case on int16 value 21; expect 136
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            v: int16 <- 21;
            case v of {
                19 -> 200;
                31 -> 95;
                n: int16 if n > 15 -> 136;
                _: int16 -> 159
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 136
    end
}}
