// expected failure E2005: boolean case missing its false branch
// recursive sum_to on uint16; sum_to(16) = 136
use trial_support_uint16;

fn sum_to(n: uint16) -> uint16 {
    case n == 0 of {
        true -> 0
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            sum_to(16)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 136
    end
}
