// expected failure E2003: binding total declared int8 but used as uint16
// uint16 bindings then expression; expect 40
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            total: int8 <- 43 + 59;
            step: uint16 <- 29 % 19;
            count: uint16 <- step % 25;
            a: uint16 <- 47 % (step * 9);
            40 + total - total + count - count + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 40
    end
}
