// expected failure E1065: parameter list of 'compute' is not closed
// helper compute/3 on int64; compute(11, 16, 4) = 11
use trial_support_int64;

fn compute(x: int64, y: int64, z: int64 -> int64 {
    x % 43 - (z / y)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            compute(11, 16, 4)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
