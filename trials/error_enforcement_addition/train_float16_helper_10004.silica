// expected failure E2003: blend returns float32 but its result feeds print_float16
// float16 helper blend; prints 6.0
use trial_support_atom;

fn blend(x: float16) -> float32 {
    x - 4.5 + 1.5
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float16(blend(9.0))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
