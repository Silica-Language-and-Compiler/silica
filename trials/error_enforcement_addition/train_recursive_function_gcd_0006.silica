// expected failure E2001: atom returned from the base case of gcd
// Euclid's gcd; gcd(18, 109) = 1
use trial_support_int64;

fn gcd(a: int64, b: int64) -> int64 {
    case b == 0 of {
        true -> :done;
        false -> gcd(b, a % b)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            gcd(18, 109)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
