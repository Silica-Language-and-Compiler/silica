// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint16 value 6; expect 69
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 6;
            case v of {
                "one" -> 172;
                n: uint16 if n > 20 -> 144;
                _: uint16 -> 69
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 69
    end
}
