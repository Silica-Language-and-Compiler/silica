// expected failure E1055: binding 'scratch' is never used
// nested inline records; width = 5
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            scratch: int64 <- 41;
            rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
                top_left: { x: 24, y: 5 },
                bottom_right: { x: 19, y: 22 }
            };
            rect.top_left.x - rect.bottom_right.x
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
