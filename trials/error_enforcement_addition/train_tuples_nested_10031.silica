// expected failure E2018: binding 't' has no type annotation
// nested tuple decomposition; x + y + z = 35
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            t <- (4, (13, 18));
            (x: int64, inner: (int64, int64)) <- t;
            (y: int64, z: int64) <- inner;
            x + y + z
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
