// Spec §16.1.2 (2026-10-13): a call to a cast-only actor (its behaviour returns (:no_reply, ...))
// is rejected with E2238 when the reference is a list element: q is prepended to an empty list and
// the call goes to the head.
// (Fable's E2237/E2238 repro rej_call_cast_only_list, 2026-10-13.)

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn sink(msg: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + 1)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        q: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        l: List[actor_ref, mem(normal)] <- prepend[actor_ref, mem(normal)](q, empty[actor_ref, mem(normal)]());
        v: int64 <- call(l.head, "x" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
