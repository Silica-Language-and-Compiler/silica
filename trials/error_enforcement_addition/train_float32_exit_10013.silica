// expected failure E1047: named struct declaration 'Config' is not allowed
// main returns float32; exit code is trunc(18.0) = 18
use trial_support_float32;

struct Config { x: int64, y: int64 }

fn main() -> float32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float32@start();
        _: boolean <- trial_support_float32@run(fn() -> float32 {
            18.0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 18.0
    end
}
