// expected failure E2005: string literal pattern against an integer scrutinee
// case on int64 value 0; expect 178
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v: int64 <- 0;
            case v of {
                "one" -> 14;
                14 -> 100;
                10 -> 41;
                n: int64 if n > 28 -> 130;
                _: int64 -> 178
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
