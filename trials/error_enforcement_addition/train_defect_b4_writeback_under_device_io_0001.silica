// regression (already diagnosed by silica-999997): expected failure E3002: mem(normal_writeback) list ops under proc[device_io]
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                xs: List[int64, mem(normal_writeback)] <- [];
                n: int64 <- length[int64, mem(normal_writeback)](xs)
            produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
