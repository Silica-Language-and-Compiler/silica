// expected failure E1060: unbalanced braces
// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((36 + 48) > 56);
                println("");
                _: atom <- print_boolean((15 + 5) > 3 * 34);
                println("");
                _: atom <- print_boolean(0 % 55 != (50 - 23));
                println("");
                _: atom <- print_boolean(37 == (27 - 2));
                println("");
                result: atom <- print_boolean(25 / 4 >= (4 % 22))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}}
