// expected failure E1047: named struct declaration 'Config' is not allowed
// tuple parameter pattern_param; add_pair((43, 12)) = 55
use trial_support_int64;

struct Config { x: int64, y: int64 }

fn add_pair((a: int64, b: int64)) -> int64 {
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add_pair((43, 12))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
