// expected failure E2005: boolean case missing its false branch
// recursive tri_acc on int64; tri_acc(7, 0) = 28
use trial_support_int64;

fn tri_acc(n: int64, acc: int64) -> int64 {
    case n == 0 of {
        true -> acc
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            tri_acc(7, 0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
