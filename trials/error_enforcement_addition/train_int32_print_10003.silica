// expected failure E1055: binding 'unused_value' is never used
// print_int32 two; prints 37 then 21
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            unused_value: int64 <- 41;
            sequence proc[device_io]
                a: int32 <- (37 * 1);
                b: int32 <- 35 - 14;
                _: atom <- print_int32(a);
                println("");
                result: atom <- print_int32(b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
