// expected failure E2001: integer literal passed where bit expects a boolean
// boolean helpers combined into bits; expect 7
use trial_support_int64;

fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            bit(1, 1) + bit(ff() == ff(), 2) + bit(ff() or tt(), 4)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
