// expected failure E1055: binding 'temp_val' is never used
// uint64 bindings then expression; expect 51
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            temp_val: int64 <- 41;
            total: uint64 <- 16 % 60;
            b: uint64 <- (16 + 1);
            step: uint64 <- 52 - 24 + 56 * 3;
            height: uint64 <- 20 % b;
            51 + total - total + step - step + height - height
        });
        _: int64 <- wait_for_exit()
    produces
        pure 51
    end
}
