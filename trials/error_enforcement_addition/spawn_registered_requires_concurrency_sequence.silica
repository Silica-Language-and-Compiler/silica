// Enforce that spawn_registered must run inside sequence proc[concurrency].
// This call is intentionally outside any sequence block.

use trial_support_int64;

fn worker(msg: int64, state: actor_ref) -> (:reply, int64, actor_ref) {
    (:reply, msg, state)
}

fn missing_concurrency_spawn_registered(seed: actor_ref) -> actor_ref {
    spawn_registered(seed, worker, :w, stack_policy(0, :keep_last_message));
    seed
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
