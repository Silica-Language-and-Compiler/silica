// expected failure E2002: undefined identifier 'missing_b'
// sequence prints and returns the same sum 52
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                a: int64 <- 20;
                b: int64 <- 32;
                print_int64(a + missing_b);
                println("");
                total: int64 <- a + b
            produces
                pure total
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
