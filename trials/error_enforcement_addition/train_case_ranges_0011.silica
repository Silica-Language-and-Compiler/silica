// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 86 gives 86
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 86;
            case n of {
                n: int64 if n < 3 -> "n + 100";
                n: int64 if n >= 3 and n < 77 -> n * 2;
                n: int64 if n >= 77 -> n
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
