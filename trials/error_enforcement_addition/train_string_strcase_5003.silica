// expected failure E1041: trailing ';' after the block's final expression
// case on string literals; "south" gives 17
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "south";
            case mode of {
                "south" -> 17;
                "apple" -> 10;
                "river" -> 17;
                _: string -> 1
            };
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
