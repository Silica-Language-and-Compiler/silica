// expected failure E2003: combine returns float16 but its result feeds print_float64
// float64 helper combine; prints 40.625
use trial_support_atom;

fn combine(x: float64) -> float16 {
    x + 9.25 + 4.0
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float64(combine(27.375))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
