// expected failure E2001: string literal in one case arm of an integer case
// case on uint16 value 22; expect 156
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 22;
            case v of {
                38 -> "200";
                25 -> 156;
                42 -> 161;
                n: uint16 if n > 35 -> 98;
                _: uint16 -> 156
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 156
    end
}
