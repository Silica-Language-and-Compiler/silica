// expected failure E2003: binding height declared uint64 but used as int32
// int32 bindings then expression; expect 0
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            height: uint64 <- 18;
            m: int32 <- (height % 43) % (6 + 41);
            0 + m - m
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
