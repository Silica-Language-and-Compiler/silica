// expected failure E2001: integer literal passed to starts_with
// starts_with prints true
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] s: string <- 7;
                result: atom <- print_boolean(starts_with(s, "北京市"))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
