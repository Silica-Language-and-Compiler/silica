// expected failure E2005: boolean case missing its false branch
// recursive steps on uint16; steps(60, 0) = 60
use trial_support_uint16;

fn steps(n: uint16, acc: uint16) -> uint16 {
    case n == 0 of {
        true -> acc
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            steps(60, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 60
    end
}
