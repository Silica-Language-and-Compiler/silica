// expected failure E1047: named struct declaration 'Node' is not allowed
// main returns the runtime-seeded atom :one_for_one; exit code 12
use trial_support_atom;

struct Node { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            :one_for_one
        });
        _: int64 <- wait_for_exit()
    produces
        pure :one_for_one
    end
}
