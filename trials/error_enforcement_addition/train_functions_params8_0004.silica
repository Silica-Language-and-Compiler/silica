// expected failure E1070: sum8 extended to nine parameters
// function with 8 parameter(s); sum8(19, 0, 1, 7, 12, 0, 0, 7, 1) = 46
use trial_support_int32;

fn sum8(a: int32, b: int32, c: int32, d: int32, e: int32, f: int32, g: int32, h: int32, i: int32) -> int32 {
    a + b + c + d + e + f + g + h + i
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sum8(19, 0, 1, 7, 12, 0, 0, 7)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 46
    end
}
