// expected failure E2001: string literal in one case arm of an integer case
// case on int64 value 11; expect 18
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v: int64 <- 11;
            case v of {
                22 -> "135";
                20 -> 106;
                3 -> 71;
                _: int64 -> 18
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
