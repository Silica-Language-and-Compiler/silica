// expected failure E1055: binding 'temp_val' is never used
// function with 8 parameter(s); sum8(0, 9, 15, 14, 10, 12, 0, 5) = 65
use trial_support_int64;

fn sum8(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64) -> int64 {
    temp_val: int64 <- 41;
    a + b + c + d + e + f + g + h
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sum8(0, 9, 15, 14, 10, 12, 0, 5)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
