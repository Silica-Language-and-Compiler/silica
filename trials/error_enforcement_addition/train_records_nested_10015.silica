// expected failure E2018: binding 'rect' has no type annotation
// nested inline records; width = 11
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            rect <- {
                top_left: { x: 16, y: 6 },
                bottom_right: { x: 27, y: 28 }
            };
            rect.bottom_right.x - rect.top_left.x
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
