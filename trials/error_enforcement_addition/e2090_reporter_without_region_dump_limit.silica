// A module that calls register_failure_reporter must define fn region_dump_limit() -> int64: registration
// calls it once to set the region dump limit (spec section 15.4.13.4). This module registers a reporter and
// does not define it. Before the check this compiled and failed at link time with an undefined symbol.
// Expected: E2090 at the register_failure_reporter call.

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep)
    produces
        pure 0
    end
}
