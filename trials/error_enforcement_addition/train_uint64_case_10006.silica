// expected failure E2001: string literal in one case arm of an integer case
// case on uint64 value 8; expect 165
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 8;
            case v of {
                14 -> "91";
                22 -> 110;
                3 -> 5;
                36 -> 42;
                n: uint64 if n > 12 -> 163;
                _: uint64 -> 165
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 165
    end
}
