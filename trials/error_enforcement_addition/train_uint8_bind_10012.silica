// expected failure E2003: binding m declared uint32 but used as uint8
// uint8 bindings then expression; expect 140
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            m: uint32 <- 32;
            b: uint8 <- m;
            c: uint8 <- 51;
            m - 0 + (51 + 57) + b - b + c - c
        });
        _: int64 <- wait_for_exit()
    produces
        pure 140
    end
}
