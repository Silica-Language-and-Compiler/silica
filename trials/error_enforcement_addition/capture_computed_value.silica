// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name only if, where the
// literal is written, the name is bound to an integer literal by an integer-typed binding.
// The literal captures m, bound to the computed value n * 2 (n itself is an integer literal).

fn take(op: fn(a: int64) -> int64) -> int64 {
    op(10)
}

fn plus_n() -> int64 {
    n: int64 <- 7;
    m: int64 <- n * 2;
    take(fn(x: int64) -> int64 { x + m })
}

fn main() -> int64 {
    plus_n()
}
