// expected failure E2005: call to unknown function 'add_paiz'
// tuple parameter typed_param; add_pair((41, 10)) = 51
use trial_support_int64;

fn add_pair(p: (int64, int64)) -> int64 {
    (a: int64, b: int64) <- p;
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add_paiz((41, 10))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
