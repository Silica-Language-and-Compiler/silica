// expected failure E2001: atom literal returned from the recursion base case
// recursive pow2 on int16; pow2(6) = 64
use trial_support_int16;

fn pow2(n: int16) -> int16 {
    case n == 0 of {
        true -> :one;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            pow2(6)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 64
    end
}
