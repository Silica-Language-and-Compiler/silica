// expected failure E1070: combine given nine parameters
// helper combine/3 on uint64; combine(4, 16, 5) = 7
use trial_support_uint64;

fn combine9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn combine(x: uint64, y: uint64, z: uint64) -> uint64 {
    y % (x + z)
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            combine(4, 16, 5)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 7
    end
}
