// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == (29 + 22) >= 27 % 22);
                println("");
                _: atom <- print_boolean((48 + 60) != 45);
                println("");
                _: atom <- print_boolean(6 != (51 - 28));
                println("");
                result: atom <- print_boolean(42 % 52 != 44 / 8)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
