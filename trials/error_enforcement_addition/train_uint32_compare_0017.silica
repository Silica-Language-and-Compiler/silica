// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == 30 % 46 <= (59 + 14));
                println("");
                _: atom <- print_boolean(36 % 20 == 28);
                println("");
                _: atom <- print_boolean((2 + 42) < 55);
                println("");
                _: atom <- print_boolean((21 + 55) <= 0 % 18);
                println("");
                result: atom <- print_boolean(9 * 29 <= (49 + 13))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
