// expected failure E1047: named struct declaration 'Point' is not allowed
// negate_int64 compare; prints true
use trial_support_atom;

struct Point { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_boolean(negate_int64(negate_int64(-72)) == -72)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
