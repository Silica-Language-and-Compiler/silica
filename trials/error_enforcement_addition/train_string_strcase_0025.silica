// expected failure E1047: named struct declaration 'Config' is not allowed
// case on string literals; "other" gives 42
use trial_support_int64;

struct Config { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "other";
            case mode of {
                "river" -> 98;
                "region" -> 26;
                "actor" -> 89;
                _: string -> 42
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
