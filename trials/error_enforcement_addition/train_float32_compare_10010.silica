// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)] _: atom <- print_boolean((40.5 - 23.5) != (3.0 - 6.5));
                println("");
                _: atom <- print_boolean((39.25 + 35.0) > 10.375 * 35.0);
                println("");
                _: atom <- print_boolean((28.375 - 15.25) != 4.75 * 28.75);
                println("");
                done: atom <- print_boolean(10.25 <= 28.0)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
