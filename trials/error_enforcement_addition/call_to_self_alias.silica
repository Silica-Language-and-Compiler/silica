// Spec §16.2.6.5 (2026-10-16): call() whose target is a name bound from self() is rejected
// with E2240 CallToSelf, the same as call(self(), ...): the actor would wait for its own reply.
// A call-only behaviour binds me <- self() and calls me.
// (Fable's E2240 repro callself, f29.)

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        r: int64 <- call(me, 1 impl ActorMessage {})
    produces
        pure (:reply, r, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        r: int64 <- call(w, 5 impl ActorMessage {});
        _: atom <- print_int64(r);
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
