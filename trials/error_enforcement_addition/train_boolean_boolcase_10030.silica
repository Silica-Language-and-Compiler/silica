// expected failure E1055: binding 'unused_value' is never used
// case on a boolean binding; expect 5
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            unused_value: int64 <- 41;
            flag: boolean <- false;
            case flag of {
                true -> 18;
                false -> 5
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
