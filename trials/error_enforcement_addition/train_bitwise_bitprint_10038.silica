// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// print_uint64 of 10 bor 35 = 43
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)] a: uint64 <- 10;
                b: uint64 <- 35;
                result: atom <- print_uint64(a bor b)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
