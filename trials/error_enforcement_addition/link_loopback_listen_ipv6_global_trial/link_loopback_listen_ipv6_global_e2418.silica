// E2418: A (:loopback) link with a "listen:[2001:db8::1]:<port>" literal: an IPv6 address other than ::1 is not a loopback address (links design §3.2). The checker sees the
// declaration, the spawn and the address literal in one function, so the program is rejected here instead of
// ending at run time with (:explicit, :link_unavailable).
carried_on net: (:tcp) (:loopback);

fn main() -> int64 {
    sequence proc[concurrency]
        car: dangerous_actor_ref <- spawn_dangerous_carrier(net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(car, (:open, actor_ref_of_word(0), "listen:[2001:db8::1]:0") impl ActorMessage {})
    produces
        pure 0
    end
}
