// expected failure E1055: binding 'unused_value' is never used
// pure sequence inside a helper; churn(2) = 10
use trial_support_int64;

fn churn(n: int64) -> int64 {
    unused_value: int64 <- 41;
    sequence
        a: string <- concatenate("xx", "yy");
        b: string <- concatenate(a, a)
    produces
        pure length_bytes(b) + n
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            churn(2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
