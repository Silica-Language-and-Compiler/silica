// expected failure E2002: undefined identifier 'missing_d'
// uint32 bindings then expression; expect 0
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            count: uint32 <- 16 % 31;
            width: uint32 <- count / count;
            d: uint32 <- 19;
            0 + width - width + d - missing_d
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
