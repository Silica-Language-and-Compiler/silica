// E2404: two tuple variants of a sum share tag and arity, so a decoder could not tell them apart (design §4.2); reported at the decode call.
use wire_etf;

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        v: (:a, int64) | (:a, string) <- (:a, 7);
        frame: string <- encode((:etf), v);
        r: (:ok, (:a, int64) | (:a, string)) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 64 });
        _: atom <- case r of {
            (:ok, _w: (:a, int64) | (:a, string)) -> print_int64(1);
            (:rejected, _why: atom) -> print_int64(0 - 1)
        }
    produces
        pure 0
    end
}
