// Defect repro (found 2026-10-08, item M): a function literal passed as a call argument inside a
// sequence block is not checked for E1056; `sequence proc[]` in its body compiles. The same literal
// passed outside a sequence, or bound by `f: fn() -> int64 <- fn() ...`, reports E1056. The golden
// was derived by hand from that working case (same message, this file's position of `proc[]`).
fn apply(f: fn() -> int64) -> int64 {
    f()
}

fn main() -> int64 {
    sequence proc[device_io]
        println("x");
        v: int64 <- apply(fn() -> int64 {
            sequence proc[]
                x: int64 <- 1
            produces
                pure x
            end
        })
    produces
        pure v
    end
}
