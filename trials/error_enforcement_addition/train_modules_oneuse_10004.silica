// expected failure E1055: binding 'scratch' is never used
// Spec §19.3: use lib_math_utils_spec; then a module-qualified call lib_math_utils_spec@multiply(0, 4) = 0
use lib_math_utils_spec;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            scratch: int64 <- 41;
            lib_math_utils_spec@multiply(0, 4)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
