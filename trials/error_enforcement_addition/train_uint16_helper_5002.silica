// expected failure E2002: undefined identifier 'yx'
// helper compute/2 on uint16; compute(7, 15) = 0
use trial_support_uint16;

fn compute(x: uint16, y: uint16) -> uint16 {
    (yx - x) / (y + x)
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            compute(7, 15)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
