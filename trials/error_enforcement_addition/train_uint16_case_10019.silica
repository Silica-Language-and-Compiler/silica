// expected failure E1055: binding 'leftover' is never used
// case on uint16 value 33; expect 75
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            leftover: int64 <- 41;
            v: uint16 <- 33;
            case v of {
                38 -> 51;
                23 -> 190;
                1 -> 119;
                35 -> 108;
                n: uint16 if n > 5 -> 75;
                _: uint16 -> 156
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 75
    end
}
