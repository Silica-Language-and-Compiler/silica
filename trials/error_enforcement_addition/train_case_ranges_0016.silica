// expected failure E1055: binding 'leftover' is never used
// guards partition int64 into three ranges; n = 118 gives 59
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            leftover: int64 <- 41;
            n: int64 <- 118;
            case n of {
                n: int64 if n < 4 -> n + 100;
                n: int64 if n >= 4 and n < 89 -> 0;
                n: int64 if n >= 89 -> n / 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
