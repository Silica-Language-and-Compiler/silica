// expected failure E2003: binding step declared uint16 but used as uint32
// uint32 bindings then expression; expect 5
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            step: uint16 <- 44 + 19 * 18;
            total: uint32 <- step % step + 53;
            width: uint32 <- step;
            count: uint32 <- (16 * 16 + step);
            ((count % 7) % 34) + total - total + width - width
        });
        _: int64 <- wait_for_exit()
    produces
        pure 5
    end
}
