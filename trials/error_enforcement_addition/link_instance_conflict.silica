// E2415: two carrier declarations name the same UART instance (links design decisions 6 and 17: a UART
// instance is never shared). The front end rejects the pair before the target's pack is asked.
carried_on telemetry: (:serial) (:uart, 1, 115200);
carried_on console_mirror: (:serial) (:uart, 1, 9600);

fn main() -> int64 {
    0
}
