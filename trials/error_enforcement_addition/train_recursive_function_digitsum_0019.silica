// expected failure E2005: call to unknown function 'digit_sum_all'
// digit_sum(2126) = 11
use trial_support_int64;

fn digit_sum(n: int64) -> int64 {
    case n < 10 of {
        true -> n;
        false -> n % 10 + digit_sum(n / 10)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            digit_sum_all(2126)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
