// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 85 gives 0
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 85;
            case n of {
                n: int64 if n < 28 -> "n + 100";
                n: int64 if n >= 28 and n < 50 -> n - 1;
                n: int64 if n >= 50 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
