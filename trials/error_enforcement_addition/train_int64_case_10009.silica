// expected failure E2018: binding 'v' has no type annotation
// case on int64 value 31; expect 27
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v <- 31;
            case v of {
                3 -> 10;
                22 -> 11;
                8 -> 165;
                44 -> 164;
                n: int64 if n > 17 -> 27;
                _: int64 -> 37
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
