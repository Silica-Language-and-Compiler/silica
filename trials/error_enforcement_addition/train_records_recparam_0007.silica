// expected failure E2005: call to unknown function 'my_area'
// record passed to a function; area({ width: 12, height: 3 }) = 36
use trial_support_int64;

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            my_area({ width: 12, height: 3 })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
