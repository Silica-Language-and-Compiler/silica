// expected failure E2005: call to unknown function 'print_bool_all'
// false or false printed
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: boolean <- false or false;
                outcome: atom <- print_bool_all(result)
                produces pure outcome end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
