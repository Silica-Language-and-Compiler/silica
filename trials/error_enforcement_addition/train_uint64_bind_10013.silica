// expected failure E2003: binding total declared uint16 but used as uint64
// uint64 bindings then expression; expect 147
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            total: uint16 <- 8 * (53 * 31);
            base: uint64 <- total;
            60 + 42 + (6 + 39) + base - base
        });
        _: int64 <- wait_for_exit()
    produces
        pure 147
    end
}
