// expected failure E2005: boolean case missing its false arm
// case on ends_with; expect 14
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s: string <- "silica compiler";
            suf: string <- "ler";
            case ends_with(s, suf) of {
                true -> 14
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
