// expected failure E2003: binding d declared uint8 but used as int16
// int16 bindings then expression; expect 0
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            d: uint8 <- 40;
            count: int16 <- 12;
            k: int16 <- (count + count) % (d - 14);
            count / 1 - count % 26 + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
