// expected failure E2001: string literal passed where an integer parameter is expected
// helper compute/2 on uint16; compute(7, 8) = 13
use trial_support_uint16;

fn compute(x: uint16, y: uint16) -> uint16 {
    1 + x + 40 / y
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            compute("7", 8)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
