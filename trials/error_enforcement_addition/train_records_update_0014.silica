// expected failure E2005: call to unknown function 'bumz'
// functional record update through bump; counter ends at 79
use trial_support_int64;

fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s0: { counter: int64, label: string } <- { counter: 45, label: "count" };
            s1: { counter: int64, label: string } <- bump(s0, 17);
            s2: { counter: int64, label: string } <- bumz(s1, 17);
            s2.counter
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
