// Q19 (data_structure_redesign_requirements.md §2 row Q19 and decision 38; chunk15_stack_memory_design.md §5.1,
// §11.1 phase 0): `rec` binds to its innermost enclosing TUPLE type, so a `rec` with no enclosing tuple type
// names no layout and is rejected with E2010 in every position (spec §4.2.2, recursive_tuple_specification.md §2).
// Here: a return type `-> ref?(L, normal, rec)`.
use trial_support_int64;

fn make(r: region(L, normal), n: int64) -> ref?(L, normal, rec) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (n, :none))
    produces pure c end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                cell: ref?(L, normal, (int64, ref?(L, normal, rec))) <- make(r, 1);
                n: int64 <- case cell of { :none -> 0; _: ref(L, normal, (int64, ref?(L, normal, rec))) -> 1 }
            produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
