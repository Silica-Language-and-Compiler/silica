// expected failure E2002: undefined identifier 'missing_n'
// guards partition int64 into three ranges; n = 62 gives 62
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 62;
            case n of {
                n: int64 if n < 17 -> n / 2;
                n: int64 if n >= 17 and missing_n < 98 -> n;
                n: int64 if n >= 98 -> n * 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
