// expected failure E2003: half_sum returns float16 but its result feeds print_float32
// float32 helper half_sum; prints -10.25
use trial_support_atom;

fn half_sum(x: float32) -> float16 {
    x - 17.5 + 1.0
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float32(half_sum(6.25))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
