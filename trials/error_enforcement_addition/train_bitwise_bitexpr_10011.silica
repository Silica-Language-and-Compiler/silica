// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (((bnot two) band lo) + seven) = 7
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            two: uint64 <- true;
            lo: uint64 <- 9;
            seven: uint64 <- 7;
            (((bnot two) band lo) + seven)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 7
    end
}
