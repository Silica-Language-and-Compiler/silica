// expected failure E2003: binding m declared int8 but used as int64
// int64 bindings then expression; expect 5
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            m: int8 <- 55 / 27 + 2;
            k: int64 <- 0;
            base: int64 <- 9;
            11 / 9 + (m + k) + base - base
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
