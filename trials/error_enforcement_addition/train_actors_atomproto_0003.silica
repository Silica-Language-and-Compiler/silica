// expected failure E4016: no main/0: entry function renamed to 'start'
// Atom-shaped messages dispatched by a case in the behavior (§15.1.2 call/reply)
fn srv(msg: atom, state: int64) -> (:reply, int64, int64) {
    case msg of {
        :peek -> (:reply, state, state);
        :bump -> (:reply, state + 1, state + 1);
        :reset -> (:reply, 0, 0);
        _: atom -> (:reply, state, state)
    }
}

fn start() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(1, srv, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        p0: int64 <- call(w, (:bump) impl ActorMessage {});
        print_int64(p0);
        println("");
        p1: int64 <- call(w, (:reset) impl ActorMessage {});
        print_int64(p1);
        println("");
        p2: int64 <- call(w, (:bump) impl ActorMessage {});
        print_int64(p2);
        println("");
        p3: int64 <- call(w, (:bump) impl ActorMessage {});
        print_int64(p3);
        println("")
    produces
        pure :ok
    end
}
