// expected failure E2005: decomposition pattern element types in the wrong order
// decompose a mixed tuple and print each element
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                t: (boolean, int64, string) <- (false, 95, "north");
                (flag: boolean, k: string, name: int64) <- t;
                print_boolean(flag);
                println("");
                print_int64(k);
                println("");
                print_string(name);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
