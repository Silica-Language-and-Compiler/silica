// expected failure E2003: shift amount literal 100 is out of range 0..63
// shifts: (seed shl 3) + (wide shr 3) = 66
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            seed: uint64 <- 7;
            wide: uint64 <- 84;
            (seed shl 100) + (wide shr 3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 66
    end
}
