// Spec §16.1.2 (2026-10-12): a cast to a call-only actor (its behaviour returns (:reply, ...)) is
// rejected at compile time with E2237.
// cast_registered to a name under which only a call-only actor is registered.
// (Fable's cast-check repros, 2026-10-12.)

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn main() -> int64 {
    sequence proc[concurrency]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        _g: actor_ref <- spawn_registered(0, plain, :cc_plain, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:cc_plain, "a" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
