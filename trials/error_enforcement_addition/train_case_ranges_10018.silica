// expected failure E2002: undefined identifier 'n_'
// guards partition int64 into three ranges; n = 16 gives 16
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 16;
            case n of {
                n: int64 if n < 11 -> 0;
                n: int64 if n >= 11 and n_ < 20 -> n;
                n: int64 if n >= 20 -> n * 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
