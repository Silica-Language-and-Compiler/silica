// expected failure E1043: whitespace between binding name 'c' and ':'
// uint16 bindings then expression; expect 6
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            c :uint16 <- 17 % 42;
            count: uint16 <- c * 52 + (c + 5);
            b: uint16 <- (23 + 54) % c;
            base: uint16 <- (7 * 49) * (18 / c);
            (b - 3) % c + count - count + base - base
        });
        _: int64 <- wait_for_exit()
    produces
        pure 6
    end
}
