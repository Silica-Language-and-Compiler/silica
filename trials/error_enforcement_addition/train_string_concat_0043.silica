// expected failure E2003: string binding used where an integer is expected
// concat of 4 pieces prints river日本語omegaalpha

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "river";
                b: string <- "日本語";
                s: string <- concat(a, b);
                s0: string <- concat(s, "omega");
                s1: string <- concat(s0, "alpha");
                print_int64(s1);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
