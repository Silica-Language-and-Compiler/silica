// expected failure E1054: extra end after the sequence block
// print_float32 of 19.0 / 1.0 - 36.75 * 0.5; prints 0.625
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float32(19.0 / 1.0 - 36.75 * 0.5)
            produces
                pure result
            end
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
