// expected failure E2005: integer pattern against a string scrutinee
// case on string literals; "other" gives 13
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "other";
            case mode of {
                1 -> 57;
                "alpha" -> 92;
                "delta" -> 2;
                _: string -> 13
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
