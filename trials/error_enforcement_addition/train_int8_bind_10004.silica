// expected failure E2018: binding 'height' has no type annotation
// int8 bindings then expression; expect 39
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            c: int8 <- (10 + 52) - 50 / 45;
            height <- 15;
            39 + c - c + height - height
        });
        _: int64 <- wait_for_exit()
    produces
        pure 39
    end
}
