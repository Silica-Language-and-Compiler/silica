// expected failure E1045: function 'scale' declared without the fn keyword
// helper scale/3 on int16; scale(2, 4, 4) = 0
use trial_support_int16;

scale(x: int16, y: int16, z: int16) -> int16 {
    28 % x % (y + z)
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            scale(2, 4, 4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
