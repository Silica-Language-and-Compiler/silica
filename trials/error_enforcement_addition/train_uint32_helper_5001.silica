// expected failure E2003: parameter x declared int8 in a uint32 helper
// helper scale/2 on uint32; scale(15, 17) = 92
use trial_support_uint32;

fn scale(x: int8, y: uint32) -> uint32 {
    x + y + 60
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            scale(15, 17)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 92
    end
}
