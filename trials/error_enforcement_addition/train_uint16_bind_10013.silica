// expected failure E2003: binding height declared uint64 but used as uint16
// uint16 bindings then expression; expect 17
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            height: uint64 <- 22 / 18 % (55 + 42);
            total: uint16 <- height;
            c: uint16 <- height * height;
            count: uint16 <- c;
            17 + total - total + count - count
        });
        _: int64 <- wait_for_exit()
    produces
        pure 17
    end
}
