// expected failure E1042: function 'main' has no return type
// count over [44, 6, 33, 42, 35, 18] = 6
use trial_support_int64;

fn count(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [_: int64, t: List[int64, mem(normal)]] -> 1 + count(t);
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [44, 6, 33, 42, 35, 18];
                r: int64 <- count(xs)
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
