// In a normal build supervision_ingress_enqueue is not a builtin: a program's own function of that
// name is an ordinary function and a bare call reaches it. Expected output: 42, exit status 0.
use trial_support_int64;

fn supervision_ingress_enqueue(a: int64, b: int64) -> int64 {
    a * 10 + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            supervision_ingress_enqueue(4, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
