// Spec §19.3.3 / §6: in a normal build the trial hook name is not a builtin, so a call to it is
// E2007 unknown function. (A trial compiler accepts it; this trial is compiled by the normal one.)
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        _: atom <- supervision_ingress_enqueue(self(), 7)
    produces
        pure (:reply, msg, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
