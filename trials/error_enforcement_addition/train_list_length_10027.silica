// expected failure E1055: binding 'leftover' is never used
// list literal of 5 int32 elements; length is 5
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            leftover: int64 <- 41;
            sequence proc[mem(normal)]
                xs: List[int32, mem(normal)] <- [28, 19, 5, 15, 36];
                n: int64 <- length[int32, mem(normal)](xs)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
