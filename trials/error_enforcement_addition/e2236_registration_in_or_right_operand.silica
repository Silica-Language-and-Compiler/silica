// Spec §15.4.13.4 "Handler before any start" (E2236), branches: the right operand of and / or runs
// only on some paths, so a registration there does not count. The worker's spawn after it is
// reported.

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn pick() -> int64 {
    3
}

fn main() -> int64 {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: boolean <- pick() == 0 or register_failure_reporter(r) == :ok;
        _: actor_ref <- spawn(0, work, stack_policy(0, :keep_last_message));
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
