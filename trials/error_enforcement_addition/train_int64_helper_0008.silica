// expected failure E1045: function 'mix' declared without the fn keyword
// helper mix/2 on int64; mix(4, 11) = 2
use trial_support_int64;

mix(x: int64, y: int64) -> int64 {
    y * x % 21
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mix(4, 11)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
