// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 5 gives 15
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 5;
            case v of {
                :3 -> 40;
                6 -> 17;
                10 -> 6;
                m: int32 if m > 1 -> 15;
                _: int32 -> 50
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
