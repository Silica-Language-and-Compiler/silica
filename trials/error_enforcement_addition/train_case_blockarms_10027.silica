// expected failure E1041: trailing ';' after a block arm's final expression
// case arms with multi-statement block bodies; expect 52
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- 3;
            case x of {
                0 -> {
                    base: int64 <- 10;
                    base * 2;
                }
                _: int64 -> {
                    step: int64 <- 17;
                    x * step + 1
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
