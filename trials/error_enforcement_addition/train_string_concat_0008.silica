// expected failure E2001: integer literal passed to concatenate
// concatenate of 3 pieces prints gammaappleriver

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] s: string <- concatenate(concatenate("gamma", "apple"), 5);
                print_string(s);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
