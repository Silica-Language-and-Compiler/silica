// expected failure E2003: binding count declared int8 but used as int64
// int64 bindings then expression; expect 36
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            count: int8 <- 29 * 3;
            d: int64 <- 5;
            step: int64 <- count;
            (12 * (count / 24)) + d - d + step - step
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
