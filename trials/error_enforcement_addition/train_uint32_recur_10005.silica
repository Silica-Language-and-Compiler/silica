// expected failure E1055: binding 'scratch' is never used
// recursive steps on uint32; steps(9, 0) = 9
use trial_support_uint32;

fn steps(n: uint32, acc: uint32) -> uint32 {
    scratch: int64 <- 41;
    case n == 0 of {
        true -> acc;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            steps(9, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 9
    end
}
