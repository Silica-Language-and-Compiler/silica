// expected failure E2005: wrong argument count in call to 'blend'
// float16 helper blend; prints 26.0
use trial_support_atom;

fn blend(x: float16) -> float16 {
    x + 21.0 + 4.0
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float16(blend())
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
