// expected failure E1042: function 'main' has no return type
// int8 bindings then expression; expect 18
use trial_support_int8;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            total: int8 <- 37 + 59;
            base: int8 <- total;
            b: int8 <- base - (base - 18);
            m: int8 <- 12;
            b + m - m
        });
        _: int64 <- wait_for_exit()
    produces
        pure 18
    end
}
