// Large float64: order of ops (multiply before add): 1.5e5 + 1.25e3 * 1.2e2 = 1.5e5 + 1.5e5 = 3.0e5
use trial_support_atom;

fn main() -> atom proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            print_float32(1.5e5 + 1.25e3 * 1.2e2)
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
