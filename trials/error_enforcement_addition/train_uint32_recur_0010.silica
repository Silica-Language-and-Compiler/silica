// expected failure E4015: function 'pow2' defined twice
// recursive pow2 on uint32; pow2(3) = 8
use trial_support_uint32;

fn pow2(n: uint32) -> uint32 {
    case n == 0 of {
        true -> 1;
        false -> 2 * pow2(n - 1)
    }
}

fn pow2(n: uint32) -> uint32 {
    case n == 0 of {
        true -> 1;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            pow2(3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 8
    end
}
