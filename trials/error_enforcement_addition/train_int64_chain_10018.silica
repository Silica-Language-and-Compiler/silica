// expected failure E1055: binding 'unused_value' is never used
// chained print_int64 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            unused_value: int64 <- 41;
            sequence proc[device_io]
                _: atom <- print_int64(28 * 22);
                println("");
                _: atom <- print_int64(11);
                println("");
                result: atom <- print_int64(34 / 42 * (24 - 19))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
