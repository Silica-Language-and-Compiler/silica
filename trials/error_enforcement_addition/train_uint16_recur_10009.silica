// expected failure E2001: atom literal returned from the recursion base case
// recursive steps on uint16; steps(13, 0) = 13
use trial_support_uint16;

fn steps(n: uint16, acc: uint16) -> uint16 {
    case n == 0 of {
        true -> :done;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            steps(13, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
