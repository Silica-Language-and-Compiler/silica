// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on uint64; tri_acc(16, 0) = 136
use trial_support_uint64;

fn tri_acc(n: uint64, acc: uint64) -> uint64 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            tri_acc(16, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 136
    end
}
