// expected failure E2018: binding 'mode' has no type annotation
// case over atoms; :idle selects 16
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode <- :idle;
            case mode of {
                :cold -> 80;
                :idle -> 16;
                :ready -> 47;
                _: atom -> 59
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
