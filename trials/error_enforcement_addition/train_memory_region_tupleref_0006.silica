// expected failure E2003: ref declared with a different tuple shape than the value
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: flat tuple stored in a ref and read back; expect 85
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                t: (int64, int64) <- (43, 42);
                cell: ref(L1, normal, (int64, string)) <- alloc_ref(r, t);
                back: (int64, int64) <- read_ref(cell);
                (x: int64, y: int64) <- back;
                value: int64 <- x + y
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
