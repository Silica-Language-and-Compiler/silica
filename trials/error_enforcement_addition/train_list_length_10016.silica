// expected failure E3010: list space does not match the sequence's mem effect
// list literal of 4 uint32 elements; length is 4
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[uint32, mem(normal_writethrough)] <- [31, 5, 35, 15];
                n: int64 <- length[uint32, mem(normal_writethrough)](xs)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
