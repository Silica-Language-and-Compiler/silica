// expected failure E1049: sequence block without produces
// float32 bindings 20.75 * 1.125 printed as 23.34375
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: float32 <- 20.75;
                b: float32 <- 1.125;
                result: atom <- print_float32(a * b)
                pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
