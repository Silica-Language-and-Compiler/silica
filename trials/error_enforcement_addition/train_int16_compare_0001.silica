// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == (15 + 55) < 1);
                println("");
                _: atom <- print_boolean(41 != (52 + 40));
                println("");
                _: atom <- print_boolean(1 > 26);
                println("");
                result: atom <- print_boolean(36 <= (11 + 6))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
