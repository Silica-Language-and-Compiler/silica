// expected failure E1052: duplicate sequence keyword
// Spec §16.1.1: call(actor_ref, message) -> Reply; behavior returns (:reply, reply, new_state)
use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(4, acc, stack_policy(0, :keep_last_message));
                r0: int64 <- call(w, 11 impl ActorMessage {});
                print_int64(r0);
                println("");
                r1: int64 <- call(w, 10 impl ActorMessage {});
                print_int64(r1);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
