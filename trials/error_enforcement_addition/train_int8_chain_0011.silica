// expected failure E2018: binding 'result' has no type annotation
// chained print_int8 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_int8(54 + 22);
                println("");
                _: atom <- print_int8(54 - 35);
                println("");
                _: atom <- print_int8(25);
                println("");
                result <- print_int8((7 / 17))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
