// expected failure E2018: binding 'mode' has no type annotation
// case on string literals; "cloud" gives 53
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode <- "cloud";
            case mode of {
                "chair" -> 33;
                "cloud" -> 53;
                "south" -> 81;
                _: string -> 82
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
