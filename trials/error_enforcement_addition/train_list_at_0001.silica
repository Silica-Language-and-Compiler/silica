// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// list_at index 1 of [0, 30, 35, 28] is 30
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io] xs: List[int64, mem(normal)] <- [0, 30, 35, 28];
                v: int64 <- list_at[int64, mem(normal)](xs, 1)
                produces pure v end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
