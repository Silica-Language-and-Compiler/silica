// expected failure E1055: binding 'scratch' is never used
// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            scratch: int64 <- 41;
            sequence proc[device_io] _: atom <- print_boolean(25 * 0 < (39 + 59));
                println("");
                _: atom <- print_boolean(29 / 5 != (10 % 1));
                println("");
                _: atom <- print_boolean(37 % 15 <= 40 / 35);
                println("");
                result: atom <- print_boolean((56 - 45) >= 2)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
