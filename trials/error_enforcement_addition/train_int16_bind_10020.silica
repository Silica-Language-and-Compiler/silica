// expected failure E1041: trailing ';' after the block's final expression
// int16 bindings then expression; expect 126
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            b: int16 <- 42;
            height: int16 <- b + b + b;
            total: int16 <- 0;
            height + total - total;
        });
        _: int64 <- wait_for_exit()
    produces
        pure 126
    end
}
