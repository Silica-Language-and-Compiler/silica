// expected failure E2005: field name misspelled in the function body
// record passed to a function; area({ width: 14, height: 8 }) = 112
use trial_support_int64;

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.heigth
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            area({ width: 14, height: 8 })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
