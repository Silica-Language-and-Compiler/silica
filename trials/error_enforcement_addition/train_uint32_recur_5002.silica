// expected failure E1047: named struct declaration 'Node' is not allowed
// recursive pow2 on uint32; pow2(4) = 16
use trial_support_uint32;

struct Node { x: int64, y: int64 }

fn pow2(n: uint32) -> uint32 {
    case n == 0 of {
        true -> 1;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            pow2(4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 16
    end
}
