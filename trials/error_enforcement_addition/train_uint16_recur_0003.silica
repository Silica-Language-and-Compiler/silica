// expected failure E2005: boolean case missing its false branch
// recursive digit_count on uint16; digit_count(41) = 2
use trial_support_uint16;

fn digit_count(n: uint16) -> uint16 {
    case n < 10 of {
        true -> 1
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            digit_count(41)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
