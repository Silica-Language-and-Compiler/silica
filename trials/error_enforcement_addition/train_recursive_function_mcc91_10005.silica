// expected failure E1055: binding 'unused_value' is never used
// McCarthy 91; mcc91(75) = 91
use trial_support_int64;

fn mcc91(n: int64) -> int64 {
    unused_value: int64 <- 41;
    case n > 100 of {
        true -> n - 10;
        false -> mcc91(mcc91(n + 11))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mcc91(75)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
