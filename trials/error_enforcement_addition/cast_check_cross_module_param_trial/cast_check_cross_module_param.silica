// Spec §16.1.2 (2026-10-12): passing a call-only actor to a function that casts to its parameter is
// rejected at the call site with E2237, also across modules: main spawns the other module's call-only
// behaviour and passes the reference to cast_check_param_lib@nudge, which casts to it. (Fable's
// xmod2 repro.)
use cast_check_param_lib;

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn main() -> int64 {
    sequence proc[concurrency]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        q: actor_ref <- spawn(0, cast_check_param_lib@plain, stack_policy(0, :keep_last_message));
        _: boolean <- cast_check_param_lib@nudge(q);
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
