// Library for cast_check_cross_module_param: a call-only behaviour, and a function that casts to its
// parameter.
export plain/2;
export nudge/1;

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn nudge(r: actor_ref) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(r, "x" impl ActorMessage {})
    produces
        pure ok
    end
}
