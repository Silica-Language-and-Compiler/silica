// expected failure E2005: string literal pattern against an integer scrutinee
// case on int32 value 10; expect 32
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 10;
            case v of {
                "one" -> 59;
                6 -> 106;
                43 -> 172;
                n: int32 if n > 33 -> 94;
                _: int32 -> 32
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 32
    end
}
