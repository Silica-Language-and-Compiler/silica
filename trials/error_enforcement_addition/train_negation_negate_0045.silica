// expected failure E1055: binding 'scratch' is never used
// negate_float64 applied 3 time(s); prints -28.125
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            scratch: int64 <- 41;
            sequence proc[device_io]
                result: atom <- print_float64(negate_float64(negate_float64(negate_float64(28.125))))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
