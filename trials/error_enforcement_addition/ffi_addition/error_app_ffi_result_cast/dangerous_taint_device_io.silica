module dangerous_taint_device_io;

use dangerous_legacy_stub;
use trial_support_int64;

fn ffi_worker_behavior(
    msg: int64,
    state: int64
) -> (:no_reply, int64) {
    sequence proc[external_danger, device_io]
        sum: int64 <- dangerous_legacy_stub@add(msg, state);
        _: int64 <- print_int64(sum)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                worker_ref: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker_behavior, stack_policy(0, :keep_last_message))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
