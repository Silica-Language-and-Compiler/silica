module dangerous_external_danger_message_boundary;

use dangerous_legacy_stub;
use trial_support_int64;

fn sink_behavior(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn ffi_worker_behavior(
    msg: int64,
    state: { pending: int64, reply_to: actor_ref, peer: actor_ref }
) -> (:no_reply, { pending: int64, reply_to: actor_ref, peer: actor_ref }) {
    sequence proc[external_danger, concurrency]
        sum: int64 <- dangerous_legacy_stub@add(msg, state.pending);
        _: boolean <- cast(state.reply_to, sum impl ActorMessage {});
        _: int64 <- call(state.peer, sum impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                reply_ref: actor_ref <- spawn(0, sink_behavior, stack_policy(0, :keep_last_message));
                peer_ref: actor_ref <- spawn(0, sink_behavior, stack_policy(0, :keep_last_message));
                worker_ref: dangerous_actor_ref <- spawn_dangerous({ pending: 0, reply_to: reply_ref, peer: peer_ref }, ffi_worker_behavior, stack_policy(0, :keep_last_message))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
