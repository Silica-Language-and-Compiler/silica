// E2406: decode on external-danger-touched bytes is permitted only inside a sequence
// proc[external_danger] block (or the handler that receives an FFI result cast); a nested plain
// sequence is outside it. The bytes are tainted because they are cut by a tainted length.
module dangerous_decode_outside_external_danger;

use dangerous_legacy_stub;
use trial_support_int64;
use wire_etf;

fn ffi_worker_behavior(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger, mem(normal), transport]
        n: int64 <- dangerous_legacy_stub@add(msg, state);
        raw: string <- byte_slice("abcdef", 0, n);
        got: int64 <- {
            sequence proc[mem(normal), transport]
                r: (:ok, int64) | (:rejected, atom) <- decode((:etf), raw);
                v: int64 <- case r of {
                    (:ok, w: int64) -> w;
                    (:rejected, _why: atom) -> 0 - 1
                }
            produces
                pure v
            end
        }
    produces
        pure (:no_reply, got)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                worker_ref: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker_behavior, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
