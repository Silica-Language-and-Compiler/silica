module dangerous_direct_call_fail;

use dangerous_legacy_stub;
use trial_support_int64;

fn ffi_worker_behavior(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- dangerous_legacy_stub@add(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn client_behavior(
    msg: int64,
    state: { worker: actor_ref }
) -> (:no_reply, { worker: actor_ref }) {
    _: int64 <- dangerous_legacy_stub@add(msg, 1);
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                worker_ref: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker_behavior, stack_policy(0, :keep_last_message));
                client_ref: actor_ref <- spawn({ worker: worker_ref }, client_behavior, stack_policy(0, :keep_last_message))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
