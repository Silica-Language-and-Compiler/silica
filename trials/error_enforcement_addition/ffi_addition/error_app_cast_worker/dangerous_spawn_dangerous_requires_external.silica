use trial_support_int64;

module dangerous_spawn_dangerous_requires_external;

fn worker_behavior(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                worker_ref: dangerous_actor_ref <- spawn_dangerous(0, worker_behavior, stack_policy(0, :keep_last_message))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
