module dangerous_cast_registered_bad_atom;

use dangerous_legacy_stub;
use trial_support_int64;

fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- dangerous_legacy_stub@add(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                _: dangerous_actor_ref <- spawn_dangerous_registered(0, ffi_worker, :dangerous_worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast_dangerous_registered(:bad_worker_name, 2 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
