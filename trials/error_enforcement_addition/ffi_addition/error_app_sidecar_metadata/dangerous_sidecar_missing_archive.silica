use trial_support_int64;

module dangerous_sidecar_missing_archive;

wrapper_meta "dangerous_exposure_source/bad_missing_archive.meta";

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(left: int64, right: int64) -> int64;

// The binding is reached the way spec 4.4/4.5 require: from the external_danger sequence of the FFI
// worker installed by spawn_dangerous. A direct call from main is E4042 at compile time and would never
// reach the link manifest. The sidecar names an archive that does not exist, so the failure this trial
// proves is E4034 when the manifest is built.
fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- add_raw(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                worker_ref: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast(worker_ref, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
