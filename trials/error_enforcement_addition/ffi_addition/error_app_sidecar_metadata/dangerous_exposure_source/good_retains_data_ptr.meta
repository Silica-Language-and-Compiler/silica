link_library: "silica_legacy_math"

wrapper silica_retain_keep {
    symbol: "silica_retain_keep"
    result: "scalar"
    error_domain: "dangerous_legacy_math"
    arguments: [
        { name: "data_ptr", lifetime: "borrowed", retain: false },
        { name: "data_len", role: "length", length_of: "data_ptr" }
    ]
    retains: [data_ptr];
}
