use trial_support_int64;

module dangerous_too_many_args_fail;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(
    a1: int64,
    a2: int64,
    a3: int64,
    a4: int64,
    a5: int64,
    a6: int64,
    a7: int64,
    a8: int64,
    a9: int64
) -> int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
