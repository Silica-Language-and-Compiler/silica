// expected failure E1047: named struct declaration 'Point' is not allowed
// int16 arithmetic: (59 * 48 * (11 % 48) % (58 + (31 + 12))) = 44
use trial_support_int16;

struct Point { x: int64, y: int64 }

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            (59 * 48 * (11 % 48) % (58 + (31 + 12)))
        });
        _: int64 <- wait_for_exit()
    produces
        pure 44
    end
}
