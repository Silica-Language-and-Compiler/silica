// expected failure E2003: binding b declared int16 but used as int64
// int64 bindings then expression; expect 28
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            b: int16 <- 18 * 25;
            width: int64 <- 9 + 18;
            count: int64 <- width;
            width % 38 + 13 / 8 + b - b + count - count
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
