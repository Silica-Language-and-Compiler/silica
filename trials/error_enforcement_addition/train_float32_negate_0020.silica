// expected failure E1050: produces clause without pure
// negate_float32 applied 3 time(s); prints -15.25
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float32(negate_float32(negate_float32(negate_float32(15.25))))
                produces result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
