// Defect repro (found 2026-10-08, item M): a parse error inside a function literal passed as a call
// argument inside a sequence block is reported as E1069 ("main has no parsable body") at main
// instead of its own code; here the duplicate `produces` (E1053). Outside a sequence the same
// literal reports E1053. The golden was derived by hand from that working case.
fn apply(f: fn() -> int64) -> int64 {
    f()
}

fn main() -> int64 {
    sequence proc[device_io]
        println("x");
        v: int64 <- apply(fn() -> int64 {
            sequence
            produces produces pure 0 end
        })
    produces
        pure v
    end
}
