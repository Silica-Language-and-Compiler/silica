// expected failure E1045: function 'steps' declared without the fn keyword
// recursive steps on uint16; steps(42, 0) = 42
use trial_support_uint16;

steps(n: uint16, acc: uint16) -> uint16 {
    case n == 0 of {
        true -> acc;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            steps(42, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 42
    end
}
