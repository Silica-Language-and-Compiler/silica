// regression (already diagnosed by silica-999997): expected failure E3002: device_io used inside a case arm of a mem(normal) sequence
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                x: int64 <- 1;
                _: atom <- case x of {
                    0 -> print_int64(0);
                    _: int64 -> print_int64(1)
                }
            produces pure 7 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
