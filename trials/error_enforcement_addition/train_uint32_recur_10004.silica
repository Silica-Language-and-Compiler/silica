// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on uint32; digit_count(17) = 2
use trial_support_uint32;

fn digit_count(n: uint32) -> uint32 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            digit_count(17)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
