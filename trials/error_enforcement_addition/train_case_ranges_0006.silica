// expected failure E1055: binding 'spare' is never used
// guards partition int64 into three ranges; n = 105 gives 205
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            spare: int64 <- 41;
            n: int64 <- 105;
            case n of {
                n: int64 if n < 101 -> n + 100;
                n: int64 if n >= 101 and n < 117 -> n + 100;
                n: int64 if n >= 117 -> n
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
