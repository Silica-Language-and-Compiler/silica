// expected failure E2005: call to unknown function 'print_stringx'
// substring_until_char from 0 up to ','
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                s: string <- substring_until_char("hello,north,gamma", 0, ',');
                print_stringx(s);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
