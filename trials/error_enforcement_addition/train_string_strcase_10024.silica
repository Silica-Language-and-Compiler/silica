// expected failure E2005: integer pattern against a string scrutinee
// case on string literals; "table" gives 15
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "table";
            case mode of {
                6 -> 90;
                "river" -> 6;
                "table" -> 15;
                _: string -> 54
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
