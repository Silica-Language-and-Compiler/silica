// A List[Collectable, S] with no concrete element type resolvable from context must be
// rejected, not silently accepted (§8.2.4). Moved here from list_addition/trial_negative_*,
// which had no .golden_fail and was excluded from that suite's compile batch by filename only.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                n: int64 <- length[Collectable, mem(normal)](empty[Collectable, mem(normal)]())
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
