// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int64; v = 10 gives 14
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v: int64 <- 10;
            case v of {
                :13 -> 11;
                0 -> 28;
                14 -> 12;
                m: int64 if m > 1 -> 14;
                _: int64 -> 33
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
