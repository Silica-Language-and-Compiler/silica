// expected failure E2005: integer pattern against a boolean scrutinee
// case on a boolean binding; expect 79
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            flag: boolean <- false;
            case flag of {
                1 -> 88;
                false -> 79
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
