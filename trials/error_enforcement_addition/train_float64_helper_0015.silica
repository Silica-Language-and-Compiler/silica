// expected failure E2003: scale returns float16 but its result feeds print_float64
// float64 helper scale; prints 45.625
use trial_support_atom;

fn scale(x: float64) -> float16 {
    x + 8.125 + 2.25
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float64(scale(35.25))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
