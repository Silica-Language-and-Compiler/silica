// expected failure E2003: binding height declared uint8 but used as uint16
// uint16 bindings then expression; expect 3
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            height: uint8 <- 32 / 42;
            d: uint16 <- height;
            count: uint16 <- d;
            k: uint16 <- 3;
            count + d + k % 5
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
