// expected failure E1045: function 'compute' declared without the fn keyword
// helper compute/3 on int16; compute(4, 1, 17) = 42
use trial_support_int16;

compute(x: int16, y: int16, z: int16) -> int16 {
    (y + y) * (z + x)
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            compute(4, 1, 17)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 42
    end
}
