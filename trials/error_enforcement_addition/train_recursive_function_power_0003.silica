// expected failure E2003: exponent parameter declared as a string
// power(1, 2) = 1
use trial_support_int64;

fn power(b: int64, e: string) -> int64 {
    case e == 0 of {
        true -> 1;
        false -> b * power(b, e - 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            power(1, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
