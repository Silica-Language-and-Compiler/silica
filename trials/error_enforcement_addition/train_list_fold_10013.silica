// expected failure E2005: list case pattern typed with the wrong element type
// count_even over [37, 41, 36, 55, 53, 25] = 1
use trial_support_int64;

fn count_even(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [h: string, t: List[int64, mem(normal)]] -> case h % 2 == 0 of {
            true -> 1 + count_even(t);
            false -> count_even(t)
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [37, 41, 36, 55, 53, 25];
                r: int64 <- count_even(xs)
            produces pure r end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
