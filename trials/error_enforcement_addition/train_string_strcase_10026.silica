// expected failure E2018: binding 'mode' has no type annotation
// case on string literals; "region" gives 12
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode <- "region";
            case mode of {
                "cherry" -> 44;
                "delta" -> 17;
                "region" -> 12;
                _: string -> 30
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
