// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io, mem(normal)] _: atom <- print_boolean((22.0 - 33.25) > 18.375);
                println("");
                _: atom <- print_boolean(24.125 * 27.25 <= 9.75);
                println("");
                _: atom <- print_boolean(37.25 >= (2.125 + 33.25));
                println("");
                done: atom <- print_boolean((1.75 - 3.375) < (14.0 + 3.5))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
