// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == 60 / 60 < 10 * 42);
                println("");
                _: atom <- print_boolean((52 + 25) != 55 / 25);
                println("");
                _: atom <- print_boolean(40 == (46 + 43));
                println("");
                _: atom <- print_boolean((16 + 1) < (2 + 48));
                println("");
                result: atom <- print_boolean(47 != 9 / 15)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
