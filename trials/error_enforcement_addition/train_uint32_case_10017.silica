// expected failure E1041: trailing ';' after the block's final expression
// case on uint32 value 6; expect 190
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            v: uint32 <- 6;
            case v of {
                19 -> 188;
                35 -> 108;
                _: uint32 -> 190
            };
        });
        _: int64 <- wait_for_exit()
    produces
        pure 190
    end
}
