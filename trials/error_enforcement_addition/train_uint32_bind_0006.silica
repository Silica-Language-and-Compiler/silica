// expected failure E2013: unary minus on a variable instead of negate_uint32
// uint32 bindings then expression; expect 33
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            a: uint32 <- 33;
            count: uint32 <- 59 + a;
            base: uint32 <- 24;
            k: uint32 <- 37 / 3;
            -a + a + count - count + base - base + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 33
    end
}
