// expected failure E1045: function 'main' declared without the fn keyword
// main returns boolean 3 < 5; exit code 1
use trial_support_boolean;

main() -> boolean {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_boolean@start();
        _: boolean <- trial_support_boolean@run(fn() -> boolean {
            3 < 5
        });
        _: int64 <- wait_for_exit()
    produces
        pure true
    end
}
