// expected failure E2001: integer literal bound to a boolean
// nested boolean cases; (false, false) selects 14
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- 1;
            b: boolean <- false;
            case a of {
                true -> case b of {
                    true -> 40;
                    false -> 19
                };
                false -> case b of {
                    true -> 98;
                    false -> 14
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
