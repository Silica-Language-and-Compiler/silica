// E1053 at the nested block: the unbraced nested sequence block repeats `produces`; the enclosing
// block's own `produces` / `end` are not taken for it.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("outer");
                v: int64 <- sequence proc[device_io]
                    println("inner")
                produces produces
                    pure 41
                end;
                w: int64 <- v + 1
            produces
                pure w
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
