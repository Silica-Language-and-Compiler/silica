use trial_support_int64;

// A module-qualified recv is not a way round the rule: it names no function.
// Expected: E1069, parse error: recv is a keyword, so the call cannot parse

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        got: int64 <- trial_support_int64@recv()
    produces
        pure 0
    end
}
