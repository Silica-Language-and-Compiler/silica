// expected failure E3001: print_float32 called outside a sequence block
// print_float32 of 14.0 * 26.0; prints 364.0
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            print_float32(14.0 * 26.0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
