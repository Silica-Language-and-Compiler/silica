// expected failure E1041: trailing ';' after the block's final expression
// uint8 bindings then expression; expect 74
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            step: uint8 <- (2 + 12) / (44 + 43);
            total: uint8 <- step;
            b: uint8 <- (total * (6 * 32));
            k: uint8 <- 8;
            38 + (28 + k) + b - b;
        });
        _: int64 <- wait_for_exit()
    produces
        pure 74
    end
}
