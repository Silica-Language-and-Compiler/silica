// expected failure E2003: binding count declared int64 but used as int8
// int8 bindings then expression; expect 49
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            count: int64 <- (52 + 28) % (34 + 45);
            a: int8 <- count;
            height: int8 <- (6 * 10 + count);
            k: int8 <- height;
            49 + a - a + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 49
    end
}
