// expected failure E2018: binding 'v' has no type annotation
// list_at index 0 of [38, 1] is 38
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [38, 1];
                v <- list_at[int64, mem(normal)](xs, 0)
            produces pure v end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
