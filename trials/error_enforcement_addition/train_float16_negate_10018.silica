// expected failure E1050: produces clause without pure
// negate_float16 applied 3 time(s); prints -9.5
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float16(negate_float16(negate_float16(negate_float16(9.5))))
            produces result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
