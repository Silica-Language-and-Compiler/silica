// E1050 at the nested block: a sequence block nested unbraced as a binding value inside another
// sequence body is checked as its own block; its produces clause lacks `pure`.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("outer");
                v: int64 <- sequence proc[device_io]
                    println("inner")
                produces
                    41
                end;
                w: int64 <- v + 1
            produces
                pure w
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
