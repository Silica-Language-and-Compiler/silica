// expected failure E1060: unbalanced braces
// remove_head on [0, 39] gives 1
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [0, 39];
                rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
                n: int64 <- length[int64, mem(normal)](rest)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}}
