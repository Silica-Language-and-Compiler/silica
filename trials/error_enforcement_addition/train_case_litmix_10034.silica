// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint64; v = 10 gives 44
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 10;
            case v of {
                :14 -> 27;
                2 -> 26;
                4 -> 37;
                m: uint64 if m > 2 -> 44;
                _: uint64 -> 2
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 44
    end
}
