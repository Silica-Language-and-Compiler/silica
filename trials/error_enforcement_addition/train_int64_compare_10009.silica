// expected failure E2005: call to unknown function 'print_boolx'
// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((35 + 15) >= (59 - 6));
                println("");
                _: atom <- print_boolean((31 + 23) > 41 * 1);
                println("");
                _: atom <- print_boolx(45 * 11 != 7 % 27);
                println("");
                _: atom <- print_boolean(49 % 35 < 39 / 4);
                println("");
                result: atom <- print_boolean((37 - 35) <= 0)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
