// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name only if, where the
// literal is written, the name is bound to an integer literal by an integer-typed binding.
// The literal captures n, bound to the boolean literal true.

fn take2(op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(1, 2)
}

fn main() -> int64 {
    n: boolean <- true;
    take2(fn(x: int64, y: int64) -> int64 { case n of { true -> x + y; false -> 9 } })
}
