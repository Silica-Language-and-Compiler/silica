// expected failure E1049: sequence block without produces
// print_float32 of 33.375 * 20.5; prints 684.1875
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float32(33.375 * 20.5)
                pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
