// expected failure E1055: binding 'leftover' is never used
// helper adjust/3 on int64; adjust(12, 20, 5) = 60
use trial_support_int64;

fn adjust(x: int64, y: int64, z: int64) -> int64 {
    leftover: int64 <- 41;
    y / z + (44 + x)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            adjust(12, 20, 5)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
