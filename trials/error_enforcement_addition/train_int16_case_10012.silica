// expected failure E2005: string literal pattern against an integer scrutinee
// case on int16 value 7; expect 75
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            v: int16 <- 7;
            case v of {
                true -> 136;
                35 -> 94;
                43 -> 152;
                n: int16 if n > 33 -> 65;
                _: int16 -> 75
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 75
    end
}
