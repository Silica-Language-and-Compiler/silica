// spawn_linked is no longer part of the public language surface.
// Any direct source use must fail type checking with E2091 and guidance
// to use spawn_registered/spawn_registered_supervisor instead.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                child: actor_ref <- spawn_linked(0, main, :phase_d_noop)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
