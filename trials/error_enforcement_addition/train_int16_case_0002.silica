// expected failure E2005: string literal pattern against an integer scrutinee
// case on int16 value 26; expect 56
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            v: int16 <- 26;
            case v of {
                true -> 92;
                18 -> 12;
                29 -> 87;
                0 -> 105;
                n: int16 if n > 4 -> 56;
                _: int16 -> 166
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 56
    end
}
