// expected failure E1053: duplicate produces keyword
// atom identity: :pending != :pending is false
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                left: atom <- :pending;
                result: atom <- print_boolean(left != :pending)
            produces produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
