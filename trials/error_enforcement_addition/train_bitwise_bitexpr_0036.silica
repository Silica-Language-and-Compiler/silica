// expected failure E2018: binding 'hi' has no type annotation
// uint64 bitwise: (one band hi) bor three = 1
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            one: uint64 <- 1;
            hi <- 7;
            three: uint64 <- 1;
            (one band hi) bor three
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
