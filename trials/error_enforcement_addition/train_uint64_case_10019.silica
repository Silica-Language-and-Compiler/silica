// expected failure E1043: whitespace between binding name 'v' and ':'
// case on uint64 value 26; expect 119
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v :uint64 <- 26;
            case v of {
                29 -> 18;
                34 -> 44;
                38 -> 183;
                35 -> 47;
                _: uint64 -> 119
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 119
    end
}
