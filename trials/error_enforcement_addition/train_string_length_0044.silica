// expected failure E1049: sequence block without produces
// length_bytes of a bound string prints 5
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] text: string <- "a b c";
                result: atom <- print_int64(length_bytes(text))
                pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
