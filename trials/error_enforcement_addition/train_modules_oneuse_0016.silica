// expected failure E1009: use names a module that does not exist
// Spec §19.3: use lib_arity; then a module-qualified call lib_arity@add3(12, 17, 19) = 48
use lib_arity_missing;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_arity@add3(12, 17, 19)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
