// Effects are local (silica-specification §9.3.1 rule 4, "Effects Are Local"; Lee 2026-10-11).
// A sequence block declares only the effects of its own operations; calling a function never adds
// that function's effects to the caller.
//
// helper's own sequence allocates a list, so it declares proc[mem(normal)]. The caller's inner
// sequence performs no allocation of its own -- it only calls helper and prints -- yet declares
// mem(normal) as if the callee's effect propagated to it. That declaration is unused.
// Expected: E3010 "Unused effect declaration: mem(normal)" at the caller's sequence.
//
// (Formerly compile_defects_effect_propagation_addition/defect_effect_propagation, written to the
// old propagation rule, which expected this program to be accepted.)

use trial_support_int64;

fn helper() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal), device_io]
                ys: List[int64, mem(normal)] <- helper();
                print_int64(ys.head);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
