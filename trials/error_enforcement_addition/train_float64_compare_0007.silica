// expected failure E1041: trailing ';' after the pure expression
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((17.0 + 21.5) >= (14.0 + 12.375));
                println("");
                done: atom <- print_boolean((40.25 + 38.0) != 11.375 * 2.5)
                produces pure done; end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
