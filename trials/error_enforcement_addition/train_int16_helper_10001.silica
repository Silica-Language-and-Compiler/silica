// expected failure E1070: combine given nine parameters
// helper combine/3 on int16; combine(11, 4, 3) = 0
use trial_support_int16;

fn combine9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn combine(x: int16, y: int16, z: int16) -> int16 {
    y % z / x
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            combine(11, 4, 3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
