// expected failure E1055: binding 'leftover' is never used
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            leftover: int64 <- 41;
            sequence proc[device_io]
                _: atom <- print_boolean(34.125 == (3.0 - 7.0));
                println("");
                _: atom <- print_boolean(1.0 > (23.25 + 23.5));
                println("");
                done: atom <- print_boolean(20.25 * 20.375 == (2.0 + 10.0))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
