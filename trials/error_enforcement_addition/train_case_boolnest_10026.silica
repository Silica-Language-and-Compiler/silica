// expected failure E2001: integer literal bound to a boolean
// nested boolean cases; (true, true) selects 79
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- 1;
            b: boolean <- true;
            case a of {
                true -> case b of {
                    true -> 79;
                    false -> 64
                };
                false -> case b of {
                    true -> 31;
                    false -> 56
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
