// expected failure E1055: binding 'leftover' is never used
// case on int64 value 0; expect 152
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            leftover: int64 <- 41;
            v: int64 <- 0;
            case v of {
                44 -> 29;
                34 -> 18;
                38 -> 197;
                n: int64 if n > 23 -> 105;
                _: int64 -> 152
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
