// Spec §22.14.2: send_after's delay_ms is a uint64. An int64 binding passed as the delay is a type
// error; a literal (send_after(100, ...)) is accepted because a numeric literal takes the expected
// uint64 type.
fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        a: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        d: int64 <- 100;
        _: timer_ref <- send_after(d, a, 1 impl ActorMessage {})
    produces pure 0 end
}
