// E1040: the same missing right-hand side inside a function literal's sequence block, with the call
// outside any sequence block. Before 2026-10-08 this parsed and an effect error was reported instead.
use trial_support_int64;

fn apply(f: fn() -> int64) -> int64 {
    f()
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            println("x");
            v: int64 <- apply(fn() -> int64 {
                    sequence
                        x: int64 <- ;
                    produces
                        pure x
                    end
                });
            v
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
