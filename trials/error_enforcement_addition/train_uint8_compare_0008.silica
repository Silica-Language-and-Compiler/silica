// expected failure E1055: binding 'unused_value' is never used
// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            unused_value: int64 <- 41;
            sequence proc[device_io] _: atom <- print_boolean(16 < 59 % 31);
                println("");
                _: atom <- print_boolean(10 == (2 % 37));
                println("");
                _: atom <- print_boolean((4 + 27) >= 28);
                println("");
                result: atom <- print_boolean((8 - 5) != (34 + 35))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
