// expected failure E2003: binding d declared int32 but used as int8
// int8 bindings then expression; expect 10
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            d: int32 <- (28 % 50) % (23 % 33);
            base: int8 <- d;
            base + d + 3 / 41
        });
        _: int64 <- wait_for_exit()
    produces
        pure 10
    end
}
