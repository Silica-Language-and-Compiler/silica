// Spec §15.1.2 (2026-10-16): `move` is no longer a builtin -- the actor-migration function is
// `migrate_actor` -- so `move(w, 0, 0)` in a proc[concurrency] sequence is E2007.
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
                _: atom <- move(w, 0, 0)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
