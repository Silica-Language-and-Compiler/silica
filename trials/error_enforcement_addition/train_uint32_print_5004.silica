// expected failure E2018: binding 'b' has no type annotation
// print_uint32 two; prints 0 then 30
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: uint32 <- 12 / 48;
                b <- 30;
                _: atom <- print_uint32(a);
                println("");
                result: atom <- print_uint32(b)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
