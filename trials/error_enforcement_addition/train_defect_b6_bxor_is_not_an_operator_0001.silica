// regression (already diagnosed by silica-999997): expected failure E1040: bxor is not an operator (spec 3.3.1); the stray identifier ends the statement
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            three: int64 <- 3;
            five: int64 <- 5;
            three bxor five
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
