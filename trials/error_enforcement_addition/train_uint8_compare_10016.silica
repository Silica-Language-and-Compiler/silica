// expected failure E1051: sequence block without a closing end
// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(32 % 10 > (36 - 25));
                println("");
                _: atom <- print_boolean(53 <= 19 % 32);
                println("");
                _: atom <- print_boolean(24 / 38 <= (48 - 27));
                println("");
                _: atom <- print_boolean(24 / 53 == (47 % 44));
                println("");
                result: atom <- print_boolean((11 % 56) < (17 + 1))
            produces
                pure result
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
