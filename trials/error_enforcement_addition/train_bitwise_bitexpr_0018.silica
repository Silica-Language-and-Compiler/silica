// expected failure E2018: binding 'seven' has no type annotation
// uint64 bitwise: (((bnot mask) band seven) + lo) = 9
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            mask: uint64 <- 7;
            seven <- 2;
            lo: uint64 <- 9;
            (((bnot mask) band seven) + lo)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 9
    end
}
