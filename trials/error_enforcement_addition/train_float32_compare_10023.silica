// expected failure E2018: binding 'done' has no type annotation
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(20.5 > 37.0);
                println("");
                _: atom <- print_boolean(9.5 * 38.0 == 2.0);
                println("");
                done <- print_boolean((27.375 + 2.0) == 31.25 / 8.0)
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
