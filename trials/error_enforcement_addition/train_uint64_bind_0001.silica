// expected failure E2013: unary minus on a variable instead of negate_uint64
// uint64 bindings then expression; expect 0
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            c: uint64 <- (60 - 29) % 53;
            total: uint64 <- (16 * 10) - c;
            count: uint64 <- (15 * c);
            -c + 47 / (42 * 41) + total - total + count - count
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
