// E3010: transport is declared but nothing in the sequence is a transport operation (encode,
// decode, recreate, byte_at, byte_slice, bytes_of, join_bytes). The sequence only prints, so
// the declared transport effect is unused.
// Expected: E3010 "Unused effect declaration: transport" at transport in the proc list.
fn main() -> int64 {
    sequence proc[device_io, transport]
        _: atom <- println("no transport operation here")
    produces
        pure 0
    end
}
