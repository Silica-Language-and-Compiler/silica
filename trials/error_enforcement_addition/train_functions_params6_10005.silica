// expected failure E1042: function 'main' has no return type
// function with 6 parameter(s); sum6(9, 21, 24, 23, 17, 4) = 98
use trial_support_uint16;

fn sum6(a: uint16, b: uint16, c: uint16, d: uint16, e: uint16, f: uint16) -> uint16 {
    a + b + c + d + e + f
}

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            sum6(9, 21, 24, 23, 17, 4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 98
    end
}
