// expected failure E2003: parameter x declared int32 in a uint64 helper
// helper combine/1 on uint64; combine(11) = 0
use trial_support_uint64;

fn combine(x: int32) -> uint64 {
    18 * x / (x * 31)
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            combine(11)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
