// expected failure E2018: binding 'n' has no type annotation
// Positive: both device_io and mem(normal) declared and used in one sequence
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal), device_io] xs: List[int64, mem(normal)] <- [23, 26];
                n <- length[int64, mem(normal)](xs);
                result: atom <- print_int64(n)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
