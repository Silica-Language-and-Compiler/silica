// E2311 LifetimeConflictAtCall (chunk15_stack_memory_design.md §6.5; region_memory_safety_design.md §5,
// Q10 option A): one call instantiates each lifetime name of the callee's signature once. `load` names L
// for both its region and its ref; this call passes a region of L1 and a ref of L2, so L would be both.
// Expected: E2311 at the call to load.

fn load(r: region(L, normal), c: ref(L, normal, int64)) -> int64 {
    sequence proc[mem(normal)]
        v: int64 <- read_ref(c)
    produces
        pure v
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        L2: lifetime <- fresh_lifetime();
        r1: region(L1, normal) <- alloc_region(normal);
        r2: region(L2, normal) <- alloc_region(normal);
        c2: ref(L2, normal, int64) <- alloc_ref(r2, 5);
        v: int64 <- load(r1, c2)
    produces
        pure v
    end
}
