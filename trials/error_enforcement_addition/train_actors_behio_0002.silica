// expected failure E4016: no main/0: entry function renamed to 'main_program'
// Behavior prints inside its own sequence proc[device_io] before replying
fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        print_string("got ");
        print_int64(msg);
        println("")
    produces
        pure (:reply, msg * 6, state)
    end
}

fn main_program() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        r: int64 <- call(w, 3 impl ActorMessage {});
        print_int64(r);
        println("")
    produces
        pure :ok
    end
}
