// expected failure E1043: whitespace between binding name 'v' and ':'
// case on int16 value 13; expect 159
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            v :int16 <- 13;
            case v of {
                18 -> 148;
                31 -> 13;
                _: int16 -> 159
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 159
    end
}
