// Spec §16.1.2 (2026-10-12): a cast to a call-only actor is rejected at compile time with E2237,
// also when the reference comes from a function of another module (through its interface): here
// cast_check_lib@make_plain spawns a call-only actor and returns it. (Fable's xmod repro.)
use cast_check_lib;

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn main() -> int64 {
    sequence proc[concurrency]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        q: actor_ref <- cast_check_lib@make_plain();
        _: boolean <- cast(q, "a" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
