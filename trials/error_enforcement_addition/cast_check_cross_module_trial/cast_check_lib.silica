// Library for cast_check_cross_module: spawns a call-only actor and returns its reference.
export make_plain/0;
export plain/2;

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn make_plain() -> actor_ref {
    sequence proc[concurrency]
        a: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message))
    produces
        pure a
    end
}
