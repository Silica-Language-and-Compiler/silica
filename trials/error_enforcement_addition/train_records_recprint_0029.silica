// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// print each field of a mixed record
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)]
                person: { name: string, age: int64, active: boolean } <- { name: "cherry", age: 40, active: true };
                print_string(person.name);
                println("");
                print_int64(person.age);
                println("");
                print_boolean(person.active);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
