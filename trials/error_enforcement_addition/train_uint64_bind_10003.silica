// expected failure E2013: unary minus on a variable instead of negate_uint64
// uint64 bindings then expression; expect 135
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            k: uint64 <- 53;
            m: uint64 <- k;
            c: uint64 <- k + 29;
            d: uint64 <- 42;
            -k + c + k - (k - m) + d - d
        });
        _: int64 <- wait_for_exit()
    produces
        pure 135
    end
}
