// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == 43 < (7 * 5));
                println("");
                _: atom <- print_boolean(7 % 7 >= 41 % 48);
                println("");
                _: atom <- print_boolean(41 > (21 - 4));
                println("");
                result: atom <- print_boolean(10 >= 51 * 36)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
