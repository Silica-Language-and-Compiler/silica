// Spec §22.14.2 with §16.2.6.3: the type rules of cast() apply at the send_after call, so a timer
// whose target was spawned with a call-only behaviour (returns (:reply, ...)) is rejected at compile
// time with E2237, as cast() to it is.
fn answerer(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        a: actor_ref <- spawn(0, answerer, stack_policy(0, :keep_last_message));
        _: timer_ref <- send_after(10, a, 1 impl ActorMessage {})
    produces pure 0 end
}
