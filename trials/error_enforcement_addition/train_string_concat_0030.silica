// expected failure E1043: whitespace between binding name 's0' and ':'
// concat of 4 pieces prints cloudsouthñandúactor

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "cloud";
                b: string <- "south";
                s: string <- concat(a, b);
                s0 :string <- concat(s, "ñandú");
                s1: string <- concat(s0, "actor");
                print_string(s1);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
