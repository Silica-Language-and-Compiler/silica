// expected failure E1054: extra end after the sequence block
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(45 / 22 < 58 * 57);
                println("");
                _: atom <- print_boolean(28 < (43 / 27));
                println("");
                _: atom <- print_boolean(31 % 29 > (36 + 51));
                println("");
                result: atom <- print_boolean((21 + 19) <= 49)
            produces pure result end end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
