// expected failure E2018: binding 'first' has no type annotation
// head on [37, 29, 36] gives 37
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [37, 29, 36];
                first <- head[int64, mem(normal)](xs)
            produces
                pure first
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
