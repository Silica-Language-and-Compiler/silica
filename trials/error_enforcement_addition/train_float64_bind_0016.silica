// expected failure E2003: integer binding mixed into float arithmetic
// float64 bindings 38.125 + 36.5 printed as 74.625
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: float64 <- 38.125;
                b: int64 <- 36;
                result: atom <- print_float64(a + b)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
