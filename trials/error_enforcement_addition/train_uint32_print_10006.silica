// expected failure E1055: binding 'scratch' is never used
// print_uint32 var; prints 19
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            scratch: int64 <- 41;
            sequence proc[device_io]
                value: uint32 <- 4 + 40;
                result: atom <- print_uint32(value - 25)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
