// expected failure E2001: sequence produces a string but is bound to int64
// sequence result bound to a variable; expect 73
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            value: int64 <- sequence produces pure "58" end;
            value + 15
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
