// expected failure E2001: string literal in one case arm of an integer case
// case on int16 value 32; expect 126
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            v: int16 <- 32;
            case v of {
                10 -> "23";
                15 -> 110;
                _: int16 -> 126
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 126
    end
}
