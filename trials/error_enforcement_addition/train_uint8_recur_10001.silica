// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on uint8; tri_acc(13, 0) = 91
use trial_support_uint8;

fn tri_acc(n: uint8, acc: uint8) -> uint8 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            tri_acc(13, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 91
    end
}
