// expected failure E1047: named struct declaration 'Point' is not allowed
// int32 arithmetic: 22 / 20 * (22 % 57) = 22
use trial_support_int32;

struct Point { x: int64, y: int64 }

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            22 / 20 * (22 % 57)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 22
    end
}
