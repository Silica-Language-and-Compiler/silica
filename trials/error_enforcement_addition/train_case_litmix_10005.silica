// expected failure E1055: binding 'leftover' is never used
// literal patterns, a guard and a typed wildcard on uint64; v = 8 gives 33
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            leftover: int64 <- 41;
            v: uint64 <- 8;
            case v of {
                10 -> 33;
                11 -> 22;
                12 -> 37;
                m: uint64 if m > 13 -> 27;
                _: uint64 -> 33
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 33
    end
}
