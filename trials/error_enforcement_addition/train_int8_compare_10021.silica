// expected failure E2018: binding 'result' has no type annotation
// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(30 < (56 % 45));
                println("");
                _: atom <- print_boolean((39 + 13) == 6 % 14);
                println("");
                _: atom <- print_boolean(20 < 1 * 34);
                println("");
                _: atom <- print_boolean(59 / 14 <= 15 / 1);
                println("");
                result <- print_boolean((32 / 39) > 27 % 42)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
