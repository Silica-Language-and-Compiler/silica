// expected failure E2003: comparison against a string binding
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == 39 > 21 % 5);
                println("");
                _: atom <- print_boolean(56 % 11 < 22);
                println("");
                _: atom <- print_boolean((41 / 53) != 58 * 25);
                println("");
                _: atom <- print_boolean(5 == (38 + 16));
                println("");
                result: atom <- print_boolean(1 / 28 <= 35)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
