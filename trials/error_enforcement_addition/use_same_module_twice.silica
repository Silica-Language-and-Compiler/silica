// A module name may appear once across a file's `use` declarations: a second `use alpha;` is E4009 DuplicateUse (spec 19.3.1).
use alpha;
use alpha;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
