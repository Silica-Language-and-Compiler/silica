// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// effectful sequence used as a statement before the return value 62
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io, mem(normal)]
                print_string("gamma");
                println("")
            produces pure :ok end;
            62
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
