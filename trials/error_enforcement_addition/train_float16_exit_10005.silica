// expected failure E1042: function 'main' has no return type
// main returns float16; exit code is trunc(2.5) = 2
use trial_support_float16;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            2.5
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2.5
    end
}
