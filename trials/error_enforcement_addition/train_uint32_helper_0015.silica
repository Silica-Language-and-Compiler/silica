// expected failure E1055: binding 'unused_value' is never used
// helper combine/3 on uint32; combine(12, 9, 6) = 2
use trial_support_uint32;

fn combine(x: uint32, y: uint32, z: uint32) -> uint32 {
    unused_value: int64 <- 41;
    x / z + z / y
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            combine(12, 9, 6)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
