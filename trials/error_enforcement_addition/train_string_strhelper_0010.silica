// expected failure E2001: integer literal returned from a string-typed arm
// string helper wrap; prints [table]

use trial_support_atom;

fn wrap(s: string) -> string {
    concatenate("[", concatenate(s, 1))
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                print_string(wrap("table"));
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
