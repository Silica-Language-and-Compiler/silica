// expected failure E2003: print_uint8 result bound as int64 instead of atom
// chained print_uint8 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                n_out: int64 <- print_uint8(7);
                println("");
                _: atom <- print_uint8((41 + 38));
                println("");
                result: atom <- print_uint8(49)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
