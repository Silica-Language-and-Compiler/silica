// A literal argument to a uint32 parameter through a module-qualified call takes the parameter's
// type and is checked against its range like a same-module argument: 5000000000 does not fit
// uint32, so this is E2011, not a silently truncated call.
use LiteralLib;
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            LiteralLib@next_u32(5000000000)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
