// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)]
                _: atom <- print_boolean(47 % 47 > 50 % 12);
                println("");
                _: atom <- print_boolean((21 + 26) <= (50 - 0));
                println("");
                _: atom <- print_boolean(35 * 60 > (21 + 54));
                println("");
                _: atom <- print_boolean((24 + 18) <= (37 / 36));
                println("");
                result: atom <- print_boolean(15 % 46 < 37 / 52)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
