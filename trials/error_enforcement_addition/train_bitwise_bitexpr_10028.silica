// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (((bnot hi) band two) + flags) = 8
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            hi: uint64 <- true;
            two: uint64 <- 3;
            flags: uint64 <- 5;
            (((bnot hi) band two) + flags)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 8
    end
}
