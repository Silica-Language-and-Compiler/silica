// expected failure E2013: unary minus on a variable instead of negate_uint8
// uint8 bindings then expression; expect 122
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            width: uint8 <- 25 + 36;
            a: uint8 <- width + width;
            -width + a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 122
    end
}
