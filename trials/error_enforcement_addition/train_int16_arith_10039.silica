// expected failure E1042: function 'main' has no return type
// int16 arithmetic: (7 + 58) % 41 = 24
use trial_support_int16;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            (7 + 58) % 41
        });
        _: int64 <- wait_for_exit()
    produces
        pure 24
    end
}
