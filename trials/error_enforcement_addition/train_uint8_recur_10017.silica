// expected failure E2002: undefined identifier 'missing_n'
// recursive digit_count on uint8; digit_count(53) = 2
use trial_support_uint8;

fn digit_count(n: uint8) -> uint8 {
    case missing_n < 10 of {
        true -> 1;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            digit_count(53)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
