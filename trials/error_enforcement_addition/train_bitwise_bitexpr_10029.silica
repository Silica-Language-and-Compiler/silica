// expected failure E1055: binding 'scratch' is never used
// uint64 bitwise: ((mask band five) + one) = 13
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            scratch: int64 <- 41;
            mask: uint64 <- 5;
            five: uint64 <- 3;
            one: uint64 <- 12;
            ((mask band five) + one)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
