// expected failure E2018: binding 'xs1' has no type annotation
// 1 prepends after empty; head is 36
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            sequence proc[mem(normal)] xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
                xs1 <- prepend[uint32, mem(normal)](36, xs0);
                h: uint32 <- head[uint32, mem(normal)](xs1)
                produces pure h end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 36
    end
}
