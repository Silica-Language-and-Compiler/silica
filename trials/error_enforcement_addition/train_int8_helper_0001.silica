// expected failure E2003: parameter x declared int64 in a int8 helper
// helper combine/1 on int8; combine(13) = 13
use trial_support_int8;

fn combine(x: int64) -> int8 {
    x
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            combine(13)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
