// expected failure E2001: integer literal passed to starts_with
// case on starts_with; expect 0
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s: string <- "abcdef";
            suf: string <- 7;
            case starts_with(s, suf) of {
                true -> 0;
                false -> 8
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
