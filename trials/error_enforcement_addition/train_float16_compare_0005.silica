// expected failure E2005: call to unknown function 'my_print_bool'
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(4.0 >= 12.25);
                println("");
                _: atom <- print_boolean(30.0 * 3.5 == 5.5);
                println("");
                _: atom <- print_boolean(21.25 != 38.0 / 38.0);
                println("");
                done: atom <- my_print_bool((11.5 - 7.0) >= 1.5)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
