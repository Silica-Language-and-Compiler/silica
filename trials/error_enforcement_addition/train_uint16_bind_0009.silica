// expected failure E2003: binding total declared int32 but used as uint16
// uint16 bindings then expression; expect 22
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            total: int32 <- 43 % 5;
            b: uint16 <- total;
            a: uint16 <- total * b - (total + 5);
            k: uint16 <- 30;
            14 + 8 % 27 + a - a + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 22
    end
}
