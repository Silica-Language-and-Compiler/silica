// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name only if, where the
// literal is written, the name is bound to an integer literal by an integer-typed binding.
// A function literal sent as an actor message, call(w, fn() -> int64 { k + 2 } impl ActorMessage {}),
// captures the parameter k of ask.
use trial_support_int64;

fn run(msg: fn() -> int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg(), state)
}

fn ask(k: int64) -> int64 {
    sequence proc[concurrency]
        w: actor_ref <- spawn(0, run, stack_policy(0, :keep_last_message));
        v: int64 <- call(w, fn() -> int64 { k + 2 } impl ActorMessage {})
    produces
        pure v
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            ask(40)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
