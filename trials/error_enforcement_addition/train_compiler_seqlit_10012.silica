// expected failure E1055: binding 'scratch' is never used
// sequence binding RHS literal then produces with no semicolon; want 112
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            scratch: int64 <- 41;
            sequence
                result: int64 <- 112
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
