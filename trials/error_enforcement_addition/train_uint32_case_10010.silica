// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint32 value 32; expect 82
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            v: uint32 <- 32;
            case v of {
                :one -> 111;
                6 -> 77;
                18 -> 68;
                1 -> 105;
                n: uint32 if n > 16 -> 82;
                _: uint32 -> 47
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 82
    end
}
