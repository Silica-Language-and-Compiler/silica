// expected failure E2018: binding 'done' has no type annotation
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(13.375 <= (2.25 + 17.0));
                println("");
                _: atom <- print_boolean((40.25 - 30.25) != (6.375 - 23.5));
                println("");
                done <- print_boolean(40.5 < 4.5)
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
