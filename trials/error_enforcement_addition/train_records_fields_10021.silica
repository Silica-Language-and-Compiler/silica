// expected failure E2005: access to a field the record does not have
// inline record field access; x - y = 25
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            p: { x: int64, y: int64 } <- { x: 40, y: 15 };
            xv: int64 <- p.x;
            yv: int64 <- p.z;
            xv - yv
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
