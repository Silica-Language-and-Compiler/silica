// Spec §15.4.13.4 "Handler before any start" (E2236): registration must come first in main's order of
// execution. This main spawns its reporter and registers it, but only after it has started the root
// supervisor; the error is reported at the supervisor's spawn.

use Supervisor;

impl E2236LateReporterSup for Supervisor;

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 1 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :e2236_worker, agent_type: :worker, initial_state: initial_state, behavior: work, restart: :transient, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: supervisor_ref <- spawn_registered_supervisor(E2236LateReporterSup, 0, :e2236_sup, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
