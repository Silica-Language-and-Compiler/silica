// expected failure E2216: an unqualified poke prim outside a device_* module (device spec §4.7)
use trial_support_int64;

fn probe() -> int64 {
    sequence proc[device_io]
        println("mapping");
        w: int64 <- map_device(1, 2)
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            probe()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
