// expected failure E1055: binding 'temp_val' is never used
// helper blend/3 on uint64; blend(11, 19, 6) = 234
use trial_support_uint64;

fn blend(x: uint64, y: uint64, z: uint64) -> uint64 {
    temp_val: int64 <- 41;
    (y * x) + (19 + z)
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            blend(11, 19, 6)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 234
    end
}
