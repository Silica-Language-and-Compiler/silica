// expected failure E1041: trailing ';' after the block's final expression
// main returns float64; exit code is trunc(8.75) = 8
use trial_support_float64;

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            8.75;
        });
        _: int64 <- wait_for_exit()
    produces
        pure 8.75
    end
}
