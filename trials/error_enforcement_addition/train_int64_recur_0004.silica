// expected failure E2005: boolean case missing its false branch
// recursive sum_to on int64; sum_to(10) = 55
use trial_support_int64;

fn sum_to(n: int64) -> int64 {
    case n == 0 of {
        true -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sum_to(10)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
