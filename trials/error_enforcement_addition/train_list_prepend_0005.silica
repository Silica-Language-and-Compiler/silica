// expected failure E2018: binding 'xs3' has no type annotation
// 4 prepends after empty; length is 4
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
                xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](7, xs0);
                xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](26, xs1);
                xs3 <- prepend[uint32, mem(normal)](31, xs2);
                xs4: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](0, xs3);
                n: int64 <- length[uint32, mem(normal)](xs4)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
