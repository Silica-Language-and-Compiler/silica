// expected failure E2239 on ESP32-S3_raw: a valid description of (:esp32s3_uart), a board-pack device tag,
// in a programmer's device_* module. On the ESP32-S3 the board pack's device_esp32s3_uart_registers is the
// only description of that tag (device spec §4.9 rule 5). Hosted targets have no board pack: they accept it.
use DeviceDescription;
use trial_support_int64;

impl fn registers(device: (:esp32s3_uart)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :fifo,   offset: 0x00, width: 32, access: :read_write },
        { name: :status, offset: 0x1C, width: 32, access: :read_only }
    ]
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
