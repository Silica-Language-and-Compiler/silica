// expected failure E2003: binding width declared int32 but used as uint32
// uint32 bindings then expression; expect 24
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            width: int32 <- 32;
            a: uint32 <- 3 + width - width / width;
            step: uint32 <- 50;
            k: uint32 <- 53 % 37 + (width - width);
            24 + a - a + step - step + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 24
    end
}
