// expected failure E2005: spawn called without a behavior function
// Spec §16.1.1: call(actor_ref, message) -> Reply; behavior returns (:reply, reply, new_state)
use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(20);
                r0: int64 <- call(w, 14 impl ActorMessage {});
                print_int64(r0);
                println("");
                r1: int64 <- call(w, 20 impl ActorMessage {});
                print_int64(r1);
                println("");
                r2: int64 <- call(w, 15 impl ActorMessage {});
                print_int64(r2);
                println("");
                r3: int64 <- call(w, 12 impl ActorMessage {});
                print_int64(r3);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
