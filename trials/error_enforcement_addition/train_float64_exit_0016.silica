// expected failure E1055: binding 'unused_value' is never used
// main returns float64; exit code is trunc(27.75) = 27
use trial_support_float64;

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            unused_value: int64 <- 41;
            27.75
        });
        _: int64 <- wait_for_exit()
    produces
        pure 27.75
    end
}
