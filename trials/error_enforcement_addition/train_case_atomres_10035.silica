// expected failure E2005: string pattern against an atom scrutinee
// case producing atoms then case dispatching on them; grade(0) -> 0
use trial_support_int64;

fn grade(n: int64) -> atom {
    case n of {
        0 -> :zero;
        k: int64 if k < 6 -> :low;
        _: int64 -> :high
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            g: atom <- grade(0);
            case g of {
                :zero -> 0;
                "low" -> 1;
                :high -> 2;
                _: atom -> 9
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
