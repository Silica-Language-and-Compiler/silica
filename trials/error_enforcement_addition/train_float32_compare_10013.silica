// expected failure E2005: call to unknown function 'print_boolx'
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(1.25 * 23.5 >= 30.0 * 38.0);
                println("");
                _: atom <- print_boolean(31.0 > 3.25);
                println("");
                _: atom <- print_boolean((38.25 - 21.75) <= 25.0);
                println("");
                done: atom <- print_boolx((38.0 - 32.0) != (27.5 + 0.25))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
