// expected failure E2003: list operation instantiated with the wrong element type
// head on [26, 20, 22, 13] gives 26
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [26, 20, 22, 13];
                first: int64 <- head[string, mem(normal)](xs)
            produces pure first end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
