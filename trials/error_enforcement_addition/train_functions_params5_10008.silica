// expected failure E1060: unbalanced braces
// function with 5 parameter(s); sum5(10, 3, 25, 3, 6) = 47
use trial_support_int64;

fn sum5(a: int64, b: int64, c: int64, d: int64, e: int64) -> int64 {
    a + b + c + d + e
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sum5(10, 3, 25, 3, 6)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}}
