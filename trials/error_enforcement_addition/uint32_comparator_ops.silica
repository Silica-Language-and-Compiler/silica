// Exercise comparison operators for uint32: <, ==, >, !=, >=, <=
// For each operator: one example where result is true, one where result is false.
// Output format per comparison: op_code, left, right, result
// op_code: 1=<, 2==, 3>, 4!=, 5>=, 6<=

use trial_support_atom;

fn main() -> atom proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            // < : true (5 < 10), false (10 < 5)
            _: atom <- print_uint32(1);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(10);
            _: atom <- print_boolean(5 < 10);
            _: atom <- print_uint32(1);
            _: atom <- print_uint32(10);
            _: atom <- print_uint32(5);
            _: atom <- print_boolean(10 < 5);

            // == : true (7 == 7), false (7 == 3)
            _: atom <- print_uint32(2);
            _: atom <- print_uint32(7);
            _: atom <- print_uint32(7);
            _: atom <- print_boolean(7 == 7);
            _: atom <- print_uint32(2);
            _: atom <- print_uint32(7);
            _: atom <- print_uint32(3);
            _: atom <- print_boolean(7 == 3);

            // > : true (10 > 5), false (5 > 10)
            _: atom <- print_uint32(3);
            _: atom <- print_uint32(10);
            _: atom <- print_uint32(5);
            _: atom <- print_boolean(10 > 5);
            _: atom <- print_uint32(3);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(10);
            _: atom <- print_boolean(5 > 10);

            // != : true (5 != 10), false (5 != 5)
            _: atom <- print_uint32(4);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(10);
            _: atom <- print_boolean(5 != 10);
            _: atom <- print_uint32(4);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(5);
            _: atom <- print_boolean(5 != 5);

            // >= : true (10 >= 5), true (5 >= 5), false (5 >= 10)
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(10);
            _: atom <- print_uint32(5);
            _: atom <- print_boolean(10 >= 5);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(5);
            _: atom <- print_boolean(5 >= 5);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(10);
            _: atom <- print_boolean(5 >= 10);

            // <= : true (5 <= 10), true (5 <= 5), false (10 <= 5)
            _: atom <- print_uint32(6);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(10);
            _: atom <- print_boolean(5 <= 10);
            _: atom <- print_uint32(6);
            _: atom <- print_uint32(5);
            _: atom <- print_uint32(5);
            _: atom <- print_boolean(5 <= 5);
            _: atom <- print_uint32(6);
            _: atom <- print_uint32(10);
            _: atom <- print_uint32(5);
            print_boolean(10 <= 5)
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
