// E2415: one region is claimed by one declaration (transport design §6.8.1): two stores on the same
// backing are refused, as two carriers on one serial port are.
carried_on first: (:store) (:backing, "/tmp/silica_trial_conflict.sildat", 8192, :stop);
carried_on second: (:store) (:backing, "/tmp/silica_trial_conflict.sildat", 8192, :ring);

fn main() -> int64 {
    0
}
