// expected failure E1049: sequence block without produces
// negate_float64 applied 1 time(s); prints -17.125
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float64(negate_float64(17.125))
            pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
