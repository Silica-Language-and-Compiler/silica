// expected failure E2001: string literal passed where an integer parameter is expected
// helper adjust/2 on uint64; adjust(5, 10) = 67
use trial_support_uint64;

fn adjust(x: uint64, y: uint64) -> uint64 {
    y + 57 + (20 % x)
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            adjust("5", 10)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 67
    end
}
