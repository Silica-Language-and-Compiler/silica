// expected failure E2005: integer pattern against a string scrutinee
// case on string literals; "region" gives 23
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "region";
            case mode of {
                3 -> 2;
                "region" -> 23;
                "hello" -> 16;
                _: string -> 61
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
