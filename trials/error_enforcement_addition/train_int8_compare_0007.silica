// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == (12 + 41) >= 54 / 38);
                println("");
                _: atom <- print_boolean((45 - 43) != 48);
                println("");
                _: atom <- print_boolean((10 + 51) >= (8 + 43));
                println("");
                result: atom <- print_boolean(56 >= (1 + 3))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
