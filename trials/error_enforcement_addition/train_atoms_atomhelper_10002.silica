// expected failure E1065: parameter list of 'status' is not closed
// helper returning :ok for positive input
use trial_support_atom;

fn status(n: int64 -> atom {
    case n > 0 of {
        true -> :ok;
        false -> :warm
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            status(7)
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
