// expected failure E1042: function 'main' has no return type
// print each field of a mixed record
use trial_support_atom;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                person: { name: string, age: int64, active: boolean } <- { name: "cherry", age: 30, active: true };
                print_string(person.name);
                println("");
                print_int64(person.age);
                println("");
                print_boolean(person.active);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
