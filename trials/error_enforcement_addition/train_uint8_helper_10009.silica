// expected failure E1041: trailing ';' after the block's final expression
// helper scale/1 on uint8; scale(16) = 3
use trial_support_uint8;

fn scale(x: uint8) -> uint8 {
    54 / x % 52;
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            scale(16)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
