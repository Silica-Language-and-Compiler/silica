// expected failure E2001: integer literal passed to contains
// case on contains; expect 57
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s: string <- "silica compiler";
            suf: string <- 7;
            case contains(s, suf) of {
                true -> 57;
                false -> 83
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
