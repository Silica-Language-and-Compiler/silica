// expected failure E2013: unary minus on a variable instead of negate_uint16
// uint16 bindings then expression; expect 58
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            total: uint16 <- 19;
            height: uint16 <- 42;
            m: uint16 <- total;
            -total + 58 + height - height + m - m
        });
        _: int64 <- wait_for_exit()
    produces
        pure 58
    end
}
