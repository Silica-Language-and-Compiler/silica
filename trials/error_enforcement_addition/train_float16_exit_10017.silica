// expected failure E1047: named struct declaration 'Node' is not allowed
// main returns float16; exit code is trunc(13.0 + 17.0 + 3.0 * 1.5) = 34
use trial_support_float16;

struct Node { x: int64, y: int64 }

fn main() -> float16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            13.0 + 17.0 + 3.0 * 1.5
        });
        _: int64 <- wait_for_exit()
    produces
        pure 34.5
    end
}
