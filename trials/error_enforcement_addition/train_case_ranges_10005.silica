// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 98 gives 97
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 98;
            case n of {
                n: int64 if n -> 0;
                n: int64 if n >= 45 and n < 108 -> n - 1;
                n: int64 if n >= 108 -> n + 100
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
