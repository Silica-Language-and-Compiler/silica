// expected failure E2018: binding 'result' has no type annotation
// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(27 % 49 != 36);
                println("");
                _: atom <- print_boolean((9 + 10) == (32 + 43));
                println("");
                _: atom <- print_boolean(52 % 9 > 14 * 51);
                println("");
                _: atom <- print_boolean((29 + 25) < (38 + 5));
                println("");
                result <- print_boolean(28 * 30 > (37 + 39))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
