// Chunk 15 phase 6 stage 6b (E2301 UseAfterMove): under `strict region_check;` a name given to move(...)
// in a send may not be used afterwards. forward moves v into the cast, then reads it on the next line.
strict region_check;

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn forward(p: actor_ref, v: int64) -> int64 {
    sequence proc[concurrency, device_io]
        _: boolean <- cast(p, move(v) impl ActorMessage {});
        _: int8 <- print_int64(v)
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rr);
        q: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: int64 <- forward(q, 7);
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
