// expected failure E2018: binding 'label' has no type annotation
// case expression as a binding's right-hand side; expect 30
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- 29;
            label <- case x % 3 of {
                0 -> 18;
                1 -> 3;
                _: int64 -> x
            };
            label + 1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
