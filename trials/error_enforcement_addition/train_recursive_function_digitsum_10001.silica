// expected failure E1055: binding 'unused_value' is never used
// digit_sum(2984) = 23
use trial_support_int64;

fn digit_sum(n: int64) -> int64 {
    unused_value: int64 <- 41;
    case n < 10 of {
        true -> n;
        false -> n % 10 + digit_sum(n / 10)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            digit_sum(2984)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
