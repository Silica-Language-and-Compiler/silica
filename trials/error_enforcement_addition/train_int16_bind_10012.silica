// expected failure E2013: unary minus on a variable instead of negate_int16
// int16 bindings then expression; expect 26
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            a: int16 <- 21;
            d: int16 <- 47 + 37;
            -a + 26 + a - a + d - d
        });
        _: int64 <- wait_for_exit()
    produces
        pure 26
    end
}
