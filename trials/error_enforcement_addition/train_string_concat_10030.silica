// expected failure E2003: string binding used where an integer is expected
// concat of 3 pieces prints southstoneregion

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: string <- "south";
                b: string <- "stone";
                s: string <- concat(a, b);
                s0: string <- concat(s, "region");
                print_int64(s0);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
