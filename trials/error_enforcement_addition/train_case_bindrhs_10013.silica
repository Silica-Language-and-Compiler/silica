// expected failure E1047: named struct declaration 'Point' is not allowed
// case expression as a binding's right-hand side; expect 18
use trial_support_int64;

struct Point { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- 12;
            label: int64 <- case x % 3 of {
                0 -> 17;
                1 -> 2;
                _: int64 -> x
            };
            label + 1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
