// expected failure E1065: parameter list of 'ack' is not closed
// Ackermann A(2, 2) = 7
use trial_support_int64;

fn ack_nonzero(m: int64, n: int64) -> int64 {
    case n == 0 of {
        true -> ack(m - 1, 1);
        false -> ack(m - 1, ack(m, n - 1))
    }
}

fn ack(m: int64, n: int64 -> int64 {
    case m == 0 of {
        true -> n + 1;
        false -> ack_nonzero(m, n)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            ack(2, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
