// expected failure E1043: whitespace between binding name 'suf' and ':'
// case on ends_with; expect 60
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s: string <- "silica compiler";
            suf :string <- "r";
            case ends_with(s, suf) of {
                true -> 60;
                false -> 92
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
