// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: ((bnot mask) band one) band lo = 8
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            mask: uint64 <- true;
            one: uint64 <- 10;
            lo: uint64 <- 14;
            ((bnot mask) band one) band lo
        });
        _: int64 <- wait_for_exit()
    produces
        pure 8
    end
}
