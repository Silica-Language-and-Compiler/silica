// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint8; v = 9 gives 25
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            v: uint8 <- 9;
            case v of {
                :10 -> 39;
                4 -> 43;
                1 -> 27;
                m: uint8 if m > 13 -> 38;
                _: uint8 -> 25
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 25
    end
}
