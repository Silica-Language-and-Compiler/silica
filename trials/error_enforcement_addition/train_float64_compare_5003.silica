// expected failure E1040: missing ';' between two statements
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((28.75 - 12.75) == 30.5 * 7.125);
                println("");
                _: atom <- print_boolean((8.5 + 22.25) <= 5.0);
                println("");
                _: atom <- print_boolean(37.5 * 29.5 != 4.75);
                println("")
                done: atom <- print_boolean((8.375 - 36.125) > 4.5)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
