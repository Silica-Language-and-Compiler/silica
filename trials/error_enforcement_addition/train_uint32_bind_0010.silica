// expected failure E2013: unary minus on a variable instead of negate_uint32
// uint32 bindings then expression; expect 5
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            d: uint32 <- 22;
            a: uint32 <- 53;
            b: uint32 <- 46;
            c: uint32 <- 54;
            -d + 15 % 40 / 3 + d - d + a - a + b - b + c - c
        });
        _: int64 <- wait_for_exit()
    produces
        pure 5
    end
}
