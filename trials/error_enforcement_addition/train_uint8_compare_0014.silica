// expected failure E1055: binding 'spare' is never used
// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            spare: int64 <- 41;
            sequence proc[device_io] _: atom <- print_boolean(50 >= 1 * 2);
                println("");
                _: atom <- print_boolean((52 + 48) == 57);
                println("");
                result: atom <- print_boolean((42 + 40) > 4 % 28)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
