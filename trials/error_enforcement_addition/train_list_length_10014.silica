// expected failure E2001: string element inside an integer list literal
// list literal of 6 int64 elements; length is 6
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal_writethrough)]
                xs: List[int64, mem(normal_writethrough)] <- ["6", 2, 18, 33, 29, 39];
                n: int64 <- length[int64, mem(normal_writethrough)](xs)
            produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
