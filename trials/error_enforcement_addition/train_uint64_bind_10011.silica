// expected failure E2018: binding 'height' has no type annotation
// uint64 bindings then expression; expect 31
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            d: uint64 <- 50 + 10;
            height <- (d % 32);
            k: uint64 <- height;
            k / k + 30
        });
        _: int64 <- wait_for_exit()
    produces
        pure 31
    end
}
