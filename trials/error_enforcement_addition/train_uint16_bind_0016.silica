// expected failure E1042: function 'main' has no return type
// uint16 bindings then expression; expect 12
use trial_support_uint16;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            height: uint16 <- 56;
            b: uint16 <- 20;
            k: uint16 <- 34 % 44;
            total: uint16 <- k;
            12 + height - height + b - b + total - total
        });
        _: int64 <- wait_for_exit()
    produces
        pure 12
    end
}
