// expected failure E2013: unary minus on a variable instead of negate_int8
// int8 bindings then expression; expect 51
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            width: int8 <- (59 + 7) / (54 + 47);
            k: int8 <- 55 + width - 22 / 36;
            -width + 51 + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 51
    end
}
