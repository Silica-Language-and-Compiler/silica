// expected failure E3001: print_int64 outside any sequence
// Positive: device_io use belongs in sequence proc[device_io] (spec §9.3.1)
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            print_int64(63)
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
