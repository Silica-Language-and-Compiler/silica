// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (two band five) bor mask = 12
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            two: uint64 <- true;
            five: uint64 <- 12;
            mask: uint64 <- 12;
            (two band five) bor mask
        });
        _: int64 <- wait_for_exit()
    produces
        pure 12
    end
}
