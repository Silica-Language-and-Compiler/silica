use trial_support_int64;

module dangerous_retained_buf_fallback_behaviour_rejected;

// E4037 RetainedBufferFallbackBehaviour (chunk 15 phase 7, the pin rule): a behaviour that allocates a
// buffer C keeps must have a proven state release, because the fallback whole-state copy (design
// section 4.4) moves every node, including the retained buffer. This behaviour's state is a List that
// the dispatch replaces wholesale with a fresh empty list, which the release analysis cannot prove
// (the case W2300 reports for any other behaviour), so the pin rule makes it an error.

wrapper_meta "dangerous_exposure_source/good_retains_data_ptr.meta";

foreign c_wrapper "silica_retain_keep"
fn keep_raw(data_ptr: uint8, data_len: uint64) -> int64;

fn ffi_worker(msg: int64, state: List[int64, mem(normal)]) -> (:no_reply, List[int64, mem(normal)]) {
    sequence proc[external_danger, mem(normal)]
        L1: lifetime <- fresh_lifetime();
        bf: buf(L1, normal, uint8, 4) <- alloc_buf_retained(4);
        _: atom <- write_buf(bf, 0, 1);
        _: int64 <- keep_raw(bf);
        fresh: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure (:no_reply, fresh)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, mem(normal)]
                initial: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                worker_ref: dangerous_actor_ref <- spawn_dangerous(initial, ffi_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(worker_ref, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
