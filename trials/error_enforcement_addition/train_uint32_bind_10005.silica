// expected failure E1043: whitespace between binding name 'm' and ':'
// uint32 bindings then expression; expect 13
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            m :uint32 <- 36;
            b: uint32 <- 44;
            a: uint32 <- 27;
            13 + m - m + b - b + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
