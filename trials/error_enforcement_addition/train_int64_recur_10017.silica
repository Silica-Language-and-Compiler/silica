// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on int64; digit_count(21) = 2
use trial_support_int64;

fn digit_count(n: int64) -> int64 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            digit_count(21)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
