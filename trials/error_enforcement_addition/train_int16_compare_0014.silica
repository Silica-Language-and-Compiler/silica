// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == (46 - 5) == 8 % 50);
                println("");
                _: atom <- print_boolean((18 % 28) != 42 % 44);
                println("");
                _: atom <- print_boolean(12 > 1);
                println("");
                _: atom <- print_boolean((8 + 47) <= (28 + 59));
                println("");
                result: atom <- print_boolean(35 != (10 % 4))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
