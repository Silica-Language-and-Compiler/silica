// expected failure E2001: integer literal bound to a boolean
// true or false printed
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] b: boolean <- 1;
                a: boolean <- false;
                result: boolean <- b or a;
                outcome: atom <- print_boolean(result)
                produces pure outcome end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
