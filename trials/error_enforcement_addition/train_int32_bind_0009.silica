// expected failure E2003: binding base declared uint8 but used as int32
// int32 bindings then expression; expect 91
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            base: uint8 <- 35;
            m: int32 <- base;
            width: int32 <- 22 * 18;
            (56 + base) % (width * width) + m - m
        });
        _: int64 <- wait_for_exit()
    produces
        pure 91
    end
}
