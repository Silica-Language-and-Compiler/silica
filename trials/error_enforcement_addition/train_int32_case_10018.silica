// expected failure E2005: string literal pattern against an integer scrutinee
// case on int32 value 37; expect 47
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 37;
            case v of {
                :one -> 174;
                41 -> 111;
                5 -> 171;
                0 -> 42;
                n: int32 if n > 27 -> 47;
                _: int32 -> 136
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 47
    end
}
