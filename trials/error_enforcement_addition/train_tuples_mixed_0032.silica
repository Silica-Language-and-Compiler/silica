// expected failure E2005: decomposition pattern element types in the wrong order
// decompose a mixed tuple and print each element
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                t: (int64, string, boolean) <- (91, "north", true);
                (k: string, name: int64, flag: boolean) <- t;
                print_int64(k);
                println("");
                print_string(name);
                println("");
                print_boolean(flag);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
