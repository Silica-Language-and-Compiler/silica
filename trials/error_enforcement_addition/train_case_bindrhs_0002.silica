// expected failure E2002: undefined identifier 'missing_x'
// case expression as a binding's right-hand side; expect 15
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- 14;
            label: int64 <- case x % 3 of {
                0 -> 15;
                1 -> 16;
                _: int64 -> missing_x
            };
            label + 1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
