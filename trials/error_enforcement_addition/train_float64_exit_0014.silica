// expected failure E1042: function 'main' has no return type
// main returns float64; exit code is trunc(28.25) = 28
use trial_support_float64;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            28.25
        });
        _: int64 <- wait_for_exit()
    produces
        pure 28.25
    end
}
