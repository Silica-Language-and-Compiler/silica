// expected failure E2005: call to unknown function 'my_apply'
// named function passed as a value; apply(twice, 24) = 48
use trial_support_int64;

fn twice(x: int64) -> int64 {
    x * 2
}

fn succ(x: int64) -> int64 {
    x + 1
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            my_apply(twice, 24)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
