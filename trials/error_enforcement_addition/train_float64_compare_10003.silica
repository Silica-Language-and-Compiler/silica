// expected failure E1043: whitespace between binding name 'done' and ':'
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((25.0 - 39.25) == 25.0);
                println("");
                _: atom <- print_boolean(16.25 <= (13.375 - 26.0));
                println("");
                _: atom <- print_boolean(39.25 * 7.0 <= 20.0);
                println("");
                done :atom <- print_boolean((28.0 + 11.0) != (29.5 - 17.25))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
