// expected failure E1047: named struct declaration 'Node' is not allowed
// digit_sum(9536) = 23
use trial_support_int64;

struct Node { x: int64, y: int64 }

fn digit_sum(n: int64) -> int64 {
    case n < 10 of {
        true -> n;
        false -> n % 10 + digit_sum(n / 10)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            digit_sum(9536)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
