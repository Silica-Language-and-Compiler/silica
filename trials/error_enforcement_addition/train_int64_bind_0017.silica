// expected failure E2003: binding base declared uint16 but used as int64
// int64 bindings then expression; expect 20
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            base: uint16 <- 8;
            b: int64 <- 36 / base;
            base + 49 / b
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
