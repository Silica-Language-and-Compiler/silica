// expected failure E2005: call to unknown function 'my_print_uint64'
// print_uint64 two; prints 13 then 2
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: uint64 <- 13;
                b: uint64 <- 44 / 16;
                _: atom <- print_uint64(a);
                println("");
                result: atom <- my_print_uint64(b)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
