// Spec §16.1.2 (2026-10-13): the compile-time cast check tracks actor references through list
// elements, so a cast through a list element to a call-only actor (its behaviour returns
// (:reply, ...)) is rejected with E2237.
// Moved from actors_addition/cast_through_list_element_reply_actor_keeps_state (2026-10-13), which
// expected this cast to compile and run. Its run-time intent (what a cast that reaches a call-only
// actor at run time does) is to be re-covered by a run-time :language_error trial.

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state * 100, state + 1)
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        l: List[actor_ref, mem(normal)] <- [p];
        _: boolean <- cast(l.head, "a" impl ActorMessage {});
        _: boolean <- cast(l.head, "b" impl ActorMessage {});
        v: int64 <- call(p, "c" impl ActorMessage {});
        _: atom <- print_int64(v);
        _: atom <- println("");
        _: boolean <- cast_exit(0);
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
