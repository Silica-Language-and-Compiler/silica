// expected failure E1041: trailing ';' after the pure expression
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(7.0 > (12.0 + 31.25));
                println("");
                done: atom <- print_boolean(10.0 * 20.125 <= 32.5)
            produces
                pure done;
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
