// expected failure E2003: binding k declared int64 but used as uint32
// uint32 bindings then expression; expect 26
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            k: int64 <- 9;
            d: uint32 <- k * k;
            d % d + (38 - 12)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 26
    end
}
