// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name only if, where the
// literal is written, the name is bound to an integer literal by an integer-typed binding.
// The literal captures n, bound to the float64 literal 2.5: a literal, but not an integer one.

fn take2(op: fn(a: float64, b: float64) -> float64) -> float64 {
    op(1.0, 2.0)
}

fn plus_n() -> float64 {
    n: float64 <- 2.5;
    take2(fn(x: float64, y: float64) -> float64 { x + y + n })
}

fn main() -> int64 {
    case plus_n() > 5.0 of {
        true -> 0;
        false -> 1
    }
}
