// expected failure E2003: print_int16 result bound as int64 instead of atom
// chained print_int16 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                n_out: int64 <- print_int16(47 + 13);
                println("");
                result: atom <- print_int16(15)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
