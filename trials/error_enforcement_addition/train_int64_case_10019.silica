// expected failure E1055: binding 'unused_value' is never used
// case on int64 value 4; expect 83
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            unused_value: int64 <- 41;
            v: int64 <- 4;
            case v of {
                26 -> 51;
                11 -> 112;
                19 -> 155;
                35 -> 51;
                n: int64 if n > 17 -> 148;
                _: int64 -> 83
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
