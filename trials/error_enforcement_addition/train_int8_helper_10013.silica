// expected failure E1045: function 'main' declared without the fn keyword
// helper compute/3 on int8; compute(12, 6, 16) = 6
use trial_support_int8;

fn compute(x: int8, y: int8, z: int8) -> int8 {
    y + x / z
}

main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            compute(12, 6, 16)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 6
    end
}
