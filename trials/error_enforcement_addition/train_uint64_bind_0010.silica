// expected failure E2003: binding base declared uint16 but used as uint64
// uint64 bindings then expression; expect 39
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            base: uint16 <- 39;
            m: uint64 <- 2 + base;
            d: uint64 <- m % base / (base * m);
            c: uint64 <- base / m;
            m + base - m + d - d + c - c
        });
        _: int64 <- wait_for_exit()
    produces
        pure 39
    end
}
