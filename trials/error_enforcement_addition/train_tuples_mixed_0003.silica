// expected failure E1047: named struct declaration 'Point' is not allowed
// decompose a mixed tuple and print each element
use trial_support_atom;

struct Point { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] t: (boolean, int64, string) <- (true, 45, "hello");
                (flag: boolean, k: int64, name: string) <- t;
                print_boolean(flag);
                println("");
                print_int64(k);
                println("");
                print_string(name);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
