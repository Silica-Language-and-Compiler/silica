// defect A2 (stays red until closure environments exist; E1067 rejects it today): a returned closure passed on to a higher-order function; apply(add_k, 5) = 15
use trial_support_int64;

fn make_adder(k: int64) -> fn(int64) -> int64 {
    fn(x: int64) -> int64 { x + k }
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add_k: fn(int64) -> int64 <- make_adder(10);
            apply(add_k, 5)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
