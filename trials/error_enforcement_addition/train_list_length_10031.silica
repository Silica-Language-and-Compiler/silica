// expected failure E1060: unbalanced braces
// list literal of 3 uint8 elements; length is 3
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal_writethrough)]
                xs: List[uint8, mem(normal_writethrough)] <- [39, 2, 40];
                n: int64 <- length[uint8, mem(normal_writethrough)](xs)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}}
