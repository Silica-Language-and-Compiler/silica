// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 61 gives 161
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 61;
            case n of {
                n: int64 if n < 45 -> "n * 2";
                n: int64 if n >= 45 and n < 56 -> n - 1;
                n: int64 if n >= 56 -> n + 100
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
