// E2401: a record with a function field cannot cross a link (design §4.2); reported at the encode call.
fn dbl(x: int64) -> int64 {
    x * 2
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        v: { f: fn(int64) -> int64, n: int64 } <- { f: dbl, n: 1 };
        frame: string <- encode((:etf), v);
        _: atom <- print_int64(length_bytes(frame))
    produces
        pure 0
    end
}
