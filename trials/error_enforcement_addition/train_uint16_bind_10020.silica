// expected failure E2013: unary minus on a variable instead of negate_uint16
// uint16 bindings then expression; expect 150
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            total: uint16 <- 39;
            b: uint16 <- (total + 20 + total * total);
            c: uint16 <- 53;
            -total + (total + 58 + c) + b - b
        });
        _: int64 <- wait_for_exit()
    produces
        pure 150
    end
}
