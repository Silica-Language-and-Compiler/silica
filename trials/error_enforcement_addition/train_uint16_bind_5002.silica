// expected failure E2003: binding d declared uint32 but used as uint16
// uint16 bindings then expression; expect 40
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            d: uint32 <- 19;
            c: uint16 <- (d * d % (d + d));
            b: uint16 <- d / d;
            40 % (34 + 22) + c - c + b - b
        });
        _: int64 <- wait_for_exit()
    produces
        pure 40
    end
}
