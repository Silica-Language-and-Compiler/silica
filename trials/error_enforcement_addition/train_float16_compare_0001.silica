// expected failure E2005: call to unknown function 'print_bool_all'
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(10.0 > 19.0 * 16.5);
                println("");
                _: atom <- print_boolean(28.0 != (13.5 + 26.5));
                println("");
                _: atom <- print_bool_all((7.0 - 21.75) <= 24.0);
                println("");
                done: atom <- print_boolean(28.0 * 33.75 < 39.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
