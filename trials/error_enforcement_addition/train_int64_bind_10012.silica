// expected failure E2003: binding m declared uint16 but used as int64
// int64 bindings then expression; expect 65
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            m: uint16 <- 49 + 16;
            height: int64 <- 32;
            m + height - height
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
