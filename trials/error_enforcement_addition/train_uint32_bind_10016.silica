// expected failure E2003: binding total declared int64 but used as uint32
// uint32 bindings then expression; expect 22
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            total: int64 <- (31 / (16 + 12));
            step: uint32 <- 23 / total + 51;
            k: uint32 <- (total % step);
            base: uint32 <- step + total;
            22 % (53 + total) + k - k + base - base
        });
        _: int64 <- wait_for_exit()
    produces
        pure 22
    end
}
