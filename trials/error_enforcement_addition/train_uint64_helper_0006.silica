// expected failure E2003: parameter x declared int64 in a uint64 helper
// helper adjust/2 on uint64; adjust(10, 4) = 14
use trial_support_uint64;

fn adjust(x: int64, y: uint64) -> uint64 {
    4 + x - y / 12
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            adjust(10, 4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 14
    end
}
