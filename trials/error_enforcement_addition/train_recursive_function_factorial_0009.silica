// expected failure E2005: boolean case without its false arm
// tail-recursive factorial; factorial_acc(5, 1) = 120
use trial_support_int64;

fn factorial_acc(n: int64, acc: int64) -> int64 {
    case n <= 1 of {
        true -> acc
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            factorial_acc(5, 1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
