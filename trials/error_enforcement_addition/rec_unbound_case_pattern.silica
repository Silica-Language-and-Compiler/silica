// Q19 (data_structure_redesign_requirements.md §2 row Q19 and decision 38; chunk15_stack_memory_design.md §5.1,
// §11.1 phase 0): `rec` binds to its innermost enclosing TUPLE type, so a `rec` with no enclosing tuple type
// names no layout and is rejected with E2010 in every position (spec §4.2.2, recursive_tuple_specification.md §2).
// Here: a case-arm pattern annotation `_: ref?(L, normal, rec)` (a pattern is not a tuple type).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                cell: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (1, :none));
                node: (int64, ref?(L, normal, rec)) <- read_ref(cell);
                (_: int64, nxt: ref?(L, normal, (int64, ref?(L, normal, rec)))) <- node;
                n: int64 <- case nxt of { :none -> 0; _: ref?(L, normal, rec) -> 1 }
            produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
