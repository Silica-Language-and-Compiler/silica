// expected failure E2018: binding 'height' has no type annotation
// int16 bindings then expression; expect 36
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            height <- 7;
            m: int16 <- 36;
            c: int16 <- 20;
            step: int16 <- (m + m) * 33;
            m + height - height + c - c + step - step
        });
        _: int64 <- wait_for_exit()
    produces
        pure 36
    end
}
