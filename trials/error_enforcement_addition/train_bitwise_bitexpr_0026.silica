// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (hi bor seven) band three = 10
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            hi: uint64 <- true;
            seven: uint64 <- 3;
            three: uint64 <- 10;
            (hi bor seven) band three
        });
        _: int64 <- wait_for_exit()
    produces
        pure 10
    end
}
