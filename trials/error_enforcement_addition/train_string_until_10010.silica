// expected failure E2001: string literal used where a char terminator is expected
// substring_until_char from 6 up to ' '
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                s: string <- substring_until_char("hello omega cherry", 6, " ");
                print_string(s);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
