// expected failure E1060: unbalanced braces
// print_int16 two; prints 56 then 41
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: int16 <- 29 + 27;
                b: int16 <- 18 + 23;
                _: atom <- print_int16(a);
                println("");
                result: atom <- print_int16(b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}}
