// expected failure E3010: concurrency declared but unused
// Positive: device_io use belongs in sequence proc[device_io] (spec §9.3.1)
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io, concurrency]
                result: atom <- print_int64(84)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
