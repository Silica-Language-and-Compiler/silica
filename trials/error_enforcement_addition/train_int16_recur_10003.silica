// expected failure E2005: boolean case missing its false branch
// recursive tri_acc on int16; tri_acc(20, 0) = 210
use trial_support_int16;

fn tri_acc(n: int16, acc: int16) -> int16 {
    case n == 0 of {
        true -> acc
    }
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            tri_acc(20, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 210
    end
}
