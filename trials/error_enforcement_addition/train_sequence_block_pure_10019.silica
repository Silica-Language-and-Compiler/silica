// expected failure E1047: named struct declaration 'Config' is not allowed
// pure sequence block (two); expect 15
use trial_support_int64;

struct Config { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                a: int64 <- 3;
                b: int64 <- 12;
                total: int64 <- a + b
            produces pure total end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
