// expected failure E1047: named struct declaration 'Config' is not allowed
// helper mix/2 on int32; mix(6, 8) = 0
use trial_support_int32;

struct Config { x: int64, y: int64 }

fn mix(x: int32, y: int32) -> int32 {
    x / 49 % (x + y)
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            mix(6, 8)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
