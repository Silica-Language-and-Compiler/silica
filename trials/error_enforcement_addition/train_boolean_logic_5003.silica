// expected failure E1047: named struct declaration 'Point' is not allowed
// false or false printed
use trial_support_atom;

struct Point { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: boolean <- false or false;
                outcome: atom <- print_boolean(result)
            produces pure outcome end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
