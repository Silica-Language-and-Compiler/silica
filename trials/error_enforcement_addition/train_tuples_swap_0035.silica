// expected failure E1055: binding 'leftover' is never used
// swap((47, 39)); first = 39
use trial_support_int64;

fn swap(p: (int64, int64)) -> (int64, int64) {
    leftover: int64 <- 41;
    (x: int64, y: int64) <- p;
    (y, x)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (first: int64, second: int64) <- swap((47, 39));
            first
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
