// expected failure E1065: parameter list of 'adjust' is not closed
// helper adjust/3 on uint8; adjust(18, 4, 17) = 5
use trial_support_uint8;

fn adjust(x: uint8, y: uint8, z: uint8 -> uint8 {
    x % z + y
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            adjust(18, 4, 17)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 5
    end
}
