// expected failure E2005: function literal called with one argument instead of two
// function literal passed as a parameter, capturing z; expect 36
use trial_support_int64;

fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            z: int64 <- 14;
            apply_pair(11, fn(a: int64, b: int64) -> int64 {
                a + b + z
            })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
