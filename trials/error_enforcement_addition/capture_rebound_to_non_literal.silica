// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name only if, where the
// literal is written, the name is bound to an integer literal by an integer-typed binding.
// n is first bound to the literal 3, then rebound to seven() + m; where the literal is written n
// is bound to that call result, not to an integer literal.

fn take(op: fn(a: int64) -> int64) -> int64 {
    op(1)
}

fn seven() -> int64 {
    7
}

fn main() -> int64 {
    n: int64 <- 3;
    m: int64 <- n + 1;
    n: int64 <- seven() + m;
    take(fn(x: int64) -> int64 { x + n })
}
