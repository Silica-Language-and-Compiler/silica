// expected failure E1055: binding 'temp_val' is never used
// uint64 bitwise: (seven bor hi) band five = 11
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            temp_val: int64 <- 41;
            seven: uint64 <- 6;
            hi: uint64 <- 11;
            five: uint64 <- 11;
            (seven bor hi) band five
        });
        _: int64 <- wait_for_exit()
    produces
        pure 11
    end
}
