// expected failure E2018: binding 'n' has no type annotation
// guards partition int64 into three ranges; n = 148 gives 147
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n <- 148;
            case n of {
                n: int64 if n < 18 -> 0;
                n: int64 if n >= 18 and n < 101 -> n;
                n: int64 if n >= 101 -> n - 1
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
