// expected failure E1055: binding 'scratch' is never used
// helper adjust/1 on uint16; adjust(7) = 14
use trial_support_uint16;

fn adjust(x: uint16) -> uint16 {
    scratch: int64 <- 41;
    x * 48 % (39 + x)
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            adjust(7)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 14
    end
}
