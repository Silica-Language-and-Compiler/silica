// expected failure E1055: binding 'leftover' is never used
// print_int8 two; prints 47 then 0
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            leftover: int64 <- 41;
            sequence proc[device_io] a: int8 <- 8 + 39;
                b: int8 <- 0;
                _: atom <- print_int8(a);
                println("");
                result: atom <- print_int8(b)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
