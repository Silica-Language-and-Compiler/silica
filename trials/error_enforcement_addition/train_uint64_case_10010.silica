// expected failure E2018: binding 'v' has no type annotation
// case on uint64 value 28; expect 188
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v <- 28;
            case v of {
                33 -> 31;
                6 -> 86;
                8 -> 69;
                37 -> 5;
                n: uint64 if n > 34 -> 69;
                _: uint64 -> 188
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 188
    end
}
