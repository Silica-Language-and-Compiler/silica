// expected failure E1060: unbalanced braces
// case on uint32 value 0; expect 161
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            v: uint32 <- 0;
            case v of {
                23 -> 64;
                42 -> 101;
                28 -> 77;
                27 -> 65;
                n: uint32 if n > 30 -> 131;
                _: uint32 -> 161
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 161
    end
}}
