// E2402: a type with a ref?(L, S, rec) slot decodes into a region the caller owns; decode needs it as
// its fourth argument (design §4.1).
fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        top: (atom, int64, ref?(L, normal, rec)) <- (:ok, 5, :none);
        frame: string <- encode((:etf), top);
        r2: (:ok, (atom, int64, ref?(L, normal, rec))) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 256 });
        _: atom <- case r2 of {
            (:ok, _w: (atom, int64, ref?(L, normal, rec))) -> print_int64(1);
            (:rejected, why: atom) -> print_atom(why)
        }
    produces
        pure 0
    end
}
