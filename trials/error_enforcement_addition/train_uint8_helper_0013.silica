// expected failure E1042: function 'main' has no return type
// helper adjust/2 on uint8; adjust(1, 16) = 15
use trial_support_uint8;

fn adjust(x: uint8, y: uint8) -> uint8 {
    y - x
}

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            adjust(1, 16)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
