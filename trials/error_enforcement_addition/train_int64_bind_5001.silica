// expected failure E2003: binding a declared int8 but used as int64
// int64 bindings then expression; expect 36
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: int8 <- 3;
            c: int64 <- 20 + a;
            width: int64 <- 28;
            36 + c - c + width - width
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
