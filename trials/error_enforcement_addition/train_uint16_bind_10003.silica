// expected failure E2003: binding a declared uint8 but used as uint16
// uint16 bindings then expression; expect 186
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            a: uint8 <- 36;
            d: uint16 <- a;
            width: uint16 <- 6 + 22;
            count: uint16 <- 16 * 12;
            count - 6 + d - d + width - width
        });
        _: int64 <- wait_for_exit()
    produces
        pure 186
    end
}
