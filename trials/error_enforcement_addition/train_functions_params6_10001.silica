// expected failure E2005: call with one argument too few
// function with 6 parameter(s); sum6(11, 10, 21, 0, 20, 19) = 81
use trial_support_int64;

fn sum6(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64) -> int64 {
    a + b + c + d + e + f
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sum6(11, 10, 21, 0, 20)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
