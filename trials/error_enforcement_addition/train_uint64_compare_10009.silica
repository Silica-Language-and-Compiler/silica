// expected failure E1049: sequence block without produces
// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(28 * 39 != (60 + 43));
                println("");
                _: atom <- print_boolean(50 <= (17 + 43));
                println("");
                _: atom <- print_boolean((2 + 25) > (37 + 17));
                println("");
                _: atom <- print_boolean(41 >= 59 % 55);
                println("");
                result: atom <- print_boolean(6 / 6 >= 37 * 55)
                pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
