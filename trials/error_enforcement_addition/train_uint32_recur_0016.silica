// expected failure E2001: atom literal returned from the recursion base case
// recursive steps on uint32; steps(13, 0) = 13
use trial_support_uint32;

fn steps(n: uint32, acc: uint32) -> uint32 {
    case n == 0 of {
        true -> :done;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            steps(13, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
