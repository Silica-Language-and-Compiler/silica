// Spec §15.1.2.3: stop_self and fail_self are how a behaviour ends its own actor. main is not an
// actor, so stop_self there is rejected at compile time with E2091 ActorOperationPlacement, as
// kill_abnormal outside a behaviour is. (The runtime entries also treat a thread with no current
// actor as the language-level failure of §15.4.5.5, but no program reaches them that way.)

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> int64 {
    sequence proc[concurrency]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 1 impl ActorMessage {});
        _: atom <- stop_self(:normal);
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
