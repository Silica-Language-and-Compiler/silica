// expected failure E1043: whitespace between binding name 'result' and ':'
// float32 helper half_sum; prints 1180.125
use trial_support_atom;

fn half_sum(x: float32) -> float32 {
    x * 32.5 + 2.0
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result :atom <- print_float32(half_sum(36.25))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
