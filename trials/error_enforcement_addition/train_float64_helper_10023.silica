// expected failure E4015: function 'half_sum' defined twice
// float64 helper half_sum; prints 7.375
use trial_support_atom;

fn half_sum(x: float64) -> float64 {
    x * 27.5 + 0.5
}

fn half_sum(x: float64) -> float64 {
    x * 27.5 + 0.5
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float64(half_sum(0.25))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
