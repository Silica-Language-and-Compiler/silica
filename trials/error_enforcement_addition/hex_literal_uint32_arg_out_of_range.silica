// expected failure E2011: 0xFFFFFFFFF (36 bits) passed to the uint32 parameter of a same-module
// function
use trial_support_atom;

fn same_u32(i: uint32) -> uint32 {
    i
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_uint32(same_u32(0xFFFFFFFFF))
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
