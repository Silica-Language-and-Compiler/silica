// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// fold a string list with concat; byte length 20
use trial_support_int64;

fn build(xs: List[string, mem(normal)]) -> string {
    sequence proc[device_io]
        result: string <- case xs of {
            []: List[string, mem(normal)] -> "";
            [h: string, t: List[string, mem(normal)]] -> concat(h, build(t));
            _: List[string, mem(normal)] -> ""
        }
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[string, mem(normal)] <- ["river", "north", "gamma", "north"];
                s: string <- build(xs)
            produces
                pure length_bytes(s)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
