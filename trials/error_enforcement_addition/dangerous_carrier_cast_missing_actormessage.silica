// The carrier contract's messages are ActorMessage; a cast to a carrier without the impl is rejected.
module dangerous_carrier_cast_missing_actormessage;
use Carrier;
use dangerous_sockets;
use dangerous_tcp_carrier;

fn close_it(car: dangerous_actor_ref) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(car, :close)
    produces
        pure sent
    end
}

fn main() -> int64 {
    0
}
