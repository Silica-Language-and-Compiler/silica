// expected failure E1055: binding 'scratch' is never used
// uint64 bitwise: (((bnot two) band mask) + flags) = 18
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            scratch: int64 <- 41;
            two: uint64 <- 8;
            mask: uint64 <- 5;
            flags: uint64 <- 13;
            (((bnot two) band mask) + flags)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 18
    end
}
