// expected failure E1040: missing ';' between two statements
// print_uint8 two; prints 17 then 49
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: uint8 <- 17;
                b: uint8 <- 7 + 42;
                _: atom <- print_uint8(a);
                println("")
                result: atom <- print_uint8(b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
