// expected failure E1055: binding 'unused_value' is never used
// uint16 bindings then expression; expect 2
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            unused_value: int64 <- 41;
            d: uint16 <- 45 % 16 / 31;
            base: uint16 <- d + (54 - 24);
            width: uint16 <- base;
            b: uint16 <- 19 / (base / 14);
            base - width + 20 % b
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
