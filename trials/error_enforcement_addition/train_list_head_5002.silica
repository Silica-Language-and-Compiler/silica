// expected failure E2003: list operation instantiated with the wrong element type
// second on [10, 15, 34, 28, 15] gives 15
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [10, 15, 34, 28, 15];
                rest: List[int64, mem(normal)] <- remove_head[uint8, mem(normal)](xs);
                second: int64 <- head[int64, mem(normal)](rest)
            produces pure second end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
