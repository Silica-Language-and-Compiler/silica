// E2412 at the spawn (links design §3.3): spawn_dangerous_carrier names a declaration whose link this
// target cannot serve, so the expansion into the target's spawn form fails where the carrier is started.
carried_on host_line: (:serial) (:uart, 1, 115200);

fn main() -> int64 {
    sequence proc[concurrency]
        _: dangerous_actor_ref <- spawn_dangerous_carrier(host_line, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
    produces
        pure 0
    end
}
