// expected failure E1051: sequence block without a closing end
// list literal of 3 uint32 elements; length is 3
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[uint32, mem(normal)] <- [31, 22, 5];
                n: int64 <- length[uint32, mem(normal)](xs)
            produces
                pure n
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
