// expected failure E2018: binding 'hi' has no type annotation
// uint64 bitwise: ((bnot three) band hi) bor seven = 6
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            three: uint64 <- 15;
            hi <- 10;
            seven: uint64 <- 6;
            ((bnot three) band hi) bor seven
        });
        _: int64 <- wait_for_exit()
    produces
        pure 6
    end
}
