// expected failure E2001: string literal in one case arm of an integer case
// case on uint16 value 25; expect 96
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 25;
            case v of {
                4 -> "59";
                17 -> 55;
                13 -> 77;
                28 -> 107;
                n: uint16 if n > 23 -> 96;
                _: uint16 -> 38
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 96
    end
}
