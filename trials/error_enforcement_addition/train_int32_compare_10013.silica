// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == 44 != 46 * 19);
                println("");
                _: atom <- print_boolean(47 % 48 != 40 * 23);
                println("");
                _: atom <- print_boolean(26 * 41 == 50);
                println("");
                _: atom <- print_boolean(39 * 17 >= 20 / 54);
                println("");
                result: atom <- print_boolean((30 * 24) < 46 % 47)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
