// expected failure E2003: binding width declared int16 but used as uint32
// uint32 bindings then expression; expect 19
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            width: int16 <- 12;
            m: uint32 <- width;
            m + 55 % width
        });
        _: int64 <- wait_for_exit()
    produces
        pure 19
    end
}
