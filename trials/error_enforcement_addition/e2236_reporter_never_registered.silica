// Spec §15.4.13.4 "Handler before any start" (E2236): only the spawn whose actor_ref is passed to
// register_failure_reporter may run before registration. Here the reporter is spawned but never
// registered, so its spawn is an ordinary start and is reported.

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: actor_ref <- spawn(0, work, stack_policy(0, :keep_last_message));
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
