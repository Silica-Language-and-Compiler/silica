// expected failure E2001: atom literal returned from the recursion base case
// recursive pow2 on int64; pow2(3) = 8
use trial_support_int64;

fn pow2(n: int64) -> int64 {
    case n == 0 of {
        true -> :one;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            pow2(3)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
