// A module function cannot be named after an actor runtime intrinsic (spec §15.4.8.5):
// `Q@link(...)` is the supervisor intrinsic surface, so a user `link` could never be reached
// through its export. The definition is rejected with E1068.
use trial_support_int64;

fn link(a: int64, b: int64) -> int64 {
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            link(1, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
