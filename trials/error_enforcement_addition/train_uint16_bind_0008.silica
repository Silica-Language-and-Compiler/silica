// expected failure E2018: binding 'c' has no type annotation
// uint16 bindings then expression; expect 15
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            base: uint16 <- 44;
            total: uint16 <- base;
            c <- base;
            59 % base + total - total + c - c
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
