// expected failure E2003: parameter x declared uint64 in a uint32 helper
// helper mix/3 on uint32; mix(9, 13, 17) = 10
use trial_support_uint32;

fn mix(x: uint64, y: uint32, z: uint32) -> uint32 {
    ((z - 7) * (y / x))
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            mix(9, 13, 17)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 10
    end
}
