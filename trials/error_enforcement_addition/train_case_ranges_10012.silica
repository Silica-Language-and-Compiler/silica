// expected failure E1043: whitespace between binding name 'n' and ':'
// guards partition int64 into three ranges; n = 103 gives 0
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n :int64 <- 103;
            case n of {
                n: int64 if n < 26 -> n;
                n: int64 if n >= 26 and n < 81 -> n;
                n: int64 if n >= 81 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
