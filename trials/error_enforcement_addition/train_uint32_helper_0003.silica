// expected failure E2003: parameter x declared uint16 in a uint32 helper
// helper blend/2 on uint32; blend(16, 1) = 72
use trial_support_uint32;

fn blend(x: uint16, y: uint32) -> uint32 {
    y + 54 + (x + y)
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            blend(16, 1)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 72
    end
}
