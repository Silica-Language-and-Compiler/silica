use trial_support_int64;

// alloc_buf_retained(n) (chunk 15 phase 7, design section 7) has the effect external_danger: the buffer is
// a node of a dangerous actor's state area and is legal only inside that actor's guarded sequence.
// There is no code of its own for the misuse; the effect checker reports the undeclared effect as
// E3002 at the call, as it does for any builtin whose effect the caller's sequence does not declare.
// Expected: E3002 "Effect not declared in caller: external_danger" at the alloc_buf_retained call.

wrapper_meta "dangerous_exposure_source/good_retains_data_ptr.meta";

foreign c_wrapper "silica_retain_keep"
fn keep_raw(data_ptr: uint8, data_len: uint64) -> int64;

fn make_retained() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        bf: buf(L1, normal, uint8, 4) <- alloc_buf_retained(4);
        _: atom <- write_buf(bf, 0, 1);
        _: int64 <- keep_raw(bf)
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                _: int64 <- make_retained()
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
