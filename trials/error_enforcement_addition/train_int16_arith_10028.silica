// expected failure E1047: named struct declaration 'Pair' is not allowed
// int16 arithmetic: 31 / 54 % (45 * 12) = 0
use trial_support_int16;

struct Pair { x: int64, y: int64 }

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            31 / 54 % (45 * 12)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
