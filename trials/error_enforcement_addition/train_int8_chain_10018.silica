// expected failure E1055: binding 'leftover' is never used
// chained print_int8 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            leftover: int64 <- 41;
            sequence proc[device_io]
                _: atom <- print_int8(52 / 42);
                println("");
                _: atom <- print_int8(55 + (24 - 22));
                println("");
                _: atom <- print_int8(25);
                println("");
                result: atom <- print_int8(9 % 36)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
