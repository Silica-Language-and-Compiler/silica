// expected failure E1045: function 'main' declared without the fn keyword
// main returns float16; exit code is trunc(0.75 * 36.0) = 27
use trial_support_float16;

main() -> float16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            0.75 * 36.0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 27.0
    end
}
