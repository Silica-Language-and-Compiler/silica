use trial_support_int64;

module dangerous_retained_buf_shrink_policy_rejected;

// E4036 RetainedBufferActorNotPinned (chunk 15 phase 7, the pin rule, chunk15_stack_memory_design.md
// section 7): a behaviour that allocates a buffer C keeps (alloc_buf_retained) holds it as a node of
// its state area, which must not move, so its spawn must pass state_policy(:keep_state_area) written
// literally. state_policy(:shrink_after_compaction) is a different choice and is rejected at the
// state_policy argument of the spawn.

wrapper_meta "dangerous_exposure_source/good_retains_data_ptr.meta";

foreign c_wrapper "silica_retain_keep"
fn keep_raw(data_ptr: uint8, data_len: uint64) -> int64;

fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger, mem(normal)]
        L1: lifetime <- fresh_lifetime();
        bf: buf(L1, normal, uint8, 4) <- alloc_buf_retained(4);
        _: atom <- write_buf(bf, 0, 1);
        _: int64 <- keep_raw(bf)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                worker_ref: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker, stack_policy(0, :keep_last_message), state_policy(:shrink_after_compaction));
                _: boolean <- cast(worker_ref, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
