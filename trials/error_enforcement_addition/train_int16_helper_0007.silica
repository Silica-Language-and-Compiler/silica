// expected failure E2003: parameter x declared uint16 in a int16 helper
// helper combine/3 on int16; combine(8, 3, 4) = 3
use trial_support_int16;

fn combine(x: uint16, y: int16, z: int16) -> int16 {
    x * y % (z + y)
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            combine(8, 3, 4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
