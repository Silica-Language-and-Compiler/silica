// expected failure E2001: integer literal message sent to an atom-typed behavior
use trial_support_atom;

fn srv(msg: atom, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, srv, stack_policy(0, :keep_last_message));
                r: int64 <- call(w, 7 impl ActorMessage {});
                print_int64(r);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
