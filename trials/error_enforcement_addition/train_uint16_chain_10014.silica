// expected failure E1040: missing ';' between two statements
// chained print_uint16 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_uint16(26 * 50);
                println("")
                _: atom <- print_uint16((27 / 12));
                println("");
                _: atom <- print_uint16(12 % 58 + 21);
                println("");
                result: atom <- print_uint16(42)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
