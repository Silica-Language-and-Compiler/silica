// expected failure E2018: binding 'rect' has no type annotation
// nested inline records; sum = 36
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            rect <- {
                top_left: { x: 0, y: 3 },
                bottom_right: { x: 14, y: 19 }
            };
            rect.top_left.x + rect.top_left.y + rect.bottom_right.x + rect.bottom_right.y
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
