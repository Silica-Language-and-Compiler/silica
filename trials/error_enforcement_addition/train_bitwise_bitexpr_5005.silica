// expected failure E1042: function 'main' has no return type
// uint64 bitwise: ((one bor flags) + bits) = 14
use trial_support_uint64;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            one: uint64 <- 12;
            flags: uint64 <- 13;
            bits: uint64 <- 1;
            ((one bor flags) + bits)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 14
    end
}
