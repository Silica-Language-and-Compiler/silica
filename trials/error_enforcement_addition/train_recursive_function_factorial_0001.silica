// expected failure E2002: undefined identifier 'nx'
// direct factorial; factorial(0) = 1
use trial_support_int64;

fn factorial(n: int64) -> int64 {
    case n <= 1 of {
        true -> 1;
        false -> n * factorial(nx - 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            factorial(0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
