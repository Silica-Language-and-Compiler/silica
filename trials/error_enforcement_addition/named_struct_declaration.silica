// E1047: named struct/record declarations are not allowed; records are inline only.

use trial_support_int64;

struct PidRegNode { name: atom, process: actor_ref, next_left: PidRegNode, next_right: PidRegNode }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
