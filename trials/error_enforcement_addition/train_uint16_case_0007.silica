// expected failure E1042: function 'main' has no return type
// case on uint16 value 25; expect 66
use trial_support_uint16;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 25;
            case v of {
                43 -> 108;
                17 -> 16;
                18 -> 115;
                14 -> 106;
                n: uint16 if n > 20 -> 66;
                _: uint16 -> 5
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 66
    end
}
