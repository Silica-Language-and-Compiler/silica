// expected failure E2018: binding 'b' has no type annotation
// print_uint16 two; prints 4 then 2958
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: uint16 <- 42 % 38;
                b <- 58 * 51;
                _: atom <- print_uint16(a);
                println("");
                result: atom <- print_uint16(b)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
