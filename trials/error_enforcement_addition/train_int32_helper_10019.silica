// expected failure E2003: parameter x declared uint8 in a int32 helper
// helper combine/2 on int32; combine(18, 6) = 108
use trial_support_int32;

fn combine(x: uint8, y: int32) -> int32 {
    (20 / 33 + (y * x))
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            combine(18, 6)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 108
    end
}
