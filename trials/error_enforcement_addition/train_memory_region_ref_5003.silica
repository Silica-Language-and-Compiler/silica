// expected failure E2001: string written into an int64 ref
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: double_write on a ref in normal_writethrough; expect 20
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal_writethrough)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal_writethrough) <- alloc_region(normal_writethrough);
                cell: ref(L1, normal_writethrough, int64) <- alloc_ref(r, "33");
                _: atom <- write_ref(cell, 41);
                _: atom <- write_ref(cell, 20);
                value: int64 <- read_ref(cell)
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
