// expected failure E2002: undefined identifier 'xx'
// case arms with multi-statement block bodies; expect 76
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- 5;
            case x of {
                0 -> {
                    base: int64 <- 19;
                    base * 2
                }
                _: int64 -> {
                    step: int64 <- 15;
                    xx * step + 1
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
