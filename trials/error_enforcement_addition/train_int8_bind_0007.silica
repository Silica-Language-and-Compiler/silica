// expected failure E2003: binding count declared uint8 but used as int8
// int8 bindings then expression; expect 0
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            count: uint8 <- 47 + 37;
            height: int8 <- 43;
            c: int8 <- count;
            step: int8 <- 14 + height / count;
            (40 + 30) * (14 / 34) + c - c + step - step
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
