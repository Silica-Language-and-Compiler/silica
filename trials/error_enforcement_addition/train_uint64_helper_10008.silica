// expected failure E1045: function 'main' declared without the fn keyword
// helper compute/3 on uint64; compute(8, 13, 18) = 5
use trial_support_uint64;

fn compute(x: uint64, y: uint64, z: uint64) -> uint64 {
    y % x * (z / z)
}

main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            compute(8, 13, 18)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 5
    end
}
