// expected failure E1065: parameter list of 'compute' is not closed
// helper compute/1 on uint32; compute(5) = 41
use trial_support_uint32;

fn compute(x: uint32 -> uint32 {
    x + (27 + 9)
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            compute(5)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 41
    end
}
