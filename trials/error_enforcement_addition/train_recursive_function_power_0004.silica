// expected failure E2005: call to unknown function 'power_all'
// power(6, 0) = 1
use trial_support_int64;

fn power(b: int64, e: int64) -> int64 {
    case e == 0 of {
        true -> 1;
        false -> b * power_all(b, e - 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            power(6, 0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
