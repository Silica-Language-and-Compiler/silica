// expected failure E2001: string literal passed where an integer parameter is expected
// helper scale/2 on int32; scale(16, 2) = 2
use trial_support_int32;

fn scale(x: int32, y: int32) -> int32 {
    (x - y) % (1 + y)
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            scale("16", 2)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
