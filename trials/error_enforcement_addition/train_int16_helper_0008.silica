// expected failure E2003: parameter x declared uint64 in a int16 helper
// helper adjust/3 on int16; adjust(14, 15, 7) = 0
use trial_support_int16;

fn adjust(x: uint64, y: int16, z: int16) -> int16 {
    z / x * (y % x)
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            adjust(14, 15, 7)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
