// expected failure E1060: unbalanced braces
// Spec §15.1.1: two actor_ref values from spawn; each replies independently
fn adder(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn doubler(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg * 2, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(1, adder, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        b: actor_ref <- spawn(2, doubler, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        ra: int64 <- call(a, 2 impl ActorMessage {});
        rb: int64 <- call(b, 7 impl ActorMessage {});
        print_int64(ra + rb);
        println("")
    produces
        pure :ok
    end
