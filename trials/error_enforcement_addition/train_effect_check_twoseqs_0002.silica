// expected failure E2005: call to unknown function 'my_print_int64'
// Positive: two sequences with separate effect declarations in one function
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                my_print_int64(6);
                println("")
            produces pure :ok end;
            n: int64 <- sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [6, 5]
            produces
                pure length[int64, mem(normal)](xs)
            end;
            n
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
