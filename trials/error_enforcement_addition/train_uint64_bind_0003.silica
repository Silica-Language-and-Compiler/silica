// expected failure E2003: binding step declared int32 but used as uint64
// uint64 bindings then expression; expect 76
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            step: int32 <- 57 - 55 + (29 + 36);
            c: uint64 <- 32;
            a: uint64 <- 28;
            a % 15 + (a + 35) + step - step + c - c
        });
        _: int64 <- wait_for_exit()
    produces
        pure 76
    end
}
