// expected failure E2003: blend returns float16 but its result feeds print_float32
// float32 helper blend; prints 356.6875
use trial_support_atom;

fn blend(x: float32) -> float16 {
    x * 15.25 + 2.125
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float32(blend(23.25))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
