// expected failure E1070: scale given nine parameters
// helper scale/3 on int64; scale(2, 18, 6) = 6
use trial_support_int64;

fn scale9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn scale(x: int64, y: int64, z: int64) -> int64 {
    z % (x + y)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            scale(2, 18, 6)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
