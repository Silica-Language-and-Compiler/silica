// expected failure E1042: function 'sum_to' has no return type
// recursive sum_to on int8; sum_to(5) = 15
use trial_support_int8;

fn sum_to(n: int8) {
    case n == 0 of {
        true -> 0;
        false -> n + sum_to(n - 1)
    }
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            sum_to(5)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
