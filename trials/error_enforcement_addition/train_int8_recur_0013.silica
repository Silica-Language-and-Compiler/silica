// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on int8; digit_count(106) = 3
use trial_support_int8;

fn digit_count(n: int8) -> int8 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            digit_count(106)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
