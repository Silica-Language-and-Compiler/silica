// expected failure E3009: proc[...] written on the function return type instead of the sequence
// float64 comparisons
use trial_support_atom;

fn main() -> atom proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(30.0 < (28.0 - 29.0));
                println("");
                _: atom <- print_boolean(39.5 > (39.25 + 38.25));
                println("");
                done: atom <- print_boolean(11.0 * 32.125 >= 26.5 * 33.125)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
