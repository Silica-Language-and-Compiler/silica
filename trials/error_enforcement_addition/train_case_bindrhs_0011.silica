// expected failure E2002: undefined identifier 'xx'
// case expression as a binding's right-hand side; expect 11
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- 0;
            label: int64 <- case xx % 3 of {
                0 -> 10;
                1 -> 17;
                _: int64 -> x
            };
            label + 1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
