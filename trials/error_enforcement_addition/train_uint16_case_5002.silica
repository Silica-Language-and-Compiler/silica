// expected failure E2001: string literal in one case arm of an integer case
// case on uint16 value 5; expect 10
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 5;
            case v of {
                32 -> "73";
                29 -> 10;
                n: uint16 if n > 13 -> 75;
                _: uint16 -> 10
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 10
    end
}
