// expected failure E1055: binding 'leftover' is never used
// helper scale/1 on uint32; scale(13) = 89
use trial_support_uint32;

fn scale(x: uint32) -> uint32 {
    leftover: int64 <- 41;
    x + 49 + (14 + x)
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            scale(13)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 89
    end
}
