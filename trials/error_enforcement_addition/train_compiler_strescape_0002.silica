// expected failure E2018: binding 's' has no type annotation
// case patterns unescape quote like string expressions; want 1
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s <- "\"";
            case s of {
                "\"" -> 1;
                _: string -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
