// expected failure E2003: shift returns float16 but its result feeds print_float32
// float32 helper shift; prints 42.75
use trial_support_atom;

fn shift(x: float32) -> float16 {
    x + 38.0 + 2.25
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float32(shift(2.5))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
