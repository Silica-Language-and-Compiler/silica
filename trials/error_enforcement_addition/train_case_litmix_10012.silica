// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 13 gives 42
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 13;
            case v of {
                :14 -> 24;
                9 -> 27;
                7 -> 21;
                m: int32 if m > 11 -> 42;
                _: int32 -> 0
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 42
    end
}
