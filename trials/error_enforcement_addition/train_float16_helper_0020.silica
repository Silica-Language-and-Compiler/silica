// expected failure E1049: sequence block without produces
// float16 helper shift; prints -13.75
use trial_support_atom;

fn shift(x: float16) -> float16 {
    x - 22.0 + 0.0
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float16(shift(8.25))
            pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
