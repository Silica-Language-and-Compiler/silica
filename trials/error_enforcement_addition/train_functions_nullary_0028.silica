// expected failure E1047: named struct declaration 'Node' is not allowed
// nullary function returning 94
use trial_support_int64;

struct Node { x: int64, y: int64 }

fn answer() -> int64 {
    94
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            answer()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
