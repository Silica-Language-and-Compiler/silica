// expected failure E2013: unary minus on a variable instead of negate_int32
// int32 bindings then expression; expect 44
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            k: int32 <- 12;
            a: int32 <- 44;
            height: int32 <- 5;
            -k + a + k - k + height - height
        });
        _: int64 <- wait_for_exit()
    produces
        pure 44
    end
}
