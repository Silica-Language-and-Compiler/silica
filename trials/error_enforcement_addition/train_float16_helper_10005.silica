// expected failure E1041: trailing ';' after the pure expression
// float16 helper blend; prints 36.25
use trial_support_atom;

fn blend(x: float16) -> float16 {
    x + 14.0 + 2.25
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float16(blend(20.0))
            produces
                pure result;
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
