// Error enforcement: case list patterns must use List[..., mem(Space)] (E2015).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [1, 2, 3];
                n: int64 <- case xs of {
                    []: List[int64] -> 0;
                    [h: int64, t: List[int64, mem(normal)]] -> h
                }
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
