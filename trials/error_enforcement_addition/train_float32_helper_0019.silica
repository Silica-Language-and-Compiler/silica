// expected failure E2003: scale returns float16 but its result feeds print_float32
// float32 helper scale; prints 22.5
use trial_support_atom;

fn scale(x: float32) -> float16 {
    x - 13.0 + 2.25
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float32(scale(33.25))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
