// expected failure E3001: list literal built outside any sequence block
// list literal of 2 uint32 elements; length is 2
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[uint32, mem(normal)] <- [33, 18];
            length[uint32, mem(normal)](xs)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
