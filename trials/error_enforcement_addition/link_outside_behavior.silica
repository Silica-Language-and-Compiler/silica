// Supervisors plan Phase D (silica-specification.md §15.4.8.5): `link` is a behavior-only
// intrinsic — the parent of the new link must be the running actor, which only exists inside
// a behavior function. Calling it from a non-behavior function must fail type check with E2091.

use trial_support_int64;

fn handler(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                ref: actor_ref <- spawn(0, handler, stack_policy(0, :keep_last_message));
                _: atom <- link(ref)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
