// expected failure E1041: trailing ';' after the block's final expression
// literal patterns, a guard and a typed wildcard on uint64; v = 12 gives 1
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 12;
            case v of {
                14 -> 35;
                7 -> 20;
                5 -> 28;
                m: uint64 if m > 9 -> 1;
                _: uint64 -> 47
            };
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
