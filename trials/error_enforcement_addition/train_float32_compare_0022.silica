// expected failure E3009: proc[...] written on the function return type instead of the sequence
// float32 comparisons
use trial_support_atom;

fn main() -> atom proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((14.5 - 22.125) >= (7.0 + 2.25));
                println("");
                _: atom <- print_boolean((27.25 + 29.0) >= (33.375 + 33.5));
                println("");
                done: atom <- print_boolean((34.0 + 36.5) <= 25.0)
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
