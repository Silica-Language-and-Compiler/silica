// expected failure E1047: named struct declaration 'Config' is not allowed
// function literal bound to a typed variable; f(13) = 14
use trial_support_int64;

struct Config { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            f: fn(int64) -> int64 <- fn(x: int64) -> int64 { x + 1 };
            f(13)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
