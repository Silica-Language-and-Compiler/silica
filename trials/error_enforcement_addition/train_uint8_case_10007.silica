// expected failure E1055: binding 'temp_val' is never used
// case on uint8 value 33; expect 60
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            temp_val: int64 <- 41;
            v: uint8 <- 33;
            case v of {
                42 -> 58;
                31 -> 183;
                _: uint8 -> 60
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 60
    end
}
