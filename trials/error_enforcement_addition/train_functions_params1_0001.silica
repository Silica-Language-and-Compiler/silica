// expected failure E1055: binding 'scratch' is never used
// function with 1 parameter(s); sum1(12) = 12
use trial_support_uint16;

fn sum1(a: uint16) -> uint16 {
    scratch: int64 <- 41;
    a
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            sum1(12)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 12
    end
}
