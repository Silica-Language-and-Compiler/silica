// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: ((bnot mask) band hi) bor five = 15
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            mask: uint64 <- true;
            hi: uint64 <- 3;
            five: uint64 <- 15;
            ((bnot mask) band hi) bor five
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
