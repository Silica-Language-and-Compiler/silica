// expected failure E1055: binding 'scratch' is never used
// recursive sum_to on uint32; sum_to(2) = 3
use trial_support_uint32;

fn sum_to(n: uint32) -> uint32 {
    scratch: int64 <- 41;
    case n == 0 of {
        true -> 0;
        false -> n + sum_to(n - 1)
    }
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            sum_to(2)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
