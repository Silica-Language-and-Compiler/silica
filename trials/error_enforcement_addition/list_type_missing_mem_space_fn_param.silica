// Error enforcement: function parameter List types must use mem(Space) (E2015).
use trial_support_int64;

fn take(xs: List[int64]) -> int64 {
    length[int64, mem(normal)](xs)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [1];
                take(xs)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
