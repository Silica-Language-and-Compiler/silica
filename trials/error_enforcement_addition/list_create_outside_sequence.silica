// Enforce E3001: list allocation must run inside sequence proc[mem(S)] … produces pure … end.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- [1, 2, 3];
            length[int64, mem(normal)](xs)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
