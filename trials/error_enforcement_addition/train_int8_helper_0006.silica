// expected failure E2003: parameter x declared int32 in a int8 helper
// helper compute/3 on int8; compute(10, 10, 3) = 0
use trial_support_int8;

fn compute(x: int32, y: int8, z: int8) -> int8 {
    x % y * (z + 58)
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            compute(10, 10, 3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
