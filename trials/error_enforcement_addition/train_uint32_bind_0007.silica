// expected failure E2003: binding m declared int64 but used as uint32
// uint32 bindings then expression; expect 12
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            m: int64 <- 12;
            b: uint32 <- m / 4;
            height: uint32 <- b;
            m * (31 % b) + height - height
        });
        _: int64 <- wait_for_exit()
    produces
        pure 12
    end
}
