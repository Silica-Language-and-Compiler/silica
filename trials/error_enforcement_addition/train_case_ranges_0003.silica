// expected failure E2002: undefined identifier 'n2'
// guards partition int64 into three ranges; n = 10 gives 10
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 10;
            case n of {
                n: int64 if n2 < 19 -> n;
                n: int64 if n >= 19 and n < 74 -> n / 2;
                n: int64 if n >= 74 -> n - 1
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
