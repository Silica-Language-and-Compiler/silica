// E1040: a binding with no right-hand side inside a function literal's sequence block, where the
// literal is a call argument inside another sequence block. Before 2026-10-08 this compiled: the
// missing right-hand side was only caught by accident when another statement followed it.
use trial_support_int64;

fn apply(f: fn() -> int64) -> int64 {
    f()
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("x");
                v: int64 <- apply(fn() -> int64 {
                    sequence
                        x: int64 <- ;
                    produces
                        pure x
                    end
                })
            produces
                pure v
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
