// expected failure E2001: string literal in one case arm of an integer case
// case on uint64 value 12; expect 170
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 12;
            case v of {
                8 -> "187";
                34 -> 64;
                23 -> 68;
                33 -> 105;
                n: uint64 if n > 15 -> 115;
                _: uint64 -> 170
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 170
    end
}
