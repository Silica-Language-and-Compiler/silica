// expected failure E1055: binding 'scratch' is never used
// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            scratch: int64 <- 41;
            sequence proc[device_io] _: atom <- print_boolean((32 + 43) != 30 / 36);
                println("");
                _: atom <- print_boolean((42 - 19) < 22 * 35);
                println("");
                _: atom <- print_boolean(42 > 2);
                println("");
                result: atom <- print_boolean(56 / 37 == 0 / 23)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
