// E3002: migrate_actor is a concurrency operation (silica-specification §22.10: every CPU
// affinity function requires proc[concurrency]; §15.1.2 Migration API). The sequence that calls
// it declares no effects, so the call needs concurrency and is the error, reported at its own
// location. Until 2026-10-19 the effect checker did not know migrate_actor at all: this program
// was accepted, and a sequence whose only concurrency operation was a migrate_actor was rejected
// with E3010 (unused effect declaration).
// Expected: E3002 "Effect not declared in caller: concurrency" at the migrate_actor call.

use trial_support_int64;

fn handler(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn move_it(target: actor_ref) -> atom {
    sequence
        r: atom <- migrate_actor(target, 1)
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, handler, stack_policy(0, :keep_last_message));
                _: atom <- move_it(w)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
