// expected failure E1047: named struct declaration 'Pair' is not allowed
// print_uint8 two; prints 62 then 59
use trial_support_atom;

struct Pair { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: uint8 <- 22 + 40;
                b: uint8 <- 48 + 11;
                _: atom <- print_uint8(a);
                println("");
                result: atom <- print_uint8(b)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
