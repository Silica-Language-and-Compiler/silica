// expected failure E1045: function 'main' declared without the fn keyword
// comments must stop at the newline; want 16
// whole-line comment before the function
use trial_support_int64;

main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: int64 <- 3; // end-of-line after a binding
            // whole-line comment between statements
            b: int64 <- 4; // another
            a / b + 16 // end-of-line after the return expression
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
