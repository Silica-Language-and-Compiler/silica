// expected failure E1052: duplicate sequence keyword
// print_int8 two; prints 15 then 7
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence sequence proc[device_io] a: int8 <- 15;
                b: int8 <- 7;
                _: atom <- print_int8(a);
                println("");
                result: atom <- print_int8(b)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
