// regression (already diagnosed by silica-999997): expected failure E3010: mem(normal) declared on a sequence that calls nothing
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] produces pure 42 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
