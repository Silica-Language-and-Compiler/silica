// expected failure E2003: a declared float32 but combined with a float16 value
// float16 bindings 41.5 - 18.75 printed as 22.75
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: float32 <- 41.5;
                b: float16 <- 18.75;
                result: atom <- print_float16(a - b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
