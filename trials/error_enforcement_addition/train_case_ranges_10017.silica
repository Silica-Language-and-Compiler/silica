// expected failure E1055: binding 'scratch' is never used
// guards partition int64 into three ranges; n = 114 gives 57
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            scratch: int64 <- 41;
            n: int64 <- 114;
            case n of {
                n: int64 if n < 29 -> 0;
                n: int64 if n >= 29 and n < 104 -> 0;
                n: int64 if n >= 104 -> n / 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
