// expected failure E2003: string binding used where an integer is expected
// concatenate of 2 pieces prints silicachair

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "silica";
                b: string <- "chair";
                s: string <- concatenate(a, b);
                print_int64(s);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
