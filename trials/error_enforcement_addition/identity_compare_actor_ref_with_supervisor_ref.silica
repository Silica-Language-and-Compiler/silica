// Spec §15.1.4 "Equality and order": the comparison operators are defined on each actor reference
// type, comparing two references of that type. Comparing an actor_ref with a supervisor_ref mixes
// reference types, a type error (E2003).

fn same(a: actor_ref, s: supervisor_ref) -> boolean {
    a == s
}

fn main() -> int64 {
    0
}
