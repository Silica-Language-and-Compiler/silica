// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint16 value 28; expect 185
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 28;
            case v of {
                :one -> 168;
                19 -> 13;
                22 -> 11;
                18 -> 106;
                n: uint16 if n > 27 -> 185;
                _: uint16 -> 69
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 185
    end
}
