// A negative literal argument to a uint32 parameter through a module-qualified call is out of the
// parameter's range (E2011), exactly as in a same-module call.
use LiteralLib;
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            LiteralLib@next_u32(-1)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
