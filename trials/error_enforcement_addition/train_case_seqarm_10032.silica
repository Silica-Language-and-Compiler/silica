// expected failure E1055: binding 'leftover' is never used
// case inside a sequence chooses what to print
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            leftover: int64 <- 41;
            flag: boolean <- true;
            sequence proc[device_io]
                v: int64 <- case flag of {
                    true -> 5;
                    false -> 9
                };
                result: atom <- print_int64(v)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
