// expected failure E2003: scale returns float32 but its result feeds print_float64
// float64 helper scale; prints 103.25
use trial_support_atom;

fn scale(x: float64) -> float32 {
    x * 7.0 + 3.5
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float64(scale(14.25))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
