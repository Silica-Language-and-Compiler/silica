// expected failure E2001: boolean literal passed to print_float32
// print_float32 of 4.5 - 18.125 - 38.5; prints -52.125
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_float32(true)
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
