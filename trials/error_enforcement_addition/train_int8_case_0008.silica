// expected failure E1043: whitespace between binding name 'v' and ':'
// case on int8 value 8; expect 111
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            v :int8 <- 8;
            case v of {
                25 -> 94;
                26 -> 55;
                n: int8 if n > 28 -> 36;
                _: int8 -> 111
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 111
    end
}
