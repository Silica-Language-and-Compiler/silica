// expected failure E2005: call to unknown function 'print_boolx'
// atom identity: :red == :green is false
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] left: atom <- :red;
                result: atom <- print_boolx(left == :green)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
