// expected failure E2003: binding count declared int32 but used as uint8
// uint8 bindings then expression; expect 48
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            count: int32 <- 16 % (11 + 31);
            a: uint8 <- count + 10 + (9 + 53);
            48 + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 48
    end
}
