// expected failure E2003: binding height declared int32 but used as uint8
// uint8 bindings then expression; expect 0
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            height: int32 <- 29 + 47;
            base: uint8 <- 58 / height;
            count: uint8 <- 5;
            24 % 20 / 56 + base - base + count - count
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
