// Spec §15.4.13.4 "Handler before any start": main must run register_failure_reporter before it
// starts any actor or supervisor (E2236 StartBeforeFailureReporter). This main starts a worker and
// never registers a reporter; the error is reported at the spawn.

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        _: actor_ref <- spawn(0, work, stack_policy(0, :keep_last_message));
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
