// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)]
                _: atom <- print_boolean(57 / 49 >= 26);
                println("");
                _: atom <- print_boolean(57 * 48 > 1 % 11);
                println("");
                _: atom <- print_boolean(10 * 4 >= 47);
                println("");
                _: atom <- print_boolean((53 + 50) == (50 + 60));
                println("");
                result: atom <- print_boolean(44 <= 29 * 42)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
