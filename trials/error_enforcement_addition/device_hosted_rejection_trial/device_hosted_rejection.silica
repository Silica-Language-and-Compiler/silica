// expected failure E2220 on every OS-hosted target: a poke prim cannot be compiled where no device is reachable
// (device spec §10). On the board this program compiles; the board driver skips sub-suites, so it is host-only.
use DeviceDescription;
use trial_support_int64;

impl fn registers(device: (:test_uart)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :fifo,    offset: 0x00, width: 32, access: :read_write },
        { name: :int_raw, offset: 0x04, width: 32, access: :write_one_to_clear },
        { name: :status,  offset: 0x1C, width: 32, access: :read_only },
        { name: :ctrl,    offset: 0x20, width: 32, access: :write_only }
    ]
}

fn probe(state: int64) -> int64 {
    sequence proc[register_rwr]
        w: device_window(L, (:test_uart)) <- map_device((:test_uart), 0x60000000);
        _: uint32 <- peek(w, :status) impl Register32 {}
    produces
        pure state
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
