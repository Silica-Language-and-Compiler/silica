// E1040: a binding with no right-hand side in a function literal body with no sequence block.
use trial_support_int64;

fn apply(f: fn() -> int64) -> int64 {
    f()
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v: int64 <- apply(fn() -> int64 {
                x: int64 <- ;
                x
            });
            v
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
