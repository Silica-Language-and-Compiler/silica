// expected failure E2005: tuple argument with three elements against a pair parameter
// tuple parameter pattern_param; add_pair((40, 26)) = 66
use trial_support_int64;

fn add_pair((a: int64, b: int64)) -> int64 {
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add_pair((40, 26, 1))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
