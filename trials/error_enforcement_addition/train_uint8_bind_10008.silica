// expected failure E2003: binding c declared int64 but used as uint8
// uint8 bindings then expression; expect 16
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            c: int64 <- 8;
            height: uint8 <- 49 + c;
            total: uint8 <- 0 / c + c;
            m: uint8 <- height;
            c + c + c / 45 + total - total + m - m
        });
        _: int64 <- wait_for_exit()
    produces
        pure 16
    end
}
