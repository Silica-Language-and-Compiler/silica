// expected failure E2003: binding d declared int16 but used as uint64
// uint64 bindings then expression; expect 48
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            d: int16 <- 24;
            height: uint64 <- d;
            m: uint64 <- 21;
            a: uint64 <- height;
            (height + d) % (d + 35) + m - m + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 48
    end
}
