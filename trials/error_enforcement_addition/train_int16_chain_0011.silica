// expected failure E2005: call to unknown function 'println_all'
// chained print_int16 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_int16(21 / 58);
                println("");
                _: atom <- print_int16(49);
                println("");
                _: atom <- print_int16(20 - 14 + 41 / 12);
                println_all("");
                result: atom <- print_int16(31)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
