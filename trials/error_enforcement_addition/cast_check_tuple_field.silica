// Spec §16.1.2 (2026-10-13): a cast to a call-only actor (its behaviour returns (:reply, ...))
// is rejected with E2237 when the reference comes out of a tuple: p is bound into a tuple, unpacked
// by a tuple pattern, and cast to.
// (Fable's E2237/E2238 repro rej_tuple_field, 2026-10-13.)

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn sink(msg: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + 1)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        q: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        t: (actor_ref, int64) <- (p, 1);
        (r: actor_ref, _: int64) <- t;
        _: boolean <- cast(r, "x" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
