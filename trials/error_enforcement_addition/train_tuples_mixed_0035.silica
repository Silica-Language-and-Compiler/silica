// expected failure E2003: string element printed with print_int64
// decompose a mixed tuple and print each element
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                t: (string, int64, atom) <- ("region", 64, :ok);
                (name: string, k: int64, tag: atom) <- t;
                print_int64(name);
                println("");
                print_int64(k);
                println("");
                print_atom(tag);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
