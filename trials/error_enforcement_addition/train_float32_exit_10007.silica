// expected failure E1055: binding 'temp_val' is never used
// main returns float32; exit code is trunc(5.25 * 20.0) = 105
use trial_support_float32;

fn main() -> float32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float32@start();
        _: boolean <- trial_support_float32@run(fn() -> float32 {
            temp_val: int64 <- 41;
            5.25 * 20.0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 105.0
    end
}
