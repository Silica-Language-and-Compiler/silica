// expected failure E2001: string literal passed where an integer parameter is expected
// helper combine/2 on int64; combine(17, 12) = 0
use trial_support_int64;

fn combine(x: int64, y: int64) -> int64 {
    26 % y / (45 - x)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            combine("17", 12)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
