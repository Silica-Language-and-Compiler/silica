// expected failure E2005: wrong argument count in call to 'sum_to'
// recursive sum_to on uint16; sum_to(15) = 120
use trial_support_uint16;

fn sum_to(n: uint16) -> uint16 {
    case n == 0 of {
        true -> 0;
        false -> n + sum_to()
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            sum_to(15)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 120
    end
}
