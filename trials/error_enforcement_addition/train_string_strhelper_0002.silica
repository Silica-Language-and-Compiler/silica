// expected failure E2001: integer literal returned from a string-typed arm
// string helper shout; prints world!

use trial_support_atom;

fn shout(s: string, n: int64) -> string {
    case n == 0 of {
        true -> 0;
        false -> concatenate(shout(s, n - 1), "!")
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                print_string(shout("world", 1));
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
