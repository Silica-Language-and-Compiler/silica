// E2412: (:sd_blocks, n, retention) is a board-only medium (transport design §6.8.6); a hosted target (macOS, linux_aarch64,
// linux_x86_64) offers only (:memory, ...) and (:backing, ...), so the declaration is rejected there by design.
carried_on journal: (:store) (:sd_blocks, 0, :ring);

fn main() -> int64 {
    0
}
