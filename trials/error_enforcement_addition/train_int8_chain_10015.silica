// expected failure E1051: sequence block without a closing end
// chained print_int8 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_int8(26 + 30);
                println("");
                _: atom <- print_int8(0);
                println("");
                _: atom <- print_int8((36 % 17));
                println("");
                result: atom <- print_int8(51)
            produces
                pure result
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
