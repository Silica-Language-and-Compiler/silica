// expected failure E1041: trailing ';' after the block's final expression
// helper compute/1 on uint16; compute(7) = 0
use trial_support_uint16;

fn compute(x: uint16) -> uint16 {
    (30 % 16) % (x / x);
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            compute(7)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
