// expected failure E2018: binding 'a' has no type annotation
// print_uint32 two; prints 91 then 952
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a <- 58 + 33;
                b: uint32 <- (34 * 28);
                _: atom <- print_uint32(a);
                println("");
                result: atom <- print_uint32(b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
