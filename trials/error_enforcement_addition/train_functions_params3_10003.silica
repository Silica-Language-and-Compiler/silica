// expected failure E2005: call with one argument too few
// function with 3 parameter(s); sum3(16, 17, 18) = 51
use trial_support_int32;

fn sum3(a: int32, b: int32, c: int32) -> int32 {
    a + b + c
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sum3(16, 17)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 51
    end
}
