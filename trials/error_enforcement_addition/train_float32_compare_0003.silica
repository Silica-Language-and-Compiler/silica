// expected failure E1045: function 'main' declared without the fn keyword
// float32 comparisons
use trial_support_atom;

main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((23.0 + 34.0) <= 0.0 * 37.0);
                println("");
                _: atom <- print_boolean(7.375 != 10.25);
                println("");
                _: atom <- print_boolean((24.0 - 17.0) <= 37.0);
                println("");
                done: atom <- print_boolean(25.5 >= 8.25)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
