// expected failure E1055: binding 'temp_val' is never used
// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            temp_val: int64 <- 41;
            sequence proc[device_io]
                _: atom <- print_boolean(34 % 45 != 45);
                println("");
                _: atom <- print_boolean(59 % 47 < (44 / 25));
                println("");
                _: atom <- print_boolean((56 + 58) != (6 + 6));
                println("");
                _: atom <- print_boolean(22 * 50 >= 55);
                println("");
                result: atom <- print_boolean((12 + 34) >= (52 - 39))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
