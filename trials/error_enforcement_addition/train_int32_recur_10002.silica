// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on int32; tri_acc(8, 0) = 36
use trial_support_int32;

fn tri_acc(n: int32, acc: int32) -> int32 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            tri_acc(8, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 36
    end
}
