// expected failure E2018: binding 'b' has no type annotation
// uint32 bindings then expression; expect 43
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            b <- 20;
            total: uint32 <- b / b;
            a: uint32 <- b;
            37 + (total + 5) + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 43
    end
}
