// expected failure E1055: binding 'temp_val' is never used
// function literal bound to a typed variable; f(14) = 19
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            temp_val: int64 <- 41;
            f: fn(int64) -> int64 <- fn(x: int64) -> int64 { x + 5 };
            f(14)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
