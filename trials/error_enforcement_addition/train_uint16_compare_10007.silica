// expected failure E2005: call to unknown function 'print_bool_all'
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((30 + 43) < (31 + 9));
                println("");
                _: atom <- print_bool_all((9 + 37) < 4);
                println("");
                _: atom <- print_boolean(34 % 42 != (58 - 29));
                println("");
                result: atom <- print_boolean((53 - 49) < (45 + 7))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
