// Spec §16.1.2 (2026-10-13): a cast to a call-only actor is rejected with E2237 when the
// reference enters an actor's state through the state the behaviour returns: swapper starts with
// the cast-only q as its peer, stores msg.reply_to as its new peer, and casts to state.peer;
// main sends it p as reply_to.
// (Fable's E2237/E2238 repro rej_state_returned, 2026-10-13.)

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn sink(msg: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + 1)
}

fn swapper(msg: { reply_to: actor_ref, n: int64 }, state: { peer: actor_ref, n: int64 }) -> (:no_reply, { peer: actor_ref, n: int64 }) {
    sequence proc[concurrency]
        _: boolean <- cast(state.peer, "x" impl ActorMessage {})
    produces
        pure (:no_reply, { peer: msg.reply_to, n: state.n })
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        q: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        s: actor_ref <- spawn({ peer: q, n: 0 }, swapper, stack_policy(0, :keep_last_message));
        _: boolean <- cast(s, { reply_to: p, n: 1 } impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
