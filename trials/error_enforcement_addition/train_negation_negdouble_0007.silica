// expected failure E2005: negate_uint16 does not exist
// negate_int64 double; prints 58
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_uint16(negate_uint16(negate_int64(58)))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
