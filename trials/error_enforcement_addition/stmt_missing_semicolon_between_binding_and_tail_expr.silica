// E1040: a binding statement (`pattern <- expr`) must end with ';' before the next statement,
// same as a bare expression statement (stmt_missing_semicolon_between_fn_statements). Today the
// parser accepts this: extract_function_body_tail's missing-terminator check
// (statement_boundary_error_wrapper, parser/constraint_extract_expr.silica) only runs when
// extract_body returns a bare expression; the let/binding path
// (parser/constraint_extract_expr_bindings.silica) recurses into the rest of the body directly
// and never calls it, so a missing ';' after a binding is silently accepted. Confirmed by
// book-verification repro r_semi1: `add`'s body compiles and runs (returns 6) with no error.

use trial_support_int64;

fn add(x: int64, y: int64) -> int64 {
    total: int64 <- x + y
    total * 2
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add(1, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
