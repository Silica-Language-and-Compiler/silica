// expected failure E2018: binding 'result' has no type annotation
// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((29 + 46) >= (40 - 13));
                println("");
                _: atom <- print_boolean(28 < (14 - 4));
                println("");
                _: atom <- print_boolean((58 + 50) == 26 / 15);
                println("");
                result <- print_boolean(2 % 3 > (50 + 50))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
