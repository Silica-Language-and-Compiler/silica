// expected failure E2005: string literal pattern against an integer scrutinee
// case on int8 value 0; expect 91
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            v: int8 <- 0;
            case v of {
                "one" -> 85;
                33 -> 76;
                _: int8 -> 91
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 91
    end
}
