// expected failure E2001: atom literal returned from the recursion base case
// recursive pow2 on uint16; pow2(0) = 1
use trial_support_uint16;

fn pow2(n: uint16) -> uint16 {
    case n == 0 of {
        true -> :one;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            pow2(0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
