// expected failure E2005: call to unknown function 'combine_all'
// helper combine/2 on int64; combine(16, 20) = 32
use trial_support_int64;

fn combine(x: int64, y: int64) -> int64 {
    (46 / x * (x % y))
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            combine_all(16, 20)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
