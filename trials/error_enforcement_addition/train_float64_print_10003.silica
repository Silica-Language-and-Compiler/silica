// expected failure E3001: print_float64 called outside a sequence block
// print_float64 of 11.125 + 24.0; prints 35.125
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            print_float64(11.125 + 24.0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
