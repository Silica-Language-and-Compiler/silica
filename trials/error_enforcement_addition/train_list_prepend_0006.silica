// expected failure E3009: proc[...] written on the function return type instead of the sequence
// 5 prepends after empty; head is 31
use trial_support_int32;

fn main() -> int32 proc[mem(normal)] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sequence proc[mem(normal)]
                xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
                xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](15, xs0);
                xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](12, xs1);
                xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](32, xs2);
                xs4: List[int32, mem(normal)] <- prepend[int32, mem(normal)](12, xs3);
                xs5: List[int32, mem(normal)] <- prepend[int32, mem(normal)](31, xs4);
                h: int32 <- head[int32, mem(normal)](xs5)
            produces pure h end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 31
    end
}
