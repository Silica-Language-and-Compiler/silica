// E3002: a call in a case guard is an operation of the enclosing sequence like any other
// (silica-specification §9.3.1; effects are local, rule 4). pick's sequence declares no effects,
// yet its case guard calls print_int64, which needs device_io. The guard's call is the error,
// reported at its own location. Before the 2026-10-12 effect-checker fix the guard was not
// visited and this program was accepted. The accepted form is
// trials/effect_check_addition/effect_guard_declared.
// Expected: E3002 "Effect not declared in caller: device_io" at the print_int64 in the guard.

use trial_support_int64;

fn pick(b: int64) -> int64 {
    sequence
        r: int64 <- case b of {
            n: int64 if print_int64(n) == :ok -> 1;
            _: int64 -> 0
        }
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(pick(1));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
