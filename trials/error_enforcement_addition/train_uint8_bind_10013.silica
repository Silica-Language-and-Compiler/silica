// expected failure E2003: binding b declared int16 but used as uint8
// uint8 bindings then expression; expect 11
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            b: int16 <- 49 % 13 + 37 / 49;
            height: uint8 <- b * b + (31 + b);
            c: uint8 <- b + 2;
            a: uint8 <- 32 + height + (12 - c);
            25 % (a / c)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 11
    end
}
