// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// string case with an effectful sequence in each arm
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            mode: string <- "verbose";
            case mode of {
                "verbose" -> {
                    sequence proc[device_io, mem(normal)]
                        print_string("verbose");
                        println("");
                        print_int64(7);
                        println("")
                    produces
                        pure :ok
                    end
                }
                "trace" -> {
                    sequence proc[device_io]
                        print_int64(8);
                        println("")
                    produces
                        pure :ok
                    end
                }
                _: string -> {
                    sequence proc[device_io]
                        print_string("default");
                        println("")
                    produces
                        pure :ok
                    end
                }
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
