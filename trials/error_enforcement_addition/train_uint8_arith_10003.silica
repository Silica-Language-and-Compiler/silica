// expected failure E1047: named struct declaration 'Config' is not allowed
// uint8 arithmetic: 39 + 34 / 23 = 40
use trial_support_uint8;

struct Config { x: int64, y: int64 }

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            39 + 34 / 23
        });
        _: int64 <- wait_for_exit()
    produces
        pure 40
    end
}
