// expected failure E2005: call to unknown function 'my_print_uint16'
// print_uint16 two; prints 4 then 27
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: uint16 <- 4 % 34;
                b: uint16 <- 27 % 33;
                _: atom <- print_uint16(a);
                println("");
                result: atom <- my_print_uint16(b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
