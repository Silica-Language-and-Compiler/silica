// expected failure E2003: binding m declared uint32 but used as uint8
// uint8 bindings then expression; expect 20
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            m: uint32 <- 20;
            total: uint8 <- 41 * 1;
            m + total - total
        });
        _: int64 <- wait_for_exit()
    produces
        pure 20
    end
}
