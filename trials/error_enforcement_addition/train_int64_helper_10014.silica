// expected failure E2001: string literal passed where an integer parameter is expected
// helper mix/3 on int64; mix(17, 4, 13) = 67
use trial_support_int64;

fn mix(x: int64, y: int64, z: int64) -> int64 {
    y + 33 + (x + z)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mix("17", 4, 13)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
