// expected failure E2018: binding 'hit' has no type annotation
// line-ending `or` followed by a blank line stays one expression
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: int64 <- 4;
            b: int64 <- 4;
            hit <- a > 8 or

                b > 8;
            case hit of {
                true -> 1;
                false -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
