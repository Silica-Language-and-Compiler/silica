// expected failure E1055: binding 'unused_value' is never used
// case on int16 value 6; expect 198
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            unused_value: int64 <- 41;
            v: int16 <- 6;
            case v of {
                3 -> 93;
                5 -> 44;
                17 -> 86;
                n: int16 if n > 26 -> 83;
                _: int16 -> 198
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 198
    end
}
