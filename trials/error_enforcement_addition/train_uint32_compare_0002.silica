// expected failure E2018: binding 'result' has no type annotation
// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((1 + 46) == (19 + 30));
                println("");
                _: atom <- print_boolean(41 > 24 % 44);
                println("");
                _: atom <- print_boolean(3 / 36 >= 15 * 34);
                println("");
                _: atom <- print_boolean(4 <= 53);
                println("");
                result <- print_boolean((41 - 38) == (43 + 7))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
