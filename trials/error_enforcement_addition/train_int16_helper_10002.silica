// expected failure E2003: parameter x declared int64 in a int16 helper
// helper combine/2 on int16; combine(17, 11) = 0
use trial_support_int16;

fn combine(x: int64, y: int16) -> int16 {
    (50 / x) / (35 - y)
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            combine(17, 11)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
