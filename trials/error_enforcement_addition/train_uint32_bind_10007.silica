// expected failure E2018: binding 'c' has no type annotation
// uint32 bindings then expression; expect 61
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            count: uint32 <- 4;
            c <- count;
            m: uint32 <- 11 / c;
            42 + 19 + m - m
        });
        _: int64 <- wait_for_exit()
    produces
        pure 61
    end
}
