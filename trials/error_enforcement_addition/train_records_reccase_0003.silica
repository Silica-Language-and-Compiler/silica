// expected failure E2005: record pattern naming a field the type lacks
// record pattern matching (guard); expect 4
use trial_support_int64;

fn score(p: { x: int64, y: int64 }) -> int64 {
    case p of {
        { x: xv, w: yv } if xv > yv -> xv - yv;
        { x: xv, y: yv } if yv > xv -> yv - xv;
        { x: xv, y: yv } -> xv + yv
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            p: { x: int64, y: int64 } <- { x: 2, y: 2 };
            score(p)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
