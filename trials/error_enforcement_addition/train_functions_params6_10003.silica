// expected failure E2005: call to unknown function 'sum6x'
// function with 6 parameter(s); sum6(0, 3, 9, 13, 7, 6) = 38
use trial_support_uint16;

fn sum6(a: uint16, b: uint16, c: uint16, d: uint16, e: uint16, f: uint16) -> uint16 {
    a + b + c + d + e + f
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            sum6x(0, 3, 9, 13, 7, 6)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 38
    end
}
