// expected failure E2001: greet returns an integer literal
// string helper greet prints hi cherry

use trial_support_atom;

fn greet(name: string) -> string {
    42
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] print_string(greet("cherry"));
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
