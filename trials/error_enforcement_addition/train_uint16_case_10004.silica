// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint16 value 7; expect 94
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 7;
            case v of {
                "one" -> 54;
                29 -> 172;
                14 -> 132;
                n: uint16 if n > 31 -> 67;
                _: uint16 -> 94
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 94
    end
}
