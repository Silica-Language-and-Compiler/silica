// expected failure E1055: binding 'unused_value' is never used
// case on int32 value 27; expect 179
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            unused_value: int64 <- 41;
            v: int32 <- 27;
            case v of {
                39 -> 114;
                21 -> 58;
                7 -> 79;
                n: int32 if n > 23 -> 179;
                _: int32 -> 26
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 179
    end
}
