// expected failure E2001: string literal in one case arm of an integer case
// case on int32 value 32; expect 3
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 32;
            case v of {
                39 -> "185";
                n: int32 if n > 28 -> 3;
                _: int32 -> 47
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
