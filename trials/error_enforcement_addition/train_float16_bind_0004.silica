// expected failure E1047: named struct declaration 'Config' is not allowed
// float16 bindings 37.5 - 19.0 printed as 18.5
use trial_support_atom;

struct Config { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: float16 <- 37.5;
                b: float16 <- 19.0;
                result: atom <- print_float16(a - b)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
