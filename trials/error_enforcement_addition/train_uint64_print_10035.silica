// expected failure E1052: duplicate sequence keyword
// print_uint64 var; prints 74
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence sequence proc[device_io]
                amount: uint64 <- 23 - 2;
                result: atom <- print_uint64(53 + amount)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
