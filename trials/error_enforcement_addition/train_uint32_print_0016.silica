// expected failure E2002: undefined identifier 'amount_'
// print_uint32 var; prints 1600
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] amount: uint32 <- 1 + 39;
                result: atom <- print_uint32(amount * amount_)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
