// expected failure E1049: sequence block without produces
// qualified call bound then printed; prints 37
use lib_math_utils_spec;
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] v: int64 <- lib_math_utils_spec@add(19, 18);
                result: atom <- print_int64(v)
                pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
