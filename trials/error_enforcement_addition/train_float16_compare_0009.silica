// expected failure E2005: call to unknown function 'print_booz'
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_booz(31.5 >= (24.5 + 17.5));
                println("");
                _: atom <- print_boolean((33.5 - 14.25) <= (27.25 + 30.0));
                println("");
                done: atom <- print_boolean(16.5 / 22.0 >= 39.0)
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
