// expected failure E2003: binding d declared int8 but used as uint32
// uint32 bindings then expression; expect 0
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            d: int8 <- 40;
            count: uint32 <- d;
            56 % count / (d * 40)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
