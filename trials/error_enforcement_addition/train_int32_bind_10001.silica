// expected failure E1042: function 'main' has no return type
// int32 bindings then expression; expect 2
use trial_support_int32;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            height: int32 <- 27 / 58;
            width: int32 <- 52;
            2 - height + width - width
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
