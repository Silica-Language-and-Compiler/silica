// expected failure E2002: undefined identifier 'xs'
// helper adjust/2 on int8; adjust(12, 13) = 25
use trial_support_int8;

fn adjust(x: int8, y: int8) -> int8 {
    y / x + (x + xs)
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            adjust(12, 13)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 25
    end
}
