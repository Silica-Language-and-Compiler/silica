// expected failure E1047: named struct declaration 'Node' is not allowed
// case on string literals; "other" gives 78
use trial_support_int64;

struct Node { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "other";
            case mode of {
                "south" -> 7;
                "silica" -> 85;
                "north" -> 36;
                _: string -> 78
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
