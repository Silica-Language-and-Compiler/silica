// expected failure E3002: region allocation under a device_io-only sequence
// region handle passed to a helper that allocates inside a case arm; want 28
use trial_support_int64;

fn pick(r: region(L1, normal), n: int64) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- case n > 0 of {
            true -> {
                cell: ref(L1, normal, int64) <- alloc_ref(r, n);
                read_ref(cell)
            };
            false -> 0
        }
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                v: int64 <- pick(r, 28)
            produces
                pure v
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
