// expected failure E1051: sequence block without a closing end
// chained print_uint16 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_uint16(46);
                println("");
                result: atom <- print_uint16(9)
                produces pure result
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
