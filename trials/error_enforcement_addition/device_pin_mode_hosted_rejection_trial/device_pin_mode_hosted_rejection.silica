// expected failure E2220 on every OS-hosted target: the board pin builtin pin_mode cannot be compiled where there
// are no GPIO pins (board_pin_builtins_design.md §4: the hosted emitters answer it in unsupported_prim_reason,
// the pre-emit pass sir_target_verify reports it). The call is a legal one for both boards (pin_mode(16, :output): GPIO16
// is a minibadge pin on the ESP32-S3 e-badge, 16 is PB0 on the NUCLEO-L476RG), inside a register_rwr
// sequence in a device_ module, so nothing but the target rejects it. The board driver skips
// sub-suites, so this trial runs on the hosts only.
use trial_support_int64;

fn probe(state: int64) -> int64 {
    sequence proc[register_rwr]
        _: atom <- pin_mode(16, :output)
    produces
        pure state
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
