// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint8 value 19; expect 9
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            v: uint8 <- 19;
            case v of {
                true -> 172;
                24 -> 186;
                2 -> 53;
                21 -> 132;
                _: uint8 -> 9
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 9
    end
}
