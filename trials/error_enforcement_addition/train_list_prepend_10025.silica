// expected failure E2001: string element prepended to an integer list
// 5 prepends after empty; length is 5
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
                xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)]("21", xs0);
                xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](37, xs1);
                xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](1, xs2);
                xs4: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](29, xs3);
                xs5: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](8, xs4);
                n: int64 <- length[uint32, mem(normal)](xs5)
            produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
