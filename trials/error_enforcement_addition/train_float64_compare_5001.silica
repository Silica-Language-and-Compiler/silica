// expected failure E1043: whitespace between binding name 'done' and ':'
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(30.25 > 19.0);
                println("");
                _: atom <- print_boolean((18.5 + 1.75) > (18.5 - 41.5));
                println("");
                done :atom <- print_boolean(23.5 * 26.5 < 15.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
