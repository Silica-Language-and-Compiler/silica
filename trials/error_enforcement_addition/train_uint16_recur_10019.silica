// expected failure E1060: unbalanced braces
// recursive steps on uint16; steps(20, 0) = 20
use trial_support_uint16;

fn steps(n: uint16, acc: uint16) -> uint16 {
    case n == 0 of {
        true -> acc;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            steps(20, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 20
    end
}}
