// expected failure E2001: string element prepended to an integer list
// 5 prepends after empty; head is 36
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            sequence proc[mem(normal)]
                xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
                xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)]("5", xs0);
                xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](19, xs1);
                xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](9, xs2);
                xs4: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](14, xs3);
                xs5: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](36, xs4);
                h: uint32 <- head[uint32, mem(normal)](xs5)
            produces
                pure h
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 36
    end
}
