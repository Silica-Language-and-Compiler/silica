// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (bits band one) bor mask = 9
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            bits: uint64 <- true;
            one: uint64 <- 11;
            mask: uint64 <- 8;
            (bits band one) bor mask
        });
        _: int64 <- wait_for_exit()
    produces
        pure 9
    end
}
