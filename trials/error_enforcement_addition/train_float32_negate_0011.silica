// expected failure E1052: duplicate sequence keyword
// negate_float32 applied 2 time(s); prints 29.125
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence sequence proc[device_io] result: atom <- print_float32(negate_float32(negate_float32(29.125)))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
