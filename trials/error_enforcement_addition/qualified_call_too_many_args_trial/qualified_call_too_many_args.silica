// Fixed 2026-09-24: leftover arguments after the callee's formals are exhausted are E2005 (check_user_call_args_recursive).
// SD-1: a qualified cross-module call with TOO MANY arguments must be rejected (spec §10.3.4,
// "Function expects n arguments, but got m"); today it compiles. Too few arguments is E2005
// (Silica's own qualified_call_wrong_arg_count_trial). Copied from project-bees
// trials/r01_harness/fail_wrong_arity.silica, whose comment records the too-many case.
use bees_hello;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            bees_hello@answer(1, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
