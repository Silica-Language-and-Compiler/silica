// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 93 gives 193
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 93;
            case n of {
                n: int64 if n < 6 -> "n / 2";
                n: int64 if n >= 6 and n < 86 -> n * 2;
                n: int64 if n >= 86 -> n + 100
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
