// expected failure E1047: named struct declaration 'Point' is not allowed
// decompose a 4-tuple from a literal; a + b + c + d = 104
use trial_support_int64;

struct Point { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (a: int64, b: int64, c: int64, d: int64) <- (37, 10, 47, 10);
            a + b + c + d
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
