// expected failure E2005: call to unknown function 'concaz'
// concat of 4 pieces prints cherryworldactorworld

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                s: string <- concaz(concat(concat("cherry", "world"), "actor"), "world");
                print_string(s);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
