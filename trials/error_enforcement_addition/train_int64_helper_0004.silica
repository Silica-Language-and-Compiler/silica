// expected failure E2003: parameter x declared uint64 in a int64 helper
// helper mix/3 on int64; mix(20, 12, 4) = 12
use trial_support_int64;

fn mix(x: uint64, y: int64, z: int64) -> int64 {
    (x + y) % (24 - z)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mix(20, 12, 4)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
