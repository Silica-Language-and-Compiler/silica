// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)]
                _: atom <- print_boolean(5.5 == 1.5 * 21.0);
                println("");
                _: atom <- print_boolean(30.5 == (39.0 - 17.5));
                println("");
                _: atom <- print_boolean(23.25 < 13.0);
                println("");
                done: atom <- print_boolean((2.0 + 35.75) != (17.0 + 0.25))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
