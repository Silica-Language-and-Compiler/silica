// expected failure E2018: binding 'done' has no type annotation
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(0.375 * 8.0 > 31.0 * 22.375);
                println("");
                _: atom <- print_boolean((5.5 - 29.25) <= 15.375);
                println("");
                done <- print_boolean(22.0 >= 23.25)
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
