// expected failure E1045: function 'main' declared without the fn keyword
// recursive steps on int8; steps(51, 0) = 51
use trial_support_int8;

fn steps(n: int8, acc: int8) -> int8 {
    case n == 0 of {
        true -> acc;
        false -> steps(n - 1, acc + 1)
    }
}

main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            steps(51, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 51
    end
}
