// expected failure E2018: binding 'result' has no type annotation
// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(3 / 20 > (47 - 38));
                println("");
                _: atom <- print_boolean(23 % 38 < 29);
                println("");
                _: atom <- print_boolean(5 * 43 == 59 / 31);
                println("");
                result <- print_boolean(8 / 45 != 11)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
