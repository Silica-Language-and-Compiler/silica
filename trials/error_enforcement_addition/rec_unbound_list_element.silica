// Q19 (data_structure_redesign_requirements.md §2 row Q19 and decision 38; chunk15_stack_memory_design.md §5.1,
// §11.1 phase 0): `rec` binds to its innermost enclosing TUPLE type, so a `rec` with no enclosing tuple type
// names no layout and is rejected with E2010 in every position (spec §4.2.2, recursive_tuple_specification.md §2).
// Here: a list element type `List[ref?(L, normal, rec), mem(normal)]` outside any tuple (inside a node tuple
// the same List binds to that node, as the brodal_okasaki and tree_rose nodes do).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                kids: List[ref?(L, normal, rec), mem(normal)] <- [];
                n: int64 <- case kids.is_nil of { true -> 0; false -> 1 }
            produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
