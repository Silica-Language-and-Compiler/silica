// expected failure E2005: boolean case missing its false branch
// recursive pow2 on int64; pow2(0) = 1
use trial_support_int64;

fn pow2(n: int64) -> int64 {
    case n == 0 of {
        true -> 1
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            pow2(0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
