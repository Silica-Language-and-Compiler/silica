// expected failure E1055: binding 'spare' is never used
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: alloc_buf with a literal size, write/read round-trip at index 4
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            spare: int64 <- 41;
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                buf: buf(L1, normal, int64, 12) <- alloc_buf(r, 12);
                _: atom <- write_buf(buf, 4, 186);
                value: int64 <- read_buf(buf, 4)
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
