// expected failure E1040: missing ';' between two statements
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(26.0 * 35.0 != 22.25);
                println("")
                done: atom <- print_boolean((3.0 - 8.75) >= (21.5 + 20.375))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
