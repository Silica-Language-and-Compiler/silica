// expected failure E1050: produces clause without pure
// print_int32 two; prints 1 then 4
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: int32 <- 37 / 27;
                b: int32 <- 43 % 13;
                _: atom <- print_int32(a);
                println("");
                result: atom <- print_int32(b)
            produces result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
