// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)]
                _: atom <- print_boolean(33.25 != 29.5);
                println("");
                _: atom <- print_boolean(9.0 >= (28.5 + 14.25));
                println("");
                _: atom <- print_boolean((28.5 + 24.5) > (40.5 - 1.0));
                println("");
                done: atom <- print_boolean(35.5 > 33.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
