// expected failure E3002: region operations under a device_io-only sequence
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: read_only on a ref in normal_writeback; expect 100
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal_writeback) <- alloc_region(normal_writeback);
                cell: ref(L1, normal_writeback, int64) <- alloc_ref(r, 100);
                value: int64 <- read_ref(cell)
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
