// expected failure E2002: undefined identifier 'missing_n'
// guards partition int64 into three ranges; n = 75 gives 37
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 75;
            case n of {
                n: int64 if n < 28 -> n - 1;
                n: int64 if n >= 28 and n < 33 -> missing_n + 100;
                n: int64 if n >= 33 -> n / 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
