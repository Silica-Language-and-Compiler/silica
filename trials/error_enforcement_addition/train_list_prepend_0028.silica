// expected failure E2001: string element prepended to an integer list
// 5 prepends after empty; head is 22
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)]("16", xs0);
                xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](19, xs1);
                xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](7, xs2);
                xs4: List[int64, mem(normal)] <- prepend[int64, mem(normal)](5, xs3);
                xs5: List[int64, mem(normal)] <- prepend[int64, mem(normal)](22, xs4);
                h: int64 <- head[int64, mem(normal)](xs5)
                produces pure h end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
