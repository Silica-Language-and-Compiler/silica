// expected failure E2003: sum bound as a boolean
// sequence prints and returns the same sum 58
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io] a: int64 <- 28;
                b: int64 <- 30;
                print_int64(a + b);
                println("");
                total: boolean <- a + b
                produces pure total end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
