// expected failure E1042: function 'main' has no return type
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(0 * 53 >= (36 / 18));
                println("");
                _: atom <- print_boolean(11 / 42 >= 22 / 12);
                println("");
                _: atom <- print_boolean(44 / 21 <= (14 + 44));
                println("");
                result: atom <- print_boolean(0 == 9 * 32)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
