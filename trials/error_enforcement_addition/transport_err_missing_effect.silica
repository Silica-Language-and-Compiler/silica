// E3013: encode is a transport operation (specification section 9.1.1, 16.4), so the sequence that
// calls it declares transport beside its allocation effect. This sequence declares mem(normal)
// and device_io but not transport; the allocation side is satisfied, the transport effect is not.
// Expected: E3013 "Transport operation without the transport effect" at the encode call.
// The accepted form is transport_addition/transport_etf_scalars.
use wire_etf;

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        f: string <- encode((:etf), 7);
        _: atom <- print_int64(length_bytes(f))
    produces
        pure 0
    end
}
