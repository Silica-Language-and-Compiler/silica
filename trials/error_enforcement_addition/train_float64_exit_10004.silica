// expected failure E1047: named struct declaration 'Pair' is not allowed
// main returns float64; exit code is trunc(22.75) = 22
use trial_support_float64;

struct Pair { x: int64, y: int64 }

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            22.75
        });
        _: int64 <- wait_for_exit()
    produces
        pure 22.75
    end
}
