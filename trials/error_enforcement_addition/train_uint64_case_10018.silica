// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint64 value 15; expect 40
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 15;
            case v of {
                "one" -> 157;
                29 -> 40;
                n: uint64 if n > 9 -> 40;
                _: uint64 -> 27
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 40
    end
}
