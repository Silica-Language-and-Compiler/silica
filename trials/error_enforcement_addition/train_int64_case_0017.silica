// expected failure E2005: string literal pattern against an integer scrutinee
// case on int64 value 23; expect 187
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v: int64 <- 23;
            case v of {
                :one -> 16;
                42 -> 107;
                7 -> 50;
                n: int64 if n > 7 -> 187;
                _: int64 -> 188
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
