// expected failure E1043: whitespace between binding name 'result' and ':'
// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(1 / 34 <= 20);
                println("");
                _: atom <- print_boolean(28 < 11 / 29);
                println("");
                _: atom <- print_boolean((49 / 38) >= 32);
                println("");
                result :atom <- print_boolean(24 <= 28 % 2)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
