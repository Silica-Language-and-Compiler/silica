// Error enforcement: function return List types must use mem(Space) (E2015).
use trial_support_int64;

fn empty_int64_list() -> List[int64] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            empty_int64_list();
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
