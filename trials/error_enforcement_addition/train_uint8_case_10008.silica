// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint8 value 25; expect 74
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            v: uint8 <- 25;
            case v of {
                :one -> 35;
                27 -> 47;
                32 -> 13;
                n: uint8 if n > 28 -> 82;
                _: uint8 -> 74
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 74
    end
}
