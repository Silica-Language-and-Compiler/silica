// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (((bnot one) band lo) + three) = 18
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            one: uint64 <- true;
            lo: uint64 <- 10;
            three: uint64 <- 10;
            (((bnot one) band lo) + three)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 18
    end
}
