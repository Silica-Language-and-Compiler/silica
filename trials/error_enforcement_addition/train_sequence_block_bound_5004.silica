// expected failure E2018: binding 'value' has no type annotation
// sequence result bound to a variable; expect 113
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            value <- sequence produces pure 76 end;
            value + 37
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
