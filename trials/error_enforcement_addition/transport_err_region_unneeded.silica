// E2402: only a type with a ref?(L, S, rec) slot decodes into a region; a fourth argument to the
// decode of a fixed type is an error (design §4.2).
use wire_etf;

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        frame: string <- encode((:etf), 7);
        r2: (:ok, int64) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 16 }, r);
        _: atom <- case r2 of {
            (:ok, w: int64) -> print_int64(w);
            (:rejected, why: atom) -> print_atom(why)
        }
    produces
        pure 0
    end
}
