// expected failure E1042: function 'main' has no return type
// case on uint32 value 15; expect 135
use trial_support_uint32;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            v: uint32 <- 15;
            case v of {
                2 -> 191;
                n: uint32 if n > 4 -> 135;
                _: uint32 -> 134
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 135
    end
}
