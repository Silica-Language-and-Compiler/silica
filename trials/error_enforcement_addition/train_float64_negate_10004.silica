// expected failure E1041: trailing ';' after the pure expression
// negate_float64 applied 2 time(s); prints 23.5
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float64(negate_float64(negate_float64(23.5)))
                produces pure result; end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
