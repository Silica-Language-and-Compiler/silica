use trial_support_int64;

module dangerous_retained_buf_compact_state_rejected;

// E4039 PinnedActorCompactsState (chunk 15 phase 7, the pin rule): a behaviour that allocates a buffer
// C keeps (alloc_buf_retained) must not call compact_state(), because compaction (design section 4.7)
// moves the nodes of the state area and the retained buffer's address must stay fixed for the actor's
// life. The state is an int64, so the release is proven; the compact_state() call alone is the error.

wrapper_meta "dangerous_exposure_source/good_retains_data_ptr.meta";

foreign c_wrapper "silica_retain_keep"
fn keep_raw(data_ptr: uint8, data_len: uint64) -> int64;

fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger, mem(normal)]
        L1: lifetime <- fresh_lifetime();
        bf: buf(L1, normal, uint8, 4) <- alloc_buf_retained(4);
        _: atom <- write_buf(bf, 0, 1);
        _: int64 <- keep_raw(bf);
        _: unit <- compact_state()
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                worker_ref: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(worker_ref, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
