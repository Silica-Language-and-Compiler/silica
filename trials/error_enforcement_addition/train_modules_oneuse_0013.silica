// expected failure E1009: use names a module that does not exist
// Spec §19.3: use lib_math_utils_spec; then a module-qualified call lib_math_utils_spec@multiply(5, 7) = 35
use lib_math_utils_spec_missing;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_math_utils_spec@multiply(5, 7)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
