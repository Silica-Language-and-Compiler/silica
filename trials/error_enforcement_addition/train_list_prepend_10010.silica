// expected failure E2018: binding 'xs1' has no type annotation
// 1 prepends after empty; length is 1
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
                xs1 <- prepend[int32, mem(normal)](8, xs0);
                n: int64 <- length[int32, mem(normal)](xs1)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
