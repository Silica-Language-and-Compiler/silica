// expected failure E2001: atom literal returned from the recursion base case
// recursive steps on int16; steps(28, 0) = 28
use trial_support_int16;

fn steps(n: int16, acc: int16) -> int16 {
    case n == 0 of {
        true -> :done;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            steps(28, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 28
    end
}
