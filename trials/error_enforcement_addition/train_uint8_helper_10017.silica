// expected failure E1055: binding 'unused_value' is never used
// helper combine/2 on uint8; combine(19, 19) = 38
use trial_support_uint8;

fn combine(x: uint8, y: uint8) -> uint8 {
    unused_value: int64 <- 41;
    (x + 19) / (y / 11)
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            combine(19, 19)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 38
    end
}
