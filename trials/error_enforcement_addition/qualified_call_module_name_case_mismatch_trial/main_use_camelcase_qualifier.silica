// `use PascalCaseLib;` matches the library file stem, but the call uses a different spelling (pascalCaseLib).
// Module checker: E1010 — qualified prefix must match the `use` line exactly (spec §19.3).
use PascalCaseLib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            pascalCaseLib@identity(1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
