// expected failure E2003: blend returns float32 but its result feeds print_float64
// float64 helper blend; prints 23.625
use trial_support_atom;

fn blend(x: float64) -> float32 {
    x * 2.0 + 3.125
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float64(blend(10.25))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
