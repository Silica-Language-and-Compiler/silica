// expected failure E2001: string literal in one case arm of an integer case
// case on int8 value 29; expect 123
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            v: int8 <- 29;
            case v of {
                29 -> "123";
                n: int8 if n > 24 -> 96;
                _: int8 -> 124
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 123
    end
}
