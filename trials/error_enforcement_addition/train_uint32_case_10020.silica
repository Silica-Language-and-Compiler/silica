// expected failure E2001: string literal in one case arm of an integer case
// case on uint32 value 22; expect 118
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            v: uint32 <- 22;
            case v of {
                35 -> "74";
                26 -> 195;
                n: uint32 if n > 23 -> 69;
                _: uint32 -> 118
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 118
    end
}
