// Spec §22.14.2 with §16.3.2: a timer's message is a cast's message, so it must satisfy ActorMessage
// (`expr impl ActorMessage {}`), as a cast's must (E2005).
fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        a: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        _: timer_ref <- send_after(10, a, 1)
    produces pure 0 end
}
