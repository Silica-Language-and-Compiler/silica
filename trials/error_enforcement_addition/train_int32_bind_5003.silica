// expected failure E2003: binding width declared int64 but used as int32
// int32 bindings then expression; expect 64
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            width: int64 <- 41 + 54 + 31 * 17;
            b: int32 <- width + 58;
            b - width + width % 8
        });
        _: int64 <- wait_for_exit()
    produces
        pure 64
    end
}
