// expected failure E1055: binding 'unused_value' is never used
// double_len("banana") = 12
use trial_support_int64;

fn double_len(s: string) -> int64 {
    unused_value: int64 <- 41;
    length_chars(s) * 2
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            double_len("banana")
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
