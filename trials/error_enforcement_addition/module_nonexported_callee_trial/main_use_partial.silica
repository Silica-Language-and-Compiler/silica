// Calls exported fn, then a module-qualified fn that exists in the library but is not exported.
use lib_one_export;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: int64 <- lib_one_export@published_inc(3);
            lib_one_export@not_exported_double(a)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}

