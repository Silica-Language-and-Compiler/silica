// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x"; _: atom <- print_boolean(label == (30 + 4) <= 46 % 22);
                println("");
                _: atom <- print_boolean(10 / 12 != 38 % 40);
                println("");
                _: atom <- print_boolean((52 + 53) > (19 % 57));
                println("");
                _: atom <- print_boolean(56 > 45 / 6);
                println("");
                result: atom <- print_boolean((47 + 19) == 53)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
