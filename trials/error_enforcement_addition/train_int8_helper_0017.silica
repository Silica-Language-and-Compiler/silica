// expected failure E2001: string literal passed where an integer parameter is expected
// helper mix/3 on int8; mix(3, 18, 17) = 5
use trial_support_int8;

fn mix(x: int8, y: int8, z: int8) -> int8 {
    (y + z) % (x + x)
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            mix("3", 18, 17)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 5
    end
}
