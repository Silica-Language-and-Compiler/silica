// expected failure E2003: reply bound to a string variable
// Spec §15.1.1: two actor_ref values from spawn; each replies independently
use trial_support_atom;

fn adder(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn doubler(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg * 2, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                a: actor_ref <- spawn(1, adder, stack_policy(0, :keep_last_message));
                b: actor_ref <- spawn(7, doubler, stack_policy(0, :keep_last_message));
                ra: string <- call(a, 3 impl ActorMessage {});
                rb: int64 <- call(b, 2 impl ActorMessage {});
                print_int64(ra + rb);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
