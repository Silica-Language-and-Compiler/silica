// expected failure E2003: binding count declared int64 but used as int8
// int8 bindings then expression; expect 44
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            count: int64 <- 22 - 60 / 21;
            m: int8 <- count;
            m + m - (35 - 39)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 44
    end
}
