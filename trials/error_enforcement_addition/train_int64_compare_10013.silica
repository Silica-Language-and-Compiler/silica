// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == (51 - 34) != 7);
                println("");
                _: atom <- print_boolean(32 > 26 * 55);
                println("");
                _: atom <- print_boolean(56 / 30 == (4 + 26));
                println("");
                _: atom <- print_boolean((37 + 9) < 58 * 19);
                println("");
                result: atom <- print_boolean(11 / 44 <= (57 - 0))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
