// expected failure E1055: binding 'leftover' is never used
// ends_with prints true
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            leftover: int64 <- 41;
            sequence proc[device_io] s: string <- "silica compiler";
                result: atom <- print_boolean(ends_with(s, "ler"))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
