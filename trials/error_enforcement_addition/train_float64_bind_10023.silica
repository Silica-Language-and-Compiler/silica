// expected failure E2003: a declared float32 but combined with a float64 value
// float64 bindings 18.5 - 40.375 printed as -21.875
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: float32 <- 18.5;
                b: float64 <- 40.375;
                result: atom <- print_float64(a - b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
