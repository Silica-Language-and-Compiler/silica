// expected failure E4015: function 'swap' defined twice
// swap((7, 18)); second = 7
use trial_support_int64;

fn swap(p: (int64, int64)) -> (int64, int64) {
    (x: int64, y: int64) <- p;
    (y, x)
}

fn swap(p: (int64, int64)) -> (int64, int64) {
    (x: int64, y: int64) <- p;
    (y, x)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (first: int64, second: int64) <- swap((7, 18));
            second
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
