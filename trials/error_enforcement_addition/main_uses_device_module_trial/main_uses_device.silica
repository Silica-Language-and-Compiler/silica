// expected failure E2230: a module that uses a device_* module without carrying the device_ prefix (device spec §3.1)
use device_plain_lib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            device_plain_lib@ping()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
