// expected failure E1055: binding 'unused_value' is never used
// head on [2, 3, 14] gives 2
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            unused_value: int64 <- 41;
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [2, 3, 14];
                first: int64 <- head[int64, mem(normal)](xs)
            produces pure first end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
