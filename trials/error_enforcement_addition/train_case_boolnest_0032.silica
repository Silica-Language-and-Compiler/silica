// expected failure E2018: binding 'b' has no type annotation
// nested boolean cases; (false, true) selects 21
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- false;
            b <- true;
            case a of {
                true -> case b of {
                    true -> 37;
                    false -> 96
                };
                false -> case b of {
                    true -> 21;
                    false -> 35
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
