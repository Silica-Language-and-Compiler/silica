// expected failure E2005: string literal pattern against an integer scrutinee
// case on int64 value 37; expect 160
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v: int64 <- 37;
            case v of {
                true -> 88;
                3 -> 49;
                26 -> 142;
                n: int64 if n > 4 -> 160;
                _: int64 -> 34
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
