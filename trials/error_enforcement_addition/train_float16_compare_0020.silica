// expected failure E1040: missing ';' between two statements
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(40.25 < 0.5);
                println("");
                _: atom <- print_boolean(18.0 * 1.5 <= 40.0);
                println("")
                done: atom <- print_boolean(12.5 >= (9.75 + 39.25))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
