// E2410: (:cbor) is a wire protocol the language names (design §8) but this build's transport pack
// does not provide (design §6.0); the target's verifier rejects the derived call.
fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        f: string <- encode((:cbor), 7);
        _: atom <- print_int64(length_bytes(f))
    produces
        pure 0
    end
}
