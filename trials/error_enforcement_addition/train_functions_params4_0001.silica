// expected failure E1042: function 'sum4' has no return type
// function with 4 parameter(s); sum4(24, 0, 10, 13) = 47
use trial_support_uint16;

fn sum4(a: uint16, b: uint16, c: uint16, d: uint16) {
    a + b + c + d
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            sum4(24, 0, 10, 13)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 47
    end
}
