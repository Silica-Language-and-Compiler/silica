// expected failure E2011: 0x1FFFFFFFFFFFFFFFF (65 bits) does not fit int64, nor any 64-bit accumulator the checker could use
use trial_support_atom;

fn big() -> int64 {
    0x1FFFFFFFFFFFFFFFF
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_int64(big())
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
