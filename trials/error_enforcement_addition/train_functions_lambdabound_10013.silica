// expected failure E1055: binding 'leftover' is never used
// function literal bound to a typed variable; f(21) = 42
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            leftover: int64 <- 41;
            f: fn(int64) -> int64 <- fn(x: int64) -> int64 { x * 2 };
            f(21)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
