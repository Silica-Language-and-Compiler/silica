// expected failure E1055: binding 'temp_val' is never used
// int8 arithmetic: 13 = 13
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            temp_val: int64 <- 41;
            13
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
