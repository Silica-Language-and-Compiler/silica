// expected failure E2001: integer literal returned from a boolean function
// main returns boolean false; exit code 0
use trial_support_boolean;

fn main() -> boolean {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_boolean@start();
        _: boolean <- trial_support_boolean@run(fn() -> boolean {
            1
        });
        _: int64 <- wait_for_exit()
    produces
        pure false
    end
}
