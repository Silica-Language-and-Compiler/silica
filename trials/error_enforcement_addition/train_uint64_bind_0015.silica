// expected failure E1055: binding 'leftover' is never used
// uint64 bindings then expression; expect 86
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            leftover: int64 <- 41;
            c: uint64 <- 48 * 13 % (17 * 7);
            d: uint64 <- (c + 57);
            b: uint64 <- c;
            m: uint64 <- c % d + c % b;
            c - m + d
        });
        _: int64 <- wait_for_exit()
    produces
        pure 86
    end
}
