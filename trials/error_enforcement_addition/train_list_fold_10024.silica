// expected failure E2005: list case pattern typed with the wrong element type
// count over [35, 28, 7, 3] = 4
use trial_support_int64;

fn count(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [_: string, t: List[int64, mem(normal)]] -> 1 + count(t);
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [35, 28, 7, 3];
                r: int64 <- count(xs)
                produces pure r end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
