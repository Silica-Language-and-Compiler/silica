use trial_support_int64;

module dangerous_buffer_in_spawn_initial_state_rejected;

// E4038 BufferInSpawnInitialState (chunk 15 phase 7, Lee 2026-11-01): a buffer never crosses an actor
// boundary, and a spawn's initial state is built by the spawner. The child must create its own buffers
// inside its own dangerous sequence. The initial state here is a buffer the spawner allocated, and is
// rejected at the initial-state argument.

fn ffi_worker(msg: int64, state: (region(L1, normal), buf(L1, normal, uint8, 4))) -> (:no_reply, (region(L1, normal), buf(L1, normal, uint8, 4))) {
    sequence proc[external_danger]
        _: int64 <- 0
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                bf: buf(L1, normal, uint8, 4) <- alloc_buf(r, 4);
                worker_ref: dangerous_actor_ref <- spawn_dangerous((r, bf), ffi_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(worker_ref, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
