// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name only if, where the
// literal is written, the name is bound to an integer literal by an integer-typed binding.
// n is bound to the literal 3, then shadowed by the tuple decomposition (n, z) <- (k, m), so where
// the literal is written n holds the parameter k's value, not an integer literal.

fn take(op: fn(a: int64) -> int64) -> int64 {
    op(1)
}

fn choose_val(k: int64) -> int64 {
    n: int64 <- 3;
    m: int64 <- n;
    (n: int64, z: int64) <- (k, m);
    take(fn(x: int64) -> int64 { x + n }) + z
}

fn main() -> int64 {
    choose_val(9)
}
