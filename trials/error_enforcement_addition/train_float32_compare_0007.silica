// expected failure E1054: extra end after the sequence block
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((27.25 + 12.375) <= 17.75);
                println("");
                _: atom <- print_boolean((22.0 + 37.75) == (32.5 - 1.0));
                println("");
                done: atom <- print_boolean(20.5 >= 4.0)
                produces pure done end end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
