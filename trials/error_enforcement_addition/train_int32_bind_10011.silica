// expected failure E2002: undefined identifier 'bs'
// int32 bindings then expression; expect 0
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            step: int32 <- 24 + (48 + 6);
            m: int32 <- 9 / step;
            c: int32 <- m;
            b: int32 <- 30;
            c + bs - b
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
