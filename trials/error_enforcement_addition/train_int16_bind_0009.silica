// expected failure E2003: binding m declared uint8 but used as int16
// int16 bindings then expression; expect 28
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            m: uint8 <- 23 * 60;
            a: int16 <- m + 59;
            count: int16 <- 28;
            count + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 28
    end
}
