// expected failure E2225: cast of a device_actor_ref through the ordinary cast (device spec §4.1, §4.5)
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                d: device_actor_ref <- spawn_device(0, worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast(d, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
