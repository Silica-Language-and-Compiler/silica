// expected failure E2003: binding count declared int64 but used as uint64
// uint64 bindings then expression; expect 20
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            count: int64 <- 32 + 54;
            d: uint64 <- (count + 9) * (count - count);
            k: uint64 <- (33 + count) * 39;
            a: uint64 <- 20;
            a + d - d + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 20
    end
}
