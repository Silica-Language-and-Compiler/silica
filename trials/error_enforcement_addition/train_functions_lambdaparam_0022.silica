// expected failure E2005: call to unknown function 'apply_paiz'
// function literal passed as a parameter, capturing z; expect 16
use trial_support_int64;

fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            z: int64 <- 4;
            apply_paiz(6, fn(a: int64, b: int64) -> int64 {
                a + b + z
            })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
