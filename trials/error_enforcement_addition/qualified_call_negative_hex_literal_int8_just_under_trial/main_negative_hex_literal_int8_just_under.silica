// A negative hexadecimal literal one step below a narrow width through a module-qualified call:
// -0x81 is -129, below the int8 minimum -0x80, so this is E2011.
use LiteralLib;
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            LiteralLib@next_i8(-0x81)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
