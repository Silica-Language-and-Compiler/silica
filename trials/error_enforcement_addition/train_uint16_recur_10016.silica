// expected failure E1041: trailing ';' after the block's final expression
// recursive digit_count on uint16; digit_count(111) = 3
use trial_support_uint16;

fn digit_count(n: uint16) -> uint16 {
    case n < 10 of {
        true -> 1;
        false -> 1 + digit_count(n / 10)
    };
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            digit_count(111)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
