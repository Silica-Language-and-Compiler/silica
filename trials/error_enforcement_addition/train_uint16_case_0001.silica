// expected failure E1042: function 'main' has no return type
// case on uint16 value 11; expect 138
use trial_support_uint16;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 11;
            case v of {
                26 -> 29;
                22 -> 10;
                13 -> 153;
                19 -> 97;
                n: uint16 if n > 28 -> 133;
                _: uint16 -> 138
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 138
    end
}
