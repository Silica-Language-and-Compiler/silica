// Spec §15.4.13.4 "Handler before any start" (E2236), the exemption's reach: only a spawn bound to a
// name that the same function passes to register_failure_reporter (or written as its argument) is
// exempt. Here a helper creates the reporter and main registers it, so the helper's spawn is a start
// before registration, reported at main's call to the helper.

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn make_reporter() -> actor_ref {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message))
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        r: actor_ref <- make_reporter();
        _: atom <- register_failure_reporter(r);
        _: actor_ref <- spawn(0, work, stack_policy(0, :keep_last_message));
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
