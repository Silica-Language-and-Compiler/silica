// expected failure E1060: unbalanced braces
// case on string literals; "other" gives 44
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "other";
            case mode of {
                "north" -> 24;
                "region" -> 96;
                "banana" -> 88;
                _: string -> 44
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}}
