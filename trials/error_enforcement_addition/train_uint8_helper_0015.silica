// expected failure E2003: parameter x declared uint16 in a uint8 helper
// helper adjust/2 on uint8; adjust(17, 18) = 17
use trial_support_uint8;

fn adjust(x: uint16, y: uint8) -> uint8 {
    x % y
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            adjust(17, 18)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 17
    end
}
