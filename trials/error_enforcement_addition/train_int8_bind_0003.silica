// expected failure E1042: function 'main' has no return type
// int8 bindings then expression; expect 17
use trial_support_int8;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            base: int8 <- 4 * 17;
            b: int8 <- base;
            width: int8 <- 6 % base;
            m: int8 <- 17;
            m + b - b + width - width
        });
        _: int64 <- wait_for_exit()
    produces
        pure 17
    end
}
