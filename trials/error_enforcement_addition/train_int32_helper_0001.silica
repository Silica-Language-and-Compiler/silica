// expected failure E1070: scale given nine parameters
// helper scale/3 on int32; scale(12, 13, 10) = 1
use trial_support_int32;

fn scale9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn scale(x: int32, y: int32, z: int32) -> int32 {
    y / z / (x / z)
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            scale(12, 13, 10)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
