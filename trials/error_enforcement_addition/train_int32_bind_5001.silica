// expected failure E2003: binding a declared int16 but used as int32
// int32 bindings then expression; expect 16
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            a: int16 <- 51;
            height: int32 <- 7 * 11;
            m: int32 <- (height - 39);
            16 + a - a + m - m
        });
        _: int64 <- wait_for_exit()
    produces
        pure 16
    end
}
