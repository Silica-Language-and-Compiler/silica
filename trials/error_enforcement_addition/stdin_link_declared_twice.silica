// E2415: standard input is one reader's: two carried_on declarations of the (:stdin) link name the same
// hardware (stdin_carrier_design.md section 2, principle 4; links design decisions 6 and 17).
carried_on first_reader: (:serial) (:stdin);
carried_on second_reader: (:serial) (:stdin);

fn main() -> int64 {
    0
}
