// Spec §16.3.2 / §5: a case expression used as the message operand of call is a marked message
// only when every arm carries `impl ActorMessage {}`. Here the false arm is unmarked, so the
// operand does not implement ActorMessage: E2005 at the case operand.
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + 1, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
                flag: boolean <- true;
                r: int64 <- call(w, case flag of {
                    true -> 5 impl ActorMessage {};
                    false -> 7
                })
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
