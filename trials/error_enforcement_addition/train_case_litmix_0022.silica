// expected failure E1041: trailing ';' after the block's final expression
// literal patterns, a guard and a typed wildcard on int32; v = 3 gives 48
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 3;
            case v of {
                4 -> 22;
                6 -> 21;
                11 -> 39;
                m: int32 if m > 11 -> 9;
                _: int32 -> 48
            };
        });
        _: int64 <- wait_for_exit()
    produces
        pure 48
    end
}
