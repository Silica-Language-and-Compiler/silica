// expected failure E2001: string literal in one case arm of an integer case
// case on int16 value 22; expect 171
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            v: int16 <- 22;
            case v of {
                41 -> "169";
                0 -> 91;
                19 -> 26;
                8 -> 66;
                n: int16 if n > 10 -> 171;
                _: int16 -> 199
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 171
    end
}
