// expected failure E2001: string literal used as a list index
// list_at index 1 of [22, 34, 0] is 34
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [22, 34, 0];
                v: int64 <- list_at[int64, mem(normal)](xs, "1")
            produces
                pure v
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
