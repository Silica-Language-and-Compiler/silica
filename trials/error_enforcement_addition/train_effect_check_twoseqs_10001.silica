// expected failure E3010: second sequence declares device_io it never uses
// Positive: two sequences with separate effect declarations in one function
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(1);
                println("")
            produces pure :ok end;
            n: int64 <- sequence proc[mem(normal), device_io]
                xs: List[int64, mem(normal)] <- [1, 0]
            produces
                pure length[int64, mem(normal)](xs)
            end;
            n
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
