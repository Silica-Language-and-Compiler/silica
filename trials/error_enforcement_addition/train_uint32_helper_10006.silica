// expected failure E2005: call to unknown function 'adjust_all'
// helper adjust/2 on uint32; adjust(16, 20) = 81
use trial_support_uint32;

fn adjust(x: uint32, y: uint32) -> uint32 {
    (y + x + 45)
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            adjust_all(16, 20)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 81
    end
}
