// Spec §15.4.13.4 "Handler before any start" (E2236), branches: after a case, registration counts as
// done only if every arm registers. One arm registers and the other does not, so the worker's spawn
// after the case can run unregistered and is reported.

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn pick() -> int64 {
    3
}

fn main() -> int64 {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- case pick() of {
            3 -> register_failure_reporter(r);
            _: int64 -> :ok
        };
        _: actor_ref <- spawn(0, work, stack_policy(0, :keep_last_message));
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
