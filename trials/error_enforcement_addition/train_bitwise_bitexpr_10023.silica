// expected failure E2001: boolean literal used as a bitwise operand
// uint64 bitwise: (one bor lo) bor seven = 15
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            one: uint64 <- true;
            lo: uint64 <- 10;
            seven: uint64 <- 12;
            (one bor lo) bor seven
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
