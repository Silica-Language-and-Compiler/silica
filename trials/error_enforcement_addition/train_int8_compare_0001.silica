// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == 42 % 36 >= (50 + 53));
                println("");
                _: atom <- print_boolean((2 + 8) == 17 / 6);
                println("");
                _: atom <- print_boolean((41 / 55) == 28);
                println("");
                result: atom <- print_boolean(11 * 2 > 36)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
