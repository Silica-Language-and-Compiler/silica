// expected failure E2013: unary minus on a variable instead of negate_int8
// int8 bindings then expression; expect 26
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            a: int8 <- 21;
            d: int8 <- a;
            m: int8 <- a;
            count: int8 <- 26;
            -a + count + d - d + m - m
        });
        _: int64 <- wait_for_exit()
    produces
        pure 26
    end
}
