// expected failure E2003: binding height declared uint8 but used as int64
// int64 bindings then expression; expect 31
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            height: uint8 <- 33;
            base: int64 <- (height + (height + 8));
            31 + base - base
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
