// expected failure E1043: whitespace between binding name 'bit_index' and ':'
// set, test and clear bit 9 of a uint64 word; expect 1
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            one: uint64 <- 1;
            zero: uint64 <- 0;
            bit_index :int64 <- 9;
            mask: uint64 <- one shl bit_index;
            word: uint64 <- zero bor mask;
            present: uint64 <- (word band mask) shr bit_index;
            cleared: uint64 <- word band (bnot mask);
            present + cleared
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
