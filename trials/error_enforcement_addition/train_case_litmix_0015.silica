// expected failure E1041: trailing ';' after the block's final expression
// literal patterns, a guard and a typed wildcard on uint64; v = 6 gives 46
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 6;
            case v of {
                7 -> 43;
                11 -> 49;
                0 -> 22;
                m: uint64 if m > 11 -> 16;
                _: uint64 -> 46
            };
        });
        _: int64 <- wait_for_exit()
    produces
        pure 46
    end
}
