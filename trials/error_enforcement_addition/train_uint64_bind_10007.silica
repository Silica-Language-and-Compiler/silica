// expected failure E2018: binding 'width' has no type annotation
// uint64 bindings then expression; expect 54
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            width <- 35 + 50 + 23 % 32;
            a: uint64 <- width;
            a / (width / 52)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 54
    end
}
