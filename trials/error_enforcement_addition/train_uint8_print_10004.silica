// expected failure E2003: value is uint8 but passed to print_int16
// print_uint8 var; prints 21
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] value: uint8 <- 40 - 19;
                result: atom <- print_int16(value)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
