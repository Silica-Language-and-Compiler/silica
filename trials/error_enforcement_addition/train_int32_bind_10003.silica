// expected failure E2013: unary minus on a variable instead of negate_int32
// int32 bindings then expression; expect 59
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            c: int32 <- 18 / 5;
            count: int32 <- c + 53;
            width: int32 <- 40;
            b: int32 <- c;
            -c + count + count / 17 + width - width + b - b
        });
        _: int64 <- wait_for_exit()
    produces
        pure 59
    end
}
