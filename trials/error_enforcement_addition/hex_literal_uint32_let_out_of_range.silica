// expected failure E2011: 0xFFFFFFFFF has 36 bits, past the uint32 maximum 0xFFFFFFFF; the range
// check reads the hex digits by their radix, not as the decimal digits that appear in the text
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                x: uint32 <- 0xFFFFFFFFF;
                r: atom <- print_uint32(x)
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
