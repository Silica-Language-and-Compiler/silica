// expected failure E2005: call to unknown function 'print_uint64x'
// print_uint64 of 35 band 21 = 1
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: uint64 <- 35;
                b: uint64 <- 21;
                result: atom <- print_uint64x(a band b)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
