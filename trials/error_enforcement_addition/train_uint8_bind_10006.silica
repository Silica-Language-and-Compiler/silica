// expected failure E1045: function 'main' declared without the fn keyword
// uint8 bindings then expression; expect 105
use trial_support_uint8;

main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            b: uint8 <- 2;
            height: uint8 <- 55;
            base: uint8 <- height + 14;
            base - b + 38
        });
        _: int64 <- wait_for_exit()
    produces
        pure 105
    end
}
