// expected failure E2005: wrong argument count in call to 'sum_acc'
// recursive sum_acc over a list; total 18
use trial_support_int64;

fn sum_acc(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> acc;
        [h: int64, t: List[int64, mem(normal)]] -> sum_acc(t);
        _: List[int64, mem(normal)] -> acc
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [14, 4];
                total: int64 <- sum_acc(xs, 0)
            produces pure total end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
