// expected failure E2003: parameter x declared int8 in a uint64 helper
// helper compute/1 on uint64; compute(3) = 3
use trial_support_uint64;

fn compute(x: int8) -> uint64 {
    x
}

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            compute(3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
