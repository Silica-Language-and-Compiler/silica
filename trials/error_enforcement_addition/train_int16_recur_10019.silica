// expected failure E1042: function 'pow2' has no return type
// recursive pow2 on int16; pow2(4) = 16
use trial_support_int16;

fn pow2(n: int16) -> {
    case n == 0 of {
        true -> 1;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            pow2(4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 16
    end
}
