// expected failure E2003: length_bytes result printed with print_string
// length_bytes of a bound string prints 7
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                text: string <- "ñandú";
                result: atom <- print_string(length_bytes(text))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
