// E1040: a binding with no right-hand side as the last statement of a sequence body, before
// `produces`. Before 2026-10-08 this compiled; only a binding followed by another statement was caught.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("x");
                x: int64 <- ;
            produces
                pure x
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
