// expected failure E1047: named struct declaration 'Pair' is not allowed
// uint64 bitwise: (seven band flags) band mask = 8
use trial_support_uint64;

struct Pair { x: int64, y: int64 }

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            seven: uint64 <- 12;
            flags: uint64 <- 8;
            mask: uint64 <- 13;
            (seven band flags) band mask
        });
        _: int64 <- wait_for_exit()
    produces
        pure 8
    end
}
