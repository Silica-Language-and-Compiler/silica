// expected failure E2001: string literal in one case arm of an integer case
// case on uint8 value 28; expect 194
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            v: uint8 <- 28;
            case v of {
                17 -> "115";
                27 -> 151;
                11 -> 0;
                22 -> 85;
                n: uint8 if n > 22 -> 194;
                _: uint8 -> 131
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 194
    end
}
