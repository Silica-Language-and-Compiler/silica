// expected failure E1050: produces clause without pure
// sequence prints and returns the same sum 12
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io] a: int64 <- 6;
                b: int64 <- 6;
                print_int64(a + b);
                println("");
                total: int64 <- a + b
                produces total end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
