// expected failure E1045: function 'main' declared without the fn keyword
// uint16 comparisons printed with print_boolean
use trial_support_atom;

main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((2 % 53) >= 33 * 8);
                println("");
                _: atom <- print_boolean((46 - 24) > (43 / 18));
                println("");
                _: atom <- print_boolean((40 + 3) != 2);
                println("");
                _: atom <- print_boolean(3 * 42 >= (14 - 10));
                println("");
                result: atom <- print_boolean(59 % 33 != 34)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
