// expected failure E2001: integer literal passed to concatenate
// concatenate of 4 pieces prints αβγchairalphariver

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "αβγ";
                b: string <- "chair";
                s: string <- concatenate(a, b);
                s0: string <- concatenate(s, "alpha");
                s1: string <- concatenate(s0, 5);
                print_string(s1);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
