// expected failure E2003: shift amount literal 64 is out of range 0..63
// shifts: (seed shl 4) + (wide shr 3) = 104
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            seed: uint64 <- 5;
            wide: uint64 <- 198;
            (seed shl 64) + (wide shr 3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 104
    end
}
