// expected failure E1010: module-qualified call without `use lib_math_utils_spec`
// Spec §19.3: use lib_math_utils_spec; then a module-qualified call lib_math_utils_spec@add(14, 0) = 14
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_math_utils_spec@add(14, 0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
