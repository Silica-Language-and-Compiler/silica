// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 3 gives 27
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 3;
            case v of {
                :3 -> 27;
                9 -> 9;
                7 -> 14;
                m: int32 if m > 14 -> 42;
                _: int32 -> 18
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 27
    end
}
