// expected failure E1055: binding 'temp_val' is never used
// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_beta@twice(15) + lib_math_utils_spec@multiply(5, 2) = 40
use trial_support_int64;

use lib_beta, lib_math_utils_spec;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            temp_val: int64 <- 41;
            lib_beta@twice(15) + lib_math_utils_spec@multiply(5, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
