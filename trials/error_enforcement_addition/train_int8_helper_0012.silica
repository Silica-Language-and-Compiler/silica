// expected failure E1055: binding 'scratch' is never used
// helper blend/1 on int8; blend(10) = 10
use trial_support_int8;

fn blend(x: int8) -> int8 {
    scratch: int64 <- 41;
    x
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            blend(10)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 10
    end
}
