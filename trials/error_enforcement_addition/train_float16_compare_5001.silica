// expected failure E1040: missing ';' between two statements
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(39.5 != (41.5 + 39.0));
                println("")
                _: atom <- print_boolean((5.5 - 2.0) <= 15.0 * 14.25);
                println("");
                _: atom <- print_boolean(27.25 == 10.75);
                println("");
                done: atom <- print_boolean((30.5 - 28.0) == (20.25 + 9.5))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
