// expected failure E1051: sequence block without a closing end
// qualified call bound then printed; prints 45
use lib_arity;
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                v: int64 <- lib_arity@add3(20, 15, 10);
                result: atom <- print_int64(v)
            produces pure result
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
