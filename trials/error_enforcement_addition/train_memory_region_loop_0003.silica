// expected failure E3001: region allocated outside any sequence block
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: a region allocated per call is released at scope exit; 32 iterations sum to 528
use trial_support_int64;

fn local_one(n: int64) -> int64 {
    L1: lifetime <- fresh_lifetime();
    r: region(L1, normal) <- alloc_region(normal);
    cell: ref(L1, normal, int64) <- alloc_ref(r, n);
    read_ref(cell)
}

fn loop_local(i: int64, acc: int64) -> int64 {
    case i <= 0 of {
        true -> acc;
        false -> loop_local(i - 1, acc + local_one(i))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                total: int64 <- loop_local(32, 0)
            produces
                pure case total == 528 of { true -> 0; false -> 1 }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
