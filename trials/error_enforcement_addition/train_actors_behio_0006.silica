// expected failure E3001: behavior prints without a sequence block
// Behavior prints inside its own sequence proc[device_io] before replying
use trial_support_atom;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    print_int64(msg);
    (:reply, msg * 5, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
                r: int64 <- call(w, 3 impl ActorMessage {});
                print_int64(r);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
