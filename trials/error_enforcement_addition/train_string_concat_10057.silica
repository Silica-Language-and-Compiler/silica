// expected failure E2003: string binding used where an integer is expected
// concatenate of 4 pieces prints riverrivercloud日本語

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "river";
                b: string <- "river";
                s: string <- concatenate(a, b);
                s0: string <- concatenate(s, "cloud");
                s1: string <- concatenate(s0, "日本語");
                print_int64(s1);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
