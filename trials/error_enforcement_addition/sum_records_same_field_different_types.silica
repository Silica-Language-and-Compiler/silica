// `{ x: int64 } | { x: string }` as a parameter type: the same field name with different field types
// is E2009 (spec §3.4.2). The shape word counts field types, so the two variants cannot be told
// apart by field name alone; the sum is rejected where it is written.

use trial_support_int64;

fn size(s: { x: int64 } | { x: string }) -> int64 {
    case s of {
        { x: n: int64 } -> n;
        { x: t: string } -> length_bytes(t)
    }
}

fn mk_int(n: int64) -> { x: int64 } | { x: string } {
    { x: n }
}

fn mk_str(t: string) -> { x: int64 } | { x: string } {
    { x: t }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(size(mk_int(42)));
                println("");
                print_int64(size(mk_str("abc")));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
