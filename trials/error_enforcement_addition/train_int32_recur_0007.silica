// expected failure E1055: binding 'leftover' is never used
// recursive digit_count on int32; digit_count(61) = 2
use trial_support_int32;

fn digit_count(n: int32) -> int32 {
    leftover: int64 <- 41;
    case n < 10 of {
        true -> 1;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            digit_count(61)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
