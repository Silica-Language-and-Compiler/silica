// expected failure E4015: function 'scale' defined twice
// helper scale/3 on int8; scale(5, 20, 12) = 0
use trial_support_int8;

fn scale(x: int8, y: int8, z: int8) -> int8 {
    (y - z) / (x + x)
}

fn scale(x: int8, y: int8, z: int8) -> int8 {
    (y - z) / (x + x)
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            scale(5, 20, 12)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
