// expected failure E2005: wrong argument count in call to 'status'
// helper returning :ok for positive input
use trial_support_atom;

fn status(n: int64) -> atom {
    case n > 0 of {
        true -> :ok;
        false -> :red
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            status()
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
