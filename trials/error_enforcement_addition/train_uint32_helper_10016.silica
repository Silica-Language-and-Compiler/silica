// expected failure E2003: parameter x declared int16 in a uint32 helper
// helper adjust/1 on uint32; adjust(12) = 12
use trial_support_uint32;

fn adjust(x: int16) -> uint32 {
    x
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            adjust(12)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 12
    end
}
