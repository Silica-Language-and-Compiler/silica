// expected failure E2018: binding 'done' has no type annotation
// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(34.0 == 24.125);
                println("");
                _: atom <- print_boolean((11.5 + 20.0) > (25.5 - 1.75));
                println("");
                _: atom <- print_boolean(24.5 > (27.25 - 2.25));
                println("");
                done <- print_boolean(6.0 * 22.25 > (38.0 - 25.5))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
