// A hexadecimal literal one step past a narrow width through a module-qualified call: 0x1FF does
// not fit the uint8 parameter (maximum 0xFF), so this is E2011.
use LiteralLib;
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            LiteralLib@next_u8(0x1FF)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
