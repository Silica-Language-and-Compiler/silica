// expected failure E1045: function 'double_len' declared without the fn keyword
// double_len("delta") = 10
use trial_support_int64;

double_len(s: string) -> int64 {
    length_chars(s) * 2
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            double_len("delta")
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
