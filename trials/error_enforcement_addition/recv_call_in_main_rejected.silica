// recv() is runtime-internal (spec section 15.1.2). A call to recv() in main is rejected at compile time.
// Expected: E2005 "recv() is runtime-internal only; user code cannot call recv (§15.1.2)" at the call.

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        got: int64 <- recv()
    produces
        pure 0
    end
}
