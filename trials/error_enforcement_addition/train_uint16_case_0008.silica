// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint16 value 33; expect 42
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            v: uint16 <- 33;
            case v of {
                "one" -> 159;
                27 -> 163;
                42 -> 193;
                41 -> 89;
                n: uint16 if n > 9 -> 42;
                _: uint16 -> 7
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 42
    end
}
