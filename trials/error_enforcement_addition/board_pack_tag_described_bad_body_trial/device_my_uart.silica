// expected failure E2202 on every target: a description of (:esp32s3_uart), a board-pack device tag, whose
// body has a non-literal field. The body checks run before the board-pack rule (device spec §4.9 rule 5,
// E2239), so the ESP32-S3_raw target reports E2202 too.
use DeviceDescription;
use trial_support_int64;

fn fifo_offset() -> uint64 {
    0x00
}

impl fn registers(device: (:esp32s3_uart)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :fifo,   offset: fifo_offset(), width: 32, access: :read_write },
        { name: :status, offset: 0x1C, width: 32, access: :read_only }
    ]
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
