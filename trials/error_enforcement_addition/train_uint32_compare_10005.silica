// expected failure E2018: binding 'result' has no type annotation
// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(33 % 13 != 59 / 48);
                println("");
                _: atom <- print_boolean((16 + 27) <= 55);
                println("");
                _: atom <- print_boolean((34 % 4) != (52 + 10));
                println("");
                _: atom <- print_boolean(45 < 15 % 46);
                println("");
                result <- print_boolean(7 > (51 + 26))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
