// expected failure E2018: binding 'two' has no type annotation
// uint64 bitwise: ((hi bor seven) + two) = 28
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            hi: uint64 <- 15;
            seven: uint64 <- 8;
            two <- 13;
            ((hi bor seven) + two)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 28
    end
}
