// expected failure E2018: binding 'v' has no type annotation
// literal patterns, a guard and a typed wildcard on int32; v = 0 gives 4
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v <- 0;
            case v of {
                5 -> 8;
                14 -> 43;
                3 -> 17;
                m: int32 if m > 13 -> 30;
                _: int32 -> 4
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 4
    end
}
