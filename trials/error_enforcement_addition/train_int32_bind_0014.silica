// expected failure E2013: unary minus on a variable instead of negate_int32
// int32 bindings then expression; expect 0
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            k: int32 <- 27;
            width: int32 <- 0;
            -k + width + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
