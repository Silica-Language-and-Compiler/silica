// expected failure E2002: undefined identifier 'missing_n'
// recursive tri_acc on uint16; tri_acc(13, 0) = 91
use trial_support_uint16;

fn tri_acc(n: uint16, acc: uint16) -> uint16 {
    case n == 0 of {
        true -> acc;
        false -> tri_acc(n - 1, acc + missing_n)
    }
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            tri_acc(13, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 91
    end
}
