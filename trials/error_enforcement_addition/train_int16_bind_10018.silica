// expected failure E1045: function 'main' declared without the fn keyword
// int16 bindings then expression; expect 17
use trial_support_int16;

main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            m: int16 <- 29 - 6;
            c: int16 <- 19 / m + m * 49;
            d: int16 <- c % (46 + m);
            17 + d - d
        });
        _: int64 <- wait_for_exit()
    produces
        pure 17
    end
}
