// expected failure E1042: function 'main' has no return type
// main returns float32; exit code is trunc(37.0 - (34.0 - 40.0)) = 43
use trial_support_float32;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float32@start();
        _: boolean <- trial_support_float32@run(fn() -> float32 {
            37.0 - (34.0 - 40.0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 43.0
    end
}
