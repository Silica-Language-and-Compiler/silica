// expected failure E2003: parameter x declared int8 in a uint16 helper
// helper mix/2 on uint16; mix(6, 9) = 154
use trial_support_uint16;

fn mix(x: int8, y: uint16) -> uint16 {
    x / x + y * 17
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            mix(6, 9)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 154
    end
}
