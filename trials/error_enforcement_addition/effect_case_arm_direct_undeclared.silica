// E3002: a print built-in inside a case-arm block is an operation of the enclosing sequence
// (silica-specification §9.3.1). pick's sequence declares no effects, so the println in the
// true arm's block needs device_io and is the error, reported at its own location.
// Expected: E3002 "Effect not declared in caller: device_io" at the println.

use trial_support_int64;

fn pick(b: boolean) -> int64 {
    sequence
        r: int64 <- case b of {
            true -> { println("x"); 1 };
            false -> 0
        }
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(pick(true));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
