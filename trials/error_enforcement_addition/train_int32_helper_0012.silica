// expected failure E2003: parameter x declared uint64 in a int32 helper
// helper combine/2 on int32; combine(3, 9) = 23
use trial_support_int32;

fn combine(x: uint64, y: int32) -> int32 {
    x + 20 - y / 18
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            combine(3, 9)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 23
    end
}
