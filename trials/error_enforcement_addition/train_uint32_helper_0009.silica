// expected failure E1070: combine given nine parameters
// helper combine/2 on uint32; combine(18, 12) = 48
use trial_support_uint32;

fn combine9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn combine(x: uint32, y: uint32) -> uint32 {
    x + (y + x)
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            combine(18, 12)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 48
    end
}
