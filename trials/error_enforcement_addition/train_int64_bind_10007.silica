// expected failure E2013: unary minus on a variable instead of negate_int64
// int64 bindings then expression; expect 110
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            m: int64 <- 17 % 18 / (26 * 11);
            a: int64 <- (m + m) + 27 * 48;
            -m + 59 + a - (a - 51)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
