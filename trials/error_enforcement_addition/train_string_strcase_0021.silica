// expected failure E2005: integer pattern against a string scrutinee
// case on string literals; "actor" gives 81
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: string <- "actor";
            case mode of {
                0 -> 74;
                "actor" -> 81;
                "delta" -> 0;
                _: string -> 16
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
