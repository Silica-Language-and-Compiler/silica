// expected failure E1047: named struct declaration 'Config' is not allowed
// uint64 bindings then expression; expect 11
use trial_support_uint64;

struct Config { x: int64, y: int64 }

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            d: uint64 <- 19 + 52;
            step: uint64 <- d;
            11 % step % (14 % 31)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 11
    end
}
