use trial_support_int64;

fn worker(msg: atom, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: boolean <- cast_exit()
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast(w, (:go) impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
