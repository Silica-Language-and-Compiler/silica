// expected failure E1070: adjust given nine parameters
// helper adjust/3 on int8; adjust(20, 9, 10) = 1
use trial_support_int8;

fn adjust9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn adjust(x: int8, y: int8, z: int8) -> int8 {
    36 / z % (x % y)
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            adjust(20, 9, 10)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
