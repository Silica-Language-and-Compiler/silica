// A qualified cross-module call must be rejected when the argument count does not
// match the callee's declared arity. add3 takes three parameters; this passes two.
//
// The existing *_wrong_arg_count trials all cover BUILTINS (actor primitives).
// Nothing covered a user-defined function reached through a module qualifier,
// which is the shape that silently mis-emitted during the frame-region work.
use ArityLib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            ArityLib@add3(1, 2)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
