// expected failure E2005: inner boolean case missing its false arm
// nested boolean cases; (false, true) selects 59
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- false;
            b: boolean <- true;
            case a of {
                true -> case b of {
                    true -> 84
                };
                false -> case b of {
                    true -> 59;
                    false -> 44
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
