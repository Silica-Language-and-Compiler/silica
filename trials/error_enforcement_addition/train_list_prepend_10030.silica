// expected failure E2003: prepend called with its arguments swapped
// 2 prepends after empty; length is 2
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](xs0, 13);
                xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](5, xs1);
                n: int64 <- length[int64, mem(normal)](xs2)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
