// expected failure E1047: named struct declaration 'Pair' is not allowed
// case on uint32 value 25; expect 195
use trial_support_uint32;

struct Pair { x: int64, y: int64 }

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            v: uint32 <- 25;
            case v of {
                33 -> 72;
                38 -> 121;
                8 -> 153;
                n: uint32 if n > 22 -> 195;
                _: uint32 -> 96
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 195
    end
}
