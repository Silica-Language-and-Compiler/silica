// expected failure E2408: the language provides no (:json) wire protocol yet
impl Transportable for int64;

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        f: string <- encode((:json), 7);
        n: int64 <- length_bytes(f);
        _: atom <- print_int64(n)
    produces
        pure 0
    end
}
