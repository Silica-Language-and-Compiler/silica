// expected failure E2018: binding 'done' has no type annotation
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((28.0 + 18.5) == (26.5 + 3.5));
                println("");
                _: atom <- print_boolean((34.0 - 25.5) == (25.0 + 5.25));
                println("");
                _: atom <- print_boolean(22.0 < (29.25 + 35.25));
                println("");
                done <- print_boolean(15.0 >= (38.5 - 0.0))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
