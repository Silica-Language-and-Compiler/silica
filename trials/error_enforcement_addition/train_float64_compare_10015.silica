// expected failure E1043: whitespace between binding name 'done' and ':'
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(17.0 * 39.25 > 28.125 * 32.375);
                println("");
                _: atom <- print_boolean(2.25 >= 31.5);
                println("");
                done :atom <- print_boolean(35.0 < 30.0 * 11.125)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
