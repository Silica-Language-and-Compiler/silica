// expected failure E1060: unbalanced braces
// Spec §16.1.1: call(actor_ref, message) -> Reply; behavior returns (:reply, reply, new_state)
fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(18, acc, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        r0: int64 <- call(w, 13 impl ActorMessage {});
        print_int64(r0);
        println("")
    produces
        pure :ok
    end
