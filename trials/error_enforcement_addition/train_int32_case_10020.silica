// expected failure E2018: binding 'v' has no type annotation
// case on int32 value 2; expect 163
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v <- 2;
            case v of {
                12 -> 190;
                n: int32 if n > 18 -> 156;
                _: int32 -> 163
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 163
    end
}
