// expected failure E2003: parameter x declared uint8 in a int8 helper
// helper mix/2 on int8; mix(13, 4) = 57
use trial_support_int8;

fn mix(x: uint8, y: int8) -> int8 {
    x / y + 54
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            mix(13, 4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 57
    end
}
