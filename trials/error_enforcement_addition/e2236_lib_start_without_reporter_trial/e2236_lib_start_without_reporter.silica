// Spec §15.4.13.4 "Handler before any start" (E2236): starts are followed into other modules through
// their interfaces. e2236_start_lib@start() starts a supervisor, and main calls it without having
// registered a FailureReporter; the error is reported at main's call.

use e2236_start_lib;

fn main() -> int64 {
    sequence proc[concurrency]
        _: supervisor_ref <- e2236_start_lib@start();
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
