// expected failure E2005: list case pattern typed with the wrong element type
// max_acc over [10, 27, 18, 3] = 27
use trial_support_int64;

fn max_acc(xs: List[int64, mem(normal)], best: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> best;
        [h: string, t: List[int64, mem(normal)]] -> case h > best of {
            true -> max_acc(t, h);
            false -> max_acc(t, best)
        };
        _: List[int64, mem(normal)] -> best
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [10, 27, 18, 3];
                r: int64 <- max_acc(xs, 0)
                produces pure r end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
