// expected failure E2005: call with one argument too few
// function with 7 parameter(s); sum7(19, 1, 3, 14, 10, 3, 8) = 58
use trial_support_int32;

fn sum7(a: int32, b: int32, c: int32, d: int32, e: int32, f: int32, g: int32) -> int32 {
    a + b + c + d + e + f + g
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sum7(19, 1, 3, 14, 10, 3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 58
    end
}
