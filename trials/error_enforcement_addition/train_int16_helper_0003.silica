// expected failure E2003: parameter x declared uint16 in a int16 helper
// helper scale/1 on int16; scale(15) = 63
use trial_support_int16;

fn scale(x: uint16) -> int16 {
    33 + x + x
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            scale(15)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 63
    end
}
