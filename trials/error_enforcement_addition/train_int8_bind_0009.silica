// expected failure E2003: binding m declared int32 but used as int8
// int8 bindings then expression; expect 0
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            m: int32 <- 21;
            d: int8 <- (m + 42) / (51 + 52);
            (43 - d) / (d + 53)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
