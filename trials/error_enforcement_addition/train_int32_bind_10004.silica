// expected failure E2003: binding height declared uint8 but used as int32
// int32 bindings then expression; expect 56
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            height: uint8 <- 31;
            k: int32 <- (height + height) / height;
            step: int32 <- height * (k % 17);
            25 + step - height
        });
        _: int64 <- wait_for_exit()
    produces
        pure 56
    end
}
