// expected failure E2003: half_sum returns float64 but its result feeds print_float32
// float32 helper half_sum; prints 1.25
use trial_support_atom;

fn half_sum(x: float32) -> float64 {
    x - 26.5 + 2.5
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float32(half_sum(25.25))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
