// expected failure E1052: duplicate sequence keyword
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence sequence proc[device_io]
                _: atom <- print_boolean((3.0 - 36.0) != 13.5 * 5.5);
                println("");
                _: atom <- print_boolean(29.25 != 8.25);
                println("");
                done: atom <- print_boolean(26.5 <= 15.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
