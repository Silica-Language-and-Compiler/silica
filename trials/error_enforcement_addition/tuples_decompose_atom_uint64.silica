use trial_support_atom;

fn main() -> atom proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            some_tuple: (atom, uint64) <- (:ok, 12345678901234567890);
            println("about to decompose tuple");
            (a_value: atom, b_value: uint64) <- some_tuple;
            println("decomposed tuple");
            print_atom(a_value);
            print_uint64(b_value);
            a_value
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
