// expected failure E2013: unary minus on a variable instead of negate_uint16
// uint16 bindings then expression; expect 50
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            d: uint16 <- 9 + 33;
            base: uint16 <- 50;
            width: uint16 <- base / (4 % d);
            -d + base + width - width
        });
        _: int64 <- wait_for_exit()
    produces
        pure 50
    end
}
