// expected failure E2005: swap returns a pair but is decomposed as a triple
// swap((5, 55)); second = 5
use trial_support_int64;

fn swap(p: (int64, int64)) -> (int64, int64) {
    (x: int64, y: int64) <- p;
    (y, x)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (first: int64, second: int64, third: int64) <- swap((5, 55));
            second
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
