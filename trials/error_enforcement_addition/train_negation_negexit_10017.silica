// expected failure E2005: call to unknown function 'negate_int64x'
// negate_int64 of a negative binding gives exit code 90
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- -90;
            negate_int64x(x)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
