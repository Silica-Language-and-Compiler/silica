// expected failure E1050: produces clause without pure
// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(9 * 3 == 50);
                println("");
                _: atom <- print_boolean((20 + 34) <= (43 - 33));
                println("");
                _: atom <- print_boolean(19 < 42 * 39);
                println("");
                result: atom <- print_boolean(43 < 9)
            produces result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
