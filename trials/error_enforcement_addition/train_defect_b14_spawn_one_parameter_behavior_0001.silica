// regression (already diagnosed by silica-999997): expected failure E2005: a behavior must take (message, state)
use trial_support_atom;

fn beh(msg: int64) -> (:reply, int64, int64) {
    (:reply, msg, msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, beh, stack_policy(0, :keep_last_message));
                r: int64 <- call(w, 1 impl ActorMessage {});
                print_int64(r);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
