// expected failure E1070: sum8 extended to nine parameters
// function with 8 parameter(s); sum8(23, 6, 0, 18, 11, 9, 11, 8, 1) = 86
use trial_support_int64;

fn sum8(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64, i: int64) -> int64 {
    a + b + c + d + e + f + g + h + i
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sum8(23, 6, 0, 18, 11, 9, 11, 8)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
