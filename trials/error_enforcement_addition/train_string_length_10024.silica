// expected failure E1047: named struct declaration 'Config' is not allowed
// length_bytes of a bound string prints 5
use trial_support_atom;

struct Config { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                text: string <- "river";
                result: atom <- print_int64(length_bytes(text))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
