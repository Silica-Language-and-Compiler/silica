// expected failure E2005: reading a field that the record type does not declare
// functional record update through bump; counter ends at 48
use trial_support_int64;

fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s0: { counter: int64, label: string } <- { counter: 42, label: "count" };
            s1: { counter: int64, label: string } <- bump(s0, 3);
            s2: { counter: int64, label: string } <- bump(s1, 3);
            s2.total
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
