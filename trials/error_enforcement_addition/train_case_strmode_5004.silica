// expected failure E2005: integer pattern against a string scrutinee
// string case with an effectful sequence in each arm
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            mode: string <- "silent";
            case mode of {
                "silent" -> {
                    sequence proc[device_io]
                        print_string("silent");
                        println("");
                        print_int64(0);
                        println("")
                    produces
                        pure :ok
                    end
                }
                2 -> {
                    sequence proc[device_io]
                        print_int64(6);
                        println("")
                    produces
                        pure :ok
                    end
                }
                _: string -> {
                    sequence proc[device_io]
                        print_string("default");
                        println("")
                    produces
                        pure :ok
                    end
                }
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
