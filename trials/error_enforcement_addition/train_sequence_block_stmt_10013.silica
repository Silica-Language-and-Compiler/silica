// expected failure E3009: proc[...] written on the function return type instead of the sequence
// effectful sequence used as a statement before the return value 100
use trial_support_int64;

fn main() -> int64 proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_string("table");
                println("")
            produces pure :ok end;
            100
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
