// E1055: using one binding does not satisfy another unused binding in the same scope.
use trial_support_int64;

fn consume(x: int64) -> int64 {
    x
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            kept: int64 <- 1;
            unused_value: int64 <- 2;
            consume(kept)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
