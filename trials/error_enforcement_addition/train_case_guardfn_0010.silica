// expected failure E2005: wrong argument count in call to 'is_positive'
// guard calls a boolean helper; z = 1 gives 2
use trial_support_int64;

fn is_positive(v: int64) -> boolean {
    v > 0
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            z: int64 <- 1;
            case z of {
                z: int64 if is_positive() -> z * 2;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
