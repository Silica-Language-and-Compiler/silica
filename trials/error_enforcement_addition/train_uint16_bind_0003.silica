// expected failure E1060: unbalanced braces
// uint16 bindings then expression; expect 113
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            step: uint16 <- 3;
            count: uint16 <- 36 + 23 + (10 + 34);
            a: uint16 <- 25 / step - count / 53;
            c: uint16 <- 6 - 0;
            count + step + a + c - c
        });
        _: int64 <- wait_for_exit()
    produces
        pure 113
    end
}}
