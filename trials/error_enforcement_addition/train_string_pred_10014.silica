// expected failure E2018: binding 'suf' has no type annotation
// case on contains; expect 55
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s: string <- "abcdef";
            suf <- "ef";
            case contains(s, suf) of {
                true -> 55;
                false -> 91
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
