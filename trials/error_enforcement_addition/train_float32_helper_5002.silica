// expected failure E2005: wrong argument count in call to 'shift'
// float32 helper shift; prints 0.375
use trial_support_atom;

fn shift(x: float32) -> float32 {
    x - 5.25 + 1.25
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float32(shift())
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
