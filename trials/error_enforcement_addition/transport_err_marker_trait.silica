// E2411: `impl Transportable` is not a declaration since 2026-11-05; decode takes its limits as an argument.
use wire_etf;

impl Transportable for (:p, int64, int64);
fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        v: (:p, int64, int64) <- (:p, 1, 2);
        f: string <- encode((:etf), v);
        _: atom <- print_int64(length_bytes(f))
    produces
        pure 0
    end
}
