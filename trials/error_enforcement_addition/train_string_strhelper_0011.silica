// expected failure E1047: named struct declaration 'Pair' is not allowed
// string helper wrap; prints [south]

use trial_support_atom;

struct Pair { x: int64, y: int64 }

fn wrap(s: string) -> string {
    concatenate("[", concatenate(s, "]"))
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                print_string(wrap("south"));
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
