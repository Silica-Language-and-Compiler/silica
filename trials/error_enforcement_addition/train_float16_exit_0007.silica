// expected failure E1055: binding 'temp_val' is never used
// main returns float16; exit code is trunc(14.25 + (10.0 + 41.5)) = 65
use trial_support_float16;

fn main() -> float16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            temp_val: int64 <- 41;
            14.25 + (10.0 + 41.5)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 65.75
    end
}
