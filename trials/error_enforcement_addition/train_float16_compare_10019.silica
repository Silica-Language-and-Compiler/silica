// expected failure E1042: function 'main' has no return type
// float16 comparisons
use trial_support_atom;

fn main() {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(5.75 >= (25.5 - 3.5));
                println("");
                _: atom <- print_boolean(36.25 < (27.0 + 24.0));
                println("");
                done: atom <- print_boolean((25.5 - 14.25) < 26.0 * 10.0)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
