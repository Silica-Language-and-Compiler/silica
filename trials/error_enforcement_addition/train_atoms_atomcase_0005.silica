// expected failure E2018: binding 'mode' has no type annotation
// case over atoms; :ready selects 45
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode <- :ready;
            case mode of {
                :hot -> 39;
                :right -> 41;
                :ready -> 45;
                _: atom -> 77
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
