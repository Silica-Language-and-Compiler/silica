// expected failure E2005: call to unknown function 'scalz'
// helper scale/3 on int32; scale(3, 6, 20) = 39
use trial_support_int32;

fn scale(x: int32, y: int32, z: int32) -> int32 {
    (59 + z) / (y / x)
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            scalz(3, 6, 20)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 39
    end
}
