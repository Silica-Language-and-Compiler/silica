// Export references a function that does not exist; module defines other functions (spec 19.2.1).
use trial_support_int64;

export alpha/1, no_such_function/1;

fn alpha(x: int64) -> int64 {
    x
}

fn beta(y: int64) -> int64 {
    y + 1
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
