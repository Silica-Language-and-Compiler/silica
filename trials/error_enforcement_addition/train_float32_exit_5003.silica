// expected failure E1055: binding 'spare' is never used
// main returns float32; exit code is trunc(23.0) = 23
use trial_support_float32;

fn main() -> float32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float32@start();
        _: boolean <- trial_support_float32@run(fn() -> float32 {
            spare: int64 <- 41;
            23.0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 23.0
    end
}
