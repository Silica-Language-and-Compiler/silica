// expected failure E2013: unary minus on a variable instead of negate_int8
// int8 bindings then expression; expect 9
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            a: int8 <- 9;
            m: int8 <- a / a;
            k: int8 <- 32 % 25 + 34 * m;
            step: int8 <- m + k;
            -a + 9 + step - step
        });
        _: int64 <- wait_for_exit()
    produces
        pure 9
    end
}
