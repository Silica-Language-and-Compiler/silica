// expected failure E2003: binding a declared int16 but used as int32
// int32 bindings then expression; expect 9
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            a: int16 <- 40 - 13;
            step: int32 <- a;
            m: int32 <- 52 % 31 - (step - 15);
            b: int32 <- 40;
            m + b - b
        });
        _: int64 <- wait_for_exit()
    produces
        pure 9
    end
}
