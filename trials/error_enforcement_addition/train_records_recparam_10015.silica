// expected failure E2005: field name misspelled in the function body
// record passed to a function; perimeter({ width: 5, height: 14 }) = 38
use trial_support_int64;

fn perimeter(r: { width: int64, height: int64 }) -> int64 {
    2 * (r.width + r.heigth)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            perimeter({ width: 5, height: 14 })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
