// expected failure E1055: binding 'unused_value' is never used
// substring uses character indices [5, 5) of "north"
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            unused_value: int64 <- 41;
            sequence proc[device_io] s: string <- substring("north", 5, 5);
                print_string(s);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
