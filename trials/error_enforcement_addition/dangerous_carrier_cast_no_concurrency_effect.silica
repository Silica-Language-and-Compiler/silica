// A cast to a carrier actor (:open, :tx, :credit, :close) needs concurrency like any cast.
module dangerous_carrier_cast_no_concurrency_effect;
use Carrier;
use dangerous_sockets;
use dangerous_tcp_carrier;

fn open_it(car: dangerous_actor_ref, owner: actor_ref) -> boolean {
    sequence proc[device_io]
        sent: boolean <- cast(car, (:open, owner, "127.0.0.1:4040") impl ActorMessage {})
    produces
        pure sent
    end
}

fn main() -> int64 {
    0
}
