// expected failure E1060: unbalanced braces
// main returns float64; exit code is trunc(5.0) = 5
use trial_support_float64;

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            5.0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 5.0
    end
}}
