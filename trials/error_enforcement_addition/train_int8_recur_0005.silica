// expected failure E2005: boolean case missing its false branch
// recursive digit_count on int8; digit_count(8) = 1
use trial_support_int8;

fn digit_count(n: int8) -> int8 {
    case n < 10 of {
        true -> 1
    }
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            digit_count(8)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
