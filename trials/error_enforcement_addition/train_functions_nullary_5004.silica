// expected failure E2003: function name used as a value without calling it
// nullary functions calling each other; expect 185
use trial_support_int64;

fn base() -> int64 {
    92
}

fn next() -> int64 {
    base() + 1
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            next + base()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
