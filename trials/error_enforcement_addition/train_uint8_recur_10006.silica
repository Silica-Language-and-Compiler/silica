// expected failure E1045: function 'steps' declared without the fn keyword
// recursive steps on uint8; steps(23, 0) = 23
use trial_support_uint8;

steps(n: uint8, acc: uint8) -> uint8 {
    case n == 0 of {
        true -> acc;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            steps(23, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 23
    end
}
