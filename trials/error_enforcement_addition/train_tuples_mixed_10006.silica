// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// decompose a mixed tuple and print each element
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal)]
                t: (boolean, int64, string) <- (false, 71, "south");
                (flag: boolean, k: int64, name: string) <- t;
                print_boolean(flag);
                println("");
                print_int64(k);
                println("");
                print_string(name);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
