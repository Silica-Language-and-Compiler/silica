// expected failure E1055: binding 'spare' is never used
// tuple parameter typed_param; add_pair((34, 7)) = 41
use trial_support_int64;

fn add_pair(p: (int64, int64)) -> int64 {
    spare: int64 <- 41;
    (a: int64, b: int64) <- p;
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add_pair((34, 7))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
