// expected failure E1055: binding 'spare' is never used
// sequence result bound to a variable; expect 103
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            spare: int64 <- 41;
            value: int64 <- sequence produces pure 90 end;
            value + 13
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
