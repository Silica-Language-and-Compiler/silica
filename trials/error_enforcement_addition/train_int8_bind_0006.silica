// expected failure E2013: unary minus on a variable instead of negate_int8
// int8 bindings then expression; expect 43
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            count: int8 <- 47 + 58 / 36;
            k: int8 <- 25;
            -count + count - count / 9 + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 43
    end
}
