// expected failure E2005: wrong argument count in call to 'digit_count'
// recursive digit_count on int8; digit_count(78) = 2
use trial_support_int8;

fn digit_count(n: int8) -> int8 {
    case n < 10 of {
        true -> 1;
        false -> 1 + digit_count()
    }
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            digit_count(78)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
