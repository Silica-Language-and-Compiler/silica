// expected failure E2001: string literal passed where an integer parameter is expected
// helper scale/3 on uint32; scale(8, 11, 7) = 19
use trial_support_uint32;

fn scale(x: uint32, y: uint32, z: uint32) -> uint32 {
    (x + y) % (31 + z)
}

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            scale("8", 11, 7)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 19
    end
}
