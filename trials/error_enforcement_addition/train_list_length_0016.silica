// expected failure E1052: duplicate sequence keyword
// list literal of 6 int64 elements; length is 6
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence sequence proc[mem(normal_writethrough)]
                xs: List[int64, mem(normal_writethrough)] <- [9, 12, 3, 1, 28, 10];
                n: int64 <- length[int64, mem(normal_writethrough)](xs)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
