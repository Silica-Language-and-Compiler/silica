// expected failure E1047: named struct declaration 'Pair' is not allowed
// uint64 arithmetic: 47 % (11 % 46 + 17 * 46) = 47
use trial_support_uint64;

struct Pair { x: int64, y: int64 }

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            47 % (11 % 46 + 17 * 46)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 47
    end
}
