// expected failure E2003: binding k declared int16 but used as uint8
// uint8 bindings then expression; expect 1
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            k: int16 <- 57;
            step: uint8 <- 59;
            total: uint8 <- k;
            b: uint8 <- total;
            39 / 31 + step - step + b - b
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
