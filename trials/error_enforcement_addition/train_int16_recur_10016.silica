// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on int16; tri_acc(6, 0) = 21
use trial_support_int16;

fn tri_acc(n: int16, acc: int16) -> int16 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            tri_acc(6, 0)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 21
    end
}
