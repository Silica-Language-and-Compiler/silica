// expected failure E1040: missing ';' between two statements
// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(2.0 > (30.0 - 5.5));
                println("")
                _: atom <- print_boolean((37.75 + 29.0) > 3.0);
                println("");
                done: atom <- print_boolean(3.5 > (25.0 + 15.75))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
