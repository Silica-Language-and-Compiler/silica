// expected failure E1045: function 'main' declared without the fn keyword
// print_uint16 var; prints 47
use trial_support_atom;

main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                x: uint16 <- 45 - 25;
                result: atom <- print_uint16(27 + x)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
