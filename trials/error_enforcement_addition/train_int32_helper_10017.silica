// expected failure E2003: parameter x declared uint16 in a int32 helper
// helper blend/1 on int32; blend(2) = 107
use trial_support_int32;

fn blend(x: uint16) -> int32 {
    x % x + (55 + 52)
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            blend(2)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 107
    end
}
