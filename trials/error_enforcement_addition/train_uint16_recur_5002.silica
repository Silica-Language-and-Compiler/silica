// expected failure E1042: function 'main' has no return type
// recursive pow2 on uint16; pow2(6) = 64
use trial_support_uint16;

fn pow2(n: uint16) -> uint16 {
    case n == 0 of {
        true -> 1;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            pow2(6)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 64
    end
}
