// expected failure E2003: print_int32 result bound as int64 instead of atom
// chained print_int32 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                n_out: int64 <- print_int32(34 + 10 + (53 - 34));
                println("");
                _: atom <- print_int32(37 % 45);
                println("");
                _: atom <- print_int32((8 * 27 % (41 + 37)));
                println("");
                result: atom <- print_int32(53)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
