// expected failure E2018: binding 'result' has no type annotation
// chained print_uint32 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_uint32(53 + 41);
                println("");
                _: atom <- print_uint32(27 / (56 - 38));
                println("");
                _: atom <- print_uint32(10);
                println("");
                result <- print_uint32(32)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
