// expected failure E1041: trailing ';' after the block's final expression
// case on int16 value 37; expect 83
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            v: int16 <- 37;
            case v of {
                10 -> 94;
                20 -> 63;
                25 -> 152;
                n: int16 if n > 21 -> 83;
                _: int16 -> 126
            };
        });
        _: int64 <- wait_for_exit()
    produces
        pure 83
    end
}
