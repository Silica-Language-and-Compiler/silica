// E2402: the limits of decode must be a record literal of integer literals; a bound record is not accepted.
fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        lim: { max_bytes: int64 } <- { max_bytes: 64 };
        frame: string <- encode((:etf), "hi");
        r: (:ok, string) | (:rejected, atom) <- decode((:etf), frame, lim);
        _: atom <- case r of {
            (:ok, w: string) -> print_int64(length_bytes(w));
            (:rejected, _why: atom) -> print_int64(0 - 1)
        }
    produces
        pure 0
    end
}
