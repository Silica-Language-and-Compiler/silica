// expected failure E2003: comparison against a string binding
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == (41 - 22) <= (53 + 50));
                println("");
                _: atom <- print_boolean((11 - 7) > 16 / 51);
                println("");
                _: atom <- print_boolean(6 * 4 != (25 + 7));
                println("");
                result: atom <- print_boolean((48 / 10) <= (56 * 13))
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
