// expected failure E2003: a declared float64 but combined with a float32 value
// float32 bindings 11.5 + 29.0 printed as 40.5
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: float64 <- 11.5;
                b: float32 <- 29.0;
                result: atom <- print_float32(a + b)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
