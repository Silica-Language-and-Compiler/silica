// expected failure E2005: string literal pattern against an integer scrutinee
// case on int64 value 4; expect 71
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v: int64 <- 4;
            case v of {
                :one -> 16;
                29 -> 131;
                n: int64 if n > 16 -> 5;
                _: int64 -> 71
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
