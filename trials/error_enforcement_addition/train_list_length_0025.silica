// expected failure E3001: list literal built outside any sequence block
// list literal of 6 uint8 elements; length is 6
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[uint8, mem(normal)] <- [23, 20, 3, 19, 1, 16];
            length[uint8, mem(normal)](xs)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
