// expected failure E2005: call to unknown function 'adjust_all'
// helper adjust/3 on int8; adjust(5, 17, 6) = 53
use trial_support_int8;

fn adjust(x: int8, y: int8, z: int8) -> int8 {
    x % y + (42 + z)
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            adjust_all(5, 17, 6)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 53
    end
}
