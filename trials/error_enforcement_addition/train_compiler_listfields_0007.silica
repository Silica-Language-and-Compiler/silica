// expected failure E1050: produces clause without pure
// list field accessors is_nil/head; want 9
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [9, 3, 43];
                r: int64 <- case xs.is_nil of {
                    true -> 0;
                    false -> xs.head
                }
            produces
                r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
