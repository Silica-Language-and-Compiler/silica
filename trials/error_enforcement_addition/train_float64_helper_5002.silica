// expected failure E2003: half_sum returns float16 but its result feeds print_float64
// float64 helper half_sum; prints 8.25
use trial_support_atom;

fn half_sum(x: float64) -> float16 {
    x - 7.5 + 2.0
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_float64(half_sum(13.75))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
