// expected failure E1055: binding 'scratch' is never used
// nested module-qualified calls; lib_beta@twice(lib_alpha@bump(7)) = 16
use trial_support_int64;

use lib_alpha, lib_beta;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            scratch: int64 <- 41;
            lib_beta@twice(lib_alpha@bump(7))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
