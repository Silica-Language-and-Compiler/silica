// expected failure E3009: proc[...] written on the function return type instead of the sequence
// int64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom proc[device_io] {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(0 * 45 >= (42 + 32));
                println("");
                _: atom <- print_boolean((23 + 18) < 57 % 33);
                println("");
                _: atom <- print_boolean(52 / 32 < (57 + 5));
                println("");
                result: atom <- print_boolean((26 + 45) >= 11 / 44)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
