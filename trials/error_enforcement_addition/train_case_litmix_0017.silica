// expected failure E1042: function 'main' has no return type
// literal patterns, a guard and a typed wildcard on uint8; v = 2 gives 8
use trial_support_uint8;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            v: uint8 <- 2;
            case v of {
                11 -> 7;
                2 -> 8;
                10 -> 2;
                m: uint8 if m > 13 -> 30;
                _: uint8 -> 17
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 8
    end
}
