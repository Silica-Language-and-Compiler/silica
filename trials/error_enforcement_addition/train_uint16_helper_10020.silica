// expected failure E2005: call to unknown function 'blend_all'
// helper blend/2 on uint16; blend(9, 4) = 11
use trial_support_uint16;

fn blend(x: uint16, y: uint16) -> uint16 {
    x + (58 % y)
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            blend_all(9, 4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 11
    end
}
