// expected failure E1054: extra end after the sequence block
// effectful sequence used as a statement before the return value 1
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_string("alpha");
                println("")
            produces pure :ok end end;
            1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
