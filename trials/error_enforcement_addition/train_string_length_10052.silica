// expected failure E1055: binding 'scratch' is never used
// length_bytes of a bound string prints 7
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            scratch: int64 <- 41;
            sequence proc[device_io] text: string <- "ñandú";
                result: atom <- print_int64(length_bytes(text))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
