// expected failure E1050: produces clause without pure
// print_boolean(11 < 2)
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] result: atom <- print_boolean(11 < 2)
                produces result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
