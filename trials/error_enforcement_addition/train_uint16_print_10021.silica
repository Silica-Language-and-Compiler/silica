// expected failure E1054: extra end after the sequence block
// print_uint16 ignore; prints 39
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_uint16(39 % 56)
                produces pure :ok end end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
