// recv() is performed only by the actor runtime between behaviour invocations (spec section 15.1.2); user code
// never calls it. A call to recv() in a behaviour is rejected at compile time.
// Expected: E2005 "recv() is runtime-internal only; user code cannot call recv (§15.1.2)" at the call.

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        got: int64 <- recv()
    produces
        pure (:reply, got, state)
    end
}

fn main() -> int64 {
    0
}
