// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// print_uint64 var; prints 357
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io, mem(normal)]
                n: uint64 <- 7 * 53;
                result: atom <- print_uint64(n - 14)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
