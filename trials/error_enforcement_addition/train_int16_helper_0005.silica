// expected failure E2001: string literal passed where an integer parameter is expected
// helper compute/2 on int16; compute(20, 13) = 130
use trial_support_int16;

fn compute(x: int16, y: int16) -> int16 {
    y + 48 + (x + 49)
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            compute("20", 13)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 130
    end
}
