// expected failure E1070: mix given nine parameters
// helper mix/3 on int64; mix(9, 10, 5) = 14
use trial_support_int64;

fn mix9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn mix(x: int64, y: int64, z: int64) -> int64 {
    z / y + (x + z)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mix(9, 10, 5)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
