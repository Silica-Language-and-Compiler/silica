// expected failure E1055: binding 'spare' is never used
// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            spare: int64 <- 41;
            sequence proc[device_io]
                _: atom <- print_boolean((12.75 + 29.0) != 9.25);
                println("");
                _: atom <- print_boolean(22.25 != (32.75 - 5.375));
                println("");
                _: atom <- print_boolean((34.25 + 20.125) != (10.0 + 32.25));
                println("");
                done: atom <- print_boolean((7.0 + 28.25) > 28.0 * 11.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
