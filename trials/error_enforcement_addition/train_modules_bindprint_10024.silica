// expected failure E1055: binding 'unused_value' is never used
// qualified call bound then printed; prints 16
use lib_alpha;
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            unused_value: int64 <- 41;
            sequence proc[device_io]
                v: int64 <- lib_alpha@bump(15);
                result: atom <- print_int64(v)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
