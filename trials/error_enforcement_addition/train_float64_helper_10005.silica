// expected failure E2003: shift returns float32 but its result feeds print_float64
// float64 helper shift; prints 61.75
use trial_support_atom;

fn shift(x: float64) -> float32 {
    x + 32.5 + 5.5
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_float64(shift(23.75))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
