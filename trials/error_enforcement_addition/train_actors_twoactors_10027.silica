// expected failure E1041: trailing ';' after the block's final expression
// Spec §15.1.1: two actor_ref values from spawn; each replies independently
use trial_support_atom;

fn adder(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state);
}

fn doubler(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg * 2, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                a: actor_ref <- spawn(4, adder, stack_policy(0, :keep_last_message));
                b: actor_ref <- spawn(9, doubler, stack_policy(0, :keep_last_message));
                ra: int64 <- call(a, 1 impl ActorMessage {});
                rb: int64 <- call(b, 3 impl ActorMessage {});
                print_int64(ra + rb);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
