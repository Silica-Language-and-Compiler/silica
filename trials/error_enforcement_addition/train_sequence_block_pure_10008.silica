// expected failure E1056: empty proc[] on a pure sequence
// pure sequence block (two); expect 59
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[]
                a: int64 <- 46;
                b: int64 <- 13;
                total: int64 <- a + b
            produces
                pure total
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
