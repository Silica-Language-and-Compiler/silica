// expected failure E2005: call to unknown function 'containz'
// case on contains; expect 79
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s: string <- "silica compiler";
            suf: string <- "lo w";
            case containz(s, suf) of {
                true -> 77;
                false -> 79
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
