// expected failure E1053: duplicate produces keyword
// float32 bindings 8.0 * 18.0 printed as 144.0
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: float32 <- 8.0;
                b: float32 <- 18.0;
                result: atom <- print_float32(a * b)
            produces produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
