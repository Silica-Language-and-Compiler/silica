// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == 28 * 46 <= 22);
                println("");
                _: atom <- print_boolean((22 + 31) < (34 * 18));
                println("");
                _: atom <- print_boolean((55 + 33) >= 2 / 58);
                println("");
                _: atom <- print_boolean((54 + 9) > 3 / 4);
                println("");
                result: atom <- print_boolean((13 - 5) == (43 * 14))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
