// expected failure E2003: binding height declared uint32 but used as uint16
// uint16 bindings then expression; expect 55
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            height: uint32 <- 3 % 29 / (31 / 29);
            m: uint16 <- height;
            step: uint16 <- 27 + m;
            a: uint16 <- 30 * step;
            (height + 52) + 9 % height + a - a
        });
        _: int64 <- wait_for_exit()
    produces
        pure 55
    end
}
