// expected failure E4015: function 'join_all' defined twice
// join_all over a list of strings
use trial_support_atom;

fn join_all(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, t: List[string, mem(normal)]] -> concatenate(h, join_all(t));
        _: List[string, mem(normal)] -> ""
    }
}

fn join_all(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, t: List[string, mem(normal)]] -> concatenate(h, join_all(t));
        _: List[string, mem(normal)] -> ""
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[mem(normal), device_io]
                xs: List[string, mem(normal)] <- ["apple", "apple", "alpha"];
                s: string <- join_all(xs);
                print_string(s);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
