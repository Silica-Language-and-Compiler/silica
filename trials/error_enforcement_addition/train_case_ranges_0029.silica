// expected failure E1060: unbalanced braces
// guards partition int64 into three ranges; n = 63 gives 163
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 63;
            case n of {
                n: int64 if n < 33 -> n;
                n: int64 if n >= 33 and n < 41 -> n / 2;
                n: int64 if n >= 41 -> n + 100
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}}
