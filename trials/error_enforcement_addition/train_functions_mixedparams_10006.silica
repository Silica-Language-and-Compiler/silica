// expected failure E2001: string literal in the int64 argument slot
// parameters of three different types; describe(6, "world", true) = 11
use trial_support_int64;

fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            describe("world", "world", true)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
