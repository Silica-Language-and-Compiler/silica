// expected failure E1055: binding 'unused_value' is never used
// string helper shout; prints gamma!

use trial_support_atom;

fn shout(s: string, n: int64) -> string {
    unused_value: int64 <- 41;
    case n == 0 of {
        true -> s;
        false -> concatenate(shout(s, n - 1), "!")
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] print_string(shout("gamma", 1));
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
