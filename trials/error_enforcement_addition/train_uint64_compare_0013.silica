// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                label: string <- "x";
                _: atom <- print_boolean(label == 7 / 16 <= 14 / 46);
                println("");
                _: atom <- print_boolean(17 * 45 == 33 * 11);
                println("");
                _: atom <- print_boolean(58 < 28 % 60);
                println("");
                _: atom <- print_boolean((55 + 27) <= 7);
                println("");
                result: atom <- print_boolean(43 % 16 < 6)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
