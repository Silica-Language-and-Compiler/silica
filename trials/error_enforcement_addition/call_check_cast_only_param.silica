// Spec §16.1.2 (2026-10-13): a call to a cast-only actor is rejected with E2238 when the
// reference is a function parameter: ask calls its parameter, and main passes the cast-only q.
// (Fable's E2237/E2238 repro rej_call_cast_only_param, 2026-10-13.)

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn sink(msg: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + 1)
}

fn ask(r: actor_ref) -> int64 {
    sequence proc[concurrency]
        v: int64 <- call(r, "x" impl ActorMessage {})
    produces
        pure v
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        q: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        v: int64 <- ask(q);
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
