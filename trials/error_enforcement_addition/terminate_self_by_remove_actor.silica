// Spec §15.1.2.3 (2026-10-16): remove_actor whose target is self() is rejected with E2241
// TerminateSelfByRemoveOrKill: an actor ends itself only with stop_self or fail_self.
// A cast-only behaviour calls remove_actor(self()). (A target the compiler cannot see, such as
// a function parameter, still compiles and fails at run time with :language_error; see
// actors_addition/remove_actor_self_language_error.)

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: atom <- remove_actor(self())
    produces
        pure (:no_reply, state + msg)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
