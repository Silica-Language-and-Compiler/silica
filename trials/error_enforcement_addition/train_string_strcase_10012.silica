// expected failure E1043: whitespace between binding name 'mode' and ':'
// case on string literals; "alpha" gives 96
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode :string <- "alpha";
            case mode of {
                "alpha" -> 96;
                "hello" -> 47;
                "world" -> 35;
                _: string -> 70
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
