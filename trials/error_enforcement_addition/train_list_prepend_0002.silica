// expected failure E1047: named struct declaration 'Pair' is not allowed
// 5 prepends after empty; length is 5
use trial_support_int64;

struct Pair { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](0, xs0);
                xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](3, xs1);
                xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](7, xs2);
                xs4: List[int64, mem(normal)] <- prepend[int64, mem(normal)](12, xs3);
                xs5: List[int64, mem(normal)] <- prepend[int64, mem(normal)](10, xs4);
                n: int64 <- length[int64, mem(normal)](xs5)
            produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
