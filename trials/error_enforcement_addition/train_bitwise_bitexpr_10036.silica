// expected failure E1045: function 'main' declared without the fn keyword
// uint64 bitwise: (one band two) bor seven = 15
use trial_support_uint64;

main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            one: uint64 <- 11;
            two: uint64 <- 11;
            seven: uint64 <- 15;
            (one band two) bor seven
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15
    end
}
