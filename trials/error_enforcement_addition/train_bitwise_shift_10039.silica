// expected failure E2003: shift amount literal 65 is out of range 0..63
// shifts: (seed shl 2) + (wide shr 1) = 44
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            seed: uint64 <- 1;
            wide: uint64 <- 80;
            (seed shl 65) + (wide shr 1)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 44
    end
}
