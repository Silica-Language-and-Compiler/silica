// expected failure E1042: function 'main' has no return type
// literal patterns, a guard and a typed wildcard on int32; v = 9 gives 18
use trial_support_int32;

fn main() -> {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 9;
            case v of {
                5 -> 34;
                7 -> 39;
                12 -> 18;
                m: int32 if m > 7 -> 18;
                _: int32 -> 28
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 18
    end
}
