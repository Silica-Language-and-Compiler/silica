// expected failure E2018: binding 'b' has no type annotation
// nested boolean cases; (true, true) selects 65
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- true;
            b <- true;
            case a of {
                true -> case b of {
                    true -> 65;
                    false -> 45
                };
                false -> case b of {
                    true -> 84;
                    false -> 31
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
