// expected failure E2018: binding 'd' has no type annotation
// int8 bindings then expression; expect 0
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            d <- 4;
            height: int8 <- 54 + 57 + (19 - 25);
            (1 / height) / (12 + 55) + d - d
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
