// Fixed 2026-09-24: check_actor_cast_builtin now rejects a cast() to a (:reply, R, S) behaviour with E2237.
// SD-8: cast() to a behaviour that returns (:reply, R, S) (a call-only behaviour, §16.2.6.1)
// faults at run time inside the behaviour when the state is a record or a tuple
// ("[silica] fault ... addr=0x0000000000000006"); with an int64 state it silently works.
// Nothing rejects the mismatch at compile time or at the call site (that check is S-31).
use trial_support_int64;

fn beh(msg: int64, state: { a: int64, b: int64 }) -> (:reply, int64, { a: int64, b: int64 }) {
    (:reply, state.a + msg, { a: state.a + msg, b: state.b })
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                a: actor_ref <- spawn({ a: 1, b: 2 }, beh, stack_policy(0, :keep_last_message));
                _: boolean <- cast(a, 5 impl ActorMessage {});
                v1: int64 <- call(a, 6 impl ActorMessage {});
                _: atom <- print_int64(v1);
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
