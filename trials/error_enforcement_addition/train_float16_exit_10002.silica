// expected failure E1047: named struct declaration 'Point' is not allowed
// main returns float16; exit code is trunc(21.5) = 21
use trial_support_float16;

struct Point { x: int64, y: int64 }

fn main() -> float16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            21.5
        });
        _: int64 <- wait_for_exit()
    produces
        pure 21.5
    end
}
