// expected failure E1055: binding 'scratch' is never used
// uint64 bitwise: (flags bor one) band bits = 7
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            scratch: int64 <- 41;
            flags: uint64 <- 2;
            one: uint64 <- 15;
            bits: uint64 <- 7;
            (flags bor one) band bits
        });
        _: int64 <- wait_for_exit()
    produces
        pure 7
    end
}
