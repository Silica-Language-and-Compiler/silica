// expected failure E1053: duplicate produces keyword
// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(48 == (47 + 55));
                println("");
                _: atom <- print_boolean(40 / 3 <= 60 / 10);
                println("");
                _: atom <- print_boolean((30 + 13) >= (25 + 22));
                println("");
                _: atom <- print_boolean(16 * 37 >= (32 + 0));
                println("");
                result: atom <- print_boolean((5 + 15) <= (7 + 17))
            produces produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
