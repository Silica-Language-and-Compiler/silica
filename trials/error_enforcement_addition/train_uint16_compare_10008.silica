// expected failure E2018: binding 'result' has no type annotation
// uint16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(58 % 15 < 0);
                println("");
                _: atom <- print_boolean((12 + 27) > 15);
                println("");
                _: atom <- print_boolean((30 * 5) > 5 / 54);
                println("");
                result <- print_boolean(47 * 41 <= 12 * 6)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
