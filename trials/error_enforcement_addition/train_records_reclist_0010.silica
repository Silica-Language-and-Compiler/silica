// expected failure E2005: field v misspelled on the list element
// list of inline records folded by sum_v = 82
use trial_support_int64;

fn sum_v(xs: List[{ k: int64, v: int64 }, mem(normal)]) -> int64 {
    case xs of {
        []: List[{ k: int64, v: int64 }, mem(normal)] -> 0;
        [h: { k: int64, v: int64 }, t: List[{ k: int64, v: int64 }, mem(normal)]] -> h.val + sum_v(t);
        _: List[{ k: int64, v: int64 }, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[{ k: int64, v: int64 }, mem(normal)] <- [{ k: 1, v: 16 }, { k: 2, v: 15 }, { k: 3, v: 29 }, { k: 4, v: 22 }];
                total: int64 <- sum_v(xs)
            produces
                pure total
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
