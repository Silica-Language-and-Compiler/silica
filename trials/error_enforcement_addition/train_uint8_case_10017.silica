// expected failure E2018: binding 'v' has no type annotation
// case on uint8 value 29; expect 51
use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            v <- 29;
            case v of {
                37 -> 85;
                35 -> 186;
                15 -> 158;
                44 -> 32;
                n: uint8 if n > 32 -> 0;
                _: uint8 -> 51
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 51
    end
}
