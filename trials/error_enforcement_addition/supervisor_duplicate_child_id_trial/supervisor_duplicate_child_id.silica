// Spec §20.3.1 "Supervised children with the same id": an id that appears twice in one supervisor's
// init child list is a compile-time error, E2235 DuplicateChildId, reported at the second occurrence.
// :dup_child is listed first and third; the error points at the third record's id.

use Supervisor;

impl DuplicateIdSup for Supervisor;

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 3600 };
        children: List[
            {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
            mem(normal)
        ] <- [
            { id: :dup_child, agent_type: :worker, initial_state: 0, behavior: plain_worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :other_child, agent_type: :worker, initial_state: 0, behavior: plain_worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :dup_child, agent_type: :worker, initial_state: 0, behavior: plain_worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn plain_worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        sup: supervisor_ref <- spawn_registered_supervisor(DuplicateIdSup, 0, :duplicate_id_sup, stack_policy(0, :keep_last_message))
    produces
        pure 0
    end
}
