// expected failure E1043: whitespace between binding name 's' and ':'
// case on ends_with; expect 86
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s :string <- "北京市";
            suf: string <- "北京市";
            case ends_with(s, suf) of {
                true -> 86;
                false -> 39
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
