// expected failure E2005: call to unknown function 'print_int64_all'
// sequence prints and returns the same sum 39
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io] a: int64 <- 17;
                b: int64 <- 22;
                print_int64_all(a + b);
                println("");
                total: int64 <- a + b
                produces pure total end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
