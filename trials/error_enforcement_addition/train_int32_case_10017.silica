// expected failure E2005: string literal pattern against an integer scrutinee
// case on int32 value 0; expect 1
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            v: int32 <- 0;
            case v of {
                "one" -> 148;
                11 -> 187;
                n: int32 if n > 36 -> 18;
                _: int32 -> 1
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
