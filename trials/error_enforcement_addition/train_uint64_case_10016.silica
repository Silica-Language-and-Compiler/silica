// expected failure E1045: function 'main' declared without the fn keyword
// case on uint64 value 16; expect 13
use trial_support_uint64;

main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            v: uint64 <- 16;
            case v of {
                28 -> 52;
                n: uint64 if n > 22 -> 78;
                _: uint64 -> 13
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
