// expected failure E2003: binding height declared int8 but used as uint64
// uint64 bindings then expression; expect 0
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            height: int8 <- 45 - 6;
            base: uint64 <- height / height + (height * height);
            (9 / height) % (1 + 48) + base - base
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
