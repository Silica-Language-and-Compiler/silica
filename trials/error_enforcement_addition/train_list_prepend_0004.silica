// expected failure E2001: string element prepended to an integer list
// 5 prepends after empty; length is 5
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)]("4", xs0);
                xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](23, xs1);
                xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](0, xs2);
                xs4: List[int64, mem(normal)] <- prepend[int64, mem(normal)](18, xs3);
                xs5: List[int64, mem(normal)] <- prepend[int64, mem(normal)](23, xs4);
                n: int64 <- length[int64, mem(normal)](xs5)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
