// expected failure E2005: call with one argument too few
// function with 5 parameter(s); sum5(8, 22, 24, 3, 19) = 76
use trial_support_int32;

fn sum5(a: int32, b: int32, c: int32, d: int32, e: int32) -> int32 {
    a + b + c + d + e
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sum5(8, 22, 24, 3)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 76
    end
}
