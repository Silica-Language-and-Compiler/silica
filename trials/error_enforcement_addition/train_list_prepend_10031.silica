// expected failure E1060: unbalanced braces
// 5 prepends after empty; head is 6
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sequence proc[mem(normal)]
                xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
                xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](11, xs0);
                xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](8, xs1);
                xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](33, xs2);
                xs4: List[int32, mem(normal)] <- prepend[int32, mem(normal)](2, xs3);
                xs5: List[int32, mem(normal)] <- prepend[int32, mem(normal)](6, xs4);
                h: int32 <- head[int32, mem(normal)](xs5)
            produces pure h end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 6
    end
}}
