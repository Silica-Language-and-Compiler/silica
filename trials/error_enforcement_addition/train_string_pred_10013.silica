// expected failure E2005: boolean case missing its false arm
// case on starts_with; expect 39
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            s: string <- "abcdef";
            suf: string <- "xx";
            case starts_with(s, suf) of {
                true -> 91
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
