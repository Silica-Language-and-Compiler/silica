// expected failure E2003: parameter x declared uint64 in a int8 helper
// helper blend/3 on int8; blend(12, 15, 4) = 30
use trial_support_int8;

fn blend(x: uint64, y: int8, z: int8) -> int8 {
    y + x + (x / z)
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            blend(12, 15, 4)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 30
    end
}
