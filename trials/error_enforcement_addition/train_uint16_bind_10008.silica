// expected failure E2002: undefined identifier 'height_'
// uint16 bindings then expression; expect 131
use trial_support_uint16;

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            m: uint16 <- 48;
            height: uint16 <- m + m % 8;
            m + 8 + (m + 27) + height_ - height
        });
        _: int64 <- wait_for_exit()
    produces
        pure 131
    end
}
