// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name only if, where the
// literal is written, the name is bound to an integer literal by an integer-typed binding.
// The literal is written in a sequence's produces part and captures n, which a statement binds to
// the result of a call (seven()), not to a literal.

fn apply(f: fn(int64) -> int64, x: int64) -> int64 {
    f(x)
}

fn seven() -> int64 {
    7
}

fn main() -> int64 {
    sequence proc[device_io]
        n: int64 <- seven();
        _: atom <- print_int64(1)
    produces
        pure apply(fn(x: int64) -> int64 { x + n }, 10)
    end
}
