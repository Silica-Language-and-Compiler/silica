// E2415: an ESP-AT module, (:esp_at, n), sits on UART n (transport_ble_plan.md §4), so it claims that
// UART instance and conflicts with a (:uart, n, baud) link on the same one (links design decision 17:
// a UART instance is never shared).
carried_on host_line: (:serial) (:uart, 1, 115200);
carried_on phone: (:ble_gatt) (:esp_at, 1);

fn main() -> int64 {
    0
}
