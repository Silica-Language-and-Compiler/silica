// expected failure E1047: named struct declaration 'Point' is not allowed
// qualified call bound then printed; prints 8
use lib_beta;
use trial_support_atom;

struct Point { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                v: int64 <- lib_beta@twice(4);
                result: atom <- print_int64(v)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
