// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int64; v = 5 gives 37
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            v: int64 <- 5;
            case v of {
                :4 -> 23;
                10 -> 21;
                5 -> 37;
                m: int64 if m > 12 -> 38;
                _: int64 -> 6
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
