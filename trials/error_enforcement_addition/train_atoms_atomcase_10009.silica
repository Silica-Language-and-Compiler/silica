// expected failure E2005: integer pattern against an atom scrutinee
// case over atoms; :retry selects 84
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            mode: atom <- :retry;
            case mode of {
                9 -> 84;
                :retry -> 84;
                :down -> 72;
                _: atom -> 98
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
