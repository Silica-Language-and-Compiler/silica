// expected failure E2013: unary minus on a variable instead of negate_int16
// int16 bindings then expression; expect 0
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            b: int16 <- 45 * 22;
            a: int16 <- 46 / b;
            total: int16 <- a + 53;
            step: int16 <- a;
            -b + step * total * (28 * a)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
