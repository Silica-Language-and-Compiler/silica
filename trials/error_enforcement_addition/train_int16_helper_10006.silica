// expected failure E2003: parameter x declared int8 in a int16 helper
// helper adjust/3 on int16; adjust(15, 9, 5) = 29
use trial_support_int16;

fn adjust(x: int8, y: int16, z: int16) -> int16 {
    1 * x + (z + y)
}

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            adjust(15, 9, 5)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 29
    end
}
