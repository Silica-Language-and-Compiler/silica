// expected failure E1055: binding 'leftover' is never used
// case on a boolean binding; expect 0
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            leftover: int64 <- 41;
            flag: boolean <- true;
            case flag of {
                true -> 0;
                false -> 11
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
