// tuple_literal_rec_element (compile defect, fixed in chunk 15 phase 1 on 2026-10-25: the type checker
// ACCEPTED this ill-typed program). The declared result's `rec` binds to the pair itself (Q19: `rec`
// names its innermost enclosing tuple type), so `cell` returns a pair whose second element is an
// optional ref to such a pair. The body returns a ref to an (int64, ref?) node instead. The tuple-literal
// check cut the expected pair's text into element texts, which left that `rec` unanchored, and an
// unanchored `rec` matched any recursive tuple. Found in the chunk 15 phase-0 gate follow-up (repro
// retpair_a, 2026-10-24); the correctly spelled result `(region(L, normal), ref?(L, normal, (int64,
// ref?(L, normal, rec))))` is accepted.
// Expected: a type error at `c` in the produces line.
module tuple_literal_rec_element;

export cell/2;

fn cell(r: region(L, normal), v: int64) -> (region(L, normal), ref?(L, normal, rec)) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (v, :none))
    produces
        pure (r, c)
    end
}
