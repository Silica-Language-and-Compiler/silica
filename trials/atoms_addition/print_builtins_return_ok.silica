// Every print and output builtin returns :ok on success (spec 5.1, 22.5), not atom index 0
// (:efficiency, the first atom of the fixed runtime prefix). Each result is bound and
// printed; the last one is main's return, so the exit status is :ok's index, 2.
// Both emitter paths are covered: a literal argument (inline write) and a bound variable
// (helper call).
//
// Expected output (stdout and stderr interleave in call order):
//   one printed value, then ":ok" and a newline, per call; the exit status is 2.

use trial_support_atom;

fn show(r: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print_atom(r);
        println("")
    produces
        pure r
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                i8: int8 <- 8;
                i16: int16 <- 16;
                i32: int32 <- 32;
                i64: int64 <- 64;
                u8: uint8 <- 18;
                u16: uint16 <- 116;
                u32: uint32 <- 132;
                u64: uint64 <- 164;
                f16: float16 <- 1.5;
                f32: float32 <- 2.5;
                f64: float64 <- 3.5;
                b: boolean <- true;
                s: string <- "var";
                a: atom <- :found;
                r1: atom <- print_int8(1);
                _: atom <- show(r1);
                r2: atom <- print_int8(i8);
                _: atom <- show(r2);
                r3: atom <- print_int16(2);
                _: atom <- show(r3);
                r4: atom <- print_int16(i16);
                _: atom <- show(r4);
                r5: atom <- print_int32(3);
                _: atom <- show(r5);
                r6: atom <- print_int32(i32);
                _: atom <- show(r6);
                r7: atom <- print_int64(4);
                _: atom <- show(r7);
                r8: atom <- print_int64(i64);
                _: atom <- show(r8);
                r9: atom <- print_uint8(5);
                _: atom <- show(r9);
                r10: atom <- print_uint8(u8);
                _: atom <- show(r10);
                r11: atom <- print_uint16(6);
                _: atom <- show(r11);
                r12: atom <- print_uint16(u16);
                _: atom <- show(r12);
                r13: atom <- print_uint32(7);
                _: atom <- show(r13);
                r14: atom <- print_uint32(u32);
                _: atom <- show(r14);
                r15: atom <- print_uint64(9);
                _: atom <- show(r15);
                r16: atom <- print_uint64(u64);
                _: atom <- show(r16);
                r17: atom <- print_float16(0.5);
                _: atom <- show(r17);
                r18: atom <- print_float16(f16);
                _: atom <- show(r18);
                r19: atom <- print_float32(0.25);
                _: atom <- show(r19);
                r20: atom <- print_float32(f32);
                _: atom <- show(r20);
                r21: atom <- print_float64(0.125);
                _: atom <- show(r21);
                r22: atom <- print_float64(f64);
                _: atom <- show(r22);
                r23: atom <- print_boolean(false);
                _: atom <- show(r23);
                r24: atom <- print_boolean(b);
                _: atom <- show(r24);
                r25: atom <- print_atom(:normal);
                _: atom <- show(r25);
                r26: atom <- print_atom(a);
                _: atom <- show(r26);
                r27: atom <- print_string("lit");
                _: atom <- show(r27);
                r28: atom <- print_string(s);
                _: atom <- show(r28);
                r29: atom <- print("lit");
                _: atom <- show(r29);
                r30: atom <- print(s);
                _: atom <- show(r30);
                r31: atom <- println("lit");
                _: atom <- show(r31);
                r32: atom <- println(s);
                _: atom <- show(r32);
                r33: atom <- println();
                _: atom <- show(r33);
                r34: atom <- print_string_stderr("lit");
                _: atom <- show(r34);
                r35: atom <- print_string_stderr(s);
                _: atom <- show(r35);
                r36: atom <- println_stderr("lit");
                _: atom <- show(r36);
                r37: atom <- println_stderr(s);
                _: atom <- show(r37);
                r38: atom <- println_stderr();
                last: atom <- show(r38)
            produces
                pure last
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
