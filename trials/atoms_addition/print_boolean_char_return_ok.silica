// print_boolean (spec §5.1.4, §22.5.4) and
// print_char print their value and return :ok. print_char writes the character's UTF-8 bytes:
// one, two, three and four bytes are covered, as a literal and as a bound variable. Only fixed-prefix
// atoms are used (:ok), so the suite's atom table does not shift; the last result is main's return,
// so the exit status is :ok's index, 2.
// Expected (stdout): true:ok false:ok false:ok a:ok é:ok €:ok 😀:ok 😀:ok, one per line; exit 2.

use trial_support_atom;

fn show(r: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print_atom(r);
        println("")
    produces
        pure r
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                b: boolean <- false;
                c: char <- '😀';
                r1: atom <- print_boolean(true);
                _: atom <- show(r1);
                r2: atom <- print_boolean(b);
                _: atom <- show(r2);
                r3: atom <- print_boolean(b);
                _: atom <- show(r3);
                r4: atom <- print_char('a');
                _: atom <- show(r4);
                r5: atom <- print_char('é');
                _: atom <- show(r5);
                r6: atom <- print_char('€');
                _: atom <- show(r6);
                r7: atom <- print_char('😀');
                _: atom <- show(r7);
                r8: atom <- print_char(c);
                last: atom <- show(r8)
            produces
                pure last
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
