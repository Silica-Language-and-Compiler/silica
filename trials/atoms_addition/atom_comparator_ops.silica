// Ordering comparisons between atom literals: <, >, <=, >=.
//
// Atoms are NOT ordered lexicographically by name. Each distinct atom gets a compile-time
// index in the atom table by order of first appearance in the program (first seen = lowest
// index). Comparisons use those numeric indices (see design §4.1.7 / atom_table).
//
// This file deliberately uses names whose spelling order disagrees with first-use order:
// `:zebra` appears before `:apple` before `:mango`, so indices are zebra=0, apple=1, mango=2
// even though "apple" < "mango" < "zebra" as strings.

use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            sequence proc[device_io]
                // < : index order zebra(0) < apple(1); not string order
                _: atom <- print_boolean(:zebra < :apple);
                println("");
                _: atom <- print_boolean(:apple < :zebra);
                println("");

                // > : mango(2) > apple(1); inverse false
                _: atom <- print_boolean(:mango > :apple);
                println("");
                _: atom <- print_boolean(:apple > :mango);
                println("");

                // <= : strict by index; equal; false when rhs index is lower
                _: atom <- print_boolean(:zebra <= :apple);
                println("");
                _: atom <- print_boolean(:mango <= :mango);
                println("");
                _: atom <- print_boolean(:mango <= :zebra);
                println("");

                // >= : strict by index; equal; false when lhs index is lower
                _: atom <- print_boolean(:mango >= :apple);
                println("");
                _: atom <- print_boolean(:apple >= :apple);
                println("");
                _: atom <- print_boolean(:zebra >= :mango);
                println("");
                _: atom <- print_boolean(:apple >= :zebra)
                produces pure 12 end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 12
    end
}// expected output: true, false, true, false, true, true, false, true, true, false, true
