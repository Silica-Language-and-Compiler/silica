// §15.1.2.2 :track_recent_peak retains the most any of the last 32 messages used. Five shallow
// messages after a deep one keep the deep amount; after 32 more the deep sample has left the
// window and the committed stack has shrunk to the shallow messages' needs.

use trial_support_int64;

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn shallow_calls(w: actor_ref, n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            sequence proc[concurrency]
                _: int64 <- call(w, 50 impl ActorMessage {});
                rest: int64 <- shallow_calls(w, n - 1)
            produces
                pure rest + 1
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, beh, stack_policy(0, :track_recent_peak));
                _: int64 <- call(w, 200000 impl ActorMessage {});
                deep: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                five: int64 <- shallow_calls(w, 5);
                mid: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                more: int64 <- shallow_calls(w, 32);
                after: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_int64(five + more);
                println("");
                print_boolean(deep.committed > 1048576);
                println("");
                print_boolean(mid.committed == deep.committed);
                println("");
                print_boolean(after.committed > 0 and after.committed < deep.committed);
                println("");
                print_boolean(after.high_water == deep.high_water);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
