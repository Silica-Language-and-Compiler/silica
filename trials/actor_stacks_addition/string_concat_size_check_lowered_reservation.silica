// Size check on string building: an actor whose reservation was lowered to 262,144 bytes doubles a
// 16-byte string 20 times (16 MiB). Each concat takes its result from the actor's stack; the size check
// ends the actor with (:explicit, :reservation_exceeded) when the stack would pass the reservation, and
// the process keeps running.
// Expected output:
//   worker ended: reservation_exceeded
//   done
//   0

fn grow(s: string, n: int64) -> string {
    case n == 0 of {
        true -> s;
        false -> grow(concat(s, s), n - 1)
    }
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    big: string <- grow("0123456789abcdef", msg);
    found: int64 <- case contains(big, "abc") of {
        true -> 1;
        false -> 0
    };
    (:no_reply, found + state)
}

fn region_dump_limit() -> int64 {
    0
}

fn kind(report: string) -> string {
    case contains(report, ":reservation_exceeded") of {
        true -> "worker ended: reservation_exceeded\n";
        false -> "worker ended: other reason\n"
    }
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print(kind(report));
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        w: actor_ref <- spawn(0, worker, stack_policy(262144, :keep_high_water), state_policy(:keep_state_area));
        _: boolean <- cast(w, 20 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        println("done")
    produces
        pure 0
    end
}
