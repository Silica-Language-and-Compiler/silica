// §15.1.2.2: stack_policy(reserve, release) -> stack_policy is a value of a built-in type; it may be
// bound to a name and passed to any spawn form.

use trial_support_int64;

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg * 2, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                p: stack_policy <- stack_policy(8388608, :keep_high_water);
                w: actor_ref <- spawn(0, beh, p);
                r: int64 <- call(w, 21 impl ActorMessage {});
                print_int64(r);
                println("");
                u: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_int64(u.reserved);
                println("");
                print_boolean(u.committed > 0 and u.committed == u.high_water);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
