// §15.1.1: spawn(initial_state, behavior_fn, stack_policy [, core_id]); the core id is the fourth
// argument, after the required stack policy.

use trial_support_int64;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                a: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message), 1);
                b: actor_ref <- spawn(100, acc, stack_policy(0, :release_on_return), 0);
                ra: int64 <- call(a, 3 impl ActorMessage {});
                rb: int64 <- call(b, 5 impl ActorMessage {});
                print_int64(ra);
                println("");
                print_int64(rb);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
