// Size check on alloc_buf: 8 TiB of int64 (below the 2^47-byte buffer limit) asked of an actor at the default reservation, which cannot hold it.
// A worker actor receives 1099511627776 and calls fill(msg), which allocates that many int64 elements in its
// frame. The size check ends THAT actor with :out_of_memory; its failure report goes to the registered
// reporter, which prints one line and ends main's wait_for_exit(). The process keeps running.
// Expected output:
//   worker ended: out_of_memory
//   done
//   0

fn fill(count: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, int64, count) <- alloc_buf(r, count);
        _: atom <- write_buf(buf, 0, 5);
        value: int64 <- read_buf(buf, 0)
    produces
        pure value
    end
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, fill(msg) + state)
}

fn region_dump_limit() -> int64 {
    0
}

fn kind(report: string) -> string {
    case contains(report, ":out_of_memory") of {
        true -> "worker ended: out_of_memory\n";
        false -> "worker ended: other reason\n"
    }
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print(kind(report));
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_high_water), state_policy(:keep_state_area));
        _: boolean <- cast(w, 1099511627776 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        println("done")
    produces
        pure 0
    end
}
