// SD-41: an actor whose state root is rebuilt each message on the PROVEN path (the new state is a tuple of
// the counter and a projection of the old state, so no W2300 and _silica_rt_state_evacuate runs at every
// dispatch end) under :keep_high_water with a lowered reservation must not exhaust the reservation through
// repeated evacuation scratch: 30000 messages complete.

fn logger(msg: (string, int64), state: (int64, string)) -> (:no_reply, (int64, string)) {
    sequence proc[concurrency, device_io]
        (_, k): (string, int64) <- msg;
        (n, kept): (int64, string) <- state;
        _: boolean <- case n + 1 == 30000 of {
            true -> { _: atom <- print_int64(n + 1 + k); _: atom <- println(""); cast_exit(0) };
            false -> true
        }
    produces
        pure (:no_reply, (n + 1, kept))
    end
}

fn send_next(me: actor_ref, i: int64) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(me, i impl ActorMessage {})
    produces
        pure sent
    end
}

fn driver(msg: int64, state: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        text: string <- concat("report ", substring("0123456789", msg % 10, msg % 10 + 1));
        _: boolean <- cast(state, (text, 0) impl ActorMessage {});
        me: actor_ref <- self();
        _: boolean <- case msg + 1 == 30000 of {
            true -> true;
            false -> send_next(me, msg + 1)
        }
    produces
        pure (:no_reply, state)
    end
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println(report);
        _: boolean <- cast_exit(3)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(r);
        l: actor_ref <- spawn((0, "kept"), logger, stack_policy(67108864, :keep_high_water), state_policy(:keep_state_area));
        d: actor_ref <- spawn(l, driver, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(d, 0 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}

fn region_dump_limit() -> int64 {
    0
}
