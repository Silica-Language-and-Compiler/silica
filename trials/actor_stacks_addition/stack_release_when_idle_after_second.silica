// §15.1.2.2 :release_when_idle keeps everything while messages keep arriving and releases all of
// it once no message has arrived for one second. main polls the actor's usage until the release
// shows (bounded, so a runtime that never releases still terminates and prints false).

use trial_support_int64;

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn poll_batch(w: actor_ref, n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            sequence proc[concurrency]
                u: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                r: int64 <- case u.committed == 0 of {
                    true -> 1;
                    false -> poll_batch(w, n - 1)
                }
            produces
                pure r
            end
        }
    }
}

// One round of a thousand polls per message; the poller's own stack holds that recursion.
fn poller(msg: int64, w: actor_ref) -> (:reply, int64, actor_ref) {
    r: int64 <- poll_batch(w, msg);
    (:reply, r, w)
}

fn rounds(p: actor_ref, n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            sequence proc[concurrency]
                r: int64 <- call(p, 1000 impl ActorMessage {});
                res: int64 <- case r == 1 of {
                    true -> 1;
                    false -> rounds(p, n - 1)
                }
            produces
                pure res
            end
        }
    }
}

// Up to msg rounds of a thousand polls (about ten seconds when nothing is ever released); the recursion over rounds lives on this actor's stack, not on main's, because
// main is not an actor and runs on the platform's ordinary stack (§15.1.2.2).
fn driver(msg: int64, p: actor_ref) -> (:reply, int64, actor_ref) {
    r: int64 <- rounds(p, msg);
    (:reply, r, p)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, beh, stack_policy(0, :release_when_idle));
                _: int64 <- call(w, 200000 impl ActorMessage {});
                busy: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_boolean(busy.committed > 1048576 and busy.retained == busy.committed);
                println("");
                p: actor_ref <- spawn(w, poller, stack_policy(0, :keep_high_water));
                d: actor_ref <- spawn(p, driver, stack_policy(0, :keep_high_water));
                released: int64 <- call(d, 400000 impl ActorMessage {});
                print_boolean(released == 1);
                println("");
                idle: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_boolean(idle.retained == 0 and idle.high_water == busy.high_water);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
