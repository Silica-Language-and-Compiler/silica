// §15.1.2.2: an actor's stack grows on demand. A million non-tail frames inside one message is far
// past the 8 MB an OS thread would allow; with :keep_high_water the stack stays committed afterwards,
// so committed equals the high-water mark and the high-water mark exceeds 8 MB.

use trial_support_int64;

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, beh, stack_policy(0, :keep_high_water));
                r: int64 <- call(w, 1000000 impl ActorMessage {});
                print_int64(r);
                println("");
                u: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_boolean(u.high_water > 8388608);
                println("");
                print_boolean(u.committed == u.high_water);
                println("");
                print_boolean(u.reserved > u.high_water);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
