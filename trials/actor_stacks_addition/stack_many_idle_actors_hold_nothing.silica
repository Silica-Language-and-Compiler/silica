// §15.1.2.2: an idle actor holds no stack memory at all. A thousand actors with lowered
// reservations (a program that spawns many must lower them) and :release_on_return each handle
// one message; afterwards every one of them has zero committed stack while its high-water mark
// shows it did run.

use trial_support_int64;

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state + 1)
}

fn spawn_and_check(n: int64, acc: int64) -> int64 {
    case n == 0 of {
        true -> acc;
        false -> {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, beh, stack_policy(1048576, :release_on_return));
                _: int64 <- call(w, n impl ActorMessage {});
                u: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                bad: int64 <- case u.committed == 0 and u.retained == 0 and u.high_water > 0 and u.reserved == 1048576 of {
                    true -> 0;
                    false -> 1
                };
                rest: int64 <- spawn_and_check(n - 1, acc + bad)
            produces
                pure rest
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                bad: int64 <- spawn_and_check(1000, 0);
                print_int64(bad);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
