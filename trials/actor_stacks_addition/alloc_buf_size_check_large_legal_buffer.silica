// Size check on alloc_buf: a legal large request passes. An actor at the default reservation allocates
// 131,072 int64 elements (1 MiB), writes the last element and reads it back through a call.
// Expected output:
//   7
//   done
//   0

use trial_wait_int64;

fn fill_last(count: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, int64, count) <- alloc_buf(r, count);
        _: atom <- write_buf(buf, count - 1, 7);
        value: int64 <- read_buf(buf, count - 1)
    produces
        pure value
    end
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, fill_last(msg), state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, beh, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                v: int64 <- call(w, 131072 impl ActorMessage {});
                print_int64(v);
                println("");
                println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
