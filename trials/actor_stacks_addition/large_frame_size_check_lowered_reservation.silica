            v153: int64 <- n + 153;
            v154: int64 <- n + 154;
            v155: int64 <- n + 155;
            v156: int64 <- n + 156;
            v157: int64 <- n + 157;
            v158: int64 <- n + 158;
            v159: int64 <- n + 159;
            v160: int64 <- n + 160;
            r: int64 <- big(n - 1);
            r + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 + v21 + v22 + v23 + v24 + v25 + v26 + v27 + v28 + v29 + v30 + v31 + v32 + v33 + v34 + v35 + v36 + v37 + v38 + v39 + v40 + v41 + v42 + v43 + v44 + v45 + v46 + v47 + v48 + v49 + v50 + v51 + v52 + v53 + v54 + v55 + v56 + v57 + v58 + v59 + v60 + v61 + v62 + v63 + v64 + v65 + v66 + v67 + v68 + v69 + v70 + v71 + v72 + v73 + v74 + v75 + v76 + v77 + v78 + v79 + v80 + v81 + v82 + v83 + v84 + v85 + v86 + v87 + v88 + v89 + v90 + v91 + v92 + v93 + v94 + v95 + v96 + v97 + v98 + v99 + v100 + v101 + v102 + v103 + v104 + v105 + v106 + v107 + v108 + v109 + v110 + v111 + v112 + v113 + v114 + v115 + v116 + v117 + v118 + v119 + v120 + v121 + v122 + v123 + v124 + v125 + v126 + v127 + v128 + v129 + v130 + v131 + v132 + v133 + v134 + v135 + v136 + v137 + v138 + v139 + v140 + v141 + v142 + v143 + v144 + v145 + v146 + v147 + v148 + v149 + v150 + v151 + v152 + v153 + v154 + v155 + v156 + v157 + v158 + v159 + v160
        }
    }
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, big(msg) + state)
}

fn region_dump_limit() -> int64 {
    0
}

fn kind(report: string) -> string {
    case contains(report, ":reservation_exceeded") of {
        true -> "worker ended: reservation_exceeded\n";
        false -> "worker ended: other reason\n"
    }
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print(kind(report));
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        w: actor_ref <- spawn(0, worker, stack_policy(262144, :keep_high_water), state_policy(:keep_state_area));
        _: boolean <- cast(w, 100000 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        println("done")
    produces
        pure 0
    end
}
