// Size check on large frames: a function with 160 live bindings has a fixed frame part above 1,024 bytes,
// so its prologue is probed against the actor's reservation. Recursing 100,000 deep in an actor whose
// reservation was lowered to 262,144 bytes ends the actor with (:explicit, :reservation_exceeded); the
// process keeps running.
// Expected output:
//   worker ended: reservation_exceeded
//   done
//   0

fn big(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            v1: int64 <- n + 1;
            v2: int64 <- n + 2;
            v3: int64 <- n + 3;
            v4: int64 <- n + 4;
            v5: int64 <- n + 5;
            v6: int64 <- n + 6;
            v7: int64 <- n + 7;
            v8: int64 <- n + 8;
            v9: int64 <- n + 9;
            v10: int64 <- n + 10;
            v11: int64 <- n + 11;
            v12: int64 <- n + 12;
            v13: int64 <- n + 13;
            v14: int64 <- n + 14;
            v15: int64 <- n + 15;
            v16: int64 <- n + 16;
            v17: int64 <- n + 17;
            v18: int64 <- n + 18;
            v19: int64 <- n + 19;
            v20: int64 <- n + 20;
            v21: int64 <- n + 21;
            v22: int64 <- n + 22;
            v23: int64 <- n + 23;
            v24: int64 <- n + 24;
            v25: int64 <- n + 25;
            v26: int64 <- n + 26;
            v27: int64 <- n + 27;
            v28: int64 <- n + 28;
            v29: int64 <- n + 29;
            v30: int64 <- n + 30;
            v31: int64 <- n + 31;
            v32: int64 <- n + 32;
            v33: int64 <- n + 33;
            v34: int64 <- n + 34;
            v35: int64 <- n + 35;
            v36: int64 <- n + 36;
            v37: int64 <- n + 37;
            v38: int64 <- n + 38;
            v39: int64 <- n + 39;
            v40: int64 <- n + 40;
            v41: int64 <- n + 41;
            v42: int64 <- n + 42;
            v43: int64 <- n + 43;
            v44: int64 <- n + 44;
            v45: int64 <- n + 45;
            v46: int64 <- n + 46;
            v47: int64 <- n + 47;
            v48: int64 <- n + 48;
            v49: int64 <- n + 49;
            v50: int64 <- n + 50;
            v51: int64 <- n + 51;
            v52: int64 <- n + 52;
            v53: int64 <- n + 53;
            v54: int64 <- n + 54;
            v55: int64 <- n + 55;
            v56: int64 <- n + 56;
            v57: int64 <- n + 57;
            v58: int64 <- n + 58;
            v59: int64 <- n + 59;
            v60: int64 <- n + 60;
            v61: int64 <- n + 61;
            v62: int64 <- n + 62;
            v63: int64 <- n + 63;
            v64: int64 <- n + 64;
            v65: int64 <- n + 65;
            v66: int64 <- n + 66;
            v67: int64 <- n + 67;
            v68: int64 <- n + 68;
            v69: int64 <- n + 69;
            v70: int64 <- n + 70;
            v71: int64 <- n + 71;
            v72: int64 <- n + 72;
            v73: int64 <- n + 73;
            v74: int64 <- n + 74;
            v75: int64 <- n + 75;
