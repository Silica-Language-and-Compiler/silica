// §15.1.2.2: nothing is committed at spawn, and :release_on_return gives everything back each
// time the handler returns. The high-water mark remembers the deep message.

use trial_support_int64;

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, beh, stack_policy(0, :release_on_return));
                u0: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_boolean(u0.committed == 0 and u0.high_water == 0 and u0.retained == 0);
                println("");
                r: int64 <- call(w, 500000 impl ActorMessage {});
                print_int64(r);
                println("");
                u1: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_boolean(u1.committed == 0);
                println("");
                print_boolean(u1.retained == 0);
                println("");
                print_boolean(u1.high_water > 4194304);
                println("");
                r2: int64 <- call(w, 500000 impl ActorMessage {});
                print_int64(r2);
                println("");
                u2: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_boolean(u2.committed == 0 and u2.high_water == u1.high_water);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
