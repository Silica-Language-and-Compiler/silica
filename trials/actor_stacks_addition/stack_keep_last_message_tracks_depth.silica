// §15.1.2.2 :keep_last_message keeps what the last message used and releases the excess: a deep
// message followed by a shallow one shrinks the committed stack, and the same deep message again
// commits exactly what it committed the first time.

use trial_support_int64;

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, beh, stack_policy(0, :keep_last_message));
                _: int64 <- call(w, 200000 impl ActorMessage {});
                u1: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                _: int64 <- call(w, 100 impl ActorMessage {});
                u2: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                _: int64 <- call(w, 200000 impl ActorMessage {});
                u3: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                print_boolean(u1.committed > 1048576);
                println("");
                print_boolean(u2.committed > 0 and u2.committed < u1.committed);
                println("");
                print_boolean(u3.committed == u1.committed);
                println("");
                print_boolean(u1.retained == u1.committed and u2.retained == u2.committed);
                println("");
                print_boolean(u3.high_water == u1.high_water);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
