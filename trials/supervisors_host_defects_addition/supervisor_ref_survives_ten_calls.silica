// Hosted twin of supervisors_board_defects_addition/supervisor_ref_after_calls (fixed 2026-10-09 in
// all four emitters): a supervisor_ref bound in main and used in a call_supervisor after ten
// call_registered calls, whose ten int64 bindings take every callee-saved register. call_supervisor
// lowers to a nested let (`let %_supervisor_live_count = supervisor_count_children(rt) in
// record_make(...)`); a let inside another let's RHS saw only its own tail as its body, so the
// liveness fallback handed the count rt's register (MOV X19, X0 after the call), and the
// terminate_child that followed received the count as its supervisor_ref: on the Mac a fault in
// os_unfair_lock_lock, status 70. Every let RHS now keeps the bound callee-saved registers
// (term_reg_spill@outer_for_aggregate_let_rhs, `_keep_cs`), so the count takes a frame slot.
// Expected: 10, the terminated worker's failure banner, 2, 9.

use Supervisor;

impl TenSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :h_w1, agent_type: :worker, initial_state: 1, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w2, agent_type: :worker, initial_state: 2, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w3, agent_type: :worker, initial_state: 3, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w4, agent_type: :worker, initial_state: 4, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w5, agent_type: :worker, initial_state: 5, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w6, agent_type: :worker, initial_state: 6, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w7, agent_type: :worker, initial_state: 7, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w8, agent_type: :worker, initial_state: 8, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w9, agent_type: :worker, initial_state: 9, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :h_w10, agent_type: :worker, initial_state: 10, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn ping(name: atom) -> int64 {
    sequence proc[concurrency]
        v: int64 <- call_registered(name, 1 impl ActorMessage {})
    produces pure v end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        rt: supervisor_ref <- spawn_registered_supervisor(TenSup, 0, :h_root, stack_policy(0, :keep_last_message));
        _s1: int64 <- ping(:h_w1);
        _s2: int64 <- ping(:h_w2);
        _s3: int64 <- ping(:h_w3);
        _s4: int64 <- ping(:h_w4);
        _s5: int64 <- ping(:h_w5);
        _s6: int64 <- ping(:h_w6);
        _s7: int64 <- ping(:h_w7);
        _s8: int64 <- ping(:h_w8);
        _s9: int64 <- ping(:h_w9);
        _s10: int64 <- ping(:h_w10);
        n: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(rt, { op: :count_children } impl SupervisorMessage {});
        print_int64(n.count);
        println("");
        _t: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(rt, { op: :terminate_child, id: :h_w1 } impl SupervisorMessage {});
        print_int64(2);
        println("");
        after: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(rt, { op: :count_children } impl SupervisorMessage {});
        print_int64(after.count);
        println("")
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
