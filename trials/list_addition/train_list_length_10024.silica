// list literal of 5 uint8 elements; length is 5
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[uint8, mem(normal)] <- [26, 8, 5, 17, 12];
                n: int64 <- length[uint8, mem(normal)](xs)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
