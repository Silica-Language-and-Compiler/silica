// List trial — silica-compiler / trials/list_addition
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8).
// Forces at least two chunk buffers in one region: design_documents/list_implementation_design.md §4.1–§4.2, §9.2, §9.5.
// Vector chunk width is target-dependent (e.g. 128-bit → 4×uint32/chunk; 256-bit → 8×uint32/chunk).
// Nine prepends after empty on List[uint32, normal] guarantees a second chunk for both (same mem(normal) region, §9.3).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
                xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](0, xs0);
                xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](1, xs1);
                xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](2, xs2);
                xs4: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](3, xs3);
                xs5: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](4, xs4);
                xs6: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](5, xs5);
                xs7: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](6, xs6);
                xs8: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](7, xs7);
                xs9: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](8, xs8);
                n: int64 <- length[uint32, mem(normal)](xs9)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
