// remove_head on [30, 27, 26, 12, 9] gives 4
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [30, 27, 26, 12, 9];
                rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
                n: int64 <- length[int64, mem(normal)](rest)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
