// Phase 0.4 — List[Collectable, S] resolved from typed binding (silica-spec §8.2.4).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- empty[Collectable, mem(normal)]();
                ys: List[int64, mem(normal)] <- prepend[Collectable, mem(normal)](7, xs);
                n: int64 <- length[Collectable, mem(normal)](ys)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
