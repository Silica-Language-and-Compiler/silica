// head on [2, 30, 23] gives 2
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [2, 30, 23];
                first: int64 <- head[int64, mem(normal)](xs)
                produces pure first end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
