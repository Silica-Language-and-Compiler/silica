use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                literal_list: List[int64, mem(normal)] <- [7, 8, 9];
                empty_list: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                n1: int64 <- length[int64, mem(normal)](literal_list);
                n2: int64 <- length[int64, mem(normal)](empty_list);
                sum: int64 <- n1 + n2
            produces
                pure sum
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
