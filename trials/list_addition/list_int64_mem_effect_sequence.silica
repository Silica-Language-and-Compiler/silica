// List trial — silica-compiler / trials/list_addition
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8).
// Implementation: design_documents/list_implementation_design.md §9.3 — list allocation under a declared mem type;
//   the same mem(normal) covers the region and any additional buffers/chunks grown in that region (§9.2).
// Lowering: §9.6 (immediate desugar to region + buffers in all paths).
// Minimal shape: sequence proc[mem(normal)] … produces pure … end (required for list operations).
// For mem(<space>) with <space> != normal, see list_int64_mem_writethrough.silica (normal_writethrough).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [1, 2, 3];
                n: int64 <- length[int64, mem(normal)](xs)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
