// List trial — silica-compiler / trials/list_addition
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8).
// design_documents/silica-specification.md §4.2.4 — uniform list types: parameters, variables, literals, patterns match.
// design_documents/list_implementation_design.md §7, §9.3 — recursive walk; effects only on sequence blocks.
// sum_list [1,2,3] -> 6
use trial_support_int64;

fn sum_list(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [h: int64, t: List[int64, mem(normal)]] -> h + sum_list(t);
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [1, 2, 3];
                total: int64 <- sum_list(xs)
            produces
                pure total
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
