// Lists are persistent values: prepending twice to the same list must give two lists that share
// its tail and keep their own heads. The list runtime filled the free slot in front of a list's
// first element in place, with no record of whether another list had already used it, so
// `b <- 2 : a; c <- 3 : a` wrote both heads into one slot and b's head read 3. Chunks now carry
// a claim word (L_list_prepend_helper in emitter/*/terms/prims/prims_list.silica). Record elements
// are one pointer word per cell since the boxed record layout, so they share chunks the same way.
// Expected output: "2 3 1", "2 3 1", then exit 0.

use trial_support_int64;

fn cons(x: int64, rest: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, rest)
    produces
        pure out
    end
}

fn nil_list() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure out
    end
}

fn cons_r(x: { v: int64, w: int64 }, rest: List[{ v: int64, w: int64 }, mem(normal)]) -> List[{ v: int64, w: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[{ v: int64, w: int64 }, mem(normal)] <- prepend[{ v: int64, w: int64 }, mem(normal)](x, rest)
    produces
        pure out
    end
}

fn nil_r() -> List[{ v: int64, w: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[{ v: int64, w: int64 }, mem(normal)] <- empty[{ v: int64, w: int64 }, mem(normal)]()
    produces
        pure out
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                a: List[int64, mem(normal)] <- cons(1, nil_list());
                b: List[int64, mem(normal)] <- cons(2, a);
                c: List[int64, mem(normal)] <- cons(3, a);
                bh: int64 <- b.head;
                ch: int64 <- c.head;
                ah: int64 <- a.head;
                r1: { v: int64, w: int64 } <- { v: 1, w: 10 };
                r2: { v: int64, w: int64 } <- { v: 2, w: 20 };
                r3: { v: int64, w: int64 } <- { v: 3, w: 30 };
                ra: List[{ v: int64, w: int64 }, mem(normal)] <- cons_r(r1, nil_r());
                rb: List[{ v: int64, w: int64 }, mem(normal)] <- cons_r(r2, ra);
                rc: List[{ v: int64, w: int64 }, mem(normal)] <- cons_r(r3, ra);
                rbh: { v: int64, w: int64 } <- rb.head;
                rch: { v: int64, w: int64 } <- rc.head;
                rah: { v: int64, w: int64 } <- ra.head;
                rbv: int64 <- rbh.v;
                rcv: int64 <- rch.v;
                rav: int64 <- rah.v;
                _: atom <- print_int64(bh);
                _: atom <- print_string(" ");
                _: atom <- print_int64(ch);
                _: atom <- print_string(" ");
                _: atom <- print_int64(ah);
                _: atom <- println("");
                _: atom <- print_int64(rbv);
                _: atom <- print_string(" ");
                _: atom <- print_int64(rcv);
                _: atom <- print_string(" ");
                _: atom <- print_int64(rav);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
