// List trial — silica-compiler / trials/list_addition
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8).
// Implementation: design_documents/list_implementation_design.md §7 (head observation), §9.3 (mem type),
//   §9.7 (primary cursor: after remove_head, rest’s primary head is the former second element).
// Language surface: silica-specification.md — remove_head, head accessor.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [10, 20, 30];
                rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
                second: int64 <- head[int64, mem(normal)](rest)
            produces
                pure second
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
