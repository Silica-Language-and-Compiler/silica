// 4 prepends after empty; head is 23
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            sequence proc[mem(normal)]
                xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
                xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](17, xs0);
                xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](31, xs1);
                xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](20, xs2);
                xs4: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](23, xs3);
                h: uint32 <- head[uint32, mem(normal)](xs4)
            produces pure h end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 23
    end
}
