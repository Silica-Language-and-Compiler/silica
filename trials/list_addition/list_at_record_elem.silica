// list_at on a list of records: element read in place, crossing a chunk boundary at index 3.
// Returns 0 iff element 1 is {2,20} and element 3 is {4,40}.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[{ k: int64, v: int64 }, mem(normal)] <- [{ k: 1, v: 10 }, { k: 2, v: 20 }, { k: 3, v: 30 }, { k: 4, v: 40 }];
                second: { k: int64, v: int64 } <- list_at[{ k: int64, v: int64 }, mem(normal)](xs, 1);
                last: { k: int64, v: int64 } <- list_at[{ k: int64, v: int64 }, mem(normal)](xs, 3)
            produces
                pure case second.k == 2 of {
                    false -> 1;
                    true -> case second.v == 20 of {
                        false -> 2;
                        true -> case last.k == 4 of { false -> 3; true -> case last.v == 40 of { false -> 4; true -> 0 } }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
