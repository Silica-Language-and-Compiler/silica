// list_at[T, S](xs, i): the i-th element from the head without a .tail walk.
// Returns 0 iff elements 0,1,2 of [7,8,9] read back as 7,8,9.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [7, 8, 9];
                a: int64 <- list_at[int64, mem(normal)](xs, 0);
                b: int64 <- list_at[int64, mem(normal)](xs, 1);
                c: int64 <- list_at[int64, mem(normal)](xs, 2)
            produces
                pure case a == 7 of {
                    false -> 1;
                    true -> case b == 8 of { false -> 2; true -> case c == 9 of { false -> 3; true -> 0 } }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
