// list literal of 5 uint8 elements; length is 5
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal_writethrough)] xs: List[uint8, mem(normal_writethrough)] <- [24, 16, 20, 29, 18];
                n: int64 <- length[uint8, mem(normal_writethrough)](xs)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
