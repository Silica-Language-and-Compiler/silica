// total_len over a list of strings
use trial_support_int64;

fn total_len(xs: List[string, mem(normal)]) -> int64 {
    case xs of {
        []: List[string, mem(normal)] -> 0;
        [h: string, t: List[string, mem(normal)]] -> length_chars(h) + total_len(t);
        _: List[string, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[string, mem(normal)] <- ["silica", "banana", "cherry", "river"];
                n: int64 <- total_len(xs)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
