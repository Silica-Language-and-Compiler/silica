// The empty list literal `[]` is the empty list wherever it appears, including as the last statement
// of a sequence (before `produces`). The parser recognised the empty form only when `:`, `;`, `)`,
// `,` or end of input followed the `]` (parser/constraint_extract_expr_lits@extract_list_literal), so
// `xs: List[int64, mem(normal)] <- []` before `produces` parsed the `]` as an element and built a
// one-element list whose head read 0.
// Expected (by hand): 0 (the literal's length), 0 (empty[...]()'s length), exit 0.

use trial_support_int64;

fn literal_empty() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- []
    produces
        pure xs
    end
}

fn builtin_empty() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure xs
    end
}

fn count(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> count(xs.tail, acc + 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                a: int64 <- count(literal_empty(), 0);
                b: int64 <- count(builtin_empty(), 0);
                print_int64(a);
                println("");
                print_int64(b);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
