// count_even over [45, 13, 35, 7, 45] = 0
use trial_support_int64;

fn count_even(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [h: int64, t: List[int64, mem(normal)]] -> case h % 2 == 0 of {
            true -> 1 + count_even(t);
            false -> count_even(t)
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [45, 13, 35, 7, 45];
                r: int64 <- count_even(xs)
                produces pure r end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
