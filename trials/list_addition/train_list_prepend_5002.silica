// 5 prepends after empty; head is 4
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            sequence proc[mem(normal)]
                xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
                xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](15, xs0);
                xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](1, xs1);
                xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](16, xs2);
                xs4: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](34, xs3);
                xs5: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](4, xs4);
                h: uint32 <- head[uint32, mem(normal)](xs5)
            produces pure h end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 4
    end
}
