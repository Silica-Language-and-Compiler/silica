// A list whose elements are a sum of two bare record variants, `{ x: int64 } | { y: int64 }`: each
// cell holds the pointer to a record that starts with its shape word, so a case over the head
// matches the variant by that word. Expected: prints 13; exits 0.

use trial_support_int64;

fn mk_x(v: int64) -> { x: int64 } | { y: int64 } {
    { x: v }
}

fn mk_y(v: int64) -> { x: int64 } | { y: int64 } {
    { y: v }
}

fn total(xs: List[{ x: int64 } | { y: int64 }, mem(normal)]) -> int64 {
    case xs of {
        []: List[{ x: int64 } | { y: int64 }, mem(normal)] -> 0;
        [h: { x: int64 } | { y: int64 }, t: List[{ x: int64 } | { y: int64 }, mem(normal)]] -> {
            here: int64 <- case h of {
                { x: v } -> v;
                { y: w } -> 0 - w
            };
            here + total(t)
        };
        _: List[{ x: int64 } | { y: int64 }, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io, mem(normal)]
                xs: List[{ x: int64 } | { y: int64 }, mem(normal)] <- [mk_x(10), mk_y(4), mk_x(7)];
                print_int64(total(xs));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
