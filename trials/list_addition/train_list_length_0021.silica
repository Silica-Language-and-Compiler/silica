// list literal of 2 uint32 elements; length is 2
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal_writethrough)] xs: List[uint32, mem(normal_writethrough)] <- [17, 27];
                n: int64 <- length[uint32, mem(normal_writethrough)](xs)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
