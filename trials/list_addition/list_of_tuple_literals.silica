// A list literal whose elements are tuple literals, `[(3, 4), (1, 2)]` (spec §3.3.4 list_literal; the
// elements are ordinary expressions). A `(` as the first element was the one element shape the
// constraint roles never covered (`(` after `[` has no operand role), so the `[` was not recognised
// as a list literal at all: E1000 at the `(` with one element, E1040 at the comma with two, in any
// position (binding, tail expression, case arm). Recognition is now structural
// (constraint_extract_slots@is_list_literal_lbracket_fallback) and the closing `]` is always the
// literal's own (constraint_extract_expr_lits@extract_list_elements_tail). Moved here from
// compile_defects_list_tuple_literal_addition (book-verification repros r_listlit / r_listlit3).
// Expected: xs has 2 elements, the pairs read back as 3+4 and 1+2, exit 2.
//   7
//   3
//   2

use trial_support_int64;

fn pairs() -> List[(int64, int64), mem(normal)] {
    [(3, 4), (1, 2)]
}

fn sum_pair(p: (int64, int64)) -> int64 {
    (a: int64, b: int64) <- p;
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal), device_io]
                xs: List[(int64, int64), mem(normal)] <- [(3, 4), (1, 2)];
                ys: List[(int64, int64), mem(normal)] <- pairs();
                _: atom <- print_int64(sum_pair(xs.head));
                println("");
                _: atom <- print_int64(sum_pair(ys.tail.head));
                println("")
            produces
                pure length[(int64, int64), mem(normal)](xs)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
