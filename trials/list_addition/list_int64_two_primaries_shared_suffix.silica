// List trial — silica-compiler / trials/list_addition
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8).
// Implementation: design_documents/list_implementation_design.md §6.2 (two names, one bundle model at type level),
//   §9.2 (single region per spine), §9.3 (mem type for list allocation), §9.7 (each List[T,S] primary cursor; case on primary).
// base and extended share suffix storage; case on each binds the head via that value’s primary cursor.
// Prints use device_io; list allocation uses mem(normal) — both in one sequence (§9.3).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal), device_io]
                base: List[int64, mem(normal)] <- [2, 3];
                extended: List[int64, mem(normal)] <- prepend[int64, mem(normal)](1, base);
                hb: int64 <- case base of {
                    []: List[int64, mem(normal)] -> 0;
                    [h: int64, _: List[int64, mem(normal)]] -> h;
                    _: List[int64, mem(normal)] -> 0
                };
                he: int64 <- case extended of {
                    []: List[int64, mem(normal)] -> 0;
                    [h: int64, _: List[int64, mem(normal)]] -> h;
                    _: List[int64, mem(normal)] -> 0
                };
                print_string("hb: ");
                print_int64(hb);
                println("");
                print_string(" he: ");
                print_int64(he);
                println("");
                sum: int64 <- hb + he
            produces
                pure sum
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
