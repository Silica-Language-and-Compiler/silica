// List trial — silica-compiler / trials/list_addition
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8):
//   `S` in `sequence proc[mem(S)]` matches the `S` in every `List[T, S]` in the block.
// Implementation: design_documents/list_implementation_design.md §4.3 (empty), §6.3–§6.4 (List[T,S] bundle, length memo),
//   §7, §9.2 (one region per spine), §9.3 (mem type for list allocation), §9.6 (immediate lowering).
// Language surface: silica-specification.md — list literals, empty(), length (Collectable int64).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                literal_list: List[int64, mem(normal)] <- [7, 8, 9];
                empty_list: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                n1: int64 <- length[int64, mem(normal)](literal_list);
                n2: int64 <- length[int64, mem(normal)](empty_list);
                sum: int64 <- n1 + n2
            produces
                pure sum
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
