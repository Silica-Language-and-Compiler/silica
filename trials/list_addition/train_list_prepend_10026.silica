// 1 prepends after empty; head is 1
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sequence proc[mem(normal)]
                xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
                xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](1, xs0);
                h: int32 <- head[int32, mem(normal)](xs1)
            produces
                pure h
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
