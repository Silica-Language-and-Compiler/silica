// 2 prepends after empty; length is 2
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
                xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](2, xs0);
                xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](25, xs1);
                n: int64 <- length[int32, mem(normal)](xs2)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
