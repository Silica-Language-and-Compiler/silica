// case on a non-empty list; expect 77
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [6, 11, 25];
                r: int64 <- case xs of {
                    []: List[int64, mem(normal)] -> 2;
                    [h: int64, _: List[int64, mem(normal)]] -> h + 71;
                    _: List[int64, mem(normal)] -> 2
                }
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
