// list literal of 3 int32 elements; length is 3
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[int32, mem(normal)] <- [0, 28, 7];
                n: int64 <- length[int32, mem(normal)](xs)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
