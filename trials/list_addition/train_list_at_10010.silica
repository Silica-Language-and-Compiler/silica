// list_at index 4 of [8, 33, 13, 9, 12] is 12
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [8, 33, 13, 9, 12];
                v: int64 <- list_at[int64, mem(normal)](xs, 4)
                produces pure v end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
