// A float literal as a tuple case pattern element (spec §3.5: `pattern ::= literal_pattern`,
// `literal_pattern ::= literal`). The compiler rejects the program at type checking with E2005
// "invalid or unsupported case pattern": case_parse_pattern in
// type_checker/expressions/type_checker_tuple_decompose_helpers.silica classifies a numeric literal
// with case_string_is_signed_int_literal, which stops at the decimal point.
// The emitter half is in place since 2026-09-19 (term_case_patterns@emit_tuple_case_pattern_asm
// compares the element against the literal, which the float literal pools now collect out of the
// pattern text), so only the front end is missing.
// Expected once accepted, by hand: 11, 2, 3, exit 0.

use trial_support_int64;

fn pick(p: (float64, int64)) -> int64 {
    case p of {
        (1.5, k: int64) -> k + 1;
        (2.5, _: int64) -> 2;
        _: (float64, int64) -> 3
    }
}

fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(pick((1.5, 10)));
                _: atom <- show(pick((2.5, 0)));
                _: atom <- show(pick((3.5, 0)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
