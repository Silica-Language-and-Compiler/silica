// A static child whose initial state is a record `{ base: int64, step: int64 }`: the child spec
// holds the record (its shape word and two fields) and every spawn of the row, including the
// restart, copies it into a fresh block of the child's own. The worker replies base + step * msg and
// advances step; after the restart the state is the spec's again. Expected: prints 103, 106, 103,
// done; exits 0.

use Supervisor;

impl RecordStateRestartSup for Supervisor;

fn worker(msg: int64, state: { base: int64, step: int64 }) -> (:reply, int64, { base: int64, step: int64 }) {
    (:reply, state.base + state.step * msg, { base: state.base, step: state.step + 1 })
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: { base: int64, step: int64 }, behavior: fn(msg: int64, state: { base: int64, step: int64 }) -> (:reply, int64, { base: int64, step: int64 }), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: { base: int64, step: int64 }, behavior: fn(msg: int64, state: { base: int64, step: int64 }) -> (:reply, int64, { base: int64, step: int64 }), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :record_state_worker, agent_type: :worker, initial_state: { base: initial_state, step: 1 }, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(RecordStateRestartSup, 100, :record_state_restart_sup, stack_policy(0, :keep_last_message));
        get_reply: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: :record_state_worker } impl SupervisorMessage {});
        v1: int64 <- call(get_reply.child, 3 impl ActorMessage {});
        _: atom <- print_int64(v1);
        println("");
        v2: int64 <- call(get_reply.child, 3 impl ActorMessage {});
        _: atom <- print_int64(v2);
        println("");
        restart_reply: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :restart_child, id: :record_state_worker } impl SupervisorMessage {});
        v3: int64 <- call(restart_reply.child, 3 impl ActorMessage {});
        _: atom <- print_int64(v3);
        println("");
        println("done")
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
