// An actor whose state is a record and whose message is a sum of two records with no atom field,
// `{ add: int64 } | { scale: int64 }`. The message is copied at send time with its shape word, so the
// behaviour's case tells the variants apart by that word; the state record is moved out of each
// behaviour and read back by the caller. (A message that is a call expression is bound first: an
// actor call whose message argument is itself a call is an open seed defect.) Expected: prints 12,
// 36, 2, done; exits 0.

fn counter(msg: { add: int64 } | { scale: int64 }, state: { total: int64, count: int64 }) -> (:reply, { total: int64, count: int64 }, { total: int64, count: int64 }) {
    next: { total: int64, count: int64 } <- case msg of {
        { add: n } -> { total: state.total + n, count: state.count + 1 };
        { scale: k } -> { total: state.total * k, count: state.count + 1 }
    };
    (:reply, next, next)
}

fn mk_add(n: int64) -> { add: int64 } | { scale: int64 } {
    { add: n }
}

fn mk_scale(k: int64) -> { add: int64 } | { scale: int64 } {
    { scale: k }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        c: actor_ref <- spawn({ total: 2, count: 0 }, counter, stack_policy(0, :keep_last_message));
        m1: { add: int64 } | { scale: int64 } <- mk_add(10);
        r1: { total: int64, count: int64 } <- call(c, m1 impl ActorMessage {});
        _: atom <- print_int64(r1.total);
        println("");
        m2: { add: int64 } | { scale: int64 } <- mk_scale(3);
        r2: { total: int64, count: int64 } <- call(c, m2 impl ActorMessage {});
        _: atom <- print_int64(r2.total);
        println("");
        _: atom <- print_int64(r2.count);
        println("");
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
