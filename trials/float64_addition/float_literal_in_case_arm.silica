// A float64 literal in a case arm of a function that is not `main`. The module's float literal pool
// searched let, call and prim nodes only (atoms/float64_literal_pool), so a literal that lived in a
// case arm (SIR kinds 3/7/8) had no pool entry and was emitted as the undefined label `L_f64_`
// ("assembler local symbol 'L_f64_' not defined"). Fixed 2026-09-19: every kind's children are
// searched. float32's pool had the same hole (float32_addition/float_literal_in_case_arm).
// Expected, by hand: 1.5, 2.25.

use trial_support_int64;

fn pick(n: int64) -> float64 {
    case n == 0 of {
        true -> 1.5;
        false -> 2.25
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_float64(pick(0));
                println("");
                _: atom <- print_float64(pick(1));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
