// defect A1: three float64 parameters; sum3(1.5, 2.25, 4.0) = 7.75
use trial_support_atom;

fn sum3(a: float64, b: float64, c: float64) -> float64 {
    a + b + c
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_float64(sum3(1.5, 2.25, 4.0))
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
