// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((10.75 - 22.375) <= (22.0 + 19.5));
                println("");
                _: atom <- print_boolean(27.125 * 14.5 == (33.375 + 11.75));
                println("");
                done: atom <- print_boolean(34.375 > (12.75 + 38.5))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
