.arch armv8.2-a+fp16
.text
    // use trial_support_atom
.extern silica_rt_ffi_guarded_enter
.extern silica_rt_ffi_guarded_exit
.extern silica_rt_ffi_guarded_setjmp
.extern silica_rt_ffi_guarded_fault_finish
.extern silica_rt_ffi_arena_bump
.global main


.globl train_float64_helper_10006_blend
train_float64_helper_10006_blend:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP D8, D9, [SP, #-16]!
    FMOV D8, D0

    ADRP X0, L_f64_1
    LDR D2, [X0, :lo12:L_f64_1]
    STR D2, [SP, #-16]!
    ADRP X0, L_f64_0
    LDR D2, [X0, :lo12:L_f64_0]
    FMOV D1, D8


    FADD D1, D1, D2
    LDR D2, [SP], #16


    FADD D0, D1, D2
    LDP D8, D9, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

.globl main
main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL silica_pid_registry_init
    BL silica_dangerous_pid_registry_init
    BL silica_device_pid_registry_init
    // unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o209|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_start
    ADD X9, X9, :lo12:trial_support_atom_start
    BLR X9

    ADRP X16, train_float64_helper_10006.__lam0
    ADD X16, X16, :lo12:train_float64_helper_10006.__lam0

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o259|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_run
    ADD X9, X9, :lo12:trial_support_atom_run
    BLR X9

    BL silica_rt_wait_for_exit

    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

.globl train_float64_helper_10006.__lam0
train_float64_helper_10006.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X0, L_f64_2
    LDR D0, [X0, :lo12:L_f64_2]
    // effects []|sir_rec:o380|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, train_float64_helper_10006_blend
    ADD X9, X9, :lo12:train_float64_helper_10006_blend
    BLR X9

    // effects [device_io]
    BL L_pf64_helper
    MOV X0, #2

    MOV X19, X0
    MOV X0, X19

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table
    ADD X9, X9, :lo12:L_pa_table
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_pf64_helper:
    SUB SP, SP, #64
    STR D0, [SP, #0]
    FCMP D0, #0.0
    B.ge L_pf64_pos
    MOV X0, #1
    ADRP X1, L_pf64_minus
    ADD X1, X1, :lo12:L_pf64_minus
    MOV X2, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    LDR D0, [SP, #0]
    FNEG D0, D0
    STR D0, [SP, #0]
L_pf64_pos:
    FCVTZS X0, D0
    MOV X10, SP
    ADD X10, X10, #48
    MOV X11, #0
    CMP X0, #0
    B.ge L_pf64_ipos
    MOV X11, #1
    NEG X0, X0
L_pf64_ipos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pf64_izero
    MOV X9, #10
L_pf64_iloop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pf64_iloop
    B L_pf64_imaybe_neg
L_pf64_izero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pf64_imaybe_neg:
    CBNZ X11, L_pf64_iprepend_minus
    B L_pf64_ido_int
L_pf64_iprepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pf64_ido_int:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    LDR D0, [SP, #0]
    FRINTZ D1, D0
    FSUB D2, D0, D1
    ADRP X8, L_pf64_10
    LDR D3, [X8, :lo12:L_pf64_10]
    MOV X12, #15
    MOV X9, X10
    SUB X9, X9, #15
    MOV X8, X9
L_pf64_frac_loop:
    CBZ X12, L_pf64_frac_done
    FMUL D2, D2, D3
    FCVTZS X0, D2
    ADD X2, X0, #48
    STRB W2, [X8]
    ADD X8, X8, #1
    SCVTF D4, X0
    FSUB D2, D2, D4
    SUB X12, X12, #1
    FCMP D2, #0.0
    B.eq L_pf64_frac_done
    B L_pf64_frac_loop
L_pf64_frac_done:
    SUB X9, X9, #1
    MOV X1, #46
    STRB W1, [X9]
    SUB X2, X8, X9
    MOV X0, #1
    MOV X1, X9
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    ADD SP, SP, #64
    RET
