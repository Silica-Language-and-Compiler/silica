// Comparing a float64 binding with an unsuffixed float literal (`v < 0.0`): the literal takes the
// binding's width. Formerly project-bees SD-13 (compile_defects_float_literal_in_comparison_addition,
// E2003 "type mismatch: v": the literal inferred float32 and no float64 operand check was tried).
// Expected: true, exit 0.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                v: float64 <- 0.0 - 2.5;
                neg: boolean <- v < 0.0;
                _: atom <- print_boolean(neg);
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
