// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(37.375 > 26.0);
                println("");
                _: atom <- print_boolean((5.25 - 31.75) <= 34.25);
                println("");
                _: atom <- print_boolean((32.0 - 8.5) > (10.0 + 31.0));
                println("");
                done: atom <- print_boolean(29.75 * 37.25 >= (10.5 - 9.25))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
