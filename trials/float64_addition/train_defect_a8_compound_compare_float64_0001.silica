// defect A8: float64 compare with compound operands on both sides (typed through an identity helper)
use trial_support_atom;

fn f64(v: float64) -> float64 {
    v
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(f64(3.0) + f64(4.0) > f64(1.0) + f64(1.0));
                println("");
                _: atom <- print_boolean((f64(5.5) + f64(29.0)) > (f64(9.375) + f64(18.0)));
                println("");
                done: atom <- print_boolean(f64(3.0) * f64(4.0) > f64(1.0) * f64(1.0))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
