use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                nan: float64 <- float64_nan();
                one: float64 <- 1.0;
                two: float64 <- 2.0;
                _: atom <- print_boolean(float64_is_nan(nan + one));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan(one + nan));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan(nan - one));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan(one - nan));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan(nan * two));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan(two * nan));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan(nan / two));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan(two / nan));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan((nan + one) * two));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan((one + nan) / two));
                _: unit <- println("");
                _: atom <- print_boolean(float64_is_nan(nan + float64_nan()));
                _: unit <- println("");
                done: atom <- print_boolean(float64_is_nan((float64_nan() * nan) - float64_nan()));
                _: unit <- println("")
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
