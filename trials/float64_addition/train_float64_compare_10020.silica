// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((20.0 + 6.25) == (2.25 - 35.25));
                println("");
                _: atom <- print_boolean((26.125 - 36.5) >= 33.0);
                println("");
                _: atom <- print_boolean(40.0 >= (5.75 + 24.5));
                println("");
                done: atom <- print_boolean((3.125 + 3.5) == 14.25)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
