// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((3.5 + 27.0) != (12.5 + 9.0));
                println("");
                _: atom <- print_boolean((33.75 + 18.0) > 15.25);
                println("");
                _: atom <- print_boolean(11.0 >= 35.5);
                println("");
                done: atom <- print_boolean((14.375 + 7.0) == (4.125 + 9.25))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
