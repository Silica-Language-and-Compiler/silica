// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(35.0 == 5.5);
                println("");
                _: atom <- print_boolean(10.0 * 3.25 == (17.375 + 8.25));
                println("");
                _: atom <- print_boolean(2.125 != (38.5 - 18.0));
                println("");
                done: atom <- print_boolean(1.75 == (0.5 + 38.0))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
