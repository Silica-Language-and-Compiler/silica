// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((15.25 + 8.25) >= 35.25);
                println("");
                _: atom <- print_boolean(13.5 != (16.0 + 25.25));
                println("");
                _: atom <- print_boolean((31.0 + 3.0) > 20.5);
                println("");
                done: atom <- print_boolean((34.5 + 11.25) > (24.0 - 29.5))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
