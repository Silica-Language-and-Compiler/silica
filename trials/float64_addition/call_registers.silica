use trial_support_atom;

fn left64() -> float64 {
    40.5
}

fn right64() -> float64 {
    2.25
}

fn next64(x: float64) -> float64 {
    x + 1.0
}

fn add_with_next64(x: float64) -> float64 {
    x + next64(x)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                expected_sum: float64 <- 42.75;
                expected_param: float64 <- 5.0;
                _: atom <- print_boolean((left64() + right64()) == expected_sum);
                _: unit <- println("");
                base: float64 <- 40.5;
                _: atom <- print_boolean((base + right64()) == expected_sum);
                _: unit <- println("");
                done: atom <- print_boolean(add_with_next64(2.0) == expected_param);
                _: unit <- println("")
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
