// main returns float64; exit code is trunc(13.0 - 8.125) = 4
use trial_support_float64;

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            13.0 - 8.125
        });
        _: int64 <- wait_for_exit()
    produces
        pure 4.875
    end
}
