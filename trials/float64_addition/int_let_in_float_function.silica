// An int64 or boolean binding inside a float-returning function. The let's RHS register followed the
// function's result register instead of the RHS's own type, so in a float64-returning function an
// integer comparison was emitted as `CSET D0, EQ` / `MOV X1, D0` and an int64 product as
// `MUL D0, X9, X10`, none of which assemble ("invalid operand for instruction"). Fixed 2026-09-19 in
// terms/let/let_dispatcher (rhs_reg_for_type).
// Expected, by hand: g(1.5, 0) = 1.5, h(1.5, 9) = 1.5, k(1.5, 3) = 1.5 (2 * 3 == 6), k(1.5, 1) = 3.0.

use trial_support_int64;

fn g(x: float64, n: int64) -> float64 {
    sequence
        c: boolean <- n == 0;
        t: float64 <- case c of { true -> x; false -> x + x }
    produces
        pure t
    end
}

fn h(x: float64, n: int64) -> float64 {
    sequence
        t: float64 <- case n > 3 of { true -> x; false -> x + x }
    produces
        pure t
    end
}

fn k(x: float64, n: int64) -> float64 {
    sequence
        d: int64 <- n * 2;
        t: float64 <- case d == 6 of { true -> x; false -> x + x }
    produces
        pure t
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_float64(g(1.5, 0));
                println("");
                _: atom <- print_float64(h(1.5, 9));
                println("");
                _: atom <- print_float64(k(1.5, 3));
                println("");
                _: atom <- print_float64(k(1.5, 1));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
