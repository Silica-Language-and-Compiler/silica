use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                p1: float64 <- float64_inf();
                o1: float64 <- 1.0;
                _: atom <- print_boolean((p1 + o1) == p1);
                _: unit <- println("");
                o2: float64 <- 1.0;
                p2: float64 <- float64_inf();
                _: atom <- print_boolean((o2 + p2) == p2);
                _: unit <- println("");
                n3: float64 <- float64_neg_inf();
                o3: float64 <- 1.0;
                _: atom <- print_boolean((n3 + o3) == n3);
                _: unit <- println("");
                o4: float64 <- 1.0;
                n4: float64 <- float64_neg_inf();
                _: atom <- print_boolean((o4 + n4) == n4);
                _: unit <- println("");
                p5a: float64 <- float64_inf();
                p5b: float64 <- float64_inf();
                _: atom <- print_boolean((p5a + p5b) == p5a);
                _: unit <- println("");
                n6a: float64 <- float64_neg_inf();
                n6b: float64 <- float64_neg_inf();
                _: atom <- print_boolean((n6a + n6b) == n6a);
                _: unit <- println("");
                p7: float64 <- float64_inf();
                n7: float64 <- float64_neg_inf();
                _: atom <- print_boolean(float64_is_nan(p7 + n7));
                _: unit <- println("");
                n8: float64 <- float64_neg_inf();
                p8: float64 <- float64_inf();
                _: atom <- print_boolean(float64_is_nan(n8 + p8));
                _: unit <- println("");
                p9: float64 <- float64_inf();
                o9: float64 <- 1.0;
                _: atom <- print_boolean((p9 - o9) == p9);
                _: unit <- println("");
                p10a: float64 <- float64_inf();
                p10b: float64 <- float64_inf();
                _: atom <- print_boolean(float64_is_nan(p10a - p10b));
                _: unit <- println("");
                p11: float64 <- float64_inf();
                n11: float64 <- float64_neg_inf();
                _: atom <- print_boolean((p11 - n11) == p11);
                _: unit <- println("");
                n12: float64 <- float64_neg_inf();
                o12: float64 <- 1.0;
                _: atom <- print_boolean((n12 - o12) == n12);
                _: unit <- println("");
                n13: float64 <- float64_neg_inf();
                p13: float64 <- float64_inf();
                _: atom <- print_boolean((n13 - p13) == n13);
                _: unit <- println("");
                n14a: float64 <- float64_neg_inf();
                n14b: float64 <- float64_neg_inf();
                _: atom <- print_boolean(float64_is_nan(n14a - n14b));
                _: unit <- println("");
                p15: float64 <- float64_inf();
                o15: float64 <- 1.0;
                _: atom <- print_boolean((p15 * o15) == p15);
                _: unit <- println("");
                o16: float64 <- 1.0;
                p16: float64 <- float64_inf();
                _: atom <- print_boolean((o16 * p16) == p16);
                _: unit <- println("");
                n17: float64 <- float64_neg_inf();
                o17: float64 <- 1.0;
                _: atom <- print_boolean((n17 * o17) == n17);
                _: unit <- println("");
                o18: float64 <- 1.0;
                n18: float64 <- float64_neg_inf();
                _: atom <- print_boolean((o18 * n18) == n18);
                _: unit <- println("");
                p19a: float64 <- float64_inf();
                p19b: float64 <- float64_inf();
                _: atom <- print_boolean((p19a * p19b) == p19a);
                _: unit <- println("");
                p20: float64 <- float64_inf();
                n20: float64 <- float64_neg_inf();
                _: atom <- print_boolean((p20 * n20) == n20);
                _: unit <- println("");
                n21: float64 <- float64_neg_inf();
                p21: float64 <- float64_inf();
                _: atom <- print_boolean((n21 * p21) == n21);
                _: unit <- println("");
                n22a: float64 <- float64_neg_inf();
                n22b: float64 <- float64_neg_inf();
                _: atom <- print_boolean((n22a * n22b) == float64_inf());
                _: unit <- println("");
                p23: float64 <- float64_inf();
                o23: float64 <- 1.0;
                _: atom <- print_boolean((p23 / o23) == p23);
                _: unit <- println("");
                n24: float64 <- float64_neg_inf();
                o24: float64 <- 1.0;
                _: atom <- print_boolean((n24 / o24) == n24);
                _: unit <- println("");
                p25a: float64 <- float64_inf();
                p25b: float64 <- float64_inf();
                _: atom <- print_boolean(float64_is_nan(p25a / p25b));
                _: unit <- println("");
                p26: float64 <- float64_inf();
                n26: float64 <- float64_neg_inf();
                _: atom <- print_boolean(float64_is_nan(p26 / n26));
                _: unit <- println("");
                n27: float64 <- float64_neg_inf();
                p27: float64 <- float64_inf();
                _: atom <- print_boolean(float64_is_nan(n27 / p27));
                _: unit <- println("");
                n28a: float64 <- float64_neg_inf();
                n28b: float64 <- float64_neg_inf();
                done: atom <- print_boolean(float64_is_nan(n28a / n28b));
                _: unit <- println("")
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
