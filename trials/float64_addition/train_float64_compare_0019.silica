// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((35.375 + 6.5) > 19.0);
                println("");
                _: atom <- print_boolean(32.75 > (26.25 - 8.25));
                println("");
                done: atom <- print_boolean(7.0 <= 13.5 * 0.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
