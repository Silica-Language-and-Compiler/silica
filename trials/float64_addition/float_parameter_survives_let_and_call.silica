// A float64 parameter stays live across a sequence binding and across a call. b3(1.5, 2.0) is
// p = x * y = 3.0, q = p + y = 5.0; b4(1.5) is t = two() = 2.0, r = x * t = 3.0. Both used to be
// wrong (4.5 and 4.0): a function with a float let was excluded from the full parameter shadow
// (emitter_core@use_full_param_shadow), so its float parameters stayed in D0-D7 -- the registers the
// arithmetic stages through and the register a call returns in.
// Expected: 3.0, 3.0, 5.0, 3.0, exit 0.

use trial_support_int64;

fn two() -> float64 { 2.0 }
fn b1(x: float64) -> float64 {
    x * two()
}
fn b2(x: float64) -> float64 {
    x * 2.0
}
fn b3(x: float64, y: float64) -> float64 {
    sequence
        p: float64 <- x * y;
        q: float64 <- p + y
    produces pure q end
}
fn b4(x: float64) -> float64 {
    sequence
        t: float64 <- two();
        r: float64 <- x * t
    produces pure r end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_float64(b1(1.5));
                println("");
                _: atom <- print_float64(b2(1.5));
                println("");
                _: atom <- print_float64(b3(1.5, 2.0));
                println("");
                _: atom <- print_float64(b4(1.5));
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
