// main returns float64; exit code is trunc(24.25) = 24
use trial_support_float64;

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            24.25
        });
        _: int64 <- wait_for_exit()
    produces
        pure 24.25
    end
}
