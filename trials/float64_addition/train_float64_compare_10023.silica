// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((21.5 - 39.0) > (38.5 - 38.5));
                println("");
                _: atom <- print_boolean((0.0 + 30.125) == 6.5);
                println("");
                done: atom <- print_boolean((32.0 - 32.75) <= 26.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
