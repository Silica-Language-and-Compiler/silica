// defect A1: second float64 parameter must reach the callee; addf(1.5, 2.25) = 3.75
use trial_support_atom;

fn addf(x: float64, y: float64) -> float64 {
    x + y
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_float64(addf(1.5, 2.25))
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
