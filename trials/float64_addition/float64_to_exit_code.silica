// Ensures float64->int conversion for termination numbers works.
// main returns float64; compiler emits FCVTZS W0, D0 so exit code = trunc(15.1) = 15.
use trial_support_float64;

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            2.5 + 3.2 * 3.9375
        });
        _: int64 <- wait_for_exit()
    produces
        pure 15.100000000000001
    end
}
