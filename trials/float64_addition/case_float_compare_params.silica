// A case on a comparison of two float64 parameters whose arms return those parameters. The compare
// stages its operands in D1/D2 (`FMOV D2, D1`, `FMOV D1, D0`), which overwrites b's register D1, and
// the true arm then returns D1, now a: bigger(1.5, 2.5) returned 1.5 instead of 2.5.
use trial_support_atom;

fn bigger(a: float64, b: float64) -> float64 {
    case a < b of {
        true -> b;
        false -> a
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] r: atom <- print_float64(bigger(1.5, 2.5)) produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
