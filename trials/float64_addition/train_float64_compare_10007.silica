// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(22.0 * 29.0 <= (39.0 + 3.0));
                println("");
                _: atom <- print_boolean(31.5 > (0.25 + 3.0));
                println("");
                done: atom <- print_boolean((2.25 + 19.0) != (10.5 + 27.0))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
