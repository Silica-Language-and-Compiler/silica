// Float64 arguments that follow a function-typed parameter. The callee calls its function parameter
// with its own float parameters (x, y), so it must move them from its incoming float registers into
// the outgoing ones. With literal arguments at the call site, apply2(addf, 3.0, 4.5) printed
// 0.000000000000000 instead of 7.5, the non-tail form f(x, y) + 1.0 printed 1.0 instead of 8.5, and
// apply_mixed(7, addf, 2.0) printed 0.5 instead of 2.5. The bound-variable call is the control.
// Expected, by hand: 7.5 (bound a, b), 7.5 (literals), 8.5 (7.5 + 1.0), 2.5 (2.0 + 0.5), 7.5
// (plain two-float call, control); exits 0.
use trial_support_int64;

fn addf(a: float64, b: float64) -> float64 {
    a + b
}

fn apply2(f: fn(float64, float64) -> float64, x: float64, y: float64) -> float64 {
    f(x, y)
}

fn apply2_nontail(f: fn(float64, float64) -> float64, x: float64, y: float64) -> float64 {
    f(x, y) + 1.0
}

fn apply_mixed(n: int64, f: fn(float64, float64) -> float64, x: float64) -> float64 {
    f(x, 0.5) + 0.0
}

fn plain2(x: float64, y: float64) -> float64 {
    x + y
}

fn show(v: float64) -> atom {
    sequence proc[device_io]
        _: atom <- print_float64(v);
        r: atom <- println("")
    produces
        pure r
    end
}

fn work() -> int64 {
    sequence
        a: float64 <- 3.0;
        b: float64 <- 4.5;
        _: atom <- show(apply2(addf, a, b));
        _: atom <- show(apply2(addf, 3.0, 4.5));
        _: atom <- show(apply2_nontail(addf, 3.0, 4.5));
        _: atom <- show(apply_mixed(7, addf, 2.0));
        _: atom <- show(plain2(3.0, 4.5))
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            work()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
