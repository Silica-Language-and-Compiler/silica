// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((23.0 + 30.125) <= (15.25 + 35.0));
                println("");
                _: atom <- print_boolean(27.125 * 24.25 <= 33.0);
                println("");
                _: atom <- print_boolean(25.0 >= (17.0 - 4.0));
                println("");
                done: atom <- print_boolean((25.5 - 35.25) != (19.5 - 12.25))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
