// float64 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((33.5 + 40.375) != 3.0 * 5.5);
                println("");
                _: atom <- print_boolean((21.0 + 16.5) <= 2.5 * 25.125);
                println("");
                _: atom <- print_boolean((33.125 - 5.0) == (22.125 - 20.0));
                println("");
                done: atom <- print_boolean((36.25 + 36.5) <= 25.75 * 39.375)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
