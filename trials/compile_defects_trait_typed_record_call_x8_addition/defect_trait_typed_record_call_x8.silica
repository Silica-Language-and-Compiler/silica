// Emitter defect (2026-10-16, repro x8r): stale X8 at a trait-typed record-returning call.
// A record-returning callee copies its result into the buffer its caller passes in X8 when X8 is
// non-zero. The call site `users: OrderedMap[string, int64, mem(normal)] <- wbt_map@empty({...})`
// binds the result to a trait-typed name, and that path never set X8, so wbt_map_empty copied its
// record through whatever X8 last held. The overrun is usually benign, so a run seldom shows it.
// Fix: every call clears X8 (`MOV X8, XZR`) unless it passes a buffer on purpose.
// The .ascomp golden is the check: it pins `MOV X8, XZR` immediately before the BLR to
// wbt_map_empty, and before the other record-returning calls made here -- wbt_map@insert (a
// generic module) and OrderedMap@get (dispatched through the trait).
// Expected:
//   41
//   2
//   0

use wbt_map;
use OrderedMap;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                users: OrderedMap[string, int64, mem(normal)] <- wbt_map@empty({
                    compare_key: cmp_str,
                    compare_value: cmp_i64
                });
                r1: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(users, "ann", 41);
                r2: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(r1.map, "bob", 2);
                g: { status: :not_found | :found, value: int64 } <- OrderedMap@get(r2.map, "ann", 0);
                a: atom <- print_int64(g.value);
                println("");
                b: atom <- print_int64(OrderedMap@size(r2.map));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
