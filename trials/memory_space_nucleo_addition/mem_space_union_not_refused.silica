// Trial: a parameter typed with a union of mem(...) alternatives that includes a refused space (device) is
// NOT refused: only a single explicit space is checked (the Supervisor.silica spawn-spec union, which every
// trial compiles, relies on this). The function never uses the refused space; main calls it with a normal list.
// Expect 7.
use trial_support_int64;

fn pick(xs: List[int64, mem(normal) | mem(normal_writethrough) | mem(device)]) -> int64 {
    7
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [1, 2];
                n: int64 <- pick(xs)
            produces
                pure n
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
