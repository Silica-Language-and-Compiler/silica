// Board size check: an actor asks for a uint8 buffer of 100,000,000 bytes, below the emitter's size cap but
// far above the board's RAM. The region allocation fails and ends THAT actor (the failure report goes to the
// registered reporter); the image keeps running and main finishes.
// Expected: "worker ended", "done", then status 0.

fn fill(count: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, uint8, count) <- alloc_buf(r, count);
        _: atom <- write_buf(buf, 0, 5)
    produces
        pure count
    end
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, fill(msg) + state)
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        println("worker ended");
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(w, 100000000 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        println("done")
    produces
        pure 0
    end
}
