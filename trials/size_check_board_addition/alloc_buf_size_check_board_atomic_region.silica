// Board size check: an atomic region's buffer of 4,294,967,280 (0xFFFFFFF0) bytes. Before the check the
// region's bump pointer wrapped and no error was raised. Now the emitter's size check refuses it: the report
// "[silica] abort: invalid buffer size at 0x<pc>" and exit status 71; no buffer is handed out.
// Expected: the abort line, 71.

fn grab(count: int64) -> int64 {
    sequence proc[mem(atomic), atomic]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, atomic) <- alloc_region(atomic);
        buf: buf(L1, atomic, uint8, count) <- alloc_buf(r, count)
    produces
        pure count
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        n: int64 <- grab(4294967280);
        print_int64(n);
        println("")
    produces
        pure 0
    end
}
