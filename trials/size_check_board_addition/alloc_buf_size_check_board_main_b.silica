// Board size check: a uint8 buffer of 0xF0000000 bytes, above the emitter's size cap.
// The count reaches alloc_buf through a parameter and is computed at run time (1 * 4026531840). The first call
// allocates one byte; the second asks for 4026531840 bytes, which the emitter's size check refuses: the report
// "[silica] abort: invalid buffer size at 0x<pc>" on the console and exit status 71. Nothing after it runs.
// Expected: 1, the abort line, 71 (compare_scout_normalized.sh folds the address to <PTR>).

fn fill(count: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, uint8, count) <- alloc_buf(r, count);
        _: atom <- write_buf(buf, 0, 5)
    produces
        pure count
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- fill(1);
        print_int64(a);
        println("");
        b: int64 <- fill(a * 4026531840);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
