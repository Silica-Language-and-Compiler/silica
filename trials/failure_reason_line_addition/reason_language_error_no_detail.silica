// The reason line of a language error whose cause the runtime does not record (spec §15.4.13: the
// detail after the em dash is optional; nothing is invented). A call to a cast-only actor is the
// run-time convention check of §16.2.6.4: the caller fails with failure_reason :language_error,
// reason_tag 2, through the shared language-error entry, which knows no more than the variant, so
// the report reads
//   reason:          :language_error
// with no detail. As actors_addition/conv_actor_call_to_cast_only: main gets the cast-only sink back
// as a call reply from directory so the reference reaches driver through a flow the compiler does not
// follow; the sink casts 2 to driver, and driver's call to the sink is the mismatch.
//
// Expected output (as a multiset):
//   6 sink
//   one failure report: reason :language_error, reason_tag 2, frame #0 ..._driver
//   0

// Prints its state plus one, then casts 2 to the actor named in the message.
fn sink(msg: actor_ref, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print_int64(state + 1);
        println(" sink");
        _: boolean <- cast(msg, 2 impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

// Hands back the reference it holds: a call reply, which the compiler does not follow.
fn directory(msg: int64, state: actor_ref) -> (:reply, actor_ref, actor_ref) {
    (:reply, state, state)
}

// state is the sink, from directory's call reply. The call is the mismatch.
fn driver(msg: int64, state: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency, device_io]
        v: int64 <- call(state, msg impl ActorMessage {});
        println("driver: not reached")
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter(1);
        k: actor_ref <- spawn(5, sink, stack_policy(0, :keep_last_message));
        d: actor_ref <- spawn(k, directory, stack_policy(0, :keep_last_message));
        r: actor_ref <- call(d, 0 impl ActorMessage {});
        dr: actor_ref <- spawn(r, driver, stack_policy(0, :keep_last_message));
        _: boolean <- cast(r, dr impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236). region_dump_limit
// is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// The reporter writes every report to standard error. Its state counts down the reports main waits
// for; the last of them ends main's wait_for_exit() with cast_exit(0).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, left)
    end
}

fn start_reporter(expected: int64) -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
