// The reason line for the reasons a program gives itself (spec §15.1.2.3, §15.4.11.2): three
// unsupervised cast-only workers, each ended by its own message 0.
//   fail_self(:badarg)                 -> reason:          (:explicit, :badarg)      reason_tag 4
//   stop_self((:explicit, :done))      -> reason:          (:explicit, :done)        reason_tag 4
//   stop_self(:normal)                 -> reason:          :normal                   reason_tag 0
// :badarg and :done are program atoms: the report prints their names from the runtime's copy of
// the program's atom table, at the indices the program gives them.
//
// Expected output (as a multiset):
//   done
//   three failure reports: (:explicit, :badarg) frame #0 ..._failing, (:explicit, :done) frame #0
//     ..._stopping, :normal frame #0 ..._leaving
//   0

fn failing(msg: int64, state: int64) -> (:no_reply, int64) {
    case msg of {
        0 -> {
            sequence proc[concurrency]
                _: atom <- fail_self(:badarg)
            produces pure (:no_reply, state) end
        };
        _: int64 -> (:no_reply, state + msg)
    }
}

fn stopping(msg: int64, state: int64) -> (:no_reply, int64) {
    case msg of {
        0 -> {
            sequence proc[concurrency]
                _: atom <- stop_self((:explicit, :done))
            produces pure (:no_reply, state) end
        };
        _: int64 -> (:no_reply, state + msg)
    }
}

fn leaving(msg: int64, state: int64) -> (:no_reply, int64) {
    case msg of {
        0 -> {
            sequence proc[concurrency]
                _: atom <- stop_self(:normal)
            produces pure (:no_reply, state) end
        };
        _: int64 -> (:no_reply, state + msg)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter(3);
        f: actor_ref <- spawn(0, failing, stack_policy(0, :keep_last_message));
        s: actor_ref <- spawn(0, stopping, stack_policy(0, :keep_last_message));
        l: actor_ref <- spawn(0, leaving, stack_policy(0, :keep_last_message));
        _: boolean <- cast(f, 0 impl ActorMessage {});
        _: boolean <- cast(s, 0 impl ActorMessage {});
        _: boolean <- cast(l, 0 impl ActorMessage {});
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236). region_dump_limit
// is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// The reporter writes every report to standard error. Its state counts down the reports main waits
// for; the last of them ends main's wait_for_exit() with cast_exit(0).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, left)
    end
}

fn start_reporter(expected: int64) -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
