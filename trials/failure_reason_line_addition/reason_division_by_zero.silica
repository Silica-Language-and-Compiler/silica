// The failure report's reason line (spec §15.4.13 unwind report format, §15.4.11.2 failure_reason): the
// line above reason_tag spells the failure_reason variant and, where the runtime knows the cause, an
// em dash and the detail. An unsupervised cast-only worker divides by its message, 0: the runtime ends
// it with :language_error (reason_tag 2) and the division-by-zero site records its cause, so the report
// reads
//   reason:          :language_error — integer division by zero
// The reporter writes the report to standard error and ends the program with status 0 after the one
// report it expects. The runtime's own "[silica] root actor exited (no supervisor)" note is written
// separately (compared as a multiset; the compare script drops that note).
//
// Expected output (as a multiset):
//   done
//   one failure report: reason :language_error — integer division by zero, reason_tag 2,
//     frame #0 reason_division_by_zero_divide
//   0

// Cast-only worker: its message is the divisor.
fn divide(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, 1000 / msg)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter(1);
        w: actor_ref <- spawn(7, divide, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 0 impl ActorMessage {});
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236). region_dump_limit
// is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// The reporter writes every report to standard error. Its state counts down the reports main waits
// for; the last of them ends main's wait_for_exit() with cast_exit(0).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, left)
    end
}

fn start_reporter(expected: int64) -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
