// The reason line for kill_abnormal (spec §15.1.2.3, §15.4.11.2): the victim ends with failure_reason
// (:explicit, :killed), reason_tag 4, and the report spells the runtime atom's name:
//   reason:          (:explicit, :killed)
// :killed is a runtime atom the program never spells, so the name comes from the runtime's own copy of
// the atom table. A killer actor kills the victim it holds as its state and replies; main prints the
// reply and waits for the one report.
//
// Expected output (as a multiset):
//   killed
//   one failure report: reason (:explicit, :killed), reason_tag 4, frame #0 reason_explicit_killed_echo
//   0

fn echo(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg, state)
}

fn killer(msg: int64, victim: actor_ref) -> (:reply, int64, actor_ref) {
    sequence proc[concurrency]
        _: atom <- kill_abnormal(victim)
    produces
        pure (:reply, msg, victim)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter(1);
        victim: actor_ref <- spawn(0, echo, stack_policy(0, :keep_last_message));
        k: actor_ref <- spawn(victim, killer, stack_policy(0, :keep_last_message));
        _: int64 <- call(k, 1 impl ActorMessage {});
        println("killed");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236). region_dump_limit
// is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// The reporter writes every report to standard error. Its state counts down the reports main waits
// for; the last of them ends main's wait_for_exit() with cast_exit(0).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, left)
    end
}

fn start_reporter(expected: int64) -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
