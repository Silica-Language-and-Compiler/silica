// Inner supervisor of failure_reason_line_addition/reason_shutdown_and_killed_children: two :permanent
// cast-only workers that never fail on their own, :rk with shutdown 0 and :rs with shutdown 50. When
// the root supervisor terminates this supervisor, it shuts them down first (spec §15.4.12.2): :rk is
// killed at once, (:explicit, :killed), and :rs is asked to stop, (:explicit, :shutdown).
use Supervisor;

export ReasonInnerSup_child_start/1;

impl ReasonInnerSup for Supervisor;

// Cast-only worker: adds its message to its state.
fn inner_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 10000000000 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :rk, agent_type: :worker, initial_state: initial_state, behavior: inner_worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :rs, agent_type: :worker, initial_state: initial_state, behavior: inner_worker, restart: :permanent, shutdown: 50, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn ReasonInnerSup_child_start(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    init(initial_state)
}
