// list_index_ends_actor  (OPEN: staged in region_hazards_open_addition, see README.md)
//
// Q9 / stage 8 (region_memory_safety_design.md §15 Q9: the actor-failure outcome "applies to
// L_buf_invalid and to the list-index abort by the same reasoning, which is worth deciding
// together"; §13 stage 8): a list index past the end inside an actor ends THAT actor (reason
// atom not fixed by the design; :list_index would be the analogue of :buf_bounds), handled by its
// supervisor; the rest of the program keeps running. In main it stays runtime abort 71.
// Today (hosted): L_list_at_helper's L_lat_oob calls _silica_rt_abort_list_index:
// "[silica] abort: list index out of range at 0x..." and status 71 for the whole process
// (runtime_failure_reporting.md §4). Q9 is open; this .scout records recommendation (a).
// Same program as buf_bounds_ends_actor, with the worker picking element msg of [7, 8, 9]
// (list_addition/list_at_out_of_range_aborts's pick): main calls it with 2 (9 + state 100 = 109),
// the crasher calls it with 3, main calls the restarted worker with 0 (7 + 100 = 107).
// Pass vs fail: a pass prints the lines below and exits 0. Today: 109, the abort line, 71.
// The banner shows reason_tag 4; the reason atom is not printed, so it is not checked.
// Expected output (compared as a multiset: reports are asynchronous):
//   109
//   failure report: worker reason_tag 4    list_at(xs, 3) on a 3-element list ends the worker
//   failure report: crasher reason_tag 4   the crasher's call raises actor_not_found
//   after restart
//   107
//   done
//   0

use Supervisor;

impl ListIndexEndsActorSup for Supervisor;

fn pick(i: int64) -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [7, 8, 9];
        v: int64 <- list_at[int64, mem(normal)](xs, i)
    produces
        pure v
    end
}

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, pick(msg) + state, state + 1)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 3600 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :li_worker, agent_type: :worker, initial_state: initial_state, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

// Calls the worker with its message; when the worker ends before replying, the call raises
// actor_not_found and the crasher fails with reason_tag 4 (spec §16.1.1).
fn crasher(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: int64 <- call_registered(:li_worker, msg impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- start_reporter(2);
        _: supervisor_ref <- spawn_registered_supervisor(ListIndexEndsActorSup, 100, :li_sup, stack_policy(0, :keep_last_message));
        r1: int64 <- call_registered(:li_worker, 2 impl ActorMessage {});
        print_int64(r1);
        println("");
        k: actor_ref <- spawn(0, crasher, stack_policy(0, :keep_last_message));
        _: boolean <- cast(k, 3 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        println("after restart");
        r2: int64 <- call_registered(:li_worker, 0 impl ActorMessage {});
        print_int64(r2);
        println("");
        println("done")
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

// One line per report, naming the failed behaviour; the state counts down from the number of
// reports main waits for, and the last ends main's wait_for_exit() with cast_exit(0).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print(report_kind(report));
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, left)
    end
}

fn report_who(report: string) -> string {
    case contains(report, "_worker\n") of {
        true -> "worker";
        false -> case contains(report, "_crasher\n") of { true -> "crasher"; false -> "other" }
    }
}

fn report_kind(report: string) -> string {
    case contains(report, "reason_tag:      4") of {
        true -> concat(concat("failure report: ", report_who(report)), " reason_tag 4\n");
        false -> concat(concat("failure report: ", report_who(report)), " other reason\n")
    }
}

fn start_reporter(expected: int64) -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
