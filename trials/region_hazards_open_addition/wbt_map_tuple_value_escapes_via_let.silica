// wbt_map_tuple_value_escapes_via_let  (OPEN: staged in region_hazards_open_addition, see README.md)
//
// Hazard H3 (region_memory_safety_design.md §1.3, stage 0 in §13, run trial in §14.2): a tuple
// bound by a let in a helper's frame and passed BY NAME into a call that keeps it must be
// promoted out of the frame, exactly as a tuple literal passed directly is. add_pair binds
// v <- (n, "v") and passes v to wbt_map@insert, which stores the value in the new node; add_pair
// then returns. main inserts keys 1 and 2 (values (10, "v") and (20, "v")), runs scrub, which
// fills the same stack area with other tuples, and reads both values back.
// Origin: the staged repro of memory note silica-aggregate-var-arg-not-promoted (2026-09-08); the
// original file lived in a session scratchpad and is lost (only a trial-cache .ascomp of it is
// left in ordered_data_structures/wbt_core/.trial_cache). Rebuilt here from its literal companion
// ordered_data_structures/wbt_core/wbt_map_tuple_value_escapes_frame (fixed and gated), changed in
// the one place the hazard needs: the value is a let-bound name, not a literal at the call.
// Today (published Mac compiler 999942, 2026-10-22): see README.md for the observed output. The
// argument-promote gate fires only on a literal tuple_make/record_make (term_reg_spill
// is_aggregate_make), so v's pointer into add_pair's frame is what the node keeps.
// Pass vs fail: a pass prints "1 10 v", "2 20 v" and "0" (exit status). A fail prints other
// numbers or strings for the values (whatever scrub left in the slot), a nonzero exit, or a fault.
// No .ascomp: today's assembly is the defective codegen.

use wbt_map;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_pair(a: (int64, string), b: (int64, string)) -> :less | :equal | :greater {
    (a0: int64, _: string) <- a;
    (b0: int64, _: string) <- b;
    cmp_i64(a0, b0)
}

// Builds the value tuple in ITS OWN frame as a let-bound name and hands the name to insert.
fn add_pair(
    m: {
        root: ref?(L, normal, (int64, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    k: int64,
    n: int64
) -> {
    root: ref?(L, normal, (int64, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence
        v: (int64, string) <- (n, "v");
        r: {
            map: {
                root: ref?(L, normal, (int64, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(m, k, v)
    produces
        pure r.map
    end
}

// Reuses the stack area add_pair ran in: each level binds two tuples of other values.
fn scrub(depth: int64) -> int64 {
    a: (int64, string) <- (depth * 1000 + 7, "scrubbed");
    b: (int64, string) <- (depth * 1000 + 9, "garbage");
    (x: int64, _: string) <- a;
    (y: int64, _: string) <- b;
    case depth == 0 of { true -> x + y; false -> x + y + scrub(depth - 1) - x - y }
}

fn show(k: int64, g: { status: :not_found | :found, value: (int64, string) }) -> int64 {
    sequence proc[device_io]
        (n: int64, s: string) <- g.value;
        _: atom <- print_int64(k);
        print(" ");
        _: atom <- print_int64(case g.status of { :found -> n; :not_found -> -1 });
        print(" ");
        println(s)
    produces pure case g.status of { :found -> 0; :not_found -> 1 } end
}

fn main() -> int64 {
    sequence
        e: {
            root: ref?(L, normal, (int64, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_pair });
        m1: {
            root: ref?(L, normal, (int64, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- add_pair(e, 1, 10);
        m2: {
            root: ref?(L, normal, (int64, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- add_pair(m1, 2, 20);
        _: int64 <- scrub(50);
        g1: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(m2, 1, (0, "none"));
        g2: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(m2, 2, (0, "none"));
        s1: int64 <- show(1, g1);
        s2: int64 <- show(2, g2)
    produces
        pure s1 + s2
    end
}
