// write_ref_young_into_heap_shell_ref  (OPEN: staged in region_hazards_open_addition, see README.md)
//
// Hazard (Phase2_notes.md §3 item 4, second case): the heap-shell twin of write_ref_young_into_older_cell.
// The actor's state is a record { cell, tag } whose cell is a ref the spawn walked to the heap. In
// message 1 the behaviour allocates `young` (7, :none) in ITS frame and writes (1, young) into the
// state's cell; the behaviour returns and its result evacuation scans the state RECORD in place but
// not the heap REFTUP cell inside it, so the cell still names the dead frame. In message 2 the
// behaviour runs scrub() (overwriting the stack that held `young`) and then reads the value through
// the cell.
// Pass vs fail: a pass prints 0 (message 1's reply) and 7 (young's value through the heap cell), then
// the exit status 0. A fail prints another second number (what scrub left) or -1 (the link was lost),
// or faults. Expected to fail with the phase 2 compiler; becomes the gate when the evacuator scans
// old ref cells or write_ref promotes the stored pointer.
// The shape (an actor whose state type names a lifetime L) is unverified: if the unit does not
// compile, report the error before changing the trial.
// No .ascomp: today's assembly is the defective codegen.

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn first_of(c: ref(L, normal, (int64, ref?(L, normal, rec)))) -> int64 {
    sequence proc[mem(normal)]
        w: (int64, ref?(L, normal, rec)) <- read_ref(c);
        (v: int64, _: ref?(L, normal, (int64, ref?(L, normal, rec)))) <- w
    produces
        pure v
    end
}

fn scrub(n: int64) -> int64 {
    sequence proc[mem(normal)]
        L2: lifetime <- fresh_lifetime();
        c: ref(L2, normal, int64) <- alloc_ref(999 + n);
        v: int64 <- read_ref(c);
        rest: int64 <- case n == 0 of { true -> 0; false -> scrub(n - 1) }
    produces
        pure v + rest
    end
}

fn do_attach(state: { cell: ref(L, normal, (int64, ref?(L, normal, rec))), tag: int64 }) -> int64 {
    sequence proc[mem(normal)]
        nothing: ref?(L, normal, (int64, ref?(L, normal, rec))) <- :none;
        young: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec((7, nothing));
        _: atom <- write_ref(state.cell, (1, young))
    produces
        pure 0
    end
}

fn do_follow(state: { cell: ref(L, normal, (int64, ref?(L, normal, rec))), tag: int64 }) -> int64 {
    sequence proc[mem(normal)]
        noise: int64 <- scrub(30);
        w: (int64, ref?(L, normal, rec)) <- read_ref(state.cell);
        (_: int64, next_ref: ref?(L, normal, (int64, ref?(L, normal, rec)))) <- w;
        out: int64 <- case next_ref of {
            :none -> 0 - 1;
            y: ref(L, normal, (int64, ref?(L, normal, rec))) -> first_of(y)
        }
    produces
        pure out
    end
}

fn beh(msg: int64, state: { cell: ref(L, normal, (int64, ref?(L, normal, rec))), tag: int64 }) -> (:reply, int64, { cell: ref(L, normal, (int64, ref?(L, normal, rec))), tag: int64 }) {
    v: int64 <- case msg == 1 of { true -> do_attach(state); false -> do_follow(state) };
    (:reply, v, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        L: lifetime <- fresh_lifetime();
        reg: region(L, normal) <- alloc_region(normal);
        nothing: ref?(L, normal, (int64, ref?(L, normal, rec))) <- :none;
        cell: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(reg, (0, nothing));
        init: { cell: ref(L, normal, (int64, ref?(L, normal, rec))), tag: int64 } <- { cell: cell, tag: 5 };
        a: actor_ref <- spawn(init, beh, stack_policy(0, :keep_last_message));
        x1: int64 <- call(a, 1 impl ActorMessage {});
        x2: int64 <- call(a, 2 impl ActorMessage {});
        print_int64(x1);
        println("");
        print_int64(x2);
        println("")
    produces
        pure 0
    end
}
