// write_ref_young_into_older_cell  (OPEN: staged in region_hazards_open_addition, see README.md)
//
// Hazard (Phase2_notes.md §3 item 4, chunk 15 phase 2): write_ref of a pointer to a node of a YOUNGER
// frame into a ref cell of an OLDER frame. The evacuation of the younger frame's result scans old
// aggregates (records, tuples, sums) in place but not old REF1 / REFTUP cells, so the pointer the
// cell now holds still names the younger frame's node after that frame returns and its stack is
// reused. main allocates `old` (0, :none); attach() allocates `young` (7, :none) in its own frame
// and writes (1, young) into `old`; scrub() then overwrites the stack the younger frame occupied;
// follow() reads old's link and young's first word.
// Pass vs fail: a pass prints 7 (young's value read through the older cell) and 0 (exit status).
// A fail prints another number (the value scrub left in the slot, or -1 if the link was lost) or
// faults. Today (phase 2 build) the cell is not scanned, so this is expected to fail; it becomes
// the gate when the evacuator scans old ref cells (or write_ref promotes the stored pointer).
// No .ascomp: today's assembly is the defective codegen.

fn first_of(c: ref(L, normal, (int64, ref?(L, normal, rec)))) -> int64 {
    sequence proc[mem(normal)]
        w: (int64, ref?(L, normal, rec)) <- read_ref(c);
        (v: int64, _: ref?(L, normal, (int64, ref?(L, normal, rec)))) <- w
    produces
        pure v
    end
}

fn attach(
    r: region(L, normal),
    old: ref(L, normal, (int64, ref?(L, normal, rec))),
    nothing: ref?(L, normal, (int64, ref?(L, normal, rec)))
) -> region(L, normal) {
    sequence proc[mem(normal)]
        young: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (7, nothing));
        _: atom <- write_ref(old, (1, young))
    produces
        pure r
    end
}

fn scrub(n: int64) -> int64 {
    sequence proc[mem(normal)]
        L2: lifetime <- fresh_lifetime();
        c: ref(L2, normal, int64) <- alloc_ref(999 + n);
        v: int64 <- read_ref(c);
        rest: int64 <- case n == 0 of { true -> 0; false -> scrub(n - 1) }
    produces
        pure v + rest
    end
}

fn follow(old: ref(L, normal, (int64, ref?(L, normal, rec)))) -> int64 {
    sequence proc[mem(normal)]
        w: (int64, ref?(L, normal, rec)) <- read_ref(old);
        (_: int64, next_ref: ref?(L, normal, (int64, ref?(L, normal, rec)))) <- w;
        out: int64 <- case next_ref of {
            :none -> 0 - 1;
            y: ref(L, normal, (int64, ref?(L, normal, rec))) -> first_of(y)
        }
    produces
        pure out
    end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        nothing: ref?(L, normal, (int64, ref?(L, normal, rec))) <- :none;
        old: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (0, nothing));
        r1: region(L, normal) <- attach(r, old, nothing);
        noise: int64 <- scrub(50);
        got: int64 <- follow(old);
        print_int64(got);
        println("")
    produces
        pure 0
    end
}
