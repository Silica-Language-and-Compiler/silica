// Regression: many live values across calls force FP frame spill slots
// past AArch64 unscaled LDR/STR range [-256,255]. Seed must emit
// address materialization (SUB/MOV + [X16]) for deep spills, and size the
// spill slab large enough for non-reused slots + wide expression temps.
// Expected printed sum: 1..40 = 820

use trial_support_atom;

fn id(x: int64) -> int64 {
    x
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                sum: int64 <- {
                    v01: int64 <- id(1);
                    v02: int64 <- id(2);
                    v03: int64 <- id(3);
                    v04: int64 <- id(4);
                    v05: int64 <- id(5);
                    v06: int64 <- id(6);
                    v07: int64 <- id(7);
                    v08: int64 <- id(8);
                    v09: int64 <- id(9);
                    v10: int64 <- id(10);
                    v11: int64 <- id(11);
                    v12: int64 <- id(12);
                    v13: int64 <- id(13);
                    v14: int64 <- id(14);
                    v15: int64 <- id(15);
                    v16: int64 <- id(16);
                    v17: int64 <- id(17);
                    v18: int64 <- id(18);
                    v19: int64 <- id(19);
                    v20: int64 <- id(20);
                    v21: int64 <- id(21);
                    v22: int64 <- id(22);
                    v23: int64 <- id(23);
                    v24: int64 <- id(24);
                    v25: int64 <- id(25);
                    v26: int64 <- id(26);
                    v27: int64 <- id(27);
                    v28: int64 <- id(28);
                    v29: int64 <- id(29);
                    v30: int64 <- id(30);
                    v31: int64 <- id(31);
                    v32: int64 <- id(32);
                    v33: int64 <- id(33);
                    v34: int64 <- id(34);
                    v35: int64 <- id(35);
                    v36: int64 <- id(36);
                    v37: int64 <- id(37);
                    v38: int64 <- id(38);
                    v39: int64 <- id(39);
                    v40: int64 <- id(40);
                    v01 + v02 + v03 + v04 + v05 + v06 + v07 + v08 + v09 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 + v21 + v22 + v23 + v24 + v25 + v26 + v27 + v28 + v29 + v30 + v31 + v32 + v33 + v34 + v35 + v36 + v37 + v38 + v39 + v40
                };
                result: atom <- print_int64(sum)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
