// Sixteen live int64 bindings exhaust X19-X28, so the pair returned by lookup and its
// elements are spilled to X29 frame slots. The record element is then read through a field
// projection inside a case arm after the short-circuit condition moved SP: the reader must
// address the element through its frame slot, not through an SP-relative alias of the tuple
// slab. 2 * (1 + ... + 16) + 30 + 12 = 314
use trial_support_atom;

fn id(x: int64) -> int64 {
    x
}

fn lookup(x: int64) -> (boolean, { name: string, arity: int64, weight: int64 }) {
    (true, { name: "found", arity: x + 23, weight: 12 })
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                total: int64 <- {
                    v01: int64 <- id(1) + 1;
                    v02: int64 <- id(2) + 2;
                    v03: int64 <- id(3) + 3;
                    v04: int64 <- id(4) + 4;
                    v05: int64 <- id(5) + 5;
                    v06: int64 <- id(6) + 6;
                    v07: int64 <- id(7) + 7;
                    v08: int64 <- id(8) + 8;
                    v09: int64 <- id(9) + 9;
                    v10: int64 <- id(10) + 10;
                    v11: int64 <- id(11) + 11;
                    v12: int64 <- id(12) + 12;
                    v13: int64 <- id(13) + 13;
                    v14: int64 <- id(14) + 14;
                    v15: int64 <- id(15) + 15;
                    v16: int64 <- id(16) + 16;
                    (found: boolean, decl: { name: string, arity: int64, weight: int64 }) <- lookup(7);
                    case found and decl.name == "found" of {
                        true -> v01 + v02 + v03 + v04 + v05 + v06 + v07 + v08 + v09 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + decl.arity + decl.weight;
                        false -> 0
                    }
                };
                result: atom <- print_int64(total)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
