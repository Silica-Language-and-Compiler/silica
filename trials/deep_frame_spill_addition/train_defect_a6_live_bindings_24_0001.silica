// defect A6: 24 live int64 bindings computed from expressions and summed in one block; sum = 600
use trial_support_atom;

fn id(x: int64) -> int64 {
    x
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                sum: int64 <- {
                    v01: int64 <- id(1) + 1;
                    v02: int64 <- id(2) + 2;
                    v03: int64 <- id(3) + 3;
                    v04: int64 <- id(4) + 4;
                    v05: int64 <- id(5) + 5;
                    v06: int64 <- id(6) + 6;
                    v07: int64 <- id(7) + 7;
                    v08: int64 <- id(8) + 8;
                    v09: int64 <- id(9) + 9;
                    v10: int64 <- id(10) + 10;
                    v11: int64 <- id(11) + 11;
                    v12: int64 <- id(12) + 12;
                    v13: int64 <- id(13) + 13;
                    v14: int64 <- id(14) + 14;
                    v15: int64 <- id(15) + 15;
                    v16: int64 <- id(16) + 16;
                    v17: int64 <- id(17) + 17;
                    v18: int64 <- id(18) + 18;
                    v19: int64 <- id(19) + 19;
                    v20: int64 <- id(20) + 20;
                    v21: int64 <- id(21) + 21;
                    v22: int64 <- id(22) + 22;
                    v23: int64 <- id(23) + 23;
                    v24: int64 <- id(24) + 24;
                    v01 + v02 + v03 + v04 + v05 + v06 + v07 + v08 + v09 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 + v21 + v22 + v23 + v24
                };
                result: atom <- print_int64(sum)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
