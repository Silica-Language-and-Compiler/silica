// Phase C: third spawn argument is a non-literal uint64 expression.
// Exercises comma + full expr grammar in the placement slot without requiring placement-keyword typing.
// Golden cpu_spawn_third_nonliteral_affinity.scout: `make integrate` captures print_int64 output then exit code.

use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                r: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message), 2 + 3);
                x: int64 <- call(r, 1 impl ActorMessage {});
                print_int64(x);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
