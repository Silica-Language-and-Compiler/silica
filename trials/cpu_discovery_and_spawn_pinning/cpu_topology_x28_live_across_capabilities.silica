// A caller's live binding in X28 survives get_core_capabilities (spec §22.10). The runtime
// routine keeps the requested core id in X28 and, until 2026-10-20, saved only X19-X26 on the
// AArch64 targets, so the tenth simultaneously live int64 of a sequence (the emitter homes
// bindings in X19 .. X28 in order) read back as the core id after the call. ten_live binds ten
// values, calls get_core_capabilities(0) and sums them: 55 either way on a sound runtime, 45 when
// X28 (j, 10) comes back as 0. The second sum passes a different id so a clobber cannot hide
// behind the value 0. On linux_x86_64 the bindings are frame slots and the sums hold by construction.

use trial_support_atom;

fn ten_live(seed: int64, core: int64) -> int64 {
    sequence proc[concurrency]
        a: int64 <- seed + 1;
        b: int64 <- seed + 2;
        c: int64 <- seed + 3;
        d: int64 <- seed + 4;
        e: int64 <- seed + 5;
        f: int64 <- seed + 6;
        g: int64 <- seed + 7;
        h: int64 <- seed + 8;
        i: int64 <- seed + 9;
        j: int64 <- seed + 10;
        ci: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- get_core_capabilities(core);
        k: int64 <- ci.id;
        s1: int64 <- a + b;
        s2: int64 <- s1 + c;
        s3: int64 <- s2 + d;
        s4: int64 <- s3 + e;
        s5: int64 <- s4 + f;
        s6: int64 <- s5 + g;
        s7: int64 <- s6 + h;
        s8: int64 <- s7 + i;
        s9: int64 <- s8 + j;
        s10: int64 <- s9 + k;
        s11: int64 <- s10 - core
    produces
        pure s11
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io, mem(normal)]
                first: int64 <- ten_live(0, 0);
                println("ten live values around get_core_capabilities(0):");
                print_int64(first);
                println("");
                pc: List[int64, mem(normal)] <- get_performance_cores();
                pl: int64 <- length[int64, mem(normal)](pc);
                last: int64 <- pl - 1;
                second: int64 <- ten_live(0, last);
                println("ten live values around get_core_capabilities(last performance core):");
                print_int64(second);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
