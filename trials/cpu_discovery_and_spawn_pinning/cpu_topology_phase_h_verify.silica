// Phase H fixture: exercises get_core_capabilities / get_cpu_topology under `sequence proc[concurrency, …]`.
// Golden cpu_topology_phase_h_verify.scout: five lines (a..e) then process exit (`2` = :ok with current emitter).
// Lines c and e are 1 only when get_cpu_topology() reports cores / NUMA nodes; refresh .scout if runtime layout changes.
// Until 2026-10-19 the .scout held 0 for both: _silica_rt_sysctl_u64 wiped its length word before the call, so
// hw.memsize read as 0 and get_cpu_topology() answered its failure value. With the helper fixed a real machine
// reports its cores and its one NUMA node (hosted targets that still carry the defect fail here until it is ported).

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io, mem(normal)]
                sent_neg: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- get_core_capabilities(-1);
                a: int64 <- case sent_neg.id < 0 of {
                    true -> 1;
                    false -> 0
                };
                print_int64(a);
                println("");
                sent_bad: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- get_core_capabilities(999999);
                b: int64 <- case sent_bad.id < 0 of {
                    true -> 1;
                    false -> 0
                };
                print_int64(b);
                println("");
                top: { cores: List[{ id: int64, core_type: atom, capabilities: List[string,mem(normal)], frequency_mhz: int64 },mem(normal)], numa_nodes: List[{ id: int64, cores: List[int64,mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 },mem(normal)] },mem(normal)], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64,mem(normal)] },mem(normal)] } } <- get_cpu_topology();
                ncores: int64 <- length[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)](top.cores);
                // Both lengths must use top before get_core_capabilities(0): emitter may hold topology ptr in X11; z overwrites that reg.
                nnuma: int64 <- length[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)](top.numa_nodes);
                c: int64 <- case ncores > 0 of {
                    true -> 1;
                    false -> 0
                };
                print_int64(c);
                println("");
                z: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- get_core_capabilities(0);
                d: int64 <- case z.id == 0 of {
                    true -> 1;
                    false -> 0
                };
                print_int64(d);
                println("");
                e: int64 <- case nnuma > 0 of {
                    true -> 1;
                    false -> 0
                };
                print_int64(e);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
