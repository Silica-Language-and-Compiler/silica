// cpu_topology_implementation_plan Phase C: spawn(initial, behavior [, core_id: uint64]) third argument (§4.6 / §15.1.1).
// Prints 3 (0+3) and 105 (100+5). `main` returns 42 via `produces pure 42` (process exit); golden .scout is stdout then `echo $?`.

use trial_support_int8;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            sequence proc[concurrency, device_io]
                a: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message), 2);
                b: actor_ref <- spawn(100, acc, stack_policy(0, :keep_last_message), 1);
                ra: int64 <- call(a, 3 impl ActorMessage {});
                rb: int64 <- call(b, 5 impl ActorMessage {});
                print_int64(ra);
                println("");
                print_int64(rb);
                println("")
            produces
                pure 42
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 42
    end
}
