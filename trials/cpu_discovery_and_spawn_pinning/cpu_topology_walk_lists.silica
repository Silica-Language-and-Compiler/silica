// Walks every list get_cpu_topology() answers (spec §22.10): cores, each core's capabilities,
// numa_nodes, each node's cores and memory_ranges, and cache_hierarchy.levels with each level's
// shared_cores. Until 2026-10-20 the runtime built those lists as 16-byte {record, next} cons
// cells while the compiled list builtins read a {length, chunk, cursor} handle over 32-byte
// chunks, so length(top.cores) was a record's address (cpu_topology_phase_h_verify's
// `ncores > 0` held by accident) and any head/remove_head walk faulted; the capabilities were
// bare C-string pointers, not Silica strings. Every line here is a 1/0 outcome or an equality
// that holds on every host, so one .scout serves the Mac and the Linux hosts.

use trial_support_atom;

// 1 when every string in xs is non-empty, else 0.
fn strings_ok(xs: List[string, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[string, mem(normal)](xs);
        r: int64 <- case n == 0 of {
            true -> 1;
            false -> {
                s: string <- head[string, mem(normal)](xs);
                rest: List[string, mem(normal)] <- remove_head[string, mem(normal)](xs);
                here: int64 <- case length_bytes(s) > 0 of {
                    true -> 1;
                    false -> 0
                };
                m: int64 <- strings_ok(rest);
                case here == 1 and m == 1 of {
                    true -> 1;
                    false -> 0
                }
            }
        }
    produces
        pure r
    end
}

// 1 when every core has an id in [0, total), a non-empty capabilities list of non-empty
// strings and a frequency_mhz that is not negative, else 0.
fn cores_ok(xs: List[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)], total: int64) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)](xs);
        r: int64 <- case n == 0 of {
            true -> 1;
            false -> {
                c: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- head[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)](xs);
                rest: List[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)] <- remove_head[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)](xs);
                id: int64 <- c.id;
                id_ok: int64 <- case id >= 0 and id < total of {
                    true -> 1;
                    false -> 0
                };
                caps: List[string, mem(normal)] <- c.capabilities;
                ncaps: int64 <- length[string, mem(normal)](caps);
                caps_ok: int64 <- strings_ok(caps);
                freq: int64 <- c.frequency_mhz;
                here: int64 <- case id_ok == 1 and ncaps > 0 and caps_ok == 1 and freq >= 0 of {
                    true -> 1;
                    false -> 0
                };
                m: int64 <- cores_ok(rest, total);
                case here == 1 and m == 1 of {
                    true -> 1;
                    false -> 0
                }
            }
        }
    produces
        pure r
    end
}

// The number of cores whose core_type is :performance.
fn count_performance(xs: List[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)](xs);
        r: int64 <- case n == 0 of {
            true -> 0;
            false -> {
                c: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- head[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)](xs);
                rest: List[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)] <- remove_head[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)](xs);
                kind: atom <- c.core_type;
                here: int64 <- case kind == :performance of {
                    true -> 1;
                    false -> 0
                };
                m: int64 <- count_performance(rest);
                here + m
            }
        }
    produces
        pure r
    end
}

// 1 when every memory range has a non-negative start, a positive size and a non-negative
// latency, else 0.
fn ranges_ok(xs: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[{ start_address: int64, size: int64, latency: int64 }, mem(normal)](xs);
        r: int64 <- case n == 0 of {
            true -> 1;
            false -> {
                g: { start_address: int64, size: int64, latency: int64 } <- head[{ start_address: int64, size: int64, latency: int64 }, mem(normal)](xs);
                rest: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] <- remove_head[{ start_address: int64, size: int64, latency: int64 }, mem(normal)](xs);
                start: int64 <- g.start_address;
                size: int64 <- g.size;
                lat: int64 <- g.latency;
                here: int64 <- case start >= 0 and size > 0 and lat >= 0 of {
                    true -> 1;
                    false -> 0
                };
                m: int64 <- ranges_ok(rest);
                case here == 1 and m == 1 of {
                    true -> 1;
                    false -> 0
                }
            }
        }
    produces
        pure r
    end
}

// 1 when every NUMA node has a non-negative id, a non-empty cores list and at least one
// well-formed memory range, else 0.
fn nodes_ok(xs: List[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)](xs);
        r: int64 <- case n == 0 of {
            true -> 1;
            false -> {
                node: { id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] } <- head[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)](xs);
                rest: List[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)] <- remove_head[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)](xs);
                id: int64 <- node.id;
                node_cores: List[int64, mem(normal)] <- node.cores;
                ncores: int64 <- length[int64, mem(normal)](node_cores);
                ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] <- node.memory_ranges;
                nranges: int64 <- length[{ start_address: int64, size: int64, latency: int64 }, mem(normal)](ranges);
                r_ok: int64 <- ranges_ok(ranges);
                here: int64 <- case id >= 0 and ncores > 0 and nranges > 0 and r_ok == 1 of {
                    true -> 1;
                    false -> 0
                };
                m: int64 <- nodes_ok(rest);
                case here == 1 and m == 1 of {
                    true -> 1;
                    false -> 0
                }
            }
        }
    produces
        pure r
    end
}

// 1 when every cache level is numbered 1..3, has a positive size_kb and a non-empty
// shared_cores list, else 0. A host whose cache sizes are unknown reports no levels, which is 1.
fn levels_ok(xs: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)](xs);
        r: int64 <- case n == 0 of {
            true -> 1;
            false -> {
                lv: { level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] } <- head[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)](xs);
                rest: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)] <- remove_head[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)](xs);
                level: int64 <- lv.level;
                size_kb: int64 <- lv.size_kb;
                line: int64 <- lv.line_size;
                assoc: int64 <- lv.associativity;
                shared: List[int64, mem(normal)] <- lv.shared_cores;
                nshared: int64 <- length[int64, mem(normal)](shared);
                here: int64 <- case level >= 1 and level <= 3 and size_kb > 0 and line >= 0 and assoc >= 0 and nshared > 0 of {
                    true -> 1;
                    false -> 0
                };
                m: int64 <- levels_ok(rest);
                case here == 1 and m == 1 of {
                    true -> 1;
                    false -> 0
                }
            }
        }
    produces
        pure r
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io, mem(normal)]
                pc: List[int64, mem(normal)] <- get_performance_cores();
                pl: int64 <- length[int64, mem(normal)](pc);
                ec: List[int64, mem(normal)] <- get_efficiency_cores();
                el: int64 <- length[int64, mem(normal)](ec);
                total: int64 <- pl + el;
                top: { cores: List[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)], numa_nodes: List[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)] } } <- get_cpu_topology();
                cores: List[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)] <- top.cores;
                ncores: int64 <- length[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)](cores);
                count_ok: int64 <- case ncores == total and ncores > 0 of {
                    true -> 1;
                    false -> 0
                };
                println("cores count is P + E:");
                print_int64(count_ok);
                println("");
                walk_ok: int64 <- cores_ok(cores, total);
                println("every core has an id in range and capability names:");
                print_int64(walk_ok);
                println("");
                nperf: int64 <- count_performance(cores);
                perf_ok: int64 <- case nperf == pl of {
                    true -> 1;
                    false -> 0
                };
                println("performance cores agree with get_performance_cores:");
                print_int64(perf_ok);
                println("");
                nodes: List[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)] <- top.numa_nodes;
                nnodes: int64 <- length[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)](nodes);
                some_nodes: int64 <- case nnodes > 0 of {
                    true -> 1;
                    false -> 0
                };
                println("at least one NUMA node:");
                print_int64(some_nodes);
                println("");
                n_ok: int64 <- nodes_ok(nodes);
                println("every node has cores and a memory range:");
                print_int64(n_ok);
                println("");
                cache: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)] } <- top.cache_hierarchy;
                levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)] <- cache.levels;
                l_ok: int64 <- levels_ok(levels);
                println("every cache level is well formed:");
                print_int64(l_ok);
                println("");
                z: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- get_core_capabilities(0);
                zcaps: List[string, mem(normal)] <- z.capabilities;
                nz: int64 <- length[string, mem(normal)](zcaps);
                z_ok: int64 <- strings_ok(zcaps);
                single_ok: int64 <- case nz > 0 and z_ok == 1 of {
                    true -> 1;
                    false -> 0
                };
                println("get_core_capabilities(0) names capabilities:");
                print_int64(single_ok);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
