// Host-independent twin of cpu_topology_runtime_queries (spec §22.10, CPU affinity appendix).
// get_performance_cores() / get_efficiency_cores() answer List[int64, mem(normal)] values that the
// list builtins read: the performance ids are 0 .. P-1 in order, the efficiency ids follow them as
// P .. P+E-1 (E is 0 on a uniform machine: the Linux hosts, the ESP32-S3), and P + E is the number
// of ids get_core_capabilities answers for (id = i), one past it being the id: -1 sentinel.
// Unlike its twin this golden names no core count, so one .scout serves every host.

use trial_support_atom;

// 1 when xs is exactly [from, from + 1, ..., from + length - 1], else 0. An empty list is a run.
fn ids_run_from(xs: List[int64, mem(normal)], from: int64) -> int64 {
    sequence proc[mem(normal)]
        cur: List[int64, mem(normal)] <- xs;
        n: int64 <- length[int64, mem(normal)](cur);
        r: int64 <- case n == 0 of {
            true -> 1;
            false -> {
                h: int64 <- head[int64, mem(normal)](cur);
                rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](cur);
                next: int64 <- from + 1;
                m: int64 <- ids_run_from(rest, next);
                case h == from of {
                    true -> m;
                    false -> 0
                }
            }
        }
    produces
        pure r
    end
}

// 1 when get_core_capabilities(i) names core i, else 0.
fn core_id_is(i: int64) -> int64 {
    sequence proc[concurrency]
        ci: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- get_core_capabilities(i);
        r: int64 <- case ci.id == i of {
            true -> 1;
            false -> 0
        }
    produces
        pure r
    end
}

// 1 when get_core_capabilities(i) is the failure sentinel (id: -1), else 0.
fn core_id_is_sentinel(i: int64) -> int64 {
    sequence proc[concurrency]
        ci: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- get_core_capabilities(i);
        r: int64 <- case ci.id == -1 of {
            true -> 1;
            false -> 0
        }
    produces
        pure r
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io, mem(normal)]
                pc: List[int64, mem(normal)] <- get_performance_cores();
                pl: int64 <- length[int64, mem(normal)](pc);
                ec: List[int64, mem(normal)] <- get_efficiency_cores();
                el: int64 <- length[int64, mem(normal)](ec);
                some_p: int64 <- case pl > 0 of {
                    true -> 1;
                    false -> 0
                };
                println("performance cores present:");
                print_int64(some_p);
                println("");
                p_run: int64 <- ids_run_from(pc, 0);
                println("performance ids are 0..P-1 in order:");
                print_int64(p_run);
                println("");
                e_run: int64 <- ids_run_from(ec, pl);
                println("efficiency ids are P..P+E-1 in order:");
                print_int64(e_run);
                println("");
                total: int64 <- pl + el;
                last: int64 <- total - 1;
                last_ok: int64 <- core_id_is(last);
                println("the last id answers get_core_capabilities:");
                print_int64(last_ok);
                println("");
                past_ok: int64 <- core_id_is_sentinel(total);
                println("one past the last id is the sentinel:");
                print_int64(past_ok);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
