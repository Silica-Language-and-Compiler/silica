// cpu_topology_implementation plan: nullary topology list helpers, get_cpu_topology, unary get_core_capabilities — parser + runtime-helper call shapes (spec §22.10 / appendix).
// Golden cpu_topology_runtime_queries.scout: `make integrate` captures stdout then exit code; core counts and id lists match this machine’s sysctl/runtime (refresh .scout after intentional source changes).

use trial_support_atom;

fn ignore_cpu_topology(t: { cores: List[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)], numa_nodes: List[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)] } }) -> atom {
    :ok
}

fn ignore_core_info(c: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }) -> atom {
    :ok
}

// Walk a List[int64, mem(normal)] in order: print each element on its own line, then recurse on remove_head.
fn print_list(xs: List[int64, mem(normal)]) -> atom {
    sequence proc[device_io, mem(normal)]
        // Copy list into a let so the pointer survives length(...) and I/O (X0 is not a stable param home across BL).
        cur: List[int64, mem(normal)] <- xs;
        n: int64 <- length[int64, mem(normal)](cur);
        r: atom <- case n == 0 of {
            true -> :ok;
            false -> {
                h: int64 <- head[int64, mem(normal)](cur);
                print_int64(h);
                println("");
                rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](cur);
                print_list(rest)
            }
        }
    produces
        pure r
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io, mem(normal)]
                ec: List[int64, mem(normal)] <- get_efficiency_cores();
                // length(ec) before get_performance_cores: both return in X0; second call would clobber if lengths were reordered.
                el: int64 <- length[int64, mem(normal)](ec);
                println("el length: ");
                print_int64(el);
                println("");
                println("efficiency core ids:");
                _: atom <- print_list(ec);
                println("");
                pc: List[int64, mem(normal)] <- get_performance_cores();
                pl: int64 <- length[int64, mem(normal)](pc);
                println("pl length: ");
                print_int64(pl);
                println("");
      
                println("performance core ids:");
                _: atom <- print_list(pc);
                println("");
                // el/pl live in caller-saved regs; compute z then print before topology BLs (they clobber X4–X18).
                z: int64 <- el + pl;
                println("combined: ");
                print_int64(z);
                println("");
                top: { cores: List[{ id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 }, mem(normal)], numa_nodes: List[{ id: int64, cores: List[int64, mem(normal)], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, mem(normal)] }, mem(normal)], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, mem(normal)] }, mem(normal)] } } <- get_cpu_topology();
                _: atom <- ignore_cpu_topology(top);
                ci: { id: int64, core_type: atom, capabilities: List[string, mem(normal)], frequency_mhz: int64 } <- get_core_capabilities(0);
                _: atom <- ignore_core_info(ci)
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
