// device_fault_lines through the third registry: spawn_device_registered flags the ACB in
// _silica_rt_register_device_actor_named itself, so the worker's fault report carries the same
// exccause / epc / excvaddr lines. Same fault (head of an empty list on :boom), same expectation.
use device_gpio_lib;
use device_esp32s3_gpio_registers;
use trial_wait_int64;

fn first_of(xs: List[int64, mem(normal)]) -> int64 {
    xs.head
}

fn worker(msg: { op: atom, n: int64 }, state: :unmapped | (:mapped, device_window(L, (:esp32s3_gpio)))) -> (:no_reply, :unmapped | (:mapped, device_window(L, (:esp32s3_gpio)))) {
    sequence proc[register_rwr, mem(normal)]
        next: :unmapped | (:mapped, device_window(L, (:esp32s3_gpio))) <- case state of {
            :unmapped -> case msg.op of {
                :init -> {
                    w: device_window(L, (:esp32s3_gpio)) <- map_device((:esp32s3_gpio), 0x60004000);
                    (:mapped, w)
                };
                _: atom -> :unmapped
            };
            (:mapped, w: device_window(L, (:esp32s3_gpio))) -> case msg.op of {
                :boom -> {
                    none: List[int64, mem(normal)] <- [];
                    v: int64 <- first_of(none) + msg.n;
                    case v == 0 of {
                        true -> :unmapped;
                        false -> (:mapped, w)
                    }
                };
                _: atom -> (:mapped, w)
            }
        }
    produces
        pure (:no_reply, next)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                d: device_actor_ref <- spawn_device_registered(:unmapped, worker, :device_faulty, stack_policy(0, :keep_last_message));
                _: boolean <- cast_device_registered(:device_faulty, { op: :init, n: 0 } impl ActorMessage {});
                _: boolean <- cast_device_registered(:device_faulty, { op: :boom, n: 1 } impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
