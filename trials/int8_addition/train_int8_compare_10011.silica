// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((12 + 42) <= 11);
                println("");
                _: atom <- print_boolean(55 / 32 == (8 + 9));
                println("");
                _: atom <- print_boolean((18 + 7) <= 0 % 32);
                println("");
                _: atom <- print_boolean(37 > 48 % 58);
                println("");
                result: atom <- print_boolean((0 + 18) >= 2)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
