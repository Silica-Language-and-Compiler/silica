// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(26 % 18 < 20);
                println("");
                _: atom <- print_boolean(1 >= (11 + 43));
                println("");
                _: atom <- print_boolean(40 < (20 + 51));
                println("");
                _: atom <- print_boolean(5 % 51 < (49 + 46));
                println("");
                result: atom <- print_boolean((7 + 22) >= (53 + 24))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
