// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(42 == (22 + 26));
                println("");
                _: atom <- print_boolean(2 % 5 == 15 % 24);
                println("");
                _: atom <- print_boolean((5 + 12) != (51 + 6));
                println("");
                _: atom <- print_boolean((36 + 15) <= 15);
                println("");
                result: atom <- print_boolean(5 % 41 < (44 - 18))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
