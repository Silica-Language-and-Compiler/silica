// Negative hexadecimal and binary literals at the bottom of every signed width, and -0x0 / -0b0 for
// the unsigned widths: the lexer reads a radix prefix after the sign exactly as it reads decimal
// digits, so -0x80 is the literal -128 wherever -128 is accepted (let-bound, passed to a same-module
// parameter, a record field, a tuple field), and the range check judges the literal by its value.
// The rejections one step below each minimum, and any other negative for an unsigned width, live in
// error_enforcement_addition (negative_hex_literal_*, negative_binary_literal_*).
// Expected: -128, -128, -32768, -2147483648, -9223372036854775808, 0, 0, 0, 0, -128, -255, -128,
// -78187493530; exits 0.
use trial_support_int64;

fn same_u8(i: uint8) -> uint8 {
    i
}

fn same_u16(i: uint16) -> uint16 {
    i
}

fn same_u32(i: uint32) -> uint32 {
    i
}

fn same_u64(i: uint64) -> uint64 {
    i
}

fn same_i8(i: int8) -> int8 {
    i
}

fn same_i16(i: int16) -> int16 {
    i
}

fn same_i32(i: int32) -> int32 {
    i
}

fn same_i64(i: int64) -> int64 {
    i
}

fn first_of(t: (int8, int64)) -> int8 {
    (a: int8, _: int64) <- t;
    a
}

fn second_of(t: (int8, int64)) -> int64 {
    (_: int8, b: int64) <- t;
    b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                low: int8 <- -0x80;
                _: atom <- print_int8(low);
                println("");
                _: atom <- print_int8(same_i8(-0b10000000));
                println("");
                _: atom <- print_int16(same_i16(-0x8000));
                println("");
                _: atom <- print_int32(same_i32(-0x80000000));
                println("");
                _: atom <- print_int64(same_i64(-0x8000000000000000));
                println("");
                _: atom <- print_uint8(same_u8(-0x0));
                println("");
                _: atom <- print_uint16(same_u16(-0b0));
                println("");
                _: atom <- print_uint32(same_u32(-0x0));
                println("");
                _: atom <- print_uint64(same_u64(-0x0));
                println("");
                r: { a: int8, b: int64 } <- { a: -0x80, b: -0xFF };
                _: atom <- print_int8(r.a);
                println("");
                _: atom <- print_int64(r.b);
                println("");
                t: (int8, int64) <- (-0b10000000, -0x123456789A);
                _: atom <- print_int8(first_of(t));
                println("");
                _: atom <- print_int64(second_of(t));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
