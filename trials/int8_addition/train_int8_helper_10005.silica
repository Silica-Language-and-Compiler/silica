// helper blend/3 on int8; blend(8, 16, 17) = 1
use trial_support_int8;

fn blend(x: int8, y: int8, z: int8) -> int8 {
    x / 6 - y / z
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            blend(8, 16, 17)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1
    end
}
