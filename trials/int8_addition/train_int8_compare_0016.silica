// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(19 / 7 <= 5 / 49);
                println("");
                _: atom <- print_boolean(46 > (37 + 56));
                println("");
                _: atom <- print_boolean(41 / 36 != 5);
                println("");
                result: atom <- print_boolean((58 - 4) == 17)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
