// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((32 + 24) >= 53);
                println("");
                _: atom <- print_boolean((60 + 33) <= 39 / 54);
                println("");
                _: atom <- print_boolean(13 >= (31 / 56));
                println("");
                _: atom <- print_boolean((6 + 47) > 25 / 57);
                println("");
                result: atom <- print_boolean(42 / 42 != (32 + 27))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
