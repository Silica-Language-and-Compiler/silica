// helper scale/1 on int8; scale(15) = 0
use trial_support_int8;

fn scale(x: int8) -> int8 {
    x - x - x / 35
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            scale(15)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
