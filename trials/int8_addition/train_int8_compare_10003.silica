// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(49 != (30 + 24));
                println("");
                _: atom <- print_boolean(18 >= 37 / 50);
                println("");
                _: atom <- print_boolean(32 > 44 / 17);
                println("");
                _: atom <- print_boolean((59 + 22) != 18);
                println("");
                result: atom <- print_boolean((53 - 42) != 12 / 60)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
