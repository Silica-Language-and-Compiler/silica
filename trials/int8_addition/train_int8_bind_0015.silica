// int8 bindings then expression; expect 48
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            c: int8 <- 33;
            height: int8 <- (c - c - c % c);
            k: int8 <- c + height - (c + height);
            base: int8 <- c + (15 - height);
            base * (35 / 33) + k - k
        });
        _: int64 <- wait_for_exit()
    produces
        pure 48
    end
}
