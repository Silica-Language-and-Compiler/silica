// recursive pow2 on int8; pow2(1) = 2
use trial_support_int8;

fn pow2(n: int8) -> int8 {
    case n == 0 of {
        true -> 1;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            pow2(1)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 2
    end
}
