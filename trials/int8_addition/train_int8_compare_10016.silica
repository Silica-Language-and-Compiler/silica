// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(35 % 18 == (49 + 48));
                println("");
                _: atom <- print_boolean(54 / 13 <= 12);
                println("");
                _: atom <- print_boolean(55 % 39 >= (13 + 57));
                println("");
                result: atom <- print_boolean(16 < (23 + 21))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
