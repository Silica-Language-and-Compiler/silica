// int8 bindings then expression; expect 23
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            height: int8 <- 38;
            step: int8 <- 40 + height - (4 + height);
            c: int8 <- 60 / height;
            base: int8 <- 52 + (12 + c);
            7 + base / 4 + step - step
        });
        _: int64 <- wait_for_exit()
    produces
        pure 23
    end
}
