// int8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(0 <= (42 + 6));
                println("");
                _: atom <- print_boolean(49 % 40 > 6);
                println("");
                _: atom <- print_boolean((29 + 31) > (22 + 45));
                println("");
                _: atom <- print_boolean((43 + 52) < 7);
                println("");
                result: atom <- print_boolean(32 >= (11 + 17))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
