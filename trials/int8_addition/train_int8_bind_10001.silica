// int8 bindings then expression; expect 126
use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            count: int8 <- 47;
            d: int8 <- 47 % count;
            step: int8 <- d % count;
            32 % 41 + (count + count) + step - step
        });
        _: int64 <- wait_for_exit()
    produces
        pure 126
    end
}
