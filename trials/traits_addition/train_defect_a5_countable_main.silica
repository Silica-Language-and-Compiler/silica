// defect A5: provided-method overloads must survive the exit-75 resume; 10 + 14 = 24
use Countable;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            Countable@double_count(5) + Countable@double_count({ items: 3, extra: 4 })
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
