// defect A5 companion: a second root using Sizeable so the suite has more than 32 units; 9 + 1 = 10
use Sizeable;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            Sizeable@size(9) + Sizeable@size(1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
