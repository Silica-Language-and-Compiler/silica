// A trait method whose result mentions a placeholder is dispatched by the receiver's own
// representation, not by declaration order: Items has two implementations over different records and
// the argument is the first one's (silica-specification §3.4.12).
// Expected: 7, exit 0.

use Items;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn lists() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [7, 8]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                a: { compare_value: fn(int64, int64) -> :less | :equal | :greater, xs: List[int64, mem(normal)] } <- { compare_value: cmp_i64, xs: lists() };
                got: List[int64, mem(normal)] <- Items@items(a);
                print_int64(got.head);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
