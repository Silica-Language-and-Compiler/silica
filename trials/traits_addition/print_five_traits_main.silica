use Sizeable;
use Scalable;
use Doubling;
use Labeled;
use TwiceRaw;
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                v0: int64 <- Sizeable@size(11);
                _: atom <- print_int64(v0);
                _: atom <- println("");
                v1: int64 <- Scalable@scale(7);
                _: atom <- print_int64(v1);
                _: atom <- println("");
                v2: int64 <- Doubling@double(3);
                _: atom <- print_int64(v2);
                _: atom <- println("");
                v3: int64 <- Labeled@code_of(41);
                _: atom <- print_int64(v3);
                _: atom <- println("");
                v4: int64 <- TwiceRaw@total(5);
                _: atom <- print_int64(v4);
                _: atom <- println("");
                result: atom <- :ok
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
