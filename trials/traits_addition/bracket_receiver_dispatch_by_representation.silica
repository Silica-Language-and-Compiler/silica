// A value bound with a collection bracket type (`g: UndirectedGraph[int64, int64, mem(normal)] <-
// StubGraphUndirected@empty({...})`) is the record its registered constructor returns
// (common_contract.md §2), so a trait call on it dispatches to THAT representation's implementation,
// not to whichever implementation is declared first or last. traits/PickGraph.silica declares the
// other record's implementation last.
// Expected: 5 (the stub record's count), exit 0.

use StubGraphUndirected;
use PickGraph;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                g: UndirectedGraph[int64, int64, mem(normal)] <- StubGraphUndirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_i64 });
                n: int64 <- PickGraph@count(g);
                print_int64(n);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
