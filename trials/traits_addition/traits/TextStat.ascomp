    ; export_trait TextStat
    ; required_fn char_len t TextStat -> int64 []


TextStat_char_len:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X0, X19
    STR X0, [SP, #-16]!
    BL L_length_chars_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X0, X12

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #23
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_length_chars_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    CBZ X19, Lch_z
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lch_bad
    LDR X20, [X19, #8]
    LDR X21, [X19, #16]
    MOV X0, #0
    MOV X9, #0
Lch_lp:
    CMP X9, X21
    B.HS Lch_done
    LDRB W10, [X20, X9]
    ADD X0, X0, #1
    CMP W10, #0x80
    B.LO Lch_a1
    AND W11, W10, #0xE0
    CMP W11, #0xC0
    B.EQ Lch_a2
    AND W11, W10, #0xF0
    CMP W11, #0xE0
    B.EQ Lch_a3
    AND W11, W10, #0xF8
    CMP W11, #0xF0
    B.EQ Lch_a4
Lch_a1:
    ADD X9, X9, #1
    B Lch_lp
Lch_a2:
    ADD X9, X9, #2
    B Lch_lp
Lch_a3:
    ADD X9, X9, #3
    B Lch_lp
Lch_a4:
    ADD X9, X9, #4
    B Lch_lp
Lch_done:
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Lch_z:
    MOV X0, #0
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Lch_bad:
    BRK #1

