    // export_trait TextStat
    // required_fn char_len t TextStat -> int64 []


.set SVR_AREA, 16
.set SVR_X12, 8
.set SVR_X19, 16
.globl TextStat_char_len
TextStat_char_len:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA
    mov QWORD PTR [rbp - SVR_X19], rdi

    mov rdi, QWORD PTR [rbp - SVR_X19]

    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rdi
    call L_length_chars_helper
    mov QWORD PTR [rbp - SVR_X12], rdi
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    mov rdi, QWORD PTR [rbp - SVR_X12]

    leave
    ret
L_pa_helper:
    test rdi, rdi
    js L_pa_oob
    cmp rdi, 23
    jge L_pa_oob
    lea r9, [rip + L_pa_table]
    mov r10, rdi
    shl r10, 4
    add r9, r10
    mov rsi, QWORD PTR [r9]
    mov rdx, QWORD PTR [r9 + 8]
    mov edi, 1
    mov eax, 1
    syscall
    xor edi, edi
    ret
L_pa_oob:
    xor edi, edi
    ret

L_length_chars_helper:
    push rbp
    mov rbp, rsp
    mov r10, rdi
    test r10, r10
    jz Lch_z
    mov rsi, QWORD PTR [r10]
    mov rdx, -1
    cmp rsi, rdx
    jne Lch_bad
    mov r8, QWORD PTR [r10 + 8]
    mov r9, QWORD PTR [r10 + 16]
    xor edi, edi
    xor r11d, r11d
Lch_lp:
    cmp r11, r9
    jae Lch_done
    movzx eax, BYTE PTR [r8 + r11]
    add rdi, 1
    cmp eax, 0x80
    jb Lch_a1
    mov ecx, eax
    and ecx, 0xE0
    cmp ecx, 0xC0
    je Lch_a2
    mov ecx, eax
    and ecx, 0xF0
    cmp ecx, 0xE0
    je Lch_a3
    mov ecx, eax
    and ecx, 0xF8
    cmp ecx, 0xF0
    je Lch_a4
Lch_a1:
    add r11, 1
    jmp Lch_lp
Lch_a2:
    add r11, 2
    jmp Lch_lp
Lch_a3:
    add r11, 3
    jmp Lch_lp
Lch_a4:
    add r11, 4
    jmp Lch_lp
Lch_done:
    pop rbp
    ret
Lch_z:
    xor edi, edi
    pop rbp
    ret
Lch_bad:
    ud2

