.text
.global _Labeled_code_of
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
    ; export_trait Labeled
    ; required_fn code_of x Labeled -> int64 []


_Labeled_code_of:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    MOV X9, X0
    MOV X10, #1


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #23
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

