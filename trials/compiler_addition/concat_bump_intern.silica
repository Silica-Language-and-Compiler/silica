// Growing concat(acc, ch) used to mmap a page per call. Type checking
// wbt_map.silica does thousands of strip_spaces char-by-char concats;
// that reached 75GB and SIGKILL. Empty operands must return the other
// string; a growing result must still compare equal. Want 42.

use trial_support_int64;

fn grow(n: int64, acc: string) -> string {
    case n <= 0 of {
        true -> acc;
        false -> grow(n - 1, concat(acc, "x"))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty_l: string <- concat("", "ab");
                empty_r: string <- concat("cd", "");
                both: string <- concat(empty_l, empty_r);
                grown: string <- grow(64, "");
                result: int64 <- case both == "abcd" of {
                    true -> case length_bytes(grown) == 64 of {
                        true -> case substring(grown, 60, 64) == "xxxx" of {
                            true -> 42;
                            false -> 1
                        };
                        false -> 2
                    };
                    false -> 3
                }
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
