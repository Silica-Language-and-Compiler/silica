// Probes the SECOND X8 injection site (emitter_core body_outer_root): a function whose body IS a
// tuple literal gets |_tuple_sret=X8, guarded only by an unchecked comment claiming "no BL inside
// the make". Here both elements are calls that allocate, so region_alloc clobbers X8 before the
// stores. Want 34.

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

// Allocates (region_alloc), which is what actually clobbers X8.
fn head_of_new_list(n: int64) -> int64 {
    xs: List[int64, mem(normal)] <- cons_int(n, empty_ints());
    xs.head
}

fn pair() -> (int64, int64) {
    (head_of_new_list(3), head_of_new_list(4))
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (a: int64, b: int64) <- pair();
            a * 10 + b
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
