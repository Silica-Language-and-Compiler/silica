// comparison@emit_compare_op(dest, cond, reg_prefix) is three string parameters whose body
// is string_concat prims. concat lowers to BL L_concat_helper, which clobbers caller-saved
// X0–X18. Full param shadow used to ignore kind-6 string_concat, so the third argument
// stayed in X2. The first concat destroyed it, and the second concat(reg_prefix, "10")
// read garbage. Selfhost hung at "Emitting..." in comparison_emit_compare_op while
// compiling `n > 0` in region_case_arm.
//
// Want 3: len("X" + "9" + "Y"). A clobbered suffix crashes or yields another length.

use trial_support_int64;

fn glue(prefix: string, mid: string, suffix: string) -> int64 {
    length_bytes(concat(concat(prefix, mid), suffix))
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            glue("X", "9", "Y")
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
