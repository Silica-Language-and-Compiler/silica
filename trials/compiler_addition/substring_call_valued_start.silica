// substring whose start argument is itself a call: length_bytes stages its operand in X0,
// which used to replace the string staged there for substring's first argument (both emitters
// guarded only the third argument). type_interner@parse_bracket_args has exactly this shape,
// so every Heap/Tree/SearchTree/PriorityQueue/graph type surface failed to parse. Want 7 7 7.
use trial_support_int64;

fn after_prefix(s: string, p: string) -> int64 {
    length_bytes(substring(s, length_bytes(p), length_bytes(s)))
}

fn after_prefix_bound(s: string, p: string) -> int64 {
    n: int64 <- length_bytes(p);
    length_bytes(substring(s, n, length_bytes(s)))
}

fn tail_after(s: string, p: string) -> string {
    substring(s, length_bytes(p), length_bytes(s))
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_int64(after_prefix("Heap[int64]", "Heap"));
                println("");
                _: atom <- print_int64(after_prefix_bound("Heap[int64]", "Heap"));
                println("");
                _: atom <- print_int64(length_bytes(tail_after("Heap[int64]", "Heap")));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
