// typed `string { ... }` case arm body; want 1
use trial_support_int64;

fn first_char(s: string) -> string {
    case s == "" of {
        false -> string {
            c: string <- substring(s, 0, 1);
            c
        };
        true -> ""
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case first_char("actor") == "a" of {
                true -> 1;
                false -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
