// A record whose field is a nested record LITERAL with a non-scalar field, returned from a function and
// then read through in the caller. This is type_checker_core:parse_type_into_context:
//     { context: { env: ctx.env, interner: pr.interner }, id: pr.id, ok: pr.ok }
// where `context` holds a List and a record.
//
// The store path inlines a nested record literal only when every one of its fields is scalar, so this one
// is stored as a POINTER to a stack copy that dies when `build` returns. Readers, and
// record_type_value_flat_byte_size, both compute value-flat offsets, so `p.context.items` emits one load
// too few and yields the nested-record pointer itself. In the compiler that pointer was handed to
// prepend as a list handle, and the prepend helper read a byte count out of adjacent dead stack and
// stored through it -- the fault that stopped type checking.
//
// Want 22: 5 from the list, 10 from the nested record's scalar field, 7 from the outer field.

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn build(xs: List[int64, mem(normal)], k: int64) -> { context: { items: List[int64, mem(normal)], tag: int64 }, id: int64, ok: boolean } {
    { context: { items: xs, tag: k }, id: 7, ok: true }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- cons_int(5, empty_ints());
                p: { context: { items: List[int64, mem(normal)], tag: int64 }, id: int64, ok: boolean } <- build(xs, 10);
                result: int64 <- p.context.items.head + p.context.tag + p.id
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
