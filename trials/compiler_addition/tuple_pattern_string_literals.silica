// A case over a tuple with string-literal element patterns. The selfhost emitter had no arm for
// tuple patterns and emitted every such branch as `B fail`, so nothing ever matched -- which is
// how a selfhost-built compiler stopped recognising `//` comments (lexer_comments).
// Want: 1 2 3 0 then main's 0.
use trial_support_int64;

fn classify(a: string, b: string) -> int64 {
    pair: (string, string) <- (a, b);
    case pair of {
        ("/", "/") -> 1;
        ("/", "*") -> 2;
        ("*", _) -> 3;
        _: (string, string) -> 0
    }
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(classify("/", "/"));
                println("");
                print_int64(classify("/", "*"));
                println("");
                print_int64(classify("*", "x"));
                println("");
                print_int64(classify("x", "/"));
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
