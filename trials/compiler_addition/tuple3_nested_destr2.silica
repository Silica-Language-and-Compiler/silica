// tuple3_nested_destr with scalar-only tuples, so the producers need no heap promotion and cannot
// trip the separate direct-body tuple bug (see direct_tuple_calls). This isolates one thing: two
// destructures in one scope both name their root %_td_0, and the second one's fields 1+ were read
// from the FIRST tuple's base register. Want 7.

use trial_support_int64;

fn t3a() -> (bool, int64, string) {
    (false, 1, "x")
}

fn t3b() -> (bool, int64, string) {
    (false, 7, "y")
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (f1: bool, n1: int64, s1: string) <- t3a();
            case f1 of {
                true -> 1;
                false -> {
                    (f2: bool, n2: int64, s2: string) <- t3b();
                    case f2 of {
                        true -> 2;
                        false -> n2
                    }
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
