// A user call whose later argument is itself a call, with a tuple argument after it so the
// arguments are staged one by one into X0..X2 instead of through the stack: the arguments
// already staged are caller-saved and must survive the nested call. Without the guard,
// combine received rank(d1)'s result where h belonged (brodal_okasaki link_nodes was passed
// the rank as the heap). 3*100 + 5*10 + 7 = 357
use trial_support_atom;

fn rank(d: int64) -> int64 {
    d + 1
}

fn combine(h: int64, r: int64, d: (int64, int64)) -> int64 {
    (lo: int64, hi: int64) <- d;
    h * 100 + r * 10 + lo + hi
}

fn join_digits(h: int64, d1: int64, d2: (int64, int64)) -> int64 {
    (lo: int64, _: int64) <- d2;
    case lo > 0 of {
        true -> combine(h, rank(d1), d2);
        false -> 0
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_int64(join_digits(3, 4, (2, 5)))
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
