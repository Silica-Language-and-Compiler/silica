// Bool return from `kind == k` / `tag == n` (and the decl_skips_body_walk nest).
// Seed-built selfhost has been observed to invert or stick these helpers, so
// walkers treated every decl as skippable (or never skippable) and hung on `use`.
//
// Bits: skips(0,-1)=1, skips(0,5)=2, skips(1,-1)=4, skips(1,5)=8, skips(7,0)=16,
// kind_eq(12,12)=32, kind_eq(12,4)=64. Correct is 1+4+8+16+32 = 61.

use trial_support_int64;

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn kind_eq(kind: int64, k: int64) -> bool {
    kind == k
}

fn skips_body(tag: int64, body_root: int64) -> bool {
    case body_root < 0 of {
        true -> true;
        false -> case tag == 0 of {
            true -> false;
            false -> true
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            bit(skips_body(0, -1), 1) + bit(skips_body(0, 5), 2) + bit(skips_body(1, -1), 4) + bit(skips_body(1, 5), 8) + bit(skips_body(7, 0), 16) + bit(kind_eq(12, 12), 32) + bit(kind_eq(12, 4), 64)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
