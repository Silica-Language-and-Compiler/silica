// Two sequential 3-tuple destructures in nested case arms, as in constraint_runner:parse_program.
// The generated code reads field 0 from the fresh tuple pointer but fields 1 and 2 from a stale
// register holding the PREVIOUS destructure's field 2:
//     MOV X19, X0 / LDR X0, [X19, #0] / LDR X1, [X24, #8] / LDR X0, [X24, #16]
// so r2 comes from a string pointer instead of the tuple. Want 7.

use trial_support_int64;

fn t3a() -> (bool, { a: int64, b: int64 }, string) {
    (false, { a: 1, b: 2 }, "x")
}

fn t3b() -> (bool, { a: int64, b: int64 }, string) {
    (false, { a: 7, b: 8 }, "y")
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (f1: bool, r1: { a: int64, b: int64 }, s1: string) <- t3a();
            case f1 of {
                true -> 1;
                false -> {
                    (f2: bool, r2: { a: int64, b: int64 }, s2: string) <- t3b();
                    case f2 of {
                        true -> 2;
                        false -> r2.a
                    }
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
