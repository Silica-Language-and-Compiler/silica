// Line-ending `or` plus a whitespace-only line must stay one expression.
// Newline/tab/CR/space are lexer whitespace, not statement boundaries
// (E1040 at prims_record value_flat_leaf_field_type_p). `//` must stop at
// newline; a lone `/` is still division.
// Want 7.

use trial_support_int64;

fn leaf_ok(t: string) -> bool {
    t == "int64" or t == "int32" or t == "int16" or t == "int8" or

    t == "uint64" or t == "bool"
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            // comment then division
            case leaf_ok("int64") of {
                true -> 14 / 2;
                false -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
