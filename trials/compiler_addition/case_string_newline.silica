// Case patterns must unescape like string expressions (spec §2.2).
// skip_line_comment is `case peek of { "\n" -> ... }`. If the pattern stays
// the two characters '\' 'n', a real newline never matches and `//` eats the
// rest of the file — selfhost then emits no `main` (undefined symbol at link).
//
// Want 7: `"\n"` as a value and as a case pattern are the same newline byte.

use trial_support_int64;

fn is_nl(s: string) -> int64 {
    case s of {
        "\n" -> 7;
        _: string -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            is_nl("\n")
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
