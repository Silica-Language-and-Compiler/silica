// Repro: tuple-returning fn whose FIRST statement destructures a tuple-returning call and
// whose tail is a tuple literal of two records. `nt` is a record_make on a stack slab, and
// the tail tuple stores a POINTER to it. Once the slab is popped that pointer dangles, so
// tok.kind reads garbage. Want 77 (tok.kind 7 * 10 + nx.pos 7).

use trial_support_int64;

fn make_tok(k: int64) -> { kind: int64, lexeme: string } {
    { kind: k, lexeme: "x" }
}

fn split(n: int64) -> ({ kind: int64, lexeme: string }, { pos: int64, line: int64 }) {
    case n > 0 of {
        true -> (make_tok(n), { pos: n, line: 1 });
        false -> (make_tok(0), { pos: 0, line: 0 })
    }
}

fn negate(n: int64) -> ({ kind: int64, lexeme: string }, { pos: int64, line: int64 }) {
    (t: { kind: int64, lexeme: string }, nxt: { pos: int64, line: int64 }) <- split(n);
    lx: string <- concat("-", t.lexeme);
    nt: { kind: int64, lexeme: string } <- { kind: t.kind, lexeme: lx };
    (nt, nxt)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (tok: { kind: int64, lexeme: string }, nx: { pos: int64, line: int64 }) <- negate(7);
            tok.kind * 10 + nx.pos
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
