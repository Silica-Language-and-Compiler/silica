// `(bool, string)` return (lookup_symbol_found). Seed comments say this tuple ABI
// is unreliable for proc[DeviceIO] callers on bootstrap, which is why some lookups
// return only a string. Want 6: missing name keeps false+"", found name is true+"int64".

use trial_support_int64;

fn lookup(name: string) -> (bool, string) {
    case name == "pick" of {
        true -> (true, "int64");
        false -> (false, "")
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (ok1: bool, t1: string) <- lookup("marker");
            (ok2: bool, t2: string) <- lookup("pick");
            a: int64 <- case ok1 of { true -> 1; false -> 0 };
            b: int64 <- case t1 == "" of { true -> 0; false -> 8 };
            c: int64 <- case ok2 of { true -> 2; false -> 0 };
            d: int64 <- case t2 == "int64" of { true -> 4; false -> 0 };
            a + b + c + d
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
