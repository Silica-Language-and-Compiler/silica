// Stick-the-landing: import a module that exports two fns and call neither.
// Both names stay in the env; unused surfaces are not interned. Want 42.
// compiler_addition links each entry alone, so this unit must not emit
// a cross-module call.

use unused_export_lib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            42
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
