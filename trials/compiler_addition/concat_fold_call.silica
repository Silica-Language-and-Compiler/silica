// A string fold whose step is `concat(one, recurse(tail))`: the left operand is a variable and the
// right operand is a call WITH arguments (SIR kind 5). term_subterm_has_user_call answered false for
// kind 5, so the left operand was left in X0 across the call and `MOV X1, X0 / BL L_concat_helper`
// used the call's result for both operands. The fold then collapsed to its base case: the selfhost's
// print_atom_inline:emit_rodata_entries is this exact shape, which is why the selfhost emitted an
// empty L_pa_table and no function bodies at all.
// Want 6: "ab" + "cd" + "ef". The bug gives 0.

use trial_support_int64;

fn build(xs: List[string, mem(normal)]) -> string {
    sequence proc[mem(normal)]
        result: string <- case xs of {
            []: List[string, mem(normal)] -> "";
            [h: string, t: List[string, mem(normal)]] -> concat(h, build(t));
            _: List[string, mem(normal)] -> ""
        }
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[string, mem(normal)] <- ["ab", "cd", "ef"];
                s: string <- build(xs)
            produces
                pure length_bytes(s)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
