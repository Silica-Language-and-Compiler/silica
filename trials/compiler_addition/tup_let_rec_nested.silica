// Nested record_make inside a returned pair: the outer pair stores a heap pointer to the
// record (tuple_elem_heap_promote). Reading the packed int64 after the call must yield 41.
// Want 42.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                p: ({ outer: int64, inner: { a: int64 } }, int64) <- ({ outer: 1, inner: { a: 41 } }, 41);
                (_r: { outer: int64, inner: { a: int64 } }, x: int64) <- p;
                result: int64 <- x + 1
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
