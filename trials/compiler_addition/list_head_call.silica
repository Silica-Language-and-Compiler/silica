// Destructure a list, recurse on the tail, then use the head. The head is bound to X1, a
// caller-saved register, so the recursive call destroys it: in atom_rodata the emitter staged
// `head` from X1 after an intervening concat and emitted " 0 0" for every atom lexeme.
// Want 6: len("abc") + len("de") + len("f").

use trial_support_int64;

fn walk(xs: List[string, mem(normal)]) -> int64 {
    case xs of {
        []: List[string, mem(normal)] -> 0;
        [h: string, t: List[string, mem(normal)]] -> {
            rest: int64 <- walk(t);
            length_bytes(h) + rest
        };
        _: List[string, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                xs: List[string, mem(normal)] <- ["abc", "de", "f"];
                total: int64 <- walk(xs)
            produces
                pure total
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
