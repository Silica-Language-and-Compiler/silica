// Nested export surface is interned at publish (after emit / after SIR in batch).
// Pair with iface_after_emit_use.silica. Want 7.

use trial_support_int64;

export pack/0;

fn pack() -> { a: int64, inner: { b: int64, c: int64 } } {
    { a: 3, inner: { b: 4, c: 5 } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            p: { a: int64, inner: { b: int64, c: int64 } } <- pack();
            p.a + p.inner.b
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
