// tup_rec_destr with a depth cap, so a runaway recursion reports a value instead of hanging.
//   3        -> recursion is fine (the hang would be elsewhere)
//   ~777+k   -> the depth cap fired, i.e. xs.tail is not shrinking

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn count(xs: List[int64, mem(normal)], depth: int64) -> (int64, bool) {
    case depth > 10 of {
        true -> (100, true);
        false -> case xs.is_nil of {
            true -> (0, false);
            false -> {
                (n: int64, f: bool) <- count(xs.tail, depth + 1);
                result: (int64, bool) <- (n + 1, f);
                result
            }
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- cons_int(5, cons_int(6, cons_int(7, empty_ints())));
            (total: int64, flag: bool) <- count(xs, 0);
            total
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
