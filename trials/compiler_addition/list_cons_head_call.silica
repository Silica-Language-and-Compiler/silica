// prepend(call(s), acc): tail is placed in X2, then the call clobbers X2.
// Selfhost typecheck hung on `:plain` because split_atom_parts did
// prepend(trim_type(s), acc) and prepend saw a garbage list.
// Want 42.

use trial_support_int64;

fn tag(s: string) -> string {
    concat(":", s)
}

fn cons_tagged(s: string, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- prepend[string, mem(normal)](tag(s), acc)
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                acc0: List[string, mem(normal)] <- empty[string, mem(normal)]();
                acc1: List[string, mem(normal)] <- prepend[string, mem(normal)]("keep", acc0);
                xs: List[string, mem(normal)] <- cons_tagged("plain", acc1);
                result: int64 <- case xs.is_nil of {
                    true -> 0;
                    false -> case xs.head == ":plain" of {
                        true -> case xs.tail.is_nil of {
                            true -> 3;
                            false -> case xs.tail.head == "keep" of {
                                true -> 42;
                                false -> 2
                            }
                        };
                        false -> 1
                    }
                }
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
