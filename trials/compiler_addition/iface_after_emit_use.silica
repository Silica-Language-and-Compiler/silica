// Stick-the-landing: importer type-checks from an iface published after the
// producer finished SIR/emit, not after type-check. No cross-module call
// (compiler_addition links each entry alone). Want 11.

use iface_after_emit_lib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            11
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
