// w3_nostring, but the terminal arms report their state through the returned record instead
// of printing (printing would need a sequence proc[device_io] block and change the shape).
//   record.line = depth at termination, record.col = number of steps taken
//   exit = line*100 + col*10 + (bad ? 1 : 2)
// Correct run: [1,3,2] -> 3 steps, depth 0 at nil, bad=false -> 0*100 + 3*10 + 2 = 32.

use trial_support_int64;

fn zero_loc() -> { line: int64, col: int64 } {
    { line: 0, col: 0 }
}

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn walk2(xs: List[int64, mem(normal)], depth: int64, steps: int64, loc: { line: int64, col: int64 }) -> (bool, { line: int64, col: int64 }) {
    case xs.is_nil of {
        true -> case depth > 0 of {
            true -> (true, { line: depth, col: steps });
            false -> (false, { line: depth, col: steps })
        };
        false -> case xs.head == 1 of {
            true -> {
                next_loc: { line: int64, col: int64 } <- case depth == 0 of {
                    true -> { line: xs.head, col: 7 };
                    false -> loc
                };
                walk2(xs.tail, depth + 1, steps + 1, next_loc)
            };
            false -> case xs.head == 2 of {
                true -> case depth > 0 of {
                    true -> walk2(xs.tail, depth - 1, steps + 1, loc);
                    false -> (true, { line: depth, col: steps })
                };
                false -> walk2(xs.tail, depth, steps + 1, loc)
            }
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- cons_int(1, cons_int(3, cons_int(2, empty_ints())));
            (bad: bool, where: { line: int64, col: int64 }) <- walk2(xs, 0, 0, zero_loc());
            where.line * 100 + where.col * 10 + case bad of {
                true -> 1;
                false -> 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
