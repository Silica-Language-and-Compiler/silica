// A binary operator whose OTHER operand is a case (or let) expression. The operand staged
// first sits in X9 (or X10); the case scrutinee's own CMP stages through X9/X10 and used to
// clobber it, so `own + (case a > b of {...})` came out as a + max(a, b). This is the shape
// in term_reg_spill@agg_subtree_bytes that inflated a gen2-emitted frame to 29 GB.
// Want: 12 12 12 12 13 then main's 0 (the bug gave 14 12 12 14 10).

use trial_support_int64;

fn plus_case_bound(a: int64, b: int64) -> int64 {
    own: int64 <- 5;
    own + (case a > b of { true -> a; false -> b })
}

fn case_plus_bound(a: int64, b: int64) -> int64 {
    own: int64 <- 5;
    (case a > b of { true -> a; false -> b }) + own
}

fn plus_case_top(a: int64, b: int64) -> int64 {
    5 + (case a > b of { true -> a; false -> b })
}

fn case_plus_top(a: int64, b: int64) -> int64 {
    (case a > b of { true -> a; false -> b }) + 5
}

fn both_complex(a: int64, b: int64) -> int64 {
    (case a > b of { true -> a; false -> b }) + (case a < b of { true -> a; false -> b + 3 })
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(plus_case_bound(7, 3));
                println("");
                print_int64(case_plus_bound(3, 7));
                println("");
                print_int64(plus_case_top(7, 3));
                println("");
                print_int64(case_plus_top(3, 7));
                println("");
                print_int64(both_complex(7, 3));
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
