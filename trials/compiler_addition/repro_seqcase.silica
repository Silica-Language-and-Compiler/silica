// Guard for the `sequence … produces pure result end` shape where `result` is bound to a
// `case` whose arms are let-blocks ending in tuple literals (same shape as
// lexer_float_literals:try_read_float_or_integer, which used to emit a spurious epilogue
// ADD SP, SP, #16). Want 81.

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn split_head(xs: List[int64, mem(normal)]) -> (int64, List[int64, mem(normal)]) {
    case xs.is_nil of {
        true -> (0, xs);
        false -> (xs.head, xs.tail)
    }
}

fn classify(xs: List[int64, mem(normal)]) -> (int64, int64) {
    sequence
        (a: int64, rest: List[int64, mem(normal)]) <- split_head(xs);
        is_big: bool <- a > 1;
        result: (int64, int64) <- case is_big of {
            true -> {
                doubled: int64 <- a * 2;
                (doubled, 1)
            };
            false -> {
                bumped: int64 <- a + 5;
                (bumped, 0)
            }
        }
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- cons_int(4, cons_int(9, empty_ints()));
            (value: int64, flag: int64) <- classify(xs);
            value * 10 + flag
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
