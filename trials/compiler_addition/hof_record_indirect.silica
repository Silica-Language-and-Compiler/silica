// Indirect callee in X17 is caller-saved. Heap-promoting a record argument
// BLs silica_rt_region_alloc, which clobbers X17. Save/reload around arg
// eval even when the arg is record_make (not a user call), and pop the
// save slot before a kind-5 tail BR (dealloc after BR is unreachable).
//
// emit_flat_tuple_stores(emit_child, ..., {bound_name, bound_reg, outer_reg, debug})
// is this shape: MOV X17, emit_child; region_alloc the bound record; BLR X17.
// Selfhost hung at "Emitting..." on tuple_let_calltail (SIGSEGV → restart).
//
// Want 7: add_pair({3,4}) == 7. Unfixed seed jumps to garbage after region_alloc.

use trial_support_int64;

fn add_pair(p: { x: int64, y: int64 }) -> int64 {
    p.x + p.y
}

fn apply(f: fn({ x: int64, y: int64 }) -> int64, a: int64, b: int64) -> int64 {
    f({ x: a, y: b })
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            apply(add_pair, 3, 4)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
