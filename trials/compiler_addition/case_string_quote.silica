// Case patterns must treat \" as escaped content, not the closing quote.
// `"\""` as a pattern is one double-quote. If case_close_quote_index stops
// at the escaped quote, the pattern becomes a backslash and the selfhost
// lexer arm `case peek of { "\"" -> read_string_literal }` never matches a
// real `"`, so string literals (including record field `""`) become the next
// statement — false E1040 on bound_wrap. Want 1.

use trial_support_int64;

fn is_quote(s: string) -> int64 {
    case s of {
        "\"" -> 1;
        _: string -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            is_quote("\"")
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
