// Minimal candidate for bug 3: a tuple-returning recursive function that DESTRUCTURES its own
// recursive call mid-spine and rebuilds a tuple from the parts. This is the shape at
// constraint_core.silica:223, and the one thing `pass` has that the passing repro_letcall
// does not. Want 3 (three elements counted).

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn count(xs: List[int64, mem(normal)]) -> (int64, bool) {
    case xs.is_nil of {
        true -> (0, false);
        false -> {
            (n: int64, f: bool) <- count(xs.tail);
            result: (int64, bool) <- (n + 1, f);
            result
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- cons_int(5, cons_int(6, cons_int(7, empty_ints())));
            (total: int64, flag: bool) <- count(xs);
            total
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
