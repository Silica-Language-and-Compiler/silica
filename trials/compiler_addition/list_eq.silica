// Isolates constraint_core:list_int_equal (verbatim shape). This is what computes `changed` in
// propagate_pass; if it wrongly reports "not equal" the fixed-point loop never settles.
// Want 21: equal lists -> 2 (tens digit), unequal lists -> 1 (ones digit).

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn list_int_equal(a: List[int64, mem(normal)], b: List[int64, mem(normal)]) -> bool {
    case a.is_nil of {
        true -> b.is_nil;
        false -> case b.is_nil of {
            true -> false;
            false -> case a.head == b.head of {
                true -> list_int_equal(a.tail, b.tail);
                false -> false
            }
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: List[int64, mem(normal)] <- cons_int(3, cons_int(7, empty_ints()));
            a2: List[int64, mem(normal)] <- cons_int(3, cons_int(7, empty_ints()));
            b: List[int64, mem(normal)] <- cons_int(3, cons_int(9, empty_ints()));
            same: int64 <- case list_int_equal(a, a2) of { true -> 2; false -> 0 };
            diff: int64 <- case list_int_equal(a, b) of { true -> 0; false -> 1 };
            same * 10 + diff
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
