use trial_support_int64;

fn pick(n: int64) -> (int64, int64) {
    case n > 0 of {
        true -> (n, 1);
        false -> (0, 2)
    }
}

fn wrap(n: int64) -> (int64, int64) {
    result: (int64, int64) <- {
        m: int64 <- n + 1;
        case m > 1 of {
            true -> pick(m);
            false -> (0, 5)
        }
    };
    result
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (a: int64, b: int64) <- wrap(7);
            (c: int64, d: int64) <- wrap(0);
            a + b + c + d
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
