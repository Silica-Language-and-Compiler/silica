// concat(A, B) where BOTH operands need a call: A is an inner concat (BL L_concat_helper) and B is a
// user call. The emitter leaves A in X0, evaluates B (clobbering X0), then does MOV X1, X0 /
// BL L_concat_helper, so both operands end up being B. atom_rodata:emit_lexemes_rodata is this
// shape, which is why every atom line came out as the atom-string part twice.
// Want 8: "abc" + "de" + "xyz". The bug gives 6.

use trial_support_int64;

fn tag() -> string {
    "xyz"
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: string <- "abc";
            b: string <- "de";
            s: string <- concat(concat(a, b), tag());
            length_bytes(s)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
