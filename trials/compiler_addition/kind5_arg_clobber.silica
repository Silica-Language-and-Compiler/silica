// A function whose body is a single call (SIR kind 5) still has later parameters live in
// caller-saved X1–X7. Nested calls while evaluating earlier arguments clobber those registers,
// so a forwarded later GPR arrives as garbage (and a forwarded fn pointer as NULL).
//
// terms_sequence_lowering:lower_sequence_block_with_expected is this shape: it tail-calls after
// expr_child_inner / expr_child_right, passing the incoming callbacks in X3/X4. Jumping to the
// clobbered pointer hung selfhost at "Generating SIR...".
//
// Want 17: wrap(10, 3, 4) == id(10)+3+4. A clobbered y or z yields any other value.

use trial_support_int64;

fn id_int(x: int64) -> int64 {
    x
}

fn add3(a: int64, b: int64, c: int64) -> int64 {
    a + (b + c)
}

fn wrap(x: int64, y: int64, z: int64) -> int64 {
    add3(id_int(x), y, z)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            wrap(10, 3, 4)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
