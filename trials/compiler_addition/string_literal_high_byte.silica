// A string literal whose FIRST byte is 0xFF collided with the string-descriptor
// tag. Twelve of the thirteen sniff sites validate the full 8-byte all-0xFF tag
// plus a length bound; substring() checked only the first byte. It therefore
// took "\xFF" (bytes FF 00) for a descriptor, loaded data/len out of the
// neighbouring rodata atom pool, and faulted. Guarded-FFI containment then
// siglongjmp'd and retried forever, so compiling any module containing "\xFF"
// hung instead of failing. Compiling this file at all is half the test. Want 42.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                hi: string <- "\xFF";
                n: int64 <- length_bytes(hi);
                s: string <- substring(hi, 0, 1);
                ok: bool <- n == 1 and s == hi;
                result: int64 <- case ok of { true -> 42; false -> 1 }
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
