// Same-module recursive string equality returning bool (module_checker
// strings_equal_ascii_ignore_case / constraint_extract_decls lexeme match).
// Those helpers were rewritten to int64 1/0 after seed-built selfhost inverted
// the bool return, so an exact `use lib_bracket_inst` looked missing (false E1010).
//
// Bits: ne=1, eq=2, prefix=4. Correct is 2.

use trial_support_int64;

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn chars_eq(a: string, b: string, i: int64, n: int64) -> bool {
    case i >= n of {
        true -> true;
        false -> {
            ca: string <- substring(a, i, i + 1);
            cb: string <- substring(b, i, i + 1);
            case ca == cb of {
                false -> false;
                true -> chars_eq(a, b, i + 1, n)
            }
        }
    }
}

fn str_eq(a: string, b: string) -> bool {
    case length_bytes(a) == length_bytes(b) of {
        false -> false;
        true -> chars_eq(a, b, 0, length_bytes(a))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            bit(str_eq("lib_bracket_inst", "other"), 1) + bit(str_eq("lib_bracket_inst", "lib_bracket_inst"), 2) + bit(str_eq("use", "export"), 4)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
