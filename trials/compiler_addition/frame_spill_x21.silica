// Nested case-arm lets after X19–X28 are full. enclosing_sp_binding re-appends
// the parent's [X29,#-N] on every nested let, so next_frame_spill_slot's
// binding-count jumped 1,2,4,6. The fourth frame store landed on the callee-saved
// save area (saved X21) and the caller's third param came back as garbage.
// Selfhost then reported E2001 "got <invalid>" on `false -> 0` in region_case_arm
// because check_one_case_branch smashed the caller's expected_type (X21).
//
// Want 107: extra() is identity, inner sums seven extras (=7), outer adds c=100.
// Unfixed seed returns 8 (saved X21 overwritten with extra(a)=1, then 1+7).

use trial_support_int64;

fn extra(n: int64) -> int64 {
    n
}

fn inner(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64) -> int64 {
    p1: int64 <- extra(a);
    p2: int64 <- extra(b);
    p3: int64 <- extra(d);
    case a > 0 of {
        true -> {
            x1: int64 <- extra(e);
            case b > -1 of {
                true -> {
                    x2: int64 <- extra(f);
                    case d > -1 of {
                        true -> {
                            x3: int64 <- extra(g);
                            x4: int64 <- extra(a);
                            p1 + p2 + p3 + x1 + x2 + x3 + x4
                        };
                        false -> 0
                    }
                };
                false -> 0
            }
        };
        false -> 0
    }
}

fn outer(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64) -> int64 {
    x: int64 <- inner(a, b, c, d, e, f, g);
    c + x
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            outer(1, 1, 100, 1, 1, 1, 1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
