// A case arm that binds the scrutinee (`n: int64 -> ...`) and uses the binding as a LATE
// argument of a call whose earlier arguments restage the scrutinee's register (the tuple
// argument forces one-by-one staging): the binding's home must be a frame slot, not the
// caller-saved scrutinee register (brodal_okasaki link read n2 as d2 this way).
// pick(4) = 5*10000 + 3*1000 + 300 + 40 + 4 = 53344
use trial_support_atom;

fn inc(x: int64) -> int64 {
    x + 1
}

fn use5(a: int64, b: (int64, int64), c: int64, d: int64, e: int64) -> int64 {
    (lo: int64, hi: int64) <- b;
    a * 10000 + (lo + hi) * 1000 + c * 100 + d * 10 + e
}

fn pick(v: int64) -> int64 {
    case v of {
        0 -> 0 - 1;
        n: int64 -> use5(inc(n), (1, 2), 3, 4, n)
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_int64(pick(4))
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
