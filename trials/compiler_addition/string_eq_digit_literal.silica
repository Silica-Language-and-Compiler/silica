// A string compared against the literal "0" or "1" inside a let body. The selfhost emitter has a
// small-immediate shortcut for `x == 0` / `x == 1`; it must apply to integer operands only, or a
// string compare becomes `MOV X10, #1` and the string helper dereferences 1.
// Want: 1 0 1 0 then main's 0.
use trial_support_int64;

fn is_one(s: string) -> int64 {
    tag: int64 <- 7;
    case s == "1" of {
        true -> tag - 6;
        false -> 0
    }
}
fn is_zero(s: string) -> int64 {
    tag: int64 <- 7;
    case s == "0" of {
        true -> tag - 6;
        false -> 0
    }
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(is_one("1"));
                println("");
                print_int64(is_one("x"));
                println("");
                print_int64(is_zero("0"));
                println("");
                print_int64(is_zero("1"));
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
