// w3_min2 plus ONE feature: the recursive arm is a let-spine that binds `next_loc` from a
// record-valued `case` (one arm a record literal, the other the incoming parameter) and passes
// it into the recursive call. Want 7.

use trial_support_int64;

fn zero_loc() -> { line: int64, col: int64 } {
    { line: 0, col: 0 }
}

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn walk(xs: List[int64, mem(normal)], depth: int64, loc: { line: int64, col: int64 }) -> (bool, { line: int64, col: int64 }) {
    case xs.is_nil of {
        true -> (false, { line: 7, col: 3 });
        false -> {
            next_loc: { line: int64, col: int64 } <- case depth == 0 of {
                true -> { line: 5, col: 6 };
                false -> loc
            };
            walk(xs.tail, depth + 1, next_loc)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- cons_int(1, cons_int(2, cons_int(3, empty_ints())));
            z0: { line: int64, col: int64 } <- zero_loc();
            (bad: bool, where: { line: int64, col: int64 }) <- walk(xs, 0, z0);
            where.line
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
