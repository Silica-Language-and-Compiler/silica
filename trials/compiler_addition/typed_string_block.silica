// A case arm `string { stmts; result }` must extract the brace body. Seed used to
// take the `string` keyword as the whole primary and leave `{ ... }` unconsumed;
// the arm collapsed to a dummy and emit used placeholder_body `"0"`.
// That made selfhost's `fn_base_name_scan` always return `"0"`, so every same-arity
// function looked overloaded and `fn main()` was labeled `main__ret_int64`.
// Want 1.

use trial_support_int64;

fn first_char(s: string) -> string {
    case s == "" of {
        false -> string {
            c: string <- substring(s, 0, 1);
            c
        };
        true -> ""
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case first_char("Z") == "Z" of {
                true -> 1;
                false -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
