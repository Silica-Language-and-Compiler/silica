// Nested tuple-let inside a case arm. After X19–X28 are full (8 params + 2 lets),
// the arm's tuple-let reuses the first callee-saved that looks dead in the *arm
// remainder*. That remainder does not mention `a`, so X19 was stolen even though
// `a` is live after the case join. Selfhost hung at "Emitting..." in
// emit_case_one_branch_inner because `branch` (X19) was overwritten, then
// sir_term_root_node walked a garbage list.
//
// Want 12: a=9 plus pair()=(1,2). A stolen `a` (and often `b` in X20) yields 4.

use trial_support_int64;

fn pair() -> (int64, int64) {
    (1, 2)
}

fn after_nested_tuple(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64) -> int64 {
    p: int64 <- b;
    q: int64 <- c;
    packed: (int64, int64) <- case h > 0 of {
        true -> {
            (u: int64, v: int64) <- pair();
            (u, v)
        };
        false -> (0, 0)
    };
    (x: int64, y: int64) <- packed;
    a + x + y + (p - b) + (q - c) + d + e + f + g
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            after_nested_tuple(9, 0, 0, 0, 0, 0, 0, 1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
