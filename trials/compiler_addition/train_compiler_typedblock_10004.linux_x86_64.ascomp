    mov QWORD PTR [rip + L_ss_cur_key], 0
    mov QWORD PTR [rip + L_ss_cur_char], 0
    mov QWORD PTR [rip + L_ss_cur_byte], 0
    add rsp, 8
    pop r13
    pop r12
    pop rbx
    pop rbp
    ret
