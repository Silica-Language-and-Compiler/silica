// Guard for the let-spine-tail-is-a-recursive-call shape (same shape as
// lexer_integer_literals:read_hex_digits). A 2-tuple-returning fn whose body is a nested
// `case`; one arm is a let-block whose TAIL is a self-recursive call, the others are tuple
// literals. The emitter must pop the caller sret slab on the let-spine arm too. Want 60.

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn scan(xs: List[int64, mem(normal)], acc: int64) -> (int64, int64) {
    case xs.is_nil of {
        true -> (acc, 0);
        false -> case xs.head > 0 of {
            true -> {
                next_acc: int64 <- acc + xs.head;
                rest: List[int64, mem(normal)] <- xs.tail;
                scan(rest, next_acc)
            };
            false -> (acc, 1)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- cons_int(1, cons_int(2, cons_int(3, empty_ints())));
            (total: int64, flag: int64) <- scan(xs, 0);
            total * 10 + flag
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
