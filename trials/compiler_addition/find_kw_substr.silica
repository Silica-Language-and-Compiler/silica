// substring(s, i, i+len(kw)) must keep s in X0 while evaluating end=i+len(kw).
// A bug saved only X1 across arg3, so len(kw) left X0=kw and substring compared
// the keyword to itself — find_kw("int64", "Heap") returned 0 and typecheck
// validate_collection infinite-recursed. Want 42.

use trial_support_int64;

fn find_kw(s: string, i: int64, kw: string) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case length_bytes(s) - i >= length_bytes(kw) and substring(s, i, i + length_bytes(kw)) == kw of {
            true -> i;
            false -> find_kw(s, i + 1, kw)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                a: int64 <- find_kw("int64", 0, "Heap");
                b: int64 <- find_kw("int64", 0, "Tree");
                c: int64 <- find_kw("HeapX", 0, "Heap");
                ok: bool <- a < 0 and b < 0 and c == 0;
                result: int64 <- case ok of { true -> 42; false -> 1 }
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
