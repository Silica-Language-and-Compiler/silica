use trial_support_int64;

fn fill(r: region(L1, normal), n: int64) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- case n of {
            0 -> 0;
            _: int64 -> {
                cell: ref(L1, normal, int64) <- alloc_ref(r, n);
                here: int64 <- read_ref(cell);
                rest: int64 <- fill(r, n - 1);
                here + rest
            }
        }
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                first: ref(L1, normal, int64) <- alloc_ref(r, 42);
                _: int64 <- fill(r, 1000);
                still_there: int64 <- read_ref(first);
                in_r: boolean <- ref_in_region(first, r);
                result: int64 <- case in_r of {
                    true -> still_there;
                    false -> 0
                }
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
