// Guards the short-circuit change: both truth tables must be unchanged, and `or` must skip its right
// operand when the left is true (the mirror of the `and` case that broke has_reserved_keyword_binding).
//
// Bits: and TT=1, TF=2, FT=4, FF=8; or TT=16, TF=32, FT=64, FF=128; or-guard=128 is reused below.
// Correct results are and TT only, or TT/TF/FT, plus the guard: 1 + 16 + 32 + 64 + 128 = 241.

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn tt() -> bool { true }
fn ff() -> bool { false }

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- empty_ints();
            and_tt: int64 <- bit(tt() and tt(), 1);
            and_tf: int64 <- bit(tt() and ff(), 2);
            and_ft: int64 <- bit(ff() and tt(), 4);
            and_ff: int64 <- bit(ff() and ff(), 8);
            or_tt: int64 <- bit(tt() or tt(), 16);
            or_tf: int64 <- bit(tt() or ff(), 32);
            or_ft: int64 <- bit(ff() or tt(), 64);
            or_ff: int64 <- bit(ff() or ff(), 128);
            // `or` must not evaluate xs.head when xs is empty.
            guard: int64 <- bit(xs.is_nil or xs.head > 0, 128);
            and_tt + and_tf + and_ft + and_ff + or_tt + or_tf + or_ft + or_ff + guard
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
