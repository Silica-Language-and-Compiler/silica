or_continued_line_leaf_ok:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    SUB SP, SP, #80
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    STR X0, [X29, #-16]
    STR X0, [X29, #-32]
    STR X0, [X29, #-48]
    STR X0, [X29, #-64]
    STR X0, [X29, #-80]
    MOV X9, X19
    ADRP X10, L_str_0@PAGE
    ADD X10, X10, L_str_0@PAGEOFF


    STP X0, X1, [SP, #-16]!
    MOV X0, X9
    MOV X1, X10
    BL L_string_cmp_helper
    CMP W0, #0
    CSET W12, EQ
    LDP X0, X1, [SP], #16
    MOV X0, X12

    CBNZ X0, L_sc_o349_done
    LDR X0, [X29, #-80]
    MOV X9, X19
    ADRP X10, L_str_1@PAGE
    ADD X10, X10, L_str_1@PAGEOFF


    STP X0, X1, [SP, #-16]!
    MOV X0, X9
    MOV X1, X10
    BL L_string_cmp_helper
    CMP W0, #0
    CSET W12, EQ
    LDP X0, X1, [SP], #16
    MOV X0, X12

L_sc_o349_done:

    CBNZ X0, L_sc_o365_done
    LDR X0, [X29, #-64]
    MOV X9, X19
    ADRP X10, L_str_2@PAGE
    ADD X10, X10, L_str_2@PAGEOFF


