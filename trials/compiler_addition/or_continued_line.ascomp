L_sc_o418_done:

    LDP X19, X20, [SP], #16
    ADD SP, SP, #80
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o528|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_start@PAGE
    ADD X9, X9, trial_support_int64_start@PAGEOFF
    BLR X9

    ADRP X16, or_continued_line.__lam0@PAGE
    ADD X16, X16, or_continued_line.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o579|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_run@PAGE
    ADD X9, X9, trial_support_int64_run@PAGEOFF
    BLR X9

    BL _silica_rt_wait_for_exit

    MOV X19, X0
    MOV X0, X19



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

or_continued_line.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X16, L_str_0@PAGE
    ADD X16, X16, L_str_0@PAGEOFF
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o673|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, or_continued_line_leaf_ok@PAGE
    ADD X9, X9, or_continued_line_leaf_ok@PAGEOFF
    BLR X9

    MOV X3, X0
L_case_o668_br_0:
    CMP W3, #1
    B.NE L_case_o668_br_1
    MOV X9, #14
    MOV X10, #2


    CMP X10, #0
    B.NE 1f
    BL _silica_rt_badarith
1:
    SDIV X0, X9, X10
    B L_case_o668_done
L_case_o668_br_1:
    CMP W3, #0
    B.NE L_case_o668_fb
    MOV X0, #0
    B L_case_o668_done
L_case_o668_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o668_done
L_case_o668_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #30
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_string_cmp_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lcmp_anull
    CBZ X20, Lcmp_gt
    LDR X1, [X19]
    MVN X2, X1
    CMP X2, #1
    B.HI Lcmp_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    MVN X2, X1
    CMP X2, #1
    B.HI Lcmp_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Lcmp_n2_done:
    MOV X25, X22
    CMP X25, X24
    B.LS Lcmp_minok
    MOV X25, X24
Lcmp_minok:
    CBZ X25, Lcmp_len
    MOV X26, X21
    MOV X27, X23
Lcmp_cloop:
    LDRB W28, [X26], #1
    LDRB W1, [X27], #1
    CMP W28, W1
    B.LO Lcmp_lt
    B.HI Lcmp_gt
    SUBS X25, X25, #1
    B.NE Lcmp_cloop
Lcmp_len:
    CMP X22, X24
    B.EQ Lcmp_eq
    B.LO Lcmp_lt
    B Lcmp_gt
Lcmp_anull:
    CBZ X20, Lcmp_eq
Lcmp_lt:
    MOV W0, #-1
    B Lcmp_exit
Lcmp_gt:
    MOV W0, #1
    B Lcmp_exit
Lcmp_eq:
    MOV W0, #0
Lcmp_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Lcmp_bad:
    BRK #1

