    CBNZ X0, L_sc_o418_done
    LDR X0, [X29, #-16]
    MOV X9, X19
    ADRP X10, L_str_5@PAGE
    ADD X10, X10, L_str_5@PAGEOFF


    STP X0, X1, [SP, #-16]!
    MOV X0, X9
    MOV X1, X10
    BL L_string_cmp_helper
    CMP W0, #0
    CSET W12, EQ
    LDP X0, X1, [SP], #16
