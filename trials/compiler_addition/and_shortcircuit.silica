// Does `and` short-circuit? constraint_runner:has_reserved_keyword_binding relies on it:
//   after_name.is_nil == false and token_starts_with_colon(after_name.head.token) and ...
// The guard exists to stop `.head` running on an empty list. The emitted code evaluates both sides
// eagerly, so `.head` dereferences a null data pointer and faults.
//
// Want 2: the left operand is false, so `xs.head` must never be evaluated.

use trial_support_int64;

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- empty_ints();
            case xs.is_nil == false and xs.head > 0 of {
                true -> 1;
                false -> 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
