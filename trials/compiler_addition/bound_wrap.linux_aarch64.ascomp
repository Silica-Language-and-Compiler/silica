.bss
.balign 8
.lcomm silica_frame_depth, 8
.lcomm silica_frame_max, 8
.lcomm silica_fuel, 8
.lcomm silica_saved_pc, 8

.arch armv8.2-a+fp16
.text
    // use trial_support_int64
.extern silica_rt_ffi_guarded_enter
.extern silica_rt_ffi_guarded_exit
.extern silica_rt_ffi_guarded_setjmp
.extern silica_rt_ffi_guarded_fault_finish
.extern silica_rt_ffi_arena_bump
.global main

    // --- recursion phases (recursion_implementation.jsonld) ---
    // p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    // p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    // p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    // p6 trampoline fallback (optional):
    // silica_trampoline_dispatch: load target from frame / BR X8
    // never rely on unbounded native recursion for general calls



.globl bound_wrap_check
bound_wrap_check:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2

    LDR X3, [X21, #32]
L_case_o537_br_0:
    CMP W3, #1
    B.NE L_case_o537_br_1
    MOV X0, #1
    B L_case_o537_done
L_case_o537_br_1:
    CMP W3, #0
    B.NE L_case_o537_fb
    MOV X0, #0
    B L_case_o537_done
L_case_o537_fb:
    BL silica_rt_case_clause
    MOV X0, #0
    B L_case_o537_done
L_case_o537_done:

    LDR X0, [X21, #24]
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X9, X12

    MOV X10, #0




    CMP X9, X10
    CSET X3, GE

L_case_o604_br_0:
    CMP W3, #1
    B.NE L_case_o604_br_1
    MOV X0, #0
    B L_case_o604_done
L_case_o604_br_1:
    CMP W3, #0
    B.NE L_case_o604_fb
    MOV X0, #1
    B L_case_o604_done
L_case_o604_fb:
    BL silica_rt_case_clause
    MOV X0, #0
    B L_case_o604_done
L_case_o604_done:

    MOV X0, X20
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X9, X12

    MOV X10, #0




    CMP X9, X10
    CSET X3, GE

L_case_o694_br_0:
    CMP W3, #1
    B.NE L_case_o694_br_1
    MOV X0, #0
    B L_case_o694_done
L_case_o694_br_1:
    CMP W3, #0
    B.NE L_case_o694_fb
    MOV X0, #1
    B L_case_o694_done
L_case_o694_fb:
    BL silica_rt_case_clause
    MOV X0, #0
    B L_case_o694_done
L_case_o694_done:

    MOV X9, X19
    MOV X10, #7



    CMP X9, X10
    CSET X3, EQ

L_case_o778_br_0:
    CMP W3, #1
    B.NE L_case_o778_br_1
    MOV X0, #42
    B L_case_o778_done
L_case_o778_br_1:
    CMP W3, #0
    B.NE L_case_o778_fb
    MOV X0, #1
    B L_case_o778_done
L_case_o778_fb:
    BL silica_rt_case_clause
    MOV X0, #0
    B L_case_o778_done
L_case_o778_done:

    MOV X22, X0
    MOV X0, X22




    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

.globl bound_wrap_wrap
bound_wrap_wrap:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    SUB SP, SP, #192

    MOV X16, X0
    STR X16, [SP, #-16]!
    MOV X16, X1
    STR X16, [SP, #-16]!
    STP X0, X1, [SP, #-16]!
    STP X2, X3, [SP, #-16]!
    STP X4, X5, [SP, #-16]!
    STP X6, X7, [SP, #-16]!
    MOVZ X9, #1, LSL #16
    MOVK X9, #15
    STR X9, [X29, #-48]
    ADRP X9, L_str_0
    ADD X9, X9, :lo12:L_str_0
    STR X9, [X29, #-40]
    ADRP X9, L_str_0
    ADD X9, X9, :lo12:L_str_0
    STR X9, [X29, #-32]
    MOV X9, X2
    STR X9, [X29, #-24]
    MOV X9, X3
    STR X9, [X29, #-16]
    SUB X16, X29, #48
    MOV X0, X16
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #48
    BL silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    LDR X3, [X1, #32]
    STR X3, [X4, #32]
    LDR X3, [X1, #40]
    STR X3, [X4, #40]
    MOV X0, X4
    ADD SP, SP, #16
    MOV X16, X0
    LDP X6, X7, [SP], #16
    LDP X4, X5, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
    STR X16, [SP, #-16]!
    LDR X0, [SP, #32]
    LDR X1, [SP, #16]
    LDR X2, [SP, #0]
    ADD SP, SP, #48
    MOV X8, XZR
    ADRP X9, bound_wrap_check
    ADD X9, X9, :lo12:bound_wrap_check
    BLR X9

    ADD SP, SP, #192
    LDP X29, X30, [SP], #16
    RET

.globl main
main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL silica_pid_registry_init
    BL silica_dangerous_pid_registry_init
    BL silica_device_pid_registry_init
    // push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o1112|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_start
    ADD X9, X9, :lo12:trial_support_int64_start
    BLR X9

    ADRP X16, bound_wrap.__lam0
    ADD X16, X16, :lo12:bound_wrap.__lam0

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o1163|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_run
    ADD X9, X9, :lo12:trial_support_int64_run
    BLR X9

    BL silica_rt_wait_for_exit

    MOV X19, X0
    MOV X0, X19



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

.globl bound_wrap.__lam0
bound_wrap.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    // p3 fuel: LDR X9,=silica_fuel / SUBS / B.EQ silica_yield (optional)
    MOV X16, #7
    STR X16, [SP, #-16]!
    ADRP X16, L_str_1
    ADD X16, X16, :lo12:L_str_1
    STR X16, [SP, #-16]!
    ADRP X16, L_str_2
    ADD X16, X16, :lo12:L_str_2
    STR X16, [SP, #-16]!
    MOV X16, #0
    STR X16, [SP, #-16]!
    LDR X0, [SP, #48]
    LDR X1, [SP, #32]
    LDR X2, [SP, #16]
    LDR X3, [SP, #0]
    ADD SP, SP, #64
    // effects []|sir_rec:o1215|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    MOV X8, XZR
    LDP X29, X30, [SP], #16

    ADRP X9, bound_wrap_wrap
    ADD X9, X9, :lo12:bound_wrap_wrap
    BR X9

L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #30
    B.ge L_pa_oob
    ADRP X9, L_pa_table
    ADD X9, X9, :lo12:L_pa_table
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_length_bytes_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    CBZ X19, Llb_z
    LDR X1, [X19]
    MVN X2, X1
    CMP X2, #1
    B.HI Llb_bad
    LDR X0, [X19, #16]
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_z:
    MOV X0, #0
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_bad:
    BRK #1

