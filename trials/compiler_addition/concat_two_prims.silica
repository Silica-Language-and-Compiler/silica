// concat(A, B) where BOTH operands are themselves concats. The left operand is staged in X0 and the
// right operand's own concat returns into X0, so without a spill the left half is lost and both halves
// of the result are the right operand. The selfhost's print_atom_inline:emit_rodata_entries builds each
// table entry exactly this way -- concat(concat(".quad ", label), concat(".quad ", len)) -- and every
// L_pa_table entry came out as the length twice with no atom label.
// Want 8: "ab" + "cd" + "ef" + "gh". The bug gives 4 (the right half twice).

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: string <- "ab";
            b: string <- "cd";
            c: string <- "ef";
            d: string <- "gh";
            s: string <- concat(concat(a, b), concat(c, d));
            length_bytes(s)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
