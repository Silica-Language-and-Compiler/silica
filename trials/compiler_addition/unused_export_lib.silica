// Unused export stays in the importer env without intern.
// Pair with unused_export_use.silica. Want 21.

use trial_support_int64;

export used_fn/0;
export unused_fn/0;

fn used_fn() -> int64 {
    21
}

fn unused_fn() -> int64 {
    99
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            used_fn()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
