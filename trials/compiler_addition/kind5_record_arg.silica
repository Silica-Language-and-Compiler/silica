// A kind-5 tail (function body is one call) does not shadow incoming GPRs:
// fs_subtree_has_user_call walks past the tail node, and a record_make argument
// is not a user call, so wrap's e/f stay in X4/X5. Parallel staging heap-promotes
// the record (BL silica_rt_region_alloc), which clobbers X0-X7, then stages e/f
// from the dead registers. Selfhost's emit_function_non_tail_user_call_root is
// this shape: it rebuilds a bound record then forwards pools in X2 — X2 became
// 0x3ff800 and emit_generic crashed, which looked like a hang at "Emitting...".
//
// Want 21: 1+2+3+4+5+6. Clobbered e/f yields any other value.

use trial_support_int64;

fn take(a: int64, b: int64, p: { x: int64, y: int64 }, c: int64, d: int64) -> int64 {
    a + b + p.x + p.y + c + d
}

fn wrap(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64) -> int64 {
    take(a, b, { x: c, y: d }, e, f)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            wrap(1, 2, 3, 4, 5, 6)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
