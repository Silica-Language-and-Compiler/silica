// Minimal recursive aggregate return: walk a list, return (bool, record). No let-spine, no
// string, no depth branching -- just recursion that always ends in the (false, ...) arm.
// Want 42. If this fails, recursion plus a record-bearing tuple return is the core defect.

use trial_support_int64;

fn zero_loc() -> { line: int64, col: int64 } {
    { line: 0, col: 0 }
}

fn empty_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

fn cons_int(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure result
    end
}

fn walk(xs: List[int64, mem(normal)], loc: { line: int64, col: int64 }) -> (bool, { line: int64, col: int64 }) {
    case xs.is_nil of {
        true -> (false, zero_loc());
        false -> walk(xs.tail, loc)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            xs: List[int64, mem(normal)] <- cons_int(1, cons_int(2, cons_int(3, empty_ints())));
            z0: { line: int64, col: int64 } <- zero_loc();
            (bad: bool, where: { line: int64, col: int64 }) <- walk(xs, z0);
            case bad of {
                true -> 1;
                false -> 42
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
