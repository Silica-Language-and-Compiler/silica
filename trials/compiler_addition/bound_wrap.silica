// Inline record arg after other GPR args: parallel staging must heap-promote the
// record_make slab before the STR slots so release (count*16) does not pop the
// payload, and a kind-5 wrapper must still return (tail BR after reclaim, or
// demoted-tail RET). This is the term_to_asm_debug_with_outer call shape that
// hung selfhost emit. Want 42.

use trial_support_int64;

fn check(a: int64, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> int64 {
    sequence
        _: int64 <- case bound.debug of { true -> 1; false -> 0 };
        _: int64 <- case length_bytes(bound.outer_reg) >= 0 of { true -> 0; false -> 1 };
        _: int64 <- case length_bytes(dest) >= 0 of { true -> 0; false -> 1 };
        result: int64 <- case a == 7 of { true -> 42; false -> 1 }
    produces
        pure result
    end
}

fn wrap(a: int64, dest: string, outer: string, dbg: bool) -> int64 {
    check(a, dest, { bound_name: "", bound_reg: "", outer_reg: outer, debug: dbg })
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            wrap(7, "X0", "outer", false)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
