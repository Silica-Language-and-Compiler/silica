// `and` must not clobber a parameter that lives in dest (X0). After the left
// compare CSET dest, the right operand still needs k; without a spill,
// `k <= 65535` becomes `1 <= 65535` and every k >= -65536 "fits" a MOV.
// Tagged char 'a' is 2^56+97 = 72057594037928033. Want 42.

use trial_support_int64;

fn fits(k: int64) -> bool {
    (k >= 0 - 65536) and (k <= 65535)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case fits(97) of {
                true -> case fits(72057594037928033) of {
                    true -> 1;
                    false -> 42
                };
                false -> 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
