// An inline sum type with a tuple variant as the type of a sequence binding. The grammar allows it:
// a statement is `pattern "<-" expression ";"` (spec §3.3.4) with `identifier_pattern ::=
// identifier ":" type` (§3.5), and a type is any inline type expression, sums included
// (§3.4.2 "Types are inline only": `:none | (:some, int64)` is the same type whether it names a
// parameter, a return or a binding). Today the parser rejects the binding line with E1000: the
// binding-type scanner stops at the `|` or the tuple variant, while the same type parses as a
// parameter type (`fn describe(v: :none | (:some, int64))`) and as a record field type. Found
// 2026-10-23 while writing supervisor_exit_reports_addition (the sink bound `r.failure_reason` to
// a sum-typed name and had to pass it to a function instead).
// Expected once accepted, by hand: 42, none, exit 0.

fn describe(v: :none | (:some, int64)) -> atom {
    sequence proc[device_io]
        kept: :none | (:some, int64) <- v;
        r: atom <- case kept of {
            :none -> println("none");
            (:some, n: int64) -> {
                sequence proc[device_io]
                    _: atom <- print_int64(n);
                    done: atom <- println("")
                produces pure done end
            }
        }
    produces pure r end
}

fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- describe((:some, 42));
        _: atom <- describe(:none)
    produces pure 0 end
}
