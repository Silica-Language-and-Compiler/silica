// chained print_uint8 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_uint8(1 * 25 / 26);
                println("");
                _: atom <- print_uint8(55 / 33);
                println("");
                result: atom <- print_uint8(18 + 23 + 16 / 8)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
