// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(27 < (4 + 59));
                println("");
                _: atom <- print_boolean(41 % 5 < (17 + 53));
                println("");
                _: atom <- print_boolean(44 > 54 / 54);
                println("");
                _: atom <- print_boolean((20 + 41) != 34 % 55);
                println("");
                result: atom <- print_boolean(35 <= 51 % 1)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
