// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(58 / 31 >= 54);
                println("");
                _: atom <- print_boolean(9 % 51 != (1 + 27));
                println("");
                _: atom <- print_boolean((10 + 29) >= 31 % 2);
                println("");
                _: atom <- print_boolean((0 + 58) < (2 + 4));
                println("");
                result: atom <- print_boolean(50 / 10 == 28 / 56)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
