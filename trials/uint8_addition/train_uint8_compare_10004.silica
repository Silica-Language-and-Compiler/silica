// uint8 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(31 / 37 > 17 / 12);
                println("");
                _: atom <- print_boolean(6 < 8 % 16);
                println("");
                _: atom <- print_boolean(20 % 60 != 17);
                println("");
                _: atom <- print_boolean((17 - 10) >= 16);
                println("");
                result: atom <- print_boolean(37 > 41 / 43)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
