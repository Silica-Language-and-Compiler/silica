// Layer 2 §8A.5: empty, singleton, ascending, descending, alternating-extremes, median-first.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_i64(acc: int64, item: int64) -> int64 {
    acc + item
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                empty_sz: int64 <- wbt_set@size(empty0);
                s1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(empty0, 42);
                s1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case s1 of {
                    :unchanged -> empty0;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                s1_inserted: boolean <- case s1 of {
                    :unchanged -> false;
                    (:inserted, _v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                s1_sz: int64 <- wbt_set@size(s1_set);
                a1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(empty0, 1);
                a1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a1 of {
                    :unchanged -> empty0;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                a2: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a1_set, 2);
                a2_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a2 of {
                    :unchanged -> a1_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                a3: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a2_set, 3);
                a3_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a3 of {
                    :unchanged -> a2_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                a4: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a3_set, 4);
                a4_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a4 of {
                    :unchanged -> a3_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                a5: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a4_set, 5);
                a5_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a5 of {
                    :unchanged -> a4_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                asc_sz: int64 <- wbt_set@size(a5_set);
                asc_sum: int64 <- wbt_set@fold(a5_set, 0, sum_i64);
                d1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(empty0, 5);
                d1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d1 of {
                    :unchanged -> empty0;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                d2: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(d1_set, 4);
                d2_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d2 of {
                    :unchanged -> d1_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                d3: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(d2_set, 3);
                d3_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d3 of {
                    :unchanged -> d2_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                d4: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(d3_set, 2);
                d4_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d4 of {
                    :unchanged -> d3_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                d5: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(d4_set, 1);
                d5_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d5 of {
                    :unchanged -> d4_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                desc_sz: int64 <- wbt_set@size(d5_set);
                desc_sum: int64 <- wbt_set@fold(d5_set, 0, sum_i64);
                e1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(empty0, 1);
                e1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case e1 of {
                    :unchanged -> empty0;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                e2: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(e1_set, 5);
                e2_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case e2 of {
                    :unchanged -> e1_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                e3: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(e2_set, 2);
                e3_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case e3 of {
                    :unchanged -> e2_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                e4: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(e3_set, 4);
                e4_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case e4 of {
                    :unchanged -> e3_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                e5: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(e4_set, 3);
                e5_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case e5 of {
                    :unchanged -> e4_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                alt_sz: int64 <- wbt_set@size(e5_set);
                alt_sum: int64 <- wbt_set@fold(e5_set, 0, sum_i64);
                m1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(empty0, 3);
                m1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m1 of {
                    :unchanged -> empty0;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                m2: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(m1_set, 1);
                m2_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m2 of {
                    :unchanged -> m1_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                m3: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(m2_set, 5);
                m3_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m3 of {
                    :unchanged -> m2_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                m4: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(m3_set, 2);
                m4_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m4 of {
                    :unchanged -> m3_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                m5: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(m4_set, 4);
                m5_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m5 of {
