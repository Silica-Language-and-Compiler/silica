                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                med_sz: int64 <- wbt_set@size(m5_set);
                med_sum: int64 <- wbt_set@fold(m5_set, 0, sum_i64)
            produces
                pure case empty_sz == 0 of {
                    false -> 1;
                    true -> case s1_inserted of {
                        false -> 2;
                        true -> case s1_sz == 1 of {
                            false -> 3;
                            true -> case asc_sz == 5 of {
                                false -> 4;
                                true -> case asc_sum == 15 of {
                                    false -> 5;
                                    true -> case desc_sz == 5 of {
                                        false -> 6;
                                        true -> case desc_sum == 15 of {
                                            false -> 7;
                                            true -> case alt_sz == 5 of {
                                                false -> 8;
                                                true -> case alt_sum == 15 of {
                                                    false -> 9;
                                                    true -> case med_sz == 5 of {
                                                        false -> 10;
                                                        true -> case med_sum == 15 of {
                                                            false -> 11;
                                                            true -> 0
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
