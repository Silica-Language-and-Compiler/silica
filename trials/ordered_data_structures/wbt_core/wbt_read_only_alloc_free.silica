// Layer 2 §8A.2: read-only helpers do not change cached size (no WBT node allocation).

use wbt_set;
use wbt_map;
use wbt_trial_fixture;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_set_step(acc: int64, item: int64) -> int64 {
    acc + item
}

fn sum_map_step(acc: int64, key: int64, value: int64) -> int64 {
    acc + key + value
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                set0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_trial_fixture@build_set_i64(cmp_i64, r);
                map0: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_trial_fixture@build_map_i64(cmp_i64, r);
                sz0: int64 <- wbt_set@size(set0);
                mz0: int64 <- wbt_map@size(map0);
                zero: int64 <- 0;
                _: boolean <- wbt_set@contains(set0, 50);
                _: boolean <- wbt_set@contains(set0, 99);
                _: { status: :not_found | :found, item: int64 } <- wbt_set@minimum(set0, zero);
                _: { status: :not_found | :found, item: int64 } <- wbt_set@maximum(set0, zero);
                _: int64 <- wbt_set@fold(set0, zero, sum_set_step);
                _: { status: :not_found | :found, value: int64 } <- wbt_map@get(map0, 50, zero);
                _: { status: :not_found | :found, key: int64, value: int64 } <- wbt_map@minimum(map0, zero, zero);
                _: { status: :not_found | :found, key: int64, value: int64 } <- wbt_map@maximum(map0, zero, zero);
                _: int64 <- wbt_map@fold(map0, zero, sum_map_step);
                sz1: int64 <- wbt_set@size(set0);
                mz1: int64 <- wbt_map@size(map0);
                exit_code: int64 <- case sz0 == 7 and mz0 == 7 of {
                    false -> 1;
                    true -> case sz1 == 7 and mz1 == 7 of {
                        true -> 0;
                        false -> 2
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
