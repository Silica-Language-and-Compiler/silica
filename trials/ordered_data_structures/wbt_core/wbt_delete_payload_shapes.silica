// Layer 2 §8A.7: delete on string set and int64→(int64,string) map payload shapes.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_string(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_pair(a: (int64, string), b: (int64, string)) -> :less | :equal | :greater {
    (a0: int64, _: string) <- a;
    (b0: int64, _: string) <- b;
    cmp_i64(a0, b0)
}

fn pair_eq(a: (int64, string), b: (int64, string)) -> boolean {
    (a0: int64, a1: string) <- a;
    (b0: int64, b1: string) <- b;
    case a0 == b0 of {
        false -> false;
        true -> a1 == b1
    }
}

fn set_string_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(string, string) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_string });
        a1: :unchanged | (:inserted, { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(empty0, "b");
        a1_set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a1 of {
            :unchanged -> empty0;
            (:inserted, v_inserted: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        a2: :unchanged | (:inserted, { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a1_set, "a");
        a2_set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a2 of {
            :unchanged -> a1_set;
            (:inserted, v_inserted: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        a3: :unchanged | (:inserted, { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a2_set, "c");
        a3_set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a3 of {
            :unchanged -> a2_set;
            (:inserted, v_inserted: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        d1: :unchanged | (:removed, { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@delete(a3_set, "a");
        d1_set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d1 of {
            :unchanged -> a3_set;
            (:removed, v_removed: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_removed
        };
        d1_removed: boolean <- case d1 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        sz: int64 <- wbt_set@size(d1_set);
        has_a: boolean <- wbt_set@contains(d1_set, "a");
        has_b: boolean <- wbt_set@contains(d1_set, "b");
        has_c: boolean <- wbt_set@contains(d1_set, "c");
        old_has_a: boolean <- wbt_set@contains(a3_set, "a")
    produces
        pure case d1_removed of {
            false -> false;
            true -> case sz == 2 of {
                false -> false;
                true -> case has_a of {
                    true -> false;
                    false -> case has_b and has_c of {
                        false -> false;
                        true -> old_has_a
                    }
                }
            }
        }
    end
}

fn map_tuple_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_pair });
        i1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@insert(empty0, 1, (10, "a"));
        i1_map: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case i1 of {
            :unchanged -> empty0;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_inserted;
            (:replaced, v_replaced: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_replaced
        };
        i2: :unchanged | (:inserted, { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@insert(i1_map, 2, (20, "b"));
        i2_map: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case i2 of {
            :unchanged -> i1_map;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_inserted;
            (:replaced, v_replaced: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_replaced
        };
        i3: :unchanged | (:inserted, { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@insert(i2_map, 3, (30, "c"));
        i3_map: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case i3 of {
            :unchanged -> i2_map;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_inserted;
            (:replaced, v_replaced: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_replaced
        };
        d1: :unchanged | (:removed, { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@delete(i3_map, 1);
        d1_map: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case d1 of {
            :unchanged -> i3_map;
            (:removed, v_removed: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_removed
        };
        d1_removed: boolean <- case d1 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> true
        };
        sz: int64 <- wbt_map@size(d1_map);
        g1: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(d1_map, 1, (0, ""));
        g2: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(d1_map, 2, (0, ""));
        g3: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(d1_map, 3, (0, ""));
        old_g1: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(i3_map, 1, (0, ""))
    produces
        pure case d1_removed of {
            false -> false;
            true -> case sz == 2 of {
                false -> false;
                true -> case g1.status of {
                    :found -> false;
                    :not_found -> case g2.status of {
                        :not_found -> false;
                        :found -> case pair_eq(g2.value, (20, "b")) of {
                            false -> false;
                            true -> case g3.status of {
                                :not_found -> false;
                                :found -> case pair_eq(g3.value, (30, "c")) of {
                                    false -> false;
                                    true -> case old_g1.status of {
                                        :not_found -> false;
                                        :found -> pair_eq(old_g1.value, (10, "a"))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s_ok: boolean <- set_string_ok();
                m_ok: boolean <- map_tuple_ok()
            produces
                pure case s_ok of {
                    false -> 1;
                    true -> case m_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
