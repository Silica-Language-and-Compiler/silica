// Layer 2 §8A.7: delete on string set and int64→(int64,string) map payload shapes.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_string(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_pair(a: (int64, string), b: (int64, string)) -> :less | :equal | :greater {
    (a0: int64, _: string) <- a;
    (b0: int64, _: string) <- b;
    cmp_i64(a0, b0)
}

fn pair_eq(a: (int64, string), b: (int64, string)) -> boolean {
    (a0: int64, a1: string) <- a;
    (b0: int64, b1: string) <- b;
    case a0 == b0 of {
        false -> false;
        true -> a1 == b1
    }
}

fn set_string_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(string, string) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_string });
        a1: {
            set: {
                root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(empty0, "b");
        a2: {
            set: {
                root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a1.set, "a");
        a3: {
            set: {
                root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a2.set, "c");
        d1: {
            set: {
                root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(a3.set, "a");
        sz: int64 <- wbt_set@size(d1.set);
        has_a: boolean <- wbt_set@contains(d1.set, "a");
        has_b: boolean <- wbt_set@contains(d1.set, "b");
        has_c: boolean <- wbt_set@contains(d1.set, "c");
        old_has_a: boolean <- wbt_set@contains(a3.set, "a")
    produces
        pure case d1.removed of {
            false -> false;
            true -> case sz == 2 of {
                false -> false;
                true -> case has_a of {
                    true -> false;
                    false -> case has_b and has_c of {
                        false -> false;
                        true -> old_has_a
                    }
                }
            }
        }
    end
}

fn map_tuple_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_pair });
        i1: {
            map: {
                root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 1, (10, "a"));
        i2: {
            map: {
                root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(i1.map, 2, (20, "b"));
        i3: {
            map: {
                root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(i2.map, 3, (30, "c"));
        d1: {
            map: {
                root: ref?(L, normal, (int64, (int64, string), int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(i3.map, 1);
        sz: int64 <- wbt_map@size(d1.map);
        g1: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(d1.map, 1, (0, ""));
        g2: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(d1.map, 2, (0, ""));
        g3: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(d1.map, 3, (0, ""));
        old_g1: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(i3.map, 1, (0, ""))
    produces
        pure case d1.removed of {
            false -> false;
            true -> case sz == 2 of {
                false -> false;
                true -> case g1.status of {
                    :found -> false;
                    :not_found -> case g2.status of {
                        :not_found -> false;
                        :found -> case pair_eq(g2.value, (20, "b")) of {
                            false -> false;
                            true -> case g3.status of {
                                :not_found -> false;
                                :found -> case pair_eq(g3.value, (30, "c")) of {
                                    false -> false;
                                    true -> case old_g1.status of {
                                        :not_found -> false;
                                        :found -> pair_eq(old_g1.value, (10, "a"))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s_ok: boolean <- set_string_ok();
                m_ok: boolean <- map_tuple_ok()
            produces
                pure case s_ok of {
                    false -> 1;
                    true -> case m_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
