// Layer 2 §8A.7: delete a one-child parent; residual is the child; pairing preserved.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn set_one_child_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        a1: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(empty0, 2);
        a2: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a1.set, 1);
        d2: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(a2.set, 2);
        sz: int64 <- wbt_set@size(d2.set);
        has1: boolean <- wbt_set@contains(d2.set, 1);
        has2: boolean <- wbt_set@contains(d2.set, 2);
        old_sz: int64 <- wbt_set@size(a2.set);
        old_has2: boolean <- wbt_set@contains(a2.set, 2)
    produces
        pure case d2.removed of {
            false -> false;
            true -> case sz == 1 and has1 of {
                false -> false;
                true -> case has2 of {
                    true -> false;
                    false -> case old_sz == 2 and old_has2 of { false -> false; true -> true }
                }
            }
        }
    end
}

fn map_one_child_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        a1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 2, 20);
        a2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a1.map, 1, 10);
        d2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(a2.map, 2);
        sz: int64 <- wbt_map@size(d2.map);
        g1: { status: :not_found | :found, value: int64 } <- wbt_map@get(d2.map, 1, 0);
        has2: boolean <- wbt_map@contains_key(d2.map, 2)
    produces
        pure case d2.removed of {
            false -> false;
            true -> case sz == 1 of {
                false -> false;
                true -> case g1.status of {
                    :not_found -> false;
                    :found -> case g1.value == 10 of {
                        false -> false;
                        true -> case has2 of { true -> false; false -> true }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s_ok: boolean <- set_one_child_ok();
                m_ok: boolean <- map_one_child_ok()
            produces
                pure case s_ok of {
                    false -> 1;
                    true -> case m_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
