// Layer 2 §8A.2: invalid comparator atoms at root, left-branch, and right-branch comparisons.

use wbt_trial_fixture;
use wbt_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64_atom(a: int64, b: int64) -> atom {
    case cmp_i64(a, b) of {
        :less -> :less;
        :equal -> :equal;
        :greater -> :greater
    }
}

fn cmp_bad_root(a: int64, b: int64) -> atom {
    case a == 50 and b == 50 of {
        true -> :ok;
        false -> cmp_i64_atom(a, b)
    }
}

fn cmp_bad_left(a: int64, b: int64) -> atom {
    case a == 10 and b == 25 of {
        true -> :ok;
        false -> cmp_i64_atom(a, b)
    }
}

fn cmp_bad_right(a: int64, b: int64) -> atom {
    case a == 90 and b == 75 of {
        true -> :ok;
        false -> cmp_i64_atom(a, b)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                set0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_trial_fixture@build_set_i64(cmp_i64, r);
                root_bad: atom <- wbt_trial_i64@search_status_i64(cmp_bad_root, 50, set0);
                left_bad: atom <- wbt_trial_i64@search_status_i64(cmp_bad_left, 10, set0);
                right_bad: atom <- wbt_trial_i64@search_status_i64(cmp_bad_right, 90, set0);
                exit_code: int64 <- case root_bad of {
                    :invalid_comparator_result -> case left_bad of {
                        :invalid_comparator_result -> case right_bad of {
                            :invalid_comparator_result -> 0;
                            _: atom -> 3
                        };
                        _: atom -> 2
                    };
                    _: atom -> 1
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
