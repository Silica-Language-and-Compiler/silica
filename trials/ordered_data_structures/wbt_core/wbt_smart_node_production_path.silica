// Layer 2 §8A.3: production WBT nodes are built only through smart_node (runtime path check).

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                set_witness: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                n10: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 10, set_witness.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                n90: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 90, set_witness.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_top: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 50, n10.root, n90.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_sz: int64 <- wbt_set@size(set_top);
                map_witness: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_n10: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 10, 1000, map_witness.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_n90: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 90, 9000, map_witness.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_top: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 50, 5000, map_n10.root, map_n90.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_sz: int64 <- wbt_map@size(map_top);
                set_has_all: boolean <- case wbt_set@contains(set_top, 50) of {
                    false -> false;
                    true -> case wbt_set@contains(set_top, 10) of {
                        false -> false;
                        true -> wbt_set@contains(set_top, 90)
                    }
                };
                map_has_all: boolean <- case wbt_map@contains_key(map_top, 50) of {
                    false -> false;
                    true -> case wbt_map@contains_key(map_top, 10) of {
                        false -> false;
                        true -> wbt_map@contains_key(map_top, 90)
                    }
                };
                exit_code: int64 <- case set_sz == 3 of {
                    false -> 1;
                    true -> case map_sz == 3 of {
                        false -> 2;
                        true -> case set_has_all of {
                            false -> 3;
                            true -> case map_has_all of {
                                false -> 4;
                                true -> 0
                            }
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
