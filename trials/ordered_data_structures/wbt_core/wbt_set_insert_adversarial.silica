// Layer 2 §8A.5: adversarial insert sequences that force repeated rotations.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_step(acc: int64, item: int64) -> int64 {
    acc + item
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                // Strict ascending spine → repeated balance_left on unwind.
                i1: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, 1);
                i2: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(i1.set, 2);
                i3: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(i2.set, 3);
                i4: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(i3.set, 4);
                i5: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(i4.set, 5);
                i6: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(i5.set, 6);
                i7: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(i6.set, 7);
                i8: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(i7.set, 8);
                asc_sz: int64 <- wbt_set@size(i8.set);
                asc_sum: int64 <- wbt_set@fold(i8.set, 0, sum_step);
                asc_min: { status: :not_found | :found, item: int64 } <- wbt_set@minimum(i8.set, 0);
                asc_max: { status: :not_found | :found, item: int64 } <- wbt_set@maximum(i8.set, 0);
                // Strict descending spine → repeated balance_right.
                j1: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, 8);
                j2: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(j1.set, 7);
                j3: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(j2.set, 6);
                j4: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(j3.set, 5);
                j5: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(j4.set, 4);
                j6: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(j5.set, 3);
                j7: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(j6.set, 2);
                j8: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(j7.set, 1);
                desc_sz: int64 <- wbt_set@size(j8.set);
                desc_sum: int64 <- wbt_set@fold(j8.set, 0, sum_step);
                // Zigzag: 4, 2, 6, 1, 3, 5, 7, 8 — mix of single/double rotations.
                z1: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, 4);
                z2: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(z1.set, 2);
                z3: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(z2.set, 6);
                z4: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(z3.set, 1);
                z5: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(z4.set, 3);
                z6: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(z5.set, 5);
                z7: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(z6.set, 7);
                z8: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(z7.set, 8);
                zig_sz: int64 <- wbt_set@size(z8.set);
                zig_sum: int64 <- wbt_set@fold(z8.set, 0, sum_step);
                has4: boolean <- wbt_set@contains(z8.set, 4);
                has8: boolean <- wbt_set@contains(z8.set, 8)
            produces
                pure case asc_sz == 8 of {
                    false -> 1;
                    true -> case asc_sum == 36 of {
                        false -> 2;
                        true -> case asc_min.item == 1 of {
                            false -> 3;
                            true -> case asc_max.item == 8 of {
                                false -> 4;
                                true -> case desc_sz == 8 of {
                                    false -> 5;
                                    true -> case desc_sum == 36 of {
                                        false -> 6;
                                        true -> case zig_sz == 8 of {
                                            false -> 7;
                                            true -> case zig_sum == 36 of {
                                                false -> 8;
                                                true -> case has4 of {
                                                    false -> 9;
                                                    true -> case has8 of {
                                                        false -> 10;
                                                        true -> 0
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
