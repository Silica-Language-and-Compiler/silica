// Layer 2 §8A.8 gate: map from_sorted rejects malformed two-element adjacency.

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn trap_value(_a: int64, _b: int64) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn map_error_is(items: List[(int64, int64), mem(normal)], expected_code: int64) -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
        built: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_map@from_sorted(empty0, items);
        sz: int64 <- wbt_map@size(built.map);
        code: int64 <- wbt_map@from_sorted_error_code(built.error)
    produces
        pure case built.valid of { true -> false; false -> sz == 0 and code == expected_code }
    end
}

fn descending_case_ok() -> boolean {
    sequence proc[mem(normal)]
        a: (int64, int64) <- (20, 200);
        b: (int64, int64) <- (10, 100);
        items: List[(int64, int64), mem(normal)] <- [a, b];
        ok: boolean <- map_error_is(items, 1)
    produces
        pure ok
    end
}

fn equal_case_ok() -> boolean {
    sequence proc[mem(normal)]
        a: (int64, int64) <- (10, 100);
        b: (int64, int64) <- (10, 101);
        items: List[(int64, int64), mem(normal)] <- [a, b];
        ok: boolean <- map_error_is(items, 2)
    produces
        pure ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                desc_ok: boolean <- descending_case_ok();
                equal_ok: boolean <- equal_case_ok()
            produces
                pure case desc_ok of {
                    false -> 1;
                    true -> case equal_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
