// Layer 2 §8A.11 Step 1: hand-written set/map trace agrees with list oracle after every mutation.
// Oracle Lists never share a frame with WBT size/fold/validate (scalar facts only).

use wbt_set;
use wbt_map;
use wbt_trial_oracle_i64;
use trial_support_int64;

fn smoke_cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

// --- Oracle fact builders (List-only frames) ---

fn facts_set_empty() -> { olen: int64, osum: int64 } {
    xs: List[int64, mem(normal)] <- wbt_trial_oracle_i64@set_oracle_empty();
    wbt_trial_oracle_i64@set_oracle_facts(xs)
}

fn facts_set_2() -> { olen: int64, osum: int64 } {
    xs0: List[int64, mem(normal)] <- wbt_trial_oracle_i64@set_oracle_empty();
    xs1: { list: List[int64, mem(normal)], inserted: boolean } <-
        wbt_trial_oracle_i64@set_oracle_insert(xs0, 2);
    wbt_trial_oracle_i64@set_oracle_facts(xs1.list)
}

fn facts_set_2_5() -> { olen: int64, osum: int64 } {
    sequence
        xs0: List[int64, mem(normal)] <- wbt_trial_oracle_i64@set_oracle_empty();
        xs1: { list: List[int64, mem(normal)], inserted: boolean } <-
            wbt_trial_oracle_i64@set_oracle_insert(xs0, 2);
        xs2: { list: List[int64, mem(normal)], inserted: boolean } <-
            wbt_trial_oracle_i64@set_oracle_insert(xs1.list, 5);
        f: { olen: int64, osum: int64 } <- wbt_trial_oracle_i64@set_oracle_facts(xs2.list)
    produces
        pure f
    end
}

fn facts_set_2_5_after_dup_2() -> { olen: int64, osum: int64 } {
    sequence
        xs0: List[int64, mem(normal)] <- wbt_trial_oracle_i64@set_oracle_empty();
        xs1: { list: List[int64, mem(normal)], inserted: boolean } <-
            wbt_trial_oracle_i64@set_oracle_insert(xs0, 2);
        xs2: { list: List[int64, mem(normal)], inserted: boolean } <-
            wbt_trial_oracle_i64@set_oracle_insert(xs1.list, 5);
        xs3: { list: List[int64, mem(normal)], inserted: boolean } <-
            wbt_trial_oracle_i64@set_oracle_insert(xs2.list, 2);
        f: { olen: int64, osum: int64 } <- wbt_trial_oracle_i64@set_oracle_facts(xs3.list)
    produces
        pure f
    end
}

fn facts_set_5_after_delete_2() -> { olen: int64, osum: int64 } {
    sequence
        xs0: List[int64, mem(normal)] <- wbt_trial_oracle_i64@set_oracle_empty();
        xs1: { list: List[int64, mem(normal)], inserted: boolean } <-
            wbt_trial_oracle_i64@set_oracle_insert(xs0, 2);
        xs2: { list: List[int64, mem(normal)], inserted: boolean } <-
            wbt_trial_oracle_i64@set_oracle_insert(xs1.list, 5);
        xs3: { list: List[int64, mem(normal)], inserted: boolean } <-
            wbt_trial_oracle_i64@set_oracle_insert(xs2.list, 2);
        xd: { list: List[int64, mem(normal)], removed: boolean } <-
            wbt_trial_oracle_i64@set_oracle_delete(xs3.list, 2);
        f: { olen: int64, osum: int64 } <- wbt_trial_oracle_i64@set_oracle_facts(xd.list)
    produces
        pure f
    end
}

fn facts_map_empty() -> { olen: int64, osum: int64 } {
    sequence
        xs: List[(int64, int64), mem(normal)] <- wbt_trial_oracle_i64@map_oracle_empty();
        f: { olen: int64, osum: int64 } <- wbt_trial_oracle_i64@map_oracle_facts(xs)
    produces
        pure f
    end
}

fn facts_map_2_20() -> { olen: int64, osum: int64 } {
    sequence
        xs0: List[(int64, int64), mem(normal)] <- wbt_trial_oracle_i64@map_oracle_empty();
        xs1: {
            list: List[(int64, int64), mem(normal)],
            inserted: boolean,
            replaced: boolean
        } <- wbt_trial_oracle_i64@map_oracle_insert(xs0, 2, 20);
        f: { olen: int64, osum: int64 } <- wbt_trial_oracle_i64@map_oracle_facts(xs1.list)
    produces
        pure f
    end
}

fn facts_map_2_200() -> { olen: int64, osum: int64 } {
    sequence
        xs0: List[(int64, int64), mem(normal)] <- wbt_trial_oracle_i64@map_oracle_empty();
        xs1: {
            list: List[(int64, int64), mem(normal)],
            inserted: boolean,
            replaced: boolean
        } <- wbt_trial_oracle_i64@map_oracle_insert(xs0, 2, 20);
        xs2: {
            list: List[(int64, int64), mem(normal)],
            inserted: boolean,
            replaced: boolean
        } <- wbt_trial_oracle_i64@map_oracle_insert(xs1.list, 2, 200);
        f: { olen: int64, osum: int64 } <- wbt_trial_oracle_i64@map_oracle_facts(xs2.list)
    produces
        pure f
    end
}

fn facts_map_empty_after_delete_2() -> { olen: int64, osum: int64 } {
    sequence
        xs0: List[(int64, int64), mem(normal)] <- wbt_trial_oracle_i64@map_oracle_empty();
        xs1: {
            list: List[(int64, int64), mem(normal)],
            inserted: boolean,
            replaced: boolean
        } <- wbt_trial_oracle_i64@map_oracle_insert(xs0, 2, 20);
        xs2: {
            list: List[(int64, int64), mem(normal)],
            inserted: boolean,
            replaced: boolean
        } <- wbt_trial_oracle_i64@map_oracle_insert(xs1.list, 2, 200);
        xd: { list: List[(int64, int64), mem(normal)], removed: boolean } <-
            wbt_trial_oracle_i64@map_oracle_delete(xs2.list, 2);
        f: { olen: int64, osum: int64 } <- wbt_trial_oracle_i64@map_oracle_facts(xd.list)
    produces
        pure f
    end
}

// --- Per-step checks (facts then WBT; scalar key probes) ---

fn step_empty_set() -> boolean {
    sequence
        f: { olen: int64, osum: int64 } <- facts_set_empty();
        olen: int64 <- f.olen;
        osum: int64 <- f.osum;
        s: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: smoke_cmp_i64 });
        ok: boolean <- wbt_trial_oracle_i64@check_set_facts(s, olen, osum)
    produces
        pure ok
    end
}

fn step_empty_map() -> boolean {
    sequence
        f: { olen: int64, osum: int64 } <- facts_map_empty();
        olen: int64 <- f.olen;
        osum: int64 <- f.osum;
        m: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: smoke_cmp_i64, compare_value: smoke_cmp_i64 });
        ok: boolean <- wbt_trial_oracle_i64@check_map_facts(m, olen, osum)
    produces
        pure ok
    end
}

fn step_set_insert_2() -> boolean {
    sequence
        f: { olen: int64, osum: int64 } <- facts_set_2();
        olen: int64 <- f.olen;
        osum: int64 <- f.osum;
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: smoke_cmp_i64 });
        ins: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(e, 2);
        ins_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case ins of {
            :unchanged -> e;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        ins_inserted: boolean <- case ins of {
            :unchanged -> false;
            (:inserted, _v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        s: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- ins_set;
        ok: boolean <- wbt_trial_oracle_i64@check_set_facts(s, olen, osum);
        has: boolean <- wbt_set@contains(s, 2)
    produces
        pure case ins_inserted of {
            false -> false;
            true -> case ok of { false -> false; true -> has }
        }
    end
}

fn step_map_insert_2_20() -> boolean {
    sequence
        f: { olen: int64, osum: int64 } <- facts_map_2_20();
        olen: int64 <- f.olen;
        osum: int64 <- f.osum;
        e: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: smoke_cmp_i64, compare_value: smoke_cmp_i64 });
        ins: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@insert(e, 2, 20);
        ins_map: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case ins of {
            :unchanged -> e;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_inserted;
            (:replaced, v_replaced: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_replaced
        };
        ins_inserted: boolean <- case ins of {
            :unchanged -> false;
            (:inserted, _v_inserted: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> true;
            (:replaced, _v_replaced: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> false
        };
        m: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- ins_map;
        ok: boolean <- wbt_trial_oracle_i64@check_map_facts(m, olen, osum);
        got: { status: :not_found | :found, value: int64 } <- wbt_map@get(m, 2, 0)
    produces
        pure case ins_inserted of {
            false -> false;
            true -> case ok of {
                false -> false;
                true -> case got.status of {
                    :not_found -> false;
                    :found -> case got.value == 20 of { true -> true; false -> false }
                }
            }
        }
    end
}

fn step_set_insert_2_5() -> boolean {
    sequence
        f: { olen: int64, osum: int64 } <- facts_set_2_5();
        olen: int64 <- f.olen;
        osum: int64 <- f.osum;
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: smoke_cmp_i64 });
        ins1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(e, 2);
        ins1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case ins1 of {
            :unchanged -> e;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        s1: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- ins1_set;
        ins: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(s1, 5);
        ins_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case ins of {
            :unchanged -> s1;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        ins_inserted: boolean <- case ins of {
            :unchanged -> false;
            (:inserted, _v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        s: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- ins_set;
        ok: boolean <- wbt_trial_oracle_i64@check_set_facts(s, olen, osum);
        h2: boolean <- wbt_set@contains(s, 2);
        h5: boolean <- wbt_set@contains(s, 5)
    produces
        pure case ins_inserted of {
            false -> false;
            true -> case ok of {
                false -> false;
                true -> case h2 of { false -> false; true -> h5 }
            }
        }
    end
}

fn step_set_dup_insert_2() -> boolean {
    sequence
        f: { olen: int64, osum: int64 } <- facts_set_2_5_after_dup_2();
        olen: int64 <- f.olen;
