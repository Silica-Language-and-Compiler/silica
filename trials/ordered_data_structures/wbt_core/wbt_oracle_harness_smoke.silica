        ins2_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case ins2 of {
