fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                t0: boolean <- step_empty_set();
                t1: boolean <- case t0 of { false -> false; true -> step_empty_map() };
                t2: boolean <- case t1 of { false -> false; true -> step_set_insert_2() };
                t3: boolean <- case t2 of { false -> false; true -> step_map_insert_2_20() };
                t4: boolean <- case t3 of { false -> false; true -> step_set_insert_2_5() };
                t5: boolean <- case t4 of { false -> false; true -> step_set_dup_insert_2() };
                t6: boolean <- case t5 of { false -> false; true -> step_map_replace_2_200() };
                t7: boolean <- case t6 of { false -> false; true -> step_set_delete_2() };
                t8: boolean <- case t7 of { false -> false; true -> step_map_delete_2() }
            produces
                pure case t0 of {
                    false -> 1;
                    true -> case t1 of {
                        false -> 2;
                        true -> case t2 of {
                            false -> 4;
                            true -> case t3 of {
                                false -> 6;
                                true -> case t4 of {
                                    false -> 7;
                                    true -> case t5 of {
                                        false -> 8;
                                        true -> case t6 of {
                                            false -> 11;
                                            true -> case t7 of {
                                                false -> 13;
                                                true -> case t8 of { false -> 15; true -> 0 }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
