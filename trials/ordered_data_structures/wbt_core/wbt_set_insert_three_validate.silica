// Chunk 15 phase 2 (S6c): insert into a weight-balanced tree three times, then validate. The inserts
// are non-return-position calls whose results (records holding the tree) reach older aggregates: an
// earlier insert's tree record is a heap shell or the caller's sret home that holds words naming nodes
// of the newest call's frame. The evacuation must rewrite those words in place and scan each old
// aggregate exactly once; a second scan of the same shell once read final addresses as new nodes and
// corrupted the tree (found 2026-10-25 as ~150 ordered_data_structures run failures). Ascending
// inserts 1, 2, 3 force a rotation at the third. Expected: size 3, valid 1, logical_count 3, then
// status 0.
//   3
//   1
//   3
//   0

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                empty0: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- wbt_set@empty({ compare_item: cmp_i64 });
                i1: { set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, inserted: boolean } <- wbt_set@insert(empty0, 1);
                i2: { set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, inserted: boolean } <- wbt_set@insert(i1.set, 2);
                i3: { set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, inserted: boolean } <- wbt_set@insert(i2.set, 3);
                sz: int64 <- wbt_set@size(i3.set);
                v: { valid: boolean, error: atom, logical_count: int64 } <- wbt_set@validate(i3.set);
                ok: int64 <- case v.valid of { true -> 1; false -> 0 };
                print_int64(sz);
                println("");
                print_int64(ok);
                println("");
                print_int64(v.logical_count);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
