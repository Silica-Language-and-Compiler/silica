// Layer 2 §8A.10: valid empty, fixture, and insert trees validate with exact counts.

use wbt_set;
use wbt_trial_fixture;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                empty0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                ve: { valid: boolean, error: atom, logical_count: int64 } <- wbt_set@validate(empty0);
                ae: int64 <- case ve.valid of {
                    true -> case ve.logical_count of { 0 -> 1; _: int64 -> 0 };
                    false -> 0
                };
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                fix: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_trial_fixture@build_set_i64(cmp_i64, r);
                vf: { valid: boolean, error: atom, logical_count: int64 } <- wbt_set@validate(fix);
                af: int64 <- case vf.valid of {
                    true -> case vf.logical_count of { 7 -> 1; _: int64 -> 0 };
                    false -> 0
                };
                i1: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, 10);
                i2: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(i1.set, 20);
                vi: { valid: boolean, error: atom, logical_count: int64 } <- wbt_set@validate(i2.set);
                ai: int64 <- case vi.valid of {
                    true -> case vi.logical_count of { 2 -> 1; _: int64 -> 0 };
                    false -> 0
                };
                out: int64 <- ae + af + ai
            produces
                pure out
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
