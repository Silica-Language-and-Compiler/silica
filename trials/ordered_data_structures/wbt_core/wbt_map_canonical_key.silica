// Layer 2 §8A.6: comparator-equal distinct keys keep the first stored key; value replaces.

use wbt_map;
use trial_support_int64;

fn abs_i64(x: int64) -> int64 {
    case x < 0 of { true -> 0 - x; false -> x }
}

fn cmp_abs(a: int64, b: int64) -> :less | :equal | :greater {
    sequence
        aa: int64 <- abs_i64(a);
        bb: int64 <- abs_i64(b)
    produces
        pure case aa < bb of { true -> :less; false -> case aa == bb of { true -> :equal; false -> :greater } }
    end
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn fold_key(acc: int64, k: int64, _v: int64) -> int64 {
    acc + k
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_map@empty({ compare_key: cmp_abs, compare_value: cmp_i64 });
                r1: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(empty0, 7, 100);
                r2: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(r1.map, 0 - 7, 200);
                sz: int64 <- wbt_map@size(r2.map);
                g: { status: :not_found | :found, value: int64 } <- wbt_map@get(r2.map, 0 - 7, 0);
                key_sum: int64 <- wbt_map@fold(r2.map, 0, fold_key)
            produces
                pure case r1.inserted of {
                    false -> 1;
                    true -> case r2.replaced of {
                        false -> 2;
                        true -> case r2.inserted of {
                            true -> 3;
                            false -> case sz == 1 of {
                                false -> 4;
                                true -> case g.status of {
                                    :not_found -> 5;
                                    :found -> case g.value == 200 of {
                                        false -> 6;
                                        true -> case key_sum == 7 of {
                                            false -> 7;
                                            true -> 0
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
