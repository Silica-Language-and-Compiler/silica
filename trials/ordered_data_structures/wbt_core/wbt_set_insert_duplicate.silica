// Layer 2 §8A.5: duplicate and comparator-equal insertion is an identity-preserving zero-node no-op.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn abs_i64(x: int64) -> int64 {
    case x < 0 of { true -> 0 - x; false -> x }
}

fn cmp_abs(a: int64, b: int64) -> :less | :equal | :greater {
    sequence
        aa: int64 <- abs_i64(a);
        bb: int64 <- abs_i64(b)
    produces
        pure case aa < bb of { true -> :less; false -> case aa == bb of { true -> :equal; false -> :greater } }
    end
}

fn sum_step(acc: int64, item: int64) -> int64 {
    acc + item
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                r1: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, 10);
                r2: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(r1.set, 20);
                r3: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(r2.set, 10);
                sz2: int64 <- wbt_set@size(r2.set);
                sz3: int64 <- wbt_set@size(r3.set);
                sum2: int64 <- wbt_set@fold(r2.set, 0, sum_step);
                sum3: int64 <- wbt_set@fold(r3.set, 0, sum_step);
                abs_empty: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_abs });
                a1: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(abs_empty, 7);
                a2: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(a1.set, 0 - 7);
                a_sz: int64 <- wbt_set@size(a2.set);
                a_sum: int64 <- wbt_set@fold(a2.set, 0, sum_step);
                a_has7: boolean <- wbt_set@contains(a2.set, 7);
                a_has_neg: boolean <- wbt_set@contains(a2.set, 0 - 7)
            produces
                pure case r3.inserted of {
                    true -> 1;
                    false -> case sz3 == 2 of {
                        false -> 2;
                        true -> case sz2 == 2 of {
                            false -> 3;
                            true -> case sum2 == 30 of {
                                false -> 4;
                                true -> case sum3 == 30 of {
                                    false -> 5;
                                    true -> case a2.inserted of {
                                        true -> 6;
                                        false -> case a_sz == 1 of {
                                            false -> 7;
                                            true -> case a_sum == 7 of {
                                                false -> 8;
                                                true -> case a_has7 of {
                                                    false -> 9;
                                                    true -> case a_has_neg of {
                                                        false -> 10;
                                                        true -> 0
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
