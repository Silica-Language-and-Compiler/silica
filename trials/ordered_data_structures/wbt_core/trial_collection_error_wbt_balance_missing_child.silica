// Layer 2 §8A.4: missing inner child for a selected double rotation fails deterministically.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                // Malformed rr with cached size -1 → weight 0 after add1.
                // right node: rl=:none (weight 1), rr=malformed (weight 0) → not (1 < 0) → double left.
                // Double left requires non-empty rl → representation violation halt.
                bad_rr: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <-
                    alloc_rec(r, (30, -1, :none, :none));
                heavy_right: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <-
                    alloc_rec(r, (20, 3, :none, bad_rr));
                witness: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                attempt: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@balance_left(witness, 10, witness.root, heavy_right),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                exit_code: int64 <- case attempt.root of { :none -> 1; _: ref?(L, normal, rec) -> 1 }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
