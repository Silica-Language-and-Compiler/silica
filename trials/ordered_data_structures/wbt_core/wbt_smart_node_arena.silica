// Layer 2 §8A.3: smart nodes allocate in the canonical arena; children stay readable and unchanged.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                set_witness: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                left_set: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 10, set_witness.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                right_set: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 90, set_witness.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                top_set: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 50, left_set.root, right_set.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                map_witness: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_left: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 10, 1000, map_witness.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_right: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 90, 9000, map_witness.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_top: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 50, 5000, map_left.root, map_right.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                left_before: boolean <- wbt_set@contains(left_set, 10);
                right_before: boolean <- wbt_set@contains(right_set, 90);
                top_ok: boolean <- wbt_set@contains(top_set, 50);
                left_after: boolean <- wbt_set@contains(left_set, 10);
                right_after: boolean <- wbt_set@contains(right_set, 90);
                map_left_before: boolean <- wbt_map@contains_key(map_left, 10);
                map_left_value: { status: :not_found | :found, value: int64 } <- wbt_map@get(map_left, 10, 0);
                map_top_ok: boolean <- wbt_map@contains_key(map_top, 50);
                map_left_after: boolean <- wbt_map@contains_key(map_left, 10);
                map_left_value_after: { status: :not_found | :found, value: int64 } <- wbt_map@get(map_left, 10, 0);
                exit_code: int64 <- case left_before of {
                    false -> 1;
                    true -> case right_before of {
                        false -> 2;
                        true -> case top_ok of {
                            false -> 3;
                            true -> case left_after of {
                                false -> 4;
                                true -> case right_after of {
                                    false -> 5;
                                    true -> case map_left_before of {
                                        false -> 6;
                                        true -> case map_left_value.status of {
                                            :not_found -> 7;
                                            :found -> case map_left_value.value == 1000 of {
                                                false -> 8;
                                                true -> case map_top_ok of {
                                                    false -> 9;
                                                    true -> case map_left_after of {
                                                        false -> 10;
                                                        true -> case map_left_value_after.status of {
                                                            :not_found -> 11;
                                                            :found -> case map_left_value_after.value == 1000 of {
                                                                false -> 12;
                                                                true -> 0
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
