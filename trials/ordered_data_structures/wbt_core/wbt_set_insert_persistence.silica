// Layer 2 §8A.5: every prior root retains size, fold, and search after later inserts.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_step(acc: int64, item: int64) -> int64 {
    acc + item
}

fn check_version(
    set0: {
        root: ref?(L, normal, rec),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    expect_sz: int64,
    expect_sum: int64,
    expect_absent: int64
) -> boolean {
    sequence
        sz: int64 <- wbt_set@size(set0);
        sum: int64 <- wbt_set@fold(set0, 0, sum_step);
        absent: boolean <- wbt_set@contains(set0, expect_absent)
    produces
        pure case sz == expect_sz of {
            false -> false;
            true -> case sum == expect_sum of {
                false -> false;
                true -> case absent of { true -> false; false -> true }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                r1: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, 10);
                r2: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(r1.set, 20);
                r3: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(r2.set, 5);
                r4: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(r3.set, 15);
                r5: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(r4.set, 25);
                // Check each retained version after the final update (helper keeps live locals small).
                v0: boolean <- check_version(empty0, 0, 0, 10);
                v1: boolean <- check_version(r1.set, 1, 10, 20);
                v2: boolean <- check_version(r2.set, 2, 30, 5);
                v3: boolean <- check_version(r3.set, 3, 35, 15);
                v4: boolean <- check_version(r4.set, 4, 50, 25);
                v5: boolean <- check_version(r5.set, 5, 75, 99);
                has5: boolean <- wbt_set@contains(r5.set, 5)
            produces
                pure case v0 of {
                    false -> 1;
                    true -> case v1 of {
                        false -> 2;
                        true -> case v2 of {
                            false -> 3;
                            true -> case v3 of {
                                false -> 4;
                                true -> case v4 of {
                                    false -> 5;
                                    true -> case v5 of {
                                        false -> 6;
                                        true -> case has5 of {
                                            false -> 7;
                                            true -> 0
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
