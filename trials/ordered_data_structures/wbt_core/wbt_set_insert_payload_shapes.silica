                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(a1.set, "b");
                a3: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(a2.set, "c");
                a4: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(a3.set, "d");
                a5: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(a4.set, "e");
                d1: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, "e");
                d2: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(d1.set, "d");
                d3: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(d2.set, "c");
                d4: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(d3.set, "b");
                d5: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(d4.set, "a");
                e1: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
