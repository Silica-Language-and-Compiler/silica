// Layer 2 §8A.5: insertion matrix on a second payload shape (string; int64 covered by wbt_set_insert_orders).

use wbt_set;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn str_digit_step(acc: int64, item: string) -> int64 {
    case item == "a" of {
        true -> (acc * 10) + 1;
        false -> case item == "b" of {
            true -> (acc * 10) + 2;
            false -> case item == "c" of {
                true -> (acc * 10) + 3;
                false -> case item == "d" of {
                    true -> (acc * 10) + 4;
                    false -> case item == "e" of {
                        true -> (acc * 10) + 5;
                        false -> (acc * 10) + 9
                    }
                }
            }
        }
    }
}

fn found_str_is(
    result: { status: :not_found | :found, item: string },
    expected: string
) -> boolean {
    case result.status of {
        :found -> result.item == expected;
        :not_found -> false
    }
}

fn str_set_ok(
    set: {
        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(string, string) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> boolean {
    sequence
        sz: int64 <- wbt_set@size(set);
        digest: int64 <- wbt_set@fold(set, 0, str_digit_step);
        lo: { status: :not_found | :found, item: string } <- wbt_set@minimum(set, "z");
        hi: { status: :not_found | :found, item: string } <- wbt_set@maximum(set, "z");
        has_a: boolean <- wbt_set@contains(set, "a");
        has_b: boolean <- wbt_set@contains(set, "b");
        has_c: boolean <- wbt_set@contains(set, "c");
        has_d: boolean <- wbt_set@contains(set, "d");
        has_e: boolean <- wbt_set@contains(set, "e")
    produces
        pure case sz == 5 of {
            false -> false;
            true -> case digest == 12345 of {
                false -> false;
                true -> case found_str_is(lo, "a") of {
                    false -> false;
                    true -> case found_str_is(hi, "e") of {
                        false -> false;
                        true -> case has_a of {
                            false -> false;
                            true -> case has_b of {
                                false -> false;
                                true -> case has_c of {
                                    false -> false;
                                    true -> case has_d of {
                                        false -> false;
                                        true -> has_e
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn str_singleton_duplicate_ok(
    empty_s: {
        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(string, string) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> boolean {
    sequence
        r1: {
            set: {
                root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(empty_s, "m");
        r2: {
            set: {
                root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(r1.set, "m");
        sz: int64 <- wbt_set@size(r2.set);
        has_m: boolean <- wbt_set@contains(r2.set, "m")
    produces
        pure case r1.inserted of {
            false -> false;
            true -> case r2.inserted of {
                true -> false;
                false -> case sz == 1 of {
                    false -> false;
                    true -> has_m
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(string, string) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_str });
                single_ok: boolean <- str_singleton_duplicate_ok(empty0);
                a1: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, "a");
                a2: {
