                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(m1.set, "a");
                m3: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(m2.set, "e");
                m4: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(m3.set, "b");
                m5: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(m4.set, "d");
                asc_ok: boolean <- str_set_ok(a5.set);
                desc_ok: boolean <- str_set_ok(d5.set);
                alt_ok: boolean <- str_set_ok(e5.set);
                med_ok: boolean <- str_set_ok(m5.set)
            produces
                pure case single_ok of {
                    false -> 1;
                    true -> case asc_ok of {
                        false -> 2;
                        true -> case desc_ok of {
                            false -> 3;
                            true -> case alt_ok of {
                                false -> 4;
                                true -> case med_ok of {
