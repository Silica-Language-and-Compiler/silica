                med_ok: boolean <- str_set_ok(m5_set)
            produces
                pure case single_ok of {
                    false -> 1;
                    true -> case asc_ok of {
                        false -> 2;
                        true -> case desc_ok of {
                            false -> 3;
                            true -> case alt_ok of {
                                false -> 4;
                                true -> case med_ok of {
                                    false -> 5;
                                    true -> 0
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
