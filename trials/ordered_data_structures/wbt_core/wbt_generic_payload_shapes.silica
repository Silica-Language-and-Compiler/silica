// Layer 2 §8A.1: scalar, string, and record/tuple payloads share the same empty-root algorithm.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                warm: region(L, normal) <- canonical_arena_lookup(1);
                scalar_set: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                string_set: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(string, string) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- wbt_set@empty({ compare_item: cmp_str });
                exit_code: int64 <- case scalar_set.specialization_key != string_set.specialization_key of {
                    true -> 0;
                    false -> 1
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
