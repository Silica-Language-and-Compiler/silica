use wbt_set;
fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        w: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- { root: :none, compare_item: cmp_i64, region: r, specialization_key: 0, compare_item_ordering_bundle: 0 };
        left: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- { root: wbt_set@smart_node(w, 10, w.root, w.root), compare_item: cmp_i64, region: r, specialization_key: 0, compare_item_ordering_bundle: 0 };
        right: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- { root: wbt_set@smart_node(w, 90, w.root, w.root), compare_item: cmp_i64, region: r, specialization_key: 0, compare_item_ordering_bundle: 0 };
        top: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- { root: wbt_set@smart_node(w, 50, left.root, right.root), compare_item: cmp_i64, region: r, specialization_key: 0, compare_item_ordering_bundle: 0 };
        sz: int64 <- wbt_set@size(top)
    produces pure case sz == 3 of { true -> 0; false -> 1 }
    end
}
