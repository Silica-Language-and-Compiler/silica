// Layer 2 §8A.8 gate: counted from_sorted rejects negative, short, and long counts without publishing roots.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn trap_value(_a: int64, _b: int64) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn set_count_error_is(items: List[int64, mem(normal)], n: int64, expected_code: int64) -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        built: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_set@from_sorted_counted(empty0, items, n);
        sz: int64 <- wbt_set@size(built.set);
        code: int64 <- wbt_set@from_sorted_error_code(built.error)
    produces
        pure case built.valid of { true -> false; false -> sz == 0 and code == expected_code }
    end
}

fn map_count_error_is(items: List[(int64, int64), mem(normal)], n: int64, expected_code: int64) -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
        built: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_map@from_sorted_counted(empty0, items, n);
        sz: int64 <- wbt_map@size(built.map);
        code: int64 <- wbt_map@from_sorted_error_code(built.error)
    produces
        pure case built.valid of { true -> false; false -> sz == 0 and code == expected_code }
    end
}

fn set_counts_ok() -> boolean {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [10, 20, 30];
        neg: boolean <- set_count_error_is(xs, 0 - 1, 4);
        short: boolean <- set_count_error_is(xs, 4, 5);
        long: boolean <- set_count_error_is(xs, 2, 5)
    produces
        pure neg and short and long
    end
}

fn map_counts_ok() -> boolean {
    sequence proc[mem(normal)]
        a: (int64, int64) <- (10, 100);
        b: (int64, int64) <- (20, 200);
        c: (int64, int64) <- (30, 300);
        xs: List[(int64, int64), mem(normal)] <- [a, b, c];
        neg: boolean <- map_count_error_is(xs, 0 - 1, 4);
        short: boolean <- map_count_error_is(xs, 4, 5);
        long: boolean <- map_count_error_is(xs, 2, 5)
    produces
        pure neg and short and long
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                set_ok: boolean <- set_counts_ok();
                map_ok: boolean <- map_counts_ok()
            produces
                pure case set_ok of {
                    false -> 1;
                    true -> case map_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
