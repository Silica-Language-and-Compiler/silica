// Layer 2 §8A.10: map validate + fold retain key/value pairing after mutations and bulk build.

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn trap_value(_a: int64, _b: int64) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn sum_kv(acc: int64, k: int64, v: int64) -> int64 {
    acc + k + v
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                empty0: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
                i1: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(empty0, 1, 10);
                i2: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(i1.map, 2, 20);
                i3: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(i2.map, 3, 30);
                replaced: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(i3.map, 2, 200);
                deleted: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    removed: boolean
                } <- wbt_map@delete(replaced.map, 1);
                b4: (int64, int64) <- (4, 40);
                b5: (int64, int64) <- (5, 50);
                b6: (int64, int64) <- (6, 60);
                items: List[(int64, int64), mem(normal)] <- [b4, b5, b6];
                bulk: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    valid: boolean,
                    error: atom
                } <- wbt_map@from_sorted(empty0, items);
                v_mut: { valid: boolean, error: atom, logical_count: int64 } <- wbt_map@validate(deleted.map);
                v_bulk: { valid: boolean, error: atom, logical_count: int64 } <- wbt_map@validate(bulk.map);
                code_mut: int64 <- wbt_map@validate_error_code(v_mut.error);
                code_bulk: int64 <- wbt_map@validate_error_code(v_bulk.error);
                fold_mut: int64 <- wbt_map@fold(deleted.map, 0, sum_kv);
                fold_bulk: int64 <- wbt_map@fold(bulk.map, 0, sum_kv);
                exit_code: int64 <- case v_mut.valid and code_mut == 0 and v_mut.logical_count == 2 and fold_mut == 235 of {
                    false -> 1;
                    true -> case v_bulk.valid and code_bulk == 0 and v_bulk.logical_count == 3 and fold_bulk == 165 of {
                        false -> 2;
                        true -> 0
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
