// Layer 2 §8A.3: overflow-safe smart constructor rejects int64.max child metadata before allocation.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                max_i64: int64 <- 9223372036854775807;
                set_bad_root: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <-
                    alloc_rec(r, (10, max_i64, :none, :none));
                set_bad_child: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: set_bad_root,
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_witness: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_attempt: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 50, set_bad_root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_rejected: boolean <- case wbt_set@size(set_attempt) == 0 of {
                    true -> wbt_set@contains(set_bad_child, 10);
                    false -> false
                };
                map_bad_root: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <-
                    alloc_rec(r, (20, 200, max_i64, :none, :none));
                map_bad_child: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: map_bad_root,
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_witness: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_attempt: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 50, 5000, map_bad_root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_rejected: boolean <- case wbt_map@size(map_attempt) == 0 of {
                    true -> wbt_map@contains_key(map_bad_child, 20);
                    false -> false
                };
                exit_code: int64 <- case set_rejected of {
                    false -> 1;
                    true -> case map_rejected of {
                        false -> 2;
                        true -> 0
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
