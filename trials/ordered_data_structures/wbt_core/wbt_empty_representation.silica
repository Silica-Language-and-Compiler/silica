// Layer 2 §8A.1: empty set and map roots are :none, size zero, arena + ordering bundle retained, no node allocated.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                warm: region(L, normal) <- canonical_arena_lookup(1);
                set0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                map0: {
                    root: ref?(L, normal, (int64, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(string, string) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_str });
                set_sz: int64 <- wbt_set@size(set0);
                map_sz: int64 <- wbt_map@size(map0);
                exit_code: int64 <- case set_sz == 0 and map_sz == 0 of {
                    true -> 0;
                    false -> 2
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
