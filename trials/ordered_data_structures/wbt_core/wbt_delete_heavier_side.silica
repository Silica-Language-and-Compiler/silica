                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                sl: boolean <- set_left_heavy_ok();
                sr: boolean <- set_right_heavy_ok();
                st: boolean <- set_tie_ok();
                ml: boolean <- map_left_heavy_ok();
                mr: boolean <- map_right_heavy_ok();
                mt: boolean <- map_tie_ok()
            produces
                pure case sl of {
                    false -> 1;
                    true -> case sr of {
                        false -> 2;
                        true -> case st of {
                            false -> 3;
                            true -> case ml of {
                                false -> 4;
                                true -> case mr of {
                                    false -> 5;
                                    true -> case mt of { false -> 6; true -> 0 }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
