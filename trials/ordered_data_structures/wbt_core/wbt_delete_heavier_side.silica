        };
        // tie → successor 3 keeps value 300
        g3: { status: :not_found | :found, value: int64 } <- wbt_map@get(d2_map, 3, 0);
        g1: { status: :not_found | :found, value: int64 } <- wbt_map@get(d2_map, 1, 0);
