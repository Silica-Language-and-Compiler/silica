fn map_tie_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        a1: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 2, 200);
        a2: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a1.map, 1, 100);
        a3: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a2.map, 3, 300);
        d2: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(a3.map, 2);
        // tie → successor 3 keeps value 300
        g3: { status: :not_found | :found, value: int64 } <- wbt_map@get(d2.map, 3, 0);
        g1: { status: :not_found | :found, value: int64 } <- wbt_map@get(d2.map, 1, 0);
        has2: boolean <- wbt_map@contains_key(d2.map, 2);
        sz: int64 <- wbt_map@size(d2.map)
    produces
        pure case d2.removed of {
            false -> false;
            true -> case sz == 2 of {
                false -> false;
                true -> case has2 of {
                    true -> false;
                    false -> case g3.status of {
                        :not_found -> false;
                        :found -> case g3.value == 300 of {
                            false -> false;
                            true -> case g1.status of {
                                :not_found -> false;
                                :found -> g1.value == 100
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                sl: boolean <- set_left_heavy_ok();
                sr: boolean <- set_right_heavy_ok();
                st: boolean <- set_tie_ok();
                ml: boolean <- map_left_heavy_ok();
                mr: boolean <- map_right_heavy_ok();
                mt: boolean <- map_tie_ok()
            produces
                pure case sl of {
                    false -> 1;
                    true -> case sr of {
                        false -> 2;
                        true -> case st of {
                            false -> 3;
                            true -> case ml of {
                                false -> 4;
                                true -> case mr of {
                                    false -> 5;
                                    true -> case mt of { false -> 6; true -> 0 }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
