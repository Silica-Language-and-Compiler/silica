// Layer 2 §8A.6: invalid compare_key atoms at root/left/right leave input map valid.

use wbt_trial_fixture;
use wbt_trial_insert_map_i64;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64_atom(a: int64, b: int64) -> atom {
    case cmp_i64(a, b) of {
        :less -> :less;
        :equal -> :equal;
        :greater -> :greater
    }
}

fn cmp_bad_root(a: int64, b: int64) -> atom {
    case a == 50 and b == 50 of {
        true -> :ok;
        false -> cmp_i64_atom(a, b)
    }
}

fn cmp_bad_left(a: int64, b: int64) -> atom {
    case a == 10 and b == 25 of {
        true -> :ok;
        false -> cmp_i64_atom(a, b)
    }
}

fn cmp_bad_right(a: int64, b: int64) -> atom {
    case a == 90 and b == 75 of {
        true -> :ok;
        false -> cmp_i64_atom(a, b)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                map0: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_trial_fixture@build_map_i64(cmp_i64, r);
                root_bad: atom <- wbt_trial_insert_map_i64@insert_status_i64(cmp_bad_root, 50, 0, map0);
                left_bad: atom <- wbt_trial_insert_map_i64@insert_status_i64(cmp_bad_left, 10, 0, map0);
                right_bad: atom <- wbt_trial_insert_map_i64@insert_status_i64(cmp_bad_right, 90, 0, map0);
                still: boolean <- wbt_map@contains_key(map0, 50);
                exit_code: int64 <- case root_bad of {
                    :invalid_comparator_result -> case left_bad of {
                        :invalid_comparator_result -> case right_bad of {
                            :invalid_comparator_result -> case still of {
                                true -> 0;
                                false -> 4
                            };
                            _: atom -> 3
                        };
                        _: atom -> 2
                    };
                    _: atom -> 1
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
