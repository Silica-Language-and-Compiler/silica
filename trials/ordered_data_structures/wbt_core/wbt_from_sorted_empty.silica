// Layer 2 §8A.8 probe: empty from_sorted paths are valid for set and map.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn trap_value(_a: int64, _b: int64) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn set_empty_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        items: List[int64, mem(normal)] <- [];
        built: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_set@from_sorted(empty0, items);
        sz: int64 <- wbt_set@size(built.set);
        code: int64 <- wbt_set@from_sorted_error_code(built.error)
    produces
        pure built.valid and sz == 0 and code == 0
    end
}

fn set_counted_empty_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        items: List[int64, mem(normal)] <- [];
        built: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_set@from_sorted_counted(empty0, items, 0);
        sz: int64 <- wbt_set@size(built.set);
        code: int64 <- wbt_set@from_sorted_error_code(built.error)
    produces
        pure built.valid and sz == 0 and code == 0
    end
}

fn map_empty_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
        items: List[(int64, int64), mem(normal)] <- [];
        built: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_map@from_sorted(empty0, items);
        sz: int64 <- wbt_map@size(built.map);
        code: int64 <- wbt_map@from_sorted_error_code(built.error)
    produces
        pure built.valid and sz == 0 and code == 0
    end
}

fn map_counted_empty_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
        items: List[(int64, int64), mem(normal)] <- [];
        built: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_map@from_sorted_counted(empty0, items, 0);
        sz: int64 <- wbt_map@size(built.map);
        code: int64 <- wbt_map@from_sorted_error_code(built.error)
    produces
        pure built.valid and sz == 0 and code == 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s1: boolean <- set_empty_ok();
                s2: boolean <- set_counted_empty_ok();
                m1: boolean <- map_empty_ok();
                m2: boolean <- map_counted_empty_ok()
            produces
                pure case s1 and s2 of {
                    false -> 1;
                    true -> case m1 and m2 of {
                        false -> 2;
                        true -> 0
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
