// Layer 2 §8A.8 collection-error gate: production set from_sorted preflight rejects invalid comparator atoms.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64_atom(a: int64, b: int64) -> atom {
    case cmp_i64(a, b) of {
        :less -> :less;
        :equal -> :equal;
        :greater -> :greater
    }
}

fn cmp_bad_begin(a: int64, b: int64) -> atom {
    case a == 10 and b == 20 of { true -> :invalid_trial_atom; false -> cmp_i64_atom(a, b) }
}

fn cmp_bad_mid(a: int64, b: int64) -> atom {
    case a == 20 and b == 30 of { true -> :invalid_trial_atom; false -> cmp_i64_atom(a, b) }
}

fn cmp_bad_end(a: int64, b: int64) -> atom {
    case a == 30 and b == 40 of { true -> :invalid_trial_atom; false -> cmp_i64_atom(a, b) }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                bad_begin: atom <- wbt_set@from_sorted_preflight_status(empty0, cmp_bad_begin, 10, 20);
                bad_mid: atom <- wbt_set@from_sorted_preflight_status(empty0, cmp_bad_mid, 20, 30);
                bad_end: atom <- wbt_set@from_sorted_preflight_status(empty0, cmp_bad_end, 30, 40);
                good: atom <- wbt_set@from_sorted_preflight_status(empty0, cmp_i64_atom, 10, 20);
                // Compare via from_sorted_error_code: atoms returned from wbt_set use that module's
                // atom-table indices and must not be pattern-matched against trial-local atoms.
                c_begin: int64 <- wbt_set@from_sorted_error_code(bad_begin);
                c_mid: int64 <- wbt_set@from_sorted_error_code(bad_mid);
                c_end: int64 <- wbt_set@from_sorted_error_code(bad_end);
                c_good: int64 <- wbt_set@from_sorted_error_code(good)
            produces
                pure case c_begin == 3 of {
                    false -> 1;
                    true -> case c_mid == 3 of {
                        false -> 2;
                        true -> case c_end == 3 of {
                            false -> 3;
                            true -> case c_good == 0 of { false -> 4; true -> 0 }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
