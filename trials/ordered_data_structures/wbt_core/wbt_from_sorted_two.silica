// Layer 2 §8A.8 probe: two-element from_sorted paths build set/map results.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn trap_value(_a: int64, _b: int64) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn got_is(
    result: { status: :not_found | :found, value: int64 },
    expected: int64
) -> boolean {
    case result.status of {
        :found -> result.value == expected;
        :not_found -> false
    }
}

fn set_two_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        items: List[int64, mem(normal)] <- [42, 43];
        built: {
            set: {
                root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_set@from_sorted(empty0, items);
        sz: int64 <- wbt_set@size(built.set);
        hit1: boolean <- wbt_set@contains(built.set, 42);
        hit2: boolean <- wbt_set@contains(built.set, 43);
        miss: boolean <- wbt_set@contains(built.set, 41);
        code: int64 <- wbt_set@from_sorted_error_code(built.error)
    produces
        pure built.valid and sz == 2 and hit1 and hit2 and case miss of { true -> false; false -> code == 0 }
    end
}

fn set_counted_two_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        items: List[int64, mem(normal)] <- [42, 43];
        built: {
            set: {
                root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_set@from_sorted_counted(empty0, items, 2);
        sz: int64 <- wbt_set@size(built.set);
        hit1: boolean <- wbt_set@contains(built.set, 42);
        hit2: boolean <- wbt_set@contains(built.set, 43);
        miss: boolean <- wbt_set@contains(built.set, 41);
        code: int64 <- wbt_set@from_sorted_error_code(built.error)
    produces
        pure built.valid and sz == 2 and hit1 and hit2 and case miss of { true -> false; false -> code == 0 }
    end
}

fn map_two_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
        b1: (int64, int64) <- (42, 420);
        b2: (int64, int64) <- (43, 430);
        items: List[(int64, int64), mem(normal)] <- [b1, b2];
        built: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_map@from_sorted(empty0, items);
        sz: int64 <- wbt_map@size(built.map);
        got1: { status: :not_found | :found, value: int64 } <- wbt_map@get(built.map, 42, 0);
        got2: { status: :not_found | :found, value: int64 } <- wbt_map@get(built.map, 43, 0);
        miss: boolean <- wbt_map@contains_key(built.map, 41);
        code: int64 <- wbt_map@from_sorted_error_code(built.error)
    produces
        pure built.valid and sz == 2 and got_is(got1, 420) and got_is(got2, 430) and case miss of { true -> false; false -> code == 0 }
    end
}

fn map_counted_two_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
        b1: (int64, int64) <- (42, 420);
        b2: (int64, int64) <- (43, 430);
        items: List[(int64, int64), mem(normal)] <- [b1, b2];
        built: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_map@from_sorted_counted(empty0, items, 2);
        sz: int64 <- wbt_map@size(built.map);
        got1: { status: :not_found | :found, value: int64 } <- wbt_map@get(built.map, 42, 0);
        got2: { status: :not_found | :found, value: int64 } <- wbt_map@get(built.map, 43, 0);
        miss: boolean <- wbt_map@contains_key(built.map, 41);
        code: int64 <- wbt_map@from_sorted_error_code(built.error)
    produces
        pure built.valid and sz == 2 and got_is(got1, 420) and got_is(got2, 430) and case miss of { true -> false; false -> code == 0 }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s1: boolean <- set_two_ok();
                s2: boolean <- set_counted_two_ok();
                m1: boolean <- map_two_ok();
                m2: boolean <- map_counted_two_ok()
            produces
                pure case s1 and s2 of {
                    false -> 1;
                    true -> case m1 and m2 of {
                        false -> 2;
                        true -> 0
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
