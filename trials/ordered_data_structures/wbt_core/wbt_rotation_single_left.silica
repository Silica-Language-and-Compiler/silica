use wbt_set;
use wbt_map;
use wbt_trial_fixture;
use wbt_trial_balance;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_set(acc: int64, item: int64) -> int64 {
    acc + item
}

fn sum_map(acc: int64, key: int64, value: int64) -> int64 {
    acc + key + value
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                set_in: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_trial_fixture@build_set_right_spine3_i64(cmp_i64, r);
                map_in: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_trial_fixture@build_map_right_spine3_i64(cmp_i64, r);
                set_out: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_trial_balance@balance_set_left_at_root(set_in),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_sz: int64 <- wbt_set@size(set_out);
                set_sum: int64 <- wbt_set@fold(set_out, 0, sum_set);
                map_out: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_trial_balance@balance_map_left_at_root(map_in),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_sz: int64 <- wbt_map@size(map_out);
                map_sum: int64 <- wbt_map@fold(map_out, 0, sum_map);
                exit_code: int64 <- case set_sz == 4 of {
                    false -> 1;
                    true -> case set_sum == 100 of {
                        false -> 2;
                        true -> case map_sz == 4 of {
                            false -> 3;
                            true -> case map_sum == 1100 of { false -> 4; true -> 0 }
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
