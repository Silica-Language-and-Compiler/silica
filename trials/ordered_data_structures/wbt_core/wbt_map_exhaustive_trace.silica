// Layer 2 §8A.11 Step 3: exhaustive map insert/replace/delete over domain keys {1,2,3}
// with values key*10, depth 3.
//
// Op encoding (6 choices × depth 3 = 216 paths, matching set scale / arena batching):
//   0..2 = insert-or-replace key 1/2/3 with value key*10
//   3..5 = delete key 1/2/3
// Insert of an absent key expects inserted:true, replaced:false.
// Insert of a present key expects inserted:false, replaced:true (replace with same value).
// Distinct replacement values are not covered; replace flags still fire when the key exists.
//
// Bitmask oracle (bit0=has1, bit1=has2, bit2=has3); osum = sum of (key+value) = sum of 11*key.
// Scalar facts + get probes only — no List live with WBT ops.
// Canonical arenas are 4KB; map nodes are heavier than set nodes, so batch 12 paths per
// fresh arena key (18 arenas × 12 = 216) to stay within bump allocation.

use wbt_map;
use wbt_trial_oracle_i64;
use trial_support_int64;

fn trace_cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn key_value(key: int64) -> int64 {
    key * 10
}

fn bit_has(mask: int64, key: int64) -> boolean {
    case key of {
        1 -> case mask % 2 of { 0 -> false; _: int64 -> true };
        2 -> case (mask / 2) % 2 of { 0 -> false; _: int64 -> true };
        3 -> case (mask / 4) % 2 of { 0 -> false; _: int64 -> true };
        _: int64 -> false
    }
}

fn bit_insert(mask: int64, key: int64) -> { mask: int64, inserted: boolean, replaced: boolean } {
    case bit_has(mask, key) of {
        true -> { mask: mask, inserted: false, replaced: true };
        false -> case key of {
            1 -> { mask: mask + 1, inserted: true, replaced: false };
            2 -> { mask: mask + 2, inserted: true, replaced: false };
            3 -> { mask: mask + 4, inserted: true, replaced: false };
            _: int64 -> { mask: mask, inserted: false, replaced: false }
        }
    }
}

fn bit_delete(mask: int64, key: int64) -> { mask: int64, removed: boolean } {
    case bit_has(mask, key) of {
        false -> { mask: mask, removed: false };
        true -> case key of {
            1 -> { mask: mask - 1, removed: true };
            2 -> { mask: mask - 2, removed: true };
            3 -> { mask: mask - 4, removed: true };
            _: int64 -> { mask: mask, removed: false }
        }
    }
}

fn bit_olen(mask: int64) -> int64 {
    case mask of {
        0 -> 0;
        1 -> 1;
        2 -> 1;
        3 -> 2;
        4 -> 1;
        5 -> 2;
        6 -> 2;
        7 -> 3;
        _: int64 -> 0
    }
}

// Present keys contribute key + key*10 = 11*key to the fold sum.
fn bit_osum(mask: int64) -> int64 {
    case mask of {
        0 -> 0;
        1 -> 11;
        2 -> 22;
        3 -> 33;
        4 -> 33;
        5 -> 44;
        6 -> 55;
        7 -> 66;
        _: int64 -> 0
    }
}

fn bool_eq(a: boolean, b: boolean) -> boolean {
    case a of {
        false -> case b of { false -> true; true -> false };
        true -> b
    }
}

fn get_agrees(
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    mask: int64,
    key: int64
) -> boolean {
    sequence
        want: boolean <- bit_has(mask, key);
        want_val: int64 <- key_value(key);
        got: { status: :not_found | :found, value: int64 } <- wbt_map@get(map, key, 0)
    produces
        pure case want of {
            false -> case got.status of { :not_found -> true; :found -> false };
            true -> case got.status of {
                :not_found -> false;
                :found -> case got.value == want_val of { true -> true; false -> false }
            }
        }
    end
}

fn verify_map_mask(
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    mask: int64
) -> boolean {
    sequence
        olen: int64 <- bit_olen(mask);
        osum: int64 <- bit_osum(mask);
        facts_ok: boolean <- wbt_trial_oracle_i64@check_map_facts(map, olen, osum);
        g1: boolean <- get_agrees(map, mask, 1);
        g2: boolean <- case g1 of { false -> false; true -> get_agrees(map, mask, 2) };
        g3: boolean <- case g2 of { false -> false; true -> get_agrees(map, mask, 3) }
    produces
        pure case facts_ok of { false -> false; true -> g3 }
    end
}

// Empty map in a chosen canonical arena (non-zero key). Wrapped sequence avoids bare-empty trampoline hang.
fn make_empty_keyed(arena_key: int64) -> {
    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        ph: region(L, normal) <- canonical_arena_lookup(arena_key);
        out: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- {
            root: :none,
            compare_key: trace_cmp_i64,
            compare_value: trace_cmp_i64,
            region: ph,
            specialization_key: 0,
            compare_key_ordering_bundle: 0,
            compare_value_ordering_bundle: 0
        }
    produces
        pure out
    end
}

fn step_insert(
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    mask: int64,
    key: int64
) -> {
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    mask: int64,
    ok: boolean
} {
    sequence
        val: int64 <- key_value(key);
        ins: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(map, key, val);
        m: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- ins.map;
        bi: { mask: int64, inserted: boolean, replaced: boolean } <- bit_insert(mask, key);
        nm: int64 <- bi.mask;
        ins_ok: boolean <- bool_eq(ins.inserted, bi.inserted);
        rep_ok: boolean <- bool_eq(ins.replaced, bi.replaced);
        flag_ok: boolean <- case ins_ok of { false -> false; true -> rep_ok };
        state_ok: boolean <- case flag_ok of {
            false -> false;
            true -> verify_map_mask(m, nm)
        }
    produces
        pure { map: m, mask: nm, ok: state_ok }
    end
}

fn step_delete(
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    mask: int64,
    key: int64
) -> {
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    mask: int64,
    ok: boolean
} {
    sequence
        del: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(map, key);
        m: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- del.map;
        bd: { mask: int64, removed: boolean } <- bit_delete(mask, key);
        nm: int64 <- bd.mask;
        flag_ok: boolean <- bool_eq(del.removed, bd.removed);
        state_ok: boolean <- case flag_ok of {
            false -> false;
            true -> verify_map_mask(m, nm)
        }
    produces
        pure { map: m, mask: nm, ok: state_ok }
    end
}

fn apply_op(
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    mask: int64,
    op: int64
) -> {
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    mask: int64,
    ok: boolean
} {
    case op of {
        0 -> step_insert(map, mask, 1);
        1 -> step_insert(map, mask, 2);
        2 -> step_insert(map, mask, 3);
        3 -> step_delete(map, mask, 1);
        4 -> step_delete(map, mask, 2);
        _: int64 -> step_delete(map, mask, 3)
    }
}

fn run_path(arena_key: int64, path_id: int64) -> boolean {
    sequence
        m0: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- make_empty_keyed(arena_key);
        op0: int64 <- path_id % 6;
        r0: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            mask: int64,
            ok: boolean
        } <- apply_op(m0, 0, op0);
        ma: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- r0.map;
        mask0: int64 <- r0.mask;
        rest1: int64 <- path_id / 6;
        op1: int64 <- rest1 % 6;
        r1: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            mask: int64,
            ok: boolean
        } <- case r0.ok of {
            false -> { map: ma, mask: mask0, ok: false };
            true -> apply_op(ma, mask0, op1)
        };
        mb: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- r1.map;
        mask1: int64 <- r1.mask;
        rest2: int64 <- rest1 / 6;
        op2: int64 <- rest2 % 6;
        r2: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            mask: int64,
            ok: boolean
        } <- case r1.ok of {
            false -> { map: mb, mask: mask1, ok: false };
            true -> apply_op(mb, mask1, op2)
        }
    produces
        pure r2.ok
    end
}

fn try_paths_range(arena_key: int64, lo: int64, hi: int64) -> boolean {
    case hi - lo of {
        0 -> true;
        1 -> run_path(arena_key, lo);
        _: int64 -> {
            sequence
                span: int64 <- hi - lo;
                half: int64 <- span / 2;
                mid: int64 <- lo + half;
                ok1: boolean <- try_paths_range(arena_key, lo, mid);
                ok2: boolean <- case ok1 of {
                    false -> false;
                    true -> try_paths_range(arena_key, mid, hi)
                }
            produces
                pure ok2
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                // Eighteen disjoint 4KB arenas × 12 paths = 216 sequences (6^3).
                // (Map nodes need more arena than set; set used 6×36.)
                b0: boolean <- try_paths_range(2, 0, 12);
                b1: boolean <- case b0 of { false -> false; true -> try_paths_range(3, 12, 24) };
                b2: boolean <- case b1 of { false -> false; true -> try_paths_range(4, 24, 36) };
                b3: boolean <- case b2 of { false -> false; true -> try_paths_range(5, 36, 48) };
                b4: boolean <- case b3 of { false -> false; true -> try_paths_range(6, 48, 60) };
                b5: boolean <- case b4 of { false -> false; true -> try_paths_range(7, 60, 72) };
                b6: boolean <- case b5 of { false -> false; true -> try_paths_range(8, 72, 84) };
                b7: boolean <- case b6 of { false -> false; true -> try_paths_range(9, 84, 96) };
                b8: boolean <- case b7 of { false -> false; true -> try_paths_range(10, 96, 108) };
                b9: boolean <- case b8 of { false -> false; true -> try_paths_range(11, 108, 120) };
                b10: boolean <- case b9 of { false -> false; true -> try_paths_range(12, 120, 132) };
                b11: boolean <- case b10 of { false -> false; true -> try_paths_range(13, 132, 144) };
                b12: boolean <- case b11 of { false -> false; true -> try_paths_range(14, 144, 156) };
                b13: boolean <- case b12 of { false -> false; true -> try_paths_range(15, 156, 168) };
                b14: boolean <- case b13 of { false -> false; true -> try_paths_range(16, 168, 180) };
                b15: boolean <- case b14 of { false -> false; true -> try_paths_range(17, 180, 192) };
                b16: boolean <- case b15 of { false -> false; true -> try_paths_range(18, 192, 204) };
                b17: boolean <- case b16 of { false -> false; true -> try_paths_range(19, 204, 216) }
            produces
                pure case b17 of { true -> 0; false -> 1 }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
