// Layer 2 §8A.7: empty and missing-key delete are no-ops (removed=false, size unchanged).

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_set(acc: int64, item: int64) -> int64 {
    acc + item
}

fn set_absent_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        d_empty: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(empty0, 1);
        a1: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(empty0, 2);
        a2: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a1.set, 1);
        a3: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a2.set, 3);
        d_miss: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(a3.set, 9);
        sz_old: int64 <- wbt_set@size(a3.set);
        sz_new: int64 <- wbt_set@size(d_miss.set);
        sum_old: int64 <- wbt_set@fold(a3.set, 0, sum_set);
        sum_new: int64 <- wbt_set@fold(d_miss.set, 0, sum_set);
        has1: boolean <- wbt_set@contains(d_miss.set, 1);
        has2: boolean <- wbt_set@contains(d_miss.set, 2);
        has3: boolean <- wbt_set@contains(d_miss.set, 3);
        has9: boolean <- wbt_set@contains(d_miss.set, 9)
    produces
        pure case d_empty.removed of {
            true -> false;
            false -> case d_miss.removed of {
                true -> false;
                false -> case sz_old == 3 and sz_new == 3 of {
                    false -> false;
                    true -> case sum_old == 6 and sum_new == 6 of {
                        false -> false;
                        true -> case has1 and has2 and has3 of {
                            false -> false;
                            true -> case has9 of { true -> false; false -> true }
                        }
                    }
                }
            }
        }
    end
}

fn map_absent_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        d_empty: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(empty0, 1);
        a1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 2, 20);
        a2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a1.map, 1, 10);
        a3: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a2.map, 3, 30);
        d_miss: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(a3.map, 9);
        sz_old: int64 <- wbt_map@size(a3.map);
        sz_new: int64 <- wbt_map@size(d_miss.map);
        g2: { status: :not_found | :found, value: int64 } <- wbt_map@get(d_miss.map, 2, 0);
        has9: boolean <- wbt_map@contains_key(d_miss.map, 9)
    produces
        pure case d_empty.removed of {
            true -> false;
            false -> case d_miss.removed of {
                true -> false;
                false -> case sz_old == 3 and sz_new == 3 of {
                    false -> false;
                    true -> case g2.status of {
                        :not_found -> false;
                        :found -> case g2.value == 20 of {
                            false -> false;
                            true -> case has9 of { true -> false; false -> true }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s_ok: boolean <- set_absent_ok();
                m_ok: boolean <- map_absent_ok()
            produces
                pure case s_ok of {
                    false -> 1;
                    true -> case m_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
