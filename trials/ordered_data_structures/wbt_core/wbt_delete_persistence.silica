// Layer 2 §8A.7: retained roots stay searchable across deletes; delete-all finishes at size 0.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_set(acc: int64, item: int64) -> int64 {
    acc + item
}

fn set_version_ok(
    set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    expect_sz: int64,
    expect_sum: int64,
    expect_present: int64
) -> boolean {
    sequence
        sz: int64 <- wbt_set@size(set);
        sum: int64 <- wbt_set@fold(set, 0, sum_set);
        has: boolean <- wbt_set@contains(set, expect_present)
    produces
        pure case sz == expect_sz of {
            false -> false;
            true -> case sum == expect_sum of {
                false -> false;
                true -> has
            }
        }
    end
}

fn set_persist_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        a1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(empty0, 1);
        a1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a1 of {
            :unchanged -> empty0;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        a2: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a1_set, 2);
        a2_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a2 of {
            :unchanged -> a1_set;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        a3: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a2_set, 3);
        a3_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a3 of {
            :unchanged -> a2_set;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        a4: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(a3_set, 4);
        a4_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case a4 of {
            :unchanged -> a3_set;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
        };
        d1: :unchanged | (:removed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@delete(a4_set, 2);
        d1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d1 of {
            :unchanged -> a4_set;
            (:removed, v_removed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_removed
        };
        d1_removed: boolean <- case d1 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        d2: :unchanged | (:removed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@delete(d1_set, 4);
        d2_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d2 of {
            :unchanged -> d1_set;
            (:removed, v_removed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_removed
        };
        d2_removed: boolean <- case d2 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        d3: :unchanged | (:removed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@delete(d2_set, 1);
        d3_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d3 of {
            :unchanged -> d2_set;
            (:removed, v_removed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_removed
        };
        d3_removed: boolean <- case d3 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        d4: :unchanged | (:removed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@delete(d3_set, 3);
        d4_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case d4 of {
            :unchanged -> d3_set;
            (:removed, v_removed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_removed
        };
        d4_removed: boolean <- case d4 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        v4: boolean <- set_version_ok(a4_set, 4, 10, 2);
        v_d1: boolean <- set_version_ok(d1_set, 3, 8, 1);
        v_d2: boolean <- set_version_ok(d2_set, 2, 4, 3);
        v_d3: boolean <- set_version_ok(d3_set, 1, 3, 3);
        sz0: int64 <- wbt_set@size(d4_set)
    produces
        pure case d1_removed and d2_removed and d3_removed and d4_removed of {
            false -> false;
            true -> case v4 and v_d1 and v_d2 and v_d3 of {
                false -> false;
                true -> sz0 == 0
            }
        }
    end
}

fn map_persist_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        a1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@insert(empty0, 1, 10);
        a1_map: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case a1 of {
            :unchanged -> empty0;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_inserted;
            (:replaced, v_replaced: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_replaced
        };
        a2: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@insert(a1_map, 2, 20);
        a2_map: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case a2 of {
            :unchanged -> a1_map;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_inserted;
            (:replaced, v_replaced: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_replaced
        };
        a3: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@insert(a2_map, 3, 30);
        a3_map: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case a3 of {
            :unchanged -> a2_map;
            (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_inserted;
            (:replaced, v_replaced: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_replaced
        };
        d1: :unchanged | (:removed, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@delete(a3_map, 2);
        d1_map: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case d1 of {
            :unchanged -> a3_map;
            (:removed, v_removed: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_removed
        };
        d1_removed: boolean <- case d1 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> true
        };
        d2: :unchanged | (:removed, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@delete(d1_map, 1);
        d2_map: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case d2 of {
            :unchanged -> d1_map;
            (:removed, v_removed: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_removed
        };
        d2_removed: boolean <- case d2 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> true
        };
        d3: :unchanged | (:removed, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) <- wbt_map@delete(d2_map, 3);
        d3_map: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case d3 of {
            :unchanged -> d2_map;
            (:removed, v_removed: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> v_removed
        };
        d3_removed: boolean <- case d3 of {
            :unchanged -> false;
            (:removed, _v_removed: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> true
        };
        old_g2: { status: :not_found | :found, value: int64 } <- wbt_map@get(a3_map, 2, 0);
        mid_g3: { status: :not_found | :found, value: int64 } <- wbt_map@get(d1_map, 3, 0);
        mid_has2: boolean <- wbt_map@contains_key(d1_map, 2);
        sz0: int64 <- wbt_map@size(d3_map);
        old_sz: int64 <- wbt_map@size(a3_map)
    produces
        pure case d1_removed and d2_removed and d3_removed of {
            false -> false;
            true -> case old_sz == 3 of {
                false -> false;
                true -> case old_g2.status of {
                    :not_found -> false;
                    :found -> case old_g2.value == 20 of {
                        false -> false;
                        true -> case mid_g3.status of {
                            :not_found -> false;
                            :found -> case mid_g3.value == 30 of {
                                false -> false;
                                true -> case mid_has2 of {
                                    true -> false;
                                    false -> sz0 == 0
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s_ok: boolean <- set_persist_ok();
                m_ok: boolean <- map_persist_ok()
            produces
                pure case s_ok of {
                    false -> 1;
                    true -> case m_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
