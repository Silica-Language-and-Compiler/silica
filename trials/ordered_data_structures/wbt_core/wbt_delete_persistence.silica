// Layer 2 §8A.7: retained roots stay searchable across deletes; delete-all finishes at size 0.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_set(acc: int64, item: int64) -> int64 {
    acc + item
}

fn set_version_ok(
    set: {
        root: ref?(L, normal, rec),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    expect_sz: int64,
    expect_sum: int64,
    expect_present: int64
) -> boolean {
    sequence
        sz: int64 <- wbt_set@size(set);
        sum: int64 <- wbt_set@fold(set, 0, sum_set);
        has: boolean <- wbt_set@contains(set, expect_present)
    produces
        pure case sz == expect_sz of {
            false -> false;
            true -> case sum == expect_sum of {
                false -> false;
                true -> has
            }
        }
    end
}

fn set_persist_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        a1: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(empty0, 1);
        a2: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a1.set, 2);
        a3: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a2.set, 3);
        a4: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a3.set, 4);
        d1: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(a4.set, 2);
        d2: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(d1.set, 4);
        d3: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(d2.set, 1);
        d4: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(d3.set, 3);
        v4: boolean <- set_version_ok(a4.set, 4, 10, 2);
        v_d1: boolean <- set_version_ok(d1.set, 3, 8, 1);
        v_d2: boolean <- set_version_ok(d2.set, 2, 4, 3);
        v_d3: boolean <- set_version_ok(d3.set, 1, 3, 3);
        sz0: int64 <- wbt_set@size(d4.set)
    produces
        pure case d1.removed and d2.removed and d3.removed and d4.removed of {
            false -> false;
            true -> case v4 and v_d1 and v_d2 and v_d3 of {
                false -> false;
                true -> sz0 == 0
            }
        }
    end
}

fn map_persist_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        a1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 1, 10);
        a2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a1.map, 2, 20);
        a3: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a2.map, 3, 30);
        d1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(a3.map, 2);
        d2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(d1.map, 1);
        d3: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(d2.map, 3);
        old_g2: { status: :not_found | :found, value: int64 } <- wbt_map@get(a3.map, 2, 0);
        mid_g3: { status: :not_found | :found, value: int64 } <- wbt_map@get(d1.map, 3, 0);
        mid_has2: boolean <- wbt_map@contains_key(d1.map, 2);
        sz0: int64 <- wbt_map@size(d3.map);
        old_sz: int64 <- wbt_map@size(a3.map)
    produces
        pure case d1.removed and d2.removed and d3.removed of {
            false -> false;
            true -> case old_sz == 3 of {
                false -> false;
                true -> case old_g2.status of {
                    :not_found -> false;
                    :found -> case old_g2.value == 20 of {
                        false -> false;
                        true -> case mid_g3.status of {
                            :not_found -> false;
                            :found -> case mid_g3.value == 30 of {
                                false -> false;
                                true -> case mid_has2 of {
                                    true -> false;
                                    false -> sz0 == 0
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s_ok: boolean <- set_persist_ok();
                m_ok: boolean <- map_persist_ok()
            produces
                pure case s_ok of {
                    false -> 1;
                    true -> case m_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
