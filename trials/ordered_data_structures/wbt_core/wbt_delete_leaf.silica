// Layer 2 §8A.7: delete a leaf; residual size/order correct; old root still contains the leaf.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_set(acc: int64, item: int64) -> int64 {
    acc + item
}

fn set_leaf_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        a1: {
            set: {
                root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(empty0, 2);
        a2: {
            set: {
                root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a1.set, 1);
        a3: {
            set: {
                root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(a2.set, 3);
        d1: {
            set: {
                root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(a3.set, 1);
        sz: int64 <- wbt_set@size(d1.set);
        sum: int64 <- wbt_set@fold(d1.set, 0, sum_set);
        gone: boolean <- wbt_set@contains(d1.set, 1);
        has2: boolean <- wbt_set@contains(d1.set, 2);
        has3: boolean <- wbt_set@contains(d1.set, 3);
        old_has1: boolean <- wbt_set@contains(a3.set, 1);
        old_sz: int64 <- wbt_set@size(a3.set)
    produces
        pure case d1.removed of {
            false -> false;
            true -> case sz == 2 and sum == 5 of {
                false -> false;
                true -> case gone of {
                    true -> false;
                    false -> case has2 and has3 of {
                        false -> false;
                        true -> case old_has1 of {
                            false -> false;
                            true -> old_sz == 3
                        }
                    }
                }
            }
        }
    end
}

fn map_leaf_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        a1: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 2, 20);
        a2: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a1.map, 1, 10);
        a3: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a2.map, 3, 30);
        d1: {
            map: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(a3.map, 1);
        sz: int64 <- wbt_map@size(d1.map);
        g1: { status: :not_found | :found, value: int64 } <- wbt_map@get(d1.map, 1, 0);
        g2: { status: :not_found | :found, value: int64 } <- wbt_map@get(d1.map, 2, 0);
        g3: { status: :not_found | :found, value: int64 } <- wbt_map@get(d1.map, 3, 0);
        old_g1: { status: :not_found | :found, value: int64 } <- wbt_map@get(a3.map, 1, 0)
    produces
        pure case d1.removed of {
            false -> false;
            true -> case sz == 2 of {
                false -> false;
                true -> case g1.status of {
                    :found -> false;
                    :not_found -> case g2.status of {
                        :not_found -> false;
                        :found -> case g2.value == 20 of {
                            false -> false;
                            true -> case g3.status of {
                                :not_found -> false;
                                :found -> case g3.value == 30 of {
                                    false -> false;
                                    true -> case old_g1.status of {
                                        :not_found -> false;
                                        :found -> old_g1.value == 10
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s_ok: boolean <- set_leaf_ok();
                m_ok: boolean <- map_leaf_ok()
            produces
                pure case s_ok of {
                    false -> 1;
                    true -> case m_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
