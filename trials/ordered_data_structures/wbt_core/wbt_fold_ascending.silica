// Layer 2 §8A.2: ascending fold order, empty identity, map key/value preservation.

use wbt_set;
use wbt_map;
use wbt_trial_fixture;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_set_step(acc: int64, item: int64) -> int64 {
    acc + item
}

fn sum_map_step(acc: int64, key: int64, value: int64) -> int64 {
    acc + key + value
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                empty_set: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                empty_map: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
                set0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_trial_fixture@build_set_i64(cmp_i64, r);
                map0: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_trial_fixture@build_map_i64(cmp_i64, r);
                init9: int64 <- 9;
                init11: int64 <- 11;
                zero: int64 <- 0;
                empty_set_fold: int64 <- wbt_set@fold(empty_set, init9, sum_set_step);
                empty_map_fold: int64 <- wbt_map@fold(empty_map, init11, sum_map_step);
                set_sum: int64 <- wbt_set@fold(set0, zero, sum_set_step);
                map_sum: int64 <- wbt_map@fold(map0, zero, sum_map_step);
                exit_code: int64 <- case empty_set_fold == 9 of {
                    false -> 1;
                    true -> case empty_map_fold == 11 of {
                        false -> 2;
                        true -> case set_sum == 350 of {
                            false -> 3;
                            true -> case map_sum == 3850 of {
                                false -> 4;
                                true -> 0
                            }
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
