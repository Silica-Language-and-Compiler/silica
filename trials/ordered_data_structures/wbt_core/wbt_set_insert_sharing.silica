// Layer 2 §8A.5: changed paths are copied; untouched sibling subtrees remain shared
// (observable via old-root size/fold/search after a one-sided insert).

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_step(acc: int64, item: int64) -> int64 {
    acc + item
}

fn check_old_new(
    old_set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    new_set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    new_item: int64,
    shared_item: int64,
    expect_old_sum: int64,
    expect_new_sum: int64
) -> boolean {
    sequence
        old_sz: int64 <- wbt_set@size(old_set);
        old_sum: int64 <- wbt_set@fold(old_set, 0, sum_step);
        old_has_new: boolean <- wbt_set@contains(old_set, new_item);
        old_has_shared: boolean <- wbt_set@contains(old_set, shared_item);
        new_sz: int64 <- wbt_set@size(new_set);
        new_sum: int64 <- wbt_set@fold(new_set, 0, sum_step);
        new_has_new: boolean <- wbt_set@contains(new_set, new_item);
        new_has_shared: boolean <- wbt_set@contains(new_set, shared_item)
    produces
        pure case old_sz == 3 of {
            false -> false;
            true -> case old_sum == expect_old_sum of {
                false -> false;
                true -> case old_has_new of {
                    true -> false;
                    false -> case old_has_shared of {
                        false -> false;
                        true -> case new_sz == 4 of {
                            false -> false;
                            true -> case new_sum == expect_new_sum of {
                                false -> false;
                                true -> case new_has_new of {
                                    false -> false;
                                    true -> new_has_shared
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                t1: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(empty0, 20);
                t1_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case t1 of {
                    :unchanged -> empty0;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                t2: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(t1_set, 10);
                t2_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case t2 of {
                    :unchanged -> t1_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                t3: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(t2_set, 30);
                t3_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case t3 of {
                    :unchanged -> t2_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                t4: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(t3_set, 5);
                t4_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case t4 of {
                    :unchanged -> t3_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                t4_inserted: boolean <- case t4 of {
                    :unchanged -> false;
                    (:inserted, _v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                left_ok: boolean <- check_old_new(t3_set, t4_set, 5, 30, 60, 65);
                t5: :unchanged | (:inserted, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(t3_set, 40);
                t5_set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case t5 of {
                    :unchanged -> t3_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                t5_inserted: boolean <- case t5 of {
                    :unchanged -> false;
                    (:inserted, _v_inserted: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                right_ok: boolean <- check_old_new(t3_set, t5_set, 40, 10, 60, 100)
            produces
                pure case t4_inserted of {
                    false -> 1;
                    true -> case left_ok of {
                        false -> 2;
                        true -> case t5_inserted of {
                            false -> 3;
                            true -> case right_ok of {
                                false -> 4;
                                true -> 0
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
