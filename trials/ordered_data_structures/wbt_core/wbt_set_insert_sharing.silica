// Layer 2 §8A.5: changed paths are copied; untouched sibling subtrees remain shared
// (observable via old-root size/fold/search after a one-sided insert).

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn sum_step(acc: int64, item: int64) -> int64 {
    acc + item
}

fn check_old_new(
    old_set: {
        root: ref?(L, normal, rec),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    new_set: {
        root: ref?(L, normal, rec),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    new_item: int64,
    shared_item: int64,
    expect_old_sum: int64,
    expect_new_sum: int64
) -> boolean {
    sequence
        old_sz: int64 <- wbt_set@size(old_set);
        old_sum: int64 <- wbt_set@fold(old_set, 0, sum_step);
        old_has_new: boolean <- wbt_set@contains(old_set, new_item);
        old_has_shared: boolean <- wbt_set@contains(old_set, shared_item);
        new_sz: int64 <- wbt_set@size(new_set);
        new_sum: int64 <- wbt_set@fold(new_set, 0, sum_step);
        new_has_new: boolean <- wbt_set@contains(new_set, new_item);
        new_has_shared: boolean <- wbt_set@contains(new_set, shared_item)
    produces
        pure case old_sz == 3 of {
            false -> false;
            true -> case old_sum == expect_old_sum of {
                false -> false;
                true -> case old_has_new of {
                    true -> false;
                    false -> case old_has_shared of {
                        false -> false;
                        true -> case new_sz == 4 of {
                            false -> false;
                            true -> case new_sum == expect_new_sum of {
                                false -> false;
                                true -> case new_has_new of {
                                    false -> false;
                                    true -> new_has_shared
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@empty({ compare_item: cmp_i64 });
                t1: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, 20);
                t2: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(t1.set, 10);
                t3: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(t2.set, 30);
                t4: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(t3.set, 5);
                left_ok: boolean <- check_old_new(t3.set, t4.set, 5, 30, 60, 65);
                t5: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(t3.set, 40);
                right_ok: boolean <- check_old_new(t3.set, t5.set, 40, 10, 60, 100)
            produces
                pure case t4.inserted of {
                    false -> 1;
                    true -> case left_ok of {
                        false -> 2;
                        true -> case t5.inserted of {
                            false -> 3;
                            true -> case right_ok of {
                                false -> 4;
                                true -> 0
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
