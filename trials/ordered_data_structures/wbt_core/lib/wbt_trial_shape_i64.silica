// Trial-only direct root/child shape checks for int64 WBT set/map nodes.

export set_root_shape_i64/2;
export map_root_shape_i64/2;

fn set_child_root_is_i64(
    subtree: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    expected_item: int64,
    expected_size: int64
) -> boolean {
    case subtree of {
        :none -> false;
        node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (item, size, _: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure item == expected_item and size == expected_size
            end
        }
    }
}

fn set_root_shape_i64(
    set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    expected: {
        root: int64,
        size: int64,
        left_root: int64,
        left_size: int64,
        right_root: int64,
        right_size: int64
    }
) -> boolean {
    case set.root of {
        :none -> false;
        root_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (item, size, left: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
                left_ok: boolean <- set_child_root_is_i64(left, expected.left_root, expected.left_size);
                right_ok: boolean <- set_child_root_is_i64(right, expected.right_root, expected.right_size)
            produces
                pure item == expected.root and size == expected.size and left_ok and right_ok
            end
        }
    }
}

fn map_child_root_is_i64(
    subtree: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    expected_key: int64,
    expected_value: int64,
    expected_size: int64
) -> boolean {
    case subtree of {
        :none -> false;
        node_ref: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (key, value, size, _: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure key == expected_key and value == expected_value and size == expected_size
            end
        }
    }
}

fn map_root_shape_i64(
    map: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    expected: {
        root_key: int64,
        root_value: int64,
        size: int64,
        left_key: int64,
        left_value: int64,
        left_size: int64,
        right_key: int64,
        right_value: int64,
        right_size: int64
    }
) -> boolean {
    case map.root of {
        :none -> false;
        root_ref: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (key, value, size, left: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
                left_ok: boolean <- map_child_root_is_i64(left, expected.left_key, expected.left_value, expected.left_size);
                right_ok: boolean <- map_child_root_is_i64(right, expected.right_key, expected.right_value, expected.right_size)
            produces
                pure key == expected.root_key and value == expected.root_value and size == expected.size and left_ok and right_ok
            end
        }
    }
}
