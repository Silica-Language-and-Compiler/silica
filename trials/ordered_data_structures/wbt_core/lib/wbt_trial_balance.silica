// Trial-only §8A.4 helpers: unpack root node and invoke balance_* (destructure is last before produces).

use wbt_set;
use wbt_map;

export balance_set_left_at_root/1;
export balance_set_right_at_root/1;
export balance_map_left_at_root/1;
export balance_map_right_at_root/1;

fn balance_set_left_from_ref(
    set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        node: (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (item, _: int64, left: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure wbt_set@balance_left(set, item, left, right)
    end
}

fn balance_set_right_from_ref(
    set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        node: (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (item, _: int64, left: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure wbt_set@balance_right(set, item, left, right)
    end
}

fn balance_set_left_at_root(
    set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case set.root of {
        :none -> :none;
        node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            balance_set_left_from_ref(set, node_ref)
    }
}

fn balance_set_right_at_root(
    set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case set.root of {
        :none -> :none;
        node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            balance_set_right_from_ref(set, node_ref)
    }
}

fn balance_map_left_at_root(
    tree: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case tree.root of {
        :none -> :none;
        node_ref: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            wbt_map@balance_left(tree, node_ref)
    }
}

fn balance_map_right_at_root(
    tree: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case tree.root of {
        :none -> :none;
        node_ref: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            wbt_map@balance_right(tree, node_ref)
    }
}
