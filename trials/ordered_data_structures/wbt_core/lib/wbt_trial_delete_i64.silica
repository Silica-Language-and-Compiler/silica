// Trial-only int64 delete-status with injectable atom comparator (§8A.7 invalid-comparator path).

use wbt_set;

export delete_status_i64/3;

fn walk_delete_cmp_i64(
    cmp: fn(int64, int64) -> atom,
    item: int64,
    node_key: int64,
    left: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence
        valid: atom <- comparator_result_validate(cmp(item, node_key))
    produces
        pure case valid of {
            :less -> walk_delete_i64(cmp, item, left);
            :equal -> :would_delete;
            :greater -> walk_delete_i64(cmp, item, right);
            _: atom -> :invalid_comparator_result
        }
    end
}

fn walk_delete_i64(
    cmp: fn(int64, int64) -> atom,
    item: int64,
    subtree: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    case subtree of {
        :none -> :absent;
        node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (node_key, _: int64, left: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure walk_delete_cmp_i64(cmp, item, node_key, left, right)
            end
        }
    }
}

fn delete_status_i64(
    cmp: fn(int64, int64) -> atom,
    item: int64,
    set: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> atom {
    case set.root of {
        :none -> :absent;
        root_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (node_key, _: int64, left: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure walk_delete_cmp_i64(cmp, item, node_key, left, right)
            end
        }
    }
}
