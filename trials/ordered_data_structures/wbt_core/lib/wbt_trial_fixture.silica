// Trial-only §8A.2–§8A.3 fixtures (int64): malformed roots via alloc_rec; production nodes via smart_node.

use wbt_set;
use wbt_map;

export build_set_i64/2;
export build_map_i64/2;
export build_set_singleton_i64/3;
export build_map_singleton_i64/4;
export build_set_cached_size_i64/4;
export build_map_cached_size_i64/5;
