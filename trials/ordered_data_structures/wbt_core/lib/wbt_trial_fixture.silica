fn build_set_smart_leaf_i64(
    cmp: fn(int64, int64) -> :less | :equal | :greater,
    r: region(L, normal),
    item: int64
) -> {
    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        scratch: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <-
            alloc_rec(r, (0, 0, :none, :none));
        scratch_payload: (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(scratch);
        witness: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: :none,
            compare_item: cmp,
            region: r,
            specialization_key: 0,
            compare_item_ordering_bundle: 0
        };
        out: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: wbt_set@smart_node(witness, item, witness.root, witness.root),
            compare_item: cmp,
            region: r,
            specialization_key: 0,
            compare_item_ordering_bundle: 0
        }
    produces
        pure out
    end
}

