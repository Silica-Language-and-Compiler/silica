// Layer 2 §8A.10: invalid comparator during bound checking → :invalid_comparator_result.

use wbt_set;
use wbt_trial_fixture;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64_atom(a: int64, b: int64) -> atom {
    case cmp_i64(a, b) of {
        :less -> :less;
        :equal -> :equal;
        :greater -> :greater
    }
}

fn cmp_bad_bound(a: int64, b: int64) -> atom {
    case a == 10 of {
        true -> case b == 25 of {
            true -> :ok;
            false -> cmp_i64_atom(a, b)
        };
        false -> cmp_i64_atom(a, b)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                good: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_trial_fixture@build_set_i64(cmp_i64, r);
                v: { valid: boolean, error: atom, logical_count: int64 } <-
                    wbt_set@validate_with_compare(good, cmp_bad_bound);
                code: int64 <- wbt_set@validate_error_code(v.error);
                exit_code: int64 <- case v.valid of {
                    true -> 1;
                    false -> case code of {
                        4 -> 0;
                        _: int64 -> 2
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
