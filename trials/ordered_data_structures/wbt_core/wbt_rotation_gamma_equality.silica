// Layer 2 §8A.4: weight(inner) == 2 * weight(outer) selects double rotation both ways.

use wbt_set;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            // GAMMA: single when weight(inner) < 2*weight(outer); equality → double.
            // Single left: w_rl=1, w_rr=2 → 1 < 4 true.
            // Double left: w_rl=2, w_rr=1 → 2 < 2 false (equality).
            // Mirror: w_lr=1, w_ll=2 → single; w_lr=2, w_ll=1 → double.
            single_left: boolean <- wbt_set@weight_lt_2x(1, 2);
            double_left: boolean <- wbt_set@weight_lt_2x(2, 1);
            single_right: boolean <- wbt_set@weight_lt_2x(1, 2);
            double_right: boolean <- wbt_set@weight_lt_2x(2, 1);
            eq_edge: boolean <- wbt_set@weight_lt_2x(4, 2);
            case single_left of {
                false -> 1;
                true -> case double_left of {
                    true -> 2;
                    false -> case single_right of {
                        false -> 3;
                        true -> case double_right of {
                            true -> 4;
                            false -> case eq_edge of {
                                true -> 5;
                                false -> 0
                            }
                        }
                    }
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
