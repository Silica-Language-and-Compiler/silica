// Layer 2 §8A.7: delete singleton root and one-child root for set and map.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn set_root_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        s1: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(empty0, 7);
        d_sing: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(s1.set, 7);
        sz0: int64 <- wbt_set@size(d_sing.set);
        old_has: boolean <- wbt_set@contains(s1.set, 7);
        // one-child root: insert 5 then 3 (left child), delete root 5
        o1: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(empty0, 5);
        o2: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(o1.set, 3);
        d_one: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_set@delete(o2.set, 5);
        sz1: int64 <- wbt_set@size(d_one.set);
        has3: boolean <- wbt_set@contains(d_one.set, 3);
        has5: boolean <- wbt_set@contains(d_one.set, 5)
    produces
        pure case d_sing.removed of {
            false -> false;
            true -> case sz0 == 0 of {
                false -> false;
                true -> case old_has of {
                    false -> false;
                    true -> case d_one.removed of {
                        false -> false;
                        true -> case sz1 == 1 and has3 of {
                            false -> false;
                            true -> case has5 of { true -> false; false -> true }
                        }
                    }
                }
            }
        }
    end
}

fn map_root_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        s1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 7, 70);
        d_sing: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(s1.map, 7);
        sz0: int64 <- wbt_map@size(d_sing.map);
        o1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 5, 50);
        o2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(o1.map, 3, 30);
        d_one: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            removed: boolean
        } <- wbt_map@delete(o2.map, 5);
        sz1: int64 <- wbt_map@size(d_one.map);
        g3: { status: :not_found | :found, value: int64 } <- wbt_map@get(d_one.map, 3, 0);
        has5: boolean <- wbt_map@contains_key(d_one.map, 5)
    produces
        pure case d_sing.removed of {
            false -> false;
            true -> case sz0 == 0 of {
                false -> false;
                true -> case d_one.removed of {
                    false -> false;
                    true -> case sz1 == 1 of {
                        false -> false;
                        true -> case g3.status of {
                            :not_found -> false;
                            :found -> case g3.value == 30 of {
                                false -> false;
                                true -> case has5 of { true -> false; false -> true }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s_ok: boolean <- set_root_ok();
                m_ok: boolean <- map_root_ok()
            produces
                pure case s_ok of {
                    false -> 1;
                    true -> case m_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
