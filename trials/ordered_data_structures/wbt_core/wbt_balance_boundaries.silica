// Layer 2 §8A.4: DELTA=3 weight inequalities below/at/above boundary; near-overflow mul.

use wbt_set;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            // weight_le_3x(a, b) <=> a <= 3*b (overflow-safe).
            // Below: 5 <= 3*2 (6) true; at: 6 <= 6 true; above: 7 <= 6 false.
            // Mirror: 2 <= 3*1 true; 3 <= 3 true; 4 <= 3 false.
            // Near overflow: 3*max_i64 overflows mul → treated as a <= 3*b true for any a.
            max_i64: int64 <- 9223372036854775807;
            below_ok: boolean <- wbt_set@weight_le_3x(5, 2);
            at_ok: boolean <- wbt_set@weight_le_3x(6, 2);
            above_ok: boolean <- wbt_set@weight_le_3x(7, 2);
            mir_below: boolean <- wbt_set@weight_le_3x(2, 1);
            mir_at: boolean <- wbt_set@weight_le_3x(3, 1);
            mir_above: boolean <- wbt_set@weight_le_3x(4, 1);
            overflow_ok: boolean <- wbt_set@weight_le_3x(max_i64, max_i64);
            balanced_ok: boolean <- wbt_set@weights_balanced(2, 2);
            unbalanced: boolean <- wbt_set@weights_balanced(1, 4);
            case below_ok of {
                false -> 1;
                true -> case at_ok of {
                    false -> 2;
                    true -> case above_ok of {
                        true -> 3;
                        false -> case mir_below of {
                            false -> 4;
                            true -> case mir_at of {
                                false -> 5;
                                true -> case mir_above of {
                                    true -> 6;
                                    false -> case overflow_ok of {
                                        false -> 7;
                                        true -> case balanced_ok of {
                                            false -> 8;
                                            true -> case unbalanced of {
                                                true -> 9;
                                                false -> 0
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
