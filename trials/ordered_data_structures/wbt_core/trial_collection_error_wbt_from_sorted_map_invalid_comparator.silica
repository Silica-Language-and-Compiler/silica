// Layer 2 §8A.8 collection-error gate: production map from_sorted preflight rejects invalid key comparator atoms.

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn trap_value(_a: int64, _b: int64) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn cmp_i64_atom(a: int64, b: int64) -> atom {
    case cmp_i64(a, b) of {
        :less -> :less;
        :equal -> :equal;
        :greater -> :greater
    }
}

fn cmp_bad_begin(a: int64, b: int64) -> atom {
    case a == 10 and b == 20 of { true -> :invalid_trial_atom; false -> cmp_i64_atom(a, b) }
}

fn cmp_bad_mid(a: int64, b: int64) -> atom {
    case a == 20 and b == 30 of { true -> :invalid_trial_atom; false -> cmp_i64_atom(a, b) }
}

fn cmp_bad_end(a: int64, b: int64) -> atom {
    case a == 30 and b == 40 of { true -> :invalid_trial_atom; false -> cmp_i64_atom(a, b) }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
                a: (int64, int64) <- (10, 100);
                b: (int64, int64) <- (20, 200);
                c: (int64, int64) <- (30, 300);
                d: (int64, int64) <- (40, 400);
                bad_begin: atom <- wbt_map@from_sorted_preflight_status(empty0, cmp_bad_begin, a, b);
                bad_mid: atom <- wbt_map@from_sorted_preflight_status(empty0, cmp_bad_mid, b, c);
                bad_end: atom <- wbt_map@from_sorted_preflight_status(empty0, cmp_bad_end, c, d);
                good: atom <- wbt_map@from_sorted_preflight_status(empty0, cmp_i64_atom, a, b);
                c_begin: int64 <- wbt_map@from_sorted_error_code(bad_begin);
                c_mid: int64 <- wbt_map@from_sorted_error_code(bad_mid);
                c_end: int64 <- wbt_map@from_sorted_error_code(bad_end);
                c_good: int64 <- wbt_map@from_sorted_error_code(good)
            produces
                pure case c_begin == 3 of {
                    false -> 1;
                    true -> case c_mid == 3 of {
                        false -> 2;
                        true -> case c_end == 3 of {
                            false -> 3;
                            true -> case c_good == 0 of { false -> 4; true -> 0 }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
