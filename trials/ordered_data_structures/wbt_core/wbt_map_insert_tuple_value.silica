// Layer 2 §8A.6 Step 9: non-scalar value — int64 key, (int64, string) value.

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_pair(a: (int64, string), b: (int64, string)) -> :less | :equal | :greater {
    (a0: int64, _: string) <- a;
    (b0: int64, _: string) <- b;
    cmp_i64(a0, b0)
}

fn pair_eq(a: (int64, string), b: (int64, string)) -> boolean {
    (a0: int64, a1: string) <- a;
    (b0: int64, b1: string) <- b;
    case a0 == b0 of {
        false -> false;
        true -> a1 == b1
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_pair });
                i1: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(empty0, 1, (10, "a"));
                i2: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(i1.map, 2, (20, "b"));
                r1: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(i2.map, 1, (11, "A"));
                sz: int64 <- wbt_map@size(r1.map);
                g1: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(r1.map, 1, (0, ""));
                g2: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(r1.map, 2, (0, ""));
                g_old: { status: :not_found | :found, value: (int64, string) } <- wbt_map@get(i2.map, 1, (0, ""))
            produces
                pure case i1.inserted of {
                    false -> 1;
                    true -> case i2.inserted of {
                        false -> 2;
                        true -> case r1.replaced of {
                            false -> 3;
                            true -> case r1.inserted of {
                                true -> 4;
                                false -> case sz == 2 of {
                                    false -> 5;
                                    true -> case g1.status of {
                                        :not_found -> 6;
                                        :found -> case pair_eq(g1.value, (11, "A")) of {
                                            false -> 7;
                                            true -> case g2.status of {
                                                :not_found -> 8;
                                                :found -> case pair_eq(g2.value, (20, "b")) of {
                                                    false -> 9;
                                                    true -> case g_old.status of {
                                                        :not_found -> 10;
                                                        :found -> case pair_eq(g_old.value, (10, "a")) of {
                                                            false -> 11;
                                                            true -> 0
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
