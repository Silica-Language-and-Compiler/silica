fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                f: boolean <- flags_ok();
                a: boolean <- asc_ok();
                d: boolean <- desc_ok()
            produces
                pure case f of {
                    false -> 1;
                    true -> case a of {
                        false -> 2;
                        true -> case d of {
                            false -> 3;
                            true -> 0
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
