// Layer 2 §8A.6: insert/replace flags plus ascending and descending order matrices.
// Alt/median-first matrices live in wbt_map_insert_orders.silica so one process
// does not exhaust the shared canonical arena (map nodes are larger than set nodes).

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn got_is(
    result: { status: :not_found | :found, value: int64 },
    expected: int64
) -> boolean {
    case result.status of {
        :found -> result.value == expected;
        :not_found -> false
    }
}

fn five_ok(
    m: {
        root: ref?(L, normal, rec),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> boolean {
    sequence
        sz: int64 <- wbt_map@size(m);
        g1: { status: :not_found | :found, value: int64 } <- wbt_map@get(m, 1, 0);
        g2: { status: :not_found | :found, value: int64 } <- wbt_map@get(m, 2, 0);
        g3: { status: :not_found | :found, value: int64 } <- wbt_map@get(m, 3, 0);
        g4: { status: :not_found | :found, value: int64 } <- wbt_map@get(m, 4, 0);
        g5: { status: :not_found | :found, value: int64 } <- wbt_map@get(m, 5, 0)
    produces
        pure case sz == 5 of {
            false -> false;
            true -> case got_is(g1, 10) of {
                false -> false;
                true -> case got_is(g2, 20) of {
                    false -> false;
                    true -> case got_is(g3, 30) of {
                        false -> false;
                        true -> case got_is(g4, 40) of {
                            false -> false;
                            true -> got_is(g5, 50)
                        }
                    }
                }
            }
        }
    end
}

fn flags_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        r1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 42, 1);
        r2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(r1.map, 42, 2);
        sz1: int64 <- wbt_map@size(r1.map);
        sz2: int64 <- wbt_map@size(r2.map);
        g_old: { status: :not_found | :found, value: int64 } <- wbt_map@get(r1.map, 42, 0);
        g_new: { status: :not_found | :found, value: int64 } <- wbt_map@get(r2.map, 42, 0)
    produces
        pure case r1.inserted of {
            false -> false;
            true -> case r1.replaced of {
                true -> false;
                false -> case r2.inserted of {
                    true -> false;
                    false -> case r2.replaced of {
                        false -> false;
                        true -> case sz1 == 1 of {
                            false -> false;
                            true -> case sz2 == 1 of {
                                false -> false;
                                true -> case got_is(g_old, 1) of {
                                    false -> false;
                                    true -> got_is(g_new, 2)
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}

fn asc_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        a1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 1, 10);
        a2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a1.map, 2, 20);
        a3: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a2.map, 3, 30);
        a4: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a3.map, 4, 40);
        a5: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(a4.map, 5, 50)
    produces
        pure five_ok(a5.map)
    end
}

fn desc_ok() -> boolean {
    sequence
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 });
        d1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, 5, 50);
        d2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(d1.map, 4, 40);
        d3: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(d2.map, 3, 30);
        d4: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(d3.map, 2, 20);
        d5: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(d4.map, 1, 10)
    produces
        pure five_ok(d5.map)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                f: boolean <- flags_ok();
                a: boolean <- asc_ok();
                d: boolean <- desc_ok()
            produces
                pure case f of {
                    false -> 1;
                    true -> case a of {
                        false -> 2;
                        true -> case d of {
                            false -> 3;
                            true -> 0
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
