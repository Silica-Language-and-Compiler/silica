	.text
# silica_rt_dest_take(rdi = a destination pair: [0] the next free address (the area grows DOWN from it),
# [8] the area's floor; rsi = bytes) -> rdi = a zeroed, 8-byte aligned block of that many bytes (rounded
# up to 8) taken from the top of what is free. Chunk 15 stage 4e (design §9.1): the runtime's list,
# string and record builders write into a destination area their caller reserved in the dynamic part of
# its own frame (get_cpu_topology, get_efficiency_cores, get_performance_cores, get_core_capabilities,
# which_children, get_child_info) and that caller returns with rsp at the area's bottom, so the emitted
# call site adopts the value into the calling frame (prims_actors@runtime_call_asm, prims_memory
# L_adopt); nothing comes from a heap. A request past the floor is a sizing bug of the caller and aborts
# the process (status 71) rather than overrun a frame. Leaf: rsi, r10, r11 and the flags only.
	.globl	silica_rt_dest_take
	.p2align	2
silica_rt_dest_take:
	add	rsi, 7
	and	rsi, -8
	mov	r10, QWORD PTR [rdi]
	sub	r10, rsi
	cmp	r10, QWORD PTR [rdi + 8]
	jb	Ldtk_overrun
	mov	QWORD PTR [rdi], r10
	mov	r11, r10
Ldtk_zero:
	test	rsi, rsi
	jz	Ldtk_done
	mov	QWORD PTR [r11], 0
	add	r11, 8
	sub	rsi, 8
	jmp	Ldtk_zero
Ldtk_done:
	mov	rdi, r10
	ret
Ldtk_overrun:
	jmp	silica_rt_abort_dest_take
	.p2align	2
# -- Begin function silica_rt_build_int_range_list
silica_rt_build_int_range_list:
# rdi = start, rsi = count, rdx = the destination pair (silica_rt_dest_take) -> rdi = the
# List[int64, mem(normal)] [start .. start + count - 1], or 0 (nil) when count <= 0. The layout is the
# one the compiled list prims read (prims_list.silica): a 24-byte handle {length, first chunk, cursor}
# over 32-byte chunks {two int64 slots filled back to front, next chunk at +16, claim at +24}. The
# elements go in from the last to the first, so every chunk after the first is full (cursor 0) as
# L_list_tail_helper expects when it steps to a successor, and the first chunk's claim equals its
# cursor so a later prepend takes its free slot in place. Chunk 15 stage 4e: the handle and the chunks
# come from the caller's destination area (24 + 32 * ((count + 1) / 2) bytes), never from a heap.
# Earlier this built 16-byte cons cells {value, next}: read as a handle, the first value was the
# length and the next cell the chunk, which is what cpu_topology_runtime_queries faulted on.
# frame: [rbp-8] start (X19), [rbp-16] remaining (X20), [rbp-24] chunk (X21), [rbp-32] cursor (X22),
#        [rbp-40] value (X23), [rbp-48] count (X24), [rbp-56] the destination pair (X25)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 48], rsi
	mov	QWORD PTR [rbp - 56], rdx
	mov	QWORD PTR [rbp - 24], 0
	mov	QWORD PTR [rbp - 32], 0
	test	rsi, rsi
	jle	LBBrl_nil
	lea	rax, [rdi + rsi]
	mov	QWORD PTR [rbp - 40], rax
LBBrl_loop:
	cmp	QWORD PTR [rbp - 16], 0
	je	LBBrl_handle
	sub	QWORD PTR [rbp - 40], 1
	cmp	QWORD PTR [rbp - 32], 0
	jne	LBBrl_store
	mov	rdi, QWORD PTR [rbp - 56]
	mov	esi, 32
	call	silica_rt_dest_take
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rdi + 16], rax
	mov	QWORD PTR [rdi + 24], 0
	mov	QWORD PTR [rbp - 24], rdi
	mov	QWORD PTR [rbp - 32], 16
LBBrl_store:
	mov	rcx, QWORD PTR [rbp - 32]
	sub	rcx, 8
	mov	QWORD PTR [rbp - 32], rcx
	mov	rax, QWORD PTR [rbp - 24]
	mov	rdx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + rcx], rdx
	sub	QWORD PTR [rbp - 16], 1
	jmp	LBBrl_loop
LBBrl_handle:
	mov	rax, QWORD PTR [rbp - 24]
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 24], rcx
	mov	rdi, QWORD PTR [rbp - 56]
	mov	esi, 24
	call	silica_rt_dest_take
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rdi], rax
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rdi + 8], rax
	mov	rax, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rdi + 16], rax
	leave
	ret
LBBrl_nil:
	xor	edi, edi
	leave
	ret
# -- End function
	.p2align	2
# -- Begin function silica_rt_build_list_from_words
silica_rt_build_list_from_words:
# rdi = array of one-word elements (element i at [rdi + 8 i]), rsi = count, rdx = the destination
# pair -> rdi = the List[T, mem(normal)] holding those words in array order, or 0 (nil) when count <= 0.
# The handle and chunk layout and the back-to-front fill are those of silica_rt_build_int_range_list
# above (24 + 32 * ((count + 1) / 2) bytes of the destination); the word is what the element type keeps
# in a chunk slot (prims_list chunk_elem_slot_bytes): a pointer to a boxed record for every record the
# runtime does not splice inline, a string header pointer, an int64. get_cpu_topology builds cores,
# numa_nodes, memory_ranges and cache_hierarchy.levels through it, and
# silica_rt_apple_hw_optional_caps_list the capabilities strings.
# frame: [rbp-8] array (X19), [rbp-16] remaining (X20), [rbp-24] chunk (X21), [rbp-32] cursor (X22),
#        [rbp-40] value (X23), [rbp-48] count (X24), [rbp-56] the destination pair (X25)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 48], rsi
	mov	QWORD PTR [rbp - 56], rdx
	mov	QWORD PTR [rbp - 24], 0
	mov	QWORD PTR [rbp - 32], 0
	test	rsi, rsi
	jle	LBBlw_nil
LBBlw_loop:
	mov	rcx, QWORD PTR [rbp - 16]
	test	rcx, rcx
	jz	LBBlw_handle
	sub	rcx, 1
	mov	QWORD PTR [rbp - 16], rcx
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + rcx*8]
	mov	QWORD PTR [rbp - 40], rax
	cmp	QWORD PTR [rbp - 32], 0
	jne	LBBlw_store
	mov	rdi, QWORD PTR [rbp - 56]
	mov	esi, 32
	call	silica_rt_dest_take
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rdi + 16], rax
	mov	QWORD PTR [rdi + 24], 0
	mov	QWORD PTR [rbp - 24], rdi
	mov	QWORD PTR [rbp - 32], 16
LBBlw_store:
	mov	rcx, QWORD PTR [rbp - 32]
	sub	rcx, 8
	mov	QWORD PTR [rbp - 32], rcx
	mov	rax, QWORD PTR [rbp - 24]
	mov	rdx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + rcx], rdx
	jmp	LBBlw_loop
LBBlw_handle:
	mov	rax, QWORD PTR [rbp - 24]
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 24], rcx
	mov	rdi, QWORD PTR [rbp - 56]
	mov	esi, 24
	call	silica_rt_dest_take
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rdi], rax
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rdi + 8], rax
	mov	rax, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rdi + 16], rax
	leave
	ret
LBBlw_nil:
	xor	edi, edi
	leave
	ret
# -- End function
# rdi = sysctl name cstring. Returns edi = int32 value, or -1 on failure.
	.p2align	2
silica_rt_sysctl_i32:
# frame: [rbp-8] name (X19); [rsp] value, [rsp+8] length (the AArch64 [sp], [sp, #8])
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_si32_fail
	mov	edi, DWORD PTR [rsp]
	leave
	ret
L_si32_fail:
	mov	edi, -1
	leave
	ret
# rdi = C string pointer, rsi = the destination pair -> rdi = a Silica string over those bytes: the
# 24-byte header {-1, bytes, byte length} every emitted string literal and string helper reads
# (string_literal_pool emits `.quad -1`, the data label, the length), taken from the caller's
# destination area (chunk 15 stage 4e; silica_rt_dest_take). The bytes stay where they are (rodata
# here). Replaces silica_rt_cons_cstr_list, which consed bare C-string pointers into 16-byte cells that
# no compiled list or string code could read.
	.p2align	2
silica_rt_cstr_to_string:
# frame: [rbp-8] cstring (X19), [rbp-16] length (X20), [rbp-24] the destination pair (X21)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 24], rsi
	xor	eax, eax
L_c2s_len:
	cmp	BYTE PTR [rdi + rax], 0
	je	L_c2s_alloc
	add	rax, 1
	jmp	L_c2s_len
L_c2s_alloc:
	mov	QWORD PTR [rbp - 16], rax
	mov	rdi, QWORD PTR [rbp - 24]
	mov	esi, 24
	call	silica_rt_dest_take
	mov	QWORD PTR [rdi], -1
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rdi + 8], rax
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rdi + 16], rax
	leave
	ret
# Machine-wide sysctl hw.optional.* flags -> List[string, mem(normal)] of their names (see
# cpu_topology_implementation_plan): each present flag's name becomes a string header
# (silica_rt_cstr_to_string) in the 8-word frame array at [rbp-144 .. rbp-80) (the AArch64
# [x29, #64]), and the list is built over the array in detection order. Shared by every core_info.
# rdi = the destination pair the strings and the list are taken from (chunk 15 stage 4e; 344 bytes at
# most).
	.globl	silica_rt_apple_hw_optional_caps_list
	.p2align	2
silica_rt_apple_hw_optional_caps_list:
# frame: [rbp-8] entry count (X19), [rbp-16] the destination pair (X20); [rbp-144 + 8 i] entry i
	push	rbp
	mov	rbp, rsp
	sub	rsp, 160
	mov	QWORD PTR [rbp - 8], 0
	mov	QWORD PTR [rbp - 16], rdi
	lea	rdi, [rip + L_sc_opt_neon]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_1
	lea	rdi, [rip + L_tok_opt_neon]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_cstr_to_string
	test	rdi, rdi
	jz	L_iho_1
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp + rax*8 - 144], rdi
	add	QWORD PTR [rbp - 8], 1
L_iho_1:
	lea	rdi, [rip + L_sc_opt_armv8crc]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_2
	lea	rdi, [rip + L_tok_opt_armv8crc]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_cstr_to_string
	test	rdi, rdi
	jz	L_iho_2
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp + rax*8 - 144], rdi
	add	QWORD PTR [rbp - 8], 1
L_iho_2:
	lea	rdi, [rip + L_sc_opt_arm64]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_3
	lea	rdi, [rip + L_tok_opt_arm64]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_cstr_to_string
	test	rdi, rdi
	jz	L_iho_3
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp + rax*8 - 144], rdi
	add	QWORD PTR [rbp - 8], 1
L_iho_3:
	lea	rdi, [rip + L_sc_opt_lse]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_4
	lea	rdi, [rip + L_tok_opt_lse]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_cstr_to_string
	test	rdi, rdi
	jz	L_iho_4
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp + rax*8 - 144], rdi
	add	QWORD PTR [rbp - 8], 1
L_iho_4:
	lea	rdi, [rip + L_sc_opt_sha512]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_5
	lea	rdi, [rip + L_tok_opt_sha512]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_cstr_to_string
	test	rdi, rdi
	jz	L_iho_5
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp + rax*8 - 144], rdi
	add	QWORD PTR [rbp - 8], 1
L_iho_5:
	lea	rdi, [rip + L_sc_opt_sha256]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_6
	lea	rdi, [rip + L_tok_opt_sha256]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_cstr_to_string
	test	rdi, rdi
	jz	L_iho_6
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp + rax*8 - 144], rdi
	add	QWORD PTR [rbp - 8], 1
L_iho_6:
	lea	rdi, [rip + L_sc_opt_aes]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_7
	lea	rdi, [rip + L_tok_opt_aes]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_cstr_to_string
	test	rdi, rdi
	jz	L_iho_7
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp + rax*8 - 144], rdi
	add	QWORD PTR [rbp - 8], 1
L_iho_7:
	lea	rdi, [rip + L_sc_opt_advsimd]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_done
	lea	rdi, [rip + L_tok_opt_advsimd]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_cstr_to_string
	test	rdi, rdi
	jz	L_iho_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp + rax*8 - 144], rdi
	add	QWORD PTR [rbp - 8], 1
L_iho_done:
	lea	rdi, [rbp - 144]
	mov	rsi, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rbp - 16]
	call	silica_rt_build_list_from_words
	leave
	ret
# rdi = sysctl name cstring. Returns rdi = uint64 (0 on failure).
	.p2align	2
silica_rt_sysctl_u64:
# frame: [rbp-8] name (X19); [rsp] value, [rsp+8] length (the AArch64 [sp], [sp, #8])
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
# The value and length words are zeroed first and the length (8) stored after them: before
# 2026-10-19 the zeroing followed the length store and wiped it, so the query saw a length of 0
# and every caller got 0 (hw.memsize for get_cpu_topology among them). Same fix as apple_silicon_mac.
	mov	QWORD PTR [rsp], 0
	mov	QWORD PTR [rsp + 8], 0
	mov	DWORD PTR [rsp + 8], 8
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_s64_fail
	mov	rdi, QWORD PTR [rsp]
	leave
	ret
L_s64_fail:
	xor	edi, edi
	leave
	ret
# Apple Silicon cache_info.levels: sysctl exposes per-cluster L1D/L2 (hw.perflevel0/1.*), aggregate hw.l1d/l2/l3,
# hw.cachelinesize, hw.nperflevels. Not exposed in sysctl: SLC/unified last-level cache as a stable L3; associativity
# (we store 0). rdi=P, rsi=E, rdx=total, rcx=all-core-ids list, r8 = the destination pair (kept at
# [rbp-88]; chunk 15 stage 4e: every list and record here is taken from it). Returns rdi = the boxed
# cache_info record { levels: List[cache level] } (levels nil when none is known).
	.globl	silica_rt_apple_build_cache_levels
	.p2align	2
silica_rt_apple_build_cache_levels:
# frame: [rbp-8] P (X19), [rbp-16] E (X20), [rbp-24] total (X21), [rbp-32] entry count (X22), [rbp-40] line (X23),
# [rbp-48] P ids (X24), [rbp-56] E ids (X25), [rbp-64] all ids (X26), [rbp-72] nperflevels (X27),
# [rbp-80] all-core-ids arg (X28), [rbp-88] the destination pair; [rbp-160 .. rbp-96) the 8-word entry
# array (the AArch64 [x29, #96]),
# filled from the top by L_bc_push: entry c goes to [rbp - 104 - 8 c]; [rsp] sysctl value, [rsp+8] sysctl length
	push	rbp
	mov	rbp, rsp
	sub	rsp, 176
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	QWORD PTR [rbp - 80], rcx
	mov	QWORD PTR [rbp - 88], r8
	mov	QWORD PTR [rbp - 32], 0
	lea	rdi, [rip + L_hw_cachelinesize_str]
	call	silica_rt_sysctl_u64
	mov	QWORD PTR [rbp - 40], rdi
	xor	edi, edi
	mov	esi, DWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rbp - 88]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 48], rdi
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_no_epl
	mov	edi, DWORD PTR [rbp - 8]
	mov	esi, DWORD PTR [rbp - 16]
	mov	rdx, QWORD PTR [rbp - 88]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 56], rdi
	jmp	L_bc_have_epl
L_bc_no_epl:
	mov	QWORD PTR [rbp - 56], 0
L_bc_have_epl:
	xor	edi, edi
	mov	esi, DWORD PTR [rbp - 24]
	mov	rdx, QWORD PTR [rbp - 88]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 64], rdi
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_nperflevels_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_bc_nperf_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 72], rax
	cmp	eax, 2
	jae	L_bc_dual
	jmp	L_bc_agg
L_bc_nperf_fail:
L_bc_agg:
	lea	rdi, [rip + L_hw_l3cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_a_skip_l3
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_a_skip_l3
	mov	esi, 3
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 104]
	mov	r14, QWORD PTR [rbp - 88]
	call	L_bc_push
	add	QWORD PTR [rbp - 32], rdi
L_bc_a_skip_l3:
	lea	rdi, [rip + L_hw_l2cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_a_skip_l2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_a_skip_l2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 104]
	mov	r14, QWORD PTR [rbp - 88]
	call	L_bc_push
	add	QWORD PTR [rbp - 32], rdi
L_bc_a_skip_l2:
	lea	rdi, [rip + L_hw_l1dcachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_done
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_done
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 104]
	mov	r14, QWORD PTR [rbp - 88]
	call	L_bc_push
	add	QWORD PTR [rbp - 32], rdi
	jmp	L_bc_done
L_bc_dual:
	lea	rdi, [rip + L_hw_l3cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_l3
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_l3
	mov	esi, 3
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 104]
	mov	r14, QWORD PTR [rbp - 88]
	call	L_bc_push
	add	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_l3:
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_d_skip_el2
	lea	rdi, [rip + L_hw_pl1_l2_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_el2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_el2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 56]
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 104]
	mov	r14, QWORD PTR [rbp - 88]
	call	L_bc_push
	add	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_el2:
	cmp	DWORD PTR [rbp - 8], 0
	je	L_bc_d_skip_pl2
	lea	rdi, [rip + L_hw_pl0_l2_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_pl2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_pl2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 48]
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 104]
	mov	r14, QWORD PTR [rbp - 88]
	call	L_bc_push
	add	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_pl2:
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_d_skip_el1
	lea	rdi, [rip + L_hw_pl1_l1d_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_el1
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_el1
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 56]
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 104]
	mov	r14, QWORD PTR [rbp - 88]
	call	L_bc_push
	add	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_el1:
	cmp	DWORD PTR [rbp - 8], 0
	je	L_bc_done
	lea	rdi, [rip + L_hw_pl0_l1d_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_done
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_done
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 48]
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 104]
	mov	r14, QWORD PTR [rbp - 88]
	call	L_bc_push
	add	QWORD PTR [rbp - 32], rdi
L_bc_done:
# levels: the [rbp-32] entries sit at the top of the entry array (L_bc_push fills it from the
# top), so the list over [rbp - 96 - 8 count, count) runs L1 .. L3 as the cons spine this replaced
# did; [rbp-32] becomes the list handle (0 when there are no levels).
	mov	rax, QWORD PTR [rbp - 32]
	neg	rax
	lea	rdi, [rbp + rax*8 - 96]
	mov	rsi, QWORD PTR [rbp - 32]
	mov	rdx, QWORD PTR [rbp - 88]
	call	silica_rt_build_list_from_words
	mov	QWORD PTR [rbp - 32], rdi
	mov	rdi, QWORD PTR [rbp - 88]
	mov	esi, 16
	call	silica_rt_dest_take
	mov	rax, rdi
	mov	rdi, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax], 65541
	mov	QWORD PTR [rax + 8], rdi
	mov	rdi, rax
	leave
	ret
# rdi = the caller's array slot for this entry, rsi=level rdx=size_kb rcx=line r8=assoc r9=shared,
# r14 (X6) = the destination pair -> rdi = 1: the boxed cache-level record (48 bytes: shape word + 5
# fields) is built in the destination (chunk 15 stage 4e) and its pointer stored in the slot (the caller
# adds rdi to its entry count).
L_bc_push:
# frame: [rbp-8] slot (X19), [rbp-16] level (X20), [rbp-24] size_kb (X21), [rbp-32] line, [rbp-40] assoc,
# [rbp-48] shared
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	QWORD PTR [rbp - 32], rcx
	mov	QWORD PTR [rbp - 40], r8
	mov	QWORD PTR [rbp - 48], r9
	mov	rdi, r14
	mov	esi, 48
	call	silica_rt_dest_take
	mov	rax, rdi
	mov	QWORD PTR [rax], 65542
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 8], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 16], rcx
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 24], rcx
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 32], rcx
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 40], rcx
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx], rax
	mov	edi, 1
	leave
	ret
	.bss
	.p2align	3
# One process-wide word: L_region_grow (prims_memory, emitted per module) serialized region growth on it.
# It lived in canonical_arena_runtime_asm until chunk 15 stage 5d removed that module.
	.globl	silica_rt_region_lock
silica_rt_region_lock:
	.zero	8
silica_actor_pthread_key:
	.zero	8
silica_actor_tls_init_lock:
	.zero	4
silica_actor_tls_key_ready:
	.zero	1
	.text
	.globl	silica_rt_ensure_actor_tls_key
	.p2align	2
silica_rt_ensure_actor_tls_key:
# frame: [rbp-16] address of silica_actor_tls_key_ready (X20)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	lea	rax, [rip + silica_actor_tls_key_ready]
	mov	QWORD PTR [rbp - 16], rax
	movzx	eax, BYTE PTR [rax]
	test	eax, eax
	jnz	L_tlse_done
	lea	rdi, [rip + silica_actor_tls_init_lock]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 16]
	movzx	eax, BYTE PTR [rax]
	test	eax, eax
	jnz	L_tlse_unlock
	lea	rdi, [rip + silica_actor_pthread_key]
	xor	esi, esi
	call	pthread_key_create
	test	eax, eax
	jnz	L_tlse_unlock
	mov	rax, QWORD PTR [rbp - 16]
	mov	BYTE PTR [rax], 1
L_tlse_unlock:
	lea	rdi, [rip + silica_actor_tls_init_lock]
	call	silica_rt_lock_unlock
L_tlse_done:
	leave
	ret
	.globl	silica_rt_tls_current_actor_get
	.p2align	2
silica_rt_tls_current_actor_get:
# -> rdi = this thread's current actor: the first word of the thread's record (the pthread key names
# it; silica_rt_tls_record_set), 0 on a thread with no record (main before any drain) or whose
# record holds none (a carrier between actors).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_ensure_actor_tls_key
	lea	rax, [rip + silica_actor_pthread_key]
	mov	rdi, QWORD PTR [rax]
	call	pthread_getspecific
	xor	edi, edi
	test	rax, rax
	jz	L_tcag_ret
	mov	rdi, QWORD PTR [rax]
L_tcag_ret:
	leave
	ret
	.globl	silica_rt_tls_actor_set_from_x19
	.p2align	2
silica_rt_tls_actor_set_from_x19:
# rdi = the ACB to install as this thread's current actor (the caller's X19 value, moved into rdi
# by the caller). The record's first word (prims_actors_carrier_asm.silica).
	jmp	silica_rt_tls_actor_set
	.section .rodata
	.p2align	2
L_silica_root_actor_exit:
	.asciz	"[silica] root actor exited (no supervisor)\n"
	.text
# The root-exit note. Written under silica_rt_root_note_lock; the exit drain
# (silica_rt_report_drain_at_exit) takes that lock last and keeps it, so the process never ends
# while a note is half written (a torn "[s" glued to the next output through a PTY).
	.globl	silica_rt_root_note_write
	.p2align	2
silica_rt_root_note_write:
	push	rbp
	mov	rbp, rsp
	lea	rdi, [rip + silica_rt_root_note_lock]
	call	silica_rt_lock_lock
	mov	edi, 2
	lea	rsi, [rip + L_silica_root_actor_exit]
	mov	edx, 43
	call	write
	lea	rdi, [rip + silica_rt_root_note_lock]
	call	silica_rt_lock_unlock
	pop	rbp
	ret
# X0 (rdi) out: 1 when a FailureReporter is registered and the note has been written now, 0 when
# the caller writes it after the report as before. With a reporter the report is printed on the
# reporter's thread, which may call cast_exit on it, so the note must be out before the report is
# queued; without one the report is written synchronously and the note follows it.
	.globl	silica_rt_root_note_early
	.p2align	2
silica_rt_root_note_early:
	push	rbp
	mov	rbp, rsp
	xor	edi, edi
	cmp	QWORD PTR [rip + silica_rt_root_failure_reporter], 0
	je	Lrne_ret
	call	silica_rt_root_note_write
	mov	edi, 1
Lrne_ret:
	pop	rbp
	ret
# X0 (rdi) = a root actor's (or root supervisor's) control block: its failure report and the root
# note, in the order silica_rt_root_note_early gives.
	.globl	silica_rt_root_report_and_note
	.p2align	2
silica_rt_root_report_and_note:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	lock inc	QWORD PTR [rip + silica_rt_report_inflight]
	call	silica_rt_root_note_early
	mov	QWORD PTR [rbp - 16], rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_deliver_unwind_report
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lrrn_ret
	call	silica_rt_root_note_write
Lrrn_ret:
	leave
	ret
	.bss
	.p2align	2
.globl	silica_rt_root_note_lock
.comm	silica_rt_root_note_lock,4,4
	.text
	.globl	silica_rt_migrate_actor
	.p2align	2
# -- Begin function silica_rt_migrate_actor
silica_rt_migrate_actor:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_migrate_actor_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_migrate_actor_acb:
# rdi = ACB (held) or 0, rsi = target core -> rdi = 0 (:ok: the move is requested, and done at the
# actor's next dispatch boundary, at once when it is idle), 1 (:invalid_target: no logical core of
# that id on this machine, silica_rt_logical_cpu_count, the count get_cpu_topology reports),
# 2 (:actor_not_found: a null reference, or an actor that has ended); the emitter maps the code to
# the program's atom (prims_actors emit_prim_op_with_atoms). 3 (:migration_blocked) only when the
# target carrier has no thread yet and the host refuses one (dangerous actors may hold every
# thread it allows; item N #5): nothing else blocks a move. A carrier actor (#144 = 0, item N stage 3) is
# moved to the carrier of the core, `core mod N` as at spawn (silica_rt_carrier_migrate, which
# says what happens per status). A dangerous actor (a thread of its own, #144) gets the thread's
# affinity hint, as every actor did before carriers; the OS may still share or move the thread
# (spec §22.10), so the hint's own result is not reported.
	test	rdi, rdi
	jz	Lmig_not_found
	cmp	DWORD PTR [rdi + 152], 0
	je	Lmig_not_found
	cmp	rsi, QWORD PTR [rip + silica_rt_logical_cpu_count]
	jae	Lmig_invalid
	cmp	QWORD PTR [rdi + 144], 0
	je	Lmig_carrier
# frame: [rbp-8] target core (X19), [rbp-16] thread (X20); [rsp] the 4-byte policy tag
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rsi
	mov	rdi, QWORD PTR [rdi + 144]
	call	silica_rt_pthread_mach_thread_np
	mov	QWORD PTR [rbp - 16], rdi
	mov	eax, DWORD PTR [rbp - 8]
	mov	DWORD PTR [rsp], eax
	mov	rdi, QWORD PTR [rbp - 16]
	mov	esi, 4
	mov	rdx, rsp
	mov	ecx, 1
	call	silica_rt_thread_policy_set
	xor	edi, edi
	leave
	ret
Lmig_carrier:
# frame: [rbp-8] ACB (X19)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	rdi, rsi
	call	silica_rt_carrier_for_core
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_carrier_migrate
	leave
	ret
Lmig_invalid:
	mov	edi, 1
	ret
Lmig_not_found:
	mov	edi, 2
	ret
# -- End function
	.text
# get_actor_memory_usage lives in prims_actors_stack_asm.silica (four-field record).
# The implicit heap (silica_rt_region_alloc, silica_rt_region_alloc_in, silica_rt_actor_init_region,
# silica_rt_actor_dealloc_region, silica_rt_region_destroy, the mark/release_to pair, ACB #160..#184 and
# silica_rt_heap_in_use) lived here until chunk 15 stage 4e (design §9.1).
# --- Chunk 15 phases 3-6, the Linux x86-64 port (2026-11-02): the state policy, compact_state, retire and
# the dispatch end (chunk15_stack_memory_design.md §2.2, §4.2, §4.6, §4.7; the Mac reference is
# apple_silicon_mac prims_actors_state_asm / prims_actors_runtime_asm). ACB words: #528 the state edge,
# #536/#544/#552 the release log base, count and capacity, #560 release enabled (the behaviour
# prefix's proof bit, silica_rt_beh_proven_store), #568 state bytes live, #576 the state policy
# (silica_rt_actor_stack_reserve), #584 compaction requested. The state area itself, retire, the
# release log and the dispatch end are in prims_actors_state_asm.silica (the 2026-11-03 port).
	.globl	silica_rt_state_area_bytes
	.p2align	4
silica_rt_state_area_bytes:
# state_area_bytes() -> rdi = ACB #568, the bytes of live nodes in the calling actor's state area;
# 0 outside an actor (main).
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lsab_done
	mov	rdi, QWORD PTR [rdi + 568]
Lsab_done:
	pop	rbp
	ret
	.globl	silica_rt_compact_state
	.p2align	4
silica_rt_compact_state:
# compact_state() (decision 40, P15; design §4.7): under :compact_on_request (ACB #576 = 2) it sets the
# compaction request (#584 = 1), which the dispatch end reads and clears; under :keep_state_area and
# :shrink_after_compaction, and outside an actor (main), it does nothing. -> rdi = 0 (unit).
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lcst_done
	cmp	QWORD PTR [rdi + 576], 2
	jne	Lcst_done
	mov	QWORD PTR [rdi + 584], 1
Lcst_done:
	xor	edi, edi
	pop	rbp
	ret
	.globl	silica_rt_raw_alloc
silica_rt_raw_alloc:
# rdi=size. malloc with a [next][size] header, NOT linked into the global region
# list. Region memory must be freeable by its owner; anything on that list can
# only be freed by unwinding to a mark, which is scope-shaped and unsound here.
# frame: [rbp-8] size (X19)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	add	rdi, 16
	call	malloc
	test	rax, rax
	jz	LBBrw_oom
	mov	QWORD PTR [rax], 0
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 8], rcx
	add	rax, 16
LBBrw_oom:
	mov	rdi, rax
	leave
	ret
# -- End function
	.globl	silica_rt_actor_supervision_ingress_enqueue
	.p2align	2
# Phase B: synthetic exit / trial hook; bounded queue
silica_rt_actor_supervision_ingress_enqueue:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_actor_supervision_ingress_enqueue_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_actor_supervision_ingress_enqueue_acb:
# rdi=target actor_ref, rsi=int64 payload -> rdi=:ok (0). Cast-shaped 152 B node; +8 = inline int64; +24 = 1 (trial; not heap payload).
# frame: [rbp-8] actor (X19), [rbp-16] node (X20), [rbp-24] payload (X21)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 24], rsi
	test	rdi, rdi
	jz	Lsie_fail_nolock
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sb_require
	mov	r10d, DWORD PTR [rdi + 16]
	cmp	r10d, 1024
	jae	Lsie_abort
	mov	edi, 1
	mov	esi, 152
	call	calloc
	test	rax, rax
	jz	Lsie_unlock_fail
	mov	QWORD PTR [rbp - 16], rax
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 8], rcx
	mov	DWORD PTR [rax + 16], 0
	mov	DWORD PTR [rax + 24], 1
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rdi + 216]
	mov	rsi, rax
	call	silica_rt_q_enqueue_locked
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 216]
	mov	r10d, DWORD PTR [rcx + 16]
	add	r10d, 1
	mov	DWORD PTR [rcx + 16], r10d
	mov	rdi, rax
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	xor	edi, edi
	leave
	ret
Lsie_unlock_fail:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Lsie_fail_nolock:
	xor	edi, edi
	leave
	ret
Lsie_abort:
	call	silica_rt_abort_ingress_full
# -- End function
	.globl	silica_rt_sb_require
	.p2align	2
silica_rt_sb_require:
# rdi = ACB -> rdi = its supervision block (SB, 144 B: +0/+8 ingress front/rear, +16 depth u32,
# +24 child-table head, +32 len, +40 sync_failure_reported, +48 start trampoline, +56 strategy,
# +64 allowed restarts, +72 time frame, +80 restart count, +88 window start, +96/+104 unused,
# +112 references: sb_unref, +120 the holder of the restart token (0 free; the protocol in
# prims_actors_child_table_asm.silica's header), +128 the carrier actors parked for the token,
# +136 unused), made now when the
# actor had none: by spawn for an actor with a trampoline, by the ingress enqueue for any other
# actor that receives an exit notice (an add_child parent; the caller holds the target's lock),
# by the child-table paths for the running actor. Freed by its last reference (sb_unref).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	rdi, QWORD PTR [rdi + 216]
	test	rdi, rdi
	jnz	Lsbr_have
	mov	edi, 1
	mov	esi, 144
	call	calloc
	mov	rdi, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rdi + 216], rax
	mov	rdi, rax
	mov	QWORD PTR [rdi + 112], 1
Lsbr_have:
	leave
	ret
	.globl	silica_rt_actor_recv
	.p2align	2
# Phase B/C/G: ingress then standard; spec 15.4.8.6 DOWN only on standard
silica_rt_actor_recv:
# TLS current actor: dequeue next message (supervision ingress first, then standard mailbox). Return rdi = message node or 0.
# frame: [rbp-8] actor (X19), [rbp-16] node (X20)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	Lrecv_done_null
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rdi + 216]
	mov	QWORD PTR [rbp - 16], 0
	test	rdi, rdi
	jz	Lrecv_try_std
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	Lrecv_try_std
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r10d, DWORD PTR [rax + 16]
	sub	r10d, 1
	mov	DWORD PTR [rax + 16], r10d
# An exit notice handed to the program keeps no hold on the ended actor.
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 16]
	cmp	DWORD PTR [rax + 24], 0
	jne	Lrecv_ret_node
	mov	rax, QWORD PTR [rax + 8]
	test	rax, rax
	jz	Lrecv_ret_node
	mov	rdi, QWORD PTR [rax]
	call	silica_rt_acb_release
	jmp	Lrecv_ret_node
Lrecv_try_std:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 128
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
Lrecv_unlock_node:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Lrecv_ret_node:
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
Lrecv_done_null:
	xor	edi, edi
	leave
	ret
# -- End function
	.globl	silica_rt_actor_add_child
	.p2align	2
# Explicit supervisor child registration
silica_rt_actor_add_child:
# rdi = parent reference, rsi = child reference: both held for the body.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 24], rsi
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 8], rdi
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 16], rdi
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_add_child_acb
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_acb_release
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_acb_release
	xor	edi, edi
	leave
	ret
	.p2align	2
silica_rt_actor_add_child_acb:
# rdi=parent supervisor ACB, rsi=child ACB (either may be 0) -> rdi=atom :ok.
# Records the explicit parent/child relationship used by supervisor ingress teardown.
# frame: [rbp-8] parent (X19), [rbp-16] child (X20)
	test	rdi, rdi
	jz	Ladd_child_done
	test	rsi, rsi
	jz	Ladd_child_done
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	cmp	QWORD PTR [rsi + 192], rdi
	je	Ladd_child_held
# The child holds its supervisor until its exit path is done with it (silica_rt_actor_final_release).
	lock add	QWORD PTR [rdi + 392], 1
	mov	rax, rdi
	xchg	QWORD PTR [rsi + 192], rax
	mov	rdi, rax
	call	silica_rt_acb_release
Ladd_child_held:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	lea	rdi, [rax + 16]
	call	silica_rt_lock_unlock
	leave
Ladd_child_done:
	xor	edi, edi
	ret
# -- End function
	.globl	silica_rt_actor_link
	.p2align	2
# Phase G: spec 15.4.8.4-8.5
silica_rt_actor_link:
# rdi=target actor_ref -> rdi=0; the emitter answers :ok (prims_actors emit_prim_op_with_atoms). Idempotent link; dead target must enqueue exit (ingress if supervisor) -- stub.
	xor	edi, edi
	ret
# -- End function
	.globl	silica_rt_actor_monitor
	.p2align	2
# Phase G: spec 15.4.8.6
silica_rt_actor_monitor:
# rdi=target -> rdi=monitor_ref. Real runtime: DOWN (:down, ref, target, reason) to standard mailbox only, not ingress.
	ret
# -- End function
	.globl	silica_rt_actor_demonitor
	.p2align	2
# Phase G: spec 15.4.8.6-8.7
silica_rt_actor_demonitor:
# rdi=monitor_ref -> rdi=0; the emitter answers :ok
	xor	edi, edi
	ret
# -- End function
	.text
	.globl	silica_rt_cv_signal
	.p2align	2
# X0 = cv_addr (4-byte futex word). Caller must hold the lock paired with this CV.
silica_rt_cv_signal:
	push	rbp
	mov	rbp, rsp
# bump seq (32-bit; wraparound after 4G signals is fine -- only mismatch w/ waiter snapshot matters)
	mov	eax, DWORD PTR [rdi]
	add	eax, 1
	mov	DWORD PTR [rdi], eax
# silica_rt_futex_wake(3, cv_addr, 0)
	mov	rsi, rdi
	mov	edi, 3
	xor	edx, edx
	call	silica_rt_futex_wake
	leave
	ret
	.globl	silica_rt_cv_wait
	.p2align	2
# X0 = cv_addr, X1 = lock_addr. Caller must hold lock; lock held on return.
silica_rt_cv_wait:
# slots: [rbp-8] = x19 cv_addr, [rbp-16] = x20 lock_addr, [rbp-24] = w22 seq snapshot (zero-extended)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
# snapshot seq (under lock)
	mov	eax, DWORD PTR [rdi]
	mov	QWORD PTR [rbp - 24], rax
# release lock
	mov	rdi, rsi
	call	silica_rt_lock_unlock
# silica_rt_futex_wait(3, cv_addr, snapshot, 0 = no timeout)
	mov	edi, 3
	mov	rsi, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rbp - 24]
	xor	ecx, ecx
	call	silica_rt_futex_wait
# re-acquire lock
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_lock_lock
	leave
	ret
	.text
# --- Phase E e3a Option B: linked-list child table ---
# silica_rt_child_table_free: X0=ACB* — walk nodes (+80 next), free each, clear anchors.
# silica_rt_child_table_ensure_min_cap: X0=ACB*, X1=min node count — X0=0 ok, 1 OOM. Appends 160 B nodes (80 B row + links + the state policy, descriptor and spec buffer words) until count >= X1.
	.globl	silica_rt_child_table_free
	.p2align	2
silica_rt_child_table_free:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	r8, QWORD PTR [rdi + 216]
	test	r8, r8
	jz	Lct_free_none
	call	silica_rt_sup_shutdown_children
# An actor parked for this supervisor's restart token (block +128) re-checks and finds it ended.
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 216]
	add	rdi, 128
	call	silica_rt_wait_list_wake
# The rows and the block outlive this actor while a linked child still holds a reference: the
# child's last act is its row's exit_done store (sb_child_done), after its own teardown. This
# actor's teardown drops its reference; the last one frees the rows and the block (sb_unref).
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 216]
	mov	QWORD PTR [rax + 216], 0
	call	silica_rt_sb_unref
Lct_free_none:
	leave
	ret
# silica_rt_sup_shutdown_children(rdi = a supervisor that has ended: alive (+152) is 0): the
# coordinated shutdown of its live children (spec §15.4.8.4, §15.4.12.2), last row first, one at a
# time. Each row is tombstoned before its child is told (maybe_restart no longer finds it, and a
# child waiting for its replacement stops waiting); a child with shutdown 0 is killed (reason tag 1,
# as kill_abnormal), one with shutdown > 0 ends with (:explicit, :shutdown). On the hosts a child
# ends at its next dispatch boundary in both cases: a dispatch in progress runs to completion, and
# the shutdown time is not enforced. The wait is for the row's exit_done, the child's last act, so
# its registered name (§20.3.1) is gone before this returns and a restarted supervisor can register
# its children again. It runs only as the supervisor's own dispatch, on the supervisor's own stack
# (its exit path: deliver_exit, and again, idempotent, child_table_free; maybe_restart's
# synchronous root report, silica_rt_sup_on_own_dispatch), where the wait for each child parks
# the supervisor and its carrier runs on (a child bound to the same carrier can only end that
# way): a wait on another actor's stack could wait on that actor itself. A row holding the
# running actor itself is skipped all the same. The block
# is held (+112) for the walk, so the rows outlive a concurrent teardown of the supervisor.
# Frame: [rbp-8] supervisor, [rbp-16] block, [rbp-24] running actor, [rbp-32] rows left,
# [rbp-40] row, [rbp-48] the child, held, [rbp-56] its identity (x25), [rbp-64] 1 when it is a
# carrier actor (x26).
	.globl	silica_rt_sup_shutdown_children
	.p2align	4
silica_rt_sup_shutdown_children:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 216]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jz	Lssc_ret
	lock add	QWORD PTR [rax + 112], 1
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 24], rdi
	xor	ecx, ecx
	mov	rax, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rax + 24]
Lssc_count:
	test	rax, rax
	jz	Lssc_counted
	add	rcx, 1
	mov	rax, QWORD PTR [rax + 80]
	jmp	Lssc_count
Lssc_counted:
	mov	QWORD PTR [rbp - 32], rcx
Lssc_next:
	mov	rcx, QWORD PTR [rbp - 32]
	test	rcx, rcx
	jz	Lssc_unref
	sub	rcx, 1
	mov	QWORD PTR [rbp - 32], rcx
	mov	rax, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rax + 24]
Lssc_walk:
	test	rcx, rcx
	jz	Lssc_at
	mov	rax, QWORD PTR [rax + 80]
	sub	rcx, 1
	jmp	Lssc_walk
Lssc_at:
	mov	QWORD PTR [rbp - 40], rax
	mov	r8, QWORD PTR [rax]
	test	r8, r8
	jz	Lssc_next
	cmp	r8, QWORD PTR [rbp - 24]
	je	Lssc_next
	mov	QWORD PTR [rax], 0
# The identity the wait is for (row +112) is read before the stop; the child may already be ending
# (its identity no longer resolves: no stop, only the wait for its exit_done).
	mov	rdi, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 56], rdi
	mov	QWORD PTR [rbp - 64], 0
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 48], rdi
	test	rdi, rdi
	jz	Lssc_wait
	mov	rcx, QWORD PTR [rbp - 40]
	cmp	QWORD PTR [rcx + 48], 0
	jle	Lssc_kill
	mov	esi, 4
	mov	rdx, QWORD PTR [rip + silica_rt_shutdown_atom]
	jmp	Lssc_stop
Lssc_kill:
# shutdown 0: killed as by kill_abnormal, failure_reason (:explicit, :killed) (§15.4.11.2, §15.4.12.2)
	mov	esi, 4
	mov	rdx, QWORD PTR [rip + silica_rt_killed_atom]
Lssc_stop:
	mov	rdi, QWORD PTR [rbp - 48]
	call	silica_rt_actor_stop
	mov	QWORD PTR [rbp - 64], rdi
	mov	rdi, QWORD PTR [rbp - 48]
	call	silica_rt_acb_release
Lssc_wait:
# The wait is for the row's exit_done to carry the child's identity (its last act): a carrier
# actor on its own stack parks for it, anything else spins (prims_actors_carrier_asm.silica).
	mov	rdi, QWORD PTR [rbp - 40]
	mov	rsi, QWORD PTR [rbp - 56]
	mov	rdx, QWORD PTR [rbp - 64]
	xor	ecx, ecx
	call	silica_rt_row_wait
	jmp	Lssc_next
Lssc_unref:
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_sb_unref
Lssc_ret:
	leave
	ret
# Supervision-block lifetime. SB +112 counts references: the owning actor's (sb_require) and one per
# linked child started from a row (actor_spawn_linked_row, taken before the child's thread exists).
# Each row node keeps its block at +88. A child can outlive its supervisor, and its final row store
# comes after it has freed itself, so neither the owner's teardown nor the child may free the rows
# alone: whoever drops the last reference frees every row node and then the block.
	.globl	silica_rt_sb_unref
	.p2align	4
silica_rt_sb_unref:
# rdi = supervision block or 0: drop one reference.
	test	rdi, rdi
	jz	Lsbu_ret
	mov	rax, -1
	lock xadd	QWORD PTR [rdi + 112], rax
	cmp	rax, 1
	jne	Lsbu_ret
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
# Notices still in the ingress (front list #0, rear list #8; node +0 = next) go with the block: an
# exit notice (+24 == 0) gives back its payload and its hold on the ended child.
	mov	rax, QWORD PTR [rdi]
	mov	QWORD PTR [rdi], 0
Lsbu_free_ingress:
	test	rax, rax
	jnz	Lsbu_free_node
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rdi + 8], 0
	test	rax, rax
	jz	Lsbu_rows
Lsbu_free_node:
	mov	QWORD PTR [rbp - 16], rax
	cmp	DWORD PTR [rax + 24], 0
	jne	Lsbu_free_node_only
	mov	rdi, QWORD PTR [rax + 8]
	call	silica_rt_exit_payload_free
Lsbu_free_node_only:
	mov	rdi, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rdi]
	mov	QWORD PTR [rbp - 16], rax
	call	free
	mov	rax, QWORD PTR [rbp - 16]
	jmp	Lsbu_free_ingress
Lsbu_rows:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rdi + 24]
Lsbu_free_row:
	test	rax, rax
	jz	Lsbu_free_block
# The row spec buffer (+144) goes with its row (design §5.4 Q14: freed at table free).
	mov	QWORD PTR [rbp - 16], rax
	mov	rdi, QWORD PTR [rax + 144]
	test	rdi, rdi
	jz	Lsbu_free_row_node
	call	free
Lsbu_free_row_node:
	mov	rdi, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rdi + 80]
	mov	QWORD PTR [rbp - 16], rax
	call	free
	mov	rax, QWORD PTR [rbp - 16]
	jmp	Lsbu_free_row
Lsbu_free_block:
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	leave
Lsbu_ret:
	ret
	.globl	silica_rt_sb_child_done
	.p2align	4
silica_rt_sb_child_done:
# rdi = the ended child's row (0: not a row child), rsi = its identity. Its last two acts, after its
# ACB is gone: the row's exit_done = its identity (a cascade stop or kill_abnormal waits for it; a
# carrier actor parked for it is made ready: silica_rt_row_exit_done_store), then its block
# reference. Frame: [rbp-8] the block.
	test	rdi, rdi
	jz	Lscd_ret
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	rax, QWORD PTR [rdi + 88]
	mov	QWORD PTR [rbp - 8], rax
	call	silica_rt_row_exit_done_store
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	jmp	silica_rt_sb_unref
Lscd_ret:
	ret
	.globl	silica_rt_child_table_ensure_min_cap
	.p2align	2
silica_rt_child_table_ensure_min_cap:
# X0=ACB* X1=min_nodes. Returns X0=0 success, 1 OOM.
# [rbp - 8] ACB (x19), [rbp - 16] min (x20), [rbp - 24] head (x21), [rbp - 32] count (x22), [rbp - 40] cursor (x23),
# [rbp - 48] new node (x24), [rbp - 56] tail cursor (x25), [rbp - 64] tail next (x26).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	cmp	rsi, 0
	jle	Lct_ens_ok
Lct_ens_retry:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	rax, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 24], rax
	mov	QWORD PTR [rbp - 32], 0
	mov	QWORD PTR [rbp - 40], rax
Lct_count_loop:
	mov	rax, QWORD PTR [rbp - 40]
	test	rax, rax
	jz	Lct_count_done
	add	QWORD PTR [rbp - 32], 1
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 40], rax
	jmp	Lct_count_loop
Lct_count_done:
	mov	rax, QWORD PTR [rbp - 32]
	cmp	rax, QWORD PTR [rbp - 16]
	jae	Lct_ens_ok
	mov	edi, 1
	mov	esi, 160
	call	calloc
	mov	rdi, rax
	test	rdi, rdi
	jz	Lct_ens_fail
	mov	QWORD PTR [rbp - 48], rdi
	mov	QWORD PTR [rdi + 80], 0
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	QWORD PTR [rdi + 88], rax
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	rax, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jnz	Lct_link_at_tail
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	QWORD PTR [rax + 24], rdi
	jmp	Lct_ens_retry
Lct_link_at_tail:
	mov	QWORD PTR [rbp - 56], rax
Lct_find_tail:
	mov	rax, QWORD PTR [rbp - 56]
	mov	rcx, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 64], rcx
	test	rcx, rcx
	jz	Lct_found_tail
	mov	QWORD PTR [rbp - 56], rcx
	jmp	Lct_find_tail
Lct_found_tail:
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 80], rcx
	jmp	Lct_ens_retry
Lct_ens_ok:
	xor	edi, edi
	leave
	ret
Lct_ens_fail:
	mov	edi, 1
	leave
	ret
	.globl	silica_rt_supervisor_spawn_child_row_by_flavor
	.p2align	2
silica_rt_supervisor_spawn_child_row_by_flavor:
# X0 = row, X1 = supervisor ACB -> X0 = the row's new child (0 when no thread could be made). Every
# start of a row's child comes here (materialize, start_child, respawn_row). The spawn returns the
# child held for this spawner (#392). The row takes the reference; the child's id is registered
# (§20.3.1) unless the child has already ended (and dropped again if it ended meanwhile: a name never
# names an ended actor); a notice the child parked at #400, because it ended before this commit, is
# enqueued now that the row holds the child, so maybe_restart finds it. Then the spawner lets go.
# [rbp - 8] row (x19), [rbp - 16] supervisor (x20), [rbp - 24] child (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	r9, QWORD PTR [rdi + 64]
	xor	r14d, r14d
	cmp	r9, 22
	sete	r14b
	mov	rcx, rdi
	mov	rdi, QWORD PTR [rcx + 24]
	mov	rsi, QWORD PTR [rcx + 32]
	mov	rdx, QWORD PTR [rcx + 16]
	mov	r8, QWORD PTR [rcx + 72]
	mov	r9, QWORD PTR [rbp - 16]
	call	silica_rt_actor_spawn_linked_row
	mov	QWORD PTR [rbp - 24], rdi
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], rdi
	test	rdi, rdi
	jz	Lsscr_done
	cmp	DWORD PTR [rdi + 152], 0
	je	Lsscr_commit
	mov	rax, QWORD PTR [rbp - 8]
	mov	r9, QWORD PTR [rax + 64]
	cmp	r9, 22
	je	Lsscr_register_dangerous
Lsscr_register_plain:
	mov	rdi, QWORD PTR [rbp - 24]
	mov	rdi, QWORD PTR [rdi + 408]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax + 8]
	call	silica_rt_register_actor_named
	mfence
	mov	rdi, QWORD PTR [rbp - 24]
	cmp	DWORD PTR [rdi + 152], 0
	jne	Lsscr_commit
	call	silica_rt_registry_forget_actor
Lsscr_commit:
	mov	rdi, QWORD PTR [rbp - 24]
	mov	eax, 1
	xchg	QWORD PTR [rdi + 400], rax
	cmp	rax, 1
	jbe	Lsscr_let_go
	mov	rdi, QWORD PTR [rbp - 16]
	mov	rsi, rax
	call	silica_rt_sup_enqueue_exit
Lsscr_let_go:
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_acb_release
Lsscr_done:
	mov	rdi, QWORD PTR [rbp - 24]
	leave
	ret
Lsscr_register_dangerous:
	mov	rdi, QWORD PTR [rbp - 24]
	mov	rdi, QWORD PTR [rdi + 408]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax + 8]
	call	silica_rt_register_dangerous_actor_named
	jmp	Lsscr_register_plain
	.globl	silica_rt_supervisor_materialize_init_children
	.p2align	2
silica_rt_supervisor_materialize_init_children:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	call	silica_rt_sb_require
	mov	rsi, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rsi]
	cmp	r8, 4096
	jb	Lmat_pre_flags_flat
	mov	QWORD PTR [rbp - 96], 8
	mov	r9, QWORD PTR [r8 + 8]
	mov	QWORD PTR [rdi + 56], r9
	mov	r9, QWORD PTR [r8 + 16]
	mov	QWORD PTR [rdi + 64], r9
	mov	r9, QWORD PTR [r8 + 24]
	mov	QWORD PTR [rdi + 72], r9
	jmp	Lmat_pre_flags_done
Lmat_pre_flags_flat:
	mov	QWORD PTR [rbp - 96], 24
	mov	QWORD PTR [rdi + 56], r8
	mov	r9, QWORD PTR [rsi + 8]
	mov	QWORD PTR [rdi + 64], r9
	mov	r9, QWORD PTR [rsi + 16]
	mov	QWORD PTR [rdi + 72], r9
Lmat_pre_flags_done:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, rsi
	add	rax, QWORD PTR [rbp - 96]
	mov	QWORD PTR [rbp - 88], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jz	Lmat_done
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 24], rcx
	mov	rcx, QWORD PTR [rax + 16]
	mov	QWORD PTR [rbp - 88], rcx
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 16], rax
Lmat_loop:
	cmp	QWORD PTR [rbp - 16], 0
	je	Lmat_done
	mov	rax, QWORD PTR [rbp - 24]
	test	rax, rax
	jz	Lmat_done
	add	rax, QWORD PTR [rbp - 88]
	mov	QWORD PTR [rbp - 96], rax
	mov	rcx, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 32], rcx
	mov	rcx, QWORD PTR [rax + 32]
	mov	QWORD PTR [rbp - 40], rcx
	mov	rcx, QWORD PTR [rax + 16]
	mov	QWORD PTR [rbp - 48], rcx
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 56], rcx
	mov	rcx, QWORD PTR [rax + 40]
	mov	QWORD PTR [rbp - 64], rcx
	mov	rcx, QWORD PTR [rax + 48]
	mov	QWORD PTR [rbp - 72], rcx
# §20.3.1: a child whose id a live actor or supervisor already holds is not started, and init
# fails with :language_error (the supervisor is the current actor while its start trampoline runs).
	mov	rdi, QWORD PTR [rbp - 56]
	call	silica_rt_registry_name_held
	test	rax, rax
	jz	Lmat_id_free
	call	silica_rt_registry_name_taken
Lmat_id_free:
# Phase E e4f + Option B: ensure one more list node, then walk `len` links from head for stable row ptr (no realloc).
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rdi + 216]
	mov	rsi, QWORD PTR [rsi + 32]
	add	rsi, 1
	call	silica_rt_child_table_ensure_min_cap
	test	rdi, rdi
	jnz	Lmat_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	rcx, QWORD PTR [rax + 24]
	mov	r9, QWORD PTR [rax + 32]
	mov	r10, r9
Lmat_walk_row:
	test	r10, r10
	jz	Lmat_walk_row_done
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmat_walk_row
Lmat_walk_row_done:
	mov	QWORD PTR [rbp - 80], rcx
    mov QWORD PTR [rcx], 0
    mov rax, QWORD PTR [rbp - 56]
    mov QWORD PTR [rcx + 8], rax
    mov rax, QWORD PTR [rbp - 48]
    mov QWORD PTR [rcx + 16], rax
    mov rax, QWORD PTR [rbp - 32]
    mov QWORD PTR [rcx + 24], rax
    mov rax, QWORD PTR [rbp - 40]
    mov QWORD PTR [rcx + 32], rax
    mov rax, QWORD PTR [rbp - 64]
    mov QWORD PTR [rcx + 40], rax
    mov rax, QWORD PTR [rbp - 72]
    mov QWORD PTR [rcx + 48], rax
    mov rax, QWORD PTR [rbp - 96]
    mov r9, QWORD PTR [rax + 56]
    mov QWORD PTR [rcx + 64], r9
    mov r9, QWORD PTR [rax + 72]
    mov QWORD PTR [rcx + 72], r9
    mov r9, QWORD PTR [rax + 64]
    mov QWORD PTR [rcx + 128], r9
    mov r9, QWORD PTR [rax + 80]
    mov QWORD PTR [rcx + 136], r9
    mov rax, QWORD PTR [rbp - 80]
    mov rdi, QWORD PTR [rax + 144]
    test rdi, rdi
    jz Lmat_spec_fresh
    call free
    mov rax, QWORD PTR [rbp - 80]
    mov QWORD PTR [rax + 144], 0
Lmat_spec_fresh:
    mov rax, QWORD PTR [rbp - 80]
    mov rsi, QWORD PTR [rax + 136]
    test rsi, rsi
    jz Lmat_spec_done
    mov rdi, QWORD PTR [rax + 24]
    call silica_rt_message_buffer
    mov rax, QWORD PTR [rbp - 80]
    mov QWORD PTR [rax + 24], rdi
    mov QWORD PTR [rax + 144], rdx
Lmat_spec_done:
    mov rdi, QWORD PTR [rbp - 80]
    mov rsi, QWORD PTR [rbp - 8]
    call silica_rt_supervisor_spawn_child_row_by_flavor
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	add	QWORD PTR [rax + 32], 1
	mov	rax, QWORD PTR [rbp - 24]
	mov	rax, QWORD PTR [rax + 88]
	mov	QWORD PTR [rbp - 24], rax
	mov	QWORD PTR [rbp - 88], 0
	sub	QWORD PTR [rbp - 16], 1
	jmp	Lmat_loop
Lmat_done:
	leave
	ret
	.globl	silica_rt_supervisor_start_child
	.p2align	2
silica_rt_supervisor_start_child:
# The builtin start_child(spec): the supervisor is the thread's current actor (the supervisor's own
# init or behaviour). rsi = 0 asks the body to read it.
	xor	esi, esi
	jmp	silica_rt_supervisor_start_child_in
	.globl	silica_rt_supervisor_start_child_in
	.p2align	2
silica_rt_supervisor_start_child_in:
# rdi = child_spec, rsi = the supervisor (0 = the thread's current actor). supervisor_add_child
# names it, so that a call_supervisor :add_child from any actor leaves that actor the current
# one (supervisor_handle_notice).
# Phase E e4f: the frame also keeps x27 (row_ptr) and x28 (appended flag) so we can
# locate / allocate the table row first, then call spawn_linked with X3 = row_ptr.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 8], rsi
	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 24], rax
	mov	rax, QWORD PTR [rdi + 16]
	mov	QWORD PTR [rbp - 32], rax
	mov	rax, QWORD PTR [rdi + 24]
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rdi + 32]
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rdi + 40]
	mov	QWORD PTR [rbp - 56], rax
	mov	rax, QWORD PTR [rdi + 48]
	mov	QWORD PTR [rbp - 64], rax
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_registry_name_held
	test	rax, rax
	jnz	Lsc_id_taken
Lsc_tls_prep:
	cmp	QWORD PTR [rbp - 8], 0
	jne	Lsc_have_sup
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 8], rdi
Lsc_have_sup:
# Phase E e4f + Option B: tombstone scan / append on singly-linked row nodes (+80).
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sb_require
	mov	r8, QWORD PTR [rdi + 24]
	mov	r9, QWORD PTR [rdi + 32]
	xor	r10d, r10d
Lsc_reuse_loop:
	cmp	r10, r9
	jae	Lsc_append_new
	mov	QWORD PTR [rbp - 72], r8
	mov	r11, r10
Lsc_walk_reuse:
	test	r11, r11
	jz	Lsc_reuse_at_row
	mov	rax, QWORD PTR [rbp - 72]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 72], rax
	sub	r11, 1
	jmp	Lsc_walk_reuse
Lsc_reuse_at_row:
	mov	rax, QWORD PTR [rbp - 72]
	mov	rcx, QWORD PTR [rax]
	test	rcx, rcx
	jz	Lsc_use_reuse_row
	add	r10, 1
	jmp	Lsc_reuse_loop
Lsc_append_new:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rdi + 216]
	mov	rsi, QWORD PTR [rsi + 32]
	add	rsi, 1
	call	silica_rt_child_table_ensure_min_cap
	test	rdi, rdi
	jnz	Lsc_id_taken
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r8, QWORD PTR [rax + 24]
	mov	r9, QWORD PTR [rax + 32]
	mov	QWORD PTR [rbp - 72], r8
	mov	r11, r9
Lsc_walk_append:
	test	r11, r11
	jz	Lsc_append_at_row
	mov	rax, QWORD PTR [rbp - 72]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 72], rax
	sub	r11, 1
	jmp	Lsc_walk_append
Lsc_append_at_row:
	mov	QWORD PTR [rbp - 80], 1
	jmp	Lsc_post_row
Lsc_use_reuse_row:
	mov	QWORD PTR [rbp - 80], 0
Lsc_post_row:
	mov	rax, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rax + 72]
	mov	rcx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rcx + 72], r8
	mov	r8, QWORD PTR [rax + 64]
	mov	QWORD PTR [rcx + 128], r8
	mov	r8, QWORD PTR [rax + 80]
	mov	QWORD PTR [rcx + 136], r8
    mov r9, QWORD PTR [rax + 56]
    mov QWORD PTR [rcx], 0
    mov rax, QWORD PTR [rbp - 24]
    mov QWORD PTR [rcx + 8], rax
    mov rax, QWORD PTR [rbp - 32]
    mov QWORD PTR [rcx + 16], rax
    mov rax, QWORD PTR [rbp - 40]
    mov QWORD PTR [rcx + 24], rax
    mov rax, QWORD PTR [rbp - 48]
    mov QWORD PTR [rcx + 32], rax
    mov rax, QWORD PTR [rbp - 56]
    mov QWORD PTR [rcx + 40], rax
    mov rax, QWORD PTR [rbp - 64]
    mov QWORD PTR [rcx + 48], rax
    mov QWORD PTR [rcx + 64], r9
    mov QWORD PTR [rcx + 96], 0
    mov QWORD PTR [rcx + 104], 0
    mov rax, QWORD PTR [rbp - 72]
    mov rdi, QWORD PTR [rax + 144]
