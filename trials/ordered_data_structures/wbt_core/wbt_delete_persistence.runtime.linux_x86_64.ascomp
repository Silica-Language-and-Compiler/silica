	.globl	silica_rt_state_copy
	.p2align	4
silica_rt_state_copy:
# X0 = value, X1 = root descriptor, X2 = destination, X3 = destination end, X4 = relocation delta -> X0 =
# the copy's root, X1 = 0 (1: no table, X0 = the value as given). One table per state slot.
	mov	r9, 1
	jmp	Lstc_copy_entry
	.globl	silica_rt_message_copy
	.p2align	4
silica_rt_message_copy:
# The same arguments and answers with ONE table for the whole value (the spine flag off at the root): the
# copy of a message into its mailbox buffer (chunk 15 phase 4a, design §5.1), sized by
# _silica_rt_message_measure. Sharing between any two parts of the message is kept (R4.2).
	mov	r9, 0
Lstc_copy_entry:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 144
	lea	rsp, [rsp - 16]
	mov	rbx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rsp], rbx
	mov	rbx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rsp + 8], rbx
	lea	rsp, [rsp - 16]
	mov	rbx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rsp], rbx
	mov	rbx, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rsp + 8], rbx
	lea	rsp, [rsp - 16]
	mov	rbx, QWORD PTR [rbp - 88]
	mov	QWORD PTR [rsp], rbx
	mov	rbx, QWORD PTR [rbp - 96]
	mov	QWORD PTR [rsp + 8], rbx
	lea	rsp, [rsp - 16]
	mov	rbx, QWORD PTR [rbp - 104]
	mov	QWORD PTR [rsp], rbx
	mov	rbx, QWORD PTR [rbp - 112]
	mov	QWORD PTR [rsp + 8], rbx
	lea	rsp, [rsp - 16]
	mov	rbx, QWORD PTR [rbp - 120]
	mov	QWORD PTR [rsp], rbx
	mov	rbx, QWORD PTR [rbp - 128]
	mov	QWORD PTR [rsp + 8], rbx
	lea	rsp, [rsp - 64]
	mov	QWORD PTR [rbp - 56], rdx
	mov	QWORD PTR [rbp - 64], rsp
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax], rcx
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax + 8], 0
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax + 16], 0
	mov	QWORD PTR [rax + 24], 0
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax + 32], 0
	mov	QWORD PTR [rax + 40], 0
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax + 48], 0
	mov	rax, QWORD PTR [rbp - 64]
