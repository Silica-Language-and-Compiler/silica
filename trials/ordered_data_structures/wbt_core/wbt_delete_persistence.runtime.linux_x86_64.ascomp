# and the entry edge, become holes (each piece a multiple of 16: the blocks and the entry edge are
# 16-aligned). #568 grows by the whole [lowest block, entry edge) and each hole's push takes its piece
# off again, so it ends up counting the retained bytes. Then the pending list is emptied.
	mov	rax, QWORD PTR [rbp - 56]
	mov	rbx, QWORD PTR [rax + 568]
	mov	QWORD PTR [rbp - 8], rbx
	mov	rax, QWORD PTR [rbp - 80]
	mov	rbx, QWORD PTR [rbp - 112]
	sub	rax, rbx
	mov	r10, rax
	mov	rax, QWORD PTR [rbp - 8]
	lea	rax, [rax + r10]
	mov	QWORD PTR [rbp - 8], rax
	mov	rax, QWORD PTR [rbp - 56]
	mov	rbx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 568], rbx
	mov	rax, QWORD PTR [rbp - 112]
	mov	QWORD PTR [rbp - 64], rax
Lsde_rt_loop:
# Each block's front gap G ([x20, x20 + G), the pending link and G itself, both read first) becomes a hole;
# its node [x20 + G, + round8(count + 8)) stays; the block ends where the node does.
	mov	rax, QWORD PTR [rbp - 64]
	mov	rbx, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 72], rbx
	mov	rax, QWORD PTR [rbp - 64]
	mov	r12, QWORD PTR [rax + 8]
	mov	rax, QWORD PTR [rbp - 64]
	lea	rax, [rax + r12]
	mov	r13, rax
	mov	rbx, QWORD PTR [r13]
	mov	QWORD PTR [rbp - 16], rbx
	mov	rax, QWORD PTR [rbp - 16]
	lea	rax, [rax + 15]
	mov	QWORD PTR [rbp - 16], rax
	mov	rax, QWORD PTR [rbp - 16]
	and	rax, -8
	mov	QWORD PTR [rbp - 16], rax
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, QWORD PTR [rbp - 64]
	mov	rdx, r12
	call	silica_rt_state_free
	mov	rbx, QWORD PTR [rbp - 16]
	lea	rax, [r13 + rbx]
	mov	rsi, rax
	mov	rax, QWORD PTR [rbp - 80]
	sub	rax, rsi
	mov	rdx, rax
	cmp	QWORD PTR [rbp - 72], 0
	je	Lsde_rt_piece
	mov	rax, QWORD PTR [rbp - 72]
	sub	rax, rsi
	mov	rdx, rax
Lsde_rt_piece:
	cmp	rdx, 16
	jl	Lsde_rt_next
	mov	rdi, QWORD PTR [rbp - 56]
	call	silica_rt_state_free
Lsde_rt_next:
	mov	rax, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rbp - 64], rax
	cmp	QWORD PTR [rbp - 64], 0
	jne	Lsde_rt_loop
	mov	rax, QWORD PTR [rbp - 56]
	mov	rbx, QWORD PTR [rax + 272]
	mov	QWORD PTR [rbp - 8], rbx
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 280]
	mov	rax, QWORD PTR [rbp - 8]
	lea	rax, [rax + r10]
	mov	r10, rax
	mov	QWORD PTR [r10 - 8], 0
Lsde_policy_go:
	cmp	QWORD PTR [rbp - 96], 0
	je	Lsde_done
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 576]
	cmp	r10, 0
	jne	Lsde_shrink
# :keep_state_area: the edge never moves up (the area keeps its largest size); it moves down only when
# the compacted state is larger than the old area. The gap above the old edge is reclaimed by the next
# compaction; it is above the edge, so the stack measurer never scans it.
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 528]
	cmp	r10, QWORD PTR [rbp - 80]
	mov	rax, QWORD PTR [rbp - 80]
	cmovb	rax, r10
	mov	r10, rax
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 528], r10
	jmp	Lsde_done
Lsde_shrink:
# :shrink_after_compaction / :compact_on_request: the edge is the compacted end; the pages between the
# old edge and the new one go back (keep = the committed bytes below the old edge), and the gap is zeroed
# so no old state word reads as frame depth.
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 528]
	cmp	r10, QWORD PTR [rbp - 80]
	jbe	Lsde_done
	mov	rax, QWORD PTR [rbp - 56]
	mov	rbx, QWORD PTR [rax + 272]
	mov	QWORD PTR [rbp - 8], rbx
	mov	rax, QWORD PTR [rbp - 56]
	mov	r11, QWORD PTR [rax + 280]
	mov	rax, QWORD PTR [rbp - 8]
	lea	rax, [rax + r11]
	mov	r11, rax
	mov	rax, QWORD PTR [rbp - 56]
	mov	r12, QWORD PTR [rax + 288]
	mov	rax, r11
	sub	rax, r12
	mov	r11, rax
	mov	rax, QWORD PTR [rbp - 80]
	sub	rax, r11
	mov	rsi, rax
	mov	rax, r10
	mov	rbx, QWORD PTR [rbp - 80]
	sub	rax, rbx
	mov	rdx, rax
	mov	rdi, QWORD PTR [rbp - 56]
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	silica_rt_stack_release_to
	mov	rsp, rbp
	pop	rbp
Lsde_done:
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 584], 0
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 560], 0
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 544], 0
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 600], 0
	mov	rdi, QWORD PTR [rbp - 104]
	mov	rbx, QWORD PTR [rsp + 64]
	mov	QWORD PTR [rbp - 104], rbx
	mov	rbx, QWORD PTR [rsp + 72]
	mov	QWORD PTR [rbp - 112], rbx
	mov	rbx, QWORD PTR [rsp + 48]
	mov	QWORD PTR [rbp - 88], rbx
	mov	rbx, QWORD PTR [rsp + 56]
	mov	QWORD PTR [rbp - 96], rbx
	mov	rbx, QWORD PTR [rsp + 32]
	mov	QWORD PTR [rbp - 72], rbx
	mov	rbx, QWORD PTR [rsp + 40]
	mov	QWORD PTR [rbp - 80], rbx
	mov	rbx, QWORD PTR [rsp + 16]
	mov	QWORD PTR [rbp - 56], rbx
	mov	rbx, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 64], rbx
	leave
	ret
Lsde_no_room:
	mov	rdi, QWORD PTR [rbp - 56]
Lstc_fail_actor:
# X0 = ACB: the state does not fit the reservation, or the runtime's own table or log could not be
# allocated (decision 39): (:explicit, :reservation_exceeded) when the program lowered the reservation
# (#376), (:explicit, :out_of_memory) otherwise. _silica_rt_actor_fail_current leaves this stack (the
# carrier's base, or the thread's alternate stack) and never returns.
	mov	r10, QWORD PTR [rdi + 376]
	cmp	r10, 0
	je	Lstc_fail_default
	lea	rax, [rip + silica_rt_reservation_exceeded_atom]
	mov	QWORD PTR [rbp - 8], rax
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax]
	and	rsp, -16
	call	silica_rt_actor_fail_current
Lstc_fail_default:
	lea	rax, [rip + silica_rt_out_of_memory_atom]
	mov	QWORD PTR [rbp - 8], rax
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax]
	and	rsp, -16
	call	silica_rt_actor_fail_current

	.bss
	.p2align	4
	.globl	silica_rt_carrier_count
silica_rt_carrier_count:
	.zero	8
	.globl	silica_rt_carriers
silica_rt_carriers:
	.zero	8
silica_rt_carrier_next:
	.zero	8
silica_rt_carriers_lock:
	.zero	8
	.globl	silica_rt_row_wait_lock
silica_rt_row_wait_lock:
	.zero	16
	.globl	silica_rt_logical_cpu_count
silica_rt_logical_cpu_count:
	.zero	8
	.globl	silica_rt_pcore_count
silica_rt_pcore_count:
	.zero	8
silica_rt_pcore_next:
	.zero	8
silica_rt_ecore_next:
	.zero	8
	.globl	silica_rt_sched_policy
silica_rt_sched_policy:
	.zero	8
	.section .rodata
L_srt_carrier_count_env:
	.asciz	"SILICA_CARRIER_COUNT"
L_srt_hw_logicalcpu:
	.asciz	"hw.logicalcpu"
L_srt_hw_perf0_logicalcpu:
	.asciz	"hw.perflevel0.logicalcpu"
Lrta_r_carrier_wait:
	.asciz	"a carrier actor waited on the carrier's own stack for another actor of its carrier"
Lrta_r_row_wake:
	.asciz	"a row child's exit found an actor on its wait list that was not parked for it"
Lrta_r_carrier_thread:
	.asciz	"the carrier thread could not be created"
Lrta_r_carrier_table:
	.asciz	"the carrier table could not be made"
Lrta_r_thread_record:
	.asciz	"the thread's actor record could not be made"
	.text
	.globl	silica_rt_carrier_adopt
	.p2align	4
silica_rt_carrier_adopt:
# rdi = a new ACB (reservation made, arena bookkeeping set), rsi = its start trampoline (0 = none),
# rdx = 1 for a dangerous actor. -> rdi = 1 when the actor was given to a carrier (no thread is to
# be made): every actor but a dangerous one, whose foreign calls may block and whose guarded-FFI
# state is per thread, so it keeps a thread of its own (rdi = 0). A supervisor or any other actor
# with a trampoline is bound and made READY (status 2, on its carrier's run queue) instead of
# started: its first dispatch runs the trampoline (Lcar_first) and then stores the started word
# (#224), which its spawner waits for; an actor without one is idle and started at once. The
# carrier: `core mod N` for a core id (#208) that names one of the machine's logical cores, 1 ..
# silica_rt_logical_cpu_count - 1 (a row child's #208 is its row pointer, no core id; 0 is the
# default; a core the machine does not have is placed in turn, the board's rule for an
# out-of-range core at spawn); else the next carrier in turn.
# Frame: [rbp-8] ACB (x19), [rbp-16] carrier (x20), [rbp-24] table (x21), [rbp-32] trampoline (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 32], rsi
	test	rdx, rdx
	jnz	Lcad_no
	call	silica_rt_carriers_ensure
	mov	QWORD PTR [rbp - 24], rdi
	mov	r10, QWORD PTR [rip + silica_rt_carrier_count]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 208]
	cmp	rcx, 4096
	jae	Lcad_in_turn
	test	rcx, rcx
	jz	Lcad_in_turn
	cmp	rcx, QWORD PTR [rip + silica_rt_logical_cpu_count]
	jae	Lcad_in_turn
	mov	rax, rcx
	xor	edx, edx
	div	r10
	mov	rcx, rdx
	jmp	Lcad_have_index
Lcad_in_turn:
	mov	rax, QWORD PTR [rip + silica_rt_carrier_next]
Lcad_turn_loop:
	lea	r11, [rax + 1]
	cmp	r11, r10
	jb	Lcad_turn_store
	xor	r11d, r11d
Lcad_turn_store:
	lock cmpxchg	QWORD PTR [rip + silica_rt_carrier_next], r11
	jne	Lcad_turn_loop
	mov	rcx, rax
Lcad_have_index:
	shl	rcx, 8
	add	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rbp - 16], rcx
	mov	rdi, rcx
	call	silica_rt_carrier_ensure_started
	test	rdi, rdi
	jz	Lcad_bound
# The host refused this carrier's thread (dangerous actors may hold every thread it allows, item N
# #5): the actor goes to a carrier that runs instead of its `core mod N` or in-turn one. None running
# (the first adoption only) is the runtime abort: the carrier thread could not be created.
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_carrier_started_any
	test	rdi, rdi
	jz	Lcad_no_carrier
	mov	QWORD PTR [rbp - 16], rdi
Lcad_bound:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 440], rcx
	mov	QWORD PTR [rax + 448], 1
	mov	QWORD PTR [rax + 456], 0
	mov	QWORD PTR [rax + 464], 0
	mov	QWORD PTR [rax + 472], 0
	mov	QWORD PTR [rax + 512], 0
	cmp	QWORD PTR [rbp - 32], 0
	jne	Lcad_ready
	mov	rdi, rax
	mov	esi, 1
	call	silica_rt_started_store
	mov	edi, 1
	jmp	Lcad_ret
Lcad_ready:
# A trampoline to run: ready on its carrier, under its lock (its identity resolves already, so a
# cast could race the status; a push needs the status guarded by the actor's lock).
	lea	rdi, [rax + 16]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 448], 2
	mov	rdi, rax
	call	silica_rt_carrier_push
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	edi, 1
	jmp	Lcad_ret
Lcad_no_carrier:
	lea	rdi, [rip + Lrta_r_carrier_thread]
	call	silica_rt_abort_with
	jmp	Lcad_no_carrier
Lcad_no:
	xor	edi, edi
Lcad_ret:
	leave
	ret
	.globl	silica_rt_carriers_ensure
	.p2align	4
silica_rt_carriers_ensure:
# -> rdi = the carrier table, made the first time: silica_rt_carrier_count blocks of 256 B (the
# count was read by silica_rt_stack_runtime_init; 1 when it was not), each knowing itself (+96)
# and its index (+112), its weighted-fair round starting at the high tier with its quantum (+200
# = 0 from calloc, +208 = 4, as the board's core block starts). Failure to make it is a runtime
# abort. Frame: [rbp-8] count (x20), [rbp-16] table (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	rdi, QWORD PTR [rip + silica_rt_carriers]
	test	rdi, rdi
	jnz	Lcen_ret
	lea	rdi, [rip + silica_rt_carriers_lock]
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rip + silica_rt_carriers]
	test	rdi, rdi
	jnz	Lcen_unlock
	mov	r10, QWORD PTR [rip + silica_rt_carrier_count]
	test	r10, r10
	jnz	Lcen_have_count
	mov	r10d, 1
	mov	QWORD PTR [rip + silica_rt_carrier_count], r10
Lcen_have_count:
	mov	QWORD PTR [rbp - 8], r10
	mov	rdi, r10
	mov	esi, 256
	call	calloc
	test	rax, rax
	jz	Lcen_failed
	mov	QWORD PTR [rbp - 16], rax
	mov	rcx, rax
	xor	r10d, r10d
	mov	r11, QWORD PTR [rbp - 8]
Lcen_fill:
	cmp	r10, r11
	jae	Lcen_filled
	mov	QWORD PTR [rcx + 96], rcx
	mov	QWORD PTR [rcx + 112], r10
	mov	QWORD PTR [rcx + 208], 4
	add	rcx, 256
	inc	r10
	jmp	Lcen_fill
Lcen_filled:
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rip + silica_rt_carriers], rax
Lcen_unlock:
	lea	rdi, [rip + silica_rt_carriers_lock]
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rip + silica_rt_carriers]
Lcen_ret:
	leave
	ret
Lcen_failed:
	lea	rdi, [rip + Lrta_r_carrier_table]
	call	silica_rt_abort_with
	jmp	Lcen_failed
	.globl	silica_rt_carrier_ensure_started
	.p2align	4
silica_rt_carrier_ensure_started:
# rdi = carrier block. Creates its thread the first time. -> rdi = 0 when the carrier runs (it did
# already, or its thread was made now), 1 when the host refused the thread (item N #5: dangerous
# actors, each on a thread of its own, may hold every thread the host allows): the carrier stays
# without one, and the caller places the actor on a carrier that runs (silica_rt_carrier_adopt)
# or answers :migration_blocked (silica_rt_carrier_migrate). Frame: [rbp-8] carrier (x19),
# [rbp-16] the result (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 0
	cmp	QWORD PTR [rdi + 80], 0
	jne	Lces_ret
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 80], 0
	jne	Lces_unlock
	lea	rdi, [rax + 64]
	xor	esi, esi
	lea	rdx, [rip + silica_rt_carrier_main]
	mov	rcx, rax
	call	pthread_create
	test	eax, eax
	jnz	Lces_failed
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 64]
	call	pthread_detach
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 80], 1
Lces_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_lock_unlock
Lces_ret:
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
Lces_failed:
	mov	QWORD PTR [rbp - 16], 1
	jmp	Lces_unlock
	.globl	silica_rt_carrier_started_any
	.p2align	4
silica_rt_carrier_started_any:
# rdi = the carrier table -> rdi = the first carrier whose thread runs (+80), or 0 when none does
# (only before the first adoption). Leaf; r10.
	mov	r10, QWORD PTR [rip + silica_rt_carrier_count]
	shl	r10, 8
	add	r10, rdi
Lcsa_loop:
	cmp	rdi, r10
	jae	Lcsa_none
	cmp	QWORD PTR [rdi + 80], 0
	jne	Lcsa_ret
	add	rdi, 256
	jmp	Lcsa_loop
Lcsa_none:
	xor	edi, edi
Lcsa_ret:
	ret
	.globl	silica_rt_tls_record_set
	.p2align	4
silica_rt_tls_record_set:
# rdi = this thread's record: two words, the current actor and the carrier (0 when the thread is
# not a carrier's). An actor thread's record is in its control block (#496), a carrier's in its
# block (+88); main has none until silica_rt_tls_actor_set makes it one.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_ensure_actor_tls_key
	mov	rdi, QWORD PTR [rip + silica_actor_pthread_key]
	mov	rsi, QWORD PTR [rbp - 8]
	call	pthread_setspecific
	leave
	ret
	.globl	silica_rt_tls_actor_set
	.p2align	4
silica_rt_tls_actor_set:
# rdi = ACB or 0: this thread's current actor, stored in the thread's record. A thread without a
# record (main) gets a calloc'd one now, never freed (one thread).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_ensure_actor_tls_key
	mov	rdi, QWORD PTR [rip + silica_actor_pthread_key]
	call	pthread_getspecific
	test	rax, rax
	jnz	Ltas_store
	mov	edi, 1
	mov	esi, 16
	call	calloc
	test	rax, rax
	jz	Ltas_failed
	mov	QWORD PTR [rbp - 16], rax
	mov	rdi, QWORD PTR [rip + silica_actor_pthread_key]
	mov	rsi, rax
	call	pthread_setspecific
	mov	rax, QWORD PTR [rbp - 16]
Ltas_store:
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], rcx
	leave
	ret
Ltas_failed:
	lea	rdi, [rip + Lrta_r_thread_record]
	call	silica_rt_abort_with
	jmp	Ltas_failed
	.globl	silica_rt_carrier_main
	.p2align	4
silica_rt_carrier_main:
# Thread entry (C-called pthread start routine): rdi = carrier block. Never returns.
# Frame: [rbp-8] carrier; the cpu_set_t (128 B) at [rsp .. rsp + 128).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 160
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rdi + 88], 0
	lea	rdi, [rdi + 88]
	call	silica_rt_tls_record_set
	mov	rax, QWORD PTR [rbp - 8]
	lea	rdi, [rax + 56]
	call	silica_rt_altstack_install_at
# Affinity to logical core i (the carrier's index): pthread_setaffinity_np(self, 128, cpu_set_t
# naming cpu i), a real binding on Linux (the thread runs only on that core while the kernel
# honours it; the Darwin tree can only hint). The result is recorded in the block (+224: 0 bound,
# else the errno; EINVAL when the index is no cpu of this machine, as under a SILICA_CARRIER_COUNT
# above the core count, or above 1023) and never aborts: the carrier is what is guaranteed, the
# core is best effort (spec §15.1.2, OS-hosted).
	mov	rdi, rsp
	xor	esi, esi
	mov	edx, 128
	call	memset
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 112]
	cmp	r10, 1024
	jae	Lcar_aff_apply
	mov	r11, r10
	shr	r11, 6
	mov	ecx, r10d
	and	ecx, 63
	mov	r8d, 1
	shl	r8, cl
	or	QWORD PTR [rsp + r11*8], r8
Lcar_aff_apply:
	call	pthread_self
	mov	rdi, rax
	mov	esi, 128
	mov	rdx, rsp
	call	pthread_setaffinity_np
	mov	eax, eax
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 224], rax
# The base: rsp here (16-byte aligned: rbp is, and the locals are 160). The dispatch frames are
# built below it by Lcar_loop; nothing of this frame is read again.
	mov	QWORD PTR [rcx + 48], rsp
	mov	QWORD PTR [rcx + 72], 1
	mov	rdi, rcx
Lcar_loop:
# rdi = the carrier. Entered afresh from every path that leaves an actor: the stack below the base
# is abandoned, and the dispatch frame of actor_thread_main is rebuilt at its fixed place (the
# module header): a fake return slot at base - 8, rbp = base - 16 with a saved rbp of 0, the 128
# bytes of slots below it, [rbp-64] = the carrier (x24), [rbp-8] = the actor once one is chosen.
	mov	rax, rdi
	mov	rsp, QWORD PTR [rax + 48]
	lea	rbp, [rsp - 16]
	mov	QWORD PTR [rbp], 0
	mov	QWORD PTR [rbp + 8], 0
	lea	rsp, [rbp - 128]
	mov	QWORD PTR [rbp - 64], rax
	mov	QWORD PTR [rbp - 8], 0
	mov	QWORD PTR [rax + 40], 0
	mov	QWORD PTR [rax + 88], 0
	mov	rdi, rax
	call	silica_rt_lock_lock
Lcar_pop:
	mov	rax, QWORD PTR [rbp - 64]
	mov	r10, QWORD PTR [rax + 128]
	or	r10, QWORD PTR [rax + 152]
	or	r10, QWORD PTR [rax + 176]
	jz	Lcar_empty
# A busy carrier sweeps a batch of its idle :release_when_idle actors when their listed bytes are
# over the carrier's budget (every pop), or when the head is due and the sweep cadence has passed
# since the last sweep; a batch that answers 1 (more to do) is followed by one dispatch and then
# the next batch (the last-sweep time is cleared so the cadence does not delay it). rax = the
# carrier at Lcar_sweep_busy on both paths (reloaded after the clock call).
	cmp	QWORD PTR [rax + 104], 0
	je	Lcar_have
	mov	r10, QWORD PTR [rax + 240]
	cmp	r10, QWORD PTR [rip + silica_rt_idle_stack_budget]
	ja	Lcar_sweep_busy
	call	silica_rt_stack_now_ns
	mov	rax, QWORD PTR [rbp - 64]
	mov	r10, rdi
	sub	r10, QWORD PTR [rax + 120]
	cmp	r10, QWORD PTR [rip + silica_rt_idle_sweep_ns]
	jb	Lcar_have
	mov	r11, QWORD PTR [rax + 104]
	mov	r10, rdi
	sub	r10, QWORD PTR [r11 + 344]
	cmp	r10, QWORD PTR [rip + silica_rt_idle_release_ns]
	jb	Lcar_have
Lcar_sweep_busy:
	mov	rdi, rax
	call	silica_rt_carrier_sweep
	cmp	rdi, 1
	jne	Lcar_have
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax + 120], 0
	jmp	Lcar_have
Lcar_empty:
# Nothing to run: sweep a batch; more to do (1) means back to the top, where mail that arrived
# meanwhile is dispatched first; else, since the sweep let this lock go for each release, an actor
# pushed meanwhile (it found the carrier awake, so it did not signal) is run before any sleep;
# else sleep until mail (or a parked actor's wake) or the time the head of the list is due (0 =
# the list is empty: no timeout). The sweep's answer stays in rdi across the queue check (no call
# between) and becomes the wait's timeout.
	mov	rdi, QWORD PTR [rbp - 64]
	call	silica_rt_carrier_sweep
	cmp	rdi, 1
	je	Lcar_pop
	mov	rax, QWORD PTR [rbp - 64]
	mov	r10, QWORD PTR [rax + 128]
	or	r10, QWORD PTR [rax + 152]
	or	r10, QWORD PTR [rax + 176]
	jnz	Lcar_have
	mov	rdx, rdi
	mov	QWORD PTR [rax + 16], 1
	lea	rdi, [rax + 8]
	mov	rsi, rax
	call	silica_rt_cv_wait_timeout
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax + 16], 0
	jmp	Lcar_pop
Lcar_have:
# The policy's choice among the ready actors (some queue is non-empty, checked under this lock).
	mov	rdi, QWORD PTR [rbp - 64]
	call	silica_rt_rq_pop
	mov	QWORD PTR [rbp - 8], rdi
	mov	rdi, QWORD PTR [rbp - 64]
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax + 448], 3
	mov	QWORD PTR [rcx + 40], rax
	mov	QWORD PTR [rcx + 88], rax
	cmp	QWORD PTR [rax + 464], 0
	jne	Lcar_resume
	cmp	QWORD PTR [rax + 224], 0
	je	Lcar_first
	jmp	LBB1_loop
Lcar_first:
# Not started: the actor's start trampoline (SB #48; a supervisor's init and the
# materialisation of its children) runs first, on the actor's own stack as a behaviour does, so a
# wait inside it (a child supervisor's start) parks. The dispatch frame with its 48-byte result
# area is the one a resume rebuilds (Lcar_resume: rsp = rbp - 176) and the carrier's SP is kept in
# #368 as a behaviour's dispatch keeps it; the frame's slots ([rbp-8] the actor, [rbp-64] the
# carrier) survive the trampoline and any park (silica_rt_ctx_save / _resume carry them). Then the
# started word goes to 1 (a spawner parked or spinning on it proceeds) and the mailbox loop
# begins. An actor that ends inside its trampoline (a duplicate child id, exhaustion, badarith)
# never returns here: its exit path stores 2 and enters the loop.
	mov	r10, QWORD PTR [rax + 216]
	test	r10, r10
	jz	Lcar_started
	mov	r10, QWORD PTR [r10 + 48]
	test	r10, r10
	jz	Lcar_started
	sub	rsp, 48
	mov	QWORD PTR [rax + 368], rsp
	mov	r11, QWORD PTR [rax + 528]
	mov	rsp, r11
	mov	rdi, rax
	call	r10
	lea	rsp, [rbp - 128]
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 368], 0
Lcar_started:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 1
	call	silica_rt_started_store
	jmp	LBB1_loop
Lcar_resume:
# Parked inside a behaviour (or a trampoline, or a drain): the dispatch frame its behaviour will
# return into is this frame, rebuilt (the post-behaviour code reads the node from ACB #240; the
# eight slots come back with the context).
	lea	r10, [rbp - 176]
	mov	QWORD PTR [rax + 368], r10
	mov	rdi, rax
	jmp	silica_rt_ctx_resume
	.globl	silica_rt_carrier_loop_enter
	.p2align	4
silica_rt_carrier_loop_enter:
# rdi = carrier block. An actor's exit path, run on the carrier's stack, ends here. Never returns.
	jmp	Lcar_loop
	.globl	silica_rt_carrier_requeue
	.p2align	4
silica_rt_carrier_requeue:
# rdi = a carrier actor whose message has been served (the dispatch boundary): a pending migration
# (#512) is applied first, then it is ready again when mail waits or it has been ended meanwhile
# (its exit path runs at its next dispatch), idle otherwise; then back to the loop of the carrier
# this thread is ([rbp-16], read before the move: after it the actor's #440 may name another
# carrier, whose thread may already be running the actor). Never returns.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 440]
	mov	QWORD PTR [rbp - 16], rax
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_carrier_apply_pending
	mov	rax, QWORD PTR [rbp - 8]
	cmp	DWORD PTR [rax + 152], 0
	je	Lcrq_ready
	mov	r10, QWORD PTR [rax + 216]
	test	r10, r10
	jz	Lcrq_std
	mov	r11, QWORD PTR [r10]
	or	r11, QWORD PTR [r10 + 8]
	jnz	Lcrq_ready
Lcrq_std:
	mov	r11, QWORD PTR [rax + 128]
	or	r11, QWORD PTR [rax + 136]
	jnz	Lcrq_ready
	mov	rdi, rax
	call	silica_rt_carrier_mark_idle
	jmp	Lcrq_unlock
Lcrq_ready:
	mov	QWORD PTR [rax + 448], 2
	mov	rdi, rax
	call	silica_rt_carrier_push
Lcrq_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 16]
	jmp	silica_rt_carrier_loop_enter
	.globl	silica_rt_carrier_apply_pending
	.p2align	4
silica_rt_carrier_apply_pending:
# rdi = a carrier actor between dispatches (its message served, or dispatched with no mail), its
# lock held, not on any run queue or sweep list: a pending migration (#512, the target carrier
# block) becomes its binding (#440). The word is taken atomically (xchg), so a migrate_actor that
# stores a new target meanwhile is not lost. Leaf; rax only.
	xor	eax, eax
	xchg	QWORD PTR [rdi + 512], rax
	test	rax, rax
	jz	Lcap_ret
	mov	QWORD PTR [rdi + 440], rax
Lcap_ret:
	ret
	.globl	silica_rt_carrier_push
	.p2align	4
silica_rt_carrier_push:
# rdi = a carrier actor whose status its caller has just set to ready (2), under the lock that guards
# that status. Appends it to the run queue of its own carrier (#440: the caller may be anywhere)
# that the policy chooses (silica_rt_rq_push) and wakes that carrier when it sleeps. A pending
# migration is not applied here: a parked actor resumes on the carrier it parked on, inside the
# same dispatch (spec §15.1.2, scheduler yield points), and moves at its dispatch boundary
# (silica_rt_carrier_requeue). Frame: [rbp-8] carrier (x19), [rbp-16] actor (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rdi + 440]
	mov	QWORD PTR [rbp - 8], rax
	mov	QWORD PTR [rdi + 456], 0
	mov	rdi, rax
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_rq_push
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 16], 0
	je	Lcpu_unlock
	lea	rdi, [rax + 8]
	call	silica_rt_cv_signal
Lcpu_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_lock_unlock
	leave
	ret
	.globl	silica_rt_carrier_mark_idle
	.p2align	4
silica_rt_carrier_mark_idle:
# rdi = a carrier actor with no mail, between dispatches, its lock held: a pending migration is
# applied, then it is idle (1), or, when it is :release_when_idle (#312 = 4) and still holds
# committed stack (#288), idle on its carrier's sweep list (5): appended at the tail (+232; the
# list is ordered by the last-message stamps, #344, which this dispatch has just written), its
# committed bytes added to the listed total (+240), under that carrier's lock (the carrier may be
# the one just moved to: its list changes under its lock, and when it sleeps it is woken, as a push
# wakes it, so that it waits with the listed actor's due time as its timeout rather than the untimed
# or longer wait it chose when its list was shorter; a carrier listing on its own thread is awake,
# so the signal is never sent for it).
# Frame: [rbp-8] actor (x19), [rbp-16] carrier (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_carrier_apply_pending
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 312], 4
	jne	Lcmi_plain
	cmp	QWORD PTR [rax + 288], 0
	je	Lcmi_plain
	mov	rcx, QWORD PTR [rax + 440]
	mov	QWORD PTR [rbp - 16], rcx
	mov	rdi, rcx
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 456], 0
	mov	r10, QWORD PTR [rcx + 232]
	test	r10, r10
	jz	Lcmi_first
	mov	QWORD PTR [r10 + 456], rax
	jmp	Lcmi_linked
Lcmi_first:
	mov	QWORD PTR [rcx + 104], rax
Lcmi_linked:
	mov	QWORD PTR [rcx + 232], rax
	mov	r10, QWORD PTR [rax + 288]
	add	QWORD PTR [rcx + 240], r10
	mov	QWORD PTR [rax + 448], 5
	cmp	QWORD PTR [rcx + 16], 0
	je	Lcmi_unlock
	lea	rdi, [rcx + 8]
	call	silica_rt_cv_signal
Lcmi_unlock:
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_lock_unlock
	jmp	Lcmi_ret
Lcmi_plain:
	mov	QWORD PTR [rax + 448], 1
Lcmi_ret:
	leave
	ret
	.globl	silica_rt_carrier_unlist
	.p2align	4
silica_rt_carrier_unlist:
# rdi = a carrier actor its caller found on its carrier's sweep list (status 5), its lock held:
# taken off the list under the carrier's lock (the tail, +232, fixed up when it was the last entry;
# its committed bytes taken off the listed total, +240). Not found is fine: the sweep took it off
# meanwhile (it is 6, sweeping, or already released and 1; the caller's status write settles it).
# Frame: [rbp-8] actor (x19), [rbp-16] carrier (x20); r10 the link word being read (x9), r11 the
# entry it names (x10), r9 the entry before it (x11, 0 at the head); no call inside the walk.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 440]
	mov	QWORD PTR [rbp - 16], rax
	mov	rdi, rax
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	lea	r10, [rcx + 104]
	xor	r9d, r9d
Lcul_find:
	mov	r11, QWORD PTR [r10]
	test	r11, r11
	jz	Lcul_unlock
	cmp	r11, rax
	je	Lcul_found
	mov	r9, r11
	lea	r10, [r11 + 456]
	jmp	Lcul_find
Lcul_found:
	mov	r8, QWORD PTR [rax + 456]
	mov	QWORD PTR [r10], r8
	test	r8, r8
	jnz	Lcul_tail_kept
	mov	QWORD PTR [rcx + 232], r9
Lcul_tail_kept:
	mov	QWORD PTR [rax + 456], 0
	mov	r8, QWORD PTR [rax + 288]
	sub	QWORD PTR [rcx + 240], r8
Lcul_unlock:
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_lock_unlock
	leave
	ret
	.globl	silica_rt_carrier_sweep
	.p2align	4
silica_rt_carrier_sweep:
# rdi = a carrier, its lock held, on its own thread; returns with it held. One batch of the idle
# sweep (the module header): up to 64 actors from the head of the sweep list (+104), each taken
# while it is due (silica_rt_stack_idle_due against the clock read once here) or while the listed
# bytes (+240) exceed the carrier's budget (silica_rt_idle_stack_budget). Per actor: under the
# carrier's lock it is unlinked (tail +232 and total +240 kept), marked 6 (sweeping) and the lock
# let go; then under the actor's own lock alone its stack is released (silica_rt_stack_release_to
# 0/0, on this carrier's stack: it never waits) and it is marked plainly idle (1), unless its
# status is no longer 6 (mail, a stop or a migration made it ready, 2: it keeps its stack and will
# stamp and relist at its next boundary); then the carrier's lock is taken again for the next
# head. -> rdi = 0 when the list is empty, 1 when more is to be done at once (the batch is full with
# the list not empty), else the microseconds until the head is due. Records the time of the sweep
# (+120). An actor marked 6 has #440 = this carrier and is on no queue or list, so a push by its
# wake lands on this carrier's queue, popped only after this call returns.
# Frame: [rbp-8] carrier (x19), [rbp-16] the head being taken (x20), [rbp-24] the clock reading
# (x21), [rbp-32] the batch count (x22), [rbp-40] the budget (x23); every slot is re-read after a
# call, and the temporaries rax rcx r10 never cross one.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 48
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_stack_now_ns
	mov	QWORD PTR [rbp - 24], rdi
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 120], rdi
	mov	r10, QWORD PTR [rip + silica_rt_idle_stack_budget]
	mov	QWORD PTR [rbp - 40], r10
	mov	QWORD PTR [rbp - 32], 0
Lcsw_next:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 104]
	mov	QWORD PTR [rbp - 16], rcx
	test	rcx, rcx
	jz	Lcsw_empty
	cmp	QWORD PTR [rbp - 32], 64
	jae	Lcsw_more
	mov	r10, QWORD PTR [rax + 240]
	cmp	r10, QWORD PTR [rbp - 40]
	ja	Lcsw_take
	mov	rdi, rcx
	mov	rsi, QWORD PTR [rbp - 24]
	call	silica_rt_stack_idle_due
	test	rdi, rdi
	jnz	Lcsw_ret
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
Lcsw_take:
# rax = the carrier, rcx = the head, under the carrier's lock.
	mov	r10, QWORD PTR [rcx + 456]
	mov	QWORD PTR [rax + 104], r10
	test	r10, r10
	jnz	Lcsw_tail_kept
	mov	QWORD PTR [rax + 232], 0
Lcsw_tail_kept:
	mov	QWORD PTR [rcx + 456], 0
	mov	r10, QWORD PTR [rcx + 288]
	sub	QWORD PTR [rax + 240], r10
	mov	QWORD PTR [rcx + 448], 6
	inc	QWORD PTR [rbp - 32]
	mov	rdi, rax
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 16]
	cmp	QWORD PTR [rcx + 448], 6
	jne	Lcsw_skip
	mov	rdi, rcx
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_stack_release_to
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rcx + 448], 1
Lcsw_skip:
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_lock_lock
	jmp	Lcsw_next
Lcsw_empty:
	xor	edi, edi
	jmp	Lcsw_ret
Lcsw_more:
	mov	edi, 1
Lcsw_ret:
	leave
	ret
	.globl	silica_rt_actor_mail_signal
	.p2align	4
silica_rt_actor_mail_signal:
# rdi = ACB; the caller holds ACB+16 and has enqueued mail or ended the actor. Signals the mailbox
# futex (an actor thread waits on it) and, for an idle carrier actor (plainly idle, 1; on its
# carrier's sweep list, 5, taken off it first; or being swept, 6, already off the list: the sweep
# finds 2 under this lock and keeps the stack), makes it ready on its own carrier.
# Frame: [rbp-8] ACB (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	add	rdi, 80
	call	silica_rt_cv_signal
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 440], 0
	je	Lams_ret
	mov	r10, QWORD PTR [rax + 448]
	cmp	r10, 1
	je	Lams_ready
	cmp	r10, 6
	je	Lams_ready
	cmp	r10, 5
	jne	Lams_ret
	mov	rdi, rax
	call	silica_rt_carrier_unlist
Lams_ready:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 448], 2
	mov	rdi, rax
	call	silica_rt_carrier_push
Lams_ret:
	leave
	ret
	.globl	silica_rt_call_wrapper_wake
	.p2align	4
silica_rt_call_wrapper_wake:
# rdi = call wrapper; the caller holds wrapper+72 and has set reply_set. Signals the wrapper's futex
# (a thread waits on it) and makes a carrier actor parked on it (wrapper+48) ready on its carrier.
# Frame: [rbp-8] wrapper (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	add	rdi, 24
	call	silica_rt_cv_signal
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 48]
	test	rax, rax
	jz	Lcww_ret
	cmp	QWORD PTR [rax + 448], 4
	jne	Lcww_ret
	mov	QWORD PTR [rax + 448], 2
	mov	rdi, rax
	call	silica_rt_carrier_push
Lcww_ret:
	leave
	ret
	.globl	silica_rt_started_store
	.p2align	4
silica_rt_started_store:
# rdi = ACB, rsi = its started word (#224): 1 started, 2 its start trampoline failed. Stores it and
# makes a carrier actor parked in the spawn (#472) ready. The parker stores #472 and then reads #224
# under its own lock; this side stores #224 and then reads #472: with the full barriers (mfence)
# one of them sees the other's store, and the status check under the parker's lock settles the rest.
# Frame: [rbp-8] the parker (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rdi + 224], rsi
	mfence
	mov	rax, QWORD PTR [rdi + 472]
	mov	QWORD PTR [rbp - 8], rax
	test	rax, rax
	jz	Lsts_ret
	lea	rdi, [rax + 16]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 448], 4
	jne	Lsts_unlock
	mov	QWORD PTR [rax + 448], 2
	mov	rdi, rax
	call	silica_rt_carrier_push
Lsts_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Lsts_ret:
	leave
	ret
	.globl	silica_rt_spawn_wait_started
	.p2align	4
silica_rt_spawn_wait_started:
# rdi = a child just spawned. Returns once its started word (#224) is set (at adoption for a plain
# actor; after the trampoline of its first dispatch for a supervisor). A carrier actor on its own
# stack parks (the child's started store wakes it); anything else spins (main spawning a root
# supervisor, a dangerous actor's thread), as the spawn always did. The parker is the actor this
# carrier runs, on whose stack this runs (silica_rt_carrier_self_on_own_stack: carrier +40 and
# the SP), never the thread's current actor: a respawn from a drain of a supervisor's ingress on
# another actor's stack would otherwise have spun (and, with the child bound to this carrier,
# never seen it start).
# Frame: [rbp-8] child (x19), [rbp-16] the parking actor (x20), [rbp-24] its carrier (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_carrier_self_on_own_stack
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	Lsws_spin
	mov	rax, QWORD PTR [rdi + 440]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jz	Lsws_spin
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 472], rcx
	mfence
Lsws_park_loop:
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 224], 0
	jne	Lsws_started
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_ctx_save
	test	rdi, rdi
	jnz	Lsws_park_loop
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 448], 4
	lea	rdi, [rax + 16]
	call	silica_rt_lock_unlock
# The loop of the carrier this thread is ([rbp-24], read while the actor still ran here): the
# actor's #440 may change once it is parked (a migration applied at its boundary elsewhere).
	mov	rdi, QWORD PTR [rbp - 24]
	jmp	silica_rt_carrier_loop_enter
Lsws_started:
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	jmp	Lsws_ret
Lsws_spin:
	mov	rax, QWORD PTR [rbp - 8]
Lsws_spin_loop:
	cmp	QWORD PTR [rax + 224], 0
	jne	Lsws_ret
	pause
	jmp	Lsws_spin_loop
Lsws_ret:
	leave
	ret
	.globl	silica_rt_on_carrier_thread
	.p2align	4
silica_rt_on_carrier_thread:
# -> rdi = the carrier block when this thread is a carrier's (the second word of the thread's
# record), else 0.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_ensure_actor_tls_key
	mov	rdi, QWORD PTR [rip + silica_actor_pthread_key]
	call	pthread_getspecific
	test	rax, rax
	jz	Loct_none
	mov	rdi, QWORD PTR [rax + 8]
	pop	rbp
	ret
Loct_none:
	xor	edi, edi
	pop	rbp
	ret
	.globl	silica_rt_carrier_self_on_own_stack
	.p2align	4
silica_rt_carrier_self_on_own_stack:
# -> rdi = the carrier actor this thread runs when the caller is on that actor's own stack (it can
# park), else 0: main, an actor thread, or a runtime path on the carrier's own stack. The parked
# actor is the one the carrier runs (carrier +40), not the thread's current actor: an ingress drain
# installs the supervisor as the current actor while it runs on the drainer's stack.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_on_carrier_thread
	test	rdi, rdi
	jz	Lcso_ret
	mov	rdi, QWORD PTR [rdi + 40]
	test	rdi, rdi
	jz	Lcso_ret
	mov	r10, rsp
	mov	r11, QWORD PTR [rdi + 272]
	cmp	r10, r11
	jb	Lcso_no
	add	r11, QWORD PTR [rdi + 280]
	cmp	r10, r11
	jae	Lcso_no
	jmp	Lcso_ret
Lcso_no:
	xor	edi, edi
Lcso_ret:
	pop	rbp
	ret
	.globl	silica_rt_sup_on_own_dispatch
	.p2align	4
silica_rt_sup_on_own_dispatch:
# rdi = a supervisor -> rdi = 1 when this thread is the supervisor's carrier running the supervisor
# itself (carrier +40: its own dispatch, the ingress served at LBB1_ingress_no_beh or a drain
# from its reply path, or its exit path), 0 anywhere else: a drain on another actor's stack
# (which installs the supervisor as the thread's CURRENT actor, so that word cannot be the
# test), main, or a dangerous actor's thread. The one place the restart-intensity breach and the
# duplicate-child-id failure make their synchronous root report, with the children shut down
# first (prims_actors_child_table_asm, Lmr_freq_escalate). What the thread identity (pthread_self
# against ACB #144) answered when a supervisor had a thread of its own. Frame: [rbp-8] sup.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_on_carrier_thread
	test	rdi, rdi
	jz	Lsod_no
	mov	rax, QWORD PTR [rdi + 40]
	xor	edi, edi
	cmp	rax, QWORD PTR [rbp - 8]
	sete	dil
	jmp	Lsod_ret
Lsod_no:
	xor	edi, edi
Lsod_ret:
	leave
	ret
	.globl	silica_rt_wait_park
	.p2align	4
silica_rt_wait_park:
# rdi = the carrier actor parking (on its own stack), rsi = the wait list it joins (the address of
# the head word: a row's +120 or a supervision block's +128; the links are ACB #456, the list is
# recorded in #480 for a stop to find), rdx = the thread's current actor to restore after the
# resume. Called with the actor's lock and the wait lock held: it publishes status 4 (parked)
# under both, releases them and leaves for the carrier loop. Returns, with no lock held, when the
# actor has been made ready again (by the list's wake or by a stop that unlinked it).
# Frame: [rbp-8] actor (x19), [rbp-16] list (x20), [rbp-24] current actor (x21), [rbp-32] carrier (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	rax, QWORD PTR [rdi + 440]
	mov	QWORD PTR [rbp - 32], rax
	call	silica_rt_ctx_save
	test	rdi, rdi
	jnz	Lwpk_resumed
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	r10, QWORD PTR [rcx]
	mov	QWORD PTR [rax + 456], r10
	mov	QWORD PTR [rcx], rax
	mov	QWORD PTR [rax + 480], rcx
	mov	QWORD PTR [rax + 448], 4
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
# The loop of the carrier this thread is ([rbp-32], read before the park was published).
	mov	rdi, QWORD PTR [rbp - 32]
	jmp	silica_rt_carrier_loop_enter
Lwpk_resumed:
# The carrier made this actor the thread's current actor at the resume; the wait was entered with
# [rbp-24] as the current actor (the supervisor, in an ingress drain).
	mov	rax, QWORD PTR [rbp - 24]
	cmp	rax, QWORD PTR [rbp - 8]
	je	Lwpk_ret
	mov	rdi, rax
	call	silica_rt_tls_actor_set
Lwpk_ret:
	leave
	ret
	.globl	silica_rt_wait_list_wake
	.p2align	4
silica_rt_wait_list_wake:
# rdi = the address of a wait list's head word: takes the whole list under the wait lock and makes
# every actor on it ready, each under its own lock, none under the wait lock. An actor on the list
# that is not parked cannot happen (it was parked under both locks, and only this wake or a stop,
# which unlinks it under the wait lock first, changes that): a runtime abort.
# Frame: [rbp-8] head word, then the next actor (x19), [rbp-16] the actor being woken (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax]
	mov	QWORD PTR [rax], 0
	mov	QWORD PTR [rbp - 16], rcx
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_unlock
Lwlw_wake:
	mov	rax, QWORD PTR [rbp - 16]
	test	rax, rax
	jz	Lwlw_ret
	mov	rcx, QWORD PTR [rax + 456]
	mov	QWORD PTR [rbp - 8], rcx
	lea	rdi, [rax + 16]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 16]
	cmp	QWORD PTR [rax + 448], 4
	jne	Lwlw_not_parked
	mov	QWORD PTR [rax + 480], 0
	mov	QWORD PTR [rax + 448], 2
	mov	rdi, rax
	call	silica_rt_carrier_push
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp - 16], rax
	jmp	Lwlw_wake
Lwlw_not_parked:
	lea	rdi, [rip + Lrta_r_row_wake]
	call	silica_rt_abort_with
Lwlw_ret:
	leave
	ret
	.globl	silica_rt_row_wait
	.p2align	4
silica_rt_row_wait:
# rdi = a row, rsi = the identity (ACB #408) of the child whose exit is waited for, rdx = 1 when that
# child is a carrier actor (0 = unknown), rcx = the waiting actor or 0 (main, or a wait that no stop
# may end). -> rdi = 1 once the row's exit_done (+56) holds that identity, 2 when rcx was ended
# meanwhile (its supervisor's cascade stops it while it waits in kill_abnormal: the wait is over
# and the victim is dead or dying). exit_done is a generation word, never cleared: the identity of
# the last child of the row that ended; a stale value from an earlier incarnation never matches.
# A carrier actor on its own stack parks on the row's wait list (the exit_done store wakes it, so
# does a stop of the waiter); anything else spins (main, a dangerous actor's thread). A runtime
# path on a carrier's own stack never comes here (every waiting path runs on the actor's own
# stack: the module header); when the awaited child is a carrier actor that is a runtime abort
# rather than a silent deadlock.
# Frame: [rbp-8] row (x19), [rbp-16] identity (x20), [rbp-24] the parking actor (x21),
# [rbp-32] child-is-carrier (x22), [rbp-40] the waiter, then the result (x23), [rbp-48] the
# current actor (x24).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 48
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 32], rdx
	mov	QWORD PTR [rbp - 40], rcx
	call	silica_rt_carrier_self_on_own_stack
	mov	QWORD PTR [rbp - 24], rdi
	test	rdi, rdi
	jz	Lrw_spin
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 48], rdi
Lrw_park_loop:
# The check and the push onto the row's wait list are one critical section under the wait lock
# (the exit side stores exit_done and takes the list under it; a stop sets the waiter's alive flag
# under the waiter's own lock), so no wake is lost.
	mov	rdi, QWORD PTR [rbp - 24]
	add	rdi, 16
	call	silica_rt_lock_lock
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 56]
	cmp	r10, QWORD PTR [rbp - 16]
	je	Lrw_done_locked
	mov	rcx, QWORD PTR [rbp - 40]
	test	rcx, rcx
	jz	Lrw_park
	cmp	DWORD PTR [rcx + 152], 0
	je	Lrw_stopped_locked
Lrw_park:
	mov	rdi, QWORD PTR [rbp - 24]
	mov	rsi, QWORD PTR [rbp - 8]
	add	rsi, 120
	mov	rdx, QWORD PTR [rbp - 48]
	call	silica_rt_wait_park
	jmp	Lrw_park_loop
Lrw_done_locked:
	mov	QWORD PTR [rbp - 40], 1
	jmp	Lrw_unlock_ret
Lrw_stopped_locked:
	mov	QWORD PTR [rbp - 40], 2
Lrw_unlock_ret:
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 24]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 40]
	jmp	Lrw_ret
Lrw_spin:
	cmp	QWORD PTR [rbp - 32], 0
	je	Lrw_spin_loop
	call	silica_rt_on_carrier_thread
	test	rdi, rdi
	jz	Lrw_spin_loop
	lea	rdi, [rip + Lrta_r_carrier_wait]
	call	silica_rt_abort_with
Lrw_spin_loop:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 56]
	cmp	r10, QWORD PTR [rbp - 16]
	je	Lrw_spin_done
	mov	rcx, QWORD PTR [rbp - 40]
	test	rcx, rcx
	jz	Lrw_spin_pause
	cmp	DWORD PTR [rcx + 152], 0
	jne	Lrw_spin_pause
	mov	edi, 2
	jmp	Lrw_ret
Lrw_spin_pause:
	pause
	jmp	Lrw_spin_loop
Lrw_spin_done:
	mov	edi, 1
Lrw_ret:
	leave
	ret
	.globl	silica_rt_row_exit_done_store
	.p2align	4
silica_rt_row_exit_done_store:
# rdi = a row whose child has ended (silica_rt_sb_child_done, the child's last act), rsi = that
# child's identity: exit_done (+56) = the identity, under the wait lock, then every carrier actor
# parked on the row's wait list (+120) is made ready; each re-checks the identity it waits for.
# Frame: [rbp-8] row (x19), [rbp-16] identity (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 56], rcx
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 120
	call	silica_rt_wait_list_wake
	leave
	ret
	.globl	silica_rt_actor_stop
	.p2align	4
silica_rt_actor_stop:
# rdi = an actor to end at its next dispatch boundary, rsi = the exit reason tag to give it (0 keeps
# what it has: a supervisor's own stop, reason 0 in its report), rdx = the reason atom that goes
# with a tag (#384; 0 = none). -> rdi = 1 when it is a carrier actor. The one way the runtime ends
# another actor: under the target's lock its alive flag goes, the reason (tag and atom) is set
# only while it was still alive (an actor already ending keeps its own), its
# mailbox is signalled (an idle carrier actor is made ready), and an actor parked on a wait list
# (a row's exit_done, a supervision block's restart token: #480 names the list) is unlinked under
# the wait lock and made ready, so a wait that this stop ends (kill_abnormal's) sees it at once. A
# parked actor the list's wake has already taken (not found on the list) is made ready by that wake.
# Frame: [rbp-8] actor (x19), [rbp-16] tag (x20), [rbp-24] atom, then the list (x21),
# [rbp-32] carrier (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	cmp	DWORD PTR [rax + 152], 0
	je	Lsto_was_ended
	mov	rcx, QWORD PTR [rbp - 16]
	test	rcx, rcx
	jz	Lsto_was_ended
	mov	QWORD PTR [rax + 232], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	test	rcx, rcx
	jz	Lsto_was_ended
	mov	QWORD PTR [rax + 384], rcx
Lsto_was_ended:
	mov	DWORD PTR [rax + 152], 0
	mov	rdi, rax
	call	silica_rt_actor_mail_signal
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 440]
	mov	QWORD PTR [rbp - 32], rcx
	test	rcx, rcx
	jz	Lsto_unlock
	cmp	QWORD PTR [rax + 448], 4
	jne	Lsto_unlock
	mov	rcx, QWORD PTR [rax + 480]
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	Lsto_unlock
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, QWORD PTR [rcx]
	xor	r11d, r11d
Lsto_find:
	test	r10, r10
	jz	Lsto_not_found
	cmp	r10, rax
	je	Lsto_found
	mov	r11, r10
	mov	r10, QWORD PTR [r10 + 456]
	jmp	Lsto_find
Lsto_found:
	mov	r8, QWORD PTR [rax + 456]
	test	r11, r11
	jz	Lsto_unlink_head
	mov	QWORD PTR [r11 + 456], r8
	jmp	Lsto_unlinked
Lsto_unlink_head:
	mov	QWORD PTR [rcx], r8
Lsto_unlinked:
	mov	QWORD PTR [rax + 480], 0
	mov	QWORD PTR [rax + 456], 0
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 448], 2
	mov	rdi, rax
	call	silica_rt_carrier_push
	jmp	Lsto_unlock
Lsto_not_found:
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_unlock
Lsto_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	xor	edi, edi
	cmp	QWORD PTR [rbp - 32], 0
	setne	dil
	leave
	ret
	.globl	silica_rt_sup_restart_try
	.p2align	4
silica_rt_sup_restart_try:
# rdi = a supervisor, rsi = the actor asking (0 = main). -> rdi = 1 when the caller now holds the
# supervisor's restart token (supervision block #120: the holder, or 1 for main), 0 when another
# holder has it, or the supervisor has no block or has ended. One holder at a time dequeues its
# ingress and runs the restarts (maybe_restart with its cascades), so no two cascades overlap.
# Frame: [rbp-8] supervisor (x19), [rbp-16] the asker, then the result (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 216]
	test	r10, r10
	jz	Lsrt_no
	cmp	DWORD PTR [rax + 152], 0
	je	Lsrt_no
	cmp	QWORD PTR [r10 + 120], 0
	jne	Lsrt_no
	mov	r11, QWORD PTR [rbp - 16]
	test	r11, r11
	jnz	Lsrt_take
	mov	r11d, 1
Lsrt_take:
	mov	QWORD PTR [r10 + 120], r11
	mov	QWORD PTR [rbp - 16], 1
	jmp	Lsrt_unlock
Lsrt_no:
	mov	QWORD PTR [rbp - 16], 0
Lsrt_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
	.globl	silica_rt_sup_restart_release
	.p2align	4
silica_rt_sup_restart_release:
# rdi = a supervisor whose restart token the caller holds: lets it go. Notices still in the ingress
# are the supervisor's own dispatch's to drain (its mailbox is signalled; the dispatch skips the
# ingress while another holder has the token), and every actor parked for the token (block +128)
# is made ready to re-check. Frame: [rbp-8] supervisor (x19), [rbp-16] its block (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 216]
	mov	QWORD PTR [rbp - 16], r10
	test	r10, r10
	jz	Lsrr_unlock
	mov	QWORD PTR [r10 + 120], 0
	mov	r11, QWORD PTR [r10]
	or	r11, QWORD PTR [r10 + 8]
	jz	Lsrr_unlock
	mov	rdi, rax
	call	silica_rt_actor_mail_signal
Lsrr_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 16]
	test	rdi, rdi
	jz	Lsrr_ret
	add	rdi, 128
	call	silica_rt_wait_list_wake
Lsrr_ret:
	leave
	ret
	.globl	silica_rt_sup_restart_acquire
	.p2align	4
silica_rt_sup_restart_acquire:
# rdi = a supervisor, rsi = the actor asking (0 = main), rdx = 1 to take the restart token, 0 to wait
# until the token is free and the ingress is empty (a row child of this supervisor never takes the
# token to DRAIN: the cascade it would run could stop the child itself; it waits for the holder, the
# supervisor's own dispatch or another drainer, to finish), 2 to take the token only once the
# ingress is empty (a row child holding the token across a terminate_child / restart_child of a
# sibling, supervisor_drain_hold: it waits as with 0, then holds with nothing to drain, so no
# cascade of a pending notice runs on it; a notice that arrives while it holds the token is the
# supervisor's own dispatch's after the release). -> rdi = 1 taken / settled, 2 when rsi
# was ended while it waited (its supervisor's cascade stops it: the caller's wait is over), 0 when
# the supervisor has no block or has ended (nothing to drain or wait for). A carrier actor on its
# own stack parks on the block's wait list (+128; a release wakes it, so does a stop of the
# waiter); anything else (main, a dangerous actor's thread) polls. Lock order everywhere: the
# waiting actor, then the supervisor, then the wait lock, then (in the push of a woken actor) its
# carrier's lock. The waiting actor may BE the supervisor (its reply path drains its own ingress,
# LBB1_reply_drain, on its own stack): the one lock is then taken once and serves both positions
# (the futex lock is not recursive).
# Frame: [rbp-8] supervisor (x19), [rbp-16] asker (x20), [rbp-24] take (x21), [rbp-32] the parking
# actor (x22), [rbp-40] result (x23), [rbp-48] current actor (x24), [rbp-56] block (x25).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 64
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	call	silica_rt_carrier_self_on_own_stack
	mov	QWORD PTR [rbp - 32], rdi
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 48], rdi
Lsra_loop:
	mov	rdi, QWORD PTR [rbp - 32]
	test	rdi, rdi
	jz	Lsra_lock_sup
	cmp	rdi, QWORD PTR [rbp - 8]
	je	Lsra_lock_sup
	add	rdi, 16
	call	silica_rt_lock_lock
Lsra_lock_sup:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	QWORD PTR [rbp - 40], 0
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 216]
	test	r10, r10
	jz	Lsra_unlock
	mov	QWORD PTR [rbp - 56], r10
	cmp	DWORD PTR [rax + 152], 0
	je	Lsra_unlock
	mov	rcx, QWORD PTR [rbp - 16]
	test	rcx, rcx
	jz	Lsra_self_ok
	cmp	DWORD PTR [rcx + 152], 0
	jne	Lsra_self_ok
	mov	QWORD PTR [rbp - 40], 2
	jmp	Lsra_unlock
Lsra_self_ok:
	cmp	QWORD PTR [r10 + 120], 0
	jne	Lsra_wait
	cmp	QWORD PTR [rbp - 24], 0
	je	Lsra_settle
	cmp	QWORD PTR [rbp - 24], 2
	jne	Lsra_take_now
# Mode 2: the token is free; take it only with an empty ingress, else wait for the supervisor's
# dispatch to serve the notices (each release wakes this actor to look again).
	mov	r11, QWORD PTR [r10]
	or	r11, QWORD PTR [r10 + 8]
	jnz	Lsra_wait
Lsra_take_now:
	mov	r11, QWORD PTR [rbp - 16]
	test	r11, r11
	jnz	Lsra_take
	mov	r11d, 1
Lsra_take:
	mov	QWORD PTR [r10 + 120], r11
	mov	QWORD PTR [rbp - 40], 1
	jmp	Lsra_unlock
Lsra_settle:
	mov	r11, QWORD PTR [r10]
	or	r11, QWORD PTR [r10 + 8]
	jnz	Lsra_wait
	mov	QWORD PTR [rbp - 40], 1
Lsra_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 32]
	test	rdi, rdi
	jz	Lsra_ret
	cmp	rdi, QWORD PTR [rbp - 8]
	je	Lsra_ret
	add	rdi, 16
	call	silica_rt_lock_unlock
	jmp	Lsra_ret
Lsra_wait:
	cmp	QWORD PTR [rbp - 32], 0
	je	Lsra_poll
# Park: the wait lock is taken before the supervisor's lock goes, so a release that follows cannot
# take the list before this actor is on it. When the parker is the supervisor itself its one lock
# stays held for silica_rt_wait_park, which releases it.
	lea	rdi, [rip + silica_rt_row_wait_lock]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 32]
	cmp	rax, QWORD PTR [rbp - 8]
	je	Lsra_park
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Lsra_park:
	mov	rdi, QWORD PTR [rbp - 32]
	mov	rsi, QWORD PTR [rbp - 56]
	add	rsi, 128
	mov	rdx, QWORD PTR [rbp - 48]
	call	silica_rt_wait_park
	jmp	Lsra_loop
Lsra_poll:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	edi, 50
	call	usleep
	jmp	Lsra_loop
Lsra_ret:
	mov	rdi, QWORD PTR [rbp - 40]
	leave
	ret
	.globl	silica_rt_carrier_for_core
	.p2align	4
silica_rt_carrier_for_core:
# rdi = a core id below silica_rt_logical_cpu_count -> rdi = the carrier block for it, `core mod N`
# (the carrier the same core id binds to at spawn), the table made if need be. Frame: [rbp-8] core.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_carriers_ensure
	mov	rcx, rdi
	mov	rax, QWORD PTR [rbp - 8]
	xor	edx, edx
	div	QWORD PTR [rip + silica_rt_carrier_count]
	shl	rdx, 8
	lea	rdi, [rcx + rdx]
	leave
	ret
	.globl	silica_rt_carrier_migrate
	.p2align	4
silica_rt_carrier_migrate:
# rdi = a carrier actor (#440 != 0), held by the caller, rsi = the target carrier block. -> rdi = 0
# (:ok, the move is requested or done) or 2 (:actor_not_found: it has ended). Under the actor's
# lock, by its status: idle (1) it is bound to the target at once (nothing of it is queued or
# listed, and mail for it takes this lock); idle on its carrier's sweep list (5) it is taken off
# that list (under the old carrier's lock), bound, and listed again on the target by
# silica_rt_carrier_mark_idle (under the target's lock; it joins the tail behind newer stamps, so
# it is released when the entry before it is, at most one idle period late); ready (2, queued on
# its carrier), running (3), parked (4, inside a dispatch) or being swept (6: its carrier's sweep
# holds it off the list and will release it or find it ready under this lock; never relisted here)
# the target is left pending in #512 and applied at the actor's next dispatch boundary
# (silica_rt_carrier_requeue, or silica_rt_carrier_mark_idle when the dispatch finds no mail),
# never while it runs and never at a resume: a parked actor resumes
# where it parked, inside the same dispatch. At most one carrier lock is held at any point, never
# with the target's and the old carrier's locks together, so the lock order of this module's
# header holds. The mailbox is the actor's own and moves with it; message order is unchanged.
# The target's thread is created first when it has none yet (nothing held); 3 (:migration_blocked)
# when the host refuses it (item N #5).
# Frame: [rbp-8] actor (x19), [rbp-16] target (x20), [rbp-24] result (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rdi, rsi
	call	silica_rt_carrier_ensure_started
	test	rdi, rdi
	jnz	Lcmg_blocked
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	cmp	DWORD PTR [rax + 152], 0
	je	Lcmg_ended
	mov	r10, QWORD PTR [rax + 448]
	cmp	r10, 1
	je	Lcmg_idle
	cmp	r10, 5
	je	Lcmg_listed
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 512], rcx
	jmp	Lcmg_ok
Lcmg_listed:
	mov	rdi, rax
	call	silica_rt_carrier_unlist
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 448], 1
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 440], rcx
	mov	rdi, rax
	call	silica_rt_carrier_mark_idle
	jmp	Lcmg_ok
Lcmg_idle:
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 440], rcx
Lcmg_ok:
	mov	QWORD PTR [rbp - 24], 0
	jmp	Lcmg_unlock
Lcmg_ended:
	mov	QWORD PTR [rbp - 24], 2
Lcmg_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 24]
	leave
	ret
Lcmg_blocked:
# The target has no thread and the host refused one (nothing held yet): 3, :migration_blocked.
	mov	edi, 3
	leave
	ret
	.globl	silica_rt_carrier_pick_kind
	.p2align	4
silica_rt_carrier_pick_kind:
# rdi = a carrier actor, rsi = 1 for a performance core, 0 for an efficiency core -> rdi = the carrier
# to move it to, or 0 when it stays: it is on a carrier of that kind already, or no carrier of
# that kind exists. Carrier i is the carrier of logical core i, and the topology the runtime
# reports (get_cpu_topology, get_performance_cores: the sysctl shim's hw.perflevel0 / 1) puts the
# P cores at [0, P) and the E cores at [P, P + E), so the P carriers are [0, min(P, N)) and the E
# carriers [P, N) (none when P >= N, as under a SILICA_CARRIER_COUNT below P, or when the machine
# reports no E cores: on Linux every core is a performance core, so none ever). Among the carriers
# of a kind the choice is in turn (silica_rt_pcore_next / ecore_next), a round robin per kind, so
# repeated pins spread over them, the hosted balance of the BEAM pattern; no exclusivity is implied.
# Frame: [rbp-8] the chosen index (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	rax, QWORD PTR [rdi + 440]
	mov	r9, QWORD PTR [rax + 112]
	mov	r10, QWORD PTR [rip + silica_rt_carrier_count]
	mov	r11, QWORD PTR [rip + silica_rt_pcore_count]
	test	r11, r11
	jnz	Lcpk_have_p
	mov	r11, r10
Lcpk_have_p:
	cmp	r11, r10
	jbe	Lcpk_p_clamped
	mov	r11, r10
Lcpk_p_clamped:
# r9 = the actor's carrier index, r10 = N, r11 = P clamped to N: P carriers [0, r11), E [r11, N).
	test	rsi, rsi
	jz	Lcpk_efficiency
	cmp	r9, r11
	jb	Lcpk_stay
	test	r11, r11
	jz	Lcpk_stay
	lea	r8, [rip + silica_rt_pcore_next]
	xor	ecx, ecx
	mov	rdx, r11
	jmp	Lcpk_turn
Lcpk_efficiency:
	cmp	r9, r11
	jae	Lcpk_stay
	cmp	r11, r10
	jae	Lcpk_stay
	lea	r8, [rip + silica_rt_ecore_next]
	mov	rcx, r11
	mov	rdx, r10
Lcpk_turn:
# The next index in turn over [rcx, rdx): the counter at r8 counts from 0 over the range's length.
	sub	rdx, rcx
	mov	rax, QWORD PTR [r8]
Lcpk_turn_loop:
	lea	rsi, [rax + 1]
	cmp	rsi, rdx
	jb	Lcpk_turn_store
	xor	esi, esi
Lcpk_turn_store:
	lock cmpxchg	QWORD PTR [r8], rsi
	jne	Lcpk_turn_loop
	cmp	rax, rdx
	jb	Lcpk_turn_in_range
	xor	eax, eax
Lcpk_turn_in_range:
	add	rax, rcx
	mov	QWORD PTR [rbp - 8], rax
	call	silica_rt_carriers_ensure
	mov	rax, QWORD PTR [rbp - 8]
	shl	rax, 8
	add	rdi, rax
	jmp	Lcpk_ret
Lcpk_stay:
	xor	edi, edi
Lcpk_ret:
	leave
	ret
	.globl	silica_rt_actor_carrier_index
	.p2align	4
silica_rt_actor_carrier_index:
# actor_carrier_index(ref) -> int64, a test-only query (trials/carriers_addition): the index of the
# carrier the actor is bound to now (#440, +112), -1 for a dangerous actor (a thread of its own)
# or a reference that names no actor. A pending migration is not reported until it is applied.
	lea	r10, [rip + silica_rt_actor_carrier_index_acb]
	jmp	silica_rt_ref_call
	.p2align	4
silica_rt_actor_carrier_index_acb:
	test	rdi, rdi
	jz	Laci_none
	mov	rax, QWORD PTR [rdi + 440]
	test	rax, rax
	jz	Laci_none
	mov	rdi, QWORD PTR [rax + 112]
	ret
Laci_none:
	mov	rdi, -1
	ret
	.globl	silica_rt_rq_push
	.p2align	4
silica_rt_rq_push:
# rdi = a carrier (its lock held), rsi = an actor its caller has made ready (status 2). Appends it
# to the tail of the queue the policy chooses: the actor's priority tier (ACB #520: 0 low, 1
# normal, 2 high -> queue 2 - level; a level above 2, never stored, counts as normal) or, under
# :round_robin (1), the normal queue, whatever the level, so ready actors run in arrival order.
# Leaf; rax r10 r11.
	mov	rax, QWORD PTR [rip + silica_rt_sched_policy]
	cmp	rax, 1
	je	Lrqp_normal
	mov	rax, QWORD PTR [rsi + 520]
	cmp	rax, 2
	ja	Lrqp_normal
	mov	r10d, 2
	sub	r10, rax
	jmp	Lrqp_have_q
Lrqp_normal:
	mov	r10d, 1
Lrqp_have_q:
	imul	r10, r10, 24
	lea	r10, [rdi + r10 + 128]
	inc	QWORD PTR [r10 + 16]
	mov	QWORD PTR [rsi + 456], 0
	mov	r11, QWORD PTR [r10 + 8]
	test	r11, r11
	jz	Lrqp_empty
	mov	QWORD PTR [r11 + 456], rsi
	mov	QWORD PTR [r10 + 8], rsi
	ret
Lrqp_empty:
	mov	QWORD PTR [r10], rsi
	mov	QWORD PTR [r10 + 8], rsi
	ret
	.globl	silica_rt_rq_take
	.p2align	4
silica_rt_rq_take:
# rdi = a carrier (its lock held), rsi = a queue index whose queue is not empty -> rdi = that queue's
# head, taken off it (its link cleared). Leaf; rax r10 r11.
	imul	r10, rsi, 24
	lea	r10, [rdi + r10 + 128]
	mov	rax, QWORD PTR [r10]
	mov	r11, QWORD PTR [rax + 456]
	mov	QWORD PTR [r10], r11
	test	r11, r11
	jnz	Lrqt_len
	mov	QWORD PTR [r10 + 8], 0
Lrqt_len:
	dec	QWORD PTR [r10 + 16]
	mov	QWORD PTR [rax + 456], 0
	mov	rdi, rax
	ret
	.globl	silica_rt_rq_pop
	.p2align	4
silica_rt_rq_pop:
# rdi = a carrier (its lock held) -> rdi = the next actor to run under the policy in force, 0 when
# every queue is empty.
#   :priority_fifo (0), and :round_robin (1), whose pushes all land in the normal queue: the head
#   of the highest-priority non-empty queue.
#   :weighted_fair (2): deficit round robin. The tier being served (+200) runs its head while it
#   has credit (+208) and actors, a unit cost per dispatch; otherwise the next tier starts with
#   its quantum (high 4, normal 2, low 1), an empty tier forfeiting its turn (DRR zeroes the
#   deficit of an idle queue). Some queue is non-empty, so at most three tier changes reach a
#   tier that runs.
#   :lottery (3): tickets = weight x actors queued, per tier, the same weights; a draw in
#   [0, total) picks the tier in proportion to its tickets and the tier's head runs. The
#   generator is a xorshift64 (Marsaglia 2003: 13, 7, 17) per carrier (+216, under this lock),
#   seeded from the clock and the carrier's index at the first draw, kept non-zero; nothing of
#   cryptographic strength is needed.
# Frame: [rbp-8] carrier (x19). rsi = the queue index handed to silica_rt_rq_take.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rip + silica_rt_sched_policy]
	cmp	rax, 2
	je	Lrqo_wf
	cmp	rax, 3
	je	Lrqo_lottery
	xor	esi, esi
Lrqo_scan:
	imul	r10, rsi, 24
	cmp	QWORD PTR [rdi + r10 + 128], 0
	jne	Lrqo_take
	inc	rsi
	cmp	rsi, 3
	jb	Lrqo_scan
	xor	edi, edi
	jmp	Lrqo_ret
Lrqo_take:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_rq_take
	jmp	Lrqo_ret
Lrqo_wf:
	mov	r10, QWORD PTR [rdi + 128]
	or	r10, QWORD PTR [rdi + 152]
	or	r10, QWORD PTR [rdi + 176]
	jnz	Lrqo_wf_have
	xor	edi, edi
	jmp	Lrqo_ret
Lrqo_wf_have:
	mov	rsi, QWORD PTR [rdi + 200]
	mov	rdx, QWORD PTR [rdi + 208]
Lrqo_wf_try:
	imul	r10, rsi, 24
	cmp	QWORD PTR [rdi + r10 + 128], 0
	je	Lrqo_wf_next
	test	rdx, rdx
	jz	Lrqo_wf_next
	dec	rdx
	mov	QWORD PTR [rdi + 200], rsi
	mov	QWORD PTR [rdi + 208], rdx
	jmp	Lrqo_take
Lrqo_wf_next:
	inc	rsi
	cmp	rsi, 3
	jb	Lrqo_wf_quantum
	xor	esi, esi
Lrqo_wf_quantum:
	mov	edx, 4
	test	rsi, rsi
	jz	Lrqo_wf_try
	mov	edx, 2
	cmp	rsi, 1
	je	Lrqo_wf_try
	mov	edx, 1
	jmp	Lrqo_wf_try
Lrqo_lottery:
	cmp	QWORD PTR [rdi + 216], 0
	jne	Lrqo_lot_seeded
	call	silica_rt_stack_now_ns
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 112]
	inc	r10
	shl	r10, 32
	xor	rdi, r10
	or	rdi, 1
	mov	QWORD PTR [rax + 216], rdi
	mov	rdi, rax
Lrqo_lot_seeded:
	mov	r10, QWORD PTR [rdi + 144]
	shl	r10, 2
	mov	r11, QWORD PTR [rdi + 168]
	shl	r11, 1
	mov	r8, QWORD PTR [rdi + 192]
	lea	r9, [r10 + r11]
	add	r9, r8
	test	r9, r9
	jnz	Lrqo_lot_draw
	xor	edi, edi
	jmp	Lrqo_ret
Lrqo_lot_draw:
	mov	rax, QWORD PTR [rdi + 216]
	mov	rcx, rax
	shl	rcx, 13
	xor	rax, rcx
	mov	rcx, rax
	shr	rcx, 7
	xor	rax, rcx
	mov	rcx, rax
	shl	rcx, 17
	xor	rax, rcx
	mov	QWORD PTR [rdi + 216], rax
	xor	edx, edx
	div	r9
	xor	esi, esi
	cmp	rdx, r10
	jb	Lrqo_take
	sub	rdx, r10
	mov	esi, 1
	cmp	rdx, r11
	jb	Lrqo_take
	mov	esi, 2
	jmp	Lrqo_take
Lrqo_ret:
	leave
	ret
	.globl	silica_rt_set_scheduler_policy
	.p2align	4
silica_rt_set_scheduler_policy:
# set_scheduler_policy(policy): rdi = the policy code (0 :priority_fifo, 1 :round_robin, 2
# :weighted_fair, 3 :lottery; the emitter maps the program's atoms to the codes and the result
# back, prims_actors emit_set_scheduler_policy_with_atoms) -> rdi = 0 (:ok) or 1 (:invalid_policy:
# any other code, the policy unchanged). One word for the process, read by every carrier at its
# next push or pop (this module's header says what happens to actors already queued). A
# dangerous actor, on a thread of its own, is scheduled by the OS and takes no part. Leaf.
	cmp	rdi, 4
	jae	Lssp_invalid
	mov	QWORD PTR [rip + silica_rt_sched_policy], rdi
	xor	edi, edi
	ret
Lssp_invalid:
	mov	edi, 1
	ret
	.globl	silica_rt_ctx_save
	.p2align	4
silica_rt_ctx_save:
# rdi = the current carrier actor, on its own stack. Saves rbp rbx r12-r15 and the eight dispatch
# frame slots of its carrier ([rbp_d - 8 .. rbp_d - 64], rbp_d = the carrier's base - 16: the
# module header) below the return address and records that SP in #464. Returns 0 at once with SP
# left lowered (the frame is live until the actor leaves for the carrier loop); returns 1, with SP,
# the registers and the slots restored, when the carrier resumes the actor (silica_rt_ctx_resume).
# Layout from the recorded SP: +0..+63 the slots, +64 pad, +72..+119 r15 r14 r13 r12 rbx rbp, +120
# the return address.
	push	rbp
	push	rbx
	push	r12
	push	r13
	push	r14
	push	r15
	sub	rsp, 72
	mov	r10, QWORD PTR [rdi + 440]
	mov	r10, QWORD PTR [r10 + 48]
	mov	rax, QWORD PTR [r10 - 24]
	mov	QWORD PTR [rsp], rax
	mov	rax, QWORD PTR [r10 - 32]
	mov	QWORD PTR [rsp + 8], rax
	mov	rax, QWORD PTR [r10 - 40]
	mov	QWORD PTR [rsp + 16], rax
	mov	rax, QWORD PTR [r10 - 48]
	mov	QWORD PTR [rsp + 24], rax
	mov	rax, QWORD PTR [r10 - 56]
	mov	QWORD PTR [rsp + 32], rax
	mov	rax, QWORD PTR [r10 - 64]
	mov	QWORD PTR [rsp + 40], rax
	mov	rax, QWORD PTR [r10 - 72]
	mov	QWORD PTR [rsp + 48], rax
	mov	rax, QWORD PTR [r10 - 80]
	mov	QWORD PTR [rsp + 56], rax
	mov	QWORD PTR [rdi + 464], rsp
	xor	edi, edi
	jmp	QWORD PTR [rsp + 120]
	.globl	silica_rt_ctx_resume
	.p2align	4
silica_rt_ctx_resume:
# rdi = a carrier actor with a parked context (#464); rbp = the carrier's dispatch frame (Lcar_resume
# runs with it). Never returns to its caller: the slots go back into the frame, then the actor
# continues after its silica_rt_ctx_save, with rdi = 1.
	mov	rsp, QWORD PTR [rdi + 464]
	mov	QWORD PTR [rdi + 464], 0
	mov	rax, QWORD PTR [rsp]
	mov	QWORD PTR [rbp - 8], rax
	mov	rax, QWORD PTR [rsp + 8]
	mov	QWORD PTR [rbp - 16], rax
	mov	rax, QWORD PTR [rsp + 16]
	mov	QWORD PTR [rbp - 24], rax
	mov	rax, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 32], rax
	mov	rax, QWORD PTR [rsp + 32]
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rsp + 40]
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rsp + 48]
	mov	QWORD PTR [rbp - 56], rax
	mov	rax, QWORD PTR [rsp + 56]
	mov	QWORD PTR [rbp - 64], rax
	add	rsp, 72
	pop	r15
	pop	r14
	pop	r13
	pop	r12
	pop	rbx
	pop	rbp
	mov	edi, 1
	ret
	.bss
	.p2align 3
# The timer table (spec §22.14.2; prims_actors_timer_asm.silica): +0 its lock (silica_rt_lock_*),
# +4 the condition word the service thread waits on (a futex seq word, silica_rt_cv_signal),
# +8 the heap (an array of timer records ordered by deadline, a binary min-heap), +16 its length,
# +24 its capacity, +32 the next timer number (never reused; 1 first), +40 the service thread
# started flag, +48 the identity map's first level (2^22 page pointers; a page is a live count and
# 4096 record pointers, indexed by the timer number's low 12 bits).
	.globl silica_rt_timers
.comm silica_rt_timers,64,8
	.text
# monotonic_time() -> int64: nanoseconds of CLOCK_MONOTONIC, the clock the deadlines use.
	.globl silica_rt_monotonic_time
	.p2align 4
silica_rt_monotonic_time:
	jmp silica_rt_stack_now_ns
# current_time() -> int64: milliseconds since the Unix epoch (CLOCK_REALTIME).
	.globl silica_rt_current_time
	.p2align 4
silica_rt_current_time:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	xor edi, edi
	mov rsi, rsp
	call clock_gettime
	mov rdi, QWORD PTR [rsp]
	imul rdi, rdi, 1000
	mov rax, QWORD PTR [rsp + 8]
	xor edx, edx
	mov ecx, 1000000
	div rcx
	add rdi, rax
	leave
	ret
# silica_rt_timer_prepare(rdi = the target's identity, rsi = the message (the copy's root), rdx = the
# mailbox buffer's bytes, rcx = its block; both 0 when the message is inline) -> rdi = a timer record
# (64 B: +0 number, +8 deadline, +16 target, +24 message, +32 the buffer block, +40 heap index, +48 the
# buffer's bytes), or 0 when there is no memory (the block is freed then). The inner half of send_after
# (emitter timer_cast; the message travels in a mailbox buffer as a cast's does).
	.globl silica_rt_timer_prepare
	.p2align 4
silica_rt_timer_prepare:
	push rbp
	mov rbp, rsp
	sub rsp, 32
	mov QWORD PTR [rbp - 8], rdi
	mov QWORD PTR [rbp - 16], rsi
	mov QWORD PTR [rbp - 24], rdx
	mov QWORD PTR [rbp - 32], rcx
	mov edi, 1
	mov esi, 64
	call calloc
	test rax, rax
	jz Ltp_none
	mov rcx, QWORD PTR [rbp - 8]
	mov QWORD PTR [rax + 16], rcx
	mov rcx, QWORD PTR [rbp - 16]
	mov QWORD PTR [rax + 24], rcx
	mov rcx, QWORD PTR [rbp - 32]
	mov QWORD PTR [rax + 32], rcx
	mov rcx, QWORD PTR [rbp - 24]
	mov QWORD PTR [rax + 48], rcx
	mov rdi, rax
	leave
	ret
Ltp_none:
	mov rdi, QWORD PTR [rbp - 32]
	test rdi, rdi
	jz Ltp_none_ret
	call free
Ltp_none_ret:
	xor edi, edi
	leave
	ret
# silica_rt_timer_release(rdi = record): a timer that will not be delivered frees its message's buffer
# block (+32, when there is one) and the record.
	.globl silica_rt_timer_release
	.p2align 4
silica_rt_timer_release:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov QWORD PTR [rbp - 8], rdi
	mov rdi, QWORD PTR [rdi + 32]
	test rdi, rdi
	jz Ltr_free
	call free
Ltr_free:
	mov rdi, QWORD PTR [rbp - 8]
	call free
	leave
	ret
# silica_rt_timer_fire(rdi = record): the cast, with the record's buffer words (bytes +48, block +32)
# as a cast site passes them: a delivered message's node owns the block from here on, and a dropped one
# (an ended or unknown target, a call-only one, §22.14.2) is freed by the cast itself (LBB3_7), so only
# the record goes here either way.
	.globl silica_rt_timer_fire
	.p2align 4
silica_rt_timer_fire:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov QWORD PTR [rbp - 8], rdi
	mov rsi, QWORD PTR [rdi + 24]
	mov rdx, QWORD PTR [rdi + 48]
	mov rcx, QWORD PTR [rdi + 32]
	mov rdi, QWORD PTR [rdi + 16]
	lea r10, [rip + silica_rt_actor_cast_flagged_buffered]
	call silica_rt_ref_call
	mov rdi, QWORD PTR [rbp - 8]
	call free
	leave
	ret
# The heap. Leaves; the table's lock is held by the caller.
	.p2align 4
silica_rt_timer_sift_up:
	lea r8, [rip + silica_rt_timers]
	mov r9, QWORD PTR [r8 + 8]
Ltsu_loop:
	test rdi, rdi
	jz Ltsu_done
	lea rcx, [rdi - 1]
	shr rcx, 1
	mov rax, QWORD PTR [r9 + rdi*8]
	mov rdx, QWORD PTR [r9 + rcx*8]
	mov rsi, QWORD PTR [rax + 8]
	mov r10, QWORD PTR [rdx + 8]
	cmp r10, rsi
	jle Ltsu_done
	mov QWORD PTR [r9 + rdi*8], rdx
	mov QWORD PTR [rdx + 40], rdi
	mov QWORD PTR [r9 + rcx*8], rax
	mov QWORD PTR [rax + 40], rcx
	mov rdi, rcx
	jmp Ltsu_loop
Ltsu_done:
	ret
	.p2align 4
silica_rt_timer_sift_down:
	lea r8, [rip + silica_rt_timers]
	mov r9, QWORD PTR [r8 + 8]
	mov r11, QWORD PTR [r8 + 16]
Ltsd_loop:
	lea rcx, [rdi + rdi + 1]
	cmp rcx, r11
	jae Ltsd_done
	mov rdx, rcx
	lea rsi, [rcx + 1]
	cmp rsi, r11
	jae Ltsd_pick
	mov rax, QWORD PTR [r9 + rcx*8]
	mov rax, QWORD PTR [rax + 8]
	mov r10, QWORD PTR [r9 + rsi*8]
	mov r10, QWORD PTR [r10 + 8]
	cmp r10, rax
	jge Ltsd_pick
	mov rdx, rsi
Ltsd_pick:
	mov rax, QWORD PTR [r9 + rdi*8]
	mov r10, QWORD PTR [r9 + rdx*8]
	mov rsi, QWORD PTR [rax + 8]
	mov rcx, QWORD PTR [r10 + 8]
	cmp rcx, rsi
	jge Ltsd_done
	mov QWORD PTR [r9 + rdi*8], r10
	mov QWORD PTR [r10 + 40], rdi
	mov QWORD PTR [r9 + rdx*8], rax
	mov QWORD PTR [rax + 40], rdx
	mov rdi, rdx
	jmp Ltsd_loop
Ltsd_done:
	ret
# silica_rt_timer_heap_remove(rdi = index): takes the record at that index out; the heap property
# is restored around the record moved into its place. Lock held.
	.p2align 4
silica_rt_timer_heap_remove:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov QWORD PTR [rbp - 8], rdi
	lea r8, [rip + silica_rt_timers]
	mov r9, QWORD PTR [r8 + 8]
	mov r11, QWORD PTR [r8 + 16]
	dec r11
	mov QWORD PTR [r8 + 16], r11
	cmp rdi, r11
	je Lthr_done
	mov rax, QWORD PTR [r9 + r11*8]
	mov QWORD PTR [r9 + rdi*8], rax
	mov QWORD PTR [rax + 40], rdi
	call silica_rt_timer_sift_down
	mov rdi, QWORD PTR [rbp - 8]
	call silica_rt_timer_sift_up
Lthr_done:
	leave
	ret
# silica_rt_timer_map_slot(rdi = timer number, esi = 1 to create the page, 0 to find only) -> rdi =
# the address of the number's slot, or 0 (no such page, a number beyond the map, no memory). Lock held.
	.p2align 4
silica_rt_timer_map_slot:
	push rbp
	mov rbp, rsp
	sub rsp, 32
	mov QWORD PTR [rbp - 8], rdi
	mov QWORD PTR [rbp - 16], rsi
	mov rax, rdi
	shr rax, 34
	jnz Ltms_none
	mov rcx, rdi
	shr rcx, 12
	mov QWORD PTR [rbp - 24], rcx
	lea r8, [rip + silica_rt_timers]
	mov r9, QWORD PTR [r8 + 48]
	test r9, r9
	jnz Ltms_l1
	test esi, esi
	jz Ltms_none
	mov edi, 4194304
	mov esi, 8
	call calloc
	test rax, rax
	jz Ltms_none
	lea r8, [rip + silica_rt_timers]
	mov QWORD PTR [r8 + 48], rax
	mov r9, rax
Ltms_l1:
	mov rcx, QWORD PTR [rbp - 24]
	mov r10, QWORD PTR [r9 + rcx*8]
	test r10, r10
	jnz Ltms_page
	cmp QWORD PTR [rbp - 16], 0
	je Ltms_none
	mov edi, 4097
	mov esi, 8
	call calloc
	test rax, rax
	jz Ltms_none
	lea r8, [rip + silica_rt_timers]
	mov r9, QWORD PTR [r8 + 48]
	mov rcx, QWORD PTR [rbp - 24]
	mov QWORD PTR [r9 + rcx*8], rax
	mov r10, rax
Ltms_page:
	mov rax, QWORD PTR [rbp - 8]
	and rax, 4095
	lea rdi, [r10 + rax*8 + 8]
	leave
	ret
Ltms_none:
	xor edi, edi
	leave
	ret
# silica_rt_timer_map_insert(rdi = timer number, rsi = record) -> rdi = 1 done, 0 no memory. Lock held.
	.p2align 4
silica_rt_timer_map_insert:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov QWORD PTR [rbp - 8], rdi
	mov QWORD PTR [rbp - 16], rsi
	mov esi, 1
	call silica_rt_timer_map_slot
	test rdi, rdi
	jz Ltmi_ret
	mov rax, QWORD PTR [rbp - 16]
	mov QWORD PTR [rdi], rax
	lea r8, [rip + silica_rt_timers]
	mov r9, QWORD PTR [r8 + 48]
	mov rcx, QWORD PTR [rbp - 8]
	shr rcx, 12
	mov r9, QWORD PTR [r9 + rcx*8]
	inc QWORD PTR [r9]
	mov edi, 1
Ltmi_ret:
	leave
	ret
# silica_rt_timer_map_remove(rdi = timer number): clears its slot; a page whose numbers have all
# been handed out and whose last live timer this was goes back. Lock held.
	.p2align 4
silica_rt_timer_map_remove:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov QWORD PTR [rbp - 8], rdi
	xor esi, esi
	call silica_rt_timer_map_slot
	test rdi, rdi
	jz Ltmr_ret
	mov QWORD PTR [rdi], 0
	lea r8, [rip + silica_rt_timers]
	mov r9, QWORD PTR [r8 + 48]
	mov rcx, QWORD PTR [rbp - 8]
	shr rcx, 12
	mov r10, QWORD PTR [r9 + rcx*8]
	dec QWORD PTR [r10]
	jnz Ltmr_ret
	lea rax, [rcx + 1]
	shl rax, 12
	cmp rax, QWORD PTR [r8 + 32]
	ja Ltmr_ret
	mov QWORD PTR [r9 + rcx*8], 0
	mov rdi, r10
	call free
Ltmr_ret:
	leave
	ret
# silica_rt_timer_cv_wait_ns(rdi = cv word, rsi = lock, rdx = nanoseconds): silica_rt_cv_wait with a
# timeout: futex(cv, FUTEX_WAIT | FUTEX_PRIVATE_FLAG, snapshot, &relative timespec); the waiter
# re-reads the heap on every wake, so a spurious or early return costs one more loop.
	.p2align 4
silica_rt_timer_cv_wait_ns:
	push rbp
	mov rbp, rsp
	sub rsp, 48
	mov QWORD PTR [rbp - 8], rdi
	mov QWORD PTR [rbp - 16], rsi
	mov rax, rdx
	xor edx, edx
	mov ecx, 1000000000
	div rcx
	mov QWORD PTR [rbp - 32], rax
	mov QWORD PTR [rbp - 24], rdx
	mov eax, DWORD PTR [rdi]
	mov QWORD PTR [rbp - 40], rax
	mov rdi, rsi
	call silica_rt_lock_unlock
	mov rdi, QWORD PTR [rbp - 8]
	mov esi, 128
	mov rdx, QWORD PTR [rbp - 40]
	lea r10, [rbp - 32]
	xor r8d, r8d
	xor r9d, r9d
	mov eax, 202
	syscall
	mov rdi, QWORD PTR [rbp - 16]
	call silica_rt_lock_lock
	leave
	ret
# The service thread: one per process, started by the first send_after. It sleeps on the condition
# word until the earliest deadline (or until a send_after puts an earlier timer at the head of the
# heap and signals), takes every due timer out under the lock, and casts with the lock released.
# It never blocks a carrier: the carriers only ever take the table's lock for the heap operations.
	.p2align 4
silica_rt_timer_thread_main:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_lock
Ltt_loop:
	lea r8, [rip + silica_rt_timers]
	cmp QWORD PTR [r8 + 16], 0
	jne Ltt_have
	lea rdi, [r8 + 4]
	mov rsi, r8
	call silica_rt_cv_wait
	jmp Ltt_loop
Ltt_have:
	mov r9, QWORD PTR [r8 + 8]
	mov rax, QWORD PTR [r9]
	mov QWORD PTR [rbp - 8], rax
	call silica_rt_stack_now_ns
	mov rax, QWORD PTR [rbp - 8]
	mov rcx, QWORD PTR [rax + 8]
	cmp rcx, rdi
	jle Ltt_fire
	mov rdx, rcx
	sub rdx, rdi
	lea r8, [rip + silica_rt_timers]
	lea rdi, [r8 + 4]
	mov rsi, r8
	call silica_rt_timer_cv_wait_ns
	jmp Ltt_loop
Ltt_fire:
	xor edi, edi
	call silica_rt_timer_heap_remove
	mov rax, QWORD PTR [rbp - 8]
	mov rdi, QWORD PTR [rax]
	call silica_rt_timer_map_remove
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_unlock
	mov rdi, QWORD PTR [rbp - 8]
	call silica_rt_timer_fire
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_lock
	jmp Ltt_loop
# silica_rt_send_after(rdi = delay_ms, rsi = the prepared record or 0) -> rdi = the timer number.
# The deadline is now + delay on the monotonic clock (saturating). A delay of 0 casts at once from
# the caller, so the message is ordered before anything the caller sends afterwards (§22.14.2); its
# number is already fired. A target that has ended means a timer cancelled already: the message is
# released and the number is never found. Otherwise the record enters the map and the heap, the
# service thread is started if it is not yet, and is woken when the new timer is the earliest.
# Frame: [rbp-8] delay, [rbp-16] record, [rbp-24] now, [rbp-32] deadline, [rbp-40] number, [rbp-48] tid.
	.globl silica_rt_send_after
	.p2align 4
silica_rt_send_after:
	push rbp
	mov rbp, rsp
	sub rsp, 48
	mov QWORD PTR [rbp - 8], rdi
	mov QWORD PTR [rbp - 16], rsi
	call silica_rt_stack_now_ns
	mov QWORD PTR [rbp - 24], rdi
	mov rax, QWORD PTR [rbp - 8]
	mov rcx, 9000000000000
	cmp rax, rcx
	ja Lsa_sat
	imul rax, rax, 1000000
	add rax, QWORD PTR [rbp - 24]
	jo Lsa_sat
	jmp Lsa_deadline
Lsa_sat:
	mov rax, 0x7FFFFFFFFFFFFFFF
Lsa_deadline:
	mov QWORD PTR [rbp - 32], rax
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_lock
	lea r8, [rip + silica_rt_timers]
	mov rax, QWORD PTR [r8 + 32]
	test rax, rax
	jnz Lsa_numbered
	mov eax, 1
Lsa_numbered:
	mov QWORD PTR [rbp - 40], rax
	lea rcx, [rax + 1]
	mov QWORD PTR [r8 + 32], rcx
	mov rsi, QWORD PTR [rbp - 16]
	test rsi, rsi
	jz Lsa_unlock_ret
	mov QWORD PTR [rsi], rax
	mov rcx, QWORD PTR [rbp - 32]
	mov QWORD PTR [rsi + 8], rcx
	cmp QWORD PTR [rbp - 8], 0
	je Lsa_now
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_unlock
	mov rax, QWORD PTR [rbp - 16]
	mov rdi, QWORD PTR [rax + 16]
	call silica_rt_ref_alive
	test rdi, rdi
	jz Lsa_drop
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_lock
	mov rdi, QWORD PTR [rbp - 40]
	mov rsi, QWORD PTR [rbp - 16]
	call silica_rt_timer_map_insert
	test rdi, rdi
	jz Lsa_unlock_drop
	lea r8, [rip + silica_rt_timers]
	mov rcx, QWORD PTR [r8 + 16]
	mov rdx, QWORD PTR [r8 + 24]
	cmp rcx, rdx
	jb Lsa_room
	add rdx, rdx
	test rdx, rdx
	jnz Lsa_cap
	mov edx, 64
Lsa_cap:
	mov QWORD PTR [r8 + 24], rdx
	mov rdi, QWORD PTR [r8 + 8]
	mov rsi, rdx
	shl rsi, 3
	call realloc
	test rax, rax
	jz Lsa_heap_oom
	lea r8, [rip + silica_rt_timers]
	mov QWORD PTR [r8 + 8], rax
Lsa_room:
	lea r8, [rip + silica_rt_timers]
	mov r9, QWORD PTR [r8 + 8]
	mov rcx, QWORD PTR [r8 + 16]
	mov rax, QWORD PTR [rbp - 16]
	mov QWORD PTR [r9 + rcx*8], rax
	mov QWORD PTR [rax + 40], rcx
	lea rdx, [rcx + 1]
	mov QWORD PTR [r8 + 16], rdx
	mov rdi, rcx
	call silica_rt_timer_sift_up
	lea r8, [rip + silica_rt_timers]
	cmp QWORD PTR [r8 + 40], 0
	jne Lsa_started
	lea rdi, [rbp - 48]
	xor esi, esi
	lea rdx, [rip + silica_rt_timer_thread_main]
	xor ecx, ecx
	call pthread_create
	test eax, eax
	jnz Lsa_started
	lea r8, [rip + silica_rt_timers]
	mov QWORD PTR [r8 + 40], 1
	mov rdi, QWORD PTR [rbp - 48]
	call pthread_detach
Lsa_started:
	mov rax, QWORD PTR [rbp - 16]
	cmp QWORD PTR [rax + 40], 0
	jne Lsa_unlock_ret
	lea rdi, [rip + silica_rt_timers + 4]
	call silica_rt_cv_signal
Lsa_unlock_ret:
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_unlock
Lsa_ret:
	mov rdi, QWORD PTR [rbp - 40]
	leave
	ret
Lsa_heap_oom:
	lea r8, [rip + silica_rt_timers]
	mov rax, QWORD PTR [r8 + 16]
	mov QWORD PTR [r8 + 24], rax
	mov rdi, QWORD PTR [rbp - 40]
	call silica_rt_timer_map_remove
Lsa_unlock_drop:
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_unlock
Lsa_drop:
	mov rdi, QWORD PTR [rbp - 16]
	call silica_rt_timer_release
	jmp Lsa_ret
Lsa_now:
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_unlock
	mov rdi, QWORD PTR [rbp - 16]
	call silica_rt_timer_fire
	jmp Lsa_ret
# silica_rt_cancel_timer(rdi = timer number) -> rdi = 0 :cancelled (the timer was pending and is
# now released, never delivered), 1 :not_found (it has fired, been cancelled, or its target has
# ended: such a timer is cancelled automatically, §22.14.2). Under the one lock a timer is either
# in the heap or not, so a cancel racing the service thread's pop yields exactly one of the two.
	.globl silica_rt_cancel_timer
	.p2align 4
silica_rt_cancel_timer:
	push rbp
	mov rbp, rsp
	sub rsp, 32
	mov QWORD PTR [rbp - 8], rdi
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_lock
	mov rdi, QWORD PTR [rbp - 8]
	xor esi, esi
	call silica_rt_timer_map_slot
	test rdi, rdi
	jz Lct_nf_unlock
	mov rax, QWORD PTR [rdi]
	test rax, rax
	jz Lct_nf_unlock
	mov QWORD PTR [rbp - 16], rax
	mov rdi, QWORD PTR [rbp - 8]
	call silica_rt_timer_map_remove
	mov rax, QWORD PTR [rbp - 16]
	mov rdi, QWORD PTR [rax + 40]
	call silica_rt_timer_heap_remove
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_unlock
	mov rax, QWORD PTR [rbp - 16]
	mov rdi, QWORD PTR [rax + 16]
	call silica_rt_ref_alive
	mov QWORD PTR [rbp - 24], rdi
	mov rdi, QWORD PTR [rbp - 16]
	call silica_rt_timer_release
	cmp QWORD PTR [rbp - 24], 0
	sete al
	movzx edi, al
	leave
	ret
Lct_nf_unlock:
	lea rdi, [rip + silica_rt_timers]
	call silica_rt_lock_unlock
	mov edi, 1
	leave
	ret

    .section .note.GNU-stack,"",@progbits

