	mov	rbx, QWORD PTR [rbp - 128]
	mov	QWORD PTR [rsp], rbx
	mov	rbx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rsp + 8], rbx
	lea	rsp, [rsp - 64]
	mov	QWORD PTR [rbp - 112], rdi
