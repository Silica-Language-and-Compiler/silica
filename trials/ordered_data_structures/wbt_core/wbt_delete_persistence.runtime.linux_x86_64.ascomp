Lsget_next:
	mov	r9, QWORD PTR [r9 + 80]
	jmp	Lsget_loop
Lsget_found:
	mov	rdi, QWORD PTR [r9 + 112]
	jmp	Lsget_done
Lsget_none:
# No live row holds the id (spec §15.4.8.3 :get_child names the child by id): no child.
	mov	rdi, -1
Lsget_done:
	leave
	ret
	.globl	silica_rt_supervisor_get_child_info
	.p2align	2
silica_rt_supervisor_get_child_info:
# rdi = the supervisor's reference: resolved and held for the body (silica_rt_sup_ref_call; an ended
# supervisor raises actor_not_found).
	lea	r10, [rip + silica_rt_supervisor_get_child_info_acb]
	jmp	silica_rt_sup_ref_call
	.globl	silica_rt_supervisor_get_child_info_acb
	.p2align	2
silica_rt_supervisor_get_child_info_acb:
# rdi = the held supervisor ACB, rsi = the child id -> rdi = the child-info record { id, agent_type, child,
# restart } (shape word + 4 fields, 40 bytes; an empty record with child -1 when no live row holds the id,
# spec §15.4.8.3). Chunk 15 stage 4e (design §9.1): the record is built below rsp in this frame ([rbp-24])
