	jmp	silica_rt_registry_name_taken

# Spawn path for the global PID registry primitive actor.
	.globl	silica_rt_pid_registry_init_spawn
	.p2align	2
silica_rt_pid_registry_init_spawn:
	push	rbp
	mov	rbp, rsp
	mov	edi, 1
	mov	rsi, QWORD PTR [rip + silica_registry_slots]
	shl	rsi, 4
	call	calloc
# spawn(X0 = init state, X1 = beh, X2 = core_id 0, X3 = 0, X4 = stack policy 0 = inherit) -> X0
	mov	rdi, rax
	lea	rsi, [rip + silica_rt_pid_registry_beh]
	xor	edx, edx
	xor	ecx, ecx
	xor	r8d, r8d
	xor	r14d, r14d
	lea	rax, [rip + silica_rt_runtime_spawner]
	mov	QWORD PTR [rip + silica_rt_spawn_rec_override], rax
	call	silica_rt_actor_spawn
	mov	QWORD PTR [rip + silica_rt_spawn_rec_override], 0
# The registries never end, so their ACBs are kept (not held) for the runtime's own use.
	call	silica_rt_ref_peek
	leave
	ret
# silica_pid_registry_init: called once at program start from emitter-injected main prologue.
