	mov	rbp, rsp
	call	silica_rt_ref_alive
	mov	rax, rdi
	pop	rbp
	ret
Lrhi_no:
	xor	eax, eax
	ret
# silica_rt_registry_name_held(rdi = atom) -> rax = 1 when the ordinary registry holds the name for a
