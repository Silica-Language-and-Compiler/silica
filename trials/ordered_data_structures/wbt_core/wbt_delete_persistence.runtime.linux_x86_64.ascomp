	mov	r10, QWORD PTR [rsp]
	cmp	r10, 0
	je	Lstc_ml_fin
	mov	r11, QWORD PTR [rsp + 8]
	mov	r12, QWORD PTR [rsp + 16]
	cmp	r11, r12
