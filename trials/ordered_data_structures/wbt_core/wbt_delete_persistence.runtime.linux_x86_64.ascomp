	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	Lfp_out
	xor	esi, esi
Lfp_len:
	movzx	edx, BYTE PTR [rdi + rsi]
	test	edx, edx
	jz	Lfp_w
	inc	rsi
	jmp	Lfp_len
Lfp_w:
	test	rsi, rsi
	jz	Lfp_out
	mov	rdx, rsi
	mov	rsi, rdi
	mov	edi, 2
	call	write
Lfp_out:
	leave
	ret
	.p2align	4
silica_rt_fault_puthex:
# rdi = value: write(2, 16 hex digits).
