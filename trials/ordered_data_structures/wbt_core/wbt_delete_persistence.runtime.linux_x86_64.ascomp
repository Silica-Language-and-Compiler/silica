	mov	QWORD PTR [rbp - 96], 1
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 544], 0
	jmp	Lsde_policy
Lsde_scalar:
# A scalar new state of a DESCRIBED type (an atom replacing a record or a buffer) reaches no node. An
# unproven behaviour, or a compaction request, takes the fallback as a pointer state does: copy_all of a
# scalar root measures 0, copies nothing and leaves an empty area (every old node, buffers included, is
# dropped; the state policy then applies as after any compaction). A proven one frees the old root shell
# as on the evacuating path, then drains the log (which holds the old buffers the epilogue retired). A
# state type with no descriptor has no nodes: only the log is drained.
