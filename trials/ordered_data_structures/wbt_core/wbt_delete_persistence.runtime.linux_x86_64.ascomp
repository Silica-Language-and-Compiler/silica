	mov	r10, QWORD PTR [rax + 8]
	cmp	r10, 0
	je	Lstc_ml_chunk_new
	mov	rax, QWORD PTR [rbp - 64]
	mov	r11, QWORD PTR [rax + 24]
	mov	rax, QWORD PTR [rbp - 120]
	cmp	rax, r11
	jb	Lstc_ml_chunk_new
	mov	rax, QWORD PTR [rbp - 64]
	mov	r11, QWORD PTR [rax + 32]
	mov	rax, QWORD PTR [rbp - 120]
	cmp	rax, r11
	jae	Lstc_ml_chunk_new
	mov	r12, QWORD PTR [rsp + 32]
	mov	rbx, QWORD PTR [rbp - 120]
	mov	QWORD PTR [r12], rbx
	jmp	Lstc_ml_done
Lstc_ml_chunk_new:
	mov	r10, QWORD PTR [rsp + 16]
	lea	r15, [r10 + 16]
	call	Lstc_bump
	mov	r12, QWORD PTR [rsp + 32]
	mov	QWORD PTR [r12], rsi
	mov	r10, QWORD PTR [rsp + 16]
	lea	r10, [r10 + 16]
	mov	r11, 0
Lstc_ml_copy:
	cmp	r11, r10
	jae	Lstc_ml_copied
	mov	rax, QWORD PTR [rbp - 120]
	mov	r12, QWORD PTR [rax + r11]
	mov	QWORD PTR [rdi + r11], r12
	lea	r11, [r11 + 8]
	jmp	Lstc_ml_copy
Lstc_ml_copied:
	mov	QWORD PTR [rbp - 120], rdi
	mov	r10, QWORD PTR [rsp + 16]
	mov	rax, QWORD PTR [rbp - 120]
	lea	rax, [rax + r10]
	mov	r10, rax
	mov	QWORD PTR [rsp + 32], r10
	mov	rax, QWORD PTR [rbp - 128]
	mov	r10, QWORD PTR [rax + 16]
