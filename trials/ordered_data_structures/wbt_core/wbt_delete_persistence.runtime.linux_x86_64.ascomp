	jmp	Lsde_drain
Lsde_scalar_undescribed:
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 560]
	cmp	r10, 0
	je	Lsde_policy
	jmp	Lsde_drain
Lsde_policy:
	cmp	QWORD PTR [rbp - 112], 0
	je	Lsde_policy_go
