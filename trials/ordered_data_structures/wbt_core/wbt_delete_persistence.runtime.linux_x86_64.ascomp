	mov	QWORD PTR [rbp - 56], rcx
	mov	QWORD PTR [rdi + 16], rcx
	mov	rcx, QWORD PTR [rax + 112]
	mov	QWORD PTR [rdi + 24], rcx
	mov	rcx, QWORD PTR [rax + 40]
	mov	QWORD PTR [rbp - 64], rcx
