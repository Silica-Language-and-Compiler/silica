# No retained-buffer test here (the pin rule): a retained buffer exists only in the behaviour
# spawn_dangerous installs (E4041), that behaviour is proven (E4037) and returns to the runtime through
# its own epilogue's flag, and its spawn's state_policy(:keep_state_area) (E4036) makes compact_state()
# a no-op, so a pinned actor never reaches the fallback.
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, QWORD PTR [rbp - 64]
	mov	rdx, QWORD PTR [rbp - 72]
