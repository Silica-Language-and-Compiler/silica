	.globl	silica_rt_get_cpu_topology
	.p2align	2
silica_rt_get_cpu_topology:
# Frame: [rbp-8] w19 P-cores, [rbp-16] w20 E-cores, [rbp-24] w21 total, [rbp-32] x22 cores list,
# [rbp-40] x23 scratch node, [rbp-48] x24 / [rbp-80] x28 core-id range list, [rbp-56] x25 cache levels,
# [rbp-64] x26 caps / numa list, [rbp-72] x27 memsize; [rbp-88] w9 loop counter and [rbp-96] w10
# are kept in the frame because the calls clobber r10/r11; [rbp-112] / [rbp-104] the destination pair
# (the AArch64 [x29, #96]). The sysctl scratch pair lives at [rsp], [rsp+8].
	push	rbp
	mov	rbp, rsp
	sub	rsp, 112
	sub	rsp, 16
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf0_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_topo_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 8], rax
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf1_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_topo_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 16], rax
	add	rsp, 16
	mov	eax, DWORD PTR [rbp - 8]
	add	eax, DWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 24], rax
	test	eax, eax
	jz	L_topo_fail_zero
# Chunk 15 stage 4e (design §9.1): every list, string and record of the answer is built in a destination
# area reserved here in this frame's dynamic part (256 bytes per core plus 2048: ample for the caps list,
# the core records and their array, five lists, two node records, the cache levels and the record itself;
# silica_rt_dest_take aborts on an overrun), its pair at [rbp-112]. L_topo_epilogue lowers rsp onto what
# was taken and leaves through rbp, and the emitted call site adopts the area into the caller's frame.
	mov	eax, DWORD PTR [rbp - 24]
	shl	rax, 8
	add	rax, 2048
	mov	r10, rsp
	sub	rsp, rax
	mov	QWORD PTR [rbp - 112], r10
	mov	QWORD PTR [rbp - 104], rsp
	lea	rdi, [rbp - 112]
	call	silica_rt_apple_hw_optional_caps_list
	mov	QWORD PTR [rbp - 64], rdi
# cores: one boxed core_info (40 bytes: shape word, id, core_type, capabilities, frequency_mhz) per
# id, its pointer in an id-ordered word array ([rbp-96], destination), then the List[core_info] handle
# built over the array by silica_rt_build_list_from_words into [rbp-32]. The record lists
# get_cpu_topology answers (cores, numa_nodes, memory_ranges, cache levels) were 16-byte
# {record, next} cons cells until 2026-10-20, which compiled code read as a list handle:
# length(top.cores) was the first record's address and any walk of the list faulted. The loop
# index is [rbp-88], ascending.
	mov	esi, DWORD PTR [rbp - 24]
	shl	rsi, 3
	lea	rdi, [rbp - 112]
	call	silica_rt_dest_take
	mov	QWORD PTR [rbp - 96], rdi
	mov	QWORD PTR [rbp - 88], 0
L_topo_core_loop:
	mov	rax, QWORD PTR [rbp - 88]
	cmp	eax, DWORD PTR [rbp - 24]
	jae	L_topo_after_cores
	lea	rdi, [rbp - 112]
	mov	esi, 40
	call	silica_rt_dest_take
	mov	QWORD PTR [rbp - 40], rdi
	mov	QWORD PTR [rdi], 65537
	mov	r11, QWORD PTR [rbp - 88]
	mov	QWORD PTR [rdi + 8], r11
	cmp	r11d, DWORD PTR [rbp - 8]
	setl	al
	movzx	eax, al
	mov	QWORD PTR [rdi + 16], rax
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rdi + 24], rax
	mov	QWORD PTR [rdi + 32], 0
	mov	rax, QWORD PTR [rbp - 96]
	mov	QWORD PTR [rax + r11*8], rdi
	add	r11, 1
	mov	QWORD PTR [rbp - 88], r11
	jmp	L_topo_core_loop
L_topo_after_cores:
	mov	rdi, QWORD PTR [rbp - 96]
	mov	esi, DWORD PTR [rbp - 24]
	lea	rdx, [rbp - 112]
	call	silica_rt_build_list_from_words
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 32], rdi
	xor	edi, edi
	mov	esi, DWORD PTR [rbp - 24]
	lea	rdx, [rbp - 112]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 48], rdi
	mov	QWORD PTR [rbp - 80], rdi
	lea	rdi, [rip + L_hw_memsize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 72], rdi
	lea	rdi, [rbp - 112]
	mov	esi, 32
	call	silica_rt_dest_take
# memory_range: one NUMA node (Apple Silicon has no multi-domain sysctl matrix). start=0 = domain origin in this layout;
# macOS sysctl does not expose physical DRAM base per node — size is real (hw.memsize bytes). latency=0 = local self-
# distance (ACPI SLIT-style relative units: same node as itself), not an OS picoseconds value.
	mov	QWORD PTR [rdi], 65540
	mov	QWORD PTR [rdi + 8], 0
	mov	rax, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rdi + 16], rax
	mov	QWORD PTR [rdi + 24], 0
# memory_ranges = [that record]: a one-word array on the stack, then the list over it.
	lea	rsp, [rsp - 16]
	mov	QWORD PTR [rsp], rdi
	mov	rdi, rsp
	mov	esi, 1
	lea	rdx, [rbp - 112]
	call	silica_rt_build_list_from_words
	lea	rsp, [rsp + 16]
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 40], rdi
	lea	rdi, [rbp - 112]
	mov	esi, 32
	call	silica_rt_dest_take
	mov	QWORD PTR [rdi], 65539
	mov	QWORD PTR [rdi + 8], 0
	mov	rax, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rdi + 16], rax
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rdi + 24], rax
# numa_nodes = [that record], the same way.
	lea	rsp, [rsp - 16]
	mov	QWORD PTR [rsp], rdi
	mov	rdi, rsp
	mov	esi, 1
	lea	rdx, [rbp - 112]
	call	silica_rt_build_list_from_words
	lea	rsp, [rsp + 16]
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 64], rdi
	mov	edi, DWORD PTR [rbp - 8]
	mov	esi, DWORD PTR [rbp - 16]
	mov	edx, DWORD PTR [rbp - 24]
	mov	rcx, QWORD PTR [rbp - 80]
	lea	r8, [rbp - 112]
	call	silica_rt_apple_build_cache_levels
	mov	QWORD PTR [rbp - 56], rdi
	lea	rdi, [rbp - 112]
	mov	esi, 32
	call	silica_rt_dest_take
	mov	QWORD PTR [rdi], 65538
	mov	rax, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rdi + 8], rax
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rdi + 16], rax
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rdi + 24], rax
	jmp	L_topo_epilogue
L_topo_sysctl_fail:
	add	rsp, 16
L_topo_fail_zero:
# sysctl or zero-core failure: still a non-NULL 32-byte record (shape word; cores, numa_nodes,
# cache_hierarchy pointers all nil) so Silica callers can field-load and length(empty) without a fault,
# built below rsp in this frame (a destination area reserved before the failure lies above it and is
# adopted with it).
	sub	rsp, 32
	mov	rdi, rsp
	mov	QWORD PTR [rdi], 65538
	mov	QWORD PTR [rdi + 8], 0
	mov	QWORD PTR [rdi + 16], 0
	mov	QWORD PTR [rdi + 24], 0
	jmp	L_topo_leave
L_topo_epilogue:
	mov	rax, QWORD PTR [rbp - 112]
	and	rax, -16
	mov	rsp, rax
L_topo_leave:
# rsp stays on the answer: the frame is left through rbp, never popped (silica_rt_actor_call's leave).
	mov	rax, QWORD PTR [rbp + 8]
	mov	rbp, QWORD PTR [rbp]
	jmp	rax
	.globl	silica_rt_get_core_capabilities
	.p2align	2
silica_rt_get_core_capabilities:
# Frame: [rbp-8] w19 P-cores, [rbp-16] w20 E-cores, [rbp-24] w21 total, [rbp-40] x23 record, [rbp-80] x28 requested id,
# [rbp-112] / [rbp-104] the destination pair.
# Chunk 15 stage 4e (design §9.1): the core_info record and its capabilities list (40 + 344 bytes at
# most) are built in a 400-byte destination area reserved below this frame (its pair at [rbp-112]);
# L_cap_epilogue lowers rsp onto what was taken and leaves through rbp, and the emitted call site adopts
# the area into the caller's frame.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 112
	mov	QWORD PTR [rbp - 80], rdi
	mov	r10, rsp
	sub	rsp, 400
	mov	QWORD PTR [rbp - 112], r10
	mov	QWORD PTR [rbp - 104], rsp
	sub	rsp, 16
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf0_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_cap_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 8], rax
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf1_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_cap_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 16], rax
	add	rsp, 16
	mov	eax, DWORD PTR [rbp - 8]
	add	eax, DWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 24], rax
# Only scratch registers (rax, rcx, r10, r11) are used here: compiled callers keep nothing in a
# machine register across a call on this target (regs/README.md, X19..X28 are frame slots), but
# rbx is the X8 sret home and r12 a helper scratch, so neither is touched. The AArch64 routines
# save x27/x28 for the same defect (a caller's live x28 binding read back as the core id).
	mov	rax, QWORD PTR [rbp - 80]
	cmp	rax, 0
	jl	L_cap_emit_sentinel
	mov	r11d, DWORD PTR [rbp - 24]
	cmp	rax, r11
	jae	L_cap_emit_sentinel
	lea	rdi, [rbp - 112]
	mov	esi, 40
	call	silica_rt_dest_take
	mov	QWORD PTR [rbp - 40], rdi
	mov	QWORD PTR [rdi], 65537
	mov	rax, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rdi + 8], rax
	mov	r10d, DWORD PTR [rbp - 8]
	cmp	rax, r10
	setl	cl
	movzx	ecx, cl
	mov	QWORD PTR [rdi + 16], rcx
	lea	rdi, [rbp - 112]
	call	silica_rt_apple_hw_optional_caps_list
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 24], rdi
	mov	QWORD PTR [rax + 32], 0
	mov	rdi, rax
	jmp	L_cap_epilogue
L_cap_sysctl_fail:
	add	rsp, 16
	jmp	L_cap_emit_sentinel
# Failure: a core_info with id=-1 (sentinel); core_type=0 (:efficiency); caps/freq zero: distinguish from valid id>=0.
L_cap_emit_sentinel:
	lea	rdi, [rbp - 112]
	mov	esi, 40
	call	silica_rt_dest_take
	mov	QWORD PTR [rdi], 65537
	mov	QWORD PTR [rdi + 8], -1
	mov	QWORD PTR [rdi + 16], 0
	mov	QWORD PTR [rdi + 24], 0
	mov	QWORD PTR [rdi + 32], 0
L_cap_epilogue:
	mov	rax, QWORD PTR [rbp - 112]
	and	rax, -16
	mov	rsp, rax
	mov	rax, QWORD PTR [rbp + 8]
	mov	rbp, QWORD PTR [rbp]
	jmp	rax
	.globl	silica_rt_get_efficiency_cores # -- Begin function silica_rt_get_efficiency_cores
	.p2align	2
silica_rt_get_efficiency_cores: # @silica_rt_get_efficiency_cores
# %bb.0: query P-core count (offset) then E-core count, build list [p..p+e-1]. Chunk 15 stage 4e
# (design §9.1): the list is built in a destination area reserved in this frame (24 + 32 * ((e + 1) / 2)
# bytes and slack, its pair at [rbp-32] / [rbp-24]); the leave lowers rsp onto it and goes through rbp,
# and the emitted call site adopts it. An empty list (e <= 0) or a sysctl failure answers 0 with rsp as
# it was.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	sub	rsp, 16
	mov	QWORD PTR [rsp + 8], 4
	mov	QWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf0_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	LBBec_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 8], rax
	mov	QWORD PTR [rsp + 8], 4
	mov	QWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf1_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	LBBec_fail
	mov	esi, DWORD PTR [rsp]
	add	rsp, 16
	cmp	esi, 0
	jle	LBBec_nil
	lea	rax, [rsi + 1]
	shr	rax, 1
	shl	rax, 5
	add	rax, 48
	and	rax, -16
	mov	r10, rsp
	sub	rsp, rax
	mov	QWORD PTR [rbp - 32], r10
	mov	QWORD PTR [rbp - 24], rsp
	mov	rdi, QWORD PTR [rbp - 8]
	lea	rdx, [rbp - 32]
	call	silica_rt_build_int_range_list
	mov	rax, QWORD PTR [rbp - 32]
	and	rax, -16
	mov	rsp, rax
	mov	rax, QWORD PTR [rbp + 8]
	mov	rbp, QWORD PTR [rbp]
	jmp	rax
LBBec_fail:
	add	rsp, 16
LBBec_nil:
	xor	edi, edi
	leave
	ret
                                        # -- End function
	.globl	silica_rt_get_performance_cores # -- Begin function silica_rt_get_performance_cores
	.p2align	2
silica_rt_get_performance_cores: # @silica_rt_get_performance_cores
# %bb.0: query P-core count, build list [0..count-1]; the destination area and the adopting leave as in
# silica_rt_get_efficiency_cores (chunk 15 stage 4e).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	sub	rsp, 16
	mov	QWORD PTR [rsp + 8], 4
	mov	QWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf0_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	LBBpc_fail
	mov	esi, DWORD PTR [rsp]
	add	rsp, 16
	cmp	esi, 0
	jle	LBBpc_nil
	lea	rax, [rsi + 1]
	shr	rax, 1
	shl	rax, 5
	add	rax, 48
	and	rax, -16
	mov	r10, rsp
	sub	rsp, rax
	mov	QWORD PTR [rbp - 32], r10
	mov	QWORD PTR [rbp - 24], rsp
	xor	edi, edi
	lea	rdx, [rbp - 32]
	call	silica_rt_build_int_range_list
	mov	rax, QWORD PTR [rbp - 32]
	and	rax, -16
	mov	rsp, rax
	mov	rax, QWORD PTR [rbp + 8]
	mov	rbp, QWORD PTR [rbp]
	jmp	rax
LBBpc_fail:
	add	rsp, 16
LBBpc_nil:
	xor	edi, edi
	leave
	ret
                                        # -- End function
	.globl	silica_rt_pin_actor_to_core # -- Begin function silica_rt_pin_actor_to_core
	.p2align	2
silica_rt_pin_actor_to_core:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_pin_actor_to_core_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_pin_actor_to_core_acb: # @silica_rt_pin_actor_to_core
# rdi = ACB (held) or 0, rsi = core id. A shorthand for migrate_actor (spec §15.1.2: the pin_actor_to_*
# helpers migrate to a chosen core): a carrier actor moves to the core's carrier (item N stage
# 3), a dangerous actor's thread gets the affinity hint. The result word is 0 whatever
# migrate_actor answered: the (int64, affinity_error) tuple of §22.10 is not materialised by any
# emitter, which is pre-existing, and the program's view of it is this word.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_migrate_actor_acb
	xor	edi, edi
	pop	rbp
	ret
                                        # -- End function
	.globl	silica_rt_pin_actor_to_efficiency_core # -- Begin function silica_rt_pin_actor_to_efficiency_core
	.p2align	2
silica_rt_pin_actor_to_efficiency_core:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_pin_actor_to_efficiency_core_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_pin_actor_to_efficiency_core_acb: # @silica_rt_pin_actor_to_efficiency_core
	test	rdi, rdi
	jz	Lpin_actor_to_efficiency_core_none
# A carrier actor (#144 = 0, item N stage 3) moves to an efficiency-core carrier chosen by
# silica_rt_carrier_pick_kind (none when it is on one already, or the machine or the carrier
# count has none: on Linux every core is a performance core); the result word is 0 as for
# pin_actor_to_core. Frame: [rbp-8] ACB.
	cmp	QWORD PTR [rdi + 144], 0
	jne	Lpin_actor_to_efficiency_core_thread
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	xor	esi, esi
	call	silica_rt_carrier_pick_kind
	test	rdi, rdi
	jz	Lpin_actor_to_efficiency_core_stay
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_carrier_migrate
Lpin_actor_to_efficiency_core_stay:
	xor	edi, edi
	leave
	ret
Lpin_actor_to_efficiency_core_thread:
# %bb.0: X0=actor_ref; pin to any E-core via affinity tag 0x45 ('E')
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	rdi, QWORD PTR [rdi + 144]
	call	silica_rt_pthread_mach_thread_np
	mov	QWORD PTR [rbp - 16], rdi
	sub	rsp, 16
	mov	DWORD PTR [rsp], 0x45
	mov	rdi, QWORD PTR [rbp - 16]
	mov	esi, 4
	mov	rdx, rsp
	mov	ecx, 1
	call	silica_rt_thread_policy_set
	add	rsp, 16
	leave
	ret
Lpin_actor_to_efficiency_core_none:
	xor	edi, edi
	ret
                                        # -- End function
	.globl	silica_rt_pin_actor_to_performance_core # -- Begin function silica_rt_pin_actor_to_performance_core
	.p2align	2
silica_rt_pin_actor_to_performance_core:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_pin_actor_to_performance_core_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_pin_actor_to_performance_core_acb: # @silica_rt_pin_actor_to_performance_core
	test	rdi, rdi
	jz	Lpin_actor_to_performance_core_none
# A carrier actor (#144 = 0, item N stage 3) moves to a performance-core carrier chosen by
# silica_rt_carrier_pick_kind (none when it is on one already); the result word is 0 as for
# pin_actor_to_core. Frame: [rbp-8] ACB.
	cmp	QWORD PTR [rdi + 144], 0
	jne	Lpin_actor_to_performance_core_thread
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	esi, 1
	call	silica_rt_carrier_pick_kind
	test	rdi, rdi
	jz	Lpin_actor_to_performance_core_stay
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_carrier_migrate
Lpin_actor_to_performance_core_stay:
	xor	edi, edi
	leave
	ret
Lpin_actor_to_performance_core_thread:
# %bb.0: X0=actor_ref; pin to any P-core via affinity tag 0x50 ('P')
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	rdi, QWORD PTR [rdi + 144]
	call	silica_rt_pthread_mach_thread_np
	mov	QWORD PTR [rbp - 16], rdi
	sub	rsp, 16
	mov	DWORD PTR [rsp], 0x50
	mov	rdi, QWORD PTR [rbp - 16]
	mov	esi, 4
	mov	rdx, rsp
	mov	ecx, 1
	call	silica_rt_thread_policy_set
	add	rsp, 16
	leave
	ret
Lpin_actor_to_performance_core_none:
	xor	edi, edi
	ret
                                        # -- End function
	.globl	silica_rt_pin_actor_realtime # -- Begin function silica_rt_pin_actor_realtime
	.p2align	2
silica_rt_pin_actor_realtime: # @silica_rt_pin_actor_realtime
# %bb.0: X0=actor_ref; stub (realtime policy requires THREAD_TIME_CONSTRAINT_POLICY)
	xor	edi, edi
