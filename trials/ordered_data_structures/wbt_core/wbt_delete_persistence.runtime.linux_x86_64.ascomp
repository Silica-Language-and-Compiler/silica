	mov	rax, 2
	mov	QWORD PTR [rdi], rax
	mov	QWORD PTR [rdi + 8], rcx
	jmp	L_pidreg_done
L_pidreg_name_taken:
	mov	rax, 86
	mov	QWORD PTR [rdi], rax
	mov	QWORD PTR [rdi + 8], rcx
	jmp	L_pidreg_done
L_pidreg_already_registered:
	mov	rax, 87
