	.globl	silica_rt_actor_self # -- Begin function silica_rt_actor_self
	.p2align	2
silica_rt_actor_self: # @silica_rt_actor_self
# The running actor's identity; main (no actor) gets the identity no actor has, all ones.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lself_main
	mov	rdi, QWORD PTR [rdi + 408]
	pop	rbp
	ret
Lself_main:
	mov	rdi, -1
	pop	rbp
	ret
