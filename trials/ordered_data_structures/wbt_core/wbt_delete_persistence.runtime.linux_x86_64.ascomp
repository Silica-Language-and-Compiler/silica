	xor	r10d, r10d
	test	rax, rax
	jz	Lsri_idle_parsed
Lsri_idle_digit:
	movzx	ecx, BYTE PTR [rax]
	sub	ecx, 48
	cmp	ecx, 9
	ja	Lsri_idle_parsed
	imul	r10, r10, 10
	add	r10, rcx
	inc	rax
	cmp	r10, 3600000
	jb	Lsri_idle_digit
	mov	r10d, 3600000
Lsri_idle_parsed:
	test	r10, r10
	jnz	Lsri_idle_have
	mov	r10d, 1000
Lsri_idle_have:
	imul	r10, r10, 1000000
	mov	QWORD PTR [rip + silica_rt_idle_release_ns], r10
	mov	r11, r10
	shr	r11, 2
	mov	ecx, 250000000
	cmp	r11, rcx
	cmovae	r11, rcx
	mov	QWORD PTR [rip + silica_rt_idle_sweep_ns], r11
# The idle-stack budget per carrier: SILICA_IDLE_STACK_BUDGET=<bytes> (decimal, the process total;
# unset, 0 or no digits means the default, the memory-plus-swap reservation over 32; the digits stop
# counting once the value passes 2^60) over the carrier count (silica_rt_carrier_count, stored above,
# at least 1), at least 16 platform pages ([rbp - 16]).
	lea	rdi, [rip + L_srt_idle_budget_env]
	call	getenv
	xor	r10d, r10d
	test	rax, rax
	jz	Lsri_budget_parsed
Lsri_budget_digit:
	movzx	ecx, BYTE PTR [rax]
	sub	ecx, 48
	cmp	ecx, 9
	ja	Lsri_budget_parsed
	imul	r10, r10, 10
	add	r10, rcx
	inc	rax
	mov	r11, r10
	shr	r11, 60
	jz	Lsri_budget_digit
Lsri_budget_parsed:
	test	r10, r10
	jnz	Lsri_budget_have
	mov	r10, QWORD PTR [rip + silica_rt_stack_default_reserve]
	shr	r10, 5
Lsri_budget_have:
	mov	rax, r10
	xor	edx, edx
	div	QWORD PTR [rip + silica_rt_carrier_count]
	mov	r10, QWORD PTR [rbp - 16]
	shl	r10, 4
	cmp	rax, r10
	cmovb	rax, r10
	mov	QWORD PTR [rip + silica_rt_idle_stack_budget], rax
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], 1
Lsri_done:
	leave
	ret
	.globl	silica_rt_stack_prefix_for
	.p2align	2
silica_rt_stack_prefix_for:
# X0 = bytes to keep -> X0 = the smallest chunk-sequence prefix sum >= X0, X1 = the chunk after it.
# Leaf: rdx = chunk (x9), rcx = prefix (x10), r8 = 1 MB (x11).
	lea	rax, [rip + silica_rt_stack_page]
	mov	rdx, QWORD PTR [rax]
	xor	ecx, ecx
	mov	r8d, 1048576
Lspf_loop:
	cmp	rcx, rdi
	jae	Lspf_done
	add	rcx, rdx
	cmp	rdx, r8
	jae	Lspf_loop
	shl	rdx, 1
	jmp	Lspf_loop
Lspf_done:
	mov	rdi, rcx
	mov	rsi, rdx
	ret
	.globl	silica_rt_stack_now_ns
	.p2align	2
silica_rt_stack_now_ns:
# clock_gettime(CLOCK_MONOTONIC = 1, &timespec at [rsp]) -> X0 = seconds * 1e9 + nanoseconds.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	edi, 1
	mov	rsi, rsp
	call	clock_gettime
	mov	rdi, QWORD PTR [rsp]
	mov	rsi, QWORD PTR [rsp + 8]
	imul	rdi, rdi, 1000000000
	add	rdi, rsi
	leave
	ret
	.globl	silica_rt_actor_stack_reserve
	.p2align	2
silica_rt_actor_stack_reserve:
# X0 = ACB, X1 = packed stack_policy (0 = inherit the spawning actor's, else the default with
# :keep_last_message). Returns X0 = 0 on success, 1 when no reservation could be made.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] policy (x20), [rbp - 24] algorithm (x21), [rbp - 32] reserve
# bytes (x22), [rbp - 40] page (x23), [rbp - 48] 1 = lowered (x24).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	call	silica_rt_stack_runtime_init
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lasr_have_policy
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lasr_default_policy
	mov	rax, QWORD PTR [rdi + 360]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jnz	Lasr_have_policy
Lasr_default_policy:
	mov	QWORD PTR [rbp - 16], 2
Lasr_have_policy:
	mov	rax, QWORD PTR [rbp - 16]
	and	rax, 15
	mov	QWORD PTR [rbp - 24], rax
	jnz	Lasr_alg_ok
	mov	QWORD PTR [rbp - 24], 2
Lasr_alg_ok:
	mov	rax, QWORD PTR [rbp - 16]
	and	rax, -64
	mov	QWORD PTR [rbp - 32], rax
	lea	rcx, [rip + silica_rt_stack_page]
	mov	rcx, QWORD PTR [rcx]
	mov	QWORD PTR [rbp - 40], rcx
	mov	QWORD PTR [rbp - 48], 0
	test	rax, rax
	jz	Lasr_default
	mov	QWORD PTR [rbp - 48], 1
	mov	r10, rcx
	sub	r10, 1
	add	rax, r10
	not	r10
	and	rax, r10
	mov	QWORD PTR [rbp - 32], rax
	jmp	Lasr_try
Lasr_default:
	lea	rax, [rip + silica_rt_stack_default_reserve]
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
Lasr_try:
# mmap(0, reserve, PROT_NONE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE = 0x4022, -1, 0)
	xor	edi, edi
	mov	rsi, QWORD PTR [rbp - 32]
	xor	edx, edx
	mov	ecx, 16418
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	mov	rdi, rax
	cmp	rdi, -1
	jne	Lasr_mapped
	cmp	QWORD PTR [rbp - 48], 0
	jne	Lasr_fail
# The host refused the whole-machine reservation by heuristic: reserve just under it, in
# sixteenths, down to half of the default.
	lea	rax, [rip + silica_rt_stack_default_reserve]
	mov	r10, QWORD PTR [rax]
	mov	r11, r10
	shr	r11, 4
	mov	rax, QWORD PTR [rbp - 40]
	sub	rax, 1
	add	r11, rax
	not	rax
	and	r11, rax
	mov	rax, QWORD PTR [rbp - 32]
	sub	rax, r11
	mov	QWORD PTR [rbp - 32], rax
	shr	r10, 1
	cmp	rax, r10
	jb	Lasr_fail
	jmp	Lasr_try
Lasr_mapped:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 272], rdi
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 280], rcx
	lea	r9, [rdi + rcx - 1040]
	mov	QWORD PTR [rax + 528], r9
	mov	QWORD PTR [rax + 288], 0
	mov	QWORD PTR [rax + 296], 0
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 304], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 312], rcx
	mov	QWORD PTR [rax + 320], 0
	mov	QWORD PTR [rax + 328], 0
	mov	QWORD PTR [rax + 336], 0
	mov	QWORD PTR [rax + 344], 0
	mov	QWORD PTR [rax + 352], 0
	mov	r10, QWORD PTR [rbp - 16]
	and	r10, -64
	or	r10, rcx
	mov	QWORD PTR [rax + 360], r10
# The state policy (bits 4-5, decision 40) is the spawn's own: #360 above drops it, so a child that
# inherits the policy word (a row child, X1 = 0) gets 0, :keep_state_area.
	mov	r10, QWORD PTR [rbp - 16]
	shr	r10, 4
	and	r10, 3
	mov	QWORD PTR [rax + 576], r10
	mov	QWORD PTR [rax + 368], 0
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 376], rcx
	mov	QWORD PTR [rax + 384], 0
	cmp	QWORD PTR [rbp - 24], 3
	jne	Lasr_no_ring
	mov	edi, 32
	mov	esi, 8
	call	calloc
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 328], rax
Lasr_no_ring:
	xor	edi, edi
	jmp	Lasr_ret
Lasr_fail:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 272], 0
	mov	QWORD PTR [rax + 528], 0
	mov	edi, 1
Lasr_ret:
	leave
	ret
	.globl	silica_rt_actor_altstack_install
	.p2align	2
silica_rt_actor_altstack_install:
# X0 = ACB. Every actor thread faults with SP inside its own inaccessible reservation, so the
# handler needs an alternate stack of its own on this thread (#352). A carrier installs one for
# its thread the same way (silica_rt_altstack_install_at, the word in its own block).
	add	rdi, 352
	.globl	silica_rt_altstack_install_at
	.p2align	2
silica_rt_altstack_install_at:
# X0 = the word that records the 64 KB mapping for this thread's signal alternate stack.
# Frame: [rbp - 8] the word (x19); stack_t at [rsp]: ss_sp @0, ss_flags (int) @8, ss_size @16.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 112
	mov	QWORD PTR [rbp - 8], rdi
# mmap(0, 65536, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS = 0x22, -1, 0)
	xor	edi, edi
	mov	esi, 65536
	mov	edx, 3
	mov	ecx, 34
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	cmp	rax, -1
	je	Lsai_ret
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx], rax
	mov	QWORD PTR [rsp], rax
	mov	QWORD PTR [rsp + 8], 0
	mov	QWORD PTR [rsp + 16], 65536
	mov	rdi, rsp
	xor	esi, esi
	call	sigaltstack
Lsai_ret:
	leave
	ret
	.globl	silica_rt_actor_stack_free
	.p2align	2
silica_rt_actor_stack_free:
# X0 = ACB, X1 = 1 when called on the alt stack (keep it mapped). Unmaps the reservation.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] on-alt-stack flag (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rdi, QWORD PTR [rdi + 272]
	test	rdi, rdi
	jz	Lsaf_alt
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax + 280]
	call	munmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 272], 0
	mov	QWORD PTR [rax + 528], 0
Lsaf_alt:
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lsaf_ring
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 352]
	test	rdi, rdi
	jz	Lsaf_ring
	mov	esi, 65536
	call	munmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 352], 0
Lsaf_ring:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 328]
	test	rdi, rdi
	jz	Lsaf_done
	call	free
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 328], 0
Lsaf_done:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 288], 0
	mov	QWORD PTR [rax + 320], 0
	leave
	ret
	.globl	silica_rt_stack_grow_to
	.p2align	2
silica_rt_stack_grow_to:
# X0 = ACB, X1 = faulting address inside the reservation. Commits chunks below the committed run
# until the address is covered. X0 = 0 grown, 1 the lowered reservation is exhausted, 2 the host
# refused the commit, 3 the address was already committed (not stack growth).
# Frame: [rbp - 8] ACB (x19), [rbp - 16] address (x20), [rbp - 24] run low address (x21),
# [rbp - 32] chunk (x22), [rbp - 40] 1 = grew (x23).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 40], 0
Lsgt_loop:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r8, QWORD PTR [rax + 272]
	mov	r10, QWORD PTR [rax + 280]
	add	r10, r8
	mov	r11, QWORD PTR [rax + 288]
	mov	rcx, r10
	sub	rcx, r11
	mov	QWORD PTR [rbp - 24], rcx
	cmp	QWORD PTR [rbp - 16], rcx
	jae	Lsgt_covered
# The lowest page of the reservation is never committed: reaching it is the end of the
# reservation whatever mapping sits below (the remainder stays a second, inaccessible mapping).
	mov	rdx, QWORD PTR [rax + 304]
	mov	QWORD PTR [rbp - 32], rdx
	mov	r11, rcx
	sub	r11, r8
	lea	rax, [rip + silica_rt_stack_page]
	mov	rax, QWORD PTR [rax]
	sub	r11, rax
	jbe	Lsgt_exhausted
	cmp	rdx, r11
	cmova	rdx, r11
	mov	QWORD PTR [rbp - 32], rdx
	mov	rdi, rcx
	sub	rdi, rdx
	mov	rsi, rdx
	mov	edx, 3
	call	mprotect
	test	eax, eax
	jnz	Lsgt_commit_failed
	mov	QWORD PTR [rbp - 40], 1
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 288]
	add	r11, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 288], r11
	cmp	r11, QWORD PTR [rax + 296]
	jbe	Lsgt_no_hw
	mov	QWORD PTR [rax + 296], r11
Lsgt_no_hw:
	mov	rcx, QWORD PTR [rax + 304]
	cmp	rcx, 1048576
	jae	Lsgt_loop
	shl	rcx, 1
	mov	QWORD PTR [rax + 304], rcx
	jmp	Lsgt_loop
Lsgt_covered:
	cmp	QWORD PTR [rbp - 40], 0
	je	Lsgt_not_ours
	xor	edi, edi
	jmp	Lsgt_ret
Lsgt_not_ours:
	mov	edi, 3
	jmp	Lsgt_ret
Lsgt_exhausted:
	mov	edi, 1
	jmp	Lsgt_ret
Lsgt_commit_failed:
	mov	edi, 2
Lsgt_ret:
	leave
	ret
	.globl	silica_rt_stack_measure
	.p2align	2
silica_rt_stack_measure:
# X0 = ACB -> X0 = bytes from the state edge (#528) down to the lowest page holding a nonzero word
# (0 = none). The scan runs from the bottom of the committed run up to the edge; the state area
# above the edge is never scanned (chunk15_stack_memory_design.md §2.4, decision 27).
# Leaf: rsi = base (x8), rdx = the edge (x9), rcx = committed (x10), r8 = page cursor (x11),
# r9 = page size (x12), r10 = word cursor (x13), r11 = page end (x14).
	mov	rsi, QWORD PTR [rdi + 272]
	mov	rdx, QWORD PTR [rdi + 280]
	add	rdx, rsi
	mov	rcx, QWORD PTR [rdi + 288]
	mov	r8, rdx
	sub	r8, rcx
	mov	rdx, QWORD PTR [rdi + 528]
	lea	r9, [rip + silica_rt_stack_page]
	mov	r9, QWORD PTR [r9]
Lsm_page:
	cmp	r8, rdx
	jae	Lsm_none
	mov	r10, r8
	mov	r11, r8
	add	r11, r9
Lsm_word:
	mov	rax, QWORD PTR [r10]
	or	rax, QWORD PTR [r10 + 8]
	lea	r10, [r10 + 16]
	jnz	Lsm_found
	cmp	r10, r11
	jb	Lsm_word
	mov	r8, r11
	jmp	Lsm_page
Lsm_found:
	mov	rdi, rdx
	sub	rdi, r8
	ret
Lsm_none:
	xor	edi, edi
	ret
	.globl	silica_rt_stack_release_to
	.p2align	2
silica_rt_stack_release_to:
# X0 = ACB, X1 = bytes to keep below the state edge, X2 = bytes below the edge the last message used
# (zeroed if kept). Releases whole chunks below the smallest chunk prefix (measured from the top,
# so the state area above the edge is inside it) that covers the edge's offset plus X1, in the sizes
# they grew by. While the state area holds nodes (the edge is below top - 1040: a composite state was
# copied in at spawn or placed at a dispatch end, prims_actors_state_asm) it is never decommitted,
# whatever X1 says (decision 27; chunk15_stack_memory_design.md §2.4). With an empty area X1 = 0 keeps
# nothing: the 1,040-byte header is all zero then and comes back zero with the next page commit, so a
# scalar-state actor under :release_on_return holds no stack between messages (spec §15.1.2.2).
# Frame: [rbp - 8] ACB (x19), [rbp - 16] keep prefix (x20), [rbp - 24] used (x21), [rbp - 32] next chunk (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 24], rdx
	mov	rax, rdi
	mov	rdi, rsi
	mov	r8, QWORD PTR [rax + 272]
	add	r8, QWORD PTR [rax + 280]
	sub	r8, QWORD PTR [rax + 528]
	cmp	r8, 1040
	ja	Lsrt_keep_area
	test	rdi, rdi
	jz	Lsrt_zero_keep
Lsrt_keep_area:
	add	rdi, r8
	call	silica_rt_stack_prefix_for
	jmp	Lsrt_have
Lsrt_zero_keep:
	xor	edi, edi
	lea	rax, [rip + silica_rt_stack_page]
	mov	rsi, QWORD PTR [rax]
Lsrt_have:
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 32], rsi
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 288]
	cmp	rdi, r11
	jae	Lsrt_zero
	mov	r8, QWORD PTR [rax + 272]
	mov	r10, QWORD PTR [rax + 280]
	add	r10, r8
	mov	rdi, r10
	sub	rdi, r11
	mov	rsi, r11
	sub	rsi, QWORD PTR [rbp - 16]
# mmap(run low, committed - keep, PROT_NONE, MAP_FIXED|MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE = 0x4032, -1, 0)
	xor	edx, edx
	mov	ecx, 16434
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 288], rcx
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 304], rcx
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lsrt_zero
	mov	rdi, QWORD PTR [rax + 352]
	test	rdi, rdi
	jz	Lsrt_zero
	mov	esi, 65536
	mov	edx, 4
	call	madvise
Lsrt_zero:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 288]
	mov	QWORD PTR [rax + 320], r11
	mov	rcx, QWORD PTR [rbp - 24]
	test	rcx, rcx
	jz	Lsrt_ret
# committed bytes below the edge: committed - (top - edge), 0 when the run ends above the edge
	mov	r8, QWORD PTR [rax + 272]
	add	r8, QWORD PTR [rax + 280]
	sub	r8, QWORD PTR [rax + 528]
	sub	r11, r8
	jae	Lsrt_zero_below
	xor	r11d, r11d
Lsrt_zero_below:
	cmp	rcx, r11
	cmova	rcx, r11
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	Lsrt_ret
	mov	rdi, QWORD PTR [rax + 528]
	sub	rdi, rcx
	xor	esi, esi
	mov	rdx, rcx
	call	memset
Lsrt_ret:
	leave
	ret
	.globl	silica_rt_stack_on_message_return
	.p2align	2
silica_rt_stack_on_message_return:
# X0 = ACB. The behavior has returned and the stack is empty: apply the actor's release algorithm.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] measured depth (x20), [rbp - 24] bytes to keep (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	cmp	QWORD PTR [rdi + 272], 0
	je	Lsmr_ret
	mov	r10, QWORD PTR [rdi + 312]
	cmp	r10, 5
	je	Lsmr_keep_all
	cmp	r10, 4
	je	Lsmr_idle_stamp
	cmp	r10, 1
	je	Lsmr_release_all
	call	silica_rt_stack_measure
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 312], 3
	jne	Lsmr_keep_depth
	mov	r11, QWORD PTR [rax + 328]
	test	r11, r11
	jz	Lsmr_keep_depth
	mov	rcx, QWORD PTR [rax + 336]
	mov	rdx, rcx
	and	rdx, 31
	mov	QWORD PTR [r11 + rdx*8], rdi
	add	rcx, 1
	mov	QWORD PTR [rax + 336], rcx
	xor	edx, edx
	xor	r8d, r8d
Lsmr_ring_max:
	mov	r9, QWORD PTR [r11 + rdx*8]
	cmp	r9, r8
	cmova	r8, r9
	add	rdx, 1
	cmp	rdx, 32
	jb	Lsmr_ring_max
	mov	QWORD PTR [rbp - 24], r8
	jmp	Lsmr_release_keep
Lsmr_keep_depth:
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 24], rax
Lsmr_release_keep:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 24]
	mov	rdx, QWORD PTR [rbp - 16]
	call	silica_rt_stack_release_to
	jmp	Lsmr_ret
Lsmr_keep_all:
	mov	r11, QWORD PTR [rdi + 288]
	mov	QWORD PTR [rdi + 320], r11
	jmp	Lsmr_ret
Lsmr_idle_stamp:
	mov	r11, QWORD PTR [rdi + 288]
	mov	QWORD PTR [rdi + 320], r11
	call	silica_rt_stack_now_ns
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 344], rdi
	jmp	Lsmr_ret
Lsmr_release_all:
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_stack_release_to
Lsmr_ret:
	leave
	ret
	.globl	silica_rt_stack_idle_check
	.p2align	2
silica_rt_stack_idle_check:
# X0 = ACB -> X0 = mailbox wait timeout in microseconds (0 = wait without a timeout). Only
# :release_when_idle actors holding committed stack wait with a timeout; once the idle period
# (silica_rt_idle_release_ns) has passed since the last message the stack is released and the wait
# becomes untimed. A dangerous actor's thread makes this check; a carrier's sweep uses
# silica_rt_stack_idle_due below.
# Frame: [rbp - 8] ACB (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	cmp	QWORD PTR [rdi + 312], 4
	jne	Lsic_none
	cmp	QWORD PTR [rdi + 288], 0
	je	Lsic_none
	call	silica_rt_stack_now_ns
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 344]
	mov	rdx, rdi
	sub	rdx, rcx
	mov	r8, QWORD PTR [rip + silica_rt_idle_release_ns]
	cmp	rdx, r8
	jb	Lsic_wait
	mov	rdi, rax
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_stack_release_to
	jmp	Lsic_none
Lsic_wait:
	sub	r8, rdx
	mov	rax, r8
	xor	edx, edx
	mov	ecx, 1000
	div	rcx
	lea	rdi, [rax + 1]
	jmp	Lsic_ret
Lsic_none:
	xor	edi, edi
Lsic_ret:
	leave
	ret
	.globl	silica_rt_stack_idle_due
	.p2align	2
silica_rt_stack_idle_due:
# X0 = ACB (a :release_when_idle actor holding committed stack, on its carrier's sweep list), X1 =
# the time now (monotonic ns; the sweep reads the clock once for a whole batch) -> X0 = 0 when the
# idle period (silica_rt_idle_release_ns) has passed since the actor's last message (#344), else
# the microseconds until it will have, at least 1. Leaf; rax rcx rdx r8 (x9-x10).
	mov	rcx, rsi
	sub	rcx, QWORD PTR [rdi + 344]
	mov	r8, QWORD PTR [rip + silica_rt_idle_release_ns]
	cmp	rcx, r8
	jae	Lsid_due
	sub	r8, rcx
	mov	rax, r8
	xor	edx, edx
	mov	ecx, 1000
	div	rcx
	lea	rdi, [rax + 1]
	ret
Lsid_due:
	xor	edi, edi
	ret
	.globl	silica_rt_cv_wait_timeout
	.p2align	2
silica_rt_cv_wait_timeout:
# X0 = cv_addr, X1 = lock_addr, X2 = timeout in microseconds (0 = none). Caller holds the lock;
# the lock is held again on return, whether woken or timed out.
# Frame: [rbp - 8] cv (x19), [rbp - 16] lock (x20), [rbp - 24] timeout (x21), [rbp - 32] cv snapshot (w22);
# struct timespec at [rsp].
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	eax, DWORD PTR [rdi]
	mov	QWORD PTR [rbp - 32], rax
	mov	rdi, rsi
	call	silica_rt_lock_unlock
	cmp	QWORD PTR [rbp - 24], 0
	je	Lcwt_untimed
# futex(addr, FUTEX_WAIT_PRIVATE = 128, expected, &timespec{us / 1000000, (us % 1000000) * 1000}, 0, 0),
# raw syscall 202 (clobbers rcx, r11).
	mov	rax, QWORD PTR [rbp - 24]
	xor	edx, edx
	mov	rcx, 1000000
	div	rcx
	imul	rdx, rdx, 1000
	mov	QWORD PTR [rsp], rax
	mov	QWORD PTR [rsp + 8], rdx
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 128
	mov	edx, DWORD PTR [rbp - 32]
	mov	r10, rsp
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
	jmp	Lcwt_lock
Lcwt_untimed:
	mov	edi, 3
	mov	rsi, QWORD PTR [rbp - 8]
	mov	edx, DWORD PTR [rbp - 32]
	xor	ecx, ecx
	call	silica_rt_futex_wait
Lcwt_lock:
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_lock_lock
	leave
	ret
	.globl	silica_rt_actor_fail_current
	.p2align	2
silica_rt_actor_fail_current:
# X0 = the current actor's ACB, X1 = reason atom. Ends the actor with (:explicit, atom): wakes its
# waiters, delivers the exit to its supervisor, frees what it owns and exits the thread. For a
# dangerous actor (a thread of its own) it runs on the signal alt stack (stack exhaustion) or on
# the actor stack (a spawn whose reservation failed). For a carrier actor it is entered on the
# carrier's stack (the fault handler returns into it there, through the signal frame with
# rsp = the carrier's base - 8, so the carrier's alternate-stack state is intact for the next
# fault) or on the actor's own (a failed spawn inside a behaviour or a start trampoline, a
# duplicate child id) and ends in the carrier loop; the reservation is freed first, before any
# waiter is woken, unless the actor has a supervision block ([rbp - 16] = 1): then its children
# are shut down in the delivering phase, each waited for, and the waits park, which needs a stack
# the carrier loop leaves alone: the top of its own reservation (every frame below it is
# abandoned: a fault's signal frame was unwound by the kernel, a failed spawn never returns),
# unmapped after that phase instead.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] 1 = delivering on the reservation (x20), [rbp - 24] the
# carrier (x21; 0 for a dangerous actor). Every stack switch below opens a fresh frame and
# rewrites the three slots (they are memory, not registers): this routine never returns, so the
# abandoned frames are not unwound.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rdi + 384], rsi
	mov	r11, QWORD PTR [rdi + 440]
	mov	QWORD PTR [rbp - 24], r11
	mov	QWORD PTR [rbp - 16], 0
	test	r11, r11
	jz	Lafc_thread_actor
	cmp	QWORD PTR [rdi + 216], 0
	je	Lafc_carrier_stack
	mov	r10, QWORD PTR [rdi + 272]
	test	r10, r10
	jz	Lafc_carrier_stack
	mov	r10, QWORD PTR [rdi + 528]
	mov	rsp, r10
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 1
	mov	QWORD PTR [rbp - 24], r11
	jmp	Lafc_deliver
Lafc_carrier_stack:
	mov	r10, QWORD PTR [r11 + 48]
	mov	rsp, r10
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 0
	mov	QWORD PTR [rbp - 24], r11
	jmp	Lafc_on_stack
Lafc_thread_actor:
# Move onto the thread's alt stack (its top; nothing there is needed again) so the actor stack
# this may be running on can be unmapped now. On the exhaustion path we are already there.
# The stack is given back before any waiter is woken, as at a message boundary: a caller that
# wakes on the death and asks get_actor_memory_usage must already see the reservation gone.
	mov	r10, QWORD PTR [rdi + 352]
	test	r10, r10
	jz	Lafc_on_stack
	add	r10, 65536
	mov	rsp, r10
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 0
	mov	QWORD PTR [rbp - 24], 0
Lafc_on_stack:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 1
	call	silica_rt_actor_stack_free
Lafc_deliver:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 232], 4
	mov	DWORD PTR [rax + 152], 0
	mov	rdi, rax
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 216]
	test	rcx, rcx
	jz	Lsbg_afc
	mov	rcx, QWORD PTR [rcx + 40]
Lsbg_afc:
	test	rcx, rcx
	jne	Lafc_report_done
	mov	rdi, rax
	call	silica_rt_actor_deliver_exit
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_deliver_unwind_report
Lafc_report_done:
# The started word (#224) is set after the report so a spawner spinning on it (actor_spawn /
# spawn_linked, while this actor's start trampoline ran) proceeds: 2 = the init trampoline failed (stack exhausted, a failed spawn reservation, a duplicate child id). The ACB is
# not freed under the spawner: it goes with its last holder (silica_rt_acb_release); a row child's
# exit notice is parked at #400 until its spawner has committed it to the row.
	mov	r10, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [r10 + 224], 0
	jne	Lafc_started_set
	mov	rdi, r10
	mov	esi, 2
	call	silica_rt_started_store
Lafc_started_set:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_signal_pending_call_deaths
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_ffi_arena_teardown
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_child_table_free
# The delivering phase ran on the reservation ([rbp - 16]): nothing waits any more, so onto the
# carrier's stack (a fresh frame there holds the actor and the carrier) and the reservation goes.
	cmp	QWORD PTR [rbp - 16], 0
	je	Lafc_stack_done
	mov	rdi, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rbp - 24]
	mov	rsp, QWORD PTR [r11 + 48]
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 1
	mov	QWORD PTR [rbp - 24], r11
	xor	esi, esi
	call	silica_rt_actor_stack_free
Lafc_stack_done:
	cmp	QWORD PTR [rbp - 24], 0
	je	Lafc_thread_end
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_final_release
	mov	rdi, QWORD PTR [rbp - 24]
	jmp	silica_rt_carrier_loop_enter
Lafc_thread_end:
# A dangerous actor's thread (on its alt stack, or the reservation): back onto its own stack, the
# alt stack goes with the holds, and the start routine returns (silica_rt_thread_actor_end; never
# pthread_exit, which force-unwinds and spins on a stack that is not the thread's).
	mov	rdi, QWORD PTR [rbp - 8]
	jmp	silica_rt_thread_actor_end
	.globl	silica_rt_fail_self
	.p2align	4
silica_rt_fail_self:
# rdi = the reason atom. fail_self(reason) (spec §15.1.2.3): the calling actor ends at once with
# failure_reason (:explicit, reason) through silica_rt_actor_fail_current, as the runtime's own
# checks end it (a buffer index out of bounds, a reservation that could not be made): the dispatch
# is abandoned, a call it is serving gets the actor-death result, queued casts are dropped. Never
# returns. The type checker admits the call only in a behaviour (E2091); a thread with no current
# actor is the language-level failure of §15.4.5.5 (silica_rt_language_error_current).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lfsf_main
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_fail_current
Lfsf_main:
	leave
	jmp	silica_rt_language_error_current
	.globl	silica_rt_stop_self_normal
	.p2align	4
silica_rt_stop_self_normal:
# stop_self(:normal) (spec §15.1.2.3): the calling actor ends at its next dispatch boundary with
# failure_reason :normal, as remove_actor ends another actor: silica_rt_actor_stop clears its
# alive flag (tag 0 keeps the default reason), the current dispatch runs to completion, a call it
# is serving still gets its reply (LBB1_reply_result precedes silica_rt_carrier_requeue), and the
# exit path runs at the next dispatch. -> rdi = 0 (the emitter answers :ok). With no current actor
# it is the language-level failure of §15.4.5.5.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lssn_main
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_actor_stop
	xor	edi, edi
	pop	rbp
	ret
Lssn_main:
	pop	rbp
	jmp	silica_rt_language_error_current
	.globl	silica_rt_stop_self_explicit
	.p2align	4
silica_rt_stop_self_explicit:
# rdi = the reason atom. stop_self((:explicit, reason)): as silica_rt_stop_self_normal, with
# failure_reason (:explicit, reason): tag 4 at #232 and the atom at #384, read by
# silica_rt_actor_deliver_exit into the exit payload. -> rdi = 0.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lsse_main
	mov	esi, 4
	mov	rdx, QWORD PTR [rbp - 8]
	call	silica_rt_actor_stop
	xor	edi, edi
	leave
	ret
Lsse_main:
	leave
	jmp	silica_rt_language_error_current
	.globl	silica_rt_spawn_reserve_failed
	.p2align	2
silica_rt_spawn_reserve_failed:
# A spawn could not make its reservation. The spawning actor fails with
# (:explicit, :stack_reserve_failed). `main` is not an actor and has no supervisor, so there the
# process ends with a runtime abort, reason stack reservation failed, status 71 (spec 15.1.2.2,
# 15.4.5.5), reported at the spawn routine's call to this function. Never returns.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lsrf_main
	lea	rax, [rip + silica_rt_stack_reserve_failed_atom]
	mov	rsi, QWORD PTR [rax]
	call	silica_rt_actor_fail_current
Lsrf_main:
	pop	rbp
	jmp	silica_rt_abort_stack_reserve
	.globl	silica_rt_spawn_thread_failed
	.p2align	4
silica_rt_spawn_thread_failed:
# A spawn_dangerous, or the start of a :dangerous row, could not make the actor's thread: the host
# refused it (pthread_create failed; macOS caps a task at kern.num_taskthreads threads, 4096, so
# about the 4,080th dangerous actor, Linux at its thread and mapping limits). The spawn gave back
# what it had taken before coming here (actor_memory_budget_plan.md item N, #5 option C). The
# spawning actor fails with (:explicit, :thread_limit), as it does for a reservation it cannot
# make; `main` is not an actor and has no supervisor, so there the process ends with a runtime
# abort, reason the thread of a dangerous actor could not be created, status 71 (spec 15.4.5.5),
# reported at the spawn routine's call to this function. Never returns.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lstf_main
	lea	rax, [rip + silica_rt_thread_limit_atom]
	mov	rsi, QWORD PTR [rax]
	call	silica_rt_actor_fail_current
Lstf_main:
	pop	rbp
	jmp	silica_rt_abort_dangerous_thread
