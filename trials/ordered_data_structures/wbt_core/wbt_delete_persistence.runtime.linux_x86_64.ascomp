Lstc_ref_asis:
	ret

Lstc_list:
	cmp	rdi, 0
	je	Lstc_ml_ret
	mov	rax, QWORD PTR [rbp - 64]
	mov	r10, QWORD PTR [rax + 8]
	cmp	r10, 0
	je	Lstc_ml_new
	mov	rax, QWORD PTR [rbp - 64]
	mov	r11, QWORD PTR [rax + 24]
	cmp	rdi, r11
	jb	Lstc_ml_new
	mov	rax, QWORD PTR [rbp - 64]
	mov	r11, QWORD PTR [rax + 32]
	cmp	rdi, r11
	jb	Lstc_ml_ret
