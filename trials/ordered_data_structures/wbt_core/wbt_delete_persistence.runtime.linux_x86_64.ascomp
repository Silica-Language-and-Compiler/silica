	mov	r10, QWORD PTR [r11 + 272]
	mov	r11, QWORD PTR [r11 + 280]
	lea	rax, [r10 + r11]
	mov	r11, rax
	mov	r11, QWORD PTR [r11 - 8]
Lstc_ref_rt_loop:
	cmp	r11, 0
	je	Lstc_ref_new
	mov	r10, QWORD PTR [r11 + 8]
	lea	rax, [r11 + r10]
	mov	r10, rax
	lea	r10, [r10 + 8]
	cmp	r10, rdi
	je	Lstc_ref_asis
	mov	r11, QWORD PTR [r11]
	jmp	Lstc_ref_rt_loop
Lstc_ref_new:
	sub	rsp, 16
	lea	rsp, [rsp - 16]
	mov	rbx, QWORD PTR [rbp - 112]
	mov	QWORD PTR [rsp], rbx
	mov	rbx, QWORD PTR [rbp - 120]
	mov	QWORD PTR [rsp + 8], rbx
	lea	rsp, [rsp - 16]
	mov	rbx, QWORD PTR [rbp - 128]
	mov	QWORD PTR [rsp], rbx
	mov	rbx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rsp + 8], rbx
	lea	rsp, [rsp - 16]
	mov	QWORD PTR [rbp - 112], rdi
	mov	QWORD PTR [rbp - 120], rsi
	mov	QWORD PTR [rbp - 128], rdx
	mov	QWORD PTR [rbp - 72], 0
	call	Lstc_lookup
	cmp	rdi, 0
	jne	Lstc_ref_done
	cmp	QWORD PTR [rbp - 120], 2
	je	Lstc_ref1
	cmp	QWORD PTR [rbp - 120], 3
	je	Lstc_refrec
	mov	rax, QWORD PTR [rbp - 112]
	mov	r10, QWORD PTR [rax - 8]
	mov	rax, r10
	mov	rbx, QWORD PTR [rbp - 128]
	imul	rax, rbx
	mov	r15, rax
	lea	r15, [r15 + 15]
	mov	rax, r15
	and	rax, -8
	mov	r15, rax
	call	Lstc_bump
	mov	QWORD PTR [rbp - 120], rdi
	mov	QWORD PTR [rsp + 8], rsi
	mov	rax, QWORD PTR [rbp - 112]
	mov	r10, QWORD PTR [rax - 8]
	mov	rax, QWORD PTR [rbp - 120]
	mov	QWORD PTR [rax], r10
	mov	rax, r10
	mov	rbx, QWORD PTR [rbp - 128]
	imul	rax, rbx
	mov	r10, rax
	lea	r10, [r10 + 7]
	mov	rax, r10
	shr	rax, 3
	mov	r10, rax
