# The registry slot count of this image: one slot per atom of the build (atoms/atom_table.silica
# build_runtime_atom_table; actor_memory_budget_plan.md item J). Atoms are interned when the program
# is built (spec §4.1.7), so the tables never overflow. The keyed forms treat an int64 below this
# count as an atom and at or above it as an actor_ref: control blocks are calloc'd, and the non-PIE
# image's heap starts above its own text (0x400000), far above any atom count.
	.section .rodata
	.p2align	3
	.globl	silica_registry_slots
silica_registry_slots:
	.quad	103
	.globl	silica_rt_reply_tag
silica_rt_reply_tag:
	.quad	-1
	.globl	silica_rt_no_reply_tag
silica_rt_no_reply_tag:
	.quad	75
	.globl	silica_rt_sup_error_tag
silica_rt_sup_error_tag:
	.quad	-1
	.globl	silica_rt_sup_self_error_atom
silica_rt_sup_self_error_atom:
	.quad	4
	.text
# The reply fields of call_supervisor's :terminate_child / :remove_child / :restart_child
# (terms_actor_lowering): the operation answers -2 when the asking actor is a row child of the
# supervisor and the operation would stop its own row (prims_actors_child_table_asm.silica,
# Lsterm_self / Lsrestart_self), and the reply is then the error shape (tag :error, status
# :error, error :language_error, child 0) instead of the operation's own.
# silica_rt_sup_op_tag(rdi = the operation's answer, rsi = the tag or status of the operation's
# own reply) -> rdi = rsi, or this build's :error for the -2 answer. Leaf.
	.globl	silica_rt_sup_op_tag
	.p2align	2
silica_rt_sup_op_tag:
	cmp	rdi, -2
	jne	Lsot_own
	mov	rsi, QWORD PTR [rip + silica_rt_sup_error_tag]
Lsot_own:
	mov	rdi, rsi
	ret
# silica_rt_sup_op_error(rdi = the answer, rsi = the error atom of the operation's own reply,
# :ok) -> rdi = rsi, or :language_error for the -2 answer. Leaf.
	.globl	silica_rt_sup_op_error
	.p2align	2
silica_rt_sup_op_error:
	cmp	rdi, -2
	jne	Lsoe_own
	mov	rsi, QWORD PTR [rip + silica_rt_sup_self_error_atom]
Lsoe_own:
	mov	rdi, rsi
	ret
# silica_rt_sup_op_child(rdi = :restart_child's answer: the started child's identity, -1 for no
# child) -> rdi = the answer, or 0 (the error reply's child) for the -2 answer. Leaf.
	.globl	silica_rt_sup_op_child
	.p2align	2
silica_rt_sup_op_child:
	cmp	rdi, -2
	jne	Lsoc_own
	xor	edi, edi
Lsoc_own:
	ret
# PID registry primitive actor (spec §20.3.1).
# State layout: one calloc block of silica_registry_slots * 16 B: occ[slots] (int64, 1 = held) at +0,
# actor_ref words[slots] at +slots*8. The same block is read directly by the keyed forms and by
# silica_rt_register_actor_named (the store writes the ref before the occ word; a removal clears the
# occ word first).
# Message record layout follows record emission: shape word@0, op@8, name@16, pid@24.
# Behavior return layout follows actor runtime convention: tag@0, reply@8, next_state@16.
# :insert replies :ok (stored, or the actor already holds this very name), :name_taken (a live actor
# or supervisor holds the name), :already_registered (the actor holds another name in this table) or
# :actor_not_found (the actor has ended); the reply is a (status atom, actor_ref) pair.
	.globl	silica_rt_pid_registry_beh
	.p2align	2
silica_rt_pid_registry_beh:
# X0 = message record, X1 = state. slots: [rbp-8] = x19 msg, [rbp-16] = x20 state, [rbp-24] = x21 op,
# [rbp-32] = x22 name, [rbp-40] = x23 pid, [rbp-48] = x24 result block. After the callocs: rdi = reply block,
# rsi = state, r10 = op, r11 = name, rcx = pid, r9 = slot count (reloaded after the one further call).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 24], rax
	mov	rax, QWORD PTR [rdi + 16]
	mov	QWORD PTR [rbp - 32], rax
	mov	rax, QWORD PTR [rdi + 24]
	mov	QWORD PTR [rbp - 40], rax
	mov	edi, 1
	mov	esi, 24
	call	calloc
	mov	QWORD PTR [rbp - 48], rax
	test	rax, rax
	jz	L_pidreg_ret_null
	mov	edi, 1
	mov	esi, 16
	call	calloc
	test	rax, rax
	jz	L_pidreg_ret_null
	mov	rdi, rax
	mov	r8, QWORD PTR [rbp - 48]
	mov	QWORD PTR [r8 + 8], rdi
	mov	rsi, QWORD PTR [rbp - 16]
	mov	QWORD PTR [r8 + 16], rsi
	mov	r10, QWORD PTR [rbp - 24]
	mov	r11, QWORD PTR [rbp - 32]
	mov	rcx, QWORD PTR [rbp - 40]
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	r10, 15
	je	L_pidreg_insert
	cmp	r10, 16
	je	L_pidreg_lookup
	cmp	r10, 17
	je	L_pidreg_delete
	mov	rax, 20
	mov	QWORD PTR [rdi], rax
	mov	QWORD PTR [rdi + 8], rcx
	jmp	L_pidreg_done
L_pidreg_insert:
	cmp	r11, 0
	jl	L_pidreg_name_taken
	cmp	r11, r9
	jge	L_pidreg_name_taken
# The pid is an identity (§15.1.4): liveness is the identity table's, and so is the holder's.
	mov	rdi, rcx
	call	silica_rt_ref_alive
	mov	QWORD PTR [rbp - 56], rdi
	mov	rdi, QWORD PTR [rbp - 48]
	mov	rdi, QWORD PTR [rdi + 8]
	mov	rsi, QWORD PTR [rbp - 16]
	mov	r11, QWORD PTR [rbp - 32]
	mov	rcx, QWORD PTR [rbp - 40]
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	QWORD PTR [rbp - 56], 0
	je	L_pidreg_actor_not_found
	mov	rax, QWORD PTR [rsi + r11*8]
	cmp	rax, 1
	jne	L_pidreg_insert_free
	lea	r8, [rsi + r9*8]
	mov	rax, QWORD PTR [r8 + r11*8]
	cmp	rax, rcx
	je	L_pidreg_insert_ok
	mov	rdi, rax
	call	silica_rt_ref_alive
	mov	QWORD PTR [rbp - 56], rdi
	mov	rdi, QWORD PTR [rbp - 48]
	mov	rdi, QWORD PTR [rdi + 8]
	mov	rsi, QWORD PTR [rbp - 16]
	mov	r11, QWORD PTR [rbp - 32]
	mov	rcx, QWORD PTR [rbp - 40]
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	QWORD PTR [rbp - 56], 0
