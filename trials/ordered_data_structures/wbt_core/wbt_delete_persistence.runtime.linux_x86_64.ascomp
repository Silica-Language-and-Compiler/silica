silica_rt_duplicate_child_id_atom:
	.quad	89
	.section .rodata
L_silica_duplicate_child_id_msg:
	.asciz	"duplicate_child_id\n"
	.text
# silica_rt_supervisor_fail_duplicate_child_id(rdi = supervisor ACB): a restart found the child's name
# held by another live actor or supervisor (§20.3.1). The supervisor fails with failure_reason
# (:explicit, :duplicate_child_id) the way a restart-intensity breach ends it (maybe_restart): a root
# supervisor is reported here, claiming the supervision block's sync_failure_reported so its own thread
# does not report again, and the root note follows; a supervised one is marked dead and its thread
# delivers the exit, carrying this reason, to its parent, which applies its own restart rules.
# Frame: [rbp - 8] supervisor (x19), [rbp - 16] 1 when this call reports (x20).
	.globl	silica_rt_supervisor_fail_duplicate_child_id
	.p2align	2
silica_rt_supervisor_fail_duplicate_child_id:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rdi + 232], 4
	lea	rax, [rip + silica_rt_duplicate_child_id_atom]
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rdi + 384], rax
	mov	QWORD PTR [rbp - 16], 0
	mov	r8, QWORD PTR [rdi + 192]
	test	r8, r8
	jnz	Lfdc_mark_dead
# The synchronous report only as the supervisor's own dispatch (maybe_restart, Lmr_freq_escalate).
	call	silica_rt_sup_on_own_dispatch
	test	rdi, rdi
	jz	Lfdc_mark_dead
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rdi + 216]
	test	rdx, rdx
	jz	Lfdc_mark_dead
	mov	r8, QWORD PTR [rdx + 40]
	test	r8, r8
	jnz	Lfdc_mark_dead
	mov	QWORD PTR [rdx + 40], 1
	mov	QWORD PTR [rbp - 16], 1
Lfdc_mark_dead:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 8]
	mov	DWORD PTR [rcx + 152], 0
	mov	rdi, rcx
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 16]
	test	rax, rax
	jz	Lfdc_done
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_shutdown_children
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_root_report_and_note
Lfdc_done:
	leave
	ret
# silica_rt_supervisor_respawn_row(rdi = row, rsi = supervisor ACB) -> rdi = 0 when the row's child was
# started, 1 when the row's id is held by a live actor or supervisor: no child is started under a name
# it does not hold, the row is a tombstone and the supervisor has failed (above). Every restart path respawns through this;
# the first start of a child (materialize, start_child) keeps its own rule.
# Frame: [rbp - 8] row (x19), [rbp - 16] supervisor (x20).
	.globl	silica_rt_supervisor_respawn_row
	.p2align	2
silica_rt_supervisor_respawn_row:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rdi, QWORD PTR [rdi + 8]
	call	silica_rt_registry_name_held
	test	rax, rax
	jnz	Lrsr_taken
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_spawn_child_row_by_flavor
	xor	edi, edi
	jmp	Lrsr_done
Lrsr_taken:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], 0
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_fail_duplicate_child_id
	mov	edi, 1
Lrsr_done:
	leave
	ret
	.p2align	2
silica_rt_supervisor_drop_pending_exit:
# X0 = supervisor ACB, X1 = child ACB. [rbp - 8] ACB (x19), [rbp - 16] child (x20), [rbp - 24] payload (x21),
# [rbp - 32] node (x22), [rbp - 40] queue anchor (x23), [rbp - 48] previous node (x24).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Ldpe_not_found
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	mov	QWORD PTR [rbp - 48], 0
Ldpe_front_loop:
	mov	rax, QWORD PTR [rbp - 32]
	test	rax, rax
	jz	Ldpe_scan_rear
	mov	r8, QWORD PTR [rax + 8]
	test	r8, r8
	jz	Ldpe_front_next
	mov	r9, QWORD PTR [r8]
	cmp	r9, QWORD PTR [rbp - 16]
	je	Ldpe_remove
Ldpe_front_next:
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	jmp	Ldpe_front_loop
Ldpe_scan_rear:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	add	rax, 8
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	mov	QWORD PTR [rbp - 48], 0
Ldpe_rear_loop:
	mov	rax, QWORD PTR [rbp - 32]
	test	rax, rax
	jz	Ldpe_not_found
	mov	r8, QWORD PTR [rax + 8]
	test	r8, r8
	jz	Ldpe_rear_next
	mov	r9, QWORD PTR [r8]
	cmp	r9, QWORD PTR [rbp - 16]
	je	Ldpe_remove
Ldpe_rear_next:
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	jmp	Ldpe_rear_loop
Ldpe_remove:
	mov	r10, QWORD PTR [rax]
	mov	rcx, QWORD PTR [rbp - 48]
	test	rcx, rcx
	jz	Ldpe_remove_head
	mov	QWORD PTR [rcx], r10
	jmp	Ldpe_removed_link
Ldpe_remove_head:
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rcx], r10
Ldpe_removed_link:
	mov	QWORD PTR [rbp - 24], r8
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r11d, DWORD PTR [rax + 16]
	test	r11d, r11d
	jz	Ldpe_depth_done
	sub	r11d, 1
	mov	DWORD PTR [rax + 16], r11d
Ldpe_depth_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_exit_payload_free
	mov	rdi, QWORD PTR [rbp - 32]
	call	free
	jmp	Ldpe_done
Ldpe_not_found:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Ldpe_done:
	leave
	ret
	.globl	silica_rt_supervisor_maybe_restart
	.p2align	2
silica_rt_supervisor_maybe_restart:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 80], rdx
	mov	rcx, QWORD PTR [rsi + 216]
	test	rcx, rcx
	jz	Lmr_done
# A supervisor that has ended restarts and tombstones nothing: its children are being shut down
# (silica_rt_sup_shutdown_children) and its rows go with it.
	cmp	DWORD PTR [rsi + 152], 0
	je	Lmr_done
	mov	rax, QWORD PTR [rcx + 24]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jz	Lmr_done
	mov	rax, QWORD PTR [rcx + 32]
	mov	QWORD PTR [rbp - 32], rax
	test	rax, rax
	jz	Lmr_done
	mov	QWORD PTR [rbp - 40], 0
Lmr_scan:
	mov	rax, QWORD PTR [rbp - 40]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_done
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_walk_scan:
	test	r10, r10
	jz	Lmr_scan_at_row
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_walk_scan
Lmr_scan_at_row:
	mov	QWORD PTR [rbp - 48], rcx
	mov	r8, QWORD PTR [rcx]
	cmp	r8, QWORD PTR [rbp - 8]
	jne	Lmr_next
	mov	rdi, QWORD PTR [rcx + 40]
	cmp	rdi, 9
	je	Lmr_can_restart
	cmp	rdi, 10
	je	Lmr_check_transient
	jmp	Lmr_tombstone_done
Lmr_check_transient:
	cmp	QWORD PTR [rbp - 80], 0
	je	Lmr_tombstone_done
Lmr_can_restart:
	mov	rax, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rax + 216]
	mov	r8, QWORD PTR [rax + 64]
	mov	r9, QWORD PTR [rax + 72]
	mov	r10, r8
	or	r10, r9
	jz	Lmr_freq_ok
	test	r8, r8
	jz	Lmr_freq_escalate
	xor	edi, edi
	call	time
	mov	QWORD PTR [rbp - 56], rax
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rcx, QWORD PTR [rcx + 216]
	mov	r8, QWORD PTR [rcx + 88]
	test	r8, r8
	jz	Lmr_freq_first
	mov	r9, QWORD PTR [rcx + 72]
	mov	r10, rax
	sub	r10, r8
	cmp	r10, r9
	ja	Lmr_freq_reset
	mov	r8, QWORD PTR [rcx + 80]
	add	r8, 1
	mov	r9, QWORD PTR [rcx + 64]
	cmp	r8, r9
	ja	Lmr_freq_escalate
	mov	QWORD PTR [rcx + 80], r8
	jmp	Lmr_freq_ok
Lmr_freq_first:
Lmr_freq_reset:
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rcx, QWORD PTR [rcx + 216]
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rcx + 88], rax
	mov	r8d, 1
	mov	QWORD PTR [rcx + 80], r8
	mov	r9, QWORD PTR [rcx + 64]
	cmp	r8, r9
	ja	Lmr_freq_escalate
	jmp	Lmr_freq_ok
Lmr_freq_escalate:
# The breach ends the supervisor abnormally (§15.4.13.2): reason tag 4, (:explicit, breach atom), as
# supervisor_fail_duplicate_child_id; its parent applies its own restart rules to it.
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rcx + 232], 4
	lea	rax, [rip + silica_rt_restart_breach_atom]
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rcx + 384], rax
# Claim sync_failure_reported BEFORE mark-dead+signal. Otherwise actor_thread_main can
# observe alive==0, take LBB1_exit, and emit a duplicate root failure banner/note.
	mov	rcx, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rcx + 192]
	test	r8, r8
	jnz	Lmr_freq_escalate_mark_dead
# The synchronous report (children shut down first) is made only by the supervisor's own dispatch,
# on its own stack. Elsewhere (a dying dangerous child draining the ingress in its exit path, a
# kill_abnormal or call_supervisor caller) the wait for the children could wait on the drainer
# itself: a child blocked in kill_abnormal waits for the dying child's exit_done. The supervisor
# is then only marked ended; its own exit path shuts the children down and reports (deliver_exit,
# as for any root actor). The test is the carrier's running actor, not the thread's current
# actor: a drain on another actor's stack runs this with the supervisor installed as the current
# actor (supervisor_drain_ingress). silica_rt_sup_on_own_dispatch, prims_actors_carrier_asm.
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_sup_on_own_dispatch
	test	rdi, rdi
	jz	Lmr_freq_escalate_mark_dead
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rdx, QWORD PTR [rcx + 216]
	mov	r8, QWORD PTR [rdx + 40]
	test	r8, r8
	jnz	Lmr_freq_escalate_mark_dead
	mov	QWORD PTR [rdx + 40], 1
	lea	rdi, [rcx + 16]
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 16]
	mov	DWORD PTR [rcx + 152], 0
	mov	rdi, rcx
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
# The children are shut down before the root's report goes out, so their reports precede it (the
# FailureReporter may end the program on the root's).
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_sup_shutdown_children
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_root_report_and_note
	jmp	Lmr_found_kept
Lmr_freq_escalate_mark_dead:
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 16]
	mov	DWORD PTR [rcx + 152], 0
	mov	rdi, rcx
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	jmp	Lmr_found_kept
Lmr_freq_ok:
	mov	rax, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rax + 216]
	mov	rdi, QWORD PTR [rax + 56]
	cmp	rdi, 13
	je	Lmr_ofa_kill
	cmp	rdi, 14
	je	Lmr_rfo_kill
	jmp	Lmr_ofo
Lmr_ofo:
# Phase E e4f: pass row_ptr (x24) as X3 so the new child's actor_thread_main can flag
# this row's exit_done on its own teardown; clear stale exit_done from prior incarnation.
# Every restart respawns through silica_rt_supervisor_respawn_row (§20.3.1: a name another actor
# took since the child ended fails the supervisor instead, and a result of 1 ends the restart).
	mov	rdi, QWORD PTR [rbp - 48]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_respawn_row
	test	rdi, rdi
	jnz	Lmr_found_kept
	jmp	Lmr_found_restarted
Lmr_ofa_kill:
	mov	QWORD PTR [rbp - 56], 0
Lmr_ofa_kill_loop:
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_ofa_spawn
	cmp	rax, QWORD PTR [rbp - 40]
	je	Lmr_ofa_kill_next
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_ofa_kill_walk_idx:
	test	r10, r10
	jz	Lmr_ofa_kill_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_ofa_kill_walk_idx
Lmr_ofa_kill_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	rcx, QWORD PTR [rcx]
	mov	QWORD PTR [rbp - 72], rcx
	test	rcx, rcx
	jz	Lmr_ofa_kill_next
# Sequential stop (spec §15.4.12.2): the sibling is ended (reason kept: the supervisor's own stop)
# and this row's exit_done is waited for, with the identity read before the stop (row +112), so
# two teardowns never overlap; the supervisor in its own dispatch, or a carrier actor draining the
# ingress, parks for it on its own stack; main and a dangerous actor's thread spin
# (prims_actors_carrier_asm.silica, silica_rt_row_wait). The holder of the restart token is never
# a row this cascade stops (child_table header), so the wait cannot be for the holder itself.
	mov	rax, QWORD PTR [rbp - 64]
	mov	rax, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 88], rax
	mov	rdi, rcx
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_actor_stop
	mov	rdx, rdi
	mov	rdi, QWORD PTR [rbp - 64]
	mov	rsi, QWORD PTR [rbp - 88]
	xor	ecx, ecx
	call	silica_rt_row_wait
Lmr_ofa_kill_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_ofa_kill_loop
Lmr_ofa_spawn:
	mov	QWORD PTR [rbp - 56], 0
Lmr_ofa_spawn_loop:
# Phase E e4f: per-user-spec sequential start — spawn_linked itself spins on the new
# child's ACB[+288] before returning, so iteration k cannot proceed until child k's
# thread has finished its TLS init / first-schedule. Children come up in list order,
# one at a time, after every cascaded stop has retired.
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_found_restarted
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_ofa_spawn_walk_idx:
	test	r10, r10
	jz	Lmr_ofa_spawn_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_ofa_spawn_walk_idx
Lmr_ofa_spawn_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	r8, QWORD PTR [rcx]
	test	r8, r8
	jz	Lmr_ofa_spawn_next
	mov	rdi, rcx
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_respawn_row
	test	rdi, rdi
	jnz	Lmr_found_kept
Lmr_ofa_spawn_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_ofa_spawn_loop
Lmr_rfo_kill:
	mov	rax, QWORD PTR [rbp - 40]
	add	rax, 1
	mov	QWORD PTR [rbp - 56], rax
Lmr_rfo_kill_loop:
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_rfo_spawn
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_rfo_kill_walk_idx:
	test	r10, r10
	jz	Lmr_rfo_kill_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_rfo_kill_walk_idx
Lmr_rfo_kill_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	rcx, QWORD PTR [rcx]
	mov	QWORD PTR [rbp - 72], rcx
	test	rcx, rcx
	jz	Lmr_rfo_kill_next
# Sequential stop, as the :one_for_all loop above: stop, then the wait for this row's exit_done to
# carry the identity read before the stop.
	mov	rax, QWORD PTR [rbp - 64]
	mov	rax, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 88], rax
	mov	rdi, rcx
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_actor_stop
	mov	rdx, rdi
	mov	rdi, QWORD PTR [rbp - 64]
	mov	rsi, QWORD PTR [rbp - 88]
	xor	ecx, ecx
	call	silica_rt_row_wait
	mov	rdi, QWORD PTR [rbp - 16]
	mov	rsi, QWORD PTR [rbp - 72]
	call	silica_rt_supervisor_drop_pending_exit
	mov	rcx, QWORD PTR [rbp - 64]
# Tombstone the row only after the child has fully exited so Lmr_rfo_spawn does not run
# with a stale child_ref in the slot.
	mov	QWORD PTR [rcx], 0
Lmr_rfo_kill_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_rfo_kill_loop
Lmr_rfo_spawn:
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rbp - 56], rax
Lmr_rfo_spawn_loop:
# Phase E e4f: per-user-spec sequential start — children come up in list order, one
# at a time. spawn_linked blocks on each new child's ACB[+288] (set in actor_thread_main
# right after TLS init / trampoline) so iteration k+1 can never run alongside iteration k.
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_found_restarted
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_rfo_spawn_walk_idx:
	test	r10, r10
	jz	Lmr_rfo_spawn_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_rfo_spawn_walk_idx
Lmr_rfo_spawn_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	rdi, rcx
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_respawn_row
	test	rdi, rdi
	jnz	Lmr_found_kept
Lmr_rfo_spawn_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_rfo_spawn_loop
Lmr_next:
	add	QWORD PTR [rbp - 40], 1
	jmp	Lmr_scan
Lmr_tombstone_done:
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax], 0
