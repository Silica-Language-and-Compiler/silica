silica_rt_message_measure:
# X0 = value, X1 = root descriptor -> X0 = bytes (-1: no table): the same walk with ONE table for the whole
# value (the spine flag off at the root, so nothing empties it): the size of a message copy, in which two
# parts of one message that share a node share its copy (chunk 15 phase 4a, design §5.1; R4.2).
	mov	r9, 0
