silica_rt_stack_runtime_init:
# Read the platform page and the default reservation (physical memory + swap) once; then the carrier
# count, the machine's core counts, the :release_when_idle period and the idle-stack budget (header).
# _SC_PAGESIZE = 30, _SC_PHYS_PAGES = 85; struct sysinfo (112 B): totalswap @64, mem_unit (u32) @104.
# Frame: [rbp - 8] = &silica_rt_stack_init_done (x19), [rbp - 16] = page (x20);
# [rsp + 32] = pages * page, [rsp + 48 .. 160) = struct sysinfo. The Apple module's x21 (the value
# being parsed) is r10 here: each parse loop and what it stores run between calls, nothing crosses one.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 240
	lea	rax, [rip + silica_rt_stack_init_done]
	mov	QWORD PTR [rbp - 8], rax
	cmp	QWORD PTR [rax], 0
	jne	Lsri_done
	mov	edi, 30
	call	sysconf
	cmp	rax, 0
	jg	Lsri_have_page
	mov	eax, 4096
Lsri_have_page:
	mov	QWORD PTR [rbp - 16], rax
	lea	rcx, [rip + silica_rt_stack_page]
	mov	QWORD PTR [rcx], rax
	mov	edi, 85
	call	sysconf
	xor	ecx, ecx
	cmp	rax, 0
	cmovle	rax, rcx
	imul	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rsp + 32], rax
	lea	rdi, [rsp + 48]
	call	sysinfo
	test	eax, eax
	jz	Lsri_swap_ok
	mov	QWORD PTR [rsp + 112], 0
	mov	DWORD PTR [rsp + 152], 1
Lsri_swap_ok:
	mov	r10, QWORD PTR [rsp + 32]
	mov	r11, QWORD PTR [rsp + 112]
	mov	eax, DWORD PTR [rsp + 152]
	test	eax, eax
	jnz	Lsri_unit_ok
	mov	eax, 1
Lsri_unit_ok:
	imul	r11, rax
	add	r10, r11
	test	r10, r10
	jnz	Lsri_have_total
	mov	r10, 17179869184
Lsri_have_total:
	mov	r11, QWORD PTR [rbp - 16]
	sub	r11, 1
	add	r10, r11
	not	r11
	and	r10, r11
	lea	rax, [rip + silica_rt_stack_default_reserve]
	mov	QWORD PTR [rax], r10
# The carrier count (item N): SILICA_CARRIER_COUNT=<n> in the environment (decimal, n >= 1; unset,
# 0 or anything else is ignored), else the machine's logical cores (hw.logicalcpu through the
# sysctl shim: sysconf(_SC_NPROCESSORS_ONLN)), at least 1. Carriers are the only model
# (prims_actors_carrier_asm.silica header): there is no gate. r10 = the count being parsed.
	lea	rdi, [rip + L_srt_carrier_count_env]
	call	getenv
	xor	r10d, r10d
	test	rax, rax
	jz	Lsri_count_sysctl
Lsri_count_digit:
	movzx	ecx, BYTE PTR [rax]
	sub	ecx, 48
	cmp	ecx, 9
	ja	Lsri_count_parsed
	imul	r10, r10, 10
	add	r10, rcx
	inc	rax
	jmp	Lsri_count_digit
Lsri_count_parsed:
	test	r10, r10
	jnz	Lsri_count_have
Lsri_count_sysctl:
	lea	rdi, [rip + L_srt_hw_logicalcpu]
	call	silica_rt_sysctl_u64
	mov	r10, rdi
	test	r10, r10
	jnz	Lsri_count_have
	mov	r10d, 1
Lsri_count_have:
	mov	QWORD PTR [rip + silica_rt_carrier_count], r10
# The machine's own counts (item N stage 3), whatever the carrier count: the logical cores
# (hw.logicalcpu, at least 1), which bound the core ids placement accepts, and the performance
# cores among them (hw.perflevel0.logicalcpu: the P cores are ids [0, P) as get_cpu_topology
# reports them; on Linux the shim answers the logical count for both, every core a P core).
	lea	rdi, [rip + L_srt_hw_logicalcpu]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jnz	Lsri_logical_have
	mov	edi, 1
Lsri_logical_have:
	mov	QWORD PTR [rip + silica_rt_logical_cpu_count], rdi
	lea	rdi, [rip + L_srt_hw_perf0_logicalcpu]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jnz	Lsri_pcore_have
	mov	rdi, QWORD PTR [rip + silica_rt_logical_cpu_count]
Lsri_pcore_have:
	mov	QWORD PTR [rip + silica_rt_pcore_count], rdi
# The :release_when_idle period: SILICA_IDLE_RELEASE_MS=<ms> (decimal; the digits up to the first
# other character; unset, 0 or no digits keeps spec §15.1.2.2's 1000 ms; clamped to 3,600,000 ms, an
# hour), kept in nanoseconds; and a busy carrier's sweep cadence, min(250 ms, the period / 4).
