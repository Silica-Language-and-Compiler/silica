	mov	DWORD PTR [rdi], 0
	mov	esi, 129
	mov	edx, 1
	xor	r10d, r10d
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
Lsru_done:
	ret
