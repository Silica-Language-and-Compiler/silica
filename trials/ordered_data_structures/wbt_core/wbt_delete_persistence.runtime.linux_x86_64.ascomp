# arrive at Lmr_found_kept: the child was not restarted).
Lmr_found_kept:
	mov	rdi, QWORD PTR [rbp - 48]
	xor	esi, esi
	leave
	ret
Lmr_found_restarted:
	mov	rdi, QWORD PTR [rbp - 48]
	mov	esi, 1
	leave
	ret
Lmr_done:
	xor	edi, edi
	xor	esi, esi
	leave
	ret
	.globl	silica_rt_child_table_first_ref
	.p2align	2
silica_rt_child_table_first_ref:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 216]
	test	rax, rax
	jz	Lctfr_empty
	mov	rax, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jz	Lctfr_empty
	mov	rcx, rax
Lctfr_scan:
	mov	rdi, QWORD PTR [rcx]
	test	rdi, rdi
	jnz	Lctfr_found
	mov	rcx, QWORD PTR [rcx + 80]
	test	rcx, rcx
	jz	Lctfr_empty
	jmp	Lctfr_scan
Lctfr_found:
	mov	rdi, QWORD PTR [rcx + 112]
	jmp	Lctfr_done
Lctfr_empty:
	mov	rdi, -1
Lctfr_done:
	leave
	ret
	.globl	silica_rt_child_table_row_ref
	.p2align	2
silica_rt_child_table_row_ref:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 16], rdi
	mov	r8, QWORD PTR [rdi + 216]
	test	r8, r8
	jz	Lctrr_empty
	mov	r9, QWORD PTR [r8 + 32]
	mov	r8, QWORD PTR [r8 + 24]
	test	r8, r8
	jz	Lctrr_empty
	test	r9, r9
	jz	Lctrr_empty
	mov	rax, QWORD PTR [rbp - 8]
	cmp	rax, 0
	jl	Lctrr_empty
	cmp	rax, r9
	jae	Lctrr_empty
	mov	r11, r8
	mov	rcx, rax
Lctrr_walk:
	test	rcx, rcx
	jz	Lctrr_at
	mov	r11, QWORD PTR [r11 + 80]
	test	r11, r11
	jz	Lctrr_empty
	sub	rcx, 1
	jmp	Lctrr_walk
Lctrr_at:
	mov	rdi, QWORD PTR [r11]
	test	rdi, rdi
	jz	Lctrr_empty
	mov	rdi, QWORD PTR [r11 + 112]
	jmp	Lctrr_done
Lctrr_empty:
	mov	rdi, -1
Lctrr_done:
	leave
	ret
	.globl	silica_rt_supervisor_count_children
	.p2align	2
silica_rt_supervisor_count_children:
# rdi = the supervisor's reference: resolved and held for the body (silica_rt_sup_ref_call; an ended
# supervisor raises actor_not_found).
	lea	r10, [rip + silica_rt_supervisor_count_children_acb]
	jmp	silica_rt_sup_ref_call
	.globl	silica_rt_supervisor_count_children_acb
	.p2align	2
silica_rt_supervisor_count_children_acb:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_tls_current_actor_get
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_ingress
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Lsbh_1
	mov	rax, QWORD PTR [rax + 24]
Lsbh_1:
	mov	QWORD PTR [rbp - 16], rax
	mov	QWORD PTR [rbp - 24], 0
Lscount_loop:
	mov	rax, QWORD PTR [rbp - 16]
	test	rax, rax
	jz	Lscount_done
	mov	r8, QWORD PTR [rax]
	test	r8, r8
	jz	Lscount_next
	add	QWORD PTR [rbp - 24], 1
Lscount_next:
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 16], rax
	jmp	Lscount_loop
Lscount_done:
	mov	rdi, QWORD PTR [rbp - 24]
	leave
	ret
	.globl	silica_rt_supervisor_get_child
	.p2align	2
silica_rt_supervisor_get_child:
# rdi = the supervisor's reference: resolved and held for the body (silica_rt_sup_ref_call; an ended
# supervisor raises actor_not_found).
	lea	r10, [rip + silica_rt_supervisor_get_child_acb]
	jmp	silica_rt_sup_ref_call
	.globl	silica_rt_supervisor_get_child_acb
	.p2align	2
silica_rt_supervisor_get_child_acb:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	call	silica_rt_tls_current_actor_get
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_ingress
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Lsbh_2
	mov	rax, QWORD PTR [rax + 24]
Lsbh_2:
	mov	r9, rax
Lsget_loop:
	test	r9, r9
	jz	Lsget_none
	mov	r10, QWORD PTR [r9]
	test	r10, r10
	jz	Lsget_next
	mov	r11, QWORD PTR [r9 + 8]
	cmp	r11, QWORD PTR [rbp - 16]
