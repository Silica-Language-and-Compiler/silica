	je	Lsc_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	add	QWORD PTR [rax + 32], 1
	jmp	Lsc_done
Lsc_id_taken:
	mov	QWORD PTR [rbp - 16], 0
Lsc_done:
# The answer is the new child's identity (row +112, §15.1.4); no child is the all-ones identity.
	mov	rdi, -1
	cmp	QWORD PTR [rbp - 16], 0
	je	Lsc_ret
	mov	rax, QWORD PTR [rbp - 72]
	mov	rdi, QWORD PTR [rax + 112]
Lsc_ret:
	leave
	ret
	.p2align	2
# silica_rt_supervisor_handle_notice(rdi = supervisor, rsi = its ingress node, rdx = the exit notice
# payload): maybe_restart on the draining actor's stack, then the payload (and its hold on the
# ended child) and the node go. The thread's current actor stays the drainer (or none, for main):
# the supervisor is passed to maybe_restart (rsi) and from there to every row walk and respawn
# (respawn_row, spawn_child_row_by_flavor, actor_spawn_linked_row r9, which also names the
# supervisor's stack policy for the child), so nothing attributed to the current actor during
# the drain (a failure of the drainer, a fault's report, a park decision, self()) names the
# supervisor. Until 2026-10-20 the supervisor was installed as the current actor here for the
# duration (and in add_child), which made a respawn's wait for a child supervisor's start spin
# instead of park (spawn_wait_started read the current actor) and would have failed the
# supervisor, on the drainer's stack, for a failure of the drainer.
# [rbp-8] supervisor (x24), [rbp-16] node (x22), [rbp-24] payload (x21).
silica_rt_supervisor_handle_notice:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 48
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 24]
	call	silica_rt_supervisor_restart_and_report
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_exit_payload_free
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
	leave
	ret
# silica_rt_supervisor_drain_run(rdi = a supervisor whose restart token the caller holds): every
# node in the ingress is dequeued (under the supervisor's lock) and handled; one that is not an
# exit notice (+24 != 0, a trial hook's message) is dropped here, the supervisor's own dispatch runs
# those. [rbp-8] supervisor (x19), [rbp-16] node (x20), [rbp-24] payload (x21).
	.p2align	2
silica_rt_supervisor_drain_run:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
Lsdrain_loop:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rdi + 216]
	mov	QWORD PTR [rbp - 16], 0
	test	rdi, rdi
	jz	Lsdrain_empty
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	Lsdrain_empty
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r9d, DWORD PTR [rax + 16]
	test	r9d, r9d
	jz	Lsdrain_depth_done
	sub	r9d, 1
	mov	DWORD PTR [rax + 16], r9d
Lsdrain_depth_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 16]
	mov	r9d, DWORD PTR [rax + 24]
	test	r9d, r9d
	jnz	Lsdrain_free_msg
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	Lsdrain_free_msg
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 16]
	mov	rdx, rcx
	call	silica_rt_supervisor_handle_notice
	jmp	Lsdrain_loop
Lsdrain_free_msg:
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
	jmp	Lsdrain_loop
Lsdrain_empty:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	leave
	ret
# silica_rt_supervisor_drain_ingress(rdi = supervisor, rsi = the actor draining; 0 = main): the
# restart protocol's entry for everyone but the supervisor's own dispatch and a dying row child. The
# restart token (block #120, silica_rt_sup_restart_acquire) is taken, every notice is dequeued and
# handled, and the token is released: a notice that arrives after that is the supervisor's own
# dispatch's (signalled at the enqueue and again by the release). A row child of this supervisor
# never takes the token (the cascade it would run could stop the child itself): it waits until the
# token is free and the ingress empty, so the supervisor's dispatch does the restarts. Returns when every
# notice that was in the ingress at entry has been handled by some holder, or at once when the
# supervisor has ended or the draining actor was ended meanwhile.
# [rbp-8] supervisor (x19), [rbp-16] 1 = take the token (x20).
	.p2align	2
silica_rt_supervisor_drain_ingress:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	edx, 1
	test	rsi, rsi
	jz	Lsdi_acquire
	cmp	QWORD PTR [rsi + 192], rdi
	jne	Lsdi_acquire
	cmp	QWORD PTR [rsi + 208], 4096
	jb	Lsdi_acquire
	xor	edx, edx
Lsdi_acquire:
	mov	QWORD PTR [rbp - 16], rdx
	call	silica_rt_sup_restart_acquire
	cmp	rdi, 1
	jne	Lsdi_ret
	cmp	QWORD PTR [rbp - 16], 0
	je	Lsdi_ret
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_run
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_restart_release
Lsdi_ret:
	leave
	ret
# silica_rt_supervisor_drain_hold(rdi = supervisor, rsi = the actor draining; 0 = main) -> rdi = 1
# when the caller holds the restart token after draining (the operations that stop or respawn
# rows, terminate_child and restart_child, hold it across their work and release it after), 0 when
# the supervisor has ended or has no block, or the caller was ended while it waited (nothing
# drained, nothing held). A row child of this supervisor never drains (the rule of
# drain_ingress: a pending notice's cascade could stop the child itself, and it would then wait
# for its own exit): it takes the token only once the ingress is empty (acquire mode 2) and holds
# it with nothing to drain. [rbp-8] supervisor (x19).
	.p2align	2
silica_rt_supervisor_drain_hold:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	edx, 1
	test	rsi, rsi
	jz	Lsdh_acquire
	cmp	QWORD PTR [rsi + 192], rdi
	jne	Lsdh_acquire
	cmp	QWORD PTR [rsi + 208], 4096
	jb	Lsdh_acquire
	mov	edx, 2
Lsdh_acquire:
	call	silica_rt_sup_restart_acquire
	cmp	rdi, 1
	jne	Lsdh_no
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_run
	mov	edi, 1
	jmp	Lsdh_ret
Lsdh_no:
	xor	edi, edi
Lsdh_ret:
	leave
	ret
# silica_rt_supervisor_drain_own_exit(rdi = supervisor, rsi = a DANGEROUS row child in its exit path,
# on its own thread): the child restarts itself when it can. If the token is free and its own exit
# notice is the first in the ingress, it takes the token, handles that one notice (maybe_restart:
# under :one_for_all or :rest_for_one the cascade stops its siblings, never its own row, and
# respawns them) and releases. Otherwise it leaves the ingress to the supervisor's own dispatch:
# another holder is at work, or notices precede its own and a restart it ran could stop this very
# actor. A carrier actor never comes here: its supervisor's dispatch restarts it.
# [rbp-8] supervisor (x19), [rbp-16] the child (x20), [rbp-24] node (x21), [rbp-32] payload (x22).
	.p2align	2
silica_rt_supervisor_drain_own_exit:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	call	silica_rt_sup_restart_try
	test	rdi, rdi
	jz	Lsdo_ret
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 216]
	test	rdi, rdi
	jz	Lsdo_unlock
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 24], rdi
	test	rdi, rdi
	jz	Lsdo_unlock
	cmp	DWORD PTR [rdi + 24], 0
	jne	Lsdo_put_back
	mov	rcx, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 32], rcx
	test	rcx, rcx
	jz	Lsdo_put_back
	mov	rax, QWORD PTR [rcx]
	cmp	rax, QWORD PTR [rbp - 16]
	jne	Lsdo_put_back
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r9d, DWORD PTR [rax + 16]
	test	r9d, r9d
	jz	Lsdo_depth_done
	sub	r9d, 1
	mov	DWORD PTR [rax + 16], r9d
Lsdo_depth_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 24]
	mov	rdx, QWORD PTR [rbp - 32]
	call	silica_rt_supervisor_handle_notice
	jmp	Lsdo_release
Lsdo_put_back:
# Not this actor's notice: back to the front, in its place (the front list is the queue's head).
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r9, QWORD PTR [rax]
	mov	QWORD PTR [rcx], r9
	mov	QWORD PTR [rax], rcx
Lsdo_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Lsdo_release:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_restart_release
Lsdo_ret:
	leave
	ret
	.globl	silica_rt_supervisor_add_child
	.p2align	2
silica_rt_supervisor_add_child:
# rdi = the supervisor's reference: resolved and held for the body (silica_rt_sup_ref_call; an ended
# supervisor raises actor_not_found).
	lea	r10, [rip + silica_rt_supervisor_add_child_acb]
	jmp	silica_rt_sup_ref_call
	.globl	silica_rt_supervisor_add_child_acb
	.p2align	2
silica_rt_supervisor_add_child_acb:
# X0 = supervisor ACB, X1 = child_spec -> X0 = the new child. [rbp - 8] TLS handoff (x19),
# [rbp - 16] supervisor, then the child (x20), [rbp - 24] spec (x21), [rbp - 32] caller's TLS actor (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 24], rsi
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 32], rdi
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_drain_ingress
# §20.3.1: an id a live actor or supervisor already holds starts no child; the actor that asked for
# the add fails with (:explicit, :duplicate_child_id). In main (no current actor) it is the
# language-level failure of §15.4.5.5: the atom's name on standard error, exit status 1.
	mov	rax, QWORD PTR [rbp - 24]
	mov	rdi, QWORD PTR [rax + 8]
	call	silica_rt_registry_name_held
	test	rax, rax
	jnz	Ladd_child_duplicate
# The supervisor is named to start_child (rsi) and stays off the thread's current actor, as in
# supervisor_handle_notice: the asking actor remains what a failure or a park is attributed to.
	mov	rdi, QWORD PTR [rbp - 24]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_start_child_in
	leave
	ret
Ladd_child_duplicate:
	mov	rdi, QWORD PTR [rbp - 32]
	test	rdi, rdi
	jz	Ladd_child_duplicate_main
	lea	rax, [rip + silica_rt_duplicate_child_id_atom]
	mov	rsi, QWORD PTR [rax]
	call	silica_rt_actor_fail_current
Ladd_child_duplicate_main:
	mov	edi, 2
	lea	rsi, [rip + L_silica_duplicate_child_id_msg]
	mov	edx, 19
	mov	eax, 1
	syscall
	mov	edi, 1
	call	exit
	jmp	Ladd_child_duplicate_main
	.data
	.p2align	3
	.globl	silica_rt_restart_breach_atom
silica_rt_restart_breach_atom:
	.quad	92
	.data
	.p2align	3
