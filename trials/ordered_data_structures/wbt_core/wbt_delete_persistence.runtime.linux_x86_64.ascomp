	jmp	Lsta_live
Lsta_extend:
# No hole of this size: the pop-only entry answers 0 here. Else the node is [edge - n, edge). The pages
# below the committed run are committed first; the lowest page of the reservation is never committed
# (_silica_rt_stack_grow_to), so a lowered reservation that cannot hold the node answers 0.
	cmp	QWORD PTR [rbp - 80], 0
	jne	Lsta_fail
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 528]
	mov	rax, r10
	mov	rbx, QWORD PTR [rbp - 64]
	sub	rax, rbx
	mov	r10, rax
	mov	rax, QWORD PTR [rbp - 56]
	mov	rbx, QWORD PTR [rax + 272]
	mov	QWORD PTR [rbp - 8], rbx
	mov	rax, QWORD PTR [rbp - 56]
	mov	r11, QWORD PTR [rax + 280]
	mov	rax, QWORD PTR [rbp - 8]
	lea	rax, [rax + r11]
	mov	r11, rax
	mov	rax, QWORD PTR [rbp - 56]
	mov	r12, QWORD PTR [rax + 288]
	mov	rax, r11
	sub	rax, r12
	mov	r11, rax
	cmp	r10, r11
	jae	Lsta_committed
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, r10
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	silica_rt_stack_grow_to
	mov	rsp, rbp
	pop	rbp
	cmp	rdi, 1
	je	Lsta_fail
	cmp	rdi, 2
	je	Lsta_fail
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 528]
	mov	rax, r10
	mov	rbx, QWORD PTR [rbp - 64]
	sub	rax, rbx
	mov	r10, rax
Lsta_committed:
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 528], r10
	mov	rdi, r10
Lsta_live:
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 568]
	mov	rbx, QWORD PTR [rbp - 64]
	lea	rax, [r10 + rbx]
	mov	r10, rax
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 568], r10
	jmp	Lsta_ret
Lsta_fail:
	mov	rdi, 0
Lsta_ret:
	mov	rbx, QWORD PTR [rsp + 32]
	mov	QWORD PTR [rbp - 72], rbx
	mov	rbx, QWORD PTR [rsp + 40]
	mov	QWORD PTR [rbp - 80], rbx
	mov	rbx, QWORD PTR [rsp + 16]
	mov	QWORD PTR [rbp - 56], rbx
	mov	rbx, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 64], rbx
	leave
	ret
	.globl	silica_rt_state_free
	.p2align	4
silica_rt_state_free:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 128
# X0 = ACB, X1 = a node of the state area, X2 = its bytes. The node's first word becomes the list link; a
# node above 1,024 bytes keeps its size in its second word. Leaf; X8-X10. The node was handed out by
# _silica_rt_state_alloc, which committed the header's page before it read a head, and a state area
# holding nodes is never decommitted (decision 27), so the header is committed here.
	mov	rbx, QWORD PTR [rdi + 272]
	mov	QWORD PTR [rbp - 8], rbx
	mov	r10, QWORD PTR [rdi + 280]
	mov	rax, QWORD PTR [rbp - 8]
	lea	rax, [rax + r10]
	mov	r10, rax
	lea	r10, [r10 - 1040]
	cmp	rdx, 1024
	ja	Lstfr_large
	mov	rax, rdx
	shr	rax, 3
	mov	r11, rax
	lea	r11, [r11 - 1]
	lea	rax, [r10 + r11*8]
	mov	r10, rax
	jmp	Lstfr_push
Lstfr_large:
	lea	r10, [r10 + 1024]
	mov	QWORD PTR [rsi + 8], rdx
Lstfr_push:
	mov	r11, QWORD PTR [r10]
	mov	QWORD PTR [rsi], r11
	mov	QWORD PTR [r10], rsi
	mov	r11, QWORD PTR [rdi + 568]
	mov	rax, r11
	sub	rax, rdx
	mov	r11, rax
	mov	QWORD PTR [rdi + 568], r11
	leave
	ret
	.globl	silica_rt_state_retain_node
	.p2align	4
silica_rt_state_retain_node:
# alloc_buf_retained's runtime half (chunk 15 phase 7, the pin rule; design §7). X0 = a 16-aligned block of
# X1 bytes in the running behaviour's own frame (L_dyn_alloc), X2 = the element count -> X0 = the element
# pointer, or 0 when there is no current actor or the state header cannot be committed.
# Block (X1 = round16(n + 24) bytes): the buffer NODE is the block's last round8(n + 8) bytes, laid out as
# every buffer's (the count, then the bytes, zeroed; the value points past the count), so that once
# placed it is exactly the node an alloc_buf buffer of n bytes is and the epilogue's retire
# (prims_actors@bmv_state_buffer_retire_asm: node buf - 8, length word plus elements rounded to 8) frees
# all of it. The block's first G = X1 - round8(n + 8) bytes (16 or 24) are the front gap: +0 the pending
# link, +8 G. An exact-size hole of the state area is taken when one is free (it is a state node already,
# counted by _silica_rt_state_alloc's Lsta_live): its front gap is pushed back on the free lists at once
# and the frame block is simply left to the frame. Otherwise the frame block is pushed on the PENDING
# list, whose head is the spare word of the state header at top - 8 (the 129 free-list heads end at
# top - 16), and _silica_rt_state_dispatch_end makes its node a state node in place and its front gap a
# hole. Blocks of one dispatch are taken from one frame's dynamic part, whose floor only goes down, so
# the list runs from the lowest block (the head) upwards.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 176
	mov	rbx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rsp + 16], rbx
	mov	rbx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rsp + 24], rbx
	mov	rbx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rsp + 32], rbx
	mov	rbx, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rsp + 40], rbx
	mov	QWORD PTR [rbp - 64], rdi
	mov	QWORD PTR [rbp - 72], rsi
	mov	QWORD PTR [rbp - 80], rdx
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	silica_rt_tls_current_actor_get
	mov	rsp, rbp
	pop	rbp
	cmp	rdi, 0
	je	Lstrn_fail
	mov	QWORD PTR [rbp - 56], rdi
	mov	rsi, QWORD PTR [rbp - 72]
	call	silica_rt_state_hole_pop
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 288]
	cmp	r10, 1040
	jb	Lstrn_fail
	mov	rax, QWORD PTR [rbp - 80]
	lea	r12, [rax + 15]
	mov	rax, r12
	and	rax, -8
	mov	r12, rax
	mov	rax, QWORD PTR [rbp - 72]
	sub	rax, r12
	mov	r12, rax
	cmp	rdi, 0
	je	Lstrn_pending
	mov	QWORD PTR [rbp - 64], rdi
# The hole's front gap goes back on its free list (a leaf: X8-X10 only, so X11 survives).
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, QWORD PTR [rbp - 64]
	mov	rdx, r12
	call	silica_rt_state_free
	jmp	Lstrn_fill
Lstrn_pending:
	mov	rax, QWORD PTR [rbp - 56]
	mov	rbx, QWORD PTR [rax + 272]
	mov	QWORD PTR [rbp - 8], rbx
	mov	rax, QWORD PTR [rbp - 56]
	mov	r10, QWORD PTR [rax + 280]
	mov	rax, QWORD PTR [rbp - 8]
	lea	rax, [rax + r10]
	mov	r10, rax
	mov	r11, QWORD PTR [r10 - 8]
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax], r11
	mov	rbx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [r10 - 8], rbx
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax + 8], r12
Lstrn_fill:
	mov	rax, QWORD PTR [rbp - 64]
	lea	rax, [rax + r12]
	mov	r13, rax
	mov	rbx, QWORD PTR [rbp - 80]
	mov	QWORD PTR [r13], rbx
	lea	rdi, [r13 + 8]
	mov	rax, QWORD PTR [rbp - 64]
	mov	rbx, QWORD PTR [rbp - 72]
	lea	rax, [rax + rbx]
	mov	r11, rax
	mov	r10, rdi
Lstrn_zero:
	cmp	r10, r11
	jae	Lstrn_ret
	mov	QWORD PTR [r10], 0
	lea	r10, [r10 + 8]
	jmp	Lstrn_zero
Lstrn_fail:
	mov	rdi, 0
Lstrn_ret:
	mov	rbx, QWORD PTR [rsp + 32]
	mov	QWORD PTR [rbp - 72], rbx
	mov	rbx, QWORD PTR [rsp + 40]
	mov	QWORD PTR [rbp - 80], rbx
	mov	rbx, QWORD PTR [rsp + 16]
	mov	QWORD PTR [rbp - 56], rbx
	mov	rbx, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 64], rbx
	leave
	ret

	.globl	silica_rt_state_install
	.p2align	4
silica_rt_state_install:
# X0 = ACB, X1 = the initial state, X2 = its root descriptor (0: a scalar type, or one the descriptors do
# not follow: the value is stored as given) -> X0 = 0, or 1 when the reservation cannot hold the state.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 192
	mov	rbx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rsp + 16], rbx
	mov	rbx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rsp + 24], rbx
	mov	rbx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rsp + 32], rbx
	mov	rbx, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rsp + 40], rbx
	mov	rbx, QWORD PTR [rbp - 88]
	mov	QWORD PTR [rsp + 48], rbx
	mov	QWORD PTR [rbp - 56], rdi
	mov	QWORD PTR [rbp - 64], rsi
	mov	QWORD PTR [rbp - 72], rdx
	mov	rax, QWORD PTR [rbp - 56]
	mov	rbx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rax], rbx
	cmp	QWORD PTR [rbp - 72], 0
	je	Lsti_ok
	cmp	QWORD PTR [rbp - 64], 65536
	jb	Lsti_ok
	mov	rdi, QWORD PTR [rbp - 64]
	mov	rsi, QWORD PTR [rbp - 72]
	call	silica_rt_state_measure
	cmp	rdi, 0
	jl	Lsti_fail
	cmp	rdi, 0
	je	Lsti_ok
# The block is rounded to 16: the edge is the SP every dispatch starts from.
	lea	rax, [rdi + 15]
	mov	QWORD PTR [rbp - 80], rax
	mov	rax, QWORD PTR [rbp - 80]
	and	rax, -16
	mov	QWORD PTR [rbp - 80], rax
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, QWORD PTR [rbp - 80]
	call	silica_rt_state_alloc
	cmp	rdi, 0
	je	Lsti_fail
	mov	QWORD PTR [rbp - 88], rdi
	mov	rdi, QWORD PTR [rbp - 64]
	mov	rsi, QWORD PTR [rbp - 72]
	mov	rdx, QWORD PTR [rbp - 88]
	mov	rax, QWORD PTR [rbp - 88]
	mov	rbx, QWORD PTR [rbp - 80]
	lea	rax, [rax + rbx]
	mov	rcx, rax
	mov	r8, 0
	call	silica_rt_state_copy
	cmp	rsi, 0
	jne	Lsti_fail
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax], rdi
Lsti_ok:
	mov	rdi, 0
	jmp	Lsti_ret
Lsti_fail:
	mov	rdi, 1
Lsti_ret:
	mov	rbx, QWORD PTR [rsp + 48]
	mov	QWORD PTR [rbp - 88], rbx
	mov	rbx, QWORD PTR [rsp + 32]
	mov	QWORD PTR [rbp - 72], rbx
	mov	rbx, QWORD PTR [rsp + 40]
	mov	QWORD PTR [rbp - 80], rbx
	mov	rbx, QWORD PTR [rsp + 16]
	mov	QWORD PTR [rbp - 56], rbx
	mov	rbx, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 64], rbx
	leave
	ret
	.globl	silica_rt_spawn_state_too_large
	.p2align	4
silica_rt_spawn_state_too_large:
# A spawn's initial state does not fit the child's reservation (a lowered one; decision 39). The spawning
# actor fails with (:explicit, :state_too_large); in main the process ends with a runtime abort, status 71.
# Never returns.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 144
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	silica_rt_tls_current_actor_get
	mov	rsp, rbp
	pop	rbp
	cmp	rdi, 0
	je	Lstl_main
	lea	rax, [rip + silica_rt_state_too_large_atom]
	mov	QWORD PTR [rbp - 8], rax
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax]
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	silica_rt_actor_fail_current
	mov	rsp, rbp
	pop	rbp
Lstl_main:
	leave
	and	rsp, -16
	call	silica_rt_abort_state_too_large
	.globl	silica_rt_message_buffer
	.p2align	4
silica_rt_message_buffer:
# The mailbox buffer (chunk 15 phase 4a, design §5.1). X0 = the message, X1 = the root-word descriptor of
# its type -> X0 = the root of the copy, X1 = the buffer's bytes, X2 = the buffer block (malloc'd, freed by
# the receiver's dispatch end, by a failed send, or by the end-of-actor drain). A scalar or atom (below
# 65536), or a value whose measure is 0 (a literal string, a function value), is answered as given with
# X1 = X2 = 0: the message stays inline in the node, as today. The copy is silica_rt_message_copy: one
# table for the whole message, every node once, so the root is the first node bumped and lies at the
# block's start for every kind but a bare buffer (whose root is its element pointer, block + 8; the node
# keeps the block in a word of its own for the free). No memory for the block or the table fails the
# sender as an arena growth failure does (silica_rt_region_alloc_failed; main aborts).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 176
	mov	rbx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rsp + 16], rbx
	mov	rbx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rsp + 24], rbx
	mov	rbx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rsp + 32], rbx
	mov	rbx, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rsp + 40], rbx
	mov	QWORD PTR [rbp - 56], rdi
	mov	QWORD PTR [rbp - 64], rsi
	cmp	QWORD PTR [rbp - 56], 65536
	jb	Lmbf_inline
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, QWORD PTR [rbp - 64]
	call	silica_rt_message_measure
	cmp	rdi, 0
	jl	Lmbf_fail
	cmp	rdi, 0
	je	Lmbf_inline
	mov	QWORD PTR [rbp - 72], rdi
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	malloc
	mov	rsp, rbp
	pop	rbp
	mov	rdi, rax
	cmp	rdi, 0
	je	Lmbf_fail
	mov	QWORD PTR [rbp - 80], rdi
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, QWORD PTR [rbp - 64]
	mov	rdx, QWORD PTR [rbp - 80]
	mov	rax, QWORD PTR [rbp - 80]
	mov	rbx, QWORD PTR [rbp - 72]
	lea	rax, [rax + rbx]
	mov	rcx, rax
	mov	r8, 0
	call	silica_rt_message_copy
	cmp	rsi, 0
	jne	Lmbf_fail
	mov	rsi, QWORD PTR [rbp - 72]
	mov	rdx, QWORD PTR [rbp - 80]
	jmp	Lmbf_ret
Lmbf_inline:
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, 0
	mov	rdx, 0
Lmbf_ret:
	mov	rbx, QWORD PTR [rsp + 32]
	mov	QWORD PTR [rbp - 72], rbx
	mov	rbx, QWORD PTR [rsp + 40]
	mov	QWORD PTR [rbp - 80], rbx
	mov	rbx, QWORD PTR [rsp + 16]
	mov	QWORD PTR [rbp - 56], rbx
	mov	rbx, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 64], rbx
	leave
	ret
Lmbf_fail:
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	silica_rt_region_alloc_failed
	mov	rsp, rbp
	pop	rbp
	.globl	silica_rt_message_forward
	.p2align	4
silica_rt_message_forward:
# Forwarding-only elision (chunk 15 phase 4b, design §5.2, decision 32). The arguments and results of
# silica_rt_message_buffer, plus X2 = the entry of the function sending; called in its place at a
# cast-family site the emitter marked with the |_mvs marker (term_message_copy fn_copy_markers: the operand is the
# behaviour's whole message parameter, used for the last time, no part of it reaching the new state).
# When X2 is the behaviour this actor is dispatching (ACB #8: not a behaviour-shaped helper it called,
# whose caller may still use the message), the node being served (ACB #240) is a plain user cast node
# (+32 = 0, +16 = 0) holding a mailbox buffer (+48) whose root is the message (+8 = X0), and no shallow
# copy has run in this dispatch (ACB #608 = 0: one may hold a pointer into the buffer), the buffer itself
# is handed on: X0 = the root, X1 = the bytes (+40), X2 = the block (+48), and the node's +40/+48 are
# zeroed so that its dispatch end (LBB1_free_user) and the teardown (LBBsigpend_active_user) skip it; the
# new node takes the words through silica_rt_actor_cast as for a fresh copy, and a dropped send frees
# the block there (LBB3_7). In every other case (main, an inline or runtime-cast message, a call
# node, a retained buffer) the message is copied as at any other site.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 160
	mov	rbx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rsp + 16], rbx
	mov	rbx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rsp + 24], rbx
	mov	QWORD PTR [rbp - 56], rdi
	mov	QWORD PTR [rbp - 64], rsi
	lea	rsp, [rsp - 16]
	mov	QWORD PTR [rsp], rdx
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	silica_rt_tls_current_actor_get
	mov	rsp, rbp
	pop	rbp
	mov	r11, QWORD PTR [rsp]
	lea	rsp, [rsp + 16]
	cmp	rdi, 0
	je	Lmfw_copy
	mov	r10, QWORD PTR [rdi + 8]
	cmp	r10, r11
	jne	Lmfw_copy
	mov	r10, QWORD PTR [rdi + 608]
	cmp	r10, 0
	jne	Lmfw_copy
	mov	rbx, QWORD PTR [rdi + 240]
	mov	QWORD PTR [rbp - 8], rbx
	cmp	QWORD PTR [rbp - 8], 0
	je	Lmfw_copy
	mov	rax, QWORD PTR [rbp - 8]
	cmp	DWORD PTR [rax + 32], 0
	jne	Lmfw_copy
	mov	rax, QWORD PTR [rbp - 8]
	cmp	DWORD PTR [rax + 16], 0
	jne	Lmfw_copy
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rax + 48]
	cmp	rdx, 0
	je	Lmfw_copy
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 8]
	cmp	r10, QWORD PTR [rbp - 56]
	jne	Lmfw_copy
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax + 40]
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 40], 0
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 48], 0
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rbx, QWORD PTR [rsp + 16]
	mov	QWORD PTR [rbp - 56], rbx
	mov	rbx, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 64], rbx
	leave
	ret
Lmfw_copy:
	mov	rdi, QWORD PTR [rbp - 56]
	mov	rsi, QWORD PTR [rbp - 64]
	mov	rbx, QWORD PTR [rsp + 16]
	mov	QWORD PTR [rbp - 56], rbx
	mov	rbx, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 64], rbx
	leave
	jmp	silica_rt_message_buffer
	.globl	silica_rt_reply_place
	.p2align	4
silica_rt_reply_place:
# The reply into the blocked caller's stack (chunk 15 phase 4c, design §5.3, decision 33). Called by the
# behaviour epilogue (prims_actors@bmv_reply_stack_asm) with X0 = the reply and X1 = the root-word descriptor
# of its type -> X0 = the root of its copy in the CALLER's stack, or the reply as given when nothing is
# copied: a scalar or atom (below 65536), no current actor, no node being served (ACB #240), a node that
# needs no reply (+16 = 0: a cast that reached a call-style behaviour), or a measure of 0 (a literal string).
# Otherwise the copy goes to [dest, dest + bytes), dest = (the SP the caller published at the call record's
# +152, less the bytes) rounded down to 16. When the published SP lies in the caller's managed reservation
# (node +56 names the caller; main and a path on a carrier thread's own stack need no growth) the
# reservation is grown to dest first (silica_rt_stack_grow_to, with the caller's ACB: a foreign stack is
# committed here, never faulted in); a reply the reservation cannot take (dest below its base, or grow_to
# answering 1 exhausted or 2 refused) sets reply_set (+136) to 4 and leaves the reply as given, and the
# caller fails with (:explicit, :reservation_exceeded) on waking (LBB4_8). The bytes go to +160. Sources are
# read where they lie (the behaviour's frame, live during the epilogue; the state area; the message
# buffer) with ONE table, so sharing inside the reply is kept (R4.2). No table or an overrun fails this
# actor as a mailbox buffer's does (silica_rt_region_alloc_failed).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 192
	mov	rbx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rsp + 16], rbx
	mov	rbx, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rsp + 24], rbx
	mov	rbx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rsp + 32], rbx
	mov	rbx, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rsp + 40], rbx
	mov	rbx, QWORD PTR [rbp - 88]
	mov	QWORD PTR [rsp + 48], rbx
	mov	rbx, QWORD PTR [rbp - 96]
	mov	QWORD PTR [rsp + 56], rbx
	mov	QWORD PTR [rbp - 56], rdi
	mov	QWORD PTR [rbp - 64], rsi
	cmp	QWORD PTR [rbp - 56], 65536
	jb	Lrpl_as_is
	push	rbp
	mov	rbp, rsp
	and	rsp, -16
	call	silica_rt_tls_current_actor_get
