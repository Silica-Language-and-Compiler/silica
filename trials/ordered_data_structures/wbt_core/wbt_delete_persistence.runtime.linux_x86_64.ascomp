# silica_rt_lock_lock(rdi = lock word). Fast path CAS 0 -> 1; slow path swaps in 2 and futex-waits while 2.
	.globl	silica_rt_lock_lock
	.p2align	4
silica_rt_lock_lock:
Lsrl_fast:
	xor	eax, eax
	mov	r10d, 1
	lock cmpxchg	DWORD PTR [rdi], r10d
	jne	Lsrl_slow
	ret
Lsrl_slow:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
Lsrl_swap:
	mov	r10d, 2
	xchg	DWORD PTR [rdi], r10d
	test	r10d, r10d
	jz	Lsrl_owned
	mov	esi, 128
	mov	edx, 2
	xor	r10d, r10d
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
	mov	rdi, QWORD PTR [rbp - 8]
	jmp	Lsrl_swap
Lsrl_owned:
	leave
	ret
# silica_rt_lock_unlock(rdi = lock word). Decrement; if it was 2 (waiters), store 0 and wake one.
	.globl	silica_rt_lock_unlock
