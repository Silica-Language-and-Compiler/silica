# silica_rt_sysctlbyname(rdi = name, rsi = oldp, rdx = oldlenp, rcx = newp, r8 = newlen) -> edi (0 ok, -1 unknown).
# *oldlenp is read and written as a 32-bit count (callers store it with a 32-bit store); 8-byte slots get
# the full value, 4-byte slots the low word.
# Frame slots: [rbp-8] name (X19) / phys pages, [rbp-16] oldp (X20), [rbp-24] oldlenp (X21),
# [rbp-32] table row (X22), [rbp-40] rbx across cpuid.
	.globl	silica_rt_sysctlbyname
	.p2align	4
silica_rt_sysctlbyname:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	lea	rax, [rip + Lsys_table]
	mov	QWORD PTR [rbp - 32], rax
Lsys_scan:
	mov	rax, QWORD PTR [rbp - 32]
	mov	rdi, QWORD PTR [rax]
	test	rdi, rdi
	jz	Lsys_fail
	mov	rsi, QWORD PTR [rbp - 8]
	call	Lsys_streq
	test	edi, edi
	jnz	Lsys_found
	add	QWORD PTR [rbp - 32], 24
	jmp	Lsys_scan
Lsys_found:
	mov	rax, QWORD PTR [rbp - 32]
	mov	r10, QWORD PTR [rax + 8]
	mov	rdi, QWORD PTR [rax + 16]
	cmp	r10, 1
	je	Lsys_sysconf
	cmp	r10, 2
	je	Lsys_cpuid
	cmp	r10, 3
	je	Lsys_memsize
	cmp	r10, 4
	je	Lsys_cpuid
	jmp	Lsys_store
Lsys_sysconf:
	call	sysconf
	xor	edi, edi
	test	rax, rax
	cmovns	rdi, rax
	jmp	Lsys_store
Lsys_cpuid:
# rdi = bit index, r10 = kind (2: leaf 1 ecx, 4: leaf 7 ebx). cpuid writes eax ebx ecx edx.
	mov	r8, rdi
	mov	QWORD PTR [rbp - 40], rbx
	mov	eax, 1
	cmp	r10, 4
	jne	Lsys_cpuid_go
	mov	eax, 7
Lsys_cpuid_go:
	xor	ecx, ecx
	cpuid
	cmp	r10, 4
	jne	Lsys_cpuid_ecx
	mov	eax, ebx
	jmp	Lsys_cpuid_bit
Lsys_cpuid_ecx:
	mov	eax, ecx
Lsys_cpuid_bit:
	mov	rbx, QWORD PTR [rbp - 40]
	mov	ecx, r8d
	shr	eax, cl
	and	eax, 1
	mov	rdi, rax
	jmp	Lsys_store
Lsys_memsize:
	mov	edi, 85
	call	sysconf
	mov	QWORD PTR [rbp - 8], rax
	mov	edi, 30
	call	sysconf
	imul	rax, QWORD PTR [rbp - 8]
	mov	rdi, rax
Lsys_store:
	mov	rsi, QWORD PTR [rbp - 16]
	test	rsi, rsi
	jz	Lsys_ok
	mov	rdx, QWORD PTR [rbp - 24]
	test	rdx, rdx
	jz	Lsys_fail
	mov	r10d, DWORD PTR [rdx]
	cmp	r10d, 8
	jae	Lsys_store8
	cmp	r10d, 4
	jb	Lsys_fail
	mov	DWORD PTR [rsi], edi
	mov	DWORD PTR [rdx], 4
	jmp	Lsys_ok
Lsys_store8:
	mov	QWORD PTR [rsi], rdi
	mov	DWORD PTR [rdx], 8
Lsys_ok:
	xor	edi, edi
	jmp	Lsys_ret
Lsys_fail:
	mov	rdi, -1
Lsys_ret:
	leave
	ret
# Lsys_streq(rdi, rsi = NUL-terminated strings) -> edi = 1 when equal.
Lsys_streq:
	movzx	eax, BYTE PTR [rdi]
	movzx	r10d, BYTE PTR [rsi]
