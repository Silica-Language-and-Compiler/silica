// Layer 2 §8A.3: smart constructor computes exact cached sizes for set and map nodes.

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                set_witness: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_leaf: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 42, set_witness.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_leaf_sz: int64 <- wbt_set@size(set_leaf);
                map_witness: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: :none,
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_leaf: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 42, 100, map_witness.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_leaf_sz: int64 <- wbt_map@size(map_leaf);
                set_child10: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 10, set_witness.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_left_heavy: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 25, set_child10.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_left_heavy_sz: int64 <- wbt_set@size(set_left_heavy);
                set_child40: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 40, set_witness.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_child60: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 60, set_witness.root, set_witness.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_balanced: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- {
                    root: wbt_set@smart_node(set_witness, 50, set_child40.root, set_child60.root),
                    compare_item: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_item_ordering_bundle: 0
                };
                set_balanced_sz: int64 <- wbt_set@size(set_balanced);
                map_child10: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 10, 1000, map_witness.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_left_heavy: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 25, 2500, map_child10.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_left_heavy_sz: int64 <- wbt_map@size(map_left_heavy);
                map_child10b: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 10, 1000, map_witness.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_child90: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 90, 9000, map_witness.root, map_witness.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_balanced: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- {
                    root: wbt_map@smart_node(map_witness, 50, 5000, map_child10b.root, map_child90.root),
                    compare_key: cmp_i64,
                    compare_value: cmp_i64,
                    region: r,
                    specialization_key: 0,
                    compare_key_ordering_bundle: 0,
                    compare_value_ordering_bundle: 0
                };
                map_balanced_sz: int64 <- wbt_map@size(map_balanced);
                exit_code: int64 <- case set_leaf_sz == 1 of {
                    false -> 1;
                    true -> case map_leaf_sz == 1 of {
                        false -> 2;
                        true -> case set_left_heavy_sz == 2 of {
                            false -> 3;
                            true -> case set_balanced_sz == 3 of {
                                false -> 4;
                                true -> case map_left_heavy_sz == 2 of {
                                    false -> 5;
                                    true -> case map_balanced_sz == 3 of {
                                        false -> 6;
                                        true -> 0
                                    }
                                }
                            }
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
