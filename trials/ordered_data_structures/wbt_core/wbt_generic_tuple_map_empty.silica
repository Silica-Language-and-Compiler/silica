// Layer 2 §8A.1: tuple/record map payload uses the same empty-root algorithm as scalar sets.

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_pair(a: (int64, string), b: (int64, string)) -> :less | :equal | :greater {
    (a0: int64, _: string) <- a;
    (b0: int64, _: string) <- b;
    cmp_i64(a0, b0)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                warm: region(L, normal) <- canonical_arena_lookup(1);
                pair_map: {
                    root: ref?(L, normal, ((int64, string), int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn((int64, string), (int64, string)) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- wbt_map@empty({ compare_key: cmp_pair, compare_value: cmp_i64 });
                exit_code: int64 <- case pair_map.specialization_key > 0 of {
                    true -> 0;
                    false -> 1
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
