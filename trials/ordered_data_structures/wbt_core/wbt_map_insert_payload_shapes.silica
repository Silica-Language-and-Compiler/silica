// Layer 2 §8A.6: second key/value shape — string keys, int64 values (distinct from int64/string matrix).

use wbt_map;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: {
                    root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- wbt_map@empty({ compare_key: cmp_str, compare_value: cmp_i64 });
                r1: {
                    map: {
                        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(empty0, "b", 2);
                r2: {
                    map: {
                        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(r1.map, "a", 1);
                r3: {
                    map: {
                        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(r2.map, "c", 3);
                r4: {
                    map: {
                        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(r3.map, "b", 9);
                sz: int64 <- wbt_map@size(r4.map);
                gb: { status: :not_found | :found, value: int64 } <- wbt_map@get(r4.map, "b", 0);
                ga: { status: :not_found | :found, value: int64 } <- wbt_map@get(r4.map, "a", 0);
                old_b: { status: :not_found | :found, value: int64 } <- wbt_map@get(r3.map, "b", 0)
            produces
                pure case r1.inserted of {
                    false -> 1;
                    true -> case r4.replaced of {
                        false -> 2;
                        true -> case sz == 3 of {
                            false -> 3;
                            true -> case ga.status of {
                                :not_found -> 4;
                                :found -> case ga.value == 1 of {
                                    false -> 5;
                                    true -> case gb.status of {
                                        :not_found -> 6;
                                        :found -> case gb.value == 9 of {
                                            false -> 7;
                                            true -> case old_b.status of {
                                                :not_found -> 8;
                                                :found -> case old_b.value == 2 of {
                                                    false -> 9;
                                                    true -> 0
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
