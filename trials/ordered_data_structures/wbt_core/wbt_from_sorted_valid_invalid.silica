// Layer 2 §8A.8 gate: from_sorted accepts strict ascending input and rejects malformed adjacency.
//
// Keep each case in its own function so FP-relative stack slots stay within ARM64
// signed 9-bit range. Construct each List in the same sequence that calls from_sorted —
// do not pass List[(K,V)] into a helper (map binding lists misbehave across that boundary).

use wbt_set;
use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn trap_value(_a: int64, _b: int64) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn set_good_case_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        items: List[int64, mem(normal)] <- [10, 20, 30, 40];
        built: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_set@from_sorted(empty0, items);
        sz: int64 <- wbt_set@size(built.set);
        code: int64 <- wbt_set@from_sorted_error_code(built.error)
    produces
        pure built.valid and code == 0 and sz == 4
    end
}

