fn set_cases_ok() -> boolean {
    sequence
        ok0: boolean <- set_good_case_ok();
        ok1: boolean <- set_desc_begin_case_ok();
        ok2: boolean <- set_desc_mid_case_ok();
        ok3: boolean <- set_desc_end_case_ok();
        ok4: boolean <- set_eq_begin_case_ok();
        ok5: boolean <- set_eq_mid_case_ok();
        ok6: boolean <- set_eq_end_case_ok()
    produces
        pure ok0 and ok1 and ok2 and ok3 and ok4 and ok5 and ok6
    end
}

fn map_good_case_ok() -> boolean {
    sequence proc[mem(normal)]
        empty0: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- wbt_map@empty({ compare_key: cmp_i64, compare_value: trap_value });
        g_a: (int64, int64) <- (10, 100);
        g_b: (int64, int64) <- (20, 200);
        g_c: (int64, int64) <- (30, 300);
        g_d: (int64, int64) <- (40, 400);
        items: List[(int64, int64), mem(normal)] <- [g_a, g_b, g_c, g_d];
        built: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- wbt_map@from_sorted(empty0, items);
        sz: int64 <- wbt_map@size(built.map);
        code: int64 <- wbt_map@from_sorted_error_code(built.error)
    produces
        pure built.valid and code == 0 and sz == 4
    end
}

