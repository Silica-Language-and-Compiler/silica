fn map_cases_ok() -> boolean {
    sequence
        ok0: boolean <- map_good_case_ok();
        ok1: boolean <- map_desc_begin_case_ok();
        ok2: boolean <- map_desc_mid_case_ok();
        ok3: boolean <- map_desc_end_case_ok();
        ok4: boolean <- map_eq_begin_case_ok();
        ok5: boolean <- map_eq_mid_case_ok();
        ok6: boolean <- map_eq_end_case_ok()
    produces
        pure ok0 and ok1 and ok2 and ok3 and ok4 and ok5 and ok6
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                set_ok: boolean <- set_cases_ok();
                map_ok: boolean <- map_cases_ok()
            produces
                pure case set_ok of {
                    false -> 1;
                    true -> case map_ok of { false -> 2; true -> 0 }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
