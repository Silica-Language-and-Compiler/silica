// Layer 2 §16 steps 3–5 (design §4): every forest size 0..36 is reached by ascending and by
// descending pushes, exercising each skew-digit collision pattern; each heap validates and pops in
// sorted order (design §4 forest invariant holds after every skew link and every normalization).

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn sizes(n: int64, max: int64) -> boolean {
    case n > max of {
        true -> true;
        false -> {
            up: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 0, n, 1);
            down: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), n, 0, -1);
            case bo_trial_i64@valid_with_count(up, n) and bo_trial_i64@pops_sorted(up, n) of {
                false -> false;
                true -> case bo_trial_i64@valid_with_count(down, n) and bo_trial_i64@pops_sorted(down, n) of {
                    false -> false;
                    true -> sizes(n + 1, max)
                }
            }
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                all_ok: boolean <- sizes(0, 36)
            produces
                pure pick(all_ok, 1, 0)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
