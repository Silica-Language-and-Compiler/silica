// Layer 2 §16 (design §11): both meld operands and the melded heap stay valid and unchanged after
// pops on any of them; strict bootstrapping means no hidden deferred computation can rewrite an old root.

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                a: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_lcg(bo_trial_i64@new_min(), 11, 25, 0);
                b: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 500, 480, -1);
                a_hash: int64 <- bo_trial_i64@pop_all_hash(a);
                b_hash: int64 <- bo_trial_i64@pop_all_hash(b);
                m: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                compatible: boolean
            } <- brodal_okasaki@meld(a, b);
                m_hash: int64 <- bo_trial_i64@pop_all_hash(m.heap);
                pa: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                status: :not_found | :found,
                value: int64
            } <- brodal_okasaki@pop(a, 0);
                pm: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                status: :not_found | :found,
                value: int64
            } <- brodal_okasaki@pop(m.heap, 0);
                pm2: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                status: :not_found | :found,
                value: int64
            } <- brodal_okasaki@pop(pm.heap, 0);
                a_same: boolean <- bo_trial_i64@pop_all_hash(a) == a_hash and bo_trial_i64@valid_with_count(a, 25);
                b_same: boolean <- bo_trial_i64@pop_all_hash(b) == b_hash and bo_trial_i64@valid_with_count(b, 20);
                m_same: boolean <- bo_trial_i64@pop_all_hash(m.heap) == m_hash and bo_trial_i64@valid_with_count(m.heap, 45);
                pa_ok: boolean <- bo_trial_i64@valid_with_count(pa.heap, 24) and bo_trial_i64@pops_sorted(pa.heap, 24);
                pm_ok: boolean <- bo_trial_i64@valid_with_count(pm2.heap, 43) and bo_trial_i64@pops_sorted(pm2.heap, 43);
                m_min: boolean <- case pm.status of {
                    :found -> pm.value <= pm2.value;
                    :not_found -> false
                }
            produces
                pure pick(m.compatible, 1, pick(a_same, 2, pick(b_same, 3, pick(m_same, 4, pick(pa_ok, 5, pick(pm_ok, 6, pick(m_min, 7, 0)))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
