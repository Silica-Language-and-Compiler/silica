// Design §7 and heap_trait.md §4: from_list pushes every item in order and equals the same pushes.

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                items: List[int64, mem(normal)] <- [9, 4, 7, 4, 1, 8, 2, 6, 3, 5, 0];
                built: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@from_list({ compare_item: cmp_i64 }, false, items);
                pushed0: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 0, 10, 1);
                pushed: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(pushed0, 4);
                built_ok: boolean <- brodal_okasaki@size(built) == 11 and bo_trial_i64@valid_with_count(built, 11) and bo_trial_i64@pops_sorted(built, 11);
                peek_ok: boolean <- bo_trial_i64@peek_is(built, 0);
                same_multiset: boolean <- bo_trial_i64@pop_all_hash(built) == bo_trial_i64@pop_all_hash(pushed);
                dup_ok: boolean <- bo_trial_i64@pop_all_count(built) == 11;
                none_items: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                none_built: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@from_list({ compare_item: cmp_i64 }, true, none_items);
                none_ok: boolean <- brodal_okasaki@is_empty(none_built) and bo_trial_i64@valid_with_count(none_built, 0) and brodal_okasaki@is_max_oriented(none_built);
                max_built: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@from_list({ compare_item: cmp_i64 }, true, items);
                max_ok: boolean <- bo_trial_i64@peek_is(max_built, 9) and bo_trial_i64@pops_sorted(max_built, 11)
            produces
                pure pick(built_ok, 1, pick(peek_ok, 2, pick(same_multiset, 3, pick(dup_ok, 4, pick(none_ok, 5, pick(max_ok, 6, 0))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
