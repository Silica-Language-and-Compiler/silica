// Layer 2 §16 step 7 (design §6): empty and singleton behavior — size, is_empty, peek, pop on the
// empty heap (:not_found, value unchanged), validation with logical count.

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@new_min();
                e_size: boolean <- brodal_okasaki@size(e) == 0 and brodal_okasaki@is_empty(e);
                e_peek: boolean <- bo_trial_i64@peek_missing(e);
                e_pop: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                status: :not_found | :found,
                value: int64
            } <- brodal_okasaki@pop(e, 0);
                e_pop_ok: boolean <- case e_pop.status of {
                    :not_found -> brodal_okasaki@size(e_pop.heap) == 0;
                    :found -> false
                };
                e_valid: boolean <- bo_trial_i64@valid_with_count(e, 0);
                s: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@singleton({ compare_item: cmp_i64 }, false, 42);
                s_size: boolean <- brodal_okasaki@size(s) == 1;
                s_peek: boolean <- bo_trial_i64@peek_is(s, 42);
                s_valid: boolean <- bo_trial_i64@valid_with_count(s, 1);
                s_pop: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                status: :not_found | :found,
                value: int64
            } <- brodal_okasaki@pop(s, 0);
                s_pop_ok: boolean <- case s_pop.status of {
                    :found -> s_pop.value == 42 and brodal_okasaki@size(s_pop.heap) == 0 and bo_trial_i64@peek_missing(s_pop.heap);
                    :not_found -> false
                };
                s_still: boolean <- bo_trial_i64@peek_is(s, 42) and brodal_okasaki@size(s) == 1;
                orient: boolean <- case brodal_okasaki@is_max_oriented(e) of { false -> true; true -> false }
            produces
                pure pick(e_size, 1, pick(e_peek, 2, pick(e_pop_ok, 3, pick(e_valid, 4, pick(s_size, 5, pick(s_peek, 6,
                    pick(s_valid, 7, pick(s_pop_ok, 8, pick(s_still, 9, pick(orient, 10, 0))))))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
