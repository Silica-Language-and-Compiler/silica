// Layer 2 §16 step 8 (design §7): push is persistent and O(1); comparator-equal duplicates are all
// retained and popped one at a time; the heap validates after every push.

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn push_checked(heap: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, x: int64, expected: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    sequence
        next: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- brodal_okasaki@push(heap, x);
        ok: boolean <- bo_trial_i64@valid_with_count(next, expected)
    produces
        pure case ok of {
            true -> next;
            false -> heap
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                h1: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- push_checked(bo_trial_i64@new_min(), 5, 1);
                h2: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- push_checked(h1, 3, 2);
                h3: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- push_checked(h2, 5, 3);
                h4: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- push_checked(h3, 1, 4);
                h5: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- push_checked(h4, 5, 5);
                sizes: boolean <- brodal_okasaki@size(h5) == 5 and brodal_okasaki@size(h1) == 1;
                peek5: boolean <- bo_trial_i64@peek_is(h5, 1) and bo_trial_i64@peek_is(h3, 3) and bo_trial_i64@peek_is(h1, 5);
                expected: int64 <- bo_trial_i64@hash_step(bo_trial_i64@hash_step(bo_trial_i64@hash_step(bo_trial_i64@hash_step(bo_trial_i64@hash_step(0, 1), 3), 5), 5), 5);
                order: boolean <- bo_trial_i64@pop_all_hash(h5) == expected;
                count5: boolean <- bo_trial_i64@pop_all_count(h5) == 5;
                sorted: boolean <- bo_trial_i64@pops_sorted(h5, 5);
                old_intact: boolean <- bo_trial_i64@pop_all_count(h3) == 3 and bo_trial_i64@peek_is(h2, 3)
            produces
                pure pick(sizes, 1, pick(peek5, 2, pick(order, 3, pick(count5, 4, pick(sorted, 5, pick(old_intact, 6, 0))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
