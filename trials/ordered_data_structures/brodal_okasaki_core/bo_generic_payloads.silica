// Overriding genericity rule (common_contract.md §1): ItemType is whatever the programmer declares.
// String items with a table-driven comparator go through push/peek/pop/meld/validate. Tuple items
// are not exercised: the bootstrap emitter miscompiles comparators with a tuple parameter after a
// scalar one (staged repro tuple_param_after_scalar_callback.silica, see plan §15 status).

use brodal_okasaki;
use trial_support_int64;

fn rank_of(s: string) -> int64 {
    case s of {
        "alpha" -> 1;
        "bravo" -> 2;
        "charlie" -> 3;
        "delta" -> 4;
        "echo" -> 5;
        _: string -> 9
    }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case rank_of(a) < rank_of(b) of {
        true -> :less;
        false -> case rank_of(a) == rank_of(b) of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn peek_is(heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(string, string) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, expected: string) -> boolean {
    res: { status: :not_found | :found, value: string } <- brodal_okasaki@peek(heap, "");
    case res.status of {
        :found -> res.value == expected;
        :not_found -> false
    }
}

fn pop_joined(heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(string, string) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, acc: string) -> string {
    p: { heap: {
            root: ref?(L, normal, rec),
            count: int64,
            max_oriented: boolean,
            compare_item: fn(string, string) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        }, status: :not_found | :found, value: string } <- brodal_okasaki@pop(heap, "");
    case p.status of {
        :not_found -> acc;
        :found -> pop_joined(p.heap, concat(acc, p.value))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@empty({ compare_item: cmp_str }, false);
                h1: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(e, "delta");
                h2: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(h1, "alpha");
                h3: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(h2, "echo");
                h4: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(h3, "bravo");
                h5: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(h4, "charlie");
                peek_ok: boolean <- peek_is(h5, "alpha") and peek_is(h1, "delta");
                order_ok: boolean <- pop_joined(h5, "") == "alphabravocharliedeltaecho";
                v: { valid: boolean, error: atom, logical_count: int64 } <- brodal_okasaki@validate(h5);
                valid_ok: boolean <- v.valid and v.logical_count == 5;
                other: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(brodal_okasaki@push(e, "echo"), "alpha");
                m: { heap: {
                    root: ref?(L, normal, rec),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(string, string) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                }, compatible: boolean } <- brodal_okasaki@meld(h5, other);
                meld_ok: boolean <- m.compatible and brodal_okasaki@size(m.heap) == 7 and pop_joined(m.heap, "") == "alphaalphabravocharliedeltaechoecho";
                mx: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(brodal_okasaki@push(brodal_okasaki@empty({ compare_item: cmp_str }, true), "bravo"), "echo");
                max_ok: boolean <- peek_is(mx, "echo") and pop_joined(mx, "") == "echobravo"
            produces
                pure pick(peek_ok, 1, pick(order_ok, 2, pick(valid_ok, 3, pick(meld_ok, 4, pick(max_ok, 5, 0)))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
