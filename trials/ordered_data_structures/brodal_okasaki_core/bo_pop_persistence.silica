// Layer 2 §16 step 10 (design §9, §11): pop returns the minimum and a new heap; every older root
// (the base, each popped version, and pushed branches) keeps its own size, pop order, and validity.

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                base: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_lcg(bo_trial_i64@new_min(), 5, 40, 0);
                base_hash: int64 <- bo_trial_i64@pop_all_hash(base);
                p1: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                status: :not_found | :found,
                value: int64
            } <- brodal_okasaki@pop(base, 0);
                p2: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                status: :not_found | :found,
                value: int64
            } <- brodal_okasaki@pop(p1.heap, 0);
                p3: {
                heap: {
                    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    count: int64,
                    max_oriented: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                },
                status: :not_found | :found,
                value: int64
            } <- brodal_okasaki@pop(p2.heap, 0);
                popped_ok: boolean <- case p1.status of {
                    :found -> p1.value <= p2.value and p2.value <= p3.value;
                    :not_found -> false
                };
                sizes_ok: boolean <- brodal_okasaki@size(p1.heap) == 39 and brodal_okasaki@size(p2.heap) == 38 and brodal_okasaki@size(p3.heap) == 37;
                valid_ok: boolean <- bo_trial_i64@valid_with_count(p1.heap, 39) and bo_trial_i64@valid_with_count(p3.heap, 37);
                base_intact: boolean <- brodal_okasaki@size(base) == 40 and bo_trial_i64@pop_all_hash(base) == base_hash and bo_trial_i64@valid_with_count(base, 40);
                p1_hash: int64 <- bo_trial_i64@pop_all_hash(p1.heap);
                branch: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@push(p1.heap, -5);
                branch_ok: boolean <- bo_trial_i64@peek_is(branch, -5) and brodal_okasaki@size(branch) == 40 and bo_trial_i64@pops_sorted(branch, 40);
                p1_after_branch: boolean <- bo_trial_i64@pop_all_hash(p1.heap) == p1_hash and bo_trial_i64@pops_sorted(p1.heap, 39);
                sorted_rest: boolean <- bo_trial_i64@pops_sorted(p3.heap, 37)
            produces
                pure pick(popped_ok, 1, pick(sizes_ok, 2, pick(valid_ok, 3, pick(base_intact, 4, pick(branch_ok, 5, pick(p1_after_branch, 6, pick(sorted_rest, 7, 0)))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
