// Layer 2 §16 (design §9, §10): pop order equals a sorted oracle for ascending, descending,
// duplicate-heavy, and pseudo-random streams; every intermediate heap validates.

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                asc: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 0, 40, 1);
                asc_ok: boolean <- bo_trial_i64@pop_all_hash(asc) == bo_trial_i64@sorted_hash_seq(0, 40, 1) and bo_trial_i64@pops_sorted(asc, 40);
                desc: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 40, 0, -1);
                desc_ok: boolean <- bo_trial_i64@pop_all_hash(desc) == bo_trial_i64@sorted_hash_seq(40, 0, -1) and bo_trial_i64@pops_sorted(desc, 40);
                dup: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_mod(bo_trial_i64@new_min(), 50, 7, 0);
                dup_ok: boolean <- bo_trial_i64@pop_all_hash(dup) == bo_trial_i64@sorted_hash_mod(50, 7, 0) and bo_trial_i64@pops_sorted(dup, 50);
                rnd: {
                root: ref?(L, normal, rec),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_lcg(bo_trial_i64@new_min(), 17, 64, 0);
                rnd_ok: boolean <- bo_trial_i64@pop_all_hash(rnd) == bo_trial_i64@sorted_hash_lcg(17, 64, false) and bo_trial_i64@pops_sorted(rnd, 64);
                sizes: boolean <- brodal_okasaki@size(asc) == 40 and brodal_okasaki@size(dup) == 50 and brodal_okasaki@size(rnd) == 64
            produces
                pure pick(asc_ok, 1, pick(desc_ok, 2, pick(dup_ok, 3, pick(rnd_ok, 4, pick(sizes, 5, 0)))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
