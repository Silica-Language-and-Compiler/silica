// Layer 2 §16 steps 4 and 9 (§7.2 acceptance): meld rejects a different comparator function value,
// a different orientation, or a different arena before allocating — the left input comes back
// unchanged with compatible = false — on both the bootstrapped path (brodal_okasaki@meld) and the
// primitive path (brodal_okasaki_forest@merge_checked). Compatible pairs still meld.

use brodal_okasaki;
use brodal_okasaki_node;
use brodal_okasaki_forest;
use bo_trial_i64;
use trial_support_int64;

fn cmp_i64_b(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn unchanged(before: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, after: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, n: int64) -> boolean {
    brodal_okasaki@size(after) == n and bo_trial_i64@pop_all_hash(after) == bo_trial_i64@pop_all_hash(before)
        and bo_trial_i64@valid_with_count(after, n)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                a: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 0, 9, 1);
                e_other_fn: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- brodal_okasaki@empty({ compare_item: cmp_i64_b }, false);
                b_other_fn: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(e_other_fn, 20, 25, 1);
                b_max: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_max(), 20, 25, 1);
                b_same: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 20, 25, 1);
                m_fn: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki@meld(a, b_other_fn);
                m_fn_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m_fn of {
                    :unchanged -> a;
                    :incompatible -> a;
                    (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
                };
                m_fn_compatible: boolean <- case m_fn of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                fn_rejected: boolean <- case m_fn_compatible of {
                    true -> false;
                    false -> unchanged(a, m_fn_heap, 9)
                };
                m_max: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki@meld(a, b_max);
                m_max_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m_max of {
                    :unchanged -> a;
                    :incompatible -> a;
                    (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
                };
                m_max_compatible: boolean <- case m_max of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                max_rejected: boolean <- case m_max_compatible of {
                    true -> false;
                    false -> unchanged(a, m_max_heap, 9)
                };
                m_ok: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki@meld(a, b_same);
                m_ok_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m_ok of {
                    :unchanged -> a;
                    :incompatible -> a;
                    (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
                };
                m_ok_compatible: boolean <- case m_ok of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                same_accepted: boolean <- m_ok_compatible and brodal_okasaki@size(m_ok_heap) == 14 and bo_trial_i64@pops_sorted(m_ok_heap, 14);
                pa: { present: boolean, item: int64, child_count: int64, kids: List[ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_node(a, a.root, 0);
                pb: { present: boolean, item: int64, child_count: int64, kids: List[ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_node(b_other_fn, b_other_fn.root, 0);
                prim_bad: :unchanged | :incompatible | (:melded, List[ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) <- brodal_okasaki_forest@merge_checked(a, pa.kids, b_other_fn, pb.kids);
                prim_bad_compatible: boolean <- case prim_bad of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: List[ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) -> true
                };
                prim_rejected: boolean <- case prim_bad_compatible of {
                    true -> false;
                    false -> true
                };
                pc: { present: boolean, item: int64, child_count: int64, kids: List[ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_node(b_same, b_same.root, 0);
                prim_good: :unchanged | :incompatible | (:melded, List[ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) <- brodal_okasaki_forest@merge_checked(a, pa.kids, b_same, pc.kids);
                prim_good_compatible: boolean <- case prim_good of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: List[ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) -> true
                };
                prim_accepted: boolean <- prim_good_compatible;
                orient_check: boolean <- case brodal_okasaki_forest@merge_compatible(a, b_max) of {
                    true -> false;
                    false -> brodal_okasaki_forest@merge_compatible(a, b_same)
                }
            produces
                pure pick(fn_rejected, 1, pick(max_rejected, 2, pick(same_accepted, 3, pick(prim_rejected, 4, pick(prim_accepted, 5, pick(orient_check, 6, 0))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
