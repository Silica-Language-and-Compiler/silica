// Layer 2 §16 step 11 (design §2): the max orientation reverses :less and :greater without negating
// values; peek is the maximum, pops descend, duplicates survive, and a max heap validates.

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                h: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_lcg(bo_trial_i64@new_max(), 23, 48, 0);
                oriented: boolean <- brodal_okasaki@is_max_oriented(h);
                order_ok: boolean <- bo_trial_i64@pop_all_hash(h) == bo_trial_i64@sorted_hash_lcg(23, 48, true);
                sorted_ok: boolean <- bo_trial_i64@pops_sorted(h, 48) and bo_trial_i64@valid_with_count(h, 48);
                d: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_mod(bo_trial_i64@new_max(), 20, 4, 0);
                d_peek: boolean <- bo_trial_i64@peek_is(d, 3);
                d_ok: boolean <- bo_trial_i64@pops_sorted(d, 20);
                asc: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_max(), 0, 30, 1);
                asc_peek: boolean <- bo_trial_i64@peek_is(asc, 29) and bo_trial_i64@pops_sorted(asc, 30);
                cmp_natural: boolean <- case brodal_okasaki@compare_item(h, 1, 2) of {
                    :less -> true;
                    :equal -> false;
                    :greater -> false
                }
            produces
                pure pick(oriented, 1, pick(order_ok, 2, pick(sorted_ok, 3, pick(d_peek, 4, pick(d_ok, 5, pick(asc_peek, 6, pick(cmp_natural, 7, 0)))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
