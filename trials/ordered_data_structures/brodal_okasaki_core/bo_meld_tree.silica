// Layer 2 §16 step 9 (design §5, §8): meld is persistent for both operands, sizes add, the merged
// heap pops in sorted order, and repeated melds (a tree of eight heaps) validate at every level.

use brodal_okasaki;
use bo_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn meld_ok(a: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, b: {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> {
        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    sequence
        m: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki@meld(a, b);
        m_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m of {
            :unchanged -> a;
            :incompatible -> a;
            (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
        };
        m_compatible: boolean <- case m of {
            :unchanged -> true;
            :incompatible -> false;
            (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        ok: boolean <- m_compatible and brodal_okasaki@size(m_heap) == brodal_okasaki@size(a) + brodal_okasaki@size(b)
            and bo_trial_i64@valid_with_count(m_heap, brodal_okasaki@size(a) + brodal_okasaki@size(b))
            and bo_trial_i64@pops_sorted(m_heap, brodal_okasaki@size(a) + brodal_okasaki@size(b))
    produces
        pure case ok of {
            true -> m_heap;
            false -> bo_trial_i64@new_min()
        }
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                h1: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_lcg(bo_trial_i64@new_min(), 1, 5, 0);
                h2: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_lcg(bo_trial_i64@new_min(), 2, 9, 0);
                h3: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 100, 113, 1);
                h4: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@new_min();
                h5: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_mod(bo_trial_i64@new_min(), 12, 3, 0);
                h6: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_lcg(bo_trial_i64@new_min(), 6, 1, 0);
                h7: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_seq(bo_trial_i64@new_min(), 50, 30, -1);
                h8: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- bo_trial_i64@push_lcg(bo_trial_i64@new_min(), 8, 31, 0);
                h12: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- meld_ok(h1, h2);
                h34: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- meld_ok(h3, h4);
                h56: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- meld_ok(h5, h6);
                h78: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- meld_ok(h7, h8);
                h1234: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- meld_ok(h12, h34);
                h5678: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- meld_ok(h56, h78);
                all: {
                root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                count: int64,
                max_oriented: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            } <- meld_ok(h1234, h5678);
                total_ok: boolean <- brodal_okasaki@size(all) == 5 + 9 + 13 + 0 + 12 + 1 + 20 + 31;
                operands_intact: boolean <- bo_trial_i64@valid_with_count(h1, 5) and bo_trial_i64@valid_with_count(h2, 9)
                    and bo_trial_i64@valid_with_count(h12, 14) and bo_trial_i64@valid_with_count(h5678, 64)
                    and bo_trial_i64@pop_all_hash(h1) == bo_trial_i64@sorted_hash_lcg(1, 5, false)
                    and bo_trial_i64@pop_all_hash(h8) == bo_trial_i64@sorted_hash_lcg(8, 31, false);
                empty_identity: boolean <- brodal_okasaki@size(h34) == 13 and bo_trial_i64@pop_all_hash(h34) == bo_trial_i64@pop_all_hash(h3);
                self_meld: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki@meld(h12, h12);
                self_meld_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case self_meld of {
                    :unchanged -> h12;
                    :incompatible -> h12;
                    (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
                };
                self_meld_compatible: boolean <- case self_meld of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                self_ok: boolean <- self_meld_compatible and brodal_okasaki@size(self_meld_heap) == 28 and bo_trial_i64@pops_sorted(self_meld_heap, 28)
            produces
                pure pick(total_ok, 1, pick(operands_intact, 2, pick(empty_identity, 3, pick(self_ok, 4, 0))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
