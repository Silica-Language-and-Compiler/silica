// ordered_set_trait.md §10 (line 288) binds an update's result with a record annotation whose field
// is the collection's public bracket type:
//     r: { set: OrderedSet[string, mem(normal)], inserted: boolean } <- wbt_set@insert(s, "Ada");
// The bracket type is the concrete record wbt_set returns (common_contract.md §2), and it is
// recognized as that representation wherever it sits, a record field included
// (type_checker_collections@collection_aware_types_compatible).
// Expected: "Ada" is inserted into the empty set, r.inserted is true, exit 1.

use wbt_set;
use OrderedSet;
use trial_support_int64;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s: OrderedSet[string, mem(normal)] <- wbt_set@empty({ compare_item: compare_names });
                r: { set: OrderedSet[string, mem(normal)], inserted: boolean } <- wbt_set@insert(s, "Ada")
            produces
                pure case r.inserted of {
                    true -> 1;
                    false -> 0
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
