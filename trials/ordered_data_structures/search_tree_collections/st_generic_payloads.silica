// search_tree_trait.md §2 and the common contract's overriding genericity rule: ItemType is whatever
// the programmer declares. The design's own example, `index: SearchTree[string, mem(normal)] <-
// wbt_set@empty({ compare_item: compare_string })`, is searched after four name inserts (and a
// repeated one), and an int64 tree holds keys at the far ends of the int64 range. The comparator
// compare_string is this trial's own function (ordinary string order).

use wbt_set;
use SearchTree;
use st_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn show(label: string, value: int64) -> int64 {
    sequence proc[device_io]
        println(label);
        print_int64(value);
        println("")
    produces
        pure value
    end
}

fn compare_string(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn strings() -> int64 {
    sequence
        index: SearchTree[string, mem(normal)] <- wbt_set@empty({ compare_item: compare_string });
        r1: { set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(index, "Grace");
        r2: { set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(r1.set, "Ada");
        r3: { set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(r2.set, "Linus");
        r4: { set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(r3.set, "Barbara");
        r5: { set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(r4.set, "Ada");
        _: int64 <- show("string_empty_contains_ada", st_trial_i64@b2i(SearchTree@contains_key(index, "Ada")));
        _: int64 <- show("string_contains_ada", st_trial_i64@b2i(SearchTree@contains_key(r5.set, "Ada")));
        _: int64 <- show("string_contains_linus", st_trial_i64@b2i(SearchTree@contains_key(r5.set, "Linus")));
        _: int64 <- show("string_contains_bob", st_trial_i64@b2i(SearchTree@contains_key(r5.set, "Bob")));
        _: int64 <- show("string_contains_empty_string", st_trial_i64@b2i(SearchTree@contains_key(r5.set, "")));
        _: int64 <- show("string_contains_prefix", st_trial_i64@b2i(SearchTree@contains_key(r5.set, "Gra")));
        _: int64 <- show("string_repeat_inserted", st_trial_i64@b2i(r5.inserted));
        _: int64 <- show("string_compare_ada_grace", st_trial_i64@cmp_code(SearchTree@compare_item(r5.set, "Ada", "Grace")));
        _: int64 <- show("string_compare_same", st_trial_i64@cmp_code(SearchTree@compare_item(r5.set, "Linus", "Linus")));
        _: int64 <- show("string_compare_zed_ada", st_trial_i64@cmp_code(SearchTree@compare_item(r5.set, "Zed", "Ada")))
    produces
        pure 0
    end
}

fn wide_int64() -> int64 {
    sequence
        e: SearchTree[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
        r1: { set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(e, 9223372036854775807);
        r2: { set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(r1.set, -9223372036854775807);
        r3: { set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(r2.set, 0);
        _: int64 <- show("int64_contains_max", st_trial_i64@b2i(SearchTree@contains_key(r3.set, 9223372036854775807)));
        _: int64 <- show("int64_contains_min", st_trial_i64@b2i(SearchTree@contains_key(r3.set, -9223372036854775807)));
        _: int64 <- show("int64_contains_zero", st_trial_i64@b2i(SearchTree@contains_key(r3.set, 0)));
        _: int64 <- show("int64_contains_max_minus_1", st_trial_i64@b2i(SearchTree@contains_key(r3.set, 9223372036854775806)));
        _: int64 <- show("int64_compare_min_max", st_trial_i64@cmp_code(SearchTree@compare_item(r3.set, -9223372036854775807, 9223372036854775807)))
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: int64 <- strings();
                _: int64 <- wide_int64()
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
