// search_tree_trait.md §3, §5: contains_key performs direct WBT search and answers true exactly for
// the keys whose comparator class is present. The same nine keys are inserted through wbt_set in
// three orders (mixed, ascending, descending); every order answers the same membership, checked key
// by key at the boundaries and by counting the present keys of [0, 100).

use wbt_set;
use SearchTree;
use st_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn show(label: string, value: int64) -> int64 {
    sequence proc[device_io]
        println(label);
        print_int64(value);
        println("")
    produces
        pure value
    end
}

fn mixed() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [50, 30, 70, 20, 40, 60, 80, 10, 90]
    produces
        pure xs
    end
}

fn ascending() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [10, 20, 30, 40, 50, 60, 70, 80, 90]
    produces
        pure xs
    end
}

fn descending() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [90, 80, 70, 60, 50, 40, 30, 20, 10]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: SearchTree[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
                t: { root: ref?(L, normal, rec), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- st_trial_i64@insert_list(e, mixed());
                a: { root: ref?(L, normal, rec), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- st_trial_i64@insert_list(e, ascending());
                d: { root: ref?(L, normal, rec), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- st_trial_i64@insert_list(e, descending());
                _: int64 <- show("present_root", st_trial_i64@b2i(SearchTree@contains_key(t, 50)));
                _: int64 <- show("present_min", st_trial_i64@b2i(SearchTree@contains_key(t, 10)));
                _: int64 <- show("present_max", st_trial_i64@b2i(SearchTree@contains_key(t, 90)));
                _: int64 <- show("present_inner", st_trial_i64@b2i(SearchTree@contains_key(t, 40)));
                _: int64 <- show("absent_below_min", st_trial_i64@b2i(SearchTree@contains_key(t, 9)));
                _: int64 <- show("absent_above_max", st_trial_i64@b2i(SearchTree@contains_key(t, 91)));
                _: int64 <- show("absent_between", st_trial_i64@b2i(SearchTree@contains_key(t, 55)));
                _: int64 <- show("absent_negative", st_trial_i64@b2i(SearchTree@contains_key(t, -50)));
                _: int64 <- show("count_mixed_order", st_trial_i64@count_present(t, 0, 100));
                _: int64 <- show("count_ascending_order", st_trial_i64@count_present(a, 0, 100));
                _: int64 <- show("count_descending_order", st_trial_i64@count_present(d, 0, 100))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
