.bss
.balign 8
.lcomm silica_frame_depth, 8
.lcomm silica_frame_max, 8
.lcomm silica_fuel, 8
.lcomm silica_saved_pc, 8

    .intel_syntax noprefix
    .text
    // use wbt_set
.global SearchTree_contains_key
.global SearchTree_compare_item
.extern silica_rt_ffi_guarded_enter
.extern silica_rt_ffi_guarded_exit
.extern silica_rt_ffi_guarded_setjmp
.extern silica_rt_ffi_guarded_fault_finish
.extern silica_rt_ffi_arena_bump
    // export_trait SearchTree
    // required_fn compare_item tree|a|b SearchTree|ItemType|ItemType -> :less | :equal | :greater []
    // required_fn contains_key tree|key SearchTree|ItemType -> bool []

    // --- recursion phases (recursion_implementation.jsonld) ---
    // p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    // p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    // p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    // p6 trampoline fallback (optional):
    // silica_trampoline_dispatch: load target from frame / BR X8
    // never rely on unbounded native recursion for general calls



.set SVR_AREA, 16
.set SVR_X11, 8
.set SVR_X16, 16
.globl SearchTree_compare_item
SearchTree_compare_item:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA
    mov QWORD PTR [rbp - SVR_X11], rdi

    // p3 fuel: LDR X9,=silica_fuel / SUBS / B.EQ silica_yield (optional)
    mov rax, QWORD PTR [rbp - SVR_X11]
    mov QWORD PTR [rbp - SVR_X16], rax

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov QWORD PTR [rbp - SVR_X16], rsi

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov QWORD PTR [rbp - SVR_X16], rdx

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp + 32]
    mov rsi, QWORD PTR [rsp + 16]
    mov rdx, QWORD PTR [rsp]
    lea rsp, [rsp + 48]
    // effects []|sir_rec:o2572|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    mov rbx, 0
    leave
    lea r10, [rip + wbt_set_apply_compare_item]
    jmp r10



.set SVR_AREA, 16
.set SVR_X11, 8
.set SVR_X16, 16
.globl SearchTree_contains_key
SearchTree_contains_key:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA
    mov QWORD PTR [rbp - SVR_X11], rdi

    // p3 fuel: LDR X9,=silica_fuel / SUBS / B.EQ silica_yield (optional)
    mov rax, QWORD PTR [rbp - SVR_X11]
    mov QWORD PTR [rbp - SVR_X16], rax

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov QWORD PTR [rbp - SVR_X16], rsi

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp + 16]
    mov rsi, QWORD PTR [rsp]
    lea rsp, [rsp + 32]
    // effects []|sir_rec:o2917|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    mov rbx, 0
    leave
    lea r10, [rip + wbt_set_contains]
    jmp r10


L_pa_helper:
    test rdi, rdi
    js L_pa_oob
    cmp rdi, 54
    jge L_pa_oob
    lea r9, [rip + L_pa_table]
    mov r10, rdi
    shl r10, 4
    add r9, r10
    mov rsi, QWORD PTR [r9]
    mov rdx, QWORD PTR [r9 + 8]
    mov edi, 1
    mov eax, 1
    syscall
    xor edi, edi
    ret
L_pa_oob:
    xor edi, edi
    ret

