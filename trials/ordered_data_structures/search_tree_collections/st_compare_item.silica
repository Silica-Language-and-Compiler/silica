// search_tree_trait.md §3, §5 and common_contract.md §4: compare_item answers with the comparator the
// tree captured, not with a built-in order. A natural tree, a descending tree (cmp_i64_desc) and a
// modulo-10 tree (cmp_mod10: keys congruent modulo 10 are one comparator class) are each asked the
// same questions; each tree's contains_key follows its own comparator. Codes: 1 :less, 2 :equal,
// 3 :greater.

use wbt_set;
use SearchTree;
use st_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn show(label: string, value: int64) -> int64 {
    sequence proc[device_io]
        println(label);
        print_int64(value);
        println("")
    produces
        pure value
    end
}

fn keys() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: SearchTree[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
                n: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- st_trial_i64@insert_list(e, keys());
                d0: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- st_trial_i64@new_desc();
                d: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- st_trial_i64@insert_list(d0, keys());
                m0: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- st_trial_i64@new_mod10();
                m: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- st_trial_i64@insert_list(m0, keys());
                _: int64 <- show("natural_1_2", st_trial_i64@cmp_code(SearchTree@compare_item(n, 1, 2)));
                _: int64 <- show("natural_2_2", st_trial_i64@cmp_code(SearchTree@compare_item(n, 2, 2)));
                _: int64 <- show("natural_3_2", st_trial_i64@cmp_code(SearchTree@compare_item(n, 3, 2)));
                _: int64 <- show("descending_1_2", st_trial_i64@cmp_code(SearchTree@compare_item(d, 1, 2)));
                _: int64 <- show("descending_2_2", st_trial_i64@cmp_code(SearchTree@compare_item(d, 2, 2)));
                _: int64 <- show("descending_3_2", st_trial_i64@cmp_code(SearchTree@compare_item(d, 3, 2)));
                _: int64 <- show("descending_contains_2", st_trial_i64@b2i(SearchTree@contains_key(d, 2)));
                _: int64 <- show("descending_contains_4", st_trial_i64@b2i(SearchTree@contains_key(d, 4)));
                _: int64 <- show("descending_count", st_trial_i64@count_present(d, 0, 10));
                _: int64 <- show("mod10_3_13", st_trial_i64@cmp_code(SearchTree@compare_item(m, 3, 13)));
                _: int64 <- show("mod10_13_4", st_trial_i64@cmp_code(SearchTree@compare_item(m, 13, 4)));
                _: int64 <- show("mod10_19_21", st_trial_i64@cmp_code(SearchTree@compare_item(m, 19, 21)));
                _: int64 <- show("mod10_contains_22", st_trial_i64@b2i(SearchTree@contains_key(m, 22)));
                _: int64 <- show("mod10_count", st_trial_i64@count_present(m, 0, 100))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
