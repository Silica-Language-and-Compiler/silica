// The same record-field bracket type as ordered_set_field_annotation, read back through a `.field`
// projection whose binding is the bracket type itself:
//     r: OrderedSet[string, mem(normal)] <- wbt_set@insert(s, "Ada").set;
// The call's result type still names the module's ItemType placeholder, which the expected record
// instantiates (ordered_set_trait.md §10, common_contract.md §1).
// Expected: "Ada" inserts into the empty set; this program discards `inserted`, exit 0.

use wbt_set;
use OrderedSet;
use trial_support_int64;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s: OrderedSet[string, mem(normal)] <- wbt_set@empty({ compare_item: compare_names });
                r: OrderedSet[string, mem(normal)] <- wbt_set@insert(s, "Ada").set
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
