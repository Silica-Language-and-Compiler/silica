// search_tree_trait.md §2, §4, §6: a parameter declared with the public bracket type
// SearchTree[ItemType, mem(SpaceType)] accepts the tree returned by a persistent update (the `set`
// field of insert's result, typed with the generated inline record), and a
// `t1: SearchTree[int64, mem(normal)] <- r.set` binding accepts it too; the record is the bracket
// type's concrete representation. Formerly the open defect compile_defects_search_tree_parameter_addition
// (E2003 "field has type {compare_item:...,count:int64}, expected SearchTree[int64, normal]": a field
// access never compared a concrete record with a collection bracket type, and a bracket-typed let
// demanded a module@empty constructor call on its right-hand side).
// StubWbtSet (beside this file) is a minimal construction module under a name the checker registers
// for the wbt_set representation. Expected: 0, 1, 1, exit 0.

use StubWbtSet;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn tree_count(tree: SearchTree[int64, mem(normal)]) -> int64 {
    StubWbtSet@count(tree)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t0: SearchTree[int64, mem(normal)] <- StubWbtSet@empty({ compare_item: cmp_i64 });
                r: { set: { compare_item: fn(int64, int64) -> :less | :equal | :greater, count: int64 }, inserted: boolean } <- StubWbtSet@insert(t0, 5);
                n0: int64 <- tree_count(t0);
                n1: int64 <- tree_count(r.set);
                t1: SearchTree[int64, mem(normal)] <- r.set;
                n2: int64 <- tree_count(t1);
                print_int64(n0);
                println("");
                print_int64(n1);
                println("");
                print_int64(n2);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
