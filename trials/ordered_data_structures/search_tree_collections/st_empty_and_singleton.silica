// search_tree_trait.md §5: search on an empty tree or for an absent key is false, for a present key
// true; §3: compare_item answers from the comparator the tree captured, whatever the tree holds.
// The empty receiver is a bracket-typed SearchTree[int64, mem(normal)] constructor binding; the
// singleton comes from wbt_set@singleton/2 (the standard construction surface, design §4) and is
// bound with the generated inline record.

use wbt_set;
use SearchTree;
use st_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn show(label: string, value: int64) -> int64 {
    sequence proc[device_io]
        println(label);
        print_int64(value);
        println("")
    produces
        pure value
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: SearchTree[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
                e_zero: int64 <- st_trial_i64@b2i(SearchTree@contains_key(e, 0));
                e_negative: int64 <- st_trial_i64@b2i(SearchTree@contains_key(e, -7));
                e_large: int64 <- st_trial_i64@b2i(SearchTree@contains_key(e, 1000000));
                e_less: int64 <- st_trial_i64@cmp_code(SearchTree@compare_item(e, 1, 2));
                e_equal: int64 <- st_trial_i64@cmp_code(SearchTree@compare_item(e, 5, 5));
                e_greater: int64 <- st_trial_i64@cmp_code(SearchTree@compare_item(e, 9, -9));
                s: { root: ref?(L, normal, rec), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- wbt_set@singleton({ compare_item: cmp_i64 }, 42);
                s_item: int64 <- st_trial_i64@b2i(SearchTree@contains_key(s, 42));
                s_below: int64 <- st_trial_i64@b2i(SearchTree@contains_key(s, 41));
                s_above: int64 <- st_trial_i64@b2i(SearchTree@contains_key(s, 43));
                s_compare: int64 <- st_trial_i64@cmp_code(SearchTree@compare_item(s, 42, 41));
                _: int64 <- show("empty_contains_zero", e_zero);
                _: int64 <- show("empty_contains_negative", e_negative);
                _: int64 <- show("empty_contains_large", e_large);
                _: int64 <- show("empty_compare_less", e_less);
                _: int64 <- show("empty_compare_equal", e_equal);
                _: int64 <- show("empty_compare_greater", e_greater);
                _: int64 <- show("singleton_contains_item", s_item);
                _: int64 <- show("singleton_contains_below", s_below);
                _: int64 <- show("singleton_contains_above", s_above);
                _: int64 <- show("singleton_compare_item", s_compare)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
