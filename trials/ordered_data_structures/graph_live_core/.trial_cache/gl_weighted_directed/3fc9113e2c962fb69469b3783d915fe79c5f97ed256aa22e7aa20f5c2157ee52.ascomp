    MOV X9, X19
    MOV X10, #1000


    MUL X9, X9, X10
    STR X9, [SP, #-16]!
    MOV X9, X20
    MOV X10, #100


    MUL X10, X9, X10
    LDR X9, [SP], #16
    ADD X9, X9, X10
    STR X9, [SP, #-16]!
    MOV X10, #10
    STR X10, [SP, #-16]!
    LDR X9, [X2, #8]
    LDR X10, [SP], #16


    MUL X10, X9, X10
    LDR X9, [SP], #16
    ADD X9, X9, X10
    STR X9, [SP, #-16]!
    LDR X10, [X2, #16]
    LDR X9, [SP], #16
    ADD X0, X9, X10
    LDP X25, X26, [X29, #-64]
    LDP X23, X24, [X29, #-48]
    LDP X21, X22, [X29, #-32]
    LDP X19, X20, [X29, #-16]
    LDP X29, X30, [X29]
    RET

