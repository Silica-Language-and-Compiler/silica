gl_weighted_directed_data_step:     STP X29, X30, [SP, #-32]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    MOV X16, SP
    STR X16, [X29, #16]

    MOV X9, X19
    STR X9, [SP, #-16]!
    LDR X10, [X20, #16]
    LDR X9, [SP], #16


    ADD X0, X9, X10
    LDP X25, X26, [X29, #-64]
    LDP X23, X24, [X29, #-48]
    LDP X21, X22, [X29, #-32]
    LDP X19, X20, [X29, #-16]
    LDP X29, X30, [X29]
    RET

