L_case_o1050_br_0:
    MOV X4, #18
    CMP X3, X4
    B.NE L_case_o1050_br_1
    MOV X0, #1
    B L_case_o1050_done
L_case_o1050_br_1:
    MOV X4, #19
    CMP X3, X4
    B.NE L_case_o1050_fb
    MOV X0, #0
    B L_case_o1050_done
L_case_o1050_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o1050_done
L_case_o1050_done:

    LDP X19, X20, [X29, #-16]
    LDP X29, X30, [X29]
    RET

main:     STP X29, X30, [SP, #-32]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    MOV X16, SP
    STR X16, [X29, #16]

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
