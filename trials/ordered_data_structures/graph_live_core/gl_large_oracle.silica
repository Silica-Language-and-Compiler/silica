// live_wbt_graph.md §4–§9, §12 at scale. Directed ring + chords on 200 vertices (i -> i+1 and
// i -> 3i mod 200: 400 distinct pairs, loops at 0 and 100), then the even ring edges removed.
// Undirected ring on 150 vertices with 15 self-loops, then every third ring edge removed. Then 300
// pseudo-random directed pairs and 300 undirected pairs over 25 vertices checked against a list
// oracle: edge count, has_edge for all 625 ordered pairs, out-degree / degree per vertex, validation.

use graph_wbt_directed;
use graph_wbt_undirected;
use live_trial_i64;
use trial_support_int64;

fn ring_chords(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, i: int64) -> { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    case i >= 200 of {
        true -> g;
        false -> {
            g1: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(g, i, (i + 1) % 200);
            g2: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(g1, i, (3 * i) % 200);
            ring_chords(g2, i + 1)
        }
    }
}

fn drop_even_ring(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, i: int64) -> { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    case i >= 200 of {
        true -> g;
        false -> {
            r: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(g, i, i + 1);
            drop_even_ring(r.graph, i + 2)
        }
    }
}

fn count_degree_two(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, i: int64, acc: int64) -> int64 {
    case i >= 200 of {
        true -> acc;
        false -> case graph_wbt_directed@out_degree(g, i) == 2 of {
            true -> count_degree_two(g, i + 1, acc + 1);
            false -> count_degree_two(g, i + 1, acc)
        }
    }
}

fn ring_loops(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, i: int64) -> { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    case i >= 150 of {
        true -> g;
        false -> {
            g1: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u(g, i, (i + 1) % 150, i % 10);
            g2: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- case i % 10 == 0 of {
                true -> live_trial_i64@add_u(g1, i, i, 0);
                false -> g1
            };
            ring_loops(g2, i + 1)
        }
    }
}

fn drop_third_ring(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, i: int64) -> { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    case i >= 150 of {
        true -> g;
        false -> {
            r: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_undirected@remove_edge(g, i, i + 1);
            drop_third_ring(r.graph, i + 3)
        }
    }
}

fn degree_sum(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, i: int64, acc: int64) -> int64 {
    case i >= 150 of {
        true -> acc;
        false -> degree_sum(g, i + 1, acc + graph_wbt_undirected@degree(g, i))
    }
}

// ---- pseudo-random runs against a list oracle of codes a*100+b ----

fn member(xs: List[int64, mem(normal)], x: int64) -> boolean {
    case xs.is_nil of {
        true -> false;
        false -> case xs.head == x of {
            true -> true;
            false -> member(xs.tail, x)
        }
    }
}

fn cons(x: int64, xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
    produces
        pure out
    end
}

fn nil() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure out
    end
}

fn count_list(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> count_list(xs.tail, acc + 1)
    }
}

fn count_from(xs: List[int64, mem(normal)], a: int64, acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> case xs.head / 100 == a of {
            true -> count_from(xs.tail, a, acc + 1);
            false -> count_from(xs.tail, a, acc)
        }
    }
}

fn pick(x: int64) -> int64 {
    (x / 65536) % 25
}

fn random_directed(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, oracle: List[int64, mem(normal)], x: int64, k: int64) -> { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, oracle: List[int64, mem(normal)] } {
    case k <= 0 of {
        true -> { graph: g, oracle: oracle };
        false -> {
            x1: int64 <- live_trial_i64@lcg(x);
            x2: int64 <- live_trial_i64@lcg(x1);
            a: int64 <- pick(x1);
            b: int64 <- pick(x2);
            g1: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(g, a, b);
            o1: List[int64, mem(normal)] <- case member(oracle, a * 100 + b) of {
                true -> oracle;
                false -> cons(a * 100 + b, oracle)
            };
            random_directed(g1, o1, x2, k - 1)
        }
    }
}

fn has_mismatches(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, oracle: List[int64, mem(normal)], p: int64, acc: int64) -> int64 {
    case p >= 625 of {
        true -> acc;
        false -> {
            a: int64 <- p / 25;
            b: int64 <- p % 25;
            same: boolean <- graph_wbt_directed@has_edge(g, a, b) == member(oracle, a * 100 + b);
            has_mismatches(g, oracle, p + 1, acc + 1 - live_trial_i64@b2i(same))
        }
    }
}

fn degree_mismatches(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, oracle: List[int64, mem(normal)], a: int64, acc: int64) -> int64 {
    case a >= 25 of {
        true -> acc;
        false -> {
            same: boolean <- graph_wbt_directed@out_degree(g, a) == count_from(oracle, a, 0);
            degree_mismatches(g, oracle, a + 1, acc + 1 - live_trial_i64@b2i(same))
        }
    }
}

fn min2(a: int64, b: int64) -> int64 {
    case a < b of {
        true -> a;
        false -> b
    }
}

fn max2(a: int64, b: int64) -> int64 {
    case a < b of {
        true -> b;
        false -> a
    }
}

fn random_undirected(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, oracle: List[int64, mem(normal)], x: int64, k: int64) -> { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, oracle: List[int64, mem(normal)] } {
    case k <= 0 of {
        true -> { graph: g, oracle: oracle };
        false -> {
            x1: int64 <- live_trial_i64@lcg(x);
            x2: int64 <- live_trial_i64@lcg(x1);
            a: int64 <- pick(x1);
            b: int64 <- pick(x2);
            g1: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u(g, a, b, (a + b) % 10);
            code: int64 <- min2(a, b) * 100 + max2(a, b);
            o1: List[int64, mem(normal)] <- case member(oracle, code) of {
                true -> oracle;
                false -> cons(code, oracle)
            };
            random_undirected(g1, o1, x2, k - 1)
        }
    }
}

fn uhas_mismatches(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, oracle: List[int64, mem(normal)], p: int64, acc: int64) -> int64 {
    case p >= 625 of {
        true -> acc;
        false -> {
            a: int64 <- p / 25;
            b: int64 <- p % 25;
            same: boolean <- graph_wbt_undirected@has_edge(g, a, b) == member(oracle, min2(a, b) * 100 + max2(a, b));
            uhas_mismatches(g, oracle, p + 1, acc + 1 - live_trial_i64@b2i(same))
        }
    }
}

fn loops_in(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> case xs.head / 100 == xs.head % 100 of {
            true -> loops_in(xs.tail, acc + 1);
            false -> loops_in(xs.tail, acc)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                d: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- ring_chords(e, 0);
                _: int64 <- live_trial_i64@put("ring_nodes", graph_wbt_directed@node_count(d));
                _: int64 <- live_trial_i64@put("ring_edges", graph_wbt_directed@edge_count(d));
                _: int64 <- live_trial_i64@put("ring_out_degree_two", count_degree_two(d, 0, 0));
                _: int64 <- live_trial_i64@put("ring_loop_0", live_trial_i64@b2i(graph_wbt_directed@has_edge(d, 0, 0)));
                _: int64 <- live_trial_i64@put("ring_loop_100", live_trial_i64@b2i(graph_wbt_directed@has_edge(d, 100, 100)));
                _: int64 <- live_trial_i64@put("ring_reachable_5_4", live_trial_i64@b2i(graph_wbt_directed@reachable(d, 5, 4)));
                _: int64 <- live_trial_i64@put("ring_valid", live_trial_i64@d_valid(d));
                h: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- drop_even_ring(d, 0);
                _: int64 <- live_trial_i64@put("dropped_edges", graph_wbt_directed@edge_count(h));
                _: int64 <- live_trial_i64@put("dropped_reachable_0_1", live_trial_i64@b2i(graph_wbt_directed@reachable(h, 0, 1)));
                _: int64 <- live_trial_i64@put("dropped_reachable_1_2", live_trial_i64@b2i(graph_wbt_directed@reachable(h, 1, 2)));
                _: int64 <- live_trial_i64@put("dropped_reachable_2_3", live_trial_i64@b2i(graph_wbt_directed@reachable(h, 2, 3)));
                _: int64 <- live_trial_i64@put("dropped_reachable_2_6", live_trial_i64@b2i(graph_wbt_directed@reachable(h, 2, 6)));
                _: int64 <- live_trial_i64@put("dropped_valid", live_trial_i64@d_valid(h));
                _: int64 <- live_trial_i64@put("old_ring_edges", graph_wbt_directed@edge_count(d));
                ue: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@new_u();
                u: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- ring_loops(ue, 0);
                _: int64 <- live_trial_i64@put("uring_edges", graph_wbt_undirected@edge_count(u));
                _: int64 <- live_trial_i64@put("uring_entries", graph_wbt_undirected@adjacency_entry_count(u));
                _: int64 <- live_trial_i64@put("uring_degree_0", graph_wbt_undirected@degree(u, 0));
                _: int64 <- live_trial_i64@put("uring_degree_1", graph_wbt_undirected@degree(u, 1));
                _: int64 <- live_trial_i64@put("uring_degree_sum", degree_sum(u, 0, 0));
                n5: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(u, 5);
                _: int64 <- live_trial_i64@put("uring_neighbors_5", live_trial_i64@view_code(n5));
                _: int64 <- live_trial_i64@put("uring_connected_0_75", live_trial_i64@b2i(graph_wbt_undirected@connected(u, 0, 75)));
                _: int64 <- live_trial_i64@put("uring_valid", live_trial_i64@u_valid(u));
                v: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- drop_third_ring(u, 0);
                _: int64 <- live_trial_i64@put("udropped_edges", graph_wbt_undirected@edge_count(v));
                _: int64 <- live_trial_i64@put("udropped_entries", graph_wbt_undirected@adjacency_entry_count(v));
                _: int64 <- live_trial_i64@put("udropped_connected_0_149", live_trial_i64@b2i(graph_wbt_undirected@connected(v, 0, 149)));
                _: int64 <- live_trial_i64@put("udropped_connected_0_1", live_trial_i64@b2i(graph_wbt_undirected@connected(v, 0, 1)));
                _: int64 <- live_trial_i64@put("udropped_connected_1_3", live_trial_i64@b2i(graph_wbt_undirected@connected(v, 1, 3)));
                _: int64 <- live_trial_i64@put("udropped_connected_3_4", live_trial_i64@b2i(graph_wbt_undirected@connected(v, 3, 4)));
                _: int64 <- live_trial_i64@put("udropped_valid", live_trial_i64@u_valid(v));
                rd: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, oracle: List[int64, mem(normal)] } <- random_directed(e, nil(), 12345, 300);
                rd_edges: int64 <- graph_wbt_directed@edge_count(rd.graph);
                rd_oracle: int64 <- count_list(rd.oracle, 0);
                _: int64 <- live_trial_i64@put("random_edge_count_agrees", live_trial_i64@b2i(rd_edges == rd_oracle));
                _: int64 <- live_trial_i64@put("random_has_edge_mismatches", has_mismatches(rd.graph, rd.oracle, 0, 0));
                _: int64 <- live_trial_i64@put("random_out_degree_mismatches", degree_mismatches(rd.graph, rd.oracle, 0, 0));
                rv: { valid: boolean, error: atom, logical_count: int64 } <- graph_wbt_directed@validate(rd.graph);
                _: int64 <- live_trial_i64@put("random_valid_code", graph_wbt_directed@validate_error_code(rv.error));
                ru: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, oracle: List[int64, mem(normal)] } <- random_undirected(ue, nil(), 777, 300);
                uo: List[int64, mem(normal)] <- ru.oracle;
                ru_edges: int64 <- graph_wbt_undirected@edge_count(ru.graph);
                ru_entries: int64 <- graph_wbt_undirected@adjacency_entry_count(ru.graph);
                uo_len: int64 <- count_list(uo, 0);
                uo_loops: int64 <- loops_in(uo, 0);
                _: int64 <- live_trial_i64@put("urandom_edge_count_agrees", live_trial_i64@b2i(ru_edges == uo_len));
                _: int64 <- live_trial_i64@put("urandom_entries_agree", live_trial_i64@b2i(ru_entries == 2 * uo_len - uo_loops));
                _: int64 <- live_trial_i64@put("urandom_has_edge_mismatches", uhas_mismatches(ru.graph, uo, 0, 0));
                uv: { valid: boolean, error: atom, logical_count: int64 } <- graph_wbt_undirected@validate(ru.graph);
                _: int64 <- live_trial_i64@put("urandom_valid_code", graph_wbt_undirected@validate_error_code(uv.error))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
