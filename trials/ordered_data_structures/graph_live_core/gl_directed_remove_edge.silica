// directed_graph_trait.md §5 and live_wbt_graph.md §6 on graph_wbt_directed: remove_edge deletes one
// directed pair only; a missing pair or missing source is a no-op; endpoints stay (an emptied
// adjacency stays attached to its vertex); the old graph is unchanged; re-adding restores the pair.

use graph_wbt_directed;
use live_trial_i64;
use trial_support_int64;

fn pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 1, 3, 2, 3, 3, 1, 3, 3]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(g0, pairs());
                _: int64 <- live_trial_i64@put("start_edges", graph_wbt_directed@edge_count(g));
                rm1: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(g, 1, 2);
                _: int64 <- live_trial_i64@put("remove_1_2", live_trial_i64@b2i(rm1.removed));
                _: int64 <- live_trial_i64@put("remove_1_2_edges", graph_wbt_directed@edge_count(rm1.graph));
                _: int64 <- live_trial_i64@put("remove_1_2_nodes", graph_wbt_directed@node_count(rm1.graph));
                _: int64 <- live_trial_i64@put("remove_1_2_has_1_2", live_trial_i64@b2i(graph_wbt_directed@has_edge(rm1.graph, 1, 2)));
                _: int64 <- live_trial_i64@put("remove_1_2_has_vertex_2", live_trial_i64@b2i(graph_wbt_directed@has_vertex(rm1.graph, 2)));
                n1: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(rm1.graph, 1);
                _: int64 <- live_trial_i64@put("remove_1_2_neighbors_1", live_trial_i64@list_code(n1));
                rm2: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(rm1.graph, 1, 2);
                _: int64 <- live_trial_i64@put("remove_missing_pair", live_trial_i64@b2i(rm2.removed));
                _: int64 <- live_trial_i64@put("remove_missing_pair_edges", graph_wbt_directed@edge_count(rm2.graph));
                rm3: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(rm2.graph, 7, 1);
                _: int64 <- live_trial_i64@put("remove_missing_source", live_trial_i64@b2i(rm3.removed));
                _: int64 <- live_trial_i64@put("remove_missing_source_nodes", graph_wbt_directed@node_count(rm3.graph));
                rm4: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(rm3.graph, 3, 3);
                _: int64 <- live_trial_i64@put("remove_loop_3", live_trial_i64@b2i(rm4.removed));
                _: int64 <- live_trial_i64@put("remove_loop_3_edges", graph_wbt_directed@edge_count(rm4.graph));
                n3: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(rm4.graph, 3);
                _: int64 <- live_trial_i64@put("remove_loop_3_neighbors_3", live_trial_i64@list_code(n3));
                rm5: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(rm4.graph, 2, 3);
                _: int64 <- live_trial_i64@put("remove_2_3_edges", graph_wbt_directed@edge_count(rm5.graph));
                n2: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(rm5.graph, 2);
                _: int64 <- live_trial_i64@put("emptied_neighbors_2", live_trial_i64@list_code(n2));
                _: int64 <- live_trial_i64@put("emptied_has_vertex_2", live_trial_i64@b2i(graph_wbt_directed@has_vertex(rm5.graph, 2)));
                _: int64 <- live_trial_i64@put("emptied_out_degree_2", graph_wbt_directed@out_degree(rm5.graph, 2));
                _: int64 <- live_trial_i64@put("final_nodes", graph_wbt_directed@node_count(rm5.graph));
                _: int64 <- live_trial_i64@put("final_valid", live_trial_i64@d_valid(rm5.graph));
                _: int64 <- live_trial_i64@put("old_edges", graph_wbt_directed@edge_count(g));
                _: int64 <- live_trial_i64@put("old_has_1_2", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 1, 2)));
                o1: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, 1);
                _: int64 <- live_trial_i64@put("old_neighbors_1", live_trial_i64@list_code(o1));
                re: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(rm5.graph, 1, 2);
                _: int64 <- live_trial_i64@put("readd_flags", live_trial_i64@flags(re.inserted, re.replaced));
                _: int64 <- live_trial_i64@put("readd_edges", graph_wbt_directed@edge_count(re.graph));
                r1: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(re.graph, 1);
                _: int64 <- live_trial_i64@put("readd_neighbors_1", live_trial_i64@list_code(r1));
                _: int64 <- live_trial_i64@put("readd_valid", live_trial_i64@d_valid(re.graph))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
