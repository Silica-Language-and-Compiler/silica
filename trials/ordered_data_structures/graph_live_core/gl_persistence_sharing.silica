// common_contract.md §7 and live_wbt_graph.md §10: every update path-copies and publishes a new root;
// the old graph and every branch taken from it stay valid and unchanged. Directed: from b (1->2,
// 2->3) branch x (+1->3), y (+3->1) and z (x - 1->2). Undirected: from ub ({1,2}:5, {2,3}:6) branch
// ux (+{1,3}:7) and uy (replace {1,2} with 9). A 60-edge chain keeps its first version intact.

use graph_wbt_directed;
use graph_wbt_undirected;
use live_trial_i64;
use trial_support_int64;

fn base_pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 2, 3]
    produces
        pure xs
    end
}

fn base_triples() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 5, 2, 3, 6]
    produces
        pure xs
    end
}

// Adds i -> i + 1 for i in [i, n).
fn chain(g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, i: int64, n: int64) -> { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    case i >= n of {
        true -> g;
        false -> chain(live_trial_i64@add_d(g, i, i + 1), i + 1, n)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                b: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(e, base_pairs());
                x: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(b, 1, 3);
                y: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(b, 3, 1);
                zr: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(x, 1, 2);
                z: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- zr.graph;
                b1: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(b, 1);
                _: int64 <- live_trial_i64@put("b_neighbors_1", live_trial_i64@list_code(b1));
                _: int64 <- live_trial_i64@put("b_valid", live_trial_i64@d_valid(b));
                x1: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(x, 1);
                _: int64 <- live_trial_i64@put("x_neighbors_1", live_trial_i64@list_code(x1));
                _: int64 <- live_trial_i64@put("x_has_3_1", live_trial_i64@b2i(graph_wbt_directed@has_edge(x, 3, 1)));
                _: int64 <- live_trial_i64@put("x_valid", live_trial_i64@d_valid(x));
                y1: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(y, 1);
                _: int64 <- live_trial_i64@put("y_neighbors_1", live_trial_i64@list_code(y1));
                y3: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(y, 3);
                _: int64 <- live_trial_i64@put("y_neighbors_3", live_trial_i64@list_code(y3));
                _: int64 <- live_trial_i64@put("y_has_1_3", live_trial_i64@b2i(graph_wbt_directed@has_edge(y, 1, 3)));
                _: int64 <- live_trial_i64@put("y_valid", live_trial_i64@d_valid(y));
                z1: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(z, 1);
                _: int64 <- live_trial_i64@put("z_neighbors_1", live_trial_i64@list_code(z1));
                _: int64 <- live_trial_i64@put("z_valid", live_trial_i64@d_valid(z));
                _: int64 <- live_trial_i64@put("x_after_z_has_1_2", live_trial_i64@b2i(graph_wbt_directed@has_edge(x, 1, 2)));
                ue: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@new_u();
                ub: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u_triples(ue, base_triples());
                ux: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u(ub, 1, 3, 7);
                uy: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u(ub, 1, 2, 9);
                ub1: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(ub, 1);
                _: int64 <- live_trial_i64@put("ub_neighbors_1", live_trial_i64@view_code(ub1));
                ux1: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(ux, 1);
                _: int64 <- live_trial_i64@put("ux_neighbors_1", live_trial_i64@view_code(ux1));
                ux3: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(ux, 3);
                _: int64 <- live_trial_i64@put("ux_neighbors_3", live_trial_i64@view_code(ux3));
                uy2: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(uy, 2);
                _: int64 <- live_trial_i64@put("uy_neighbors_2", live_trial_i64@view_code(uy2));
                ub2: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(ub, 2);
                _: int64 <- live_trial_i64@put("ub_neighbors_2", live_trial_i64@view_code(ub2));
                _: int64 <- live_trial_i64@put("ub_valid", live_trial_i64@u_valid(ub));
                _: int64 <- live_trial_i64@put("ux_valid", live_trial_i64@u_valid(ux));
                _: int64 <- live_trial_i64@put("uy_valid", live_trial_i64@u_valid(uy));
                c1: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- chain(e, 0, 30);
                c2: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- chain(c1, 30, 60);
                _: int64 <- live_trial_i64@put("chain_first_edges", graph_wbt_directed@edge_count(c1));
                _: int64 <- live_trial_i64@put("chain_first_has_40_41", live_trial_i64@b2i(graph_wbt_directed@has_edge(c1, 40, 41)));
                _: int64 <- live_trial_i64@put("chain_first_valid", live_trial_i64@d_valid(c1));
                _: int64 <- live_trial_i64@put("chain_second_edges", graph_wbt_directed@edge_count(c2));
                _: int64 <- live_trial_i64@put("chain_second_nodes", graph_wbt_directed@node_count(c2));
                _: int64 <- live_trial_i64@put("chain_second_reachable_0_60", live_trial_i64@b2i(graph_wbt_directed@reachable(c2, 0, 60)));
                _: int64 <- live_trial_i64@put("chain_first_reachable_0_60", live_trial_i64@b2i(graph_wbt_directed@reachable(c1, 0, 60)));
                _: int64 <- live_trial_i64@put("chain_second_valid", live_trial_i64@d_valid(c2))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
