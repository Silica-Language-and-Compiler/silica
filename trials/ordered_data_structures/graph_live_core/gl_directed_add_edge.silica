// directed_graph_trait.md §4–§5, §8 and live_wbt_graph.md §3–§4 on graph_wbt_directed (unweighted:
// payload = target, edge_target = identity): add_edge auto-adds missing endpoints (node count grows
// by 0, 1 or 2), inserted/replaced flags (10 * inserted + replaced), a duplicate pair is a no-op, a
// self-loop counts once, neighbors ascend by target, out_degree, directional has_edge, target-only
// vertices, ascending vertex order, edge_count = sum of out-degrees, and validation.

use graph_wbt_directed;
use live_trial_i64;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                r1: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(g0, 10, 20);
                _: int64 <- live_trial_i64@put("add_10_20_flags", live_trial_i64@flags(r1.inserted, r1.replaced));
                _: int64 <- live_trial_i64@put("add_10_20_nodes", graph_wbt_directed@node_count(r1.graph));
                r2: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(r1.graph, 10, 5);
                _: int64 <- live_trial_i64@put("add_10_5_flags", live_trial_i64@flags(r2.inserted, r2.replaced));
                _: int64 <- live_trial_i64@put("add_10_5_nodes", graph_wbt_directed@node_count(r2.graph));
                r3: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(r2.graph, 10, 20);
                _: int64 <- live_trial_i64@put("dup_10_20_flags", live_trial_i64@flags(r3.inserted, r3.replaced));
                _: int64 <- live_trial_i64@put("dup_10_20_edges", graph_wbt_directed@edge_count(r3.graph));
                r4: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(r3.graph, 20, 20);
                _: int64 <- live_trial_i64@put("loop_20_flags", live_trial_i64@flags(r4.inserted, r4.replaced));
                _: int64 <- live_trial_i64@put("loop_20_nodes", graph_wbt_directed@node_count(r4.graph));
                _: int64 <- live_trial_i64@put("loop_20_edges", graph_wbt_directed@edge_count(r4.graph));
                r5: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(r4.graph, 30, 10);
                _: int64 <- live_trial_i64@put("add_30_10_nodes", graph_wbt_directed@node_count(r5.graph));
                r6: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(r5.graph, 40, 50);
                _: int64 <- live_trial_i64@put("add_40_50_nodes", graph_wbt_directed@node_count(r6.graph));
                g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- r6.graph;
                _: int64 <- live_trial_i64@put("edges", graph_wbt_directed@edge_count(g));
                n10: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, 10);
                _: int64 <- live_trial_i64@put("neighbors_10", live_trial_i64@list_code(n10));
                n20: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, 20);
                _: int64 <- live_trial_i64@put("neighbors_20", live_trial_i64@list_code(n20));
                n50: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, 50);
                _: int64 <- live_trial_i64@put("neighbors_50", live_trial_i64@list_code(n50));
                _: int64 <- live_trial_i64@put("has_vertex_50", live_trial_i64@b2i(graph_wbt_directed@has_vertex(g, 50)));
                _: int64 <- live_trial_i64@put("out_degree_10", graph_wbt_directed@out_degree(g, 10));
                _: int64 <- live_trial_i64@put("out_degree_20", graph_wbt_directed@out_degree(g, 20));
                _: int64 <- live_trial_i64@put("out_degree_50", graph_wbt_directed@out_degree(g, 50));
                _: int64 <- live_trial_i64@put("has_10_20", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 10, 20)));
                _: int64 <- live_trial_i64@put("has_20_10", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 20, 10)));
                _: int64 <- live_trial_i64@put("has_20_20", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 20, 20)));
                _: int64 <- live_trial_i64@put("has_30_10", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 30, 10)));
                _: int64 <- live_trial_i64@put("has_10_30", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 10, 30)));
                _: int64 <- live_trial_i64@put("has_99_10", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 99, 10)));
                vs: List[int64, mem(normal)] <- graph_wbt_directed@vertices(g);
                _: int64 <- live_trial_i64@put("vertices", live_trial_i64@list_code(vs));
                _: int64 <- live_trial_i64@put("valid", live_trial_i64@d_valid(g))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
