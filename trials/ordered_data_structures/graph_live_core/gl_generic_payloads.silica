        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s0: DirectedGraph[string, string, mem(normal)] <- graph_wbt_directed@empty({ compare_node: cmp_str, compare_edge: cmp_str, edge_target: ident_str });
                s1: :unchanged | (:inserted, { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) <- graph_wbt_directed@add_edge(s0, "b", "c");
