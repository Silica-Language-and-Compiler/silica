// common_contract.md §1 overriding genericity rule on the live graph modules: the node, payload,
// edge-data and weight types come only from the programmer's declarations. string vertices with
// string payloads (directed, lexicographic neighbor and vertex order); int64 vertices with string
// edge data (undirected, replacement in both directions); string vertices with int64 data and
// string weights (weighted directed); string vertices with string data and int64 weights (weighted
// undirected, weight = byte length).

use graph_wbt_directed;
use graph_wbt_undirected;
use graph_weighted;
use graph_weighted_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident_str(s: string) -> string {
    s
}

fn label(d: int64) -> string {
    case d < 5 of {
        true -> "light";
        false -> "heavy"
    }
}

fn byte_length(s: string) -> int64 {
    length_bytes(s)
}

fn join(xs: List[string, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> join(xs.tail, concat(concat(acc, ","), xs.head))
    }
}

fn join_data(xs: List[{ to: int64, data: string }, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: int64, data: string } <- xs.head;
            join_data(xs.tail, concat(concat(acc, ","), w.data))
        }
    }
}

fn join_targets(xs: List[{ to: string, data: int64 }, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: string, data: int64 } <- xs.head;
            join_targets(xs.tail, concat(concat(acc, ","), w.to))
        }
    }
}

fn say(label: string, s: string) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(" ");
        println(s)
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s0: DirectedGraph[string, string, mem(normal)] <- graph_wbt_directed@empty({ compare_node: cmp_str, compare_edge: cmp_str, edge_target: ident_str });
                s1: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(s0, "b", "c");
                s2: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(s1.graph, "a", "c");
                s3: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(s2.graph, "a", "b");
                s4: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(s3.graph, "c", "a");
                s5: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(s4.graph, "a", "b");
                sg: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- s5.graph;
                _: int64 <- live_trial_i64@put("str_dup_flags", live_trial_i64@flags(s5.inserted, s5.replaced));
                _: int64 <- live_trial_i64@put("str_nodes", graph_wbt_directed@node_count(sg));
                _: int64 <- live_trial_i64@put("str_edges", graph_wbt_directed@edge_count(sg));
                sa: List[string, mem(normal)] <- graph_wbt_directed@neighbors(sg, "a");
                _: int64 <- say("str_neighbors_a", join(sa, ""));
                sv: List[string, mem(normal)] <- graph_wbt_directed@vertices(sg);
                _: int64 <- say("str_vertices", join(sv, ""));
                _: int64 <- live_trial_i64@put("str_has_c_a", live_trial_i64@b2i(graph_wbt_directed@has_edge(sg, "c", "a")));
                _: int64 <- live_trial_i64@put("str_has_a_a", live_trial_i64@b2i(graph_wbt_directed@has_edge(sg, "a", "a")));
                _: int64 <- live_trial_i64@put("str_reachable_b_a", live_trial_i64@b2i(graph_wbt_directed@reachable(sg, "b", "a")));
                sval: { valid: boolean, error: atom, logical_count: int64 } <- graph_wbt_directed@validate(sg);
                _: int64 <- live_trial_i64@put("str_valid", graph_wbt_directed@validate_error_code(sval.error) * 1000 + sval.logical_count);
                u0: UndirectedGraph[int64, string, mem(normal)] <- graph_wbt_undirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_str });
                u1: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u0, 1, 2, "x");
                u2: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u1.graph, 2, 3, "y");
                u3: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u2.graph, 2, 1, "z");
                ug: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- u3.graph;
                n2: List[{ to: int64, data: string }, mem(normal)] <- graph_wbt_undirected@neighbors(ug, 2);
                _: int64 <- say("udata_neighbors_2", join_data(n2, ""));
                n1: List[{ to: int64, data: string }, mem(normal)] <- graph_wbt_undirected@neighbors(ug, 1);
                _: int64 <- say("udata_neighbors_1", join_data(n1, ""));
                old1: List[{ to: int64, data: string }, mem(normal)] <- graph_wbt_undirected@neighbors(u2.graph, 1);
                _: int64 <- say("udata_old_neighbors_1", join_data(old1, ""));
                uval: { valid: boolean, error: atom, logical_count: int64 } <- graph_wbt_undirected@validate(ug);
                _: int64 <- live_trial_i64@put("udata_valid", graph_wbt_undirected@validate_error_code(uval.error) * 1000 + uval.logical_count);
                w0: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- graph_weighted@empty({ compare_node: cmp_str, compare_edge_data: cmp_i64, edge_weight: label, compare_weight: cmp_str });
                w1: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w0, "x", "y", 3);
                w2: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w1.graph, "x", "z", 8);
                w3: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w2.graph, "y", "y", 1);
                wg: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- w3.graph;
                wxy: { status: :not_found | :found, weight: string } <- graph_weighted@weight_of(wg, "x", "y", "none");
                _: int64 <- say("wstr_weight_x_y", wxy.weight);
                wxz: { status: :not_found | :found, weight: string } <- graph_weighted@weight_of(wg, "x", "z", "none");
                _: int64 <- say("wstr_weight_x_z", wxz.weight);
                wzx: { status: :not_found | :found, weight: string } <- graph_weighted@weight_of(wg, "z", "x", "none");
                _: int64 <- say("wstr_weight_z_x", wzx.weight);
                _: int64 <- live_trial_i64@put("wstr_compare_heavy_light", live_trial_i64@cmp_code(graph_weighted@compare_weight(wg, "heavy", "light")));
                wn: List[{ to: string, data: int64 }, mem(normal)] <- graph_weighted@weighted_neighbors(wg, "x");
                _: int64 <- say("wstr_neighbors_x", join_targets(wn, ""));
                x0: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- graph_weighted_undirected@empty({ compare_node: cmp_str, compare_edge_data: cmp_str, edge_weight: byte_length, compare_weight: cmp_i64 });
                x1: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted_undirected@add_edge(x0, "p", "q", "abc");
                x2: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted_undirected@add_edge(x1.graph, "q", "r", "de");
                xg: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- x2.graph;
                wqp: { status: :not_found | :found, weight: int64 } <- graph_weighted_undirected@weight_of(xg, "q", "p", 0);
                _: int64 <- live_trial_i64@put("wlen_weight_q_p", wqp.weight);
                wrq: { status: :not_found | :found, weight: int64 } <- graph_weighted_undirected@weight_of(xg, "r", "q", 0);
                _: int64 <- live_trial_i64@put("wlen_weight_r_q", wrq.weight);
                _: int64 <- live_trial_i64@put("wlen_degree_q", graph_weighted_undirected@degree(xg, "q"));
                _: int64 <- live_trial_i64@put("wlen_connected_p_r", live_trial_i64@b2i(graph_weighted_undirected@connected(xg, "p", "r")));
                xval: { valid: boolean, error: atom, logical_count: int64 } <- graph_weighted_undirected@validate(xg);
                _: int64 <- live_trial_i64@put("wlen_valid", graph_weighted_undirected@validate_error_code(xval.error) * 1000 + xval.logical_count)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
