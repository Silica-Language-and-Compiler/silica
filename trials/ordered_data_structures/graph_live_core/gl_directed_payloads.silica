// directed_graph_trait.md §1–§2, §4–§5, §9 item 4 on graph_wbt_directed with a custom payload
// (EdgePayloadType differs from the target): payload t*100 + label targets t (edge_target =
// hundreds). One adjacency position per (from, target): a different payload for the same target
// replaces (flags 1), a comparator-equal payload is a no-op (flags 0). neighbors are payloads in
// ascending target order; has_edge takes vertex IDs; edge_target, compare_edge and compare_node use
// the captured functions; validate rejects a record whose extractor disagrees with the keys.

use graph_wbt_directed;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn hundreds(x: int64) -> int64 {
    x / 100
}

fn ident(x: int64) -> int64 {
    x
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                p0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_wbt_directed@empty({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: hundreds });
                a: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(p0, 1, 205);
                _: int64 <- live_trial_i64@put("add_1_205_flags", live_trial_i64@flags(a.inserted, a.replaced));
                _: int64 <- live_trial_i64@put("add_1_205_nodes", graph_wbt_directed@node_count(a.graph));
                b: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(a.graph, 1, 207);
                _: int64 <- live_trial_i64@put("add_1_207_flags", live_trial_i64@flags(b.inserted, b.replaced));
                _: int64 <- live_trial_i64@put("add_1_207_edges", graph_wbt_directed@edge_count(b.graph));
                c: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(b.graph, 1, 207);
                _: int64 <- live_trial_i64@put("again_1_207_flags", live_trial_i64@flags(c.inserted, c.replaced));
                d: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(c.graph, 1, 309);
                _: int64 <- live_trial_i64@put("add_1_309_flags", live_trial_i64@flags(d.inserted, d.replaced));
                _: int64 <- live_trial_i64@put("add_1_309_nodes", graph_wbt_directed@node_count(d.graph));
                e: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(d.graph, 3, 301);
                g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- e.graph;
                _: int64 <- live_trial_i64@put("edges", graph_wbt_directed@edge_count(g));
                n1: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, 1);
                _: int64 <- live_trial_i64@put("neighbors_1", live_trial_i64@list_code3(n1));
                n3: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, 3);
                _: int64 <- live_trial_i64@put("neighbors_3", live_trial_i64@list_code3(n3));
                old: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(a.graph, 1);
                _: int64 <- live_trial_i64@put("old_neighbors_1", live_trial_i64@list_code3(old));
                t309: int64 <- graph_wbt_directed@edge_target(g, 309);
                _: int64 <- live_trial_i64@put("edge_target_309", t309);
                _: int64 <- live_trial_i64@put("compare_edge_207_309", live_trial_i64@cmp_code(graph_wbt_directed@compare_edge(g, 207, 309)));
                _: int64 <- live_trial_i64@put("compare_node_3_1", live_trial_i64@cmp_code(graph_wbt_directed@compare_node(g, 3, 1)));
                _: int64 <- live_trial_i64@put("has_1_2", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 1, 2)));
                _: int64 <- live_trial_i64@put("has_1_207", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 1, 207)));
                _: int64 <- live_trial_i64@put("reachable_1_3", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 1, 3)));
                _: int64 <- live_trial_i64@put("valid", live_trial_i64@d_valid(g));
                bad: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { root: g.root, compare_node: g.compare_node, compare_edge: g.compare_edge, edge_target: ident, region: g.region, specialization_key: g.specialization_key, node_count: g.node_count, edge_count: g.edge_count, compare_node_ordering_bundle: g.compare_node_ordering_bundle, compare_edge_ordering_bundle: g.compare_edge_ordering_bundle, edge_target_ordering_bundle: g.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("wrong_extractor_valid", live_trial_i64@d_valid(bad))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
