// Open generic-module layout defect, staged per the genericity rule (common_contract.md §1): record
// edge data through the live graph modules. weighted_graph_trait.md §13's example —
// WeightedGraph[int64, {weight: int64}, int64] with edge_weight reading the record — must find the
// weight 7 for (10, 20), and the generated neighbor view must carry the record data; an undirected
// graph with {label, cost} edge data must return both fields in both directions.
// Expected (derived from the designs): weight_status 1, weight 7, view_weight 7, u_label 3,
// u_cost 9, u_back_cost 9. Observed with the 2026-09-18 compiler: see the suite README (record- or
// tuple-typed items through generic modules are read with the wrong layout; another agent is fixing
// it). The graph modules store one word per value, exactly as for int64 or string.

use graph_weighted;
use graph_wbt_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_weight_data(a: { weight: int64 }, b: { weight: int64 }) -> :less | :equal | :greater {
    cmp_i64(a.weight, b.weight)
}

fn weight_data_weight(d: { weight: int64 }) -> int64 {
    d.weight
}

fn compare_cost(a: { label: int64, cost: int64 }, b: { label: int64, cost: int64 }) -> :less | :equal | :greater {
    cmp_i64(a.cost, b.cost)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn({ weight: int64 }, { weight: int64 }) -> :less | :equal | :greater, compare_value: fn({ weight: int64 }, { weight: int64 }) -> :less | :equal | :greater, edge_weight: fn({ weight: int64 }) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- graph_weighted@empty({ compare_node: cmp_i64, compare_edge_data: compare_weight_data, edge_weight: weight_data_weight, compare_weight: cmp_i64 });
                d7: { weight: int64 } <- { weight: 7 };
                g1: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn({ weight: int64 }, { weight: int64 }) -> :less | :equal | :greater, compare_value: fn({ weight: int64 }, { weight: int64 }) -> :less | :equal | :greater, edge_weight: fn({ weight: int64 }) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(g0, 10, 20, d7);
                w: { status: :not_found | :found, weight: int64 } <- graph_weighted@weight_of(g1.graph, 10, 20, 0);
                _: int64 <- live_trial_i64@put("weight_status", case w.status of { :found -> 1; :not_found -> 0 });
                _: int64 <- live_trial_i64@put("weight", w.weight);
                vs: List[{ to: int64, data: { weight: int64 } }, mem(normal)] <- graph_weighted@neighbors(g1.graph, 10);
                v: { to: int64, data: { weight: int64 } } <- vs.head;
                vd: { weight: int64 } <- v.data;
                _: int64 <- live_trial_i64@put("view_weight", vd.weight);
                u0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn({ label: int64, cost: int64 }, { label: int64, cost: int64 }) -> :less | :equal | :greater, compare_value: fn({ label: int64, cost: int64 }, { label: int64, cost: int64 }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_wbt_undirected@empty({ compare_node: cmp_i64, compare_edge_data: compare_cost });
                c: { label: int64, cost: int64 } <- { label: 3, cost: 9 };
                u1: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn({ label: int64, cost: int64 }, { label: int64, cost: int64 }) -> :less | :equal | :greater, compare_value: fn({ label: int64, cost: int64 }, { label: int64, cost: int64 }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u0, 1, 2, c);
                us: List[{ to: int64, data: { label: int64, cost: int64 } }, mem(normal)] <- graph_wbt_undirected@neighbors(u1.graph, 2);
                u: { to: int64, data: { label: int64, cost: int64 } } <- us.head;
                ud: { label: int64, cost: int64 } <- u.data;
                _: int64 <- live_trial_i64@put("u_label", ud.label);
                _: int64 <- live_trial_i64@put("u_cost", ud.cost);
                bs: List[{ to: int64, data: { label: int64, cost: int64 } }, mem(normal)] <- graph_wbt_undirected@neighbors(u1.graph, 1);
                b: { to: int64, data: { label: int64, cost: int64 } } <- bs.head;
                bd: { label: int64, cost: int64 } <- b.data;
                _: int64 <- live_trial_i64@put("u_back_cost", bd.cost)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
