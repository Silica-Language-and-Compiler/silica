// directed_graph_trait.md §4, §6 and live_wbt_graph.md §7–§8 on graph_wbt_directed: fold_vertices
// visits every vertex once in ascending order, fold_edges visits every directed edge once in
// (from, target) order, fold_neighbors folds one vertex's payloads without a list (a missing vertex
// folds nothing), and reachable follows outgoing edges only, terminates on cycles and self-loops, is
// false for an absent endpoint and true for an existing vertex to itself.

use graph_wbt_directed;
use live_trial_i64;
use trial_support_int64;

fn pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 2, 3, 3, 1, 3, 4, 5, 5, 6, 1]
    produces
        pure xs
    end
}

fn vertex_step(acc: int64, v: int64) -> int64 {
    acc * 100 + v
}

fn edge_step(acc: int64, from: int64, to: int64) -> int64 {
    acc * 100 + from * 10 + to
}

fn sum_step(acc: int64, to: int64) -> int64 {
    acc + to
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(g0, pairs());
                _: int64 <- live_trial_i64@put("nodes", graph_wbt_directed@node_count(g));
                _: int64 <- live_trial_i64@put("edges", graph_wbt_directed@edge_count(g));
                f_fold_vertices: int64 <- graph_wbt_directed@fold_vertices(g, 1, vertex_step);
                _: int64 <- live_trial_i64@put("fold_vertices", f_fold_vertices);
                f_fold_edges: int64 <- graph_wbt_directed@fold_edges(g, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", f_fold_edges);
                f_fold_neighbors_3: int64 <- graph_wbt_directed@fold_neighbors(g, 0, sum_step, 3);
                _: int64 <- live_trial_i64@put("fold_neighbors_3", f_fold_neighbors_3);
                f_fold_neighbors_9: int64 <- graph_wbt_directed@fold_neighbors(g, 0, sum_step, 9);
                _: int64 <- live_trial_i64@put("fold_neighbors_9", f_fold_neighbors_9);
                _: int64 <- live_trial_i64@put("reachable_1_4", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 1, 4)));
                _: int64 <- live_trial_i64@put("reachable_4_1", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 4, 1)));
                _: int64 <- live_trial_i64@put("reachable_5_5", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 5, 5)));
                _: int64 <- live_trial_i64@put("reachable_6_3", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 6, 3)));
                _: int64 <- live_trial_i64@put("reachable_1_6", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 1, 6)));
                _: int64 <- live_trial_i64@put("reachable_5_1", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 5, 1)));
                _: int64 <- live_trial_i64@put("reachable_4_4", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 4, 4)));
                _: int64 <- live_trial_i64@put("reachable_1_99", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 1, 99)));
                _: int64 <- live_trial_i64@put("reachable_99_99", live_trial_i64@b2i(graph_wbt_directed@reachable(g, 99, 99)));
                e: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                f_empty_fold_vertices: int64 <- graph_wbt_directed@fold_vertices(e, 1, vertex_step);
                _: int64 <- live_trial_i64@put("empty_fold_vertices", f_empty_fold_vertices);
                f_empty_fold_edges: int64 <- graph_wbt_directed@fold_edges(e, 1, edge_step);
                _: int64 <- live_trial_i64@put("empty_fold_edges", f_empty_fold_edges)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
