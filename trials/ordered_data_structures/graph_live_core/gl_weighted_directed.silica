// weighted_graph_trait.md §3, §5–§8, §11 and directed_graph_trait.md §4 on graph_weighted (weighted
// directed live graph; edge_weight = twice, compare_weight = int64 order): edge identity is
// (from, to), so adding an existing pair replaces the complete data (flags 1) and keeps the counts;
// weighted neighbors ascend by target, not weight (view_code: to*100+data); weight_of finds the
// extracted weight or returns the placeholder with :not_found (status 1/0); edge_weight,
// compare_weight, compare_edge_data, compare_edge (target then data) and edge_target use the captured
// functions; folds, out_degree, has_edge, reachable, removal, persistence and validation.

use graph_weighted;
use live_trial_i64;
use trial_support_int64;

fn data_step(acc: int64, w: { to: int64, data: int64 }) -> int64 {
    acc + w.data
}

fn edge_step(acc: int64, from: int64, w: { to: int64, data: int64 }) -> int64 {
    acc * 1000 + from * 100 + w.to * 10 + w.data
}

fn status_code(r: { status: :not_found | :found, weight: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                w0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@new_wd();
                a: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w0, 1, 3, 5);
                _: int64 <- live_trial_i64@put("add_1_3_flags", live_trial_i64@flags(a.inserted, a.replaced));
                _: int64 <- live_trial_i64@put("add_1_3_nodes", graph_weighted@node_count(a.graph));
                b: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(a.graph, 1, 2, 9);
                c: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(b.graph, 1, 3, 4);
                _: int64 <- live_trial_i64@put("replace_1_3_flags", live_trial_i64@flags(c.inserted, c.replaced));
                _: int64 <- live_trial_i64@put("replace_1_3_edges", graph_weighted@edge_count(c.graph));
                d: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(c.graph, 2, 2, 7);
                g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- d.graph;
                _: int64 <- live_trial_i64@put("nodes", graph_weighted@node_count(g));
                _: int64 <- live_trial_i64@put("edges", graph_weighted@edge_count(g));
                wn: List[{ to: int64, data: int64 }, mem(normal)] <- graph_weighted@weighted_neighbors(g, 1);
                _: int64 <- live_trial_i64@put("weighted_neighbors_1", live_trial_i64@view_code(wn));
                nn: List[{ to: int64, data: int64 }, mem(normal)] <- graph_weighted@neighbors(g, 1);
                _: int64 <- live_trial_i64@put("neighbors_1", live_trial_i64@view_code(nn));
                w13: { status: :not_found | :found, weight: int64 } <- graph_weighted@weight_of(g, 1, 3, 77);
                _: int64 <- live_trial_i64@put("weight_of_1_3_status", status_code(w13));
                _: int64 <- live_trial_i64@put("weight_of_1_3", w13.weight);
                w31: { status: :not_found | :found, weight: int64 } <- graph_weighted@weight_of(g, 3, 1, 77);
                _: int64 <- live_trial_i64@put("weight_of_3_1_status", status_code(w31));
                _: int64 <- live_trial_i64@put("weight_of_3_1", w31.weight);
                w19: { status: :not_found | :found, weight: int64 } <- graph_weighted@weight_of(g, 1, 99, 77);
                _: int64 <- live_trial_i64@put("weight_of_1_99_status", status_code(w19));
                ew: int64 <- graph_weighted@edge_weight(g, 21);
                _: int64 <- live_trial_i64@put("edge_weight_21", ew);
                _: int64 <- live_trial_i64@put("compare_weight_8_18", live_trial_i64@cmp_code(graph_weighted@compare_weight(g, 8, 18)));
                _: int64 <- live_trial_i64@put("compare_edge_data_5_5", live_trial_i64@cmp_code(graph_weighted@compare_edge_data(g, 5, 5)));
                v29: { to: int64, data: int64 } <- { to: 2, data: 9 };
                v31: { to: int64, data: int64 } <- { to: 3, data: 1 };
                v24: { to: int64, data: int64 } <- { to: 2, data: 4 };
                _: int64 <- live_trial_i64@put("compare_edge_29_31", live_trial_i64@cmp_code(graph_weighted@compare_edge(g, v29, v31)));
                _: int64 <- live_trial_i64@put("compare_edge_29_24", live_trial_i64@cmp_code(graph_weighted@compare_edge(g, v29, v24)));
                t: int64 <- graph_weighted@edge_target(g, v31);
                _: int64 <- live_trial_i64@put("edge_target_31", t);
                _: int64 <- live_trial_i64@put("out_degree_1", graph_weighted@out_degree(g, 1));
                _: int64 <- live_trial_i64@put("has_1_3", live_trial_i64@b2i(graph_weighted@has_edge(g, 1, 3)));
                _: int64 <- live_trial_i64@put("has_3_1", live_trial_i64@b2i(graph_weighted@has_edge(g, 3, 1)));
                _: int64 <- live_trial_i64@put("reachable_1_2", live_trial_i64@b2i(graph_weighted@reachable(g, 1, 2)));
                _: int64 <- live_trial_i64@put("reachable_2_1", live_trial_i64@b2i(graph_weighted@reachable(g, 2, 1)));
                fw: int64 <- graph_weighted@fold_weighted_neighbors(g, 0, data_step, 1);
                _: int64 <- live_trial_i64@put("fold_weighted_neighbors_1", fw);
                fn1: int64 <- graph_weighted@fold_neighbors(g, 0, data_step, 1);
                _: int64 <- live_trial_i64@put("fold_neighbors_1", fn1);
                fe: int64 <- graph_weighted@fold_edges(g, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", fe);
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_weighted@validate(g);
                _: int64 <- live_trial_i64@put("valid", graph_weighted@validate_error_code(v.error) * 1000 + v.logical_count);
                rm: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, removed: boolean } <- graph_weighted@remove_edge(g, 1, 3);
                _: int64 <- live_trial_i64@put("remove_1_3", live_trial_i64@b2i(rm.removed));
                _: int64 <- live_trial_i64@put("remove_1_3_edges", graph_weighted@edge_count(rm.graph));
                r13: { status: :not_found | :found, weight: int64 } <- graph_weighted@weight_of(rm.graph, 1, 3, 0);
                _: int64 <- live_trial_i64@put("remove_1_3_weight_status", status_code(r13));
                o13: { status: :not_found | :found, weight: int64 } <- graph_weighted@weight_of(c.graph, 1, 3, 0);
                _: int64 <- live_trial_i64@put("old_c_weight_1_3", o13.weight);
                p13: { status: :not_found | :found, weight: int64 } <- graph_weighted@weight_of(b.graph, 1, 3, 0);
                _: int64 <- live_trial_i64@put("old_b_weight_1_3", p13.weight)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
