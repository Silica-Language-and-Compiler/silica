// live_wbt_graph.md §9, §11 and common_contract.md §12 on graph_wbt_directed / graph_wbt_undirected
// validate (printed as error code * 1000 + logical_count; graph_wbt_core@validate_error_code:
// 0 ok, 2 wrong_arena, 5 negative_count, 6 size_mismatch, 7 order_violation, 9 edge_count_mismatch,
// 10 missing_endpoint, 11 undirected_asymmetry, 12 target_mismatch). Valid graphs report their
// logical edge count. Malformed values are built from real graphs by replacing one record field, or
// by hand from wbt_map nodes (a target that is not a vertex, which the public updates never create;
// an inner map outside the graph's arena was a ninth case, mixed_arena; chunk 15 phase 2 (P7) retired
// ref_in_region, the validators no longer tell arenas apart, and the case was removed),
// or by reading a directed root as undirected (one stored direction; reverse data that differ).

use wbt_map;
use graph_wbt_directed;
use graph_wbt_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_desc(a: int64, b: int64) -> :less | :equal | :greater {
    cmp_i64(b, a)
}

fn root_cmp(_: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> :less | :equal | :greater {
    :equal
}

fn add_one(x: int64) -> int64 {
    x + 1
}

fn pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 2, 3, 3, 1]
    produces
        pure xs
    end
}

fn triples() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 5, 2, 3, 6]
    produces
        pure xs
    end
}

fn with_counts(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, n: int64, m: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { root: g.root, compare_node: g.compare_node, compare_edge: g.compare_edge, edge_target: g.edge_target, region: g.region, specialization_key: g.specialization_key, node_count: n, edge_count: m, compare_node_ordering_bundle: g.compare_node_ordering_bundle, compare_edge_ordering_bundle: g.compare_edge_ordering_bundle, edge_target_ordering_bundle: g.edge_target_ordering_bundle };
    out
}

fn u_counts(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, n: int64, m: int64, a: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- { root: g.root, compare_node: g.compare_node, compare_edge_data: g.compare_edge_data, compare_value: g.compare_value, region: g.region, specialization_key: g.specialization_key, node_count: n, edge_count: m, adjacency_entry_count: a, compare_node_ordering_bundle: g.compare_node_ordering_bundle, compare_edge_data_ordering_bundle: g.compare_edge_data_ordering_bundle };
    out
}

// Reads a directed graph's storage as an undirected graph with the given counts.
fn as_undirected(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, m: int64, a: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- { root: g.root, compare_node: g.compare_node, compare_edge_data: g.compare_edge, compare_value: g.compare_edge, region: g.region, specialization_key: g.specialization_key, node_count: g.node_count, edge_count: m, adjacency_entry_count: a, compare_node_ordering_bundle: g.compare_node_ordering_bundle, compare_edge_data_ordering_bundle: g.compare_edge_ordering_bundle };
    out
}

// Unbound constructor results share wbt_map's canonical arena (a let-binding of a registered
// constructor call is re-anchored to its specialization's arena, so these helpers return the call).
fn inner_empty() -> { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    wbt_map@empty({ compare_key: cmp_i64, compare_value: cmp_i64 })
}

fn outer_empty() -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    wbt_map@empty({ compare_key: cmp_i64, compare_value: root_cmp })
}

// Vertex 1 with the single entry 1 -> 7 (7 is not a vertex); outer and inner maps in one arena.
fn missing_endpoint(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    sequence
        im1: { map: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- wbt_map@insert(inner_empty(), 7, 7);
        om1: { map: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- wbt_map@insert(outer_empty(), 1, im1.map.root);
        out: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { root: om1.map.root, compare_node: g.compare_node, compare_edge: g.compare_edge, edge_target: g.edge_target, region: om1.map.region, specialization_key: g.specialization_key, node_count: 1, edge_count: 1, compare_node_ordering_bundle: g.compare_node_ordering_bundle, compare_edge_ordering_bundle: g.compare_edge_ordering_bundle, edge_target_ordering_bundle: g.edge_target_ordering_bundle }
    produces
        pure out
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                d: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(e, pairs());
                _: int64 <- live_trial_i64@put("directed_valid", live_trial_i64@d_valid(d));
                _: int64 <- live_trial_i64@put("negative_nodes", live_trial_i64@d_valid(with_counts(d, -1, 3)));
                _: int64 <- live_trial_i64@put("node_count_mismatch", live_trial_i64@d_valid(with_counts(d, 4, 3)));
                _: int64 <- live_trial_i64@put("edge_count_mismatch", live_trial_i64@d_valid(with_counts(d, 3, 2)));
                wt: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { root: d.root, compare_node: d.compare_node, compare_edge: d.compare_edge, edge_target: add_one, region: d.region, specialization_key: d.specialization_key, node_count: 3, edge_count: 3, compare_node_ordering_bundle: d.compare_node_ordering_bundle, compare_edge_ordering_bundle: d.compare_edge_ordering_bundle, edge_target_ordering_bundle: d.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("target_mismatch", live_trial_i64@d_valid(wt));
                wo: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { root: d.root, compare_node: cmp_desc, compare_edge: d.compare_edge, edge_target: d.edge_target, region: d.region, specialization_key: d.specialization_key, node_count: 3, edge_count: 3, compare_node_ordering_bundle: d.compare_node_ordering_bundle, compare_edge_ordering_bundle: d.compare_edge_ordering_bundle, edge_target_ordering_bundle: d.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("order_violation", live_trial_i64@d_valid(wo));
                _: int64 <- live_trial_i64@put("missing_endpoint", live_trial_i64@d_valid(missing_endpoint(d)));
                ue: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@new_u();
                u: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u_triples(ue, triples());
                _: int64 <- live_trial_i64@put("undirected_valid", live_trial_i64@u_valid(u));
                _: int64 <- live_trial_i64@put("negative_entries", live_trial_i64@u_valid(u_counts(u, 3, 2, -4)));
                _: int64 <- live_trial_i64@put("entry_count_mismatch", live_trial_i64@u_valid(u_counts(u, 3, 2, 3)));
                _: int64 <- live_trial_i64@put("logical_edge_mismatch", live_trial_i64@u_valid(u_counts(u, 3, 3, 4)));
                one_way: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(e, 1, 2);
                _: int64 <- live_trial_i64@put("one_direction", live_trial_i64@u_valid(as_undirected(one_way, 1, 1)));
                back: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(one_way, 2, 1);
                _: int64 <- live_trial_i64@put("reverse_data_differs", live_trial_i64@u_valid(as_undirected(back, 1, 2)));
                lp: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u(ue, 1, 1, 4);
                _: int64 <- live_trial_i64@put("self_loop_valid", live_trial_i64@u_valid(lp))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
