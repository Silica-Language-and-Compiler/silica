// undirected_graph_trait.md §4–§9 and live_wbt_graph.md §5–§7, §9 on graph_wbt_undirected with
// int64 edge data: a non-loop edge is stored in both directions with the same data, a self-loop once;
// re-adding either orientation replaces the data in both directions (flags 1) without changing
// counts; neighbors are {to, data} views in ascending target order (view_code: to*100+data per
// view); degree counts a loop twice while neighbor_entry_count counts its one entry; the sum of
// degrees is twice edge_count; fold_edges visits each logical edge once from its lesser endpoint;
// connected; removal deletes both directions (or one loop entry); the old graph is unchanged.

use graph_wbt_undirected;
use live_trial_i64;
use trial_support_int64;

fn edge_step(acc: int64, a: int64, b: int64, data: int64) -> int64 {
    acc * 1000 + a * 100 + b * 10 + data
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                u0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@new_u();
                r1: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u0, 1, 2, 7);
                _: int64 <- live_trial_i64@put("add_1_2_flags", live_trial_i64@flags(r1.inserted, r1.replaced));
                _: int64 <- live_trial_i64@put("add_1_2_nodes", graph_wbt_undirected@node_count(r1.graph));
                _: int64 <- live_trial_i64@put("add_1_2_edges", graph_wbt_undirected@edge_count(r1.graph));
                _: int64 <- live_trial_i64@put("add_1_2_entries", graph_wbt_undirected@adjacency_entry_count(r1.graph));
                r2: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(r1.graph, 2, 3, 8);
                r3: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(r2.graph, 3, 3, 9);
                _: int64 <- live_trial_i64@put("loop_3_flags", live_trial_i64@flags(r3.inserted, r3.replaced));
                _: int64 <- live_trial_i64@put("loop_3_edges", graph_wbt_undirected@edge_count(r3.graph));
                _: int64 <- live_trial_i64@put("loop_3_entries", graph_wbt_undirected@adjacency_entry_count(r3.graph));
                r4: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(r3.graph, 2, 1, 6);
                _: int64 <- live_trial_i64@put("readd_2_1_flags", live_trial_i64@flags(r4.inserted, r4.replaced));
                g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- r4.graph;
                _: int64 <- live_trial_i64@put("edges", graph_wbt_undirected@edge_count(g));
                _: int64 <- live_trial_i64@put("entries", graph_wbt_undirected@adjacency_entry_count(g));
                n1: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(g, 1);
                _: int64 <- live_trial_i64@put("neighbors_1", live_trial_i64@view_code(n1));
                n2: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(g, 2);
                _: int64 <- live_trial_i64@put("neighbors_2", live_trial_i64@view_code(n2));
                n3: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(g, 3);
                _: int64 <- live_trial_i64@put("neighbors_3", live_trial_i64@view_code(n3));
                _: int64 <- live_trial_i64@put("degree_1", graph_wbt_undirected@degree(g, 1));
                _: int64 <- live_trial_i64@put("degree_2", graph_wbt_undirected@degree(g, 2));
                _: int64 <- live_trial_i64@put("degree_3", graph_wbt_undirected@degree(g, 3));
                _: int64 <- live_trial_i64@put("entry_count_3", graph_wbt_undirected@neighbor_entry_count(g, 3));
                _: int64 <- live_trial_i64@put("degree_missing_9", graph_wbt_undirected@degree(g, 9));
                _: int64 <- live_trial_i64@put("has_3_2", live_trial_i64@b2i(graph_wbt_undirected@has_edge(g, 3, 2)));
                _: int64 <- live_trial_i64@put("has_2_3", live_trial_i64@b2i(graph_wbt_undirected@has_edge(g, 2, 3)));
                _: int64 <- live_trial_i64@put("has_1_3", live_trial_i64@b2i(graph_wbt_undirected@has_edge(g, 1, 3)));
                _: int64 <- live_trial_i64@put("has_3_3", live_trial_i64@b2i(graph_wbt_undirected@has_edge(g, 3, 3)));
                f: int64 <- graph_wbt_undirected@fold_edges(g, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", f);
                _: int64 <- live_trial_i64@put("valid", live_trial_i64@u_valid(g));
                v4: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean } <- graph_wbt_undirected@add_vertex(g, 4);
                h: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- v4.graph;
                _: int64 <- live_trial_i64@put("connected_1_3", live_trial_i64@b2i(graph_wbt_undirected@connected(h, 1, 3)));
                _: int64 <- live_trial_i64@put("connected_3_1", live_trial_i64@b2i(graph_wbt_undirected@connected(h, 3, 1)));
                _: int64 <- live_trial_i64@put("connected_1_4", live_trial_i64@b2i(graph_wbt_undirected@connected(h, 1, 4)));
                _: int64 <- live_trial_i64@put("connected_4_4", live_trial_i64@b2i(graph_wbt_undirected@connected(h, 4, 4)));
                rm1: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_undirected@remove_edge(h, 3, 2);
                _: int64 <- live_trial_i64@put("remove_3_2", live_trial_i64@b2i(rm1.removed));
                _: int64 <- live_trial_i64@put("remove_3_2_edges", graph_wbt_undirected@edge_count(rm1.graph));
                _: int64 <- live_trial_i64@put("remove_3_2_entries", graph_wbt_undirected@adjacency_entry_count(rm1.graph));
                _: int64 <- live_trial_i64@put("remove_3_2_has_2_3", live_trial_i64@b2i(graph_wbt_undirected@has_edge(rm1.graph, 2, 3)));
                m3: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(rm1.graph, 3);
                _: int64 <- live_trial_i64@put("remove_3_2_neighbors_3", live_trial_i64@view_code(m3));
                _: int64 <- live_trial_i64@put("remove_3_2_connected_1_3", live_trial_i64@b2i(graph_wbt_undirected@connected(rm1.graph, 1, 3)));
                rm2: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_undirected@remove_edge(rm1.graph, 3, 3);
                _: int64 <- live_trial_i64@put("remove_loop_edges", graph_wbt_undirected@edge_count(rm2.graph));
                _: int64 <- live_trial_i64@put("remove_loop_entries", graph_wbt_undirected@adjacency_entry_count(rm2.graph));
                rm3: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_undirected@remove_edge(rm2.graph, 1, 3);
                _: int64 <- live_trial_i64@put("remove_missing", live_trial_i64@b2i(rm3.removed));
                _: int64 <- live_trial_i64@put("final_nodes", graph_wbt_undirected@node_count(rm3.graph));
                _: int64 <- live_trial_i64@put("final_valid", live_trial_i64@u_valid(rm3.graph));
                _: int64 <- live_trial_i64@put("old_r2_edges", graph_wbt_undirected@edge_count(r2.graph));
                _: int64 <- live_trial_i64@put("old_r2_entries", graph_wbt_undirected@adjacency_entry_count(r2.graph));
                o2: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(r2.graph, 2);
                _: int64 <- live_trial_i64@put("old_r2_neighbors_2", live_trial_i64@view_code(o2))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
