// weighted_graph_trait.md §5, §7–§8, §11 and undirected_graph_trait.md §5–§7 on
// graph_weighted_undirected (edge_weight = twice): one logical datum produces two directional views
// {to: v, data} and {to: u, data}; replacement from either orientation updates both (flags 1);
// a self-loop has one view; weight_of answers the same weight in both orientations; degree counts a
// loop twice; fold_edges visits each logical edge once; removal drops both views; validation.

use graph_weighted_undirected;
use live_trial_i64;
use trial_support_int64;

fn edge_step(acc: int64, a: int64, b: int64, data: int64) -> int64 {
    acc * 1000 + a * 100 + b * 10 + data
}

fn status_code(r: { status: :not_found | :found, weight: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                x0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@new_wu();
                a: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted_undirected@add_edge(x0, 1, 2, 5);
                _: int64 <- live_trial_i64@put("add_1_2_flags", live_trial_i64@flags(a.inserted, a.replaced));
                _: int64 <- live_trial_i64@put("add_1_2_entries", graph_weighted_undirected@adjacency_entry_count(a.graph));
                b: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted_undirected@add_edge(a.graph, 3, 1, 6);
                c: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted_undirected@add_edge(b.graph, 2, 1, 7);
                _: int64 <- live_trial_i64@put("replace_2_1_flags", live_trial_i64@flags(c.inserted, c.replaced));
                _: int64 <- live_trial_i64@put("replace_2_1_edges", graph_weighted_undirected@edge_count(c.graph));
                _: int64 <- live_trial_i64@put("replace_2_1_entries", graph_weighted_undirected@adjacency_entry_count(c.graph));
                d: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted_undirected@add_edge(c.graph, 3, 3, 4);
                g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- d.graph;
                _: int64 <- live_trial_i64@put("edges", graph_weighted_undirected@edge_count(g));
                _: int64 <- live_trial_i64@put("entries", graph_weighted_undirected@adjacency_entry_count(g));
                w1: List[{ to: int64, data: int64 }, mem(normal)] <- graph_weighted_undirected@weighted_neighbors(g, 1);
                _: int64 <- live_trial_i64@put("weighted_neighbors_1", live_trial_i64@view_code(w1));
                n2: List[{ to: int64, data: int64 }, mem(normal)] <- graph_weighted_undirected@neighbors(g, 2);
                _: int64 <- live_trial_i64@put("neighbors_2", live_trial_i64@view_code(n2));
                n3: List[{ to: int64, data: int64 }, mem(normal)] <- graph_weighted_undirected@neighbors(g, 3);
                _: int64 <- live_trial_i64@put("neighbors_3", live_trial_i64@view_code(n3));
                w21: { status: :not_found | :found, weight: int64 } <- graph_weighted_undirected@weight_of(g, 2, 1, 0);
                _: int64 <- live_trial_i64@put("weight_of_2_1", w21.weight);
                w12: { status: :not_found | :found, weight: int64 } <- graph_weighted_undirected@weight_of(g, 1, 2, 0);
                _: int64 <- live_trial_i64@put("weight_of_1_2", w12.weight);
                w33: { status: :not_found | :found, weight: int64 } <- graph_weighted_undirected@weight_of(g, 3, 3, 0);
                _: int64 <- live_trial_i64@put("weight_of_3_3", w33.weight);
                w23: { status: :not_found | :found, weight: int64 } <- graph_weighted_undirected@weight_of(g, 2, 3, 55);
                _: int64 <- live_trial_i64@put("weight_of_2_3_status", status_code(w23));
                _: int64 <- live_trial_i64@put("weight_of_2_3", w23.weight);
                _: int64 <- live_trial_i64@put("degree_3", graph_weighted_undirected@degree(g, 3));
                _: int64 <- live_trial_i64@put("entry_count_3", graph_weighted_undirected@neighbor_entry_count(g, 3));
                ew: int64 <- graph_weighted_undirected@edge_weight(g, 10);
                _: int64 <- live_trial_i64@put("edge_weight_10", ew);
                _: int64 <- live_trial_i64@put("compare_weight_14_14", live_trial_i64@cmp_code(graph_weighted_undirected@compare_weight(g, 14, 14)));
                v31: { to: int64, data: int64 } <- { to: 3, data: 1 };
                t: int64 <- graph_weighted_undirected@edge_target(g, v31);
                _: int64 <- live_trial_i64@put("edge_target_31", t);
                f: int64 <- graph_weighted_undirected@fold_edges(g, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", f);
                _: int64 <- live_trial_i64@put("connected_2_3", live_trial_i64@b2i(graph_weighted_undirected@connected(g, 2, 3)));
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_weighted_undirected@validate(g);
                _: int64 <- live_trial_i64@put("valid", graph_weighted_undirected@validate_error_code(v.error) * 1000 + v.logical_count);
                rm: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, removed: boolean } <- graph_weighted_undirected@remove_edge(g, 1, 2);
                r21: { status: :not_found | :found, weight: int64 } <- graph_weighted_undirected@weight_of(rm.graph, 2, 1, 0);
                _: int64 <- live_trial_i64@put("remove_1_2_weight_2_1_status", status_code(r21));
                _: int64 <- live_trial_i64@put("remove_1_2_edges", graph_weighted_undirected@edge_count(rm.graph));
                _: int64 <- live_trial_i64@put("remove_1_2_entries", graph_weighted_undirected@adjacency_entry_count(rm.graph));
                rv: { valid: boolean, error: atom, logical_count: int64 } <- graph_weighted_undirected@validate(rm.graph);
                _: int64 <- live_trial_i64@put("remove_1_2_valid", graph_weighted_undirected@validate_error_code(rv.error) * 1000 + rv.logical_count);
                oa: { status: :not_found | :found, weight: int64 } <- graph_weighted_undirected@weight_of(a.graph, 2, 1, 0);
                _: int64 <- live_trial_i64@put("old_a_weight_2_1", oa.weight)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
