// weighted_graph_trait.md §5, §7–§8, §11 and undirected_graph_trait.md §5–§7 on
// graph_weighted_undirected (edge_weight = twice): one logical datum produces two directional views
// {to: v, data} and {to: u, data}; replacement from either orientation updates both (flags 1);
// a self-loop has one view; weight_of answers the same weight in both orientations; degree counts a
// loop twice; fold_edges visits each logical edge once; removal drops both views; validation.

use graph_weighted_undirected;
use live_trial_i64;
use trial_support_int64;

fn edge_step(acc: int64, a: int64, b: int64, data: int64) -> int64 {
    acc * 1000 + a * 100 + b * 10 + data
}

fn status_code(r: { status: :not_found | :found, weight: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

