// live_wbt_graph.md §3 and directed_graph_trait.md §4–§6 on graph_wbt_directed: the empty graph
// (bracket-typed DirectedGraph[int64, int64, mem(normal)] binding), explicit isolated vertices,
// add_vertex flags, the missing-versus-isolated distinction (neighbors empty and out_degree 0 for
// both, has_vertex tells them apart), ascending vertex order, and persistence of the empty value.

use graph_wbt_directed;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident(x: int64) -> int64 {
    x
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: DirectedGraph[int64, int64, mem(normal)] <- graph_wbt_directed@empty({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident });
                _: int64 <- live_trial_i64@put("empty_nodes", graph_wbt_directed@node_count(e));
                _: int64 <- live_trial_i64@put("empty_edges", graph_wbt_directed@edge_count(e));
                _: int64 <- live_trial_i64@put("empty_has_5", live_trial_i64@b2i(graph_wbt_directed@has_vertex(e, 5)));
                l_empty_neighbors_5: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(e, 5);
                _: int64 <- live_trial_i64@put("empty_neighbors_5", live_trial_i64@list_code(l_empty_neighbors_5));
                _: int64 <- live_trial_i64@put("empty_out_degree_5", graph_wbt_directed@out_degree(e, 5));
                _: int64 <- live_trial_i64@put("empty_valid", live_trial_i64@d_valid(e));
                a1: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean } <- graph_wbt_directed@add_vertex(e, 5);
                a2: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean } <- graph_wbt_directed@add_vertex(a1.graph, 5);
                a3: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean } <- graph_wbt_directed@add_vertex(a2.graph, 3);
                _: int64 <- live_trial_i64@put("add_5_inserted", live_trial_i64@b2i(a1.inserted));
                _: int64 <- live_trial_i64@put("add_5_again_inserted", live_trial_i64@b2i(a2.inserted));
                _: int64 <- live_trial_i64@put("add_3_inserted", live_trial_i64@b2i(a3.inserted));
                g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- a3.graph;
                _: int64 <- live_trial_i64@put("nodes", graph_wbt_directed@node_count(g));
                _: int64 <- live_trial_i64@put("edges", graph_wbt_directed@edge_count(g));
                _: int64 <- live_trial_i64@put("has_5", live_trial_i64@b2i(graph_wbt_directed@has_vertex(g, 5)));
                _: int64 <- live_trial_i64@put("has_4", live_trial_i64@b2i(graph_wbt_directed@has_vertex(g, 4)));
                l_isolated_neighbors_5: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, 5);
                _: int64 <- live_trial_i64@put("isolated_neighbors_5", live_trial_i64@list_code(l_isolated_neighbors_5));
                _: int64 <- live_trial_i64@put("isolated_out_degree_5", graph_wbt_directed@out_degree(g, 5));
                l_missing_neighbors_4: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, 4);
                _: int64 <- live_trial_i64@put("missing_neighbors_4", live_trial_i64@list_code(l_missing_neighbors_4));
                l_vertices: List[int64, mem(normal)] <- graph_wbt_directed@vertices(g);
                _: int64 <- live_trial_i64@put("vertices", live_trial_i64@list_code(l_vertices));
                _: int64 <- live_trial_i64@put("valid", live_trial_i64@d_valid(g));
                _: int64 <- live_trial_i64@put("old_empty_nodes", graph_wbt_directed@node_count(e))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
