// undirected_graph_trait.md §2, §4, §13 on graph_wbt_undirected with EdgeDataType = unit (the
// unweighted specialization): a bracket-typed UndirectedGraph[int64, unit, mem(normal)] binding,
// add_unit_edge (the design's add_edge/3 convenience; header deviation 2) supplies (), a duplicate in
// either orientation is a no-op (flags 0), add_edge/4 with () also inserts, self-loop and degree
// rules hold, and validation passes.

use graph_wbt_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_unit(a: unit, b: unit) -> :less | :equal | :greater {
    :equal
}

fn targets_code(xs: List[{ to: int64, data: unit }, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: int64, data: unit } <- xs.head;
            targets_code(xs.tail, acc * 100 + w.to)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: UndirectedGraph[int64, unit, mem(normal)] <- graph_wbt_undirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_unit });
                a: :unchanged | (:inserted, { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }) | (:replaced, { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }) <- graph_wbt_undirected@add_unit_edge(g0, 10, 20);
                a_graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- case a of {
                    :unchanged -> g0;
                    (:inserted, v_inserted: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }) -> v_inserted;
