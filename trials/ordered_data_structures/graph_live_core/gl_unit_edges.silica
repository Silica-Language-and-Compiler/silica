// undirected_graph_trait.md §2, §4, §13 on graph_wbt_undirected with EdgeDataType = unit (the
// unweighted specialization): a bracket-typed UndirectedGraph[int64, unit, mem(normal)] binding,
// add_unit_edge (the design's add_edge/3 convenience; header deviation 2) supplies (), a duplicate in
// either orientation is a no-op (flags 0), add_edge/4 with () also inserts, self-loop and degree
// rules hold, and validation passes.

use graph_wbt_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_unit(a: unit, b: unit) -> :less | :equal | :greater {
    :equal
}

fn targets_code(xs: List[{ to: int64, data: unit }, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: int64, data: unit } <- xs.head;
            targets_code(xs.tail, acc * 100 + w.to)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: UndirectedGraph[int64, unit, mem(normal)] <- graph_wbt_undirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_unit });
                a: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_unit_edge(g0, 10, 20);
                _: int64 <- live_trial_i64@put("add_10_20_flags", live_trial_i64@flags(a.inserted, a.replaced));
                b: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_unit_edge(a.graph, 20, 10);
                _: int64 <- live_trial_i64@put("dup_20_10_flags", live_trial_i64@flags(b.inserted, b.replaced));
                c: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_unit_edge(b.graph, 20, 20);
                _: int64 <- live_trial_i64@put("loop_20_flags", live_trial_i64@flags(c.inserted, c.replaced));
                d: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(c.graph, 30, 20, ());
                _: int64 <- live_trial_i64@put("add4_30_20_flags", live_trial_i64@flags(d.inserted, d.replaced));
                g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- d.graph;
                _: int64 <- live_trial_i64@put("nodes", graph_wbt_undirected@node_count(g));
                _: int64 <- live_trial_i64@put("edges", graph_wbt_undirected@edge_count(g));
                _: int64 <- live_trial_i64@put("entries", graph_wbt_undirected@adjacency_entry_count(g));
                _: int64 <- live_trial_i64@put("degree_20", graph_wbt_undirected@degree(g, 20));
                _: int64 <- live_trial_i64@put("entry_count_20", graph_wbt_undirected@neighbor_entry_count(g, 20));
                n20: List[{ to: int64, data: unit }, mem(normal)] <- graph_wbt_undirected@neighbors(g, 20);
                _: int64 <- live_trial_i64@put("neighbors_20", targets_code(n20, 1));
                _: int64 <- live_trial_i64@put("has_20_30", live_trial_i64@b2i(graph_wbt_undirected@has_edge(g, 20, 30)));
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_wbt_undirected@validate(g);
                _: int64 <- live_trial_i64@put("valid", graph_wbt_undirected@validate_error_code(v.error) * 1000 + v.logical_count);
                _: int64 <- live_trial_i64@put("old_nodes", graph_wbt_undirected@node_count(g0))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
