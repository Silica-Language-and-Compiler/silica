                    (:replaced, _v_replaced: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }) -> true
                };
                _: int64 <- live_trial_i64@put("add4_30_20_flags", live_trial_i64@flags(d_inserted, d_replaced));
                g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- d_graph;
                _: int64 <- live_trial_i64@put("nodes", graph_wbt_undirected@node_count(g));
                _: int64 <- live_trial_i64@put("edges", graph_wbt_undirected@edge_count(g));
                _: int64 <- live_trial_i64@put("entries", graph_wbt_undirected@adjacency_entry_count(g));
                _: int64 <- live_trial_i64@put("degree_20", graph_wbt_undirected@degree(g, 20));
                _: int64 <- live_trial_i64@put("entry_count_20", graph_wbt_undirected@neighbor_entry_count(g, 20));
                n20: List[{ to: int64, data: unit }, mem(normal)] <- graph_wbt_undirected@neighbors(g, 20);
                _: int64 <- live_trial_i64@put("neighbors_20", targets_code(n20, 1));
                _: int64 <- live_trial_i64@put("has_20_30", live_trial_i64@b2i(graph_wbt_undirected@has_edge(g, 20, 30)));
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_wbt_undirected@validate(g);
                _: int64 <- live_trial_i64@put("valid", graph_wbt_undirected@validate_error_code(v.error) * 1000 + v.logical_count);
                _: int64 <- live_trial_i64@put("old_nodes", graph_wbt_undirected@node_count(g0))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
