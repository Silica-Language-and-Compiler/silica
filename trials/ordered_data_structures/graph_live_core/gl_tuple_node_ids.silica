// Tuple vertex IDs through graph_wbt_directed (genericity rule, common_contract.md §1).
// NodeIdType = EdgePayloadType = (int64, int64) with a lexicographic comparator; the edge
// (1,2) -> (3,4) must be found and the neighbor read back. Formerly the open generic-payload defect
// defect_generic_payload_tuple_node_ids; passes since the uniform boxed record layout (2026-09-18) and
// the tuple var-tail epilogue fix of 2026-09-19 (ident_pair returned its parameter and popped a slab it
// never pushed; trials/generic_modules_addition/tuple_param_returned_as_is).
// Expected (derived from the designs): nodes 2, edges 1, has_edge 1, neighbor_first 3,
// neighbor_second 4.

use graph_wbt_directed;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_pair(a: (int64, int64), b: (int64, int64)) -> :less | :equal | :greater {
    sequence
        (a1: int64, a2: int64) <- a;
        (b1: int64, b2: int64) <- b;
        c: :less | :equal | :greater <- cmp_i64(a1, b1)
    produces
        pure case c of {
            :equal -> cmp_i64(a2, b2);
            _: atom -> c
        }
    end
}

fn ident_pair(p: (int64, int64)) -> (int64, int64) {
    p
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: { root: ref?(L, normal, rec), compare_node: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater, compare_edge: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater, edge_target: fn((int64, int64)) -> (int64, int64), region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_wbt_directed@empty({ compare_node: cmp_pair, compare_edge: cmp_pair, edge_target: ident_pair });
                from: (int64, int64) <- (1, 2);
                to: (int64, int64) <- (3, 4);
                g1: { graph: { root: ref?(L, normal, rec), compare_node: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater, compare_edge: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater, edge_target: fn((int64, int64)) -> (int64, int64), region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(g0, from, to);
                g: { root: ref?(L, normal, rec), compare_node: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater, compare_edge: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater, edge_target: fn((int64, int64)) -> (int64, int64), region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- g1.graph;
                _: int64 <- live_trial_i64@put("nodes", graph_wbt_directed@node_count(g));
                _: int64 <- live_trial_i64@put("edges", graph_wbt_directed@edge_count(g));
                _: int64 <- live_trial_i64@put("has_edge", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, from, to)));
                ns: List[(int64, int64), mem(normal)] <- graph_wbt_directed@neighbors(g, from);
                (n1: int64, n2: int64) <- ns.head;
                _: int64 <- live_trial_i64@put("neighbor_first", n1);
                _: int64 <- live_trial_i64@put("neighbor_second", n2)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
