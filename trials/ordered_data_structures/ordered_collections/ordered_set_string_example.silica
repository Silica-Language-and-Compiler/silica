// §10 Step 5: string OrderedSet example from the design.

use wbt_set;
use OrderedSet;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                names0: OrderedSet[string, mem(normal)] <- wbt_set@empty({ compare_item: cmp_str });
                r1: :unchanged | (:inserted, { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(names0, "Ada");
                r1_set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case r1 of {
                    :unchanged -> names0;
                    (:inserted, v_inserted: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                r1_inserted: boolean <- case r1 of {
                    :unchanged -> false;
                    (:inserted, _v_inserted: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                r2: :unchanged | (:inserted, { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- wbt_set@insert(r1_set, "Ada");
                r2_set: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case r2 of {
                    :unchanged -> r1_set;
                    (:inserted, v_inserted: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_inserted
                };
                r2_inserted: boolean <- case r2 of {
                    :unchanged -> false;
                    (:inserted, _v_inserted: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                present: boolean <- OrderedSet@contains(r2_set, "Ada");
                empty_still: boolean <- OrderedSet@contains(names0, "Ada");
                exit_code: int64 <- case r1_inserted and r2_inserted == false and present and empty_still == false of {
                    true -> 0;
                    false -> 1
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
