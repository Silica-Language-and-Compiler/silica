// §10 Step 5: string OrderedSet example from the design.

use wbt_set;
use OrderedSet;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                names0: OrderedSet[string, mem(normal)] <- wbt_set@empty({ compare_item: cmp_str });
                r1: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(names0, "Ada");
                r2: {
                    set: {
                        root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(string, string) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(r1.set, "Ada");
                present: boolean <- OrderedSet@contains(r2.set, "Ada");
                empty_still: boolean <- OrderedSet@contains(names0, "Ada");
                exit_code: int64 <- case r1.inserted and r2.inserted == false and present and empty_still == false of {
                    true -> 0;
                    false -> 1
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
