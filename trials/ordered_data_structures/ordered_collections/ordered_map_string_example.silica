// §9 Step 5: string-key OrderedMap example from the design.

use wbt_map;
use OrderedMap;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                users: OrderedMap[string, int64, mem(normal)] <- wbt_map@empty({
                    compare_key: cmp_str,
                    compare_value: cmp_i64
                });
                r1: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(users, "ann", 1);
                r2: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(r1.map, "bob", 2);
                g: { status: :not_found | :found, value: int64 } <- OrderedMap@get(r2.map, "ann", 0);
                f: { status: :not_found | :found, key: string } <- OrderedMap@find_value(r2.map, 2, "");
                exit_code: int64 <- case g.status of {
                    :not_found -> 1;
                    :found -> case g.value == 1 of {
                        false -> 2;
                        true -> case f.status of {
                            :not_found -> 3;
                            :found -> case f.key == "bob" of { true -> 0; false -> 4 }
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
