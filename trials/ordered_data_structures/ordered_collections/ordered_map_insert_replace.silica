// §9 Step 4: insert then replace same key class on OrderedMap path.

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                m0: OrderedMap[int64, int64, mem(normal)] <- wbt_map@empty({
                    compare_key: cmp_i64,
                    compare_value: cmp_i64
                });
                r1: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(m0, 7, 1);
                r2: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(r1.map, 7, 2);
                g: { status: :not_found | :found, value: int64 } <- wbt_map@get(r2.map, 7, 0);
                sz: int64 <- wbt_map@size(r2.map);
                exit_code: int64 <- case r1.inserted and r2.replaced and sz == 1 of {
                    false -> 1;
                    true -> case g.status of {
                        :not_found -> 2;
                        :found -> case g.value == 2 of { true -> 0; false -> 3 }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
