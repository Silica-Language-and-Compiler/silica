// §10 Step 4: public empty + insert + contains + size.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s0: OrderedSet[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
                r1: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(s0, 10);
                one: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- wbt_set@singleton({ compare_item: cmp_i64 }, 99);
                exit_code: int64 <- case r1.inserted and wbt_set@contains(r1.set, 10) and wbt_set@size(r1.set) == 1 of {
                    false -> 1;
                    true -> case wbt_set@contains(one, 99) and wbt_set@size(one) == 1 of {
                        true -> 0;
                        false -> 2
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
