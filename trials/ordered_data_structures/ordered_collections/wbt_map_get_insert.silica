// §9 Step 4: public module get/insert on OrderedMap bind.

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                m0: OrderedMap[int64, int64, mem(normal)] <- wbt_map@empty({
                    compare_key: cmp_i64,
                    compare_value: cmp_i64
                });
                r: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(m0, 5, 50);
                g: { status: :not_found | :found, value: int64 } <- wbt_map@get(r.map, 5, 0);
                c: boolean <- wbt_map@contains_key(r.map, 5);
                exit_code: int64 <- case r.inserted and c of {
                    false -> 1;
                    true -> case g.status of {
                        :not_found -> 2;
                        :found -> case g.value == 50 of { true -> 0; false -> 3 }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
