// §9 Step 2: required OrderedMap trait methods on empty and nonempty maps.

use wbt_map;
use OrderedMap;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn fold_sum(acc: int64, k: int64, v: int64) -> int64 {
    acc + k + v
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: OrderedMap[int64, int64, mem(normal)] <- wbt_map@empty({
                    compare_key: cmp_i64,
                    compare_value: cmp_i64
                });
                empty_sz: int64 <- wbt_map@size(empty0);
                empty_fold: int64 <- wbt_map@fold(empty0, 7, fold_sum);
                empty_get: { status: :not_found | :found, value: int64 } <- OrderedMap@get(empty0, 1, -1);
                ck: atom <- OrderedMap@compare_key(empty0, 1, 2);
                cv: atom <- OrderedMap@compare_value(empty0, 3, 3);
                ins: {
                    map: {
                        root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    inserted: boolean,
                    replaced: boolean
                } <- wbt_map@insert(empty0, 2, 20);
                got: { status: :not_found | :found, value: int64 } <- OrderedMap@get(ins.map, 2, -1);
                sz1: int64 <- OrderedMap@size(ins.map);
                sum1: int64 <- OrderedMap@fold(ins.map, 0, fold_sum);
                exit_code: int64 <- case empty_sz == 0 and empty_fold == 7 of {
                    false -> 1;
                    true -> case empty_get.status of {
                        :found -> 2;
                        :not_found -> case ck of {
                            :less -> case cv of {
                                :equal -> case got.status of {
                                    :not_found -> 3;
                                    :found -> case got.value == 20 and sz1 == 1 and sum1 == 22 of {
                                        true -> 0;
                                        false -> 4
                                    }
                                };
                                _: atom -> 5
                            };
                            _: atom -> 6
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
