// §10 Step 5: persistent insert — prior version unchanged.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s0: OrderedSet[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
                r1: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(s0, 1);
                r2: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(r1.set, 2);
                old_has2: boolean <- wbt_set@contains(r1.set, 2);
                new_has2: boolean <- wbt_set@contains(r2.set, 2);
                exit_code: int64 <- case wbt_set@size(r1.set) == 1 and wbt_set@size(r2.set) == 2 of {
                    false -> 1;
                    true -> case old_has2 == false and new_has2 of { true -> 0; false -> 2 }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
