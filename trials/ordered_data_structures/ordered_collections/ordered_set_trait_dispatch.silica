// §10 Steps 2–3: OrderedSet trait methods on empty and nonempty sets.

use wbt_set;
use OrderedSet;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn fold_sum(acc: int64, item: int64) -> int64 {
    acc + item
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                empty0: OrderedSet[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
                empty_sz: int64 <- OrderedSet@size(empty0);
                empty_fold: int64 <- OrderedSet@fold(empty0, 7, fold_sum);
                empty_has: boolean <- OrderedSet@contains(empty0, 1);
                cmp: atom <- OrderedSet@compare_item(empty0, 1, 2);
                ins: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    inserted: boolean
                } <- wbt_set@insert(empty0, 2);
                has2: boolean <- OrderedSet@contains(ins.set, 2);
                miss: boolean <- OrderedSet@contains(ins.set, 3);
                sz1: int64 <- OrderedSet@size(ins.set);
                sum1: int64 <- OrderedSet@fold(ins.set, 0, fold_sum);
                exit_code: int64 <- case empty_sz == 0 and empty_fold == 7 and empty_has == false of {
                    false -> 1;
                    true -> case cmp of {
                        :less -> case has2 and miss == false and sz1 == 1 and sum1 == 2 of {
                            true -> 0;
                            false -> 2
                        };
                        _: atom -> 3
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
