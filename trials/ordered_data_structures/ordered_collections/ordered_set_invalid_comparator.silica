// §10 Step 4: empty / failure cases from ordered_set_trait.md §6 (public path).

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn fold_id(acc: int64, _: int64) -> int64 {
    acc
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                empty0: OrderedSet[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
                has: boolean <- wbt_set@contains(empty0, 1);
                del: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    removed: boolean
                } <- wbt_set@delete(empty0, 1);
                folded: int64 <- wbt_set@fold(empty0, 42, fold_id);
                bad_items: List[int64, mem(normal)] <- [2, 1];
                bad_sorted: {
                    set: {
                        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    valid: boolean,
                    error: atom
                } <- wbt_set@from_sorted(empty0, bad_items);
                exit_code: int64 <- case has == false and del.removed == false and folded == 42 of {
                    false -> 1;
                    true -> case bad_sorted.valid == false of { true -> 0; false -> 2 }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
