// §9 Step 4: from_sorted and from_list on the public module path.

use wbt_map;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                empty0: OrderedMap[int64, int64, mem(normal)] <- wbt_map@empty({
                    compare_key: cmp_i64,
                    compare_value: cmp_i64
                });
                b1: (int64, int64) <- (1, 10);
                b2: (int64, int64) <- (2, 20);
                b3: (int64, int64) <- (3, 30);
                items: List[(int64, int64), mem(normal)] <- [b1, b2, b3];
                built: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    valid: boolean,
                    error: atom
                } <- wbt_map@from_sorted(empty0, items);
                from_l: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(int64, int64) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    valid: boolean,
                    error: atom
                } <- wbt_map@from_list({
                    compare_key: cmp_i64,
                    compare_value: cmp_i64
                }, items);
                g2: { status: :not_found | :found, value: int64 } <- wbt_map@get(built.map, 2, 0);
                sz_l: int64 <- wbt_map@size(from_l.map);
                exit_code: int64 <- case built.valid and from_l.valid of {
                    false -> 1;
                    true -> case g2.status of {
                        :not_found -> 2;
                        :found -> case g2.value == 20 and sz_l == 3 of {
                            true -> 0;
                            false -> 3
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
