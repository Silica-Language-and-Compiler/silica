    LDR X3, [X1, #32]
    STR X3, [X4, #32]
    LDR X3, [X1, #40]
    STR X3, [X4, #40]
    MOV X0, X4
    ADD SP, SP, #16
    MOV X16, X0
    LDP X6, X7, [SP], #16
    LDP X4, X5, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
