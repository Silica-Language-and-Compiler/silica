    ; export_trait OrderedSet
    ; required_fn compare_item set|a|b OrderedSet|ItemType|ItemType -> :less | :equal | :greater []
    ; required_fn fold set|init|step OrderedSet|AccType|fn ( AccType , ItemType ) -> AccType -> AccType []
    ; required_fn contains set|item OrderedSet|ItemType -> bool []
    ; required_fn size set OrderedSet -> int64 []

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



OrderedSet_compare_item:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    MOV X11, X0

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X11
    MOV X17, SP
    CMP X16, X17
    B.LO 7f
    CMP X16, X29
    B.HS 7f
    STP X0, X1, [SP, #-16]!
    STP X2, X3, [SP, #-16]!
    STP X4, X5, [SP, #-16]!
    STP X6, X7, [SP, #-16]!
    MOV X0, X16
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #48
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    LDR X3, [X1, #32]
    STR X3, [X4, #32]
    LDR X3, [X1, #40]
    STR X3, [X4, #40]
    MOV X0, X4
    ADD SP, SP, #16
    MOV X16, X0
    LDP X6, X7, [SP], #16
    LDP X4, X5, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
    MOV X16, X16
7:
    STR X16, [SP, #-16]!
    MOV X16, X1
    STR X16, [SP, #-16]!
    MOV X16, X2
    STR X16, [SP, #-16]!
    LDR X0, [SP, #32]
    LDR X1, [SP, #16]
    LDR X2, [SP, #0]
    ADD SP, SP, #48
    ; effects []|sir_rec:o1069|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    MOV X8, XZR
    LDP X29, X30, [SP], #16

    ADRP X9, wbt_set_apply_compare_item@PAGE
    ADD X9, X9, wbt_set_apply_compare_item@PAGEOFF
    BR X9


OrderedSet_fold:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    MOV X11, X0

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X11
    MOV X17, SP
    CMP X16, X17
    B.LO 7f
    CMP X16, X29
    B.HS 7f
    STP X0, X1, [SP, #-16]!
    STP X2, X3, [SP, #-16]!
    STP X4, X5, [SP, #-16]!
    STP X6, X7, [SP, #-16]!
    MOV X0, X16
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #48
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    LDR X3, [X1, #32]
    STR X3, [X4, #32]
    LDR X3, [X1, #40]
    STR X3, [X4, #40]
    MOV X0, X4
    ADD SP, SP, #16
    MOV X16, X0
    LDP X6, X7, [SP], #16
    LDP X4, X5, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
    MOV X16, X16
7:
    STR X16, [SP, #-16]!
    MOV X16, X1
    STR X16, [SP, #-16]!
    MOV X16, X2
    STR X16, [SP, #-16]!
    LDR X0, [SP, #32]
    LDR X1, [SP, #16]
    LDR X2, [SP, #0]
    ADD SP, SP, #48
    ; effects []|sir_rec:o1448|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    MOV X8, XZR
    LDP X29, X30, [SP], #16

    ADRP X9, wbt_set_fold@PAGE
    ADD X9, X9, wbt_set_fold@PAGEOFF
    BR X9


OrderedSet_contains:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    MOV X11, X0

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
