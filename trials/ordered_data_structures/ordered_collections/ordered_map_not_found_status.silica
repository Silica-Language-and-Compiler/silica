// §9 Step 4: :not_found status on get/find_value for empty public maps.

use wbt_map;
use OrderedMap;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                m0: OrderedMap[int64, int64, mem(normal)] <- wbt_map@empty({
                    compare_key: cmp_i64,
                    compare_value: cmp_i64
                });
                g: { status: :not_found | :found, value: int64 } <- wbt_map@get(m0, 1, -7);
                f: { status: :not_found | :found, key: int64 } <- OrderedMap@find_value(m0, 1, -7);
                v: {
                    valid: boolean,
                    error: atom,
                    logical_count: int64
                } <- wbt_map@validate(m0);
                exit_code: int64 <- case g.status of {
                    :found -> 1;
                    :not_found -> case f.status of {
                        :found -> 2;
                        :not_found -> case g.value == 0 - 7 and f.key == 0 - 7 and v.valid of {
                            true -> 0;
                            false -> 3
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
