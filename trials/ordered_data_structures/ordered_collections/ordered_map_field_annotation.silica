// ordered_map_trait.md: an update's result bound with a record annotation whose field is the public
// bracket type `OrderedMap[string, int64, mem(normal)]` (the concrete record wbt_map returns,
// common_contract.md §2).
// Expected: "apples" is inserted into the empty map, r.inserted is true, exit 1.

use wbt_map;
use OrderedMap;
use trial_support_int64;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_counts(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                m: OrderedMap[string, int64, mem(normal)] <- wbt_map@empty({ compare_key: compare_names, compare_value: compare_counts });
                r: { map: OrderedMap[string, int64, mem(normal)], inserted: boolean, replaced: boolean } <- wbt_map@insert(m, "apples", 3)
            produces
                pure case r.inserted of {
                    true -> 1;
                    false -> 0
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
