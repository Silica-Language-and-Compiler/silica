// §10 Step 4: from_sorted and from_list on the public module path.

use wbt_set;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                empty0: OrderedSet[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
                items: List[int64, mem(normal)] <- [1, 2, 3];
                built: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    valid: boolean,
                    error: atom
                } <- wbt_set@from_sorted(empty0, items);
                from_l: {
                    set: {
                        root: ref?(L, normal, rec),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_item_ordering_bundle: int64
                    },
                    valid: boolean,
                    error: atom
                } <- wbt_set@from_list({ compare_item: cmp_i64 }, items);
                exit_code: int64 <- case built.valid and from_l.valid of {
                    false -> 1;
                    true -> case wbt_set@contains(built.set, 2) and wbt_set@size(from_l.set) == 3 of {
                        true -> 0;
                        false -> 2
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
