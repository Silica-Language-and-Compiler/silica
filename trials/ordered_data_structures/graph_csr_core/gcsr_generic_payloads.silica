// common_contract.md §1 overriding genericity rule on the CSR snapshots: the gl_generic_payloads
// graphs frozen — string vertices with string payloads (directed; slots in lexicographic order),
// int64 vertices with string edge data (undirected), string vertices with int64 data and string
// weights (weighted directed), string vertices with string data and int64 byte-length weights
// (weighted undirected) — answer as the live graphs do; every buffer holds the declared types.

use graph_wbt_directed;
use graph_wbt_undirected;
use graph_weighted;
use graph_weighted_undirected;
use graph_csr_directed;
use graph_csr_undirected;
use graph_csr_weighted;
use graph_csr_weighted_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident_str(s: string) -> string {
    s
}

fn label(d: int64) -> string {
    case d < 5 of {
        true -> "light";
        false -> "heavy"
    }
}

fn byte_length(s: string) -> int64 {
    length_bytes(s)
}

fn join(xs: List[string, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> join(xs.tail, concat(concat(acc, ","), xs.head))
    }
}

fn join_data(xs: List[{ to: int64, data: string }, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: int64, data: string } <- xs.head;
            join_data(xs.tail, concat(concat(acc, ","), w.data))
        }
    }
}

fn join_targets(xs: List[{ to: string, data: int64 }, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: string, data: int64 } <- xs.head;
            join_targets(xs.tail, concat(concat(acc, ","), w.to))
        }
    }
}

fn say(label: string, s: string) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(" ");
        println(s)
    produces
        pure 0
    end
}

fn add_s(g: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, from: string, to: string) -> { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    r: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(g, from, to);
    r.graph
}

fn string_graph() -> { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    sequence
        s0: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_wbt_directed@empty({ compare_node: cmp_str, compare_edge: cmp_str, edge_target: ident_str });
        s1: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_s(s0, "b", "c");
        s2: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_s(s1, "a", "c");
        s3: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_s(s2, "a", "b")
    produces
        pure add_s(s3, "c", "a")
    end
}

fn data_graph() -> { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    sequence
        u0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_wbt_undirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_str });
        u1: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u0, 1, 2, "x");
        u2: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u1.graph, 2, 3, "y");
        u3: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u2.graph, 2, 1, "z")
    produces
        pure u3.graph
    end
}

fn weighted_graph() -> { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } {
    sequence
        w0: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- graph_weighted@empty({ compare_node: cmp_str, compare_edge_data: cmp_i64, edge_weight: label, compare_weight: cmp_str });
        w1: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w0, "x", "y", 3);
        w2: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w1.graph, "x", "z", 8);
        w3: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w2.graph, "y", "y", 1)
    produces
        pure w3.graph
    end
}

fn length_graph() -> { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } {
    sequence
        x0: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- graph_weighted_undirected@empty({ compare_node: cmp_str, compare_edge_data: cmp_str, edge_weight: byte_length, compare_weight: cmp_i64 });
        x1: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted_undirected@add_edge(x0, "p", "q", "abc");
        x2: { graph: { root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted_undirected@add_edge(x1.graph, "q", "r", "de")
    produces
        pure x2.graph
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                sc: { node_ids: buf(L, normal, string, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, string, na), values: buf(L, normal, string, na), slot_root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(string_graph());
                _: int64 <- live_trial_i64@put("str_nodes", graph_csr_directed@node_count(sc));
                _: int64 <- live_trial_i64@put("str_edges", graph_csr_directed@edge_count(sc));
                sa: List[string, mem(normal)] <- graph_csr_directed@neighbors(sc, "a");
                _: int64 <- say("str_neighbors_a", join(sa, ""));
                sv: List[string, mem(normal)] <- graph_csr_directed@vertices(sc);
                _: int64 <- say("str_vertices", join(sv, ""));
                _: int64 <- live_trial_i64@put("str_has_c_a", live_trial_i64@b2i(graph_csr_directed@has_edge(sc, "c", "a")));
                _: int64 <- live_trial_i64@put("str_reachable_b_a", live_trial_i64@b2i(graph_csr_directed@reachable(sc, "b", "a")));
                uc: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, string, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_csr_undirected@freeze_from_wbt(data_graph());
                n2: List[{ to: int64, data: string }, mem(normal)] <- graph_csr_undirected@neighbors(uc, 2);
                _: int64 <- say("udata_neighbors_2", join_data(n2, ""));
                n1: List[{ to: int64, data: string }, mem(normal)] <- graph_csr_undirected@neighbors(uc, 1);
                _: int64 <- say("udata_neighbors_1", join_data(n1, ""));
                uv: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_undirected@validate(uc);
                _: int64 <- live_trial_i64@put("udata_valid", graph_csr_undirected@validate_error_code(uv.error) * 1000 + uv.logical_count);
                wc: { node_ids: buf(L, normal, string, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, string, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- graph_csr_weighted@freeze_from_wbt(weighted_graph());
                wxy: { status: :not_found | :found, weight: string } <- graph_csr_weighted@weight_of(wc, "x", "y", "none");
                _: int64 <- say("wstr_weight_x_y", wxy.weight);
                wxz: { status: :not_found | :found, weight: string } <- graph_csr_weighted@weight_of(wc, "x", "z", "none");
                _: int64 <- say("wstr_weight_x_z", wxz.weight);
                wzx: { status: :not_found | :found, weight: string } <- graph_csr_weighted@weight_of(wc, "z", "x", "none");
                _: int64 <- say("wstr_weight_z_x", wzx.weight);
                wn: List[{ to: string, data: int64 }, mem(normal)] <- graph_csr_weighted@weighted_neighbors(wc, "x");
                _: int64 <- say("wstr_neighbors_x", join_targets(wn, ""));
                xc: { node_ids: buf(L, normal, string, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, string, na), values: buf(L, normal, string, na), slot_root: ref?(L, normal, rec), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- graph_csr_weighted_undirected@freeze_from_wbt(length_graph());
                wqp: { status: :not_found | :found, weight: int64 } <- graph_csr_weighted_undirected@weight_of(xc, "q", "p", 0);
                _: int64 <- live_trial_i64@put("wlen_weight_q_p", wqp.weight);
                wrq: { status: :not_found | :found, weight: int64 } <- graph_csr_weighted_undirected@weight_of(xc, "r", "q", 0);
                _: int64 <- live_trial_i64@put("wlen_weight_r_q", wrq.weight);
                _: int64 <- live_trial_i64@put("wlen_degree_q", graph_csr_weighted_undirected@degree(xc, "q"));
                xv: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_weighted_undirected@validate(xc);
                _: int64 <- live_trial_i64@put("wlen_valid", graph_csr_weighted_undirected@validate_error_code(xv.error) * 1000 + xv.logical_count)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
