// csr_graph_snapshot.md §1, §8 and CSR-D7 rule 4: freezing reads one live graph version without
// modifying it; later live updates (an added edge, a removed edge, a new vertex) do not appear in the
// snapshot; re-freezing the updated live graph gives a new snapshot; the old live graph and the old
// snapshot both stay valid.

use graph_wbt_directed;
use graph_csr_directed;
use live_trial_i64;
use trial_support_int64;

fn pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 2, 3, 3, 1]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(e, pairs());
                s1: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(g);
                _: int64 <- live_trial_i64@put("live_edges_after_freeze", graph_wbt_directed@edge_count(g));
                _: int64 <- live_trial_i64@put("live_valid_after_freeze", live_trial_i64@d_valid(g));
                g2: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(g, 1, 3);
                r3: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(g2, 2, 3);
                v4: { graph: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean } <- graph_wbt_directed@add_vertex(r3.graph, 4);
                g3: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- v4.graph;
                _: int64 <- live_trial_i64@put("snapshot_edges", graph_csr_directed@edge_count(s1));
                _: int64 <- live_trial_i64@put("snapshot_nodes", graph_csr_directed@node_count(s1));
                _: int64 <- live_trial_i64@put("snapshot_has_1_3", live_trial_i64@b2i(graph_csr_directed@has_edge(s1, 1, 3)));
                _: int64 <- live_trial_i64@put("snapshot_has_2_3", live_trial_i64@b2i(graph_csr_directed@has_edge(s1, 2, 3)));
                _: int64 <- live_trial_i64@put("snapshot_has_vertex_4", live_trial_i64@b2i(graph_csr_directed@has_vertex(s1, 4)));
                s2: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(g3);
                _: int64 <- live_trial_i64@put("refrozen_edges", graph_csr_directed@edge_count(s2));
                _: int64 <- live_trial_i64@put("refrozen_nodes", graph_csr_directed@node_count(s2));
                _: int64 <- live_trial_i64@put("refrozen_has_1_3", live_trial_i64@b2i(graph_csr_directed@has_edge(s2, 1, 3)));
                _: int64 <- live_trial_i64@put("refrozen_has_2_3", live_trial_i64@b2i(graph_csr_directed@has_edge(s2, 2, 3)));
                _: int64 <- live_trial_i64@put("refrozen_has_vertex_4", live_trial_i64@b2i(graph_csr_directed@has_vertex(s2, 4)));
                n1: List[int64, mem(normal)] <- graph_csr_directed@neighbors(s2, 1);
                _: int64 <- live_trial_i64@put("refrozen_neighbors_1", live_trial_i64@list_code(n1));
                o1: List[int64, mem(normal)] <- graph_csr_directed@neighbors(s1, 1);
                _: int64 <- live_trial_i64@put("snapshot_neighbors_1", live_trial_i64@list_code(o1));
                v1: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_directed@validate(s1);
                _: int64 <- live_trial_i64@put("snapshot_valid", graph_csr_directed@validate_error_code(v1.error) * 1000 + v1.logical_count);
                v2: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_directed@validate(s2);
                _: int64 <- live_trial_i64@put("refrozen_valid", graph_csr_directed@validate_error_code(v2.error) * 1000 + v2.logical_count);
                _: int64 <- live_trial_i64@put("old_live_edges", graph_wbt_directed@edge_count(g));
                _: int64 <- live_trial_i64@put("old_live_has_2_3", live_trial_i64@b2i(graph_wbt_directed@has_edge(g, 2, 3)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
