// Snapshot equivalence (csr_graph_snapshot.md §1, §6, §7; CSR-D7 rule 3 through the public module
// operations): CSR snapshots of large live graphs answer every query as the live graph does. The
// 200-vertex ring + chords (i -> i+1, i -> 3i mod 200) with its even ring edges removed, 300
// pseudo-random directed pairs over 25 vertices, and 300 pseudo-random undirected edges over 25
// vertices: has_edge for every ordered pair of the first 25 / 40 IDs, out-degree / degree and the
// neighbor lists of every vertex, reachability from two sources to every vertex, fold sums, counts,
// and both validators.

use graph_wbt_directed;
use graph_wbt_undirected;
use graph_csr_directed;
use graph_csr_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ring_chords(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, i: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    case i >= 200 of {
        true -> g;
        false -> {
            g1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(g, i, (i + 1) % 200);
            g2: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(g1, i, (3 * i) % 200);
            ring_chords(g2, i + 1)
        }
    }
}

fn drop_even_ring(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, i: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    case i >= 200 of {
        true -> g;
        false -> {
            r: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_wbt_directed@remove_edge(g, i, i + 1);
            drop_even_ring(r.graph, i + 2)
        }
    }
}

fn pick(x: int64) -> int64 {
    (x / 65536) % 25
}

fn random_directed(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, x: int64, k: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    case k <= 0 of {
        true -> g;
        false -> {
            x1: int64 <- live_trial_i64@lcg(x);
            x2: int64 <- live_trial_i64@lcg(x1);
            g1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(g, pick(x1), pick(x2));
            random_directed(g1, x2, k - 1)
        }
    }
}

fn random_undirected(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, x: int64, k: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    case k <= 0 of {
        true -> g;
        false -> {
            x1: int64 <- live_trial_i64@lcg(x);
            x2: int64 <- live_trial_i64@lcg(x1);
            a: int64 <- pick(x1);
            b: int64 <- pick(x2);
            g1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u(g, a, b, (a + b) % 10);
            random_undirected(g1, x2, k - 1)
        }
    }
}

fn same_list(xs: List[int64, mem(normal)], ys: List[int64, mem(normal)]) -> boolean {
    case xs.is_nil of {
        true -> ys.is_nil;
        false -> case ys.is_nil of {
            true -> false;
            false -> case xs.head == ys.head of {
                false -> false;
                true -> same_list(xs.tail, ys.tail)
            }
        }
    }
}

fn same_views(xs: List[{ to: int64, data: int64 }, mem(normal)], ys: List[{ to: int64, data: int64 }, mem(normal)]) -> boolean {
    case xs.is_nil of {
        true -> ys.is_nil;
        false -> case ys.is_nil of {
            true -> false;
            false -> {
                a: { to: int64, data: int64 } <- xs.head;
                b: { to: int64, data: int64 } <- ys.head;
                case a.to == b.to and a.data == b.data of {
                    false -> false;
                    true -> same_views(xs.tail, ys.tail)
                }
            }
        }
    }
}

// Mismatches over ordered pairs (p / n, p % n), p < n * n.
fn d_edge_mismatches(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, n: int64, p: int64, acc: int64) -> int64 {
    case p >= n * n of {
        true -> acc;
        false -> {
            a: boolean <- graph_wbt_directed@has_edge(g, p / n, p % n);
            b: boolean <- graph_csr_directed@has_edge(c, p / n, p % n);
            d_edge_mismatches(g, c, n, p + 1, acc + 1 - live_trial_i64@b2i(a == b))
        }
    }
}

// Per-vertex mismatches of out-degree, neighbor list and reachability from `from`.
fn d_vertex_mismatches(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, n: int64, from: int64, v: int64, acc: int64) -> int64 {
    case v >= n of {
        true -> acc;
        false -> {
            da: int64 <- graph_wbt_directed@out_degree(g, v);
            db: int64 <- graph_csr_directed@out_degree(c, v);
            dg: boolean <- da == db;
            la: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(g, v);
            lb: List[int64, mem(normal)] <- graph_csr_directed@neighbors(c, v);
            ra: boolean <- graph_wbt_directed@reachable(g, from, v);
            rb: boolean <- graph_csr_directed@reachable(c, from, v);
            bad: int64 <- 3 - live_trial_i64@b2i(dg) - live_trial_i64@b2i(same_list(la, lb)) - live_trial_i64@b2i(ra == rb);
            d_vertex_mismatches(g, c, n, from, v + 1, acc + bad)
        }
    }
}

fn u_edge_mismatches(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, n: int64, p: int64, acc: int64) -> int64 {
    case p >= n * n of {
        true -> acc;
        false -> {
            a: boolean <- graph_wbt_undirected@has_edge(g, p / n, p % n);
            b: boolean <- graph_csr_undirected@has_edge(c, p / n, p % n);
            u_edge_mismatches(g, c, n, p + 1, acc + 1 - live_trial_i64@b2i(a == b))
        }
    }
}

fn u_vertex_mismatches(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, n: int64, v: int64, acc: int64) -> int64 {
    case v >= n of {
        true -> acc;
        false -> {
            da: int64 <- graph_wbt_undirected@degree(g, v);
            db: int64 <- graph_csr_undirected@degree(c, v);
            dg: boolean <- da == db;
            la: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(g, v);
            lb: List[{ to: int64, data: int64 }, mem(normal)] <- graph_csr_undirected@neighbors(c, v);
            ca: boolean <- graph_wbt_undirected@connected(g, 0, v);
            cb: boolean <- graph_csr_undirected@connected(c, 0, v);
            bad: int64 <- 3 - live_trial_i64@b2i(dg) - live_trial_i64@b2i(same_views(la, lb)) - live_trial_i64@b2i(ca == cb);
            u_vertex_mismatches(g, c, n, v + 1, acc + bad)
        }
    }
}

fn sum_pair(acc: int64, from: int64, to: int64) -> int64 {
    acc + from * 1000 + to
}

fn sum_edge(acc: int64, a: int64, b: int64, data: int64) -> int64 {
    acc + a * 1000 + b * 10 + data
}

fn d_code(v: { valid: boolean, error: atom, logical_count: int64 }) -> int64 {
    graph_csr_directed@validate_error_code(v.error) * 1000 + v.logical_count
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                h: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- drop_even_ring(ring_chords(e, 0), 0);
                hc: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(h);
                _: int64 <- live_trial_i64@put("ring_edges", graph_csr_directed@edge_count(hc));
                _: int64 <- live_trial_i64@put("ring_edge_mismatches", d_edge_mismatches(h, hc, 40, 0, 0));
                _: int64 <- live_trial_i64@put("ring_vertex_mismatches_from_1", d_vertex_mismatches(h, hc, 200, 1, 0, 0));
                _: int64 <- live_trial_i64@put("ring_vertex_mismatches_from_2", d_vertex_mismatches(h, hc, 200, 2, 0, 0));
                s1: int64 <- graph_wbt_directed@fold_edges(h, 0, sum_pair);
                s2: int64 <- graph_csr_directed@fold_edges(hc, 0, sum_pair);
                _: int64 <- live_trial_i64@put("ring_fold_agrees", live_trial_i64@b2i(s1 == s2));
                hv: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_directed@validate(hc);
                _: int64 <- live_trial_i64@put("ring_valid", d_code(hv));
                r: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- random_directed(e, 12345, 300);
                rc: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(r);
                re: int64 <- graph_wbt_directed@edge_count(r);
                rce: int64 <- graph_csr_directed@edge_count(rc);
                _: int64 <- live_trial_i64@put("random_edge_count_agrees", live_trial_i64@b2i(re == rce));
                _: int64 <- live_trial_i64@put("random_edge_mismatches", d_edge_mismatches(r, rc, 25, 0, 0));
                _: int64 <- live_trial_i64@put("random_vertex_mismatches", d_vertex_mismatches(r, rc, 25, 0, 0, 0));
                rv: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_directed@validate(rc);
                _: int64 <- live_trial_i64@put("random_valid_code", graph_csr_directed@validate_error_code(rv.error));
                ue: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@new_u();
                u: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- random_undirected(ue, 777, 300);
                uc: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_csr_undirected@freeze_from_wbt(u);
                ued: int64 <- graph_wbt_undirected@edge_count(u);
                uce: int64 <- graph_csr_undirected@edge_count(uc);
                _: int64 <- live_trial_i64@put("urandom_edge_count_agrees", live_trial_i64@b2i(ued == uce));
                uen: int64 <- graph_wbt_undirected@adjacency_entry_count(u);
                ucn: int64 <- graph_csr_undirected@adjacency_entry_count(uc);
                _: int64 <- live_trial_i64@put("urandom_entries_agree", live_trial_i64@b2i(uen == ucn));
                _: int64 <- live_trial_i64@put("urandom_edge_mismatches", u_edge_mismatches(u, uc, 25, 0, 0));
                _: int64 <- live_trial_i64@put("urandom_vertex_mismatches", u_vertex_mismatches(u, uc, 25, 0, 0));
                f1: int64 <- graph_wbt_undirected@fold_edges(u, 0, sum_edge);
                f2: int64 <- graph_csr_undirected@fold_edges(uc, 0, sum_edge);
                _: int64 <- live_trial_i64@put("urandom_fold_agrees", live_trial_i64@b2i(f1 == f2));
                uv: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_undirected@validate(uc);
                _: int64 <- live_trial_i64@put("urandom_valid_code", graph_csr_undirected@validate_error_code(uv.error))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
