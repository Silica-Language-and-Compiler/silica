// csr_graph_snapshot.md §2–§6, §11 and csr_dense_representation_contract.md CSR-D2/D3 on
// graph_csr_directed: freezing the gl_directed_add_edge graph (10->20, 10->5, 20->20, 30->10, 40->50)
// keeps its counts; slots follow ascending node order; rows answer neighbors (payloads in ascending
// target order), out_degree, has_edge (row binary search), folds and reachable exactly as the live
// graph does; the captured comparators and extractor are copied; validate passes. A graph with IDs
// 100, 200, 300 shows public IDs and int64 slots are separate domains: slot numbers are not vertices.

use graph_csr_directed;
use live_trial_i64;
use trial_support_int64;

fn pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [10, 20, 10, 5, 20, 20, 30, 10, 40, 50]
    produces
        pure xs
    end
}

fn wide_pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [100, 200, 200, 300, 300, 100]
    produces
        pure xs
    end
}

fn vertex_step(acc: int64, v: int64) -> int64 {
    acc * 100 + v
}

// Row order of the edge fold: each visited payload (target) as two base-100 digits.
fn edge_step(acc: int64, from: int64, to: int64) -> int64 {
    acc * 100 + to
}

fn sum_step(acc: int64, e: int64) -> int64 {
    acc + e
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(e, pairs());
                c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(g);
                _: int64 <- live_trial_i64@put("nodes", graph_csr_directed@node_count(c));
                _: int64 <- live_trial_i64@put("edges", graph_csr_directed@edge_count(c));
                n10: List[int64, mem(normal)] <- graph_csr_directed@neighbors(c, 10);
                _: int64 <- live_trial_i64@put("neighbors_10", live_trial_i64@list_code(n10));
                n20: List[int64, mem(normal)] <- graph_csr_directed@neighbors(c, 20);
                _: int64 <- live_trial_i64@put("neighbors_20", live_trial_i64@list_code(n20));
                n50: List[int64, mem(normal)] <- graph_csr_directed@neighbors(c, 50);
                _: int64 <- live_trial_i64@put("neighbors_50", live_trial_i64@list_code(n50));
                n99: List[int64, mem(normal)] <- graph_csr_directed@neighbors(c, 99);
                _: int64 <- live_trial_i64@put("neighbors_99", live_trial_i64@list_code(n99));
                _: int64 <- live_trial_i64@put("has_vertex_50", live_trial_i64@b2i(graph_csr_directed@has_vertex(c, 50)));
                _: int64 <- live_trial_i64@put("has_vertex_99", live_trial_i64@b2i(graph_csr_directed@has_vertex(c, 99)));
                _: int64 <- live_trial_i64@put("out_degree_10", graph_csr_directed@out_degree(c, 10));
                _: int64 <- live_trial_i64@put("out_degree_50", graph_csr_directed@out_degree(c, 50));
                _: int64 <- live_trial_i64@put("has_10_20", live_trial_i64@b2i(graph_csr_directed@has_edge(c, 10, 20)));
                _: int64 <- live_trial_i64@put("has_20_10", live_trial_i64@b2i(graph_csr_directed@has_edge(c, 20, 10)));
                _: int64 <- live_trial_i64@put("has_20_20", live_trial_i64@b2i(graph_csr_directed@has_edge(c, 20, 20)));
                _: int64 <- live_trial_i64@put("has_10_7", live_trial_i64@b2i(graph_csr_directed@has_edge(c, 10, 7)));
                vs: List[int64, mem(normal)] <- graph_csr_directed@vertices(c);
                _: int64 <- live_trial_i64@put("vertices", live_trial_i64@list_code(vs));
                fv: int64 <- graph_csr_directed@fold_vertices(c, 1, vertex_step);
                _: int64 <- live_trial_i64@put("fold_vertices", fv);
                fe: int64 <- graph_csr_directed@fold_edges(c, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", fe);
                fn10: int64 <- graph_csr_directed@fold_neighbors(c, 0, sum_step, 10);
                _: int64 <- live_trial_i64@put("fold_neighbors_10", fn10);
                _: int64 <- live_trial_i64@put("reachable_30_5", live_trial_i64@b2i(graph_csr_directed@reachable(c, 30, 5)));
                _: int64 <- live_trial_i64@put("reachable_5_30", live_trial_i64@b2i(graph_csr_directed@reachable(c, 5, 30)));
                _: int64 <- live_trial_i64@put("reachable_50_50", live_trial_i64@b2i(graph_csr_directed@reachable(c, 50, 50)));
                _: int64 <- live_trial_i64@put("compare_node_10_5", live_trial_i64@cmp_code(graph_csr_directed@compare_node(c, 10, 5)));
                t7: int64 <- graph_csr_directed@edge_target(c, 7);
                _: int64 <- live_trial_i64@put("edge_target_7", t7);
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_directed@validate(c);
                _: int64 <- live_trial_i64@put("valid", graph_csr_directed@validate_error_code(v.error) * 1000 + v.logical_count);
                w: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(e, wide_pairs());
                wc: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(w);
                _: int64 <- live_trial_i64@put("wide_has_vertex_0", live_trial_i64@b2i(graph_csr_directed@has_vertex(wc, 0)));
                _: int64 <- live_trial_i64@put("wide_has_vertex_1", live_trial_i64@b2i(graph_csr_directed@has_vertex(wc, 1)));
                _: int64 <- live_trial_i64@put("wide_has_vertex_200", live_trial_i64@b2i(graph_csr_directed@has_vertex(wc, 200)));
                _: int64 <- live_trial_i64@put("wide_out_degree_1", graph_csr_directed@out_degree(wc, 1));
                _: int64 <- live_trial_i64@put("wide_out_degree_200", graph_csr_directed@out_degree(wc, 200));
                _: int64 <- live_trial_i64@put("wide_has_1_2", live_trial_i64@b2i(graph_csr_directed@has_edge(wc, 1, 2)));
                _: int64 <- live_trial_i64@put("wide_has_200_300", live_trial_i64@b2i(graph_csr_directed@has_edge(wc, 200, 300)));
                wv: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_directed@validate(wc);
                _: int64 <- live_trial_i64@put("wide_valid", graph_csr_directed@validate_error_code(wv.error) * 1000 + wv.logical_count);
                ec: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(e);
                _: int64 <- live_trial_i64@put("empty_nodes", graph_csr_directed@node_count(ec));
                en: List[int64, mem(normal)] <- graph_csr_directed@neighbors(ec, 1);
                _: int64 <- live_trial_i64@put("empty_neighbors_1", live_trial_i64@list_code(en));
                ev: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_directed@validate(ec);
                _: int64 <- live_trial_i64@put("empty_valid", graph_csr_directed@validate_error_code(ev.error) * 1000 + ev.logical_count)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
