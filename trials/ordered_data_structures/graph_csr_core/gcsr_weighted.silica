// csr_graph_snapshot.md §3–§6 and weighted_graph_trait.md §8–§9 (CSR-D4 parallel buffers) on
// graph_csr_weighted (the gl_weighted_directed graph: 1->2:9, 1->3:4 after replacement, 2->2:7;
// weight = twice the data) and graph_csr_weighted_undirected (the gl_weighted_undirected graph:
// {1,2}:7 after replacement, {3,1}:6, loop {3,3}:4): weighted views in target order, weight_of with
// :found / placeholder :not_found (status 1/0), the captured functions, folds, degrees, reachability
// and validation, all as the live graphs answer them.

use graph_csr_weighted;
use graph_csr_weighted_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn data_step(acc: int64, w: { to: int64, data: int64 }) -> int64 {
    acc + w.data
}

fn edge_step(acc: int64, from: int64, w: { to: int64, data: int64 }) -> int64 {
    acc * 1000 + from * 100 + w.to * 10 + w.data
}

fn uedge_step(acc: int64, a: int64, b: int64, data: int64) -> int64 {
    acc * 1000 + a * 100 + b * 10 + data
}

fn status_code(r: { status: :not_found | :found, weight: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

fn directed_source() -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } {
    sequence
        w0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@new_wd();
        w1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@add_wd(w0, 1, 3, 5);
        w2: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@add_wd(w1, 1, 2, 9);
        w3: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@add_wd(w2, 1, 3, 4)
    produces
        pure live_trial_i64@add_wd(w3, 2, 2, 7)
    end
}

fn undirected_source() -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } {
    sequence
        x0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@new_wu();
        x1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@add_wu(x0, 1, 2, 5);
        x2: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@add_wu(x1, 3, 1, 6);
        x3: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@add_wu(x2, 2, 1, 7)
    produces
        pure live_trial_i64@add_wu(x3, 3, 3, 4)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- graph_csr_weighted@freeze_from_wbt(directed_source());
                _: int64 <- live_trial_i64@put("nodes", graph_csr_weighted@node_count(c));
                _: int64 <- live_trial_i64@put("edges", graph_csr_weighted@edge_count(c));
                wn: List[{ to: int64, data: int64 }, mem(normal)] <- graph_csr_weighted@weighted_neighbors(c, 1);
                _: int64 <- live_trial_i64@put("weighted_neighbors_1", live_trial_i64@view_code(wn));
                nn: List[{ to: int64, data: int64 }, mem(normal)] <- graph_csr_weighted@neighbors(c, 1);
                _: int64 <- live_trial_i64@put("neighbors_1", live_trial_i64@view_code(nn));
                w13: { status: :not_found | :found, weight: int64 } <- graph_csr_weighted@weight_of(c, 1, 3, 77);
                _: int64 <- live_trial_i64@put("weight_of_1_3_status", status_code(w13));
                _: int64 <- live_trial_i64@put("weight_of_1_3", w13.weight);
                w31: { status: :not_found | :found, weight: int64 } <- graph_csr_weighted@weight_of(c, 3, 1, 77);
                _: int64 <- live_trial_i64@put("weight_of_3_1_status", status_code(w31));
                _: int64 <- live_trial_i64@put("weight_of_3_1", w31.weight);
                ew: int64 <- graph_csr_weighted@edge_weight(c, 21);
                _: int64 <- live_trial_i64@put("edge_weight_21", ew);
                v29: { to: int64, data: int64 } <- { to: 2, data: 9 };
                v24: { to: int64, data: int64 } <- { to: 2, data: 4 };
                _: int64 <- live_trial_i64@put("compare_edge_29_24", live_trial_i64@cmp_code(graph_csr_weighted@compare_edge(c, v29, v24)));
                t: int64 <- graph_csr_weighted@edge_target(c, v24);
                _: int64 <- live_trial_i64@put("edge_target_24", t);
                _: int64 <- live_trial_i64@put("out_degree_1", graph_csr_weighted@out_degree(c, 1));
                _: int64 <- live_trial_i64@put("reachable_1_2", live_trial_i64@b2i(graph_csr_weighted@reachable(c, 1, 2)));
                _: int64 <- live_trial_i64@put("reachable_2_1", live_trial_i64@b2i(graph_csr_weighted@reachable(c, 2, 1)));
                fw: int64 <- graph_csr_weighted@fold_weighted_neighbors(c, 0, data_step, 1);
                _: int64 <- live_trial_i64@put("fold_weighted_neighbors_1", fw);
                fe: int64 <- graph_csr_weighted@fold_edges(c, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", fe);
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_weighted@validate(c);
                _: int64 <- live_trial_i64@put("valid", graph_csr_weighted@validate_error_code(v.error) * 1000 + v.logical_count);
                x: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- graph_csr_weighted_undirected@freeze_from_wbt(undirected_source());
                _: int64 <- live_trial_i64@put("u_edges", graph_csr_weighted_undirected@edge_count(x));
                _: int64 <- live_trial_i64@put("u_entries", graph_csr_weighted_undirected@adjacency_entry_count(x));
                x1: List[{ to: int64, data: int64 }, mem(normal)] <- graph_csr_weighted_undirected@weighted_neighbors(x, 1);
                _: int64 <- live_trial_i64@put("u_weighted_neighbors_1", live_trial_i64@view_code(x1));
                x21: { status: :not_found | :found, weight: int64 } <- graph_csr_weighted_undirected@weight_of(x, 2, 1, 0);
                _: int64 <- live_trial_i64@put("u_weight_of_2_1", x21.weight);
                x12: { status: :not_found | :found, weight: int64 } <- graph_csr_weighted_undirected@weight_of(x, 1, 2, 0);
                _: int64 <- live_trial_i64@put("u_weight_of_1_2", x12.weight);
                x33: { status: :not_found | :found, weight: int64 } <- graph_csr_weighted_undirected@weight_of(x, 3, 3, 0);
                _: int64 <- live_trial_i64@put("u_weight_of_3_3", x33.weight);
                _: int64 <- live_trial_i64@put("u_degree_3", graph_csr_weighted_undirected@degree(x, 3));
                _: int64 <- live_trial_i64@put("u_connected_2_3", live_trial_i64@b2i(graph_csr_weighted_undirected@connected(x, 2, 3)));
                uf: int64 <- graph_csr_weighted_undirected@fold_edges(x, 1, uedge_step);
                _: int64 <- live_trial_i64@put("u_fold_edges", uf);
                uv: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_weighted_undirected@validate(x);
                _: int64 <- live_trial_i64@put("u_valid", graph_csr_weighted_undirected@validate_error_code(uv.error) * 1000 + uv.logical_count)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
