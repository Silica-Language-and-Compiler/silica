// csr_graph_snapshot.md §5, §10 and common_contract.md §12 on the CSR validators (printed as error
// code * 1000 + logical_count; graph_csr_core@validate_error_code: 0 ok, 1 negative_count,
// 2 csr_offset_violation, 3 order_violation, 4 slot_mismatch, 5 missing_endpoint, 6 target_mismatch,
// 7 edge_count_mismatch, 8 undirected_asymmetry). Malformed snapshots are built from real ones by
// replacing one record field: a negative count, the offsets of a snapshot with one more edge (its
// final offset exceeds this snapshot's A), a reversed node comparator, another snapshot's
// node_to_slot map, another snapshot's target buffer (a target that is not a vertex), a different
// payload extractor, a changed edge count (a directed snapshot's A is its edge count, so the extent
// check reports it first), and a one-way directed snapshot read as undirected.

use graph_csr_directed;
use graph_csr_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_desc(a: int64, b: int64) -> :less | :equal | :greater {
    cmp_i64(b, a)
}

fn add_one(x: int64) -> int64 {
    x + 1
}

fn pairs_a() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 2, 3, 3, 1]
    produces
        pure xs
    end
}

fn pairs_b() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 2, 4, 3, 1]
    produces
        pure xs
    end
}

fn pairs_c() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 2, 3, 3, 1, 1, 3]
    produces
        pure xs
    end
}

fn freeze_pairs(xs: List[int64, mem(normal)]) -> { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    e: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
    g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(e, xs);
    graph_csr_directed@freeze_from_wbt(g)
}

fn code(c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> int64 {
    v: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_directed@validate(c);
    graph_csr_directed@validate_error_code(v.error) * 1000 + v.logical_count
}

fn ucode(c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }) -> int64 {
    v: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_undirected@validate(c);
    graph_csr_undirected@validate_error_code(v.error) * 1000 + v.logical_count
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                a: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- freeze_pairs(pairs_a());
                b: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- freeze_pairs(pairs_b());
                c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- freeze_pairs(pairs_c());
                _: int64 <- live_trial_i64@put("valid", code(a));
                neg: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { node_ids: a.node_ids, offsets: a.offsets, targets: a.targets, values: a.values, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: -1, edge_count: 3, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("negative_count", code(neg));
                offs: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { node_ids: a.node_ids, offsets: c.offsets, targets: a.targets, values: a.values, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 3, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("offsets_extent", code(offs));
                desc: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { node_ids: a.node_ids, offsets: a.offsets, targets: a.targets, values: a.values, slot_root: a.slot_root, compare_node: cmp_desc, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 3, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("node_order", code(desc));
                slots: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { node_ids: a.node_ids, offsets: a.offsets, targets: a.targets, values: a.values, slot_root: b.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 3, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("slot_map", code(slots));
                tgts: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { node_ids: a.node_ids, offsets: a.offsets, targets: b.targets, values: a.values, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 3, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("missing_endpoint", code(tgts));
                extr: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { node_ids: a.node_ids, offsets: a.offsets, targets: a.targets, values: a.values, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: add_one, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 3, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("target_mismatch", code(extr));
                cnt: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { node_ids: a.node_ids, offsets: a.offsets, targets: a.targets, values: a.values, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 4, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("edge_count_changed", code(cnt));
                und: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- { node_ids: a.node_ids, offsets: a.offsets, targets: a.targets, values: a.values, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge_data: a.compare_edge, compare_value: a.compare_edge, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 3, adjacency_entry_count: 3, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_data_ordering_bundle: a.compare_edge_ordering_bundle };
                _: int64 <- live_trial_i64@put("undirected_asymmetry", ucode(und));
                u0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@new_u();
                u1: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u(u0, 1, 2, 5);
                uc: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_csr_undirected@freeze_from_wbt(live_trial_i64@add_u(u1, 2, 2, 6));
                _: int64 <- live_trial_i64@put("undirected_valid", ucode(uc));
                ubad: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- { node_ids: uc.node_ids, offsets: uc.offsets, targets: uc.targets, values: uc.values, slot_root: uc.slot_root, compare_node: uc.compare_node, compare_edge_data: uc.compare_edge_data, compare_value: uc.compare_value, region: uc.region, specialization_key: uc.specialization_key, node_count: 2, edge_count: 3, adjacency_entry_count: 3, compare_node_ordering_bundle: uc.compare_node_ordering_bundle, compare_edge_data_ordering_bundle: uc.compare_edge_data_ordering_bundle };
                _: int64 <- live_trial_i64@put("undirected_edge_count_mismatch", ucode(ubad))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
