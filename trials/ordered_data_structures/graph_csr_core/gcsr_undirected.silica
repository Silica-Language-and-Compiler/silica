// csr_graph_snapshot.md §7, §10 and undirected_graph_trait.md §6–§9 on graph_csr_undirected: the
// gl_undirected_symmetry graph ({1,2}:6 after replacement, {2,3}:8, loop {3,3}:9) frozen keeps both
// directions of each non-loop edge (two rows) and one entry for the loop, the logical and
// adjacency-entry counts, the {to, data} views (view_code), degree (loop twice), neighbor_entry_count,
// the canonical edge fold, connected, and validates. A unit-data graph (EdgeDataType = unit) freezes too.

use graph_wbt_undirected;
use graph_csr_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_unit(a: unit, b: unit) -> :less | :equal | :greater {
    :equal
}

fn triples() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 7, 2, 3, 8, 3, 3, 9, 2, 1, 6]
    produces
        pure xs
    end
}

fn edge_step(acc: int64, a: int64, b: int64, data: int64) -> int64 {
    acc * 1000 + a * 100 + b * 10 + data
}

fn data_step(acc: int64, w: { to: int64, data: int64 }) -> int64 {
    acc + w.data
}

// {10, 20} and the loop {20, 20} with unit data.
fn unit_source() -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    sequence
        g0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_wbt_undirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_unit });
        a: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_unit_edge(g0, 10, 20);
        b: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_unit_edge(a.graph, 20, 20)
    produces
        pure b.graph
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                u0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@new_u();
                u: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u_triples(u0, triples());
                c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_csr_undirected@freeze_from_wbt(u);
                _: int64 <- live_trial_i64@put("nodes", graph_csr_undirected@node_count(c));
                _: int64 <- live_trial_i64@put("edges", graph_csr_undirected@edge_count(c));
                _: int64 <- live_trial_i64@put("entries", graph_csr_undirected@adjacency_entry_count(c));
                n1: List[{ to: int64, data: int64 }, mem(normal)] <- graph_csr_undirected@neighbors(c, 1);
                _: int64 <- live_trial_i64@put("neighbors_1", live_trial_i64@view_code(n1));
                n2: List[{ to: int64, data: int64 }, mem(normal)] <- graph_csr_undirected@neighbors(c, 2);
                _: int64 <- live_trial_i64@put("neighbors_2", live_trial_i64@view_code(n2));
                n3: List[{ to: int64, data: int64 }, mem(normal)] <- graph_csr_undirected@neighbors(c, 3);
                _: int64 <- live_trial_i64@put("neighbors_3", live_trial_i64@view_code(n3));
                _: int64 <- live_trial_i64@put("degree_1", graph_csr_undirected@degree(c, 1));
                _: int64 <- live_trial_i64@put("degree_2", graph_csr_undirected@degree(c, 2));
                _: int64 <- live_trial_i64@put("degree_3", graph_csr_undirected@degree(c, 3));
                _: int64 <- live_trial_i64@put("entry_count_3", graph_csr_undirected@neighbor_entry_count(c, 3));
                _: int64 <- live_trial_i64@put("has_3_2", live_trial_i64@b2i(graph_csr_undirected@has_edge(c, 3, 2)));
                _: int64 <- live_trial_i64@put("has_1_3", live_trial_i64@b2i(graph_csr_undirected@has_edge(c, 1, 3)));
                f: int64 <- graph_csr_undirected@fold_edges(c, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", f);
                fd: int64 <- graph_csr_undirected@fold_neighbors(c, 0, data_step, 2);
                _: int64 <- live_trial_i64@put("fold_neighbors_2", fd);
                v36: { to: int64, data: int64 } <- { to: 3, data: 6 };
                t: int64 <- graph_csr_undirected@edge_target(c, v36);
                _: int64 <- live_trial_i64@put("edge_target_36", t);
                _: int64 <- live_trial_i64@put("connected_1_3", live_trial_i64@b2i(graph_csr_undirected@connected(c, 1, 3)));
                _: int64 <- live_trial_i64@put("connected_1_4", live_trial_i64@b2i(graph_csr_undirected@connected(c, 1, 4)));
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_undirected@validate(c);
                _: int64 <- live_trial_i64@put("valid", graph_csr_undirected@validate_error_code(v.error) * 1000 + v.logical_count);
                z0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, unit, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- unit_source();
                z: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, unit, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_csr_undirected@freeze_from_wbt(z0);
                _: int64 <- live_trial_i64@put("unit_edges", graph_csr_undirected@edge_count(z));
                _: int64 <- live_trial_i64@put("unit_degree_20", graph_csr_undirected@degree(z, 20));
                _: int64 <- live_trial_i64@put("unit_has_20_10", live_trial_i64@b2i(graph_csr_undirected@has_edge(z, 20, 10)));
                zv: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_undirected@validate(z);
                _: int64 <- live_trial_i64@put("unit_valid", graph_csr_undirected@validate_error_code(zv.error) * 1000 + zv.logical_count)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
