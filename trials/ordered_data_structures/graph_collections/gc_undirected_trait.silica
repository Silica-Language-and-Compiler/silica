// undirected_graph_trait.md §3, §6, §8, §9 through the UndirectedGraph trait on graph_wbt_undirected
// (gc_undirected_trait_weighted covers graph_weighted_undirected), bound with the inline record type
// (a bracket-typed UndirectedGraph[...] receiver dispatches to its own representation:
// trials/traits_addition/bracket_receiver_dispatch_by_representation and, with further arguments,
// bracket_receiver_arguments in this directory). Every trait
// method: counts, has_vertex, {to, data} neighbors (view_code: to*100+data), fold_neighbors, the
// captured comparators, edge_target on a view, degree (a self-loop counts twice), has_edge in both
// orientations, connected; and a degree-sum algorithm written once over the trait (sum of degrees
// is twice the edge count).

use graph_wbt_undirected;
use UndirectedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn triples() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 5, 2, 3, 6, 3, 3, 7]
    produces
        pure xs
    end
}

fn ids3() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3]
    produces
        pure xs
    end
}

fn data_step(acc: int64, w: { to: int64, data: int64 }) -> int64 {
    acc + w.data
}

// Written once over the trait: the sum of degrees of the listed vertices.
fn degree_sum(g: UndirectedGraph, xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> {
            d: int64 <- UndirectedGraph@degree(g, xs.head);
            degree_sum(g, xs.tail, acc + d)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                u0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_wbt_undirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_i64 });
                e_nodes: int64 <- UndirectedGraph@node_count(u0);
                _: int64 <- live_trial_i64@put("empty_nodes", e_nodes);
                e_edges: int64 <- UndirectedGraph@edge_count(u0);
                _: int64 <- live_trial_i64@put("empty_edges", e_edges);
                _: int64 <- live_trial_i64@put("empty_degree_1", UndirectedGraph@degree(u0, 1));
                _: int64 <- live_trial_i64@put("empty_connected_1_1", live_trial_i64@b2i(UndirectedGraph@connected(u0, 1, 1)));
                u: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u_triples(u0, triples());
                _: int64 <- live_trial_i64@put("nodes", UndirectedGraph@node_count(u));
                _: int64 <- live_trial_i64@put("edges", UndirectedGraph@edge_count(u));
                _: int64 <- live_trial_i64@put("has_vertex_3", live_trial_i64@b2i(UndirectedGraph@has_vertex(u, 3)));
                n2: List[{ to: int64, data: int64 }, mem(normal)] <- UndirectedGraph@neighbors(u, 2);
                _: int64 <- live_trial_i64@put("neighbors_2", live_trial_i64@view_code(n2));
                f2: int64 <- UndirectedGraph@fold_neighbors(u, 2, 0, data_step);
                _: int64 <- live_trial_i64@put("fold_neighbors_2", f2);
                _: int64 <- live_trial_i64@put("compare_node_1_2", live_trial_i64@cmp_code(UndirectedGraph@compare_node(u, 1, 2)));
                _: int64 <- live_trial_i64@put("compare_edge_data_6_5", live_trial_i64@cmp_code(UndirectedGraph@compare_edge_data(u, 6, 5)));
                v36: { to: int64, data: int64 } <- { to: 3, data: 6 };
                t: int64 <- UndirectedGraph@edge_target(u, v36);
                _: int64 <- live_trial_i64@put("edge_target_36", t);
                _: int64 <- live_trial_i64@put("degree_1", UndirectedGraph@degree(u, 1));
                _: int64 <- live_trial_i64@put("degree_3", UndirectedGraph@degree(u, 3));
                _: int64 <- live_trial_i64@put("has_edge_3_2", live_trial_i64@b2i(UndirectedGraph@has_edge(u, 3, 2)));
                _: int64 <- live_trial_i64@put("has_edge_1_3", live_trial_i64@b2i(UndirectedGraph@has_edge(u, 1, 3)));
                _: int64 <- live_trial_i64@put("connected_1_3", live_trial_i64@b2i(UndirectedGraph@connected(u, 1, 3)));
                _: int64 <- live_trial_i64@put("connected_1_9", live_trial_i64@b2i(UndirectedGraph@connected(u, 1, 9)));
                _: int64 <- live_trial_i64@put("algo_degree_sum", degree_sum(u, ids3(), 0))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
