// directed_graph_trait.md §3, §6, §8 through the DirectedGraph trait on the live representation
// (graph_wbt_directed): every trait method on the empty graph and on an updated graph (inline
// record type: a DirectedGraph[...]-typed value is rejected by trait calls, E2003,
// graph_bracket_receiver (this directory)) — counts, has_vertex, neighbors in
// ascending target order, fold_neighbors (design argument order id, init, step), the captured
// comparators and extractor, out_degree, has_edge, reachable — and algorithms written once over the
// trait (trait-typed parameters) that only call trait methods. (A List-returning trait method
// called on a trait-typed parameter is rejected, E2003:
// trait_placeholder_return (this directory).)

use graph_wbt_directed;
use DirectedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident(x: int64) -> int64 {
    x
}

fn pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 1, 3, 2, 3, 3, 1, 4, 4]
    produces
        pure xs
    end
}

fn ids() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3, 4, 9]
    produces
        pure xs
    end
}

fn sum_step(acc: int64, e: int64) -> int64 {
    acc + e
}

// Written once over the trait: sum of out-degrees of the listed vertices.
fn total_out_degree(g: DirectedGraph, xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> {
            d: int64 <- DirectedGraph@out_degree(g, xs.head);
            total_out_degree(g, xs.tail, acc + d)
        }
    }
}

// Written once over the trait: how many listed vertices are reachable from `from`.
fn reach_count(g: DirectedGraph, from: int64, xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> {
            r: boolean <- DirectedGraph@reachable(g, from, xs.head);
            reach_count(g, from, xs.tail, acc + live_trial_i64@b2i(r))
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_wbt_directed@empty({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident });
                e_nodes: int64 <- DirectedGraph@node_count(g0);
                _: int64 <- live_trial_i64@put("empty_nodes", e_nodes);
                e_has: boolean <- DirectedGraph@has_vertex(g0, 1);
                _: int64 <- live_trial_i64@put("empty_has_vertex_1", live_trial_i64@b2i(e_has));
                e_out: int64 <- DirectedGraph@out_degree(g0, 1);
                _: int64 <- live_trial_i64@put("empty_out_degree_1", e_out);
                e_reach: boolean <- DirectedGraph@reachable(g0, 1, 1);
                _: int64 <- live_trial_i64@put("empty_reachable_1_1", live_trial_i64@b2i(e_reach));
                g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(g0, pairs());
                _: int64 <- live_trial_i64@put("nodes", DirectedGraph@node_count(g));
                _: int64 <- live_trial_i64@put("edges", DirectedGraph@edge_count(g));
                _: int64 <- live_trial_i64@put("has_vertex_4", live_trial_i64@b2i(DirectedGraph@has_vertex(g, 4)));
                _: int64 <- live_trial_i64@put("has_vertex_9", live_trial_i64@b2i(DirectedGraph@has_vertex(g, 9)));
                n1: List[int64, mem(normal)] <- DirectedGraph@neighbors(g, 1);
                _: int64 <- live_trial_i64@put("neighbors_1", live_trial_i64@list_code(n1));
                f1: int64 <- DirectedGraph@fold_neighbors(g, 1, 0, sum_step);
                _: int64 <- live_trial_i64@put("fold_neighbors_1", f1);
                _: int64 <- live_trial_i64@put("compare_node_2_1", live_trial_i64@cmp_code(DirectedGraph@compare_node(g, 2, 1)));
                _: int64 <- live_trial_i64@put("compare_edge_5_5", live_trial_i64@cmp_code(DirectedGraph@compare_edge(g, 5, 5)));
                t7: int64 <- DirectedGraph@edge_target(g, 7);
                _: int64 <- live_trial_i64@put("edge_target_7", t7);
                _: int64 <- live_trial_i64@put("out_degree_1", DirectedGraph@out_degree(g, 1));
                _: int64 <- live_trial_i64@put("out_degree_4", DirectedGraph@out_degree(g, 4));
                _: int64 <- live_trial_i64@put("out_degree_9", DirectedGraph@out_degree(g, 9));
                _: int64 <- live_trial_i64@put("has_edge_3_1", live_trial_i64@b2i(DirectedGraph@has_edge(g, 3, 1)));
                _: int64 <- live_trial_i64@put("has_edge_1_4", live_trial_i64@b2i(DirectedGraph@has_edge(g, 1, 4)));
                _: int64 <- live_trial_i64@put("reachable_2_1", live_trial_i64@b2i(DirectedGraph@reachable(g, 2, 1)));
                _: int64 <- live_trial_i64@put("reachable_1_4", live_trial_i64@b2i(DirectedGraph@reachable(g, 1, 4)));
                _: int64 <- live_trial_i64@put("reachable_4_4", live_trial_i64@b2i(DirectedGraph@reachable(g, 4, 4)));
                _: int64 <- live_trial_i64@put("algo_total_out_degree", total_out_degree(g, ids(), 0));
                _: int64 <- live_trial_i64@put("algo_reach_count_from_1", reach_count(g, 1, ids(), 0))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
