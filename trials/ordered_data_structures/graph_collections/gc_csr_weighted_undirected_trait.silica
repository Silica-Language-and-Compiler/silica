// undirected_graph_trait.md §3 and weighted_graph_trait.md §4 through the UndirectedGraph and
// WeightedGraph traits on a CSR snapshot of a weighted undirected graph
// (graph_csr_weighted_undirected), the graph of gc_undirected_trait_weighted frozen: counts,
// has_vertex, the captured comparators, connected, degree (the loop counts twice), has_edge.
// (Placeholder-result methods: the trait headers.)
// Algorithms written once over a trait are exercised in the live trait trials; a function with a
// trait-typed parameter is copied once per implementation and each call selects its copy
// (trials/traits_addition/trait_param_dispatch_per_impl).

use graph_csr_weighted_undirected;
use UndirectedGraph;
use WeightedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                x0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@new_wu();
                x1: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@add_wu(x0, 1, 2, 4);
                x: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@add_wu(x1, 2, 2, 1);
                c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- graph_csr_weighted_undirected@freeze_from_wbt(x);
                _: int64 <- live_trial_i64@put("weighted_nodes", UndirectedGraph@node_count(c));
                _: int64 <- live_trial_i64@put("weighted_edges", UndirectedGraph@edge_count(c));
                _: int64 <- live_trial_i64@put("weighted_has_vertex_3", live_trial_i64@b2i(UndirectedGraph@has_vertex(c, 3)));
                _: int64 <- live_trial_i64@put("weighted_compare_edge_data_4_1", live_trial_i64@cmp_code(UndirectedGraph@compare_edge_data(c, 4, 1)));
                _: int64 <- live_trial_i64@put("weighted_connected_1_2", live_trial_i64@b2i(UndirectedGraph@connected(c, 1, 2)));
                _: int64 <- live_trial_i64@put("weighted_degree_2", UndirectedGraph@degree(c, 2));
                _: int64 <- live_trial_i64@put("weighted_has_edge_2_1", live_trial_i64@b2i(UndirectedGraph@has_edge(c, 2, 1)));
                _: int64 <- live_trial_i64@put("u_compare_weight_2_10", live_trial_i64@cmp_code(WeightedGraph@compare_weight(c, 2, 10)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
