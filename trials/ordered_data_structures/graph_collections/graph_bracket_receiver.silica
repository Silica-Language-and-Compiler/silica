// directed_graph_trait.md §3, §11: a value bound with `DirectedGraph[N, P, mem(S)]` from its
// registered constructor is the constructor's concrete record, so trait calls take it as the
// receiver. The bracket-to-record fit reads the record's edge_target witness, whose generated
// spelling `fn(ValueType) -> KeyType` witnesses any concrete pair (common_contract.md §1).
// Expected: 3, exit 0.

use StubGraphDirected;
use ProbeDirected;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident(x: int64) -> int64 {
    x
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                g: DirectedGraph[int64, int64, mem(normal)] <- StubGraphDirected@empty({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident });
                n: int64 <- ProbeDirected@count(g);
                print_int64(n);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
