    ; required_fn edge_weight g|data WeightedGraph|ValueType -> ItemType []
    ; required_fn compare_edge_data g|a|b WeightedGraph|ValueType|ValueType -> :less | :equal | :greater []
    ; required_fn compare_weight g|a|b WeightedGraph|ItemType|ItemType -> :less | :equal | :greater []
    ; required_fn weighted_neighbors g|id WeightedGraph|KeyType -> List [ { to : KeyType , data : ValueType } , mem ( normal ) ] []
    ; required_fn fold_weighted_neighbors g|id|init|step WeightedGraph|KeyType|AccType|fn ( AccType , { to : KeyType , data : ValueType } ) -> AccType -> AccType []
