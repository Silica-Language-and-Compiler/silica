// undirected_graph_trait.md §3, §10 and csr_graph_snapshot.md §7–§8 through the UndirectedGraph trait
// on a CSR snapshot (graph_csr_undirected): the graph of gc_undirected_trait, frozen, answers the
// receiver-dispatched methods identically — counts, has_vertex, the captured comparators, degree (a
// self-loop counts twice), has_edge in both orientations, connected. (neighbors / fold_neighbors /
// edge_target dispatch to this representation's own implementation.)
// Algorithms written once over a trait are exercised in the live trait trials; a function with a
// trait-typed parameter is copied once per implementation and each call selects its copy
// (trials/traits_addition/trait_param_dispatch_per_impl).

use graph_csr_undirected;
use UndirectedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn triples() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 5, 2, 3, 6, 3, 3, 7]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                u0: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@new_u();
                c0: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_csr_undirected@freeze_from_wbt(u0);
                _: int64 <- live_trial_i64@put("empty_nodes", UndirectedGraph@node_count(c0));
                _: int64 <- live_trial_i64@put("empty_edges", UndirectedGraph@edge_count(c0));
                _: int64 <- live_trial_i64@put("empty_degree_1", UndirectedGraph@degree(c0, 1));
                _: int64 <- live_trial_i64@put("empty_connected_1_1", live_trial_i64@b2i(UndirectedGraph@connected(c0, 1, 1)));
                u: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u_triples(u0, triples());
                c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_csr_undirected@freeze_from_wbt(u);
                _: int64 <- live_trial_i64@put("nodes", UndirectedGraph@node_count(c));
                _: int64 <- live_trial_i64@put("edges", UndirectedGraph@edge_count(c));
                _: int64 <- live_trial_i64@put("has_vertex_3", live_trial_i64@b2i(UndirectedGraph@has_vertex(c, 3)));
                _: int64 <- live_trial_i64@put("compare_node_1_2", live_trial_i64@cmp_code(UndirectedGraph@compare_node(c, 1, 2)));
                _: int64 <- live_trial_i64@put("compare_edge_data_6_5", live_trial_i64@cmp_code(UndirectedGraph@compare_edge_data(c, 6, 5)));
                _: int64 <- live_trial_i64@put("degree_1", UndirectedGraph@degree(c, 1));
                _: int64 <- live_trial_i64@put("degree_3", UndirectedGraph@degree(c, 3));
                _: int64 <- live_trial_i64@put("has_edge_3_2", live_trial_i64@b2i(UndirectedGraph@has_edge(c, 3, 2)));
                _: int64 <- live_trial_i64@put("has_edge_1_3", live_trial_i64@b2i(UndirectedGraph@has_edge(c, 1, 3)));
                _: int64 <- live_trial_i64@put("connected_1_3", live_trial_i64@b2i(UndirectedGraph@connected(c, 1, 3)));
                _: int64 <- live_trial_i64@put("connected_1_9", live_trial_i64@b2i(UndirectedGraph@connected(c, 1, 9)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
