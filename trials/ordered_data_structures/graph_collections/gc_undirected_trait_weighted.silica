// undirected_graph_trait.md §3, §6, §8, §9 through the UndirectedGraph trait on
// graph_weighted_undirected (the weighted undirected representation), bound with its inline record
// type: counts, has_vertex, the captured edge-data comparator, connected, degree (the loop counts
// twice) and has_edge. neighbors / fold_neighbors / edge_target are not called here: they are covered
// on this representation by its module trials (a placeholder-result trait method now dispatches by
// the receiver's representation; trials/traits_addition/trait_placeholder_result_dispatch).
// Algorithms written once over a trait are exercised in the live trait trials; a function with a
// trait-typed parameter is copied once per implementation and each call selects its copy
// (trials/traits_addition/trait_param_dispatch_per_impl).

use graph_weighted_undirected;
use UndirectedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                x0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@new_wu();
                x1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@add_wu(x0, 1, 2, 4);
                x: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- live_trial_i64@add_wu(x1, 2, 2, 1);
                _: int64 <- live_trial_i64@put("weighted_nodes", UndirectedGraph@node_count(x));
                _: int64 <- live_trial_i64@put("weighted_edges", UndirectedGraph@edge_count(x));
                _: int64 <- live_trial_i64@put("weighted_has_vertex_3", live_trial_i64@b2i(UndirectedGraph@has_vertex(x, 3)));
                _: int64 <- live_trial_i64@put("weighted_compare_edge_data_4_1", live_trial_i64@cmp_code(UndirectedGraph@compare_edge_data(x, 4, 1)));
                _: int64 <- live_trial_i64@put("weighted_connected_1_2", live_trial_i64@b2i(UndirectedGraph@connected(x, 1, 2)));
                _: int64 <- live_trial_i64@put("weighted_degree_2", UndirectedGraph@degree(x, 2));
                _: int64 <- live_trial_i64@put("weighted_has_edge_2_1", live_trial_i64@b2i(UndirectedGraph@has_edge(x, 2, 1)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
