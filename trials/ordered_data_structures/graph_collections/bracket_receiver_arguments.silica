// undirected_graph_trait.md §13: a value bound with `UndirectedGraph[N, E, mem(S)]` dispatches to
// the implementation of its own representation — the record its registered constructor returns —
// even when a second implementation carries the same comparator witnesses, and even when the method
// takes further arguments whose types are placeholders (`id: KeyType`).
// Expected: 5 (the stub record's count), exit 0.

use StubGraphUndirected;
use PlusGraph;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                g: UndirectedGraph[int64, int64, mem(normal)] <- StubGraphUndirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_i64 });
                n: int64 <- PlusGraph@count_at(g, 2);
                print_int64(n);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
