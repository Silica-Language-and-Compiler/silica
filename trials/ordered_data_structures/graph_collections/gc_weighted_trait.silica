// weighted_graph_trait.md §4, §5, §8 through the WeightedGraph trait on graph_weighted (the weighted
// directed representation; gc_weighted_trait_undirected covers graph_weighted_undirected; inline
// record receivers; a WeightedGraph[...]-typed value is rejected by trait
// calls, E2003, graph_bracket_receiver (this directory)): edge_weight (twice),
// compare_edge_data, compare_weight, weighted neighbors in target order (view_code), the weighted
// fold, weight_of with :found / placeholder :not_found (status 1/0), and a weight-counting algorithm
// written once over the trait.

use graph_weighted;
use WeightedGraph;
use live_trial_i64;
use trial_support_int64;

// First function of the unit: it lists :less, :equal, :greater in that order, so this unit numbers
// the comparator atoms as the graph modules do (atoms are numbered per compilation unit).
fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn data_step(acc: int64, w: { to: int64, data: int64 }) -> int64 {
    acc + w.data
}

fn status_code(r: { status: :not_found | :found, weight: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

// Written once over the trait: how many listed weights compare :greater than limit under the
// graph's captured weight comparator. (A trait method whose result mentions a placeholder — such as
// edge_weight or weighted_neighbors — called on a trait-typed parameter is rejected, E2003:
// trait_placeholder_return (this directory).)
fn count_heavier(g: WeightedGraph, ws: List[int64, mem(normal)], limit: int64, acc: int64) -> int64 {
    case ws.is_nil of {
        true -> acc;
        false -> {
            c: :less | :equal | :greater <- WeightedGraph@compare_weight(g, ws.head, limit);
            case c of {
                :greater -> count_heavier(g, ws.tail, limit, acc + 1);
                _: atom -> count_heavier(g, ws.tail, limit, acc)
            }
        }
    }
}

fn weights() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [4, 10, 18, 2]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                w0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@new_wd();
                w1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@add_wd(w0, 1, 2, 5);
                w2: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@add_wd(w1, 1, 3, 2);
                w: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- live_trial_i64@add_wd(w2, 3, 1, 9);
                ew: int64 <- WeightedGraph@edge_weight(w, 4);
                _: int64 <- live_trial_i64@put("edge_weight_4", ew);
                _: int64 <- live_trial_i64@put("compare_edge_data_2_5", live_trial_i64@cmp_code(WeightedGraph@compare_edge_data(w, 2, 5)));
                _: int64 <- live_trial_i64@put("compare_weight_10_4", live_trial_i64@cmp_code(WeightedGraph@compare_weight(w, 10, 4)));
                wn: List[{ to: int64, data: int64 }, mem(normal)] <- WeightedGraph@weighted_neighbors(w, 1);
                _: int64 <- live_trial_i64@put("weighted_neighbors_1", live_trial_i64@view_code(wn));
                fw: int64 <- WeightedGraph@fold_weighted_neighbors(w, 1, 0, data_step);
                _: int64 <- live_trial_i64@put("fold_weighted_neighbors_1", fw);
                a: { status: :not_found | :found, weight: int64 } <- WeightedGraph@weight_of(w, 1, 3, 0);
                _: int64 <- live_trial_i64@put("weight_of_1_3", a.weight);
                b: { status: :not_found | :found, weight: int64 } <- WeightedGraph@weight_of(w, 3, 1, 0);
                _: int64 <- live_trial_i64@put("weight_of_3_1", b.weight);
                c: { status: :not_found | :found, weight: int64 } <- WeightedGraph@weight_of(w, 2, 1, 99);
                _: int64 <- live_trial_i64@put("weight_of_2_1_status", status_code(c));
                _: int64 <- live_trial_i64@put("weight_of_2_1", c.weight);
                _: int64 <- live_trial_i64@put("algo_heavier_than_5", count_heavier(w, weights(), 5, 0))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
