// directed_graph_trait.md §3, §7 and csr_graph_snapshot.md §8 through the DirectedGraph trait on a
// CSR snapshot (graph_csr_directed): the graph of gc_directed_trait, frozen, answers every
// receiver-dispatched method identically — counts, has_vertex, the captured comparators, out_degree,
// has_edge, reachable. neighbors / fold_neighbors / edge_target reach the last implementation through
// the trait dispatch to graph_csr_directed's own implementation (trait_placeholder_result_dispatch);
// the snapshot's own functions are exercised in graph_csr_core.
// Algorithms written once over a trait are exercised in the live trait trials; a function with a
// trait-typed parameter is copied once per implementation and each call selects its copy
// (trials/traits_addition/trait_param_dispatch_per_impl).

use graph_csr_directed;
use DirectedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 1, 3, 2, 3, 3, 1, 4, 4]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@new_d();
                c0: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(e);
                _: int64 <- live_trial_i64@put("empty_nodes", DirectedGraph@node_count(c0));
                _: int64 <- live_trial_i64@put("empty_has_vertex_1", live_trial_i64@b2i(DirectedGraph@has_vertex(c0, 1)));
                _: int64 <- live_trial_i64@put("empty_out_degree_1", DirectedGraph@out_degree(c0, 1));
                _: int64 <- live_trial_i64@put("empty_reachable_1_1", live_trial_i64@b2i(DirectedGraph@reachable(c0, 1, 1)));
                g: { root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d_pairs(e, pairs());
                c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(g);
                _: int64 <- live_trial_i64@put("nodes", DirectedGraph@node_count(c));
                _: int64 <- live_trial_i64@put("edges", DirectedGraph@edge_count(c));
                _: int64 <- live_trial_i64@put("has_vertex_4", live_trial_i64@b2i(DirectedGraph@has_vertex(c, 4)));
                _: int64 <- live_trial_i64@put("has_vertex_9", live_trial_i64@b2i(DirectedGraph@has_vertex(c, 9)));
                _: int64 <- live_trial_i64@put("compare_node_2_1", live_trial_i64@cmp_code(DirectedGraph@compare_node(c, 2, 1)));
                _: int64 <- live_trial_i64@put("compare_edge_5_5", live_trial_i64@cmp_code(DirectedGraph@compare_edge(c, 5, 5)));
                _: int64 <- live_trial_i64@put("out_degree_1", DirectedGraph@out_degree(c, 1));
                _: int64 <- live_trial_i64@put("out_degree_4", DirectedGraph@out_degree(c, 4));
                _: int64 <- live_trial_i64@put("out_degree_9", DirectedGraph@out_degree(c, 9));
                _: int64 <- live_trial_i64@put("has_edge_3_1", live_trial_i64@b2i(DirectedGraph@has_edge(c, 3, 1)));
                _: int64 <- live_trial_i64@put("has_edge_1_4", live_trial_i64@b2i(DirectedGraph@has_edge(c, 1, 4)));
                _: int64 <- live_trial_i64@put("reachable_2_1", live_trial_i64@b2i(DirectedGraph@reachable(c, 2, 1)));
                _: int64 <- live_trial_i64@put("reachable_1_4", live_trial_i64@b2i(DirectedGraph@reachable(c, 1, 4)));
                _: int64 <- live_trial_i64@put("reachable_4_4", live_trial_i64@b2i(DirectedGraph@reachable(c, 4, 4)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
