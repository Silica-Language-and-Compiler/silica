// directed_graph_trait.md §3, §7 and dense_matrix_graph.md §13 through the DirectedGraph trait on a
// dense graph (graph_dense_directed): the graph of gc_directed_trait over the universe {1, 2, 3, 4}
// answers every receiver-dispatched method identically — counts, has_vertex, the captured
// comparators, out_degree, has_edge, reachable (the empty universe answers like the empty live
// graph). neighbors / fold_neighbors / edge_target reach the last implementation through the trait
// (DirectedGraph header deviation 7); the dense module's own functions are exercised in
// graph_dense_core.
// Algorithms written once over a trait are exercised in the live trait trials; a function with a
// trait-typed parameter is copied once per implementation and each call selects its copy
// (trials/traits_addition/trait_param_dispatch_per_impl).

use graph_dense_directed;
use DirectedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident(x: int64) -> int64 {
    x
}

fn universe(n: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- case n <= 0 of {
            true -> empty[int64, mem(normal)]();
            false -> prepend[int64, mem(normal)](1, shift(universe(n - 1)))
        }
    produces
        pure out
    end
}

// Adds 1 to every element (universe(n) = [1, ..., n]).
fn shift(xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- case xs.is_nil of {
            true -> xs;
            false -> prepend[int64, mem(normal)](xs.head + 1, shift(xs.tail))
        }
    produces
        pure out
    end
}

fn pairs() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 1, 3, 2, 3, 3, 1, 4, 4]
    produces
        pure xs
    end
}

fn add_pairs(g: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, xs: List[int64, mem(normal)]) -> { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    case xs.is_nil of {
        true -> g;
        false -> {
            rest: List[int64, mem(normal)] <- xs.tail;
            r: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(g, xs.head, rest.head);
            add_pairs(r.graph, rest.tail)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                c0: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_dense_directed@empty_for_nodes({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident }, universe(0));
                _: int64 <- live_trial_i64@put("empty_nodes", DirectedGraph@node_count(c0));
                _: int64 <- live_trial_i64@put("empty_has_vertex_1", live_trial_i64@b2i(DirectedGraph@has_vertex(c0, 1)));
                _: int64 <- live_trial_i64@put("empty_out_degree_1", DirectedGraph@out_degree(c0, 1));
                _: int64 <- live_trial_i64@put("empty_reachable_1_1", live_trial_i64@b2i(DirectedGraph@reachable(c0, 1, 1)));
                c: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_pairs(graph_dense_directed@empty_for_nodes({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident }, universe(4)), pairs());
                _: int64 <- live_trial_i64@put("nodes", DirectedGraph@node_count(c));
                _: int64 <- live_trial_i64@put("edges", DirectedGraph@edge_count(c));
                _: int64 <- live_trial_i64@put("has_vertex_4", live_trial_i64@b2i(DirectedGraph@has_vertex(c, 4)));
                _: int64 <- live_trial_i64@put("has_vertex_9", live_trial_i64@b2i(DirectedGraph@has_vertex(c, 9)));
                _: int64 <- live_trial_i64@put("compare_node_2_1", live_trial_i64@cmp_code(DirectedGraph@compare_node(c, 2, 1)));
                _: int64 <- live_trial_i64@put("compare_edge_5_5", live_trial_i64@cmp_code(DirectedGraph@compare_edge(c, 5, 5)));
                _: int64 <- live_trial_i64@put("out_degree_1", DirectedGraph@out_degree(c, 1));
                _: int64 <- live_trial_i64@put("out_degree_4", DirectedGraph@out_degree(c, 4));
                _: int64 <- live_trial_i64@put("out_degree_9", DirectedGraph@out_degree(c, 9));
                _: int64 <- live_trial_i64@put("has_edge_3_1", live_trial_i64@b2i(DirectedGraph@has_edge(c, 3, 1)));
                _: int64 <- live_trial_i64@put("has_edge_1_4", live_trial_i64@b2i(DirectedGraph@has_edge(c, 1, 4)));
                _: int64 <- live_trial_i64@put("reachable_2_1", live_trial_i64@b2i(DirectedGraph@reachable(c, 2, 1)));
                _: int64 <- live_trial_i64@put("reachable_1_4", live_trial_i64@b2i(DirectedGraph@reachable(c, 1, 4)));
                _: int64 <- live_trial_i64@put("reachable_4_4", live_trial_i64@b2i(DirectedGraph@reachable(c, 4, 4)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
