// weighted_graph_trait.md §4, §9 through the WeightedGraph trait on a dense weighted directed graph
// (graph_dense_weighted) over {1, 2, 3}: the captured edge-data and weight comparators, as in
// gc_weighted_trait. (edge_weight / weighted_neighbors / fold_weighted_neighbors / weight_of:
// WeightedGraph header deviation 5; the dense module's own functions are exercised in graph_dense_core.)
// Algorithms written once over a trait are exercised in the live trait trials; a function with a
// trait-typed parameter is copied once per implementation and each call selects its copy
// (trials/traits_addition/trait_param_dispatch_per_impl).

use graph_dense_weighted;
use WeightedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn twice(x: int64) -> int64 {
    x * 2
}

fn universe3() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                w0: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- graph_dense_weighted@empty_for_nodes({ compare_node: cmp_i64, compare_edge_data: cmp_i64, edge_weight: twice, compare_weight: cmp_i64 }, universe3());
                w1: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_weighted@add_edge(w0, 1, 2, 5);
                w2: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_weighted@add_edge(w1.graph, 1, 3, 2);
                w3: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_weighted@add_edge(w2.graph, 3, 1, 9);
                c: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- w3.graph;
                _: int64 <- live_trial_i64@put("compare_edge_data_2_5", live_trial_i64@cmp_code(WeightedGraph@compare_edge_data(c, 2, 5)));
                _: int64 <- live_trial_i64@put("compare_weight_10_4", live_trial_i64@cmp_code(WeightedGraph@compare_weight(c, 10, 4)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
