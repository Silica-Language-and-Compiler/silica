// common_contract.md §1 overriding genericity rule through the graph traits: string vertex IDs and
// payloads through DirectedGraph, int64 vertices with string edge data through UndirectedGraph, and
// string vertices with int64 data and string weights through WeightedGraph. The placeholder types
// come only from the declared records and constructor functions.

use graph_wbt_directed;
use graph_wbt_undirected;
use graph_weighted;
use DirectedGraph;
use UndirectedGraph;
use WeightedGraph;
use live_trial_i64;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident_str(s: string) -> string {
    s
}

fn label(d: int64) -> string {
    case d < 5 of {
        true -> "light";
        false -> "heavy"
    }
}

fn join(xs: List[string, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> join(xs.tail, concat(concat(acc, ","), xs.head))
    }
}

fn join_data(xs: List[{ to: int64, data: string }, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: int64, data: string } <- xs.head;
            join_data(xs.tail, concat(concat(acc, ","), w.data))
        }
    }
}

fn join_targets(xs: List[{ to: string, data: int64 }, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: string, data: int64 } <- xs.head;
            join_targets(xs.tail, concat(concat(acc, ","), w.to))
        }
    }
}

fn say(label: string, s: string) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(" ");
        println(s)
    produces
        pure 0
    end
}

fn add_s(g: { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, from: string, to: string) -> { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    r: { graph: { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_directed@add_edge(g, from, to);
    r.graph
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                s0: { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_wbt_directed@empty({ compare_node: cmp_str, compare_edge: cmp_str, edge_target: ident_str });
                s1: { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_s(s0, "b", "c");
                s2: { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_s(s1, "a", "c");
                s3: { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_s(s2, "a", "b");
                sg: { root: ref?(L, normal, (string, ref?(L, normal, (string, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_s(s3, "c", "a");
                _: int64 <- live_trial_i64@put("str_edges", DirectedGraph@edge_count(sg));
                sa: List[string, mem(normal)] <- DirectedGraph@neighbors(sg, "a");
                _: int64 <- say("str_neighbors_a", join(sa, ""));
                tq: string <- DirectedGraph@edge_target(sg, "q");
                _: int64 <- say("str_edge_target_q", tq);
                _: int64 <- live_trial_i64@put("str_compare_node_b_a", live_trial_i64@cmp_code(DirectedGraph@compare_node(sg, "b", "a")));
                _: int64 <- live_trial_i64@put("str_has_edge_c_a", live_trial_i64@b2i(DirectedGraph@has_edge(sg, "c", "a")));
                _: int64 <- live_trial_i64@put("str_reachable_b_a", live_trial_i64@b2i(DirectedGraph@reachable(sg, "b", "a")));
                _: int64 <- live_trial_i64@put("str_out_degree_a", DirectedGraph@out_degree(sg, "a"));
                u0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_wbt_undirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_str });
                u1: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u0, 1, 2, "x");
                u2: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(u1.graph, 2, 3, "y");
                ug: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- u2.graph;
                n2: List[{ to: int64, data: string }, mem(normal)] <- UndirectedGraph@neighbors(ug, 2);
                _: int64 <- say("udata_neighbors_2", join_data(n2, ""));
                _: int64 <- live_trial_i64@put("udata_compare_edge_data_x_y", live_trial_i64@cmp_code(UndirectedGraph@compare_edge_data(ug, "x", "y")));
                _: int64 <- live_trial_i64@put("udata_degree_2", UndirectedGraph@degree(ug, 2));
                w0: { root: ref?(L, normal, (string, ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- graph_weighted@empty({ compare_node: cmp_str, compare_edge_data: cmp_i64, edge_weight: label, compare_weight: cmp_str });
                w1: { graph: { root: ref?(L, normal, (string, ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w0, "x", "y", 3);
                w2: { graph: { root: ref?(L, normal, (string, ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- graph_weighted@add_edge(w1.graph, "x", "z", 8);
                wg: { root: ref?(L, normal, (string, ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- w2.graph;
                wxy: { status: :not_found | :found, weight: string } <- WeightedGraph@weight_of(wg, "x", "y", "none");
                _: int64 <- say("wstr_weight_x_y", wxy.weight);
                wyx: { status: :not_found | :found, weight: string } <- WeightedGraph@weight_of(wg, "y", "x", "none");
                _: int64 <- say("wstr_weight_y_x", wyx.weight);
                e9: string <- WeightedGraph@edge_weight(wg, 9);
                _: int64 <- say("wstr_edge_weight_9", e9);
                _: int64 <- live_trial_i64@put("wstr_compare_weight_heavy_light", live_trial_i64@cmp_code(WeightedGraph@compare_weight(wg, "heavy", "light")));
                wn: List[{ to: string, data: int64 }, mem(normal)] <- WeightedGraph@weighted_neighbors(wg, "x");
                _: int64 <- say("wstr_weighted_neighbors_x", join_targets(wn, ""))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
