// undirected_graph_trait.md: an add_edge result bound with a record annotation whose field is the
// public bracket type `UndirectedGraph[string, int64, mem(normal)]` (the concrete record
// graph_wbt_undirected returns, common_contract.md §2).
// Expected: the edge between "Big Pool" and "Mud Hole" is new, r.inserted is true, exit 1.

use graph_wbt_undirected;
use trial_support_int64;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_counts(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g: UndirectedGraph[string, int64, mem(normal)] <- graph_wbt_undirected@empty({ compare_node: compare_names, compare_edge_data: compare_counts });
                r: { graph: UndirectedGraph[string, int64, mem(normal)], inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(g, "Big Pool", "Mud Hole", 4)
            produces
                pure case r.inserted of {
                    true -> 1;
                    false -> 0
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
