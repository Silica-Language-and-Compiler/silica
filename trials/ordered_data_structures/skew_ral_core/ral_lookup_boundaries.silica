// Layer 2 §15 step 5: lookup at first, middle, last, and invalid indexes for lengths 1..17,
// plus every index for each length (weight boundaries 1, 3, 7, 15 inclusive).

use skew_ral;
use ral_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn boundaries(n: int64) -> boolean {
    sequence
        s: {
            count: int64,
            reversed: boolean,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        } <- ral_trial_i64@seq_front(n);
        first_ok: boolean <- ral_trial_i64@lookup_is(s, 0, 0);
        mid_ok: boolean <- ral_trial_i64@lookup_is(s, n / 2, n / 2);
        last_ok: boolean <- ral_trial_i64@lookup_is(s, n - 1, n - 1);
        neg_ok: boolean <- ral_trial_i64@lookup_missing(s, -1);
        past_ok: boolean <- ral_trial_i64@lookup_missing(s, n);
        far_ok: boolean <- ral_trial_i64@lookup_missing(s, n + 1000);
        all_ok: boolean <- ral_trial_i64@indexes_match(s, n)
    produces
        pure first_ok and mid_ok and last_ok and neg_ok and past_ok and far_ok and all_ok
    end
}

fn lengths(n: int64, max: int64) -> boolean {
    case n > max of {
        true -> true;
        false -> case boundaries(n) of {
            false -> false;
            true -> lengths(n + 1, max)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: {
                    count: int64,
                    reversed: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                    region: region(L, normal),
                    specialization_key: int64
                } <- ral_trial_i64@new_front();
                empty_ok: boolean <- ral_trial_i64@lookup_missing(e, 0);
                all_ok: boolean <- lengths(1, 17)
            produces
                pure pick(empty_ok, 1, pick(all_ok, 2, 0))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
