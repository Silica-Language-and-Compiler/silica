// Layer 2 §15 step 9 (design §8): the reverse orientation appends in O(1) by prepending. The new
// item takes logical index `count`, existing logical indexes keep their values, get/set translate
// through physical_index = count - 1 - logical_index, and orientation :front declines append.

use skew_ral;
use ral_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

// Append i for i in [k, n); after each append logical indexes 0..i all still read their index.
fn grow(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        specialization_key: int64
    },
    k: int64,
    n: int64
) -> boolean {
    case k >= n of {
        true -> true;
        false -> grow_step(ral, k, n)
    }
}

fn grow_step(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        specialization_key: int64
    },
    k: int64,
    n: int64
) -> boolean {
    sequence
        app: :unchanged | (:appended, { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) <- skew_ral@append(ral, k);
        app_list: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 } <- case app of {
            :unchanged -> ral;
            (:appended, v_appended: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) -> v_appended
        };
        app_appended: boolean <- case app of {
            :unchanged -> false;
            (:appended, _v_appended: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) -> true
        };
        size_ok: boolean <- skew_ral@size(app_list) == k + 1;
        stable_ok: boolean <- ral_trial_i64@gets_match(app_list, k + 1);
        newest_physical: boolean <- ral_trial_i64@lookup_is(app_list, 0, k);
        mapping_ok: boolean <- skew_ral@logical_to_physical(app_list, 0) == k;
        old_stable: boolean <- ral_trial_i64@gets_match(ral, k)
    produces
        pure case app_appended and size_ok and stable_ok and newest_physical and mapping_ok and old_stable of {
            false -> false;
            true -> grow(app_list, k + 1, n)
        }
    end
}

fn set_logical() -> boolean {
    sequence
        r: {
            count: int64,
            reversed: boolean,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            specialization_key: int64
        } <- ral_trial_i64@seq_reverse(10);
        s: :unchanged | (:updated, { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) <- skew_ral@set(r, 3, 33);
        s_list: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 } <- case s of {
            :unchanged -> r;
            (:updated, v_updated: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) -> v_updated
        };
        s_updated: boolean <- case s of {
            :unchanged -> false;
            (:updated, _v_updated: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) -> true
        };
        got_new: boolean <- ral_trial_i64@get_is(s_list, 3, 33);
        got_phys: boolean <- ral_trial_i64@lookup_is(s_list, 6, 33);
        got_old: boolean <- ral_trial_i64@get_is(r, 3, 3);
        neighbours: boolean <- ral_trial_i64@get_is(s_list, 2, 2)
            and ral_trial_i64@get_is(s_list, 4, 4);
        bad_neg: boolean <- ral_trial_i64@get_missing(r, -1);
        bad_past: boolean <- ral_trial_i64@get_missing(r, 10);
        bad_set: :unchanged | (:updated, { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) <- skew_ral@set(r, 10, 99);
        bad_set_updated: boolean <- case bad_set of {
            :unchanged -> false;
            (:updated, _v_updated: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) -> true
        };
        bad_set_ok: boolean <- case bad_set_updated of {
            true -> false;
            false -> true
        };
        order_ok: boolean <- ral_trial_i64@hash_of(r) == ral_trial_i64@range_hash(0, 10);
        valid_ok: boolean <- ral_trial_i64@valid_with_count(s_list, 10)
    produces
        pure s_updated and got_new and got_phys and got_old and neighbours and bad_neg and bad_past
            and bad_set_ok and order_ok and valid_ok
    end
}

fn front_declines() -> boolean {
    sequence
        f: {
            count: int64,
            reversed: boolean,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            specialization_key: int64
        } <- ral_trial_i64@seq_front(4);
        app: :unchanged | (:appended, { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) <- skew_ral@append(f, 4);
        app_list: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 } <- case app of {
            :unchanged -> f;
            (:appended, v_appended: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) -> v_appended
        };
        app_appended: boolean <- case app of {
            :unchanged -> false;
            (:appended, _v_appended: { count: int64, reversed: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], specialization_key: int64 }) -> true
        };
        flag_ok: boolean <- case app_appended of {
            true -> false;
            false -> true
        };
        front_maps: boolean <- skew_ral@logical_to_physical(f, 2) == 2
    produces
        pure flag_ok and skew_ral@size(app_list) == 4 and front_maps and ral_trial_i64@gets_match(f, 4)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                grow_ok: boolean <- grow(ral_trial_i64@new_reverse(), 0, 20);
                set_ok: boolean <- set_logical();
                front_ok: boolean <- front_declines()
            produces
                pure pick(grow_ok, 1, pick(set_ok, 2, pick(front_ok, 3, 0)))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
