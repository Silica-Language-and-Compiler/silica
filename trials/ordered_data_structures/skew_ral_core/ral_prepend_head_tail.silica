// Layer 2 §15 steps 3–4: prepend/head/tail round trips for every length 0..20, crossing the
// skew weight boundaries 1, 3, 7, 15 (and the two-equal-digit states between them).
// Each tail exposes the next physical item; validation holds after every step.

use skew_ral;
use ral_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

// Peel k = 0 .. n - 1: head must be k and the remaining size n - k, valid throughout.
fn peel(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    k: int64,
    n: int64
) -> boolean {
    case k >= n of {
        true -> ral_trial_i64@head_missing(ral) and skew_ral@size(ral) == 0;
        false -> peel_step(ral, k, n)
    }
}

fn peel_step(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    k: int64,
    n: int64
) -> boolean {
    sequence
        head_ok: boolean <- ral_trial_i64@head_is(ral, k);
        size_ok: boolean <- skew_ral@size(ral) == n - k;
        valid_ok: boolean <- ral_trial_i64@valid_with_count(ral, n - k);
        rest: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            status: :not_found | :found
        } <- skew_ral@tail(ral);
        tail_ok: boolean <- case rest.status of {
            :found -> true;
            :not_found -> false
        }
    produces
        pure case head_ok and size_ok and valid_ok and tail_ok of {
            false -> false;
            true -> peel(rest.list, k + 1, n)
        }
    end
}

fn empty_tail_unchanged() -> boolean {
    sequence
        e: {
            count: int64,
            reversed: boolean,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        } <- ral_trial_i64@new_front();
        t: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            status: :not_found | :found
        } <- skew_ral@tail(e);
        status_ok: boolean <- case t.status of {
            :not_found -> true;
            :found -> false
        }
    produces
        pure status_ok and skew_ral@size(t.list) == 0 and ral_trial_i64@valid_with_count(t.list, 0)
    end
}

fn lengths(n: int64, max: int64) -> boolean {
    case n > max of {
        true -> true;
        false -> case peel(ral_trial_i64@seq_front(n), 0, n) of {
            false -> false;
            true -> lengths(n + 1, max)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                round_trips: boolean <- lengths(0, 20);
                empty_ok: boolean <- empty_tail_unchanged();
                order_ok: boolean <- ral_trial_i64@hash_of(ral_trial_i64@seq_front(20)) == ral_trial_i64@range_hash(0, 20)
            produces
                pure pick(round_trips, 1, pick(empty_ok, 2, pick(order_ok, 3, 0)))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
