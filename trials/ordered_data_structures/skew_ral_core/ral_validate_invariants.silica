// Layer 2 §15 step 10 (design §11–§12): malformed fixtures built directly against the
// representation hit each validation error in preorder; well-formed forests validate with the
// logical count. Error codes: 1 negative_count, 2 size_mismatch, 3 rank_violation,
// 4 missing_tree, 5 shape_violation, 6 wrong_arena, 7 repeated_child.
// Chunk 15 phase 2 (P7): ref_in_region is retired, the validator can no longer tell arenas apart
// (code 6 is never produced), so the arena case was removed; the main sequence now numbers its
// groups 1..6 (the last, repeated_child, was 7) and the exit value is 0 when every group passes.
// Chunk 15 phase 5 (5b): the fixtures are allocated with the region-less alloc_rec (design §8.1);
// no family arena is looked up and no region handle is threaded through the helpers.

use skew_ral;
use ral_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

// Allocators return the ref? alone: the cell is allocated in this frame and adopted by the caller.
fn cell(
    v: int64,
    left: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec((v, left, right))
    produces
        pure c
    end
}

fn leaf(v: int64) -> ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    cell(v, :none, :none)
}

fn no_digits() -> List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- empty[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]()
    produces
        pure out
    end
}

fn digit(
    w: int64,
    t: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    rest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] {
    sequence proc[mem(normal)]
        d: (int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- (w, t);
        out: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- prepend[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)](d, rest)
    produces
        pure out
    end
}

fn code_of(
    count: int64,
    forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> int64 {
    sequence
        ral: {
            count: int64,
            reversed: boolean,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            specialization_key: int64
        } <- {
            count: count,
            reversed: false,
            compare_item: cmp_i64,
            forest: forest,
            specialization_key: 0
        }
    produces
        pure ral_trial_i64@error_code_of(ral)
    end
}

fn valid_cases() -> boolean {
    sequence
        l1: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(1);
        l2: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(2);
        l11: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(11);
        l12: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(12);
        n3: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(10, l11, l12);
        l21: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(21);
        l22: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(22);
        n3b: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(20, l21, l22);
        ok0: boolean <- code_of(0, no_digits()) == 0;
        ok1: boolean <- code_of(1, digit(1, l1, no_digits())) == 0;
        ok2: boolean <- code_of(2, digit(1, l1, digit(1, l2, no_digits()))) == 0;
        ok4: boolean <- code_of(4, digit(1, l1, digit(3, n3, no_digits()))) == 0;
        ok6: boolean <- code_of(6, digit(3, n3, digit(3, n3b, no_digits()))) == 0
    produces
        pure ok0 and ok1 and ok2 and ok4 and ok6
    end
}

fn valid_ten() -> boolean {
    sequence
        l11: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(11);
        l12: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(12);
        n3: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(10, l11, l12);
        l32: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(32);
        l33: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(33);
        n31: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(31, l32, l33);
        l35: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(35);
        l36: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(36);
        n34: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(34, l35, l36);
        n7: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(30, n31, n34);
        ok10: boolean <- code_of(10, digit(3, n3, digit(7, n7, no_digits()))) == 0
    produces
        pure ok10
    end
}

fn count_cases() -> boolean {
    sequence
        l1: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(1);
        negative: boolean <- code_of(-1, no_digits()) == 1;
        size_short: boolean <- code_of(2, digit(1, l1, no_digits())) == 2;
        size_long: boolean <- code_of(0, digit(1, l1, no_digits())) == 2
    produces
        pure negative and size_short and size_long
    end
}

fn digit_cases() -> boolean {
    sequence
        l1: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(1);
        l2: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(2);
        l3: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(3);
        l11: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(11);
        l12: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(12);
        n3: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(10, l11, l12);
        l21: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(21);
        l22: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(22);
        n3b: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(20, l21, l22);
        bad_weight: boolean <- code_of(2, digit(2, l1, no_digits())) == 3;
        zero_weight: boolean <- code_of(0, digit(0, l1, no_digits())) == 3;
        dup_late: boolean <- code_of(7, digit(1, l1, digit(3, n3, digit(3, n3b, no_digits())))) == 3;
        decreasing: boolean <- code_of(4, digit(3, n3, digit(1, l1, no_digits()))) == 3;
        triple: boolean <- code_of(3, digit(1, l1, digit(1, l2, digit(1, l3, no_digits())))) == 3;
        missing: boolean <- code_of(1, digit(1, :none, no_digits())) == 4
    produces
        pure bad_weight and zero_weight and dup_late and decreasing and triple and missing
    end
}

fn shape_cases() -> boolean {
    sequence
        l1: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(1);
        l11: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(11);
        l12: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(12);
        n3: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(10, l11, l12);
        half: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(60, l1, :none);
        leaf_as_node: boolean <- code_of(3, digit(3, l1, no_digits())) == 5;
        node_as_leaf: boolean <- code_of(1, digit(1, n3, no_digits())) == 5;
        half_node: boolean <- code_of(3, digit(3, half, no_digits())) == 5
    produces
        pure leaf_as_node and node_as_leaf and half_node
    end
}

fn repeat_cases() -> boolean {
    sequence
        l1: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(1);
        l11: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(11);
        l12: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(12);
        n3: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(10, l11, l12);
        shared: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(40, l1, l1);
        deep_shared: ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(50, n3, n3);
        repeated: boolean <- code_of(3, digit(3, shared, no_digits())) == 7;
        repeated_deep: boolean <- code_of(7, digit(7, deep_shared, no_digits())) == 7;
        preorder_first: boolean <- code_of(5, digit(2, l1, digit(3, shared, no_digits()))) == 3
    produces
        pure repeated and repeated_deep and preorder_first
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                c1: boolean <- valid_cases();
                c2: boolean <- valid_ten();
                c3: boolean <- count_cases();
                c4: boolean <- digit_cases();
                c5: boolean <- shape_cases();
                c6: boolean <- repeat_cases()
            produces
                pure pick(c1, 1, pick(c2, 2, pick(c3, 3, pick(c4, 4, pick(c5, 5, pick(c6, 6, 0))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
