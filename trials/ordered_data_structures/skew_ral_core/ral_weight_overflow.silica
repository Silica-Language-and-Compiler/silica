// Layer 2 §15 (design §2, §9): skew weight arithmetic and overflow rejection before allocation.
// link_weight(2^62) would need 2^63 + 1 and must report overflow; count_preflight mirrors it.

use skew_ral_weights;
use skew_ral_validate;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn link_is(w: int64, expected: int64) -> boolean {
    pair: (boolean, int64) <- skew_ral_weights@link_weight(w);
    (ok: boolean, lw: int64) <- pair;
    ok and lw == expected
}

fn link_overflows(w: int64) -> boolean {
    pair: (boolean, int64) <- skew_ral_weights@link_weight(w);
    (ok: boolean, _: int64) <- pair;
    case ok of {
        true -> false;
        false -> true
    }
}

fn skew_is(w: int64, expected: boolean) -> boolean {
    skew_ral_weights@is_skew_weight(w) == expected
}

// count_preflight's atoms are decoded by the unit that creates them (atoms are numbered per unit).
fn preflight_code(n: int64) -> int64 {
    skew_ral_validate@validate_error_code(skew_ral_validate@count_preflight(n))
}

fn preflight_is(n: int64, expected: int64) -> boolean {
    preflight_code(n) == expected
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                links: boolean <- link_is(1, 3) and link_is(3, 7) and link_is(7, 15) and link_is(15, 31)
                    and link_is(4611686018427387903, 9223372036854775807);
                overflow: boolean <- link_overflows(4611686018427387904) and link_overflows(9223372036854775807);
                children: boolean <- skew_ral_weights@child_weight(3) == 1 and skew_ral_weights@child_weight(7) == 3
                    and skew_ral_weights@child_weight(15) == 7 and skew_ral_weights@child_weight(1) == 0;
                skew_yes: boolean <- skew_is(1, true) and skew_is(3, true) and skew_is(7, true) and skew_is(15, true)
                    and skew_is(31, true) and skew_is(1023, true);
                skew_no: boolean <- skew_is(0, false) and skew_is(-1, false) and skew_is(2, false) and skew_is(4, false)
                    and skew_is(5, false) and skew_is(6, false) and skew_is(9, false) and skew_is(11, false);
                preflight: boolean <- preflight_is(0, 0) and preflight_is(5, 0) and preflight_is(-1, 1)
                    and preflight_is(4611686018427387903, 0) and preflight_is(4611686018427387904, 8)
            produces
                pure pick(links, 1, pick(overflow, 2, pick(children, 3, pick(skew_yes, 4, pick(skew_no, 5, pick(preflight, 6, 0))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
