// Layer 2 §15 step 6: persistent update at first, middle, last, and invalid indexes. The old
// sequence keeps every value; the new one differs only at the updated index; invalid indexes
// return the original value with updated = false.

use skew_ral;
use ral_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

// Every physical index other than `skip` still reads its own index.
fn others_intact(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    i: int64,
    n: int64,
    skip: int64
) -> boolean {
    case i >= n of {
        true -> true;
        false -> case i == skip of {
            true -> others_intact(ral, i + 1, n, skip);
            false -> case ral_trial_i64@lookup_is(ral, i, i) of {
                false -> false;
                true -> others_intact(ral, i + 1, n, skip)
            }
        }
    }
}

fn update_at(
    base: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    n: int64,
    i: int64
) -> boolean {
    sequence
        u: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            updated: boolean
        } <- skew_ral@update(base, i, 1000 + i);
        new_ok: boolean <- ral_trial_i64@lookup_is(u.list, i, 1000 + i);
        new_others: boolean <- others_intact(u.list, 0, n, i);
        new_size: boolean <- skew_ral@size(u.list) == n;
        new_valid: boolean <- ral_trial_i64@valid_with_count(u.list, n);
        old_ok: boolean <- ral_trial_i64@indexes_match(base, n);
        old_valid: boolean <- ral_trial_i64@valid_with_count(base, n)
    produces
        pure u.updated and new_ok and new_others and new_size and new_valid and old_ok and old_valid
    end
}

fn invalid_at(
    base: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    n: int64,
    i: int64
) -> boolean {
    sequence
        u: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            updated: boolean
        } <- skew_ral@update(base, i, 5555);
        unchanged: boolean <- ral_trial_i64@indexes_match(u.list, n);
        size_ok: boolean <- skew_ral@size(u.list) == n;
        flag_ok: boolean <- case u.updated of {
            true -> false;
            false -> true
        }
    produces
        pure unchanged and size_ok and flag_ok
    end
}

fn lengths(n: int64, max: int64) -> boolean {
    case n > max of {
        true -> true;
        false -> {
            base: {
                count: int64,
                reversed: boolean,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            } <- ral_trial_i64@seq_front(n);
            case update_at(base, n, 0) and update_at(base, n, n / 2) and update_at(base, n, n - 1) of {
                false -> false;
                true -> case invalid_at(base, n, -1) and invalid_at(base, n, n) of {
                    false -> false;
                    true -> lengths(n + 1, max)
                }
            }
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: {
                    count: int64,
                    reversed: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
                    region: region(L, normal),
                    specialization_key: int64
                } <- ral_trial_i64@new_front();
                empty_ok: boolean <- invalid_at(e, 0, 0);
                all_ok: boolean <- lengths(1, 17)
            produces
                pure pick(empty_ok, 1, pick(all_ok, 2, 0))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
