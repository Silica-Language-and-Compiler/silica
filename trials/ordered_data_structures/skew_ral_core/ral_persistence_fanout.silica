// Design §7 and common_contract.md §7: several versions derived from one base stay independent.
// Prepend, tail, and update each share every untouched tree with the base.

use skew_ral;
use ral_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                base: {
                    count: int64,
                    reversed: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                    region: region(L, normal),
                    specialization_key: int64
                } <- ral_trial_i64@seq_front(15);
                v1: {
                    count: int64,
                    reversed: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                    region: region(L, normal),
                    specialization_key: int64
                } <- skew_ral@prepend(base, 100);
                v2: {
                    count: int64,
                    reversed: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                    region: region(L, normal),
                    specialization_key: int64
                } <- skew_ral@prepend(base, 200);
                v3: {
                    list: {
                        count: int64,
                        reversed: boolean,
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                        region: region(L, normal),
                        specialization_key: int64
                    },
                    status: :not_found | :found
                } <- skew_ral@tail(base);
                v4: {
                    list: {
                        count: int64,
                        reversed: boolean,
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                        region: region(L, normal),
                        specialization_key: int64
                    },
                    updated: boolean
                } <- skew_ral@update(base, 7, 777);
                v5: {
                    list: {
                        count: int64,
                        reversed: boolean,
                        compare_item: fn(int64, int64) -> :less | :equal | :greater,
                        forest: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                        region: region(L, normal),
                        specialization_key: int64
                    },
                    updated: boolean
                } <- skew_ral@update(v1, 0, 111);
                base_ok: boolean <- ral_trial_i64@indexes_match(base, 15) and ral_trial_i64@valid_with_count(base, 15)
                    and ral_trial_i64@hash_of(base) == ral_trial_i64@range_hash(0, 15);
                v1_ok: boolean <- ral_trial_i64@lookup_is(v1, 0, 100)
                    and ral_trial_i64@lookup_is(v1, 8, 7) and ral_trial_i64@valid_with_count(v1, 16);
                v2_ok: boolean <- ral_trial_i64@lookup_is(v2, 0, 200)
                    and ral_trial_i64@lookup_is(v2, 15, 14) and ral_trial_i64@valid_with_count(v2, 16);
                v3_ok: boolean <- ral_trial_i64@lookup_is(v3.list, 0, 1)
                    and ral_trial_i64@hash_of(v3.list) == ral_trial_i64@range_hash(1, 15) and ral_trial_i64@valid_with_count(v3.list, 14);
                v4_ok: boolean <- v4.updated and ral_trial_i64@lookup_is(v4.list, 7, 777)
                    and ral_trial_i64@lookup_is(v4.list, 6, 6) and ral_trial_i64@valid_with_count(v4.list, 15);
                v5_ok: boolean <- v5.updated and ral_trial_i64@lookup_is(v5.list, 0, 111)
                    and ral_trial_i64@lookup_is(v1, 0, 100) and ral_trial_i64@valid_with_count(v5.list, 16);
                sums_ok: boolean <- ral_trial_i64@sum_of(base) == 105 and ral_trial_i64@sum_of(v1) == 205
                    and ral_trial_i64@sum_of(v2) == 305 and ral_trial_i64@sum_of(v3.list) == 105
                    and ral_trial_i64@sum_of(v4.list) == 875 and ral_trial_i64@sum_of(v5.list) == 216
            produces
                pure pick(base_ok, 1, pick(v1_ok, 2, pick(v2_ok, 3, pick(v3_ok, 4, pick(v4_ok, 5, pick(v5_ok, 6, pick(sums_ok, 7, 0)))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
