// Layer 2 §15 steps 1–2: empty representation, cell/digit encoding, canonical arena identity.
// Exit code names the first failed check; 0 = all checks pass.

use skew_ral;
use ral_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn arena_matches(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> boolean {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        key: int64 <- skew_ral@arena_key();
        expected: region(L, normal) <- canonical_arena_lookup(key);
        same: boolean <- canonical_arena_same(ral.region, expected)
    produces
        pure same
    end
}

fn is_front(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> boolean {
    case skew_ral@is_reversed(ral) of {
        false -> true;
        true -> false
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                e: {
                    count: int64,
                    reversed: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
                    region: region(L, normal),
                    specialization_key: int64
                } <- ral_trial_i64@new_front();
                e_size: boolean <- skew_ral@size(e) == 0;
                e_valid: boolean <- ral_trial_i64@valid_with_count(e, 0);
                e_head: boolean <- ral_trial_i64@head_missing(e);
                seven: {
                    count: int64,
                    reversed: boolean,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
                    region: region(L, normal),
                    specialization_key: int64
                } <- ral_trial_i64@seq_front(7);
                seven_size: boolean <- skew_ral@size(seven) == 7;
                seven_valid: boolean <- ral_trial_i64@valid_with_count(seven, 7);
                seven_order: boolean <- ral_trial_i64@hash_of(seven) == ral_trial_i64@range_hash(0, 7);
                seven_index: boolean <- ral_trial_i64@indexes_match(seven, 7);
                arena_ok: boolean <- arena_matches(seven);
                arena_e_ok: boolean <- arena_matches(e);
                orient_ok: boolean <- is_front(seven)
            produces
                pure pick(e_size, 1, pick(e_valid, 2, pick(e_head, 3, pick(seven_size, 4, pick(seven_valid, 5,
                    pick(seven_order, 6, pick(seven_index, 7, pick(arena_ok, 8, pick(arena_e_ok, 9, pick(orient_ok, 10, 0))))))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
