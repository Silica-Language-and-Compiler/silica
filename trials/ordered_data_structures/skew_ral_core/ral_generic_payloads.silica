// Overriding genericity rule (common_contract.md §1): ItemType is whatever the programmer declares.
// String payloads go through from_list/head/lookup/update/fold and validation; tuple payloads go
// through append/get/set/head and validation. Folding with a tuple-typed callback parameter is
// staged, not wired: the bootstrap emitter miscompiles `fn(int64, (int64, int64)) -> int64` even
// for a direct local call (`step(5, (3, 10))` yields 13), see staged trial
// tuple_param_after_scalar_callback.silica.

use skew_ral;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a == b of {
        true -> :equal;
        false -> :less
    }
}

fn cmp_pair(a: (int64, int64), b: (int64, int64)) -> :less | :equal | :greater {
    (a1: int64, _: int64) <- a;
    (b1: int64, _: int64) <- b;
    case a1 < b1 of {
        true -> :less;
        false -> case a1 == b1 of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn concat_step(acc: string, x: string) -> string {
    concat(acc, x)
}

fn string_is(res: { status: :not_found | :found, value: string }, expected: string) -> boolean {
    case res.status of {
        :found -> res.value == expected;
        :not_found -> false
    }
}

fn pair_is(res: { status: :not_found | :found, value: (int64, int64) }, a: int64, b: int64) -> boolean {
    case res.status of {
        :found -> {
            (got_a: int64, got_b: int64) <- res.value;
            got_a == a and got_b == b
        };
        :not_found -> false
    }
}

fn strings() -> boolean {
    sequence proc[mem(normal)]
        items: List[string, mem(normal)] <- ["a", "b", "c", "d", "e"];
        built: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            valid: boolean,
            error: atom
        } <- skew_ral@from_list({ compare_item: cmp_str }, false, items);
        joined: string <- skew_ral@fold_logical(built.list, "", concat_step);
        head_ok: boolean <- string_is(skew_ral@head(built.list, ""), "a");
        last_ok: boolean <- string_is(skew_ral@lookup(built.list, 4, ""), "e");
        u: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn(string, string) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            updated: boolean
        } <- skew_ral@update(built.list, 2, "zz");
        new_joined: string <- skew_ral@fold_logical(u.list, "", concat_step);
        v: { valid: boolean, error: atom, logical_count: int64 } <- skew_ral@validate(u.list)
    produces
        pure built.valid and joined == "abcde" and head_ok and last_ok and u.updated
            and new_joined == "abzzde" and v.valid and v.logical_count == 5
    end
}

fn pairs() -> boolean {
    sequence
        e: {
            count: int64,
            reversed: boolean,
            compare_item: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, ((int64, int64), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        } <- skew_ral@empty_ral({ compare_item: cmp_pair }, true);
        a1: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, ((int64, int64), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            appended: boolean
        } <- skew_ral@append(e, (1, 10));
        a2: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, ((int64, int64), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            appended: boolean
        } <- skew_ral@append(a1.list, (2, 20));
        a3: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, ((int64, int64), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            appended: boolean
        } <- skew_ral@append(a2.list, (3, 30));
        get0: boolean <- pair_is(skew_ral@get(a3.list, 0, (0, 0)), 1, 10);
        get2: boolean <- pair_is(skew_ral@get(a3.list, 2, (0, 0)), 3, 30);
        head_ok: boolean <- pair_is(skew_ral@head(a3.list, (0, 0)), 3, 30);
        s: {
            list: {
                count: int64,
                reversed: boolean,
                compare_item: fn((int64, int64), (int64, int64)) -> :less | :equal | :greater,
                forest: List[(int64, ref?(L, normal, ((int64, int64), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
                region: region(L, normal),
                specialization_key: int64
            },
            updated: boolean
        } <- skew_ral@set(a3.list, 1, (7, 70));
        set_ok: boolean <- pair_is(skew_ral@get(s.list, 1, (0, 0)), 7, 70);
        old_ok: boolean <- pair_is(skew_ral@get(a3.list, 1, (0, 0)), 2, 20);
        v: { valid: boolean, error: atom, logical_count: int64 } <- skew_ral@validate(s.list)
    produces
        pure a3.appended and get0 and get2 and head_ok and s.updated and set_ok and old_ok
            and v.valid and v.logical_count == 3
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                strings_ok: boolean <- strings();
                pairs_ok: boolean <- pairs()
            produces
                pure pick(strings_ok, 1, pick(pairs_ok, 2, 0))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
