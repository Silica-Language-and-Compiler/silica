// tree_trait.md §13-§14 and common_contract.md §12: validate walks every node, checking arena
// membership and active-path acyclicity before descending, the count signs and live <= slots, the
// child-slot list's own skew-binary invariants and length, the occupied count against
// live_child_count, then every child, then the cached subtree count against 1 + the exact child
// counts. Malformed fixtures are built directly against the representation (node tuple
// (item, count, live, slots, anchor, forest) with the forest built through skew_ral in the tree's
// arena; every tree record is built in its own helper frame because the bootstrap emitter clobbers
// an earlier destructured ref when a record with a function-valued field is bound after several
// (region, ref?) destructures, see memory_region_addition/emitter_defect_record_bind_after_destructures).
// Codes (tree_rose@validate_error_code): 0 ok, 1 cycle, 2 wrong_arena, 3 missing_root,
// 4 rank_violation, 5 negative_count, 6 size_mismatch, 7 slot_count_mismatch,
// 8 live_count_mismatch. count_overflow (9) cannot be staged: a cached count large enough to
// overflow the checked sum fails its own size check first.

use skew_ral;
use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_slot(_: ref?(L, normal, rec), _: ref?(L, normal, rec)) -> :less | :equal | :greater {
    :equal
}

fn arena() -> region(L, normal) {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        key: int64 <- tree_rose@arena_key();
        r: region(L, normal) <- canonical_arena_lookup(key)
    produces
        pure r
    end
}

fn foreign_arena() -> region(L, normal) {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- canonical_arena_lookup(9085)
    produces
        pure r
    end
}

fn no_slots() -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[(int64, ref?(L, normal, rec)), mem(normal)] <- empty[(int64, ref?(L, normal, rec)), mem(normal)]()
    produces
        pure out
    end
}

fn none_ref() -> ref?(L, normal, rec) {
    :none
}

// The child-slot list of `count` slots whose spine is `forest`, in arena `r`.
fn slots(r: region(L, normal), forest: List[(int64, ref?(L, normal, rec)), mem(normal)], count: int64) -> {
            count: int64,
            reversed: boolean,
            compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        } {
    out: {
            count: int64,
            reversed: boolean,
            compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        } <- { count: count, reversed: true, compare_item: cmp_slot, forest: forest, region: r, specialization_key: 0 };
    out
}

// Appends one slot (an occupied child or :none for a vacant slot) and returns the new spine.
fn slot_append(r: region(L, normal), forest: List[(int64, ref?(L, normal, rec)), mem(normal)], count: int64, child: ref?(L, normal, rec)) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    ral: {
            count: int64,
            reversed: boolean,
            compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        } <- slots(r, forest, count);
    app: { list: {
            count: int64,
            reversed: boolean,
            compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        }, appended: boolean } <- skew_ral@append(ral, child);
    app.list.forest
}

// Allocators return (region, ref) pairs: a bare reference return would outlive its region (E2100).
fn node(
    r: region(L, normal),
    v: int64,
    count: int64,
    live: int64,
    nslots: int64,
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> (region(L, normal), ref?(L, normal, rec)) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) <- alloc_rec(r, (v, count, live, nslots, :none, forest))
    produces
        pure (r, c)
    end
}

fn leaf(r: region(L, normal), v: int64) -> (region(L, normal), ref?(L, normal, rec)) {
    f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- no_slots();
    node(r, v, 1, 0, 0, f0)
}

fn tree_of(r: region(L, normal), root: ref?(L, normal, rec)) -> {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } {
    out: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- { root: root, compare_item: cmp_i64, region: r, specialization_key: 0, compare_item_ordering_bundle: 0 };
    out
}

fn code_of(r: region(L, normal), root: ref?(L, normal, rec)) -> int64 {
    t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- tree_of(r, root);
    rt_trial_i64@error_code_of(t)
}

// `n` is the second parameter on purpose: a third parameter read after a record-returning let is
// clobbered by the bootstrap emitter (staged/param_after_record_lets_clobbered).
fn valid_count_of(r: region(L, normal), n: int64, root: ref?(L, normal, rec)) -> boolean {
    t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- tree_of(r, root);
    rt_trial_i64@valid_count(t, n)
}

fn seq_of(r: region(L, normal), root: ref?(L, normal, rec)) -> int64 {
    t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- tree_of(r, root);
    rt_trial_i64@seq_pre(t)
}

fn node_count_of(r: region(L, normal), root: ref?(L, normal, rec)) -> int64 {
    t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- tree_of(r, root);
    tree_rose@node_count(t)
}

// Two leaf children in slots 0 and 1: the spine of a two-slot list.
fn two_kids(r: region(L, normal)) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence
        l1_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 2);
        (_: region(L, normal), l1: ref?(L, normal, rec)) <- l1_p;
        l2_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 3);
        (_: region(L, normal), l2: ref?(L, normal, rec)) <- l2_p;
        f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- no_slots();
        f1: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f0, 0, l1);
        f2: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f1, 1, l2)
    produces
        pure f2
    end
}

fn valid_cases(r: region(L, normal)) -> boolean {
    sequence
        l_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 9);
        (_: region(L, normal), l: ref?(L, normal, rec)) <- l_p;
        kids: List[(int64, ref?(L, normal, rec)), mem(normal)] <- two_kids(r);
        n3_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 3, 2, 2, kids);
        (_: region(L, normal), n3: ref?(L, normal, rec)) <- n3_p;
        f1: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, kids, 2, none_ref());
        vac_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 3, 2, 3, f1);
        (_: region(L, normal), vac: ref?(L, normal, rec)) <- vac_p;
        leaf_ok: boolean <- code_of(r, l) == 0;
        node_ok: boolean <- code_of(r, n3) == 0 and valid_count_of(r, 3, n3) and seq_of(r, n3) == 123;
        vacant_ok: boolean <- code_of(r, vac) == 0 and valid_count_of(r, 3, vac)
    produces
        pure leaf_ok and node_ok and vacant_ok
    end
}

fn count_cases(r: region(L, normal)) -> boolean {
    sequence
        f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- no_slots();
        zero_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 0, 0, 0, f0);
        (_: region(L, normal), zero: ref?(L, normal, rec)) <- zero_p;
        neg_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, -5, 0, 0, f0);
        (_: region(L, normal), neg: ref?(L, normal, rec)) <- neg_p;
        negl_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 1, -1, 0, f0);
        (_: region(L, normal), negl: ref?(L, normal, rec)) <- negl_p;
        over_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 1, 1, 0, f0);
        (_: region(L, normal), over: ref?(L, normal, rec)) <- over_p;
        kids: List[(int64, ref?(L, normal, rec)), mem(normal)] <- two_kids(r);
        big_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 7, 2, 2, kids);
        (_: region(L, normal), big: ref?(L, normal, rec)) <- big_p
    produces
        pure code_of(r, zero) == 5 and code_of(r, neg) == 5 and code_of(r, negl) == 5 and code_of(r, over) == 8
            and code_of(r, big) == 6 and node_count_of(r, big) == 7
    end
}

// slot_count disagrees with the list (7); live_child_count disagrees with the occupied slots (8).
fn slot_cases(r: region(L, normal)) -> boolean {
    sequence
        kids: List[(int64, ref?(L, normal, rec)), mem(normal)] <- two_kids(r);
        short_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 3, 2, 3, kids);
        (_: region(L, normal), short: ref?(L, normal, rec)) <- short_p;
        long_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 3, 1, 1, kids);
        (_: region(L, normal), long: ref?(L, normal, rec)) <- long_p;
        live_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 3, 1, 2, kids);
        (_: region(L, normal), live: ref?(L, normal, rec)) <- live_p
    produces
        pure code_of(r, short) == 7 and code_of(r, long) == 7 and code_of(r, live) == 8
    end
}

// A spine digit of weight 2 is not a skew weight: the list's own validator rejects it (4). The
// digit reuses the cell of a valid one-slot spine under the wrong weight.
fn rank_case(r: region(L, normal)) -> boolean {
    sequence proc[mem(normal)]
        l_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 2);
        (_: region(L, normal), l: ref?(L, normal, rec)) <- l_p;
        f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- no_slots();
        good: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f0, 0, l);
        (_: int64, cell: ref?(L, normal, rec)) <- good.head;
        d: (int64, ref?(L, normal, rec)) <- (2, cell);
        f1: List[(int64, ref?(L, normal, rec)), mem(normal)] <- prepend[(int64, ref?(L, normal, rec)), mem(normal)](d, f0);
        bad_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 2, 1, 2, f1);
        (_: region(L, normal), bad: ref?(L, normal, rec)) <- bad_p
    produces
        pure code_of(r, bad) == 4
    end
}

// The walk is depth-first: a child's violation is reported before its parent's (nested), and a
// parent whose cached count agrees with a wrong child count is caught through the child.
fn nested_cases(r: region(L, normal)) -> boolean {
    sequence
        f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- no_slots();
        bad_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 2, 0, 0, 0, f0);
        (_: region(L, normal), bad: ref?(L, normal, rec)) <- bad_p;
        f1: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f0, 0, bad);
        parent_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 99, 1, 1, f1);
        (_: region(L, normal), parent: ref?(L, normal, rec)) <- parent_p;
        l_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 3);
        (_: region(L, normal), l: ref?(L, normal, rec)) <- l_p;
        f2: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f0, 0, l);
        inner_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 2, 9, 1, 1, f2);
        (_: region(L, normal), inner: ref?(L, normal, rec)) <- inner_p;
        f3: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f0, 0, inner);
        outer_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 10, 1, 1, f3);
        (_: region(L, normal), outer: ref?(L, normal, rec)) <- outer_p
    produces
        pure code_of(r, parent) == 5 and code_of(r, outer) == 6
    end
}

// A node outside the tree's arena (root, child, or a child-slot list cell) is reported first.
fn arena_cases(r: region(L, normal), f: region(L, normal)) -> boolean {
    sequence
        fl_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(f, 5);
        (_: region(L, normal), fl: ref?(L, normal, rec)) <- fl_p;
        own_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 4);
        (_: region(L, normal), own: ref?(L, normal, rec)) <- own_p;
        f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- no_slots();
        f1: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f0, 0, fl);
        mixed_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 2, 1, 1, f1);
        (_: region(L, normal), mixed: ref?(L, normal, rec)) <- mixed_p;
        f2: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(f, f0, 0, own);
        cells_p: (region(L, normal), ref?(L, normal, rec)) <- node(r, 1, 2, 1, 1, f2);
        (_: region(L, normal), cells: ref?(L, normal, rec)) <- cells_p
    produces
        pure code_of(r, fl) == 2 and code_of(r, mixed) == 2 and code_of(r, cells) == 2
            and code_of(f, fl) == 0 and code_of(r, own) == 0
    end
}

// b's only child is a, and a is rewritten to hold b: the walk meets a again on the active path.
fn cycle_code(r: region(L, normal)) -> int64 {
    sequence proc[mem(normal)]
        f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- no_slots();
        a: ref(L, normal, (int64, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) <- alloc_rec(r, (5, 1, 0, 0, :none, f0));
        fa: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f0, 0, a);
        b: ref(L, normal, (int64, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) <- alloc_rec(r, (6, 2, 1, 1, :none, fa));
        fb: List[(int64, ref?(L, normal, rec)), mem(normal)] <- slot_append(r, f0, 0, b);
        _: atom <- write_ref(a, (5, 3, 1, 1, :none, fb))
    produces
        pure code_of(r, a)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                r: region(L, normal) <- arena();
                f: region(L, normal) <- foreign_arena();
                valid: boolean <- valid_cases(r);
                counts: boolean <- count_cases(r);
                slots_ok: boolean <- slot_cases(r);
                rank: boolean <- rank_case(r);
                nested: boolean <- nested_cases(r);
                arenas: boolean <- arena_cases(r, f);
                cyc: int64 <- cycle_code(r);
                missing: int64 <- code_of(r, :none);
                built: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@tree_1_2_4_5_3();
                built_code: int64 <- rt_trial_i64@error_code_of(built);
                println("built_tree");
                print_int64(built_code);
                println("");
                println("missing_root");
                print_int64(missing);
                println("");
                println("cycle");
                print_int64(cyc);
                println("")
            produces
                pure pick(valid, 1, pick(counts, 2, pick(slots_ok, 3, pick(rank, 4, pick(nested, 5, pick(arenas, 6, pick(cyc == 1 and missing == 3, 7, 0)))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
