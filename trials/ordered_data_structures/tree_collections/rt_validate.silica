// tree_trait.md §13-§14 and common_contract.md §12: validate walks every node, checking arena
// membership and active-path acyclicity before descending, the count signs and live <= slots, the
// child-slot list's own skew-binary invariants and weight sum, the occupied count against
// live_child_count, then every child, then the cached subtree count against 1 + the exact child
// counts. Malformed fixtures are built directly against the representation: the nine-field node
// (item, count, live, slots, weight, slot, left, right, spine), a rose node with weight 0 and an
// empty slot/left/right, a cell with counts 0 and an empty spine. The child-slot list is in the
// reverse orientation: the spine of two slots is [cell(slot 1), cell(slot 0)], of three slots
// [cell(3, slot 2, left = cell(slot 1), right = cell(slot 0))]. Every tree record is built in its
// own helper frame because the bootstrap emitter clobbers an earlier bound ref when a record
// with a function-valued field is bound after several ref bindings, see
// memory_region_addition/emitter_defect_record_bind_after_destructures.
// Chunk 15 phase 2 (P7): ref_in_region is retired, so the validators cannot tell arenas apart and the
// wrong-arena cases (code 2, foreign-arena root / child / slot cell) were removed with it; the exit
// code of a failing group is now 1..5 for the groups and 6 for cycle / missing root, 0 when all pass.
// Chunk 15 phase 5 (5b): the fixtures are allocated with the region-less alloc_rec (design §8.1);
// no family arena is looked up and no region handle is threaded through the helpers.
// Codes (tree_rose@validate_error_code): 0 ok, 1 cycle, 2 wrong_arena, 3 missing_root,
// 4 rank_violation, 5 negative_count, 6 size_mismatch, 7 slot_count_mismatch,
// 8 live_count_mismatch. count_overflow (9) cannot be staged: a cached count large enough to
// overflow the checked sum fails its own size check first.

use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn no_slots() -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- empty[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]()
    produces
        pure out
    end
}

fn spine_cons(head: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), rest: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- prepend[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)](head, rest)
    produces
        pure out
    end
}

fn none_ref() -> ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    :none
}

// Allocators return the ref? alone: the node is allocated in this frame and adopted by the caller.
fn node(
    v: int64,
    count: int64,
    live: int64,
    nslots: int64,
    spine: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]
) -> ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec((v, count, live, nslots, 0, :none, :none, :none, spine))
    produces
        pure c
    end
}

fn leaf(v: int64) -> ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
    node(v, 1, 0, 0, s0)
}

// A cell of weight w holding `slot`, with no halves (a correct cell only when w = 1).
fn bare_cell(w: int64, slot: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence proc[mem(normal)]
        e: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        c: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec((1, 0, 0, 0, w, slot, :none, :none, e))
    produces
        pure c
    end
}

fn branch_cell(slot: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), left: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), right: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence proc[mem(normal)]
        e: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        c: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec((1, 0, 0, 0, 3, slot, left, right, e))
    produces
        pure c
    end
}

// One slot (slot 0 = c0).
fn one_slot(c0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    cell: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- bare_cell(1, c0);
    s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
    spine_cons(cell, s0)
}

// Two slots: physical order is slot 1, then slot 0.
fn two_slots(c0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), c1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    cell0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- bare_cell(1, c0);
    cell1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- bare_cell(1, c1);
    s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
    s1: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- spine_cons(cell0, s0);
    spine_cons(cell1, s1)
}

// Three slots: one weight-3 cell holding slot 2, slot 1 in its left half, slot 0 in its right.
fn three_slots(c0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), c1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), c2: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    cell0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- bare_cell(1, c0);
    cell1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- bare_cell(1, c1);
    top: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- branch_cell(c2, cell1, cell0);
    s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
    spine_cons(top, s0)
}

fn tree_of(root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    out: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- { root: root, compare_item: cmp_i64, specialization_key: 0, compare_item_ordering_bundle: 0 };
    out
}

fn code_of(root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> int64 {
    t: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- tree_of(root);
    rt_trial_i64@error_code_of(t)
}

// `n` is read before `root` on purpose: a third parameter read after a record-returning let is
// clobbered by the bootstrap emitter (staged/param_after_record_lets_clobbered).
fn valid_count_of(n: int64, root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> boolean {
    t: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- tree_of(root);
    rt_trial_i64@valid_count(t, n)
}

fn seq_of(root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> int64 {
    t: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- tree_of(root);
    rt_trial_i64@seq_pre(t)
}

fn node_count_of(root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> int64 {
    t: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- tree_of(root);
    tree_rose@node_count(t)
}

// Two leaf children (items 2 and 3) in slots 0 and 1.
fn two_kids() -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence
        l1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- leaf(2);
        l2: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- leaf(3);
        s: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_slots(l1, l2)
    produces
        pure s
    end
}

// The same two children and a vacant slot 2.
fn two_kids_and_vacant() -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence
        l1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- leaf(2);
        l2: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- leaf(3);
        s: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- three_slots(l1, l2, none_ref())
    produces
        pure s
    end
}

fn valid_cases() -> boolean {
    sequence
        l: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- leaf(9);
        kids: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_kids();
        n3: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 3, 2, 2, kids);
        kids_vac: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_kids_and_vacant();
        vac: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 3, 2, 3, kids_vac);
        leaf_ok: boolean <- code_of(l) == 0;
        node_ok: boolean <- code_of(n3) == 0 and valid_count_of(3, n3) and seq_of(n3) == 123;
        vacant_ok: boolean <- code_of(vac) == 0 and valid_count_of(3, vac) and seq_of(vac) == 123
    produces
        pure leaf_ok and node_ok and vacant_ok
    end
}

fn count_cases() -> boolean {
    sequence
        s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        zero: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 0, 0, 0, s0);
        neg: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, -5, 0, 0, s0);
        negl: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 1, -1, 0, s0);
        over: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 1, 1, 0, s0);
        kids: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_kids();
        big: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 7, 2, 2, kids)
    produces
        pure code_of(zero) == 5 and code_of(neg) == 5 and code_of(negl) == 5 and code_of(over) == 8
            and code_of(big) == 6 and node_count_of(big) == 7
    end
}

// slot_count disagrees with the list's weight sum (7); live_child_count disagrees with the
// occupied slots (8).
fn slot_cases() -> boolean {
    sequence
        kids: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_kids();
        short: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 3, 2, 3, kids);
        long: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 3, 1, 1, kids);
        live: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 3, 1, 2, kids)
    produces
        pure code_of(short) == 7 and code_of(long) == 7 and code_of(live) == 8
    end
}

// A spine cell of weight 2 is not a skew weight, and a weight-3 cell without its two halves is
// misshapen: the list's own invariants reject both (4).
fn rank_case() -> boolean {
    sequence
        l: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- leaf(2);
        c2: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- bare_cell(2, l);
        s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        s2: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- spine_cons(c2, s0);
        bad: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 2, 1, 2, s2);
        c3: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- bare_cell(3, l);
        s3: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- spine_cons(c3, s0);
        hollow: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 2, 1, 3, s3)
    produces
        pure code_of(bad) == 4 and code_of(hollow) == 4
    end
}

// The walk is depth-first: a child's violation is reported before its parent's (nested), and a
// parent whose cached count agrees with a wrong child count is caught through the child.
fn nested_cases() -> boolean {
    sequence
        s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        bad: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(2, 0, 0, 0, s0);
        s1: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(bad);
        parent: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 99, 1, 1, s1);
        l: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- leaf(3);
        s2: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(l);
        inner: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(2, 9, 1, 1, s2);
        s3: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(inner);
        outer: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- node(1, 10, 1, 1, s3)
    produces
        pure code_of(parent) == 5 and code_of(outer) == 6
    end
}

// b's only child is a, and a is rewritten to hold b: the walk meets a again on the active path.
fn cycle_code() -> int64 {
    sequence proc[mem(normal)]
        s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        a: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec((5, 1, 0, 0, 0, :none, :none, :none, s0));
        sa: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(a);
        b: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec((6, 2, 1, 1, 0, :none, :none, :none, sa));
        sb: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(b);
        _: atom <- write_ref(a, (5, 3, 1, 1, 0, :none, :none, :none, sb))
    produces
        pure code_of(a)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                valid: boolean <- valid_cases();
                counts: boolean <- count_cases();
                slots_ok: boolean <- slot_cases();
                rank: boolean <- rank_case();
                nested: boolean <- nested_cases();
                cyc: int64 <- cycle_code();
                missing: int64 <- code_of(:none);
                built: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- rt_trial_i64@tree_1_2_4_5_3();
                built_code: int64 <- rt_trial_i64@error_code_of(built);
                println("built_tree");
                print_int64(built_code);
                println("");
                println("missing_root");
                print_int64(missing);
                println("");
                println("cycle");
                print_int64(cyc);
                println("")
            produces
                pure pick(valid, 1, pick(counts, 2, pick(slots_ok, 3, pick(rank, 4, pick(nested, 5, pick(cyc == 1 and missing == 3, 6, 0))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
