// tree_trait.md §13-§14 and common_contract.md §12: validate walks every node, checking arena
// membership and active-path acyclicity before descending, the count signs and live <= slots, the
// child-slot list's own skew-binary invariants and weight sum, the occupied count against
// live_child_count, then every child, then the cached subtree count against 1 + the exact child
// counts. Malformed fixtures are built directly against the representation: the nine-field node
// (item, count, live, slots, weight, slot, left, right, spine), a rose node with weight 0 and an
// empty slot/left/right, a cell with counts 0 and an empty spine. The child-slot list is in the
// reverse orientation: the spine of two slots is [cell(slot 1), cell(slot 0)], of three slots
// [cell(3, slot 2, left = cell(slot 1), right = cell(slot 0))]. Every tree record is built in its
// own helper frame because the bootstrap emitter clobbers an earlier destructured ref when a record
// with a function-valued field is bound after several (region, ref?) destructures, see
// memory_region_addition/emitter_defect_record_bind_after_destructures.
// Codes (tree_rose@validate_error_code): 0 ok, 1 cycle, 2 wrong_arena, 3 missing_root,
// 4 rank_violation, 5 negative_count, 6 size_mismatch, 7 slot_count_mismatch,
// 8 live_count_mismatch. count_overflow (9) cannot be staged: a cached count large enough to
// overflow the checked sum fails its own size check first.

use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn arena() -> region(L, normal) {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        key: int64 <- tree_rose@arena_key();
        r: region(L, normal) <- canonical_arena_lookup(key)
    produces
        pure r
    end
}

fn foreign_arena() -> region(L, normal) {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- canonical_arena_lookup(9085)
    produces
        pure r
    end
}

fn no_slots() -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- empty[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]()
    produces
        pure out
    end
}

fn spine_cons(head: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), rest: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- prepend[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)](head, rest)
    produces
        pure out
    end
}

fn none_ref() -> ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    :none
}

// Allocators return (region, ref) pairs: a bare reference return would outlive its region (E2100).
fn node(
    r: region(L, normal),
    v: int64,
    count: int64,
    live: int64,
    nslots: int64,
    spine: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]
) -> (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec(r, (v, count, live, nslots, 0, :none, :none, :none, spine))
    produces
        pure (r, c)
    end
}

fn leaf(r: region(L, normal), v: int64) -> (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) {
    s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
    node(r, v, 1, 0, 0, s0)
}

// A cell of weight w holding `slot`, with no halves (a correct cell only when w = 1).
fn bare_cell(r: region(L, normal), w: int64, slot: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) {
    sequence proc[mem(normal)]
        e: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        c: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec(r, (1, 0, 0, 0, w, slot, :none, :none, e))
    produces
        pure (r, c)
    end
}

fn branch_cell(r: region(L, normal), slot: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), left: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), right: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) {
    sequence proc[mem(normal)]
        e: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        c: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec(r, (1, 0, 0, 0, 3, slot, left, right, e))
    produces
        pure (r, c)
    end
}

// One slot (slot 0 = c0), its cell in arena r.
fn one_slot(r: region(L, normal), c0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bare_cell(r, 1, c0);
    (_: region(L, normal), cell: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- p;
    s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
    spine_cons(cell, s0)
}

// Two slots: physical order is slot 1, then slot 0.
fn two_slots(r: region(L, normal), c0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), c1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    p0: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bare_cell(r, 1, c0);
    (_: region(L, normal), cell0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- p0;
    p1: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bare_cell(r, 1, c1);
    (_: region(L, normal), cell1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- p1;
    s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
    s1: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- spine_cons(cell0, s0);
    spine_cons(cell1, s1)
}

// Three slots: one weight-3 cell holding slot 2, slot 1 in its left half, slot 0 in its right.
fn three_slots(r: region(L, normal), c0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), c1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), c2: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    p0: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bare_cell(r, 1, c0);
    (_: region(L, normal), cell0: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- p0;
    p1: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bare_cell(r, 1, c1);
    (_: region(L, normal), cell1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- p1;
    p2: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- branch_cell(r, c2, cell1, cell0);
    (_: region(L, normal), top: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- p2;
    s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
    spine_cons(top, s0)
}

fn tree_of(r: region(L, normal), root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    out: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- { root: root, compare_item: cmp_i64, region: r, specialization_key: 0, compare_item_ordering_bundle: 0 };
    out
}

fn code_of(r: region(L, normal), root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> int64 {
    t: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- tree_of(r, root);
    rt_trial_i64@error_code_of(t)
}

// `n` is the second parameter on purpose: a third parameter read after a record-returning let is
// clobbered by the bootstrap emitter (staged/param_after_record_lets_clobbered).
fn valid_count_of(r: region(L, normal), n: int64, root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> boolean {
    t: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- tree_of(r, root);
    rt_trial_i64@valid_count(t, n)
}

fn seq_of(r: region(L, normal), root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> int64 {
    t: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- tree_of(r, root);
    rt_trial_i64@seq_pre(t)
}

fn node_count_of(r: region(L, normal), root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> int64 {
    t: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- tree_of(r, root);
    tree_rose@node_count(t)
}

// Two leaf children (items 2 and 3) in slots 0 and 1.
fn two_kids(r: region(L, normal)) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence
        l1_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(r, 2);
        (_: region(L, normal), l1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- l1_p;
        l2_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(r, 3);
        (_: region(L, normal), l2: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- l2_p;
        s: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_slots(r, l1, l2)
    produces
        pure s
    end
}

// The same two children and a vacant slot 2.
fn two_kids_and_vacant(r: region(L, normal)) -> List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence
        l1_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(r, 2);
        (_: region(L, normal), l1: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- l1_p;
        l2_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(r, 3);
        (_: region(L, normal), l2: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- l2_p;
        s: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- three_slots(r, l1, l2, none_ref())
    produces
        pure s
    end
}

fn valid_cases(r: region(L, normal)) -> boolean {
    sequence
        l_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(r, 9);
        (_: region(L, normal), l: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- l_p;
        kids: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_kids(r);
        n3_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 3, 2, 2, kids);
        (_: region(L, normal), n3: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- n3_p;
        kids_vac: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_kids_and_vacant(r);
        vac_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 3, 2, 3, kids_vac);
        (_: region(L, normal), vac: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- vac_p;
        leaf_ok: boolean <- code_of(r, l) == 0;
        node_ok: boolean <- code_of(r, n3) == 0 and valid_count_of(r, 3, n3) and seq_of(r, n3) == 123;
        vacant_ok: boolean <- code_of(r, vac) == 0 and valid_count_of(r, 3, vac) and seq_of(r, vac) == 123
    produces
        pure leaf_ok and node_ok and vacant_ok
    end
}

fn count_cases(r: region(L, normal)) -> boolean {
    sequence
        s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        zero_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 0, 0, 0, s0);
        (_: region(L, normal), zero: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- zero_p;
        neg_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, -5, 0, 0, s0);
        (_: region(L, normal), neg: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- neg_p;
        negl_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 1, -1, 0, s0);
        (_: region(L, normal), negl: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- negl_p;
        over_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 1, 1, 0, s0);
        (_: region(L, normal), over: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- over_p;
        kids: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_kids(r);
        big_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 7, 2, 2, kids);
        (_: region(L, normal), big: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- big_p
    produces
        pure code_of(r, zero) == 5 and code_of(r, neg) == 5 and code_of(r, negl) == 5 and code_of(r, over) == 8
            and code_of(r, big) == 6 and node_count_of(r, big) == 7
    end
}

// slot_count disagrees with the list's weight sum (7); live_child_count disagrees with the
// occupied slots (8).
fn slot_cases(r: region(L, normal)) -> boolean {
    sequence
        kids: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- two_kids(r);
        short_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 3, 2, 3, kids);
        (_: region(L, normal), short: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- short_p;
        long_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 3, 1, 1, kids);
        (_: region(L, normal), long: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- long_p;
        live_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 3, 1, 2, kids);
        (_: region(L, normal), live: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- live_p
    produces
        pure code_of(r, short) == 7 and code_of(r, long) == 7 and code_of(r, live) == 8
    end
}

// A spine cell of weight 2 is not a skew weight, and a weight-3 cell without its two halves is
// misshapen: the list's own invariants reject both (4).
fn rank_case(r: region(L, normal)) -> boolean {
    sequence
        l_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(r, 2);
        (_: region(L, normal), l: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- l_p;
        c2_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bare_cell(r, 2, l);
        (_: region(L, normal), c2: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- c2_p;
        s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        s2: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- spine_cons(c2, s0);
        bad_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 2, 1, 2, s2);
        (_: region(L, normal), bad: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bad_p;
        c3_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bare_cell(r, 3, l);
        (_: region(L, normal), c3: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- c3_p;
        s3: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- spine_cons(c3, s0);
        hollow_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 2, 1, 3, s3);
        (_: region(L, normal), hollow: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- hollow_p
    produces
        pure code_of(r, bad) == 4 and code_of(r, hollow) == 4
    end
}

// The walk is depth-first: a child's violation is reported before its parent's (nested), and a
// parent whose cached count agrees with a wrong child count is caught through the child.
fn nested_cases(r: region(L, normal)) -> boolean {
    sequence
        s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        bad_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 2, 0, 0, 0, s0);
        (_: region(L, normal), bad: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- bad_p;
        s1: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(r, bad);
        parent_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 99, 1, 1, s1);
        (_: region(L, normal), parent: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- parent_p;
        l_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(r, 3);
        (_: region(L, normal), l: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- l_p;
        s2: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(r, l);
        inner_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 2, 9, 1, 1, s2);
        (_: region(L, normal), inner: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- inner_p;
        s3: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(r, inner);
        outer_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 10, 1, 1, s3);
        (_: region(L, normal), outer: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- outer_p
    produces
        pure code_of(r, parent) == 5 and code_of(r, outer) == 6
    end
}

// A node outside the tree's arena (root, child, or a child-slot list cell) is reported first.
fn arena_cases(r: region(L, normal), f: region(L, normal)) -> boolean {
    sequence
        fl_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(f, 5);
        (_: region(L, normal), fl: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- fl_p;
        own_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- leaf(r, 4);
        (_: region(L, normal), own: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- own_p;
        s1: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(r, fl);
        mixed_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 2, 1, 1, s1);
        (_: region(L, normal), mixed: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- mixed_p;
        s2: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(f, own);
        cells_p: (region(L, normal), ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- node(r, 1, 2, 1, 1, s2);
        (_: region(L, normal), cells: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- cells_p
    produces
        pure code_of(r, fl) == 2 and code_of(r, mixed) == 2 and code_of(r, cells) == 2
            and code_of(f, fl) == 0 and code_of(r, own) == 0
    end
}

// b's only child is a, and a is rewritten to hold b: the walk meets a again on the active path.
fn cycle_code(r: region(L, normal)) -> int64 {
    sequence proc[mem(normal)]
        s0: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- no_slots();
        a: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec(r, (5, 1, 0, 0, 0, :none, :none, :none, s0));
        sa: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(r, a);
        b: ref(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec(r, (6, 2, 1, 1, 0, :none, :none, :none, sa));
        sb: List[ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- one_slot(r, b);
        _: atom <- write_ref(a, (5, 3, 1, 1, 0, :none, :none, :none, sb))
    produces
        pure code_of(r, a)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                r: region(L, normal) <- arena();
                f: region(L, normal) <- foreign_arena();
                valid: boolean <- valid_cases(r);
                counts: boolean <- count_cases(r);
                slots_ok: boolean <- slot_cases(r);
                rank: boolean <- rank_case(r);
                nested: boolean <- nested_cases(r);
                arenas: boolean <- arena_cases(r, f);
                cyc: int64 <- cycle_code(r);
                missing: int64 <- code_of(r, :none);
                built: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- rt_trial_i64@tree_1_2_4_5_3();
                built_code: int64 <- rt_trial_i64@error_code_of(built);
                println("built_tree");
                print_int64(built_code);
                println("");
                println("missing_root");
                print_int64(missing);
                println("");
                println("cycle");
                print_int64(cyc);
                println("")
            produces
                pure pick(valid, 1, pick(counts, 2, pick(slots_ok, 3, pick(rank, 4, pick(nested, 5, pick(arenas, 6, pick(cyc == 1 and missing == 3, 7, 0)))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
