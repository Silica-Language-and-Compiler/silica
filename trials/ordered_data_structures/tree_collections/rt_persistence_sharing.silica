// tree_trait.md §8-§10 and common_contract.md §7: every update is persistent. Versions derived from
// one base stay independent, each shares every untouched subtree with the base, the base keeps
// every value, and a chain is updated at the bottom and cut in the middle while the original is
// unchanged. Base 1(2(4, 5), 3), preorder 12453.

use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
fn versions() -> boolean {
    sequence proc[mem(normal)]
        base: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@tree_1_2_4_5_3();
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        pa: List[int64, mem(normal)] <- [0];
        pb: List[int64, mem(normal)] <- [1];
        v1: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(base, pb, 6);
        v2: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@remove(base, pa, 0);
        v3: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@replace(base, pa, 7);
        v4: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(v1, p0, 8);
        v5: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@remove(v4, p0, 1);
        seq_ok: boolean <- rt_trial_i64@seq_pre(base) == 12453 and rt_trial_i64@seq_pre(v1) == 124536
            and rt_trial_i64@seq_pre(v2) == 1253 and rt_trial_i64@seq_pre(v3) == 17453
            and rt_trial_i64@seq_pre(v4) == 1245368 and rt_trial_i64@seq_pre(v5) == 12458;
        count_ok: boolean <- tree_rose@node_count(base) == 5 and tree_rose@node_count(v1) == 6
            and tree_rose@node_count(v2) == 4 and tree_rose@node_count(v3) == 5
            and tree_rose@node_count(v4) == 7 and tree_rose@node_count(v5) == 5;
        shared_ok: boolean <- rt_trial_i64@get_is(v2, pb, 3) and rt_trial_i64@get_is(v3, pb, 3)
            and rt_trial_i64@child_count_of(v5, pa) == 2 and rt_trial_i64@slot_count_of(v5, p0) == 3;
        valid_ok: boolean <- rt_trial_i64@valid_count(base, 5) and rt_trial_i64@valid_count(v1, 6)
            and rt_trial_i64@valid_count(v2, 4) and rt_trial_i64@valid_count(v3, 5)
            and rt_trial_i64@valid_count(v4, 7) and rt_trial_i64@valid_count(v5, 5)
    produces
        pure seq_ok and count_ok and shared_ok and valid_ok
    end
}

fn chain_versions() -> boolean {
    sequence
        c: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@chain(40);
        bottom: List[int64, mem(normal)] <- rt_trial_i64@path_chain(39);
        mid: List[int64, mem(normal)] <- rt_trial_i64@path_chain(20);
        renamed: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@replace(c, bottom, 99);
        cut: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@remove(c, mid, 0);
        both: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@replace(cut, mid, 55);
        rename_ok: boolean <- rt_trial_i64@get_is(renamed, bottom, 99) and rt_trial_i64@get_is(c, bottom, 40)
            and rt_trial_i64@sum_of(renamed) == 879 and rt_trial_i64@sum_of(c) == 820;
        cut_ok: boolean <- tree_rose@node_count(cut) == 21 and tree_rose@node_count(c) == 40
            and rt_trial_i64@get_missing(cut, bottom) and rt_trial_i64@get_is(cut, mid, 21)
            and rt_trial_i64@sum_of(cut) == 231;
        both_ok: boolean <- rt_trial_i64@get_is(both, mid, 55) and rt_trial_i64@get_is(cut, mid, 21)
            and rt_trial_i64@sum_of(both) == 265 and rt_trial_i64@valid_count(both, 21)
    produces
        pure rename_ok and cut_ok and both_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                base: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@tree_1_2_4_5_3();
                pa: List[int64, mem(normal)] <- tree_rose@path_with(tree_rose@path_root(), 0);
                pb: List[int64, mem(normal)] <- tree_rose@path_with(tree_rose@path_root(), 1);
                v1: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@add(base, pb, 6);
                v2: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@remove(base, pa, 0);
                v3: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@replace(base, pa, 7);
                s0: int64 <- rt_trial_i64@seq_pre(base);
                s1: int64 <- rt_trial_i64@seq_pre(v1);
                s2: int64 <- rt_trial_i64@seq_pre(v2);
                s3: int64 <- rt_trial_i64@seq_pre(v3);
                a: boolean <- versions();
                b: boolean <- chain_versions();
                println("base");
                print_int64(s0);
                println("");
                println("v1_added");
                print_int64(s1);
                println("");
                println("v2_removed");
                print_int64(s2);
                println("");
                println("v3_replaced");
                print_int64(s3);
                println("")
            produces
                pure pick(a, 1, pick(b, 2, 0))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
