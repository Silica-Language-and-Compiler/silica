// tree_trait.md §2, §7, §12: a Tree is one node at construction. Every query on the root path
// succeeds, every deeper or negative path is :not_found, child counts are zero, the preorder fold
// visits the root once with the empty path, find_first finds the root or nothing, remove_child at
// the root's (nonexistent) slot 0 declines, and replace_item at the root publishes a new version
// while the old one keeps its item. Root path code 1.

use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
fn queries() -> boolean {
    sequence proc[mem(normal)]
        t: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@new_tree(7);
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        pa: List[int64, mem(normal)] <- [0];
        pn: List[int64, mem(normal)] <- [-1];
        count_ok: boolean <- tree_rose@node_count(t) == 1 and tree_rose@root_item(t) == 7;
        get_ok: boolean <- rt_trial_i64@get_is(t, p0, 7) and rt_trial_i64@get_missing(t, pa)
            and rt_trial_i64@get_missing(t, pn);
        counts_ok: boolean <- rt_trial_i64@child_count_of(t, p0) == 0 and rt_trial_i64@slot_count_of(t, p0) == 0
            and rt_trial_i64@child_count_of(t, pa) == -1 and rt_trial_i64@slot_count_of(t, pa) == -1;
        child_ok: boolean <- rt_trial_i64@child_missing(t, p0, 0) and rt_trial_i64@child_missing(t, p0, -1)
            and rt_trial_i64@child_missing(t, pa, 0);
        fold_ok: boolean <- rt_trial_i64@seq_pre(t) == 7 and rt_trial_i64@paths_pre(t) == 1
            and rt_trial_i64@count_visited(t) == 1 and rt_trial_i64@depth_sum(t) == 0;
        find_ok: boolean <- rt_trial_i64@find_code(t, 7) == 1 and rt_trial_i64@find_code(t, 8) == -1
            and rt_trial_i64@find_value(t, 7) == 7;
        valid_ok: boolean <- rt_trial_i64@valid_count(t, 1)
    produces
        pure count_ok and get_ok and counts_ok and child_ok and fold_ok and find_ok and valid_ok
    end
}

fn updates() -> boolean {
    sequence proc[mem(normal)]
        t: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@new_tree(7);
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        pa: List[int64, mem(normal)] <- [0];
        remove_ok: boolean <- rt_trial_i64@remove_count(t, p0, 0) == -1 and rt_trial_i64@remove_count(t, pa, 0) == -1;
        nine: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@replace(t, p0, 9);
        replace_ok: boolean <- rt_trial_i64@replace_ok(t, p0, 9) and tree_rose@root_item(nine) == 9
            and tree_rose@node_count(nine) == 1 and tree_rose@root_item(t) == 7
            and rt_trial_i64@replace_ok(t, pa, 9) == false;
        grown: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t, p0, 8);
        add_ok: boolean <- rt_trial_i64@add_slot(t, p0, 8) == 0 and tree_rose@node_count(grown) == 2
            and rt_trial_i64@get_is(grown, pa, 8) and tree_rose@node_count(t) == 1
            and rt_trial_i64@add_slot(t, pa, 8) == -1;
        valid_ok: boolean <- rt_trial_i64@valid_count(nine, 1) and rt_trial_i64@valid_count(grown, 2)
    produces
        pure remove_ok and replace_ok and add_ok and valid_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t: {
                    root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@new_tree(7);
                n: int64 <- tree_rose@node_count(t);
                r: int64 <- tree_rose@root_item(t);
                s: int64 <- rt_trial_i64@seq_pre(t);
                q: boolean <- queries();
                u: boolean <- updates();
                println("node_count");
                print_int64(n);
                println("");
                println("root_item");
                print_int64(r);
                println("");
                println("preorder");
                print_int64(s);
                println("")
            produces
                pure pick(q, 1, pick(u, 2, 0))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
