// tree_trait.md §5, §10: fold_preorder visits the node, then its occupied slots in ascending slot
// order, each subtree recursively; vacant slots are skipped; every callback receives a root-first
// path of stable slots. Fixture 1(2(4, 5), 3(_, 8), _): root slots 0, 1 and vacated 2; under 3
// slot 0 vacated and 8 at slot 1. Preorder 124538; path codes 1 + 10 + 100 + 101 + 11 + 111 = 334.

use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
fn keep_step(acc: int64, _: List[int64, mem(normal)], _: int64) -> int64 {
    acc
}

fn fixture() -> {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } {
    sequence proc[mem(normal)]
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        pb: List[int64, mem(normal)] <- [1];
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@tree_1_2_4_5_3();
        t6: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t, pb, 6);
        t7: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t6, p0, 7);
        t8: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t7, pb, 8);
        no7: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@remove(t8, p0, 2);
        no6: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@remove(no7, pb, 0)
    produces
        pure no6
    end
}

fn orders() -> boolean {
    sequence proc[mem(normal)]
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- fixture();
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        pb: List[int64, mem(normal)] <- [1];
        pb1: List[int64, mem(normal)] <- [1, 1];
        shape_ok: boolean <- tree_rose@node_count(t) == 6 and rt_trial_i64@slot_count_of(t, p0) == 3
            and rt_trial_i64@child_count_of(t, p0) == 2 and rt_trial_i64@slot_count_of(t, pb) == 2
            and rt_trial_i64@child_count_of(t, pb) == 1 and rt_trial_i64@get_is(t, pb1, 8);
        fold_ok: boolean <- rt_trial_i64@seq_pre(t) == 124538 and rt_trial_i64@paths_pre(t) == 334
            and rt_trial_i64@count_visited(t) == 6 and rt_trial_i64@sum_of(t) == 23
            and rt_trial_i64@depth_sum(t) == 8;
        init_ok: boolean <- tree_rose@fold_preorder(t, 5, keep_step) == 5;
        valid_ok: boolean <- rt_trial_i64@valid_count(t, 6)
    produces
        pure shape_ok and fold_ok and init_ok and valid_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- fixture();
                s: int64 <- rt_trial_i64@seq_pre(t);
                p: int64 <- rt_trial_i64@paths_pre(t);
                sum: int64 <- rt_trial_i64@sum_of(t);
                one: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@new_tree(9);
                s1: int64 <- rt_trial_i64@seq_pre(one);
                o: boolean <- orders();
                println("preorder");
                print_int64(s);
                println("");
                println("path_codes");
                print_int64(p);
                println("");
                println("sum");
                print_int64(sum);
                println("");
                println("single_node_preorder");
                print_int64(s1);
                println("")
            produces
                pure pick(o, 1, 0)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
