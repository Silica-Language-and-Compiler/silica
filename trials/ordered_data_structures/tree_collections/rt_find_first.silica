// tree_trait.md §10, §12 and common_contract.md §4: find_first returns the first preorder node
// whose item compares :equal under the captured comparator, with its path; nothing found is
// :not_found. Duplicates resolve to the earliest preorder position, and comparator equality (not
// built-in ==) is identity: with cmp_mod10, 2 finds 22. Fixture 1(2(4, 5), 3(5, 2)).

use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
// Comparator results are cased with :less, :equal, :greater in that order in the first function
// of this unit that mentions them: atoms are numbered per unit in order of first appearance and
// tree_rose returns the three at their implicit positions.
fn atom_code(a: :less | :equal | :greater) -> int64 {
    case a of {
        :less -> 1;
        :equal -> 2;
        :greater -> 3
    }
}

fn fixture() -> {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } {
    sequence proc[mem(normal)]
        pb: List[int64, mem(normal)] <- [1];
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@tree_1_2_4_5_3();
        t5: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t, pb, 5);
        t2: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t5, pb, 2)
    produces
        pure t2
    end
}

fn duplicates() -> boolean {
    sequence
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- fixture();
        first5: boolean <- rt_trial_i64@find_code(t, 5) == 101 and rt_trial_i64@find_value(t, 5) == 5;
        first2: boolean <- rt_trial_i64@find_code(t, 2) == 10;
        root: boolean <- rt_trial_i64@find_code(t, 1) == 1 and rt_trial_i64@find_code(t, 3) == 11
            and rt_trial_i64@find_code(t, 4) == 100;
        missing: boolean <- rt_trial_i64@find_code(t, 9) == -1 and rt_trial_i64@find_value(t, 9) == -1
            and rt_trial_i64@find_code(t, 0) == -1;
        preorder_ok: boolean <- rt_trial_i64@seq_pre(t) == 1245352
    produces
        pure first5 and first2 and root and missing and preorder_ok
    end
}

// Comparator identity: cmp_mod10 makes 22 equal to 2 and 35 equal to 5, 15 and 25 both to 5.
fn comparator_identity() -> boolean {
    sequence
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        t1: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@new_tree_mod10(11);
        t2: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t1, p0, 22);
        t3: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t2, p0, 35);
        t4: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t3, p0, 25);
        by_digit: boolean <- rt_trial_i64@find_value(t4, 2) == 22 and rt_trial_i64@find_code(t4, 2) == 10
            and rt_trial_i64@find_value(t4, 5) == 35 and rt_trial_i64@find_code(t4, 5) == 11
            and rt_trial_i64@find_value(t4, 1) == 11 and rt_trial_i64@find_value(t4, 101) == 11;
        none: boolean <- rt_trial_i64@find_code(t4, 3) == -1;
        cmp_ok: boolean <- atom_code(tree_rose@compare_item(t4, 22, 2)) == 2
            and atom_code(tree_rose@compare_item(t4, 3, 25)) == 1 and atom_code(tree_rose@compare_item(t4, 19, 25)) == 3
    produces
        pure by_digit and none and cmp_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- fixture();
                f5: int64 <- rt_trial_i64@find_code(t, 5);
                f2: int64 <- rt_trial_i64@find_code(t, 2);
                f9: int64 <- rt_trial_i64@find_code(t, 9);
                p0: List[int64, mem(normal)] <- tree_rose@path_root();
                m1: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@new_tree_mod10(11);
                m2: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@add(m1, p0, 22);
                mv: int64 <- rt_trial_i64@find_value(m2, 2);
                d: boolean <- duplicates();
                c: boolean <- comparator_identity();
                println("first_5_path");
                print_int64(f5);
                println("");
                println("first_2_path");
                print_int64(f2);
                println("");
                println("missing_9");
                print_int64(f9);
                println("");
                println("mod10_value_for_2");
                print_int64(mv);
                println("")
            produces
                pure pick(d, 1, pick(c, 2, 0))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
