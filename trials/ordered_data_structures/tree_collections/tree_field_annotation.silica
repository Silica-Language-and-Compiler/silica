// tree_trait.md: a rose-tree update bound with a record annotation whose field is the public bracket
// type `Tree[string, mem(normal)]` (the concrete record tree_rose returns, common_contract.md §2).
// Expected: "Mother" is added as a child of the root, grown.added is true, exit 1.

use tree_rose;
use Tree;
use trial_support_int64;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                t: Tree[string, mem(normal)] <- tree_rose@with_root({ compare_item: compare_names }, "Grandmother");
                found: { status: :not_found | :found, value: string, path: List[int64, mem(normal)] } <- tree_rose@find_first(t, "Grandmother", "");
                grown: :unchanged | (:added, { root: ref?(L, normal, (string, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }, int64) <- tree_rose@add_leaf(t, found.path, "Mother");
                grown_added: boolean <- case grown of {
                    :unchanged -> false;
                    (:added, _v_added: { root: ref?(L, normal, (string, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), compare_item: fn(string, string) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }, _n_added: int64) -> true
                }
            produces
                pure case grown_added of {
                    true -> 1;
                    false -> 0
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
