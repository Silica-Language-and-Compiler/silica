// tree_trait.md §10, §12: replace_item changes only the target item, copies the root-to-target
// path, keeps every count and slot number, reports changed = true whenever the path exists (no
// item equality is consulted) and returns the exact old tree for a missing or vacant path.
// Fixture 1(2(4, 5), 3), preorder 12453.

use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
fn found_paths() -> boolean {
    sequence proc[mem(normal)]
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@tree_1_2_4_5_3();
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        pa: List[int64, mem(normal)] <- [0];
        p01: List[int64, mem(normal)] <- [0, 1];
        at_root: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@replace(t, p0, 9);
        root_ok: boolean <- rt_trial_i64@replace_ok(t, p0, 9) and rt_trial_i64@seq_pre(at_root) == 92453
            and tree_rose@node_count(at_root) == 5 and rt_trial_i64@slot_count_of(at_root, p0) == 2
            and rt_trial_i64@child_count_of(at_root, pa) == 2 and rt_trial_i64@paths_pre(at_root) == 223;
        deep: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@replace(t, p01, 8);
        deep_ok: boolean <- rt_trial_i64@seq_pre(deep) == 12483 and rt_trial_i64@get_is(deep, p01, 8)
            and rt_trial_i64@get_is(deep, pa, 2) and tree_rose@node_count(deep) == 5;
        same_item: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@replace(t, pa, 2);
        same_ok: boolean <- rt_trial_i64@replace_ok(t, pa, 2) and rt_trial_i64@seq_pre(same_item) == 12453;
        old_ok: boolean <- rt_trial_i64@seq_pre(t) == 12453 and rt_trial_i64@get_is(t, p01, 5);
        valid_ok: boolean <- rt_trial_i64@valid_count(at_root, 5) and rt_trial_i64@valid_count(deep, 5)
    produces
        pure root_ok and deep_ok and same_ok and old_ok and valid_ok
    end
}

fn missing_paths() -> boolean {
    sequence proc[mem(normal)]
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@tree_1_2_4_5_3();
        pa: List[int64, mem(normal)] <- [0];
        p05: List[int64, mem(normal)] <- [0, 5];
        p7: List[int64, mem(normal)] <- [7];
        p00: List[int64, mem(normal)] <- [0, 0];
        pneg: List[int64, mem(normal)] <- [0, -1];
        declined: boolean <- rt_trial_i64@replace_ok(t, p05, 8) == false and rt_trial_i64@replace_ok(t, p7, 8) == false
            and rt_trial_i64@replace_ok(t, pneg, 8) == false;
        same: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@replace(t, p05, 8);
        unchanged: boolean <- rt_trial_i64@seq_pre(same) == 12453 and tree_rose@node_count(same) == 5;
        vacated: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@remove(t, pa, 0);
        vacant_declined: boolean <- rt_trial_i64@replace_ok(vacated, p00, 6) == false
            and rt_trial_i64@seq_pre(vacated) == 1253
    produces
        pure declined and unchanged and vacant_declined
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@tree_1_2_4_5_3();
                p0: List[int64, mem(normal)] <- tree_rose@path_root();
                p01: List[int64, mem(normal)] <- tree_rose@path_with(tree_rose@path_with(p0, 0), 1);
                at_root: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@replace(t, p0, 9);
                deep: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- rt_trial_i64@replace(t, p01, 8);
                s_root: int64 <- rt_trial_i64@seq_pre(at_root);
                s_deep: int64 <- rt_trial_i64@seq_pre(deep);
                s_old: int64 <- rt_trial_i64@seq_pre(t);
                f: boolean <- found_paths();
                m: boolean <- missing_paths();
                println("replaced_root");
                print_int64(s_root);
                println("");
                println("replaced_deep");
                print_int64(s_deep);
                println("");
                println("original");
                print_int64(s_old);
                println("")
            produces
                pure pick(f, 1, pick(m, 2, 0))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
