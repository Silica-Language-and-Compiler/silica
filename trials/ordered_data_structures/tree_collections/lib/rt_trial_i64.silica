    r.changed
}

// The path of `depth` zero slots (the spine of a chain).
fn path_chain(depth: int64) -> List[int64, mem(normal)] {
    case depth <= 0 of {
        true -> tree_rose@path_root();
        false -> tree_rose@path_with(path_chain(depth - 1), 0)
    }
}

fn path_code_go(path: List[int64, mem(normal)], acc: int64) -> int64 {
    case path.is_nil of {
        true -> acc;
        false -> path_code_go(path.tail, acc * 10 + path.head)
    }
}

fn path_code(path: List[int64, mem(normal)]) -> int64 {
    path_code_go(path, 1)
}

fn found_is(res: { status: :not_found | :found, value: int64 }, expected: int64) -> boolean {
    case res.status of {
        :found -> res.value == expected;
        :not_found -> false
    }
}

fn is_not_found(res: { status: :not_found | :found, value: int64 }) -> boolean {
    case res.status of {
        :found -> false;
        :not_found -> true
    }
}

fn get_is(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)], expected: int64) -> boolean {
    found_is(tree_rose@get(tree, path, 0), expected)
}

fn get_missing(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)]) -> boolean {
    is_not_found(tree_rose@get(tree, path, 0))
}

fn child_is(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)], slot: int64, expected: int64) -> boolean {
    r: { status: :not_found | :found, value: int64, child_path: List[int64, mem(normal)] } <- tree_rose@child_at(tree, path, slot, 0);
    case r.status of {
        :found -> r.value == expected;
        :not_found -> false
    }
}

fn child_missing(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)], slot: int64) -> boolean {
    r: { status: :not_found | :found, value: int64, child_path: List[int64, mem(normal)] } <- tree_rose@child_at(tree, path, slot, 0);
    case r.status of {
        :found -> false;
        :not_found -> true
    }
}

// The code of child_at's child_path, -1 when the child is missing.
fn child_path_code(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)], slot: int64) -> int64 {
    r: { status: :not_found | :found, value: int64, child_path: List[int64, mem(normal)] } <- tree_rose@child_at(tree, path, slot, 0);
    case r.status of {
        :found -> path_code(r.child_path);
        :not_found -> -1
    }
}

// child_count at a path, -1 when the path is missing.
fn child_count_of(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)]) -> int64 {
    r: { status: :not_found | :found, count: int64 } <- tree_rose@child_count(tree, path);
    case r.status of {
        :found -> r.count;
        :not_found -> -1
    }
}

fn slot_count_of(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)]) -> int64 {
    r: { status: :not_found | :found, count: int64 } <- tree_rose@child_slot_count(tree, path);
    case r.status of {
        :found -> r.count;
        :not_found -> -1
    }
}

// Single-digit items concatenated in visit order: 1(2, 3) in preorder is 123.
fn digit_step(acc: int64, _: List[int64, mem(normal)], item: int64) -> int64 {
    acc * 10 + item
}

fn seq_pre(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> int64 {
    tree_rose@fold_preorder(tree, 0, digit_step)
}

fn sum_step(acc: int64, _: List[int64, mem(normal)], item: int64) -> int64 {
    acc + item
}

fn sum_of(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> int64 {
    tree_rose@fold_preorder(tree, 0, sum_step)
}

fn count_step(acc: int64, _: List[int64, mem(normal)], _: int64) -> int64 {
    acc + 1
}

fn count_visited(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> int64 {
    tree_rose@fold_preorder(tree, 0, count_step)
}

// Sum of the path codes handed to a preorder fold.
fn path_code_step(acc: int64, path: List[int64, mem(normal)], _: int64) -> int64 {
    acc + path_code(path)
}

fn paths_pre(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> int64 {
    tree_rose@fold_preorder(tree, 0, path_code_step)
}

// Sum over every visited node of its depth (the length of the path handed to the callback).
fn depth_step(acc: int64, path: List[int64, mem(normal)], _: int64) -> int64 {
    acc + tree_rose@path_length(path)
}

fn depth_sum(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> int64 {
    tree_rose@fold_preorder(tree, 0, depth_step)
}

// The last item when the (non-negative) preorder items strictly ascend, -1 as soon as one does
// not; -2 is the not-started accumulator.
fn ascending_step(acc: int64, _: List[int64, mem(normal)], item: int64) -> int64 {
    case acc == -2 of {
        true -> item;
        false -> case acc == -1 of {
            true -> -1;
            false -> case item > acc of {
                true -> item;
                false -> -1
            }
        }
    }
}

fn ascending_tail(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> int64 {
    tree_rose@fold_preorder(tree, -2, ascending_step)
}

// find_first's path code, -1 when not found.
fn find_code(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, item: int64) -> int64 {
    r: { status: :not_found | :found, value: int64, path: List[int64, mem(normal)] } <- tree_rose@find_first(tree, item, 0);
    case r.status of {
        :found -> path_code(r.path);
        :not_found -> -1
    }
}

fn find_value(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, item: int64) -> int64 {
    r: { status: :not_found | :found, value: int64, path: List[int64, mem(normal)] } <- tree_rose@find_first(tree, item, 0);
    case r.status of {
        :found -> r.value;
        :not_found -> -1
    }
}

fn valid_count(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, n: int64) -> boolean {
    v: { valid: boolean, error: atom, logical_count: int64 } <- tree_rose@validate(tree);
    case v.valid of {
        false -> false;
        true -> v.logical_count == n
    }
}

// validate's error atoms are decoded by the unit that creates them (atoms are numbered per unit).
fn error_code_of(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> int64 {
    v: { valid: boolean, error: atom, logical_count: int64 } <- tree_rose@validate(tree);
    tree_rose@validate_error_code(v.error)
}

fn chain_go(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, i: int64, n: int64, depth: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    case i > n of {
        true -> tree;
        false -> chain_go(add(tree, path_chain(depth), i), i + 1, n, depth + 1)
    }
}

// Items 1..n down one spine: root 1, its slot-0 child 2, ..., item i at depth i - 1.
fn chain(n: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    chain_go(new_tree(1), 2, n, 0)
}

fn fan_go(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, i: int64, n: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    case i > n of {
        true -> tree;
        false -> fan_go(add(tree, tree_rose@path_root(), i), i + 1, n)
    }
}

// Root 0 with children 1..n appended in order, so slot s holds s + 1.
fn fan(n: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    fan_go(new_tree(0), 1, n)
}

fn gets_match_go(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, i: int64, n: int64) -> boolean {
    case i >= n of {
        true -> true;
        false -> case get_is(tree, tree_rose@path_with(tree_rose@path_root(), i), i + 1) of {
            false -> false;
            true -> gets_match_go(tree, i + 1, n)
        }
    }
}

// Every root slot s in [0, n) holds s + 1 (a fan that lost no child).
fn gets_match(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, n: int64) -> boolean {
    gets_match_go(tree, 0, n)
}

// 1(2(4, 5), 3): slots 0 and 1 at the root, slots 0 and 1 under 2. Preorder 12453.
fn tree_1_2_4_5_3() -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    sequence proc[mem(normal)]
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        pa: List[int64, mem(normal)] <- [0];
        t1: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- new_tree(1);
        t2: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- add(t1, p0, 2);
        t3: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- add(t2, p0, 3);
        t4: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- add(t3, pa, 4);
        t5: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- add(t4, pa, 5)
    produces
        pure t5
    end
}
