// Trial-only int64 helpers for tree_collections: constructors, shape builders, path codes,
// result checks, and fold-based sequences. Fold callbacks must be local to the module that passes
// them, so every fold-based check lives here. Items are single digits where a fold concatenates
// them (seq_pre), so the printed traversal reads as the visit order. Path codes are a leading 1
// followed by the slot digits: root 1, [0] 10, [1, 0] 110, [0, 2] 102 (slots below 10 only).
//
// The comparator is the ItemType witness tree_rose resolves at every qualified call; find_first
// and compare_item are the only operations that call it.

use tree_rose;

export cmp_i64/2;
export cmp_mod10/2;
export cmp_other/2;
export new_tree/1;
export new_tree_mod10/1;
export new_tree_other/1;
export add/3;
export add_slot/3;
export add_sub/3;
export add_sub_slot/3;
export add_sub_compatible/3;
export remove/3;
export remove_count/3;
export replace/3;
export replace_ok/3;
export path_chain/1;
export path_code/1;
export found_is/2;
export is_not_found/1;
export get_is/3;
export get_missing/2;
export child_is/4;
export child_missing/3;
export child_path_code/3;
export child_count_of/2;
export slot_count_of/2;
export seq_pre/1;
export sum_of/1;
export count_visited/1;
export paths_pre/1;
export depth_sum/1;
export ascending_tail/1;
export find_code/2;
export find_value/2;
export valid_count/2;
export error_code_of/1;
export chain/1;
export fan/1;
export gets_match/2;
export tree_1_2_4_5_3/0;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

// Items are equal when their last decimal digits agree (comparator equality is tree identity).
fn cmp_mod10(a: int64, b: int64) -> :less | :equal | :greater {
    cmp_i64(a - (a / 10) * 10, b - (b / 10) * 10)
}

// A second comparator symbol: behaviourally cmp_i64, a different ordering identity.
fn cmp_other(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn new_tree(item: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    tree_rose@with_root({ compare_item: cmp_i64 }, item)
}

fn new_tree_mod10(item: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    tree_rose@with_root({ compare_item: cmp_mod10 }, item)
}

fn new_tree_other(item: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    tree_rose@with_root({ compare_item: cmp_other }, item)
}

// add_leaf's tree (the old tree when the parent is missing).
fn add(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)], item: int64) -> {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    r: { tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, added: boolean, child_slot: int64 } <- tree_rose@add_leaf(tree, path, item);
    r.tree
}

// add_leaf's slot, -1 when nothing was added.
fn add_slot(tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, path: List[int64, mem(normal)], item: int64) -> int64 {
    r: { tree: {
        root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, added: boolean, child_slot: int64 } <- tree_rose@add_leaf(tree, path, item);
    case r.added of {
        true -> r.child_slot;
        false -> -1
    }
}

