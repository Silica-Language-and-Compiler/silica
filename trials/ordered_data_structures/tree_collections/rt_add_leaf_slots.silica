// tree_trait.md §8: add_child (add_leaf here, see the tree_rose header) appends a one-node subtree
// whose slot is the parent's old slot count; slots are assigned in append order at every node;
// a missing parent path answers added = false with the old tree. Built here:
// 1(2, 3(5, 6), 4(7)) with slots 0,1,2 at the root, 0,1 under 3 and 0 under 4. Preorder 1235647;
// path codes 1 + 10 + 11 + 110 + 111 + 12 + 120 = 375.

use tree_rose;
use rt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}
fn build() -> {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } {
    sequence proc[mem(normal)]
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        p1: List[int64, mem(normal)] <- [1];
        p2: List[int64, mem(normal)] <- [2];
        t1: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@new_tree(1);
        t2: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t1, p0, 2);
        t3: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t2, p0, 3);
        t4: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t3, p0, 4);
        t5: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t4, p1, 5);
        t6: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t5, p1, 6);
        t7: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t6, p2, 7)
    produces
        pure t7
    end
}

fn slots_in_order() -> boolean {
    sequence proc[mem(normal)]
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        p1: List[int64, mem(normal)] <- [1];
        t1: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@new_tree(1);
        s0: int64 <- rt_trial_i64@add_slot(t1, p0, 2);
        t2: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t1, p0, 2);
        s1: int64 <- rt_trial_i64@add_slot(t2, p0, 3);
        t3: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t2, p0, 3);
        s2: int64 <- rt_trial_i64@add_slot(t3, p0, 4);
        t4: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t3, p0, 4);
        s10: int64 <- rt_trial_i64@add_slot(t4, p1, 5);
        t5: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t4, p1, 5);
        s11: int64 <- rt_trial_i64@add_slot(t5, p1, 6)
    produces
        pure s0 == 0 and s1 == 1 and s2 == 2 and s10 == 0 and s11 == 1
    end
}

fn shape() -> boolean {
    sequence proc[mem(normal)]
        t: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- build();
        p0: List[int64, mem(normal)] <- tree_rose@path_root();
        p1: List[int64, mem(normal)] <- [1];
        p11: List[int64, mem(normal)] <- [1, 1];
        p20: List[int64, mem(normal)] <- [2, 0];
        count_ok: boolean <- tree_rose@node_count(t) == 7 and rt_trial_i64@count_visited(t) == 7;
        root_ok: boolean <- rt_trial_i64@child_count_of(t, p0) == 3 and rt_trial_i64@slot_count_of(t, p0) == 3;
        inner_ok: boolean <- rt_trial_i64@child_count_of(t, p1) == 2 and rt_trial_i64@slot_count_of(t, p1) == 2
            and rt_trial_i64@child_count_of(t, p11) == 0;
        get_ok: boolean <- rt_trial_i64@get_is(t, p11, 6) and rt_trial_i64@get_is(t, p20, 7)
            and rt_trial_i64@child_is(t, p0, 2, 4) and rt_trial_i64@child_path_code(t, p1, 1) == 111;
        fold_ok: boolean <- rt_trial_i64@seq_pre(t) == 1235647 and rt_trial_i64@paths_pre(t) == 375
            and rt_trial_i64@depth_sum(t) == 9;
        valid_ok: boolean <- rt_trial_i64@valid_count(t, 7)
    produces
        pure count_ok and root_ok and inner_ok and get_ok and fold_ok and valid_ok
    end
}

fn missing_parent() -> boolean {
    sequence proc[mem(normal)]
        t: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- build();
        p5: List[int64, mem(normal)] <- [5];
        p100: List[int64, mem(normal)] <- [1, 0, 0];
        pneg: List[int64, mem(normal)] <- [-1];
        same: {
            root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- rt_trial_i64@add(t, p5, 9);
        declined: boolean <- rt_trial_i64@add_slot(t, p5, 9) == -1 and rt_trial_i64@add_slot(t, p100, 9) == -1
            and rt_trial_i64@add_slot(t, pneg, 9) == -1;
        unchanged: boolean <- tree_rose@node_count(same) == 7 and rt_trial_i64@seq_pre(same) == 1235647
    produces
        pure declined and unchanged
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal), device_io]
                t: {
                    root: ref?(L, normal, (int64, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_item_ordering_bundle: int64
                } <- build();
                n: int64 <- tree_rose@node_count(t);
                s: int64 <- rt_trial_i64@seq_pre(t);
                p: int64 <- rt_trial_i64@paths_pre(t);
                a: boolean <- slots_in_order();
                b: boolean <- shape();
                c: boolean <- missing_parent();
                println("node_count");
                print_int64(n);
                println("");
                println("preorder");
                print_int64(s);
                println("");
                println("path_codes");
                print_int64(p);
                println("")
            produces
                pure pick(a, 1, pick(b, 2, pick(c, 3, 0)))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
