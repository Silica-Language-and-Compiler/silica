// binary_tree_trait.md §11 and persistent_binary_tree.md §8: replace_left/replace_right install a
// compatible whole tree in exactly one fixed role of the node at parent_path, preserve the
// opposite child by reference and recompute counts along the copied path; an empty subtree clears
// the child; clear_left/clear_right are that replacement with the empty tree. Nothing promotes a
// grandchild or moves a child across roles. Clearing an already-empty child and any missing
// parent path return the old tree with changed = false. Fixture 1(2(4, 5), 3(6, 7)).

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn replace_subtrees() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        p2: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(2);
        eight: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(8);
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        zero: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(0);
        nine: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@node_of(9, zero, e);
        rl: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p0, eight);
        rr: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_right(base, p2, nine);
        rl_ok: boolean <- rl.changed and rl.compatible and bt_trial_i64@seq_pre(rl.tree) == 18367
            and tree_binary@node_count(rl.tree) == 5 and bt_trial_i64@right_is(rl.tree, 0, 3)
            and bt_trial_i64@left_is(rl.tree, 0, 8) and bt_trial_i64@valid_count(rl.tree, 5);
        rr_ok: boolean <- rr.changed and rr.compatible and bt_trial_i64@seq_pre(rr.tree) == 12453690
            and tree_binary@node_count(rr.tree) == 8 and bt_trial_i64@get_is(rr.tree, 221, 0)
            and bt_trial_i64@left_is(rr.tree, 2, 6) and bt_trial_i64@valid_count(rr.tree, 8);
        base_ok: boolean <- bt_trial_i64@seq_pre(base) == 1245367 and tree_binary@node_count(base) == 7
            and tree_binary@node_count(nine) == 2 and tree_binary@node_count(eight) == 1
    produces
        pure rl_ok and rr_ok and base_ok
    end
}

fn clear_children() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        p1: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(1);
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        rl2: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p1, e);
        cl: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_left(base, p1);
        cr: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_right(base, p0);
        cl0: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_left(base, p0);
        rl2_ok: boolean <- rl2.changed and rl2.compatible and bt_trial_i64@seq_pre(rl2.tree) == 125367
            and tree_binary@node_count(rl2.tree) == 6 and bt_trial_i64@get_missing(rl2.tree, 11)
            and bt_trial_i64@get_is(rl2.tree, 12, 5) and bt_trial_i64@left_missing(rl2.tree, 1) and bt_trial_i64@right_is(rl2.tree, 1, 5);
        cl_ok: boolean <- cl.changed and bt_trial_i64@seq_pre(cl.tree) == 125367 and tree_binary@node_count(cl.tree) == 6;
        cr_ok: boolean <- cr.changed and bt_trial_i64@seq_pre(cr.tree) == 1245 and tree_binary@node_count(cr.tree) == 4
            and bt_trial_i64@right_missing(cr.tree, 0) and bt_trial_i64@left_is(cr.tree, 0, 2);
        cl0_ok: boolean <- cl0.changed and bt_trial_i64@seq_pre(cl0.tree) == 1367 and tree_binary@node_count(cl0.tree) == 4
            and bt_trial_i64@left_missing(cl0.tree, 0) and bt_trial_i64@right_is(cl0.tree, 0, 3)
            and bt_trial_i64@get_missing(cl0.tree, 1) and bt_trial_i64@get_is(cl0.tree, 21, 6);
        valid_ok: boolean <- bt_trial_i64@valid_count(cl.tree, 6) and bt_trial_i64@valid_count(cr.tree, 4)
            and bt_trial_i64@valid_count(cl0.tree, 4) and bt_trial_i64@valid_count(base, 7)
    produces
        pure rl2_ok and cl_ok and cr_ok and cl0_ok and valid_ok
    end
}

fn already_empty_and_missing() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p1: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(1);
        p111: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(111);
        p222: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(222);
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        eight: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(8);
        rl2: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p1, e);
        again: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_left(rl2.tree, p1);
        again2: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(rl2.tree, p1, e);
        m1: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_left(base, p111);
        m2: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_right(base, p222, eight);
        m3: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_right(base, p222);
        again_ok: boolean <- again.changed == false and bt_trial_i64@seq_pre(again.tree) == 125367
            and again2.changed == false and again2.compatible and bt_trial_i64@seq_pre(again2.tree) == 125367
            and tree_binary@node_count(again.tree) == 6;
        missing_ok: boolean <- m1.changed == false and m2.changed == false and m2.compatible and m3.changed == false
            and bt_trial_i64@seq_pre(m1.tree) == 1245367 and bt_trial_i64@seq_pre(m2.tree) == 1245367
            and bt_trial_i64@seq_pre(m3.tree) == 1245367
    produces
        pure again_ok and missing_ok
    end
}

// Grafting a 7-node tree as the left child of node 3 (replacing leaf 6): 7 - 1 + 7 = 13 nodes.
fn counts_recomputed() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        c7: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p2: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(2);
        big: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p2, c7);
        big_ok: boolean <- big.changed and big.compatible and tree_binary@node_count(big.tree) == 13
            and bt_trial_i64@seq_pre(big.tree) == 1245312453677 and bt_trial_i64@valid_count(big.tree, 13)
            and bt_trial_i64@get_is(big.tree, 2111, 4) and bt_trial_i64@right_is(big.tree, 2, 7)
            and bt_trial_i64@get_is(big.tree, 21, 1);
        inputs_ok: boolean <- tree_binary@node_count(base) == 7 and tree_binary@node_count(c7) == 7
            and bt_trial_i64@valid_count(c7, 7)
    produces
        pure big_ok and inputs_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                base: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@complete7();
                p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
                p1: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(1);
                eight: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@leaf(8);
                rl: { tree: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p0, eight);
                cl: { tree: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                }, changed: boolean } <- tree_binary@clear_left(base, p1);
                cr: { tree: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                }, changed: boolean } <- tree_binary@clear_right(base, p0);
                pre_rl: int64 <- bt_trial_i64@seq_pre(rl.tree);
                pre_cl: int64 <- bt_trial_i64@seq_pre(cl.tree);
                pre_cr: int64 <- bt_trial_i64@seq_pre(cr.tree);
                rs: boolean <- replace_subtrees();
                cc: boolean <- clear_children();
                am: boolean <- already_empty_and_missing();
                cn: boolean <- counts_recomputed();
                println("left_replaced");
                print_int64(pre_rl);
                println("");
                println("left_cleared_at_2");
                print_int64(pre_cl);
                println("");
                println("right_cleared_at_root");
                print_int64(pre_cr);
                println("")
            produces
                pure pick(rs, 1, pick(cc, 2, pick(am, 3, pick(cn, 4, 0))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
