// binary_tree_trait.md §11 and persistent_binary_tree.md §8: replace_left/replace_right install a
// compatible whole tree in exactly one fixed role of the node at parent_path, preserve the
// opposite child by reference and recompute counts along the copied path; an empty subtree clears
// the child; clear_left/clear_right are that replacement with the empty tree. Nothing promotes a
// grandchild or moves a child across roles. Clearing an already-empty child and any missing
// parent path return the old tree with changed = false. Fixture 1(2(4, 5), 3(6, 7)).

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn replace_subtrees() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        p2: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(2);
        eight: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@leaf(8);
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        zero: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@leaf(0);
        nine: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@node_of(9, zero, e);
        rl: :unchanged | :incompatible | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@replace_left(base, p0, eight);
        rl_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case rl of {
            :unchanged -> base;
            :incompatible -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        rl_changed: boolean <- case rl of {
            :unchanged -> false;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        rl_compatible: boolean <- case rl of {
            :unchanged -> true;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        rr: :unchanged | :incompatible | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@replace_right(base, p2, nine);
        rr_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case rr of {
            :unchanged -> base;
            :incompatible -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        rr_changed: boolean <- case rr of {
            :unchanged -> false;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        rr_compatible: boolean <- case rr of {
            :unchanged -> true;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        rl_ok: boolean <- rl_changed and rl_compatible and bt_trial_i64@seq_pre(rl_tree) == 18367
            and tree_binary@node_count(rl_tree) == 5 and bt_trial_i64@right_is(rl_tree, 0, 3)
            and bt_trial_i64@left_is(rl_tree, 0, 8) and bt_trial_i64@valid_count(rl_tree, 5);
        rr_ok: boolean <- rr_changed and rr_compatible and bt_trial_i64@seq_pre(rr_tree) == 12453690
            and tree_binary@node_count(rr_tree) == 8 and bt_trial_i64@get_is(rr_tree, 221, 0)
            and bt_trial_i64@left_is(rr_tree, 2, 6) and bt_trial_i64@valid_count(rr_tree, 8);
        base_ok: boolean <- bt_trial_i64@seq_pre(base) == 1245367 and tree_binary@node_count(base) == 7
            and tree_binary@node_count(nine) == 2 and tree_binary@node_count(eight) == 1
    produces
        pure rl_ok and rr_ok and base_ok
    end
}

fn clear_children() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        p1: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(1);
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        rl2: :unchanged | :incompatible | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@replace_left(base, p1, e);
        rl2_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case rl2 of {
            :unchanged -> base;
            :incompatible -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        rl2_changed: boolean <- case rl2 of {
            :unchanged -> false;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        rl2_compatible: boolean <- case rl2 of {
            :unchanged -> true;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        cl: :unchanged | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@clear_left(base, p1);
        cl_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case cl of {
            :unchanged -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        cl_changed: boolean <- case cl of {
            :unchanged -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        cr: :unchanged | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@clear_right(base, p0);
        cr_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case cr of {
            :unchanged -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        cr_changed: boolean <- case cr of {
            :unchanged -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        cl0: :unchanged | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@clear_left(base, p0);
        cl0_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case cl0 of {
            :unchanged -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        cl0_changed: boolean <- case cl0 of {
            :unchanged -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        rl2_ok: boolean <- rl2_changed and rl2_compatible and bt_trial_i64@seq_pre(rl2_tree) == 125367
            and tree_binary@node_count(rl2_tree) == 6 and bt_trial_i64@get_missing(rl2_tree, 11)
            and bt_trial_i64@get_is(rl2_tree, 12, 5) and bt_trial_i64@left_missing(rl2_tree, 1) and bt_trial_i64@right_is(rl2_tree, 1, 5);
        cl_ok: boolean <- cl_changed and bt_trial_i64@seq_pre(cl_tree) == 125367 and tree_binary@node_count(cl_tree) == 6;
        cr_ok: boolean <- cr_changed and bt_trial_i64@seq_pre(cr_tree) == 1245 and tree_binary@node_count(cr_tree) == 4
            and bt_trial_i64@right_missing(cr_tree, 0) and bt_trial_i64@left_is(cr_tree, 0, 2);
        cl0_ok: boolean <- cl0_changed and bt_trial_i64@seq_pre(cl0_tree) == 1367 and tree_binary@node_count(cl0_tree) == 4
            and bt_trial_i64@left_missing(cl0_tree, 0) and bt_trial_i64@right_is(cl0_tree, 0, 3)
            and bt_trial_i64@get_missing(cl0_tree, 1) and bt_trial_i64@get_is(cl0_tree, 21, 6);
        valid_ok: boolean <- bt_trial_i64@valid_count(cl_tree, 6) and bt_trial_i64@valid_count(cr_tree, 4)
            and bt_trial_i64@valid_count(cl0_tree, 4) and bt_trial_i64@valid_count(base, 7)
    produces
        pure rl2_ok and cl_ok and cr_ok and cl0_ok and valid_ok
    end
}

fn already_empty_and_missing() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p1: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(1);
        p111: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(111);
        p222: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(222);
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        eight: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@leaf(8);
        rl2: :unchanged | :incompatible | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@replace_left(base, p1, e);
        rl2_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case rl2 of {
            :unchanged -> base;
            :incompatible -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        again: :unchanged | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@clear_left(rl2_tree, p1);
        again_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case again of {
            :unchanged -> rl2_tree;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        again_changed: boolean <- case again of {
            :unchanged -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        again2: :unchanged | :incompatible | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@replace_left(rl2_tree, p1, e);
        again2_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case again2 of {
            :unchanged -> rl2_tree;
            :incompatible -> rl2_tree;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        again2_changed: boolean <- case again2 of {
            :unchanged -> false;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        again2_compatible: boolean <- case again2 of {
            :unchanged -> true;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        m1: :unchanged | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@clear_left(base, p111);
        m1_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case m1 of {
            :unchanged -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        m1_changed: boolean <- case m1 of {
            :unchanged -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        m2: :unchanged | :incompatible | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@replace_right(base, p222, eight);
        m2_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case m2 of {
            :unchanged -> base;
            :incompatible -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        m2_changed: boolean <- case m2 of {
            :unchanged -> false;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        m2_compatible: boolean <- case m2 of {
            :unchanged -> true;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        m3: :unchanged | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@clear_right(base, p222);
        m3_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case m3 of {
            :unchanged -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        m3_changed: boolean <- case m3 of {
            :unchanged -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        again_ok: boolean <- again_changed == false and bt_trial_i64@seq_pre(again_tree) == 125367
            and again2_changed == false and again2_compatible and bt_trial_i64@seq_pre(again2_tree) == 125367
            and tree_binary@node_count(again_tree) == 6;
        missing_ok: boolean <- m1_changed == false and m2_changed == false and m2_compatible and m3_changed == false
            and bt_trial_i64@seq_pre(m1_tree) == 1245367 and bt_trial_i64@seq_pre(m2_tree) == 1245367
            and bt_trial_i64@seq_pre(m3_tree) == 1245367
    produces
        pure again_ok and missing_ok
    end
}

// Grafting a 7-node tree as the left child of node 3 (replacing leaf 6): 7 - 1 + 7 = 13 nodes.
fn counts_recomputed() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        c7: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p2: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(2);
        big: :unchanged | :incompatible | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@replace_left(base, p2, c7);
        big_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case big of {
            :unchanged -> base;
            :incompatible -> base;
            (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
        };
        big_changed: boolean <- case big of {
            :unchanged -> false;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        big_compatible: boolean <- case big of {
            :unchanged -> true;
            :incompatible -> false;
            (:changed, _v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> true
        };
        big_ok: boolean <- big_changed and big_compatible and tree_binary@node_count(big_tree) == 13
            and bt_trial_i64@seq_pre(big_tree) == 1245312453677 and bt_trial_i64@valid_count(big_tree, 13)
            and bt_trial_i64@get_is(big_tree, 2111, 4) and bt_trial_i64@right_is(big_tree, 2, 7)
            and bt_trial_i64@get_is(big_tree, 21, 1);
        inputs_ok: boolean <- tree_binary@node_count(base) == 7 and tree_binary@node_count(c7) == 7
            and bt_trial_i64@valid_count(c7, 7)
    produces
        pure big_ok and inputs_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                base: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64
                } <- bt_trial_i64@complete7();
                p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
                p1: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(1);
                eight: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64
                } <- bt_trial_i64@leaf(8);
                rl: :unchanged | :incompatible | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@replace_left(base, p0, eight);
                rl_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case rl of {
                    :unchanged -> base;
                    :incompatible -> base;
                    (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
                };
                cl: :unchanged | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@clear_left(base, p1);
                cl_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case cl of {
                    :unchanged -> base;
                    (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
                };
                cr: :unchanged | (:changed, { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) <- tree_binary@clear_right(base, p0);
                cr_tree: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 } <- case cr of {
                    :unchanged -> base;
                    (:changed, v_changed: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64 }) -> v_changed
                };
                pre_rl: int64 <- bt_trial_i64@seq_pre(rl_tree);
                pre_cl: int64 <- bt_trial_i64@seq_pre(cl_tree);
                pre_cr: int64 <- bt_trial_i64@seq_pre(cr_tree);
                rs: boolean <- replace_subtrees();
                cc: boolean <- clear_children();
                am: boolean <- already_empty_and_missing();
                cn: boolean <- counts_recomputed();
                println("left_replaced");
                print_int64(pre_rl);
                println("");
                println("left_cleared_at_2");
                print_int64(pre_cl);
                println("");
                println("right_cleared_at_root");
                print_int64(pre_cr);
                println("")
            produces
                pure pick(rs, 1, pick(cc, 2, pick(am, 3, pick(cn, 4, 0))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
