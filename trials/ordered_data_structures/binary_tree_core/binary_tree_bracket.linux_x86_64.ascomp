    cmp r9, r8
    jbe Lcmp_minok
    mov r9, r8
Lcmp_minok:
    test r9, r9
    jz Lcmp_len
    mov r10, r13
    mov r11, r15
Lcmp_cloop:
    movzx ecx, BYTE PTR [r10]
    add r10, 1
    movzx esi, BYTE PTR [r11]
    add r11, 1
    cmp ecx, esi
    jb Lcmp_lt
    ja Lcmp_gt
    sub r9, 1
    jne Lcmp_cloop
Lcmp_len:
    cmp r14, r8
    je Lcmp_eq
    jb Lcmp_lt
    jmp Lcmp_gt
Lcmp_anull:
    test r12, r12
    jz Lcmp_eq
Lcmp_lt:
    mov edi, -1
    jmp Lcmp_exit
Lcmp_gt:
    mov edi, 1
    jmp Lcmp_exit
Lcmp_eq:
    xor edi, edi
Lcmp_exit:
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbx
    pop rbp
    ret
