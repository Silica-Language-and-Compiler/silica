    mov rbx, rdi
    mov r12, rsi
    test rbx, rbx
    jz Lcmp_anull
    test r12, r12
    jz Lcmp_gt
    mov rsi, QWORD PTR [rbx]
    mov rdx, -1
    cmp rsi, rdx
    jne Lcmp_bad
    mov r13, QWORD PTR [rbx + 8]
    mov r14, QWORD PTR [rbx + 16]
    mov rsi, QWORD PTR [r12]
