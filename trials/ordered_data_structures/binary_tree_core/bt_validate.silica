// persistent_binary_tree.md §13–§15 and binary_tree_trait.md §15: validate is a postorder walk
// that checks arena membership and active-path acyclicity before descending, then every cached
// count against 1 + the exact child counts with checked arithmetic. Malformed fixtures are built
// directly against the representation. Error codes (tree_binary@validate_error_code): 0 ok,
// 1 cycle, 2 wrong_arena, 5 negative_count, 6 size_mismatch, 9 count_overflow. Chunk 15 phase 2 (P7):
// ref_in_region is retired, the validator cannot tell arenas apart (code 2 is never produced), so the
// wrong_arena fixture, its printed line and the arena group were removed. Legal physical
// sharing validates with the per-occurrence count; count_preflight mirrors the smart constructor's
// checked arithmetic.
// Chunk 15 phase 5 (5b): the fixtures are allocated with the region-less alloc_rec (design §8.1);
// no family arena is looked up and no region handle is threaded through the helpers.

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

// Allocators return the ref? alone: the cell is allocated in this frame and adopted by the caller.
fn cell(
    v: int64,
    count: int64,
    left: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec((v, count, left, right))
    produces
        pure c
    end
}

fn leaf(v: int64) -> ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    cell(v, 1, :none, :none)
}

fn tree_of(root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } {
    out: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- { root: root, compare_item: cmp_i64, specialization_key: 0 };
    out
}

fn code_of(root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> int64 {
    t: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- tree_of(root);
    bt_trial_i64@error_code_of(t)
}

fn valid_cases() -> boolean {
    sequence
        l1: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(2);
        l2: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(3);
        n3: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 3, l1, l2);
        empty_t: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- tree_of(:none);
        node_t: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- tree_of(n3);
        ok0: boolean <- code_of(:none) == 0 and bt_trial_i64@valid_count(empty_t, 0);
        ok1: boolean <- code_of(l1) == 0;
        ok3: boolean <- code_of(n3) == 0 and bt_trial_i64@valid_count(node_t, 3) and tree_binary@node_count(node_t) == 3
            and bt_trial_i64@seq_pre(node_t) == 123
    produces
        pure ok0 and ok1 and ok3
    end
}

fn negative_cases() -> boolean {
    sequence
        neg: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, -5, :none, :none);
        zero: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 0, :none, :none);
        neg_ok: boolean <- code_of(neg) == 5;
        zero_ok: boolean <- code_of(zero) == 5
    produces
        pure neg_ok and zero_ok
    end
}

// node_count reads the cached root count (7) even though validation rejects it.
fn mismatch_cases() -> boolean {
    sequence
        l1: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(2);
        l2: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(3);
        big: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 7, l1, l2);
        small: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 2, l1, l2);
        big_t: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- tree_of(big);
        big_ok: boolean <- code_of(big) == 6 and tree_binary@node_count(big_t) == 7;
        small_ok: boolean <- code_of(small) == 6
    produces
        pure big_ok and small_ok
    end
}

fn count_cases() -> boolean {
    negative_cases() and mismatch_cases()
}

// The walk is postorder: a child's violation is reported before its parent's, and a parent whose
// cached count agrees with a wrong child count is caught through the child.
fn nested_cases() -> boolean {
    sequence
        l1: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(2);
        l2: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(3);
        bad: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(2, 0, :none, :none);
        parent: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 99, bad, l2);
        inner: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(2, 9, l1, :none);
        outer: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 11, inner, l2);
        child_first: boolean <- code_of(parent) == 5;
        through_child: boolean <- code_of(outer) == 6
    produces
        pure child_first and through_child
    end
}

// a.left = b and b.left = a (built with write_ref): the walk reaches a again while a is on the
// active path and stops with :cycle.
fn cycle_code() -> int64 {
    sequence proc[mem(normal)]
        a: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec((5, 1, :none, :none));
        b: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec((6, 2, a, :none));
        _: atom <- write_ref(a, (5, 3, b, :none));
        t: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- tree_of(a)
    produces
        pure bt_trial_i64@error_code_of(t)
    end
}

fn shared_case() -> boolean {
    sequence
        four: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@leaf(4);
        five: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@leaf(5);
        sub: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@node_of(2, four, five);
        t: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- bt_trial_i64@node_of(1, sub, sub);
        ok: boolean <- bt_trial_i64@valid_count(t, 7) and bt_trial_i64@error_code_of(t) == 0
    produces
        pure ok
    end
}

// count_preflight's atoms are decoded by the unit that creates them (atoms are numbered per unit).
fn preflight_code(a: int64, b: int64) -> int64 {
    tree_binary@validate_error_code(tree_binary@count_preflight(a, b))
}

fn preflight() -> boolean {
    preflight_code(0, 0) == 0 and preflight_code(3, 4) == 0 and preflight_code(-1, 0) == 5 and preflight_code(0, -1) == 5
        and preflight_code(4611686018427387904, 4611686018427387904) == 9
        and preflight_code(9223372036854775807, 0) == 9
        and preflight_code(4611686018427387904, 4611686018427387903) == 9
        and preflight_code(4611686018427387903, 4611686018427387903) == 0
}

fn neg_code() -> int64 {
    sequence
        neg: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, -5, :none, :none)
    produces
        pure code_of(neg)
    end
}

fn mismatch_code() -> int64 {
    sequence
        l1: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- leaf(2);
        big: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 7, l1, :none)
    produces
        pure code_of(big)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64
                } <- bt_trial_i64@complete7();
                valid_code: int64 <- bt_trial_i64@error_code_of(t);
                negative: int64 <- neg_code();
                mismatch: int64 <- mismatch_code();
                cycle: int64 <- cycle_code();
                overflow: int64 <- preflight_code(9223372036854775807, 0);
                vc: boolean <- valid_cases();
                cc: boolean <- count_cases();
                nc: boolean <- nested_cases();
                sc: boolean <- shared_case();
                pf: boolean <- preflight();
                println("valid");
                print_int64(valid_code);
                println("");
                println("negative_count");
                print_int64(negative);
                println("");
                println("size_mismatch");
                print_int64(mismatch);
                println("");
                println("cycle");
                print_int64(cycle);
                println("");
                println("count_overflow");
                print_int64(overflow);
                println("")
            produces
                pure pick(vc, 1, pick(cc, 2, pick(nc, 3, pick(sc, 4, pick(pf, 5, pick(cycle == 1, 6, 0))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
