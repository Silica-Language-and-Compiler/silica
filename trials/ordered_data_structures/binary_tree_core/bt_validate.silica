// persistent_binary_tree.md §13–§15 and binary_tree_trait.md §15: validate is a postorder walk
// that checks arena membership and active-path acyclicity before descending, then every cached
// count against 1 + the exact child counts with checked arithmetic. Malformed fixtures are built
// directly against the representation. Error codes (tree_binary@validate_error_code): 0 ok,
// 1 cycle, 2 wrong_arena, 5 negative_count, 6 size_mismatch, 9 count_overflow. Legal physical
// sharing validates with the per-occurrence count; count_preflight mirrors the smart constructor's
// checked arithmetic.

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn arena() -> region(L, normal) {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        key: int64 <- tree_binary@arena_key();
        r: region(L, normal) <- canonical_arena_lookup(key)
    produces
        pure r
    end
}

fn foreign_arena() -> region(L, normal) {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- canonical_arena_lookup(9083)
    produces
        pure r
    end
}

// Allocators return (region, ref) pairs: a bare reference return would outlive its region (E2100).
fn cell(
    r: region(L, normal),
    v: int64,
    count: int64,
    left: ref?(L, normal, rec),
    right: ref?(L, normal, rec)
) -> (region(L, normal), ref?(L, normal, rec)) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (v, count, left, right))
    produces
        pure (r, c)
    end
}

fn leaf(r: region(L, normal), v: int64) -> (region(L, normal), ref?(L, normal, rec)) {
    cell(r, v, 1, :none, :none)
}

fn tree_of(r: region(L, normal), root: ref?(L, normal, rec)) -> {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } {
    out: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- { root: root, compare_item: cmp_i64, region: r, specialization_key: 0 };
    out
}

fn code_of(r: region(L, normal), root: ref?(L, normal, rec)) -> int64 {
    t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_of(r, root);
    bt_trial_i64@error_code_of(t)
}

fn valid_cases(r: region(L, normal)) -> boolean {
    sequence
        l1_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 2);
        (_: region(L, normal), l1: ref?(L, normal, rec)) <- l1_p;
        l2_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 3);
        (_: region(L, normal), l2: ref?(L, normal, rec)) <- l2_p;
        n3_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, 3, l1, l2);
        (_: region(L, normal), n3: ref?(L, normal, rec)) <- n3_p;
        empty_t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_of(r, :none);
        node_t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_of(r, n3);
        ok0: boolean <- code_of(r, :none) == 0 and bt_trial_i64@valid_count(empty_t, 0);
        ok1: boolean <- code_of(r, l1) == 0;
        ok3: boolean <- code_of(r, n3) == 0 and bt_trial_i64@valid_count(node_t, 3) and tree_binary@node_count(node_t) == 3
            and bt_trial_i64@seq_pre(node_t) == 123
    produces
        pure ok0 and ok1 and ok3
    end
}

fn negative_cases(r: region(L, normal)) -> boolean {
    sequence
        neg_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, -5, :none, :none);
        (_: region(L, normal), neg: ref?(L, normal, rec)) <- neg_p;
        zero_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, 0, :none, :none);
        (_: region(L, normal), zero: ref?(L, normal, rec)) <- zero_p;
        neg_ok: boolean <- code_of(r, neg) == 5;
        zero_ok: boolean <- code_of(r, zero) == 5
    produces
        pure neg_ok and zero_ok
    end
}

// node_count reads the cached root count (7) even though validation rejects it.
fn mismatch_cases(r: region(L, normal)) -> boolean {
    sequence
        l1_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 2);
        (_: region(L, normal), l1: ref?(L, normal, rec)) <- l1_p;
        l2_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 3);
        (_: region(L, normal), l2: ref?(L, normal, rec)) <- l2_p;
        big_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, 7, l1, l2);
        (_: region(L, normal), big: ref?(L, normal, rec)) <- big_p;
        small_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, 2, l1, l2);
        (_: region(L, normal), small: ref?(L, normal, rec)) <- small_p;
        big_t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_of(r, big);
        big_ok: boolean <- code_of(r, big) == 6 and tree_binary@node_count(big_t) == 7;
        small_ok: boolean <- code_of(r, small) == 6
    produces
        pure big_ok and small_ok
    end
}

fn count_cases(r: region(L, normal)) -> boolean {
    negative_cases(r) and mismatch_cases(r)
}

// The walk is postorder: a child's violation is reported before its parent's, and a parent whose
// cached count agrees with a wrong child count is caught through the child.
fn nested_cases(r: region(L, normal)) -> boolean {
    sequence
        l1_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 2);
        (_: region(L, normal), l1: ref?(L, normal, rec)) <- l1_p;
        l2_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 3);
        (_: region(L, normal), l2: ref?(L, normal, rec)) <- l2_p;
        bad_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 2, 0, :none, :none);
        (_: region(L, normal), bad: ref?(L, normal, rec)) <- bad_p;
        parent_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, 99, bad, l2);
        (_: region(L, normal), parent: ref?(L, normal, rec)) <- parent_p;
        inner_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 2, 9, l1, :none);
        (_: region(L, normal), inner: ref?(L, normal, rec)) <- inner_p;
        outer_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, 11, inner, l2);
        (_: region(L, normal), outer: ref?(L, normal, rec)) <- outer_p;
        child_first: boolean <- code_of(r, parent) == 5;
        through_child: boolean <- code_of(r, outer) == 6
    produces
        pure child_first and through_child
    end
}

fn arena_cases(r: region(L, normal), f: region(L, normal)) -> boolean {
    sequence
        fl_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(f, 5);
        (_: region(L, normal), fl: ref?(L, normal, rec)) <- fl_p;
        own_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 4);
        (_: region(L, normal), own: ref?(L, normal, rec)) <- own_p;
        mixed_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, 3, own, fl);
        (_: region(L, normal), mixed: ref?(L, normal, rec)) <- mixed_p;
        root_outside: boolean <- code_of(r, fl) == 2;
        child_outside: boolean <- code_of(r, mixed) == 2;
        own_arena: boolean <- code_of(f, fl) == 0 and code_of(r, own) == 0
    produces
        pure root_outside and child_outside and own_arena
    end
}

// a.left = b and b.left = a (built with write_ref): the walk reaches a again while a is on the
// active path and stops with :cycle.
fn cycle_code(r: region(L, normal)) -> int64 {
    sequence proc[mem(normal)]
        a: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (5, 1, :none, :none));
        b: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (6, 2, a, :none));
        _: atom <- write_ref(a, (5, 3, b, :none));
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_of(r, a)
    produces
        pure bt_trial_i64@error_code_of(t)
    end
}

fn shared_case() -> boolean {
    sequence
        four: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(4);
        five: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(5);
        sub: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@node_of(2, four, five);
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@node_of(1, sub, sub);
        ok: boolean <- bt_trial_i64@valid_count(t, 7) and bt_trial_i64@error_code_of(t) == 0
    produces
        pure ok
    end
}

// count_preflight's atoms are decoded by the unit that creates them (atoms are numbered per unit).
fn preflight_code(a: int64, b: int64) -> int64 {
    tree_binary@validate_error_code(tree_binary@count_preflight(a, b))
}

fn preflight() -> boolean {
    preflight_code(0, 0) == 0 and preflight_code(3, 4) == 0 and preflight_code(-1, 0) == 5 and preflight_code(0, -1) == 5
        and preflight_code(4611686018427387904, 4611686018427387904) == 9
        and preflight_code(9223372036854775807, 0) == 9
        and preflight_code(4611686018427387904, 4611686018427387903) == 9
        and preflight_code(4611686018427387903, 4611686018427387903) == 0
}

fn neg_code(r: region(L, normal)) -> int64 {
    sequence
        neg_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, -5, :none, :none);
        (_: region(L, normal), neg: ref?(L, normal, rec)) <- neg_p
    produces
        pure code_of(r, neg)
    end
}

fn mismatch_code(r: region(L, normal)) -> int64 {
    sequence
        l1_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(r, 2);
        (_: region(L, normal), l1: ref?(L, normal, rec)) <- l1_p;
        big_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, 7, l1, :none);
        (_: region(L, normal), big: ref?(L, normal, rec)) <- big_p
    produces
        pure code_of(r, big)
    end
}

fn wrong_arena_code(r: region(L, normal), f: region(L, normal)) -> int64 {
    sequence
        fl_p: (region(L, normal), ref?(L, normal, rec)) <- leaf(f, 5);
        (_: region(L, normal), fl: ref?(L, normal, rec)) <- fl_p
    produces
        pure code_of(r, fl)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                r: region(L, normal) <- arena();
                f: region(L, normal) <- foreign_arena();
                t: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@complete7();
                valid_code: int64 <- bt_trial_i64@error_code_of(t);
                negative: int64 <- neg_code(r);
                mismatch: int64 <- mismatch_code(r);
                wrong_arena: int64 <- wrong_arena_code(r, f);
                cycle: int64 <- cycle_code(r);
                overflow: int64 <- preflight_code(9223372036854775807, 0);
                vc: boolean <- valid_cases(r);
                cc: boolean <- count_cases(r);
                nc: boolean <- nested_cases(r);
                ac: boolean <- arena_cases(r, f);
                sc: boolean <- shared_case();
                pf: boolean <- preflight();
                println("valid");
                print_int64(valid_code);
                println("");
                println("negative_count");
                print_int64(negative);
                println("");
                println("size_mismatch");
                print_int64(mismatch);
                println("");
                println("wrong_arena");
                print_int64(wrong_arena);
                println("");
                println("cycle");
                print_int64(cycle);
                println("");
                println("count_overflow");
                print_int64(overflow);
                println("")
            produces
                pure pick(vc, 1, pick(cc, 2, pick(nc, 3, pick(ac, 4, pick(sc, 5, pick(pf, 6, pick(cycle == 1, 7, 0)))))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
