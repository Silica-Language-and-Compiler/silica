// binary_tree_trait.md §16 and persistent_binary_tree.md §12, common_contract.md §7: every update
// is persistent. Several versions derived from one base stay independent, each shares every
// untouched subtree with the base, and the base keeps every value. Deep spines (40 nodes) are
// updated at the bottom and in the middle. Fixture 1(2(4, 5), 3(6, 7)), preorder 1245367.

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn inc(x: int64) -> int64 {
    x + 1
}

fn six_versions() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        p11: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(11);
        p2: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(2);
        p22: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(22);
        nine: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(9);
        v1: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@replace_item(base, p11, 8);
        v2: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p2, nine);
        v3: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_right(base, p0);
        v4: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@replace_item(v1.tree, p22, 0);
        v5: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_postorder(base, inc);
        base_ok: boolean <- bt_trial_i64@seq_pre(base) == 1245367 and tree_binary@node_count(base) == 7 and bt_trial_i64@valid_count(base, 7);
        v1_ok: boolean <- bt_trial_i64@seq_pre(v1.tree) == 1285367 and tree_binary@node_count(v1.tree) == 7 and bt_trial_i64@valid_count(v1.tree, 7);
        v2_ok: boolean <- bt_trial_i64@seq_pre(v2.tree) == 1245397 and tree_binary@node_count(v2.tree) == 7 and bt_trial_i64@valid_count(v2.tree, 7);
        v3_ok: boolean <- bt_trial_i64@seq_pre(v3.tree) == 1245 and tree_binary@node_count(v3.tree) == 4 and bt_trial_i64@valid_count(v3.tree, 4);
        v4_ok: boolean <- bt_trial_i64@seq_pre(v4.tree) == 1285360 and bt_trial_i64@seq_pre(v1.tree) == 1285367
            and bt_trial_i64@valid_count(v4.tree, 7);
        v5_ok: boolean <- bt_trial_i64@seq_pre(v5) == 2356478 and bt_trial_i64@valid_count(v5, 7) and tree_binary@node_count(nine) == 1
    produces
        pure base_ok and v1_ok and v2_ok and v3_ok and v4_ok and v5_ok
    end
}

fn zipper_version() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        o: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_open(base);
        d: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_right(o.zipper);
        z: {
            focus: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_replace_item(d.zipper, 5);
        v6: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(z);
        v6_ok: boolean <- bt_trial_i64@seq_pre(v6) == 1245567 and tree_binary@node_count(v6) == 7 and bt_trial_i64@valid_count(v6, 7);
        base_ok: boolean <- bt_trial_i64@seq_pre(base) == 1245367 and bt_trial_i64@get_is(base, 2, 3)
    produces
        pure v6_ok and base_ok
    end
}

// Left spine 1..40 (sum 820, depth sum 780): item 40 at depth 39 becomes 99 (sum 879); the path one
// deeper is missing; clearing the left child at depth 20 (item 21) drops items 22..40 (count 21,
// sum 231). The base spine is unchanged throughout.
fn deep_left() -> boolean {
    sequence
        spine: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@left_spine(40);
        bottom: List[:left | :right, mem(normal)] <- bt_trial_i64@path_lefts(39);
        below: List[:left | :right, mem(normal)] <- bt_trial_i64@path_lefts(40);
        middle: List[:left | :right, mem(normal)] <- bt_trial_i64@path_lefts(20);
        r: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@replace_item(spine, bottom, 99);
        c: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_left(spine, middle);
        spine_ok: boolean <- tree_binary@node_count(spine) == 40 and bt_trial_i64@sum_of(spine) == 820
            and bt_trial_i64@depth_sum_pre(spine) == 780 and bt_trial_i64@get_at_is(spine, bottom, 40)
            and bt_trial_i64@get_at_missing(spine, below) and bt_trial_i64@valid_count(spine, 40);
        r_ok: boolean <- r.changed and bt_trial_i64@get_at_is(r.tree, bottom, 99) and bt_trial_i64@sum_of(r.tree) == 879
            and tree_binary@node_count(r.tree) == 40 and bt_trial_i64@valid_count(r.tree, 40) and bt_trial_i64@get_at_is(spine, bottom, 40);
        c_ok: boolean <- c.changed and tree_binary@node_count(c.tree) == 21 and bt_trial_i64@sum_of(c.tree) == 231
            and bt_trial_i64@get_at_is(c.tree, middle, 21) and bt_trial_i64@get_at_missing(c.tree, bottom)
            and bt_trial_i64@valid_count(c.tree, 21) and bt_trial_i64@sum_of(spine) == 820
    produces
        pure spine_ok and r_ok and c_ok
    end
}

// Right spine 1..40: item 21 at depth 20 becomes 0 (sum 799); the base keeps 21 there.
fn deep_right() -> boolean {
    sequence
        spine: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@right_spine(40);
        bottom: List[:left | :right, mem(normal)] <- bt_trial_i64@path_rights(39);
        middle: List[:left | :right, mem(normal)] <- bt_trial_i64@path_rights(20);
        r: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@replace_item(spine, middle, 0);
        spine_ok: boolean <- tree_binary@node_count(spine) == 40 and bt_trial_i64@sum_of(spine) == 820
            and bt_trial_i64@depth_sum_pre(spine) == 780 and bt_trial_i64@get_at_is(spine, bottom, 40)
            and bt_trial_i64@valid_count(spine, 40);
        r_ok: boolean <- r.changed and bt_trial_i64@get_at_is(r.tree, middle, 0) and bt_trial_i64@sum_of(r.tree) == 799
            and bt_trial_i64@get_at_is(r.tree, bottom, 40) and bt_trial_i64@get_at_is(spine, middle, 21)
            and bt_trial_i64@valid_count(r.tree, 40)
    produces
        pure spine_ok and r_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                base: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@complete7();
                p11: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(11);
                p2: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(2);
                nine: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@leaf(9);
                v1: { tree: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                }, changed: boolean } <- tree_binary@replace_item(base, p11, 8);
                v2: { tree: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p2, nine);
                pre_base: int64 <- bt_trial_i64@seq_pre(base);
                pre_v1: int64 <- bt_trial_i64@seq_pre(v1.tree);
                pre_v2: int64 <- bt_trial_i64@seq_pre(v2.tree);
                spine: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@left_spine(40);
                spine_sum: int64 <- bt_trial_i64@sum_of(spine);
                sv: boolean <- six_versions();
                zv: boolean <- zipper_version();
                dl: boolean <- deep_left();
                dr: boolean <- deep_right();
                println("base");
                print_int64(pre_base);
                println("");
                println("v1");
                print_int64(pre_v1);
                println("");
                println("v2");
                print_int64(pre_v2);
                println("");
                println("spine40_sum");
                print_int64(spine_sum);
                println("")
            produces
                pure pick(sv, 1, pick(zv, 2, pick(dl, 3, pick(dr, 4, 0))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
