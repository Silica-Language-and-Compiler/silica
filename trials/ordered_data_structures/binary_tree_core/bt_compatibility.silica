// binary_tree_trait.md §9, §11, §13 and persistent_binary_tree.md §9: node, replace_left,
// replace_right and zipper_replace_subtree check canonical-arena identity and the specialization
// key before allocating. An incompatible subtree returns compatible = false and publishes no root:
// node yields the canonical empty value, the graft and zipper forms return their input unchanged.
// Trees from the standard constructors of one specialization share the canonical arena and are
// compatible.

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn alien_cell(r: region(L, normal), v: int64) -> (region(L, normal), ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (v, 1, :none, :none))
    produces
        pure (r, c)
    end
}

// A one-node tree of the same shape whose arena is not the tree_binary canonical arena.
fn alien_leaf(v: int64) -> {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        arena: region(L, normal) <- canonical_arena_lookup(9083);
        pair: (region(L, normal), ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- alien_cell(arena, v);
        (_: region(L, normal), c: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- pair;
        out: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- { root: c, compare_item: cmp_i64, region: arena, specialization_key: 0 }
    produces
        pure out
    end
}

// The same tree under a different specialization key.
fn rekeyed(t: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, key: int64) -> {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } {
    out: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- { root: t.root, compare_item: t.compare_item, region: t.region, specialization_key: key };
    out
}

fn node_rejects() -> boolean {
    sequence
        good: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(2);
        alien: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- alien_leaf(3);
        made: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, compatible: boolean } <- tree_binary@node({ compare_item: cmp_i64 }, 1, good, alien);
        made2: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, compatible: boolean } <- tree_binary@node({ compare_item: cmp_i64 }, 1, alien, good);
        keyed: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- rekeyed(good, 1);
        made3: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, compatible: boolean } <- tree_binary@node({ compare_item: cmp_i64 }, 1, good, keyed);
        rej_ok: boolean <- made.compatible == false and made2.compatible == false and made3.compatible == false;
        empty_ok: boolean <- tree_binary@node_count(made.tree) == 0 and tree_binary@node_count(made2.tree) == 0
            and tree_binary@node_count(made3.tree) == 0 and bt_trial_i64@valid_count(made.tree, 0);
        inputs_ok: boolean <- tree_binary@node_count(good) == 1 and bt_trial_i64@root_is(good, 2)
            and tree_binary@node_count(alien) == 1 and bt_trial_i64@root_is(alien, 3) and bt_trial_i64@valid_count(alien, 1);
        accept_ok: boolean <- bt_trial_i64@node_compatible(1, good, good)
    produces
        pure rej_ok and empty_ok and inputs_ok and accept_ok
    end
}

fn graft_rejects() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        alien: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- alien_leaf(9);
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        p1: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(1);
        nine: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(9);
        keyed: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- rekeyed(nine, 5);
        rl: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p0, alien);
        rr: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_right(base, p1, alien);
        rk: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p0, keyed);
        ok_graft: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(base, p0, nine);
        rej_ok: boolean <- rl.compatible == false and rl.changed == false and rr.compatible == false and rr.changed == false
            and rk.compatible == false and rk.changed == false;
        unchanged_ok: boolean <- bt_trial_i64@seq_pre(rl.tree) == 1245367 and bt_trial_i64@seq_pre(rr.tree) == 1245367
            and bt_trial_i64@seq_pre(rk.tree) == 1245367 and tree_binary@node_count(rl.tree) == 7;
        accept_ok: boolean <- ok_graft.compatible and ok_graft.changed and bt_trial_i64@seq_pre(ok_graft.tree) == 19367
            and bt_trial_i64@valid_count(ok_graft.tree, 5)
    produces
        pure rej_ok and unchanged_ok and accept_ok
    end
}

fn zipper_rejects() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        alien: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- alien_leaf(9);
        nine: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(9);
        opened: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_open(base);
        rz: { zipper: {
            focus: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, compatible: boolean } <- tree_binary@zipper_replace_subtree(opened.zipper, alien);
        closed: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(rz.zipper);
        ok: { zipper: {
            focus: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, compatible: boolean } <- tree_binary@zipper_replace_subtree(opened.zipper, nine);
        closed2: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(ok.zipper);
        rej_ok: boolean <- rz.compatible == false and bt_trial_i64@focus_is(rz.zipper, 1) and tree_binary@zipper_depth(rz.zipper) == 0
            and bt_trial_i64@seq_pre(closed) == 1245367 and tree_binary@node_count(closed) == 7;
        accept_ok: boolean <- ok.compatible and bt_trial_i64@focus_is(ok.zipper, 9) and bt_trial_i64@seq_pre(closed2) == 9
            and tree_binary@node_count(closed2) == 1 and bt_trial_i64@seq_pre(base) == 1245367
    produces
        pure rej_ok and accept_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                good: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@leaf(2);
                alien: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- alien_leaf(3);
                made: { tree: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                }, compatible: boolean } <- tree_binary@node({ compare_item: cmp_i64 }, 1, good, alien);
                rejected_count: int64 <- tree_binary@node_count(made.tree);
                rejected_flag: int64 <- case made.compatible of { true -> 1; false -> 0 };
                accepted_flag: int64 <- case bt_trial_i64@node_compatible(1, good, good) of { true -> 1; false -> 0 };
                nr: boolean <- node_rejects();
                gr: boolean <- graft_rejects();
                zr: boolean <- zipper_rejects();
                println("alien_node_compatible");
                print_int64(rejected_flag);
                println("");
                println("alien_node_count");
                print_int64(rejected_count);
                println("");
                println("same_arena_compatible");
                print_int64(accepted_flag);
                println("")
            produces
                pure pick(nr, 1, pick(gr, 2, pick(zr, 3, 0)))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
