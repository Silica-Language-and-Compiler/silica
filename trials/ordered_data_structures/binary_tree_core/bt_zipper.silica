        } } <- tree_binary@zipper_down_left(o.zipper);
        d2: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_right(d1.zipper);
        z2: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_replace_item(d2.zipper, 8);
        closed: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(z2);
        u: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_up(z2);
        c2: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(u.zipper);
        e: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        oe: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_open(e);
        ze: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_replace_item(oe.zipper, 3);
        ce: {
            root: ref?(L, normal, rec),
