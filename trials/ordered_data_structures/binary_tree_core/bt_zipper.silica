// binary_tree_trait.md §13 and persistent_binary_tree.md §11: the zipper is an immutable focused
// view. Opening an empty tree is :not_found; down_left/down_right push one breadcrumb and focus the
// occupied child, or report :not_found and leave the zipper unchanged; replace_item changes only
// the focused item; replace_subtree replaces the whole focus; up rebuilds one parent (at the root
// it is :not_found and unchanged); close rebuilds every breadcrumb. The source tree is never
// modified. Fixture 1(2(4, 5), 3(6, 7)).

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn moved(m: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } }) -> boolean {
    case m.status of {
        :found -> true;
        :not_found -> false
    }
}

fn open_empty() -> boolean {
    sequence
        e: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        o: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_open(e);
        dl: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_left(o.zipper);
        up: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_up(o.zipper);
        closed: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(o.zipper);
        open_ok: boolean <- moved(o) == false and bt_trial_i64@focus_missing(o.zipper) and tree_binary@zipper_depth(o.zipper) == 0;
        move_ok: boolean <- moved(dl) == false and bt_trial_i64@focus_missing(dl.zipper) and moved(up) == false;
        close_ok: boolean <- tree_binary@node_count(closed) == 0 and bt_trial_i64@valid_count(closed, 0)
    produces
        pure open_ok and move_ok and close_ok
    end
}

fn navigate() -> boolean {
    sequence
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        o: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_open(t);
        d1: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_left(o.zipper);
        d2: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_right(d1.zipper);
        d3: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_left(d2.zipper);
        d4: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_right(d2.zipper);
        u1: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_up(d2.zipper);
        u2: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_up(u1.zipper);
        u3: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_up(u2.zipper);
        closed: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(d2.zipper);
        open_ok: boolean <- moved(o) and bt_trial_i64@focus_is(o.zipper, 1) and tree_binary@zipper_depth(o.zipper) == 0;
        down_ok: boolean <- moved(d1) and bt_trial_i64@focus_is(d1.zipper, 2) and tree_binary@zipper_depth(d1.zipper) == 1
            and moved(d2) and bt_trial_i64@focus_is(d2.zipper, 5) and tree_binary@zipper_depth(d2.zipper) == 2;
        stay_ok: boolean <- moved(d3) == false and bt_trial_i64@focus_is(d3.zipper, 5) and tree_binary@zipper_depth(d3.zipper) == 2
            and moved(d4) == false and bt_trial_i64@focus_is(d4.zipper, 5);
        up_ok: boolean <- moved(u1) and bt_trial_i64@focus_is(u1.zipper, 2) and tree_binary@zipper_depth(u1.zipper) == 1
            and moved(u2) and bt_trial_i64@focus_is(u2.zipper, 1) and tree_binary@zipper_depth(u2.zipper) == 0
            and moved(u3) == false and bt_trial_i64@focus_is(u3.zipper, 1) and tree_binary@zipper_depth(u3.zipper) == 0;
        close_ok: boolean <- bt_trial_i64@seq_pre(closed) == 1245367 and tree_binary@node_count(closed) == 7
            and bt_trial_i64@valid_count(closed, 7) and bt_trial_i64@seq_pre(t) == 1245367
    produces
        pure open_ok and down_ok and stay_ok and up_ok and close_ok
    end
}

fn edit_item() -> boolean {
    sequence
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        o: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_open(t);
        d1: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
