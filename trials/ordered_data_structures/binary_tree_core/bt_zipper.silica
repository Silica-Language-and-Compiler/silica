fn edit_subtree() -> boolean {
    sequence
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        e: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        eight: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(8);
        nine: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@node_of(9, eight, e);
        o: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_open(t);
        dr: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_right(o.zipper);
        rs: { zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, compatible: boolean } <- tree_binary@zipper_replace_subtree(dr.zipper, nine);
        closed: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(rs.zipper);
        dl: { status: :not_found | :found, zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } } <- tree_binary@zipper_down_left(rs.zipper);
        c2: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(dl.zipper);
        re: { zipper: {
            focus: ref?(L, normal, rec),
            breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, compatible: boolean } <- tree_binary@zipper_replace_subtree(dr.zipper, e);
        c3: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@zipper_close(re.zipper);
        rs_ok: boolean <- rs.compatible and bt_trial_i64@focus_is(rs.zipper, 9) and tree_binary@zipper_depth(rs.zipper) == 1
            and bt_trial_i64@focus_is(dr.zipper, 3);
        closed_ok: boolean <- bt_trial_i64@seq_pre(closed) == 124598 and tree_binary@node_count(closed) == 6
            and bt_trial_i64@valid_count(closed, 6) and bt_trial_i64@get_is(closed, 21, 8) and bt_trial_i64@get_missing(closed, 22);
        deeper_ok: boolean <- moved(dl) and bt_trial_i64@focus_is(dl.zipper, 8) and tree_binary@zipper_depth(dl.zipper) == 2
            and bt_trial_i64@seq_pre(c2) == 124598;
        cleared_ok: boolean <- re.compatible and bt_trial_i64@focus_missing(re.zipper) and bt_trial_i64@seq_pre(c3) == 1245
            and tree_binary@node_count(c3) == 4 and bt_trial_i64@right_missing(c3, 0) and bt_trial_i64@valid_count(c3, 4);
        old_ok: boolean <- bt_trial_i64@seq_pre(t) == 1245367 and tree_binary@node_count(nine) == 2
    produces
        pure rs_ok and closed_ok and deeper_ok and cleared_ok and old_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@complete7();
                e: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@new_empty();
                eight: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@leaf(8);
                nine: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@node_of(9, eight, e);
                o: { status: :not_found | :found, zipper: {
                    focus: ref?(L, normal, rec),
                    breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } } <- tree_binary@zipper_open(t);
                d1: { status: :not_found | :found, zipper: {
                    focus: ref?(L, normal, rec),
                    breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } } <- tree_binary@zipper_down_left(o.zipper);
                d2: { status: :not_found | :found, zipper: {
                    focus: ref?(L, normal, rec),
                    breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } } <- tree_binary@zipper_down_right(d1.zipper);
                z2: {
                    focus: ref?(L, normal, rec),
                    breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- tree_binary@zipper_replace_item(d2.zipper, 8);
                item_closed: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- tree_binary@zipper_close(z2);
                dr: { status: :not_found | :found, zipper: {
                    focus: ref?(L, normal, rec),
                    breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } } <- tree_binary@zipper_down_right(o.zipper);
                rs: { zipper: {
                    focus: ref?(L, normal, rec),
                    breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, rec)), mem(normal)],
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                }, compatible: boolean } <- tree_binary@zipper_replace_subtree(dr.zipper, nine);
                sub_closed: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- tree_binary@zipper_close(rs.zipper);
                item_pre: int64 <- bt_trial_i64@seq_pre(item_closed);
                sub_pre: int64 <- bt_trial_i64@seq_pre(sub_closed);
                oe: boolean <- open_empty();
                nv: boolean <- navigate();
                ei: boolean <- edit_item();
                es: boolean <- edit_subtree();
                println("item_replaced");
                print_int64(item_pre);
                println("");
                println("subtree_replaced");
                print_int64(sub_pre);
                println("")
            produces
                pure pick(oe, 1, pick(nv, 2, pick(ei, 3, pick(es, 4, 0))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
