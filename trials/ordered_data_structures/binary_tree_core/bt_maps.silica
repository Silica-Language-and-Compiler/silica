// binary_tree_trait.md §12 and persistent_binary_tree.md §10: map_preorder and map_postorder
// replace every item with the callback result and preserve the exact shape (paths, counts,
// depths); the source tree is unchanged; the empty tree maps to the empty tree; a shared subtree
// is mapped once per logical occurrence. With a pure callback the two orders give the same tree,
// so visitation order itself is not observable here. Fixture 1(2(4, 5), 3(6, 7)).

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn dbl(x: int64) -> int64 {
    x * 2
}

fn inc(x: int64) -> int64 {
    x + 1
}

fn map_complete() -> boolean {
    sequence
        base: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        d: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_preorder(base, dbl);
        i: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_postorder(base, inc);
        i2: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_preorder(base, inc);
        d_ok: boolean <- bt_trial_i64@sum_of(d) == 56 and tree_binary@node_count(d) == 7 and bt_trial_i64@get_is(d, 12, 10)
            and bt_trial_i64@get_is(d, 21, 12) and bt_trial_i64@root_is(d, 2) and bt_trial_i64@valid_count(d, 7);
        i_ok: boolean <- bt_trial_i64@seq_pre(i) == 2356478 and bt_trial_i64@seq_in(i) == 5362748
            and tree_binary@node_count(i) == 7 and bt_trial_i64@valid_count(i, 7);
        same_ok: boolean <- bt_trial_i64@seq_pre(i2) == 2356478 and bt_trial_i64@paths_pre(i2) == 69;
        base_ok: boolean <- bt_trial_i64@seq_pre(base) == 1245367 and bt_trial_i64@sum_of(base) == 28
    produces
        pure d_ok and i_ok and same_ok and base_ok
    end
}

fn map_edges() -> boolean {
    sequence
        e: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        me: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_preorder(e, inc);
        mp: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_postorder(e, inc);
        one: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(4);
        mo: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_postorder(one, dbl);
        spine: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@left_spine(6);
        bottom: List[:left | :right, mem(normal)] <- bt_trial_i64@path_lefts(5);
        ms: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_preorder(spine, inc);
        e_ok: boolean <- tree_binary@node_count(me) == 0 and tree_binary@node_count(mp) == 0 and bt_trial_i64@valid_count(me, 0);
        one_ok: boolean <- bt_trial_i64@root_is(mo, 8) and tree_binary@node_count(mo) == 1 and bt_trial_i64@root_is(one, 4);
        spine_ok: boolean <- tree_binary@node_count(ms) == 6 and bt_trial_i64@get_at_is(ms, bottom, 7) and bt_trial_i64@get_is(ms, 0, 2)
            and bt_trial_i64@depth_sum_pre(ms) == 15 and bt_trial_i64@depth_sum_pre(spine) == 15
            and bt_trial_i64@sum_of(ms) == 27 and bt_trial_i64@sum_of(spine) == 21 and bt_trial_i64@valid_count(ms, 6)
    produces
        pure e_ok and one_ok and spine_ok
    end
}

// 1(S, S) with S = 2(4, 5): preorder 1245245 maps to 2356356 and keeps count 7.
fn map_shared() -> boolean {
    sequence
        four: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(4);
        five: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(5);
        sub: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@node_of(2, four, five);
        sh: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@node_of(1, sub, sub);
        msh: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_postorder(sh, inc);
        ok: boolean <- tree_binary@node_count(msh) == 7 and bt_trial_i64@seq_pre(msh) == 2356356
            and bt_trial_i64@valid_count(msh, 7) and bt_trial_i64@seq_pre(sh) == 1245245
    produces
        pure ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                base: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@complete7();
                d: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- tree_binary@map_preorder(base, dbl);
                i: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- tree_binary@map_postorder(base, inc);
                d_sum: int64 <- bt_trial_i64@sum_of(d);
                i_pre: int64 <- bt_trial_i64@seq_pre(i);
                i_in: int64 <- bt_trial_i64@seq_in(i);
                base_pre: int64 <- bt_trial_i64@seq_pre(base);
                mc: boolean <- map_complete();
                med: boolean <- map_edges();
                msh: boolean <- map_shared();
                println("doubled_sum");
                print_int64(d_sum);
                println("");
                println("incremented_preorder");
                print_int64(i_pre);
                println("");
                println("incremented_inorder");
                print_int64(i_in);
                println("");
                println("base_preorder");
                print_int64(base_pre);
                println("")
            produces
                pure pick(mc, 1, pick(med, 2, pick(msh, 3, 0)))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
