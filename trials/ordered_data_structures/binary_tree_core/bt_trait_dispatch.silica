// binary_tree_trait.md §6: the BinaryTree trait methods dispatched on the tree_binary record:
// node_count, the provided is_empty (exactly node_count == 0), root_item, get, left_item,
// right_item and the three folds, on the empty tree and on 1(2(4, 5), 3(6, 7)).

use tree_binary;
use BinaryTree;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn digit_step(acc: int64, _: List[:left | :right, mem(normal)], item: int64) -> int64 {
    acc * 10 + item
}

fn count_step(acc: int64, _: List[:left | :right, mem(normal)], _: int64) -> int64 {
    acc + 1
}

fn empty_trait() -> boolean {
    sequence
        e: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        count_ok: boolean <- BinaryTree@node_count(e) == 0 and BinaryTree@is_empty(e);
        r: { status: :not_found | :found, value: int64 } <- BinaryTree@root_item(e, 0);
        g: { status: :not_found | :found, value: int64 } <- BinaryTree@get(e, p0, 0);
        l: { status: :not_found | :found, value: int64 } <- BinaryTree@left_item(e, p0, 0);
        rr: { status: :not_found | :found, value: int64 } <- BinaryTree@right_item(e, p0, 0);
        query_ok: boolean <- bt_trial_i64@is_not_found(r) and bt_trial_i64@is_not_found(g)
            and bt_trial_i64@is_not_found(l) and bt_trial_i64@is_not_found(rr);
        f1: int64 <- BinaryTree@fold_preorder(e, 7, digit_step);
        f2: int64 <- BinaryTree@fold_inorder(e, 8, digit_step);
        f3: int64 <- BinaryTree@fold_postorder(e, 9, digit_step);
        fold_ok: boolean <- f1 == 7 and f2 == 8 and f3 == 9
    produces
        pure count_ok and query_ok and fold_ok
    end
}

fn full_trait() -> boolean {
    sequence
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@complete7();
        p12: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(12);
        p2: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(2);
        p11: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(11);
        p111: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(111);
        count_ok: boolean <- BinaryTree@node_count(t) == 7 and BinaryTree@is_empty(t) == false;
        r: { status: :not_found | :found, value: int64 } <- BinaryTree@root_item(t, 0);
        g: { status: :not_found | :found, value: int64 } <- BinaryTree@get(t, p12, 0);
        l: { status: :not_found | :found, value: int64 } <- BinaryTree@left_item(t, p2, 0);
        rr: { status: :not_found | :found, value: int64 } <- BinaryTree@right_item(t, p2, 0);
        la: { status: :not_found | :found, value: int64 } <- BinaryTree@left_item(t, p11, 0);
        gm: { status: :not_found | :found, value: int64 } <- BinaryTree@get(t, p111, 0);
        query_ok: boolean <- bt_trial_i64@found_is(r, 1) and bt_trial_i64@found_is(g, 5) and bt_trial_i64@found_is(l, 6)
            and bt_trial_i64@found_is(rr, 7) and bt_trial_i64@is_not_found(la) and bt_trial_i64@is_not_found(gm);
        f1: int64 <- BinaryTree@fold_preorder(t, 0, digit_step);
        f2: int64 <- BinaryTree@fold_inorder(t, 0, digit_step);
        f3: int64 <- BinaryTree@fold_postorder(t, 0, digit_step);
        f4: int64 <- BinaryTree@fold_inorder(t, 0, count_step);
        fold_ok: boolean <- f1 == 1245367 and f2 == 4251637 and f3 == 4526731 and f4 == 7
    produces
        pure count_ok and query_ok and fold_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@new_empty();
                t: {
                    root: ref?(L, normal, rec),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@complete7();
                empty_flag: int64 <- case BinaryTree@is_empty(e) of { true -> 1; false -> 0 };
                full_flag: int64 <- case BinaryTree@is_empty(t) of { true -> 1; false -> 0 };
                count: int64 <- BinaryTree@node_count(t);
                pre: int64 <- BinaryTree@fold_preorder(t, 0, digit_step);
                post: int64 <- BinaryTree@fold_postorder(t, 0, digit_step);
                et: boolean <- empty_trait();
                ft: boolean <- full_trait();
                println("is_empty_empty");
                print_int64(empty_flag);
                println("");
                println("is_empty_full");
                print_int64(full_flag);
                println("");
                println("node_count");
                print_int64(count);
                println("");
                println("fold_preorder");
                print_int64(pre);
                println("");
                println("fold_postorder");
                print_int64(post);
                println("")
            produces
                pure pick(et, 1, pick(ft, 2, 0))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
