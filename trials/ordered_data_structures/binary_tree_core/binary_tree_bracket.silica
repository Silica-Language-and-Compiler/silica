// binary_tree_trait.md §6 / common_contract.md §1: the `BinaryTree[ItemType, mem(SpaceType)]`
// bracket family over tree_binary — a return type, a binding, and trait calls on the bound value.
// Expected: a one-node tree; root_item prints `root`; node_count is the exit code.
//   root
//   1

use tree_binary;
use BinaryTree;
use trial_support_int64;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn make_tree() -> BinaryTree[string, mem(normal)] {
    sequence
        t: BinaryTree[string, mem(normal)] <- tree_binary@with_root({ compare_item: compare_names }, "root")
    produces
        pure t
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t: BinaryTree[string, mem(normal)] <- make_tree();
                found: { status: :not_found | :found, value: string } <- BinaryTree@root_item(t, "");
                println(found.value)
            produces
                pure BinaryTree@node_count(t)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
