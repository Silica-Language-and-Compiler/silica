    ; export_trait BinaryTree
    ; required_fn node_count tree BinaryTree -> int64 []
    ; required_fn root_item tree|placeholder BinaryTree|ItemType -> {status : :not_found | :found , value : ItemType } []
    ; required_fn get tree|path|placeholder BinaryTree|List [ :left | :right , mem ( normal ) ]|ItemType -> {status : :not_found | :found , value : ItemType } []
    ; required_fn left_item tree|path|placeholder BinaryTree|List [ :left | :right , mem ( normal ) ]|ItemType -> {status : :not_found | :found , value : ItemType } []
    ; required_fn right_item tree|path|placeholder BinaryTree|List [ :left | :right , mem ( normal ) ]|ItemType -> {status : :not_found | :found , value : ItemType } []
    ; required_fn fold_preorder tree|init|step BinaryTree|AccType|fn ( AccType , List [ :left | :right , mem ( normal ) ] , ItemType ) -> AccType -> AccType []
    ; required_fn fold_inorder tree|init|step BinaryTree|AccType|fn ( AccType , List [ :left | :right , mem ( normal ) ] , ItemType ) -> AccType -> AccType []
    ; required_fn fold_postorder tree|init|step BinaryTree|AccType|fn ( AccType , List [ :left | :right , mem ( normal ) ] , ItemType ) -> AccType -> AccType []

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



BinaryTree_is_empty:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X10, #0


    STR X10, [SP, #-16]!
    MOV X16, X19
    MOV X17, SP
    CMP X16, X17
    B.LO 7f
    CMP X16, X29
    B.HS 7f
    STP X0, X1, [SP, #-16]!
    STP X2, X3, [SP, #-16]!
    STP X4, X5, [SP, #-16]!
    STP X6, X7, [SP, #-16]!
    MOV X0, X16
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #40
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    LDR X3, [X1, #32]
    STR X3, [X4, #32]
    MOV X0, X4
    ADD SP, SP, #16
    MOV X16, X0
    LDP X6, X7, [SP], #16
    LDP X4, X5, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
    MOV X16, X16
7:
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o2223|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, BinaryTree_node_count@PAGE
    ADD X9, X9, BinaryTree_node_count@PAGEOFF
    BLR X9

    MOV X9, X0
    LDR X10, [SP], #16


    CMP X9, X10
    CSET X0, EQ
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

