}

fn right_missing(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }, code: int64) -> boolean {
    p: List[:left | :right, mem(normal)] <- path_of(code);
    is_not_found(tree_binary@right_item(tree, p, 0))
}

// Single-digit items concatenated in visit order: 1(2, 3) in preorder is 123.
fn digit_step(acc: int64, _: List[:left | :right, mem(normal)], item: int64) -> int64 {
    acc * 10 + item
}

fn seq_pre(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }) -> int64 {
    tree_binary@fold_preorder(tree, 0, digit_step)
}

fn seq_in(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }) -> int64 {
    tree_binary@fold_inorder(tree, 0, digit_step)
}

fn seq_post(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }) -> int64 {
    tree_binary@fold_postorder(tree, 0, digit_step)
}

// Sum of the decimal path codes handed to a preorder fold (root 0, left child 1, right child 2, ...).
fn path_code_step(acc: int64, path: List[:left | :right, mem(normal)], _: int64) -> int64 {
    acc + tree_binary@path_code(path)
}

fn paths_pre(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }) -> int64 {
    tree_binary@fold_preorder(tree, 0, path_code_step)
}

fn sum_step(acc: int64, _: List[:left | :right, mem(normal)], item: int64) -> int64 {
    acc + item
}

fn sum_of(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }) -> int64 {
    tree_binary@fold_preorder(tree, 0, sum_step)
}

// Sum over every visited node of its depth (the length of the path handed to the callback).
fn depth_step(acc: int64, path: List[:left | :right, mem(normal)], _: int64) -> int64 {
    acc + tree_binary@path_length(path)
}

fn depth_sum_pre(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }) -> int64 {
    tree_binary@fold_preorder(tree, 0, depth_step)
}

fn valid_count(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }, n: int64) -> boolean {
    v: { valid: boolean, error: atom, logical_count: int64 } <- tree_binary@validate(tree);
    case v.valid of {
        false -> false;
        true -> v.logical_count == n
    }
}

// validate's error atoms are decoded by the unit that creates them (atoms are numbered per unit).
fn error_code_of(tree: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }) -> int64 {
    v: { valid: boolean, error: atom, logical_count: int64 } <- tree_binary@validate(tree);
    tree_binary@validate_error_code(v.error)
}

fn focus_is(z: {
        focus: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }, expected: int64) -> boolean {
    found_is(tree_binary@zipper_focus_item(z, 0), expected)
}

fn focus_missing(z: {
        focus: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        breadcrumbs: List[(:from_left | :from_right, int64, ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }) -> boolean {
    is_not_found(tree_binary@zipper_focus_item(z, 0))
}
