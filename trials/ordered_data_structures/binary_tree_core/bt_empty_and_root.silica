// binary_tree_trait.md §8 and persistent_binary_tree.md §6, §13: the empty tree and a one-node
// tree. empty stores root :none, reports count zero, allocates no node; every query on it is
// :not_found and every update is a no-op that returns it unchanged. with_root creates one leaf with
// count one; its children are absent (:not_found) and every deeper path is missing.

use tree_binary;
use bt_trial_i64;
use trial_support_int64;

fn pick(ok: boolean, code: int64, rest: int64) -> int64 {
    case ok of {
        true -> rest;
        false -> code
    }
}

fn inc(x: int64) -> int64 {
    x + 1
}

fn empty_queries() -> boolean {
    sequence
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        count_ok: boolean <- tree_binary@node_count(e) == 0;
        root_ok: boolean <- bt_trial_i64@root_missing(e);
        get_ok: boolean <- bt_trial_i64@get_missing(e, 0) and bt_trial_i64@get_missing(e, 1) and bt_trial_i64@get_missing(e, 2);
        child_ok: boolean <- bt_trial_i64@left_missing(e, 0) and bt_trial_i64@right_missing(e, 0);
        fold_ok: boolean <- bt_trial_i64@seq_pre(e) == 0 and bt_trial_i64@seq_in(e) == 0 and bt_trial_i64@seq_post(e) == 0
            and bt_trial_i64@sum_of(e) == 0;
        valid_ok: boolean <- bt_trial_i64@valid_count(e, 0)
    produces
        pure count_ok and root_ok and get_ok and child_ok and fold_ok and valid_ok
    end
}

fn empty_updates() -> boolean {
    sequence
        e: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@new_empty();
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        four: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(4);
        ri: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@replace_item(e, p0, 5);
        cl: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_left(e, p0);
        cr: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_right(e, p0);
        rl: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_left(e, p0, four);
        mp: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- tree_binary@map_preorder(e, inc);
        flags_ok: boolean <- ri.changed == false and cl.changed == false and cr.changed == false
            and rl.changed == false and rl.compatible;
        still_ok: boolean <- tree_binary@node_count(ri.tree) == 0 and tree_binary@node_count(cl.tree) == 0
            and tree_binary@node_count(cr.tree) == 0 and tree_binary@node_count(rl.tree) == 0
            and tree_binary@node_count(mp) == 0 and bt_trial_i64@valid_count(mp, 0)
    produces
        pure flags_ok and still_ok
    end
}

fn leaf_queries() -> boolean {
    sequence
        one: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(7);
        count_ok: boolean <- tree_binary@node_count(one) == 1;
        root_ok: boolean <- bt_trial_i64@root_is(one, 7) and bt_trial_i64@get_is(one, 0, 7);
        deeper_ok: boolean <- bt_trial_i64@get_missing(one, 1) and bt_trial_i64@get_missing(one, 2)
            and bt_trial_i64@get_missing(one, 11) and bt_trial_i64@get_missing(one, 21);
        child_ok: boolean <- bt_trial_i64@left_missing(one, 0) and bt_trial_i64@right_missing(one, 0);
        parent_ok: boolean <- bt_trial_i64@left_missing(one, 1) and bt_trial_i64@right_missing(one, 2);
        fold_ok: boolean <- bt_trial_i64@seq_pre(one) == 7 and bt_trial_i64@seq_in(one) == 7
            and bt_trial_i64@seq_post(one) == 7 and bt_trial_i64@paths_pre(one) == 0;
        valid_ok: boolean <- bt_trial_i64@valid_count(one, 1)
    produces
        pure count_ok and root_ok and deeper_ok and child_ok and parent_ok and fold_ok and valid_ok
    end
}

fn leaf_updates() -> boolean {
    sequence
        one: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(7);
        p0: List[:left | :right, mem(normal)] <- bt_trial_i64@path_of(0);
        eight: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- bt_trial_i64@leaf(8);
        ri: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@replace_item(one, p0, 9);
        new_ok: boolean <- ri.changed and bt_trial_i64@root_is(ri.tree, 9) and tree_binary@node_count(ri.tree) == 1;
        old_ok: boolean <- bt_trial_i64@root_is(one, 7);
        cl: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean } <- tree_binary@clear_left(one, p0);
        cl_ok: boolean <- cl.changed == false and bt_trial_i64@root_is(cl.tree, 7);
        rr: { tree: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        }, changed: boolean, compatible: boolean } <- tree_binary@replace_right(one, p0, eight);
        rr_ok: boolean <- rr.changed and rr.compatible and tree_binary@node_count(rr.tree) == 2
            and bt_trial_i64@right_is(rr.tree, 0, 8) and bt_trial_i64@left_missing(rr.tree, 0)
            and bt_trial_i64@get_is(rr.tree, 2, 8) and bt_trial_i64@valid_count(rr.tree, 2);
        still_one: boolean <- tree_binary@node_count(one) == 1 and bt_trial_i64@right_missing(one, 0)
    produces
        pure new_ok and old_ok and cl_ok and rr_ok and still_one
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@new_empty();
                one: {
                    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- bt_trial_i64@leaf(7);
                empty_count: int64 <- tree_binary@node_count(e);
                leaf_count: int64 <- tree_binary@node_count(one);
                leaf_root: int64 <- bt_trial_i64@seq_pre(one);
                eq: boolean <- empty_queries();
                eu: boolean <- empty_updates();
                lq: boolean <- leaf_queries();
                lu: boolean <- leaf_updates();
                println("empty_count");
                print_int64(empty_count);
                println("");
                println("leaf_count");
                print_int64(leaf_count);
                println("");
                println("leaf_root");
                print_int64(leaf_root);
                println("")
            produces
                pure pick(eq, 1, pick(eu, 2, pick(lq, 3, pick(lu, 4, 0))))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
