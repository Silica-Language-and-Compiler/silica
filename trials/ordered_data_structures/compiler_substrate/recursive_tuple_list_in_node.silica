// Layer 1 §7.3: recursive nodes store List values alongside optional child refs.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                items: List[int64, mem(normal)] <- [7, 8];
                cell: ref(L, normal, (int64, List[int64, mem(normal)], ref?(L, normal, rec))) <- alloc_rec(r, (42, items, :none));
                node: (int64, List[int64, mem(normal)], ref?(L, normal, rec)) <- read_ref(cell);
                (k: int64, xs: List[int64, mem(normal)], child: ref?(L, normal, (int64, List[int64, mem(normal)], ref?(L, normal, rec)))) <- node;
                len: int64 <- length[int64, mem(normal)](xs);
                exit_code: int64 <- case child of {
                    :none -> case k == 42 and len == 2 of {
                        true -> 0;
                        false -> 1
                    };
                    _: ref(L, normal, (int64, List[int64, mem(normal)], ref?(L, normal, rec))) -> 2
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
