// Layer 1 §7.8: checked int64 add/mul/add1 reject overflow.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            ok_add: (boolean, int64) <- checked_int64_add(10, 20);
            (add_ok: boolean, add_val: int64) <- ok_add;
            ov_add: (boolean, int64) <- checked_int64_add(9223372036854775807, 1);
            (ov_add_ok: boolean, _ov_add_val: int64) <- ov_add;
            ov_mul: (boolean, int64) <- checked_int64_mul(9223372036854775807, 2);
            (ov_mul_ok: boolean, _ov_mul_val: int64) <- ov_mul;
            ok_add1: (boolean, int64) <- checked_int64_add1(41);
            (add1_ok: boolean, add1_val: int64) <- ok_add1;
            ov_add1: (boolean, int64) <- checked_int64_add1(9223372036854775807);
            (ov_add1_ok: boolean, _ov_add1_val: int64) <- ov_add1;
            byte_size_pair: (boolean, int64) <- checked_int64_byte_size(12, 8);
            (bytes_ok: boolean, bytes_val: int64) <- byte_size_pair;
            case add_ok of {
                false -> 1;
                true -> case add_val == 30 of {
                    false -> 2;
                    true -> case ov_add_ok of {
                        true -> 3;
                        false -> case ov_mul_ok of {
                            true -> 4;
                            false -> case add1_ok of {
                                false -> 5;
                                true -> case add1_val == 42 of {
                                    false -> 6;
                                    true -> case ov_add1_ok of {
                                        true -> 7;
                                        false -> case bytes_ok of {
                                            false -> 8;
                                            true -> case bytes_val == 96 of {
                                                false -> 9;
                                                true -> 0
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
