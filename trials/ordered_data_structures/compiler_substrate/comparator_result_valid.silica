// Layer 1 §7.7: comparator results must be :less, :equal, or :greater.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            less_ok: boolean <- comparator_result_valid(:less);
            equal_ok: boolean <- comparator_result_valid(:equal);
            greater_ok: boolean <- comparator_result_valid(:greater);
            bad_ok: boolean <- comparator_result_valid(:ok);
            case less_ok of {
                false -> 1;
                true -> case equal_ok of {
                    false -> 2;
                    true -> case greater_ok of {
                        false -> 3;
                        true -> case bad_ok of {
                            true -> 4;
                            false -> 0
                        }
                    }
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
