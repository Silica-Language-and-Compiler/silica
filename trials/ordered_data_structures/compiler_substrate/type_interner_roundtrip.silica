// Phase 1 type DAG interner smoke (logic lives in type_interner@phase1_roundtrip_smoke).

use type_interner;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            type_interner@phase1_roundtrip_smoke()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
