// Layer 1 §7.2: two separately evaluated closure expressions are incompatible.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                cmp_a: fn(int64, int64) -> atom <- fn(a: int64, b: int64) -> atom {
                    case a < b of {
                        true -> :less;
                        false -> case a > b of {
                            true -> :greater;
                            false -> :equal
                        }
                    }
                };
                cmp_b: fn(int64, int64) -> atom <- fn(a: int64, b: int64) -> atom {
                    case a < b of {
                        true -> :less;
                        false -> case a > b of {
                            true -> :greater;
                            false -> :equal
                        }
                    }
                };
                t1: int64 <- ordering_identity_materialize(cmp_a);
                t2: int64 <- ordering_identity_materialize(cmp_b);
                same: boolean <- ordering_identity_same(t1, t2);
                exit_code: int64 <- case same of {
                    true -> 1;
                    false -> 0
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
