export empty/1;

fn empty(functions: {
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge_data: fn(string, string) -> :less | :equal | :greater,
    edge_weight: fn(string) -> int64,
    compare_weight: fn(int64, int64) -> :less | :equal | :greater
}) -> {
    node_count: int64,
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge_data: fn(string, string) -> :less | :equal | :greater,
    edge_weight: fn(string) -> int64,
    compare_weight: fn(int64, int64) -> :less | :equal | :greater,
    specialization_key: int64
} {
    sequence
        L: lifetime <- fresh_lifetime();
        out: {
            node_count: int64,
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge_data: fn(string, string) -> :less | :equal | :greater,
            edge_weight: fn(string) -> int64,
            compare_weight: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- {
            node_count: 0,
            compare_node: functions.compare_node,
            compare_edge_data: functions.compare_edge_data,
            edge_weight: functions.edge_weight,
            compare_weight: functions.compare_weight,
            specialization_key: 0
        }
    produces
        pure out
    end
}
