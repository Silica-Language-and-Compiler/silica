export empty/1;
export with_root/2;

fn empty(functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater }) -> {
    node_count: int64,
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    specialization_key: int64
} {
    sequence
        L: lifetime <- fresh_lifetime();
        out: {
            node_count: int64,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- {
            node_count: 0,
            compare_item: functions.compare_item,
            specialization_key: 0
        }
    produces
        pure out
    end
}

fn with_root(
    functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater },
    root_item: int64
) -> {
    node_count: int64,
    root_item: int64,
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    specialization_key: int64
} {
    sequence
        L: lifetime <- fresh_lifetime();
        out: {
            node_count: int64,
            root_item: int64,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- {
            node_count: 1,
            root_item: root_item,
            compare_item: functions.compare_item,
            specialization_key: 0
        }
    produces
        pure out
    end
}
