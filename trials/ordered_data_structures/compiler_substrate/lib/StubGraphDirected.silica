export empty/1;

fn empty(functions: {
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
}) -> {
    node_count: int64,
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64,
    specialization_key: int64
} {
    sequence
        L: lifetime <- fresh_lifetime();
        out: {
            node_count: int64,
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64,
            specialization_key: int64
        } <- {
            node_count: 0,
            compare_node: functions.compare_node,
            compare_edge: functions.compare_edge,
            edge_target: functions.edge_target,
            specialization_key: 0
        }
    produces
        pure out
    end
}
