export empty/1;

fn empty(functions: {
    compare_priority: fn(int64, int64) -> :less | :equal | :greater,
    compare_item: fn(string, string) -> :less | :equal | :greater
}) -> {
    queue_size: int64,
    compare_priority: fn(int64, int64) -> :less | :equal | :greater,
    compare_item: fn(string, string) -> :less | :equal | :greater,
    specialization_key: int64
} {
    sequence
        L: lifetime <- fresh_lifetime();
        out: {
            queue_size: int64,
            compare_priority: fn(int64, int64) -> :less | :equal | :greater,
            compare_item: fn(string, string) -> :less | :equal | :greater,
            specialization_key: int64
        } <- {
            queue_size: 0,
            compare_priority: functions.compare_priority,
            compare_item: functions.compare_item,
            specialization_key: 0
        }
    produces
        pure out
    end
}
