L_list_prepend_helper:
    push rbp
    mov rbp, rsp
    sub rsp, 16
    mov QWORD PTR [rsp], rdi
    sub rsp, 16
    mov QWORD PTR [rsp], rsi
    mov QWORD PTR [rsp + 8], rdx
    sub rsp, 16
    mov QWORD PTR [rsp], rcx
    mov QWORD PTR [rsp + 8], r8
    sub rsp, 16
    mov QWORD PTR [rsp], r9
    test rdx, rdx
    jz L_lph_new_chunk
    mov r14, QWORD PTR [rdx + 16]
    test r14, r14
    jz L_lph_new_chunk
    mov r15, QWORD PTR [rdx + 8]
    mov rax, QWORD PTR [rbp - 16]
    test rax, 1
    jz L_lph_frame_ok
    cmp r15, rsp
    jb L_lph_cow
    cmp r15, QWORD PTR [rbp]
    jae L_lph_cow
L_lph_frame_ok:
    lea rbx, [r15 + r8]
    mov rax, QWORD PTR [rbx + 8]
    cmp rax, r14
    jne L_lph_cow
    mov rbx, r14
    sub rbx, rcx
    mov QWORD PTR [r15 + r8 + 8], rbx
    lea r11, [r15 + rbx]
    mov r12, QWORD PTR [rsp]
    test r12, r12
    jz L_lph_room_scalar
    xor r13d, r13d
L_lph_room_agg:
    cmp r13, rcx
    jge L_lph_room_stored
    mov rax, QWORD PTR [rsi + r13]
    mov QWORD PTR [r11 + r13], rax
    add r13, 8
    jmp L_lph_room_agg
    jmp L_lph_room_stored
L_lph_room_scalar:
    cmp rcx, 8
    je L_lph_rs8
    cmp rcx, 4
    je L_lph_rs4
    cmp rcx, 2
    je L_lph_rs2
    mov BYTE PTR [r11], sil
    jmp L_lph_room_stored
L_lph_rs2:
    mov WORD PTR [r11], si
    jmp L_lph_room_stored
L_lph_rs4:
    mov DWORD PTR [r11], esi
    jmp L_lph_room_stored
L_lph_rs8:
    mov QWORD PTR [r11], rsi
L_lph_room_stored:
    mov rdi, QWORD PTR [rbp - 16]
    and rdi, -16
    mov r9, QWORD PTR [rsp]
    add rsp, 16
    mov rcx, QWORD PTR [rsp]
    mov r8, QWORD PTR [rsp + 8]
    add rsp, 16
    mov rsi, QWORD PTR [rsp]
    mov rdx, QWORD PTR [rsp + 8]
    add rsp, 16
    mov r14, QWORD PTR [rdx]
    add r14, 1
    mov QWORD PTR [rdi], r14
    mov r15, QWORD PTR [rdx + 8]
    mov QWORD PTR [rdi + 8], r15
    mov rbx, QWORD PTR [rdx + 16]
    sub rbx, rcx
    mov QWORD PTR [rdi + 16], rbx
    leave
    ret
L_lph_cow:
    mov r14, QWORD PTR [rbp - 16]
    and r14, -16
    lea r14, [r14 + 32]
    mov r9, QWORD PTR [rsp]
    mov rcx, QWORD PTR [rsp + 16]
    mov r8, QWORD PTR [rsp + 24]
    mov rsi, QWORD PTR [rsp + 32]
    mov rdx, QWORD PTR [rsp + 40]
    mov r15, QWORD PTR [rdx + 8]
    mov r10, QWORD PTR [rdx + 16]
    mov r13, r10
L_lph_cow_copy:
    cmp r13, r8
    jge L_lph_cow_copied
    mov rax, QWORD PTR [r15 + r13]
    mov QWORD PTR [r14 + r13], rax
    add r13, 8
    jmp L_lph_cow_copy
L_lph_cow_copied:
    mov rax, QWORD PTR [r15 + r8]
    mov QWORD PTR [r14 + r8], rax
    mov rbx, r10
    sub rbx, rcx
    lea r11, [r14 + rbx]
    test r9, r9
    jz L_lph_cow_scalar
    xor r13d, r13d
L_lph_cow_agg:
    cmp r13, rcx
    jge L_lph_alloc_handle
    mov rax, QWORD PTR [rsi + r13]
    mov QWORD PTR [r11 + r13], rax
    add r13, 8
    jmp L_lph_cow_agg
L_lph_cow_scalar:
    cmp rcx, 8
    je L_lph_cs8
    cmp rcx, 4
    je L_lph_cs4
    cmp rcx, 2
    je L_lph_cs2
    mov BYTE PTR [r11], sil
    jmp L_lph_alloc_handle
L_lph_cs2:
    mov WORD PTR [r11], si
    jmp L_lph_alloc_handle
L_lph_cs4:
    mov DWORD PTR [r11], esi
    jmp L_lph_alloc_handle
L_lph_cs8:
