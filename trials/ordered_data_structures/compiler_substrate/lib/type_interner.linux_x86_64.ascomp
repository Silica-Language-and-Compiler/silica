L_list_prepend_helper:
    push rbp
    mov rbp, rsp
    sub rsp, 16
    mov QWORD PTR [rsp], rsi
    mov QWORD PTR [rsp + 8], rdx
    sub rsp, 16
    mov QWORD PTR [rsp], rcx
    mov QWORD PTR [rsp + 8], r8
    sub rsp, 16
    mov QWORD PTR [rsp], r9
    test rdx, rdx
    jz L_lph_new_chunk
    mov r14, QWORD PTR [rdx + 16]
    test r14, r14
    jz L_lph_new_chunk
    mov r15, QWORD PTR [rdx + 8]
    lea rbx, [r15 + r8]
    mov rax, QWORD PTR [rbx + 8]
    cmp rax, r14
    jne L_lph_cow
    mov rbx, r14
    sub rbx, rcx
    mov QWORD PTR [r15 + r8 + 8], rbx
    lea r11, [r15 + rbx]
    mov r12, QWORD PTR [rsp]
    test r12, r12
    jz L_lph_room_scalar
    xor r13d, r13d
L_lph_room_agg:
    cmp r13, rcx
    jge L_lph_room_stored
    mov rax, QWORD PTR [rsi + r13]
    mov QWORD PTR [r11 + r13], rax
    add r13, 8
    jmp L_lph_room_agg
    jmp L_lph_room_stored
L_lph_room_scalar:
    cmp rcx, 8
    je L_lph_rs8
    cmp rcx, 4
    je L_lph_rs4
    cmp rcx, 2
    je L_lph_rs2
    mov BYTE PTR [r11], sil
    jmp L_lph_room_stored
L_lph_rs2:
    mov WORD PTR [r11], si
    jmp L_lph_room_stored
L_lph_rs4:
    mov DWORD PTR [r11], esi
    jmp L_lph_room_stored
L_lph_rs8:
    mov QWORD PTR [r11], rsi
L_lph_room_stored:
    mov edi, 24
    call silica_rt_region_alloc
    mov r9, QWORD PTR [rsp]
    add rsp, 16
    mov rcx, QWORD PTR [rsp]
    mov r8, QWORD PTR [rsp + 8]
    add rsp, 16
    mov rsi, QWORD PTR [rsp]
    mov rdx, QWORD PTR [rsp + 8]
    add rsp, 16
    mov r14, QWORD PTR [rdx]
    add r14, 1
    mov QWORD PTR [rdi], r14
    mov r15, QWORD PTR [rdx + 8]
    mov QWORD PTR [rdi + 8], r15
    mov rbx, QWORD PTR [rdx + 16]
    sub rbx, rcx
    mov QWORD PTR [rdi + 16], rbx
    pop rbp
    ret
L_lph_cow:
    lea rdi, [r8 + 16]
    call silica_rt_region_alloc
    mov r14, rdi
    mov r9, QWORD PTR [rsp]
    mov rcx, QWORD PTR [rsp + 16]
    mov r8, QWORD PTR [rsp + 24]
    mov rsi, QWORD PTR [rsp + 32]
    mov rdx, QWORD PTR [rsp + 40]
    mov r15, QWORD PTR [rdx + 8]
    mov r10, QWORD PTR [rdx + 16]
    mov r13, r10
L_lph_cow_copy:
    cmp r13, r8
    jge L_lph_cow_copied
    mov rax, QWORD PTR [r15 + r13]
    mov QWORD PTR [r14 + r13], rax
    add r13, 8
    jmp L_lph_cow_copy
L_lph_cow_copied:
    mov rax, QWORD PTR [r15 + r8]
    mov QWORD PTR [r14 + r8], rax
    mov rbx, r10
    sub rbx, rcx
    lea r11, [r14 + rbx]
    test r9, r9
    jz L_lph_cow_scalar
    xor r13d, r13d
L_lph_cow_agg:
    cmp r13, rcx
    jge L_lph_alloc_handle
    mov rax, QWORD PTR [rsi + r13]
    mov QWORD PTR [r11 + r13], rax
    add r13, 8
    jmp L_lph_cow_agg
L_lph_cow_scalar:
    cmp rcx, 8
    je L_lph_cs8
    cmp rcx, 4
    je L_lph_cs4
    cmp rcx, 2
    je L_lph_cs2
    mov BYTE PTR [r11], sil
    jmp L_lph_alloc_handle
L_lph_cs2:
    mov WORD PTR [r11], si
    jmp L_lph_alloc_handle
L_lph_cs4:
    mov DWORD PTR [r11], esi
    jmp L_lph_alloc_handle
L_lph_cs8:
    mov QWORD PTR [r11], rsi
    jmp L_lph_alloc_handle
L_lph_new_chunk:
    lea rdi, [r8 + 16]
    call silica_rt_region_alloc
    mov r14, rdi
    mov r9, QWORD PTR [rsp]
    mov rcx, QWORD PTR [rsp + 16]
    mov r8, QWORD PTR [rsp + 24]
    mov rsi, QWORD PTR [rsp + 32]
    mov rdx, QWORD PTR [rsp + 40]
    mov rbx, r8
    sub rbx, rcx
    lea r11, [r14 + rbx]
    test r9, r9
    jz L_lph_new_scalar
    xor r13d, r13d
L_lph_new_agg:
    cmp r13, rcx
    jge L_lph_new_stored
    mov rax, QWORD PTR [rsi + r13]
    mov QWORD PTR [r11 + r13], rax
    add r13, 8
    jmp L_lph_new_agg
    jmp L_lph_new_stored
L_lph_new_scalar:
    cmp rcx, 8
    je L_lph_ns8
    cmp rcx, 4
    je L_lph_ns4
    cmp rcx, 2
    je L_lph_ns2
    mov BYTE PTR [r11], sil
    jmp L_lph_new_stored
L_lph_ns2:
    mov WORD PTR [r11], si
    jmp L_lph_new_stored
L_lph_ns4:
    mov DWORD PTR [r11], esi
    jmp L_lph_new_stored
L_lph_ns8:
    mov QWORD PTR [r11], rsi
L_lph_new_stored:
    test rdx, rdx
    jz L_lph_next_nil
    mov r10, QWORD PTR [rdx + 8]
    mov QWORD PTR [r14 + r8], r10
    jmp L_lph_alloc_handle
L_lph_next_nil:
    mov QWORD PTR [r14 + r8], 0
L_lph_alloc_handle:
    mov QWORD PTR [r14 + r8 + 8], rbx
    sub rsp, 16
    mov QWORD PTR [rsp], r14
    mov QWORD PTR [rsp + 8], rbx
    mov edi, 24
    call silica_rt_region_alloc
    mov r14, QWORD PTR [rsp]
    mov rbx, QWORD PTR [rsp + 8]
    add rsp, 16
    mov r9, QWORD PTR [rsp]
    add rsp, 16
    mov rcx, QWORD PTR [rsp]
    mov r8, QWORD PTR [rsp + 8]
    add rsp, 16
    mov rsi, QWORD PTR [rsp]
    mov rdx, QWORD PTR [rsp + 8]
    add rsp, 16
    test rdx, rdx
    jz L_lph_len1
    mov r10, QWORD PTR [rdx]
    add r10, 1
    jmp L_lph_setlen
L_lph_len1:
    mov r10d, 1
L_lph_setlen:
    mov QWORD PTR [rdi], r10
    mov QWORD PTR [rdi + 8], r14
    mov QWORD PTR [rdi + 16], rbx
    pop rbp
    ret

L_list_tail_helper:
    push rbp
    mov rbp, rsp
    mov rcx, QWORD PTR [rdi]
    mov r8, QWORD PTR [rdi + 8]
    mov r9, QWORD PTR [rdi + 16]
    lea r14, [r9 + rsi]
    cmp r14, rdx
    jge L_lth_next_chunk
    sub rcx, 1
    test rcx, rcx
    jz L_lth_nil
    sub rsp, 16
    mov QWORD PTR [rsp], rcx
    mov QWORD PTR [rsp + 8], r8
    sub rsp, 16
    mov QWORD PTR [rsp], r14
    mov QWORD PTR [rsp + 8], 0
    mov edi, 24
    call silica_rt_region_alloc
    mov r14, QWORD PTR [rsp]
    add rsp, 16
    mov rcx, QWORD PTR [rsp]
    mov r8, QWORD PTR [rsp + 8]
    add rsp, 16
    mov QWORD PTR [rdi], rcx
    mov QWORD PTR [rdi + 8], r8
    mov QWORD PTR [rdi + 16], r14
    pop rbp
    ret
L_lth_next_chunk:
    mov r15, QWORD PTR [r8 + rdx]
    test r15, r15
    jz L_lth_nil
    sub rcx, 1
    test rcx, rcx
    jz L_lth_nil
    sub rsp, 16
    mov QWORD PTR [rsp], rcx
    mov QWORD PTR [rsp + 8], r15
    mov edi, 24
    call silica_rt_region_alloc
    mov rcx, QWORD PTR [rsp]
    mov r15, QWORD PTR [rsp + 8]
    add rsp, 16
    mov QWORD PTR [rdi], rcx
    mov QWORD PTR [rdi + 8], r15
    mov QWORD PTR [rdi + 16], 0
    pop rbp
    ret
L_lth_nil:
    xor edi, edi
    pop rbp
    ret

L_list_length_helper:
    test rdi, rdi
    jz L_list_len_nil
    mov rdi, QWORD PTR [rdi]
    ret
L_list_len_nil:
    xor edi, edi
    ret

L_list_at_helper:
    test rdi, rdi
    jz L_lat_oob
    mov r8, QWORD PTR [rdi]
    cmp rsi, r8
    jae L_lat_oob
    mov r9, QWORD PTR [rdi + 8]
    mov r14, QWORD PTR [rdi + 16]
L_lat_loop:
    test rsi, rsi
    jz L_lat_done
    add r14, rdx
    cmp r14, rcx
    jl L_lat_step
    mov r9, QWORD PTR [r9 + rcx]
    xor r14d, r14d
L_lat_step:
    sub rsi, 1
    jmp L_lat_loop
L_lat_done:
    lea rdi, [r9 + r14]
    ret
L_lat_oob:
    push rbp
    mov rbp, rsp
    call silica_rt_abort_list_index

