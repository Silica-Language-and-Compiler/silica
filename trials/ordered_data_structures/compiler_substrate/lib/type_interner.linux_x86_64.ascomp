    mov r8, QWORD PTR [r12 + 16]
Lsc_n2_done:
    test r8, r8
    jz Lsc_true
    cmp r8, r14
    ja Lsc_false
    mov r9, r14
    sub r9, r8
    add r9, 1
    mov r10, r13
Lsc_outer:
    mov r11, r10
    mov rcx, r15
    mov rdi, r8
Lsc_inner:
    movzx esi, BYTE PTR [r11]
    add r11, 1
    movzx edx, BYTE PTR [rcx]
    add rcx, 1
    cmp esi, edx
    jne Lsc_next
    sub rdi, 1
    jne Lsc_inner
    jmp Lsc_true
Lsc_next:
    add r10, 1
    sub r9, 1
    jne Lsc_outer
    jmp Lsc_false
Lsc_true:
    mov edi, 1
    jmp Lsc_exit
Lsc_false:
