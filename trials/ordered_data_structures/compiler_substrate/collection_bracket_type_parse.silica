// Layer 1 §7.6: every public bracketed collection type form parses and type-checks.
// Signature-only: no runtime constructor calls (nine injected lowers hang in one proc).

use trial_support_int64;

fn ty_ordered_set(_: OrderedSet[int64, mem(normal)]) -> int64 {
    0
}

fn ty_ordered_map(_: OrderedMap[int64, string, mem(normal)]) -> int64 {
    0
}

fn ty_search_tree(_: SearchTree[int64, mem(normal)]) -> int64 {
    0
}

fn ty_directed_graph(_: DirectedGraph[int64, int64, mem(normal)]) -> int64 {
    0
}

fn ty_undirected_graph(_: UndirectedGraph[int64, unit, mem(normal)]) -> int64 {
    0
}

fn ty_weighted_graph(_: WeightedGraph[int64, string, int64, mem(normal)]) -> int64 {
    0
}

fn ty_heap(_: Heap[int64, mem(normal)]) -> int64 {
    0
}

fn ty_priority_queue(_: PriorityQueue[int64, string, mem(normal)]) -> int64 {
    0
}

fn ty_tree(_: Tree[int64, mem(normal)]) -> int64 {
    0
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
