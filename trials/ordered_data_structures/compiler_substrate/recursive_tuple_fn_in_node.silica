// Layer 1 §7.3: recursive nodes store function values alongside optional child refs.

use trial_support_int64;

fn int64_cmp(a: int64, b: int64) -> atom {
    case a < b of {
        true -> :less;
        false -> case a > b of {
            true -> :greater;
            false -> :equal
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                cell: ref(L, normal, (int64, fn(a: int64, b: int64) -> atom, ref?(L, normal, rec))) <- alloc_rec(r, (42, int64_cmp, :none));
                node: (int64, fn(a: int64, b: int64) -> atom, ref?(L, normal, rec)) <- read_ref(cell);
                (k: int64, c: fn(a: int64, b: int64) -> atom, child: ref?(L, normal, (int64, fn(a: int64, b: int64) -> atom, ref?(L, normal, rec)))) <- node;
                exit_code: int64 <- case child of {
                    :none -> case c(k, 1) of {
                        :greater -> 0;
                        _: atom -> 1
                    };
                    child_ref: ref(L, normal, (int64, fn(a: int64, b: int64) -> atom, ref?(L, normal, rec))) -> 2
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
