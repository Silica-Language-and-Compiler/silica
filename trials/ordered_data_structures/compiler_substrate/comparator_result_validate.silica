// Layer 1 §7.7: invalid comparator atoms map to :invalid_comparator_result.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            good: atom <- comparator_result_validate(:equal);
            bad: atom <- comparator_result_validate(:ok);
            case good == :equal of {
                false -> 1;
                true -> case bad == :invalid_comparator_result of {
                    true -> 0;
                    false -> 2
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
