// Layer 1 §7.5/§7.9: constructor record field order is name-based; lowering runs end-to-end.

use StubWbtMap;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_str(_a: string, _b: string) -> :less | :equal | :greater {
    :equal
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                warm: region(L, normal) <- canonical_arena_lookup(1);
                map0: {
                    stored_size: int64,
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(string, string) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- StubWbtMap@empty({
                    compare_value: cmp_str,
                    compare_key: cmp_i64
                });
                key_ok: boolean <- map0.specialization_key > 0;
                bundle_ok: boolean <- map0.compare_key_ordering_bundle > 0;
                exit_code: int64 <- case key_ok of {
                    false -> 1;
                    true -> case bundle_ok of {
                        true -> 0;
                        false -> 2
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
