// Layer 1/2 §8A.5 stability: OrderedSet specialization keys distinguish every supported SpaceType.

use StubWbtSet;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(atomic), mem(device)]
                L_atomic: lifetime <- fresh_lifetime();
                atomic_warm: region(L_atomic, atomic) <- alloc_region(atomic);
                L_dev: lifetime <- fresh_lifetime();
                device_warm: region(L_dev, device) <- alloc_region(device);
                s_normal: {
                    stored_root: int64,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- StubWbtSet@empty({ compare_item: cmp_i64 });
                s_writeback: {
                    stored_root: int64,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal_writeback),
                    specialization_key: int64
                } <- StubWbtSet@empty({ compare_item: cmp_i64 });
                s_writethrough: {
                    stored_root: int64,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal_writethrough),
                    specialization_key: int64
                } <- StubWbtSet@empty({ compare_item: cmp_i64 });
                s_noncacheable: {
                    stored_root: int64,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal_noncacheable),
                    specialization_key: int64
                } <- StubWbtSet@empty({ compare_item: cmp_i64 });
                s_atomic: {
                    stored_root: int64,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, atomic),
                    specialization_key: int64
                } <- StubWbtSet@empty({ compare_item: cmp_i64 });
                s_device: {
                    stored_root: int64,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, device),
                    specialization_key: int64
                } <- StubWbtSet@empty({ compare_item: cmp_i64 });
                keys_ok: boolean <-
                    s_normal.specialization_key == 16843009 and
                    s_writeback.specialization_key == 16843265 and
                    s_writethrough.specialization_key == 16843521 and
                    s_noncacheable.specialization_key == 16843777 and
                    s_atomic.specialization_key == 16844033 and
                    s_device.specialization_key == 16844289;
                distinct_ok: boolean <-
                    s_normal.specialization_key != s_writeback.specialization_key and
                    s_writeback.specialization_key != s_writethrough.specialization_key and
                    s_writethrough.specialization_key != s_noncacheable.specialization_key and
                    s_noncacheable.specialization_key != s_atomic.specialization_key and
                    s_atomic.specialization_key != s_device.specialization_key
            produces
                pure case keys_ok of {
                    false -> 1;
                    true -> case distinct_ok of {
                        true -> 0;
                        false -> 2
                    }
                }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
