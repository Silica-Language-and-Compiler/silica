// Layer 1 §7.7: lookup results use {status: :not_found | :found, payload}.

use trial_support_int64;

fn lookup_not_found() -> { status: :not_found | :found, value: int64 } {
    r: { status: :not_found | :found, value: int64 } <- { status: :not_found, value: 0 };
    r
}

fn lookup_found(v: int64) -> { status: :not_found | :found, value: int64 } {
    r: { status: :not_found | :found, value: int64 } <- { status: :found, value: v };
    r
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            r1: { status: :not_found | :found, value: int64 } <- lookup_not_found();
            r2: { status: :not_found | :found, value: int64 } <- lookup_found(42);
            case r1.status == :not_found of {
                false -> 1;
                true -> case r2.status == :found of {
                    false -> 2;
                    true -> case r2.value == 42 of {
                        true -> 0;
                        false -> 3
                    }
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
