// Layer 1 §7.5: constructor lowering obtains the canonical arena for repeated constructions.

use StubWbtSet;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r_warm: region(L, normal) <- canonical_arena_lookup(16843009);
                s1: {
                    stored_root: int64,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- StubWbtSet@empty({ compare_item: cmp_i64 });
                s2: {
                    stored_root: int64,
                    compare_item: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64
                } <- StubWbtSet@empty({ compare_item: cmp_i64 });
                same_arena: boolean <- canonical_arena_same(s1.region, s2.region);
                same_key: boolean <- s1.specialization_key == s2.specialization_key;
                exit_code: int64 <- case same_arena of {
                    false -> 2;
                    true -> case same_key of {
                        false -> 3;
                        true -> case s1.specialization_key == 16843009 of {
                            true -> 0;
                            false -> 4
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
