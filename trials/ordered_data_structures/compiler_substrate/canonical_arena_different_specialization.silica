// Layer 1 §7.1: different specialization keys resolve to distinct canonical arenas.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                key_a: int64 <- 16843009;
                key_b: int64 <- 33685778;
                r_a: region(L, normal) <- canonical_arena_lookup(key_a);
                r_b: region(L, normal) <- canonical_arena_lookup(key_b);
                same: boolean <- canonical_arena_same(r_a, r_b);
                exit_code: int64 <- case same of {
                    true -> 1;
                    false -> 0
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
