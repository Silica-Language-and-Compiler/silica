// Layer 1 §7.8: runtime-sized buf(L, Space, T, N) allocation and indexed access.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                capacity: int64 <- 12;
                index: int64 <- 7;
                buf: buf(L1, normal, int64, capacity) <- alloc_buf(r, capacity);
                _: atom <- write_buf(buf, index, 123);
                value: int64 <- read_buf(buf, index)
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
