// Layer 1 §7.1: repeated canonical_arena_lookup for the same specialization key shares one arena.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                key: int64 <- 65537;
                r1: region(L, normal) <- canonical_arena_lookup(key);
                r2: region(L, normal) <- canonical_arena_lookup(key);
                same: boolean <- canonical_arena_same(r1, r2);
                exit_code: int64 <- case same of {
                    true -> 0;
                    false -> 1
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
