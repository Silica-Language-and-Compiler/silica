// Layer 1 §7.4: one concrete record implements two independent traits.

use SizeTrait;
use ScaleTrait;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            cell: { payload: int64 } <- { payload: 11 };
            SizeTrait@read_size(cell) + ScaleTrait@read_scale(cell)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
