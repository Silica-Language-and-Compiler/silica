// Layer 1 §7.5/§7.9: all nine public collection families resolve and run @empty through stub modules.

use StubWbtSet;
use StubWbtMap;
use StubGraphDirected;
use StubGraphUndirected;
use StubGraphWeighted;
use StubHeap;
use StubPriorityQueue;
use StubTreeRose;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_str(_a: string, _b: string) -> :less | :equal | :greater {
    :equal
}

fn cmp_unit(_a: unit, _b: unit) -> :less | :equal | :greater {
    :equal
}

fn edge_target_id(e: int64) -> int64 {
    e
}

fn edge_weight_from_data(_d: string) -> int64 {
    1
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                warm: region(L, normal) <- canonical_arena_lookup(1);
                _: OrderedSet[int64, mem(normal)] <- StubWbtSet@empty({ compare_item: cmp_i64 });
                _: OrderedMap[int64, string, mem(normal)] <- StubWbtMap@empty({ compare_key: cmp_i64, compare_value: cmp_str });
                _: SearchTree[int64, mem(normal)] <- StubWbtSet@empty({ compare_item: cmp_i64 });
                _: DirectedGraph[int64, int64, mem(normal)] <- StubGraphDirected@empty({
                    compare_node: cmp_i64,
                    compare_edge: cmp_i64,
                    edge_target: edge_target_id
                });
                _: UndirectedGraph[int64, unit, mem(normal)] <- StubGraphUndirected@empty({
                    compare_node: cmp_i64,
                    compare_edge_data: cmp_unit
                });
                _: WeightedGraph[int64, string, int64, mem(normal)] <- StubGraphWeighted@empty({
                    compare_node: cmp_i64,
                    compare_edge_data: cmp_str,
                    edge_weight: edge_weight_from_data,
                    compare_weight: cmp_i64
                });
                _: Heap[int64, mem(normal)] <- StubHeap@empty({ compare_item: cmp_i64 });
                _: PriorityQueue[int64, string, mem(normal)] <- StubPriorityQueue@empty({
                    compare_priority: cmp_i64,
                    compare_item: cmp_str
                });
                _: Tree[int64, mem(normal)] <- StubTreeRose@with_root({ compare_item: cmp_i64 }, 42);
                exit_code: int64 <- 0
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
