// Layer 1 §7.1: same representation family with different memory-space keys do not share an arena.
// Keys encode (representation_id << 16) | space_tag per compiler specialization-key plan.

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                key_normal: int64 <- 16843009;
                key_atomic: int64 <- 16844033;
                r_normal: region(L, normal) <- canonical_arena_lookup(key_normal);
                r_atomic: region(L, normal) <- canonical_arena_lookup(key_atomic);
                same: boolean <- canonical_arena_same(r_normal, r_atomic);
                exit_code: int64 <- case same of {
                    true -> 1;
                    false -> 0
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
