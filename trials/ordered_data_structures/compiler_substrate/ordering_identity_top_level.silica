// Layer 1 §7.2: repeated references to one top-level comparator share ordering identity.

use trial_support_int64;

fn cmp_int64(a: int64, b: int64) -> atom {
    case a < b of {
        true -> :less;
        false -> case a > b of {
            true -> :greater;
            false -> :equal
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                t1: int64 <- ordering_identity_materialize(cmp_int64);
                t2: int64 <- ordering_identity_materialize(cmp_int64);
                same: boolean <- ordering_identity_same(t1, t2);
                exit_code: int64 <- case same of {
                    true -> 0;
                    false -> 1
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
