// Layer 1 §7.6: distinct registered representation modules yield distinct specialization keys.

use StubHeap;
use StubHeapMax;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            heap_min: {
                heap_size: int64,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64
            } <- StubHeap@empty({ compare_item: cmp_i64 });
            heap_max: {
                heap_size: int64,
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64
            } <- StubHeapMax@empty({ compare_item: cmp_i64 });
            case heap_min.specialization_key == heap_max.specialization_key of {
                true -> 1;
                false -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
