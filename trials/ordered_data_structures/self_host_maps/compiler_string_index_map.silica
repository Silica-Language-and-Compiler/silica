// §11 Step 3: compiler_maps string→int64 insert / lookup / duplicate via WBT OrderedMap.

use compiler_maps;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                m0: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- compiler_maps@empty_string_int64_map();
                r1: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    index: int64,
                    inserted: boolean
                } <- compiler_maps@map_insert_or_get_index(m0, ":ok", 0);
                r2: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    index: int64,
                    inserted: boolean
                } <- compiler_maps@map_insert_or_get_index(r1.map, ":fail", 1);
                r3: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    index: int64,
                    inserted: boolean
                } <- compiler_maps@map_insert_or_get_index(r2.map, ":ok", 2);
                i_ok: int64 <- compiler_maps@map_index_of(r3.map, ":ok");
                i_fail: int64 <- compiler_maps@map_index_of(r3.map, ":fail");
                i_miss: int64 <- compiler_maps@map_index_of(r3.map, ":missing");
                n0: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                } <- compiler_maps@empty_numeric_string_int64_map();
                nr1: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    index: int64,
                    inserted: boolean
                } <- compiler_maps@map_insert_or_get_index(n0, "10", 0);
                nr2: {
                    map: {
                        root: ref?(L, normal, rec),
                        compare_key: fn(string, string) -> :less | :equal | :greater,
                        compare_value: fn(int64, int64) -> :less | :equal | :greater,
                        region: region(L, normal),
                        specialization_key: int64,
                        compare_key_ordering_bundle: int64,
                        compare_value_ordering_bundle: int64
                    },
                    index: int64,
                    inserted: boolean
                } <- compiler_maps@map_insert_or_get_index(nr1.map, "010", 1);
                exit_code: int64 <- case r1.inserted and r2.inserted of {
                    false -> 1;
                    true -> case r3.inserted of {
                        true -> 2;
                        false -> case r3.index == 0 and i_ok == 0 and i_fail == 1 and i_miss < 0 of {
                            false -> 3;
                            true -> case nr1.inserted of {
                                false -> 4;
                                true -> case nr2.inserted of {
                                    true -> 5;
                                    false -> case nr2.index == 0 of { true -> 0; false -> 6 }
                                }
                            }
                        }
                    }
                }
            produces
                pure exit_code
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
