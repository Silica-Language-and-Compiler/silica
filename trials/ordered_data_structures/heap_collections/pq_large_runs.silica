// priority_queue_trait.md §1, §11, §12: large runs. 300 entries with pseudo-random priorities pop in
// lexicographic (priority, value) order with every rest validating, and match an insertion-sort
// oracle; 200 entries (i mod 5, i) exercise many equal priorities: values ascend within each
// priority and (0, 0) is the root.

use PriorityQueue;
use pq_trial_i64;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- pq_trial_i64@new_queue();
                big: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- pq_trial_i64@push_lcg(e, 777, 300, 0);
                big_len: int64 <- PriorityQueue@len(big);
                big_valid: int64 <- pq_trial_i64@validate_code(big);
                big_count: int64 <- pq_trial_i64@validate_count(big);
                big_lex: int64 <- pq_trial_i64@pops_lexicographic_code(big, 300);
                big_oracle: int64 <- pq_trial_i64@oracle_lcg_code(big, 777, 300);
                md: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- pq_trial_i64@push_mod(e, 200, 5, 0);
                md_len: int64 <- PriorityQueue@len(md);
                md_lex: int64 <- pq_trial_i64@pops_lexicographic_code(md, 200);
                md_valid: int64 <- pq_trial_i64@validate_code(md);
                md_pp: int64 <- pq_trial_i64@peek_priority_code(md);
                md_pv: int64 <- pq_trial_i64@peek_value_code(md);
                println("len");
                print_int64(big_len);
                println("");
                println("validate");
                print_int64(big_valid);
                println("");
                println("count");
                print_int64(big_count);
                println("");
                println("lexicographic");
                print_int64(big_lex);
                println("");
                println("oracle");
                print_int64(big_oracle);
                println("");
                println("mod_len");
                print_int64(md_len);
                println("");
                println("mod_lexicographic");
                print_int64(md_lex);
                println("");
                println("mod_validate");
                print_int64(md_valid);
                println("");
                println("mod_peek_priority");
                print_int64(md_pp);
                println("");
                println("mod_peek_value");
                print_int64(md_pv);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
