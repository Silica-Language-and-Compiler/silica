// heap_trait.md §5, §6: pushing 9,4,7,4,1,8,2,6,3,5,0 and popping until empty yields the items in
// ascending order on the min module and descending on the max module (duplicates 4,4 both present);
// len counts occurrences, peek is the extreme item, and the heap validates. Pop digits are printed
// as 1 followed by one digit per popped item.

use brodal_okasaki;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [9, 4, 7, 4, 1, 8, 2, 6, 3, 5, 0]
    produces
        pure xs
    end
}

fn first_three() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [9, 4, 7]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                xs: List[int64, mem(normal)] <- items();
                ys: List[int64, mem(normal)] <- first_three();
                e_min: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
                e_max: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_max();
                mn: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e_min, xs);
                mx: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e_max, xs);
                mn_len: int64 <- Heap@len(mn);
                mn_peek: int64 <- hc_trial_i64@peek_code(mn);
                mn_pops: int64 <- hc_trial_i64@pop_digits(mn);
                mn_valid: int64 <- hc_trial_i64@validate_code(mn);
                mn_count: int64 <- hc_trial_i64@validate_count(mn);
                mx_len: int64 <- Heap@len(mx);
                mx_peek: int64 <- hc_trial_i64@peek_code(mx);
                mx_pops: int64 <- hc_trial_i64@pop_digits(mx);
                p_min: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e_min, ys);
                p_max: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e_max, ys);
                p_min_peek: int64 <- hc_trial_i64@peek_code(p_min);
                p_max_peek: int64 <- hc_trial_i64@peek_code(p_max);
                println("min_len");
                print_int64(mn_len);
                println("");
                println("min_peek");
                print_int64(mn_peek);
                println("");
                println("min_pops");
                print_int64(mn_pops);
                println("");
                println("min_validate");
                print_int64(mn_valid);
                println("");
                println("min_count");
                print_int64(mn_count);
                println("");
                println("max_len");
                print_int64(mx_len);
                println("");
                println("max_peek");
                print_int64(mx_peek);
                println("");
                println("max_pops");
                print_int64(mx_pops);
                println("");
                println("partial_min_peek");
                print_int64(p_min_peek);
                println("");
                println("partial_max_peek");
                print_int64(p_max_peek);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
