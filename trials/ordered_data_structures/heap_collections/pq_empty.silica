// priority_queue_trait.md §9: the empty queue answers len 0, is_empty, :not_found from peek,
// peek_priority and peek_value, :not_found from pop with the same (still empty) queue, and validates
// with logical_count 0. brodal_okasaki_priority@empty/1 (the checker's constructor name) and
// empty_priority_queue/1 (the design's name) build the same empty queue.

use brodal_okasaki_priority;
use PriorityQueue;
use pq_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_val(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn status_code(r: { status: :not_found | :found, priority: int64, value: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                q0: PriorityQueue[int64, int64, mem(normal)] <- brodal_okasaki_priority@empty({
                    compare_priority: cmp_i64,
                    compare_item: cmp_val
                });
                q_len: int64 <- PriorityQueue@len(q0);
                q_empty: int64 <- pq_trial_i64@b2i(PriorityQueue@is_empty(q0));
                pp: int64 <- pq_trial_i64@peek_priority_code(q0);
                pv: int64 <- pq_trial_i64@peek_value_code(q0);
                pk: { status: :not_found | :found, priority: int64, value: int64 } <- PriorityQueue@peek(q0, 0, 0);
                pk_status: int64 <- status_code(pk);
                pop: int64 <- pq_trial_i64@pop_priority_code(q0);
                pop_rest: int64 <- pq_trial_i64@pop_rest_len(q0);
                v_code: int64 <- pq_trial_i64@validate_code(q0);
                v_count: int64 <- pq_trial_i64@validate_count(q0);
                d: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@empty_priority_queue({ compare_priority: cmp_i64, compare_item: cmp_val });
                d_len: int64 <- PriorityQueue@len(d);
                d_empty: int64 <- pq_trial_i64@b2i(PriorityQueue@is_empty(d));
                println("len");
                print_int64(q_len);
                println("");
                println("is_empty");
                print_int64(q_empty);
                println("");
                println("peek_priority");
                print_int64(pp);
                println("");
                println("peek_value");
                print_int64(pv);
                println("");
                println("peek_status");
                print_int64(pk_status);
                println("");
                println("pop");
                print_int64(pop);
                println("");
                println("pop_rest_len");
                print_int64(pop_rest);
                println("");
                println("validate");
                print_int64(v_code);
                println("");
                println("validate_count");
                print_int64(v_count);
                println("");
                println("design_name_len");
                print_int64(d_len);
                println("");
                println("design_name_is_empty");
                print_int64(d_empty);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
