// heap_trait.md §6 (From list): from_list folds push over the list, retains every element including
// duplicates, and equals the same pushes; the empty list gives the empty heap; the max module's
// from_list is max-oriented.

use brodal_okasaki_min;
use brodal_okasaki_max;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [9, 4, 7, 4, 1, 8, 2, 6, 3, 5, 0]
    produces
        pure xs
    end
}

fn no_items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                xs: List[int64, mem(normal)] <- items();
                none: List[int64, mem(normal)] <- no_items();
                built: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@from_list({ compare_item: cmp_i64 }, xs);
                b_len: int64 <- Heap@len(built);
                b_pops: int64 <- hc_trial_i64@pop_digits(built);
                b_valid: int64 <- hc_trial_i64@validate_code(built);
                b_count: int64 <- hc_trial_i64@validate_count(built);
                nb: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@from_list({ compare_item: cmp_i64 }, none);
                nb_len: int64 <- Heap@len(nb);
                nb_empty: int64 <- hc_trial_i64@b2i(Heap@is_empty(nb));
                mx: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_max@from_list({ compare_item: cmp_i64 }, xs);
                mx_peek: int64 <- hc_trial_i64@peek_code(mx);
                mx_pops: int64 <- hc_trial_i64@pop_digits(mx);
                e: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
                pushed: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, xs);
                same: int64 <- hc_trial_i64@b2i(hc_trial_i64@pop_digits(pushed) == b_pops);
                println("len");
                print_int64(b_len);
                println("");
                println("pops");
                print_int64(b_pops);
                println("");
                println("validate");
                print_int64(b_valid);
                println("");
                println("count");
                print_int64(b_count);
                println("");
                println("empty_len");
                print_int64(nb_len);
                println("");
                println("empty_is_empty");
                print_int64(nb_empty);
                println("");
                println("max_peek");
                print_int64(mx_peek);
                println("");
                println("max_pops");
                print_int64(mx_pops);
                println("");
                println("same_as_push");
                print_int64(same);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
