// priority_queue_trait.md §8: from_entries folds push_priority over a list of {priority, value}
// records in order, deduplicating nothing: five entries including (1,2) twice give len 5 and pop
// lexicographically; the empty list gives the empty queue; the result equals the same pushes.

use brodal_okasaki_priority;
use PriorityQueue;
use pq_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_val(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn entries() -> List[{ priority: int64, value: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        es: List[{ priority: int64, value: int64 }, mem(normal)] <- [
            { priority: 3, value: 1 },
            { priority: 1, value: 2 },
            { priority: 3, value: 0 },
            { priority: 2, value: 2 },
            { priority: 1, value: 2 }
        ]
    produces
        pure es
    end
}

fn no_entries() -> List[{ priority: int64, value: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        es: List[{ priority: int64, value: int64 }, mem(normal)] <- empty[{ priority: int64, value: int64 }, mem(normal)]()
    produces
        pure es
    end
}

fn pushed_same() -> { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } {
    q0: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@empty_priority_queue({ compare_priority: cmp_i64, compare_item: cmp_val });
    q1: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(q0, 3, 1);
    q2: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(q1, 1, 2);
    q3: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(q2, 3, 0);
    q4: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(q3, 2, 2);
    brodal_okasaki_priority@push_priority(q4, 1, 2)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                es: List[{ priority: int64, value: int64 }, mem(normal)] <- entries();
                none: List[{ priority: int64, value: int64 }, mem(normal)] <- no_entries();
                built: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@from_entries({ compare_priority: cmp_i64, compare_item: cmp_val }, es);
                b_len: int64 <- PriorityQueue@len(built);
                b_pops: int64 <- pq_trial_i64@pop_digits(built);
                b_count: int64 <- pq_trial_i64@pop_count(built);
                b_valid: int64 <- pq_trial_i64@validate_code(built);
                nb: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@from_entries({ compare_priority: cmp_i64, compare_item: cmp_val }, none);
                nb_len: int64 <- PriorityQueue@len(nb);
                nb_empty: int64 <- pq_trial_i64@b2i(PriorityQueue@is_empty(nb));
                pushed: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- pushed_same();
                same: int64 <- pq_trial_i64@b2i(pq_trial_i64@pop_digits(pushed) == b_pops);
                println("len");
                print_int64(b_len);
                println("");
                println("pops");
                print_int64(b_pops);
                println("");
                println("count");
                print_int64(b_count);
                println("");
                println("validate");
                print_int64(b_valid);
                println("");
                println("empty_len");
                print_int64(nb_len);
                println("");
                println("empty_is_empty");
                print_int64(nb_empty);
                println("");
                println("same_as_push");
                print_int64(same);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
