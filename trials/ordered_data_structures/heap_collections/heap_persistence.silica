// heap_trait.md §7, §11: updates are persistent. The design's example: h1 = push(h0, 9),
// h2 = push(h1, 3), p = pop(h2) gives p.value = 3, p.heap contains 9, and h2 still contains both;
// h1 and h0 are untouched, and two pushes diverging from h2 leave h2 unchanged.

use brodal_okasaki;
use brodal_okasaki_min;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                h0: Heap[int64, mem(normal)] <- brodal_okasaki_min@empty({ compare_item: cmp_i64 });
                h1: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(h0, 9);
                h2: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(h1, 3);
                p: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki_min@pop(h2, 0);
                p_value: int64 <- p.value;
                rest: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- p.heap;
                rest_peek: int64 <- hc_trial_i64@peek_code(rest);
                rest_len: int64 <- Heap@len(rest);
                h2_len: int64 <- Heap@len(h2);
                h2_peek: int64 <- hc_trial_i64@peek_code(h2);
                h2_pops: int64 <- hc_trial_i64@pop_digits(h2);
                h1_len: int64 <- Heap@len(h1);
                h1_peek: int64 <- hc_trial_i64@peek_code(h1);
                h0_len: int64 <- Heap@len(h0);
                h3a: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(h2, 1);
                h3b: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(h2, 5);
                h3a_pops: int64 <- hc_trial_i64@pop_digits(h3a);
                h3b_pops: int64 <- hc_trial_i64@pop_digits(h3b);
                h2_again: int64 <- hc_trial_i64@pop_digits(h2);
                println("pop_value");
                print_int64(p_value);
                println("");
                println("rest_peek");
                print_int64(rest_peek);
                println("");
                println("rest_len");
                print_int64(rest_len);
                println("");
                println("h2_len");
                print_int64(h2_len);
                println("");
                println("h2_peek");
                print_int64(h2_peek);
                println("");
                println("h2_pops");
                print_int64(h2_pops);
                println("");
                println("h1_len");
                print_int64(h1_len);
                println("");
                println("h1_peek");
                print_int64(h1_peek);
                println("");
                println("h0_len");
                print_int64(h0_len);
                println("");
                println("h3a_pops");
                print_int64(h3a_pops);
                println("");
                println("h3b_pops");
                print_int64(h3b_pops);
                println("");
                println("h2_again");
                print_int64(h2_again);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
