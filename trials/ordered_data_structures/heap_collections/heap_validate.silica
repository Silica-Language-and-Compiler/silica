// heap_trait.md §4 (validate), §9.1; common_contract.md §12: validate reports valid with error :ok
// (code 0) and a logical_count equal to len on the empty heap, after pushes, after a pop, after a
// meld, and on the max module.

use brodal_okasaki;
use brodal_okasaki_min;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [3, 1, 4, 1, 5, 9, 2]
    produces
        pure xs
    end
}

fn more() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [2, 7]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                xs: List[int64, mem(normal)] <- items();
                ys: List[int64, mem(normal)] <- more();
                e: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
                e_code: int64 <- hc_trial_i64@validate_code(e);
                e_count: int64 <- hc_trial_i64@validate_count(e);
                p: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, xs);
                p_code: int64 <- hc_trial_i64@validate_code(p);
                p_count: int64 <- hc_trial_i64@validate_count(p);
                p_len: int64 <- Heap@len(p);
                pp: { heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(p, 0);
                rest: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- pp.heap;
                rest_code: int64 <- hc_trial_i64@validate_code(rest);
                rest_count: int64 <- hc_trial_i64@validate_count(rest);
                q: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, ys);
                m: { heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(p, q);
                mh: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- m.heap;
                m_code: int64 <- hc_trial_i64@validate_code(mh);
                m_count: int64 <- hc_trial_i64@validate_count(mh);
                x: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(hc_trial_i64@new_max(), xs);
                x_code: int64 <- hc_trial_i64@validate_code(x);
                x_count: int64 <- hc_trial_i64@validate_count(x);
                v: { valid: boolean, error: atom, logical_count: int64 } <- brodal_okasaki_min@validate(mh);
                v_valid: int64 <- hc_trial_i64@b2i(v.valid);
                println("empty_code");
                print_int64(e_code);
                println("");
                println("empty_count");
                print_int64(e_count);
                println("");
                println("push_code");
                print_int64(p_code);
                println("");
                println("push_count");
                print_int64(p_count);
                println("");
                println("push_len");
                print_int64(p_len);
                println("");
                println("pop_code");
                print_int64(rest_code);
                println("");
                println("pop_count");
                print_int64(rest_count);
                println("");
                println("meld_code");
                print_int64(m_code);
                println("");
                println("meld_count");
                print_int64(m_count);
                println("");
                println("meld_valid");
                print_int64(v_valid);
                println("");
                println("max_code");
                print_int64(x_code);
                println("");
                println("max_count");
                print_int64(x_count);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
