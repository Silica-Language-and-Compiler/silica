// heap_trait.md §1, §6, §9.5: comparator-equal items are retained as separate occurrences and popped
// one at a time. Pushing 5,3,5,1,5 gives len 5; the min module pops 1,3,5,5,5 and each pop removes
// exactly one occurrence (the rests pop 3,5,5,5 then 5,5,5); the max module pops 5,5,5,3,1.

use brodal_okasaki;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [5, 3, 5, 1, 5]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                xs: List[int64, mem(normal)] <- items();
                e_min: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
                e_max: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_max();
                d: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e_min, xs);
                d_len: int64 <- Heap@len(d);
                d_pops: int64 <- hc_trial_i64@pop_digits(d);
                d_count: int64 <- hc_trial_i64@pop_count(d);
                p1: { heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(d, 0);
                p1_value: int64 <- p1.value;
                r1: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- p1.heap;
                r1_len: int64 <- Heap@len(r1);
                r1_pops: int64 <- hc_trial_i64@pop_digits(r1);
                p2: { heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(r1, 0);
                r2: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- p2.heap;
                r2_pops: int64 <- hc_trial_i64@pop_digits(r2);
                mx: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e_max, xs);
                mx_pops: int64 <- hc_trial_i64@pop_digits(mx);
                mx_peek: int64 <- hc_trial_i64@peek_code(mx);
                q1: { heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(mx, 0);
                mx_rest: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- q1.heap;
                mx_rest_pops: int64 <- hc_trial_i64@pop_digits(mx_rest);
                d_valid: int64 <- hc_trial_i64@validate_code(d);
                println("len");
                print_int64(d_len);
                println("");
                println("pops");
                print_int64(d_pops);
                println("");
                println("count");
                print_int64(d_count);
                println("");
                println("pop");
                print_int64(p1_value);
                println("");
                println("rest_len");
                print_int64(r1_len);
                println("");
                println("rest_pops");
                print_int64(r1_pops);
                println("");
                println("rest2_pops");
                print_int64(r2_pops);
                println("");
                println("max_pops");
                print_int64(mx_pops);
                println("");
                println("max_peek");
                print_int64(mx_peek);
                println("");
                println("max_rest_pops");
                print_int64(mx_rest_pops);
                println("");
                println("validate");
                print_int64(d_valid);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
