// priority_queue_trait.md §6, §9: meld_priority combines every entry of two compatible queues
// ({(1,1),(4,4),(7,7)} with {(2,2),(3,3),(9,9)}: len 6, lexicographic pops) and leaves both inputs
// unchanged; melding with the empty queue gives the other queue; a queue whose priority comparator
// or item comparator is a different function value is incompatible: the left queue comes back
// unchanged with compatible = false, in either argument position.

use brodal_okasaki_priority;
use PriorityQueue;
use pq_trial_i64;
use trial_support_int64;

