// heap_trait.md §6 (Meld), §8: melding {1,4,7} with {2,3,9} on the min module combines every
// occurrence (len 6, pops 1,2,3,4,7,9) and leaves both inputs unchanged; melding with the empty heap
// gives the other heap; a heap built with a different comparator function value or the opposite
// orientation is incompatible: the result is the left heap unchanged with compatible = false.

use brodal_okasaki;
use brodal_okasaki_min;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn left_items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [7, 1, 4]
    produces
        pure xs
    end
}

fn right_items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [9, 2, 3]
    produces
        pure xs
    end
}

fn compatible_part() -> boolean {
    sequence
        e: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
        a: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, left_items());
        b: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, right_items());
        m: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki_min@meld(a, b);
        m_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m of {
            :unchanged -> a;
            :incompatible -> a;
            (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
        };
        m_res_compatible: boolean <- case m of {
            :unchanged -> true;
            :incompatible -> false;
            (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        mh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- m_heap;
        m_ok: boolean <- m_res_compatible and Heap@len(mh) == 6 and hc_trial_i64@pop_digits(mh) == 1123479
            and hc_trial_i64@peek_code(mh) == 1 and hc_trial_i64@validate_code(mh) == 0;
        inputs_ok: boolean <- hc_trial_i64@pop_digits(a) == 1147 and hc_trial_i64@pop_digits(b) == 1239;
        me: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki_min@meld(a, e);
        me_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case me of {
            :unchanged -> a;
            :incompatible -> a;
            (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
        };
        me_compatible: boolean <- case me of {
            :unchanged -> true;
            :incompatible -> false;
            (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        meh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- me_heap;
        em: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki_min@meld(e, b);
        em_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case em of {
            :unchanged -> e;
            :incompatible -> e;
            (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
        };
        em_compatible: boolean <- case em of {
            :unchanged -> true;
            :incompatible -> false;
            (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
        };
        emh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- em_heap;
        empty_ok: boolean <- me_compatible and Heap@len(meh) == 3 and hc_trial_i64@pop_digits(meh) == 1147
            and em_compatible and Heap@len(emh) == 3 and hc_trial_i64@pop_digits(emh) == 1239
    produces
        pure m_ok and inputs_ok and empty_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
                a: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, left_items());
                b: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, right_items());
                m: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki_min@meld(a, b);
                m_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case m of {
                    :unchanged -> a;
                    :incompatible -> a;
                    (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
                };
                m_res_compatible: boolean <- case m of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                mh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- m_heap;
                m_compatible: int64 <- hc_trial_i64@b2i(m_res_compatible);
                m_len: int64 <- Heap@len(mh);
                m_pops: int64 <- hc_trial_i64@pop_digits(mh);
                a_pops: int64 <- hc_trial_i64@pop_digits(a);
                c: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki@push(hc_trial_i64@new_min_alt(), 5);
                mc: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki_min@meld(a, c);
                mc_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case mc of {
                    :unchanged -> a;
                    :incompatible -> a;
                    (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
                };
                mc_res_compatible: boolean <- case mc of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                mch: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- mc_heap;
                mc_compatible: int64 <- hc_trial_i64@b2i(mc_res_compatible);
                mc_pops: int64 <- hc_trial_i64@pop_digits(mch);
                d: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki@push(hc_trial_i64@new_max(), 5);
                md: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki_min@meld(a, d);
                md_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case md of {
                    :unchanged -> a;
                    :incompatible -> a;
                    (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
                };
                md_res_compatible: boolean <- case md of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                mdh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- md_heap;
                md_compatible: int64 <- hc_trial_i64@b2i(md_res_compatible);
                md_pops: int64 <- hc_trial_i64@pop_digits(mdh);
                dm: :unchanged | :incompatible | (:melded, { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) <- brodal_okasaki_min@meld(d, a);
                dm_heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- case dm of {
                    :unchanged -> d;
                    :incompatible -> d;
                    (:melded, v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> v_melded
                };
                dm_res_compatible: boolean <- case dm of {
                    :unchanged -> true;
                    :incompatible -> false;
                    (:melded, _v_melded: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 }) -> true
                };
                dmh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_item_ordering_bundle: int64 } <- dm_heap;
                dm_compatible: int64 <- hc_trial_i64@b2i(dm_res_compatible);
                dm_len: int64 <- Heap@len(dmh);
                dm_pops: int64 <- hc_trial_i64@pop_digits(dmh);
                detail: int64 <- hc_trial_i64@b2i(compatible_part());
                println("compatible");
                print_int64(m_compatible);
                println("");
                println("len");
                print_int64(m_len);
                println("");
                println("pops");
                print_int64(m_pops);
                println("");
                println("left_unchanged_pops");
                print_int64(a_pops);
                println("");
                println("compatible_detail");
                print_int64(detail);
                println("");
                println("alt_comparator_compatible");
                print_int64(mc_compatible);
                println("");
                println("alt_comparator_pops");
                print_int64(mc_pops);
                println("");
                println("max_compatible");
                print_int64(md_compatible);
                println("");
                println("max_pops");
                print_int64(md_pops);
                println("");
                println("max_left_compatible");
                print_int64(dm_compatible);
                println("");
                println("max_left_len");
                print_int64(dm_len);
                println("");
                println("max_left_pops");
                print_int64(dm_pops);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
