// heap_trait.md §6 (Meld), §8: melding {1,4,7} with {2,3,9} on the min module combines every
// occurrence (len 6, pops 1,2,3,4,7,9) and leaves both inputs unchanged; melding with the empty heap
// gives the other heap; a heap built with a different comparator function value or the opposite
// orientation is incompatible: the result is the left heap unchanged with compatible = false.

use brodal_okasaki;
use brodal_okasaki_min;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn left_items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [7, 1, 4]
    produces
        pure xs
    end
}

fn right_items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [9, 2, 3]
    produces
        pure xs
    end
}

fn compatible_part() -> boolean {
    sequence
        e: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
        a: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, left_items());
        b: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, right_items());
        m: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(a, b);
        mh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- m.heap;
        m_ok: boolean <- m.compatible and Heap@len(mh) == 6 and hc_trial_i64@pop_digits(mh) == 1123479
            and hc_trial_i64@peek_code(mh) == 1 and hc_trial_i64@validate_code(mh) == 0;
        inputs_ok: boolean <- hc_trial_i64@pop_digits(a) == 1147 and hc_trial_i64@pop_digits(b) == 1239;
        me: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(a, e);
        meh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- me.heap;
        em: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(e, b);
        emh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- em.heap;
        empty_ok: boolean <- me.compatible and Heap@len(meh) == 3 and hc_trial_i64@pop_digits(meh) == 1147
            and em.compatible and Heap@len(emh) == 3 and hc_trial_i64@pop_digits(emh) == 1239
    produces
        pure m_ok and inputs_ok and empty_ok
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
                a: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, left_items());
                b: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, right_items());
                m: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(a, b);
                mh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- m.heap;
                m_compatible: int64 <- hc_trial_i64@b2i(m.compatible);
                m_len: int64 <- Heap@len(mh);
                m_pops: int64 <- hc_trial_i64@pop_digits(mh);
                a_pops: int64 <- hc_trial_i64@pop_digits(a);
                c: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki@push(hc_trial_i64@new_min_alt(), 5);
                mc: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(a, c);
                mch: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- mc.heap;
                mc_compatible: int64 <- hc_trial_i64@b2i(mc.compatible);
                mc_pops: int64 <- hc_trial_i64@pop_digits(mch);
                d: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki@push(hc_trial_i64@new_max(), 5);
                md: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(a, d);
                mdh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- md.heap;
                md_compatible: int64 <- hc_trial_i64@b2i(md.compatible);
                md_pops: int64 <- hc_trial_i64@pop_digits(mdh);
                dm: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(d, a);
                dmh: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- dm.heap;
                dm_compatible: int64 <- hc_trial_i64@b2i(dm.compatible);
                dm_len: int64 <- Heap@len(dmh);
                dm_pops: int64 <- hc_trial_i64@pop_digits(dmh);
                detail: int64 <- hc_trial_i64@b2i(compatible_part());
                println("compatible");
                print_int64(m_compatible);
                println("");
                println("len");
                print_int64(m_len);
                println("");
                println("pops");
                print_int64(m_pops);
                println("");
                println("left_unchanged_pops");
                print_int64(a_pops);
                println("");
                println("compatible_detail");
                print_int64(detail);
                println("");
                println("alt_comparator_compatible");
                print_int64(mc_compatible);
                println("");
                println("alt_comparator_pops");
                print_int64(mc_pops);
                println("");
                println("max_compatible");
                print_int64(md_compatible);
                println("");
                println("max_pops");
                print_int64(md_pops);
                println("");
                println("max_left_compatible");
                print_int64(dm_compatible);
                println("");
                println("max_left_len");
                print_int64(dm_len);
                println("");
                println("max_left_pops");
                print_int64(dm_pops);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
