// Trial-only int64 helpers for heap_collections (Heap side): constructors through the public
// brodal_okasaki_min / brodal_okasaki_max surface, push streams, pop-order digit strings, a sorted
// oracle, and result codes. cmp_i64 stays the first function: the emitter numbers its
// :less/:equal/:greater atoms in first-use order and the core's compare unit expects that order.
// cmp_i64_alt has the same body but is a distinct function value (ordering identity is exact
// function-value identity, common_contract.md §5), so heaps built with it are incompatible for meld.
// Orientation-agnostic operations (push, pop, peek, size, validate) go through the brodal_okasaki
// core, which both generated modules forward to. Digit strings: pop_digits returns 1 followed by the
// popped single-digit items, so leading zeros survive; e.g. items 0,1,2 popped in min order read 1012.
// Codes: peek_code / pop_code answer the item, or 99 for :not_found (trial items stay below 99).

use brodal_okasaki;
use brodal_okasaki_min;
use brodal_okasaki_max;

export cmp_i64/2;
export cmp_i64_alt/2;
export b2i/1;
export new_min/0;
export new_max/0;
export new_min_alt/0;
export push_digits/2;
export push_seq/4;
export push_lcg/4;
export pop_digits/1;
export pop_count/1;
export pops_sorted_code/2;
export peek_code/1;
export pop_code/1;
export pop_rest_len/1;
export validate_code/1;
export validate_count/1;
export oracle_lcg_code/3;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_i64_alt(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn b2i(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn new_min() -> { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    brodal_okasaki_min@empty({ compare_item: cmp_i64 })
}

fn new_max() -> { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    brodal_okasaki_max@empty({ compare_item: cmp_i64 })
}

fn new_min_alt() -> { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    brodal_okasaki_min@empty({ compare_item: cmp_i64_alt })
}

// Pushes every item of xs in list order.
fn push_digits(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, xs: List[int64, mem(normal)]) -> { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    case xs of {
        []: List[int64, mem(normal)] -> heap;
        [h: int64, t: List[int64, mem(normal)]] -> push_digits(brodal_okasaki@push(heap, h), t)
    }
}

// Pushes lo, lo + step, ... while below hi (step may be negative with lo > hi).
fn push_seq(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, lo: int64, hi: int64, step: int64) -> { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    case step > 0 of {
        true -> case lo >= hi of {
            true -> heap;
            false -> push_seq(brodal_okasaki@push(heap, lo), lo + step, hi, step)
        };
        false -> case lo <= hi of {
            true -> heap;
            false -> push_seq(brodal_okasaki@push(heap, lo), lo + step, hi, step)
        }
    }
}

fn lcg_next(x: int64) -> int64 {
    ((x * 1103515245 + 12345) / 65536) - (((x * 1103515245 + 12345) / 65536) / 1000) * 1000
}

// Pushes n pseudo-random values in [0, 1000) from seed.
fn push_lcg(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, seed: int64, n: int64, i: int64) -> { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    case i >= n of {
        true -> heap;
        false -> push_lcg(brodal_okasaki@push(heap, lcg_next(seed)), lcg_next(seed), n, i + 1)
    }
}

fn pop_digits_go(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, acc: int64) -> int64 {
    p: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(heap, 0);
    case p.status of {
        :not_found -> acc;
        :found -> pop_digits_go(p.heap, acc * 10 + p.value)
    }
}

// 1 followed by every popped item as one digit; the heap itself is unchanged (persistent).
fn pop_digits(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    pop_digits_go(heap, 1)
}

fn pop_count_go(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, acc: int64) -> int64 {
    p: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(heap, 0);
    case p.status of {
        :not_found -> acc;
        :found -> pop_count_go(p.heap, acc + 1)
    }
}

fn pop_count(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    pop_count_go(heap, 0)
}

fn valid_with_count(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, n: int64) -> boolean {
    v: { valid: boolean, error: atom, logical_count: int64 } <- brodal_okasaki@validate(heap);
    case v.valid of {
        false -> false;
        true -> v.logical_count == n and brodal_okasaki@size(heap) == n
    }
}

// Pops everything, checking that every rest validates and that the sequence is monotone in the
// heap's orientation; 1 when exactly n items came out in order, else 0.
fn pops_sorted_go(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, remaining: int64, prev: int64, have_prev: boolean) -> boolean {
    p: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(heap, 0);
    case p.status of {
        :not_found -> remaining == 0;
        :found -> {
            in_order: boolean <- case have_prev of {
                false -> true;
                true -> case brodal_okasaki@is_max_oriented(heap) of {
                    false -> prev <= p.value;
                    true -> prev >= p.value
                }
            };
            case in_order and valid_with_count(p.heap, remaining - 1) of {
                false -> false;
                true -> pops_sorted_go(p.heap, remaining - 1, p.value, true)
            }
        }
    }
}

fn pops_sorted_code(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, n: int64) -> int64 {
    b2i(pops_sorted_go(heap, n, 0, false))
}

fn peek_code(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    r: { status: :not_found | :found, value: int64 } <- brodal_okasaki@peek(heap, 0);
    case r.status of {
        :found -> r.value;
        :not_found -> 99
    }
}

fn pop_code(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    p: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(heap, 0);
    case p.status of {
        :found -> p.value;
        :not_found -> 99
    }
}

fn pop_rest_len(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    p: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(heap, 0);
    brodal_okasaki@size(p.heap)
}

// The validator's error code: 0 is :ok (brodal_okasaki_validate decodes the atoms).
fn validate_code(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    v: { valid: boolean, error: atom, logical_count: int64 } <- brodal_okasaki@validate(heap);
    brodal_okasaki@validate_error_code(v.error)
}

fn validate_count(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    v: { valid: boolean, error: atom, logical_count: int64 } <- brodal_okasaki@validate(heap);
    v.logical_count
}

// Sorted-list oracle over plain lists (insertion sort), hashed the same way as the pop sequence.
fn hash_step(acc: int64, x: int64) -> int64 {
    acc * 31 + x + 7
}

fn pop_hash_go(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, acc: int64) -> int64 {
    p: { heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: int64 } <- brodal_okasaki@pop(heap, 0);
    case p.status of {
        :not_found -> acc;
        :found -> pop_hash_go(p.heap, hash_step(acc, p.value))
    }
}

fn insert_sorted(xs: List[int64, mem(normal)], x: int64, descending: boolean) -> List[int64, mem(normal)] {
    case xs of {
        []: List[int64, mem(normal)] -> {
            sequence proc[mem(normal)]
                out: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
            produces
                pure out
            end
        };
        [h: int64, t: List[int64, mem(normal)]] -> {
            goes_first: boolean <- case descending of {
                false -> x <= h;
                true -> x >= h
            };
            case goes_first of {
                true -> {
                    sequence proc[mem(normal)]
                        out: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, xs)
                    produces
                        pure out
                    end
                };
                false -> {
                    sequence proc[mem(normal)]
                        inner: List[int64, mem(normal)] <- insert_sorted(t, x, descending);
                        out: List[int64, mem(normal)] <- prepend[int64, mem(normal)](h, inner)
                    produces
                        pure out
                    end
                }
            }
        }
    }
}

fn hash_list(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> acc;
        [h: int64, t: List[int64, mem(normal)]] -> hash_list(t, hash_step(acc, h))
    }
}

fn empty_i64() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure out
    end
}

fn sorted_lcg_go(xs: List[int64, mem(normal)], seed: int64, n: int64, i: int64, descending: boolean) -> List[int64, mem(normal)] {
    case i >= n of {
        true -> xs;
        false -> sorted_lcg_go(insert_sorted(xs, lcg_next(seed), descending), lcg_next(seed), n, i + 1, descending)
    }
}

// 1 when the heap's full pop sequence equals the sorted oracle of the same n lcg values from seed
// (ascending for a min heap, descending for a max heap).
fn oracle_lcg_code(heap: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, seed: int64, n: int64) -> int64 {
    expected: int64 <- hash_list(sorted_lcg_go(empty_i64(), seed, n, 0, brodal_okasaki@is_max_oriented(heap)), 0);
    b2i(pop_hash_go(heap, 0) == expected)
}
