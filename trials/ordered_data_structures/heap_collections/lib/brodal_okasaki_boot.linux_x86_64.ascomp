    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    // effects []|sir_rec:o1262|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    mov rbx, 0
    lea r10, [rip + brodal_okasaki_node_empty_forest]
