// priority_queue_trait.md §4 (validate), §11.3; common_contract.md §12: validate reports valid with
// error :ok (code 0) and a logical_count equal to len on the empty queue, after pushes, after a pop,
// and after a compatible meld.

use brodal_okasaki_priority;
use PriorityQueue;
use pq_trial_i64;
use trial_support_int64;

