    p2: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(p1, 1, 4);
    p3: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(p2, 4, 1);
    p4: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(p3, 1, 5);
    p5: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(p4, 5, 9);
    p6: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(p5, 9, 2);
    brodal_okasaki_priority@push_priority(p6, 2, 6)
}

fn build_q(q0: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }) -> { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } {
    q1: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(q0, 2, 7);
    brodal_okasaki_priority@push_priority(q1, 1, 8)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- pq_trial_i64@new_queue();
                e_code: int64 <- pq_trial_i64@validate_code(e);
                e_count: int64 <- pq_trial_i64@validate_count(e);
                p: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- build_p(e);
                p_code: int64 <- pq_trial_i64@validate_code(p);
                p_count: int64 <- pq_trial_i64@validate_count(p);
                p_len: int64 <- PriorityQueue@len(p);
                pp: { queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, priority: int64, value: int64 }
                    <- brodal_okasaki_priority@pop_priority(p, 0, 0);
                rest: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- pp.queue;
                rest_code: int64 <- pq_trial_i64@validate_code(rest);
                rest_count: int64 <- pq_trial_i64@validate_count(rest);
                q: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- build_q(e);
                m: { queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_priority@meld_priority(p, q);
                mq: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- m.queue;
                m_compatible: int64 <- pq_trial_i64@b2i(m.compatible);
                m_code: int64 <- pq_trial_i64@validate_code(mq);
                m_count: int64 <- pq_trial_i64@validate_count(mq);
                v: { valid: boolean, error: atom, logical_count: int64 } <- brodal_okasaki_priority@validate(mq);
                v_valid: int64 <- pq_trial_i64@b2i(v.valid);
                println("empty_code");
                print_int64(e_code);
                println("");
                println("empty_count");
                print_int64(e_count);
                println("");
                println("push_code");
                print_int64(p_code);
                println("");
                println("push_count");
                print_int64(p_count);
                println("");
                println("push_len");
                print_int64(p_len);
                println("");
                println("pop_code");
                print_int64(rest_code);
                println("");
                println("pop_count");
                print_int64(rest_count);
                println("");
                println("meld_compatible");
                print_int64(m_compatible);
                println("");
                println("meld_code");
                print_int64(m_code);
                println("");
                println("meld_count");
                print_int64(m_count);
                println("");
                println("meld_valid");
                print_int64(v_valid);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
