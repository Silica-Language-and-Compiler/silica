// heap_trait.md §6, §8: the empty heap answers len 0, is_empty, peek :not_found, pop :not_found with
// the identical (still empty) heap, and validates; singleton/2 holds exactly one occurrence, which
// peek reports and one pop removes, leaving the empty heap. The max module's singleton agrees.

use brodal_okasaki_min;
use brodal_okasaki_max;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
                e_len: int64 <- Heap@len(e);
                e_empty: int64 <- hc_trial_i64@b2i(Heap@is_empty(e));
                e_peek: int64 <- hc_trial_i64@peek_code(e);
                e_pop: int64 <- hc_trial_i64@pop_code(e);
                e_rest: int64 <- hc_trial_i64@pop_rest_len(e);
                e_valid: int64 <- hc_trial_i64@validate_code(e);
                s: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@singleton({ compare_item: cmp_i64 }, 7);
                s_len: int64 <- Heap@len(s);
                s_peek: int64 <- hc_trial_i64@peek_code(s);
                s_empty: int64 <- hc_trial_i64@b2i(Heap@is_empty(s));
                s_pop: int64 <- hc_trial_i64@pop_code(s);
                s_rest: int64 <- hc_trial_i64@pop_rest_len(s);
                s_valid: int64 <- hc_trial_i64@validate_code(s);
                s_count: int64 <- hc_trial_i64@validate_count(s);
                m: { root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_max@singleton({ compare_item: cmp_i64 }, 7);
                m_peek: int64 <- hc_trial_i64@peek_code(m);
                println("empty_len");
                print_int64(e_len);
                println("");
                println("empty_is_empty");
                print_int64(e_empty);
                println("");
                println("empty_peek");
                print_int64(e_peek);
                println("");
                println("empty_pop");
                print_int64(e_pop);
                println("");
                println("empty_pop_rest_len");
                print_int64(e_rest);
                println("");
                println("empty_validate");
                print_int64(e_valid);
                println("");
                println("singleton_len");
                print_int64(s_len);
                println("");
                println("singleton_peek");
                print_int64(s_peek);
                println("");
                println("singleton_is_empty");
                print_int64(s_empty);
                println("");
                println("singleton_pop");
                print_int64(s_pop);
                println("");
                println("singleton_pop_rest_len");
                print_int64(s_rest);
                println("");
                println("singleton_validate");
                print_int64(s_valid);
                println("");
                println("singleton_count");
                print_int64(s_count);
                println("");
                println("max_singleton_peek");
                print_int64(m_peek);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
