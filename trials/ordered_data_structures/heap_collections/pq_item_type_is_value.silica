// priority_queue_trait.md §1, common_contract.md §1: for PriorityQueue[PriorityType, ItemType,
// mem(SpaceType)] the ItemType placeholder is the stored value (bracket parameter 2, compare_item
// witness), not the priority. A bare ItemType formal on a PriorityQueue[int64, string, mem(normal)]
// receiver takes the string value. Formerly the open defect compile_defects_item_type_addition
// (E2001: ItemType resolved to the first bracket parameter, the int64 priority).
// lib/StubPriorityQueue.silica is the minimal construction module the trial needs. Expected: x, exit 0.

use StubPriorityQueue;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a == b of {
        true -> :equal;
        false -> :less
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                q: PriorityQueue[int64, string, mem(normal)] <- StubPriorityQueue@empty({
                    compare_priority: cmp_i64,
                    compare_item: cmp_str
                });
                v: string <- StubPriorityQueue@value_only(q, "x");
                println(v)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
