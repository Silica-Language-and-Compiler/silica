// priority_queue_trait.md §3, §11.6: the PriorityQueue trait methods dispatched on the
// brodal_okasaki_priority record: len, peek, and the provided is_empty (exactly len == 0),
// peek_priority and peek_value, which describe the same entry as peek; on the empty queue (a
// bracket-typed constructor binding) and on {(4,4), (2,6), (2,1)} (inline-typed pushed queues).

use brodal_okasaki_priority;
use PriorityQueue;
use pq_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_val(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn status_code(r: { status: :not_found | :found, priority: int64, value: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

fn priority_status_code(r: { status: :not_found | :found, priority: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

fn value_status_code(r: { status: :not_found | :found, value: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: PriorityQueue[int64, int64, mem(normal)] <- brodal_okasaki_priority@empty({
                    compare_priority: cmp_i64,
                    compare_item: cmp_val
                });
                e_len: int64 <- PriorityQueue@len(e);
                e_empty: int64 <- pq_trial_i64@b2i(PriorityQueue@is_empty(e));
                ek: { status: :not_found | :found, priority: int64, value: int64 } <- PriorityQueue@peek(e, 0, 0);
                ek_status: int64 <- status_code(ek);
                ep: { status: :not_found | :found, priority: int64 } <- PriorityQueue@peek_priority(e, 0, 0);
                ep_status: int64 <- priority_status_code(ep);
                ev: { status: :not_found | :found, value: int64 } <- PriorityQueue@peek_value(e, 0, 0);
                ev_status: int64 <- value_status_code(ev);
                h1: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(e, 4, 4);
                h2: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(h1, 2, 6);
                h3: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: int64, value: int64, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(h2, 2, 1);
                h_len: int64 <- PriorityQueue@len(h3);
                h_empty: int64 <- pq_trial_i64@b2i(PriorityQueue@is_empty(h3));
                hk: { status: :not_found | :found, priority: int64, value: int64 } <- PriorityQueue@peek(h3, 0, 0);
                hk_status: int64 <- status_code(hk);
                hk_priority: int64 <- hk.priority;
                hk_value: int64 <- hk.value;
                hp: { status: :not_found | :found, priority: int64 } <- PriorityQueue@peek_priority(h3, 0, 0);
                hp_priority: int64 <- hp.priority;
                hv: { status: :not_found | :found, value: int64 } <- PriorityQueue@peek_value(h3, 0, 0);
                hv_value: int64 <- hv.value;
                agree: int64 <- pq_trial_i64@b2i(hp_priority == hk_priority and hv_value == hk_value
                    and priority_status_code(hp) == hk_status and value_status_code(hv) == hk_status);
                println("empty_len");
                print_int64(e_len);
                println("");
                println("empty_is_empty");
                print_int64(e_empty);
                println("");
                println("empty_peek_status");
                print_int64(ek_status);
                println("");
                println("empty_peek_priority_status");
                print_int64(ep_status);
                println("");
                println("empty_peek_value_status");
                print_int64(ev_status);
                println("");
                println("len");
                print_int64(h_len);
                println("");
                println("is_empty");
                print_int64(h_empty);
                println("");
                println("peek_status");
                print_int64(hk_status);
                println("");
                println("peek_priority");
                print_int64(hk_priority);
                println("");
                println("peek_value");
                print_int64(hk_value);
                println("");
                println("projected_priority");
                print_int64(hp_priority);
                println("");
                println("projected_value");
                print_int64(hv_value);
                println("");
                println("projections_agree");
                print_int64(agree);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
