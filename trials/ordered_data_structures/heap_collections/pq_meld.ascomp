    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #32
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #68
    B.ge L_pa_oob
