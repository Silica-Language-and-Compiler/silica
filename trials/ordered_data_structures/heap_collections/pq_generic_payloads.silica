// common_contract.md §1 (overriding genericity rule), priority_queue_trait.md §2, §13: PriorityType
// and ItemType are whatever the programmer declares. PriorityQueue[int64, string] with a
// table-driven string comparator on the values, and PriorityQueue[string, int64] with that
// comparator on the priorities, both through push/peek/pop and the PriorityQueue trait.

use brodal_okasaki_priority;
use PriorityQueue;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn rank_of(s: string) -> int64 {
    case s of {
        "alpha" -> 1;
        "bravo" -> 2;
        "charlie" -> 3;
        "delta" -> 4;
        "echo" -> 5;
        _: string -> 9
    }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case rank_of(a) < rank_of(b) of {
        true -> :less;
        false -> case rank_of(a) == rank_of(b) of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn a_values(queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }, { priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, acc: string) -> string {
    p: { queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }, { priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, priority: int64, value: string }
        <- brodal_okasaki_priority@pop_priority(queue, 0, "");
    case p.status of {
        :not_found -> acc;
        :found -> a_values(p.queue, concat(acc, p.value))
    }
}

fn a_priorities(queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }, { priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, acc: int64) -> int64 {
    p: { queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }, { priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, priority: int64, value: string }
        <- brodal_okasaki_priority@pop_priority(queue, 0, "");
    case p.status of {
        :not_found -> acc;
        :found -> a_priorities(p.queue, acc * 10 + p.priority)
    }
}

fn b_priorities(queue: { compare_priority: fn(string, string) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, acc: string) -> string {
    p: { queue: { compare_priority: fn(string, string) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, priority: string, value: int64 }
        <- brodal_okasaki_priority@pop_priority(queue, "", 0);
    case p.status of {
        :not_found -> acc;
        :found -> b_priorities(p.queue, concat(acc, p.priority))
    }
}

fn b_values(queue: { compare_priority: fn(string, string) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, acc: int64) -> int64 {
    p: { queue: { compare_priority: fn(string, string) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, priority: string, value: int64 }
        <- brodal_okasaki_priority@pop_priority(queue, "", 0);
    case p.status of {
        :not_found -> acc;
        :found -> b_values(p.queue, acc * 10 + p.value)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                qa: PriorityQueue[int64, string, mem(normal)] <- brodal_okasaki_priority@empty({
                    compare_priority: cmp_i64,
                    compare_item: cmp_str
                });
                a1: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }, { priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(qa, 2, "delta");
                a2: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }, { priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(a1, 1, "echo");
                a3: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }, { priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(a2, 2, "alpha");
                a4: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }, { priority: int64, value: string, priority_order: fn(int64, int64) -> :less | :equal | :greater, value_order: fn(string, string) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(a3, 3, "bravo");
                a_len: int64 <- PriorityQueue@len(a4);
                ak: { status: :not_found | :found, priority: int64, value: string } <- PriorityQueue@peek(a4, 0, "");
                ak_priority: int64 <- ak.priority;
                ak_value: string <- ak.value;
                a_vals: string <- a_values(a4, "");
                a_pris: int64 <- a_priorities(a4, 1);
                qb: PriorityQueue[string, int64, mem(normal)] <- brodal_okasaki_priority@empty({
                    compare_priority: cmp_str,
                    compare_item: cmp_i64
                });
                b1: { compare_priority: fn(string, string) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(qb, "charlie", 3);
                b2: { compare_priority: fn(string, string) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(b1, "alpha", 1);
                b3: { compare_priority: fn(string, string) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn({ priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }, { priority: string, value: int64, priority_order: fn(string, string) -> :less | :equal | :greater, value_order: fn(int64, int64) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_priority@push_priority(b2, "alpha", 0);
                b_len: int64 <- PriorityQueue@len(b3);
                bk: { status: :not_found | :found, priority: string, value: int64 } <- PriorityQueue@peek(b3, "", 0);
                bk_priority: string <- bk.priority;
                bk_value: int64 <- bk.value;
                b_pris: string <- b_priorities(b3, "");
                b_vals: int64 <- b_values(b3, 1);
                bv: { status: :not_found | :found, value: int64 } <- PriorityQueue@peek_value(b3, "", 0);
                bv_value: int64 <- bv.value;
                ap: { status: :not_found | :found, priority: int64 } <- PriorityQueue@peek_priority(a4, 0, "");
                ap_priority: int64 <- ap.priority;
                println("a_len");
                print_int64(a_len);
                println("");
                println("a_peek_priority");
                print_int64(ak_priority);
                println("");
                println("a_peek_value");
                println(ak_value);
                println("a_values");
                println(a_vals);
                println("a_priorities");
                print_int64(a_pris);
                println("");
                println("b_len");
                print_int64(b_len);
                println("");
                println("b_peek_priority");
                println(bk_priority);
                println("b_peek_value");
                print_int64(bk_value);
                println("");
                println("b_priorities");
                println(b_pris);
                println("b_values");
                print_int64(b_vals);
                println("");
                println("trait_b_peek_value");
                print_int64(bv_value);
                println("");
                println("trait_a_peek_priority");
                print_int64(ap_priority);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
