// heap_trait.md §5, §9, §10: large runs. 500 pseudo-random pushes on each orientation pop in sorted
// order (every intermediate heap validates) and match an insertion-sort oracle of the same values;
// 1000 ascending pushes on the min module and 1000 descending pushes on the max module keep the
// extreme item at the root and pop sorted.

use Heap;
use hc_trial_i64;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e_min: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_min();
                e_max: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@new_max();
                mn: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_lcg(e_min, 12345, 500, 0);
                mn_len: int64 <- Heap@len(mn);
                mn_valid: int64 <- hc_trial_i64@validate_code(mn);
                mn_count: int64 <- hc_trial_i64@validate_count(mn);
                mn_sorted: int64 <- hc_trial_i64@pops_sorted_code(mn, 500);
                mn_oracle: int64 <- hc_trial_i64@oracle_lcg_code(mn, 12345, 500);
                mx: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_lcg(e_max, 12345, 500, 0);
                mx_sorted: int64 <- hc_trial_i64@pops_sorted_code(mx, 500);
                mx_oracle: int64 <- hc_trial_i64@oracle_lcg_code(mx, 12345, 500);
                sq: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_seq(e_min, 0, 1000, 1);
                sq_len: int64 <- Heap@len(sq);
                sq_sorted: int64 <- hc_trial_i64@pops_sorted_code(sq, 1000);
                sq_peek: int64 <- hc_trial_i64@peek_code(sq);
                rv: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_seq(e_max, 999, -1, -1);
                rv_peek: int64 <- hc_trial_i64@peek_code(rv);
                rv_sorted: int64 <- hc_trial_i64@pops_sorted_code(rv, 1000);
                println("min_len");
                print_int64(mn_len);
                println("");
                println("min_validate");
                print_int64(mn_valid);
                println("");
                println("min_count");
                print_int64(mn_count);
                println("");
                println("min_sorted");
                print_int64(mn_sorted);
                println("");
                println("min_oracle");
                print_int64(mn_oracle);
                println("");
                println("max_sorted");
                print_int64(mx_sorted);
                println("");
                println("max_oracle");
                print_int64(mx_oracle);
                println("");
                println("seq_len");
                print_int64(sq_len);
                println("");
                println("seq_sorted");
                print_int64(sq_sorted);
                println("");
                println("seq_peek");
                print_int64(sq_peek);
                println("");
                println("rev_peek");
                print_int64(rv_peek);
                println("");
                println("rev_sorted");
                print_int64(rv_sorted);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
