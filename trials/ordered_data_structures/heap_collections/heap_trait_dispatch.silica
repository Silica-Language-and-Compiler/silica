// heap_trait.md §3: the Heap trait methods dispatched on both generated modules' records: len, peek,
// compare_item (the captured comparator in its natural ascending sense, on the max module too), and
// the provided is_empty (exactly len == 0), on the empty heap and on {4, 2, 6}. The receivers are a
// bracket-typed `Heap[int64, mem(normal)]` constructor binding and inline-typed pushed heaps.

use brodal_okasaki_min;
use brodal_okasaki_max;
use Heap;
use hc_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn items() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [4, 2, 6]
    produces
        pure xs
    end
}

fn status_code(r: { status: :not_found | :found, value: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

fn cmp_code(c: :less | :equal | :greater) -> int64 {
    case c of {
        :less -> 1;
        :equal -> 2;
        :greater -> 3
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                xs: List[int64, mem(normal)] <- items();
                e: Heap[int64, mem(normal)] <- brodal_okasaki_min@empty({ compare_item: cmp_i64 });
                e_len: int64 <- Heap@len(e);
                e_empty: int64 <- hc_trial_i64@b2i(Heap@is_empty(e));
                e_peek: { status: :not_found | :found, value: int64 } <- Heap@peek(e, 0);
                e_peek_status: int64 <- status_code(e_peek);
                h: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(e, xs);
                h_len: int64 <- Heap@len(h);
                h_empty: int64 <- hc_trial_i64@b2i(Heap@is_empty(h));
                h_peek: { status: :not_found | :found, value: int64 } <- Heap@peek(h, 0);
                h_peek_status: int64 <- status_code(h_peek);
                h_peek_value: int64 <- h_peek.value;
                c_less: int64 <- cmp_code(Heap@compare_item(h, 1, 2));
                c_equal: int64 <- cmp_code(Heap@compare_item(h, 2, 2));
                c_greater: int64 <- cmp_code(Heap@compare_item(h, 3, 2));
                mx: Heap[int64, mem(normal)] <- brodal_okasaki_max@empty({ compare_item: cmp_i64 });
                mxh: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- hc_trial_i64@push_digits(mx, xs);
                mx_peek: { status: :not_found | :found, value: int64 } <- Heap@peek(mxh, 0);
                mx_peek_value: int64 <- mx_peek.value;
                mx_less: int64 <- cmp_code(Heap@compare_item(mxh, 1, 2));
                mx_len: int64 <- Heap@len(mxh);
                mx_empty: int64 <- hc_trial_i64@b2i(Heap@is_empty(mxh));
                println("empty_len");
                print_int64(e_len);
                println("");
                println("empty_is_empty");
                print_int64(e_empty);
                println("");
                println("empty_peek_status");
                print_int64(e_peek_status);
                println("");
                println("len");
                print_int64(h_len);
                println("");
                println("is_empty");
                print_int64(h_empty);
                println("");
                println("peek_status");
                print_int64(h_peek_status);
                println("");
                println("peek_value");
                print_int64(h_peek_value);
                println("");
                println("compare_less");
                print_int64(c_less);
                println("");
                println("compare_equal");
                print_int64(c_equal);
                println("");
                println("compare_greater");
                print_int64(c_greater);
                println("");
                println("max_peek_value");
                print_int64(mx_peek_value);
                println("");
                println("max_compare_less");
                print_int64(mx_less);
                println("");
                println("max_len");
                print_int64(mx_len);
                println("");
                println("max_is_empty");
                print_int64(mx_empty);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
