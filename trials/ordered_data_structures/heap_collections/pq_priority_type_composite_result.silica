// priority_queue_trait.md §1, §3: PriorityType inside a composite result type. A generic module's
// result record { status, priority: PriorityType, value: ValueType } binds to the caller's concrete
// { status, priority: int64, value: string } for a PriorityQueue[int64, string, mem(normal)] receiver
// (resolve_constructor_call_formal substitutes PriorityType from bracket parameter 1 or the
// compare_priority witness, as it does ItemType/KeyType/ValueType). Formerly the open defect
// compile_defects_priority_type_addition (E2003, PriorityType never substituted).
// lib/StubPriorityQueue.silica is the minimal construction module (a registered PriorityQueue module
// name) the trial needs. Expected: 5, exit 0.

use StubPriorityQueue;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a == b of {
        true -> :equal;
        false -> :less
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                q: PriorityQueue[int64, string, mem(normal)] <- StubPriorityQueue@empty({
                    compare_priority: cmp_i64,
                    compare_item: cmp_str
                });
                r: { status: :not_found | :found, priority: int64, value: string } <- StubPriorityQueue@peek(q, 5, "x");
                p: int64 <- r.priority;
                print_int64(p);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
