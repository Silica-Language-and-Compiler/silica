// common_contract.md §1 (overriding genericity rule), heap_trait.md §2, §3: ItemType is whatever the
// programmer declares. String items with a table-driven comparator go through both generated
// modules and the Heap trait: peek, pop order, max orientation, compare_item in the comparator's
// natural ascending sense, meld, validate.

use brodal_okasaki_min;
use brodal_okasaki_max;
use Heap;
use trial_support_int64;

fn rank_of(s: string) -> int64 {
    case s of {
        "alpha" -> 1;
        "bravo" -> 2;
        "charlie" -> 3;
        "delta" -> 4;
        "echo" -> 5;
        _: string -> 9
    }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case rank_of(a) < rank_of(b) of {
        true -> :less;
        false -> case rank_of(a) == rank_of(b) of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn pop_joined(heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, acc: string) -> string {
    p: { heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: string } <- brodal_okasaki_min@pop(heap, "");
    case p.status of {
        :not_found -> acc;
        :found -> pop_joined(p.heap, concat(acc, p.value))
    }
}

fn cmp_code(c: :less | :equal | :greater) -> int64 {
    case c of {
        :less -> 1;
        :equal -> 2;
        :greater -> 3
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                e: Heap[string, mem(normal)] <- brodal_okasaki_min@empty({ compare_item: cmp_str });
                h1: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(e, "delta");
                h2: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(h1, "alpha");
                h3: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(h2, "echo");
                h4: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(h3, "bravo");
                h5: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(h4, "charlie");
                h_len: int64 <- Heap@len(h5);
                pk: { status: :not_found | :found, value: string } <- Heap@peek(h5, "");
                pk_value: string <- pk.value;
                pops: string <- pop_joined(h5, "");
                mx0: Heap[string, mem(normal)] <- brodal_okasaki_max@empty({ compare_item: cmp_str });
                mx1: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_max@push(mx0, "bravo");
                mx2: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_max@push(mx1, "echo");
                mk: { status: :not_found | :found, value: string } <- Heap@peek(mx2, "");
                mk_value: string <- mk.value;
                mx_pops: string <- pop_joined(mx2, "");
                c: int64 <- cmp_code(Heap@compare_item(h5, "alpha", "bravo"));
                mc: int64 <- cmp_code(Heap@compare_item(mx2, "alpha", "bravo"));
                o1: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(e, "echo");
                o2: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki_min@push(o1, "alpha");
                m: { heap: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki_min@meld(h5, o2);
                mh: { root: ref?(L, normal, rec), count: int64, max_oriented: boolean, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- m.heap;
                m_compatible: int64 <- case m.compatible of { true -> 1; false -> 0 };
                m_len: int64 <- Heap@len(mh);
                m_pops: string <- pop_joined(mh, "");
                v: { valid: boolean, error: atom, logical_count: int64 } <- brodal_okasaki_min@validate(mh);
                v_code: int64 <- brodal_okasaki_min@validate_error_code(v.error);
                println("len");
                print_int64(h_len);
                println("");
                println("peek");
                println(pk_value);
                println("pops");
                println(pops);
                println("max_peek");
                println(mk_value);
                println("max_pops");
                println(mx_pops);
                println("compare_item");
                print_int64(c);
                println("");
                println("max_compare_item");
                print_int64(mc);
                println("");
                println("meld_compatible");
                print_int64(m_compatible);
                println("");
                println("meld_len");
                print_int64(m_len);
                println("");
                println("meld_pops");
                println(m_pops);
                println("meld_validate");
                print_int64(v_code);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
