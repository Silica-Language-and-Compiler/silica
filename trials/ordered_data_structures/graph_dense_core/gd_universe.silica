// dense_matrix_graph.md §2–§3, §5 and CSR-D2/D3: the vertex universe is fixed by empty_for_nodes from
// a strictly ascending ID list; valid_universe reports acceptance, and an unsorted or duplicated
// list yields the empty universe. IDs 100, 200, 300 get slots 0, 1, 2, but slots are not vertices:
// has_vertex(0) is false and an edge between slot numbers is rejected. The empty universe answers
// every query. V is a runtime value, not part of the type: both graphs share one record type.

use graph_dense_directed;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident(x: int64) -> int64 {
    x
}

fn wide() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [100, 200, 300]
    produces
        pure xs
    end
}

fn unsorted() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [3, 1, 2]
    produces
        pure xs
    end
}

fn duplicated() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 2]
    produces
        pure xs
    end
}

fn none() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure xs
    end
}

fn make_dense(xs: List[int64, mem(normal)]) -> { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    graph_dense_directed@empty_for_nodes({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident }, xs)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: int64 <- live_trial_i64@put("valid_wide", live_trial_i64@b2i(graph_dense_directed@valid_universe({ compare_node: cmp_i64 }, wide())));
                _: int64 <- live_trial_i64@put("valid_unsorted", live_trial_i64@b2i(graph_dense_directed@valid_universe({ compare_node: cmp_i64 }, unsorted())));
                _: int64 <- live_trial_i64@put("valid_duplicated", live_trial_i64@b2i(graph_dense_directed@valid_universe({ compare_node: cmp_i64 }, duplicated())));
                _: int64 <- live_trial_i64@put("valid_empty", live_trial_i64@b2i(graph_dense_directed@valid_universe({ compare_node: cmp_i64 }, none())));
                w: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- make_dense(wide());
                _: int64 <- live_trial_i64@put("wide_nodes", graph_dense_directed@node_count(w));
                _: int64 <- live_trial_i64@put("wide_has_vertex_0", live_trial_i64@b2i(graph_dense_directed@has_vertex(w, 0)));
                _: int64 <- live_trial_i64@put("wide_has_vertex_200", live_trial_i64@b2i(graph_dense_directed@has_vertex(w, 200)));
                s: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(w, 0, 1);
                _: int64 <- live_trial_i64@put("slot_edge_rejected", live_trial_i64@b2i(s.rejected));
                t: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(w, 300, 100);
                _: int64 <- live_trial_i64@put("id_edge_inserted", live_trial_i64@b2i(t.inserted));
                _: int64 <- live_trial_i64@put("id_edge_has_300_100", live_trial_i64@b2i(graph_dense_directed@has_edge(t.graph, 300, 100)));
                _: int64 <- live_trial_i64@put("id_edge_has_2_0", live_trial_i64@b2i(graph_dense_directed@has_edge(t.graph, 2, 0)));
                u: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- make_dense(unsorted());
                _: int64 <- live_trial_i64@put("unsorted_nodes", graph_dense_directed@node_count(u));
                dd: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- make_dense(duplicated());
                _: int64 <- live_trial_i64@put("duplicated_nodes", graph_dense_directed@node_count(dd));
                e: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- make_dense(none());
                _: int64 <- live_trial_i64@put("empty_nodes", graph_dense_directed@node_count(e));
                en: List[int64, mem(normal)] <- graph_dense_directed@neighbors(e, 1);
                _: int64 <- live_trial_i64@put("empty_neighbors_1", live_trial_i64@list_code(en));
                ev: List[int64, mem(normal)] <- graph_dense_directed@vertices(e);
                _: int64 <- live_trial_i64@put("empty_vertices", live_trial_i64@list_code(ev));
                ea: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(e, 1, 1);
                _: int64 <- live_trial_i64@put("empty_add_rejected", live_trial_i64@b2i(ea.rejected));
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_directed@validate(e);
                _: int64 <- live_trial_i64@put("empty_valid", graph_dense_directed@validate_error_code(v.error) * 1000 + v.logical_count);
                wv: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_directed@validate(t.graph);
                _: int64 <- live_trial_i64@put("wide_valid", graph_dense_directed@validate_error_code(wv.error) * 1000 + wv.logical_count)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
