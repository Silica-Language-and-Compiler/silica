.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
    ; use graph_dense_directed, graph_dense_undirected, live_trial_i64, trial_support_int64
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



gd_validate_cmp_i64:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X3, LT
L_case_o881_br_0:
    CMP W3, #1
    B.NE L_case_o881_br_1
    MOV X0, #23
    B L_case_o881_done
L_case_o881_br_1:
    CMP W3, #0
    B.NE L_case_o881_fb
    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X3, EQ
L_case_o937_br_0:
    CMP W3, #1
    B.NE L_case_o937_br_1
    MOV X0, #24
    B L_case_o937_done
L_case_o937_br_1:
    CMP W3, #0
    B.NE L_case_o937_fb
    MOV X0, #25
    B L_case_o937_done
L_case_o937_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o937_done
L_case_o937_done:

    B L_case_o881_done
L_case_o881_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o881_done
L_case_o881_done:

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

gd_validate_cmp_desc:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X1
    STR X16, [SP, #-16]!
    MOV X16, X0
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o1098|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    MOV X8, XZR
    LDP X29, X30, [SP], #16

    ADRP X9, gd_validate_cmp_i64@PAGE
    ADD X9, X9, gd_validate_cmp_i64@PAGEOFF
    BR X9


