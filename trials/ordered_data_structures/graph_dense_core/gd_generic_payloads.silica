}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                sg: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- string_graph();
                _: int64 <- live_trial_i64@put("str_nodes", graph_dense_directed@node_count(sg));
                _: int64 <- live_trial_i64@put("str_edges", graph_dense_directed@edge_count(sg));
                sa: List[string, mem(normal)] <- graph_dense_directed@neighbors(sg, "a");
                _: int64 <- say("str_neighbors_a", join(sa, ""));
                sv: List[string, mem(normal)] <- graph_dense_directed@vertices(sg);
                _: int64 <- say("str_vertices", join(sv, ""));
                _: int64 <- live_trial_i64@put("str_has_c_a", live_trial_i64@b2i(graph_dense_directed@has_edge(sg, "c", "a")));
                _: int64 <- live_trial_i64@put("str_reachable_b_a", live_trial_i64@b2i(graph_dense_directed@reachable(sg, "b", "a")));
                ug: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- data_graph();
                n2: List[{ to: int64, data: string }, mem(normal)] <- graph_dense_undirected@neighbors(ug, 2);
                _: int64 <- say("udata_neighbors_2", join_data(n2, ""));
                n1: List[{ to: int64, data: string }, mem(normal)] <- graph_dense_undirected@neighbors(ug, 1);
                _: int64 <- say("udata_neighbors_1", join_data(n1, ""));
                uv: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_undirected@validate(ug);
                _: int64 <- live_trial_i64@put("udata_valid", graph_dense_undirected@validate_error_code(uv.error) * 1000 + uv.logical_count);
                wg: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, edge_weight: fn(int64) -> string, compare_weight: fn(string, string) -> :less | :equal | :greater, compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- weighted_graph();
                wxy: { status: :not_found | :found, weight: string } <- graph_dense_weighted@weight_of(wg, "x", "y", "none");
                _: int64 <- say("wstr_weight_x_y", wxy.weight);
                wxz: { status: :not_found | :found, weight: string } <- graph_dense_weighted@weight_of(wg, "x", "z", "none");
                _: int64 <- say("wstr_weight_x_z", wxz.weight);
                wzx: { status: :not_found | :found, weight: string } <- graph_dense_weighted@weight_of(wg, "z", "x", "none");
                _: int64 <- say("wstr_weight_z_x", wzx.weight);
                wn: List[{ to: string, data: int64 }, mem(normal)] <- graph_dense_weighted@weighted_neighbors(wg, "x");
                _: int64 <- say("wstr_neighbors_x", join_targets(wn, ""));
                xg: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge_data: fn(string, string) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater, edge_weight: fn(string) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 } <- length_graph();
                wqp: { status: :not_found | :found, weight: int64 } <- graph_dense_weighted_undirected@weight_of(xg, "q", "p", 0);
                _: int64 <- live_trial_i64@put("wlen_weight_q_p", wqp.weight);
                wrq: { status: :not_found | :found, weight: int64 } <- graph_dense_weighted_undirected@weight_of(xg, "r", "q", 0);
                _: int64 <- live_trial_i64@put("wlen_weight_r_q", wrq.weight);
                _: int64 <- live_trial_i64@put("wlen_degree_q", graph_dense_weighted_undirected@degree(xg, "q"));
                xv: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_weighted_undirected@validate(xg);
                _: int64 <- live_trial_i64@put("wlen_valid", graph_dense_weighted_undirected@validate_error_code(xv.error) * 1000 + xv.logical_count)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
