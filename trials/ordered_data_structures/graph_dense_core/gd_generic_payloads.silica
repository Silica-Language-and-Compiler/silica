// common_contract.md §1 overriding genericity rule on the dense graphs: string vertices with string
// payloads (directed, universe a < b < c), int64 vertices with string edge data (undirected),
// string vertices with int64 data and string weights (weighted directed), string vertices with string
// data and int64 byte-length weights (weighted undirected) — the gl_generic_payloads graphs built
// over fixed universes answer as the live graphs do.

use graph_dense_directed;
use graph_dense_undirected;
use graph_dense_weighted;
use graph_dense_weighted_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident_str(s: string) -> string {
    s
}

fn label(d: int64) -> string {
    case d < 5 of {
        true -> "light";
        false -> "heavy"
    }
}

fn byte_length(s: string) -> int64 {
    length_bytes(s)
}

fn abc() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[string, mem(normal)] <- ["a", "b", "c"]
    produces
        pure xs
    end
}

fn xyz() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[string, mem(normal)] <- ["x", "y", "z"]
    produces
        pure xs
    end
}

fn pqr() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[string, mem(normal)] <- ["p", "q", "r"]
    produces
        pure xs
    end
}

fn one_two_three() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3]
    produces
        pure xs
    end
}

fn join(xs: List[string, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> join(xs.tail, concat(concat(acc, ","), xs.head))
    }
}

fn join_data(xs: List[{ to: int64, data: string }, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: int64, data: string } <- xs.head;
            join_data(xs.tail, concat(concat(acc, ","), w.data))
        }
    }
}

fn join_targets(xs: List[{ to: string, data: int64 }, mem(normal)], acc: string) -> string {
    case xs.is_nil of {
        true -> acc;
        false -> {
            w: { to: string, data: int64 } <- xs.head;
            join_targets(xs.tail, concat(concat(acc, ","), w.to))
        }
    }
}

fn say(label: string, s: string) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(" ");
        println(s)
    produces
        pure 0
    end
}

fn add_s(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, from: string, to: string) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    r: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(g, from, to);
    r.graph
}

fn string_graph() -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    sequence
        s0: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_dense_directed@empty_for_nodes({ compare_node: cmp_str, compare_edge: cmp_str, edge_target: ident_str }, abc());
        s1: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (string, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (string, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(string, string) -> :less | :equal | :greater, compare_edge: fn(string, string) -> :less | :equal | :greater, edge_target: fn(string) -> string, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_s(s0, "b", "c");
