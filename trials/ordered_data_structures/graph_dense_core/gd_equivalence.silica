// Representation agreement (csr_dense_representation_contract.md CSR-D7 rule 3, through the public
// module operations): the same edges added to a live graph, a dense graph over the universe
// 0..24, and the CSR snapshot of the live graph give the same answers — has_edge for every ordered
// pair, out-degree / degree, neighbor lists, reachability / connectivity from vertex 0, fold sums,
// counts and validation — for 300 pseudo-random directed pairs and 300 undirected edges.

use graph_wbt_directed;
use graph_wbt_undirected;
use graph_csr_directed;
use graph_csr_undirected;
use graph_dense_directed;
use graph_dense_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident(x: int64) -> int64 {
    x
}

fn range(i: int64, n: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- case i >= n of {
            true -> empty[int64, mem(normal)]();
            false -> prepend[int64, mem(normal)](i, range(i + 1, n))
        }
    produces
        pure out
    end
}

fn pick(x: int64) -> int64 {
    (x / 65536) % 25
}

fn add_dd(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, a: int64, b: int64) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    r: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(g, a, b);
    r.graph
}

fn add_du(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, a: int64, b: int64, d: int64) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    r: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_edge(g, a, b, d);
    r.graph
}

fn random_both(live: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, dense: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, x: int64, k: int64) -> { live: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, dense: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } } {
    case k <= 0 of {
        true -> { live: live, dense: dense };
        false -> {
            x1: int64 <- live_trial_i64@lcg(x);
            x2: int64 <- live_trial_i64@lcg(x1);
            a: int64 <- pick(x1);
            b: int64 <- pick(x2);
            l1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- live_trial_i64@add_d(live, a, b);
            d1: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- add_dd(dense, a, b);
            random_both(l1, d1, x2, k - 1)
        }
    }
}

fn urandom_both(live: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, dense: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, x: int64, k: int64) -> { live: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, dense: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } } {
    case k <= 0 of {
        true -> { live: live, dense: dense };
        false -> {
            x1: int64 <- live_trial_i64@lcg(x);
            x2: int64 <- live_trial_i64@lcg(x1);
            a: int64 <- pick(x1);
            b: int64 <- pick(x2);
            l1: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- live_trial_i64@add_u(live, a, b, (a + b) % 10);
            d1: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- add_du(dense, a, b, (a + b) % 10);
            urandom_both(l1, d1, x2, k - 1)
        }
    }
}

fn same_list(xs: List[int64, mem(normal)], ys: List[int64, mem(normal)]) -> boolean {
    case xs.is_nil of {
        true -> ys.is_nil;
        false -> case ys.is_nil of {
            true -> false;
            false -> case xs.head == ys.head of {
                false -> false;
                true -> same_list(xs.tail, ys.tail)
            }
        }
    }
}

fn same_views(xs: List[{ to: int64, data: int64 }, mem(normal)], ys: List[{ to: int64, data: int64 }, mem(normal)]) -> boolean {
    case xs.is_nil of {
        true -> ys.is_nil;
        false -> case ys.is_nil of {
            true -> false;
            false -> {
                a: { to: int64, data: int64 } <- xs.head;
                b: { to: int64, data: int64 } <- ys.head;
                case a.to == b.to and a.data == b.data of {
                    false -> false;
                    true -> same_views(xs.tail, ys.tail)
                }
            }
        }
    }
}

fn d_pair_mismatches(l: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, d: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, p: int64, acc: int64) -> int64 {
    case p >= 625 of {
        true -> acc;
        false -> {
            a: boolean <- graph_wbt_directed@has_edge(l, p / 25, p % 25);
            b: boolean <- graph_csr_directed@has_edge(c, p / 25, p % 25);
            e: boolean <- graph_dense_directed@has_edge(d, p / 25, p % 25);
            bad: int64 <- 2 - live_trial_i64@b2i(a == b) - live_trial_i64@b2i(a == e);
            d_pair_mismatches(l, c, d, p + 1, acc + bad)
        }
    }
}

fn d_vertex_mismatches(l: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, d: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, v: int64, acc: int64) -> int64 {
    case v >= 25 of {
        true -> acc;
        false -> {
            da: int64 <- graph_wbt_directed@out_degree(l, v);
            db: int64 <- graph_csr_directed@out_degree(c, v);
            dc: int64 <- graph_dense_directed@out_degree(d, v);
            la: List[int64, mem(normal)] <- graph_wbt_directed@neighbors(l, v);
            lb: List[int64, mem(normal)] <- graph_csr_directed@neighbors(c, v);
            lc: List[int64, mem(normal)] <- graph_dense_directed@neighbors(d, v);
            ra: boolean <- graph_wbt_directed@reachable(l, 0, v);
            rb: boolean <- graph_csr_directed@reachable(c, 0, v);
            rc: boolean <- graph_dense_directed@reachable(d, 0, v);
            ok: int64 <- live_trial_i64@b2i(da == db) + live_trial_i64@b2i(da == dc) + live_trial_i64@b2i(same_list(la, lb)) + live_trial_i64@b2i(same_list(la, lc)) + live_trial_i64@b2i(ra == rb) + live_trial_i64@b2i(ra == rc);
            d_vertex_mismatches(l, c, d, v + 1, acc + 6 - ok)
        }
    }
}

fn u_pair_mismatches(l: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, d: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, p: int64, acc: int64) -> int64 {
    case p >= 625 of {
        true -> acc;
        false -> {
            a: boolean <- graph_wbt_undirected@has_edge(l, p / 25, p % 25);
            b: boolean <- graph_csr_undirected@has_edge(c, p / 25, p % 25);
            e: boolean <- graph_dense_undirected@has_edge(d, p / 25, p % 25);
            bad: int64 <- 2 - live_trial_i64@b2i(a == b) - live_trial_i64@b2i(a == e);
            u_pair_mismatches(l, c, d, p + 1, acc + bad)
        }
    }
}

fn u_vertex_mismatches(l: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, d: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, v: int64, acc: int64) -> int64 {
    case v >= 25 of {
        true -> acc;
        false -> {
            da: int64 <- graph_wbt_undirected@degree(l, v);
            db: int64 <- graph_csr_undirected@degree(c, v);
            dc: int64 <- graph_dense_undirected@degree(d, v);
            la: List[{ to: int64, data: int64 }, mem(normal)] <- graph_wbt_undirected@neighbors(l, v);
            lb: List[{ to: int64, data: int64 }, mem(normal)] <- graph_csr_undirected@neighbors(c, v);
            lc: List[{ to: int64, data: int64 }, mem(normal)] <- graph_dense_undirected@neighbors(d, v);
            ra: boolean <- graph_wbt_undirected@connected(l, 0, v);
            rb: boolean <- graph_csr_undirected@connected(c, 0, v);
            rc: boolean <- graph_dense_undirected@connected(d, 0, v);
            ok: int64 <- live_trial_i64@b2i(da == db) + live_trial_i64@b2i(da == dc) + live_trial_i64@b2i(same_views(la, lb)) + live_trial_i64@b2i(same_views(la, lc)) + live_trial_i64@b2i(ra == rb) + live_trial_i64@b2i(ra == rc);
            u_vertex_mismatches(l, c, d, v + 1, acc + 6 - ok)
        }
    }
}

fn sum_pair(acc: int64, from: int64, to: int64) -> int64 {
    acc + from * 1000 + to
}

fn sum_edge(acc: int64, a: int64, b: int64, data: int64) -> int64 {
    acc + a * 1000 + b * 10 + data
}

// The live graph over the whole universe 0..24 (isolated vertices included, as the dense universe).
fn with_universe(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, i: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    case i >= 25 of {
        true -> g;
        false -> {
            r: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean } <- graph_wbt_directed@add_vertex(g, i);
            with_universe(r.graph, i + 1)
        }
    }
}

fn uwith_universe(g: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, i: int64) -> { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } {
    case i >= 25 of {
        true -> g;
        false -> {
            r: { graph: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean } <- graph_wbt_undirected@add_vertex(g, i);
            uwith_universe(r.graph, i + 1)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                l0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- with_universe(live_trial_i64@new_d(), 0);
                d0: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_dense_directed@empty_for_nodes({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident }, range(0, 25));
                both: { live: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, dense: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } } <- random_both(l0, d0, 12345, 300);
                c: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_csr_directed@freeze_from_wbt(both.live);
                le: int64 <- graph_wbt_directed@edge_count(both.live);
                de: int64 <- graph_dense_directed@edge_count(both.dense);
                ce: int64 <- graph_csr_directed@edge_count(c);
                _: int64 <- live_trial_i64@put("edge_counts_agree", live_trial_i64@b2i(le == de and le == ce));
                _: int64 <- live_trial_i64@put("pair_mismatches", d_pair_mismatches(both.live, c, both.dense, 0, 0));
                _: int64 <- live_trial_i64@put("vertex_mismatches", d_vertex_mismatches(both.live, c, both.dense, 0, 0));
                s1: int64 <- graph_wbt_directed@fold_edges(both.live, 0, sum_pair);
                s2: int64 <- graph_dense_directed@fold_edges(both.dense, 0, sum_pair);
                _: int64 <- live_trial_i64@put("fold_agrees", live_trial_i64@b2i(s1 == s2));
                dv: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_directed@validate(both.dense);
                _: int64 <- live_trial_i64@put("dense_valid_code", graph_dense_directed@validate_error_code(dv.error));
                ul0: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- uwith_universe(live_trial_i64@new_u(), 0);
                ud0: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_dense_undirected@empty_for_nodes({ compare_node: cmp_i64, compare_edge_data: cmp_i64 }, range(0, 25));
                ub: { live: { root: ref?(L, normal, (int64, ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, dense: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } } <- urandom_both(ul0, ud0, 777, 300);
                uc: { node_ids: buf(L, normal, int64, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, int64, na), values: buf(L, normal, int64, na), slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_csr_undirected@freeze_from_wbt(ub.live);
                ule: int64 <- graph_wbt_undirected@edge_count(ub.live);
                ude: int64 <- graph_dense_undirected@edge_count(ub.dense);
                uce: int64 <- graph_csr_undirected@edge_count(uc);
                _: int64 <- live_trial_i64@put("u_edge_counts_agree", live_trial_i64@b2i(ule == ude and ule == uce));
                _: int64 <- live_trial_i64@put("u_pair_mismatches", u_pair_mismatches(ub.live, uc, ub.dense, 0, 0));
                _: int64 <- live_trial_i64@put("u_vertex_mismatches", u_vertex_mismatches(ub.live, uc, ub.dense, 0, 0));
                f1: int64 <- graph_wbt_undirected@fold_edges(ub.live, 0, sum_edge);
                f2: int64 <- graph_dense_undirected@fold_edges(ub.dense, 0, sum_edge);
                _: int64 <- live_trial_i64@put("u_fold_agrees", live_trial_i64@b2i(f1 == f2));
                uv: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_undirected@validate(ub.dense);
                _: int64 <- live_trial_i64@put("u_dense_valid_code", graph_dense_undirected@validate_error_code(uv.error))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
