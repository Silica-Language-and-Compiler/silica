// dense_matrix_graph.md §6, §9–§10 and undirected_graph_trait.md §5–§9 on graph_dense_undirected over
// {1, 2, 3, 4}: a non-loop edge writes both mirrored cells, a self-loop the one diagonal cell;
// re-adding either orientation replaces the data in both (flags 1); an endpoint outside the
// universe is rejected (flag 100); views (view_code), degree (loop twice), neighbor_entry_count,
// the canonical edge fold, connected, removal of both cells, persistence, validation; and the unit
// form through add_unit_edge.

use graph_dense_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_unit(a: unit, b: unit) -> :less | :equal | :greater {
    :equal
}

fn universe() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3, 4]
    produces
        pure xs
    end
}

fn edge_step(acc: int64, a: int64, b: int64, data: int64) -> int64 {
    acc * 1000 + a * 100 + b * 10 + data
}

fn flags3(r: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean }) -> int64 {
    100 * live_trial_i64@b2i(r.rejected) + live_trial_i64@flags(r.inserted, r.replaced)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                u0: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_dense_undirected@empty_for_nodes({ compare_node: cmp_i64, compare_edge_data: cmp_i64 }, universe());
                a: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_edge(u0, 1, 2, 7);
                _: int64 <- live_trial_i64@put("add_1_2_flags", flags3(a));
                _: int64 <- live_trial_i64@put("add_1_2_entries", graph_dense_undirected@adjacency_entry_count(a.graph));
                b: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_edge(a.graph, 2, 3, 8);
                c: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_edge(b.graph, 3, 3, 9);
                _: int64 <- live_trial_i64@put("loop_3_flags", flags3(c));
                d: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_edge(c.graph, 2, 1, 6);
                _: int64 <- live_trial_i64@put("readd_2_1_flags", flags3(d));
                x: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_edge(d.graph, 2, 9, 1);
                _: int64 <- live_trial_i64@put("outside_2_9_flags", flags3(x));
                g: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- x.graph;
                _: int64 <- live_trial_i64@put("edges", graph_dense_undirected@edge_count(g));
                _: int64 <- live_trial_i64@put("entries", graph_dense_undirected@adjacency_entry_count(g));
                n1: List[{ to: int64, data: int64 }, mem(normal)] <- graph_dense_undirected@neighbors(g, 1);
                _: int64 <- live_trial_i64@put("neighbors_1", live_trial_i64@view_code(n1));
                n2: List[{ to: int64, data: int64 }, mem(normal)] <- graph_dense_undirected@neighbors(g, 2);
                _: int64 <- live_trial_i64@put("neighbors_2", live_trial_i64@view_code(n2));
                n3: List[{ to: int64, data: int64 }, mem(normal)] <- graph_dense_undirected@neighbors(g, 3);
                _: int64 <- live_trial_i64@put("neighbors_3", live_trial_i64@view_code(n3));
                _: int64 <- live_trial_i64@put("degree_2", graph_dense_undirected@degree(g, 2));
                _: int64 <- live_trial_i64@put("degree_3", graph_dense_undirected@degree(g, 3));
                _: int64 <- live_trial_i64@put("degree_4", graph_dense_undirected@degree(g, 4));
                _: int64 <- live_trial_i64@put("entry_count_3", graph_dense_undirected@neighbor_entry_count(g, 3));
                _: int64 <- live_trial_i64@put("has_3_2", live_trial_i64@b2i(graph_dense_undirected@has_edge(g, 3, 2)));
                f: int64 <- graph_dense_undirected@fold_edges(g, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", f);
                _: int64 <- live_trial_i64@put("connected_1_3", live_trial_i64@b2i(graph_dense_undirected@connected(g, 1, 3)));
                _: int64 <- live_trial_i64@put("connected_1_4", live_trial_i64@b2i(graph_dense_undirected@connected(g, 1, 4)));
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_undirected@validate(g);
                _: int64 <- live_trial_i64@put("valid", graph_dense_undirected@validate_error_code(v.error) * 1000 + v.logical_count);
                r: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, removed: boolean } <- graph_dense_undirected@remove_edge(g, 3, 2);
                _: int64 <- live_trial_i64@put("remove_3_2", live_trial_i64@b2i(r.removed));
                _: int64 <- live_trial_i64@put("remove_3_2_entries", graph_dense_undirected@adjacency_entry_count(r.graph));
                _: int64 <- live_trial_i64@put("remove_3_2_has_2_3", live_trial_i64@b2i(graph_dense_undirected@has_edge(r.graph, 2, 3)));
                r2: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, removed: boolean } <- graph_dense_undirected@remove_edge(r.graph, 3, 3);
                _: int64 <- live_trial_i64@put("remove_loop_edges", graph_dense_undirected@edge_count(r2.graph));
                rv: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_undirected@validate(r2.graph);
                _: int64 <- live_trial_i64@put("after_remove_valid", graph_dense_undirected@validate_error_code(rv.error) * 1000 + rv.logical_count);
                ob: List[{ to: int64, data: int64 }, mem(normal)] <- graph_dense_undirected@neighbors(b.graph, 2);
                _: int64 <- live_trial_i64@put("old_b_neighbors_2", live_trial_i64@view_code(ob));
                z0: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_dense_undirected@empty_for_nodes({ compare_node: cmp_i64, compare_edge_data: cmp_unit }, universe());
                z1: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_unit_edge(z0, 4, 1);
                z2: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(unit, unit) -> :less | :equal | :greater, compare_value: fn(unit, unit) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_unit_edge(z1.graph, 1, 4);
                _: int64 <- live_trial_i64@put("unit_dup_flags", live_trial_i64@flags(z2.inserted, z2.replaced));
                _: int64 <- live_trial_i64@put("unit_edges", graph_dense_undirected@edge_count(z2.graph));
                _: int64 <- live_trial_i64@put("unit_has_1_4", live_trial_i64@b2i(graph_dense_undirected@has_edge(z2.graph, 1, 4)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
