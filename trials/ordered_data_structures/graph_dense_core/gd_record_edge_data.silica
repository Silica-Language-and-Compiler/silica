// Record edge data through the dense graphs (genericity rule, common_contract.md §1). The
// weighted_graph_trait.md §13 graph (10 -> 20 with {weight: 7}) over the universe {10, 20} must
// answer weight_of 7 and carry the record in its generated view; an undirected {label, cost} dense
// graph must return both fields in both directions. Formerly the open generic-payload layout defect
// defect_generic_payload_dense_record_data; passes since the uniform boxed record layout of 2026-09-18.
// Expected (derived from the designs): weight_status 1, weight 7, view_weight 7, u_label 3, u_cost 9,
// u_back_cost 9.

use graph_dense_weighted;
use graph_dense_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_weight_data(a: { weight: int64 }, b: { weight: int64 }) -> :less | :equal | :greater {
    cmp_i64(a.weight, b.weight)
}

fn weight_data_weight(d: { weight: int64 }) -> int64 {
    d.weight
}

fn compare_cost(a: { label: int64, cost: int64 }, b: { label: int64, cost: int64 }) -> :less | :equal | :greater {
    cmp_i64(a.cost, b.cost)
}

fn ten_twenty() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [10, 20]
    produces
        pure xs
    end
}

fn one_two() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn({ weight: int64 }, { weight: int64 }) -> :less | :equal | :greater, compare_value: fn({ weight: int64 }, { weight: int64 }) -> :less | :equal | :greater, edge_weight: fn({ weight: int64 }) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- graph_dense_weighted@empty_for_nodes({ compare_node: cmp_i64, compare_edge_data: compare_weight_data, edge_weight: weight_data_weight, compare_weight: cmp_i64 }, ten_twenty());
                d7: { weight: int64 } <- { weight: 7 };
                g1: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn({ weight: int64 }, { weight: int64 }) -> :less | :equal | :greater, compare_value: fn({ weight: int64 }, { weight: int64 }) -> :less | :equal | :greater, edge_weight: fn({ weight: int64 }) -> int64, compare_weight: fn(int64, int64) -> :less | :equal | :greater, compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_weighted@add_edge(g0, 10, 20, d7);
                w: { status: :not_found | :found, weight: int64 } <- graph_dense_weighted@weight_of(g1.graph, 10, 20, 0);
                _: int64 <- live_trial_i64@put("weight_status", case w.status of { :found -> 1; :not_found -> 0 });
                _: int64 <- live_trial_i64@put("weight", w.weight);
                vs: List[{ to: int64, data: { weight: int64 } }, mem(normal)] <- graph_dense_weighted@neighbors(g1.graph, 10);
                v: { to: int64, data: { weight: int64 } } <- vs.head;
                vd: { weight: int64 } <- v.data;
                _: int64 <- live_trial_i64@put("view_weight", vd.weight);
                u0: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn({ label: int64, cost: int64 }, { label: int64, cost: int64 }) -> :less | :equal | :greater, compare_value: fn({ label: int64, cost: int64 }, { label: int64, cost: int64 }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- graph_dense_undirected@empty_for_nodes({ compare_node: cmp_i64, compare_edge_data: compare_cost }, one_two());
                cc: { label: int64, cost: int64 } <- { label: 3, cost: 9 };
                u1: { graph: { cells: List[(int64, ref?(L, normal, rec)), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, rec)), mem(normal)], slot_root: ref?(L, normal, rec), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn({ label: int64, cost: int64 }, { label: int64, cost: int64 }) -> :less | :equal | :greater, compare_value: fn({ label: int64, cost: int64 }, { label: int64, cost: int64 }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_undirected@add_edge(u0, 1, 2, cc);
                us: List[{ to: int64, data: { label: int64, cost: int64 } }, mem(normal)] <- graph_dense_undirected@neighbors(u1.graph, 2);
                u: { to: int64, data: { label: int64, cost: int64 } } <- us.head;
                ud: { label: int64, cost: int64 } <- u.data;
                _: int64 <- live_trial_i64@put("u_label", ud.label);
                _: int64 <- live_trial_i64@put("u_cost", ud.cost);
                bs: List[{ to: int64, data: { label: int64, cost: int64 } }, mem(normal)] <- graph_dense_undirected@neighbors(u1.graph, 1);
                b: { to: int64, data: { label: int64, cost: int64 } } <- bs.head;
                bd: { label: int64, cost: int64 } <- b.data;
                _: int64 <- live_trial_i64@put("u_back_cost", bd.cost)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
