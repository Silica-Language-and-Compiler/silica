// dense_matrix_graph.md §4, §6 and weighted_graph_trait.md §6–§9 on graph_dense_weighted and
// graph_dense_weighted_undirected over {1, 2, 3} (weight = twice the data): each cell carries the
// complete edge data; replacement changes data only (flags 1); weight_of finds the extracted weight
// or returns the placeholder (status 1/0); weighted views in target order; mirrored undirected cells
// answer the same weight in both orientations; folds, degrees, reachability and validation.

use graph_dense_weighted;
use graph_dense_weighted_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn twice(x: int64) -> int64 {
    x * 2
}

fn universe() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3]
    produces
        pure xs
    end
}

fn data_step(acc: int64, w: { to: int64, data: int64 }) -> int64 {
    acc + w.data
}

fn edge_step(acc: int64, from: int64, w: { to: int64, data: int64 }) -> int64 {
    acc * 1000 + from * 100 + w.to * 10 + w.data
}

fn status_code(r: { status: :not_found | :found, weight: int64 }) -> int64 {
    case r.status of {
        :found -> 1;
        :not_found -> 0
    }
}

