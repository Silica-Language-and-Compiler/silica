// dense_matrix_graph.md §10–§11 and common_contract.md §12 on the dense validators (printed as error
// code * 1000 + logical_count; graph_dense_core@validate_error_code: 0 ok, 1 negative_count,
// 2 dense_cell_mismatch, 5 slot_mismatch, 6 target_mismatch,
// 7 edge_count_mismatch, 8 undirected_asymmetry). Malformed graphs replace one record field of a real
// one: a negative count, a cell count that is not V * V, a reversed node comparator (the node_to_slot
// WBT index is then out of order, so the index check reports it before the slot-order walk),
// another universe's node_to_slot map, a different payload extractor, a wrong edge count, and a
// directed graph's one-way cells read as undirected.

use graph_dense_directed;
use graph_dense_undirected;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_desc(a: int64, b: int64) -> :less | :equal | :greater {
    cmp_i64(b, a)
}

fn ident(x: int64) -> int64 {
    x
}

fn add_one(x: int64) -> int64 {
    x + 1
}

fn universe() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3]
    produces
        pure xs
    end
}

fn other_universe() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 4]
    produces
        pure xs
    end
}

fn add(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, a: int64, b: int64) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    r: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(g, a, b);
    r.graph
}

fn code(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> int64 {
    v: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_directed@validate(g);
    graph_dense_directed@validate_error_code(v.error) * 1000 + v.logical_count
}

fn ucode(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 }) -> int64 {
    v: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_undirected@validate(g);
    graph_dense_undirected@validate_error_code(v.error) * 1000 + v.logical_count
}

fn source() -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    g0: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_dense_directed@empty_for_nodes({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident }, universe());
    add(add(g0, 1, 2), 2, 3)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                a: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- source();
                o: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_dense_directed@empty_for_nodes({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident }, other_universe());
                _: int64 <- live_trial_i64@put("valid", code(a));
                neg: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { cells: a.cells, cell_count: a.cell_count, slots: a.slots, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: -1, edge_count: 2, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("negative_count", code(neg));
                cells: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { cells: a.cells, cell_count: 8, slots: a.slots, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 2, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("cell_count_not_v_squared", code(cells));
                desc: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { cells: a.cells, cell_count: 9, slots: a.slots, slot_root: a.slot_root, compare_node: cmp_desc, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 2, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("reversed_comparator", code(desc));
                slots: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { cells: a.cells, cell_count: 9, slots: a.slots, slot_root: o.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 2, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("slot_map", code(slots));
                extr: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { cells: a.cells, cell_count: 9, slots: a.slots, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: add_one, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 2, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("target_mismatch", code(extr));
                cnt: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- { cells: a.cells, cell_count: 9, slots: a.slots, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge: a.compare_edge, edge_target: a.edge_target, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 3, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_ordering_bundle: a.compare_edge_ordering_bundle, edge_target_ordering_bundle: a.edge_target_ordering_bundle };
                _: int64 <- live_trial_i64@put("edge_count_mismatch", code(cnt));
                und: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge_data: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64 } <- { cells: a.cells, cell_count: 9, slots: a.slots, slot_root: a.slot_root, compare_node: a.compare_node, compare_edge_data: a.compare_edge, compare_value: a.compare_edge, region: a.region, specialization_key: a.specialization_key, node_count: 3, edge_count: 2, adjacency_entry_count: 2, compare_node_ordering_bundle: a.compare_node_ordering_bundle, compare_edge_data_ordering_bundle: a.compare_edge_ordering_bundle };
                _: int64 <- live_trial_i64@put("undirected_asymmetry", ucode(und))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
