// dense_matrix_graph.md §2, §5–§9 and directed_graph_trait.md §4–§6 on graph_dense_directed over the
// universe {1, 2, 3, 5}: every cell starts absent; add_edge sets one cell (flags 10 * inserted +
// replaced), a comparator-equal payload is a no-op, an endpoint outside the universe is rejected
// with the graph unchanged, a self-loop is one diagonal cell; neighbors scan a row in ascending
// target order; out_degree, has_edge, reachable, the folds; remove_edge clears one cell (a missing
// edge is a no-op); every older version is unchanged; validation.

use graph_dense_directed;
use live_trial_i64;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident(x: int64) -> int64 {
    x
}

fn universe() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 2, 3, 5]
    produces
        pure xs
    end
}

fn vertex_step(acc: int64, v: int64) -> int64 {
    acc * 10 + v
}

fn edge_step(acc: int64, from: int64, to: int64) -> int64 {
    acc * 100 + from * 10 + to
}

fn sum_step(acc: int64, e: int64) -> int64 {
    acc + e
}

fn flags3(r: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean }) -> int64 {
    100 * live_trial_i64@b2i(r.rejected) + live_trial_i64@flags(r.inserted, r.replaced)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                g0: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- graph_dense_directed@empty_for_nodes({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident }, universe());
                _: int64 <- live_trial_i64@put("empty_nodes", graph_dense_directed@node_count(g0));
                _: int64 <- live_trial_i64@put("empty_edges", graph_dense_directed@edge_count(g0));
                _: int64 <- live_trial_i64@put("empty_has_1_2", live_trial_i64@b2i(graph_dense_directed@has_edge(g0, 1, 2)));
                a: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(g0, 1, 3);
                _: int64 <- live_trial_i64@put("add_1_3_flags", flags3(a));
                b: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(a.graph, 1, 2);
                c: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(b.graph, 1, 3);
                _: int64 <- live_trial_i64@put("dup_1_3_flags", flags3(c));
                d: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(c.graph, 5, 5);
                _: int64 <- live_trial_i64@put("loop_5_flags", flags3(d));
                e: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(d.graph, 1, 4);
                _: int64 <- live_trial_i64@put("outside_1_4_flags", flags3(e));
                f: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(e.graph, 9, 1);
                _: int64 <- live_trial_i64@put("outside_9_1_flags", flags3(f));
                h: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } <- graph_dense_directed@add_edge(f.graph, 3, 2);
                g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- h.graph;
                _: int64 <- live_trial_i64@put("nodes", graph_dense_directed@node_count(g));
                _: int64 <- live_trial_i64@put("edges", graph_dense_directed@edge_count(g));
                _: int64 <- live_trial_i64@put("has_vertex_4", live_trial_i64@b2i(graph_dense_directed@has_vertex(g, 4)));
                n1: List[int64, mem(normal)] <- graph_dense_directed@neighbors(g, 1);
                _: int64 <- live_trial_i64@put("neighbors_1", live_trial_i64@list_code(n1));
                n2: List[int64, mem(normal)] <- graph_dense_directed@neighbors(g, 2);
                _: int64 <- live_trial_i64@put("neighbors_2", live_trial_i64@list_code(n2));
                n9: List[int64, mem(normal)] <- graph_dense_directed@neighbors(g, 9);
                _: int64 <- live_trial_i64@put("neighbors_9", live_trial_i64@list_code(n9));
                vs: List[int64, mem(normal)] <- graph_dense_directed@vertices(g);
                _: int64 <- live_trial_i64@put("vertices", live_trial_i64@list_code(vs));
                _: int64 <- live_trial_i64@put("out_degree_1", graph_dense_directed@out_degree(g, 1));
                _: int64 <- live_trial_i64@put("out_degree_5", graph_dense_directed@out_degree(g, 5));
                _: int64 <- live_trial_i64@put("has_3_2", live_trial_i64@b2i(graph_dense_directed@has_edge(g, 3, 2)));
                _: int64 <- live_trial_i64@put("has_2_3", live_trial_i64@b2i(graph_dense_directed@has_edge(g, 2, 3)));
                _: int64 <- live_trial_i64@put("reachable_1_2", live_trial_i64@b2i(graph_dense_directed@reachable(g, 1, 2)));
                _: int64 <- live_trial_i64@put("reachable_2_1", live_trial_i64@b2i(graph_dense_directed@reachable(g, 2, 1)));
                _: int64 <- live_trial_i64@put("reachable_2_2", live_trial_i64@b2i(graph_dense_directed@reachable(g, 2, 2)));
                fv: int64 <- graph_dense_directed@fold_vertices(g, 0, vertex_step);
                _: int64 <- live_trial_i64@put("fold_vertices", fv);
                fe: int64 <- graph_dense_directed@fold_edges(g, 1, edge_step);
                _: int64 <- live_trial_i64@put("fold_edges", fe);
                fn1: int64 <- graph_dense_directed@fold_neighbors(g, 0, sum_step, 1);
                _: int64 <- live_trial_i64@put("fold_neighbors_1", fn1);
                v: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_directed@validate(g);
                _: int64 <- live_trial_i64@put("valid", graph_dense_directed@validate_error_code(v.error) * 1000 + v.logical_count);
                r1: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_dense_directed@remove_edge(g, 1, 3);
                _: int64 <- live_trial_i64@put("remove_1_3", live_trial_i64@b2i(r1.removed));
                _: int64 <- live_trial_i64@put("remove_1_3_edges", graph_dense_directed@edge_count(r1.graph));
                r2: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_dense_directed@remove_edge(r1.graph, 1, 3);
                _: int64 <- live_trial_i64@put("remove_again", live_trial_i64@b2i(r2.removed));
                r3: { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (int64, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(int64, int64) -> :less | :equal | :greater, compare_edge: fn(int64, int64) -> :less | :equal | :greater, edge_target: fn(int64) -> int64, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } <- graph_dense_directed@remove_edge(r2.graph, 7, 1);
                _: int64 <- live_trial_i64@put("remove_outside", live_trial_i64@b2i(r3.removed));
                m1: List[int64, mem(normal)] <- graph_dense_directed@neighbors(r3.graph, 1);
                _: int64 <- live_trial_i64@put("after_remove_neighbors_1", live_trial_i64@list_code(m1));
                rv: { valid: boolean, error: atom, logical_count: int64 } <- graph_dense_directed@validate(r3.graph);
                _: int64 <- live_trial_i64@put("after_remove_valid", graph_dense_directed@validate_error_code(rv.error) * 1000 + rv.logical_count);
                o1: List[int64, mem(normal)] <- graph_dense_directed@neighbors(g, 1);
                _: int64 <- live_trial_i64@put("old_neighbors_1", live_trial_i64@list_code(o1));
                _: int64 <- live_trial_i64@put("old_a_edges", graph_dense_directed@edge_count(a.graph));
                _: int64 <- live_trial_i64@put("old_empty_has_1_3", live_trial_i64@b2i(graph_dense_directed@has_edge(g0, 1, 3)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
