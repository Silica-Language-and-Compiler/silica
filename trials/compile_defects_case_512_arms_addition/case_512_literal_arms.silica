fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- println(case id_of(3) == :p3 of { true -> "p3 ok"; false -> "p3 bad" });
        _: atom <- println(case id_of(511) == :p511 of { true -> "p511 ok"; false -> "p511 bad" });
        _: atom <- println(case id_of(512) == :p_overflow of { true -> "overflow ok"; false -> "overflow bad" })
    produces pure 0 end
}
