.text
    ; use trial_support_atom
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o166|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_start@PAGE
    ADD X9, X9, trial_support_atom_start@PAGEOFF
    BLR X9

    ADRP X16, train_int16_chain_10018.__lam0@PAGE
    ADD X16, X16, train_int16_chain_10018.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o216|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_run@PAGE
    ADD X9, X9, trial_support_atom_run@PAGEOFF
    BLR X9

    BL _silica_rt_wait_for_exit

    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

train_int16_chain_10018.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi16_0@PAGE
    ADD X1, X1, L_pi16_0@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #2


    ; effects [device_io]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    MOV W9, #19
    MOV W10, #58


    ADD W9, W9, W10
    MOV W10, #54


    ADD W0, W9, W10
    ; effects [device_io]
    SXTH X0, W0
    BL L_pi_helper
    MOV X0, #2

    ; effects [device_io]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi16_0@PAGE
    ADD X1, X1, L_pi16_0@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #2


    ; effects [device_io]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    MOV W9, #38
    MOV W10, #42


    CMP W10, #0
    B.NE 1f
    BL _silica_rt_badarith
1:
    SDIV W16, W9, W10
    MSUB W0, W16, W10, W9
    ; effects [device_io]
    SXTH X0, W0
    BL L_pi_helper
    MOV X0, #2

    MOV X19, X0
    MOV X0, X19







    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pi_helper:
    SUB SP, SP, #32
    MOV X10, SP
    ADD X10, X10, #24
    MOV X11, #0
    CMP X0, #0
    B.ge L_pi_pos
    MOV X11, #1
    NEG X0, X0
L_pi_pos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pi_zero
    MOV X9, #10
L_pi_loop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pi_loop
    B L_pi_maybe_neg
L_pi_zero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pi_maybe_neg:
    CBNZ X11, L_pi_prepend_minus
    B L_pi_do_write
L_pi_prepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pi_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #32
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

