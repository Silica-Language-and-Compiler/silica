// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((19 + 8) < 43 / 38);
                println("");
                _: atom <- print_boolean((21 + 18) != 8);
                println("");
                _: atom <- print_boolean((52 + 4) < 59);
                println("");
                _: atom <- print_boolean(57 % 20 != (40 * 55));
                println("");
                result: atom <- print_boolean(41 <= (35 + 55))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
