// int16 bindings then expression; expect 41
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            height: int16 <- 56;
            step: int16 <- (46 - 2) / (55 + height);
            m: int16 <- height;
            width: int16 <- 12;
            41 + step - step + m - m + width - width
        });
        _: int64 <- wait_for_exit()
    produces
        pure 41
    end
}
