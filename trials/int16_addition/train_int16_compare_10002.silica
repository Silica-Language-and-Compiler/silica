// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(23 % 59 >= 10);
                println("");
                _: atom <- print_boolean((13 + 8) < 37);
                println("");
                _: atom <- print_boolean(18 > 50 * 58);
                println("");
                _: atom <- print_boolean(3 * 52 >= 51);
                println("");
                result: atom <- print_boolean(3 % 53 == (30 + 53))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
