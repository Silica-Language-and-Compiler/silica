// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(5 == (59 - 14));
                println("");
                _: atom <- print_boolean(0 % 29 == (19 % 16));
                println("");
                _: atom <- print_boolean((54 + 49) >= (41 + 36));
                println("");
                _: atom <- print_boolean((43 + 46) <= (15 + 32));
                println("");
                result: atom <- print_boolean(0 / 25 == (43 - 35))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
