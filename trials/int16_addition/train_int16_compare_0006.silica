// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(1 * 1 <= (38 - 38));
                println("");
                _: atom <- print_boolean((33 + 23) > 43 * 52);
                println("");
                _: atom <- print_boolean(4 != 25 / 35);
                println("");
                _: atom <- print_boolean((59 + 53) == 20 * 37);
                println("");
                result: atom <- print_boolean(16 >= 56 % 39)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
