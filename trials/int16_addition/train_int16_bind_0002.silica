// int16 bindings then expression; expect 14
use trial_support_int16;

fn main() -> int16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int16@start();
        _: boolean <- trial_support_int16@run(fn() -> int16 {
            height: int16 <- 49;
            b: int16 <- height + height;
            c: int16 <- height * b % (height / height);
            total: int16 <- b - 31;
            12 + 2 + c - c + total - total
        });
        _: int64 <- wait_for_exit()
    produces
        pure 14
    end
}
