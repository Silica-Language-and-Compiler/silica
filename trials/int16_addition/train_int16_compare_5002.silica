// int16 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(56 == 22 / 30);
                println("");
                _: atom <- print_boolean((6 + 52) >= 34);
                println("");
                _: atom <- print_boolean((15 + 41) > (22 + 17));
                println("");
                _: atom <- print_boolean(55 != 9);
                println("");
                result: atom <- print_boolean(8 == 34 / 46)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
