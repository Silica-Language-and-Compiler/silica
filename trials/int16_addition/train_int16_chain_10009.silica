// chained print_int16 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_int16(26);
                println("");
                _: atom <- print_int16(25 % 59);
                println("");
                _: atom <- print_int16(((38 - 12) % (47 / 24)));
                println("");
                result: atom <- print_int16(58)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
