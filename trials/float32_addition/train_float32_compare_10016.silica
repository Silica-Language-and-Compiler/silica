// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(17.25 >= 20.25 / 2.25);
                println("");
                _: atom <- print_boolean(18.0 == (37.375 + 24.25));
                println("");
                _: atom <- print_boolean((24.5 - 20.5) > (10.25 - 27.75));
                println("");
                done: atom <- print_boolean(0.125 < 25.0 * 1.25)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
