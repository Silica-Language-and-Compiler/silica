// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((27.5 - 37.5) <= (38.25 + 26.25));
                println("");
                _: atom <- print_boolean(5.125 <= 5.5);
                println("");
                done: atom <- print_boolean(27.5 != (39.75 + 38.125))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
