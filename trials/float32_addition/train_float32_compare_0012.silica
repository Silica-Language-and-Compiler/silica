// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(5.125 * 23.0 < (35.75 - 21.25));
                println("");
                _: atom <- print_boolean(17.0 == 17.75);
                println("");
                _: atom <- print_boolean(21.375 * 7.125 == (31.5 + 10.5));
                println("");
                done: atom <- print_boolean(4.125 * 21.25 < 36.0 * 35.5)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
