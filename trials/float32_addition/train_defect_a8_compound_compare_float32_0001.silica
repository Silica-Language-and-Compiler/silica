// defect A8: float compare with compound operands on both sides (untyped literals are float32)
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(3.0 + 4.0 > 1.0 + 1.0);
                println("");
                _: atom <- print_boolean((5.5 + 29.0) > (9.375 + 18.0));
                println("");
                _: atom <- print_boolean(3.0 * 4.0 > 1.0 * 1.0);
                println("");
                _: atom <- print_boolean((25.0 + 0.125) >= 7.125);
                println("");
                a: float64 <- 3.0 + 4.0;
                b: float64 <- 1.0 + 1.0;
                done: atom <- print_boolean(a > b)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
