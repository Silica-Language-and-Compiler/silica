// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((8.75 - 27.75) < 11.375);
                println("");
                _: atom <- print_boolean(9.25 >= 30.375);
                println("");
                _: atom <- print_boolean(30.0 != (0.75 - 22.5));
                println("");
                done: atom <- print_boolean((31.5 + 11.25) == (39.0 + 13.25))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
