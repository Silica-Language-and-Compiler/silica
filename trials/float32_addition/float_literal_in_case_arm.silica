// The float32 half of float64_addition/float_literal_in_case_arm: a float32 literal in a case arm of
// a function that is not `main` had no entry in the float32 literal pool and was emitted as the
// undefined label `L_f32_`. Fixed 2026-09-19.
// Expected, by hand: 10.25 and 42.75, each on its own line (println follows each print), then the
// exit status 0. (add.scout's "42.750" is "42.75" with no newline, followed by the status "0".)

use trial_support_int64;

fn pick(n: int64) -> float32 {
    case n == 0 of {
        true -> 10.25;
        false -> 42.75
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_float32(pick(0));
                println("");
                _: atom <- print_float32(pick(1));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
