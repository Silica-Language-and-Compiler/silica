// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(30.5 / 0.5 != 29.75);
                println("");
                _: atom <- print_boolean(1.25 * 18.75 == 1.5 * 35.25);
                println("");
                _: atom <- print_boolean((29.0 - 28.0) > 9.25);
                println("");
                done: atom <- print_boolean((27.25 - 29.0) < 18.5 * 3.5)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
