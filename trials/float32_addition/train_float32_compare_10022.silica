// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((5.0 + 34.125) > 16.0);
                println("");
                _: atom <- print_boolean((14.5 - 22.75) != (7.0 + 17.75));
                println("");
                done: atom <- print_boolean(8.0 <= (29.5 + 38.375))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
