// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(4.0 * 10.25 > (13.0 + 13.5));
                println("");
                _: atom <- print_boolean(14.25 > 16.5);
                println("");
                _: atom <- print_boolean(37.25 <= (36.0 - 23.125));
                println("");
                done: atom <- print_boolean(3.75 == (7.0 + 23.25))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
