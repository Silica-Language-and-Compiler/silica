use trial_support_atom;

fn left32() -> float32 {
    40.5
}

fn right32() -> float32 {
    2.25
}

fn next32(x: float32) -> float32 {
    x + 1.0
}

fn add_with_next32(x: float32) -> float32 {
    x + next32(x)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                expected_sum: float32 <- 42.75;
                expected_param: float32 <- 5.0;
                _: atom <- print_boolean((left32() + right32()) == expected_sum);
                _: unit <- println("");
                base: float32 <- 40.5;
                _: atom <- print_boolean((base + right32()) == expected_sum);
                _: unit <- println("");
                done: atom <- print_boolean(add_with_next32(2.0) == expected_param);
                _: unit <- println("")
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
