// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(4.0 < 28.0);
                println("");
                _: atom <- print_boolean((39.375 - 8.125) < 22.0);
                println("");
                _: atom <- print_boolean((33.5 + 28.75) > 25.0);
                println("");
                done: atom <- print_boolean(20.25 > (18.5 + 15.5))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
