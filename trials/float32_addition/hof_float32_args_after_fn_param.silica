// The float32 twin of float64_addition/hof_float_args_after_fn_param: float32 arguments that follow
// a function-typed parameter, which the callee moves from its incoming float registers into the
// outgoing ones to call its function parameter. The float64 forms printed wrong values with literal
// arguments; these float32 forms were right before the fix and guard the same register moves.
// Expected, by hand: 7.5 (bound a, b), 7.5 (literals), 8.5 (7.5 + 1.0), 2.5 (2.0 + 0.5), 7.5
// (plain two-float call, control); exits 0.
use trial_support_int64;

fn addf32(a: float32, b: float32) -> float32 {
    a + b
}

fn apply2_32(f: fn(float32, float32) -> float32, x: float32, y: float32) -> float32 {
    f(x, y)
}

fn apply2_nontail(f: fn(float32, float32) -> float32, x: float32, y: float32) -> float32 {
    f(x, y) + 1.0
}

fn apply_mixed(n: int64, f: fn(float32, float32) -> float32, x: float32) -> float32 {
    f(x, 0.5) + 0.0
}

fn plain2(x: float32, y: float32) -> float32 {
    x + y
}

fn show(v: float32) -> atom {
    sequence proc[device_io]
        _: atom <- print_float32(v);
        r: atom <- println("")
    produces
        pure r
    end
}

fn work() -> int64 {
    sequence
        a: float32 <- 3.0;
        b: float32 <- 4.5;
        _: atom <- show(apply2_32(addf32, a, b));
        _: atom <- show(apply2_32(addf32, 3.0, 4.5));
        _: atom <- show(apply2_nontail(addf32, 3.0, 4.5));
        _: atom <- show(apply_mixed(7, addf32, 2.0));
        _: atom <- show(plain2(3.0, 4.5))
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            work()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
