// defect A1: returning the second float32 parameter; second(1.5, 2.25) = 2.25
use trial_support_atom;

fn second(x: float32, y: float32) -> float32 {
    y
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_float32(second(1.5, 2.25))
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
