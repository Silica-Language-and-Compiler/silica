// float32 twin of float64_addition/case_float_compare_params: a case on a comparison of two float32
// parameters whose arms return those parameters. The compare staged its operands in S1/S2, which
// overwrote b's register S1, so the true arm returned a.
use trial_support_atom;

fn bigger(a: float32, b: float32) -> float32 {
    case a < b of {
        true -> b;
        false -> a
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] r: atom <- print_float32(bigger(1.5, 2.5)) produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
