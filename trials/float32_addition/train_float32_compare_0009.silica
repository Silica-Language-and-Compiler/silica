// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(37.0 < (14.375 - 11.125));
                println("");
                _: atom <- print_boolean((16.0 + 40.0) == (40.0 + 24.0));
                println("");
                done: atom <- print_boolean((32.0 + 29.125) > (25.5 - 9.5))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
