// main returns float32; exit code is trunc(6.25 + 20.125 + 31.0 * 1.375) = 69
use trial_support_float32;

fn main() -> float32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float32@start();
        _: boolean <- trial_support_float32@run(fn() -> float32 {
            6.25 + 20.125 + 31.0 * 1.375
        });
        _: int64 <- wait_for_exit()
    produces
        pure 69.0
    end
}
