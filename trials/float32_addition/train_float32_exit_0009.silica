// main returns float32; exit code is trunc(21.375 + 4.75) = 26
use trial_support_float32;

fn main() -> float32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float32@start();
        _: boolean <- trial_support_float32@run(fn() -> float32 {
            21.375 + 4.75
        });
        _: int64 <- wait_for_exit()
    produces
        pure 26.125
    end
}
