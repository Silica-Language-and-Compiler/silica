// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(4.25 * 32.5 == 39.5);
                println("");
                _: atom <- print_boolean(10.0 * 4.5 <= 37.5);
                println("");
                done: atom <- print_boolean((14.5 - 1.0) <= (10.125 - 35.5))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
