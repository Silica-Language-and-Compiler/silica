.text
    ; use trial_support_atom
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o139|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_start@PAGE
    ADD X9, X9, trial_support_atom_start@PAGEOFF
    BLR X9

    ADRP X16, train_float32_compare_10013.__lam0@PAGE
    ADD X16, X16, train_float32_compare_10013.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o189|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_run@PAGE
    ADD X9, X9, trial_support_atom_run@PAGEOFF
    BLR X9

    BL _silica_rt_wait_for_exit

    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

train_float32_compare_10013.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X0, L_f32_1@PAGE
    LDR S2, [X0, L_f32_1@PAGEOFF]
    ADRP X0, L_f32_0@PAGE
    LDR S1, [X0, L_f32_0@PAGEOFF]


    FMUL S0, S1, S2
    STR S0, [SP, #-16]!
    ADRP X0, L_f32_3@PAGE
    LDR S2, [X0, L_f32_3@PAGEOFF]
    ADRP X0, L_f32_2@PAGE
    LDR S1, [X0, L_f32_2@PAGEOFF]


    FMUL S2, S1, S2
    LDR S1, [SP], #16
    FCMP S1, S2
    CSET W0, GE
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #2

    ; effects [device_io]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    ADRP X11, L_f32_5@PAGE
    LDR S2, [X11, L_f32_5@PAGEOFF]
    ADRP X11, L_f32_4@PAGE
    LDR S1, [X11, L_f32_4@PAGEOFF]
    FCMP S1, S2
    CSET W0, GT
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #2

    ; effects [device_io]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    ADRP X11, L_f32_7@PAGE
    LDR S2, [X11, L_f32_7@PAGEOFF]
    ADRP X11, L_f32_6@PAGE
    LDR S1, [X11, L_f32_6@PAGEOFF]
    FSUB S1, S1, S2
    ADRP X11, L_f32_8@PAGE
    LDR S2, [X11, L_f32_8@PAGEOFF]


    FCMP S1, S2
    CSET W0, LE
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #2

    ; effects [device_io]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    ADRP X11, L_f32_11@PAGE
    LDR S2, [X11, L_f32_11@PAGEOFF]
    ADRP X11, L_f32_10@PAGE
    LDR S1, [X11, L_f32_10@PAGEOFF]
    FADD S2, S1, S2
    STR S2, [SP, #-16]!
    ADRP X11, L_f32_9@PAGE
    LDR S2, [X11, L_f32_9@PAGEOFF]
    ADRP X11, L_f32_3@PAGE
    LDR S1, [X11, L_f32_3@PAGEOFF]
    FSUB S1, S1, S2
    LDR S2, [SP], #16


    FCMP S1, S2
    CSET W0, NE
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #2

    MOV X19, X0
    MOV X0, X19







    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_pb_helper:
    CMP X0, #0
    B.eq L_pb_false_branch
    MOV X0, #1
    ADRP X1, L_pb_true@PAGE
    ADD X1, X1, L_pb_true@PAGEOFF
    MOV X2, #4
    MOV X16, #4
    SVC #0x80
    B L_pb_after
L_pb_false_branch:
    MOV X0, #1
    ADRP X1, L_pb_false@PAGE
    ADD X1, X1, L_pb_false@PAGEOFF
    MOV X2, #5
    MOV X16, #4
    SVC #0x80
L_pb_after:
    RET
