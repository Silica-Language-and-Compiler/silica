// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((1.5 - 21.5) <= 29.0);
                println("");
                _: atom <- print_boolean(37.0 <= 0.5 * 31.5);
                println("");
                _: atom <- print_boolean(7.0 <= 4.5 * 29.375);
                println("");
                done: atom <- print_boolean((13.375 - 19.5) < 22.125)
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
