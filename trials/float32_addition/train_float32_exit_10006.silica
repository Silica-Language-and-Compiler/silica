// main returns float32; exit code is trunc(14.25 - 6.0) = 8
use trial_support_float32;

fn main() -> float32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float32@start();
        _: boolean <- trial_support_float32@run(fn() -> float32 {
            14.25 - 6.0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 8.25
    end
}
