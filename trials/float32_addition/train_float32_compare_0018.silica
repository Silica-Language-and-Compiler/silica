// float32 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((40.0 + 2.25) <= 12.0);
                println("");
                _: atom <- print_boolean(26.375 > (28.5 - 25.0));
                println("");
                _: atom <- print_boolean(12.25 < 16.25 * 24.25);
                println("");
                done: atom <- print_boolean((38.125 + 17.25) == 34.75)
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
