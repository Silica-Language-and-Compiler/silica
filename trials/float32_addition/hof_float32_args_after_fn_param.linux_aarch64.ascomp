    FSUB S2, S0, S1
    ADRP X8, L_pf32_10
    LDR S3, [X8, :lo12:L_pf32_10]
    MOV X12, #7
    MOV X9, X10
    SUB X9, X9, #7
    MOV X8, X9
L_pf32_frac_loop:
    CBZ X12, L_pf32_frac_done
    FMUL S2, S2, S3
    FCVTZS W0, S2
    ADD X2, X0, #48
    STRB W2, [X8]
    ADD X8, X8, #1
    SCVTF S4, W0
    FSUB S2, S2, S4
    SUB X12, X12, #1
    FCMP S2, #0.0
    B.eq L_pf32_frac_done
    B L_pf32_frac_loop
L_pf32_frac_done:
    SUB X9, X9, #1
    MOV X1, #46
    STRB W1, [X9]
    SUB X2, X8, X9
    MOV X0, #1
    MOV X1, X9
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    ADD SP, SP, #64
