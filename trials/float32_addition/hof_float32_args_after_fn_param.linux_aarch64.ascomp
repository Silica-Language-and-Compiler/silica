    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o1748|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
