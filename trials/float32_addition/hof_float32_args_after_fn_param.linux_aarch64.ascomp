.globl main
main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL silica_pid_registry_init
    BL silica_dangerous_pid_registry_init
    BL silica_device_pid_registry_init
    // push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o1645|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_start
    ADD X9, X9, :lo12:trial_support_int64_start
    BLR X9

    ADRP X16, hof_float32_args_after_fn_param.__lam0
    ADD X16, X16, :lo12:hof_float32_args_after_fn_param.__lam0

    STR X16, [SP, #-16]!
