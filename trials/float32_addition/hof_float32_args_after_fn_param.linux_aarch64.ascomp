L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table
    ADD X9, X9, :lo12:L_pa_table
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_pf32_helper:
    SUB SP, SP, #64
    STR S0, [SP, #0]
    FCMP S0, #0.0
    B.ge L_pf32_pos
    MOV X0, #1
    ADRP X1, L_pf32_minus
    ADD X1, X1, :lo12:L_pf32_minus
    MOV X2, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    LDR S0, [SP, #0]
    FNEG S0, S0
    STR S0, [SP, #0]
L_pf32_pos:
    FCVTZS W0, S0
    MOV X10, SP
    ADD X10, X10, #48
    MOV X11, #0
    CMP X0, #0
    B.ge L_pf32_ipos
    MOV X11, #1
    NEG X0, X0
L_pf32_ipos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pf32_izero
    MOV X9, #10
L_pf32_iloop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pf32_iloop
    B L_pf32_imaybe_neg
L_pf32_izero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pf32_imaybe_neg:
    CBNZ X11, L_pf32_iprepend_minus
    B L_pf32_ido_int
L_pf32_iprepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pf32_ido_int:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    STR X8, [SP, #-16]!
