// defect A7: int32 (z % 11 % (x % y)) with (5, 3, 3) is 1 (a clobbered operand became a zero divisor)
use trial_support_atom;

fn mix(x: int32, y: int32, z: int32) -> int32 {
    (z % 11 % (x % y))
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_int32(mix(5, 3, 3))
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
