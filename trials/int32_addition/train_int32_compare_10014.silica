// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((51 + 21) < 15 % 19);
                println("");
                _: atom <- print_boolean(19 / 33 < 1 / 55);
                println("");
                _: atom <- print_boolean(60 % 54 >= 2 / 21);
                println("");
                result: atom <- print_boolean(22 % 26 >= 55)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
