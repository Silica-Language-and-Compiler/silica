// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((11 + 23) != 7);
                println("");
                _: atom <- print_boolean(32 * 57 != 8 / 41);
                println("");
                _: atom <- print_boolean(33 % 46 == 15 % 36);
                println("");
                result: atom <- print_boolean((12 + 45) > 42 * 49)
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
