// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((54 + 43) > 11 / 60);
                println("");
                _: atom <- print_boolean((49 % 23) == (37 - 7));
                println("");
                _: atom <- print_boolean((13 - 9) > 56 % 28);
                println("");
                result: atom <- print_boolean(50 <= 44 % 12)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
