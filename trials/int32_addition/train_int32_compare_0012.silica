// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(43 * 22 >= (0 + 57));
                println("");
                _: atom <- print_boolean((57 - 9) == 46);
                println("");
                _: atom <- print_boolean((16 + 40) >= 27);
                println("");
                result: atom <- print_boolean((54 + 7) < 35)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
