// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((25 / 53) <= 31);
                println("");
                _: atom <- print_boolean(23 % 46 <= (30 + 13));
                println("");
                _: atom <- print_boolean(24 % 21 != 10 * 27);
                println("");
                result: atom <- print_boolean(24 * 48 >= 31 / 37)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
