// int32 `+`, `-`, `*` with a right-hand literal beyond the MOV immediate range (65536 and up)
// take the literal from the pool through the same W-register path as uint32; the left operand
// is 5. Expected: 70005, -69995, 350000, 2147483005; exits 0.
use trial_support_int64;

fn plus_right(x: int32) -> int32 {
    x + 70000
}

fn minus_right(x: int32) -> int32 {
    x - 70000
}

fn times_right(x: int32) -> int32 {
    x * 70000
}

fn plus_near_max(x: int32) -> int32 {
    x + 2147483000
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                five: int32 <- 5;
                a: atom <- print_int32(plus_right(five));
                println("");
                b: atom <- print_int32(minus_right(five));
                println("");
                c: atom <- print_int32(times_right(five));
                println("");
                d: atom <- print_int32(plus_near_max(five));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
