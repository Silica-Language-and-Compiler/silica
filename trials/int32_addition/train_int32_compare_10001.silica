// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((9 + 49) == (19 + 1));
                println("");
                _: atom <- print_boolean((3 + 24) == 17 * 34);
                println("");
                _: atom <- print_boolean(6 * 9 > (12 + 2));
                println("");
                _: atom <- print_boolean(11 != 6 / 45);
                println("");
                result: atom <- print_boolean(9 * 13 > (48 * 34))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
