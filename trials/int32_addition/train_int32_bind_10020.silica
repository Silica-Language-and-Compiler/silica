// int32 bindings then expression; expect 0
use trial_support_int32;

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            height: int32 <- 2;
            m: int32 <- height;
            base: int32 <- height;
            count: int32 <- height + height + (1 - base);
            base * base / 53 + m - m + count - count
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
