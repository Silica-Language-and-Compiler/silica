// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(51 > 8);
                println("");
                _: atom <- print_boolean(32 * 26 != 54 % 13);
                println("");
                _: atom <- print_boolean((14 + 57) != 11 * 23);
                println("");
                _: atom <- print_boolean((55 + 42) < (42 + 13));
                println("");
                result: atom <- print_boolean((7 + 20) < 3)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
