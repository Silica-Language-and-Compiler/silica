// int32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(12 * 37 == (29 - 11));
                println("");
                _: atom <- print_boolean(29 / 60 <= (30 + 45));
                println("");
                _: atom <- print_boolean(53 * 0 > (24 + 29));
                println("");
                _: atom <- print_boolean(54 / 48 == 29 % 47);
                println("");
                result: atom <- print_boolean(5 == 56 % 57)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
