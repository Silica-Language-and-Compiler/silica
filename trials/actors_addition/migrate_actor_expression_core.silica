// migrate_actor(ref, EXPR) with an arithmetic expression as the core argument. Every binary runtime
// prim (prims_actors@emit_runtime_binary) reads its first operand back from X9 after the second
// operand has been evaluated into X10; a computed second operand stages its own left operand through
// X9, so the runtime received `1` as the actor and faulted in silica_rt_migrate_actor (a literal or a
// bound name never showed it; reconstructed from the project-bees S11 spike note, whose trials bind
// the core first). Fixed 2026-09-24: term_emit_kind_compound_part3 holds X9 across a computed second
// operand for the whole family (siblings: pin_actor_to_core_expression_core,
// set_actor_priority_expression_value). Expected: 42 / done
use trial_wait_int64;

fn handler(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_int64(state + msg);
        println("");
        println("done")
    produces pure (:no_reply, state + msg) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                ref: actor_ref <- spawn(0, handler, stack_policy(0, :keep_last_message));
                i: int64 <- 1;
                _: atom <- migrate_actor(ref, 1 + i % 2);
                _: boolean <- cast(ref, 42 impl ActorMessage {})
            produces pure 0 end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
