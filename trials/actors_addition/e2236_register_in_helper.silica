// Spec §15.4.13.4 "Handler before any start" (E2236): registration may be done in a function main
// calls, as long as it runs before the first start. setup spawns the reporter and registers it (the
// spawn is exempt: bound and registered in the same function); main then starts the worker, which
// prints 42 and ends the program with status 42.

fn region_dump_limit() -> int64 {
    0
}

// Writes each unwind report to stderr, as the runtime does when no reporter is registered.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

// Prints the value it is sent plus one, then ends the program with that value.
fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- print_int64(msg + 1);
        println("");
        _: boolean <- cast_exit(msg + 1)
    produces
        pure (:no_reply, state)
    end
}

fn setup() -> atom {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(r)
    produces
        pure registered
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- setup();
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 41 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
