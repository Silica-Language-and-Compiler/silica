// Alternating cast()s to two actors (one "A" or "B" line per message). Parallel workers can reorder lines
// relative to enqueue order; compare with actor_threads_burst_two (six prints per handler).
// Keep the cast count modest so mailboxes drain reliably; message uses 1 not 0.
// Each actor prints done after a handled message; main waits for command-line exit.
// §16.1.2: cast.

use trial_wait_int64;

fn line_a(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("A");
        println("done");
        new_st: int64 <- state + msg
    produces
        pure (:no_reply, new_st)
    end
}

fn line_b(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("B");
        println("done");
        new_st: int64 <- state + msg
    produces
        pure (:no_reply, new_st)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                ar: actor_ref <- spawn(0, line_a, stack_policy(0, :keep_last_message));
                br: actor_ref <- spawn(0, line_b, stack_policy(0, :keep_last_message));
                _: boolean <- cast(ar, 1 impl ActorMessage {});
                _: boolean <- cast(br, 1 impl ActorMessage {});
                _: boolean <- cast(ar, 1 impl ActorMessage {});
                _: boolean <- cast(br, 1 impl ActorMessage {});
                _: boolean <- cast(ar, 1 impl ActorMessage {});
                _: boolean <- cast(br, 1 impl ActorMessage {});
                _: boolean <- cast(ar, 1 impl ActorMessage {});
                _: boolean <- cast(br, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
