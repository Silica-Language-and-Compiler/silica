// Several caller actors enqueue synchronous calls to the same victim. The first
// call handled by the victim marks the victim dead; the actor loop must exit
// before servicing the remaining standard mailbox calls, and teardown must wake
// each queued caller with the actor-death result.
// The victim ends itself with kill_abnormal on a reference the compiler cannot see is its own: each
// caller sends the victim its own reference as the message (kill_abnormal(self()), or a name bound
// from self(), is rejected at compile time with E2241, spec §15.1.2.3), so the run-time check fails
// the victim with :language_error (reason_tag 2).

use trial_wait_int64;

fn spin(n: int64) -> int64 {
    case n <= 0 of {
        true -> 0;
        false -> spin(n - 1)
    }
}

fn die_on_first_call(msg: actor_ref, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        _: int64 <- spin(1000);
        _: atom <- kill_abnormal(msg)
    produces
        pure (:reply, state, state)
    end
}

fn caller(msg: int64, victim: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency, device_io]
        result: int64 <- call(victim, victim impl ActorMessage {});
        print_int64(result);
        println("")
    produces
        pure (:no_reply, victim)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                victim: actor_ref <- spawn(0, die_on_first_call, stack_policy(0, :keep_last_message));
                c1: actor_ref <- spawn(victim, caller, stack_policy(0, :keep_last_message));
                c2: actor_ref <- spawn(victim, caller, stack_policy(0, :keep_last_message));
                c3: actor_ref <- spawn(victim, caller, stack_policy(0, :keep_last_message));
                c4: actor_ref <- spawn(victim, caller, stack_policy(0, :keep_last_message));
                _: boolean <- cast(c1, 1 impl ActorMessage {});
                _: boolean <- cast(c2, 2 impl ActorMessage {});
                _: boolean <- cast(c3, 3 impl ActorMessage {});
                _: boolean <- cast(c4, 4 impl ActorMessage {});
                println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
