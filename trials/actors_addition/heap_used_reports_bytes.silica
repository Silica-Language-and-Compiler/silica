// state_area_bytes() -> int64 (no arguments, no effect): the live bytes of the calling actor's state area
// (ACB #568), or 0 on the main thread. Spawning an actor with a composite initial state puts that
// state in the new actor's area, not the caller's, so the caller's reading is non-negative and does not
// grow across the spawn.
use trial_support_int64;

fn hold(msg: int64, state: (int64, int64)) -> (:reply, int64, (int64, int64)) {
    (a: int64, b: int64) <- state;
    (:reply, a + b + msg, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                h0: int64 <- state_area_bytes();
                w: actor_ref <- spawn((3, 4), hold, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                v: int64 <- call(w, 1 impl ActorMessage {});
                h1: int64 <- state_area_bytes();
                _: atom <- print_int64(case h0 >= 0 of { true -> 1; false -> 0 });
                println("");
                _: atom <- print_int64(case h1 > h0 of { true -> 1; false -> 0 });
                println("");
                _: atom <- print_int64(v);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
