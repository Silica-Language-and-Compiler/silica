// heap_used() -> int64 (effect mem(normal)): the bytes the program's allocator has handed out and
// not released. On the ESP32-S3 it is exact (allocated blocks below the bump pointer); on a hosted
// target it is what silica_rt_region_alloc has bumped from the per-actor arenas and main's
// fallback, less the arenas of ended actors. Spawning an actor with a composite initial state
// moves that state into a heap block, so the count grows across the spawn on every target.
use trial_support_int64;

fn hold(msg: int64, state: (int64, int64)) -> (:reply, int64, (int64, int64)) {
    (a: int64, b: int64) <- state;
    (:reply, a + b + msg, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io, mem(normal)]
                h0: int64 <- heap_used();
                w: actor_ref <- spawn((3, 4), hold, stack_policy(0, :keep_last_message));
                v: int64 <- call(w, 1 impl ActorMessage {});
                h1: int64 <- heap_used();
                _: atom <- print_int64(case h0 >= 0 of { true -> 1; false -> 0 });
                println("");
                _: atom <- print_int64(case h1 > h0 of { true -> 1; false -> 0 });
                println("");
                _: atom <- print_int64(v);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
