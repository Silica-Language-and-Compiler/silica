// Spec §16.1.2 / §16.1.4: a cast to an actor that has ended returns false, the message is dropped
// and the sender goes on. A cast that enqueues returns true.
// main casts to a live sink (true), removes the two sinks and waits for their ends (the failure
// reporter counts the two reports and ends main's wait_for_exit() with cast_exit(0)). Then:
//   - an actor (the prober, call-only, holding the ended sink's reference) casts to the ended sink
//     in two dispatches and replies each time with what the cast returned; it is not ended, so the
//     second call is answered too;
//   - main casts to the ended sink twice, an integer and a string (a buffered message, freed by the
//     runtime because it is not enqueued), and gets false both times;
//   - main goes on: a cast to a fresh sink returns true and a call to a live worker is answered.
// main returns 0: nothing in this program raises actor_not_found.
//
// Expected output (compared as a multiset: the report and the root-exit note are asynchronous):
//   cast to the live actor: true
//   failure report               twice: the sinks end through remove_actor (failure_reason :normal)
//   [silica] root actor exited (no supervisor)    twice: the sinks had no supervisor
//   prober replied 30, its cast returned false    call(p, 3)
//   prober replied 40, its cast returned false    call(p, 4): the prober is alive
//   main cast to the ended actor: false
//   main cast of a string to the ended actor: false
//   cast to a fresh actor: true
//   8                            call(w, 1) on state 7
//   main goes on

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn text_sink(msg: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + length_bytes(msg))
}

// The prober casts its message to the actor its state names and replies msg * 10, plus 1 when the
// cast returned true.
fn prober(msg: int64, state: actor_ref) -> (:reply, int64, actor_ref) {
    sequence proc[concurrency]
        sent: boolean <- cast(state, msg impl ActorMessage {});
        flag: int64 <- case sent of {
            true -> 1;
            false -> 0
        }
    produces
        pure (:reply, msg * 10 + flag, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- start_reporter(2);
        a: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        t: actor_ref <- spawn(0, text_sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        w: actor_ref <- spawn(7, worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        live: boolean <- cast(a, 1 impl ActorMessage {});
        print("cast to the live actor: ");
        print_boolean(live);
        println("");
        _: atom <- remove_actor(a);
        _: atom <- remove_actor(t);
        _: int64 <- wait_for_exit();
        p: actor_ref <- spawn(a, prober, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        first: int64 <- call(p, 3 impl ActorMessage {});
        print("prober replied ");
        print_int64(first);
        print(", its cast returned ");
        print_boolean(first == 31);
        println("");
        second: int64 <- call(p, 4 impl ActorMessage {});
        print("prober replied ");
        print_int64(second);
        print(", its cast returned ");
        print_boolean(second == 41);
        println("");
        from_main: boolean <- cast(a, 1 impl ActorMessage {});
        print("main cast to the ended actor: ");
        print_boolean(from_main);
        println("");
        text_from_main: boolean <- cast(t, "a message that travels in a mailbox buffer" impl ActorMessage {});
        print("main cast of a string to the ended actor: ");
        print_boolean(text_from_main);
        println("");
        b: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        fresh: boolean <- cast(b, 1 impl ActorMessage {});
        print("cast to a fresh actor: ");
        print_boolean(fresh);
        println("");
        print_int64(call(w, 1 impl ActorMessage {}));
        println("");
        println("main goes on")
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

// The failure reporter prints one line per report and ends main's wait_for_exit() with cast_exit(0)
// when its count reaches 0 (as in identity_dead_ref_raises).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print("failure report\n");
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, left)
    end
}

fn start_reporter(expected: int64) -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
