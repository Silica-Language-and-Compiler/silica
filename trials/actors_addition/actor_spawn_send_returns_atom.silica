// Spec §16.1.1 / silica:ActorModel: call(actor_ref, message) -> Reply proc[concurrency].
// §15.1.2: behavior returns (:reply, reply_value, new_state) for call() messages.
// §15.1.1: spawn(initial_state, behavior_fn) -> actor_ref.

use trial_support_int64;

fn step(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
    new_state: int64 <- msg + state;
    println("New state is");
    print_int64(new_state);
    println("")
    produces
        pure (:reply, new_state, new_state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                peer: actor_ref <- spawn(0, step, stack_policy(0, :keep_last_message));
                result: int64 <- call(peer, 1 impl ActorMessage {});
                print_int64(result);
                println("")
            produces
                pure result
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
