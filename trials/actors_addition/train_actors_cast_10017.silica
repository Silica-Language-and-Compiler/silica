// Spec §16.1.2: cast enqueues asynchronously and returns boolean; behavior returns (:no_reply, new_state)
use trial_support_atom;

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(4, sink, stack_policy(0, :keep_last_message));
                enqueued: boolean <- cast(w, 7 impl ActorMessage {});
                print_boolean(enqueued);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
