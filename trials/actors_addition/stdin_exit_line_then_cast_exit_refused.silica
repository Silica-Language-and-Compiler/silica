// The stdin line "exit" is recorded as cast_exit(0) (spec §15.1.2.5; the first exit request wins):
// main prints the marker "ready" and waits; the harness then writes "exit" to stdin
// (stdin_exit_line_then_cast_exit_refused.wait_for_exit), so wait_for_exit returns 0, and the later
// cast_exit(5) is refused because an exit request is already recorded.
// Expected, by hand: ready, 0, false; exit status 0 (main's own value).
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        println("ready");
        code: int64 <- wait_for_exit();
        print_int64(code);
        println("");
        later: boolean <- cast_exit(5);
        print_boolean(later);
        println("")
    produces
        pure 0
    end
}
