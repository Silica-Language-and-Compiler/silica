// A supervisor's init returns its (flags, children) tuple through the result buffer the runtime's
// supervisor start names for it (X8). Here init's body is a tail call to child_spec, which builds
// the tuple, so the buffer is passed through a second function. The one worker starts with the
// initial state child_spec gives it (40), and on its message (2) prints state + message and ends
// the program. A start that names no buffer, or a stale one, faults before the worker runs.
// Expected output:
//   42
//   0

use Supervisor;

impl SupervisorInitTailCallSupervisor for Supervisor;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- print_int64(state + msg);
        _: atom <- println("");
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

fn child_spec(start_value: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 1 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :trial_worker, agent_type: :worker, initial_state: start_value, behavior: worker, restart: :transient, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    child_spec(initial_state + 40)
}

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        _: supervisor_ref <- spawn_registered_supervisor(SupervisorInitTailCallSupervisor, 0, :trial_supervisor, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:trial_worker, 2 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
