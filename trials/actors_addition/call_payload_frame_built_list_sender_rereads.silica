// Chunk 15 phase 2 (S6d, forwarding-word restore): as call_payload_frame_built_string_sender_rereads
// with a list payload built in the sender's frame ([3, 4, 5], three cons blocks). The actor replies
// head + length = 3 + 3; the sender then reads the list again: head 3, length 3.
// Expected: 6, 3, 3, then status 0.
//   6
//   3
//   3
//   0

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn nil_int() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure r
    end
}

fn cons_int(x: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn measure(msg: List[int64, mem(normal)], state: int64) -> (:reply, int64, int64) {
    sequence proc[mem(normal)]
        n: int64 <- length[int64, mem(normal)](msg);
        h: int64 <- msg.head
    produces
        pure (:reply, h + n, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(0, measure, stack_policy(0, :keep_last_message));
        c: List[int64, mem(normal)] <- cons_int(5, nil_int());
        b: List[int64, mem(normal)] <- cons_int(4, c);
        l: List[int64, mem(normal)] <- cons_int(3, b);
        n: int64 <- call(a, l impl ActorMessage {});
        print_int64(n);
        println("");
        lh: int64 <- l.head;
        print_int64(lh);
        println("");
        ll: int64 <- length[int64, mem(normal)](l);
        print_int64(ll);
        println("")
    produces
        pure 0
    end
}
