// Spec §16.1.2 (2026-10-13), accepting side of cast_check_param (E2237): a call-only actor passed as a plain
// parameter is reached the correct way, with a call; ask calls its parameter and main passes the
// call-only plain. plain replies its state plus 41, so main prints 41.
// Expected output:
//   41
//   0

fn ask(r: actor_ref) -> int64 {
    sequence proc[concurrency]
        v: int64 <- call(r, "x" impl ActorMessage {})
    produces
        pure v
    end
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state + 41, state + 1)
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        v: int64 <- ask(p);
        _: atom <- print_int64(v);
        _: atom <- println("");
        _: boolean <- cast_exit(0);
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
