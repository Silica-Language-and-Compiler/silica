// Spec §16.1.2 (2026-10-13), accepting side of cast_check_list_element and
// cast_check_list_prepend (E2237): list elements are tracked, and here the list holds only the
// cast-only printer, so the cast to its head compiles. The cast-only printer prints the message and ends the program.
// Expected output:
//   listed
//   0

fn printer(msg: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        n: int64 <- state + 1;
        println(msg);
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, n)
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        q: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message));
        l: List[actor_ref, mem(normal)] <- prepend[actor_ref, mem(normal)](q, empty[actor_ref, mem(normal)]());
        _: boolean <- cast(l.head, "listed" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
