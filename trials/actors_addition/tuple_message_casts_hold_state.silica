// The tuple-message twin of record_message_casts_hold_state: a tuple message is copied at send
// time into a block of its own, which the receiver gives back once its behaviour has read it.
// Two batches of 1,000 casts, each closed by a (0, 0) message that makes the receiver print its
// running sum and a done marker.
use trial_wait_int64;

fn sum_tup(msg: (int64, int64), state: int64) -> (:no_reply, int64) {
    (p: int64, q: int64) <- msg;
    sequence proc[device_io]
        _: boolean <- case p == 0 of {
            true -> {
                _: atom <- print_int64(state);
                println("");
                println("done");
                true
            };
            false -> true
        }
    produces
        pure (:no_reply, state + p + q)
    end
}

fn cast_tup_n(target: actor_ref, n: int64) -> int64 {
    sequence proc[concurrency]
        _: boolean <- cast(target, (1, 2) impl ActorMessage {});
        left: int64 <- case n == 1 of {
            true -> 0;
            false -> cast_tup_n(target, n - 1)
        }
    produces
        pure left
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io, mem(normal)]
                h: int64 <- heap_used();
                _: atom <- print_int64(case h >= 0 of { true -> 1; false -> 0 });
                println("");
                t: actor_ref <- spawn(0, sum_tup, stack_policy(0, :keep_last_message));
                _: int64 <- cast_tup_n(t, 1000);
                _: boolean <- cast(t, (0, 0) impl ActorMessage {});
                _: int64 <- cast_tup_n(t, 1000);
                _: boolean <- cast(t, (0, 0) impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
