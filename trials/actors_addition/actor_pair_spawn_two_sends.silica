// Spec §15.1.1: two actor_ref values from spawn(initial_state, behavior_fn).
// §16.1.1: call(actor_ref, message) -> Reply; §15.1.2: behavior returns (:reply, reply, state).
// §16.3.2: ActorMessage on each payload.

use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                left: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                right: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                left_result: int64 <- call(left, 10 impl ActorMessage {});
                print_int64(left_result);
                println("");
                right_result: int64 <- call(right, 20 impl ActorMessage {});
                print_int64(right_result);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
