// Chunk 15 phase 2 (S6 evacuation): the behaviour twin of memory_region_addition/
// frame_bounded_growth_list_loop_in_main. A behaviour calls a function that returns a list built in
// its frame, in a loop of 3000 iterations; each call's result is evacuated into the behaviour's
// frame and the loop is a tail call, so frame growth stays bounded on the actor's stack.
// mk(i) = [i, i + 1]; the sum of the heads over i = 1..3000 is 4501500.
// Expected: 4501500, then status 0.
//   4501500
//   0

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn nil_int() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure r
    end
}

fn cons_int(x: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn mk(i: int64) -> List[int64, mem(normal)] {
    top: List[int64, mem(normal)] <- cons_int(i + 1, nil_int());
    cons_int(i, top)
}

fn run_loop(i: int64, acc: int64) -> int64 {
    case i == 0 of {
        true -> acc;
        false -> {
            l: List[int64, mem(normal)] <- mk(i);
            run_loop(i - 1, acc + l.head)
        }
    }
}

fn total(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, run_loop(msg, 0), state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(0, total, stack_policy(0, :keep_last_message));
        t: int64 <- call(a, 3000 impl ActorMessage {});
        print_int64(t);
        println("")
    produces
        pure 0
    end
}
