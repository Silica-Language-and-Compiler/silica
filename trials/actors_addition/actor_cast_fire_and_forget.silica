// Spec §16.1.2: cast enqueues asynchronously and returns boolean (actor exists vs terminated).
// §15.1.2: behavior for cast() returns (:no_reply, new_state).
// §16.3.2: message operand must satisfy ActorMessage via postfix `expr impl ActorMessage {}`.

use trial_support_uint8;

fn noop(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            sequence proc[concurrency]
                peer: actor_ref <- spawn(0, noop, stack_policy(0, :keep_last_message));
                enqueued: boolean <- cast(peer, 42 impl ActorMessage {})
            produces
                pure 42
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 42
    end
}
