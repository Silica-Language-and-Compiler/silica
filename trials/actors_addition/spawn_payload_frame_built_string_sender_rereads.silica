// Chunk 15 phase 2 (S5/S6d): the initial state of a spawn is a string built with concat in the
// spawner's frame. The spawn walks it to the heap; the spawner's own string must survive (forwarding
// word restored) and the actor must see the right bytes. Expected: 5 (the actor's length of its
// state), hello, then status 0.
//   5
//   hello
//   0

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn state_len(msg: int64, state: string) -> (:reply, int64, string) {
    (:reply, length_bytes(state), state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        s: string <- concat("hel", "lo");
        a: actor_ref <- spawn(s, state_len, stack_policy(0, :keep_last_message));
        n: int64 <- call(a, 1 impl ActorMessage {});
        print_int64(n);
        println("");
        println(s)
    produces
        pure 0
    end
}
