// A float16 actor state and a (float16, int64) reply: the actor is spawned with 0.75 and replies
// (state, msg); the caller destructures the reply and prints both elements. Before the fix the
// Mac printed 0.0 for the float16.
// Expected output:
//   0.75
//   5
//   0
use trial_support_int64;

fn rh(msg: int64, state: float16) -> (:reply, (float16, int64), float16) {
    (:reply, (state, msg), state)
}

fn ph(x: float16) -> int64 {
    sequence proc[device_io]
        _: atom <- print_float16(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn pi(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                h: actor_ref <- spawn(0.75, rh, stack_policy(0, :keep_last_message));
                hr: (float16, int64) <- call(h, 5 impl ActorMessage {});
                (h1, h2): (float16, int64) <- hr
            produces
                pure ph(h1) + pi(h2)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
