// Spec §16.2.6.4 (run-time check where the convention is unknown), reference in an actor state field:
// main gets a call-only worker back as a call reply from directory and spawns holder with it in the
// first field of its state tuple, so the reference reaches holder's sends through a flow the compiler
// does not follow.
// holder calls the worker (the right way: 1 + 5 = 6, "6 holder call ok"), then casts to it. The cast
// is the mismatch: nothing is enqueued and holder fails with failure_reason :language_error
// (reason_tag 2). The reporter writes holder's report and ends the program with status 0.
//
// Expected output (the report is printed by the FailureReporter; order checked as a multiset):
//   6 holder call ok
//   one failure report: reason_tag 2, frame #0 conv_state_field_cast_to_call_only_holder
// exit status 0

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

// Hands back the reference it holds: a call reply, which the compiler does not follow.
fn directory(msg: int64, state: actor_ref) -> (:reply, actor_ref, actor_ref) {
    (:reply, state, state)
}

// The state's first field is the call-only worker, from directory's call reply. The cast is the
// mismatch.
fn holder(msg: int64, state: (actor_ref, int64)) -> (:no_reply, (actor_ref, int64)) {
    sequence proc[concurrency, device_io]
        (target, count): (actor_ref, int64) <- state;
        v: int64 <- call(target, msg impl ActorMessage {});
        print_int64(v + count);
        println(" holder call ok");
        _: boolean <- cast(target, msg impl ActorMessage {});
        println("holder: not reached")
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        w: actor_ref <- spawn(5, worker, stack_policy(0, :keep_last_message));
        d: actor_ref <- spawn(w, directory, stack_policy(0, :keep_last_message));
        r: actor_ref <- call(d, 0 impl ActorMessage {});
        h: actor_ref <- spawn((r, 0), holder, stack_policy(0, :keep_last_message));
        _: boolean <- cast(h, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// The program expects exactly one failure report. The reporter writes it to stderr and then ends
// the program with status 0, so the exit comes only after the report is out.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
