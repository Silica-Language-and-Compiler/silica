// Minimal: cast-only behavior; state and return are actor_ref. Body is only cast(peer, msg).
use trial_support_atom;

fn relay(m: atom, peer: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        _: boolean <- cast(peer, m impl ActorMessage {})
    produces
        pure (:no_reply, peer)
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            :ok
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
