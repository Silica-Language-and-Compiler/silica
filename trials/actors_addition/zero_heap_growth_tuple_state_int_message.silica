// A behaviour with an int64 message and a tuple state gives its (:no_reply, state) result back
// once each message is handled. The counter's state is (messages handled, heap_used() at message
// 100). It casts itself the next message through a helper, reads heap_used() on every message
// through the same helper before the cast, and at message 1100 prints how far the heap grew over
// the thousand messages between and ends the program. Before the fix each message left its result
// and state tuples behind (32 bytes a message on the Mac).
// Expected output:
//   0
//   0

fn region_dump_limit() -> int64 {
    0
}

fn send_next(me: actor_ref) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(me, 1 impl ActorMessage {})
    produces
        pure sent
    end
}

fn finish(growth: int64) -> boolean {
    sequence proc[concurrency, device_io]
        _: atom <- print_int64(growth);
        _: atom <- println("");
        ended: boolean <- cast_exit(0)
    produces
        pure ended
    end
}

fn read_heap_used() -> int64 {
    sequence proc[mem(normal)]
        used: int64 <- heap_used()
    produces
        pure used
    end
}

// state: (messages handled, heap_used() at message 100)
fn count_pair(msg: int64, state: (int64, int64)) -> (:no_reply, (int64, int64)) {
    sequence proc[concurrency]
        (seen, base_then): (int64, int64) <- state;
        n: int64 <- seen + msg;
        used: int64 <- read_heap_used();
        base: int64 <- case n == 100 of {
            true -> used;
            false -> base_then
        };
        me: actor_ref <- self();
        _: boolean <- case n == 1100 of {
            true -> finish(used - base);
            false -> send_next(me)
        }
    produces
        pure (:no_reply, (n, base))
    end
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn((0, 0), count_pair, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, 1 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
