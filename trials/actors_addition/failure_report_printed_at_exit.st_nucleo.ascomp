.else
MOVI32 \t, \off
strh \r, [sp, \t]
.endif
.endm
.macro XL8U r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrb \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrb \r, [sp, \r]
.endif
.endm
.macro XS8 r, off, t
.if ((\off) >= 0) && ((\off) <= 4095)
strb \r, [sp, #(\off)]
.else
MOVI32 \t, \off
strb \r, [sp, \t]
.endif
.endm
.macro XL8S r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrsb \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrsb \r, [sp, \r]
