add \r, \r, sp
.endif
.endm
.macro XL32 r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldr \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldr \r, [sp, \r]
.endif
.endm
.macro XS32 r, off, t
.if ((\off) >= 0) && ((\off) <= 4095)
str \r, [sp, #(\off)]
.else
MOVI32 \t, \off
str \r, [sp, \t]
.endif
.endm
