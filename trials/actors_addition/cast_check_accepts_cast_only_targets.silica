// Spec §16.1.2 (2026-10-12): a cast to an actor whose behaviour is call-only (returns (:reply, ...))
// is rejected at compile time. This trial is the accepting side: every cast here reaches a cast-only
// actor, through each form the check follows: the spawned reference directly, a helper function
// that casts to its parameter, a function that returns its argument, and a case whose arms name a
// call-only and a cast-only actor (mixed arms are not provably call-only, so the cast is allowed;
// at run time the case picks the cast-only actor). The cast-only counter prints each message with
// its count and ends the program after the fourth.
// Expected output:
//   a 1
//   b 2
//   c 3
//   d 4
//   0

fn counter(msg: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        n: int64 <- state + 1;
        print(msg);
        print(" ");
        print_int64(n);
        println("");
        _: boolean <- case n == 4 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, n)
    end
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn nudge(r: actor_ref, msg: string) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(r, msg impl ActorMessage {})
    produces
        pure ok
    end
}

fn pass(r: actor_ref) -> actor_ref {
    r
}

fn pick(flag: boolean, a: actor_ref, b: actor_ref) -> actor_ref {
    case flag of {
        true -> a;
        false -> b
    }
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        n: actor_ref <- spawn(0, counter, stack_policy(0, :keep_last_message));
        _: boolean <- cast(n, "a" impl ActorMessage {});
        _: boolean <- nudge(n, "b");
        _: boolean <- cast(pass(n), "c" impl ActorMessage {});
        _: boolean <- cast(pick(false, p, n), "d" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
