// Spec §15.1.4 Actor Identity across cores: a reference compares by identity wherever it is
// compared. a is pinned to core 1 and b to core 0; each compares a reference it receives in a
// message with its own self(): 1 = the same actor, 2 = the message's actor sorts first, 3 = after.
//
// Expected output:
//   1          a gets a: same actor
//   3          a gets b: b <0.2> sorts after a <0.1>        (depends on child numbering)
//   2          b gets a: a <0.1> sorts before b <0.2>       (depends on child numbering)
//   2          b gets the reporter <0.0>: sorts before b    (depends on child numbering)
//   a <0.1>    (child numbering)
//   b <0.2>    (child numbering)
//   done
//
// Position numbering: only position 0 (main, fixed by the spec) appears; the global position
// counter does not affect this trial. Lines 2-6 depend on main numbering its spawns 0, 1, 2 in order.
// Runs on hosts and on the ESP32-S3 board (both LX7 cores).

fn same_as_me(msg: actor_ref, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        r: int64 <- case msg == me of {
            true -> 1;
            false -> case msg < me of {
                true -> 2;
                false -> 3
            }
        }
    produces
        pure (:reply, r, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- start_reporter();
        a: actor_ref <- spawn(0, same_as_me, stack_policy(0, :keep_last_message), 1);
        b: actor_ref <- spawn(0, same_as_me, stack_policy(0, :keep_last_message), 0);
        print_int64(call(a, a impl ActorMessage {}));
        println("");
        print_int64(call(a, b impl ActorMessage {}));
        println("");
        print_int64(call(b, a impl ActorMessage {}));
        println("");
        print_int64(call(b, rep impl ActorMessage {}));
        println("");
        _: int64 <- print_id("a", a);
        _: int64 <- print_id("b", b);
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

fn print_id(label: string, r: actor_ref) -> int64 {
    sequence proc[concurrency, device_io]
        i: uint64 <- actor_id(r);
        print(label);
        print(" <");
        print_uint64(i shr 32);
        print(".");
        print_uint64(i band 4294967295);
        println(">")
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println(case contains(report, "reason_tag:      4") of {
            true -> "failure report: reason_tag 4";
            false -> "failure report: other"
        })
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
