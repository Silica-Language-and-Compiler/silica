// Zero and negative int64 messages still update state consistently.

use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        println("msg");
        print_int64(msg);
        println("");
        println("state_before");
        print_int64(state);
        println("");
        new_state: int64 <- msg + state;
        println("state_after");
        print_int64(new_state);
        println("")
    produces
        pure (:reply, new_state, new_state)
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                _: int64 <- call(w, 0 impl ActorMessage {});
                _: int64 <- call(w, -11 impl ActorMessage {})
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
