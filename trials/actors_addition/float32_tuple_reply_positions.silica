// A behaviour's reply tuple keeps a float32 element in one word at every position. Three actors
// hold a float32 state and reply (state, msg + 1), (msg, state, msg + 2) and (msg, msg + 3, state);
// the caller destructures each reply and prints every element in order. A second call to the first
// actor, whose reply is discarded, checks the actor still answers after the first reply. Before
// the fix the program printed nothing and ended with status 70 on the Mac.
// Expected output:
//   2.5 11 / 20 3.5 22 / 30 33 4.5 (one per line)
//   0
use trial_support_int64;

fn fa(msg: int64, state: float32) -> (:reply, (float32, int64), float32) {
    (:reply, (state, msg + 1), state)
}

fn fb(msg: int64, state: float32) -> (:reply, (int64, float32, int64), float32) {
    (:reply, (msg, state, msg + 2), state)
}

fn fc(msg: int64, state: float32) -> (:reply, (int64, int64, float32), float32) {
    (:reply, (msg, msg + 3, state), state)
}

fn pf(x: float32) -> int64 {
    sequence proc[device_io]
        _: atom <- print_float32(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn pi(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                a: actor_ref <- spawn(2.5, fa, stack_policy(0, :keep_last_message));
                b: actor_ref <- spawn(3.5, fb, stack_policy(0, :keep_last_message));
                c: actor_ref <- spawn(4.5, fc, stack_policy(0, :keep_last_message));
                ra: (float32, int64) <- call(a, 10 impl ActorMessage {});
                rb: (int64, float32, int64) <- call(b, 20 impl ActorMessage {});
                rc: (int64, int64, float32) <- call(c, 30 impl ActorMessage {});
                _: (float32, int64) <- call(a, 11 impl ActorMessage {});
                (a1, a2): (float32, int64) <- ra;
                (b1, b2, b3): (int64, float32, int64) <- rb;
                (c1, c2, c3): (int64, int64, float32) <- rc
            produces
                pure pf(a1) + pi(a2) + pi(b1) + pf(b2) + pi(b3) + pi(c1) + pi(c2) + pf(c3)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
