// Two actors spawned with float32 literal states, 2.5 and 4.5, each reply their state: a float32
// literal passed to spawn as the initial state reaches the actor as that float32. Before the fix
// the program printed nothing and never ended on the Mac.
// Expected output:
//   2.5
//   4.5
//   0
use trial_support_int64;

fn fa(msg: int64, state: float32) -> (:reply, float32, float32) {
    (:reply, state, state)
}

fn pf(x: float32) -> int64 {
    sequence proc[device_io]
        _: atom <- print_float32(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                a: actor_ref <- spawn(2.5, fa, stack_policy(0, :keep_last_message));
                c: actor_ref <- spawn(4.5, fa, stack_policy(0, :keep_last_message));
                ra: float32 <- call(a, 10 impl ActorMessage {});
                rc: float32 <- call(c, 10 impl ActorMessage {})
            produces
                pure pf(ra) + pf(rc)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
