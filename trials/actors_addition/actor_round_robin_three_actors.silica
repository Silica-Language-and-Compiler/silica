// Three actors; one call each in order. Replies are printed inside behaviors (avoids many int64 temps in main with three actor_ref).
// §16.1.1: call.

use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        print_int64(msg + state);
        println("")
    produces
        pure (:reply, msg + state, msg + state)
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency]
                x: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                y: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                z: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                _: int64 <- call(x, 1 impl ActorMessage {});
                _: int64 <- call(y, 2 impl ActorMessage {});
                _: int64 <- call(z, 3 impl ActorMessage {})
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
