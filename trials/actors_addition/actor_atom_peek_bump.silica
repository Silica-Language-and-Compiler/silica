// Atom-shaped messages: :peek returns state; :bump increments state (§15.1.2 call/reply).

use trial_support_atom;

fn srv(msg: atom, state: int64) -> (:reply, int64, int64) {
    case msg of {
        :peek -> (:reply, state, state);
        :bump -> (:reply, state + 1, state + 1);
        _: atom -> (:reply, state, state)
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, srv, stack_policy(0, :keep_last_message));
                p1: int64 <- call(w, (:peek) impl ActorMessage {});
                print_int64(p1);
                println("");
                _: int64 <- call(w, (:bump) impl ActorMessage {});
                p2: int64 <- call(w, (:peek) impl ActorMessage {});
                print_int64(p2);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
