// Every actor built-in whose spec result is :ok answers :ok (link and demonitor, spec §15.4.8.5-7;
// set_actor_priority, migrate_actor and unpin_actor, §22.10), index 2 of the fixed atom prefix. Before
// 2026-10-09 the hosted emitters handed the program the runtime's 0, which is :efficiency, the first
// atom of the prefix, and migrate_actor / set_actor_priority returned the OS call's status. link,
// monitor and demonitor are behaviour-only, so a worker actor runs the calls against a peer it
// spawns and replies with the last result; main prints the reply and returns it, so the exit status
// is :ok's index, 2. Only atoms this suite already interns are used (:ok and :normal are in the fixed
// prefix), so no other trial's atom index moves.
// Expected: ":ok" five times from the worker, ":ok" once from main, exit 2.

use trial_support_atom;

fn peer(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn show(r: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print_atom(r);
        println("")
    produces
        pure r
    end
}

fn worker(msg: int64, state: int64) -> (:reply, atom, int64) {
    sequence proc[concurrency]
        p: actor_ref <- spawn(0, peer, stack_policy(0, :keep_last_message));
        linked: atom <- link(p);
        _: atom <- show(linked);
        m: monitor_ref <- monitor(p);
        demonitored: atom <- demonitor(m);
        _: atom <- show(demonitored);
        prioritised: atom <- set_actor_priority(p, :normal);
        _: atom <- show(prioritised);
        migrated: atom <- migrate_actor(p, 0);
        _: atom <- show(migrated);
        unpinned: atom <- unpin_actor(p);
        last: atom <- show(unpinned)
    produces
        pure (:reply, last, state + msg)
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
                r: atom <- call(w, 1 impl ActorMessage {});
                last: atom <- show(r)
            produces
                pure last
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
