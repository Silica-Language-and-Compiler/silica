// Direct calls of functions returning a reply form (:reply, int64, int64) (or (:no_reply, int64))
// whose parameters include float64, float32 or float16 values, in first, middle and last
// positions, read every parameter from the right register and return the reply intact. Covered:
// float before / after an int64, mixed float32 and float64 among int64s, a float16 last, all three
// float widths, eight parameters (all int64, and int64s mixed with all three float widths), a
// function whose whole body is a reply-form call (cb, cb8, which reorders its eight arguments),
// the same functions called through function values, and a reply-form call passed straight in as
// an argument. Each pr line prints its tag (the expected pair) and then the pair it got.
//   t1  f64a(1.5, 40)                          -> (40, 41)
//   t2  f64b(5, 3.25)                          -> (5, 7)
//   t3  f32m(1, 0.75, 2, 4.5, 9)               -> (1 + 2, 9) = (3, 9)
//   t4  f16b(11, 12, 2.5)                      -> (11, 12)
//   t5  ffall(6.5, 0.75, 2.5)                  -> (:no_reply, 7)
//   t6  e8(1, 2, 3, 4, 5, 6, 7, 8)             -> (1 + ... + 7, 8) = (28, 8)
//   t7  e8f(1, 1.25, 2, 0.75, 3, 4, 5, 2.5)    -> (1 + 2 + 3 + 4, 5) = (10, 5)
//   t8  cb(8.5, 30) = f64b(31, 8.5)            -> (31, 33)
//   t9  cb8(1..8) = e8(8, 7, ..., 1)           -> (8 + 7 + ... + 2, 1) = (35, 1)
//   t10 f64a through a fn value (9.75, 50)     -> (50, 51)
//   t11 e8 through a fn value (1 x7, 9)        -> (7, 9)
//   t12 e8f through a fn value (2, 0.5, 2, 0.75, 2, 2, 3, 2.5) -> (2 + 2 + 2 + 2, 3) = (8, 3)
//   t13 first(f64b(77, 1.0))                   -> 77
// Expected output:
//   f64a x=1.5
//   t1 40 41 40 41
//   f64b x=3.25
//   t2 5 7 5 7
//   f32m x=0.75 y=4.5
//   t3 3 9 3 9
//   f16b x=2.5
//   t4 11 12 11 12
//   ffall 6.5 0.75 2.5
//   7 t5 7
//   t6 28 8 28 8
//   e8f 1.25 0.75 2.5
//   t7 10 5 10 5
//   f64b x=8.5
//   t8 31 33 31 33
//   t9 35 1 35 1
//   f64a x=9.75
//   t10 50 51 50 51
//   t11 7 9 7 9
//   e8f 0.5 0.75 2.5
//   t12 8 3 8 3
//   f64b x=1.0
//   77 t13 77
//   0 (exit status)
use trial_support_int64;

fn f64a(x: float64, n: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("f64a x=");
        _: atom <- print_float64(x);
        println("")
    produces
        pure (:reply, n, n + 1)
    end
}

fn f64b(n: int64, x: float64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("f64b x=");
        _: atom <- print_float64(x);
        println("")
    produces
        pure (:reply, n, n + 2)
    end
}

fn f32m(a: int64, x: float32, b: int64, y: float64, c: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("f32m x=");
        _: atom <- print_float32(x);
        _: atom <- print_string(" y=");
        _: atom <- print_float64(y);
        println("")
    produces
        pure (:reply, a + b, c)
    end
}

fn f16b(n: int64, m: int64, x: float16) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("f16b x=");
        _: atom <- print_float16(x);
        println("")
    produces
        pure (:reply, n, m)
    end
}

fn ffall(x: float64, y: float32, z: float16) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_string("ffall ");
        _: atom <- print_float64(x);
        _: atom <- print_string(" ");
        _: atom <- print_float32(y);
        _: atom <- print_string(" ");
        _: atom <- print_float16(z);
        println("")
    produces
        pure (:no_reply, 7)
    end
}

fn e8(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64) -> (:reply, int64, int64) {
    (:reply, a + b + c + d + e + f + g, h)
}

fn e8f(a: int64, x: float64, b: int64, y: float32, c: int64, d: int64, e: int64, z: float16) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("e8f ");
        _: atom <- print_float64(x);
        _: atom <- print_string(" ");
        _: atom <- print_float32(y);
        _: atom <- print_string(" ");
        _: atom <- print_float16(z);
        println("")
    produces
        pure (:reply, a + b + c + d, e)
    end
}

fn cb(x: float64, n: int64) -> (:reply, int64, int64) {
    f64b(n + 1, x)
}

fn cb8(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64) -> (:reply, int64, int64) {
    e8(h, g, f, e, d, c, b, a)
}

fn first(t: (:reply, int64, int64)) -> int64 {
    (_, a, _) <- t;
    a
}

fn pr(tag: string, t: (:reply, int64, int64)) -> int64 {
    sequence proc[device_io]
        (_, a, b) <- t;
        _: atom <- print_string(tag);
        _: atom <- print_string(" ");
        _: atom <- print_int64(a);
        _: atom <- print_string(" ");
        _: atom <- print_int64(b);
        println("")
    produces
        pure 0
    end
}

fn checks() -> int64 {
    sequence proc[device_io]
        h16: float16 <- 2.5;
        x32: float32 <- 0.75;
        t1: (:reply, int64, int64) <- f64a(1.5, 40);
        _: int64 <- pr("t1 40 41", t1);
        t2: (:reply, int64, int64) <- f64b(5, 3.25);
        _: int64 <- pr("t2 5 7", t2);
        t3: (:reply, int64, int64) <- f32m(1, x32, 2, 4.5, 9);
        _: int64 <- pr("t3 3 9", t3);
        t4: (:reply, int64, int64) <- f16b(11, 12, h16);
        _: int64 <- pr("t4 11 12", t4);
        t5: (:no_reply, int64) <- ffall(6.5, x32, h16);
        (_, s5) <- t5;
        _: atom <- print_int64(s5);
        println(" t5 7");
        t6: (:reply, int64, int64) <- e8(1, 2, 3, 4, 5, 6, 7, 8);
        _: int64 <- pr("t6 28 8", t6);
        t7: (:reply, int64, int64) <- e8f(1, 1.25, 2, x32, 3, 4, 5, h16);
        _: int64 <- pr("t7 10 5", t7);
        t8: (:reply, int64, int64) <- cb(8.5, 30);
        _: int64 <- pr("t8 31 33", t8);
        t9: (:reply, int64, int64) <- cb8(1, 2, 3, 4, 5, 6, 7, 8);
        _: int64 <- pr("t9 35 1", t9);
        hv: fn(float64, int64) -> (:reply, int64, int64) <- f64a;
        t10: (:reply, int64, int64) <- hv(9.75, 50);
        _: int64 <- pr("t10 50 51", t10);
        hv8: fn(int64, int64, int64, int64, int64, int64, int64, int64) -> (:reply, int64, int64) <- e8;
        t11: (:reply, int64, int64) <- hv8(1, 1, 1, 1, 1, 1, 1, 9);
        _: int64 <- pr("t11 7 9", t11);
        hvf: fn(int64, float64, int64, float32, int64, int64, int64, float16) -> (:reply, int64, int64) <- e8f;
        t12: (:reply, int64, int64) <- hvf(2, 0.5, 2, x32, 2, 2, 3, h16);
        _: int64 <- pr("t12 8 3", t12);
        k: int64 <- first(f64b(77, 1.0));
        _: atom <- print_int64(k);
        println(" t13 77")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                r: int64 <- checks()
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
