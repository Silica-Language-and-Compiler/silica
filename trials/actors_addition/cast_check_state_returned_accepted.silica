// Spec §16.1.2 (2026-10-13), accepting side of cast_check_state_returned (E2237): swapper casts to the pid
// in its state and returns msg.pid as its new pid; every reference it can hold is the cast-only
// printer, so the cast compiles. main casts swapper twice, so swapper casts "swapped" to the printer
// twice; the printer prints each and ends the program after the second.
// Records here reuse the field names op, name, pid (the suite's first record shape) so that adding
// this trial does not renumber the shapes of the trials compiled after it.
// Expected output:
//   swapped
//   swapped
//   0

fn printer(msg: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        n: int64 <- state + 1;
        println(msg);
        _: boolean <- case n == 2 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, n)
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn swapper(msg: { op: int64, name: string, pid: actor_ref }, state: { op: int64, name: string, pid: actor_ref }) -> (:no_reply, { op: int64, name: string, pid: actor_ref }) {
    sequence proc[concurrency]
        _: boolean <- cast(state.pid, "swapped" impl ActorMessage {})
    produces
        pure (:no_reply, { op: msg.op, name: msg.name, pid: msg.pid })
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        q: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message));
        s: actor_ref <- spawn({ op: 1, name: "printer", pid: q }, swapper, stack_policy(0, :keep_last_message));
        _: boolean <- cast(s, { op: 1, name: "printer", pid: q } impl ActorMessage {});
        _: boolean <- cast(s, { op: 1, name: "printer", pid: q } impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
