// A function with a float64 parameter ahead of an int64 one, returning a reply form
// (:reply, int64, int64), reads its int64 parameter from the right register and returns the reply
// intact: fr(1.5, 40) = (:reply, 40, 41) -> 40 + 41 = 81.
// Expected output:
//   81
//   0
use trial_support_int64;

fn fr(x: float64, n: int64) -> (:reply, int64, int64) {
    (:reply, n, n + 1)
}

fn show(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn check() -> int64 {
    sequence
        t: (:reply, int64, int64) <- fr(1.5, 40);
        (_, a, b) <- t;
        _: int64 <- show(a + b)
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                r: int64 <- check()
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
