// A root FailureReporter (spec section 15.4.13.4) that ends the program, the shape the compiler's own
// main uses (actor_memory_budget_plan.md item L). main registers the reporter, starts a supervisor
// with one :temporary worker, casts the worker a zero divisor, and waits in wait_for_exit. The worker
// dies in the division; the runtime delivers its unwind report to the reporter, which prints one fixed
// line (the report text itself carries pointers and is not printed) and ends the program with
// cast_exit(1). wait_for_exit then returns 1, which main returns as the status.
// Expected output:
//   report received
//   1

use Supervisor;

impl ReporterTrialSupervisor for Supervisor;

fn region_dump_limit() -> int64 {
    0
}

fn handle_report(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println("report received");
        _: boolean <- cast_exit(1)
    produces
        pure (:no_reply, state)
    end
}

fn divide_beh(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, 42 / msg)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 1 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :trial_worker, agent_type: :worker, initial_state: 0, behavior: divide_beh, restart: :temporary, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        reporter: actor_ref <- spawn(0, handle_report, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter);
        _: supervisor_ref <- spawn_registered_supervisor(ReporterTrialSupervisor, 0, :trial_supervisor, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:trial_worker, 0 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
