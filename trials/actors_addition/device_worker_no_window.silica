// A device worker that maps nothing: spawn_device and cast_device alone compile and run on every
// target (device spec §10 -- only map_device, peek and poke are rejected on hosted targets).
// Expected on the host and on the board: worker ok / status 0.
use trial_wait_int64;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("worker ok")
    produces
        pure (:no_reply, state + msg)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                d: device_actor_ref <- spawn_device(0, worker, stack_policy(0, :keep_last_message));
                _: boolean <- cast_device(d, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
