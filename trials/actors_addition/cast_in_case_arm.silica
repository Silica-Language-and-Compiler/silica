// cast_in_case_arm
//
// A case arm whose body is cast(actor_ref, msg impl ActorMessage {}). A cast is an expression
// (spec §3.3.11 cast_expression; §16.1.2, it yields a boolean), and a case arm body is an
// expression (§3.3.3), so `true -> cast(s, n impl ActorMessage {})` is a valid arm.
// Found while writing bees_gaps_open_addition/monitor_down_delivered (2026-10-23); fixed the same
// day in parser/constraint_extract_expr.silica (extract_case_rhs_primary_nonempty): the case-arm
// RHS extractor accepted only identifier tokens as a call head, so the keyword `cast` was read as
// a bare operand and `(s, n ...)` became the next arm's pattern (E2005 "invalid or unsupported
// case pattern" at the `(`) or trailed the last arm (E1069 "no parsable body"). The same path
// covers send, spawn, self, link, monitor and the other callable keywords; cast_registered,
// cast_exit and call are identifiers and never failed.
// Expected: the sink receives 5, prints it and ends main's wait_for_exit with cast_exit(0).
//   5
//   0

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print_int64(msg);
        println("");
        _: boolean <- cast_exit(0)
    produces pure (:no_reply, state + 1) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- start_reporter();
        s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        n: int64 <- 5;
        _: boolean <- case n > 0 of {
            true -> cast(s, n impl ActorMessage {});
            false -> false
        };
        code: int64 <- wait_for_exit()
    produces pure code end
}

fn region_dump_limit() -> int64 {
    0
}

// One line per report; any failure ends main's wait_for_exit with cast_exit(70).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println("failure report");
        _: boolean <- cast_exit(70)
    produces
        pure (:no_reply, state + 1)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
