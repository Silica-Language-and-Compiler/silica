// Front-end guard: a behaviour whose new state keeps a string taken from the MESSAGE through a
// tuple pattern must not be state-release-proven (W2300). `logger` keeps `report`, a part of
// `msg`, as the second element of its new state, and nothing in the state is rebuilt from the
// old state's string, so the old state cannot be proven dead by an update. The compiler warns
// (W2300: state release not proven for behaviour 'logger': slot '0' is replaced without an
// update (by a part of '%msg')) and the state chain is released, so 300 dispatches, each with a
// freshly built report string, do not exhaust memory. Before the fix the message part was
// treated as proven and the chain was not released.
//
// `driver` casts itself the next index (cast over call) and casts `logger` one message per
// index. At the 300th message `logger` prints how many reports were damaged (the state's
// string was read after the next dispatch; all must still end with the marker) and ends.
// Expected output:
//   0
//   0

fn region_dump_limit() -> int64 {
    0
}

fn logger(msg: (string, int64), state: (int64, string, int64)) -> (:no_reply, (int64, string, int64)) {
    sequence proc[concurrency, device_io]
        (report, k): (string, int64) <- msg;
        (n, last, damaged): (int64, string, int64) <- state;
        ok: boolean <- n == 0 or contains(last, "=== end of report ===");
        now_damaged: int64 <- case ok of { true -> damaged; false -> damaged + 1 };
        _: boolean <- case n + 1 == 300 of {
            true -> { _: atom <- print_int64(now_damaged + k); _: atom <- println(""); cast_exit(0) };
            false -> true
        }
    produces
        pure (:no_reply, (n + 1, report, now_damaged))
    end
}

fn digit(d: int64) -> string {
    substring("0123456789", d, d + 1)
}

fn number_text(n: int64) -> string {
    case n < 10 of {
        true -> digit(n);
        false -> concat(number_text(n / 10), digit(n % 10))
    }
}

fn send_next(me: actor_ref, i: int64) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(me, i impl ActorMessage {})
    produces
        pure sent
    end
}

fn driver(msg: int64, state: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        text: string <- concat("report ", concat(number_text(msg), " === end of report ==="));
        _: boolean <- cast(state, (text, 0) impl ActorMessage {});
        me: actor_ref <- self();
        _: boolean <- case msg + 1 == 300 of {
            true -> true;
            false -> send_next(me, msg + 1)
        }
    produces
        pure (:no_reply, state)
    end
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(r);
        l: actor_ref <- spawn((0, "", 0), logger, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        d: actor_ref <- spawn(l, driver, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(d, 0 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
