// The FailureReporter (spec §15.4.13.4) itself fails while it handles a report. main registers the
// reporter and starts two root workers, each of which dies dividing 42 by the 0 main casts it. The
// reporter divides 42 by its state, 0, so it dies on the first report it handles; that report goes
// back with it, and its own unwind report is written to standard error, since no reporter is left.
// The other worker's report, queued for the reporter when it died or made after, is written to
// standard error once. Each report ends in the `actor_thread_main` frame; after two of them the
// harness writes the `exit` line (failure_reporter_fails_mid_report.wait_for_exit), wait_for_exit
// returns 0 and main returns it. Which worker's report is the one written is not defined, and the
// reports are written asynchronously, so the golden is compared unordered (.scout.multiset).
// Expected output (pointers and the atom number folded by the compare):
//   the reporter's report (#0 failure_reporter_fails_mid_report_handle_report)
//   one worker's report (#0 failure_reporter_fails_mid_report_divide_beh)
//   0

fn region_dump_limit() -> int64 {
    0
}

fn divide_beh(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, 42 / msg)
}

fn handle_report(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, 42 / state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        reporter: actor_ref <- spawn(0, handle_report, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter);
        w1: actor_ref <- spawn(0, divide_beh, stack_policy(0, :keep_last_message));
        w2: actor_ref <- spawn(0, divide_beh, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w1, 0 impl ActorMessage {});
        _: boolean <- cast(w2, 0 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
