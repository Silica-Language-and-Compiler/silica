// A call returning a reply form (:reply, int64, int64) passed straight in as another function's
// argument arrives intact, both when the outer function returns an aggregate and when it returns
// int64, called as a function's whole body and from a sequence's produces.
//   agg(4):    first_two(count_reply(4)) = first_two((:reply, 40, 4)) = (40, 4)  -> 40 * 100 + 4 = 4004
//   agg_let(4): k 5, first_two((:reply, 50, 5)) = (50, 5)                       -> 5005
//   plain(4):  second((:reply, 40, 4)) = 40 + 4                                 -> 44
//   plain2(4): k 5, second((:reply, 50, 5)) + 1 = 50 + 5 + 1                    -> 56
// Expected output:
//   4004
//   5005
//   44
//   56
//   0
use trial_support_int64;

fn count_reply(n: int64) -> (:reply, int64, int64) {
    (:reply, n * 10, n)
}

fn first_two(t: (:reply, int64, int64)) -> (int64, int64) {
    sequence
        (_, a, b) <- t
    produces
        pure (a, b)
    end
}

fn agg(n: int64) -> (int64, int64) {
    first_two(count_reply(n))
}

fn agg_let(n: int64) -> (int64, int64) {
    sequence
        k: int64 <- n + 1
    produces
        pure first_two(count_reply(k))
    end
}

fn second(t: (:reply, int64, int64)) -> int64 {
    sequence
        (_, a, b) <- t
    produces
        pure a + b
    end
}

fn plain(n: int64) -> int64 {
    second(count_reply(n))
}

fn plain2(n: int64) -> int64 {
    sequence
        k: int64 <- n + 1
    produces
        pure second(count_reply(k)) + 1
    end
}

fn show(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn checks() -> int64 {
    sequence
        (x, y) <- agg(4);
        _: int64 <- show(x * 100 + y);
        (x2, y2) <- agg_let(4);
        _: int64 <- show(x2 * 100 + y2);
        _: int64 <- show(plain(4));
        _: int64 <- show(plain2(4))
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                r: int64 <- checks()
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
