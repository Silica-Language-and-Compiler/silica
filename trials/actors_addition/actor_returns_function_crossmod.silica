// Actor whose reply is a function value taken from a DIFFERENT module (same signature).
// msg 0 -> dbl, else -> inc. Proves fn-values cross module boundaries through call().
use actor_returns_function_crossmod_fns;
use trial_support_int64;
fn srv(msg: int64, state: int64) -> (:reply, fn(int64) -> int64, int64) {
    case msg == 0 of {
        true -> (:reply, actor_returns_function_crossmod_fns@dbl, state);
        false -> (:reply, actor_returns_function_crossmod_fns@inc, state)
    }
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, srv, stack_policy(0, :keep_last_message));
                f0: fn(int64) -> int64 <- call(w, 0 impl ActorMessage {});
                f1: fn(int64) -> int64 <- call(w, 1 impl ActorMessage {});
                a: int64 <- f0(21);
                b: int64 <- f1(9)
            produces pure a + b end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
