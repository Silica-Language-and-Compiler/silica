// Spec §16.1.2 (2026-10-13), accepting side of cast_check_case_same (E2237): a case whose arms name a
// call-only and a cast-only actor is not provably call-only, so the cast compiles. The condition is
// a run-time value (plain's reply, 41) so it cannot be folded; at run time the case picks the
// cast-only printer, which prints the message and ends the program.
// Expected output:
//   case
//   0

fn printer(msg: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        n: int64 <- state + 1;
        println(msg);
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, n)
    end
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state + 41, state + 1)
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        q: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message));
        k: int64 <- call(p, "k" impl ActorMessage {});
        r: actor_ref <- case k > 100 of {
            true -> p;
            false -> q
        };
        _: boolean <- cast(r, "case" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
