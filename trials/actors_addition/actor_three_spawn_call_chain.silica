// Three independent actors; main issues call() to each in order (first → second → third).
// §15.1.2: (:reply, reply_value, new_state); §16.1.1: call(actor_ref, message) -> Reply.

use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        println("Before state is");
        print_int64(state);
        println("");
        println("Received message");
        print_int64(msg);
        println("");
        new_state: int64 <- msg + state;
        println("New state is");
        print_int64(new_state);
        println("")
    produces
        pure (:reply, new_state, new_state)
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency]
                first: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                second: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                third: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                _: int64 <- call(first, 1 impl ActorMessage {});
                _: int64 <- call(second, 2 impl ActorMessage {});
                _: int64 <- call(third, 3 impl ActorMessage {})
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
