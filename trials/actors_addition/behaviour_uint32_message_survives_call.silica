// A behaviour's narrow first parameter must survive the calls before it is used. The reply
// buffer behaviour kept uint32 messages in the ABI home (W0), where print_string's unit result
// replaced them, so the second print showed 0 instead of the message. §16.1.2 cast.

use trial_wait_int64;

fn show(v: uint32, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_string("uint32 got ");
        _: atom <- print_uint32(v);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, show, stack_policy(0, :keep_last_message));
                m: uint32 <- 7;
                _: boolean <- cast(w, m impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
