// Chunk 15 phase 6 stage 6b: under `strict region_check;` a binding is a fresh name, not a use. forward
// moves x into a cast, then rebinds x to a new value and reads that one; no E2301.
use trial_wait_int64;

strict region_check;

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn forward(p: actor_ref, x: int64) -> int64 {
    sequence proc[concurrency, device_io]
        _: boolean <- cast(p, move(x) impl ActorMessage {});
        x: int64 <- 7;
        _: int8 <- print_int64(x);
        _: int8 <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                q: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                r: int64 <- forward(q, 5);
                _: atom <- remove_actor(q)
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
