// Spec §15.1.2.3 (Actor Termination): an actor ends itself only with stop_self or fail_self.
// remove_actor must not name the calling actor. remove_actor(self()) written out is rejected at
// compile time (E2241, error_enforcement_addition/terminate_self_by_remove_actor); here the target
// reaches remove_actor through end_actor's parameter, which the compiler cannot see through, so the
// calling actor fails at run time with failure_reason :language_error (reason_tag 2) and runs no
// further: the println after end_actor(self()) is never reached. The worker is cast-only and
// main only casts, so nothing waits on a reply. The FailureReporter writes the worker's report,
// prints the done marker and ends the program with cast_exit(0).
//
// Expected output (order checked as a multiset):
//   one failure report: reason_tag 2, frame #0 remove_actor_self_language_error_worker
//   done
// exit status 0 (no "after remove_actor(self())" line)

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: int64 <- end_actor(self());
        _: atom <- println("after remove_actor(self())")
    produces
        pure (:no_reply, state + msg)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// Writes the report to stderr, prints the done marker and ends the program with status 0.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: atom <- println("done");
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}

// Ends `target` with remove_actor. The caller passes self(); behind the parameter the compiler
// cannot tell, so the run-time check fails the calling actor with :language_error.
fn end_actor(target: actor_ref) -> int64 {
    sequence proc[concurrency]
        _: atom <- remove_actor(target)
    produces
        pure 0
    end
}
