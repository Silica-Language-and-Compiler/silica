// defect A3: record-typed actor state through call/reply; 6 + 9 = 15
use trial_support_atom;

fn tally(msg: int64, state: { v: int64, hits: int64 }) -> (:reply, int64, { v: int64, hits: int64 }) {
    (:reply, state.v + msg, { v: state.v + msg, hits: state.hits + 1 })
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn({ v: 6, hits: 0 }, tally, stack_policy(0, :keep_last_message));
                r0: int64 <- call(w, 9 impl ActorMessage {});
                print_int64(r0);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
