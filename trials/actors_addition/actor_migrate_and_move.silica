use trial_wait_int64;

fn handler(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
    println("handler received message: ");
    print_int64(msg);
    println("");
    println("handler state: ");
    print_int64(state);
    println("");
    println("updated state: ");
    print_int64(state + msg);
    println("");
    println("done")
    produces
        pure (:no_reply, state + msg)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                ref: actor_ref <- spawn(0, handler, stack_policy(0, :keep_last_message));
                _: atom <- migrate_actor(ref, 2);
                _: atom <- migrate_actor(ref, 4);
                enqueued: boolean <- cast(ref, 42 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
