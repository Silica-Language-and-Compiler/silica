// call-only worker and cast-only sink in one main (mixed conventions, two actor_ref).
// §16.1.1 call / §16.1.2 cast.

use trial_support_atom;

fn reply_fn(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn silent(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency]
                sink: actor_ref <- spawn(0, silent, stack_policy(0, :keep_last_message));
                talker: actor_ref <- spawn(0, reply_fn, stack_policy(0, :keep_last_message));
                _: int64 <- call(talker, 3 impl ActorMessage {});
                _: boolean <- cast(sink, 9 impl ActorMessage {})
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
