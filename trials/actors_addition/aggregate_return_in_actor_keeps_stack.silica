// A behaviour that calls an aggregate-returning function on every dispatch keeps its stack: 100,000
// messages x 10 record-returning calls each. Every such call used to leak ~32 bytes of actor stack
// (~4 bytes for a one-field record) until the 8 MB guard, faulting in `mk`; the caller's sret slab
// is now released. Kept as a regression trial under a plain name (was sd21_aggregate_return_leaks_stack).
// Expected: 7700154, done, exit 0.

use trial_wait_int64;

fn mk(n: int64) -> { a: int64, b: int64, c: int64 } { { a: n, b: n + 1, c: n + 2 } }
fn sum_k(k: int64, acc: int64) -> int64 {
    sequence
        r: { a: int64, b: int64, c: int64 } <- mk(k);
        v: int64 <- case k == 0 of { true -> acc + r.c; false -> sum_k(k - 1, acc + r.c) }
    produces pure v end
}
fn beh(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        v: int64 <- sum_k(10, 0);
        _: atom <- case msg == 0 - 1 of {
            true -> { _: atom <- print_int64(state + v); println(""); println("done"); :ok };
            false -> :ok
        }
    produces pure (:no_reply, state + v) end
}
fn send_n(a: actor_ref, i: int64) -> atom {
    sequence proc[concurrency]
        _: boolean <- cast(a, i impl ActorMessage {});
        r: atom <- case i == 0 of { true -> :ok; false -> send_n(a, i - 1) }
    produces pure r end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                a: actor_ref <- spawn(0, beh, stack_policy(0, :keep_last_message));
                _: atom <- send_n(a, 100000);
                _: boolean <- cast(a, 0 - 1 impl ActorMessage {})
            produces pure 0 end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
