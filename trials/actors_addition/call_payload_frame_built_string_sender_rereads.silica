// Chunk 15 phase 2 (S6d, forwarding-word restore): a call whose payload is a string built with concat
// in the SENDER's frame. The send walks the payload to the heap (heap-mode evacuation), which marks
// each source node with a forwarding word. The sender's string must be restored afterwards: before
// the fix the sender's string marker stayed overwritten and its next read trapped (exit 133, found by
// compiler_substrate/type_interner_roundtrip). The sender reads the same string twice after the call.
// Expected: 5 (length seen by the actor), hello, hello!, then status 0.
//   5
//   hello
//   hello!
//   0

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn measure(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, length_bytes(msg), state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(0, measure, stack_policy(0, :keep_last_message));
        s: string <- concat("hel", "lo");
        n: int64 <- call(a, s impl ActorMessage {});
        print_int64(n);
        println("");
        println(s);
        println(concat(s, "!"))
    produces
        pure 0
    end
}
