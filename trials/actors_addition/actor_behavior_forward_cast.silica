// Spec §15.1.2: recv() is runtime-internal only; forwarding is done inside a behavior via cast().
// Router behavior receives msg as a parameter and delivers it to another actor via cast().
// §15.1.2: behavior returns (:no_reply, new_state) for cast() messages.
// integrate .scout: process exit is main's return atom index (:no_reply is collected before :ok → :ok is 1).

use trial_support_atom;

fn sink(msg: int64, state: { v: int64 }) -> (:no_reply, { v: int64 }) {
    (:no_reply, { v: state.v + msg })
}

fn forwarder(msg: int64, state: { sink: actor_ref }) -> (:no_reply, { sink: actor_ref }) {
    sequence proc[concurrency]
        _: boolean <- cast(state.sink, msg impl ActorMessage {})
    produces
        pure :ok
    end;
    (:no_reply, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency]
                sink_ref: actor_ref <- spawn({ v: 0 }, sink, stack_policy(0, :keep_last_message));
                router: actor_ref <- spawn({ sink: sink_ref }, forwarder, stack_policy(0, :keep_last_message));
                _: boolean <- cast(router, 7 impl ActorMessage {})
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
