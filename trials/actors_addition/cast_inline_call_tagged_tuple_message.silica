// SD-44 / SD-45 / SD-31 (BEES request C2, 2026-11-17): a user function call written inline as a cast message
// (or as an element of a message tuple literal) was lowered with no expected type, so the message was sent as
// a bare word: no message-buffer copy, and the receiver read a pointer into the sender's dead frame. The
// behaviour casts to self(), so the next dispatch reuses the frame before the message is read.
// Here: mk() returns a tagged-tuple sum. Expected: 21 ok / 35 ok, exit 0.
fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- cast_exit(70)
    produces
        pure (:no_reply, state)
    end
}

fn mk(n: int64) -> (:go, int64) | (:ok, int64) | (:err, atom) {
    case n > 0 of {
        true -> (:ok, n * 7);
        false -> (:err, :neg)
    }
}

fn relay(msg: (:go, int64) | (:ok, int64) | (:err, atom), state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        me: actor_ref <- self();
        r: int64 <- case msg of {
            (:go, n: int64) -> {
                _: boolean <- cast(me, mk(n) impl ActorMessage {});
                0
            };
            (:ok, x: int64) -> {
                print_int64(x);
                println(" ok");
                1
            };
            (:err, _: atom) -> {
                println("err");
                1
            }
        };
        _: boolean <- case state + r == 2 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, state + r)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(0, relay, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(a, (:go, 3) impl ActorMessage {});
        _: boolean <- cast(a, (:go, 5) impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
