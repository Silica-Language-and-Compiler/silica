// A call made after a target actor is marked dead completes with the runtime
// actor-death result instead of blocking on an unserviced wrapper.

use trial_wait_int64;

fn echo(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg, state)
}

fn killer(msg: int64, victim: actor_ref) -> (:reply, int64, actor_ref) {
    sequence proc[concurrency]
        _: atom <- kill_abnormal(victim);
        result: int64 <- call(victim, msg impl ActorMessage {})
    produces
        pure (:reply, result, victim)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                victim: actor_ref <- spawn(0, echo, stack_policy(0, :keep_last_message));
                worker: actor_ref <- spawn(victim, killer, stack_policy(0, :keep_last_message));
                result: int64 <- call(worker, 42 impl ActorMessage {});
                print_int64(result);
                println("");
                println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
