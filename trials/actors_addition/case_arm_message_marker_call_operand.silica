// Spec §16.3.2 / §5: a case expression whose every arm carries the `impl ActorMessage {}` marker is
// itself a marked message, so it can be the message operand of call directly. The worker replies
// msg + 1; flag is true, so the true arm sends 5.
// Expected, by hand: call(w, 5) = 5 + 1 prints 6; the work returns 0, the exit status.
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + 1, state)
}

fn work() -> int64 {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        flag: boolean <- true;
        r: int64 <- call(w, case flag of {
            true -> 5 impl ActorMessage {};
            false -> 7 impl ActorMessage {}
        });
        _: atom <- print_int64(r);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            work()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
