// Spec §16.1.2 (2026-10-13), accepting side of cast_check_message_field (E2237): answerer casts to the
// pid field of its message, and main sends it the cast-only printer as pid, so the cast
// compiles. The printer prints "answered" and ends the program.
// Records here reuse the field names op, name, pid (the suite's first record shape) so that adding
// this trial does not renumber the shapes of the trials compiled after it.
// Expected output:
//   answered
//   0

fn printer(msg: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        n: int64 <- state + 1;
        println(msg);
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, n)
    end
}

fn answerer(msg: { op: int64, name: string, pid: actor_ref }, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: boolean <- cast(msg.pid, "answered" impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        q: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message));
        a: actor_ref <- spawn(0, answerer, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, { op: 1, name: "printer", pid: q } impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
