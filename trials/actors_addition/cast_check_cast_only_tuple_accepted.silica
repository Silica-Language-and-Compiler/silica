// Spec §16.1.2 (2026-10-13), accepting side of cast_check_tuple_field (E2237): a reference that goes
// through a tuple and a tuple pattern is tracked, and here it names a cast-only actor, so the cast
// compiles. The cast-only printer prints the message and ends the program.
// Expected output:
//   tuple
//   0

fn printer(msg: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        n: int64 <- state + 1;
        println(msg);
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, n)
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        q: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message));
        t: (actor_ref, int64) <- (q, 1);
        (r: actor_ref, _: int64) <- t;
        _: boolean <- cast(r, "tuple" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
