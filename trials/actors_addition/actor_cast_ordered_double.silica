// Two cast()s to the same cast-only actor (async; no I/O — process may exit before mailbox runs).
// §15.1.2: (:no_reply, State); §16.1.2: cast -> boolean.

use trial_support_atom;

fn silent(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency]
                peer: actor_ref <- spawn(0, silent, stack_policy(0, :keep_last_message));
                _: boolean <- cast(peer, 100 impl ActorMessage {});
                _: boolean <- cast(peer, 23 impl ActorMessage {})
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
