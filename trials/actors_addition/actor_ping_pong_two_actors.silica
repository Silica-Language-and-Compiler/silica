// Spec §15.1.2: behavior returns (:reply, reply_value, new_state) for call() messages.
// §16.1.1: call(actor_ref, message) -> Reply for synchronous request-reply.
// §15.1.3: self() returns the current actor's reference.


use trial_support_int64;

fn server(msg: atom, state: int64) -> (:reply, atom, int64) {
    sequence proc[device_io]
        result: atom <- case msg of {
            :ping -> {
                print_atom(msg);
                println("");
                :pong
            }
            _: atom -> :error
        }
    produces
        pure (:reply, result, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                server_ref: actor_ref <- spawn(0, server, stack_policy(0, :keep_last_message));
                result: atom <- call(server_ref, (:ping) impl ActorMessage {});
                print_atom(result);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
