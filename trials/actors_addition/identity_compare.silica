// Spec §15.1.4 Actor Identity: every actor reference is the actor's 64-bit identity
// (position << 32 | child number), printed as <position.child_number>. The six comparison operators
// compare identities as the pair (position, child number). main is position 0 and numbers the actors
// it spawns from 0 upward: the failure reporter is 0, a is 1, b is 2.
//
// Expected output:
//   rep <0.0>     main's first spawn            (child numbering; position 0 is main's by spec)
//   a <0.1>       main's second spawn           (child numbering)
//   b <0.2>       main's third spawn            (child numbering)
//   true          a == a
//   true          a != b
//   true          a < b                         (depends on child numbering: 1 < 2)
//   true          b >= a                        (depends on child numbering)
//   false         a > b                         (depends on child numbering)
//   true          rep <= a                      (depends on child numbering: 0 <= 1)
//   5             call(b, 5) on state 0: comparing references never disturbs the actors
//   done
//
// Position numbering: only position 0 (main) appears here, which the spec fixes and which the
// runtime's global position counter does not affect; every printed identity depends on the child
// numbers main hands out in spawn order (reporter first, then a, then b).
// Deviation: §4.5.1 and §22.4 still say comparison operators do not apply to references and name
// actor_ref_equal / actor_ref_not_equal; this trial follows §15.1.4 "Equality and order".

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- start_reporter();
        a: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        b: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message));
        _: int64 <- print_id("rep", rep);
        _: int64 <- print_id("a", a);
        _: int64 <- print_id("b", b);
        print_boolean(a == a);
        println("");
        print_boolean(a != b);
        println("");
        print_boolean(a < b);
        println("");
        print_boolean(b >= a);
        println("");
        print_boolean(a > b);
        println("");
        print_boolean(rep <= a);
        println("");
        v: int64 <- call(b, 5 impl ActorMessage {});
        print_int64(v);
        println("");
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

fn print_id(label: string, r: actor_ref) -> int64 {
    sequence proc[concurrency, device_io]
        i: uint64 <- actor_id(r);
        print(label);
        print(" <");
        print_uint64(i shr 32);
        print(".");
        print_uint64(i band 4294967295);
        println(">")
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println(case contains(report, "reason_tag:      4") of {
            true -> "failure report: reason_tag 4";
            false -> "failure report: other"
        })
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
