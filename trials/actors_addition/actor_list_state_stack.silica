// List-typed actor state: msg>0 pushes and returns new length; msg==0 returns current length.
use trial_support_atom;

fn llen(s: List[int64, mem(normal)]) -> int64 {
    sequence proc[mem(normal)] r: int64 <- length[int64, mem(normal)](s) produces pure r end
}
fn lpush(msg: int64, s: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)] r: List[int64, mem(normal)] <- prepend[int64, mem(normal)](msg, s) produces pure r end
}
fn srv(msg: int64, state: List[int64, mem(normal)]) -> (:reply, int64, List[int64, mem(normal)]) {
    case msg == 0 of {
        true -> (:reply, llen(state), state);
        false -> {
            ns: List[int64, mem(normal)] <- lpush(msg, state);
            (:reply, llen(ns), ns)
        }
    }
}
fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io, mem(normal)]
                e: List[int64, mem(normal)] <- [];
                w: actor_ref <- spawn(e, srv, stack_policy(0, :keep_last_message));
                l0: int64 <- call(w, 0 impl ActorMessage {});
                print_int64(l0);
                println("");
                _: int64 <- call(w, 5 impl ActorMessage {});
                _: int64 <- call(w, 6 impl ActorMessage {});
                l2: int64 <- call(w, 0 impl ActorMessage {});
                print_int64(l2);
                println("")
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
