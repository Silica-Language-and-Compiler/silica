// A behaviour whose case arm returns its reply form (:reply, int64, int64) through a call,
// count_reply(...), or through a block ending in that call, { k <- ...; count_reply(k) }, builds
// the reply in the actor's reply buffer, so handling a message leaves nothing on the heap; lit_beh,
// whose arms are tuple literals, is the control. Each actor is warmed with one call (msg 0, the
// false arm: reply -1, state 0 -> 1), then drive makes 2001 calls with msg 1 (i = 2000 down to 0)
// and the heap is read before and after.
//   case_beh / case_let_beh, state s: reply 10 * (s + 1), state s + 1. After the warm-up s is 1,
//   so the 2001 replies are 10 * 2 .. 10 * 2002: 10 * (2002 * 2003 / 2 - 1) = 20050020.
// Expected output (heap growth for lit_beh, the two sums, heap growth for case_beh, case_let_beh):
//   0
//   20050020
//   20050020
//   0
//   0
//   0 (exit status)
use trial_support_int64;

fn count_reply(n: int64) -> (:reply, int64, int64) {
    (:reply, n * 10, n)
}

fn case_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    case msg > 0 of {
        true -> count_reply(state + 1);
        false -> (:reply, 0 - 1, state + 1)
    }
}

fn case_let_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    case msg > 0 of {
        true -> {
            k: int64 <- state + msg;
            count_reply(k)
        };
        false -> (:reply, 0 - 1, state + 1)
    }
}

fn lit_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    case msg > 0 of {
        true -> (:reply, (state + 1) * 10, state + 1);
        false -> (:reply, 0 - 1, state + 1)
    }
}

fn drive(a: actor_ref, i: int64, acc: int64) -> int64 {
    sequence proc[concurrency]
        c: int64 <- call(a, 1 impl ActorMessage {});
        r: int64 <- case i == 0 of {
            true -> acc + c;
            false -> drive(a, i - 1, acc + c)
        }
    produces
        pure r
    end
}

fn show(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn measure() -> int64 {
    sequence proc[concurrency, mem(normal)]
        a: actor_ref <- spawn(0, case_beh, stack_policy(0, :keep_last_message));
        b: actor_ref <- spawn(0, case_let_beh, stack_policy(0, :keep_last_message));
        _: int64 <- call(a, 0 impl ActorMessage {});
        _: int64 <- call(b, 0 impl ActorMessage {});
        h0: int64 <- heap_used();
        s1: int64 <- drive(a, 2000, 0);
        h1: int64 <- heap_used();
        s2: int64 <- drive(b, 2000, 0);
        h2: int64 <- heap_used();
        c: actor_ref <- spawn(0, lit_beh, stack_policy(0, :keep_last_message));
        _: int64 <- call(c, 0 impl ActorMessage {});
        h3: int64 <- heap_used();
        _: int64 <- drive(c, 2000, 0);
        h4: int64 <- heap_used();
        _: int64 <- show(h4 - h3);
        _: int64 <- show(s1);
        _: int64 <- show(s2);
        _: int64 <- show(h1 - h0);
        _: int64 <- show(h2 - h1)
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                r: int64 <- measure()
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
