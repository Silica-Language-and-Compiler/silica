// Spec §15.4.13.4 "Handler before any start" (E2236): the trial-support shape. trial_support_int64
// @start() spawns and registers the FailureReporter before it starts the trial supervisor (both in
// the module, reached from main through its interface), so main needs no registration of its own.
// The work, run by the supervisor's worker, starts an actor of its own (a function literal is not
// followed: it runs in the worker), calls it, prints 42 and returns it as the program's status.
use trial_support_int64;

fn adder(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + 1, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                a: actor_ref <- spawn(0, adder, stack_policy(0, :keep_last_message));
                v: int64 <- call(a, 41 impl ActorMessage {});
                print_int64(v);
                println("")
            produces
                pure v
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
