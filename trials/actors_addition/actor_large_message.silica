// Large int64 message (sanity for mailbox / call path with non-tiny literals).

use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                r: int64 <- call(w, 1000000 impl ActorMessage {});
                print_int64(r);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
