// Second call() uses the first reply as the message operand (needs int64 spill across calls when one actor_ref holds X19).
// 0+5=5 reply; then 5+5=10.

use trial_support_atom;

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, acc, stack_policy(0, :keep_last_message));
                first: int64 <- call(w, 5 impl ActorMessage {});
                second: int64 <- call(w, first impl ActorMessage {});
                print_int64(first);
                println("");
                print_int64(second);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
