// float32 record fields take one word each, in an actor's state and reply and in records nested
// in tuples or holding tuples. The actor's state { a, b, c } (float32, int64, float32) starts
// { a: 1.25, b: 3, c: 2.75 }; each message swaps a and c, adds the message to b, and replies the
// new state. Then mix(3.25, 40) returns (x, { x: n, y: x }, n + 1), and intup(5.75) returns
// { tag: (x, 77), inner: 78 }. The work ends the program itself with cast_exit (trial_wait_int64's
// worker does not). The field names reuse record shapes the suite already numbers ({a,b,c}, {x,y},
// {tag,inner}) so the trial renumbers no other trial's shapes. Before the fix the Mac printed
// 0.0000000 for mix's float32 and then faulted (status 70).
// Expected output:
//   2.75 13 1.25     reply to 10
//   1.25 33 2.75     reply to 20
//   3.25 40 3.25 41  mix(3.25, 40)
//   5.75 77 78       intup(5.75)
//   (one per line)
//   0
use trial_wait_int64;

fn ra(msg: int64, state: { a: float32, b: int64, c: float32 }) -> (:reply, { a: float32, b: int64, c: float32 }, { a: float32, b: int64, c: float32 }) {
    (:reply, { a: state.c, b: state.b + msg, c: state.a }, { a: state.c, b: state.b + msg, c: state.a })
}

fn mix(x: float32, n: int64) -> (float32, { x: int64, y: float32 }, int64) {
    (x, { x: n, y: x }, n + 1)
}

fn intup(x: float32) -> { tag: (float32, int64), inner: int64 } {
    { tag: (x, 77), inner: 78 }
}

fn pf(x: float32) -> int64 {
    sequence proc[device_io]
        _: atom <- print_float32(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn pi(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                act: actor_ref <- spawn({ a: 1.25, b: 3, c: 2.75 }, ra, stack_policy(0, :keep_last_message));
                r1: { a: float32, b: int64, c: float32 } <- call(act, 10 impl ActorMessage {});
                r2: { a: float32, b: int64, c: float32 } <- call(act, 20 impl ActorMessage {});
                mr: (float32, { x: int64, y: float32 }, int64) <- mix(3.25, 40);
                (m1, m2, m3): (float32, { x: int64, y: float32 }, int64) <- mr;
                it: { tag: (float32, int64), inner: int64 } <- intup(5.75);
                (i1, i2): (float32, int64) <- it.tag;
                r: int64 <- pf(r1.a) + pi(r1.b) + pf(r1.c) + pf(r2.a) + pi(r2.b) + pf(r2.c) + pf(m1) + pi(m2.x) + pf(m2.y) + pi(m3) + pf(i1) + pi(i2) + pi(it.inner);
                _: boolean <- cast_exit(r)
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
