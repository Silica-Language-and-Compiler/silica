// §16.1.3: repeated call() to the same actor_ref preserves FIFO ordering for that sender.
// Many synchronous calls with the same payload advance state 1+1+…+1.

use trial_support_atom;

fn step(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, step, stack_policy(0, :keep_last_message));
                r01: int64 <- call(w, 1 impl ActorMessage {});
                r02: int64 <- call(w, 1 impl ActorMessage {});
                r03: int64 <- call(w, 1 impl ActorMessage {});
                r04: int64 <- call(w, 1 impl ActorMessage {});
                r05: int64 <- call(w, 1 impl ActorMessage {});
                r06: int64 <- call(w, 1 impl ActorMessage {});
                r07: int64 <- call(w, 1 impl ActorMessage {});
                r08: int64 <- call(w, 1 impl ActorMessage {});
                print_int64(r08);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
