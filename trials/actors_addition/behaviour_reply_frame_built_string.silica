// Chunk 15 phase 2 (S5, heap evacuation of behaviour results): a behaviour builds its reply string
// with concat in its own frame; the reply and the new state (the same string) are evacuated to the
// heap before the frame goes. Each call grows the state by one "x". Expected: ax, axx, then status 0.
//   ax
//   axx
//   0

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn grow(msg: int64, state: string) -> (:reply, string, string) {
    s: string <- concat(state, "x");
    (:reply, s, s)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn("a", grow, stack_policy(0, :keep_last_message));
        r1: string <- call(a, 1 impl ActorMessage {});
        r2: string <- call(a, 1 impl ActorMessage {});
        println(r1);
        println(r2)
    produces
        pure 0
    end
}
