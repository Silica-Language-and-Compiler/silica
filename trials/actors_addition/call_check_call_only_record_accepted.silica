// Spec §16.1.2 (2026-10-13), accepting side of call_check_* (E2238) and cast_check_record_field: a reference
// read from a record field is tracked, and here it names a call-only actor, so the call compiles.
// plain replies its state plus 41, so main prints 41.
// Records here reuse the field names op, name, pid (the suite's first record shape) so that adding
// this trial does not renumber the shapes of the trials compiled after it.
// Expected output:
//   41
//   0

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state + 41, state + 1)
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        bx: { op: int64, name: string, pid: actor_ref } <- { op: 1, name: "plain", pid: p };
        pr: actor_ref <- bx.pid;
        v: int64 <- call(pr, "x" impl ActorMessage {});
        _: atom <- print_int64(v);
        _: atom <- println("");
        _: boolean <- cast_exit(0);
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
