// Chunk 15 phase 2 (S5, heap evacuation of behaviour state): the new state is a record built in the
// behaviour's frame, with a label made by concat. After the call the record (and its string) are
// evacuated to the heap shell the actor keeps. Initial state { 0, "ab" }; every call appends "!" and
// replies count * 100 + length of the label: 1 * 100 + 3, 2 * 100 + 4, 3 * 100 + 5.
// Expected: 103, 204, 305, then status 0.
//   103
//   204
//   305
//   0

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn step(msg: int64, state: { count: int64, label: string }) -> (:reply, int64, { count: int64, label: string }) {
    l: string <- concat(state.label, "!");
    next: { count: int64, label: string } <- { count: state.count + 1, label: l };
    (:reply, next.count * 100 + length_bytes(next.label), next)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        init: { count: int64, label: string } <- { count: 0, label: "ab" };
        a: actor_ref <- spawn(init, step, stack_policy(0, :keep_last_message));
        x1: int64 <- call(a, 1 impl ActorMessage {});
        x2: int64 <- call(a, 1 impl ActorMessage {});
        x3: int64 <- call(a, 1 impl ActorMessage {});
        print_int64(x1);
        println("");
        print_int64(x2);
        println("");
        print_int64(x3);
        println("")
    produces
        pure 0
    end
}
