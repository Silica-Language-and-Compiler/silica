// The :reply form of the same defect: a uint8 message to a call behaviour must survive a user
// call and a print before it is used. §16.1.1 call.

use trial_support_int64;

fn twice(n: int64) -> int64 {
    n + n
}

fn echo(v: uint8, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        n: int64 <- twice(state);
        _: atom <- print_string("uint8 got ");
        _: atom <- print_uint8(v);
        println("")
    produces
        pure (:reply, n, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(21, echo, stack_policy(0, :keep_last_message));
                m: uint8 <- 9;
                r: int64 <- call(w, m impl ActorMessage {});
                _: atom <- print_string("reply ");
                _: atom <- print_int64(r);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
