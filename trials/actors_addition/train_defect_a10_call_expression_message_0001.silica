// defect A10: a call whose message argument is itself a call expression; the reply must be "A B"
use trial_support_atom;

fn one(s: string) -> string {
    s
}

fn echo(msg: string, state: int64) -> (:reply, string, int64) {
    (:reply, msg, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, echo, stack_policy(0, :keep_last_message));
                r: string <- call(w, one("A B") impl ActorMessage {});
                println(r)
            produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
