// Spec §15.1.4 / §16.1.2: a reference to an actor that has ended never equals a reference to a live
// actor, and sending to it raises actor_not_found. A prober holding a reference to an ended actor
// casts to it: the cast raises actor_not_found in the prober, which fails with
// (:explicit, :actor_not_found) (reason_tag 4). Spec §16.1.1: a relay actor is blocked in a call to
// the prober when the prober ends, so the call raises actor_not_found in the relay, which fails the
// same way (reason_tag 4). main only casts to the relay, so main itself never calls an actor that
// ends mid-call. A fresh actor gets a new identity (<0.5>), never the ended actor's (<0.1>).
// Finally main casts to the ended actor: main has no supervisor, so it prints actor_not_found and
// the process exits with status 1.
// main waits for the three failure reports once, in wait_for_exit(), which the reporter ends with
// cast_exit(0) on the third report (no polling: every call reply stays on the heap while main runs).
//
// Expected output (compared as a multiset: reports and the root-exit note are asynchronous):
//   failure report: other          a ends through remove_actor (failure_reason :normal)
//   [silica] root actor exited (no supervisor)    a had no supervisor
//   failure report: reason_tag 4   the prober's cast to the ended a raises actor_not_found
//   failure report: reason_tag 4   the relay's call to the prober raises actor_not_found (§16.1.1)
//   a <0.1>                        (child numbering: reporter 0, a 1, w 2, prober 3, relay 4)
//   b <0.5>                        (child numbering: a new identity, never a's)
//   false                          a == b
//   8                              call(w, 1) on state 7: the live actor is unaffected
//   main casts to the ended actor
//   actor_not_found                main's cast raises; exit status 1
//
// Position numbering: only position 0 (main, fixed by the spec) appears; the global position
// counter does not affect this trial. The a and b lines depend on main's child numbers in spawn order.

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn prober(msg: int64, state: actor_ref) -> (:reply, int64, actor_ref) {
    sequence proc[concurrency]
        _: boolean <- cast(state, msg impl ActorMessage {})
    produces
        pure (:reply, 1, state)
    end
}

// The relay calls the prober with its message; the prober ends before replying, so the call raises
// actor_not_found here (§16.1.1) and the relay fails with reason_tag 4.
fn relay(msg: int64, state: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        _: int64 <- call(state, msg impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- start_reporter(3);
        a: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        w: actor_ref <- spawn(7, worker, stack_policy(0, :keep_last_message));
        _: atom <- remove_actor(a);
        p: actor_ref <- spawn(a, prober, stack_policy(0, :keep_last_message));
        q: actor_ref <- spawn(p, relay, stack_policy(0, :keep_last_message));
        _: boolean <- cast(q, 3 impl ActorMessage {});
        _: int64 <- wait_for_exit();
        b: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        _: int64 <- print_id("a", a);
        _: int64 <- print_id("b", b);
        print_boolean(a == b);
        println("");
        print_int64(call(w, 1 impl ActorMessage {}));
        println("");
        println("main casts to the ended actor");
        _: boolean <- cast(a, 1 impl ActorMessage {});
        println("not reached");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

fn print_id(label: string, r: actor_ref) -> int64 {
    sequence proc[concurrency, device_io]
        i: uint64 <- actor_id(r);
        print(label);
        print(" <");
        print_uint64(i shr 32);
        print(".");
        print_uint64(i band 4294967295);
        println(">")
    produces
        pure 0
    end
}

fn region_dump_limit() -> int64 {
    0
}

// The failure reporter prints one line per report. A FailureReporter is cast-only (spec §15.4.13.4),
// so main cannot ask it how many reports it has had. Instead its state counts down from the number of
// reports main waits for (start_reporter's argument), and the last of them ends main's single
// wait_for_exit() with cast_exit(0) (spec §15.1.2.5). main waits once and polls nothing, so no call
// reply piles up on the heap while main runs. The line is printed before the cast_exit, so no report
// line lands inside a line main prints.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print(report_kind(report));
        left: int64 <- state - 1;
        _: boolean <- case left == 0 of {
            true -> cast_exit(0);
            false -> true
        }
    produces
        pure (:no_reply, left)
    end
}

fn report_kind(report: string) -> string {
    case contains(report, "reason_tag:      4") of {
        true -> "failure report: reason_tag 4\n";
        false -> "failure report: other\n"
    }
}

// The registry-polling version of this trial named these atoms here (and, in supervisors_addition,
// built the registry's { op, name, pid } message); atoms and record shapes are numbered per suite in
// first-use order, so this never-called function keeps them at the same place in the suite's tables
// and no later trial's numbering moves.
fn table_places(n: int64) -> atom {
    case n of {
        1 -> :first;
        2 -> :second;
        _: int64 -> :done
    }
}

fn start_reporter(expected: int64) -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(expected, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
