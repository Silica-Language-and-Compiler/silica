// Behavior invokes a separate recursive int64 helper (non-tail factorial).
// §15.1.2: (:reply, Reply, State); §16.1.1: call(actor_ref, message) -> Reply.

use trial_support_atom;

fn factorial(n: int64) -> int64 {
    case n <= 1 of {
        true -> 1;
        false -> n * factorial(n - 1)
    }
}

fn compute(msg: int64, state: int64) -> (:reply, int64, int64) {
    reply: int64 <- factorial(msg);
    (:reply, reply, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                worker: actor_ref <- spawn(0, compute, stack_policy(0, :keep_last_message));
                result: int64 <- call(worker, 10 impl ActorMessage {});
                print_int64(result);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
