// Spec §16.1.3: repeated call() to the same actor preserves FIFO order
use trial_support_atom;

fn step(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(0, step, stack_policy(0, :keep_last_message));
                v0: int64 <- call(w, 4 impl ActorMessage {});
                v1: int64 <- call(w, 4 impl ActorMessage {});
                v2: int64 <- call(w, 4 impl ActorMessage {});
                print_int64(v2);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
