// Boolean ActorState; reply echoes state without mutation (edge: non-numeric state).

use trial_support_atom;

fn id(msg: int64, state: boolean) -> (:reply, boolean, boolean) {
    (:reply, state, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                w: actor_ref <- spawn(false, id, stack_policy(0, :keep_last_message));
                r: boolean <- call(w, 0 impl ActorMessage {});
                _: atom <- print_boolean(r);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
