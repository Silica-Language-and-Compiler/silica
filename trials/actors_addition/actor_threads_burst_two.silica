// Observational: two cast-only actors each print the same tag many times in one message handler.
// If the runtime maps actors to different worker threads, those write() syscalls can interleave on stdout
// (lines of "A" and "B" mixed). A single global mailbox thread would tend to serialize.
// Each actor prints done after its burst; main waits for command-line exit.
// §15.1.2: (:no_reply, State); §16.1.2: cast.

use trial_wait_int64;

fn burst_a(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("A");
        println("A");
        println("A");
        println("A");
        println("A");
        println("A");
        println("done");
        new_st: int64 <- state + msg
    produces
        pure (:no_reply, new_st)
    end
}

fn burst_b(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("B");
        println("B");
        println("B");
        println("B");
        println("B");
        println("B");
        println("done");
        new_st: int64 <- state + msg
    produces
        pure (:no_reply, new_st)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                a: actor_ref <- spawn(0, burst_a, stack_policy(0, :keep_last_message));
                b: actor_ref <- spawn(0, burst_b, stack_policy(0, :keep_last_message));
                _: boolean <- cast(a, 1 impl ActorMessage {});
                _: boolean <- cast(b, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
