// Spec §15.1.2.3 (Actor Termination): an actor ends itself only with stop_self or fail_self.
// kill_abnormal must not name the calling actor. kill_abnormal(self()) written out is rejected at
// compile time (E2241, error_enforcement_addition/terminate_self_by_kill_abnormal), and kill_abnormal
// may only be called from a behaviour (E2091), so here the target reaches it through the behaviour's
// message parameter: main sends the victim its own reference, which the compiler cannot see, and
// the calling actor fails at run time with failure_reason :language_error (reason_tag 2). Nothing is
// done to it first, and the call it is serving gets the actor-death result, never a reply: main's
// call fails with actor_not_found, which, main not being an actor, is the language-level failure of
// §15.4.5.5: `actor_not_found` on standard error and exit status 1. The victim's report is written
// by the FailureReporter.
//
// Expected output (order checked as a multiset):
//   actor_not_found
//   one failure report: reason_tag 2, frame #0 kill_abnormal_self_language_error_victim
// exit status 1

fn victim(msg: actor_ref, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        _: atom <- kill_abnormal(msg)
    produces
        pure (:reply, state, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        v: actor_ref <- spawn(0, victim, stack_policy(0, :keep_last_message));
        x: int64 <- call(v, v impl ActorMessage {});
        print_int64(x);
        println(" got a reply: wrong")
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
