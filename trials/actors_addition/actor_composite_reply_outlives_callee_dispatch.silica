// Item B (actor_memory_budget_plan.md §3): a composite reply is moved out of the behaviour and is
// owned by the caller. The caller holds the (a, b) reply while the callee serves two more messages,
// which rebuild the callee's frame and reply buffer, and only then reads it. Expected: 3 4, status 0.

use trial_support_int64;

fn pairs(msg: int64, state: int64) -> (:reply, (int64, int64), int64) {
    (:reply, (msg, msg + 1), state + 1)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                p: actor_ref <- spawn(0, pairs, stack_policy(0, :keep_last_message));
                first: (int64, int64) <- call(p, 3 impl ActorMessage {});
                _: (int64, int64) <- call(p, 50 impl ActorMessage {});
                _: (int64, int64) <- call(p, 60 impl ActorMessage {});
                r: int64 <- case first of {
                    (a: int64, b: int64) -> {
                        print_int64(a);
                        println("");
                        print_int64(b);
                        println("");
                        0
                    }
                }
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
