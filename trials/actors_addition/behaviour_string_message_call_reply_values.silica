// A behaviour whose first parameter is a string returns its reply through the actor's reply buffer;
// the caller of call/2 still gets the right value and the actor keeps the right state. echo_len
// takes a string, prints it and replies with its running byte count (starting at 10); avg takes a
// string and replies with its float64 state plus 1.5 (starting at 1.0). Each is called twice.
// Expected output:
//   helloabc
//   15 18 2.5 4.0
//   0

fn region_dump_limit() -> int64 {
    0
}

fn echo_len(msg: string, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        n: int64 <- state + length_bytes(msg);
        _: atom <- print_string(msg)
    produces
        pure (:reply, n, n)
    end
}

fn avg(msg: string, state: float64) -> (:reply, float64, float64) {
    (:reply, state + 1.5, state + 1.5)
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(10, echo_len, stack_policy(0, :keep_last_message));
        x1: int64 <- call(a, "hello" impl ActorMessage {});
        x2: int64 <- call(a, "abc" impl ActorMessage {});
        _: atom <- println("");
        c: actor_ref <- spawn(1.0, avg, stack_policy(0, :keep_last_message));
        z1: float64 <- call(c, "q" impl ActorMessage {});
        z2: float64 <- call(c, "q" impl ActorMessage {});
        _: atom <- print_int64(x1);
        _: atom <- print_string(" ");
        _: atom <- print_int64(x2);
        _: atom <- print_string(" ");
        _: atom <- print_float64(z1);
        _: atom <- print_string(" ");
        _: atom <- print_float64(z2);
        _: atom <- println("")
    produces
        pure 0
    end
}
