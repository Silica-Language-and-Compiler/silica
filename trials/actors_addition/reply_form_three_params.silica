// A function whose parameters fill three or four argument registers and whose result is a reply
// form (:reply, int64, int64) returns it correctly wherever it is used: called directly with its
// result bound to a name, as the whole body of a behaviour, and from a sequence's produces in a
// behaviour; a call-bodied (:no_reply, int64) behaviour calling a 0-parameter helper handles a cast.
//   mk3(1, 2, 3) = (:reply, 3, 3)                          -> 3 * 10 + 3 = 33
//   mk4(1, 2, 3, 4) = (:reply, 6, 4)                       -> 6 * 10 + 4 = 64
//   beh3, state 5: msg 1 -> mk3(1, 5, 6) replies 6, state 6;
//                  msg 2 -> mk3(2, 6, 7) replies 8, state 7 -> 6 * 100 + 8 = 608
//   beh4, state 5: msg 1 -> x 2, mk4(1, 5, 2, 15) replies 8, state 15;
//                  msg 2 -> x 4, mk4(2, 15, 4, 25) replies 21, state 25 -> 8 * 100 + 21 = 821
//   beh0 prints nothing; it is cast to first so it runs while the calls above wait. A fault there
//   would print a failure report.
// Expected output:
//   33
//   64
//   608
//   821
//   0
use trial_support_int64;

fn mk3(a: int64, b: int64, c: int64) -> (:reply, int64, int64) {
    (:reply, a + b, c)
}

fn mk4(a: int64, b: int64, c: int64, d: int64) -> (:reply, int64, int64) {
    (:reply, a + b + c, d)
}

fn nr0() -> (:no_reply, int64) {
    (:no_reply, 77)
}

fn beh3(msg: int64, state: int64) -> (:reply, int64, int64) {
    mk3(msg, state, state + 1)
}

fn beh4(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence
        x: int64 <- msg * 2
    produces
        pure mk4(msg, state, x, state + 10)
    end
}

fn beh0(msg: int64, state: int64) -> (:no_reply, int64) {
    nr0()
}

fn show(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn direct() -> int64 {
    sequence
        t: (:reply, int64, int64) <- mk3(1, 2, 3);
        (_, p, q) <- t;
        _: int64 <- show(p * 10 + q);
        u: (:reply, int64, int64) <- mk4(1, 2, 3, 4);
        (_, p2, q2) <- u;
        _: int64 <- show(p2 * 10 + q2)
    produces
        pure 0
    end
}

fn through_actors() -> int64 {
    sequence proc[concurrency]
        z: actor_ref <- spawn(5, beh0, stack_policy(0, :keep_last_message));
        _: boolean <- cast(z, 1 impl ActorMessage {});
        a: actor_ref <- spawn(5, beh3, stack_policy(0, :keep_last_message));
        a1: int64 <- call(a, 1 impl ActorMessage {});
        a2: int64 <- call(a, 2 impl ActorMessage {});
        _: int64 <- show(a1 * 100 + a2);
        b: actor_ref <- spawn(5, beh4, stack_policy(0, :keep_last_message));
        b1: int64 <- call(b, 1 impl ActorMessage {});
        b2: int64 <- call(b, 2 impl ActorMessage {});
        _: int64 <- show(b1 * 100 + b2)
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                d: int64 <- direct();
                c: int64 <- through_actors()
            produces
                pure d + c
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
