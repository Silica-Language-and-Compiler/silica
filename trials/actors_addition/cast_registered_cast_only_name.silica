// Spec §16.1.2 (2026-10-12): cast_registered to a name is rejected at compile time when every actor
// registered under that name is call-only. This trial is the accepting side: :divider is registered
// for a cast-only actor (another actor in the program is call-only, but not under that name), so
// main's cast_registered compiles and reaches it. The actor prints its message and ends the program.
// :divider is already in this suite's atom table, so no other trial's atoms are renumbered.
// Expected output:
//   7
//   0

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print_int64(msg);
        println("");
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

fn plain(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        _p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        _g: actor_ref <- spawn_registered(0, sink, :divider, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:divider, 7 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
