// Three cast-only actors tagged X/Y/Z; round-robin casts (single println per delivery).
// Stresses three live actor_ref handles plus concurrent mailbox delivery; output order is observational.
// Each actor prints done after a handled message; main waits for command-line exit.
// §16.1.2: cast.

use trial_wait_int64;

fn tag_x(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("X");
        println("done");
        nx: int64 <- state + msg
    produces
        pure (:no_reply, nx)
    end
}

fn tag_y(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("Y");
        println("done");
        ny: int64 <- state + msg
    produces
        pure (:no_reply, ny)
    end
}

fn tag_z(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("Z");
        println("done");
        nz: int64 <- state + msg
    produces
        pure (:no_reply, nz)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                x: actor_ref <- spawn(0, tag_x, stack_policy(0, :keep_last_message));
                y: actor_ref <- spawn(0, tag_y, stack_policy(0, :keep_last_message));
                z: actor_ref <- spawn(0, tag_z, stack_policy(0, :keep_last_message));
                _: boolean <- cast(x, 1 impl ActorMessage {});
                _: boolean <- cast(y, 1 impl ActorMessage {});
                _: boolean <- cast(z, 1 impl ActorMessage {});
                _: boolean <- cast(x, 1 impl ActorMessage {});
                _: boolean <- cast(y, 1 impl ActorMessage {});
                _: boolean <- cast(z, 1 impl ActorMessage {});
                _: boolean <- cast(x, 1 impl ActorMessage {});
                _: boolean <- cast(y, 1 impl ActorMessage {});
                _: boolean <- cast(z, 1 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
