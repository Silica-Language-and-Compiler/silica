// The smallest program whose first actor operations from main are spawn_registered and then
// cast_registered (docs/examples/idle_actor_capacity/main.silica's main, without its spawner's
// work): the FailureReporter that spec §15.4.13.4 requires before any spawn (E2236), one registered
// actor, one cast to it by name, wait_for_exit. Nothing else is started first, so the injected
// silica_pid_registry_init, the registered spawn's carrier adoption (the first carrier thread) and
// the cast's enqueue all run from main's own frame, on the platform stack (SysV: rsp 16-byte aligned
// at every call). The actor prints its message and ends the program with cast_exit(0).
// :divider is already in this suite's atom table, so no other trial's atoms are renumbered.
// Expected output:
//   7
//   0

fn spawner(msg: int64, total: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print_int64(total + msg);
        println("");
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, total + msg)
    end
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        _: actor_ref <- spawn_registered(0, spawner, :divider, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:divider, 7 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
