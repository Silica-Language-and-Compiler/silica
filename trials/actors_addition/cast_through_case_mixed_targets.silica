// Spec §16.1.2 (2026-10-12): the compile-time check rejects a cast only when its target is provably
// call-only. A case whose arms give a call-only actor and a cast-only actor is not, so the cast below
// compiles. At run time the case picks the cast-only actor (a cast to a call-only actor is never
// sent by a trial), which prints its message and ends the program.
// Expected output:
//   mixed
//   0

fn sink(msg: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        println(msg);
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

fn plain(msg: string, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state + 1)
}

fn pick(flag: boolean, a: actor_ref, b: actor_ref) -> actor_ref {
    case flag of {
        true -> a;
        false -> b
    }
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rr: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(rr);
        p: actor_ref <- spawn(0, plain, stack_policy(0, :keep_last_message));
        n: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        _: boolean <- cast(pick(false, p, n), "mixed" impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
