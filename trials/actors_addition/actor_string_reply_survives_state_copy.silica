// Chunk 15 phase 3 (stage 3d, string replies): a behaviour replies a bare string that IS its own
// state (the old state node, not a copy) and builds a fresh state. The reply must be copied into the
// caller's arena in the behaviour epilogue, so the caller's string survives the actor's later
// dispatches, each of which copies (compacts) the state over the old area. The caller holds the
// second reply across twelve more calls, then prints it. Expected: ax, then status 0.
//   ax
//   0

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn grow(msg: int64, state: string) -> (:reply, string, string) {
    (:reply, state, concat(state, "x"))
}

fn pump(a: actor_ref, n: int64) -> int64 {
    sequence proc[concurrency]
        _: string <- call(a, 1 impl ActorMessage {});
        rest: int64 <- case n <= 1 of {
            true -> 0;
            false -> pump(a, n - 1)
        }
    produces
        pure rest
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn("a", grow, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        r1: string <- call(a, 1 impl ActorMessage {});
        r2: string <- call(a, 1 impl ActorMessage {});
        _p: int64 <- pump(a, 12);
        println(r2)
    produces
        pure 0
    end
}
