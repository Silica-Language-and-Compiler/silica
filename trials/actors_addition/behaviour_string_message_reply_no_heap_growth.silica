// A behaviour whose first parameter is a string builds its result tuple in the actor's reply
// buffer, so handling a message leaves nothing on the heap. The counter below takes a string
// message, ends in a sequence producing (:no_reply, state) and casts itself the next message
// through a helper. It reads heap_used() on every message through the same helper and keeps the
// reading from message 100; at message 1100 it prints how far the heap grew over the thousand
// messages between and ends the program. Before the fix each message left its result tuple behind
// (96,000 bytes over the thousand on the Mac). The state is one int64 holding both numbers,
// messages handled + 4096 * heap_used() at message 100 (a tuple state is a separate cost this trial
// does not measure).
// Expected output:
//   0
//   0

fn region_dump_limit() -> int64 {
    0
}

fn send_next(me: actor_ref) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(me, "x" impl ActorMessage {})
    produces
        pure sent
    end
}

fn finish(growth: int64) -> boolean {
    sequence proc[concurrency, device_io]
        _: atom <- print_int64(growth);
        _: atom <- println("");
        ended: boolean <- cast_exit(0)
    produces
        pure ended
    end
}

fn read_heap_used() -> int64 {
    sequence proc[mem(normal)]
        used: int64 <- heap_used()
    produces
        pure used
    end
}

// state: messages handled + 4096 * heap_used() at message 100
fn count_str(msg: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        base_then: int64 <- state / 4096;
        n: int64 <- state - 4096 * base_then + length_bytes(msg);
        used: int64 <- read_heap_used();
        base: int64 <- case n == 100 of {
            true -> used;
            false -> base_then
        };
        me: actor_ref <- self();
        _: boolean <- case n == 1100 of {
            true -> finish(used - base);
            false -> send_next(me)
        }
    produces
        pure (:no_reply, n + 4096 * base)
    end
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(0, count_str, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, "x" impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
