// Chunk 15 phase 2 (S5, heap evacuation of behaviour state): the new state is a list prepended in the
// behaviour's frame. The cons blocks are frame nodes and are evacuated to the heap with the state.
// Messages 7, 8, 9 cons onto the list; the reply is length * 100 + head: 107, 208, 309.
// Expected: 107, 208, 309, then status 0.
//   107
//   208
//   309
//   0

fn region_dump_limit() -> int64 {
    0
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn nil_int() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure r
    end
}

fn push(msg: int64, state: List[int64, mem(normal)]) -> (:reply, int64, List[int64, mem(normal)]) {
    sequence proc[mem(normal)]
        l: List[int64, mem(normal)] <- prepend[int64, mem(normal)](msg, state);
        n: int64 <- length[int64, mem(normal)](l);
        h: int64 <- l.head
    produces
        pure (:reply, n * 100 + h, l)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(nil_int(), push, stack_policy(0, :keep_last_message));
        x1: int64 <- call(a, 7 impl ActorMessage {});
        x2: int64 <- call(a, 8 impl ActorMessage {});
        x3: int64 <- call(a, 9 impl ActorMessage {});
        print_int64(x1);
        println("");
        print_int64(x2);
        println("");
        print_int64(x3);
        println("")
    produces
        pure 0
    end
}
