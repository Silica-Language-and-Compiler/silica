// Spec §16.2.6.4 (run-time check where the convention is unknown), sender is an actor: main gets a
// cast-only sink back as a call reply from directory and spawns driver with that reference as its
// state, so the reference reaches driver through a flow the compiler does not follow. main then
// casts driver's own reference to the sink (a cast to a cast-only actor: the run-time check passes);
// the sink prints 1 + 5 = 6 and casts 2 to driver. driver calls its state, the cast-only sink: the
// runtime finds the mismatch, enqueues nothing and fails driver with failure_reason :language_error
// (reason_tag 2). The reporter writes driver's report and ends the program with status 0. The
// sink line is printed before driver runs, so "not reached" and a second sink line never appear.
//
// Expected output (the report is printed by the FailureReporter; order checked as a multiset):
//   6 sink
//   one failure report: reason_tag 2, frame #0 conv_actor_call_to_cast_only_driver
// exit status 0

// Prints its state plus one, then casts 2 to the actor named in the message.
fn sink(msg: actor_ref, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print_int64(state + 1);
        println(" sink");
        _: boolean <- cast(msg, 2 impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

// Hands back the reference it holds: a call reply, which the compiler does not follow.
fn directory(msg: int64, state: actor_ref) -> (:reply, actor_ref, actor_ref) {
    (:reply, state, state)
}

// state is the sink, from directory's call reply. The call is the mismatch.
fn driver(msg: int64, state: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency, device_io]
        v: int64 <- call(state, msg impl ActorMessage {});
        println("driver: not reached")
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        k: actor_ref <- spawn(5, sink, stack_policy(0, :keep_last_message));
        d: actor_ref <- spawn(k, directory, stack_policy(0, :keep_last_message));
        r: actor_ref <- call(d, 0 impl ActorMessage {});
        dr: actor_ref <- spawn(r, driver, stack_policy(0, :keep_last_message));
        _: boolean <- cast(r, dr impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// The program expects exactly one failure report. The reporter writes it to stderr and then ends
// the program with status 0, so the exit comes only after the report is out.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
