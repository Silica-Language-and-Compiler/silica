// String message and string reply through call
use trial_support_atom;

fn echo(msg: string, state: int64) -> (:reply, string, int64) {
    (:reply, concatenate("echo: ", msg), state + 1)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[concurrency, device_io]
                e: actor_ref <- spawn(0, echo, stack_policy(0, :keep_last_message));
                r: string <- call(e, "cherry" impl ActorMessage {});
                print_string(r);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
