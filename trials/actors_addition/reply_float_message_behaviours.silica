// Behaviours whose message is a float64, float32 or float16 (or whose state is a float64) read the
// message and state from the right registers when they print them and when they hand them to a
// reply-form helper on the reply spine, and the caller of call/2 gets the right reply.
//   a  b64, state 4, msg 2.5 twice: 2.5 > 1.0, so f64b(state + 1, msg): prints "f64b x=2.5",
//      replies (state + 1) * 10, state becomes state + 1: replies 50, then 60
//   b  b32, state 10, msg 0.25: prints "b32 msg=0.25", replies 10 + 5 = 15
//   c  bst (float64 state), state 1.25, msg 7 then 8: prints "bst state=1.25", replies 8, state
//      1.75; prints "bst state=1.75", replies 9
//   d  bcb (call-bodied), state 1, msg 6.75: f64a(6.75, 101): prints "f64a x=6.75", replies 101
//   e  b16, state 3, msg 0.5: prints "b16 msg=0.5", replies 3
// Expected output:
//   f64b x=2.5
//   f64b x=2.5
//   50 60
//   b32 msg=0.25
//   15
//   bst state=1.25
//   bst state=1.75
//   8 9
//   f64a x=6.75
//   101
//   b16 msg=0.5
//   3
//   0 (exit status)
use trial_support_int64;

fn f64a(x: float64, n: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("f64a x=");
        _: atom <- print_float64(x);
        println("")
    produces
        pure (:reply, n, n + 1)
    end
}

fn f64b(n: int64, x: float64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("f64b x=");
        _: atom <- print_float64(x);
        println("")
    produces
        pure (:reply, n * 10, n)
    end
}

fn b64(msg: float64, state: int64) -> (:reply, int64, int64) {
    case msg > 1.0 of {
        true -> f64b(state + 1, msg);
        false -> (:reply, 0 - 1, state)
    }
}

fn b32(msg: float32, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("b32 msg=");
        _: atom <- print_float32(msg);
        println("")
    produces
        pure (:reply, state + 5, state + 1)
    end
}

fn bst(msg: int64, state: float64) -> (:reply, int64, float64) {
    sequence proc[device_io]
        _: atom <- print_string("bst state=");
        _: atom <- print_float64(state);
        println("")
    produces
        pure (:reply, msg + 1, state + 0.5)
    end
}

fn bcb(msg: float64, state: int64) -> (:reply, int64, int64) {
    f64a(msg, state + 100)
}

fn b16(msg: float16, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        _: atom <- print_string("b16 msg=");
        _: atom <- print_float16(msg);
        println("")
    produces
        pure (:reply, state, state + 1)
    end
}

fn checks() -> int64 {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(4, b64, stack_policy(0, :keep_last_message));
        m1: float64 <- 2.5;
        r1: int64 <- call(a, m1 impl ActorMessage {});
        r2: int64 <- call(a, m1 impl ActorMessage {});
        _: atom <- print_int64(r1);
        _: atom <- print_string(" ");
        _: atom <- print_int64(r2);
        _: atom <- println("");
        b: actor_ref <- spawn(10, b32, stack_policy(0, :keep_last_message));
        m2: float32 <- 0.25;
        r3: int64 <- call(b, m2 impl ActorMessage {});
        _: atom <- print_int64(r3);
        _: atom <- println("");
        s0: float64 <- 1.25;
        c: actor_ref <- spawn(s0, bst, stack_policy(0, :keep_last_message));
        r4: int64 <- call(c, 7 impl ActorMessage {});
        r5: int64 <- call(c, 8 impl ActorMessage {});
        _: atom <- print_int64(r4);
        _: atom <- print_string(" ");
        _: atom <- print_int64(r5);
        _: atom <- println("");
        d: actor_ref <- spawn(1, bcb, stack_policy(0, :keep_last_message));
        m4: float64 <- 6.75;
        r6: int64 <- call(d, m4 impl ActorMessage {});
        _: atom <- print_int64(r6);
        _: atom <- println("");
        e: actor_ref <- spawn(3, b16, stack_policy(0, :keep_last_message));
        m5: float16 <- 0.5;
        r7: int64 <- call(e, m5 impl ActorMessage {});
        _: atom <- print_int64(r7);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                r: int64 <- checks()
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
