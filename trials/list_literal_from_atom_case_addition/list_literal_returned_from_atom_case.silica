// A function whose body is a case over an atom, each arm a list literal, returns a List[uint32] to its
// caller. On the boards the copier that moves the list out of the callee's frame region walked a list's
// chunks with CDATA = 2 * slot bytes, but a chunk's data is max(16, slot bytes) (prims_list
// chunk_data_bytes; the hosted runtimes had it right): for a 4-byte element it read the next-chunk word
// from inside the data and faulted ([silica] fault, addr 0x16, in rt_state.S rt_sm_val; a behaviour that
// bound such a list ended with :memory_fault). Fixed 2026-11-10 in both board runtimes' rt_state.S
// (measure and copy). Found by the board pin-builtin tests (lib/device_pin_sweep pin_set).
// Expected output: 13, 13, status 0.

fn pins(name: atom) -> List[uint32, mem(normal)] {
    case name of {
        :all -> [13, 14, 15];
        _: atom -> [16]
    }
}

fn pins64(name: atom) -> List[int64, mem(normal)] {
    case name of {
        :all -> [13, 14, 15];
        _: atom -> [16]
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        qs: List[int64, mem(normal)] <- pins64(:all);
        _: atom <- print_int64(qs.head);
        println("");
        ps: List[uint32, mem(normal)] <- pins(:all);
        _: atom <- print_uint32(ps.head);
        println("")
    produces
        pure 0
    end
}
