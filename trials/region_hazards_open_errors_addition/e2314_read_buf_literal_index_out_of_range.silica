// expected failure E2314 (BufferIndexOutOfRange; message text provisional: E2314 does not exist yet)
// region_memory_safety_design.md §8 "static: literal index", §10 (E2314, type checker), §13 stage 8,
// §14.1 ("literal index 15 into N = 10"): read_buf(b, 15) on a buf(L1, normal, int64, 10) is rejected,
// because a literal index at or past a literal length can never be in bounds.
// Today (published Mac compiler 999942): accepted; the program compiles and the run-time bounds
// check ends it with "[silica] abort: buffer index out of bounds", status 71.
// See ../region_hazards_open_addition/README.md.
fn fill() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        b: buf(L1, normal, int64, 10) <- alloc_buf(r, 10);
        _: atom <- write_buf(b, 0, 5);
        value: int64 <- read_buf(b, 15)
    produces
        pure value
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- fill();
        print_int64(a);
        println("")
    produces
        pure 0
    end
}
