// expected failure E2313 (BufferLengthMismatch; message text provisional: E2313 does not exist yet)
// region_memory_safety_design.md §8 "static: literal size", §10 (E2313, type checker), §13 stage 8,
// §14.1 ("E2313, E2314: literal size mismatch"): alloc_buf(r, 10) bound to buf(L1, normal, int64, 16)
// is rejected, because the buffer's type promises 16 elements and the allocation makes 10.
// Today (published Mac compiler 999942): accepted; the program compiles, and only the run-time
// length word (10) stops an access at index 10..15. See ../region_hazards_open_addition/README.md.
fn fill() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        b: buf(L1, normal, int64, 16) <- alloc_buf(r, 10);
        _: atom <- write_buf(b, 0, 5);
        value: int64 <- read_buf(b, 0)
    produces
        pure value
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- fill();
        print_int64(a);
        println("")
    produces
        pure 0
    end
}
