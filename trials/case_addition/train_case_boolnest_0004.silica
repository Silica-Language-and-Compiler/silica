// nested boolean cases; (false, false) selects 58
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- false;
            b: boolean <- false;
            case a of {
                true -> case b of {
                    true -> 26;
                    false -> 79
                };
                false -> case b of {
                    true -> 34;
                    false -> 58
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
