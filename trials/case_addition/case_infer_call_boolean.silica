// Case scrutinee is a custom function call returning boolean — type inferred from callee.
use trial_support_int64;

fn is_positive(n: int64) -> boolean {
    n > 0
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case is_positive(7) of {
                true -> 1;
                false -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
