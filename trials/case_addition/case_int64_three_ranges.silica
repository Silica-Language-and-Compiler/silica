// Spec §3.3.3 "Practical Guard Exhaustiveness" Example 1: disjoint ranges cover int64
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 42;
            case n of {
                n: int64 if n < 0 -> -1;
                n: int64 if n >= 0 and n < 100 -> n * 2;
                n: int64 if n >= 100 -> n + 100;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
