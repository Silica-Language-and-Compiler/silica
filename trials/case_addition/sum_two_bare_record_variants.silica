// `{ x: int64 } | { y: int64 }`: two record variants with no atom field at all. The variants differ
// in their field names, so they have different shape words and each arm matches only its own
// variant whatever the arm order. Expected: prints 10, -20, -5, 40; exits 0.

use trial_support_int64;

fn value(s: { x: int64 } | { y: int64 }) -> int64 {
    case s of {
        { x: v } -> v;
        { y: w } -> 0 - w
    }
}

fn value_reversed(s: { x: int64 } | { y: int64 }) -> int64 {
    case s of {
        { y: w } -> 0 - w;
        { x: v } -> 2 * v
    }
}

fn mk_x(v: int64) -> { x: int64 } | { y: int64 } {
    { x: v }
}

fn mk_y(v: int64) -> { x: int64 } | { y: int64 } {
    { y: v }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(value(mk_x(10)));
                println("");
                print_int64(value(mk_y(20)));
                println("");
                print_int64(value_reversed(mk_y(5)));
                println("");
                print_int64(value_reversed(mk_x(20)));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
