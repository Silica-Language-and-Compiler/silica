// Hexadecimal, binary and negative hexadecimal literals as record field sub-patterns (spec §3.3
// record patterns), next to a binding and wildcards.
// Expected, by hand: 5, 100, 200, 0; exits 0.

use trial_support_int64;

fn classify(r: { code: int64, flag: int64 }) -> int64 {
    case r of {
        { code: 0x10, flag: f } -> f + 1;
        { code: 0xFF, flag: 0b11 } -> 100;
        { code: _, flag: -0x1 } -> 200;
        { code: _, flag: _ } -> 0
    }
}
fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(classify({ code: 16, flag: 4 }));
                _: atom <- show(classify({ code: 255, flag: 3 }));
                _: atom <- show(classify({ code: 7, flag: -1 }));
                _: atom <- show(classify({ code: 7, flag: 7 }))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}