// Spec §3.3.3: guard calls a helper after the pattern binds
use trial_support_int64;

fn is_positive(x: int64) -> boolean {
    x > 0
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            y: int64 <- 8;
            case y of {
                z: int64 if is_positive(z) -> z * 2;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
