// Regression: case-branch RHS `-> { ... }` must parse as a real multi-statement body, not stub/dummy.
use trial_support_int64;

fn helper(n: int64) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> {
            x: int64 <- n;
            y: int64 <- x;
            y
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            helper(7)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
