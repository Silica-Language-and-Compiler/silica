// Spec §3.3.3: guarded branches with multi-line block bodies (expression blocks)
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- -4;
            case x of {
                n: int64 if n < 0 -> {
                    y: int64 <- n * -1;
                    step: int64 <- y + 1;
                    step * 2
                }
                n: int64 if n >= 0 -> {
                    z: int64 <- n * 3;
                    z + 7
                }
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
