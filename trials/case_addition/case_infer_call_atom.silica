// Case scrutinee is a custom function call returning atom — type inferred from callee.
use trial_support_int64;

fn kind(n: int64) -> atom {
    case n == 0 of {
        true -> :zero;
        false -> :nonzero
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case kind(2) of {
                :zero -> 0;
                :nonzero -> 1;
                _: atom -> 2
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
