// A sum of two record variants, `{ op: :add, n: int64 } | { op: :neg, n: int64 }` (spec §15.4.8
// SupervisorMessage shape): the leading `op` field of single atom type tells the variants apart. A
// record literal builds the variant whose atom fields it names (`{ op: :neg, n: k }` is the second
// variant, not the first with the same field names). Expected: prints 15, 5; exits 0.

use trial_support_int64;

fn apply(op: { op: :add, n: int64 } | { op: :neg, n: int64 }, x: int64) -> int64 {
    case op of {
        { op: :add, n: k } -> x + k;
        { op: :neg, n: k } -> k - x
    }
}

fn add(k: int64) -> { op: :add, n: int64 } | { op: :neg, n: int64 } {
    { op: :add, n: k }
}

fn neg(k: int64) -> { op: :add, n: int64 } | { op: :neg, n: int64 } {
    { op: :neg, n: k }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(apply(add(10), 5));
                println("");
                print_int64(apply(neg(10), 5));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
