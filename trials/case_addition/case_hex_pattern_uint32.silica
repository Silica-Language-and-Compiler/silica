// Hexadecimal integer literals as case patterns on a uint32 scrutinee, next to a decimal arm
// (spec §3.3 literal_pattern, §6 integer literals). 0xFFFFFFFF and 0x80000000 sit at the width
// boundary and are matched through the literal pool, not a MOV immediate.
// Expected, by hand: 1, 2, 3, 4, 5, 0; exits 0.

use trial_support_int64;

fn classify(v: uint32) -> int64 {
    case v of {
        0x10 -> 1;
        0xFF -> 2;
        0xFFFFFFFF -> 3;
        0x80000000 -> 4;
        4096 -> 5;
        _: uint32 -> 0
    }
}
fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(classify(16));
                _: atom <- show(classify(0xFF));
                _: atom <- show(classify(4294967295));
                _: atom <- show(classify(0x80000000));
                _: atom <- show(classify(0x1000));
                _: atom <- show(classify(17))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}