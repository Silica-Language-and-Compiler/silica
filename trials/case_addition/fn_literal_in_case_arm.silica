// Function literals inside case arms (spec §3.3.6 function literals, §5 case expressions): a literal
// as an arm value of a case bound in a sequence, a literal as a call argument inside an arm of a
// function-level case and of a case bound in a sequence, and a literal as an arm value of a
// function-level case (pick). A literal as an arm value failed to parse (E1000 at its `fn`).
// Expected, by hand: apply(g, 10) with g = fn(x) { x - 1 } prints 9; arm_call(true) =
// apply(fn(x) { x + 100 }, 5) prints 105; r = apply(fn(y) { y * 3 }, 7) prints 21. The exit status is
// apply(pick(true), 1) with pick(true) = fn(x) { x - 1 }: 0.
use trial_support_int64;

fn apply(f: fn(int64) -> int64, x: int64) -> int64 {
    f(x)
}

fn arm_call(flag: boolean) -> int64 {
    case flag of {
        true -> apply(fn(x: int64) -> int64 { x + 100 }, 5);
        false -> 0
    }
}

fn pick(flag: boolean) -> fn(int64) -> int64 {
    case flag of {
        true -> fn(x: int64) -> int64 { x - 1 };
        false -> fn(x: int64) -> int64 { x + 1 }
    }
}

fn work() -> int64 {
    sequence proc[device_io]
        flag: boolean <- true;
        g: fn(int64) -> int64 <- case flag of {
            true -> fn(x: int64) -> int64 { x - 1 };
            false -> fn(x: int64) -> int64 { x }
        };
        _: atom <- print_int64(apply(g, 10));
        _: atom <- print_char(' ');
        _: atom <- print_int64(arm_call(true));
        _: atom <- print_char(' ');
        r: int64 <- case flag of {
            true -> apply(fn(y: int64) -> int64 { y * 3 }, 7);
            false -> 1
        };
        _: atom <- print_int64(r);
        _: atom <- println("")
    produces
        pure apply(pick(true), 1)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            work()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
