// Spec §3.3.3: int64 scrutinee with guards and typed wildcard fallback
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: int64 <- -7;
            case x of {
                n: int64 if n > 0 -> n * 2;
                n: int64 if n < 0 -> negate_int64(n) * 2;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
