// A case over an inline sum `:none | (:found, uint32)` (spec §15.4.11.2) whose tuple arm comes before
// the atom arm. The sum is one word, an atom index or a tuple pointer; until 2026-10-01 the tuple arm
// read the word as a tuple pointer before the atom arm was tried, so `:none` faulted (exit 70) on
// every emitter. The tuple arm now excludes the sum's atom variants first
// (terms/term_case_patterns@emit_sum_atom_variant_guard); arm order is free (§3.5).
// Expected: prints 1, 0; exits 0.

use trial_support_int64;

fn present(r: :none | (:found, uint32)) -> uint32 {
    case r of {
        (:found, i: uint32) -> 1;
        :none -> 0
    }
}

fn found(v: uint32) -> :none | (:found, uint32) {
    (:found, v)
}

fn absent() -> :none | (:found, uint32) {
    :none
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                seven: uint32 <- 7;
                a: atom <- print_uint32(present(found(seven)));
                println("");
                b: atom <- print_uint32(present(absent()));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
