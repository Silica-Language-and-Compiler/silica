// One case whose arms mix decimal, hexadecimal, binary and negative hexadecimal literal patterns
// (spec §3.3 literal_pattern, §6 integer literals); 0xDEADBEEF needs the literal pool.
// Expected, by hand: 1, 2, 3, 4, 5, 0; exits 0.

use trial_support_int64;

fn classify(v: int64) -> int64 {
    case v of {
        10 -> 1;
        0x20 -> 2;
        0b1000000 -> 3;
        -0x1 -> 4;
        0xDEADBEEF -> 5;
        _: int64 -> 0
    }
}
fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(classify(10));
                _: atom <- show(classify(32));
                _: atom <- show(classify(64));
                _: atom <- show(classify(-1));
                _: atom <- show(classify(3735928559));
                _: atom <- show(classify(11))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}