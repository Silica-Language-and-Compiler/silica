// A case over an inline sum with a record variant, `:none | { id: uint32, name: string }`
// (spec §3.4.2 "combinations thereof", §15.4.8 SupervisorMessage), with the record arm before the atom
// arm. The sum is one word, an atom index or a pointer to the boxed record; the record arm excludes
// the sum's atom variants first (terms/term_case_patterns@emit_sum_variant_guards), then reads the
// fields through the pointer. The record literal returned by `tagged` is promoted to the heap in the
// epilogue (emitter_core@sum_variant_record_return_promotes_in_epilogue). Until 2026-10-02 the
// parser rejected a record after `|` (E1069). Expected: prints 7, 3, 0, 0; exits 0.

use trial_support_int64;

fn describe(r: :none | { id: uint32, name: string }) -> int64 {
    case r of {
        { id: i, name: n } -> length_bytes(n);
        :none -> 0
    }
}

fn ident(r: :none | { id: uint32, name: string }) -> uint32 {
    case r of {
        { id: i, name: n } -> i;
        :none -> 0
    }
}

fn tagged(v: uint32) -> :none | { id: uint32, name: string } {
    { id: v, name: "abc" }
}

fn absent() -> :none | { id: uint32, name: string } {
    :none
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                seven: uint32 <- 7;
                a: atom <- print_uint32(ident(tagged(seven)));
                println("");
                print_int64(describe(tagged(seven)));
                println("");
                b: atom <- print_uint32(ident(absent()));
                println("");
                print_int64(describe(absent()));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
