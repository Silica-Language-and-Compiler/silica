// guards partition int64 into three ranges; n = 89 gives 189
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 89;
            case n of {
                n: int64 if n < 30 -> n * 2;
                n: int64 if n >= 30 and n < 66 -> n / 2;
                n: int64 if n >= 66 -> n + 100;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
