// Guards on successive branches; final unguarded pattern covers the remainder (spec §3.3.3)
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            n: uint64 <- 50;
            case n of {
                k: uint64 if k < 10 -> k;
                k: uint64 if k < 100 -> k + 1000;
                m: uint64 -> m + 10000
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure 1050
    end
}
