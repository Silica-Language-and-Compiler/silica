// Mixed: case on custom call returning (atom, int64) — type inferred from callee.
use trial_support_int64;

fn tagged(n: int64) -> (atom, int64) {
    (:ok, n)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case tagged(9) of {
                t: (atom, int64) -> {
                    (_tag: atom, c: int64) <- t;
                    c
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
