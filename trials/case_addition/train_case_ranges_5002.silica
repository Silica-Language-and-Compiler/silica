// guards partition int64 into three ranges; n = 34 gives 134
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 34;
            case n of {
                n: int64 if n < 43 -> n + 100;
                n: int64 if n >= 43 and n < 73 -> n - 1;
                n: int64 if n >= 73 -> n - 1;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
