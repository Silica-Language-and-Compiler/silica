// nested boolean cases; (false, true) selects 6
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- false;
            b: boolean <- true;
            case a of {
                true -> case b of {
                    true -> 86;
                    false -> 27
                };
                false -> case b of {
                    true -> 6;
                    false -> 91
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
