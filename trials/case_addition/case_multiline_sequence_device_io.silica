// Spec §3.3.4: each branch is a block; effectful work in sequence proc[device_io] (print requires device_io)
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            mode: string <- "verbose";
            case mode of {
                "verbose" -> {
                    sequence proc[device_io]
                        print_string("verbose");
                        println("");
                        print_int64(1);
                        println("")
                    produces
                        pure :ok
                    end
                }
                "quiet" -> {
                    sequence proc[device_io]
                        print_int64(0);
                        println("")
                    produces
                        pure :ok
                    end
                }
                _: string -> {
                    sequence proc[device_io]
                        print_string("default");
                        println("")
                    produces
                        pure :ok
                    end
                }
            }
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
