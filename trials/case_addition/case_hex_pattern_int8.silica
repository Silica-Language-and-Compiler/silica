// Hexadecimal and binary literals as case patterns on an int8 scrutinee, next to a decimal arm (spec
// §3.3 literal_pattern, §6 integer literals); 0x7F is the top of the width.
// Expected, by hand: 1, 2, 3, 4, 0; exits 0.

use trial_support_int64;

fn classify(v: int8) -> int64 {
    case v of {
        0x7F -> 1;
        0b101 -> 2;
        0x0 -> 3;
        100 -> 4;
        _: int8 -> 0
    }
}
fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(classify(127));
                _: atom <- show(classify(5));
                _: atom <- show(classify(0));
                _: atom <- show(classify(0x64));
                _: atom <- show(classify(1))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}