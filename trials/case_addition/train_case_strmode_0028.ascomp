.text
    ; use trial_support_atom
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o170|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_start@PAGE
    ADD X9, X9, trial_support_atom_start@PAGEOFF
    BLR X9

    ADRP X16, train_case_strmode_0028.__lam0@PAGE
    ADD X16, X16, train_case_strmode_0028.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o220|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_run@PAGE
    ADD X9, X9, trial_support_atom_run@PAGEOFF
    BLR X9

    BL _silica_rt_wait_for_exit

    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

train_case_strmode_0028.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X19, X1
    MOV X3, X19
L_case_o307_br_0:
    STR X3, [SP, #-16]!
    ADRP X4, L_str_1@PAGE
    ADD X4, X4, L_str_1@PAGEOFF
    MOV X0, X3
    MOV X1, X4
    BL L_string_eq_helper
    MOV W12, W0
    LDR X3, [SP], #16
    CMP W12, #0
    B.EQ L_case_o307_br_1
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #5

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #2


    ; effects [device_io]
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi_0@PAGE
    ADD X1, X1, L_pi_0@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #2


    ; effects [device_io]
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    MOV X0, #2




    B L_case_o307_done
L_case_o307_br_1:
    STR X3, [SP, #-16]!
    ADRP X4, L_str_4@PAGE
    ADD X4, X4, L_str_4@PAGEOFF
    MOV X0, X3
    MOV X1, X4
    BL L_string_eq_helper
    MOV W12, W0
    LDR X3, [SP], #16
    CMP W12, #0
    B.EQ L_case_o307_br_2
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi_1@PAGE
    ADD X1, X1, L_pi_1@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #2


    ; effects [device_io]
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    MOV X0, #2


    B L_case_o307_done
L_case_o307_br_2:
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_5@PAGE
    ADD X1, X1, L_str_5@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #7

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #2


    ; effects [device_io]
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    MOV X0, #2


    B L_case_o307_done
L_case_o307_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o307_done
L_case_o307_done:


    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_string_eq_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Leq_anull
    CBZ X20, Leq_neq
    LDR X1, [X19]
    MVN X2, X1
    CMP X2, #1
    B.HI Leq_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    MVN X2, X1
    CMP X2, #1
    B.HI Leq_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Leq_n2_done:
    CMP X22, X24
    B.NE Leq_neq
    CBZ X22, Leq_yes
    MOV X25, X21
    MOV X26, X23
    MOV X27, X22
Leq_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Leq_neq
    SUBS X27, X27, #1
    B.NE Leq_cloop
Leq_yes:
    MOV W0, #1
    B Leq_exit
Leq_anull:
    CBZ X20, Leq_yes
    B Leq_neq
Leq_neq:
    MOV W0, #0
Leq_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Leq_bad:
    BRK #1

