use trial_support_int64;

fn read_via_sequence(r: ref(L, normal, int64)) -> int64 {
    sequence proc[mem(normal)]
        v: int64 <- read_ref(r);
        v
    produces
        pure v
    end
}

fn helper(x: ref?(L, normal, int64)) -> int64 {
    case x of {
        :none -> 0;
        r: ref(L, normal, int64) -> {
            read_via_sequence(r)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            helper(:none)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
