// guards partition int64 into three ranges; n = 9 gives 4
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 9;
            case n of {
                n: int64 if n < 46 -> n / 2;
                n: int64 if n >= 46 and n < 98 -> n;
                n: int64 if n >= 98 -> n;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
