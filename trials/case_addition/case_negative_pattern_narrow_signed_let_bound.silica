// Negative literal patterns (decimal and hexadecimal alike) on int8, int16 and int32 scrutinees whose
// values arrive from let bindings. Open emitter defect (2026-10-02): the let stores the narrow negative
// as a zero-extended word (MOV W1, #-128; MOV X19, X1) while the pattern compare is a full-width CMP
// against the sign-extended literal, so no negative arm matches; a literal argument (classify(-64))
// and `v == -64` both match. Hex patterns fail exactly as decimal ones do.
// Expected, by hand: 1, 2, 3, 4, 5, 6; exits 0.

use trial_support_int64;

fn classify8(v: int8) -> int64 {
    case v of {
        -128 -> 1;
        -0x40 -> 2;
        _: int8 -> 0
    }
}

fn classify16(v: int16) -> int64 {
    case v of {
        -300 -> 3;
        -0x7FFF -> 4;
        _: int16 -> 0
    }
}

fn classify32(v: int32) -> int64 {
    case v of {
        -70000 -> 5;
        -0x7FFFFFFF -> 6;
        _: int32 -> 0
    }
}
fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: int8 <- -128;
            b: int8 <- -64;
            c: int16 <- -300;
            d: int16 <- -32767;
            e: int32 <- -70000;
            f: int32 <- -2147483647;
            sequence
                _: atom <- show(classify8(a));
                _: atom <- show(classify8(b));
                _: atom <- show(classify16(c));
                _: atom <- show(classify16(d));
                _: atom <- show(classify32(e));
                _: atom <- show(classify32(f))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}