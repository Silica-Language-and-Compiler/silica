// Binary integer literals as case patterns on a uint8 scrutinee, next to a decimal arm (spec §3.3
// literal_pattern, §6 integer literals), including both ends of the width: 0b0 and 0b11111111.
// Expected, by hand: 1, 2, 3, 4, 5, 0; exits 0.

use trial_support_int64;

fn classify(v: uint8) -> int64 {
    case v of {
        0b0 -> 1;
        0b101 -> 2;
        0b11111111 -> 3;
        0b10000000 -> 4;
        7 -> 5;
        _: uint8 -> 0
    }
}
fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(classify(0));
                _: atom <- show(classify(5));
                _: atom <- show(classify(0xFF));
                _: atom <- show(classify(128));
                _: atom <- show(classify(0b111));
                _: atom <- show(classify(9))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}