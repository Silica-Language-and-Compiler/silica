// Case scrutinee is a custom function call returning a 3-tuple — type inferred from callee.
use trial_support_int64;

fn triple(n: int64) -> (int64, int64, int64) {
    (n, n + 1, n + 2)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case triple(1) of {
                t: (int64, int64, int64) -> {
                    (a: int64, b: int64, c: int64) <- t;
                    a + b + c
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
