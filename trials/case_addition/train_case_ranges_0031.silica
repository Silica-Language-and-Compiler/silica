// guards partition int64 into three ranges; n = 64 gives 63
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 64;
            case n of {
                n: int64 if n < 17 -> n - 1;
                n: int64 if n >= 17 and n < 42 -> n - 1;
                n: int64 if n >= 42 -> n - 1;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
