// nested boolean cases; (true, false) selects 90
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- true;
            b: boolean <- false;
            case a of {
                true -> case b of {
                    true -> 13;
                    false -> 90
                };
                false -> case b of {
                    true -> 37;
                    false -> 21
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
