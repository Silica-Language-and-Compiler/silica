// The same sum written record first, `{ price: int64, qty: int64 } | :none`, matched with the atom arm
// before the record arm, built by a function, a let and a literal argument. A record-headed sum is a
// sum, not a record, in the register conventions (reg_conventions@record_heads_sum_regcv), so the
// value is one word everywhere. Expected: prints 12, -1, 30, 42; exits 0.

use trial_support_int64;

fn total(o: { price: int64, qty: int64 } | :none) -> int64 {
    case o of {
        :none -> -1;
        { price: p, qty: q } -> p * q
    }
}

fn order(p: int64, q: int64) -> { price: int64, qty: int64 } | :none {
    { price: p, qty: q }
}

fn nothing() -> { price: int64, qty: int64 } | :none {
    :none
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(total(order(3, 4)));
                println("");
                print_int64(total(nothing()));
                println("");
                o: { price: int64, qty: int64 } | :none <- { price: 5, qty: 6 };
                print_int64(total(o));
                println("");
                print_int64(total({ price: 6, qty: 7 }));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
