// guards partition int64 into three ranges; n = 7 gives 0
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 7;
            case n of {
                n: int64 if n < 26 -> 0;
                n: int64 if n >= 26 and n < 114 -> 0;
                n: int64 if n >= 114 -> n * 2;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
