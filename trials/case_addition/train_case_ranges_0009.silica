// guards partition int64 into three ranges; n = 149 gives 148
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 149;
            case n of {
                n: int64 if n < 27 -> n;
                n: int64 if n >= 27 and n < 44 -> n * 2;
                n: int64 if n >= 44 -> n - 1;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
