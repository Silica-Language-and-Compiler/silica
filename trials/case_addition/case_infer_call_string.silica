// Case scrutinee is a custom function call returning string — type inferred from callee.
use trial_support_int64;

fn tag(n: int64) -> string {
    case n > 0 of {
        true -> "pos";
        false -> "non"
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case tag(3) of {
                "pos" -> 1;
                "non" -> 2;
                _: string -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
