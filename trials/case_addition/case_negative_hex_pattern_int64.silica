// Negative hexadecimal and binary literals as case patterns on an int64 scrutinee (spec §3.3
// literal_pattern, §6 integer literals), with int64 extremes written in hexadecimal.
// Expected, by hand: 1, 2, 3, 4, 5, 0; exits 0.

use trial_support_int64;

fn classify(v: int64) -> int64 {
    case v of {
        -0x10 -> 1;
        -0xFF -> 2;
        -0b11 -> 3;
        0x7FFFFFFFFFFFFFFF -> 4;
        -0x80000000 -> 5;
        _: int64 -> 0
    }
}
fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(classify(-16));
                _: atom <- show(classify(-255));
                _: atom <- show(classify(-3));
                _: atom <- show(classify(9223372036854775807));
                _: atom <- show(classify(-2147483648));
                _: atom <- show(classify(16))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}