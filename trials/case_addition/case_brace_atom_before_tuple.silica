use trial_support_int64;

fn cmp_fn(a: int64, b: int64) -> :less | :equal | :greater {
    :equal
}

fn helper(n: int64) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> {
            node: (int64, int64) <- (n, n);
            raw_cmp: :less | :equal | :greater <- cmp_fn(n, n);
            (k: int64, _: int64) <- node;
            case raw_cmp of {
                :equal -> k;
                _: atom -> 0
            }
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            helper(1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
