// A tuple case pattern whose elements are an atom literal and a named binding, `(:ok, n: int64)`
// (spec §3.5 tuple_pattern, §4.1.7 tagged tuples), matches and binds. Until 2026-09-19 the emitter
// (terms/term_case_patterns@emit_tuple_case_elems_check) compared only string-literal elements and
// emitted an unconditional `B fail` for an atom, an integer or a named element, so both tagged arms
// fell through to the wildcard arm (3, 3, 3) and `n` never had a home.
// Expected: 15 (5 + 10 through the bound n), 2, 3, exit 0.

use trial_support_int64;

fn classify(result: (atom, int64)) -> int64 {
    case result of {
        (:ok, n: int64) -> n + 10;
        (:error, _: int64) -> 2;
        _: (atom, int64) -> 3
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                a: int64 <- classify((:ok, 5));
                b: int64 <- classify((:error, 0));
                c: int64 <- classify((:other, 1));
                _: atom <- print_int64(a);
                _: atom <- println("");
                _: atom <- print_int64(b);
                _: atom <- println("");
                _: atom <- print_int64(c);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
