// Case scrutinee is a custom function call returning int32 — type inferred from callee.
use trial_support_int64;

fn bump32(n: int32) -> int32 {
    n + 1
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case bump32(5) of {
                6 -> 1;
                _: int32 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
