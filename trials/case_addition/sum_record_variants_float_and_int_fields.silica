// `{ x: float64, y: float64 } | { n: int64 }`: record variants whose fields are floats and an
// integer; the shape word tells them apart. (Binding a float64 field in a record pattern is an
// open emitter defect, compile_defects_float_record_field_binding_addition, so the float arm uses
// wildcards.) Expected: prints 7, 5; exits 0.

use trial_support_int64;

fn whole(s: { x: float64, y: float64 } | { n: int64 }) -> int64 {
    case s of {
        { x: _, y: _ } -> 7;
        { n: k } -> k
    }
}

fn mk_point(a: float64, b: float64) -> { x: float64, y: float64 } | { n: int64 } {
    { x: a, y: b }
}

fn mk_n(k: int64) -> { x: float64, y: float64 } | { n: int64 } {
    { n: k }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(whole(mk_point(3.5, 3.25)));
                println("");
                print_int64(whole(mk_n(5)));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
