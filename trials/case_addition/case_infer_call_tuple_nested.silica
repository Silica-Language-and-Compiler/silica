// Case scrutinee is a custom function call returning a nested tuple — type inferred from callee.
use trial_support_int64;

fn nested(n: int64) -> (int64, (int64, int64)) {
    (n, (n + 1, n + 2))
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case nested(5) of {
                t: (int64, (int64, int64)) -> {
                    (a: int64, inner: (int64, int64)) <- t;
                    (b: int64, c: int64) <- inner;
                    a + b + c
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
