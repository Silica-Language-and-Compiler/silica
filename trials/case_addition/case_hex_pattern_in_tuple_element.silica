// Hexadecimal, binary and negative hexadecimal literals as tuple pattern elements (spec §3.5
// tuple_pattern), next to a binding and wildcards.
// Expected, by hand: 5, 100, 200, 0; exits 0.

use trial_support_int64;

fn classify(p: (int64, int64)) -> int64 {
    case p of {
        (0x10, n: int64) -> n + 1;
        (0xFF, 0b11) -> 100;
        (_: int64, -0x1) -> 200;
        _: (int64, int64) -> 0
    }
}
fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(classify((16, 4)));
                _: atom <- show(classify((255, 3)));
                _: atom <- show(classify((7, -1)));
                _: atom <- show(classify((7, 7)))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}