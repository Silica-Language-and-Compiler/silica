// guards partition int64 into three ranges; n = 140 gives 0
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 140;
            case n of {
                n: int64 if n < 64 -> n + 100;
                n: int64 if n >= 64 and n < 67 -> n;
                n: int64 if n >= 67 -> 0;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
