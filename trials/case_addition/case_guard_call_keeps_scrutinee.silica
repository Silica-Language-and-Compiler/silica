// A case whose arms bind the scrutinee and test it in a guard that calls a function: the scrutinee is
// parked in the arm's frame slot before the guard, and the guard's call is free to reuse the
// scrutinee register (X3 here, the callee's own case scrutinee). When the guard fails, the next arm
// must not store that clobbered register over the slot. The emitters reloaded nothing on a failed
// guard, so the second arm saw the callee's value instead of n: the STM32-L476RG_raw board pack's
// window_containing_from recursed forever for every window but the first, and the cross compiler
// ran out of memory on map_device((:stm32l4_gpioa), 0x48000000) (2026-11-10).
// Expected output: 100, then 7, status 0.

fn limit(k: int64) -> int64 {
    case k of {
        1 -> 10;
        _: int64 -> case k < 5 of {
            true -> 3;
            false -> 4
        }
    }
}

fn first_over(i: int64) -> int64 {
    case i of {
        n: int64 if n >= limit(0) -> n + 7;
        n: int64 if n == 2 -> 100;
        n: int64 -> first_over(n + 1)
    }
}

fn after_two(i: int64) -> int64 {
    case i of {
        n: int64 if n == limit(0) -> n + 4;
        n: int64 -> after_two(n + 1)
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- first_over(0);
        _: atom <- print_int64(a);
        println("");
        b: int64 <- after_two(0);
        _: atom <- print_int64(b);
        println("")
    produces
        pure 0
    end
}
