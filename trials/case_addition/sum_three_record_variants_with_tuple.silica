// `:none | { a: uint32 } | { b: string } | (:pair, int64, int64)`: an atom, two records with
// different field types, and a tagged tuple in one sum. The atom is excluded first, the tuple is
// told by its tag and each record by its shape word. Expected: prints 7, 3, 12, 0; exits 0.

use trial_support_int64;

fn measure(s: :none | { a: uint32 } | { b: string } | (:pair, int64, int64)) -> int64 {
    case s of {
        { a: n } -> 7;
        { b: t } -> length_bytes(t);
        (:pair, p: int64, q: int64) -> p * q;
        :none -> 0
    }
}

fn mk_a(n: uint32) -> :none | { a: uint32 } | { b: string } | (:pair, int64, int64) {
    { a: n }
}

fn mk_b(t: string) -> :none | { a: uint32 } | { b: string } | (:pair, int64, int64) {
    { b: t }
}

fn mk_pair(p: int64, q: int64) -> :none | { a: uint32 } | { b: string } | (:pair, int64, int64) {
    (:pair, p, q)
}

fn mk_none() -> :none | { a: uint32 } | { b: string } | (:pair, int64, int64) {
    :none
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(measure(mk_a(9)));
                println("");
                print_int64(measure(mk_b("abc")));
                println("");
                print_int64(measure(mk_pair(3, 4)));
                println("");
                print_int64(measure(mk_none()));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
