// guards partition int64 into three ranges; n = 85 gives 170
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 85;
            case n of {
                n: int64 if n < 32 -> n * 2;
                n: int64 if n >= 32 and n < 117 -> n * 2;
                n: int64 if n >= 117 -> n;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
