// guards partition int64 into three ranges; n = 22 gives 0
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 22;
            case n of {
                n: int64 if n < 20 -> n - 1;
                n: int64 if n >= 20 and n < 45 -> 0;
                n: int64 if n >= 45 -> n;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
