// guards partition int64 into three ranges; n = 16 gives 32
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 16;
            case n of {
                n: int64 if n < 17 -> n * 2;
                n: int64 if n >= 17 and n < 33 -> n + 100;
                n: int64 if n >= 33 -> n;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
