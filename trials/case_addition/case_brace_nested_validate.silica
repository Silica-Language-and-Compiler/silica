use trial_support_int64;

fn cmp_fn(a: int64, b: int64) -> :less | :equal | :greater {
    :equal
}

fn helper(n: int64) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> {
            node: int64 <- n;
            raw: :less | :equal | :greater <- cmp_fn(n, node);
            case raw of {
                :equal -> 1;
                _: atom -> 0
            }
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            helper(1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
