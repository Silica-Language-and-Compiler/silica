// A sum with two tuple variants and two atom variants, `:ok | (:found, int64) | :not_found | (:lookup, int64, int64)`,
// matched with both tuple arms before both atom arms. The atoms here are ordinary table atoms (not the
// :none word 0), so the tuple arms must exclude every atom variant of the sum, not only zero.
// Expected: prints 5, 30, -1, -2; exits 0.

use trial_support_int64;

fn weight(v: :ok | (:found, int64) | :not_found | (:lookup, int64, int64)) -> int64 {
    case v of {
        (:found, a: int64) -> a;
        (:lookup, a: int64, b: int64) -> a * b;
        :ok -> -1;
        :not_found -> -2
    }
}

fn found(a: int64) -> :ok | (:found, int64) | :not_found | (:lookup, int64, int64) {
    (:found, a)
}

fn lookup(a: int64, b: int64) -> :ok | (:found, int64) | :not_found | (:lookup, int64, int64) {
    (:lookup, a, b)
}

fn ok_v() -> :ok | (:found, int64) | :not_found | (:lookup, int64, int64) {
    :ok
}

fn not_found_v() -> :ok | (:found, int64) | :not_found | (:lookup, int64, int64) {
    :not_found
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(weight(found(5)));
                println("");
                print_int64(weight(lookup(5, 6)));
                println("");
                print_int64(weight(ok_v()));
                println("");
                print_int64(weight(not_found_v()));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
