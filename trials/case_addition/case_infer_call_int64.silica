// Case scrutinee is a custom function call returning int64 — type inferred from callee.
use trial_support_int64;

fn add_ten(n: int64) -> int64 {
    n + 10
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case add_ten(5) of {
                15 -> 1;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
