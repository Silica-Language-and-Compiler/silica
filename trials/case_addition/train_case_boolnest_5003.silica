// nested boolean cases; (true, false) selects 63
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: boolean <- true;
            b: boolean <- false;
            case a of {
                true -> case b of {
                    true -> 95;
                    false -> 63
                };
                false -> case b of {
                    true -> 1;
                    false -> 86
                }
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
