// Case scrutinee is a custom function call returning a record — type inferred from callee.
use trial_support_int64;

fn point(xv: int64, yv: int64) -> { x: int64, y: int64 } {
    { x: xv, y: yv }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case point(3, 4) of {
                _: { x: int64, y: int64 } -> 7
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
