// guards partition int64 into three ranges; n = 30 gives 15
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 30;
            case n of {
                n: int64 if n < 6 -> n + 100;
                n: int64 if n >= 6 and n < 76 -> n / 2;
                n: int64 if n >= 76 -> 0;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
