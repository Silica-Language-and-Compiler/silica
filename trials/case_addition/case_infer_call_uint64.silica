// Case scrutinee is a custom function call returning uint64 — type inferred from callee.
use trial_support_int64;

fn next_u64(n: uint64) -> uint64 {
    n + 1
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case next_u64(9) of {
                10 -> 1;
                _: uint64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
