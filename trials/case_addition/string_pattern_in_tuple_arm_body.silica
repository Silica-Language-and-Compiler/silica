// A string case pattern inside the body of a tuple-pattern arm. L_string_eq_helper is emitted when a
// module has any string case pattern; atoms/string_rodata@term_has_string_case_pattern used to stop at
// a record or tuple branch whose own pattern text held no quoted string, so this module did not link
// ("L_string_eq_helper undefined"). Fixed 2026-09-19 together with the tuple pattern emitter.
// Expected, by hand: 6, 5, 0.

use trial_support_int64;

fn pick(p: (atom, int64), s: string) -> int64 {
    case p of {
        (:ok, n: int64) -> case s of {
            "yes" -> n + 1;
            _: string -> n
        };
        _: (atom, int64) -> 0
    }
}

fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(pick((:ok, 5), "yes"));
                _: atom <- show(pick((:ok, 5), "no"));
                _: atom <- show(pick((:error, 5), "yes"))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
