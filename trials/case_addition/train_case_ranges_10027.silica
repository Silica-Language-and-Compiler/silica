// guards partition int64 into three ranges; n = 21 gives 121
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 21;
            case n of {
                n: int64 if n < 28 -> n + 100;
                n: int64 if n >= 28 and n < 117 -> n;
                n: int64 if n >= 117 -> n + 100;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
