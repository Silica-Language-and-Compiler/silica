// A sum holding a record variant beside a tuple variant, `:empty | (:pair, int64, int64) | { tag: :point, x: int64 }`.
// Both pointer variants are told apart by the first word behind the pointer: the tuple variant's tag
// atom and the record variant's first field, which must be a single atom type (E2234 otherwise; the
// shape of spec §15.4.8 `{ op: :add_child, ... } | { op: :remove_child, ... }`). Each pointer arm
// compares that word with its own atom before reading anything else, so arm order is free.
// Expected: prints 5, 42, 0; exits 0.

use trial_support_int64;

fn area(s: :empty | (:pair, int64, int64) | { tag: :point, x: int64 }) -> int64 {
    case s of {
        { tag: :point, x: v } -> v;
        (:pair, a: int64, b: int64) -> a * b;
        :empty -> 0
    }
}

fn pair(a: int64, b: int64) -> :empty | (:pair, int64, int64) | { tag: :point, x: int64 } {
    (:pair, a, b)
}

fn point(v: int64) -> :empty | (:pair, int64, int64) | { tag: :point, x: int64 } {
    { tag: :point, x: v }
}

fn nothing() -> :empty | (:pair, int64, int64) | { tag: :point, x: int64 } {
    :empty
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(area(point(5)));
                println("");
                print_int64(area(pair(6, 7)));
                println("");
                print_int64(area(nothing()));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
