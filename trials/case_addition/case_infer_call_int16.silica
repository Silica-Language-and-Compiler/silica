// Case scrutinee is a custom function call returning int16 — type inferred from callee.
use trial_support_int64;

fn double16(n: int16) -> int16 {
    n * 2
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case double16(4) of {
                8 -> 1;
                _: int16 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
