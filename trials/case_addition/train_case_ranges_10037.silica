// guards partition int64 into three ranges; n = 103 gives 51
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            n: int64 <- 103;
            case n of {
                n: int64 if n < 33 -> n - 1;
                n: int64 if n >= 33 and n < 102 -> n * 2;
                n: int64 if n >= 102 -> n / 2;
                _: int64 -> 0
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
