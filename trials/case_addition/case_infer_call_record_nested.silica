// Case scrutinee is a custom function call returning a nested record — type inferred from callee.
use trial_support_int64;

fn labeled(n: int64) -> { name: string, pos: { x: int64, y: int64 } } {
    { name: "p", pos: { x: n, y: n + 1 } }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            case labeled(10) of {
                _: { name: string, pos: { x: int64, y: int64 } } -> 21
            }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
