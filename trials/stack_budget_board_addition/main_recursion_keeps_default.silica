// Board stack budget (actor_memory_budget_plan.md §4.1): main's stacks are sized per image by a
// static walk over the linked code. A main that recurses cannot be bounded by it and keeps the
// documented default (128 KB of machine stack, 64 KB auxiliary: silica_esp32s3.ld). 1,500 nested
// frames in main run on that default.
// Expected:
//   1500
//   0

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        r: int64 <- depth(1500);
        print_int64(r);
        println("")
    produces
        pure 0
    end
}
