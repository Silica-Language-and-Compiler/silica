// Board stacks (actor_memory_budget_plan.md item F, spec §15.1.2.2): at the dispatch boundary the
// runtime releases the chunks the actor's release algorithm does not keep, in the chunk sizes the
// stack grew by. One actor per algorithm handles a deep message (400 frames: several chunks),
// then shallow ones; get_actor_memory_usage shows what each keeps:
//   :release_on_return   nothing after any message, while the high-water mark remembers the deep one
//   :keep_last_message   the deep chunks until the next, shallow, message; then the first chunks only
//   :track_recent_peak   the deep chunks through five shallow messages; after 32 more the deep sample
//                        has left the window and the first chunks remain
//   :keep_high_water     the deep chunks for good
// (:release_when_idle is stack_release_when_idle, which has to wait a second.)
// Expected:
//   true
//   true
//   true
//   true
//   true
//   true
//   true
//   true
//   true
//   0

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn shallow_calls(w: actor_ref, n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            sequence proc[concurrency]
                _: int64 <- call(w, 1 impl ActorMessage {});
                rest: int64 <- shallow_calls(w, n - 1)
            produces
                pure rest
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        a: actor_ref <- spawn(0, beh, stack_policy(0, :release_on_return));
        _: int64 <- call(a, 400 impl ActorMessage {});
        ua: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(a);
        print_boolean(ua.committed == 0 and ua.retained == 0);
        println("");
        print_boolean(ua.high_water > 8192);
        println("");
        b: actor_ref <- spawn(0, beh, stack_policy(0, :keep_last_message));
        _: int64 <- call(b, 400 impl ActorMessage {});
        ub: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(b);
        _: int64 <- call(b, 1 impl ActorMessage {});
        ub2: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(b);
        print_boolean(ub.committed > 8192 and ub.committed == ub.high_water);
        println("");
        print_boolean(ub2.committed == 2560 and ub2.high_water == ub.high_water);
        println("");
        c: actor_ref <- spawn(0, beh, stack_policy(0, :track_recent_peak));
        _: int64 <- call(c, 400 impl ActorMessage {});
        uc: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(c);
        _: int64 <- shallow_calls(c, 5);
        uc2: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(c);
        _: int64 <- shallow_calls(c, 32);
        uc3: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(c);
        print_boolean(uc.committed > 8192);
        println("");
        print_boolean(uc2.committed == uc.committed);
        println("");
        print_boolean(uc3.committed == 2560 and uc3.high_water == uc.high_water);
        println("");
        d: actor_ref <- spawn(0, beh, stack_policy(0, :keep_high_water));
        _: int64 <- call(d, 400 impl ActorMessage {});
        ud: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(d);
        _: int64 <- shallow_calls(d, 3);
        ud2: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(d);
        print_boolean(ud.committed > 8192);
        println("");
        print_boolean(ud2.committed == ud.committed and ud2.retained == ud.committed);
        println("")
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :release_on_return));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
