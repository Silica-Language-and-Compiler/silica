// Board stacks (actor_memory_budget_plan.md item F): get_actor_memory_usage on the board reports
// the chunks an actor holds. reserved is what the actor may grow into: the whole heap at the
// default reservation, as the machine's memory is on a host; committed is the chunk bytes held
// now and retained the same (release happens at the dispatch boundary, so what an idle actor
// holds is what its algorithm kept); high_water is the most each stack has held. A deep message
// grows the stack past its first chunks and leaves a high-water mark within the reserved amount;
// a shallow message afterwards does not lower the mark, while :keep_last_message gives the deep
// chunks back.
// Expected:
//   true
//   true
//   true
//   true
//   true
//   0

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        w: actor_ref <- spawn(0, beh, stack_policy(0, :keep_last_message));
        _: int64 <- call(w, 400 impl ActorMessage {});
        deep: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
        _: int64 <- call(w, 1 impl ActorMessage {});
        after: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
        print_boolean(deep.high_water > 2560);
        println("");
        print_boolean(deep.high_water <= deep.reserved);
        println("");
        print_boolean(deep.committed == deep.retained and deep.committed == deep.high_water);
        println("");
        print_boolean(after.high_water == deep.high_water);
        println("");
        print_boolean(after.committed < deep.committed and after.committed > 0);
        println("")
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
