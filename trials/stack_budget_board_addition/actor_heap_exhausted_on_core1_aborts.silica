// A runtime abort raised by an actor on core 1 ends the whole program (spec §15.4.5.5), while main
// keeps core 0 busy writing to the console. The worker is spawned on core 1 and cast 40: it doubles
// an 8-byte string 40 times, and the heap (about 150 KB on the board) is exhausted after some 14
// doublings, so the runtime writes the abort line and the program ends with status 71, the abort
// status. main meanwhile writes 100,000 empty lines (println("") through a tail-recursive helper);
// they carry no text, so they are ignored by the comparison (blank lines do not count), and how many
// were written before the abort does not matter.
// Expected, by hand (golden in the folded form: the abort site's address differs between builds):
//   [silica] abort: heap exhausted at <PTR>
//   71
// Before the fix the abort on core 1 did not end the program while main ran on core 0.
// Atoms: :keep_last_message only, already numbered in this suite.
fn grow(s: string, n: int64) -> string {
    case n of {
        0 -> s;
        _: int64 -> grow(concat(s, s), n - 1)
    }
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println(grow("abcdefgh", msg))
    produces
        pure (:no_reply, state)
    end
}

fn blank_lines(n: int64) -> int64 {
    sequence proc[device_io]
        println("");
        r: int64 <- case n of {
            0 -> 0;
            _: int64 -> blank_lines(n - 1)
        }
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        _: atom <- start_reporter();
        w: actor_ref <- spawn(0, worker, stack_policy(0, :keep_last_message), 1);
        _: boolean <- cast(w, 40 impl ActorMessage {});
        _: int64 <- blank_lines(100000)
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
