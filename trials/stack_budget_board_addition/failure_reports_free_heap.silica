// Board heap (spec §15.4.13.4): a FailureReporter's report string goes back to the heap once
// handle_report returns, unless the reporter kept it or sent it on. This reporter keeps nothing:
// it counts the report, starts the next root worker and casts it 0, and the worker dies dividing 42
// by 0, 120 times. heap_used() is read at the 20th report and at the 120th; the hundred reports
// between them must leave less than 20,000 bytes behind. Measured on the board 2026-10-12 (the
// fixing agent's repro, scratchpad frl/b1): before the fix every report stayed, 37,600 bytes over
// those hundred reports (376 each); after it 12,800 (128 each, kept by something other than the
// report). The reporter prints the comparison and ends the program with status 0. Each root
// worker's end writes the runtime's root-actor note on the board; the notes are compared as a
// set (.scout.multiset), as the suite's other failure trials are.
// Expected:
//   [silica] root actor exited (no supervisor)   (120 times)
//   true
//   0

fn region_dump_limit() -> int64 {
    0
}

fn divide_beh(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, 42 / msg)
}

fn next_worker() -> boolean {
    sequence proc[concurrency]
        w: actor_ref <- spawn(0, divide_beh, stack_policy(0, :keep_last_message));
        sent: boolean <- cast(w, 0 impl ActorMessage {})
    produces
        pure sent
    end
}

fn finish(used_at_20: int64) -> boolean {
    sequence proc[concurrency, device_io, mem(normal)]
        _: atom <- print_boolean(heap_used() - used_at_20 < 20000);
        _: atom <- println("");
        ended: boolean <- cast_exit(0)
    produces
        pure ended
    end
}

// state: (reports seen, heap_used() at the 20th report)
fn handle_report(report: string, state: (int64, int64)) -> (:no_reply, (int64, int64)) {
    sequence proc[mem(normal)]
        (seen, used_at_20): (int64, int64) <- state;
        n: int64 <- seen + 1;
        used: int64 <- case n == 20 of {
            true -> heap_used();
            false -> used_at_20
        };
        _: boolean <- case n == 120 of {
            true -> finish(used);
            false -> next_worker()
        }
    produces
        pure (:no_reply, (n, used))
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        reporter: actor_ref <- spawn((0, 0), handle_report, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter);
        _: boolean <- next_worker();
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
