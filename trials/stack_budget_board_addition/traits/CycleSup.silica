// The ten-child supervisor that supervisor_end_frees_child_table starts and ends in a loop, as the
// one child of that trial's root supervisor (the root restarts it after every end). A worker is
// cast-only and divides its state by its message, so a cast of 0 ends it with the division fault;
// any other message it handles and keeps running. (It was call-only until spec §16.1.1 made a call
// to an actor that ends mid-call raise actor_not_found in the caller.) The children are
// :temporary, so a worker's own end leaves a tombstone row, not a restart.

use Supervisor;

export CycleSup_child_start/1;

impl CycleSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state / msg)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :cyc_w1, agent_type: :worker, initial_state: 1, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w2, agent_type: :worker, initial_state: 2, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w3, agent_type: :worker, initial_state: 3, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w4, agent_type: :worker, initial_state: 4, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w5, agent_type: :worker, initial_state: 5, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w6, agent_type: :worker, initial_state: 6, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w7, agent_type: :worker, initial_state: 7, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w8, agent_type: :worker, initial_state: 8, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w9, agent_type: :worker, initial_state: 9, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain },
            { id: :cyc_w10, agent_type: :worker, initial_state: 10, behavior: worker, restart: :temporary, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn CycleSup_child_start(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    init(initial_state)
}
