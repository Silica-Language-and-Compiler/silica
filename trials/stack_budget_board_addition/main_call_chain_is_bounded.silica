// Board stack budget (actor_memory_budget_plan.md §4.1): a main whose work is a chain of helpers has
// an exact per-image bound (the deepest chain of windowed frames plus the deepest runtime callee),
// and build_image.sh sizes its stacks from it with a margin instead of the 128 KB default. The chain
// below is five frames deep and each level builds a tuple it reads back.
// Expected:
//   120
//   0

fn pair_sum(a: int64, b: int64) -> int64 {
    t: (int64, int64) <- (a, b);
    (x: int64, y: int64) <- t;
    x + y
}

fn l5(n: int64) -> int64 { pair_sum(n, 5) }
fn l4(n: int64) -> int64 { pair_sum(l5(n), 4) }
fn l3(n: int64) -> int64 { pair_sum(l4(n), 3) }
fn l2(n: int64) -> int64 { pair_sum(l3(n), 2) }
fn l1(n: int64) -> int64 { pair_sum(l2(n), 1) }

fn main() -> int64 {
    sequence proc[device_io]
        r: int64 <- l1(105);
        print_int64(r);
        println("")
    produces
        pure 0
    end
}
