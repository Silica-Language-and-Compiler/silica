// Board stack budget (actor_memory_budget_plan.md §4.2, item D): a root supervisor declaring eight
// children in one init literal is the case that scales a supervisor's auxiliary stack (one slab per
// child-spec record before it is copied to the heap). At stack_policy reserve 0 the supervisor runs on
// the size the image's stack table gives its start trampoline and starts all eight; the first
// answers through the supervisor's child table (1 + 5), and each child is on its own table size.
// Expected:
//   8
//   6
//   0

impl WideSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :wide_c1, agent_type: :worker, initial_state: 1, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :wide_c2, agent_type: :worker, initial_state: 2, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :wide_c3, agent_type: :worker, initial_state: 3, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :wide_c4, agent_type: :worker, initial_state: 4, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :wide_c5, agent_type: :worker, initial_state: 5, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :wide_c6, agent_type: :worker, initial_state: 6, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :wide_c7, agent_type: :worker, initial_state: 7, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :wide_c8, agent_type: :worker, initial_state: initial_state, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(WideSup, 8, :wide_sup, stack_policy(0, :keep_last_message));
        n: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :count_children } impl SupervisorMessage {});
        print_int64(n.count);
        println("");
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: :wide_c1 } impl SupervisorMessage {});
        v: int64 <- call(got.child, 5 impl ActorMessage {});
        print_int64(v);
        println("")
    produces pure 0 end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
