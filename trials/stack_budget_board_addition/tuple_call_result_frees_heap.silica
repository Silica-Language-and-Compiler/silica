// Board heap: the hosted twin is actors_addition/zero_heap_growth_tuple_call_per_message. On the
// board heap_used() counts the whole heap, actor stack chunks included; both readings are taken
// through the same helper at the same stack depth, and :keep_last_message keeps the chunks, so they
// compare like for like. Golden derived by hand (the same as the hosted golden), not yet run on the
// board.
// A tuple returned by a call inside an actor goes to the caller's result buffer (X8), a home in the
// caller's frame, so destructuring it leaves nothing on the actor's heap. Each message calls
// pair_direct once and destructures the result. Before the fix every call copied its tuple to the
// actor's region, which nothing frees until the actor ends (16 bytes a call on the Mac).
// The counter casts itself the next message through a helper, reads heap_used() on every message
// through the same helper after the work and before the cast, keeps the reading from message 100
// and at message 1100 prints how far the heap grew over the thousand messages between and ends the
// program. The state is one int64 holding both numbers, messages handled + 4096 * heap_used() at
// message 100.
// Expected output:
//   0
//   0

fn pair_direct(n: int64) -> (int64, int64) {
    (n, n + 1)
}

fn work(n: int64) -> int64 {
    (a, b): (int64, int64) <- pair_direct(n);
    a + b
}

fn region_dump_limit() -> int64 {
    0
}

fn send_next(me: actor_ref) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(me, 1 impl ActorMessage {})
    produces
        pure sent
    end
}

fn finish(growth: int64) -> boolean {
    sequence proc[concurrency, device_io]
        _: atom <- print_int64(growth);
        _: atom <- println("");
        ended: boolean <- cast_exit(0)
    produces
        pure ended
    end
}

fn read_heap_used() -> int64 {
    sequence proc[mem(normal)]
        used: int64 <- heap_used()
    produces
        pure used
    end
}

// state: messages handled + 4096 * heap_used() at message 100
fn count(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        base_then: int64 <- state / 4096;
        n: int64 <- state - 4096 * base_then + msg;
        _: int64 <- work(n);
        used: int64 <- read_heap_used();
        base: int64 <- case n == 100 of {
            true -> used;
            false -> base_then
        };
        me: actor_ref <- self();
        _: boolean <- case n == 1100 of {
            true -> finish(used - base);
            false -> send_next(me)
        }
    produces
        pure (:no_reply, n + 4096 * base)
    end
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(0, count, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, 1 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
