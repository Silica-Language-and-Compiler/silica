// Board heap: the hosted twin is actors_addition/zero_heap_growth_case_tuple_literal_arm. On the
// board heap_used() counts the whole heap, actor stack chunks included; both readings are taken
// through the same helper at the same stack depth, and :keep_last_message keeps the chunks, so they
// compare like for like. Golden derived by hand (the same as the hosted golden), not yet run on the
// board.
// A behaviour whose body is a case with bare tuple-literal arms builds its (:no_reply, state)
// result in the reply buffer, so handling a message leaves nothing on the heap. The counter's body
// is `case step(state + msg) of { 0 -> (:no_reply, 0); next -> (:no_reply, next) }`: step reads
// heap_used() through a helper, keeps the reading from message 100, casts the counter its next
// message, and at message 1100 prints how far the heap grew over the thousand messages between and
// ends the program. The state is one int64 holding both numbers, messages handled + 4096 *
// heap_used() at message 100; step never returns 0. Before the fix each message left its result
// tuple on the actor's region (16 bytes a message on the Mac).
// Expected output:
//   0
//   0

fn region_dump_limit() -> int64 {
    0
}

fn send_next(me: actor_ref) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(me, 1 impl ActorMessage {})
    produces
        pure sent
    end
}

fn finish(growth: int64) -> boolean {
    sequence proc[concurrency, device_io]
        _: atom <- print_int64(growth);
        _: atom <- println("");
        ended: boolean <- cast_exit(0)
    produces
        pure ended
    end
}

fn read_heap_used() -> int64 {
    sequence proc[mem(normal)]
        used: int64 <- heap_used()
    produces
        pure used
    end
}

// s: messages handled (this one included) + 4096 * heap_used() at message 100
fn step(s: int64) -> int64 {
    sequence proc[concurrency]
        base_then: int64 <- s / 4096;
        n: int64 <- s - 4096 * base_then;
        used: int64 <- read_heap_used();
        base: int64 <- case n == 100 of {
            true -> used;
            false -> base_then
        };
        me: actor_ref <- self();
        _: boolean <- case n == 1100 of {
            true -> finish(used - base);
            false -> send_next(me)
        }
    produces
        pure n + 4096 * base
    end
}

fn tally(msg: int64, state: int64) -> (:no_reply, int64) {
    case step(state + msg) of {
        0 -> (:no_reply, 0);
        next: int64 -> (:no_reply, next)
    }
}

fn rep(report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(r);
        a: actor_ref <- spawn(0, tally, stack_policy(0, :keep_last_message));
        _: boolean <- cast(a, 1 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
