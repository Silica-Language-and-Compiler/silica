// Emitter defect found 2026-10-08 while adding the nested-sequence trials, fixed the same day: a binding
// whose value is a nested sequence block that itself makes a call, followed by another call before the
// binding is read, read the later call's result. `v` here is 41 but `w` came out as 3: the inner block
// left 41 in X0 and `v` was never moved to its own register, so println("outer end") (returning :ok,
// atom 2) overwrote it. The let emitter decided the callee-saved spill from the RHS root node's type,
// and a nested let chain's root is its first statement -- the discarded println, SIR `%_` of type
// unit -- not its value. The value type of a let chain is its tail's (term_sir_helpers@
// let_rhs_value_type); with it `v` is spilled to X19 and read from there. Without a call inside the
// inner block the root was the value binding itself and the spill happened by accident
// (sequence_nested_unbraced_binding_value). The .scout holds the correct output.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("outer start");
                v: int64 <- sequence proc[device_io]
                    println("inner")
                produces
                    pure 41
                end;
                println("outer end");
                w: int64 <- v + 1
            produces
                pure w
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
