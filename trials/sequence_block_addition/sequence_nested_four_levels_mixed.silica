// Sequence blocks nested four deep: unbraced as a binding value (levels 1-2), inside a function
// literal passed as a call argument (level 3), and unbraced again inside that literal's block
// (level 4). Every block keeps its own `produces` / `end`; the exit status sums the levels.
use trial_support_int64;

fn apply(f: fn() -> int64) -> int64 {
    f()
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("level 1");
                a: int64 <- sequence proc[device_io]
                    println("level 2");
                    b: int64 <- apply(fn() -> int64 {
                        sequence proc[device_io]
                            println("level 3");
                            c: int64 <- sequence proc[device_io]
                                println("level 4");
                                d: int64 <- 4
                            produces
                                pure d
                            end;
                            c3: int64 <- c + 3
                        produces
                            pure c3
                        end
                    });
                    b2: int64 <- b + 2
                produces
                    pure b2
                end;
                a1: int64 <- a + 1
            produces
                pure a1
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
