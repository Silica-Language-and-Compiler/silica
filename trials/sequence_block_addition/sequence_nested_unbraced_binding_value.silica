// A sequence block nested unbraced as a binding value inside another sequence body (spec §9.3:
// sequence_expression is an expression; statement ::= pattern "<-" expression ";"). The outer
// block keeps its own `produces` / `end`, the inner its own; both run in order.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("outer start");
                v: int64 <- sequence proc[device_io]
                    println("inner");
                    inner_result: int64 <- 41
                produces
                    pure inner_result
                end;
                w: int64 <- v + 1;
                println("outer end")
            produces
                pure w
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
