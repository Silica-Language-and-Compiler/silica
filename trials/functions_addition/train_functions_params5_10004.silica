// function with 5 parameter(s); sum5(15, 19, 23, 11, 23) = 91
use trial_support_uint16;

fn sum5(a: uint16, b: uint16, c: uint16, d: uint16, e: uint16) -> uint16 {
    a + b + c + d + e
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            sum5(15, 19, 23, 11, 23)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 91
    end
}
