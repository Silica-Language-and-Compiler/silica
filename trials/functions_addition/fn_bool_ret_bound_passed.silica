use trial_support_int64;

fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn id_boolean(b: boolean) -> boolean {
    b
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn check() -> int64 {
    t: boolean <- tt();
    f: boolean <- ff();
    pt: boolean <- id_boolean(t);
    pf: boolean <- id_boolean(f);
    bit(pt, 1) + bit(pf == false, 2)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            check()//pt=1, pf==false=2: want 3
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
