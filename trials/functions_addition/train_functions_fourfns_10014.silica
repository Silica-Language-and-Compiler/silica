// four arithmetic helpers; sub(7, 8) + add(2, 9) + div(17, 8) + mul(18, 1) = 30
use trial_support_int64;

fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sub(7, 8) + add(2, 9) + div(17, 8) + mul(18, 1)//30
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
