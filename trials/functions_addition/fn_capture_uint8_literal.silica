// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name bound to an integer
// literal by an integer-typed binding where the literal is written.
// A uint8 literal capturing n: uint8 (bound to 40), called with (1, 2): 1 + 2 + 40 = 43; the
// result is compared as a uint8 and 43 is returned when it matches (1 otherwise).
// Expected: exit status 43.
use trial_support_int64;

fn take2(op: fn(a: uint8, b: uint8) -> uint8) -> uint8 {
    op(1, 2)
}

fn add_u8() -> int64 {
    n: uint8 <- 40;
    r: uint8 <- take2(fn(x: uint8, y: uint8) -> uint8 { x + y + n });
    case r == 43 of {
        true -> 43;
        false -> 1
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            add_u8()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
