// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name bound to an integer
// literal by an integer-typed binding where the literal is written.
// Swapped-formals regression: the binary literal 10 + x - y is the first argument of apply_first,
// which calls it with (1, 2): 10 + 1 - 2 = 9 (formals swapped would give 11).
// Expected: exit status 9.
use trial_support_int64;

fn apply_first(op: fn(a: int64, b: int64) -> int64, p: int64, q: int64) -> int64 {
    op(p, q)
}

fn sub_first() -> int64 {
    apply_first(fn(x: int64, y: int64) -> int64 { 10 + x - y }, 1, 2)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sub_first()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
