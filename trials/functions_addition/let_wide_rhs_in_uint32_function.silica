// A function that returns uint32 evaluates its body into W0. A let in that body whose right-hand side is
// 64 bits wide (an int64 from length_bytes, a string from substring) took the body's W0 as the let's
// register too, so the emitters wrote `MOV W0, X12` / `MOV W0, X0` after the string helper, which does
// not assemble (found 2026-11-10 in the board emitters' prims_pin pin_value, a uint32 parser of a
// literal's text). A wide let's register is now the 64-bit view of the same register
// (let_dispatcher rhs_reg_for_type).
// Expected output: 4, 1, 7, 0, status 0.

fn size_class(text: string) -> uint32 {
    n: int64 <- length_bytes(text);
    case n > 3 of {
        true -> 4;
        false -> 1
    }
}

fn first_digit(text: string) -> uint32 {
    c: string <- substring(text, 0, 1);
    case c == "7" of {
        true -> 7;
        false -> 0
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        a: uint32 <- size_class("hello");
        _: atom <- print_uint32(a);
        println("");
        b: uint32 <- size_class("hi");
        _: atom <- print_uint32(b);
        println("");
        c: uint32 <- first_digit("789");
        _: atom <- print_uint32(c);
        println("");
        d: uint32 <- first_digit("12");
        _: atom <- print_uint32(d);
        println("")
    produces
        pure 0
    end
}
