// Open emitter defect, 2026-10-01, all four emitters (host and board print the same): in a body
// with no call, no case and no BL-producing prim, a let's right-hand side is staged through X0 or
// W1/X1 -- the ABI homes of the first two parameters -- and only int64/uint64/function/handle
// parameters are moved to X19/X20 at entry first (emitter_core needs_int64_abi_entry_shadow,
// is_gpr64_param_type). An atom first parameter is overwritten by an atom let (`MOV X0, #23`;
// f_atom prints true), and a narrow second parameter by a narrow let (`MOV W1, #9`; f_two_u32
// prints 18). A narrow first parameter is intact because narrow lets stage in W1 (f_u32, the
// control). Found while fixing the device_window case
// (device_actor_addition/device_window_param_survives_let); the fix for it does not cover these.
// Expected output: false, 14, 11, then exit 0.

// :left -> false
use trial_support_int64;

fn f_atom(a: atom) -> boolean {
    b: atom <- :right;
    a == b
}

// 1, 5 -> 14
fn f_two_u32(a: uint32, b: uint32) -> uint32 {
    c: uint32 <- 9;
    b + c
}

// 5 -> 11 (control: a narrow first parameter survives a narrow let)
fn f_u32(a: uint32) -> uint32 {
    b: uint32 <- a + 1;
    a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("f_atom (expected false)");
                print_boolean(f_atom(:left));
                println("");
                println("f_two_u32 (expected 14)");
                print_uint32(f_two_u32(1, 5));
                println("");
                println("f_u32 (expected 11)");
                print_uint32(f_u32(5));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
