use trial_support_float64;

fn add_one_f64(x: float64) -> float64 {
    x + 1.0
}

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            add_one_f64(2.718)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3.717999999999999
    end
}
