// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name bound to an integer
// literal by an integer-typed binding where the literal is written.
// An inline unary literal capturing n (bound to 3) is the second argument of takec, which calls it
// with its first argument 1: 1 + 3 = 4.
// Expected: exit status 4.
use trial_support_int64;

fn takec(k: int64, op: fn(a: int64) -> int64) -> int64 {
    op(k)
}

fn plus_n() -> int64 {
    n: int64 <- 3;
    takec(1, fn(x: int64) -> int64 { x + n })
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            plus_n()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
