// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name bound to an integer
// literal by an integer-typed binding where the literal is written. A sequence's statement bindings
// are in scope in its produces part, so a literal written there may capture them.
// in_statement: the literal is in a statement and captures n (5): apply(fn(x) { x + n }, 10) = 15.
// in_produces: the literal is in the produces part and captures n (7), bound by a statement:
// apply(fn(x) { x + n }, 10) = 17 (it failed with E2002 undefined identifier: n).
// Expected, by hand: 15, 17; exits 0.
use trial_support_int64;

fn apply(f: fn(int64) -> int64, x: int64) -> int64 {
    f(x)
}

fn in_statement() -> int64 {
    sequence
        n: int64 <- 5;
        r: int64 <- apply(fn(x: int64) -> int64 { x + n }, 10)
    produces
        pure r
    end
}

fn in_produces() -> int64 {
    sequence
        n: int64 <- 7;
        _: int64 <- 1
    produces
        pure apply(fn(x: int64) -> int64 { x + n }, 10)
    end
}

fn show(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        r: atom <- println("")
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                _: atom <- show(in_statement());
                _: atom <- show(in_produces())
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
