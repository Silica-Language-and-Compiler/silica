// function with 8 parameter(s); sum8(1, 7, 24, 19, 4, 1, 20, 2) = 78
use trial_support_uint16;

fn sum8(a: uint16, b: uint16, c: uint16, d: uint16, e: uint16, f: uint16, g: uint16, h: uint16) -> uint16 {
    a + b + c + d + e + f + g + h
}

fn main() -> uint16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint16@start();
        _: boolean <- trial_support_uint16@run(fn() -> uint16 {
            sum8(1, 7, 24, 19, 4, 1, 20, 2)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 78
    end
}
