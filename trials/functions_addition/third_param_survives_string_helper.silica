// Emitter defect fixed 2026-10-25 (chunk 15 phase 1), hosted emitters: a body with no call, no case,
// no let and no memory/actor prim kept a third parameter in its ABI home X2, but a string prim
// branches to a runtime helper (L_length_bytes_helper, L_substring_helper, L_string_cmp_helper) that
// stages its operands in X0-X2 and uses X1-X3 as scratch. has_at read `pat` after
// L_length_bytes_helper had left ~marker (1) in X2 and faulted (exit 70) in the next length helper;
// ends_with3 compared against whatever the cmp helper left in X2. Bodies with three or more
// parameters and a string prim now take the full parameter shadow (emitter_core
// fs_term_has_string_helper_prim).
// Expected output: true, false, true, false, then exit 0.

use trial_support_int64;

fn has_at(s: string, i: int64, pat: string) -> boolean {
    i + length_bytes(pat) <= length_bytes(s) and substring(s, i, i + length_bytes(pat)) == pat
}

fn ends_with3(a: string, b: string, c: string) -> boolean {
    a == b or substring(a, length_bytes(a) - length_bytes(c), length_bytes(a)) == c
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                println("has_at region( at 0 (expected true)");
                print_boolean(has_at("region(R,normal)", 0, "region("));
                println("");
                println("has_at ref( at 0 (expected false)");
                print_boolean(has_at("region(R,normal)", 0, "ref("));
                println("");
                println("ends_with3 normal) (expected true)");
                print_boolean(ends_with3("region(R,normal)", "x", "normal)"));
                println("");
                println("ends_with3 rec) (expected false)");
                print_boolean(ends_with3("region(R,normal)", "x", "rec)"));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
