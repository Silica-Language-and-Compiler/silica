use trial_support_int64;

fn add(x: int64, y: int64) -> int64 {
    x + y
}

// Outermost function: two parameters — int64 and a binary function type (the fn(...) counts as one formal).
fn first_of_pair_with_fn(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            first_of_pair_with_fn(42, add)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
