use trial_support_boolean;

fn give_true() -> boolean {
    true
}

fn take() -> boolean {
    b: boolean <- give_true();
    b
}

fn main() -> boolean {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_boolean@start();
        _: boolean <- trial_support_boolean@run(fn() -> boolean {
            take()
        });
        _: int64 <- wait_for_exit()
    produces
        pure true
    end
}
