// A function value whose first parameter is a float64, called with a float literal argument, gets
// that literal in its float register and the int64 after it in its own register: once through a
// binding in the caller (hv(9.75, 50)) and once through a parameter of another function
// (apply(g) calls hv(9.75, 50)). Each call prints "g x=9.75" and returns 50; 50 + 50 = 100.
// Expected output:
//   g x=9.75
//   g x=9.75
//   100
//   0 (exit status)
use trial_support_int64;

fn g(x: float64, n: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_string("g x=");
        _: atom <- print_float64(x);
        println("")
    produces
        pure n
    end
}

fn apply(hv: fn(float64, int64) -> int64) -> int64 {
    hv(9.75, 50)
}

fn checks() -> int64 {
    sequence proc[device_io]
        hv: fn(float64, int64) -> int64 <- g;
        a: int64 <- hv(9.75, 50);
        b: int64 <- apply(g);
        _: atom <- print_int64(a + b);
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                r: int64 <- checks()
            produces
                pure r
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
