// function with 7 parameter(s); sum7(9, 17, 10, 3, 10, 6, 17) = 72
use trial_support_int64;

fn sum7(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64) -> int64 {
    a + b + c + d + e + f + g
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sum7(9, 17, 10, 3, 10, 6, 17)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
