.bss
.balign 8
.lcomm silica_frame_depth, 8
.lcomm silica_frame_max, 8
.lcomm silica_fuel, 8
.lcomm silica_saved_pc, 8

.arch armv8.2-a+fp16
.text
    // use trial_support_int64
.extern silica_rt_ffi_guarded_enter
.extern silica_rt_ffi_guarded_exit
.extern silica_rt_ffi_guarded_setjmp
.extern silica_rt_ffi_guarded_fault_finish
.extern silica_rt_ffi_arena_bump
.global main

    // --- recursion phases (recursion_implementation.jsonld) ---
    // p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    // p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    // p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    // p6 trampoline fallback (optional):
    // silica_trampoline_dispatch: load target from frame / BR X8
    // never rely on unbounded native recursion for general calls



.globl train_functions_nullary_0005_answer
train_functions_nullary_0005_answer:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    MOV X0, #37
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

.globl main
main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL silica_pid_registry_init
    BL silica_dangerous_pid_registry_init
    BL silica_device_pid_registry_init
    // unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o184|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_start
    ADD X9, X9, :lo12:trial_support_int64_start
    BLR X9

    ADRP X16, train_functions_nullary_0005.__lam0
    ADD X16, X16, :lo12:train_functions_nullary_0005.__lam0

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o235|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_run
    ADD X9, X9, :lo12:trial_support_int64_run
    BLR X9

    BL silica_rt_wait_for_exit

    MOV X19, X0
    MOV X0, X19



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

.globl train_functions_nullary_0005.__lam0
train_functions_nullary_0005.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    // p3 fuel: LDR X9,=silica_fuel / SUBS / B.EQ silica_yield (optional)
    // unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o287|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    MOV X8, XZR
    LDP X29, X30, [SP], #16

    ADRP X9, train_functions_nullary_0005_answer
    ADD X9, X9, :lo12:train_functions_nullary_0005_answer
    BR X9

L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #30
    B.ge L_pa_oob
    ADRP X9, L_pa_table
    ADD X9, X9, :lo12:L_pa_table
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

