// function with 6 parameter(s); sum6(25, 12, 13, 7, 24, 14) = 95
use trial_support_int32;

fn sum6(a: int32, b: int32, c: int32, d: int32, e: int32, f: int32) -> int32 {
    a + b + c + d + e + f
}

fn main() -> int32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int32@start();
        _: boolean <- trial_support_int32@run(fn() -> int32 {
            sum6(25, 12, 13, 7, 24, 14)
        });
        _: int64 <- wait_for_exit()
    produces
        pure 95
    end
}
