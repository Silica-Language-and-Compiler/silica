// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name bound to an integer
// literal by an integer-typed binding where the literal is written.
// An inner literal captures k, bound to 5 inside the outer literal; take calls each with 2:
// inner 2 * 5 = 10, outer 2 + 10 = 12.
// Expected: exit status 12.
use trial_support_int64;

fn take(op: fn(a: int64) -> int64) -> int64 {
    op(2)
}

fn nested() -> int64 {
    take(fn(x: int64) -> int64 {
        k: int64 <- 5;
        x + take(fn(y: int64) -> int64 { y * k })
    })
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            nested()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
