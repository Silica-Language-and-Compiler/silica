// function with 8 parameter(s); sum8(18, 15, 18, 13, 8, 15, 4, 0) = 91
use trial_support_int64;

fn sum8(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64) -> int64 {
    a + b + c + d + e + f + g + h
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sum8(18, 15, 18, 13, 8, 15, 4, 0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
