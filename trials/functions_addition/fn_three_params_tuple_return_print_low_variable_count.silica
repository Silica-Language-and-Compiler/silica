use trial_support_atom;

fn bundle(a: int64, b: float32, label: string) -> (int64, float32, string) {
    (a, b, label)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                (n: int64, x: float32, s: string)  <- bundle(7, 2.5, "ok");
                print_int64(n);
                println("");
                print_float32(x);
                println("");
                print_string(s);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
