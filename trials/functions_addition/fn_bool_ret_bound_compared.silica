use trial_support_int64;

fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn check() -> int64 {
    t: boolean <- tt();
    f: boolean <- ff();
    eq_t: boolean <- t == true;
    eq_f: boolean <- f == false;
    ne: boolean <- t == f;
    bit(eq_t, 1) + bit(eq_f, 2) + bit(ne, 4)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            check()//eq_t=1, eq_f=2, ne=0: want 3
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
