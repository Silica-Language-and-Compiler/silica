// Spec §3.3.6, rule E1072 (2026-10-16): a function literal may capture a name bound to an integer
// literal by an integer-typed binding where the literal is written.
// A bound binary literal capturing two integer literals, n (3) and k (7), passed to take2, which
// calls it with (1, 2): 1 - 2 + 10 * 3 + 7 = 36.
// Expected: exit status 36.
use trial_support_int64;

fn take2(op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(1, 2)
}

fn plus_n() -> int64 {
    n: int64 <- 3;
    k: int64 <- 7;
    f: fn(int64, int64) -> int64 <- fn(x: int64, y: int64) -> int64 { x - y + 10 * n + k };
    take2(f)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            plus_n()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
