// Spec §3.3.6: a function literal written in a sequence's produces part whose own body is a
// sequence. The literal's sequence binds its own k; the outer k (2) is passed as the argument, not
// captured: apply(fn(x) { k <- x * 10; k + 1 }, 2) = 21.
// Expected, by hand: exit status 21.
use trial_support_int64;

fn apply(f: fn(int64) -> int64, x: int64) -> int64 {
    f(x)
}

fn inner_seq() -> int64 {
    sequence
        k: int64 <- 2
    produces
        pure apply(fn(x: int64) -> int64 {
            sequence
                k: int64 <- x * 10
            produces
                pure k + 1
            end
        }, k)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            inner_seq()
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
