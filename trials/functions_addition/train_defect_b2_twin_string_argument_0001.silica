// positive twin of B2: a string argument to a string parameter; length of "abc" doubled is 6
use trial_support_int64;

fn double_len(s: string) -> int64 {
    length_bytes(s) * 2
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            double_len("abc")
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
