// A print built-in nested in a call argument, show(print_int8(1)), inside a sequence that declares
// device_io. Lee's rule (2026-10-09): the nested call is allowed when an enclosing sequence declares
// the effect, exactly like a direct call. Before the fix the program type- and effect-checked but the
// assembly referenced labels that were never emitted (L_pi8_0, L_pf64_helper, L_pb_helper, ...):
// the rodata and helper walkers of every emitter stopped at a user call instead of searching its
// arguments (emitter/<target>/atoms/int_rodata.silica collect_*_from_term and term_has_*_print,
// float*_rodata, string_rodata, atom_table collect_atoms_from_term). Every argument position is
// covered: the first argument (inner), a later argument (right_expr), a helper's own sequence, and a
// case arm.
// Expected: each printed value followed by ":ok" and a newline (stdout and stderr interleave in
// call order); the exit status is :ok's index, 2.

use trial_support_atom;

fn show(r: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print_atom(r);
        println("")
    produces
        pure r
    end
}

fn second(n: int64, r: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        _: atom <- print_atom(r);
        println("")
    produces
        pure r
    end
}

fn through_helper(b: boolean) -> atom {
    sequence proc[device_io]
        last: atom <- show(print_boolean(b))
    produces
        pure last
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                i8: int8 <- 8;
                f64: float64 <- 3.5;
                b: boolean <- true;
                s: string <- "var";
                a: atom <- :ok;
                _: atom <- show(print_int8(1));
                _: atom <- show(print_int8(i8));
                _: atom <- show(print_int16(2));
                _: atom <- show(print_int32(3));
                _: atom <- show(print_int64(4));
                _: atom <- show(print_uint8(5));
                _: atom <- show(print_uint16(6));
                _: atom <- show(print_uint32(7));
                _: atom <- show(print_uint64(9));
                _: atom <- show(print_float16(0.5));
                _: atom <- show(print_float32(0.25));
                _: atom <- show(print_float64(0.125));
                _: atom <- show(print_float64(f64));
                _: atom <- show(print_boolean(false));
                _: atom <- show(print_boolean(b));
                _: atom <- show(print_atom(:ok));
                _: atom <- show(print_atom(a));
                _: atom <- show(print_string("lit"));
                _: atom <- show(print_string(s));
                _: atom <- show(println("lit"));
                _: atom <- show(println_stderr(s));
                _: atom <- second(10, print_int8(11));
                _: atom <- second(12, print_float32(1.5));
                _: atom <- through_helper(false);
                last: atom <- case b of {
                    true -> show(print_int8(13));
                    false -> show(print_int8(14))
                }
            produces
                pure last
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
