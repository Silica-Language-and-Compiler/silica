// A1 guard: sender unit (sd3_pat_a_tx) listed before the receiver (sd3_pat_b_rx).
// Expected: 3 100
use sd3_pat_a_tx;
use sd3_pat_b_rx;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_int64(sd3_pat_b_rx@classify(sd3_pat_a_tx@make_go(3)));
                print_string(" ");
                _: atom <- print_int64(sd3_pat_b_rx@classify(sd3_pat_a_tx@make_stop(1)));
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
