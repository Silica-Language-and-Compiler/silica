// nested module-qualified calls; lib_math_utils_spec@add(lib_base@seven(), 7) = 14
use trial_support_int64;

use lib_base, lib_math_utils_spec;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_math_utils_spec@add(lib_base@seven(), 7)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
