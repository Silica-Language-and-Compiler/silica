// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_alpha@bump(6) + lib_math_utils_spec@multiply(3, 15) = 52
use trial_support_int64;

use lib_alpha, lib_math_utils_spec;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_alpha@bump(6) + lib_math_utils_spec@multiply(3, 15)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
