// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_arity@add3(9, 12, 15) + lib_alpha@bump(19) = 56
use lib_arity;
use lib_alpha;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_arity@add3(9, 12, 15) + lib_alpha@bump(19)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
