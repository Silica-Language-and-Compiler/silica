// Spec §19.3.3: one `use` may list two modules exporting the same name/arity;
// module-qualified calls pick each one. 4*4 + 4*2 = 24.
use trial_support_int64;

use lib_shared_area_alpha, lib_shared_area_beta;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            a: int64 <- lib_shared_area_alpha@area(4);
            b: int64 <- lib_shared_area_beta@area(4);
            a + b
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
