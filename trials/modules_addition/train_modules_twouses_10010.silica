// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_beta@twice(2) + lib_math_utils_spec@multiply(7, 1) = 11
use lib_beta;
use lib_math_utils_spec;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_beta@twice(2) + lib_math_utils_spec@multiply(7, 1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
