// Negative hexadecimal and binary literals at the bottom of every signed width, and -0x0 / -0b0 for
// unsigned widths, through a module-qualified call: the literal takes the formal's type and the range
// check reads it by its value, so each minimum is accepted (-0x80 is -128 for int8). The rejections
// one step below each minimum live in error_enforcement_addition
// (qualified_call_negative_hex_literal_int8_just_under_trial, negative_hex_literal_*).
// Expected: -128, -128, -32768, -2147483648, -9223372036854775808, 0, 0; exits 0.
use hex_literal_param_lib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_int8(hex_literal_param_lib@same_i8(-0x80));
                println("");
                _: atom <- print_int8(hex_literal_param_lib@same_i8(-0b10000000));
                println("");
                _: atom <- print_int16(hex_literal_param_lib@same_i16(-0x8000));
                println("");
                _: atom <- print_int32(hex_literal_param_lib@same_i32(-0x80000000));
                println("");
                _: atom <- print_int64(hex_literal_param_lib@same_i64(-0x8000000000000000));
                println("");
                _: atom <- print_uint8(hex_literal_param_lib@same_u8(-0x0));
                println("");
                _: atom <- print_uint64(hex_literal_param_lib@same_u64(-0b0));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
