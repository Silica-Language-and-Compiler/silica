// root program using the new library module train_lib_shift5; train_lib_shift5@shift5_apply(8) = 13
use train_lib_shift5;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            train_lib_shift5@shift5_apply(8)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
