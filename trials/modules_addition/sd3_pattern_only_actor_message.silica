// A1: atoms named only in the receiving actor's message type and patterns (lib/sd3_pat_actor_rx.silica,
// listed before this unit) must be in the build-wide atom table, so the tags this unit sends as expression
// literals match its arms. A call, as in spawn_qualified_behaviour.
// Expected: 45 100 (state 40 + 5, then the :stop reply)
use sd3_pat_actor_rx;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                r: actor_ref <- spawn(40, sd3_pat_actor_rx@beh, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                a: int64 <- call(r, (:go, 5) impl ActorMessage {});
                b: int64 <- call(r, (:stop, 1) impl ActorMessage {});
                _: atom <- print_int64(a);
                print_string(" ");
                _: atom <- print_int64(b);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
