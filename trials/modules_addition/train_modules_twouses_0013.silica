// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_base@seven() + lib_math_utils_spec@multiply(12, 16) = 199
use lib_base;
use lib_math_utils_spec;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_base@seven() + lib_math_utils_spec@multiply(12, 16)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
