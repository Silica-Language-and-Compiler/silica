// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_math_utils_spec@add(3, 8) + lib_alpha@bump(1) = 13
use trial_support_int64;

use lib_math_utils_spec, lib_alpha;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_math_utils_spec@add(3, 8) + lib_alpha@bump(1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
