// An unsuffixed float literal infers as float32; through a module-qualified call it takes the
// formal's type (float64 here, float32 for the second call) exactly as in a same-module call,
// and lowers as a float64 constant for the float64 parameter. Until 2026-10-01 the qualified
// path raised E2003 "argument type float32 does not match parameter type float64".
// Expected: 3.000, 2.500; exits 0.
use float_literal_param_lib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_float64(float_literal_param_lib@twice_f64(1.5));
                println("");
                _: atom <- print_float32(float_literal_param_lib@twice_f32(1.25));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
