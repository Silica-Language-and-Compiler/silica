// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_alpha@bump(12) + lib_arity@add3(9, 3, 16) = 41
use lib_alpha;
use lib_arity;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_alpha@bump(12) + lib_arity@add3(9, 3, 16)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
