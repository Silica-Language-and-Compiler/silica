// A1 (BEES request): the actor's message type names the tuple tags :go and :stop only in the union type
// and in case patterns. The sender (main, a later unit) spells them as expression literals, so it registers
// them after this unit: before the fix the receiver compared the variant position, not the atom's index,
// and the actor failed with "no case arm matched".
module sd3_pat_actor_rx;
export beh/2;

fn beh(msg: (:go, int64) | (:stop, int64), state: int64) -> (:reply, int64, int64) {
    case msg of {
        (:go, n: int64) -> (:reply, state + n, state + n);
        (:stop, _m: int64) -> (:reply, 100, state)
    }
}
