    push rbp
    mov rbp, rsp
    push rbx
    push r12
    push r13
    push r14
    push r15
    mov rbx, rdi
    mov r12, rsi
    test rbx, rbx
    jz Lcmp_anull
    test r12, r12
    jz Lcmp_gt
    mov rsi, QWORD PTR [rbx]
