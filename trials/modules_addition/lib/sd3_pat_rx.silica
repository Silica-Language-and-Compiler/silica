// A1 (BEES request, 2026-11-17): a receiving unit that names the tuple-tag atoms :go and :stop only in
// a union type and in case patterns must register them in the build-wide atom table (spec 4.1.7:
// an atom has one identity in every unit, message and case pattern). The sender is a later unit
// that spells :go and :stop as expression literals.
module sd3_pat_rx;
export classify/1;

fn classify(msg: (:go, int64) | (:stop, int64)) -> int64 {
    case msg of {
        (:go, n: int64) -> n;
        (:stop, _m: int64) -> 100
    }
}
