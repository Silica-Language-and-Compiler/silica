// SD-3 (registered-name shape) unit C: the supervised worker. Adds the two message fields and
// prints their sum, then ends the program (cast_exit, spec §15.1.2.5): the sum is the trial's last
// output. See sd3_cross_unit_atoms_registered_name.silica for the defect this exercises.
export add_and_print/2;

fn add_and_print(msg: (int64, int64), state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        (left: int64, right: int64) <- msg;
        total: int64 <- left + right;
        _: atom <- print_int64(total);
        println("");
        _: boolean <- cast_exit(0)
    produces
        pure (:no_reply, state)
    end
}
