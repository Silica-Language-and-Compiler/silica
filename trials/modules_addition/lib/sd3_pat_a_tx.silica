// A1 guard: the sender unit is listed BEFORE the receiver (lib/sd3_pat_b_rx.silica), the order that already
// worked: the atoms :go and :stop get their table indices here, and the receiver must find the same ones.
module sd3_pat_a_tx;
export make_go/1;
export make_stop/1;

fn make_go(n: int64) -> (:go, int64) | (:stop, int64) { (:go, n) }
fn make_stop(n: int64) -> (:go, int64) | (:stop, int64) { (:stop, n) }
