// A1 guard: receiver listed after the sender (lib/sd3_pat_a_tx.silica); names :go and :stop only in its
// type and patterns.
module sd3_pat_b_rx;
export classify/1;

fn classify(msg: (:go, int64) | (:stop, int64)) -> int64 {
    case msg of {
        (:go, n: int64) -> n;
        (:stop, _m: int64) -> 100
    }
}
