/// Supervisor trait — see `silica-specification.md` §15.4.13 (Supervisor Trait).
///
/// Implementors supply `init`, which returns `supervisor_flags` and a static `child_spec` list.
/// Supervisor startup is runtime-owned: `spawn_registered_supervisor(T, state, name)` calls
/// `T.init(state)` exactly once, registers the supervisor, and owns child lifecycle.
///
/// Copied verbatim (module name must match the `use Supervisor;` / `impl X for Supervisor;`
/// spelling) from the book-verification repro `c18_supmodule/Supervisor.silica` for
/// sd3_cross_unit_atoms_registered_name (see that trial's header comment).

export trait Supervisor;
export init/1;

required {
    fn init(initial_supervisor_state: ActorState) -> (
        {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        },
        List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: ActorState,
                behavior: fn(msg: ActorMessage, state: ActorState) -> (:no_reply, ActorState),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous, state_policy: state_policy
            },
            mem(normal)
                | mem(normal_writeback)
                | mem(normal_writethrough)
                | mem(normal_noncacheable)
                | mem(atomic)
                | mem(device)
        ]
    );
}
