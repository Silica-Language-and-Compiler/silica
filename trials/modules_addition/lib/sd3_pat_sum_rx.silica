// A1: an atom variant named only in the parameter's sum type (:idle) and never spelled as an expression
// or as an arm in this unit; the other arm is a tuple tag (:work). The sender is a later unit.
module sd3_pat_sum_rx;
export describe/1;

fn describe(m: :idle | (:work, int64)) -> int64 {
    case m of {
        (:work, n: int64) -> n;
        _ -> 0
    }
}
