// Spec §19.3.3: importing multiple modules is fine when their export sets do not overlap on name+arity.
use trial_support_int64;

use lib_alpha, lib_math_utils_spec;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_alpha@bump(lib_math_utils_spec@add(1, 1))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
