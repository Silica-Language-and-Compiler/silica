// Hexadecimal literals at the top of every integer width through a module-qualified call: the
// literal takes the formal's type and the range check reads it by its radix, so each maximum is
// accepted (0xFFFFFFFF is 4294967295 for uint32). The rejections one step past each maximum live
// in error_enforcement_addition (qualified_call_hex_literal_*_trial, hex_literal_*).
// Expected: 255, 255, 65535, 4294967295, 18446744073709551615, 127, 32767, 2147483647,
// 9223372036854775807; exits 0.
use hex_literal_param_lib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_uint8(hex_literal_param_lib@same_u8(0xFF));
                println("");
                _: atom <- print_uint8(hex_literal_param_lib@same_u8(0b11111111));
                println("");
                _: atom <- print_uint16(hex_literal_param_lib@same_u16(0xFFFF));
                println("");
                _: atom <- print_uint32(hex_literal_param_lib@same_u32(0xFFFFFFFF));
                println("");
                _: atom <- print_uint64(hex_literal_param_lib@same_u64(0xFFFFFFFFFFFFFFFF));
                println("");
                _: atom <- print_int8(hex_literal_param_lib@same_i8(0x7F));
                println("");
                _: atom <- print_int16(hex_literal_param_lib@same_i16(0x7FFF));
                println("");
                _: atom <- print_int32(hex_literal_param_lib@same_i32(0x7FFFFFFF));
                println("");
                _: atom <- print_int64(hex_literal_param_lib@same_i64(0x7FFFFFFFFFFFFFFF));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
