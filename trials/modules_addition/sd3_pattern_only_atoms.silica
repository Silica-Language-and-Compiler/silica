// A1: atoms named only in the receiver's type and patterns (lib/sd3_pat_rx.silica, listed before this
// unit) are registered in the build-wide table, so a tag this unit builds as an expression literal
// matches the receiver's arm. Before the fix the receiver compared the variant position and failed with
// "no case arm matched".
// Expected: 5 100
use sd3_pat_rx;
use trial_support_int64;

fn make_go(n: int64) -> (:go, int64) | (:stop, int64) { (:go, n) }
fn make_stop(n: int64) -> (:go, int64) | (:stop, int64) { (:stop, n) }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_int64(sd3_pat_rx@classify(make_go(5)));
                print_string(" ");
                _: atom <- print_int64(sd3_pat_rx@classify(make_stop(9)));
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
