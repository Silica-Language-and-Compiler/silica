// The same qualified-call literal path for every other integer width: the literal takes the
// formal's type (uint8, uint16, int8, int16, int32, uint64), including negative literals to the
// signed widths and a literal past 2^32 to uint64.
// Expected: 17, 301, -4, -299, 100001, 5000000001; exits 0.
use literal_param_lib;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_uint8(literal_param_lib@next_u8(16));
                println("");
                _: atom <- print_uint16(literal_param_lib@next_u16(300));
                println("");
                _: atom <- print_int8(literal_param_lib@next_i8(-5));
                println("");
                _: atom <- print_int16(literal_param_lib@next_i16(-300));
                println("");
                _: atom <- print_int32(literal_param_lib@next_i32(100000));
                println("");
                _: atom <- print_uint64(literal_param_lib@next_u64(5000000000));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
