// spawn with a module-qualified behaviour (`module@fn`, spec §3.3.2): the checker resolves the
// behaviour through the used module and the SIR takes that module's symbol for the behaviour
// pointer. Before 2026-09-30 this was E2005 "unknown behavior function". A call, not a cast and
// wait_for_exit(): wait_for_exit() does not return when this suite's library set is linked in
// (seen with local behaviours and with the published compiler too, 2026-09-30).
// Expected: the worker replies 40 + 2, exit 0.
//   42
//   0
use lib_qualified_worker;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                r: actor_ref <- spawn(40, lib_qualified_worker@worker, stack_policy(0, :keep_last_message));
                v: int64 <- call(r, 2 impl ActorMessage {});
                _: atom <- print_int64(v);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
