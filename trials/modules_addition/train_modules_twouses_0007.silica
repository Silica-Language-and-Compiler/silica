// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_arity@add3(6, 12, 18) + lib_math_utils_spec@add(7, 3) = 46
use trial_support_int64;

use lib_arity, lib_math_utils_spec;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_arity@add3(6, 12, 18) + lib_math_utils_spec@add(7, 3)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
