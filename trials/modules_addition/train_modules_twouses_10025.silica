// Spec §19.3.1/§19.3.3: two imports whose exports do not overlap; lib_base@seven() + lib_beta@twice(10) = 27
use trial_support_int64;

use lib_base, lib_beta;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_base@seven() + lib_beta@twice(10)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
