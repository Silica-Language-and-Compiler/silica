// nested module-qualified calls; lib_math_utils_spec@multiply(lib_middle@ten(), 20) = 200
use trial_support_int64;

use lib_middle, lib_math_utils_spec;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            lib_math_utils_spec@multiply(lib_middle@ten(), 20)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
