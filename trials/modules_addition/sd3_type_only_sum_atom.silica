// A1: :idle is named only in lib/sd3_pat_sum_rx.silica's parameter type; this unit passes it as an
// expression literal, and (:work, 7) as a tagged tuple. Before the fix the receiver's tag compare used
// a variant position, not the atom's table index.
// Expected: 0 7
use sd3_pat_sum_rx;
use trial_support_int64;

fn make_idle() -> :idle | (:work, int64) { :idle }
fn make_work(n: int64) -> :idle | (:work, int64) { (:work, n) }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_int64(sd3_pat_sum_rx@describe(make_idle()));
                print_string(" ");
                _: atom <- print_int64(sd3_pat_sum_rx@describe(make_work(7)));
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
