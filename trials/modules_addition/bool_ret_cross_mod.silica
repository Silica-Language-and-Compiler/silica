// Cross-module bool returns (`module@fn`). Seed-built selfhost has been observed
// to treat `instantiated_fn_name@decl_name_matches` as always-true, so the main
// marker matched every callee. Want 10: unequal names and `ff` stay false.
use lib_bool_name_match;
use trial_support_int64;

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            bit(lib_bool_name_match@decl_name_matches("marker", "pick"), 1) + bit(lib_bool_name_match@decl_name_matches("pick", "pick"), 2) + bit(lib_bool_name_match@ff(), 4) + bit(lib_bool_name_match@tt(), 8)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
