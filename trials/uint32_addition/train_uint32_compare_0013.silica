// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((21 + 14) == 20 / 42);
                println("");
                _: atom <- print_boolean((53 - 3) != 0 / 14);
                println("");
                result: atom <- print_boolean((28 - 23) >= 33)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
