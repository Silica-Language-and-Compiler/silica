// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(56 * 14 < 5 % 21);
                println("");
                _: atom <- print_boolean(49 > 8 * 37);
                println("");
                _: atom <- print_boolean((1 % 6) <= 51 % 29);
                println("");
                _: atom <- print_boolean(18 < (59 + 24));
                println("");
                result: atom <- print_boolean(50 % 44 != 25)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
