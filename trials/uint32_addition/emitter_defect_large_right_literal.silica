// Fixed 2026-10-01 (const_default: a W-register literal-pool load took its page address in X9,
// which is where the left operand of a narrow binop already sat). A uint32 `+`, `-` or `*` whose
// right operand is a literal of 65536 or more read garbage for the left operand (`x + 70000`
// with x = 5 printed 77263216). The literal on the left, a literal up to 65535, an int64 operand
// and a let-bound uint32 operand were never affected.
// Expected: prints 70005, 70005, 4294897301, 350000; exits 0.
use trial_support_int64;

fn plus_right(x: uint32) -> uint32 {
    x + 70000
}

fn plus_left(x: uint32) -> uint32 {
    70000 + x
}

fn minus_right(x: uint32) -> uint32 {
    x - 70000
}

fn times_right(x: uint32) -> uint32 {
    x * 70000
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                five: uint32 <- 5;
                a: atom <- print_uint32(plus_right(five));
                println("");
                b: atom <- print_uint32(plus_left(five));
                println("");
                c: atom <- print_uint32(minus_right(five));
                println("");
                d: atom <- print_uint32(times_right(five));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
