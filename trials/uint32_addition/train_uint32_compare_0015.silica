// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(32 == (58 - 49));
                println("");
                _: atom <- print_boolean((52 - 17) != (4 + 38));
                println("");
                _: atom <- print_boolean(7 * 10 > 51 % 55);
                println("");
                _: atom <- print_boolean(24 == (15 + 46));
                println("");
                result: atom <- print_boolean(2 > 37 / 17)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
