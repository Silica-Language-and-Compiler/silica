// uint32 bindings then expression; expect 64
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            count: uint32 <- 47;
            k: uint32 <- (50 % count) / (count + 15);
            total: uint32 <- 15;
            d: uint32 <- (count / 51);
            count + 15 + 44 / total + k - k + d - d
        });
        _: int64 <- wait_for_exit()
    produces
        pure 64
    end
}
