// Hexadecimal and binary literals at the top of every integer width, let-bound and passed to a
// same-module parameter: the range check reads them by their radix (0xFFFFFFFF is 4294967295, not
// the decimal digits of its text), so each maximum is accepted and reaches the callee unchanged.
// The rejections one step past each maximum live in error_enforcement_addition (hex_literal_*).
// Expected: 255, 255, 65535, 4294967295, 4294967295, 18446744073709551615, 127, 32767, 2147483647,
// 9223372036854775807; exits 0.
use trial_support_int64;

fn same_u8(i: uint8) -> uint8 {
    i
}

fn same_u16(i: uint16) -> uint16 {
    i
}

fn same_u32(i: uint32) -> uint32 {
    i
}

fn same_u64(i: uint64) -> uint64 {
    i
}

fn same_i8(i: int8) -> int8 {
    i
}

fn same_i16(i: int16) -> int16 {
    i
}

fn same_i32(i: int32) -> int32 {
    i
}

fn same_i64(i: int64) -> int64 {
    i
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_uint8(same_u8(0xFF));
                println("");
                _: atom <- print_uint8(same_u8(0b11111111));
                println("");
                _: atom <- print_uint16(same_u16(0xFFFF));
                println("");
                top: uint32 <- 0xFFFFFFFF;
                _: atom <- print_uint32(top);
                println("");
                _: atom <- print_uint32(same_u32(0xFFFFFFFF));
                println("");
                _: atom <- print_uint64(same_u64(0xFFFFFFFFFFFFFFFF));
                println("");
                _: atom <- print_int8(same_i8(0x7F));
                println("");
                _: atom <- print_int16(same_i16(0x7FFF));
                println("");
                _: atom <- print_int32(same_i32(0x7FFFFFFF));
                println("");
                _: atom <- print_int64(same_i64(0x7FFFFFFFFFFFFFFF));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
