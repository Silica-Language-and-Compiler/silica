// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(59 < 50 * 56);
                println("");
                _: atom <- print_boolean(14 / 23 < (6 + 3));
                println("");
                _: atom <- print_boolean(8 / 34 == 10 / 35);
                println("");
                _: atom <- print_boolean(7 * 59 == (52 % 14));
                println("");
                result: atom <- print_boolean(16 % 53 < 21 % 59)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
