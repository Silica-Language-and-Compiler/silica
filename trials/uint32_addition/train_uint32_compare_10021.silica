// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(25 / 28 == 42 * 21);
                println("");
                _: atom <- print_boolean(17 % 32 <= 23);
                println("");
                _: atom <- print_boolean(55 % 25 != (28 + 17));
                println("");
                _: atom <- print_boolean(39 % 54 <= 29 * 44);
                println("");
                result: atom <- print_boolean(52 > (32 - 21))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
