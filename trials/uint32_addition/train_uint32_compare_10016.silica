// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(49 % 60 > (59 - 56));
                println("");
                _: atom <- print_boolean((6 % 32) != 26);
                println("");
                _: atom <- print_boolean(34 * 20 == 46 % 12);
                println("");
                _: atom <- print_boolean((21 + 34) != (28 / 46));
                println("");
                result: atom <- print_boolean(53 % 54 < (35 + 43))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
