// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(8 % 57 < 43);
                println("");
                _: atom <- print_boolean((28 + 45) > 23 / 31);
                println("");
                _: atom <- print_boolean(42 * 6 < 12 % 44);
                println("");
                _: atom <- print_boolean(32 < 55 * 45);
                println("");
                result: atom <- print_boolean(38 / 41 < (35 + 38))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
