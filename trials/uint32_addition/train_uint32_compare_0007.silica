// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((0 + 22) > 24 * 60);
                println("");
                _: atom <- print_boolean((34 + 9) > 33 % 17);
                println("");
                _: atom <- print_boolean((44 + 26) != 14 / 21);
                println("");
                _: atom <- print_boolean(30 % 21 == 1 % 11);
                println("");
                result: atom <- print_boolean(6 != (49 + 27))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
