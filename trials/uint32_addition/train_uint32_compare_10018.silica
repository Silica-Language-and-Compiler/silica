// uint32 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(30 % 45 != 49 * 5);
                println("");
                _: atom <- print_boolean(3 % 19 >= 43);
                println("");
                _: atom <- print_boolean((60 - 44) < (0 + 16));
                println("");
                _: atom <- print_boolean((32 + 11) > 38 % 38);
                println("");
                result: atom <- print_boolean(20 == (13 * 14))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
