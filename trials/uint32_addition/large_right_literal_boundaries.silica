// Right-hand uint32 literals at the MOV-immediate boundary and at the top of the type: 65535 is
// the last value one MOV encodes, 65536 the first that comes from the literal pool, 4294967295
// (0xFFFFFFFF) the largest uint32. The left operand is 5; wrapping results are modulo 2^32.
// Expected: 65540, 65541, 4, 4294901766, 4294901765, 6, 327675, 327680, 4294967291; exits 0.
use trial_support_int64;

fn plus_65535(x: uint32) -> uint32 {
    x + 65535
}

fn plus_65536(x: uint32) -> uint32 {
    x + 65536
}

fn plus_max(x: uint32) -> uint32 {
    x + 4294967295
}

fn minus_65535(x: uint32) -> uint32 {
    x - 65535
}

fn minus_65536(x: uint32) -> uint32 {
    x - 65536
}

fn minus_max(x: uint32) -> uint32 {
    x - 4294967295
}

fn times_65535(x: uint32) -> uint32 {
    x * 65535
}

fn times_65536(x: uint32) -> uint32 {
    x * 65536
}

fn times_max(x: uint32) -> uint32 {
    x * 4294967295
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                five: uint32 <- 5;
                a: atom <- print_uint32(plus_65535(five));
                println("");
                b: atom <- print_uint32(plus_65536(five));
                println("");
                c: atom <- print_uint32(plus_max(five));
                println("");
                d: atom <- print_uint32(minus_65535(five));
                println("");
                e: atom <- print_uint32(minus_65536(five));
                println("");
                f: atom <- print_uint32(minus_max(five));
                println("");
                g: atom <- print_uint32(times_65535(five));
                println("");
                h: atom <- print_uint32(times_65536(five));
                println("");
                i: atom <- print_uint32(times_max(five));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
