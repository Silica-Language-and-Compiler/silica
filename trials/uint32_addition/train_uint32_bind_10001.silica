// uint32 bindings then expression; expect 27
use trial_support_uint32;

fn main() -> uint32 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint32@start();
        _: boolean <- trial_support_uint32@run(fn() -> uint32 {
            height: uint32 <- 4;
            d: uint32 <- 28;
            count: uint32 <- 45;
            step: uint32 <- 9 + 42;
            27 + height - height + d - d + count - count + step - step
        });
        _: int64 <- wait_for_exit()
    produces
        pure 27
    end
}
