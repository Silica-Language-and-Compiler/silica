// The allocation a transport operation needs is satisfied by a mem(...) kind of any sort
// (specification section 9.1.1, 16.4): mem(normal) is not special. This sequence declares
// mem(atomic) beside transport, encodes and decodes an int64, and the declared mem(atomic)
// counts as used by those operations (no E3010).
use wire_etf;
use trial_support_hex;

fn main() -> int64 {
    sequence proc[mem(atomic), device_io, transport]
        frame: string <- encode((:etf), 42);
        _: atom <- println(trial_support_hex@hex(frame));
        r: (:ok, int64) | (:rejected, atom) <- decode((:etf), frame);
        out: atom <- case r of {
            (:ok, w: int64) -> case w == 42 of {
                true -> println("round trip");
                false -> println("round trip differs")
            };
            (:rejected, why: atom) -> print_atom(why)
        }
    produces
        pure 0
    end
}
