// A recursive tuple (atom, int64, ref?(L, normal, rec)) crosses as nested tuples with the atom
// `none` in an empty slot, {ok, 5, {ok, 4, none}} to Erlang (design §4.2, §4.7). decode takes the
// caller's region as its fourth argument and rebuilds every present slot in it with alloc_rec;
// max_depth bounds the nesting it follows.
use wire_etf;
use trial_support_hex;

fn push(r: region(L, normal), top: ref?(L, normal, (atom, int64, ref?(L, normal, rec))), v: int64) -> ref?(L, normal, (atom, int64, ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        cell: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, v, top))
    produces pure cell end
}

fn total(top: ref?(L, normal, (atom, int64, ref?(L, normal, rec))), acc: int64) -> int64 {
    case top of {
        :none -> acc;
        c: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (atom, int64, ref?(L, normal, rec)) <- read_ref(c);
                (_: atom, v: int64, n: ref?(L, normal, (atom, int64, ref?(L, normal, rec)))) <- node
            produces pure total(n, acc + v) end
        }
    }
}

fn report(r2: (:ok, (atom, int64, ref?(L, normal, rec))) | (:rejected, atom)) -> atom {
    sequence proc[device_io]
        o: atom <- case r2 of {
            (:ok, w: (atom, int64, ref?(L, normal, rec))) -> {
                sequence proc[device_io]
                    (_: atom, v0: int64, nx: ref?(L, normal, (atom, int64, ref?(L, normal, rec)))) <- w;
                    o2: atom <- print_int64(v0 + total(nx, 0))
                produces pure o2 end
            };
            (:rejected, why: atom) -> print_atom(why)
        };
        o3: atom <- println("")
    produces
        pure o3
    end
}

// The limits are literals at each call (design §4.1): one function per depth.
fn at4(r: region(L, normal), frame: string) -> atom {
    sequence proc[mem(normal), transport]
        r2: (:ok, (atom, int64, ref?(L, normal, rec))) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 256, max_depth: 4 }, r)
    produces pure report(r2) end
}

fn at3(r: region(L, normal), frame: string) -> atom {
    sequence proc[mem(normal), transport]
        r2: (:ok, (atom, int64, ref?(L, normal, rec))) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 256, max_depth: 3 }, r)
    produces pure report(r2) end
}

fn at2(r: region(L, normal), frame: string) -> atom {
    sequence proc[mem(normal), transport]
        r2: (:ok, (atom, int64, ref?(L, normal, rec))) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 256, max_depth: 2 }, r)
    produces pure report(r2) end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        s1: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) <- push(r, :none, 4);
        s2: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) <- push(r, s1, 3);
        top: (atom, int64, ref?(L, normal, rec)) <- (:ok, 5, s2);
        frame: string <- encode((:etf), top);
        _: atom <- println(trial_support_hex@hex(frame));
        _: atom <- at4(r, frame);
        // three nested tuples need depth 3; depth 2 stops at the third.
        _: atom <- at3(r, frame);
        _: atom <- at2(r, frame);
        // a slot holding an atom other than none is a bad variant.
        bad: List[int64, mem(normal)] <- [131, 104, 3, 119, 2, 111, 107, 97, 1, 119, 3, 110, 105, 108];
        badf: string <- bytes_of(bad);
        _: atom <- at4(r, badf)
    produces
        pure 0
    end
}
