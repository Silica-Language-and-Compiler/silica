// One owner per region, held by a lock on the backing (design §6.8.2). While the first carrier has the
// backing open, a second carrier started on the same declaration is refused with
// (:link_down, :in_use): its open finds the backing locked, as a second process's would.
module dangerous_store_backing_in_use;

use wireframe;
use Carrier;
use storelog;
use trial_wait_int64;

carried_on journal: (:store) (:backing, "store_backing_in_use.sildat", 8192, :stop);

// A new carrier on the same declaration, opened by this owner: a restart of the carrier actor.
fn fresh() -> dangerous_actor_ref {
    sequence proc[concurrency]
        c: dangerous_actor_ref <- spawn_dangerous_carrier(journal, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(c, (:open, self(), "") impl ActorMessage {})
    produces
        pure c
    end
}

fn next_car(step: int64, car: dangerous_actor_ref) -> dangerous_actor_ref {
    case step == 2 of {
        true -> fresh();
        false -> car
    }
}

fn said_closed() -> boolean {
    sequence proc[device_io]
        _: atom <- println("link_down :closed")
    produces
        pure true
    end
}

fn done_only() -> boolean {
    sequence proc[device_io]
        _: atom <- println("done")
    produces
        pure true
    end
}

// A replayed record, as it is.
fn shown(segment: string, st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    _: atom <- case length_bytes(segment) < 24 of {
        true -> say_text("rx ", segment);
        false -> say_n("rx bytes=", length_bytes(segment))
    };
    st
}

fn expect(step: int64) -> atom {
    case step of {
        0 -> :link_up;
        1 -> :log;
        2 -> :tx_credit;
        3 -> :link_down;
        _: int64 -> :never
    }
}

fn need(step: int64) -> int64 {
    case step of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> 1;
        _: int64 -> 1
    }
}

fn act(step: int64, car: dangerous_actor_ref) -> boolean {
    case step of {
        3 -> act3(car);
        _: int64 -> true
    }
}

fn act3(car: dangerous_actor_ref) -> boolean {
    done_only()
}

fn say_n(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces
        pure o
    end
}

fn say_atom(label: string, a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_atom(a);
        o: atom <- println("")
    produces
        pure o
    end
}

fn say_text(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        o: atom <- println(s)
    produces
        pure o
    end
}

fn say_log(oldest: int64, nx: int64, capacity: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print("log oldest=");
        _: atom <- print_int64(oldest);
        _: atom <- print(" next=");
        _: atom <- print_int64(nx);
        _: atom <- print(" capacity=");
        _: atom <- print_int64(capacity);
        o: atom <- println("")
    produces
        pure o
    end
}

fn tx(car: dangerous_actor_ref, s: string) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:tx, s, self()) impl ActorMessage {})
    produces
        pure r
    end
}

// n records of `size` zero bytes each.
fn tx_zeros(car: dangerous_actor_ref, n: int64, size: int64) -> boolean {
    case n <= 0 of {
        true -> true;
        false -> {
            _: boolean <- tx(car, storelog@zeros(size));
            tx_zeros(car, n - 1, size)
        }
    }
}

fn tx_all(car: dangerous_actor_ref, segs: List[string, mem(normal)]) -> boolean {
    case segs of {
        []: List[string, mem(normal)] -> true;
        [h: string, t: List[string, mem(normal)]] -> {
            _: boolean <- tx(car, h);
            tx_all(car, t)
        }
    }
}

fn nth(xs: List[string, mem(normal)], i: int64) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, t: List[string, mem(normal)]] -> case i == 0 of { true -> h; false -> nth(t, i - 1) }
    }
}

fn ask_sync(car: dangerous_actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, :sync impl ActorMessage {})
    produces
        pure r
    end
}

fn ask_read(car: dangerous_actor_ref, from: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:read, from) impl ActorMessage {})
    produces
        pure r
    end
}

fn ask_read_stop(car: dangerous_actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, :read_stop impl ActorMessage {})
    produces
        pure r
    end
}

fn give_credit(car: dangerous_actor_ref, n: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:credit, n) impl ActorMessage {})
    produces
        pure r
    end
}

fn ask_trim(car: dangerous_actor_ref, upto: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:trim, upto) impl ActorMessage {})
    produces
        pure r
    end
}

fn ask_close(car: dangerous_actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, :close impl ActorMessage {})
    produces
        pure r
    end
}

// The carrier ends after :close and, having no supervisor, its normal exit is reported on standard
// error. The owner waits for that report before it prints the carrier's last message and the line
// the trial run ends at.
fn settle() -> boolean {
    sequence proc[concurrency]
        _: timer_ref <- send_after(300, self(), :settled impl ActorMessage {})
    produces
        pure true
    end
}

fn finished() -> boolean {
    sequence proc[device_io]
        _: atom <- println("link_down :closed");
        _: atom <- println("done")
    produces
        pure true
    end
}

// The script: at each step the owner waits for need(step) events of the kind expect(step), then
// act(step) runs and the next step begins. Every event is printed as it arrives, awaited or not.
fn progress(e: atom, st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    case e == expect(st.step) of {
        false -> st;
        true -> case st.left > 1 of {
            true -> { car: st.car, step: st.step, left: st.left - 1, rx: st.rx };
            false -> acted(st)
        }
    }
}

fn acted(st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    _: boolean <- act(st.step, st.car);
    { car: next_car(st.step, st.car), step: st.step + 1, left: need(st.step + 1), rx: st.rx }
}

fn on_text(label: string, s: string, e: atom, st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_text(label, s);
    (:no_reply, progress(e, st))
}

fn on_n(label: string, n: int64, e: atom, st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_n(label, n);
    (:no_reply, progress(e, st))
}

fn on_atom(label: string, a: atom, e: atom, st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_atom(label, a);
    (:no_reply, progress(e, st))
}

// The carrier's last message. (:link_down, :closed) is printed by finished(), after the carrier's exit
// report: the report is written by another thread and would otherwise land before or after this line.
fn on_link_down(why: atom, st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    case why == :closed of {
        true -> (:no_reply, progress(:link_down, st));
        false -> on_atom("link_down ", why, :link_down, st)
    }
}

fn on_log(oldest: int64, nx: int64, capacity: int64, st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_log(oldest, nx, capacity);
    (:no_reply, progress(:log, st))
}

fn on_rx(segment: string, st: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    (:no_reply, progress(:rx, shown(segment, st)))
}

fn owner(msg: (:link_up, string) | (:log, int64, int64, int64) | (:tx_credit, int64) | (:synced, int64) | (:rx, string) | (:rx_end, int64) | (:tx_failed, atom) | (:read_failed, atom) | (:link_down, atom) | :settled, state: { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    case msg of {
        (:link_up, info: string) -> on_text("link_up ", info, :link_up, state);
        (:log, a: int64, b: int64, c: int64) -> on_log(a, b, c, state);
        (:tx_credit, n: int64) -> on_n("tx_credit ", n, :tx_credit, state);
        (:synced, n: int64) -> on_n("synced ", n, :synced, state);
        (:rx, s: string) -> on_rx(s, state);
        (:rx_end, n: int64) -> on_n("rx_end ", n, :rx_end, state);
        (:tx_failed, why: atom) -> on_atom("tx_failed ", why, :tx_failed, state);
        (:read_failed, why: atom) -> on_atom("read_failed ", why, :read_failed, state);
        (:link_down, why: atom) -> on_link_down(why, state);
        :settled -> (:no_reply, progress(:settled, state))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: dangerous_actor_ref <- spawn_dangerous_carrier(journal, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                own: actor_ref <- spawn({ car: car, step: 0, left: need(0), rx: wireframe@fresh(:storage) }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(car, (:open, own, "") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
