// ETF lists and sums (transport_serialization_design.md §4.7): a list is LIST_EXT with a NIL tail,
// an atom variant is its atom, a tagged-tuple variant is its tuple; the frame from term_to_binary
// of the same term decodes.
use wire_etf;
use trial_support_hex;


fn show_sum(v: (:a, int64) | (:b, string) | :none) -> atom {
    sequence proc[mem(normal), device_io, transport]
        frame: string <- encode((:etf), v);
        _: atom <- println(trial_support_hex@hex(frame));
        r: (:ok, (:a, int64) | (:b, string) | :none) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 64 });
        out: atom <- case r of {
            (:ok, w: (:a, int64) | (:b, string) | :none) -> case w of {
                (:a, n: int64) -> {
                    _: atom <- print_int64(n);
                    println("")
                };
                (:b, s: string) -> println(s);
                :none -> println("none")
            };
            (:rejected, why: atom) -> print_atom(why)
        }
    produces
        pure out
    end
}

fn show_cmd(v: (:cmd, { op: :set | :get, key: string, values: List[int64, mem(normal)] })) -> atom {
    case v of {
        (:cmd, rc: { op: :set | :get, key: string, values: List[int64, mem(normal)] }) -> {
            sequence proc[mem(normal), device_io]
                op: :set | :get <- rc.op;
                _: atom <- case op of {
                    :set -> println("set");
                    :get -> println("get")
                };
                _: atom <- println(rc.key);
                nv: int64 <- length[int64, mem(normal)](rc.values);
                _: atom <- print_int64(nv);
                second: int64 <- list_at[int64, mem(normal)](rc.values, 1);
                _: atom <- print_int64(second);
                outc: atom <- println("")
            produces
                pure outc
            end
        }
    }
}

fn show_xy(x: int64, y: string) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        o: atom <- println(y)
    produces
        pure o
    end
}

// A sum with a record variant: the map among an atom and a tagged tuple (design §4.2).
fn show_mixed(v: (:a, int64) | { x: int64, y: string } | :none) -> atom {
    sequence proc[mem(normal), device_io, transport]
        frame: string <- encode((:etf), v);
        _: atom <- println(trial_support_hex@hex(frame));
        r: (:ok, (:a, int64) | { x: int64, y: string } | :none) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 64 });
        out: atom <- case r of {
            (:ok, w: (:a, int64) | { x: int64, y: string } | :none) -> case w of {
                :none -> println("none");
                (:a, n: int64) -> print_int64(n);
                { x: wx, y: wy } -> show_xy(wx, wy)
            };
            (:rejected, why: atom) -> print_atom(why)
        }
    produces
        pure out
    end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        xs: List[int64, mem(normal)] <- [1, 2, 3];
        fx: string <- encode((:etf), xs);
        _: atom <- println(trial_support_hex@hex(fx));
        rx: (:ok, List[int64, mem(normal)]) | (:rejected, atom) <- decode((:etf), fx, { max_bytes: 256, max_length: 8 });
        _: atom <- case rx of {
            (:ok, ws: List[int64, mem(normal)]) -> {
                sequence proc[mem(normal), device_io]
                    n: int64 <- length[int64, mem(normal)](ws);
                    third: int64 <- list_at[int64, mem(normal)](ws, 2);
                    _: atom <- print_int64(n);
                    _: atom <- print_int64(third);
                    out: atom <- println("")
                produces
                    pure out
                end
            };
            (:rejected, whyx: atom) -> print_atom(whyx)
        };
        none: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        fn0: string <- encode((:etf), none);
        _: atom <- println(trial_support_hex@hex(fn0));
        rn: (:ok, List[int64, mem(normal)]) | (:rejected, atom) <- decode((:etf), fn0, { max_bytes: 256, max_length: 8 });
        _: atom <- case rn of {
            (:ok, wn: List[int64, mem(normal)]) -> {
                sequence proc[mem(normal), device_io]
                    n0: int64 <- length[int64, mem(normal)](wn);
                    _: atom <- print_int64(n0);
                    out0: atom <- println("")
                produces
                    pure out0
                end
            };
            (:rejected, whyn: atom) -> print_atom(whyn)
        };
        vals: List[int64, mem(normal)] <- [10, 20];
        c: (:cmd, { op: :set | :get, key: string, values: List[int64, mem(normal)] }) <- (:cmd, { op: :set, key: "k", values: vals });
        fc: string <- encode((:etf), c);
        _: atom <- println(trial_support_hex@hex(fc));
        // term_to_binary({cmd, #{op => set, key => <<"k">>, values => [10, 20]}}) on OTP 27: keys values, op, key.
        erl: List[int64, mem(normal)] <- [131, 104, 2, 119, 3, 99, 109, 100, 116, 0, 0, 0, 3, 119, 6, 118, 97, 108, 117, 101, 115, 107, 0, 2, 10, 20, 119, 2, 111, 112, 119, 3, 115, 101, 116, 119, 3, 107, 101, 121, 109, 0, 0, 0, 1, 107];
        ferl: string <- bytes_of(erl);
        rc: (:ok, (:cmd, { op: :set | :get, key: string, values: List[int64, mem(normal)] })) | (:rejected, atom) <- decode((:etf), ferl, { max_bytes: 4096, max_depth: 4, max_length: 16 });
        _: atom <- case rc of {
            (:ok, vc: (:cmd, { op: :set | :get, key: string, values: List[int64, mem(normal)] })) -> show_cmd(vc);
            (:rejected, whyc: atom) -> print_atom(whyc)
        };
        _: atom <- show_sum((:a, 7));
        _: atom <- show_sum((:b, "bee"));
        _: atom <- show_sum(:none);
        _: atom <- show_mixed((:a, 7));
        _: atom <- show_mixed({ x: 3, y: "yy" });
        _: atom <- show_mixed(:none)
    produces
        pure 0
    end
}
