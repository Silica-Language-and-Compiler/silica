// The link vocabulary of transport_links_design.md §3.1 through the built-in Link module (closed, like
// Carrier), the Carrier rows of the ESP32-S3 board carriers (:uart1) and (:usb_serial_jtag) that stage
// S-C added, and a carrier declared with `carried_on` read through its name: Carrier@mtu(test_net) is
// the kind's row, and the framing chosen by it is the kind's framing (§7: the link narrows nothing in
// phases A to C). The declarations are checked against this host's pack: (:loopback) and
// (:serial_port, path, baud) are provided on a hosted target; the serial one is never opened here.
use Link;
use Carrier;
use wireframe;

carried_on test_net: (:tcp) (:loopback);
carried_on readings: (:udp) (:loopback);
carried_on board: (:serial) (:serial_port, "/dev/cu.usbmodem101", 115200);

fn bool_text(b: boolean) -> string {
    case b of {
        true -> "true";
        false -> "false"
    }
}

fn addressing_text(a: atom) -> string {
    case a of {
        :none -> "none";
        :endpoint -> "endpoint";
        :characteristic -> "characteristic";
        :block -> "block";
        _: atom -> "?"
    }
}

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn show_link(name: string, l: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(name);
        _: atom <- print(" known=");
        _: atom <- print(bool_text(Link@known(l)));
        _: atom <- print(" arity=");
        _: atom <- print_int64(Link@arity(l));
        _: atom <- print(" instance_indexed=");
        _: atom <- print(bool_text(Link@instance_indexed(l)));
        _: atom <- print(" tcp=");
        _: atom <- print(bool_text(Link@carries(l, :tcp)));
        _: atom <- print(" udp=");
        _: atom <- print(bool_text(Link@carries(l, :udp)));
        _: atom <- print(" serial=");
        _: atom <- print(bool_text(Link@carries(l, :serial)));
        o: atom <- println("")
    produces
        pure o
    end
}

fn show_carrier(name: string, p: boolean, m: int64, b: atom, d: atom, a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(name);
        _: atom <- print(" provided=");
        _: atom <- print(bool_text(p));
        _: atom <- print(" mtu=");
        _: atom <- print_int64(m);
        _: atom <- print(" boundaries=");
        _: atom <- print_atom(b);
        _: atom <- print(" delivery=");
        _: atom <- print_atom(d);
        _: atom <- print(" addressing=");
        _: atom <- print(addressing_text(a));
        o: atom <- println("")
    produces
        pure o
    end
}

fn show_framing(name: string, segs: List[string, mem(normal)]) -> atom {
    sequence proc[device_io, mem(normal)]
        n: int64 <- length[string, mem(normal)](segs);
        first: string <- first_segment(segs);
        _: atom <- print(name);
        _: atom <- print(" segments=");
        _: atom <- print_int64(n);
        _: atom <- print(" first_length=");
        _: atom <- print_int64(length_bytes(first));
        o: atom <- println("")
    produces
        pure o
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        // §3.1: every link the language names, and one it does not
        _: atom <- show_link("loopback", (:loopback));
        _: atom <- show_link("interface", (:interface));
        _: atom <- show_link("ethernet", (:ethernet));
        _: atom <- show_link("wifi", (:wifi));
        _: atom <- show_link("uart", (:uart));
        _: atom <- show_link("serial_port", (:serial_port));
        _: atom <- show_link("usb_cdc", (:usb_cdc));
        _: atom <- show_link("usb_serial_jtag", (:usb_serial_jtag));
        _: atom <- show_link("loopbak", :loopbak);
        // the board carriers' rows (transport design §6.4): serial links with no address
        _: atom <- show_carrier("uart1", Carrier@provides((:uart1)), Carrier@mtu((:uart1)), Carrier@boundaries((:uart1)), Carrier@delivery((:uart1)), Carrier@addressing((:uart1)));
        _: atom <- show_carrier("usb_serial_jtag", Carrier@provides((:usb_serial_jtag)), Carrier@mtu((:usb_serial_jtag)), Carrier@boundaries((:usb_serial_jtag)), Carrier@delivery((:usb_serial_jtag)), Carrier@addressing((:usb_serial_jtag)));
        // a declared carrier, read through its name: the kind's row
        _: atom <- show_carrier("test_net", Carrier@provides(test_net), Carrier@mtu(test_net), Carrier@boundaries(test_net), Carrier@delivery(test_net), Carrier@addressing(test_net));
        _: atom <- show_carrier("readings", Carrier@provides(readings), Carrier@mtu(readings), Carrier@boundaries(readings), Carrier@delivery(readings), Carrier@addressing(readings));
        _: atom <- show_carrier("board", Carrier@provides(board), Carrier@mtu(board), Carrier@boundaries(board), Carrier@delivery(board), Carrier@addressing(board));
        // §7: the framing of a declared carrier is the kind's framing
        tcp_segs: List[string, mem(normal)] <- wireframe@frame("abc", Carrier@mtu(test_net), Carrier@boundaries(test_net));
        _: atom <- show_framing("test_net", tcp_segs);
        udp_segs: List[string, mem(normal)] <- wireframe@frame("abc", Carrier@mtu(readings), Carrier@boundaries(readings));
        _: atom <- show_framing("readings", udp_segs);
        st: { mode: atom, expected: int64, pending: string } <- wireframe@fresh(Carrier@boundaries(board));
        _: atom <- print("board fresh mode=");
        _: atom <- print_atom(st.mode);
        _: atom <- println("")
    produces
        pure 0
    end
}
