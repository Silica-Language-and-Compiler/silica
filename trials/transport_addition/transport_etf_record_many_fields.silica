// SD-37 (BEES request C1, 2026-11-17): the derived record decoder passed one parameter per field to its pair walker, so a record of more than four fields hit the 8-register-argument limit (E1070). The walker now takes its slots as one record, for any field count. Here: 12 fields (int64, string, atom cycling). Expected: see .scout.
use wire_etf;

fn show(w: { fa: int64, fb: string, fc: atom, fd: int64, fe: string, ff: atom, fg: int64, fh: string, fi: atom, fj: int64, fk: string, fl: atom }) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(w.fa);
        _: atom <- println("");
        _: atom <- print(w.fb);
        _: atom <- println("");
        _: atom <- print_atom(w.fc);
        _: atom <- println("");
        _: atom <- print_int64(w.fd);
        _: atom <- println("");
        _: atom <- print(w.fe);
        _: atom <- println("");
        _: atom <- print_atom(w.ff);
        _: atom <- println("");
        _: atom <- print_int64(w.fg);
        _: atom <- println("");
        _: atom <- print(w.fh);
        _: atom <- println("");
        _: atom <- print_atom(w.fi);
        _: atom <- println("");
        _: atom <- print_int64(w.fj);
        _: atom <- println("");
        _: atom <- print(w.fk);
        _: atom <- println("");
        _: atom <- print_atom(w.fl);
        _: atom <- println("");
        out: atom <- println("end")
    produces
        pure out
    end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        v: { fa: int64, fb: string, fc: atom, fd: int64, fe: string, ff: atom, fg: int64, fh: string, fi: atom, fj: int64, fk: string, fl: atom } <- { fa: 100, fb: "s1", fc: :gamma, fd: 103, fe: "s4", ff: :beta, fg: 106, fh: "s7", fi: :alpha, fj: 109, fk: "s10", fl: :delta };
        frame: string <- encode((:etf), v);
        _: atom <- print_int64(length_bytes(frame));
        _: atom <- println("");
        r: (:ok, { fa: int64, fb: string, fc: atom, fd: int64, fe: string, ff: atom, fg: int64, fh: string, fi: atom, fj: int64, fk: string, fl: atom }) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 4096, max_depth: 4, max_length: 256 });
        _: atom <- case r of {
            (:ok, w: { fa: int64, fb: string, fc: atom, fd: int64, fe: string, ff: atom, fg: int64, fh: string, fi: atom, fj: int64, fk: string, fl: atom }) -> show(w);
            (:rejected, why: atom) -> print_atom(why)
        };
        out: atom <- println("done")
    produces
        pure 0
    end
}
