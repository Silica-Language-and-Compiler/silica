// ETF scalars (transport_serialization_design.md §4.7): every scalar kind encodes to the bytes
// term_to_binary writes, and decodes back; the older atom tags decode too.
use trial_support_hex;


fn show_int64(v: int64) -> atom {
    sequence proc[mem(normal), device_io]
        frame: string <- encode((:etf), v);
        _: atom <- println(trial_support_hex@hex(frame));
        r: (:ok, int64) | (:rejected, atom) <- decode((:etf), frame);
        out: atom <- case r of {
            (:ok, w: int64) -> case w == v of {
                true -> println("round trip");
                false -> println("round trip differs")
            };
            (:rejected, why: atom) -> print_atom(why)
        }
    produces
        pure out
    end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        _: atom <- show_int64(0);
        _: atom <- show_int64(255);
        _: atom <- show_int64(256);
        _: atom <- show_int64(-1);
        _: atom <- show_int64(-2147483648);
        _: atom <- show_int64(2147483648);
        _: atom <- show_int64(9223372036854775807);
        _: atom <- show_int64(-9223372036854775807 - 1);
        big: uint64 <- to_uint64(-1);
        fb: string <- encode((:etf), big);
        _: atom <- println(trial_support_hex@hex(fb));
        rb: (:ok, uint64) | (:rejected, atom) <- decode((:etf), fb);
        _: atom <- case rb of {
            (:ok, wb: uint64) -> print_uint64(wb);
            (:rejected, whyb: atom) -> print_atom(whyb)
        };
        _: atom <- println("");
        small: int16 <- -3;
        fs: string <- encode((:etf), small);
        _: atom <- println(trial_support_hex@hex(fs));
        rs: (:ok, int16) | (:rejected, atom) <- decode((:etf), fs);
        _: atom <- case rs of {
            (:ok, ws: int16) -> print_int16(ws);
            (:rejected, whys: atom) -> print_atom(whys)
        };
        _: atom <- println("");
        f: float64 <- 1.5;
        ff: string <- encode((:etf), f);
        _: atom <- println(trial_support_hex@hex(ff));
        rf: (:ok, float64) | (:rejected, atom) <- decode((:etf), ff);
        _: atom <- case rf of {
            (:ok, wf: float64) -> case wf == f of {
                true -> println("float64 round trip");
                false -> println("float64 differs")
            };
            (:rejected, whyf: atom) -> print_atom(whyf)
        };
        f3: float32 <- 2.5;
        ff3: string <- encode((:etf), f3);
        _: atom <- println(trial_support_hex@hex(ff3));
        rf3: (:ok, float32) | (:rejected, atom) <- decode((:etf), ff3);
        _: atom <- case rf3 of {
            (:ok, wf3: float32) -> case wf3 == f3 of {
                true -> println("float32 round trip");
                false -> println("float32 differs")
            };
            (:rejected, whyf3: atom) -> print_atom(whyf3)
        };
        t: boolean <- true;
        ft: string <- encode((:etf), t);
        _: atom <- println(trial_support_hex@hex(ft));
        rt: (:ok, boolean) | (:rejected, atom) <- decode((:etf), ft);
        _: atom <- case rt of {
            (:ok, wt: boolean) -> print_boolean(wt);
            (:rejected, whyt: atom) -> print_atom(whyt)
        };
        _: atom <- println("");
        fu: string <- encode((:etf), ());
        _: atom <- println(trial_support_hex@hex(fu));
        ru: (:ok, unit) | (:rejected, atom) <- decode((:etf), fu);
        _: atom <- case ru of {
            (:ok, _wu: unit) -> println("unit round trip");
            (:rejected, whyu: atom) -> print_atom(whyu)
        };
        a: atom <- :ok;
        fa: string <- encode((:etf), a);
        _: atom <- println(trial_support_hex@hex(fa));
        ra: (:ok, atom) | (:rejected, atom) <- decode((:etf), fa);
        _: atom <- case ra of {
            (:ok, wa: atom) -> print_atom(wa);
            (:rejected, whya: atom) -> print_atom(whya)
        };
        _: atom <- println("");
        oe: :ok | :error <- :error;
        foe: string <- encode((:etf), oe);
        _: atom <- println(trial_support_hex@hex(foe));
        roe: (:ok, :ok | :error) | (:rejected, atom) <- decode((:etf), foe);
        _: atom <- case roe of {
            (:ok, woe: :ok | :error) -> case woe of {
                :ok -> println("ok");
                :error -> println("error")
            };
            (:rejected, whyoe: atom) -> print_atom(whyoe)
        };
        s: string <- "hello";
        fstr: string <- encode((:etf), s);
        _: atom <- println(trial_support_hex@hex(fstr));
        rstr: (:ok, string) | (:rejected, atom) <- decode((:etf), fstr, { max_bytes: 64 });
        _: atom <- case rstr of {
            (:ok, ws2: string) -> println(ws2);
            (:rejected, whys2: atom) -> print_atom(whys2)
        };
        e: string <- "";
        fe: string <- encode((:etf), e);
        _: atom <- println(trial_support_hex@hex(fe));
        // ATOM_EXT (100), the deprecated Latin-1 tag, still decodes.
        old: List[int64, mem(normal)] <- [131, 100, 0, 2, 111, 107];
        fold: string <- bytes_of(old);
        rold: (:ok, atom) | (:rejected, atom) <- decode((:etf), fold);
        _: atom <- case rold of {
            (:ok, wold: atom) -> print_atom(wold);
            (:rejected, whyold: atom) -> print_atom(whyold)
        };
        _: atom <- println("");
        // STRING_EXT (107), an Erlang charlist, decodes into a string.
        cl: List[int64, mem(normal)] <- [131, 107, 0, 2, 104, 105];
        fcl: string <- bytes_of(cl);
        rcl: (:ok, string) | (:rejected, atom) <- decode((:etf), fcl, { max_bytes: 64 });
        _: atom <- case rcl of {
            (:ok, wcl: string) -> println(wcl);
            (:rejected, whycl: atom) -> print_atom(whycl)
        }
    produces
        pure 0
    end
}
