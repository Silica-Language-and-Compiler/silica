// SD-39 (BEES request C3, 2026-11-17): an actor whose state holds a dangerous_actor_ref. The state-release
// proof (sir_state_release.silica, sr_type_may_point) counted dangerous_actor_ref as pointer-carrying, so a
// behaviour that stores one in its state (the (:set, c) arm) was unproven (W2300) and took a whole-state
// copy at every dispatch. A dangerous_actor_ref is a plain word, like actor_ref. The program output is
// the same either way (1000); the assembly golden is the guard: the holder epilogue sets the proof flag
// (MOV X11, #1) and the behaviour prefix word is 0x5C1AC0F6 (0x5C1AC0F2 before the fix).
module dangerous_state_holds_carrier_ref;

use dangerous_sockets;
use dangerous_tcp_carrier;

fn region_dump_limit() -> int64 {
    0
}

fn reporter(msg: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + 1)
}

fn sink(msg: (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom), state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn holder(msg: (:tick, int64) | (:set, dangerous_actor_ref), state: { car: dangerous_actor_ref, n: int64 }) -> (:no_reply, { car: dangerous_actor_ref, n: int64 }) {
    case msg of {
        (:set, c: dangerous_actor_ref) -> (:no_reply, { car: c, n: state.n });
        (:tick, k: int64) -> {
            sequence proc[concurrency, device_io]
                _: boolean <- case k == 0 of {
                    true -> {
                        print_int64(state.n);
                        println("");
                        cast_exit(0)
                    };
                    false -> cast(self(), (:tick, k - 1) impl ActorMessage {})
                }
            produces
                pure (:no_reply, { car: state.car, n: state.n + 1 })
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        car1: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        car2: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        a: actor_ref <- spawn({ car: car1, n: 0 }, holder, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(a, (:set, car2) impl ActorMessage {});
        _: boolean <- cast(a, (:tick, 1000) impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
