// A (:udp) carrier on (:loopback) opened with an explicit local IPv4 address inside 127.0.0.0/8 (hosted Ethernet plan E2,
// transport_links_design.md §3.2): "127.0.0.1:9@127.0.0.1:0" binds 127.0.0.1 on a port the system picks and answers
// (:link_up, _). The owner prints one line and ends the program. Port 0 keeps the trial off any fixed port.
module dangerous_udp_link_listen_ip;

use dangerous_sockets;

carried_on net: (:udp) (:loopback);

fn region_dump_limit() -> int64 {
    0
}

fn reporter(_msg: string, state: { seen: int64, report: string }) -> (:no_reply, { seen: int64, report: string }) {
    (:no_reply, state)
}

fn owner(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
         state: { reporter: actor_ref })
    -> (:no_reply, { reporter: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- println("up");
                _: boolean <- cast_exit(0)
            produces
                pure (:no_reply, state)
            end
        };
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_credit, _n2: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, why2: atom) -> {
            sequence proc[concurrency]
                _: boolean <- case why2 of {
                    :fault -> cast(state.reporter, "link_down:fault" impl ActorMessage {});
                    _: atom -> cast_exit(2)
                }
            produces
                pure (:no_reply, state)
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn({ seen: 0, report: "" }, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        car: dangerous_actor_ref <- spawn_dangerous_carrier(net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        own: actor_ref <- spawn({ reporter: rep }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(car, (:open, own, "127.0.0.1:9@127.0.0.1:0") impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
