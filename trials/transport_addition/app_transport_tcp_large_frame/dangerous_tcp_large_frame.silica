// A (:tcp) frame larger than 65,536 bytes (E8, transport_hosted_ethernet_plan.md): over loopback, with the E8 dial form
// "<ipv4>:<port>:<timeout_ms>", the client sends one 70,000-byte frame (4-byte length prefix, no wire-format change) and the
// accepted session, whose max_frame is 1,000,000, receives it intact: the length and the bytes either side of 65,536 are shown.
module dangerous_tcp_large_frame;

use wireframe;
use Carrier;
use dangerous_sockets;

fn region_dump_limit() -> int64 {
    0
}

// The program's own failure reporter is the ONLY writer to standard output. The receiving session casts the one line
// the program shows to the reporter as "T:<line>"; when it arrives the reporter prints it, then "done", and ends the
// program. No carrier is closed, so no carrier end report (and no runtime banner) can race the output.
fn reporter(msg: string, state: { seen: int64, out: string }) -> (:no_reply, { seen: int64, out: string }) {
    sequence proc[concurrency, device_io]
        is_text: boolean <- starts_with(msg, "T:");
        seen: int64 <- case is_text of { true -> state.seen + 1; false -> state.seen };
        out: string <- case is_text of {
            true -> concat(state.out, substring(msg, 2, length_bytes(msg)));
            false -> state.out
        };
        _: boolean <- case is_text and seen == 1 of {
            true -> {
                _: atom <- print(out);
                _: atom <- println("done");
                cast_exit(0)
            };
            false -> true
        }
    produces
        pure (:no_reply, { seen: seen, out: out })
    end
}

carried_on test_net: (:tcp) (:loopback);

// Decimal text of a non-negative int64 (dangerous_tcp_carrier's int_text is not exported).
fn num_text_from(n: int64, acc: string) -> string {
    case n < 10 of {
        true -> concat(substring("0123456789", n, n + 1), acc);
        false -> num_text_from(n / 10, concat(substring("0123456789", n % 10, n % 10 + 1), acc))
    }
}

fn num_text(n: int64) -> string {
    num_text_from(n, "")
}

// The largest frame the receiving session assembles (wireframe@unframe's max_frame).
fn max_frame() -> int64 {
    1000000
}

// A frame's payload is 70,000 bytes, more than 65,536: byte i is the decimal digit i % 10 (ASCII 48 + i % 10). It is
// built from 10 bytes by tens, then seven times.
fn rep10(s: string) -> string {
    sequence proc[mem(normal), transport]
        parts: List[string, mem(normal)] <- [s, s, s, s, s, s, s, s, s, s];
        out: string <- join_bytes(parts)
    produces
        pure out
    end
}

fn rep7(s: string) -> string {
    sequence proc[mem(normal), transport]
        parts: List[string, mem(normal)] <- [s, s, s, s, s, s, s];
        out: string <- join_bytes(parts)
    produces
        pure out
    end
}

fn payload() -> string {
    rep7(rep10(rep10(rep10("0123456789"))))
}

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

// Frames the payload (the 4-byte length prefix and the bytes) and casts it to the carrier as one segment.
fn send_big(car: dangerous_actor_ref) -> boolean {
    sequence proc[concurrency]
        segs: List[string, mem(normal)] <- wireframe@frame(payload(), Carrier@mtu(test_net), Carrier@boundaries(test_net));
        seg: string <- first_segment(segs);
        sent: boolean <- cast(car, (:tx, seg, self()) impl ActorMessage {})
    produces
        pure sent
    end
}

// The line shown for a received frame: its length and four sampled bytes, two of them either side of byte 65,536.
fn frame_line(frame: string) -> string {
    sequence proc[transport]
        n: int64 <- length_bytes(frame);
        b0: int64 <- byte_at(frame, 0);
        b65535: int64 <- byte_at(frame, 65535);
        b65536: int64 <- byte_at(frame, 65536);
        blast: int64 <- byte_at(frame, 69999);
        ok: boolean <- n == 70000 and b0 == 48 and b65535 == 53 and b65536 == 54 and blast == 57;
        line: string <- case ok of {
            true -> concat("T:frame ", concat(num_text(n), " intact\n"));
            false -> "T:frame damaged\n"
        }
    produces
        pure line
    end
}

fn reject_line(why: atom) -> string {
    case why of {
        :too_large -> "T:rejected too_large\n";
        _: atom -> "T:rejected other\n"
    }
}

// The listener's owner: on :link_up it starts the client against the port the listener got (the dial states a
// 3000 ms connect timeout); each accepted connection gets a session actor, which opens it.
fn server(msg: (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, info: string) -> case starts_with(info, "port:") of {
            true -> {
                sequence proc[concurrency]
                    cli_link: dangerous_actor_ref <- spawn_dangerous_carrier(test_net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    cli: actor_ref <- spawn({ car: cli_link, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: state.rep }, client, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    _: boolean <- cast(cli_link, (:open, cli, concat(concat("127.0.0.1:", substring(info, 5, length_bytes(info))), ":3000")) impl ActorMessage {})
                produces
                    pure (:no_reply, state)
                end
            };
            false -> (:no_reply, state)
        };
        (:accepted, conn: dangerous_actor_ref, _info: string) -> {
            sequence proc[concurrency]
                ses: actor_ref <- spawn({ car: conn, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: state.rep }, session, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(conn, (:open, ses, "") impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, _why3: atom) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.rep, "T:tx_failed\n" impl ActorMessage {})
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// The accepted connection's owner: opens it with receive credit for 64 segments (the carrier reads at most 65,536
// bytes at a time, so the frame arrives in several segments) and assembles the frame with wireframe@unframe,
// max_frame() as the limit. What it shows is the whole outcome.
fn session(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
           state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 64) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, segment: string) -> {
            sequence
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, max_frame());
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[concurrency]
                            _: boolean <- cast(state.rep, frame_line(frame) impl ActorMessage {})
                        produces pure r2 end
                    };
                    (:rejected, why2: atom) -> {
                        sequence proc[concurrency]
                            _: boolean <- cast(state.rep, reject_line(why2) impl ActorMessage {})
                        produces pure state.rx end
                    }
                }
            produces
                pure (:no_reply, { car: state.car, rx: rx2, credits: state.credits, rep: state.rep })
            end
        };
        (:tx_failed, _why3: atom) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.rep, "T:tx_failed\n" impl ActorMessage {})
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// The client's owner: on :link_up it sends the one 70,000-byte frame; it shows nothing.
fn client(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence
                _: boolean <- send_big(state.car)
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, _why3: atom) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.rep, "T:tx_failed\n" impl ActorMessage {})
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn({ seen: 0, out: "" }, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        srv_link: dangerous_actor_ref <- spawn_dangerous_carrier(test_net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        srv: actor_ref <- spawn({ car: srv_link, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: rep }, server, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(srv_link, (:open, srv, "listen:0") impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
