// A (:tcp) exchange from both sides in one program, over two connections (E3, transport_hosted_ethernet_plan.md).
// Connection A: a listener and a dialing client; the client sends (:ping, 7) and the accepted session answers
// (:pong, 8). Only after that answer is printed does the client start connection B, a second listener, where the
// roles are reversed: the accepted session sends (:ping, 9) and the dialer answers (:pong, 10). Starting B after
// A's answer makes the output order deterministic. Frames are length-prefixed ETF (design §5, §4.7).
module dangerous_tcp_both_sides;

use wire_etf;
use wireframe;
use Carrier;
use dangerous_sockets;
use dangerous_tcp_carrier;

fn region_dump_limit() -> int64 {
    0
}

// The program's own failure reporter is the ONLY writer to standard output (the runtime's banners for the
// carriers' ends are written by the carriers' threads, so any actor that printed would race them). Each actor casts
// the line it would show to the reporter as "T:<line>"; the reporter also receives the carriers' end reports, and
// when all 8 messages (carrier reports plus lines) have arrived it prints the collected lines in arrival order,
// then "done", and ends the program.
fn reporter(msg: string, state: { seen: int64, out: string }) -> (:no_reply, { seen: int64, out: string }) {
    sequence proc[concurrency, device_io]
        is_text: boolean <- starts_with(msg, "T:");
        seen: int64 <- state.seen + 1;
        out: string <- case is_text of {
            true -> concat(state.out, substring(msg, 2, length_bytes(msg)));
            false -> state.out
        };
        _: boolean <- case seen == 8 of {
            true -> {
                _: atom <- print(out);
                _: atom <- println("done");
                cast_exit(0)
            };
            false -> true
        }
    produces
        pure (:no_reply, { seen: seen, out: out })
    end
}


// The carriers are declared on the host's loopback interface (transport_links_design.md §3.3):
// spawn_dangerous_carrier(test_net, ...) starts dangerous_tcp_carrier for the kind, and Carrier@mtu(test_net)
// is the kind's row. One declaration serves the listener, its connections and the client: a loopback
// link is not exclusive hardware.
carried_on test_net: (:tcp) (:loopback);

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn send_term(car: dangerous_actor_ref, v: (:ping, int64) | (:pong, int64)) -> boolean {
    sequence proc[mem(normal), concurrency, transport]
        frame: string <- encode((:etf), v);
        segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu(test_net), Carrier@boundaries(test_net));
        seg: string <- first_segment(segs);
        sent: boolean <- cast(car, (:tx, seg, self()) impl ActorMessage {})
    produces
        pure sent
    end
}

// Every line the program shows is cast to the failure reporter as "T:<line>"; the reporter is the only writer.
fn term_line(v: (:ping, int64) | (:pong, int64)) -> string {
    case v of {
        (:ping, n: int64) -> case n == 7 of { true -> "T:ping 7\n"; false -> "T:ping 9\n" };
        (:pong, n: int64) -> case n == 8 of { true -> "T:pong 8\n"; false -> "T:pong 10\n" }
    }
}

// Connection A. The listener's owner starts the client on the port the listener was given; each accepted
// connection gets a session actor, which opens it.
fn server_a(msg: (:link_up, string) | (:accepted, int64, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, info: string) -> case starts_with(info, "port:") of {
            // bound: start the dialing side against the port the listener got
            true -> {
                sequence proc[concurrency]
                    cli_link: dangerous_actor_ref <- spawn_dangerous_carrier(test_net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    cli: actor_ref <- spawn({ car: cli_link, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: state.rep }, client_a, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    _: boolean <- cast(cli_link, (:open, cli, concat(concat("127.0.0.1:", substring(info, 5, length_bytes(info))), ":3000")) impl ActorMessage {})
                produces
                    pure (:no_reply, state)
                end
            };
            false -> (:no_reply, state)
        };
        (:accepted, fd: int64, _info: string) -> {
            sequence proc[concurrency]
                conn: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: fd, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                ses: actor_ref <- spawn({ car: conn, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: state.rep }, session_a, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(conn, (:open, ses, "") impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// Connection A, the accepted side: shows (:ping, 7) and answers (:pong, 8).
fn session_a(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, segment: string) -> {
            sequence
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), concurrency, transport]
                            decoded: (:ok, (:ping, int64) | (:pong, int64)) | (:rejected, atom) <- decode((:etf), frame);
                            _: boolean <- case decoded of {
                                (:ok, v: (:ping, int64) | (:pong, int64)) -> cast(state.rep, term_line(v) impl ActorMessage {});
                                (:rejected, _why: atom) -> cast(state.rep, "T:rejected\n" impl ActorMessage {})
                            };
                            _: boolean <- send_term(state.car, (:pong, 8))
                        produces pure r2 end
                    };
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why2)
                        produces pure state.rx end
                    }
                }
            produces
                pure (:no_reply, { car: state.car, rx: rx2, credits: state.credits, rep: state.rep })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// Connection A, the dialing side: on :link_up it sends (:ping, 7); the answer is shown, the connection is
// closed and connection B is started: a second listener, whose owner starts the dialer of B.
fn client_a(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {});
                _: boolean <- send_term(state.car, (:ping, 7))
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, segment: string) -> {
            sequence
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), concurrency, transport]
                            decoded: (:ok, (:ping, int64) | (:pong, int64)) | (:rejected, atom) <- decode((:etf), frame);
                            _: boolean <- case decoded of {
                                (:ok, v: (:ping, int64) | (:pong, int64)) -> cast(state.rep, term_line(v) impl ActorMessage {});
                                (:rejected, _why: atom) -> cast(state.rep, "T:rejected\n" impl ActorMessage {})
                            };
                            _: boolean <- cast(state.car, :close impl ActorMessage {});
                            lis_link: dangerous_actor_ref <- spawn_dangerous_carrier(test_net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                            lis: actor_ref <- spawn({ car: lis_link, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: state.rep }, server_b, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                            _: boolean <- cast(lis_link, (:open, lis, "listen:0") impl ActorMessage {})
                        produces pure r2 end
                    };
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why2)
                        produces pure state.rx end
                    }
                }
            produces
                pure (:no_reply, { car: state.car, rx: rx2, credits: state.credits, rep: state.rep })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// Connection B, the roles reversed. The listener's owner starts the dialer on the port the listener was
// given; the accepted session is the side that sends.
fn server_b(msg: (:link_up, string) | (:accepted, int64, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, info: string) -> case starts_with(info, "port:") of {
            // bound: start the dialing side against the port the listener got
            true -> {
                sequence proc[concurrency]
                    cli_link: dangerous_actor_ref <- spawn_dangerous_carrier(test_net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    cli: actor_ref <- spawn({ car: cli_link, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: state.rep }, responder_b, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    _: boolean <- cast(cli_link, (:open, cli, concat(concat("127.0.0.1:", substring(info, 5, length_bytes(info))), ":3000")) impl ActorMessage {})
                produces
                    pure (:no_reply, state)
                end
            };
            false -> (:no_reply, state)
        };
        (:accepted, fd: int64, _info: string) -> {
            sequence proc[concurrency]
                conn: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: fd, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                ses: actor_ref <- spawn({ car: conn, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: state.rep }, session_b, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(conn, (:open, ses, "") impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// Connection B, the accepted side: on :link_up it sends (:ping, 9); the answer is shown and the connection closed.
fn session_b(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {});
                _: boolean <- send_term(state.car, (:ping, 9))
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, segment: string) -> {
            sequence
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), concurrency, transport]
                            decoded: (:ok, (:ping, int64) | (:pong, int64)) | (:rejected, atom) <- decode((:etf), frame);
                            _: boolean <- case decoded of {
                                (:ok, v: (:ping, int64) | (:pong, int64)) -> cast(state.rep, term_line(v) impl ActorMessage {});
                                (:rejected, _why: atom) -> cast(state.rep, "T:rejected\n" impl ActorMessage {})
                            };
                            _: boolean <- cast(state.car, :close impl ActorMessage {})
                        produces pure r2 end
                    };
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why2)
                        produces pure state.rx end
                    }
                }
            produces
                pure (:no_reply, { car: state.car, rx: rx2, credits: state.credits, rep: state.rep })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// Connection B, the dialing side: shows (:ping, 9) and answers (:pong, 10).
fn responder_b(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, credits: int64, rep: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, credits: state.credits + n, rep: state.rep });
        (:rx, segment: string) -> {
            sequence
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), concurrency, transport]
                            decoded: (:ok, (:ping, int64) | (:pong, int64)) | (:rejected, atom) <- decode((:etf), frame);
                            _: boolean <- case decoded of {
                                (:ok, v: (:ping, int64) | (:pong, int64)) -> cast(state.rep, term_line(v) impl ActorMessage {});
                                (:rejected, _why: atom) -> cast(state.rep, "T:rejected\n" impl ActorMessage {})
                            };
                            _: boolean <- send_term(state.car, (:pong, 10))
                        produces pure r2 end
                    };
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why2)
                        produces pure state.rx end
                    }
                }
            produces
                pure (:no_reply, { car: state.car, rx: rx2, credits: state.credits, rep: state.rep })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn({ seen: 0, out: "" }, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        srv_link: dangerous_actor_ref <- spawn_dangerous_carrier(test_net, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        srv: actor_ref <- spawn({ car: srv_link, rx: wireframe@fresh(Carrier@boundaries(test_net)), credits: 0, rep: rep }, server_a, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(srv_link, (:open, srv, "listen:0") impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
