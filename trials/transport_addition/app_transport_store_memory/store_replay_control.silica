// Replay over what a real log holds, and the refusals of the vocabulary (design §6.8.2, §6.8.3).
// Frames are cut for a 12-byte record so that "alpha-alpha-alpha" is three records (A0, A1, A2) and
// "bravo" is one (B0). The log is written as A0 A1 | B0 | A0 A1 A2: the first two records are the front
// of a frame whose end never arrived, as after a crash in the middle of a frame.
//   - A replay from 0 drops the orphaned front when the next frame-start record arrives and gives
//     "bravo", then the whole "alpha-alpha-alpha".
//   - A replay from 4 lands inside a frame: records 4 and 5 (A1, A2) continue nothing and are skipped.
//   - One replay at a time: a (:read, 2) during a replay is (:read_failed, :busy); :read_stop ends the
//     replay with (:rx_end, 1), the first record not delivered.
//   - A second (:open, ...) of an open region is answered (:link_down, :in_use) and changes nothing.
//   - (:read, 99) is :beyond_tail; an empty record is refused with :empty and a 5000-byte one with
//     :too_long, and neither takes a number: the (:synced, 6) that follows says so.
module store_replay_control;

use wireframe;
use Carrier;
use storelog;
use trial_wait_int64;

carried_on journal: (:store) (:memory, 16384, :stop);

fn alpha() -> List[string, mem(normal)] {
    wireframe@frame("alpha-alpha-alpha", 12, :storage)
}

fn bravo() -> List[string, mem(normal)] {
    wireframe@frame("bravo", 12, :storage)
}

fn show_frame(f: string) -> atom {
    say_text("rx frame ", f)
}

fn open_again(car: actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:open, self(), "") impl ActorMessage {})
    produces
        pure r
    end
}

// A replayed record goes through the :storage framing; a whole frame is shown by show_frame.
fn shown(segment: string, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    reframed(wireframe@unframe(st.rx, segment, 64), st)
}

fn reframed(r: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom), st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    case r of {
        (:more, rx1: { mode: atom, expected: int64, pending: string }) -> more(rx1, st);
        (:frame, f: string, rx2: { mode: atom, expected: int64, pending: string }) -> framed(f, rx2, st);
        (:rejected, why: atom) -> rejected(why, st)
    }
}

fn more(rx1: { mode: atom, expected: int64, pending: string }, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    _: atom <- say_n("rx more, waiting for record ", rx1.expected);
    { car: st.car, step: st.step, left: st.left, rx: rx1 }
}

fn framed(f: string, rx2: { mode: atom, expected: int64, pending: string }, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    _: atom <- show_frame(f);
    { car: st.car, step: st.step, left: st.left, rx: rx2 }
}

fn rejected(why: atom, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    _: atom <- say_atom("rx rejected ", why);
    { car: st.car, step: st.step, left: st.left, rx: wireframe@fresh(:storage) }
}

fn expect(step: int64) -> atom {
    case step of {
        0 -> :link_up;
        1 -> :log;
        2 -> :tx_credit;
        3 -> :tx_credit;
        4 -> :synced;
        5 -> :rx;
        6 -> :rx_end;
        7 -> :rx;
        8 -> :rx_end;
        9 -> :rx;
        10 -> :read_failed;
        11 -> :rx_end;
        12 -> :link_down;
        13 -> :read_failed;
        14 -> :tx_failed;
        15 -> :tx_failed;
        16 -> :synced;
        17 -> :link_down;
        18 -> :settled;
        _: int64 -> :never
    }
}

fn need(step: int64) -> int64 {
    case step of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> 1;
        4 -> 1;
        5 -> 6;
        6 -> 1;
        7 -> 2;
        8 -> 1;
        9 -> 1;
        10 -> 1;
        11 -> 1;
        12 -> 1;
        13 -> 1;
        14 -> 1;
        15 -> 1;
        16 -> 1;
        17 -> 1;
        18 -> 1;
        _: int64 -> 1
    }
}

fn act(step: int64, car: actor_ref) -> boolean {
    case step of {
        2 -> act2(car);
        4 -> act4(car);
        6 -> act6(car);
        8 -> act8(car);
        9 -> act9(car);
        10 -> act10(car);
        11 -> act11(car);
        12 -> act12(car);
        13 -> act13(car);
        14 -> act14(car);
        15 -> act15(car);
        16 -> act16(car);
        17 -> act17(car);
        18 -> act18(car);
        _: int64 -> true
    }
}

fn act2(car: actor_ref) -> boolean {
    _: boolean <- tx(car, nth(alpha(), 0));
    _: boolean <- tx(car, nth(alpha(), 1));
    _: boolean <- tx_all(car, bravo());
    _: boolean <- tx_all(car, alpha());
    ask_sync(car)
}

fn act4(car: actor_ref) -> boolean {
    _: boolean <- ask_read(car, 0);
    give_credit(car, 6)
}

fn act6(car: actor_ref) -> boolean {
    _: boolean <- ask_read(car, 4);
    give_credit(car, 2)
}

fn act8(car: actor_ref) -> boolean {
    _: boolean <- ask_read(car, 0);
    give_credit(car, 1)
}

fn act9(car: actor_ref) -> boolean {
    ask_read(car, 2)
}

fn act10(car: actor_ref) -> boolean {
    ask_read_stop(car)
}

fn act11(car: actor_ref) -> boolean {
    open_again(car)
}

fn act12(car: actor_ref) -> boolean {
    ask_read(car, 99)
}

fn act13(car: actor_ref) -> boolean {
    tx(car, "")
}

fn act14(car: actor_ref) -> boolean {
    tx(car, storelog@zeros(5000))
}

fn act15(car: actor_ref) -> boolean {
    ask_sync(car)
}

fn act16(car: actor_ref) -> boolean {
    ask_close(car)
}

fn act17(car: actor_ref) -> boolean {
    settle()
}

fn act18(car: actor_ref) -> boolean {
    finished()
}

fn say_n(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces
        pure o
    end
}

fn say_atom(label: string, a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_atom(a);
        o: atom <- println("")
    produces
        pure o
    end
}

fn say_text(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        o: atom <- println(s)
    produces
        pure o
    end
}

fn say_log(oldest: int64, nx: int64, capacity: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print("log oldest=");
        _: atom <- print_int64(oldest);
        _: atom <- print(" next=");
        _: atom <- print_int64(nx);
        _: atom <- print(" capacity=");
        _: atom <- print_int64(capacity);
        o: atom <- println("")
    produces
        pure o
    end
}

fn tx(car: actor_ref, s: string) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:tx, s, self()) impl ActorMessage {})
    produces
        pure r
    end
}

// n records of `size` zero bytes each.
fn tx_zeros(car: actor_ref, n: int64, size: int64) -> boolean {
    case n <= 0 of {
        true -> true;
        false -> {
            _: boolean <- tx(car, storelog@zeros(size));
            tx_zeros(car, n - 1, size)
        }
    }
}

fn tx_all(car: actor_ref, segs: List[string, mem(normal)]) -> boolean {
    case segs of {
        []: List[string, mem(normal)] -> true;
        [h: string, t: List[string, mem(normal)]] -> {
            _: boolean <- tx(car, h);
            tx_all(car, t)
        }
    }
}

fn nth(xs: List[string, mem(normal)], i: int64) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, t: List[string, mem(normal)]] -> case i == 0 of { true -> h; false -> nth(t, i - 1) }
    }
}

fn ask_sync(car: actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, :sync impl ActorMessage {})
    produces
        pure r
    end
}

fn ask_read(car: actor_ref, from: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:read, from) impl ActorMessage {})
    produces
        pure r
    end
}

fn ask_read_stop(car: actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, :read_stop impl ActorMessage {})
    produces
        pure r
    end
}

fn give_credit(car: actor_ref, n: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:credit, n) impl ActorMessage {})
    produces
        pure r
    end
}

fn ask_trim(car: actor_ref, upto: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:trim, upto) impl ActorMessage {})
    produces
        pure r
    end
}

fn ask_close(car: actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, :close impl ActorMessage {})
    produces
        pure r
    end
}

// The carrier ends after :close and, having no supervisor, its normal exit is reported on standard
// error. The owner waits for that report before it prints the carrier's last message and the line
// the trial run ends at.
fn settle() -> boolean {
    sequence proc[concurrency]
        _: timer_ref <- send_after(300, self(), :settled impl ActorMessage {})
    produces
        pure true
    end
}

fn finished() -> boolean {
    sequence proc[device_io]
        _: atom <- println("link_down :closed");
        _: atom <- println("done")
    produces
        pure true
    end
}

// The script: at each step the owner waits for need(step) events of the kind expect(step), then
// act(step) runs and the next step begins. Every event is printed as it arrives, awaited or not.
fn progress(e: atom, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    case e == expect(st.step) of {
        false -> st;
        true -> case st.left > 1 of {
            true -> { car: st.car, step: st.step, left: st.left - 1, rx: st.rx };
            false -> acted(st)
        }
    }
}

fn acted(st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } } {
    _: boolean <- act(st.step, st.car);
    { car: st.car, step: st.step + 1, left: need(st.step + 1), rx: st.rx }
}

fn on_text(label: string, s: string, e: atom, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_text(label, s);
    (:no_reply, progress(e, st))
}

fn on_n(label: string, n: int64, e: atom, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_n(label, n);
    (:no_reply, progress(e, st))
}

fn on_atom(label: string, a: atom, e: atom, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_atom(label, a);
    (:no_reply, progress(e, st))
}

// The carrier's last message. (:link_down, :closed) is printed by finished(), after the carrier's exit
// report: the report is written by another thread and would otherwise land before or after this line.
fn on_link_down(why: atom, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    case why == :closed of {
        true -> (:no_reply, progress(:link_down, st));
        false -> on_atom("link_down ", why, :link_down, st)
    }
}

fn on_log(oldest: int64, nx: int64, capacity: int64, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_log(oldest, nx, capacity);
    (:no_reply, progress(:log, st))
}

fn on_rx(segment: string, st: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    (:no_reply, progress(:rx, shown(segment, st)))
}

fn owner(msg: (:link_up, string) | (:log, int64, int64, int64) | (:tx_credit, int64) | (:synced, int64) | (:rx, string) | (:rx_end, int64) | (:tx_failed, atom) | (:read_failed, atom) | (:link_down, atom) | :settled, state: { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: actor_ref, step: int64, left: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    case msg of {
        (:link_up, info: string) -> on_text("link_up ", info, :link_up, state);
        (:log, a: int64, b: int64, c: int64) -> on_log(a, b, c, state);
        (:tx_credit, n: int64) -> on_n("tx_credit ", n, :tx_credit, state);
        (:synced, n: int64) -> on_n("synced ", n, :synced, state);
        (:rx, s: string) -> on_rx(s, state);
        (:rx_end, n: int64) -> on_n("rx_end ", n, :rx_end, state);
        (:tx_failed, why: atom) -> on_atom("tx_failed ", why, :tx_failed, state);
        (:read_failed, why: atom) -> on_atom("read_failed ", why, :read_failed, state);
        (:link_down, why: atom) -> on_link_down(why, state);
        :settled -> (:no_reply, progress(:settled, state))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: actor_ref <- spawn_dangerous_carrier(journal, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                own: actor_ref <- spawn({ car: car, step: 0, left: need(0), rx: wireframe@fresh(:storage) }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(car, (:open, own, "") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
