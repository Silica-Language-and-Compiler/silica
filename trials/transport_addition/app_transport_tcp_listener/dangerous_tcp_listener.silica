// A (:tcp) listener serving several peers (design §6.2, §6.3): one listening carrier, and two clients
// that connect to it one after the other. For each accepted peer the listener tells its owner
// (:accepted, fd, info); the owner starts a connection carrier from the descriptor (spawn_dangerous) and gives every connection a session
// actor of its own, which opens the connection, decodes the (:ping, n) it carries as a
// length-prefixed ETF frame (§5, §4.7) and answers (:pong, n + 1). The clients hand the answers to the failure reporter, the only writer of standard output (it also starts round 2).
module dangerous_tcp_listener;

use wire_etf;
use wireframe;
use Carrier;
use dangerous_sockets;
use dangerous_tcp_carrier;

fn region_dump_limit() -> int64 {
    0
}

// The program's own failure reporter is the only writer of standard output and the only starter of the rounds, so the
// order is fixed by construction, not by timing. Every message is a string. "start" (cast by main): the reporter
// spawns the listener and the coordinator, which gets the reporter as its output sink. "out:<line>": the reporter
// prints <line> and, after round 1's last line (pong 8) has been written, tells the coordinator to start round 2;
// after round 2's last line (pong 10) it tells the coordinator to close the links. Anything else is a failure report
// the runtime delivers here instead of printing it: each of the five carriers (the listener, two client links, two
// accepted connections) ends normally and reports; after the last the reporter prints the trial's last line and ends
// the program.
fn reporter(msg: string, state: { seen: int64, boss: actor_ref })
    -> (:no_reply, { seen: int64, boss: actor_ref }) {
    case msg == "start" of {
        true -> {
            sequence proc[concurrency]
                lst: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                boss: actor_ref <- spawn({ car: lst, port: "", c1: lst, c2: lst, out: self() }, coordinator, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(lst, (:open, boss, "listen:0") impl ActorMessage {})
            produces
                pure (:no_reply, { seen: state.seen, boss: boss })
            end
        };
        false -> case starts_with(msg, "out:") of {
            true -> {
                sequence proc[concurrency, device_io]
                    _: atom <- println(substring(msg, 4, length_bytes(msg)));
                    _: boolean <- case msg == "out:pong 8" of {
                        true -> cast(state.boss, (:client_done, 7) impl ActorMessage {});
                        false -> case msg == "out:pong 10" of {
                            true -> cast(state.boss, (:client_done, 9) impl ActorMessage {});
                            false -> true
                        }
                    }
                produces
                    pure (:no_reply, state)
                end
            };
            false -> {
                sequence proc[concurrency, device_io]
                    seen: int64 <- state.seen + 1;
                    _: boolean <- case seen == 5 of {
                        true -> {
                            _: atom <- println("done");
                            cast_exit(0)
                        };
                        false -> true
                    }
                produces
                    pure (:no_reply, { seen: seen, boss: state.boss })
                end
            }
        }
    }
}


fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn send_term(car: dangerous_actor_ref, v: (:ping, int64) | (:pong, int64)) -> boolean {
    sequence proc[mem(normal), concurrency, transport]
        frame: string <- encode((:etf), v);
        segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu((:tcp)), Carrier@boundaries((:tcp)));
        seg: string <- first_segment(segs);
        sent: boolean <- cast(car, (:tx, seg, self()) impl ActorMessage {})
    produces
        pure sent
    end
}

// Hands a line to the reporter, the only writer of standard output. A lookup is one flat case: the exchange is
// ping 7, pong 8 in round 1 and ping 9, pong 10 in round 2.
fn line_for(v: (:ping, int64) | (:pong, int64)) -> string {
    case v of {
        (:ping, n: int64) -> case n of {
            7 -> "out:ping 7";
            9 -> "out:ping 9";
            _: int64 -> "out:ping ?"
        };
        (:pong, n2: int64) -> case n2 of {
            8 -> "out:pong 8";
            10 -> "out:pong 10";
            _: int64 -> "out:pong ?"
        }
    }
}

fn emit(out: actor_ref, v: (:ping, int64) | (:pong, int64)) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(out, line_for(v) impl ActorMessage {})
    produces
        pure sent
    end
}

fn ping_value(v: (:ping, int64) | (:pong, int64)) -> int64 {
    case v of {
        (:ping, n: int64) -> n;
        (:pong, n: int64) -> n
    }
}

// The owner of one accepted connection: opens it, then answers every (:ping, n) with (:pong, n + 1).
fn session(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
           state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, out: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, out: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:rx, segment: string) -> {
            sequence proc[concurrency]
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), transport]
                            decoded: (:ok, (:ping, int64) | (:pong, int64)) | (:rejected, atom) <- decode((:etf), frame);
                            _: boolean <- case decoded of {
                                (:ok, v: (:ping, int64) | (:pong, int64)) -> emit(state.out, v);
                                (:rejected, _why: atom) -> true
                            };
                            _: boolean <- case decoded of {
                                (:ok, v2: (:ping, int64) | (:pong, int64)) -> send_term(state.car, (:pong, ping_value(v2) + 1));
                                (:rejected, _why2: atom) -> true
                            }
                        produces pure r2 end
                    };
                    (:rejected, why3: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why3)
                        produces pure state.rx end
                    }
                };
                _: boolean <- cast(state.car, (:credit, 1) impl ActorMessage {})
            produces
                pure (:no_reply, { car: state.car, rx: rx2, out: state.out })
            end
        };
        (:tx_failed, why4: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why4)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why5: atom) -> (:no_reply, state)
    }
}

// A client: on :link_up it sends (:ping, n); the answer is shown and the coordinator told. The coordinator closes the
// connection (every carrier ends only after the last answer is shown, so no root-exit note can precede output).
fn client(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, n: int64, out: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, n: int64, out: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {});
                _: boolean <- send_term(state.car, (:ping, state.n))
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:rx, segment: string) -> {
            sequence
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), transport]
                            decoded: (:ok, (:ping, int64) | (:pong, int64)) | (:rejected, atom) <- decode((:etf), frame);
                            _: boolean <- case decoded of {
                                (:ok, v: (:ping, int64) | (:pong, int64)) -> emit(state.out, v);
                                (:rejected, _why: atom) -> true
                            }
                        produces pure r2 end
                    };
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why2)
                        produces pure state.rx end
                    }
                }
            produces
                pure (:no_reply, { car: state.car, rx: rx2, n: state.n, out: state.out })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why4: atom) -> (:no_reply, state)
    }
}

// The listener's owner: starts the first client once the listener is bound, gives each accepted
// connection a session, starts the second client when the first is done, and ends the trial after
// the second, then closes both client links and the listener.
fn coordinator(msg: (:link_up, string) | (:accepted, int64, string) | (:client_done, int64) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
               state: { car: dangerous_actor_ref, port: string, c1: dangerous_actor_ref, c2: dangerous_actor_ref, out: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, port: string, c1: dangerous_actor_ref, c2: dangerous_actor_ref, out: actor_ref }) {
    case msg of {
        (:link_up, info: string) -> case starts_with(info, "port:") of {
            true -> {
                sequence proc[concurrency]
                    port: string <- substring(info, 5, length_bytes(info));
                    link1: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    cli1: actor_ref <- spawn({ car: link1, rx: wireframe@fresh(Carrier@boundaries((:tcp))), n: 7, out: state.out }, client, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    _: boolean <- cast(link1, (:open, cli1, concat(concat("127.0.0.1:", port), ":3000")) impl ActorMessage {})
                produces
                    pure (:no_reply, { car: state.car, port: port, c1: link1, c2: state.c2, out: state.out })
                end
            };
            false -> (:no_reply, state)
        };
        (:accepted, fd: int64, _info: string) -> {
            sequence proc[concurrency]
                conn: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: fd, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                ses: actor_ref <- spawn({ car: conn, rx: wireframe@fresh(Carrier@boundaries((:tcp))), out: state.out }, session, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(conn, (:open, ses, "") impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:client_done, n: int64) -> case n == 7 of {
            true -> {
                sequence proc[concurrency]
                    link2: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    cli2: actor_ref <- spawn({ car: link2, rx: wireframe@fresh(Carrier@boundaries((:tcp))), n: 9, out: state.out }, client, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    _: boolean <- cast(link2, (:open, cli2, concat(concat("127.0.0.1:", state.port), ":3000")) impl ActorMessage {})
                produces
                    pure (:no_reply, { car: state.car, port: state.port, c1: state.c1, c2: link2, out: state.out })
                end
            };
            false -> {
                // both answers are shown: closing the two client links and the listener ends the five carriers
                // (the accepted connections end when their peers close); the reporter counts their reports
                sequence proc[concurrency]
                    _: boolean <- cast(state.c1, :close impl ActorMessage {});
                    _: boolean <- cast(state.c2, :close impl ActorMessage {});
                    _: boolean <- cast(state.car, :close impl ActorMessage {})
                produces
                    pure (:no_reply, state)
                end
            }
        };
        (:tx_credit, _n2: int64) -> (:no_reply, state);
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, why: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why)
            produces pure (:no_reply, state) end
        };
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn({ seen: 0, boss: actor_ref_of_word(0) }, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        _: boolean <- cast(rep, "start" impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
