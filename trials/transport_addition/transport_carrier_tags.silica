// The carrier tags in the design's form (transport_serialization_design.md §3, §6.1): `(:tcp)` is a
// parenthesised atom literal, so Carrier@mtu((:tcp)) reads the same row as Carrier@mtu(:tcp). Every
// property of every hosted carrier is read through the design form, one through the bare atom, and
// the framing call of §3 is made with the properties it answers.
module transport_carrier_tags;

use Carrier;
use wireframe;

fn bool_text(b: boolean) -> string {
    case b of {
        true -> "true";
        false -> "false"
    }
}

// Spelled through a case rather than print_atom: `:none` is the empty-slot atom, which print_atom
// does not name (it is absent from the program's atom table).
fn addressing_text(a: atom) -> string {
    case a of {
        :none -> "none";
        :endpoint -> "endpoint";
        :characteristic -> "characteristic";
        :block -> "block";
        _: atom -> "?"
    }
}

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn show(name: string, p: boolean, m: int64, b: atom, d: atom, a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(name);
        _: atom <- print(" provided=");
        _: atom <- print(bool_text(p));
        _: atom <- print(" mtu=");
        _: atom <- print_int64(m);
        _: atom <- print(" boundaries=");
        _: atom <- print_atom(b);
        _: atom <- print(" delivery=");
        _: atom <- print_atom(d);
        _: atom <- print(" addressing=");
        _: atom <- print(addressing_text(a));
        o: atom <- println("")
    produces
        pure o
    end
}

fn show_framing(name: string, segs: List[string, mem(normal)]) -> atom {
    sequence proc[device_io, mem(normal)]
        n: int64 <- length[string, mem(normal)](segs);
        first: string <- first_segment(segs);
        _: atom <- print(name);
        _: atom <- print(" segments=");
        _: atom <- print_int64(n);
        _: atom <- print(" first_length=");
        _: atom <- print_int64(length_bytes(first));
        o: atom <- println("")
    produces
        pure o
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- show("tcp", Carrier@provides((:tcp)), Carrier@mtu((:tcp)), Carrier@boundaries((:tcp)), Carrier@delivery((:tcp)), Carrier@addressing((:tcp)));
        _: atom <- show("udp", Carrier@provides((:udp)), Carrier@mtu((:udp)), Carrier@boundaries((:udp)), Carrier@delivery((:udp)), Carrier@addressing((:udp)));
        _: atom <- show("serial", Carrier@provides((:serial)), Carrier@mtu((:serial)), Carrier@boundaries((:serial)), Carrier@delivery((:serial)), Carrier@addressing((:serial)));
        // named by the design (§6.3, §6.5), not provided by this build
        _: atom <- show("ble_gatt", Carrier@provides((:ble_gatt)), Carrier@mtu((:ble_gatt)), Carrier@boundaries((:ble_gatt)), Carrier@delivery((:ble_gatt)), Carrier@addressing((:ble_gatt)));
        // the bare atom names the same row
        _: atom <- show("tcp", Carrier@provides(:tcp), Carrier@mtu(:tcp), Carrier@boundaries(:tcp), Carrier@delivery(:tcp), Carrier@addressing(:tcp));
        // §3: the framing chosen by the carrier's properties; a 3-byte frame behind the 4-byte length
        // prefix on a :stream carrier, bare on a :datagram carrier whose mtu holds it
        tcp_segs: List[string, mem(normal)] <- wireframe@frame("abc", Carrier@mtu((:tcp)), Carrier@boundaries((:tcp)));
        _: atom <- show_framing("tcp", tcp_segs);
        udp_segs: List[string, mem(normal)] <- wireframe@frame("abc", Carrier@mtu((:udp)), Carrier@boundaries((:udp)));
        _: atom <- show_framing("udp", udp_segs);
        st: { mode: atom, expected: int64, pending: string } <- wireframe@fresh(Carrier@boundaries((:tcp)));
        _: atom <- print("fresh mode=");
        _: atom <- print_atom(st.mode);
        _: atom <- println("")
    produces
        pure 0
    end
}
