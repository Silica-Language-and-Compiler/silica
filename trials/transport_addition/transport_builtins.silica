// The transport builtins (transport_serialization_design.md §9.2): bytes into and out of strings,
// joining fragments, atom names both ways, float bits, and integer width conversions.
use trial_support_hex;

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        xs: List[int64, mem(normal)] <- [131, 97, 255, 0, 7];
        s: string <- bytes_of(xs);
        n: int64 <- length_bytes(s);
        _: atom <- print_int64(n);
        _: atom <- println("");
        _: atom <- println(trial_support_hex@hex(s));
        b: int64 <- byte_at(s, 2);
        _: atom <- print_int64(b);
        _: atom <- println("");
        sl: string <- byte_slice(s, 1, 3);
        _: atom <- println(trial_support_hex@hex(sl));
        parts: List[string, mem(normal)] <- [sl, "ab", "", "c"];
        j: string <- join_bytes(parts);
        _: atom <- println(trial_support_hex@hex(j));
        none: List[string, mem(normal)] <- empty[string, mem(normal)]();
        j0: string <- join_bytes(none);
        n0: int64 <- length_bytes(j0);
        _: atom <- print_int64(n0);
        _: atom <- println("");
        nm: string <- atom_name(:accel);
        _: atom <- println(nm);
        i: int64 <- atom_index_of_name("accel");
        a: atom <- atom_of_bits(i);
        _: atom <- print_atom(a);
        _: atom <- println("");
        miss: int64 <- atom_index_of_name("no_such_atom_here");
        _: atom <- print_int64(miss);
        _: atom <- println("");
        f: float64 <- 1.5;
        bits: int64 <- float64_bits(f);
        _: atom <- print_int64(bits);
        _: atom <- println("");
        g: float64 <- float64_of_bits(bits);
        _: atom <- case g == f of {
            true -> println("float64 bits round trip");
            false -> println("float64 bits differ")
        };
        f32: float32 <- 2.5;
        b32: int64 <- float32_bits(f32);
        _: atom <- print_int64(b32);
        _: atom <- println("");
        w: float64 <- float32_to_float64(f32);
        wide: float64 <- 2.5;
        _: atom <- case w == wide of {
            true -> println("float32 widened");
            false -> println("float32 widening differs")
        };
        nar: float32 <- float64_to_float32(w);
        _: atom <- case nar == f32 of {
            true -> println("float64 narrowed");
            false -> println("float64 narrowing differs")
        };
        g32: float32 <- float32_of_bits(b32);
        _: atom <- case g32 == f32 of {
            true -> println("float32 bits round trip");
            false -> println("float32 bits differ")
        };
        i16: int16 <- -2;
        wi: int64 <- to_int64(i16);
        _: atom <- print_int64(wi);
        _: atom <- println("");
        u8: uint8 <- 200;
        wu: int64 <- to_int64(u8);
        _: atom <- print_int64(wu);
        _: atom <- println("");
        back: int16 <- to_int16(70000);
        _: atom <- print_int16(back);
        _: atom <- println("");
        bu: uint8 <- to_uint8(300);
        _: atom <- print_uint8(bu);
        _: atom <- println("");
        u64: uint64 <- to_uint64(-1);
        _: atom <- print_uint64(u64);
        _: atom <- println("");
        i32: int32 <- to_int32(-5);
        wi32: int64 <- to_int64(i32);
        _: atom <- print_int64(wi32);
        _: atom <- println("")
    produces
        pure 0
    end
}
