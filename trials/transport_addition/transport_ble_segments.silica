// The segmentation path of wireframe for a (:ble_gatt) carrier, with no radio (transport_ble_plan.md
// stage 3; transport_serialization_design.md §5): a frame longer than the carrier's mtu is cut into
// segments of mtu bytes, each behind a 4-byte header { frame_seq: uint16, index: uint16 } whose index
// has bit 15 set on the last, and unframe puts them together again in order. The mtu is the kind's row
// read through a declared carrier, Carrier@mtu(phone) = 20, so a 48-byte frame (the size of the demo's
// ETF reading) travels as three segments of 16 payload bytes. A frame the mtu holds travels bare. A
// link that negotiated a larger mtu (the value :link_up carries) is given to wireframe@frame in place
// of the row. A frame with a segment missing is rejected.
use Carrier;
use wireframe;
use trial_support_hex;

carried_on phone: (:ble_gatt) (:bluetooth, 0);

fn show_segments(segs: List[string, mem(normal)], index: int64) -> atom {
    case segs of {
        []: List[string, mem(normal)] -> :ok;
        [h: string, t: List[string, mem(normal)]] -> {
            sequence proc[device_io]
                _: atom <- print("  ");
                _: atom <- print_int64(index);
                _: atom <- print(" length=");
                _: atom <- print_int64(length_bytes(h));
                _: atom <- print(" ");
                _: atom <- println(trial_support_hex@hex(h));
                o: atom <- show_segments(t, index + 1)
            produces
                pure o
            end
        }
    }
}

fn show_frame(name: string, f: string, mtu: int64) -> List[string, mem(normal)] {
    sequence proc[device_io, mem(normal)]
        segs: List[string, mem(normal)] <- wireframe@frame(f, mtu, Carrier@boundaries(phone));
        _: atom <- print(name);
        _: atom <- print(" frame=");
        _: atom <- print_int64(length_bytes(f));
        _: atom <- print(" mtu=");
        _: atom <- print_int64(mtu);
        _: atom <- print(" segments=");
        _: atom <- print_int64(length[string, mem(normal)](segs));
        _: atom <- println("");
        _: atom <- show_segments(segs, 0)
    produces
        pure segs
    end
}

// Every segment through unframe, in the order given; what the last one answered.
fn feed(state: { mode: atom, expected: int64, pending: string }, segs: List[string, mem(normal)], want: string) -> string {
    case segs of {
        []: List[string, mem(normal)] -> "more";
        [h: string, t: List[string, mem(normal)]] -> step(wireframe@unframe(state, h, 4096), t, want)
    }
}

fn step(un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom), rest: List[string, mem(normal)], want: string) -> string {
    case un of {
        (:more, next: { mode: atom, expected: int64, pending: string }) -> feed(next, rest, want);
        (:frame, f: string, _after: { mode: atom, expected: int64, pending: string }) -> same_text(f == want);
        (:rejected, why: atom) -> concat("rejected ", atom_text(why))
    }
}

fn same_text(same: boolean) -> string {
    case same of {
        true -> "frame equal";
        false -> "frame differs"
    }
}

fn atom_text(a: atom) -> string {
    case a of {
        :bad_tag -> "bad_tag";
        :truncated -> "truncated";
        :too_large -> "too_large";
        _: atom -> "?"
    }
}

// The list without its second element: a segment lost on the way.
fn drop_second(xs: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case xs of {
        []: List[string, mem(normal)] -> xs;
        [a: string, t: List[string, mem(normal)]] -> case t of {
            []: List[string, mem(normal)] -> xs;
            [_b: string, rest: List[string, mem(normal)]] -> {
                sequence proc[mem(normal)]
                    out: List[string, mem(normal)] <- prepend[string, mem(normal)](a, rest)
                produces
                    pure out
                end
            }
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        f48: string <- "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKL";
        f50: string <- concat(f48, "MN");
        f20: string <- "0123456789abcdefghij";
        // the kind's row: three full segments
        s48: List[string, mem(normal)] <- show_frame("row", f48, Carrier@mtu(phone));
        _: atom <- println(feed(wireframe@fresh(Carrier@boundaries(phone)), s48, f48));
        // a short last segment
        s50: List[string, mem(normal)] <- show_frame("row", f50, Carrier@mtu(phone));
        _: atom <- println(feed(wireframe@fresh(Carrier@boundaries(phone)), s50, f50));
        // the mtu holds the frame: bare
        s20: List[string, mem(normal)] <- show_frame("row", f20, Carrier@mtu(phone));
        _: atom <- println(feed(wireframe@fresh(Carrier@boundaries(phone)), s20, f20));
        // a link that negotiated 185: the same frame is one bare segment
        s185: List[string, mem(normal)] <- show_frame("negotiated", f48, 185);
        _: atom <- println(feed(wireframe@fresh(Carrier@boundaries(phone)), s185, f48));
        // the second segment lost: the third arrives where the second is expected
        _: atom <- println(feed(wireframe@fresh(Carrier@boundaries(phone)), drop_second(s48), f48))
    produces
        pure 0
    end
}
