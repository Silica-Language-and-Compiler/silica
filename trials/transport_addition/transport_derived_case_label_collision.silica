// A derived transport function's case labels must not repeat the unit's own. The derived source
// (file: <unit>.silica.derived) is parsed from byte offset 0 like the unit, and the
// SIR generator names case labels by the source byte offset (L_case_o<offset>_br_N, _fb, _done):
// `classify` holds a case at the byte offset of a case in the derived decoder of
// (:ping, int64) | (:pong, int64). Before each derived declaration carried its own label tag the
// assembler rejected the unit: symbol 'L_case_o<offset>_br_0' is already defined.
// The header is sized so that the case in classify sits at byte offset 770 below.
use wire_etf;
use trial_support_hex;

fn classify(v: (:ping, int64) | (:pong, int64)) -> atom {
    sequence proc[device_io]
        o: atom <- case v of {
            (:ping, n: int64) -> {
                _: atom <- print_int64(n);
                println(" ping")
            };
            (:pong, n: int64) -> {
                _: atom <- print_int64(n);
                println(" pong")
            }
        }
    produces
        pure o
    end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        v: (:ping, int64) | (:pong, int64) <- (:ping, 7);
        frame: string <- encode((:etf), v);
        _: atom <- println(trial_support_hex@hex(frame));
        r: (:ok, (:ping, int64) | (:pong, int64)) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 64 });
        _: atom <- case r of {
            (:ok, w: (:ping, int64) | (:pong, int64)) -> classify(w);
            (:rejected, why: atom) -> print_atom(why)
        }
    produces
        pure 0
    end
}
