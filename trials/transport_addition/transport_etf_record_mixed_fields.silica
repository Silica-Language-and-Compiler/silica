// SD-37 (BEES request C1, 2026-11-17): the derived record decoder passed one parameter per field to its pair walker, so a record of more than four fields hit the 8-register-argument limit (E1070). The walker now takes its slots as one record, for any field count. Here: 9 mixed fields (nested record, list, tagged tuple, boolean, sum, uint64) and a truncated frame.
use wire_etf;

fn show_t(v: (:p, int64, int64)) -> atom {
    case v of {
        (:p, a: int64, b: int64) -> {
            sequence proc[device_io]
                _: atom <- print_int64(a + b);
                out: atom <- println("")
            produces
                pure out
            end
        }
    }
}

fn show_s(v: (:on, int64) | :off) -> atom {
    case v of {
        (:on, n: int64) -> {
            sequence proc[device_io]
                _: atom <- print_int64(n);
                out: atom <- println(" on")
            produces
                pure out
            end
        };
        :off -> {
            sequence proc[device_io]
                out: atom <- println("off")
            produces
                pure out
            end
        }
    }
}

fn sum_list(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> acc;
        [h: int64, t: List[int64, mem(normal)]] -> sum_list(t, acc + h)
    }
}

fn show(w: { fa: int64, fb: string, fc: atom, fd: { x: int64, y: string }, fe: List[int64, mem(normal)], ff: (:p, int64, int64), fg: boolean, fh: (:on, int64) | :off, fi: uint64 }) -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(w.fa);
        _: atom <- println("");
        _: atom <- println(w.fb);
        _: atom <- print_atom(w.fc);
        _: atom <- println("");
        _: atom <- print_int64(w.fd.x);
        _: atom <- println("");
        _: atom <- println(w.fd.y);
        _: atom <- print_int64(sum_list(w.fe, 0));
        _: atom <- println("");
        _: atom <- show_t(w.ff);
        _: atom <- print_int64(case w.fg of { true -> 1; false -> 0 });
        _: atom <- println("");
        _: atom <- show_s(w.fh);
        _: atom <- print_uint64(w.fi);
        _: atom <- println("");
        out: atom <- println("end")
    produces
        pure out
    end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        inner: { x: int64, y: string } <- { x: 7, y: "inner" };
        xs: List[int64, mem(normal)] <- [1000, 2000, 3000];
        tp: (:p, int64, int64) <- (:p, 40, 2);
        sw: (:on, int64) | :off <- (:on, 9);
        v: { fa: int64, fb: string, fc: atom, fd: { x: int64, y: string }, fe: List[int64, mem(normal)], ff: (:p, int64, int64), fg: boolean, fh: (:on, int64) | :off, fi: uint64 } <- { fa: -5, fb: "hello", fc: :gamma, fd: inner, fe: xs, ff: tp, fg: true, fh: sw, fi: 18446744073709551615 };
        frame: string <- encode((:etf), v);
        _: atom <- print_int64(length_bytes(frame));
        _: atom <- println("");
        r: (:ok, { fa: int64, fb: string, fc: atom, fd: { x: int64, y: string }, fe: List[int64, mem(normal)], ff: (:p, int64, int64), fg: boolean, fh: (:on, int64) | :off, fi: uint64 }) | (:rejected, atom) <- decode((:etf), frame, { max_bytes: 4096, max_depth: 4, max_length: 256 });
        _: atom <- case r of {
            (:ok, w: { fa: int64, fb: string, fc: atom, fd: { x: int64, y: string }, fe: List[int64, mem(normal)], ff: (:p, int64, int64), fg: boolean, fh: (:on, int64) | :off, fi: uint64 }) -> show(w);
            (:rejected, why: atom) -> print_atom(why)
        };
        short: string <- substring(frame, 0, length_bytes(frame) - 4);
        r2: (:ok, { fa: int64, fb: string, fc: atom, fd: { x: int64, y: string }, fe: List[int64, mem(normal)], ff: (:p, int64, int64), fg: boolean, fh: (:on, int64) | :off, fi: uint64 }) | (:rejected, atom) <- decode((:etf), short, { max_bytes: 4096, max_depth: 4, max_length: 256 });
        _: atom <- case r2 of {
            (:ok, w2: { fa: int64, fb: string, fc: atom, fd: { x: int64, y: string }, fe: List[int64, mem(normal)], ff: (:p, int64, int64), fg: boolean, fh: (:on, int64) | :off, fi: uint64 }) -> show(w2);
            (:rejected, why2: atom) -> print_atom(why2)
        };
        _: atom <- println("");
        out: atom <- println("done")
    produces
        pure 0
    end
}
