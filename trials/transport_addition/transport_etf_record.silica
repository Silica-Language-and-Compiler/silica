// ETF records and tuples (transport_serialization_design.md §4.7): a record encodes as a map with
// its keys in name order and decodes from a map with its keys in any order, as Erlang since OTP 26
// writes them; a tuple is a tuple, a tagged tuple a tuple led by its atom.
use wire_etf;
use trial_support_hex;


fn show_accel(rc: { x: int16, y: int16, z: int16, at_ms: uint64 }) -> atom {
    sequence proc[device_io]
        _: atom <- print_int16(rc.x);
        _: atom <- println("");
        _: atom <- print_int16(rc.y);
        _: atom <- println("");
        _: atom <- print_int16(rc.z);
        _: atom <- println("");
        _: atom <- print_uint64(rc.at_ms);
        out: atom <- println("")
    produces
        pure out
    end
}

fn show_pair(p: (int64, string)) -> atom {
    case p of {
        (n: int64, s: string) -> {
            sequence proc[device_io]
                _: atom <- print_int64(n);
                out: atom <- println(s)
            produces
                pure out
            end
        }
    }
}

fn show_p(v: (:p, int64, int64)) -> atom {
    case v of {
        (:p, a: int64, b: int64) -> {
            sequence proc[device_io]
                _: atom <- print_int64(a + b);
                out: atom <- println("")
            produces
                pure out
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io, transport]
        v: { x: int16, y: int16, z: int16, at_ms: uint64 } <- { x: 1, y: -2, z: 512, at_ms: 1000 };
        frame: string <- encode((:etf), v);
        _: atom <- println(trial_support_hex@hex(frame));
        r: (:ok, { x: int16, y: int16, z: int16, at_ms: uint64 }) | (:rejected, atom) <- decode((:etf), frame);
        _: atom <- case r of {
            (:ok, v2: { x: int16, y: int16, z: int16, at_ms: uint64 }) -> show_accel(v2);
            (:rejected, why: atom) -> print_atom(why)
        };
        // term_to_binary(#{x => 1, y => -2, z => 512, at_ms => 1000}) on OTP 27: keys y, x, z, at_ms.
        erl: List[int64, mem(normal)] <- [131, 116, 0, 0, 0, 4, 119, 1, 121, 98, 255, 255, 255, 254, 119, 1, 120, 97, 1, 119, 1, 122, 98, 0, 0, 2, 0, 119, 5, 97, 116, 95, 109, 115, 98, 0, 0, 3, 232];
        ferl: string <- bytes_of(erl);
        r2: (:ok, { x: int16, y: int16, z: int16, at_ms: uint64 }) | (:rejected, atom) <- decode((:etf), ferl);
        _: atom <- case r2 of {
            (:ok, v3: { x: int16, y: int16, z: int16, at_ms: uint64 }) -> show_accel(v3);
            (:rejected, why2: atom) -> print_atom(why2)
        };
        tp: (:p, int64, int64) <- (:p, 40, 2);
        ftp: string <- encode((:etf), tp);
        _: atom <- println(trial_support_hex@hex(ftp));
        rtp: (:ok, (:p, int64, int64)) | (:rejected, atom) <- decode((:etf), ftp);
        _: atom <- case rtp of {
            (:ok, v4: (:p, int64, int64)) -> show_p(v4);
            (:rejected, why4: atom) -> print_atom(why4)
        };
        p: (int64, string) <- (1, "a");
        fp: string <- encode((:etf), p);
        _: atom <- println(trial_support_hex@hex(fp));
        rp: (:ok, (int64, string)) | (:rejected, atom) <- decode((:etf), fp, { max_bytes: 64 });
        _: atom <- case rp of {
            (:ok, pr: (int64, string)) -> show_pair(pr);
            (:rejected, whyp: atom) -> print_atom(whyp)
        }
    produces
        pure 0
    end
}
