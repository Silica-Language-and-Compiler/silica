// Dialing "10.255.255.1:9:300", a non-routable address whose SYN is dropped: after 300 ms the owner gets (:link_down, :timeout) and the carrier ends (:explicit, :link_timeout). HOST-NETWORK DEPENDENT: a host with no route to 10.0.0.0/8 refuses at once with ENETUNREACH, which is (:link_down, :fault), and the trial exits 2.
// No link; the carrier is spawned directly.
//
// The owner is told (:link_down, :timeout) and tells its own failure reporter; the carrier itself ends with the reason named below, which the runtime delivers to that reporter as the failure report.
// The reporter waits for both, prints the report on stderr and ends the program with exit code 0 (any other reason from the owner: 2), so the run ends on the carrier's failure report.
module dangerous_link_dial_timeout_expires;

use dangerous_sockets;
use dangerous_tcp_carrier;

fn region_dump_limit() -> int64 {
    0
}

fn reporter(msg: string, state: { seen: int64, report: string }) -> (:no_reply, { seen: int64, report: string }) {
    sequence proc[concurrency, device_io]
        from_owner: boolean <- msg == "link_down:timeout";
        seen: int64 <- case from_owner of {
            true -> state.seen + 1;
            false -> case contains(msg, "(:explicit, :link_timeout)") of {
                true -> state.seen + 2;
                false -> state.seen
            }
        };
        report: string <- case from_owner of {
            true -> state.report;
            false -> msg
        };
        _: boolean <- case seen == 3 of {
            true -> {
                _: atom <- println_stderr(report);
                cast_exit(0)
            };
            false -> true
        }
    produces
        pure (:no_reply, { seen: seen, report: report })
    end
}

fn owner(msg: (:link_up, string) | (:accepted, int64, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
         state: { reporter: actor_ref })
    -> (:no_reply, { reporter: actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> (:no_reply, state);
        (:accepted, _fd: int64, _peer: string) -> (:no_reply, state);
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_credit, _n2: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, why2: atom) -> {
            sequence proc[concurrency]
                _: boolean <- case why2 of {
                    :timeout -> cast(state.reporter, "link_down:timeout" impl ActorMessage {});
                    _: atom -> cast_exit(2)
                }
            produces
                pure (:no_reply, state)
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn({ seen: 0, report: "" }, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        car: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        own: actor_ref <- spawn({ reporter: rep }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(car, (:open, own, "10.255.255.1:9:300") impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
