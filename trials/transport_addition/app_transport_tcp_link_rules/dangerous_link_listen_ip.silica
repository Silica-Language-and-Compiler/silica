// A (:tcp) listener on one given IPv4 address (hosted Ethernet plan E2 item 2): the carrier opened with
// "listen:127.0.0.1:0" binds 127.0.0.1 on a port the system picks, answers (:link_up, "port:<n>"), and a client
// carrier dials it. The listener's owner prints the peer the connection carrier reports,
// "peer:<ipv4>:<port>" (getpeername), reduced to its address. No link is declared, so the address form is the
// only rule at work; port 0 keeps the trial off any fixed port.
module dangerous_link_listen_ip;

use dangerous_sockets;
use dangerous_tcp_carrier;
use trial_wait_int64;

fn coordinator(msg: (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
               state: { car: dangerous_actor_ref, n: int64 })
    -> (:no_reply, { car: dangerous_actor_ref, n: int64 }) {
    case msg of {
        (:link_up, info: string) -> case starts_with(info, "port:") of {
            // the listener is bound: dial it from a client carrier owned by this actor
            true -> {
                sequence proc[concurrency, device_io]
                    _: atom <- println("listener up");
                    port: string <- substring(info, 5, length_bytes(info));
                    cli: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    _: boolean <- cast(cli, (:open, self(), concat("127.0.0.1:", port)) impl ActorMessage {})
                produces
                    pure (:no_reply, state)
                end
            };
            // the client's own :link_up: nothing to say
            false -> (:no_reply, state)
        };
        (:accepted, _conn: dangerous_actor_ref, info: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("accepted ");
                _: atom <- println(substring_until_char(info, 5, ':'));
                _: atom <- println("done");
                _: boolean <- cast(state.car, :close impl ActorMessage {});
                _: boolean <- cast_exit(0)
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n2: int64) -> (:no_reply, state);
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                lst: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                boss: actor_ref <- spawn({ car: lst, n: 0 }, coordinator, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(lst, (:open, boss, "listen:127.0.0.1:0") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
