// A successful dial with a timeout: the client dials "127.0.0.1:<port>:3000" and its :link_up carries the peer as
// "host:port", WITHOUT the timeout (hosted Ethernet plan stage E8). A listener on port 0 keeps the trial off any
// fixed port; the coordinator remembers "127.0.0.1:<port>" and compares the client's :link_up text with it exactly.
// It prints once, when it has seen both the client's :link_up and the listener's :accepted.
module dangerous_link_dial_link_up_text;

use dangerous_sockets;
use dangerous_tcp_carrier;
use trial_wait_int64;

fn settle(state: { car: dangerous_actor_ref, expect: string, seen: int64 }, delta: int64)
    -> (:no_reply, { car: dangerous_actor_ref, expect: string, seen: int64 }) {
    sequence proc[concurrency, device_io]
        seen: int64 <- state.seen + delta;
        r: boolean <- case seen == 3 of {
            true -> {
                _: atom <- println("dial link_up: host:port");
                _: atom <- println("done");
                _: boolean <- cast(state.car, :close impl ActorMessage {});
                cast_exit(0)
            };
            false -> case seen > 3 of {
                true -> {
                    _: atom <- println("dial link_up: unexpected text");
                    cast_exit(2)
                };
                false -> true
            }
        }
    produces
        pure (:no_reply, { car: state.car, expect: state.expect, seen: seen })
    end
}

fn coordinator(msg: (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
               state: { car: dangerous_actor_ref, expect: string, seen: int64 })
    -> (:no_reply, { car: dangerous_actor_ref, expect: string, seen: int64 }) {
    case msg of {
        (:link_up, info: string) -> case starts_with(info, "port:") of {
            // the listener is bound: dial it from a client carrier owned by this actor
            true -> {
                sequence proc[concurrency]
                    port: string <- substring(info, 5, length_bytes(info));
                    cli: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    _: boolean <- cast(cli, (:open, self(), concat(concat("127.0.0.1:", port), ":3000")) impl ActorMessage {})
                produces
                    pure (:no_reply, { car: state.car, expect: concat("127.0.0.1:", port), seen: state.seen })
                end
            };
            // the client's own :link_up: it must be exactly "127.0.0.1:<port>"
            false -> case info == state.expect of {
                true -> settle(state, 1);
                false -> settle(state, 100)
            }
        };
        (:accepted, _conn: dangerous_actor_ref, _peer: string) -> settle(state, 2);
        (:tx_credit, _n2: int64) -> (:no_reply, state);
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                lst: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                boss: actor_ref <- spawn({ car: lst, expect: "", seen: 0 }, coordinator, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(lst, (:open, boss, "listen:127.0.0.1:0") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
