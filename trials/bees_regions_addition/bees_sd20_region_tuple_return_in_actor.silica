// bees_sd20_region_tuple_return_in_actor
//
// Shows: a function returning a tuple that holds a region handle, (region(L, normal), T), works
// when it is called on an actor thread. The actor's state is (region, count); each call runs mk
// twice on the region it was given and replies val(a) + val(b) + count. main calls the actor
// directly (the shape BEES had), not through a supervised thunk.
// Origin: project-bees defect SD-20. It used to end the process (exit 70 with no report, or a
// fault whose pc equals the function's own address) while the same call from main worked.
// Observed 2026-10-22 on the Mac compiler (binaries/silica-compiler, 999943): prints `11 23`,
// exit 0 (fixed). memory_region_addition/region_tuple_return_in_actor is the same program
// rewritten on trial_support_int64 (the calls made from the supervised thunk).
// Expected output: 11 23, then exit 0.
fn mk(r: region(L, normal), n: int64) -> (region(L, normal), ref(L, normal, (int64, ref?(L, normal, rec)))) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (n, :none))
    produces pure (r, c) end
}
fn val(x: ref(L, normal, (int64, ref?(L, normal, rec)))) -> int64 {
    sequence proc[mem(normal)]
        node: (int64, ref?(L, normal, rec)) <- read_ref(x);
        (n: int64, _: ref?(L, normal, rec)) <- node
    produces pure n end
}
fn beh(msg: int64, state: (region(L, normal), int64)) -> (:reply, int64, (region(L, normal), int64)) {
    sequence
        (r0: region(L, normal), k: int64) <- state;
        (r1: region(L, normal), a: ref(L, normal, (int64, ref?(L, normal, rec)))) <- mk(r0, msg);
        (r2: region(L, normal), b: ref(L, normal, (int64, ref?(L, normal, rec)))) <- mk(r1, msg * 10);
        sum: int64 <- val(a) + val(b) + k
    produces pure (:reply, sum, (r2, k + 1)) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        _: atom <- start_reporter();
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        a: actor_ref <- spawn((r, 0), beh, stack_policy(0, :keep_last_message));
        v1: int64 <- call(a, 1 impl ActorMessage {});
        v2: int64 <- call(a, 2 impl ActorMessage {});
        _: atom <- print_int64(v1);
        print_string(" ");
        _: atom <- print_int64(v2);
        println("")
    produces pure 0 end
}

// ---- port addition: FailureReporter (E2236 requires one before any spawn), copied from
// ---- docs/examples/idle_actor_capacity/main.silica
fn region_dump_limit() -> int64 {
    0
}

fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
