// bees_sd7_message_region_released_in_flight  (gated; staged in bees_regions_open_addition until 2026-10-22, failed its ceiling then, passes with the SD-7 fix, see README.md)
//
// Shows (the correct behaviour): a region moved into a message is released when the receiving
// behaviour returns (§18.7: regions a message carries are moved on send and dispatch-scoped in
// the receiver), measured with one message in flight. The actor's behaviour sums the two-cell
// chain (1, 2) its message carries, keeps only an int64, and casts the next message, a fresh
// region built by build_message, to itself (registered as :w); main sends the first. After
// 100,000 messages the total is 300000 and it prints the total and done.
// Origin: project-bees defect SD-7; chunk 4 region design §18.7 (message regions released at
// dispatch end) and §18.6's message_region_released_at_dispatch_end. This is the in-flight twin of
// bees_sd7_message_region_released, which is the realistic burst shape (main casts all 100,000
// at once) and whose peak RSS includes the queued messages.
// Why this shape and not the burst: each queued message legitimately holds a live ~4 KB region,
// so the burst's peak RSS measures queue depth as well as release and cannot tell a leak from a
// full queue. Here at most one message (one region) exists at a time, so memory that grows with
// the count is memory that is never released. This trial carries the peak-RSS ceiling; the burst
// trial checks only output.
// Measured 2026-10-22 on the Mac. Program alone (/usr/bin/time -l): the compiler without the
// SD-7 fix (binaries/silica-compiler, 999943) peaks at ~534 MB, about 5.3 KB per message; the
// compiler with the fix (compiler/build/apple_silicon_mac/silica-compiler) at ~6.9 MB. Under the
// harness, whose peak includes the Python marker runner's own ~15 MB: 508.9 MiB without the fix,
// 15.7 MiB with it. The 1,000,000-message variant: ~2.4 GB without the fix, ~57 MB with it;
// 100,000 int64 casts (the burst control, no regions) peak at ~14.5 MB.
// How leaking and not leaking differ: only in memory; the output (300000, done) is the same. No
// program output can show it: heap_used() counts only actor arena bumps, and alloc_region's
// blocks come from _silica_rt_raw_alloc, which no counter sees. So the check is the harness's
// peak-RSS ceiling (host only; trials/README.md, "Peak memory ceiling"): the .scout holds the
// correct output (300000, done, exit 0) and bees_sd7_message_region_released_in_flight.max_rss_mb
// holds 40 (MiB): about 2.5 times the leak-free harness peak (15.7) and under a tenth of the leak
// (508.9), so allocator or host variation does not flip a leak-free run, while a leak of about
// 250 bytes a message (100,000 x 250 B = 25 MB on top of the leak-free peak) still fails.
// Staged in bees_regions_open_addition (no .ascomp) until the SD-7 fix was built; moved to
// bees_regions_addition with its .ascomp goldens once it passed (see README.md).
// Run: about one second.
fn some_term(c: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> ref?(L, normal, (atom, int64, ref?(L, normal, rec))) {
    c
}

fn sum_chain(root: ref?(L, normal, (atom, int64, ref?(L, normal, rec)))) -> int64 {
    sequence proc[mem(normal)]
        total: int64 <- case root of {
            :none -> 0;
            c: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> {
                node: (atom, int64, ref?(L, normal, rec)) <- read_ref(c);
                (_: atom, v: int64, nxt: ref?(L, normal, (atom, int64, ref?(L, normal, rec)))) <- node;
                v + sum_chain(nxt)
            }
        }
    produces pure total end
}

fn beh(msg: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        got: int64 <- sum_chain(msg.root);
        new_total: int64 <- state + got;
        _: atom <- case new_total >= 300000 of {
            true -> { _: atom <- print_int64(new_total); println(""); println("done"); :ok };
            false -> { _: boolean <- send_next(); :ok }
        }
    produces pure (:no_reply, new_total) end
}

fn build_message(a: int64, b: int64) -> { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        n2: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, b, :none));
        n1: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, a, n2))
    produces pure { r: r, root: some_term(n1) } end
}

fn send_next() -> boolean {
    sequence proc[concurrency]
        m: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) } <- build_message(1, 2);
        ok: boolean <- cast_registered(:w, m impl ActorMessage {})
    produces pure ok end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: actor_ref <- spawn_registered(0, beh, :w, stack_policy(0, :keep_last_message));
        _: boolean <- send_next();
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// ---- port addition: FailureReporter (E2236 requires one before any spawn), copied from
// ---- docs/examples/idle_actor_capacity/main.silica
fn region_dump_limit() -> int64 {
    0
}

fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
