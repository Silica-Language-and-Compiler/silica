// bees_sd7_message_region_released  (gated; staged in bees_regions_open_addition until 2026-10-22, moved here with the SD-7 fix, see README.md)
//
// Shows (the correct behaviour): a region moved into a message is released when the receiving
// behaviour returns (§18.7: regions a message carries are moved on send and dispatch-scoped in
// the receiver). main builds 100,000 messages { r, root }, each a fresh region holding a two-cell
// chain (1, 2), and casts them to one cast-only actor that sums the chain and keeps only an int64;
// a last message with sum 0 makes it print the total (300000) and done.
// Origin: project-bees defect SD-7; chunk 4 region design §18.7 (message regions released at
// dispatch end) and §18.6's message_region_released_at_dispatch_end; hazard H9 (a region inside a
// record is never released).
// This is the realistic burst shape: main casts all 100,000 messages without throttling, so many
// are queued at once, and each queued message legitimately holds its live ~4 KB region. Peak RSS
// here therefore includes the queue and cannot tell a leak from a full queue, so this trial has
// no peak-RSS ceiling and checks output only (300000, done, exit 0). The release itself is
// checked by its in-flight twin, bees_sd7_message_region_released_in_flight, which keeps one
// message in flight and carries the ceiling.
// Measured 2026-10-22 on the Mac (/usr/bin/time -l and the harness): the compiler without the
// SD-7 fix (binaries/silica-compiler, 999943) peaks at ~520 MiB (~545 MB); the compiler with the
// fix (compiler/build/apple_silicon_mac/silica-compiler) at ~382 MiB, the queue it still holds;
// 100,000 int64 casts (no regions) peak at ~14.6 MB. Output is right with both.
// No program output measures region memory: heap_used() counts only actor arena bumps
// (_silica_rt_region_alloc), and alloc_region's blocks come from _silica_rt_raw_alloc, which no
// counter sees; get_actor_memory_usage reports stacks only.
// It failed nothing on output while staged (the leak showed only in memory); with the SD-7 fix it passes and is gated here.
// Run: about one second.
fn some_term(c: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> ref?(L, normal, rec) {
    c
}

fn sum_chain(root: ref?(L, normal, rec)) -> int64 {
    sequence proc[mem(normal)]
        total: int64 <- case root of {
            :none -> 0;
            c: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> {
                node: (atom, int64, ref?(L, normal, rec)) <- read_ref(c);
                (_: atom, v: int64, nxt: ref?(L, normal, rec)) <- node;
                v + sum_chain(nxt)
            }
        }
    produces pure total end
}

fn beh(msg: { r: region(L, normal), root: ref?(L, normal, rec) }, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        got: int64 <- sum_chain(msg.root);
        new_total: int64 <- state + got;
        // port change: E2237 forbids cast to a call-only actor, so beh is cast-only and the final
        // (sum 0) message prints the total instead of replying to a call
        _: atom <- case got == 0 of {
            true -> { _: atom <- print_int64(new_total); println(""); println("done"); :ok };
            false -> :ok
        }
    produces pure (:no_reply, new_total) end
}

fn build_message(a: int64, b: int64) -> { r: region(L, normal), root: ref?(L, normal, rec) } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        n2: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, b, :none));
        n1: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, a, n2))
    produces pure { r: r, root: some_term(n1) } end
}

fn send_n(a: actor_ref, n: int64) -> int64 {
    sequence proc[concurrency]
        m: { r: region(L, normal), root: ref?(L, normal, rec) } <- build_message(1, 2);
        _: boolean <- cast(a, m impl ActorMessage {});
        rest: int64 <- case n <= 1 of {
            true -> 0;
            false -> send_n(a, n - 1)
        }
    produces pure rest end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        a: actor_ref <- spawn(0, beh, stack_policy(0, :keep_last_message));
        _: int64 <- send_n(a, 100000);
        last: { r: region(L, normal), root: ref?(L, normal, rec) } <- build_message(0, 0);
        _: boolean <- cast(a, last impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

// ---- port addition: FailureReporter (E2236 requires one before any spawn), copied from
// ---- docs/examples/idle_actor_capacity/main.silica
fn region_dump_limit() -> int64 {
    0
}

fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
