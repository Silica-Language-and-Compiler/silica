// Trial helper for bees_sd22_region_bound_locally_cast: project-bees's bees_term module, copied
// unchanged (below this note) from the 2026-10-22 port of the BEES repros. The trial calls only
// mk_int and int_of; the rest is kept so the helper stays the module BEES compiles. The port's
// silica.config also listed bees_atoms, which neither this module nor the trial uses.
module bees_term;
// GENERATED by tools/gen_bees_term.py; edit the template there.
//
// bees_term v0 (spike S9; contract item 1 draft). A term is a cell in a region:
//   (tag, n, f, a, p, h, t)
//   tag  0 nil  1 int(n)  2 float(f)  3 atom(a)  4 pid(p)  5 cons(h=head, t=tail)
//        6 tuple(n=arity, h=element list)  7 binary(n=byte count, h=list of int cells 0..255)
//        8 fun(n=module index, h=cons(fn index, env list))
// Every atom in a term comes from bees_atoms (D30); this unit writes none.
//
// Shapes forced by the fixed point (see the S9 and S13 notes):
//  - the heap is the record { r: region(L, normal) }, passed IN to every constructor; a process
//    keeps it in its state as a field h. A message is { r: region(L, normal), c: ref?(L, normal, rec) },
//    a term in its own region, moved by the cast;
//  - every constructor and accessor returns ONE reference, ref?(L, normal, rec): an aggregate
//    (record or tuple) return leaks ~32 bytes of stack per call for the life of the actor
//    (SD-21), a plain ref return fails E2100, and a (region, ref) tuple crashes (SD-20);
//  - a ref? cannot annotate a binding (SD-5): results are used as arguments, in `case`, or held
//    in a record field; every region that holds terms is region(L, normal) (SD-6).

export mk_nil/1;
export mk_int/2;
export mk_float/2;
export mk_atom/2;
export mk_pid/2;
export mk_cons/3;
export mk_tuple/3;
export mk_binary/3;
export mk_fun/3;
export tag/1;
export int_of/1;
export float_of/1;
export atom_of/1;
export pid_of/1;
export hd_of/1;
export tl_of/1;
export arity/1;
export list_len/1;
export nth/2;
export copy/2;
export eq/2;
export is_none/1;
export is_list/1;

fn some(c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> ref?(L, normal, rec) { c }
fn is_none(c: ref?(L, normal, rec)) -> boolean { case c of { :none -> true; _: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> false } }
fn is_list(c: ref?(L, normal, rec)) -> boolean { tag(c) == 5 }

fn mk_nil(h: { r: region(L, normal) }) -> ref?(L, normal, rec) {
    sequence proc[mem(normal), concurrency]
        me: actor_ref <- self();
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (0, 0, 0.0, :ok, me, :none, :none))
    produces pure some(c) end
}
fn mk_int(h: { r: region(L, normal) }, n: int64) -> ref?(L, normal, rec) {
    sequence proc[mem(normal), concurrency]
        me: actor_ref <- self();
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (1, n, 0.0, :ok, me, :none, :none))
    produces pure some(c) end
}
fn mk_float(h: { r: region(L, normal) }, f: float64) -> ref?(L, normal, rec) {
    sequence proc[mem(normal), concurrency]
        me: actor_ref <- self();
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (2, 0, f, :ok, me, :none, :none))
    produces pure some(c) end
}
fn mk_atom(h: { r: region(L, normal) }, a: atom) -> ref?(L, normal, rec) {
    sequence proc[mem(normal), concurrency]
        me: actor_ref <- self();
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (3, 0, 0.0, a, me, :none, :none))
    produces pure some(c) end
}
fn mk_pid(h: { r: region(L, normal) }, p: actor_ref) -> ref?(L, normal, rec) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (4, 0, 0.0, :ok, p, :none, :none))
    produces pure some(c) end
}
fn mk_cons(h: { r: region(L, normal) }, hd: ref?(L, normal, rec), tl: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    sequence proc[mem(normal), concurrency]
        me: actor_ref <- self();
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (5, 0, 0.0, :ok, me, hd, tl))
    produces pure some(c) end
}
// A tuple of arity n over the list of its elements.
fn mk_tuple(h: { r: region(L, normal) }, n: int64, elements: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    sequence proc[mem(normal), concurrency]
        me: actor_ref <- self();
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (6, n, 0.0, :ok, me, elements, :none))
    produces pure some(c) end
}
// A binary of n bytes over a list of int cells 0..255.
fn mk_binary(h: { r: region(L, normal) }, n: int64, bs: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    sequence proc[mem(normal), concurrency]
        me: actor_ref <- self();
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (7, n, 0.0, :ok, me, bs, :none))
    produces pure some(c) end
}
// A fun: module index and cons(fn index, env list).
fn mk_fun(h: { r: region(L, normal) }, module_index: int64, body: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    sequence proc[mem(normal), concurrency]
        me: actor_ref <- self();
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (8, module_index, 0.0, :ok, me, body, :none))
    produces pure some(c) end
}

fn read(c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)) {
    sequence proc[mem(normal)]
        node: (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(c)
    produces pure node end
}

fn tag(c: ref?(L, normal, rec)) -> int64 {
    case c of {
        :none -> 0 - 1;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (tg: int64, _: int64, _: float64, _: atom, _: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
            tg
        }
    }
}
fn int_of(c: ref?(L, normal, rec)) -> int64 {
    case c of {
        :none -> 0;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (_: int64, n: int64, _: float64, _: atom, _: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
            n
        }
    }
}
// A float64-returning function must not destructure the cell (SD-14), so the slot comes through
// a record; that record return leaks ~32 bytes of stack per call (SD-21). A1 decides whether
// floats are held as their IEEE bytes instead.
fn float_slot(x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> { f: float64 } {
    sequence proc[mem(normal)]
        node: (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(x);
        (_: int64, _: int64, f: float64, _: atom, _: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node
    produces pure { f: f } end
}
fn fzero() -> float64 { 0.0 }
fn fget(s: { f: float64 }) -> float64 { s.f }
fn float_of(c: ref?(L, normal, rec)) -> float64 {
    case c of {
        :none -> fzero();
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> fget(float_slot(x))
    }
}
fn atom_of(c: ref?(L, normal, rec)) -> atom {
    case c of {
        :none -> :unknown;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (_: int64, _: int64, _: float64, a: atom, _: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
            a
        }
    }
}
fn pid_of(c: ref?(L, normal, rec)) -> actor_ref {
    sequence proc[concurrency]
        me: actor_ref <- self();
        p: actor_ref <- case c of {
            :none -> me;
            x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                (_: int64, _: int64, _: float64, _: atom, q: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
                q
            }
        }
    produces pure p end
}
fn hd_of(c: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    case c of {
        :none -> :none;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (_: int64, _: int64, _: float64, _: atom, _: actor_ref, hd: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
            hd
        }
    }
}
fn tl_of(c: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    case c of {
        :none -> :none;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (_: int64, _: int64, _: float64, _: atom, _: actor_ref, _: ref?(L, normal, rec), tl: ref?(L, normal, rec)) <- read(x);
            tl
        }
    }
}
fn arity(c: ref?(L, normal, rec)) -> int64 { int_of(c) }

// Length of a cons list (nil-terminated); a non-list ends the count.
fn list_len(c: ref?(L, normal, rec)) -> int64 {
    case tag(c) == 5 of {
        true -> 1 + list_len(tl_of(c));
        false -> 0
    }
}
// The i-th element (0-based) of a cons list, or none.
fn nth(c: ref?(L, normal, rec), i: int64) -> ref?(L, normal, rec) {
    case tag(c) == 5 of {
        true -> case i == 0 of {
            true -> hd_of(c);
            false -> nth(tl_of(c), i - 1)
        };
        false -> :none
    }
}

// Deep copy of a term from any region into the heap h (evacuation, roadmap §4.2).
fn copy(h: { r: region(L, normal) }, c: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    case c of {
        :none -> :none;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (tg: int64, n: int64, f: float64, a: atom, p: actor_ref, hd: ref?(L, normal, rec), tl: ref?(L, normal, rec)) <- read(x);
            case tg of {
                5 -> mk_cons(h, copy(h, hd), copy(h, tl));
                6 -> mk_tuple(h, n, copy(h, hd));
                7 -> mk_binary(h, n, copy(h, hd));
                8 -> mk_fun(h, n, copy(h, hd));
                2 -> mk_float(h, f);
                3 -> mk_atom(h, a);
                4 -> mk_pid(h, p);
                1 -> mk_int(h, n);
                _: int64 -> mk_nil(h)
            }
        }
    }
}

// Structural equality (=:= for the v0 types; floats compare exactly).
fn eq(a: ref?(L, normal, rec), b: ref?(L, normal, rec)) -> boolean {
    case tag(a) == tag(b) of {
        false -> false;
        true -> case tag(a) of {
            0 -> true;
            1 -> int_of(a) == int_of(b);
            2 -> feq(float_of(a), float_of(b));
            3 -> atom_of(a) == atom_of(b);
            4 -> same_pid(pid_of(a), pid_of(b));
            5 -> eq(hd_of(a), hd_of(b)) and eq(tl_of(a), tl_of(b));
            6 -> arity(a) == arity(b) and eq(hd_of(a), hd_of(b));
            7 -> arity(a) == arity(b) and eq(hd_of(a), hd_of(b));
            _: int64 -> false
        }
    }
}
fn feq(x: float64, y: float64) -> boolean { x == y }
// Pid equality waits on S-26: actor_ref_equal is specified (2026-09-15) but not in the fixed
// point (it links as an undefined symbol), and the comparison operators do not apply to
// references. Until then two pids are never equal (recorded in the S9 note).
fn same_pid(x: actor_ref, y: actor_ref) -> boolean { false }
