// region_in_returned_record_released  (OPEN: staged in bees_regions_open_addition, see README.md)
//
// Shows (the correct behaviour): a region held in a record that a function returns is released
// once the caller is done with it. No actors. mk makes a fresh region with a two-cell chain
// (n, n + 1) and returns { r, c }; val reads the first cell and drops the record; loop does
// this 100,000 times and main prints the sum of n (5000050000).
// Origin: chunk 4 region design hazard H9 (owned-region leaks: a region inside a record or
// tuple); found while porting project-bees SD-7, whose message is such a record. No trial
// covered it before this one.
// Observed 2026-10-22 on the Mac compiler (999943): FAILS. Output is right (5000050000) but peak
// RSS is ~528 MB (/usr/bin/time -l) for 100,000 two-cell regions: none is ever released.
// How leaking and not leaking differ: only in memory. Released, peak RSS stays at about one
// region (~1 MB for the process); leaking, it is count x ~5 KB. The program's output cannot
// show it today: heap_used() does not count alloc_region's blocks (it printed 0 growth over the
// 100,000 regions while RSS reached 528 MB), and get_actor_memory_usage reports actor stacks.
// So the check is the harness's peak-RSS ceiling: the .scout holds the correct output
// (5000050000, exit 0) and region_in_returned_record_released.max_rss_mb holds 100 (MB): a
// leak-free run needs about one region (a few MB for the process), today's leak ~503 MiB
// (~528 MB). Host only (trials/README.md, "Peak memory ceiling").
// No .ascomp: today's assembly is the defective codegen; it is recorded when the leak is fixed.
// Run: well under a second.
fn some_cell(c: ref(L, normal, (int64, ref?(L, normal, rec)))) -> ref?(L, normal, (int64, ref?(L, normal, rec))) { c }
fn mk(n: int64) -> { r: region(L, normal), c: ref(L, normal, (int64, ref?(L, normal, rec))) } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        c2: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (n + 1, :none));
        c: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (n, some_cell(c2)))
    produces pure { r: r, c: c } end
}
fn val(n: int64) -> int64 {
    sequence proc[mem(normal)]
        h: { r: region(L, normal), c: ref(L, normal, (int64, ref?(L, normal, rec))) } <- mk(n);
        node: (int64, ref?(L, normal, rec)) <- read_ref(h.c);
        (a: int64, _: ref?(L, normal, (int64, ref?(L, normal, rec)))) <- node
    produces pure a end
}
fn loop(i: int64, acc: int64) -> int64 {
    case i == 0 of { true -> acc; false -> loop(i - 1, acc + val(i)) }
}
fn main() -> int64 {
    sequence proc[device_io]
        s: int64 <- loop(100000, 0);
        _: atom <- print_int64(s);
        println("")
    produces pure 0 end
}
