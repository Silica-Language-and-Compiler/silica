// The board holds one link (transport_ble_plan.md stage 10, part 2): the first (:ble_gatt) carrier a
// program opens takes the radio, and an :open to a second carrier answers (:link_down, :fault) and
// leaves the first as it was. The owner opens the first carrier as a peripheral of the Nordic UART
// Service, two seconds later opens the second, and when that has answered closes the first, which
// answers (:link_down, :closed). One direction only (links design decision 15): nothing here needs a peer.
// Expected (guest of ESP-IDF only: the image holds the NimBLE wrapper, guest_c_sources):
//   link down :fault / closing / link down :closed / status 0.
// spawn_dangerous_carrier adds the carrier's `use` implicitly for the compiler; it is written out because the
// board image tooling (trials/targets/board_suite.sh link_closure) links a program with the modules its
// source names in `use` lines.
use dangerous_ble_gatt_board_carrier;
use Carrier;
use trial_wait_int64;

carried_on phone: (:ble_gatt) (:bluetooth, 0);

// downs: the :link_down messages so far. The first must be the second carrier's :fault, the next the
// first carrier's :closed.
fn owner(msg: :go | :second | (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
         state: { car: actor_ref, other: actor_ref, downs: int64 }) -> (:no_reply, { car: actor_ref, other: actor_ref, downs: int64 }) {
    case msg of {
        :go -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:open, self(), "peripheral:") impl ActorMessage {});
                _: timer_ref <- send_after(2000, self(), :second impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        :second -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.other, (:open, self(), "peripheral:") impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:link_up, _info: string) -> (:no_reply, state);
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, why2: atom) -> {
            sequence proc[device_io, concurrency]
                _: atom <- print("link down ");
                _: atom <- print_atom(why2);
                _: atom <- println("");
                _: boolean <- case state.downs == 0 of {
                    true -> case why2 == :fault of {
                        true -> {
                            sequence proc[device_io, concurrency]
                                _: atom <- println("closing");
                                told: boolean <- cast(state.car, :close impl ActorMessage {})
                            produces
                                pure told
                            end
                        };
                        false -> cast_exit(1)
                    };
                    false -> case why2 == :closed of {
                        true -> cast_exit(0);
                        false -> cast_exit(2)
                    }
                }
            produces
                pure (:no_reply, { car: state.car, other: state.other, downs: state.downs + 1 })
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: actor_ref <- spawn_dangerous_carrier(phone, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                other: actor_ref <- spawn_dangerous_carrier(phone, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                me: actor_ref <- spawn({ car: car, other: other, downs: 0 }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(me, :go impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
