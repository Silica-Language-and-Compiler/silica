// The board's (:ble_gatt) carrier (transport_ble_plan.md stage 7) opened as a peripheral of the Nordic
// UART Service and closed again with no central about: the carrier spawns the radio actor, which
// publishes the service, starts the controller and NimBLE and advertises. A :tx while no central has
// subscribed is (:tx_failed, :link_down). After six seconds the owner closes: the radio stops
// advertising and the owner gets (:link_down, :closed). One direction only (links design decision 15):
// nothing here needs a peer.
// Expected (guest of ESP-IDF only: the image holds the NimBLE wrapper, guest_c_sources):
//   tx failed :link_down / closing / link down :closed / status 0.
// spawn_dangerous_carrier adds the carrier's `use` implicitly for the compiler; it is written out because the
// board image tooling (trials/targets/board_suite.sh link_closure) links a program with the modules its
// source names in `use` lines.
use dangerous_ble_gatt_board_carrier;
use Carrier;
use trial_wait_int64;

carried_on phone: (:ble_gatt) (:bluetooth, 0);

fn owner(msg: :go | :tick | (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
         state: { car: actor_ref }) -> (:no_reply, { car: actor_ref }) {
    case msg of {
        :go -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:open, self(), "peripheral:") impl ActorMessage {});
                _: boolean <- cast(state.car, (:tx, "segment", self()) impl ActorMessage {});
                _: timer_ref <- send_after(6000, self(), :tick impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        :tick -> {
            sequence proc[concurrency, device_io]
                _: atom <- println("closing");
                _: boolean <- cast(state.car, :close impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:link_up, info: string) -> {
            sequence proc[device_io]
                _: atom <- print("link up ");
                _: atom <- println(info)
            produces
                pure (:no_reply, state)
            end
        };
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, why: atom) -> {
            sequence proc[device_io]
                _: atom <- print("tx failed ");
                _: atom <- print_atom(why);
                _: atom <- println("")
            produces
                pure (:no_reply, state)
            end
        };
        (:link_down, why2: atom) -> {
            sequence proc[device_io, concurrency]
                _: atom <- print("link down ");
                _: atom <- print_atom(why2);
                _: atom <- println("");
                _: boolean <- case why2 == :closed of {
                    true -> cast_exit(0);
                    false -> cast_exit(1)
                }
            produces
                pure (:no_reply, state)
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: actor_ref <- spawn_dangerous_carrier(phone, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                me: actor_ref <- spawn({ car: car }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(me, :go impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
