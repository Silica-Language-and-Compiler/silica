    STP X19, X30, [SP, #-32]!
    STP X20, X21, [SP, #16]
    ADRP X20, L_ss_arena_head
    ADD X20, X20, :lo12:L_ss_arena_head
    LDR X19, [X20]
L_ss_rel_loop:
    CBZ X19, L_ss_rel_done
    LDR X21, [X19]
    LDR X1, [X19, #8]
    MOV X0, X19
    STR X8, [SP, #-16]!
    MOV X8, #215
    SVC #0
    LDR X8, [SP], #16
    MOV X19, X21
    B L_ss_rel_loop
L_ss_rel_done:
    STR XZR, [X20]
    ADRP X1, L_ss_arena_ptr
    ADD X1, X1, :lo12:L_ss_arena_ptr
    STR XZR, [X1]
    ADRP X1, L_ss_arena_end
    ADD X1, X1, :lo12:L_ss_arena_end
    STR XZR, [X1]
    ADRP X1, L_ss_ascii_key
    ADD X1, X1, :lo12:L_ss_ascii_key
    STR XZR, [X1]
    STR XZR, [X1, #8]
    STR XZR, [X1, #16]
    STR XZR, [X1, #24]
    STR XZR, [X1, #32]
    ADRP X1, L_ss_cached_len
    ADD X1, X1, :lo12:L_ss_cached_len
    STR XZR, [X1]
    ADRP X1, L_ss_cur_key
    ADD X1, X1, :lo12:L_ss_cur_key
    STR XZR, [X1]
    ADRP X1, L_ss_cur_char
    ADD X1, X1, :lo12:L_ss_cur_char
    STR XZR, [X1]
    ADRP X1, L_ss_cur_byte
    ADD X1, X1, :lo12:L_ss_cur_byte
    STR XZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
    .bss
    .p2align 3
