.global main


main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o158|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_start@PAGE
    ADD X9, X9, trial_support_atom_start@PAGEOFF
    BLR X9

    ADRP X16, train_string_concat_0006.__lam0@PAGE
    ADD X16, X16, train_string_concat_0006.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o208|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_run@PAGE
    ADD X9, X9, trial_support_atom_run@PAGEOFF
    BLR X9

    BL _silica_rt_wait_for_exit

    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

train_string_concat_0006.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF


    BL L_concat_helper
    MOV X19, X0
    MOV X0, X19
    ; effects [device_io]
    BL L_ps_helper
    MOV X0, #2

    ; effects [device_io]
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_ps_helper:
    LDR X9, [X0]
    MOV X10, #-1
    CMP X9, X10
    B.NE L_ps_bad
    LDR X1, [X0, #8]
    LDR X2, [X0, #16]
    MOV X0, #1
    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    RET
L_ps_bad:
    BRK #1
L_psnl_helper:
    LDR X9, [X0]
    MOV X10, #-1
    CMP X9, X10
    B.NE L_psnl_helper_bad
    LDR X1, [X0, #8]
    LDR X2, [X0, #16]
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    RET
L_psnl_helper_bad:
    BRK #1
L_concat_helper:
    STP X19, X20, [SP, #-64]!
    STP X21, X22, [SP, #16]
    STP X23, X30, [SP, #32]
    MOV X19, X0
    MOV X20, X1
    LDR X9, [X19]
    MOV X10, #-1
    CMP X9, X10
    B.NE L_sc_bad
    LDR X21, [X19, #16]
    LDR X9, [X20]
    CMP X9, X10
    B.NE L_sc_bad
    LDR X22, [X20, #16]
    CBZ X21, L_sc_ret2
    CBZ X22, L_sc_ret1
    ADD X0, X21, X22
    ADD X0, X0, #25
    BL L_sc_bump_alloc
    CBZ X0, L_sc_ret
    MOV X23, X0
    MOV X9, #-1
    STR X9, [X23]
    ADD X9, X23, #24
    STR X9, [X23, #8]
    ADD X10, X21, X22
    STR X10, [X23, #16]
    LDR X10, [X19, #8]
    MOV X11, X21
L_sc_cp1:
    CBZ X11, L_sc_cp1_done
    LDRB W12, [X10]
    STRB W12, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X11, X11, #1
    B L_sc_cp1
L_sc_cp1_done:
    LDR X10, [X20, #8]
    MOV X11, X22
L_sc_cp2:
    CBZ X11, L_sc_cp2_done
    LDRB W12, [X10]
    STRB W12, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X11, X11, #1
    B L_sc_cp2
L_sc_cp2_done:
    STRB WZR, [X9]
    MOV X0, X23
    B L_sc_ret
L_sc_ret2:
    MOV X0, X20
    B L_sc_ret
L_sc_ret1:
    MOV X0, X19
L_sc_ret:
    LDP X23, X30, [SP, #32]
    LDP X21, X22, [SP, #16]
    LDP X19, X20, [SP], #64
    RET
L_sc_bad:
    BRK #1
L_sc_bump_alloc:
    STP X19, X30, [SP, #-32]!
    STP X20, X21, [SP, #16]
    ADD X0, X0, #7
    LSR X0, X0, #3
    LSL X19, X0, #3
    ADRP X1, L_sc_lock@PAGE
    ADD X1, X1, L_sc_lock@PAGEOFF
    MOV W2, #1
L_sc_lock_spin:
    LDAXR W3, [X1]
    CBNZ W3, L_sc_lock_wait
    STXR W3, W2, [X1]
    CBZ W3, L_sc_lock_held
    B L_sc_lock_spin
L_sc_lock_wait:
    CLREX
    YIELD
    B L_sc_lock_spin
L_sc_lock_held:
    ADRP X20, L_sc_arena_ptr@PAGE
    ADD X20, X20, L_sc_arena_ptr@PAGEOFF
    LDR X21, [X20]
    CBZ X21, L_sc_bump_new
    ADRP X1, L_sc_arena_end@PAGE
    ADD X1, X1, L_sc_arena_end@PAGEOFF
    LDR X2, [X1]
    ADD X3, X21, X19
    CMP X3, X2
    B.HI L_sc_bump_new
    STR X3, [X20]
    MOV X0, X21
    ADRP X1, L_sc_lock@PAGE
    ADD X1, X1, L_sc_lock@PAGEOFF
    STLR WZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_sc_bump_new:
    ADD X1, X19, #16
    MOVZ X2, #0x40, LSL #16
    CMP X1, X2
    CSEL X1, X1, X2, HI
    MOV X21, X1
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    CMN X0, #1
    B.EQ L_sc_bump_fail
    ADRP X2, L_sc_arena_head@PAGE
    ADD X2, X2, L_sc_arena_head@PAGEOFF
    LDR X3, [X2]
    STR X3, [X0]
    STR X21, [X0, #8]
    STR X0, [X2]
    ADD X1, X0, #16
    ADD X3, X1, X19
    STR X3, [X20]
    ADRP X2, L_sc_arena_end@PAGE
    ADD X2, X2, L_sc_arena_end@PAGEOFF
    ADD X3, X0, X21
    STR X3, [X2]
    MOV X0, X1
    ADRP X1, L_sc_lock@PAGE
    ADD X1, X1, L_sc_lock@PAGEOFF
    STLR WZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_sc_bump_fail:
    MOV X0, #0
    ADRP X1, L_sc_lock@PAGE
    ADD X1, X1, L_sc_lock@PAGEOFF
    STLR WZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_sc_arena_mark:
    ADRP X16, L_sc_arena_ptr@PAGE
    ADD X16, X16, L_sc_arena_ptr@PAGEOFF
    LDR X16, [X16]
    ADRP X17, L_sc_arena_head@PAGE
    ADD X17, X17, L_sc_arena_head@PAGEOFF
    LDR X17, [X17]
    RET
L_sc_arena_release_to:
    STP X29, X30, [SP, #-16]!
    STP X0, X1, [SP, #-16]!
    STP X2, X3, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X16
    MOV X20, X17
    ADRP X3, L_sc_arena_head@PAGE
    ADD X3, X3, L_sc_arena_head@PAGEOFF
    LDR X2, [X3]
L_sc_rt_loop:
    CMP X2, X20
    B.EQ L_sc_rt_done
    CBZ X2, L_sc_rt_done
    LDR X0, [X2]
    STR X0, [X3]
    LDR X1, [X2, #8]
    MOV X0, X2
    MOVZ X16, #73
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    ADRP X3, L_sc_arena_head@PAGE
    ADD X3, X3, L_sc_arena_head@PAGEOFF
    LDR X2, [X3]
    B L_sc_rt_loop
L_sc_rt_done:
    ADRP X0, L_sc_arena_ptr@PAGE
    ADD X0, X0, L_sc_arena_ptr@PAGEOFF
    STR X19, [X0]
    CBZ X20, L_sc_rt_noend
    LDR X1, [X20, #8]
    ADD X1, X20, X1
    ADRP X0, L_sc_arena_end@PAGE
    ADD X0, X0, L_sc_arena_end@PAGEOFF
    STR X1, [X0]
    B L_sc_rt_caches
L_sc_rt_noend:
    ADRP X0, L_sc_arena_end@PAGE
    ADD X0, X0, L_sc_arena_end@PAGEOFF
    STR XZR, [X0]
L_sc_rt_caches:
    ADRP X0, L_sc_len_key@PAGE
    ADD X0, X0, L_sc_len_key@PAGEOFF
    STR XZR, [X0]
    ADRP X0, L_sc_len_val@PAGE
    ADD X0, X0, L_sc_len_val@PAGEOFF
    STR XZR, [X0]
    LDP X19, X20, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_sc_arena_release:
    STP X19, X30, [SP, #-32]!
    STP X20, X21, [SP, #16]
    ADRP X20, L_sc_arena_head@PAGE
    ADD X20, X20, L_sc_arena_head@PAGEOFF
    LDR X19, [X20]
L_sc_rel_loop:
    CBZ X19, L_sc_rel_done
    LDR X21, [X19]
    LDR X1, [X19, #8]
    MOV X0, X19
    MOVZ X16, #73
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    MOV X19, X21
    B L_sc_rel_loop
L_sc_rel_done:
    STR XZR, [X20]
    ADRP X1, L_sc_arena_ptr@PAGE
    ADD X1, X1, L_sc_arena_ptr@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_sc_arena_end@PAGE
    ADD X1, X1, L_sc_arena_end@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_sc_len_key@PAGE
    ADD X1, X1, L_sc_len_key@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_sc_len_val@PAGE
    ADD X1, X1, L_sc_len_val@PAGEOFF
    STR XZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
