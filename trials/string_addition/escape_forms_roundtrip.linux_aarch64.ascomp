    LDR X8, [SP], #16
    LDP X19, X20, [SP], #16
    MOV X0, #2


    MOV X9, X23
    ADRP X10, L_str_4
    ADD X10, X10, :lo12:L_str_4


    STP X0, X1, [SP, #-16]!
