    LDR X8, [SP], #16
    LDP X19, X20, [SP], #16
    MOV X0, #2


    MOV X9, X21
    ADRP X10, L_str_2
    ADD X10, X10, :lo12:L_str_2


    STP X0, X1, [SP, #-16]!
    MOV X0, X9
    MOV X1, X10
    BL L_string_cmp_helper
    CMP W0, #0
    CSET W12, EQ
    LDP X0, X1, [SP], #16
    MOV X0, X12

    // effects [device_io]
    BL L_pb_helper
    MOV X0, #2

    // effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline
    ADD X1, X1, :lo12:L_newline
