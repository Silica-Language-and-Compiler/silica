    ADRP X9, trial_support_atom_run
    ADD X9, X9, :lo12:trial_support_atom_run
    BLR X9

    BL silica_rt_wait_for_exit

    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

