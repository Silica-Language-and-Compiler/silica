L_psnl_helper:
    LDR X9, [X0]
    MVN X10, X9
    CMP X10, #1
    B.HI L_psnl_helper_bad
    LDR X1, [X0, #8]
    LDR X2, [X0, #16]
    STR X8, [SP, #-16]!
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X8, #10
    STR X8, [SP, #32]
    ADD X0, SP, #32
    MOV X8, #1
    STP X0, X8, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X8, #66
    SVC #0
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    LDR X8, [SP], #16
    RET
L_psnl_helper_bad:
