    MOV X23, X1
    ADRP X1, L_str_5
    ADD X1, X1, :lo12:L_str_5
    MOV X24, X1
    ADRP X1, L_str_6
    ADD X1, X1, :lo12:L_str_6
    MOV X25, X1
    MOV X0, X19
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X0, X12

    // effects [device_io]
    BL L_pi_helper
    MOV X0, #2

    // effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline
    ADD X1, X1, :lo12:L_newline
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    LDP X19, X20, [SP], #16
    MOV X0, #2


    MOV X0, X20
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X0, X12

    // effects [device_io]
