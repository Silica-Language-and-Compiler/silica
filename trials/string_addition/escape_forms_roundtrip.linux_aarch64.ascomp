L_length_bytes_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    CBZ X19, Llb_z
    LDR X1, [X19]
    MVN X2, X1
    CMP X2, #1
    B.HI Llb_bad
    LDR X0, [X19, #16]
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
