    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    LDP X19, X20, [SP], #16
    MOV X0, #2


    MOV X0, X21
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X0, X12

    // effects [device_io]
