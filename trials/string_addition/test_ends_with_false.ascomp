.text
    ; use trial_support_int64
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o169|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_start@PAGE
    ADD X9, X9, trial_support_int64_start@PAGEOFF
    BLR X9

    ADRP X16, test_ends_with_false.__lam0@PAGE
    ADD X16, X16, test_ends_with_false.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o220|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_run@PAGE
    ADD X9, X9, trial_support_int64_run@PAGEOFF
    BLR X9

    BL _silica_rt_wait_for_exit

    MOV X19, X0
    MOV X0, X19



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

test_ends_with_false.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    STR X0, [SP, #-16]!
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    LDR X0, [SP], #16
    BL L_string_ends_with_helper
    MOV W3, W0
L_case_o272_br_0:
    CMP W3, #1
    B.NE L_case_o272_br_1
    MOV X0, #1
    B L_case_o272_done
L_case_o272_br_1:
    CMP W3, #0
    B.NE L_case_o272_fb
    MOV X0, #0
    B L_case_o272_done
L_case_o272_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o272_done
L_case_o272_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_string_starts_with_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lsw_false
    CBZ X20, Lsw_false
    LDR X1, [X19]
    MVN X2, X1
    CMP X2, #1
    B.HI Lsw_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    MVN X2, X1
    CMP X2, #1
    B.HI Lsw_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Lsw_n2_done:
    CBZ X24, Lsw_true
    CMP X24, X22
    B.HI Lsw_false
    MOV X25, X21
    MOV X26, X23
    MOV X27, X24
Lsw_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Lsw_false
    SUBS X27, X27, #1
    B.NE Lsw_cloop
Lsw_true:
    MOV W0, #1
    B Lsw_exit
Lsw_false:
    MOV W0, #0
Lsw_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

Lsw_bad:
    BRK #1

L_string_ends_with_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lew_false
    CBZ X20, Lew_false
    LDR X1, [X19]
    MVN X2, X1
    CMP X2, #1
    B.HI Lew_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    MVN X2, X1
    CMP X2, #1
    B.HI Lew_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Lew_n2_done:
    CBZ X24, Lew_true
    CMP X24, X22
    B.HI Lew_false
    SUB X25, X22, X24
    ADD X25, X21, X25
    MOV X26, X23
    MOV X27, X24
Lew_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Lew_false
    SUBS X27, X27, #1
    B.NE Lew_cloop
Lew_true:
    MOV W0, #1
    B Lew_exit
Lew_false:
    MOV W0, #0
Lew_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

Lew_bad:
    BRK #1

L_string_contains_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lsc_false
    CBZ X20, Lsc_false
    LDR X1, [X19]
    MVN X2, X1
    CMP X2, #1
    B.HI Lsc_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    MVN X2, X1
    CMP X2, #1
    B.HI Lsc_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Lsc_n2_done:
    CBZ X24, Lsc_true
    CMP X24, X22
    B.HI Lsc_false
    SUB X25, X22, X24
    ADD X25, X25, #1
    MOV X26, X21
Lsc_outer:
    MOV X27, X26
    MOV X28, X23
    MOV X0, X24
Lsc_inner:
    LDRB W1, [X27], #1
    LDRB W2, [X28], #1
    CMP W1, W2
    B.NE Lsc_next
    SUBS X0, X0, #1
    B.NE Lsc_inner
    B Lsc_true
Lsc_next:
    ADD X26, X26, #1
    SUBS X25, X25, #1
    B.NE Lsc_outer
    B Lsc_false
Lsc_true:
    MOV W0, #1
    B Lsc_exit
Lsc_false:
    MOV W0, #0
Lsc_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

Lsc_bad:
    BRK #1

