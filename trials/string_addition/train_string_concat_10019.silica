// concatenate of 4 pieces prints deltaomegahelloapple

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: string <- "delta";
                b: string <- "omega";
                s: string <- concatenate(a, b);
                s0: string <- concatenate(s, "hello");
                s1: string <- concatenate(s0, "apple");
                print_string(s1);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
