// Spec 4.1.6: a string is a byte buffer -- any byte may appear at any position,
// including bytes that are not valid UTF-8. Spec 5.3.1: length_bytes counts
// bytes exactly; length_chars counts a byte outside a well-formed UTF-8
// sequence as one character.
//
// A literal whose FIRST byte is 0xFF previously collided with the string
// descriptor tag and crashed the compiler (EXC_BAD_ACCESS, then an infinite
// containment retry loop). Compiling this file at all is part of the test.
//
// Expected: 1 1 3 3 4 true true false
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] ff: string <- "\xFF";
                hi: string <- "\x80\xFE\xFF";
                print_int64(length_bytes(ff));
                println();
                print_int64(length_chars(ff));
                println();
                print_int64(length_bytes(hi));
                println();
                print_int64(length_chars(hi));
                println();
                print_int64(length_bytes(concatenate(ff, hi)));
                println();
                print_boolean(substring(hi, 1, 2) == "\xFE");
                println();
                print_boolean(ff == "\xFF");
                println();
                print_boolean(ff == "\xFE")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
