main:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA
    mov QWORD PTR [rbp - SVR_CS0], rbx
    mov QWORD PTR [rbp - SVR_CS1], r12
    mov QWORD PTR [rbp - SVR_CS2], r13
    mov QWORD PTR [rbp - SVR_CS3], r14
    mov QWORD PTR [rbp - SVR_CS4], r15

    call silica_pid_registry_init
    call silica_dangerous_pid_registry_init
    call silica_device_pid_registry_init
    // unsupported term kind (dummy k)?
    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    // effects []|sir_rec:o163|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    mov rbx, 0
    lea r10, [rip + trial_support_int64_start]
    call r10

    lea rax, [rip + train_string_strcase_0001.__lam0]
    mov QWORD PTR [rbp - SVR_X16], rax

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    // effects []|sir_rec:o214|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    mov rbx, 0
    lea r10, [rip + trial_support_int64_run]
    call r10

    call silica_rt_wait_for_exit

    mov QWORD PTR [rbp - SVR_X19], rdi
    mov rdi, QWORD PTR [rbp - SVR_X19]




    mov rax, rdi
    mov rbx, QWORD PTR [rbp - SVR_CS0]
    mov r12, QWORD PTR [rbp - SVR_CS1]
    mov r13, QWORD PTR [rbp - SVR_CS2]
    mov r14, QWORD PTR [rbp - SVR_CS3]
    mov r15, QWORD PTR [rbp - SVR_CS4]
    leave
    ret

.set SVR_AREA, 16
.set SVR_X12, 8
.set SVR_X19, 16
.globl train_string_strcase_0001.__lam0
train_string_strcase_0001.__lam0:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA

    lea rsi, [rip + L_str_0]

    mov QWORD PTR [rbp - SVR_X19], rsi
    mov rcx, QWORD PTR [rbp - SVR_X19]

L_case_o303_br_0:
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rcx
    lea r8, [rip + L_str_0]

    mov rdi, rcx
    mov rsi, r8
    call L_string_eq_helper
    mov eax, edi
    mov QWORD PTR [rbp - SVR_X12], rax
    mov rcx, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    cmp DWORD PTR [rbp - SVR_X12], 0
    je L_case_o303_br_1
    mov rdi, 63

    jmp L_case_o303_done
L_case_o303_br_1:
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rcx
    lea r8, [rip + L_str_1]

