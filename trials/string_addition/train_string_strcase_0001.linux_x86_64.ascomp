    mov rcx, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    cmp DWORD PTR [rbp - SVR_X12], 0
    je L_case_o303_br_3
    mov rdi, 71

    jmp L_case_o303_done
L_case_o303_br_3:
    mov rdi, 69

    jmp L_case_o303_done
L_case_o303_fb:
    call silica_rt_case_clause
    mov rdi, 0
    jmp L_case_o303_done
L_case_o303_done:


    leave
    ret
L_pa_helper:
    test rdi, rdi
    js L_pa_oob
    cmp rdi, 28
    jge L_pa_oob
    lea r9, [rip + L_pa_table]
    mov r10, rdi
    shl r10, 4
    add r9, r10
    mov rsi, QWORD PTR [r9]
    mov rdx, QWORD PTR [r9 + 8]
    mov edi, 1
    mov eax, 1
    syscall
    xor edi, edi
    ret
L_pa_oob:
    xor edi, edi
    ret

L_string_eq_helper:
    push rbp
    mov rbp, rsp
    push rbx
    push r12
    push r13
    push r14
    push r15
    mov rbx, rdi
    mov r12, rsi
    test rbx, rbx
    jz Leq_anull
    test r12, r12
    jz Leq_neq
    mov rsi, QWORD PTR [rbx]
    mov rdx, -1
    cmp rsi, rdx
    jne Leq_bad
    mov r13, QWORD PTR [rbx + 8]
    mov r14, QWORD PTR [rbx + 16]
    mov rsi, QWORD PTR [r12]
    cmp rsi, rdx
    jne Leq_bad
    mov r15, QWORD PTR [r12 + 8]
    mov r8, QWORD PTR [r12 + 16]
Leq_n2_done:
    cmp r14, r8
    jne Leq_neq
    test r14, r14
    jz Leq_yes
    mov r9, r13
    mov r10, r15
    mov r11, r14
Leq_cloop:
    movzx ecx, BYTE PTR [r9]
    add r9, 1
    movzx eax, BYTE PTR [r10]
    add r10, 1
    cmp ecx, eax
    jne Leq_neq
    sub r11, 1
    jne Leq_cloop
Leq_yes:
    mov edi, 1
    jmp Leq_exit
Leq_anull:
    test r12, r12
    jz Leq_yes
    jmp Leq_neq
Leq_neq:
    xor edi, edi
Leq_exit:
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbx
    pop rbp
    ret
Leq_bad:
    ud2

