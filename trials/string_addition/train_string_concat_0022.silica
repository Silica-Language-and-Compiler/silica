// concatenate of 4 pieces prints applestone世界alpha

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "apple";
                b: string <- "stone";
                s: string <- concatenate(a, b);
                s0: string <- concatenate(s, "世界");
                s1: string <- concatenate(s0, "alpha");
                print_string(s1);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
