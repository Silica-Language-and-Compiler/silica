// Spec 4.1.6: a string carries its length explicitly and is NOT terminated by a
// sentinel byte, so 0x00 is ordinary data: "a\x00b" is a three-byte string and
// length_bytes("\x00") is 1.
//
// Under the old NUL-terminated representation the 0x00 escape resolved to an
// empty string, so "a\x00b" silently became "ab" (2 bytes) and "a\x00b" compared
// EQUAL to "a\x00c" -- silent corruption, not a crash.
//
// Expected: 1 3 2 1 3 false true
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] z: string <- "\x00";
                ab: string <- "a\x00b";
                print_int64(length_bytes(z));
                println();
                print_int64(length_bytes(ab));
                println();
                print_int64(length_bytes(concatenate(z, z)));
                println();
                print_int64(length_bytes(substring(ab, 1, 2)));
                println();
                print_int64(length_bytes(concatenate("a\x00", "b")));
                println();
                print_boolean(ab == "a\x00c");
                println();
                print_boolean(ab == "a\x00b")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
