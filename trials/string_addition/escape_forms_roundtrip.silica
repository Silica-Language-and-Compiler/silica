// Trial: every escape form must survive the literal emitter.
//
// Literals are emitted from their UNRESOLVED source text and translated to
// assembler escapes (\x00 -> \000, \xFF -> \377), so a regression in that
// translator silently changes byte content or length. Strings are byte buffers
// (§4.1.6): length_bytes counts bytes exactly.
// Want: 1 1 1 1 1 1 5 true true
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] nl: string <- "\n";
                tb: string <- "\t";
                bs: string <- "\\";
                qt: string <- "\"";
                hi: string <- "\xFF";
                lo: string <- "\x01";
                mix: string <- "a\tb\\c";
                print_int64(length_bytes(nl));
                println();
                print_int64(length_bytes(tb));
                println();
                print_int64(length_bytes(bs));
                println();
                print_int64(length_bytes(qt));
                println();
                print_int64(length_bytes(hi));
                println();
                print_int64(length_bytes(lo));
                println();
                print_int64(length_bytes(mix));
                println();
                print_boolean(bs == "\\");
                println();
                print_boolean(hi == "\xFF")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
