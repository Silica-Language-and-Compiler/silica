.text
    ; use trial_support_atom
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    BL _silica_device_pid_registry_init
    ; push dummy argument slot
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o157|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_start@PAGE
    ADD X9, X9, trial_support_atom_start@PAGEOFF
    BLR X9

    ADRP X16, train_string_until_0002.__lam0@PAGE
    ADD X16, X16, train_string_until_0002.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o207|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_atom_run@PAGE
    ADD X9, X9, trial_support_atom_run@PAGEOFF
    BLR X9

    BL _silica_rt_wait_for_exit

    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

train_string_until_0002.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #-16]!
    MOV X9, #6
    STR X9, [SP, #-16]!
    ADRP X9, L_i64_0@PAGE
    LDR X9, [X9, L_i64_0@PAGEOFF]
    MOV X2, X9
    LDR X1, [SP], #16
    LDR X0, [SP], #16
    BL L_substring_until_char_helper
    MOV X19, X0
    MOV X0, X19
    ; effects [device_io]
    BL L_ps_helper
    MOV X0, #2

    ; effects [device_io]
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    LDR X1, [X1, #8]
    MOV X2, #0
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    MOV X0, #2


    MOV X0, #2



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_ps_helper:
    LDR X9, [X0]
    MOV X10, #-1
    CMP X9, X10
    B.NE L_ps_bad
    LDR X1, [X0, #8]
    LDR X2, [X0, #16]
    MOV X0, #1
    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    RET
L_ps_bad:
    BRK #1
L_psnl_helper:
    LDR X9, [X0]
    MOV X10, #-1
    CMP X9, X10
    B.NE L_psnl_helper_bad
    LDR X1, [X0, #8]
    LDR X2, [X0, #16]
    SUB SP, SP, #48
    STP X1, X2, [SP]
    MOV X16, #10
    STR X16, [SP, #32]
    ADD X0, SP, #32
    MOV X16, #1
    STP X0, X16, [SP, #16]
    MOV X0, #1
    MOV X1, SP
    MOV X2, #2
    STP X19, X20, [SP, #-16]!
    MOV X16, #121
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #48
    RET
L_psnl_helper_bad:
    BRK #1
L_substring_until_char_helper:
    STP X19, X20, [SP, #-80]!
    STP X21, X22, [SP, #16]
    STP X23, X14, [SP, #32]
    STP X15, X30, [SP, #48]
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2
    LSR X14, X21, #56
    MOV W15, W21
    CMP X14, #0
    CINC X14, X14, EQ
    LDR X9, [X19]
    MOV X10, #-1
    CMP X9, X10
    B.NE L_suc_bad
    LDR X22, [X19, #16]
    LDR X19, [X19, #8]
L_suc_len_done:
    CMP X20, #0
    CSEL X20, XZR, X20, LT
    CMP X20, X22
    CSEL X20, X22, X20, GT
    MOV X23, X20
    ADD X9, X19, X20
L_suc_scan:
    CMP X20, X22
    B.GE L_suc_scan_done
    LDRB W10, [X9]
    ADD X17, X20, X14
    CMP X17, X22
    B.GT L_suc_no_match
    CMP X14, #1
    B.EQ L_suc_cmp1
    CMP X14, #2
    B.EQ L_suc_cmp2
    CMP X14, #3
    B.EQ L_suc_cmp3
    LDR W13, [X9]
    CMP W13, W15
    B.EQ L_suc_scan_done
    B L_suc_no_match
L_suc_cmp1:
    LDRB W13, [X9]
    UBFX W16, W15, #0, #8
    CMP W13, W16
    B.EQ L_suc_scan_done
    B L_suc_no_match
L_suc_cmp2:
    LDRH W13, [X9]
    UBFX W16, W15, #0, #16
    CMP W13, W16
    B.EQ L_suc_scan_done
    B L_suc_no_match
L_suc_cmp3:
    LDR W13, [X9]
    UBFX W13, W13, #0, #24
    UBFX W16, W15, #0, #24
    CMP W13, W16
    B.EQ L_suc_scan_done
L_suc_no_match:
    CMP W10, #0x80
    B.LO L_suc_adv1
    CMP W10, #0xC2
    B.LO L_suc_adv1
    CMP W10, #0xE0
    B.LO L_suc_adv2
    CMP W10, #0xF0
    B.LO L_suc_adv3
    CMP W10, #0xF8
    B.LO L_suc_adv4
L_suc_adv1:
    ADD X9, X9, #1
    ADD X20, X20, #1
    B L_suc_scan
L_suc_adv2:
    SUB X12, X22, X20
    MOV X17, #2
    CMP X12, #2
    CSEL X17, X12, X17, LO
    ADD X9, X9, X17
    ADD X20, X20, X17
    B L_suc_scan
L_suc_adv3:
    SUB X12, X22, X20
    MOV X17, #3
    CMP X12, #3
    CSEL X17, X12, X17, LO
    ADD X9, X9, X17
    ADD X20, X20, X17
    B L_suc_scan
L_suc_adv4:
    SUB X12, X22, X20
    MOV X17, #4
    CMP X12, #4
    CSEL X17, X12, X17, LO
    ADD X9, X9, X17
    ADD X20, X20, X17
    B L_suc_scan
L_suc_scan_done:
    SUB X11, X20, X23
    CBZ X11, L_suc_empty
    ADD X10, X19, X23
    ADD X0, X11, #25
    BL L_suc_bump_alloc
    CBZ X0, L_suc_ret
    MOV X23, X0
    MOV X9, #-1
    STR X9, [X23]
    ADD X9, X23, #24
    STR X9, [X23, #8]
    STR X11, [X23, #16]
    MOV X12, X11
L_suc_cp:
    CBZ X12, L_suc_cp_done
    LDRB W13, [X10]
    STRB W13, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X12, X12, #1
    B L_suc_cp
L_suc_cp_done:
    STRB WZR, [X9]
    MOV X0, X23
    B L_suc_ret
L_suc_empty:
    ADRP X0, L_suc_empty_str@PAGE
    ADD X0, X0, L_suc_empty_str@PAGEOFF
L_suc_ret:
    LDP X15, X30, [SP, #48]
    LDP X23, X14, [SP, #32]
    LDP X21, X22, [SP, #16]
    LDP X19, X20, [SP], #80
    RET
L_suc_bump_alloc:
    STP X19, X30, [SP, #-32]!
    STP X20, X21, [SP, #16]
    ADD X0, X0, #7
    LSR X0, X0, #3
    LSL X19, X0, #3
    ADRP X1, L_suc_lock@PAGE
    ADD X1, X1, L_suc_lock@PAGEOFF
    MOV W2, #1
L_suc_lk_bump_spin:
    LDAXR W3, [X1]
    CBNZ W3, L_suc_lk_bump_wait
    STXR W3, W2, [X1]
    CBZ W3, L_suc_lk_bump_held
    B L_suc_lk_bump_spin
L_suc_lk_bump_wait:
    CLREX
    YIELD
    B L_suc_lk_bump_spin
L_suc_lk_bump_held:
    ADRP X20, L_suc_arena_ptr@PAGE
    ADD X20, X20, L_suc_arena_ptr@PAGEOFF
    LDR X21, [X20]
    CBZ X21, L_suc_bump_new
    ADRP X1, L_suc_arena_end@PAGE
    ADD X1, X1, L_suc_arena_end@PAGEOFF
    LDR X2, [X1]
    ADD X3, X21, X19
    CMP X3, X2
    B.HI L_suc_bump_new
    STR X3, [X20]
    MOV X0, X21
    ADRP X1, L_suc_lock@PAGE
    ADD X1, X1, L_suc_lock@PAGEOFF
    STLR WZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_suc_bump_new:
    ADD X1, X19, #16
    MOVZ X2, #0x40, LSL #16
    CMP X1, X2
    CSEL X1, X1, X2, HI
    MOV X21, X1
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    CMN X0, #1
    B.EQ L_suc_bump_fail
    ADRP X2, L_suc_arena_head@PAGE
    ADD X2, X2, L_suc_arena_head@PAGEOFF
    LDR X3, [X2]
    STR X3, [X0]
    STR X21, [X0, #8]
    STR X0, [X2]
    ADD X1, X0, #16
    ADD X3, X1, X19
    STR X3, [X20]
    ADRP X2, L_suc_arena_end@PAGE
    ADD X2, X2, L_suc_arena_end@PAGEOFF
    ADD X3, X0, X21
    STR X3, [X2]
    MOV X0, X1
    ADRP X1, L_suc_lock@PAGE
    ADD X1, X1, L_suc_lock@PAGEOFF
    STLR WZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_suc_bump_fail:
    MOV X0, #0
    ADRP X1, L_suc_lock@PAGE
    ADD X1, X1, L_suc_lock@PAGEOFF
    STLR WZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
