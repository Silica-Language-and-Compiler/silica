// string helper count_a_rec; prints 3
use trial_support_atom;

fn count_a_rec(s: string) -> int64 {
    case length_chars(s) == 0 of {
        true -> 0;
        false -> count_a_step(s)
    }
}

fn count_a_step(s: string) -> int64 {
    head: string <- substring(s, 0, 1);
    rest: string <- substring(s, 1, length_chars(s));
    case head == "a" of {
        true -> 1 + count_a_rec(rest);
        false -> count_a_rec(rest)
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                result: atom <- print_int64(count_a_rec("banana"))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
