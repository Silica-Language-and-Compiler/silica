// Spec §5.1.1 defines `print(value: string) -> atom proc[device_io]` as a built-in string-printing intrinsic
// alongside `println`, with the same signature shape as every other print_* builtin. Until 2026-09-24 the
// compiler implemented `print_string` but never registered a builtin named `print`: the type checker and the
// effect checker accepted the call, the SIR generator had no lowering for it, and it reached the linker as
// the undefined symbol `main_print` ("Undefined symbols for architecture arm64"). `print` now lowers exactly
// like `print_string`, and a builtin the type checker accepts but the code generator cannot lower is a
// compile-time E4001 naming the module, the function and the builtin (sir_generator/sir_call_verify).
// Formerly defect_print_undefined_builtin (book-verification 2026-09-19, repros r_print / r_print2).
// Expected: prints "yes" then a newline, exit code 2 (module atom table index of :ok, as in this suite).

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print("yes");
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
