// substring / substring_until_char whose bounds are the function's own parameters, with the first
// parameter still in its ABI register X0. The emitter used to stage the string argument straight
// into X0, destroying the parameter the start and end were then computed from: digit(4) came back
// empty (found by the lane A1 D12 stress trial, 2026-09-19). Arguments are now evaluated into a
// scratch register and parked until all three are known.
// Expected:
//   42
//   bc
//   brave
//   0

use trial_support_int64;

fn digit(d: int64) -> string {
    substring("0123456789", d, d + 1)
}

fn slice_two(e: int64, s: string) -> string {
    substring(s, e, e + 2)
}

fn word_from(e: int64, s: string) -> string {
    substring_until_char(s, e, ' ')
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                a: string <- digit(4);
                b: string <- digit(2);
                println(concat(a, b));
                println(slice_two(1, "abcdef"));
                println(word_from(6, "hello brave world"))
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
