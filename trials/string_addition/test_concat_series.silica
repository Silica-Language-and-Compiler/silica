use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "A";
                b: string <- "B";
                c: string <- concatenate(a, b);
                d: string <- concatenate(c, "C");
                e: string <- concatenate("0", d);
                f: string <- concatenate(e, "9");
                print_string(f);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
