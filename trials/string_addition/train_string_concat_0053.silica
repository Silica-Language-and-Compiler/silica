// concatenate of 3 pieces prints silicaαβγZürich

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                a: string <- "silica";
                b: string <- "αβγ";
                s: string <- concatenate(a, b);
                s0: string <- concatenate(s, "Zürich");
                print_string(s0);
                println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
