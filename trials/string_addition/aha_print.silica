use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] s: string <- "😎";
                print_string(s);
                println();
                print_string("Hello Matt. How are you doing?");
                println();
                print_string("Guess what? I was compiled using the first version of the completely self-hosted Silica compiler!");
                println();
                print_string("Won't be long before my friendly compiler who compiled me rules the world!");
                println();
                print_string("Would you like to play a game?🚀🚀🚀");
                println();
                print_string("😎🌍🌍🌏😎🌍🌍🌏😎")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
