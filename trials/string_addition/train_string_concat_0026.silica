// concatenate of 3 pieces prints cherrycaféalpha

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "cherry";
                b: string <- "café";
                s: string <- concatenate(a, b);
                s0: string <- concatenate(s, "alpha");
                print_string(s0);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
