// concat of 3 pieces prints 🎉Zürichnorth

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] a: string <- "🎉";
                b: string <- "Zürich";
                s: string <- concat(a, b);
                s0: string <- concat(s, "north");
                print_string(s0);
                println("")
                produces pure :ok end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
