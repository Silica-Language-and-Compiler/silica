// A record built in this unit and passed INTO a generic function (gpass@value_of / tag_of): the
// generic unit reads its ItemType field as one word and the field after it at the next word, so
// both units must lay a record-typed field out as one pointer slot (the boxed record layout, see
// the header of emitter/*/terms/prims/prims_record.silica). The second box holds a nested record
// LITERAL rather than a variable, which takes the literal's own promote path.
// Expected output: 7, 8, 5, 11, 12, 6, then exit 0.

use gpass;
use trial_support_int64;

fn cmp_pair(a: { a: int64, b: int64 }, b: { a: int64, b: int64 }) -> :less | :equal | :greater {
    case a.a < b.a of {
        true -> :less;
        false -> case a.a == b.a of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                item: { a: int64, b: int64 } <- { a: 7, b: 8 };
                box: { status: :not_found | :found, value: { a: int64, b: int64 }, tag: int64 } <- { status: :found, value: item, tag: 5 };
                f: { a: int64, b: int64 } <- gpass@value_of({ compare_item: cmp_pair }, box);
                t: int64 <- gpass@tag_of({ compare_item: cmp_pair }, box);
                lit_box: { status: :not_found | :found, value: { a: int64, b: int64 }, tag: int64 } <- { status: :found, value: { a: 11, b: 12 }, tag: 6 };
                g: { a: int64, b: int64 } <- gpass@value_of({ compare_item: cmp_pair }, lit_box);
                t2: int64 <- gpass@tag_of({ compare_item: cmp_pair }, lit_box);
                fa: int64 <- f.a;
                fb: int64 <- f.b;
                ga: int64 <- g.a;
                gb: int64 <- g.b;
                print_int64(fa);
                println("");
                print_int64(fb);
                println("");
                print_int64(t);
                println("");
                print_int64(ga);
                println("");
                print_int64(gb);
                println("");
                print_int64(t2);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
