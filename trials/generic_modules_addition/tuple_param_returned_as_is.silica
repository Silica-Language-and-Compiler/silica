// A tuple-returning function whose body (after any let spine) is a parameter returned as it is.
// The epilogue copied the tuple to the region and then popped a 16-byte return slab the body never
// pushed, so the callee-saved restores read the caller's words and the function returned to a garbage
// address: the identity edge_target of ordered_data_structures/graph_live_core/gl_tuple_node_ids
// (tuple vertex IDs through graph_wbt_directed) looped or faulted, and so did a plain call of it.
// Pre-existing (999974 hangs on it too); fixed 2026-09-19 in emitter_core@esf_tuple_ret_dealloc
// (tuple_return_tail_is_variable). apply_pair calls the function value the way the generic
// graph module does.
// Expected output: 1 2, then 1 2, then 5 6, one number per line; exit 0.

use trial_support_int64;

fn ident_pair(p: (int64, int64)) -> (int64, int64) {
    p
}

fn keep_after_let(p: (int64, int64), n: int64) -> (int64, int64) {
    sequence
        _: int64 <- n + 1
    produces
        pure p
    end
}

fn apply_pair(f: fn((int64, int64)) -> (int64, int64), v: (int64, int64)) -> (int64, int64) {
    f(v)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                x: (int64, int64) <- (1, 2);
                y: (int64, int64) <- ident_pair(x);
                (y0: int64, y1: int64) <- y;
                print_int64(y0);
                println("");
                print_int64(y1);
                println("");
                z: (int64, int64) <- keep_after_let(y, 3);
                (z0: int64, z1: int64) <- z;
                print_int64(z0);
                println("");
                print_int64(z1);
                println("");
                w: (int64, int64) <- apply_pair(ident_pair, (5, 6));
                (w0: int64, w1: int64) <- w;
                print_int64(w0);
                println("");
                print_int64(w1);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
