// Companion to two_generic_collections_round_trip (D13, docs/learn-silica.md §10): the RECORD form of
// the original report -- job_queue@empty_jobs' { queue, seen } -- built by pair_sets@make_record from
// two wbt_set instances, returned across the module boundary and passed back in. A let-bound
// aggregate stored in a record field is copied to the region at the store (boxed record layout), so
// this form already worked while the tuple form faulted; it stays as the regression guard.
// Expected: "0 at start", exit 0.

use pair_sets;
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                p: { ints: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } } <- pair_sets@make_record();
                _: atom <- print_int64(pair_sets@waiting_record(p));
                println(" at start")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
