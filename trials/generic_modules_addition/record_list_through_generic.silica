// Lists of records crossing a generic boundary in both directions. A List[ItemType] cell in a
// generic unit holds one word, so a concrete List[{ a, b }] cell must hold one word too (a
// pointer to the record): gpass walks, indexes and extends a list built here, and builds one
// that this unit walks with .head and [h | t] patterns.
// Expected output: 3, 2 20, 0 5, 4, 65, 7 70 8 80, then exit 0.

use gpass;
use trial_support_int64;

fn cmp_ab(p: { a: int64, b: int64 }, q: { a: int64, b: int64 }) -> :less | :equal | :greater {
    case p.a < q.a of {
        true -> :less;
        false -> case p.a == q.a of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cons_ab(x: { a: int64, b: int64 }, rest: List[{ a: int64, b: int64 }, mem(normal)]) -> List[{ a: int64, b: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[{ a: int64, b: int64 }, mem(normal)] <- prepend[{ a: int64, b: int64 }, mem(normal)](x, rest)
    produces
        pure out
    end
}

fn nil_ab() -> List[{ a: int64, b: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[{ a: int64, b: int64 }, mem(normal)] <- empty[{ a: int64, b: int64 }, mem(normal)]()
    produces
        pure out
    end
}

fn length_ab(xs: List[{ a: int64, b: int64 }, mem(normal)], acc: int64) -> int64 {
    case xs of {
        []: List[{ a: int64, b: int64 }, mem(normal)] -> acc;
        [h: { a: int64, b: int64 }, t: List[{ a: int64, b: int64 }, mem(normal)]] -> length_ab(t, acc + 1)
    }
}

fn sum_b(xs: List[{ a: int64, b: int64 }, mem(normal)], acc: int64) -> int64 {
    case xs of {
        []: List[{ a: int64, b: int64 }, mem(normal)] -> acc;
        [h: { a: int64, b: int64 }, t: List[{ a: int64, b: int64 }, mem(normal)]] -> sum_b(t, acc + h.b)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                r1: { a: int64, b: int64 } <- { a: 1, b: 10 };
                r2: { a: int64, b: int64 } <- { a: 2, b: 20 };
                r3: { a: int64, b: int64 } <- { a: 3, b: 30 };
                e: List[{ a: int64, b: int64 }, mem(normal)] <- nil_ab();
                l3: List[{ a: int64, b: int64 }, mem(normal)] <- cons_ab(r3, e);
                l2: List[{ a: int64, b: int64 }, mem(normal)] <- cons_ab(r2, l3);
                xs: List[{ a: int64, b: int64 }, mem(normal)] <- cons_ab(r1, l2);
                n: int64 <- gpass@count_items({ compare_item: cmp_ab }, xs);
                s: { a: int64, b: int64 } <- gpass@second_item({ compare_item: cmp_ab }, xs);
                z: { a: int64, b: int64 } <- { a: 0, b: 5 };
                ys: List[{ a: int64, b: int64 }, mem(normal)] <- gpass@push_item({ compare_item: cmp_ab }, z, xs);
                yh: { a: int64, b: int64 } <- ys.head;
                ylen: int64 <- length_ab(ys, 0);
                total: int64 <- sum_b(ys, 0);
                p7: { a: int64, b: int64 } <- { a: 7, b: 70 };
                p8: { a: int64, b: int64 } <- { a: 8, b: 80 };
                ps: List[{ a: int64, b: int64 }, mem(normal)] <- gpass@pair_items({ compare_item: cmp_ab }, p7, p8);
                ph: { a: int64, b: int64 } <- ps.head;
                pt: List[{ a: int64, b: int64 }, mem(normal)] <- ps.tail;
                pn: { a: int64, b: int64 } <- pt.head;
                sa: int64 <- s.a;
                sb: int64 <- s.b;
                ya: int64 <- yh.a;
                yb: int64 <- yh.b;
                pha: int64 <- ph.a;
                phb: int64 <- ph.b;
                pna: int64 <- pn.a;
                pnb: int64 <- pn.b;
                print_int64(n);
                println("");
                print_int64(sa);
                print_string(" ");
                print_int64(sb);
                println("");
                print_int64(ya);
                print_string(" ");
                print_int64(yb);
                println("");
                print_int64(ylen);
                println("");
                print_int64(total);
                println("");
                print_int64(pha);
                print_string(" ");
                print_int64(phb);
                print_string(" ");
                print_int64(pna);
                print_string(" ");
                print_int64(pnb);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
