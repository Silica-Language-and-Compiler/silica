// Helper for emitter_defect_two_generic_collections_round_trip: combines two instances of the
// generic wbt_set collection (one over int64, one over string) into a tuple and hands it back
// out, the same shape job_queue@empty_jobs/waiting used in the original D13 report (a
// (PriorityQueue, OrderedSet) tuple). This module is the unit boundary: main builds nothing
// itself, it only calls in and passes the tuple back.

use wbt_set;

export make_pair/0;
export waiting/1;
export make_record/0;
export waiting_record/1;

fn compare_ints(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn make_pair() -> (
    { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 },
    { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }
) {
    a: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- wbt_set@empty({ compare_item: compare_ints });
    b: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- wbt_set@empty({ compare_item: compare_names });
    (a, b)
}

fn waiting(p: (
    { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 },
    { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }
)) -> int64 {
    (a: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, _: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) <- p;
    wbt_set@size(a)
}

fn make_record() -> { ints: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } } {
    a: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- wbt_set@empty({ compare_item: compare_ints });
    b: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- wbt_set@empty({ compare_item: compare_names });
    { ints: a, names: b }
}

fn waiting_record(p: { ints: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(string, string) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } }) -> int64 {
    wbt_set@size(p.ints)
}
