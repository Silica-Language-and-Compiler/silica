// Layer 2 §8A.1–§8A.5 / §8A.7–§8A.8 / §8A.10 — Adams WBT set core: smart nodes, read-only helpers,
// (3,2) balance/rotations, insert, delete, from_sorted, validate.
// Node shape (inline at every boundary): (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)); every ref? to a node spells it, so rec binds to it.

export empty/1;
export smart_node/4;
export subtree_cached_size/1;
export size/1;
export search_status/2;
export contains/2;
export fold/3;
export singleton/2;
export from_list/2;
export apply_compare_item/3;
export minimum/2;
export maximum/2;
export weight/1;
export weight_le_3x/2;
export weight_lt_2x/2;
export weights_balanced/2;
export balance_left/4;
export balance_right/4;
export insert/2;
export delete/2;
export delete_min/2;
export delete_max/2;
export from_sorted/2;
export from_sorted_counted/3;
export from_sorted_error_code/1;
export from_sorted_preflight_status/4;
export validate/1;
export validate_with_compare/2;
export validate_error_code/1;

// Internal helper: local `empty(...)` is otherwise resolved as the list primitive.
fn empty_set(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        ph: region(L, normal) <- canonical_arena_lookup(1);
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: :none,
            compare_item: functions.compare_item,
            region: ph,
            specialization_key: 0,
            compare_item_ordering_bundle: 0
        }
    produces
        pure out
    end
}

fn empty(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    empty_set(functions)
}

fn walk_search_cmp(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    node_key: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence
        cmp: atom <- compare_checked(item, node_key, set.compare_item)
    produces
        pure case cmp of {
            :less -> walk_search(set, item, left);
            :equal -> :found;
            :greater -> walk_search(set, item, right);
            _: atom -> :invalid_comparator_result
        }
    end
}

fn compare_checked(
    item: ItemType,
    node_key: ItemType,
    compare_item: fn(ItemType, ItemType) -> atom
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare_item(item, node_key))
    produces
        pure result
    end
}

fn apply_compare_item(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    a: ItemType,
    b: ItemType
) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_checked(a, b, set.compare_item)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> apply_compare_invalid_halt_item(bad, a)
        }
    end
}

fn apply_compare_invalid_halt_item(_: atom, placeholder: ItemType) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0;
        _: ItemType <- placeholder
    produces
        pure :equal
    end
}

fn singleton(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    item: ItemType
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence
        empty0: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- empty_set(functions);
        ins: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- insert(empty0, item)
    produces
        pure ins.set
    end
}

fn from_list_cons(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    head: ItemType,
    tail: List[ItemType, mem(normal)]
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence
        ins: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- insert(set, head)
    produces
        pure from_list_go(ins.set, tail)
    end
}

fn from_list_go(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)]
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    case items of {
        []: List[ItemType, mem(normal)] -> set;
        [h: ItemType, t: List[ItemType, mem(normal)]] ->
            from_list_cons(set, h, t)
    }
}

fn from_list(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    items: List[ItemType, mem(normal)]
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        empty0: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- empty_set(functions);
        built: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- from_list_go(empty0, items)
    produces
        pure { set: built, valid: true, error: :ok }
    end
}

fn subtree_cached_size(subtree: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> int64 {
    case subtree of {
        :none -> 0;
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (_, sz: int64, _, _) <- node
            produces
                pure sz
            end
        }
    }
}

fn sum_lr_ok(left_sz: int64, right_sz: int64) -> boolean {
    sum_pair: (boolean, int64) <- checked_int64_add(left_sz, right_sz);
    (ok: boolean, _: int64) <- sum_pair;
    ok
}

fn sum_lr_partial(left_sz: int64, right_sz: int64) -> int64 {
    sum_pair: (boolean, int64) <- checked_int64_add(left_sz, right_sz);
    (_: boolean, partial: int64) <- sum_pair;
    partial
}

fn partial_add1_ok(partial: int64) -> boolean {
    add1_pair: (boolean, int64) <- checked_int64_add1(partial);
    (ok: boolean, _: int64) <- add1_pair;
    ok
}

fn partial_add1_size(partial: int64) -> int64 {
    add1_pair: (boolean, int64) <- checked_int64_add1(partial);
    (_: boolean, cached_size: int64) <- add1_pair;
    cached_size
}

fn smart_node_finish_alloc(
    item: ItemType,
    arena: region(L, normal),
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    cached_size: int64
) -> (region(L, normal), ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) {
    sequence proc[mem(normal)]
        cell: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <-
            alloc_rec(arena, (item, cached_size, left, right))
    produces
        pure (arena, cell)
    end
}

fn smart_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    left_sz: int64 <- subtree_cached_size(left);
    right_sz: int64 <- subtree_cached_size(right);
    sum_pair: (boolean, int64) <- checked_int64_add(left_sz, right_sz);
    (sum_ok: boolean, partial: int64) <- sum_pair;
    add1_pair: (boolean, int64) <- checked_int64_add1(partial);
    (add_ok: boolean, cached_size: int64) <- add1_pair;
    arena: region(L, normal) <- set.region;
    case sum_ok of {
        false -> :none;
        true -> case add_ok of {
            false -> :none;
            true -> {
                alloc_pair: (region(L, normal), ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- smart_node_finish_alloc(item, arena, left, right, cached_size);
                (_: region(L, normal), cell: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- alloc_pair;
                cell
            }
        }
    }
}

fn minimum_cmp(
    node_key: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case left of {
        :none -> { status: :found, item: node_key };
        _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> minimum_subtree(left, placeholder)
    }
}

fn maximum_cmp(
    node_key: ItemType,
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case right of {
        :none -> { status: :found, item: node_key };
        _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> maximum_subtree(right, placeholder)
    }
}

fn size(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> int64 {
    case set.root of {
        :none -> 0;
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (_, sz: int64, _, _) <- node
            produces
                pure sz
            end
        }
    }
}

fn weight_empty() -> (boolean, int64) {
    (true, 1)
}

fn weight_subtree(subtree: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> (boolean, int64) {
    case subtree of {
        :none -> weight_empty();
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (_, sz: int64, _, _) <- node
            produces
                pure checked_int64_add1(sz)
            end
        }
    }
}

fn weight(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> (boolean, int64) {
    case set.root of {
        :none -> (true, 1);
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (_, sz: int64, _, _) <- node
            produces
                pure checked_int64_add1(sz)
            end
        }
    }
}

fn walk_search(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    subtree: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    case subtree of {
        :none -> :not_found;
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (node_key, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure walk_search_cmp(set, item, node_key, left, right)
            end
        }
    }
}

fn search_status(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> atom {
    case set.root of {
        :none -> :not_found;
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (node_key, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure walk_search_cmp(set, item, node_key, left, right)
            end
        }
    }
}

fn contains_invalid_halt(_: atom) -> boolean {
    sequence
        _: int64 <- 1 / 0
    produces
        pure false
    end
}

fn contains(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> boolean {
    case search_status(set, item) of {
        :found -> true;
        :not_found -> false;
        bad: atom -> contains_invalid_halt(bad)
    }
}

fn fold_after_left(
    step: fn(AccType, ItemType) -> AccType,
    left_acc: AccType,
    node_key: ItemType,
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    sequence
        mid: AccType <- step(left_acc, node_key)
    produces
        pure fold_subtree(step, mid, right)
    end
}

fn fold_node(
    step: fn(AccType, ItemType) -> AccType,
    acc: AccType,
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (node_key, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        left_acc: AccType <- fold_subtree(step, acc, left)
    produces
        pure fold_after_left(step, left_acc, node_key, right)
    end
}

fn fold_subtree(
    step: fn(AccType, ItemType) -> AccType,
    acc: AccType,
    subtree: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    case subtree of {
        :none -> acc;
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            fold_node(step, acc, node_ref)
    }
}

fn fold(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    init: AccType,
    visit_fn: fn(AccType, ItemType) -> AccType
) -> AccType {
    case set.root of {
        :none -> init;
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            fold_node(visit_fn, init, root_ref)
    }
}

fn minimum_subtree(
    subtree: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case subtree of {
        :none -> { status: :not_found, item: placeholder };
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (node_key, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure minimum_cmp(node_key, left, placeholder)
            end
        }
    }
}

fn minimum(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case set.root of {
        :none -> { status: :not_found, item: placeholder };
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (node_key, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure minimum_cmp(node_key, left, placeholder)
            end
        }
    }
}

fn maximum_subtree(
    subtree: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case subtree of {
        :none -> { status: :not_found, item: placeholder };
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (node_key, _: int64, _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure maximum_cmp(node_key, right, placeholder)
            end
        }
    }
}

fn maximum(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case set.root of {
        :none -> { status: :not_found, item: placeholder };
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (node_key, _: int64, _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure maximum_cmp(node_key, right, placeholder)
            end
        }
    }
}

// §8A.4 — overflow-safe a <= 3*b (DELTA). Mul overflow of non-negative b means 3*b exceeds int64, so a <= 3*b.
fn weight_le_3x(a: int64, b: int64) -> boolean {
    mul_pair: (boolean, int64) <- checked_int64_mul(b, 3);
    (ok: boolean, product: int64) <- mul_pair;
    case ok of {
        false -> true;
        true -> a <= product
    }
}

// §8A.4 — overflow-safe a < 2*b (GAMMA). Equality is intentionally excluded (selects double rotation).
fn weight_lt_2x(a: int64, b: int64) -> boolean {
    mul_pair: (boolean, int64) <- checked_int64_mul(b, 2);
    (ok: boolean, product: int64) <- mul_pair;
    case ok of {
        false -> true;
        true -> a < product
    }
}

fn weights_balanced(wl: int64, wr: int64) -> boolean {
    case weight_le_3x(wl, wr) of {
        false -> false;
        true -> weight_le_3x(wr, wl)
    }
}

fn balance_rep_violation_halt(_: int64) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :none
    end
}


fn rotate_single_left_build(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right_key: ItemType,
    rl: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    rr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        mid: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, item, left, rl),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, right_key, mid.root, rr),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        }
    produces
        pure out.root
    end
}

fn rotate_double_left_build(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right_key: ItemType,
    rl_key: ItemType,
    rll: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    rlr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    rr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        new_left: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, item, left, rll),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        new_right: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, right_key, rlr, rr),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, rl_key, new_left.root, new_right.root),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        }
    produces
        pure out.root
    end
}

fn rotate_single_right_build(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left_key: ItemType,
    ll: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    lr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        mid: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, item, lr, right),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, left_key, ll, mid.root),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        }
    produces
        pure out.root
    end
}

fn rotate_double_right_build(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left_key: ItemType,
    ll: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    lr_key: ItemType,
    lrl: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    lrr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        new_left: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, left_key, ll, lrl),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        new_right: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, item, lrr, right),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, lr_key, new_left.root, new_right.root),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        }
    produces
        pure out.root
    end
}

fn balance_left_decide_rotation(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right_key: ItemType,
    rl: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    rr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    w_rl: int64,
    w_rr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case weight_lt_2x(w_rl, w_rr) of {
        true -> rotate_single_left_build(set, item, left, right_key, rl, rr);
        false -> case rl of {
            :none -> balance_rep_violation_halt(0);
            rl_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                sequence proc[mem(normal)]
                    rl_node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(rl_ref);
                    (rl_key, _: int64, rll: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), rlr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- rl_node
                produces
                    pure rotate_double_left_build(set, item, left, right_key, rl_key, rll, rlr, rr)
                end
            }
        }
    }
}



fn node_weight_from_ref(
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> (boolean, int64) {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, sz: int64, _, _) <- node
    produces
        pure checked_int64_add1(sz)
    end
}

fn balance_left_after_right_read(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right_node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)),
    wl: int64,
    wr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        (right_key, _: int64, rl: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), rr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- right_node
    produces
        pure balance_left_with_inner_weights(set, item, left, right_key, rl, rr, wl, wr)
    end
}

fn balance_left_with_inner_weights(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right_key: ItemType,
    rl: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    rr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    wl: int64,
    wr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case rl of {
        :none -> case rr of {
            :none -> balance_left_decide_rotation(set, item, left, right_key, rl, rr, 1, 1);
            _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> balance_left_decide_rotation(set, item, left, right_key, rl, rr, 1, wr - 1)
        };
        _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> case rr of {
            :none -> balance_left_decide_rotation(set, item, left, right_key, rl, rr, wr - 1, 1);
            rr_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                w_rr_pair: (boolean, int64) <- node_weight_from_ref(rr_ref);
                (ok_rr: boolean, w_rr: int64) <- w_rr_pair;
                case ok_rr of {
                    false -> balance_rep_violation_halt(wr);
                    true -> balance_left_decide_rotation(set, item, left, right_key, rl, rr, wr - w_rr, w_rr)
                }
            }
        }
    }
}


fn balance_left_from_right_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    wl: int64,
    wr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        right_node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(right_ref)
    produces
        pure balance_left_after_right_read(set, item, left, right_node, wl, wr)
    end
}

fn balance_right_decide_rotation(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left_key: ItemType,
    ll: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    lr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    w_ll: int64,
    w_lr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case weight_lt_2x(w_lr, w_ll) of {
        true -> rotate_single_right_build(set, item, left_key, ll, lr, right);
        false -> case lr of {
            :none -> balance_rep_violation_halt(0);
            lr_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                sequence proc[mem(normal)]
                    lr_node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(lr_ref);
                    (lr_key, _: int64, lrl: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), lrr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- lr_node
                produces
                    pure rotate_double_right_build(set, item, left_key, ll, lr_key, lrl, lrr, right)
                end
            }
        }
    }
}



fn balance_right_after_left_read(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left_node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    wl: int64,
    wr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        (left_key, _: int64, ll: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), lr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- left_node
    produces
        pure balance_right_with_inner_weights(set, item, left_key, ll, lr, right, wl, wr)
    end
}

fn balance_right_with_inner_weights(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left_key: ItemType,
    ll: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    lr: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    wl: int64,
    wr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case ll of {
        :none -> case lr of {
            :none -> balance_right_decide_rotation(set, item, left_key, ll, lr, right, 1, 1);
            _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> balance_right_decide_rotation(set, item, left_key, ll, lr, right, 1, wl - 1)
        };
        _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> case lr of {
            :none -> balance_right_decide_rotation(set, item, left_key, ll, lr, right, wl - 1, 1);
            lr_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                w_lr_pair: (boolean, int64) <- node_weight_from_ref(lr_ref);
                (ok_lr: boolean, w_lr: int64) <- w_lr_pair;
                case ok_lr of {
                    false -> balance_rep_violation_halt(wl);
                    true -> balance_right_decide_rotation(set, item, left_key, ll, lr, right, wl - w_lr, w_lr)
                }
            }
        }
    }
}


fn balance_right_from_left_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    wl: int64,
    wr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        left_node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(left_ref)
    produces
        pure balance_right_after_left_read(set, item, left_node, right, wl, wr)
    end
}

fn balance_left_with_weights(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    wl: int64,
    wr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case weight_le_3x(wr, wl) of {
        true -> smart_node(set, item, left, right);
        false -> case right of {
            :none -> balance_rep_violation_halt(0);
            right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                balance_left_from_right_node(set, item, left, right_ref, wl, wr)
        }
    }
}

// balance_left: used when the right side may have become too heavy (DELTA = 3).
fn balance_left(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case right of {
        :none -> smart_node(set, item, left, right);
        right_present: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            w_r_pair: (boolean, int64) <- weight_subtree(right_present);
            (ok_r: boolean, wr: int64) <- w_r_pair;
            case ok_r of {
                false -> balance_rep_violation_halt(0);
                true -> case left of {
                    :none -> balance_left_with_weights(set, item, left, right, 1, wr);
                    left_present: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                        w_l_pair: (boolean, int64) <- weight_subtree(left_present);
                        (ok_l: boolean, wl: int64) <- w_l_pair;
                        case ok_l of {
                            false -> balance_rep_violation_halt(0);
                            true -> balance_left_with_weights(set, item, left, right, wl, wr)
                        }
                    }
                }
            }
        }
    }
}

fn balance_right_with_weights(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    wl: int64,
    wr: int64
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case weight_le_3x(wl, wr) of {
        true -> smart_node(set, item, left, right);
        false -> case left of {
            :none -> balance_rep_violation_halt(0);
            left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                balance_right_from_left_node(set, item, left_ref, right, wl, wr)
        }
    }
}

// balance_right: mirror of balance_left when the left side may have become too heavy.
fn balance_right(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case left of {
        :none -> smart_node(set, item, left, right);
        left_present: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            w_l_pair: (boolean, int64) <- weight_subtree(left_present);
            (ok_l: boolean, wl: int64) <- w_l_pair;
            case ok_l of {
                false -> balance_rep_violation_halt(0);
                true -> case right of {
                    :none -> balance_right_with_weights(set, item, left, right, wl, 1);
                    right_present: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                        w_r_pair: (boolean, int64) <- weight_subtree(right_present);
                        (ok_r: boolean, wr: int64) <- w_r_pair;
                        case ok_r of {
                            false -> balance_rep_violation_halt(0);
                            true -> balance_right_with_weights(set, item, left, right, wl, wr)
                        }
                    }
                }
            }
        }
    }
}

fn insert_pair_true(
    new_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
