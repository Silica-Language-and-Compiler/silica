fn set_with_root(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    new_root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: new_root,
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        }
    produces
        pure out
    end
}

fn delete_extreme_residual(
    residual: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            item: ItemType
        } <- {
            root: residual,
            item: item
        }
    produces
        pure out
    end
}

fn delete_min_rebuild(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_key: ItemType,
    residual_left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    extracted: ItemType
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence
        rebuilt: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: balance_left(set, node_key, residual_left, right),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            item: ItemType
        } <- {
            root: rebuilt.root,
            item: extracted
        }
    produces
        pure out
    end
}

fn delete_max_rebuild(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_key: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    residual_right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    extracted: ItemType
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence
        rebuilt: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: balance_right(set, node_key, left, residual_right),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            item: ItemType
        } <- {
            root: rebuilt.root,
            item: extracted
        }
    produces
        pure out
    end
}

fn delete_min_after_child(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_key: ItemType,
    child: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        item: ItemType
    },
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence
        extracted: ItemType <- child.item
    produces
        pure delete_min_rebuild(set, node_key, child.root, right, extracted)
    end
}

fn delete_max_after_child(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_key: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    child: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        item: ItemType
    }
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence
        extracted: ItemType <- child.item
    produces
        pure delete_max_rebuild(set, node_key, left, child.root, extracted)
    end
}

fn delete_min_descend(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_key: ItemType,
    left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence
        child: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            item: ItemType
        } <- delete_min_at_node(set, left_ref)
    produces
        pure delete_min_after_child(set, node_key, child, right)
    end
}

fn delete_max_descend(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_key: ItemType,
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence
        child: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            item: ItemType
        } <- delete_max_at_node(set, right_ref)
    produces
        pure delete_max_after_child(set, node_key, left, child)
    end
}

fn delete_min_at_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (node_key, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure case left of {
            :none -> delete_extreme_residual(right, node_key);
            left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                delete_min_descend(set, node_key, left_ref, right)
        }
    end
}

fn delete_max_at_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    item: ItemType
} {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (node_key, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure case right of {
            :none -> delete_extreme_residual(left, node_key);
            right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                delete_max_descend(set, node_key, left, right_ref)
        }
    end
}

fn delete_rebuild_left_shrunk(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
