        ext: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            item: ItemType
        } <- delete_min_at_node(set, right_ref)
    produces
        pure delete_pair_removed(delete_rebuild_splice_right(set, ext.item, left_ref, ext.root))
    end
}

fn delete_equal_two_children(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    sequence
        left_sz: int64 <- subtree_cached_size(left_ref);
        right_sz: int64 <- subtree_cached_size(right_ref)
    produces
        pure case left_sz > right_sz of {
            true -> delete_splice_from_left(set, left_ref, right_ref);
            false -> delete_splice_from_right(set, left_ref, right_ref)
        }
    end
}

// Nested `case` must not close over an outer pattern-bound ref: the emitter can
// rebind that name to the wrong register (seen as `delete_equal_two_children(set, set, right)`).
// Split so `left_ref` is a real parameter before casing on `right`.
fn delete_equal_left_empty(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    case right of {
        :none -> delete_pair_removed(set_with_root(set, :none));
        right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            delete_pair_removed(set_with_root(set, right_ref))
    }
}

fn delete_equal_left_present(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    case right of {
        :none -> delete_pair_removed(set_with_root(set, left_ref));
        right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            delete_equal_two_children(set, left_ref, right_ref)
    }
}

fn delete_equal_by_children(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    case left of {
        :none -> delete_equal_left_empty(set, right);
        left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            delete_equal_left_present(set, left_ref, right)
    }
}

fn delete_at_node_equal(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure delete_equal_by_children(set, left, right)
    end
}

fn delete_after_key(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    node_key: ItemType,
    cmp: atom
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    case cmp of {
        :equal -> delete_at_node_equal(set, node_ref);
        :less -> delete_at_node_less(set, item, node_ref, node_key);
        :greater -> delete_at_node_greater(set, item, node_ref, node_key);
        _: atom -> delete_invalid_halt(set, cmp)
    }
}

fn delete_node_key(
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ItemType {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (node_key, _: int64, _, _) <- node
    produces
        pure node_key
    end
}

fn delete_at_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    sequence
        node_key: ItemType <- delete_node_key(node_ref);
        cmp: atom <- compare_checked(item, node_key, set.compare_item)
    produces
        pure delete_after_key(set, item, node_ref, node_key, cmp)
    end
}

fn delete(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    case set.root of {
        :none -> delete_pair_unchanged(set);
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            delete_at_node(set, item, root_ref)
    }
}

fn delete_min_from_root(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    status: :not_found | :found,
    item: ItemType
} {
    sequence
        ext: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            item: ItemType
        } <- delete_min_at_node(set, root_ref);
        extracted: ItemType <- ext.item;
        new_set: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- set_with_root(set, ext.root)
    produces
        pure extreme_found(new_set, extracted)
    end
}

fn delete_max_from_root(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    status: :not_found | :found,
    item: ItemType
} {
    sequence
        ext: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            item: ItemType
        } <- delete_max_at_node(set, root_ref);
        extracted: ItemType <- ext.item;
        new_set: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- set_with_root(set, ext.root)
    produces
        pure extreme_found(new_set, extracted)
    end
}

fn delete_min(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    status: :not_found | :found,
    item: ItemType
} {
    case set.root of {
        :none -> extreme_empty(set, placeholder);
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            delete_min_from_root(set, root_ref)
    }
}

fn delete_max(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    status: :not_found | :found,
    item: ItemType
} {
    case set.root of {
        :none -> extreme_empty(set, placeholder);
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            delete_max_from_root(set, root_ref)
    }
}



// §8A.8 — deterministic linear from_sorted (median split, bottom-up smart_node sizes).
// Emitter/runtime constraints discovered while implementing:
// - Finish/smart_node must run under a live List cons-match arm (scalar extract + finish).
// - Nested preflight that threads `original` then publishes corrupts the list; atom-only
//   preflight that fully unwinds before publish is safe.
// - Passing List tails as arguments is OK; do not store them in result records/tuples.
// - Atom indices are module-local: decode via from_sorted_error_code for portable codes.
// Builder: Adams consume via a mutable list cursor; mid is matched in-place so right
// build + finish_node stay under that cons frame.

fn from_sorted_ok(
    new_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- {
            set: new_set,
            valid: true,
            error: :ok
        }
    produces
        pure out
    end
}

fn from_sorted_err(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    error: atom
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- {
            set: set_with_root(set, :none),
            valid: false,
            error: error
        }
    produces
        pure out
    end
}

fn from_sorted_build_ok(
    new_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    from_sorted_ok(new_set)
}

fn from_sorted_build_err(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    error: atom
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    from_sorted_err(set, error)
}

fn from_sorted_preflight_pair(
    compare_item: fn(ItemType, ItemType) -> atom,
    prev: ItemType,
    next: ItemType
) -> atom {
    sequence
        cmp: atom <- comparator_result_validate(compare_item(prev, next))
    produces
        pure case cmp of {
            :less -> :ok;
            :equal -> :equal_keys;
            :greater -> :not_ascending;
            _: atom -> :invalid_comparator_result
        }
    end
}

// Trial/status entry: set argument specializes ItemType so an atom comparator can be injected.
fn from_sorted_preflight_status(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    injected_compare: fn(ItemType, ItemType) -> atom,
    prev: ItemType,
    next: ItemType
) -> atom {
    sequence
        _: int64 <- set.specialization_key;
        out: atom <- from_sorted_preflight_pair(injected_compare, prev, next)
    produces
        pure out
    end
}

fn from_sorted_finish_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    right_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        left_hold: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
        } <- {
            root: left_set.root
        };
        right_hold: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
        } <- {
            root: right_set.root
        };
        built_set: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: smart_node(set, item, left_hold.root, right_hold.root),
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- case built_set.root of {
            :none -> from_sorted_build_err(set, :size_overflow);
            _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> from_sorted_build_ok(built_set)
        }
    produces
        pure out
    end
}

fn from_sorted_after_right(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    left_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    right_b: {
        set: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        },
        valid: boolean,
        error: atom
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case right_b.valid of {
        false -> right_b;
        true -> from_sorted_finish_node(set, item, left_set, right_b.set)
    }
}

fn from_sorted_build_one_item(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        empty_child: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- set_with_root(set, :none);
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_finish_node(set, item, empty_child, empty_child)
    produces
        pure out
    end
}

// §8A.8: runtime-sized item buffer + Adams build.
// Constraints (emitter/runtime):
// - Do not alloc_buf under a live List cons (hangs).
// - Do not smart_node before the input list is fully peeled under cons (hangs).
// - Fill under cons (write_buf + adjacent preflight only); build after cons unwinds.

fn from_sorted_fill(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)],
    remaining: int64,
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    cursor: {
        write_idx: int64,
        prev_ref: ref(L, normal, (ItemType, int64)),
        has_prev: boolean
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case remaining == 0 of {
        true -> case items of {
            []: List[ItemType, mem(normal)] -> from_sorted_ok(set);
            _: List[ItemType, mem(normal)] -> from_sorted_err(set, :count_mismatch)
        };
        false -> case items of {
            []: List[ItemType, mem(normal)] -> from_sorted_err(set, :count_mismatch);
            [h: ItemType, t: List[ItemType, mem(normal)]] ->
                from_sorted_fill_cons(set, h, t, remaining, n, items_buf, cursor)
        }
    }
}

fn from_sorted_fill_cons(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    h: ItemType,
    t: List[ItemType, mem(normal)],
    remaining: int64,
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    cursor: {
        write_idx: int64,
        prev_ref: ref(L, normal, (ItemType, int64)),
        has_prev: boolean
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        chk: atom <- from_sorted_peel_check(set, cursor.prev_ref, cursor.has_prev, h);
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- case chk of {
            :ok -> from_sorted_fill_cons_ok(set, h, t, remaining, n, items_buf, cursor);
            _: atom -> from_sorted_err(set, chk)
        }
    produces
        pure out
    end
}

fn from_sorted_peel_check(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    prev_ref: ref(L, normal, (ItemType, int64)),
    has_prev: boolean,
    h: ItemType
) -> atom {
    case has_prev of {
        false -> :ok;
        true -> from_sorted_peel_check_prev(set, prev_ref, h)
    }
}

fn from_sorted_peel_check_prev(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    prev_ref: ref(L, normal, (ItemType, int64)),
    h: ItemType
) -> atom {
    sequence proc[mem(normal)]
        wrapped: (ItemType, int64) <- read_ref(prev_ref);
        (prev, _flag: int64) <- wrapped;
        out: atom <- from_sorted_preflight_pair(set.compare_item, prev, h)
    produces
        pure out
    end
}

fn from_sorted_fill_cons_ok(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    h: ItemType,
    t: List[ItemType, mem(normal)],
    remaining: int64,
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    cursor: {
        write_idx: int64,
        prev_ref: ref(L, normal, (ItemType, int64)),
        has_prev: boolean
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        _: atom <- write_buf(items_buf, cursor.write_idx, h);
        _: atom <- write_ref(cursor.prev_ref, (h, 1));
        next_cursor: {
            write_idx: int64,
            prev_ref: ref(L, normal, (ItemType, int64)),
            has_prev: boolean
        } <- {
            write_idx: cursor.write_idx + 1,
            prev_ref: cursor.prev_ref,
            has_prev: true
        };
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_fill(set, t, remaining - 1, n, items_buf, next_cursor)
    produces
        pure out
    end
}

fn from_sorted_buf_build(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    start: int64,
    count: int64
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case count == 0 of {
        true -> from_sorted_ok(set_with_root(set, :none));
        false -> case count == 1 of {
            true -> from_sorted_buf_one(set, n, items_buf, start);
            false -> from_sorted_buf_split(set, n, items_buf, start, count)
        }
    }
}

fn from_sorted_buf_one(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    start: int64
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        item: ItemType <- read_buf(items_buf, start);
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_build_one_item(set, item)
    produces
        pure out
    end
}

fn from_sorted_buf_split(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    start: int64,
    count: int64
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        left_count: int64 <- count / 2;
        right_count: int64 <- count - left_count - 1;
        left_b: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_buf_build(set, n, items_buf, start, left_count);
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_buf_after_left(set, n, items_buf, start, left_count, right_count, left_b)
    produces
        pure out
    end
}

fn from_sorted_buf_after_left(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    start: int64,
    left_count: int64,
    right_count: int64,
    left_b: {
        set: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        },
        valid: boolean,
        error: atom
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case left_b.valid of {
        false -> left_b;
        true -> from_sorted_buf_mid(set, n, items_buf, start, left_count, right_count, left_b.set)
    }
}

fn from_sorted_buf_mid(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    start: int64,
    left_count: int64,
    right_count: int64,
    left_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        mid: ItemType <- read_buf(items_buf, start + left_count);
        right_b: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_buf_build(set, n, items_buf, start + left_count + 1, right_count);
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_after_right(set, mid, left_set, right_b)
    produces
        pure out
    end
}

fn from_sorted_after_fill(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, ItemType, n),
    filled: {
        set: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        },
        valid: boolean,
        error: atom
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case filled.valid of {
        false -> filled;
        true -> from_sorted_buf_build(set, n, items_buf, 0, n)
    }
}

fn from_sorted_publish(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)],
    n: int64
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case n == 0 of {
        true -> case items of {
            []: List[ItemType, mem(normal)] -> from_sorted_ok(set_with_root(set, :none));
            _: List[ItemType, mem(normal)] -> from_sorted_err(set, :count_mismatch)
        };
        false -> from_sorted_publish_alloc(set, items, n)
    }
}

fn from_sorted_publish_alloc(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)],
    n: int64
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        items_buf: buf(L, normal, ItemType, n) <- alloc_buf(set.region, n);
        filled: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_publish_fill(set, items, n, items_buf);
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_after_fill(set, n, items_buf, filled)
    produces
        pure out
    end
}

fn from_sorted_publish_fill(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)],
    n: int64,
    items_buf: buf(L, normal, ItemType, n)
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case items of {
        []: List[ItemType, mem(normal)] -> from_sorted_err(set, :count_mismatch);
        [h: ItemType, t: List[ItemType, mem(normal)]] ->
            from_sorted_publish_fill_start(set, h, t, n, items_buf)
    }
}

fn from_sorted_publish_fill_start(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    h: ItemType,
    t: List[ItemType, mem(normal)],
    n: int64,
    items_buf: buf(L, normal, ItemType, n)
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        prev_ref: ref(L, normal, (ItemType, int64)) <- alloc_ref(set.region, (h, 1));
        _: atom <- write_buf(items_buf, 0, h);
        cursor: {
            write_idx: int64,
            prev_ref: ref(L, normal, (ItemType, int64)),
            has_prev: boolean
        } <- {
            write_idx: 1,
            prev_ref: prev_ref,
            has_prev: true
        };
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_fill(set, t, n - 1, n, items_buf, cursor)
    produces
        pure out
    end
}




fn from_sorted_counted_matching(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)],
    n: int64
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    from_sorted_publish(set, items, n)
}

fn from_sorted_counted(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)],
    n: int64
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case n < 0 of {
        true -> from_sorted_err(set, :negative_count);
        false -> from_sorted_counted_matching(set, items, n)
    }
}

fn from_sorted_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :not_ascending -> 1;
        :equal_keys -> 2;
        :invalid_comparator_result -> 3;
        :negative_count -> 4;
        :count_mismatch -> 5;
        :size_overflow -> 6;
        _: atom -> 99
    }
}

fn from_sorted(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)]
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        n: int64 <- length[ItemType, mem(normal)](items);
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_counted_matching(set, items, n)
    produces
        pure out
    end
}

// §8A.10 — postorder structural validation.
// Diagnostic precedence (stable for goldens):
//   on entry: :cycle, :wrong_arena, :repeated_child
//   after children (node-local): :invalid_comparator_result, :negative_count,
//     :size_mismatch, :order_violation, :balance_violation
// Child errors surface before parent node-local errors.

fn validate_result_ok(count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    sequence
        out: { valid: boolean, error: atom, logical_count: int64 } <- { valid: true, error: :ok, logical_count: count }
    produces
        pure out
    end
}

fn validate_result_err(error: atom, count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    sequence
        out: { valid: boolean, error: atom, logical_count: int64 } <- { valid: false, error: error, logical_count: count }
    produces
        pure out
    end
}

fn validate_subtree_ok_empty(placeholder: ItemType) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
} {
    sequence
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: ItemType,
            hi: ItemType
        } <- { error: :ok, count: 0, has_items: false, lo: placeholder, hi: placeholder }
    produces
        pure out
    end
}

fn validate_subtree_err(error: atom, count: int64, placeholder: ItemType) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
} {
    sequence
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: ItemType,
            hi: ItemType
        } <- { error: error, count: count, has_items: false, lo: placeholder, hi: placeholder }
    produces
        pure out
    end
}

fn validate_subtree_ok_node(count: int64, lo: ItemType, hi: ItemType) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
} {
    sequence
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: ItemType,
            hi: ItemType
        } <- { error: :ok, count: count, has_items: true, lo: lo, hi: hi }
    produces
        pure out
    end
}

fn validate_fuel_start(cached: int64) -> int64 {
    case cached < 0 of {
        true -> 64;
        false -> case cached > 1000000 of {
            true -> 1000002;
            false -> cached + 2
        }
    }
}

fn validate_order_left(
    compare_item: fn(ItemType, ItemType) -> atom,
    left_hi: ItemType,
    key: ItemType
) -> atom {
    sequence
        cmp: atom <- comparator_result_validate(compare_item(left_hi, key))
    produces
        pure case cmp of {
            :less -> :ok;
            :equal -> :order_violation;
            :greater -> :order_violation;
            _: atom -> :invalid_comparator_result
        }
    end
}

fn validate_order_right(
    compare_item: fn(ItemType, ItemType) -> atom,
    key: ItemType,
    right_lo: ItemType
) -> atom {
    sequence
        cmp: atom <- comparator_result_validate(compare_item(key, right_lo))
    produces
        pure case cmp of {
            :less -> :ok;
            :equal -> :order_violation;
            :greater -> :order_violation;
            _: atom -> :invalid_comparator_result
        }
    end
}

fn validate_bounds_left(
    compare_item: fn(ItemType, ItemType) -> atom,
    left: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: ItemType,
        hi: ItemType
    },
    key: ItemType
) -> atom {
    case left.has_items of {
        false -> :ok;
        true -> validate_order_left(compare_item, left.hi, key)
    }
}

fn validate_bounds_right(
    compare_item: fn(ItemType, ItemType) -> atom,
    key: ItemType,
    right: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: ItemType,
        hi: ItemType
    }
) -> atom {
    case right.has_items of {
        false -> :ok;
        true -> validate_order_right(compare_item, key, right.lo)
    }
}

fn validate_combine_lo(key: ItemType, left: {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
}) -> ItemType {
    case left.has_items of {
        true -> left.lo;
        false -> key
    }
}

fn validate_combine_hi(key: ItemType, right: {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
}) -> ItemType {
    case right.has_items of {
        true -> right.hi;
        false -> key
    }
}

fn validate_node_local(
    compare_item: fn(ItemType, ItemType) -> atom,
    key: ItemType,
    cached: int64,
    left: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: ItemType,
        hi: ItemType
    },
    right: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: ItemType,
        hi: ItemType
    }
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
} {
    sequence
        left_bound: atom <- validate_bounds_left(compare_item, left, key);
        right_bound: atom <- case left_bound of {
            :ok -> validate_bounds_right(compare_item, key, right);
            bad: atom -> bad
        };
        // Avoid checked_int64_add pair temps here: their stack slabs unbalanced SP and
        // made RET load LR from a key immediate (crash to address 0xa).
        counts_ok: boolean <- case left.count < 0 of {
            true -> false;
            false -> case right.count < 0 of { true -> false; false -> true }
        };
        computed: int64 <- left.count + right.count + 1;
        wl: int64 <- left.count + 1;
        wr: int64 <- right.count + 1;
        bal_ok: boolean <- case counts_ok of {
            true -> weights_balanced(wl, wr);
            false -> false
        };
        combined_lo: ItemType <- validate_combine_lo(key, left);
        combined_hi: ItemType <- validate_combine_hi(key, right);
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: ItemType,
            hi: ItemType
        } <- case right_bound of {
            :invalid_comparator_result -> validate_subtree_err(:invalid_comparator_result, computed, key);
            :order_violation -> case cached <= 0 of {
                true -> validate_subtree_err(:negative_count, computed, key);
                false -> case counts_ok of {
                    false -> validate_subtree_err(:size_mismatch, computed, key);
                    true -> case computed == cached of {
                        false -> validate_subtree_err(:size_mismatch, computed, key);
                        true -> validate_subtree_err(:order_violation, computed, key)
                    }
                }
            };
            :ok -> case cached <= 0 of {
                true -> validate_subtree_err(:negative_count, computed, key);
                false -> case counts_ok of {
                    false -> validate_subtree_err(:size_mismatch, computed, key);
                    true -> case computed == cached of {
                        false -> validate_subtree_err(:size_mismatch, computed, key);
                        true -> case bal_ok of {
                            false -> validate_subtree_err(:balance_violation, computed, key);
                            true -> validate_subtree_ok_node(computed, combined_lo, combined_hi)
                        }
                    }
                }
            };
            bad: atom -> validate_subtree_err(bad, computed, key)
        }
    produces
        pure out
    end
}

// Single left-then-right walk (no left_only/right_only/both split): the emitter
// clobbers the unmatched child when marshalling calls after a `case` on ref?.
fn validate_finish(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> atom,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    left_res: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: ItemType,
        hi: ItemType
    },
    right_res: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: ItemType,
        hi: ItemType
    }
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
} {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (key, cached: int64, _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: ItemType,
            hi: ItemType
        } <- case left_res.error of {
            :ok -> case right_res.error of {
                :ok -> validate_node_local(set.compare_item, key, cached, left_res, right_res);
                bad: atom -> right_res
            };
            bad: atom -> left_res
        }
    produces
        pure out
    end
}

fn validate_after_children(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> atom,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    fuel: int64,
    left_res: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: ItemType,
        hi: ItemType
    }
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
} {
    case left_res.error of {
        :ok -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (key, _: int64, _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
                right_res: {
                    error: atom,
                    count: int64,
                    has_items: boolean,
                    lo: ItemType,
                    hi: ItemType
                } <- validate_subtree(set, right, key, fuel)
            produces
                pure validate_finish(set, node_ref, left_res, right_res)
            end
        };
        bad: atom -> left_res
    }
}

fn edge_cycle(
    a: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    b: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence
        cyc: boolean <- ref_eq(a, b);
        out: atom <- case cyc of { true -> :cycle; false -> :ok }
    produces
        pure out
    end
}

fn edge_repeated(
    a: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    b: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence
        same: boolean <- ref_eq(a, b);
        out: atom <- case same of { true -> :repeated_child; false -> :ok }
    produces
        pure out
    end
}

fn edges_when_left(
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    case right of {
        :none -> edge_cycle(node_ref, left_ref);
        right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence
                rep: atom <- edge_repeated(left_ref, right_ref);
                out: atom <- case rep of {
                    :repeated_child -> :repeated_child;
                    :ok -> {
                        sequence
                            e1: atom <- edge_cycle(node_ref, left_ref);
                            e2: atom <- case e1 of {
                                :ok -> edge_cycle(node_ref, right_ref);
                                bad: atom -> bad
                            }
                        produces
                            pure e2
                        end
                    };
                    bad: atom -> bad
                }
            produces
                pure out
            end
        }
    }
}

fn validate_child_edges_of(
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        out: atom <- case left of {
            :none -> case right of {
                :none -> :ok;
                right_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                    edge_cycle(node_ref, right_ref)
            };
            left_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                edges_when_left(node_ref, left_ref, right)
        }
    produces
        pure out
    end
}

fn validate_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> atom,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ItemType,
    fuel: int64
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
} {
    sequence
        in_arena: boolean <- true;
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: ItemType,
            hi: ItemType
        } <- case fuel <= 0 of {
            true -> validate_subtree_err(:cycle, 0, placeholder);
            false -> case in_arena of {
                false -> validate_subtree_err(:wrong_arena, 0, placeholder);
                true -> {
                    sequence proc[mem(normal)]
                        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                        (key, _: int64, left: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
                        next_fuel: int64 <- fuel - 1;
                        edges: atom <- validate_child_edges_of(node_ref);
                        walked: {
                            error: atom,
                            count: int64,
                            has_items: boolean,
                            lo: ItemType,
                            hi: ItemType
                        } <- case edges of {
                            :ok -> {
                                sequence
                                    left_res: {
                                        error: atom,
                                        count: int64,
                                        has_items: boolean,
                                        lo: ItemType,
                                        hi: ItemType
                                    } <- validate_subtree(set, left, key, next_fuel)
                                produces
                                    pure validate_after_children(set, node_ref, right, next_fuel, left_res)
                                end
                            };
                            bad: atom -> validate_subtree_err(bad, 0, key)
                        }
                    produces
                        pure walked
                    end
                }
            }
        }
    produces
        pure out
    end
}

fn validate_subtree(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> atom,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    subtree: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ItemType,
    fuel: int64
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: ItemType,
    hi: ItemType
} {
    case subtree of {
        :none -> validate_subtree_ok_empty(placeholder);
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            validate_node(set, node_ref, placeholder, fuel)
    }
}

fn validate_at_root(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> atom,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> { valid: boolean, error: atom, logical_count: int64 } {
    sequence proc[mem(normal)]
        node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
        (key, cached: int64, _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        fuel: int64 <- validate_fuel_start(cached);
        walk: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: ItemType,
            hi: ItemType
        } <- validate_node(set, root_ref, key, fuel);
        out: { valid: boolean, error: atom, logical_count: int64 } <- case walk.error of {
            :ok -> validate_result_ok(walk.count);
            bad: atom -> validate_result_err(bad, walk.count)
        }
    produces
        pure out
    end
}

fn validate(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    sequence
        probe: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> atom,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: set.root,
            compare_item: set.compare_item,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: { valid: boolean, error: atom, logical_count: int64 } <- validate_core(probe)
    produces
        pure out
    end
}

fn validate_with_compare(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    injected_compare: fn(ItemType, ItemType) -> atom
) -> { valid: boolean, error: atom, logical_count: int64 } {
    sequence
        _: int64 <- set.specialization_key;
        probe: {
            root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> atom,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: set.root,
            compare_item: injected_compare,
            region: set.region,
            specialization_key: set.specialization_key,
            compare_item_ordering_bundle: set.compare_item_ordering_bundle
        };
        out: { valid: boolean, error: atom, logical_count: int64 } <- validate_core(probe)
    produces
        pure out
    end
}

fn validate_core(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> atom,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    case set.root of {
        :none -> validate_result_ok(0);
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            validate_at_root(set, root_ref)
    }
}

fn validate_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :cycle -> 1;
        :wrong_arena -> 2;
        :repeated_child -> 3;
        :invalid_comparator_result -> 4;
        :negative_count -> 5;
        :size_mismatch -> 6;
        :order_violation -> 7;
        :balance_violation -> 8;
        _: atom -> 99
    }
}
