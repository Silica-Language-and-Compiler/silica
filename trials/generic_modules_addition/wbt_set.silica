    },
    inserted: boolean
} {
    case cmp of {
        :equal -> insert_pair_false(set);
        :less -> insert_at_node_less(set, item, node_ref, node_key);
        :greater -> insert_at_node_greater(set, item, node_ref, node_key);
        _: atom -> insert_invalid_halt(set, cmp)
    }
}

fn insert_at_node(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    inserted: boolean
} {
    sequence
        node_key: ItemType <- insert_node_key(node_ref);
        cmp: atom <- compare_checked(item, node_key, set.compare_item)
    produces
        // Keep the owning set root unchanged across descent. Rebinding set.root to
        // node_ref corrupts caller-held versions under Silica's record lowering.
        pure insert_after_key(set, item, node_ref, node_key, cmp)
    end
}

// §8A.5: persistent set insertion. Duplicate comparator class is a zero-node identity no-op.
// Never keep a live empty ref? in any frame that allocates (smart_node / balance).
fn insert(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    inserted: boolean
} {
    case set.root of {
        :none -> insert_singleton(set, item);
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            insert_at_node(set, item, root_ref)
    }
}

// §8A.7 — deletion, extreme extraction, deletion-side rebalancing.

fn delete_pair_removed(
    new_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    sequence
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- {
            set: new_set,
            removed: true
        }
    produces
        pure out
    end
}

fn delete_pair_unchanged(
    old_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    sequence
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- {
            set: old_set,
            removed: false
        }
    produces
        pure out
    end
}

fn delete_invalid_halt(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    _: atom
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: boolean
} {
    sequence
        _: int64 <- 1 / 0;
        out: {
            set: {
                root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            removed: boolean
        } <- {
            set: set,
            removed: false
        }
    produces
        pure out
    end
}

fn extreme_empty(
    old_set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> {
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    status: :not_found | :found,
    item: ItemType
} {
