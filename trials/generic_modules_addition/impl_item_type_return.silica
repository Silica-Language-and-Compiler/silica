// A trait impl whose ItemType-valued result comes from another generic call (found by the Tree trait
// work, stdlib Tree.silica root_item). A trait call re-checks the impl body with concrete parameter
// types; the body is now also checked against the impl's return resolved from the first concrete
// parameter, so a qualified call into the generic core (bare ItemType, record-wrapped, tuple-wrapped)
// and a local helper taking the collection all return the concrete item. The caller destructures a
// generic (ItemType, int64) result directly, which resolves the call's result against argument one.
// Formerly the open defect compile_defects_impl_item_type_addition (E2003 "stub_tree_core@root_item
// returns int64, expected ItemType"; E2005 for the direct tuple destructure).
// StubTree.silica (the trait) and stub_tree_core.silica (the generic core) are its helper units.
// Expected: 7, 7, 8, 8, 7, exit 0.

use StubTree;
use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                t: { root: int64, compare_item: fn(int64, int64) -> :less | :equal | :greater } <- { root: 7, compare_item: cmp_i64 };
                a: int64 <- StubTree@root_item(t);
                e: { status: :not_found | :found, value: int64 } <- StubTree@root_entry(t);
                pr: (int64, int64) <- StubTree@root_pair(t);
                (p1: int64, n1: int64) <- pr;
                (p2: int64, n2: int64) <- StubTree@root_pair(t);
                h: int64 <- StubTree@root_via_helper(t);
                _: atom <- print_int64(a);
                _: atom <- println("");
                _: atom <- print_int64(e.value);
                _: atom <- println("");
                _: atom <- print_int64(p1 + n1);
                _: atom <- println("");
                _: atom <- print_int64(p2 + n2);
                _: atom <- println("");
                _: atom <- print_int64(h);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
