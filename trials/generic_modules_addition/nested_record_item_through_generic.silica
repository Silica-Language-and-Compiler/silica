// A record item that itself holds a nested record, round-tripped through two generic writers
// (gbox@wrap, gpass@wrap_tagged). With the boxed record layout the item is one pointer word in
// the generic result, its `inner` field is one pointer word in the item, and every field after
// `inner` sits one word later -- the same whichever unit built the value. The last line
// destructures the item with a nested record pattern.
// Expected output: 1, 2, 3, 4, 3, 9, 4321, then exit 0.

use gbox;
use gpass;
use trial_support_int64;

fn cmp_n(p: { a: int64, inner: { x: int64, y: int64 }, z: int64 }, q: { a: int64, inner: { x: int64, y: int64 }, z: int64 }) -> :less | :equal | :greater {
    case p.a < q.a of {
        true -> :less;
        false -> case p.a == q.a of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn digits(v: { a: int64, inner: { x: int64, y: int64 }, z: int64 }) -> int64 {
    case v of {
        { a: pa, inner: { x: px, y: py }, z: pz } -> pa + px * 10 + py * 100 + pz * 1000
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                item: { a: int64, inner: { x: int64, y: int64 }, z: int64 } <- { a: 1, inner: { x: 2, y: 3 }, z: 4 };
                r: { status: :not_found | :found, value: { a: int64, inner: { x: int64, y: int64 }, z: int64 } } <- gbox@wrap({ compare_item: cmp_n }, item);
                v: { a: int64, inner: { x: int64, y: int64 }, z: int64 } <- r.value;
                va: int64 <- v.a;
                vx: int64 <- v.inner.x;
                vy: int64 <- v.inner.y;
                vz: int64 <- v.z;
                rt: { status: :not_found | :found, value: { a: int64, inner: { x: int64, y: int64 }, z: int64 }, tag: int64 } <- gpass@wrap_tagged({ compare_item: cmp_n }, item, 9);
                w: { a: int64, inner: { x: int64, y: int64 }, z: int64 } <- rt.value;
                wy: int64 <- w.inner.y;
                wt: int64 <- rt.tag;
                d: int64 <- digits(v);
                print_int64(va);
                println("");
                print_int64(vx);
                println("");
                print_int64(vy);
                println("");
                print_int64(vz);
                println("");
                print_int64(wy);
                println("");
                print_int64(wt);
                println("");
                print_int64(d);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
