// Not in silica.config: float16 AArch64 assembly not yet valid for this pipeline.
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] x: float16 <- 4.25;
                result: atom <- print_boolean(negate_float16(x) == -4.25)
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
