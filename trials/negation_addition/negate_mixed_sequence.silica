// Literal negation, variable negation, and triple negation across signed integer and float prints.
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_int8(negate_int8(11));
                _: atom <- print_int16(negate_int16(-22));
                v32: int32 <- 7;
                _: atom <- print_int32(negate_int32(v32));
                _: atom <- print_int64(negate_int64(negate_int64(negate_int64(5))));
                _: atom <- print_float32(negate_float32(negate_float32(negate_float32(2.0))));
                result: atom <- print_float64(negate_float64(-9.5))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
