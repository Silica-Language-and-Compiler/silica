    cmp r11, r10
    bhs.w 1f
    movw r10, #16
    str r10, [r9, #136]
    bl silica_rt_aux_grow
    ldr r11, [r9, #112]
1:
    ldr r11, [r9, #112]
    str r8, [r11, #0]
    str r12, [r11, #4]
    movw r6, #65449
    movt r6, #65535
    movw r7, #65535
    movt r7, #65535

    rsbs r10, r6, #0
    sbc r11, r7, r7, lsl #1
    mov r6, r10
    mov r7, r11

    rsbs r10, r6, #0
    sbc r11, r7, r7, lsl #1
    mov r6, r10
    mov r7, r11

    ldr r11, [r9, #112]
    ldr r8, [r11, #0]
    ldr r12, [r11, #4]
    ldr r11, [r9, #112]
    addw r11, r11, #16
    str r11, [r9, #112]
    ldr r10, [r9, #124]
    cmp r11, r10
    blo.w 1f
    bl silica_rt_aux_release
1:
    XS32 r8, SVR_X10, r11
    XS32 r12, SVR_X10+4, r11


    XL32 r8, SVR_X10
    XL32 r12, SVR_X10+4
    eor r10, r6, r8
    eor r11, r7, r12
    orrs r10, r10, r11
    ite eq
    moveq r10, #1
    movne r10, #0
    movw r11, #0
    mov r0, r10
    mov r1, r11

    # effects [device_io]
    bl silica_rt_print_bool
    movw r0, #2
    movw r1, #0

    XS32 r0, SVR_X19, r11
    XS32 r1, SVR_X19+4, r11
    XL32 r10, SVR_X19
    XL32 r11, SVR_X19+4
    mov r0, r10
    mov r1, r11


    XL32 r11, SFP+4
    str r11, [r9, #140]
    FRAME_LEAVE SFRAME
