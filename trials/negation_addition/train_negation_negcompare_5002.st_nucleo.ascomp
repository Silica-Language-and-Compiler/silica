    .syntax unified
    .cpu cortex-m4
    .fpu fpv4-sp-d16
    .thumb
.macro MOVI32 r, v
.if ((\v) >= 0) && ((\v) <= 65535)
movw \r, #(\v)
.else
movw \r, #((\v) & 0xffff)
movt \r, #(((\v) >> 16) & 0xffff)
.endif
.endm
.macro XADDR r, off
.if ((\off) >= 0) && ((\off) <= 4095)
add \r, sp, #(\off)
.else
MOVI32 \r, \off
add \r, \r, sp
.endif
.endm
.macro XL32 r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldr \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldr \r, [sp, \r]
.endif
.endm
.macro XS32 r, off, t
.if ((\off) >= 0) && ((\off) <= 4095)
str \r, [sp, #(\off)]
.else
MOVI32 \t, \off
str \r, [sp, \t]
.endif
.endm
.macro XL16U r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrh \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrh \r, [sp, \r]
.endif
.endm
.macro XL16S r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrsh \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrsh \r, [sp, \r]
.endif
.endm
.macro XS16 r, off, t
.if ((\off) >= 0) && ((\off) <= 4095)
strh \r, [sp, #(\off)]
.else
MOVI32 \t, \off
strh \r, [sp, \t]
.endif
.endm
.macro XL8U r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrb \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrb \r, [sp, \r]
.endif
.endm
.macro XS8 r, off, t
.if ((\off) >= 0) && ((\off) <= 4095)
strb \r, [sp, #(\off)]
.else
MOVI32 \t, \off
strb \r, [sp, \t]
.endif
.endm
.macro XL8S r, off
.if ((\off) >= 0) && ((\off) <= 4095)
ldrsb \r, [sp, #(\off)]
.else
MOVI32 \r, \off
ldrsb \r, [sp, \r]
.endif
.endm
.macro FRAME_ENTER n
.if (\n) <= 4095
subw r10, sp, #(\n)
.else
MOVI32 r10, \n
sub r10, sp, r10
.endif
ldr r11, [r9, #116]
cmp r10, r11
bhs.w 1f
mov r11, lr
MOVI32 r10, \n
bl silica_rt_stack_grow
mov lr, r11
b.w 2f
1:
mov sp, r10
2:
.if ((\n) - 4) <= 4095
str lr, [sp, #((\n) - 4)]
.else
MOVI32 r10, (\n) - 4
str lr, [sp, r10]
.endif
.endm
.macro FRAME_LEAVE n
.if ((\n) - 4) <= 4095
ldr lr, [sp, #((\n) - 4)]
.else
MOVI32 r10, (\n) - 4
ldr lr, [sp, r10]
.endif
.if (\n) <= 4095
addw sp, sp, #(\n)
.else
MOVI32 r10, \n
add sp, sp, r10
.endif
bx lr
.endm
    .text
    # use trial_support_atom
.global main


.set SFRAME, 48
.set SFP, 16
.set SVR_X16, 0
    .section .text.main,"ax",%progbits
    .align 2
    .thumb_func
    .type main, %function
main:
    FRAME_ENTER SFRAME
    ldr r10, [r9, #140]
    XS32 r10, SFP+4, r8
    ldr r11, [r9, #112]
    XS32 r11, SFP, r8
    str r11, [r9, #140]

    bl silica_pid_registry_init
    bl silica_dangerous_pid_registry_init
    bl silica_device_pid_registry_init
    # push dummy argument slot
    XL32 r8, SVR_X16
    XL32 r12, SVR_X16+4
    ldr r11, [r9, #112]
    subw r11, r11, #16
    str r11, [r9, #112]
    ldr r10, [r9, #120]
    cmp r11, r10
    bhs.w 1f
    movw r10, #16
    str r10, [r9, #136]
    bl silica_rt_aux_grow
    ldr r11, [r9, #112]
1:
    ldr r11, [r9, #112]
    str r8, [r11, #0]
    str r12, [r11, #4]
    ldr r11, [r9, #112]
    ldr r8, [r11, #0]
    ldr r12, [r11, #4]
    mov r0, r8
    mov r1, r12
    ldr r11, [r9, #112]
    addw r11, r11, #16
    str r11, [r9, #112]
    ldr r10, [r9, #124]
    cmp r11, r10
    blo.w 1f
    bl silica_rt_aux_release
1:
    # effects []|sir_rec:o153|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    movw r10, #0
    movw r11, #0
    str r10, [r9, #40]
    str r11, [r9, #44]
    ldr r11, [r9, #140]
    ldr r10, [r9, #112]
    cmp r10, r11
    bne.w 3f
    XL32 r11, SFP
    str r11, [r9, #140]
    str r11, [r9, #112]
    ldr r10, [r9, #120]
    cmp r11, r10
    blo.w 2f
    ldr r10, [r9, #124]
    cmp r11, r10
    blo.w 1f
2:
    bl silica_rt_aux_release
1:
3:
    ldr r11, [r9, #112]
    XS32 r11, SFP+8, r10
    bl trial_support_atom_start
    XL32 r11, SFP+8
    str r11, [r9, #136]
    bl silica_rt_adopt

    movw r10, #:lower16:train_negation_negcompare_5002.__lam0
    movt r10, #:upper16:train_negation_negcompare_5002.__lam0
    movw r11, #0
    XS32 r10, SVR_X16, r12
    XS32 r11, SVR_X16+4, r12

    XL32 r8, SVR_X16
    XL32 r12, SVR_X16+4
    ldr r11, [r9, #112]
    subw r11, r11, #16
    str r11, [r9, #112]
    ldr r10, [r9, #120]
    cmp r11, r10
    bhs.w 1f
    movw r10, #16
    str r10, [r9, #136]
    bl silica_rt_aux_grow
    ldr r11, [r9, #112]
1:
    ldr r11, [r9, #112]
    str r8, [r11, #0]
    str r12, [r11, #4]
    ldr r11, [r9, #112]
    ldr r8, [r11, #0]
    ldr r12, [r11, #4]
    mov r0, r8
    mov r1, r12
    ldr r11, [r9, #112]
    addw r11, r11, #16
    str r11, [r9, #112]
    ldr r10, [r9, #124]
    cmp r11, r10
    blo.w 1f
    bl silica_rt_aux_release
1:
    # effects []|sir_rec:o203|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    movw r10, #0
    movw r11, #0
    str r10, [r9, #40]
    str r11, [r9, #44]
    ldr r11, [r9, #112]
    XS32 r11, SFP+8, r10
    bl trial_support_atom_run
    XL32 r11, SFP+8
    str r11, [r9, #112]
    ldr r10, [r9, #120]
    cmp r11, r10
    blo.w 2f
    ldr r10, [r9, #124]
    cmp r11, r10
    blo.w 1f
2:
    bl silica_rt_aux_release
1:

    bl silica_rt_wait_for_exit

    movw r0, #2
    movw r1, #0




    XL32 r11, SFP+4
    str r11, [r9, #140]
    XL32 r11, SFP
    str r11, [r9, #112]
    ldr r10, [r9, #120]
    cmp r11, r10
    blo.w 2f
    ldr r10, [r9, #124]
    cmp r11, r10
    blo.w 1f
2:
    bl silica_rt_aux_release
1:
    FRAME_LEAVE SFRAME
    .section .rodata.silica_fnames, "ao", %progbits, main
    .p2align 2
    .word main
    .word L_fname_main
L_fname_main:
    .asciz "main"
    .text


