    movw r11, #65535
    movt r11, #65535
    XS32 r10, SVR_X10, r12
    XS32 r11, SVR_X10+4, r12

    XL32 r8, SVR_X10
    XL32 r12, SVR_X10+4
    ldr r11, [r9, #112]
