// An actor_ref argument before a tuple-literal argument holding a call, the shape that broke
// console_stdin_carrier's on_open: `cast_owner(o, (:link_up, concat("stdin:", info)))` kept o in X0,
// string_concat overwrote X0, and cast_owner cast to the string's address (cast answered false).
// greet is a tail call whose parameter o is still in X0 at the call; greet_direct passes the same
// message to the cast builtin itself, whose emission parks the actor_ref across any computed
// message (term_emit_kind_compound_part3) and was already right. The sink checks both messages and
// ends the program: status 0 when both arrived intact, 3 otherwise; main ends it with 99 when a cast
// answered false, so a lost message cannot hang the run in wait_for_exit.
// Expected (by hand): the two lines below, then exit status 0.
//   greet: true
//   greet_direct: true

fn sink(m: (atom, string), state: int64) -> (:no_reply, int64) {
    (tag: atom, s: string) <- m;
    ok: boolean <- tag == :line and (s == "hello" or s == "world");
    next: int64 <- case ok of {
        true -> state + 1;
        false -> state + 10
    };
    done: boolean <- next % 10 + next / 10 == 2;
    code: int64 <- case next == 2 of {
        true -> 0;
        false -> 3
    };
    sequence proc[concurrency]
        _: boolean <- case done of {
            true -> cast_exit(code);
            false -> true
        }
    produces
        pure (:no_reply, next)
    end
}

fn send_line(o: actor_ref, m: (atom, string)) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(o, m impl ActorMessage {})
    produces
        pure r
    end
}

fn greet(o: actor_ref) -> boolean {
    send_line(o, (:line, concat("he", "llo")))
}

fn greet_direct(o: actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(o, (:line, concat("wor", "ld")) impl ActorMessage {})
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        r1: boolean <- greet(s);
        print("greet: ");
        print_boolean(r1);
        println("");
        r2: boolean <- greet_direct(s);
        print("greet_direct: ");
        print_boolean(r2);
        println("");
        _: boolean <- case r1 and r2 of {
            true -> true;
            false -> cast_exit(99)
        };
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}

// FailureReporter (spec §15.4.13.4), registered before anything is spawned. Every report goes to
// standard error; an abnormal one (reason_tag other than 0) ends the program with status 70.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case contains(report, "reason_tag:      0") of {
            true -> true;
            false -> cast_exit(70)
        }
    produces pure (:no_reply, state) end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces pure registered end
}
