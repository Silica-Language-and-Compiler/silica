// A call nested in a tuple-literal argument after a scalar argument. Before the fix the scalar
// staged in X0 (here the tail call's own parameter, still in X0) was overwritten by the nested
// call: string_concat loads its operands into X0/X1 for L_concat_helper, and the emitters' guard
// (term_subterm_has_user_call) only saw user calls, so `show(n, (:tag, concat("he", "llo")))`
// printed the string's address instead of 42. A tuple argument is never staged in parallel
// (simple_gpr_arg_tree_can_stage refuses tuple types), so these calls take the sequential path.
// Covered: two arguments (the reorder of the two-argument call), the same inside a let body, three
// arguments (the staged-argument guard of emit_rest_args), a first argument that is itself a call
// (it must keep the second, evaluated first, in X1), and a prim other than concat (length_bytes).
// Expected (by hand): the five lines below, then exit status 0.
//   42 :tag hello
//   8 :seq seq
//   1 2 :three three
//   10 :first first
//   9 :len 5

fn show(n: int64, m: (atom, string)) -> int64 {
    (tag: atom, s: string) <- m;
    sequence proc[device_io]
        _: atom <- print_int64(n);
        _: atom <- print(" ");
        _: atom <- print_atom(tag);
        _: atom <- print(" ");
        _: atom <- println(s)
    produces
        pure n
    end
}

fn show3(a: int64, b: int64, m: (atom, string)) -> int64 {
    (tag: atom, s: string) <- m;
    sequence proc[device_io]
        _: atom <- print_int64(a);
        _: atom <- print(" ");
        _: atom <- print_int64(b);
        _: atom <- print(" ");
        _: atom <- print_atom(tag);
        _: atom <- print(" ");
        _: atom <- println(s)
    produces
        pure a + b
    end
}

fn show_n(n: int64, m: (atom, int64)) -> int64 {
    (tag: atom, k: int64) <- m;
    sequence proc[device_io]
        _: atom <- print_int64(n);
        _: atom <- print(" ");
        _: atom <- print_atom(tag);
        _: atom <- print(" ");
        _: atom <- print_int64(k);
        _: atom <- println("")
    produces
        pure n + k
    end
}

fn twice(n: int64) -> int64 {
    n * 2
}

fn go(n: int64) -> int64 {
    show(n, (:tag, concat("he", "llo")))
}

fn go_seq(n: int64) -> int64 {
    m: int64 <- n + 1;
    show(m, (:seq, concat("se", "q")))
}

fn go3(a: int64, b: int64) -> int64 {
    show3(a, b, (:three, concat("thr", "ee")))
}

fn go_call_first(n: int64) -> int64 {
    show(twice(n), (:first, concat("fir", "st")))
}

fn go_len(n: int64) -> int64 {
    show_n(n, (:len, length_bytes(concat("ab", "cde"))))
}

fn main() -> int64 {
    a: int64 <- go(42);
    b: int64 <- go_seq(7);
    c: int64 <- go3(1, 2);
    d: int64 <- go_call_first(5);
    e: int64 <- go_len(9);
    a + b + c + d + e - 77
}
