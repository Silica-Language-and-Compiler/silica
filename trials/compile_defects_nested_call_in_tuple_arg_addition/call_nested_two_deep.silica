// A call nested two aggregate literals deep in an argument after a scalar argument: a tuple in a
// tuple, a record in a tuple, and a tuple in a record. The guard looks through every literal, at any
// depth, so the scalar in X0 survives the string_concat at the bottom.
// The tuple in a tuple is also the regression of a separate SIR defect found here (2026-11-18): the
// call argument took the literal's inferred type, which flattens (:outer, (:pair, s)) into the triple
// (atom, atom, string), so the caller built three flat words and show_nested faulted reading the
// :pair atom as the pointer to the inner pair (terms_helpers expected_or_inferred_call_arg_type).
// Expected (by hand): the three lines below, then exit status 0.
//   21 :outer :pair deep
//   22 :wrap wrap 4
//   23 :rt rect 1.5

fn show_nested(n: int64, m: (atom, (atom, string))) -> int64 {
    (outer: atom, pair: (atom, string)) <- m;
    (tag: atom, s: string) <- pair;
    sequence proc[device_io]
        _: atom <- print_int64(n);
        _: atom <- print(" ");
        _: atom <- print_atom(outer);
        _: atom <- print(" ");
        _: atom <- print_atom(tag);
        _: atom <- print(" ");
        _: atom <- println(s)
    produces
        pure n
    end
}

fn show_wrapped(n: int64, m: (atom, { s: string, k: int64 })) -> int64 {
    (tag: atom, r: { s: string, k: int64 }) <- m;
    sequence proc[device_io]
        _: atom <- print_int64(n);
        _: atom <- print(" ");
        _: atom <- print_atom(tag);
        _: atom <- print(" ");
        _: atom <- print(r.s);
        _: atom <- print(" ");
        _: atom <- print_int64(r.k);
        _: atom <- println("")
    produces
        pure n
    end
}

fn show_deep_record(n: int64, r: { t: (atom, string), w: float64 }) -> int64 {
    (tag: atom, s: string) <- r.t;
    sequence proc[device_io]
        _: atom <- print_int64(n);
        _: atom <- print(" ");
        _: atom <- print_atom(tag);
        _: atom <- print(" ");
        _: atom <- print(s);
        _: atom <- print(" ");
        _: atom <- print_float64(r.w);
        _: atom <- println("")
    produces
        pure n
    end
}

fn go_nested(n: int64) -> int64 {
    show_nested(n, (:outer, (:pair, concat("de", "ep"))))
}

fn go_wrapped(n: int64) -> int64 {
    show_wrapped(n, (:wrap, { s: concat("wr", "ap"), k: 4 }))
}

// w is bound first: a record literal argument with a non-scalar field takes the literal's inferred
// field types, and an unsuffixed float literal infers as float32 against the float64 field (a
// separate, pre-existing SIR defect, not this suite's); a float64 name keeps the record on the
// sequential argument path, which is what this case covers.
fn go_deep_record(n: int64) -> int64 {
    w: float64 <- 1.5;
    show_deep_record(n, { t: (:rt, concat("re", "ct")), w: w })
}

fn main() -> int64 {
    a: int64 <- go_nested(21);
    b: int64 <- go_wrapped(22);
    c: int64 <- go_deep_record(23);
    a + b + c - 66
}
