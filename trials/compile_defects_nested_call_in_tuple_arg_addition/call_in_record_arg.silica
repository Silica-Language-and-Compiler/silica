// A call nested in a record-literal argument after a scalar argument. A record with a float64 field
// is not staged in parallel (a float node anywhere in the argument refuses the staging), so it takes
// the sequential path, where the scalar in X0 died in string_concat before the fix; a record of
// string and int64 fields is staged and was already right, and is kept here so both paths stay
// covered. The three-argument form goes through emit_rest_args.
// Expected (by hand): the three lines below, then exit status 0.
//   11 record 2.5
//   12 plain 3
//   1 2 rec3 0.5

fn show_rec(n: int64, r: { s: string, w: float64 }) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        _: atom <- print(" ");
        _: atom <- print(r.s);
        _: atom <- print(" ");
        _: atom <- print_float64(r.w);
        _: atom <- println("")
    produces
        pure n
    end
}

fn show_rec_plain(n: int64, r: { s: string, k: int64 }) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(n);
        _: atom <- print(" ");
        _: atom <- print(r.s);
        _: atom <- print(" ");
        _: atom <- print_int64(r.k);
        _: atom <- println("")
    produces
        pure n
    end
}

fn show_rec3(a: int64, b: int64, r: { s: string, w: float64 }) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(a);
        _: atom <- print(" ");
        _: atom <- print_int64(b);
        _: atom <- print(" ");
        _: atom <- print(r.s);
        _: atom <- print(" ");
        _: atom <- print_float64(r.w);
        _: atom <- println("")
    produces
        pure a + b
    end
}

fn go_rec(n: int64) -> int64 {
    show_rec(n, { s: concat("re", "cord"), w: 2.5 })
}

fn go_rec_plain(n: int64) -> int64 {
    show_rec_plain(n, { s: concat("pla", "in"), k: 3 })
}

fn go_rec3(a: int64, b: int64) -> int64 {
    show_rec3(a, b, { s: concat("re", "c3"), w: 0.5 })
}

fn main() -> int64 {
    a: int64 <- go_rec(11);
    b: int64 <- go_rec_plain(12);
    c: int64 <- go_rec3(1, 2);
    a + b + c - 26
}
