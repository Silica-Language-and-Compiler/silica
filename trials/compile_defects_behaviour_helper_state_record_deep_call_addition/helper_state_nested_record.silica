use trial_wait_int64;

fn deep(n: int64) -> int64 {
    case n <= 0 of {
        true -> 0;
        false -> deep(n - 1) + n
    }
}

fn big(n: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_string("");
        p: { a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64 } <- { a: n, b: n + 1, c: n + 2, d: n + 3, e: n + 4, f: n + 5, g: n + 6, h: n + 7 };
        q: { a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64 } <- { a: p.h, b: p.g, c: p.f, d: p.e, e: p.d, f: p.c, g: p.b, h: p.a }
    produces
        pure p.a + q.a + p.h + q.h
    end
}

fn finish(step: int64) -> atom {
    case step < 3 of {
        true -> :ok;
        false -> {
            sequence proc[concurrency, device_io]
                _: atom <- print_string("DONE\n");
                _: boolean <- cast_exit(0)
            produces
                pure :ok
            end
        }
    }
}

fn helper(st: { a: int64, in: { x: int64, y: int64 }, d: int64 }) -> (:no_reply, { a: int64, in: { x: int64, y: int64 }, d: int64 }) {
    (:no_reply, { a: st.a + 1, in: { x: st.in.x + 2, y: st.in.y + 3 }, d: st.d + 4 })
}

fn step(msg: int64, st: { a: int64, in: { x: int64, y: int64 }, d: int64 }) -> (:no_reply, { a: int64, in: { x: int64, y: int64 }, d: int64 }) {
    sequence proc[device_io]
        _: atom <- print_int64(st.a);
        _: atom <- print_string(" ");
        _: atom <- print_int64(st.in.x);
        _: atom <- print_string(" ");
        _: atom <- print_int64(st.in.y);
        _: atom <- print_string(" ");
        _: atom <- print_int64(st.d);
        _: atom <- print_string("\n");
        r: (:no_reply, { a: int64, in: { x: int64, y: int64 }, d: int64 }) <- helper(st);
        x: int64 <- big(3);
        y: int64 <- deep(20);
        _: atom <- finish(msg)
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                c: actor_ref <- spawn({ a: 0, in: { x: 0, y: 0 }, d: 0 }, step, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(c, 1 impl ActorMessage {});
                _: boolean <- cast(c, 2 impl ActorMessage {});
                _: boolean <- cast(c, 3 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
