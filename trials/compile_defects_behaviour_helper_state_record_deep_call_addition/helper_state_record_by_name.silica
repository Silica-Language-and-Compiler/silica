use trial_wait_int64;

fn sink(msg: int64, total: int64) -> (:no_reply, int64) {
    (:no_reply, total + msg)
}

fn finish(step: int64) -> atom {
    case step < 3 of {
        true -> :ok;
        false -> {
            sequence proc[concurrency, device_io]
                _: atom <- print_string("done\n");
                _: boolean <- cast_exit(0)
            produces
                pure :ok
            end
        }
    }
}

fn announce(peer: actor_ref, expect: string, seen: int64) -> atom {
    sequence proc[concurrency, device_io]
        _: atom <- print_string("seen=");
        _: atom <- print_int64(seen);
        _: atom <- print_string(" expect=");
        _: atom <- print_string(expect);
        _: atom <- print_string("\n");
        _: boolean <- cast(peer, 1 impl ActorMessage {});
        _: atom <- finish(seen)
    produces
        pure :ok
    end
}

// The helper builds the new state record in its own frame and returns it as (:no_reply, record); the
// whole state arrives BY NAME.
fn settle(state: { peer: actor_ref, expect: string, seen: int64 }, delta: int64) -> (:no_reply, { peer: actor_ref, expect: string, seen: int64 }) {
    seen: int64 <- state.seen + delta;
    t: atom <- announce(state.peer, state.expect, seen);
    (:no_reply, { peer: state.peer, expect: state.expect, seen: seen })
}

// The string field becomes a run-time string (built by concat in this frame, copied into the state area).
fn arm(state: { peer: actor_ref, expect: string, seen: int64 }) -> (:no_reply, { peer: actor_ref, expect: string, seen: int64 }) {
    e: string <- concat("key:", "7");
    (:no_reply, { peer: state.peer, expect: e, seen: state.seen })
}

fn keeper(msg: int64, state: { peer: actor_ref, expect: string, seen: int64 }) -> (:no_reply, { peer: actor_ref, expect: string, seen: int64 }) {
    case msg == 0 of {
        true -> arm(state);
        false -> settle(state, 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                k: actor_ref <- spawn({ peer: s, expect: "", seen: 0 }, keeper, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(k, 0 impl ActorMessage {});
                _: boolean <- cast(k, 1 impl ActorMessage {});
                _: boolean <- cast(k, 2 impl ActorMessage {});
                _: boolean <- cast(k, 3 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
