use trial_wait_int64;

fn mk(a: int64, b: int64, c: int64, d: int64) -> { a: int64, b: int64, c: int64, d: int64 } {
    { a: a, b: b, c: c, d: d }
}

fn deep(n: int64) -> int64 {
    case n <= 0 of {
        true -> 0;
        false -> deep(n - 1) + n
    }
}

fn helper(st: { a: int64, b: int64, c: int64, d: int64 }) -> (:no_reply, { a: int64, b: int64, c: int64, d: int64 }) {
    (:no_reply, mk(st.a + 1, st.b + 2, st.c + 3, st.d + 4))
}

fn finish(step: int64) -> atom {
    case step < 3 of {
        true -> :ok;
        false -> {
            sequence proc[concurrency, device_io]
                _: atom <- print_string("DONE\n");
                _: boolean <- cast_exit(0)
            produces
                pure :ok
            end
        }
    }
}

fn step(msg: int64, st: { a: int64, b: int64, c: int64, d: int64 }) -> (:no_reply, { a: int64, b: int64, c: int64, d: int64 }) {
    sequence proc[device_io]
        _: atom <- print_int64(st.a);
        _: atom <- print_string(" ");
        _: atom <- print_int64(st.b);
        _: atom <- print_string(" ");
        _: atom <- print_int64(st.c);
        _: atom <- print_string(" ");
        _: atom <- print_int64(st.d);
        _: atom <- print_string("\n");
        r: (:no_reply, { a: int64, b: int64, c: int64, d: int64 }) <- helper(st);
        x: int64 <- deep(6);
        y: int64 <- deep(9);
        _: atom <- print_int64(x + y);
        _: atom <- print_string("\n");
        _: atom <- finish(msg)
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                c: actor_ref <- spawn({ a: 0, b: 0, c: 0, d: 0 }, step, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(c, 1 impl ActorMessage {});
                _: boolean <- cast(c, 2 impl ActorMessage {});
                _: boolean <- cast(c, 3 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
