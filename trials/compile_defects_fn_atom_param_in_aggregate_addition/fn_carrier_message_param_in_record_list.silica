// A fn whose parameter is the carrier-shaped five-variant message type, stored in a record inside a list.
// Open defect: strip_named_params_work strips parameter names from fn types by cutting at the first top-level ":"
// without checking that a name precedes it, so an atom-led parameter type is corrupted on repeated passes and the
// checker raises E2003. Expected: the function is read back through the list and called with (:credit, 5) and :poll: "carrier=15" then "carrier=10", then the marker "done" and the exit status 0.

use trial_wait_int64;

fn carrier_step(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: int64) -> int64 {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> state;
        (:tx, _s: string, _f: actor_ref) -> state;
        (:credit, n: int64) -> state + n;
        :close -> state;
        :poll -> state
    }
}

fn run3(f: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: int64) -> int64, m: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, s: int64) -> int64 {
    f(m, s)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[device_io, mem(normal)]
                items: List[{ tag: int64, f: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: int64) -> int64 }, mem(normal)] <- [
                    { tag: 10, f: carrier_step }
                ];
                first: { tag: int64, f: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: int64) -> int64 } <- list_nth(items, 0);
                m1: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll <- (:credit, 5);
                m2: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll <- :poll;
                a: int64 <- run3(first.f, m1, first.tag);
                _: atom <- print_string("carrier=");
                _: atom <- print_int64(a);
                _: atom <- println("");
                b: int64 <- run3(first.f, m2, first.tag);
                _: atom <- print_string("carrier=");
                _: atom <- print_int64(b);
                _: atom <- println("");
                _: atom <- println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
