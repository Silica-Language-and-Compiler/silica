// A function whose first parameter is atom-led (msg: :close | :poll) stored in a record that sits in a list.
// Open defect: strip_named_params_work cut the fn type at its first top-level ":" without checking that a
// name precedes it, so the atom-led parameter type was corrupted on a repeated pass and E2003 was raised.
// Expected: the stored function is read back through the list and called twice: "close=11" then "poll=12", exit 0.

use trial_wait_int64;

fn pick(msg: :close | :poll, state: int64) -> int64 {
    case msg of {
        :close -> state + 1;
        :poll -> state + 2
    }
}

fn run_close(f: fn(msg: :close | :poll, state: int64) -> int64, s: int64) -> int64 {
    f(:close, s)
}

fn run_poll(f: fn(msg: :close | :poll, state: int64) -> int64, s: int64) -> int64 {
    f(:poll, s)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[device_io, mem(normal)]
                items: List[{ tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 }, mem(normal)] <- [
                    { tag: 1, f: pick },
                    { tag: 2, f: pick }
                ];
                first: { tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 } <- list_nth(items, 0);
                second: { tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 } <- list_nth(items, 1);
                _: atom <- print_string("close=");
                a: int64 <- run_close(first.f, 10);
                _: atom <- print_int64(a);
                _: atom <- println("");
                _: atom <- print_string("poll=");
                b: int64 <- run_poll(second.f, 10);
                _: atom <- print_int64(b);
                _: atom <- println("");
                _: atom <- println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
