// An atom-led fn parameter stored in a tuple that sits in a list.
// Open defect: strip_named_params_work strips parameter names from fn types by cutting at the first top-level ":"
// without checking that a name precedes it, so an atom-led parameter type is corrupted on repeated passes and the
// checker raises E2003. Expected: the tuples are read back through the list and the stored function is called: "close=2" then "poll=4", then the marker "done" and the exit status 0.

use trial_wait_int64;

fn pick(msg: :close | :poll, state: int64) -> int64 {
    case msg of {
        :close -> state + 1;
        :poll -> state + 2
    }
}

fn run_close(f: fn(msg: :close | :poll, state: int64) -> int64, s: int64) -> int64 {
    f(:close, s)
}

fn run_poll(f: fn(msg: :close | :poll, state: int64) -> int64, s: int64) -> int64 {
    f(:poll, s)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[device_io, mem(normal)]
                items: List[(int64, fn(msg: :close | :poll, state: int64) -> int64), mem(normal)] <- [
                    (1, pick),
                    (2, pick)
                ];
                p0: (int64, fn(msg: :close | :poll, state: int64) -> int64) <- list_nth(items, 0);
                p1: (int64, fn(msg: :close | :poll, state: int64) -> int64) <- list_nth(items, 1);
                (t0, f0): (int64, fn(msg: :close | :poll, state: int64) -> int64) <- p0;
                (t1, f1): (int64, fn(msg: :close | :poll, state: int64) -> int64) <- p1;
                a: int64 <- run_close(f0, t0);
                _: atom <- print_string("close=");
                _: atom <- print_int64(a);
                _: atom <- println("");
                b: int64 <- run_poll(f1, t1);
                _: atom <- print_string("poll=");
                _: atom <- print_int64(b);
                _: atom <- println("");
                _: atom <- println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
