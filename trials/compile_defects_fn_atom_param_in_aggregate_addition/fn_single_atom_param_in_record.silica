// A single-atom fn parameter type (msg: :close) stored in a record.
// Open defect: strip_named_params_work strips parameter names from fn types by cutting at the first top-level ":"
// without checking that a name precedes it, so an atom-led parameter type is corrupted on repeated passes and the
// checker raises E2003. Expected: the stored function is called with :close: "single=4", then the marker "done" and the exit status 0.

use trial_wait_int64;

fn only(msg: :close, state: int64) -> int64 {
    state + 1
}

fn run_only(f: fn(msg: :close, state: int64) -> int64, s: int64) -> int64 {
    f(:close, s)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[device_io]
                r: { tag: int64, f: fn(msg: :close, state: int64) -> int64 } <- { tag: 3, f: only };
                a: int64 <- run_only(r.f, r.tag);
                _: atom <- print_string("single=");
                _: atom <- print_int64(a);
                _: atom <- println("");
                _: atom <- println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
