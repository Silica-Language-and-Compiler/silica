// A fn parameter whose type is unnamed-led by a tuple ((:a, int64) | :b) stored in a record.
// Open defect: strip_named_params_work strips parameter names from fn types by cutting at the first top-level ":"
// without checking that a name precedes it, so an atom-led parameter type is corrupted on repeated passes and the
// checker raises E2003. Expected: the stored function is called with (:a, 5) and then :b: "tuple_led=15" then "tuple_led=10", then the marker "done" and the exit status 0.

use trial_wait_int64;

fn pick2(msg: (:a, int64) | :b, state: int64) -> int64 {
    case msg of {
        (:a, n: int64) -> state + n;
        :b -> state
    }
}

fn run2(f: fn(msg: (:a, int64) | :b, state: int64) -> int64, m: (:a, int64) | :b, s: int64) -> int64 {
    f(m, s)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[device_io]
                r: { tag: int64, f: fn(msg: (:a, int64) | :b, state: int64) -> int64 } <- { tag: 10, f: pick2 };
                m1: (:a, int64) | :b <- (:a, 5);
                m2: (:a, int64) | :b <- :b;
                a: int64 <- run2(r.f, m1, r.tag);
                _: atom <- print_string("tuple_led=");
                _: atom <- print_int64(a);
                _: atom <- println("");
                b: int64 <- run2(r.f, m2, r.tag);
                _: atom <- print_string("tuple_led=");
                _: atom <- print_int64(b);
                _: atom <- println("");
                _: atom <- println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
