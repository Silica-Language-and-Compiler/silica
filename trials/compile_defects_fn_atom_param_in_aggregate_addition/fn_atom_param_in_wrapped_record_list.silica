// An atom-led fn parameter in a record parameter that is wrapped as a one-element list ([r]).
// Open defect: strip_named_params_work strips parameter names from fn types by cutting at the first top-level ":"
// without checking that a name precedes it, so an atom-led parameter type is corrupted on repeated passes and the
// checker raises E2003. Expected: the list built from the record parameter is read back and the stored function is called: "wrapped=6", then the marker "done" and the exit status 0.

use trial_wait_int64;

fn pick(msg: :close | :poll, state: int64) -> int64 {
    case msg of {
        :close -> state + 1;
        :poll -> state + 2
    }
}

fn run_close(f: fn(msg: :close | :poll, state: int64) -> int64, s: int64) -> int64 {
    f(:close, s)
}

fn run_poll(f: fn(msg: :close | :poll, state: int64) -> int64, s: int64) -> int64 {
    f(:poll, s)
}

fn wrap(r: { tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 }) -> List[{ tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 }, mem(normal)] {
    [r]
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[device_io]
                r: { tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 } <- { tag: 5, f: pick };
                items: List[{ tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 }, mem(normal)] <- wrap(r);
                first: { tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 } <- list_nth(items, 0);
                a: int64 <- run_close(first.f, first.tag);
                _: atom <- print_string("wrapped=");
                _: atom <- print_int64(a);
                _: atom <- println("");
                _: atom <- println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
