// A supervisor child-spec row whose behavior field is a fn type with an atom-led parameter
// (msg: :close | :poll). Open defect: strip_named_params_work cut the fn type at its first top-level ":"
// without checking that a name precedes it, so the atom-led parameter type was corrupted on repeated
// passes and the checker raised E2003 on the :worker row. Expected: the runtime delivers :poll to the
// child, which prints "kid=poll" then "done", then the exit status 0.

use Supervisor;

impl MSup for Supervisor;

fn kid(msg: :close | :poll, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_string("kid=");
        label: string <- case msg of {
            :close -> "close";
            :poll -> "poll"
        };
        _: atom <- println(label);
        _: atom <- println("done")
    produces
        pure (:no_reply, state)
    end
}

fn init(_s: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: :close | :poll, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 2, restarts_time_frame: 60 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: :close | :poll, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)] <- [
            { id: :k, agent_type: :worker, initial_state: 0, behavior: kid, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(MSup, 0, :msup, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast_registered(:k, :poll impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec 15.4.13.4): registered before the supervisor starts (E2236).
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
