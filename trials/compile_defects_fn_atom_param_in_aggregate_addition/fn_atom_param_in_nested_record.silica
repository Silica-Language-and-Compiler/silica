// An atom-led fn parameter in a record nested inside a record literal.
// Open defect: strip_named_params_work strips parameter names from fn types by cutting at the first top-level ":"
// without checking that a name precedes it, so an atom-led parameter type is corrupted on repeated passes and the
// checker raises E2003. Expected: the inner record is read from the outer one and its function is called: "nested=9", then the marker "done" and the exit status 0.

use trial_wait_int64;

fn pick(msg: :close | :poll, state: int64) -> int64 {
    case msg of {
        :close -> state + 1;
        :poll -> state + 2
    }
}

fn run_close(f: fn(msg: :close | :poll, state: int64) -> int64, s: int64) -> int64 {
    f(:close, s)
}

fn run_poll(f: fn(msg: :close | :poll, state: int64) -> int64, s: int64) -> int64 {
    f(:poll, s)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[device_io]
                outer: { id: int64, inner: { tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 } } <- { id: 1, inner: { tag: 7, f: pick } };
                inner: { tag: int64, f: fn(msg: :close | :poll, state: int64) -> int64 } <- outer.inner;
                a: int64 <- run_poll(inner.f, inner.tag);
                _: atom <- print_string("nested=");
                _: atom <- print_int64(a);
                _: atom <- println("");
                _: atom <- println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
