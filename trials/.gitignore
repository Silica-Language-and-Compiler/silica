# Trial executables: a built trial program is the trial's stem with no extension. Every
# extensionless file under trials/ is ignored except the names that are sources or markers.
*
!*.*
!*/
!Makefile
!makefile
!INTEGRATE_PENDING
!dangerous_exposure_source

# Regenerated by each trial Makefile target `silica.config` (see that directory's Makefile).
**/silica.config
# Written by `make integrate` / sub-trial checks; removed by `make clean`.
**/.integrate_counts

# Written by the shared integrate wrapper (silica_compiler.mk); removed by `make clean`.
**/.integrate_log
**/.integrate_report
**/.integrate_status
**/.integrate_start
**/.integrate_results
**/.integrate_skipped
**/.integrate_pass_marks
**/.integrate_fail_marks
**/.integrate_running/
# Per-unit sandboxes and stamps in ordered_data_structures leaves.
**/.sandbox/
**/*.checked

# Trial targets (targets/README.md): the lock that keeps trial runs from overlapping, the work area
# of board runs, and each board target's own outputs next to the trials (one set per board target).
/.integrate.lock/
/.target/
**/.integrate_report.ESP32-S3_raw
**/*.ESP32-S3_raw.sout
**/*.ESP32-S3_raw.cur_fail

# `!*.*` at the top re-includes every file with an extension, so the build outputs ignored in the root
# .gitignore are ignored again here (patterns in this file win over the root's).
*.o
*.a
*.so
*.dylib
*.sams
*.iface
*.sout
*.cur_fail
*.cur_warn
*.mklog
*.log
*.tmp
*.elf
*.map
*.ll
*.bc
*.swp
*.atom_rotext.expect
.DS_Store
silica.config
silica.link
silica.atoms
silica.shapes
silica.needs_runtime
silica.compile.order
silica.target
.silica.config.units

# Item M: the private Supervisor trait link each suite makes next to its silica.config.
**/.trial_stdlib/

# Item M: the private Supervisor trait link each suite makes next to its silica.config.
**/.trial_stdlib/
# Item M: ordered_data_structures leaves link the trial-support modules into lib/ (leaf.mk).
ordered_data_structures/**/lib/trial_support_*.silica
ordered_data_structures/**/lib/trial_wait_*.silica
ordered_data_structures/**/lib/Supervisor.silica

# trial cache intermediates (only the content-hashed .ascomp goldens are tracked)
**/.trial_cache/**/*.atoms
**/.trial_cache/**/*.shapes
