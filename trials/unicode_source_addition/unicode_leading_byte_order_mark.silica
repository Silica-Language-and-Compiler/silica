// Spec §2.1 (2026-10-16): a source file may begin with a UTF-8 byte order mark (EF BB BF); the
// lexer skips it, so this file, whose first three bytes are the mark, compiles and runs as if the
// mark were absent. (A byte order mark anywhere after the first character is E0001.)
// The work returns :ok, a fixed-prefix atom, so the exit status is :ok's index, 2.
// Expected (stdout): "byte order mark skipped" on one line; exit 2.

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- println("byte order mark skipped")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
