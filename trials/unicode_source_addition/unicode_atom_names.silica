// Spec §2.1, §2.2 (2026-10-16): atom literals may hold any Unicode character; print_atom writes the
// atom's name, colon first, with its exact UTF-8 bytes. Two-, three- and four-byte characters are
// covered, and two literals with the same Unicode name are the same atom. The work returns :ok, a
// fixed-prefix atom, so the exit status is :ok's index, 2. (This suite has its own atom table, so
// the new atoms shift no other suite's numbering.)
// Expected (stdout), one per line: :café, :日本, :ünïcødé_😀, true; exit 2.
//
// Open defect when written (2026-10-16, gen1 of the lexer build): the emitter writes each atom's
// name table entry one byte per character, with '?' for every non-ASCII character and NUL padding
// up to the byte length, so print_atom(:café) prints ":caf?" followed by a NUL.

use trial_support_atom;

// Prints an atom on its own line and returns it.
fn show(a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print_atom(a);
        println("")
    produces
        pure a
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- show(:café);
                _: atom <- show(:日本);
                _: atom <- show(:ünïcødé_😀);
                _: atom <- print_boolean(:café == :café);
                _: atom <- println("")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
