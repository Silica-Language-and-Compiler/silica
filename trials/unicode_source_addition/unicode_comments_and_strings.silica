// Spec §2.1 (2026-10-16): source text is UTF-8, and any Unicode character may appear inside
// comments, string literals and character literals. Comments: «guillemets», ü, €, 中文, 😀 (four
// bytes), and the block comment below. Strings with two-, three- and four-byte characters print
// their exact bytes. The work returns :ok, a fixed-prefix atom, so the exit status is :ok's index, 2.
// Expected (stdout), one per line: café, 3 € 50, 中文, 😀 ok, é, ok; exit 2.

{- A block comment with Unicode: ñ, Ω, ∑, 漢字, 🎉, and a line of Greek: αβγδε. -}

use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- println("café");               // two-byte é
                _: atom <- println("3 € 50");             // three-byte €
                _: atom <- println("中文");               // three-byte CJK
                _: atom <- println("😀 ok");              // four-byte emoji
                _: atom <- print_char('é');               // a two-byte character literal
                _: atom <- println("");
                _: atom <- println("ok")
            produces
                pure :ok
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
