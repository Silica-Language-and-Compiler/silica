// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(54 * 18 > 1);
                println("");
                _: atom <- print_boolean((22 - 13) >= (50 + 7));
                println("");
                result: atom <- print_boolean((52 + 23) != 1)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
