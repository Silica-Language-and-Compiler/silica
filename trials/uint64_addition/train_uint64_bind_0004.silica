// uint64 bindings then expression; expect 3
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            count: uint64 <- 14;
            c: uint64 <- count;
            total: uint64 <- 7;
            height: uint64 <- 8;
            28 / height % (height + height) + c - c + total - total
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3
    end
}
