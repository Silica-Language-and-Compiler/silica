// uint64 relational comparisons when the left operand has its top bit set, both through a
// binding in a let body (the emitter's bound-let compare path) and directly on parameters.
// 2^64-1 is above 255 for every unsigned operator. Until 2026-11-05 the bound-let path emitted
// signed condition codes (LE/LT/GT/GE) for uint64 operands, so `big <= lim` was true.
// Output per probe: op_code (1=<, 2=<=, 3=>, 4=>=), shape (1=bound, 2=direct), result for big, result for small.

use trial_support_atom;

fn lt_bound(v: uint64) -> boolean {
    lim: uint64 <- 255;
    v < lim
}

fn le_bound(v: uint64) -> boolean {
    lim: uint64 <- 255;
    v <= lim
}

fn gt_bound(v: uint64) -> boolean {
    lim: uint64 <- 255;
    v > lim
}

fn ge_bound(v: uint64) -> boolean {
    lim: uint64 <- 255;
    v >= lim
}

fn lt_direct(v: uint64, lim: uint64) -> boolean {
    v < lim
}

fn le_direct(v: uint64, lim: uint64) -> boolean {
    v <= lim
}

fn gt_direct(v: uint64, lim: uint64) -> boolean {
    v > lim
}

fn ge_direct(v: uint64, lim: uint64) -> boolean {
    v >= lim
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                big: uint64 <- 18446744073709551615;
                small: uint64 <- 3;
                lim: uint64 <- 255;
                _: atom <- print_uint64(1);
                _: atom <- print_uint64(1);
                _: atom <- print_boolean(lt_bound(big));
                _: atom <- print_boolean(lt_bound(small));
                _: atom <- print_uint64(2);
                _: atom <- print_uint64(1);
                _: atom <- print_boolean(le_bound(big));
                _: atom <- print_boolean(le_bound(small));
                _: atom <- print_uint64(3);
                _: atom <- print_uint64(1);
                _: atom <- print_boolean(gt_bound(big));
                _: atom <- print_boolean(gt_bound(small));
                _: atom <- print_uint64(4);
                _: atom <- print_uint64(1);
                _: atom <- print_boolean(ge_bound(big));
                _: atom <- print_boolean(ge_bound(small));
                _: atom <- print_uint64(1);
                _: atom <- print_uint64(2);
                _: atom <- print_boolean(lt_direct(big, lim));
                _: atom <- print_boolean(lt_direct(small, lim));
                _: atom <- print_uint64(2);
                _: atom <- print_uint64(2);
                _: atom <- print_boolean(le_direct(big, lim));
                _: atom <- print_boolean(le_direct(small, lim));
                _: atom <- print_uint64(3);
                _: atom <- print_uint64(2);
                _: atom <- print_boolean(gt_direct(big, lim));
                _: atom <- print_boolean(gt_direct(small, lim));
                _: atom <- print_uint64(4);
                _: atom <- print_uint64(2);
                _: atom <- print_boolean(ge_direct(big, lim));
                result: atom <- print_boolean(ge_direct(small, lim))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
