// chained print_uint64 calls separated by println
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_uint64(10);
                println("");
                _: atom <- print_uint64(4 % 38 + 5 / 2);
                println("");
                result: atom <- print_uint64(37 / 37 + 14)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
