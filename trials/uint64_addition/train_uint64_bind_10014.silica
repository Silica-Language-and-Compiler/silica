// uint64 bindings then expression; expect 54
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            step: uint64 <- 15;
            d: uint64 <- 46 / 10 % (1 + step);
            base: uint64 <- 59;
            count: uint64 <- d % d % (27 % 34);
            36 + step + 39 % 9 + base - base + count - count
        });
        _: int64 <- wait_for_exit()
    produces
        pure 54
    end
}
