// defect B12 follow-up: the largest uint64 literal is in range and must compile;
// the range check judged 64-bit literals through an int64 accumulator and rejected it.
use trial_support_atom;

fn big() -> uint64 {
    18446744073709551615
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                r: atom <- print_uint64(big())
            produces pure r end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
