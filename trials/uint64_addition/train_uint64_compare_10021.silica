// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((21 + 2) < 54 / 26);
                println("");
                _: atom <- print_boolean((37 - 3) == 40);
                println("");
                _: atom <- print_boolean(45 / 31 > 46 % 41);
                println("");
                _: atom <- print_boolean((23 + 37) > (53 + 60));
                println("");
                result: atom <- print_boolean(11 >= (20 + 56))
            produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
