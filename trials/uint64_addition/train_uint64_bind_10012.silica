// uint64 bindings then expression; expect 22
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            m: uint64 <- 46 * 34;
            total: uint64 <- 48 - 43;
            height: uint64 <- m;
            count: uint64 <- height + (24 - 9);
            22 + total - total + count - count
        });
        _: int64 <- wait_for_exit()
    produces
        pure 22
    end
}
