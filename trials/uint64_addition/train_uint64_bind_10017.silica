// uint64 bindings then expression; expect 29
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            total: uint64 <- 50;
            base: uint64 <- total - 46 + 30 / 37;
            k: uint64 <- 2;
            count: uint64 <- 29;
            0 + (25 + 4) + base - base + k - k + count - count
        });
        _: int64 <- wait_for_exit()
    produces
        pure 29
    end
}
