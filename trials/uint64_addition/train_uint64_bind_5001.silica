// uint64 bindings then expression; expect 46
use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            width: uint64 <- 6;
            m: uint64 <- (width - width / 20);
            height: uint64 <- m + width;
            base: uint64 <- height * 12;
            21 + 25 + 3 / 34 + base - base
        });
        _: int64 <- wait_for_exit()
    produces
        pure 46
    end
}
