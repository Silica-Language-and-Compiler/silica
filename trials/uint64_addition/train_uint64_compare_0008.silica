// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean(41 == 32 % 1);
                println("");
                _: atom <- print_boolean(1 < (14 + 59));
                println("");
                _: atom <- print_boolean(38 > 24 / 12);
                println("");
                _: atom <- print_boolean(32 / 44 >= 50 / 35);
                println("");
                result: atom <- print_boolean((11 - 1) < (9 + 25))
                produces pure result end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
