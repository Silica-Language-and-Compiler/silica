// uint64 comparisons printed with print_boolean
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(25 == 45 * 26);
                println("");
                _: atom <- print_boolean((48 + 9) != (39 - 21));
                println("");
                _: atom <- print_boolean((14 / 39) < 56 % 36);
                println("");
                result: atom <- print_boolean((13 + 7) > 47)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
