// A device worker writes "hi" on USART2 through peek (:isr, TXE) and poke (:tdr); main only spawns,
// casts and waits (device spec §4.6). The worker shares USART2 with the runtime console, so its bytes
// appear in the program's output. Mirrors device_actor_addition/device_uart_hello (ESP32-S3 UART0).
// Expected: hi / status 0.
use device_usart2_lib;
use trial_wait_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                u: device_actor_ref <- spawn_device(:unmapped, device_usart2_lib@usart2_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast_device(u, { op: :init, byte: 0 } impl ActorMessage {});
                _: boolean <- cast_device(u, { op: :putc, byte: 104 } impl ActorMessage {});
                _: boolean <- cast_device(u, { op: :putc, byte: 105 } impl ActorMessage {});
                _: boolean <- cast_device(u, { op: :putc, byte: 10 } impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
