// Two GPIO workers: the LED worker makes PA5 an output and turns LD2 on; the button worker clocks GPIOC
// through RCC, reads B1 (PC13, pulled high on the board: idle 1) and casts the level to an ordinary
// printer actor; then the LED goes off. Mirrors device_actor_addition/device_gpio_button.
// Expected: button 1 / status 0 (nobody presses B1 during the run).
use device_gpio_lib;
use trial_wait_int64;

fn printer(level: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print("button ");
        _: atom <- print_int64(level);
        println("")
    produces
        pure (:no_reply, state + 1)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                p: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                l: device_actor_ref <- spawn_device(:unmapped, device_gpio_lib@led_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                b: device_actor_ref <- spawn_device(:unmapped, device_gpio_lib@button_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast_device(l, { op: :init, reply_to: p } impl ActorMessage {});
                _: boolean <- cast_device(l, { op: :led_on, reply_to: p } impl ActorMessage {});
                _: boolean <- cast_device(b, { op: :init, reply_to: p } impl ActorMessage {});
                _: boolean <- cast_device(b, { op: :read_button, reply_to: p } impl ActorMessage {});
                _: boolean <- cast_device(l, { op: :led_off, reply_to: p } impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
