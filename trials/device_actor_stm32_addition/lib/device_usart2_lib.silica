// USART2 (the runtime's console, the ST-LINK virtual COM port) as a device worker: window 0 of the
// STM32-L476RG_raw board_pack.silica at 0x40004400, described by the pack's
// device_stm32l4_usart2_registers (registers :isr, TXE is bit 7, and :tdr). The worker maps its window on
// :init inside a register_rwr sequence (nothing maps at the spawn site, device spec §4.3) and keeps the
// move-only handle in its state; every register access is inside a sequence proc[register_rwr].
// Messages: { op: :init | :putc | :discard, byte: uint32 }. No message asks for a reply.
// :discard reads :isr only for its effect (the load must still be emitted, spec §4.7).
use device_stm32l4_usart2_registers;

export usart2_worker/2;

fn put_byte(w: device_window(L, (:stm32l4_usart2)), byte: uint32) -> device_window(L, (:stm32l4_usart2)) {
    sequence proc[register_rwr]
        status: uint32 <- peek(w, :isr) impl Register32 {};
        empty: uint32 <- (status shr 7) band 1;
        r: device_window(L, (:stm32l4_usart2)) <- case empty == 1 of {
            true -> {
                _: atom <- poke(w, :tdr, byte impl Register32 {});
                w
            };
            false -> put_byte(w, byte)
        }
    produces
        pure r
    end
}

fn discard_status(w: device_window(L, (:stm32l4_usart2))) -> device_window(L, (:stm32l4_usart2)) {
    sequence proc[register_rwr]
        _: uint32 <- peek(w, :isr) impl Register32 {}
    produces
        pure w
    end
}

fn usart2_worker(msg: { op: atom, byte: uint32 }, state: :unmapped | (:mapped, device_window(L, (:stm32l4_usart2)))) -> (:no_reply, :unmapped | (:mapped, device_window(L, (:stm32l4_usart2)))) {
    sequence proc[register_rwr]
        next: :unmapped | (:mapped, device_window(L, (:stm32l4_usart2))) <- case state of {
            :unmapped -> case msg.op of {
                :init -> {
                    w: device_window(L, (:stm32l4_usart2)) <- map_device((:stm32l4_usart2), 0x40004400);
                    (:mapped, w)
                };
                _: atom -> :unmapped
            };
            (:mapped, w: device_window(L, (:stm32l4_usart2))) -> case msg.op of {
                :putc -> (:mapped, put_byte(w, msg.byte));
                :discard -> (:mapped, discard_status(w));
                _: atom -> (:mapped, w)
            }
        }
    produces
        pure (:no_reply, next)
    end
}
