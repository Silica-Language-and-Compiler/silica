// A computed map_device base is checked at run time (silica_rt_map_device_check, rt_support.S, the
// twin of board_pack.silica's window table): the worker receives the base in its message and maps
// GPIOA's tag at 0x20000000, which is SRAM1, not a board window. The check halts the program with the
// runtime abort "illegal device map" (status 71, runtime_failure_reporting.md); nothing is mapped and
// no register is touched. The constant-base twin is refused at compile time (refusals/).
// Expected: the folded abort line and status 71.
use device_stm32l4_gpioa_registers;
use trial_wait_int64;

fn worker(msg: { op: atom, base: uint64 }, state: :unmapped | (:mapped, device_window(L, (:stm32l4_gpioa)))) -> (:no_reply, :unmapped | (:mapped, device_window(L, (:stm32l4_gpioa)))) {
    sequence proc[register_rwr]
        next: :unmapped | (:mapped, device_window(L, (:stm32l4_gpioa))) <- case msg.op of {
            :map -> {
                w: device_window(L, (:stm32l4_gpioa)) <- map_device((:stm32l4_gpioa), msg.base);
                (:mapped, w)
            };
            _: atom -> state
        }
    produces
        pure (:no_reply, next)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                d: device_actor_ref <- spawn_device(:unmapped, worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast_device(d, { op: :map, base: 0x20000000 } impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
