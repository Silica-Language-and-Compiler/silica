// STM32-L476RG_raw emitter refusal: a 64-bit peek cannot be one load on the 32-bit AHB/APB bus, so the
// emitter writes .error "STM32-L476RG: peek of a 64-bit register is not supported on this board
// (Register32 only)" and the image build fails at assembly. The description (of TIM2, a board window
// the pack does not describe, so a program may) declares a register 64 bits wide so the shared checker
// accepts the marker.
use DeviceDescription;

export registers/1;
export worker/2;

impl fn registers(device: (:stm32l4_tim2)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :cnt_pair, offset: 0x20, width: 64, access: :read_only }
    ]
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        w: device_window(L, (:stm32l4_tim2)) <- map_device((:stm32l4_tim2), 0x40000000);
        _: uint64 <- peek(w, :cnt_pair) impl Register64 {}
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        _: atom <- start_reporter();
        d: device_actor_ref <- spawn_device(0, worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast_device(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the boards) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
