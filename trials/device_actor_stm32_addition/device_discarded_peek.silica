// A peek bound to `_` is still one load (device spec §4.7 "Reads are never removed"): the worker's
// :discard reads :isr for its effect only, then :putc writes "d". The emitted .sams for
// device_usart2_lib must show one ldr for discard_status; the run itself only shows the byte.
// Expected: d / status 0.
use device_usart2_lib;
use trial_wait_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                u: device_actor_ref <- spawn_device(:unmapped, device_usart2_lib@usart2_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast_device(u, { op: :init, byte: 0 } impl ActorMessage {});
                _: boolean <- cast_device(u, { op: :discard, byte: 0 } impl ActorMessage {});
                _: boolean <- cast_device(u, { op: :putc, byte: 100 } impl ActorMessage {});
                _: boolean <- cast_device(u, { op: :putc, byte: 10 } impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
