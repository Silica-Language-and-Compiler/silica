// Positive: effects are local (silica-specification §9.3.1 rule 4) when the caller is an actor
// behaviour. ask declares concurrency for its own call; relay, a behaviour, calls ask and declares
// nothing: calling a function never adds that function's effects to the caller, so relay needs
// no sequence block. A behaviour written as `sequence proc[concurrency] r: int64 <- ask(...)`
// performs no concurrency operation of its own and gets E3010 (the over-declared form is
// trials/error_enforcement_addition/effect_local_callee_unused); this is the shape the starter
// actor of bees_regions_addition/bees_sd7_message_region_released_in_flight first took (2026-11-07).
// echo replies msg * 2; relay replies ask's answer + 1; the work calls relay with 20 and prints 41.
// Only atoms the support modules already hold (:reply, :keep_last_message, :keep_state_area) are
// used, so the suite's atom table and the goldens of the units after this one do not change.
use trial_support_int64;

fn echo(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg * 2, state)
}

fn ask(a: actor_ref, n: int64) -> int64 {
    sequence proc[concurrency]
        r: int64 <- call(a, n impl ActorMessage {})
    produces
        pure r
    end
}

fn relay(msg: int64, state: actor_ref) -> (:reply, int64, actor_ref) {
    r: int64 <- ask(state, msg);
    (:reply, r + 1, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                e: actor_ref <- spawn(0, echo, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                rl: actor_ref <- spawn(e, relay, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                v: int64 <- call(rl, 20 impl ActorMessage {});
                print_int64(v);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
