.arch armv8.2-a+fp16
.text
    // use trial_support_int64
.extern silica_rt_ffi_guarded_enter
.extern silica_rt_ffi_guarded_exit
.extern silica_rt_ffi_guarded_setjmp
.extern silica_rt_ffi_guarded_fault_finish
.extern silica_rt_ffi_arena_bump
.global main


.globl main
main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL silica_pid_registry_init
    BL silica_dangerous_pid_registry_init
    BL silica_device_pid_registry_init
    // unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o215|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_start
    ADD X9, X9, :lo12:trial_support_int64_start
    BLR X9

    ADRP X16, train_effect_check_memarms_10003.__lam0
    ADD X16, X16, :lo12:train_effect_check_memarms_10003.__lam0

    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    // effects []|sir_rec:o266|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_run
    ADD X9, X9, :lo12:trial_support_int64_run
    BLR X9

    BL silica_rt_wait_for_exit

    MOV X19, X0
    MOV X0, X19



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

.globl train_effect_check_memarms_10003.__lam0
train_effect_check_memarms_10003.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!

    MOV X1, #0
    MOV X19, X1
    MOV X3, X19
L_case_o409_br_0:
    CMP W3, #1
    B.NE L_case_o409_br_1
    MOV X2, #0

    STR X2, [SP, #-16]!
    MOV X1, #34
    LDR X2, [SP], #16
    MOV X3, #8
    MOV X4, #16
    MOV X5, #0
    BL L_list_prepend_helper

    MOV X20, X0
    MOV X9, X20
    MOV X0, X9
    BL L_list_length_helper


    B L_case_o409_done
L_case_o409_br_1:
    CMP W3, #0
    B.NE L_case_o409_fb
    MOV X0, #0

    MOV X20, X0
    MOV X9, X20
    MOV X0, X9
    BL L_list_length_helper


    B L_case_o409_done
L_case_o409_fb:
    BL silica_rt_case_clause
    MOV X0, #0
    B L_case_o409_done
L_case_o409_done:

    MOV X20, X0
    MOV X0, X20


    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #28
    B.ge L_pa_oob
    ADRP X9, L_pa_table
    ADD X9, X9, :lo12:L_pa_table
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_list_prepend_helper:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X1, X2, [SP, #-16]!
    STP X3, X4, [SP, #-16]!
    STR X5, [SP, #-16]!
    CBZ X2, L_lph_new_chunk
    LDR X6, [X2, #16]
    CBZ X6, L_lph_new_chunk
    LDR X7, [X2, #8]
    ADD X12, X7, X4
    LDR X9, [X12, #8]
    CMP X9, X6
    B.NE L_lph_cow
    SUB X8, X6, X3
    STR X8, [X12, #8]
    ADD X10, X7, X8
    LDR X11, [SP]
    CBZ X11, L_lph_room_scalar
    MOV X12, #0
L_lph_room_agg:
    CMP X12, X3
    B.GE L_lph_room_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_room_agg
    B L_lph_room_stored
L_lph_room_scalar:
    CMP X3, #8
    B.EQ L_lph_rs8
    CMP X3, #4
    B.EQ L_lph_rs4
    CMP X3, #2
    B.EQ L_lph_rs2
    STRB W1, [X10]
    B L_lph_room_stored
L_lph_rs2:
    STRH W1, [X10]
    B L_lph_room_stored
L_lph_rs4:
    STR W1, [X10]
    B L_lph_room_stored
L_lph_rs8:
    STR X1, [X10]
L_lph_room_stored:
    MOV X0, #24
    BL silica_rt_region_alloc
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    LDR X6, [X2]
    ADD X6, X6, #1
    STR X6, [X0]
    LDR X7, [X2, #8]
    STR X7, [X0, #8]
    LDR X8, [X2, #16]
    SUB X8, X8, X3
    STR X8, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lph_cow:
    ADD X0, X4, #16
    BL silica_rt_region_alloc
    MOV X6, X0
    LDR X5, [SP]
    LDP X3, X4, [SP, #16]
    LDP X1, X2, [SP, #32]
    LDR X7, [X2, #8]
    LDR X9, [X2, #16]
    MOV X12, X9
L_lph_cow_copy:
    CMP X12, X4
    B.GE L_lph_cow_copied
    LDR X13, [X7, X12]
    STR X13, [X6, X12]
    ADD X12, X12, #8
    B L_lph_cow_copy
L_lph_cow_copied:
    ADD X12, X7, X4
    LDR X13, [X12]
    ADD X12, X6, X4
    STR X13, [X12]
    SUB X8, X9, X3
    ADD X10, X6, X8
    CBZ X5, L_lph_cow_scalar
    MOV X12, #0
L_lph_cow_agg:
    CMP X12, X3
    B.GE L_lph_alloc_handle
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_cow_agg
L_lph_cow_scalar:
    CMP X3, #8
    B.EQ L_lph_cs8
    CMP X3, #4
    B.EQ L_lph_cs4
    CMP X3, #2
    B.EQ L_lph_cs2
    STRB W1, [X10]
    B L_lph_alloc_handle
L_lph_cs2:
    STRH W1, [X10]
    B L_lph_alloc_handle
L_lph_cs4:
    STR W1, [X10]
    B L_lph_alloc_handle
L_lph_cs8:
    STR X1, [X10]
    B L_lph_alloc_handle
L_lph_new_chunk:
    ADD X0, X4, #16
    BL silica_rt_region_alloc
    MOV X6, X0
    LDR X5, [SP]
    LDP X3, X4, [SP, #16]
    LDP X1, X2, [SP, #32]
    SUB X8, X4, X3
    ADD X10, X6, X8
    CBZ X5, L_lph_new_scalar
    MOV X12, #0
L_lph_new_agg:
    CMP X12, X3
    B.GE L_lph_new_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_new_agg
    B L_lph_new_stored
L_lph_new_scalar:
    CMP X3, #8
    B.EQ L_lph_ns8
    CMP X3, #4
    B.EQ L_lph_ns4
    CMP X3, #2
    B.EQ L_lph_ns2
    STRB W1, [X10]
    B L_lph_new_stored
L_lph_ns2:
    STRH W1, [X10]
    B L_lph_new_stored
L_lph_ns4:
    STR W1, [X10]
    B L_lph_new_stored
L_lph_ns8:
    STR X1, [X10]
L_lph_new_stored:
    CBZ X2, L_lph_next_nil
    LDR X9, [X2, #8]
    STR X9, [X6, X4]
    B L_lph_alloc_handle
L_lph_next_nil:
    STR XZR, [X6, X4]
L_lph_alloc_handle:
    ADD X9, X6, X4
    STR X8, [X9, #8]
    STP X6, X8, [SP, #-16]!
    MOV X0, #24
    BL silica_rt_region_alloc
    LDP X6, X8, [SP], #16
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    CBZ X2, L_lph_len1
    LDR X9, [X2]
    ADD X9, X9, #1
    B L_lph_setlen
L_lph_len1:
    MOV X9, #1
L_lph_setlen:
    STR X9, [X0]
    STR X6, [X0, #8]
    STR X8, [X0, #16]
    LDP X29, X30, [SP], #16
    RET

L_list_tail_helper:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    LDR X3, [X0]
    LDR X4, [X0, #8]
    LDR X5, [X0, #16]
    ADD X6, X5, X1
    CMP X6, X2
    B.GE L_lth_next_chunk
    SUB X3, X3, #1
    CBZ X3, L_lth_nil
    STP X3, X4, [SP, #-16]!
    STP X6, XZR, [SP, #-16]!
    MOV X0, #24
    BL silica_rt_region_alloc
    LDP X6, XZR, [SP], #16
    LDP X3, X4, [SP], #16
    STR X3, [X0]
    STR X4, [X0, #8]
    STR X6, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lth_next_chunk:
    LDR X7, [X4, X2]
    CBZ X7, L_lth_nil
    SUB X3, X3, #1
    CBZ X3, L_lth_nil
    STP X3, X7, [SP, #-16]!
    MOV X0, #24
    BL silica_rt_region_alloc
    LDP X3, X7, [SP], #16
    STR X3, [X0]
    STR X7, [X0, #8]
    STR XZR, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lth_nil:
    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET

L_list_length_helper:
    CBZ X0, L_list_len_nil
    LDR X0, [X0]
    RET
L_list_len_nil:
    MOV X0, #0
    RET

