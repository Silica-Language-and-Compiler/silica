// Positive: pure helper chosen from a case arm; the effect runs in the sequence body
use trial_support_atom;

fn pick_value(flag: boolean) -> int64 {
    case flag of {
        true -> 7;
        false -> 7
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            flag: boolean <- true;
            sequence proc[device_io]
                v: int64 <- pick_value(flag);
                result: atom <- print_int64(v)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
