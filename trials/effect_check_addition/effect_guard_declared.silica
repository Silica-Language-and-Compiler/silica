// Positive: a call in a case guard is an operation of the enclosing sequence
// (silica-specification §9.3.1; effects are local, rule 4). pick's sequence declares device_io,
// and its only device_io operation is the print_int64 in the case guard, so the declaration is
// used (E3010 must not fire). The guard prints 1 and passes; main then prints pick's result, 1.
// The rejected form (no declaration) is trials/error_enforcement_addition/effect_guard_undeclared.
use trial_support_int64;

fn pick(b: int64) -> int64 {
    sequence proc[device_io]
        r: int64 <- case b of {
            n: int64 if print_int64(n) == :ok -> 1;
            _: int64 -> 0
        }
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(pick(1));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
