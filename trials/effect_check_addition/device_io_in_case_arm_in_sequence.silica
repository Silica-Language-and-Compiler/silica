// Positive: device_io used only inside a case arm still counts as used for the enclosing
// sequence proc[device_io] … produces pure … end (spec §9.3.1 / E3010 must not fire).
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            flag: boolean <- true;
            sequence proc[device_io]
                result: atom <- case flag of {
                    true -> print_int64(1);
                    false -> print_int64(0)
                }
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
