// Positive: list allocation requires sequence proc[mem(normal_writeback)] (spec §9.3.1)
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal_writeback)] xs: List[int64, mem(normal_writeback)] <- [7, 10, 16];
                n: int64 <- length[int64, mem(normal_writeback)](xs)
                produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
