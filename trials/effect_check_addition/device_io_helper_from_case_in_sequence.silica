// Positive: effectful work stays in sequence proc[device_io] … produces pure … end;
// pure helpers may be chosen from a case arm, then the effect runs in the sequence body.
use trial_support_atom;

fn pick_value(flag: boolean) -> int64 {
    case flag of {
        true -> 1;
        false -> 0
    }
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            flag: boolean <- true;
            sequence proc[device_io]
                v: int64 <- pick_value(flag);
                result: atom <- print_int64(v)
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
