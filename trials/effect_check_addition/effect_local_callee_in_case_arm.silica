// Positive: effects are local (silica-specification §9.3.1 rule 4). say declares device_io for
// its own prints. pick calls say from a case arm inside a sequence that declares no effects:
// calling a function never adds that function's effects to the caller, so pick needs no
// declaration. say prints 1; main then prints pick's result, 1.
// The over-declared form is trials/error_enforcement_addition/effect_local_callee_unused (E3010).
use trial_support_int64;

fn say(n: int64) -> int64 {
    sequence proc[device_io]
        print_int64(n);
        println("")
    produces
        pure n
    end
}

fn pick(b: boolean) -> int64 {
    sequence
        r: int64 <- case b of {
            true -> say(1);
            false -> 0
        }
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                print_int64(pick(true));
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
