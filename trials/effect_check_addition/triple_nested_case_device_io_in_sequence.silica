// Positive: device_io used only in case-within-case-within-case still counts for
// sequence proc[device_io] … produces pure … end (spec §9.3.1 / E3010 must not fire).
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            a: int64 <- 1;
            b: int64 <- 2;
            c: int64 <- 3;
            sequence proc[device_io]
                result: atom <- case a of {
                    0 -> print_int64(0);
                    _: int64 -> case b of {
                        0 -> print_int64(10);
                        _: int64 -> case c of {
                            3 -> print_int64(3);
                            _: int64 -> print_int64(99)
                        }
                    }
                }
            produces
                pure result
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
