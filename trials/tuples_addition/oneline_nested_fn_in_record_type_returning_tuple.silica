use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            x: { start: (int64, fn(msg: int64, state: int64) -> (int64,string)) } <- { start: (0, fn(msg: int64, state: int64) -> (int64,string){ (0, "hello") }) };
            _used_x: { start: (int64, fn(msg: int64, state: int64) -> (int64,string)) } <- x;
            1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
