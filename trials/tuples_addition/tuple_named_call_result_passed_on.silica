// A tuple call result bound to a name and then passed to another call, or kept in a list, outlives
// the expression that made it: the call names no result buffer (X8 = 0) and the callee hands back
// a block of its own. p and q are pair results passed to sum2 (10 * first + second); p is read
// again after other calls; keep puts two pair results in a list, and its head and second element
// are summed the same way.
// Expected output:
//   45      sum2(p), p = (4, 5)
//   78      sum2(q), q = (7, 8)
//   45      sum2(p) again
//   12      list head (1, 2)
//   122     list second (11, 12)
//   0
use trial_support_int64;

fn pair(n: int64) -> (int64, int64) {
    (n, n + 1)
}

fn sum2(p: (int64, int64)) -> int64 {
    (a, b): (int64, int64) <- p;
    10 * a + b
}

fn keep(n: int64) -> List[(int64, int64), mem(normal)] {
    a: (int64, int64) <- pair(n);
    b: (int64, int64) <- pair(n + 10);
    [a, b]
}

fn pi(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                p: (int64, int64) <- pair(4);
                q: (int64, int64) <- pair(7);
                _: int64 <- pi(sum2(p));
                _: int64 <- pi(sum2(q));
                _: int64 <- pi(sum2(p));
                l: List[(int64, int64), mem(normal)] <- keep(1);
                h: (int64, int64) <- l.head;
                t: List[(int64, int64), mem(normal)] <- l.tail;
                s: (int64, int64) <- t.head
            produces
                pure pi(sum2(h)) + pi(sum2(s))
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
