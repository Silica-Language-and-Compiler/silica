use trial_support_uint64;

fn main() -> uint64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint64@start();
        _: boolean <- trial_support_uint64@run(fn() -> uint64 {
            inner_tuple:(uint8, string) <- (1, "hello 😱");
            deep_inner_tuple:(float64, string) <- (2.0, "world 😱");
            a_tuple:((uint8, string), uint64) <- (inner_tuple, 123456789012345);
            _used_a_tuple:((uint8, string), uint64) <- a_tuple;
            deep_inner_tuple_2:((float64, string), string) <- (deep_inner_tuple, " fdaewq5432k 😱");
            b_tuple:(int64,((float64, string), string),string) <- (75, deep_inner_tuple_2, " fdaewq5432k 😱");
            _used_b_tuple:(int64,((float64, string), string),string) <- b_tuple;
            42
        });
        _: int64 <- wait_for_exit()
    produces
        pure 42
    end
}
