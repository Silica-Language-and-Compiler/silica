
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
            flags_and_children: (
                {
                    strategy: :one_for_one | :one_for_all | :rest_for_one,
                    allowed_restart_count: int64,
                    restarts_time_frame: int64
                },
                List[
                    {
                        id: atom,
                        agent_type: atom,
                        start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                        restart: :permanent | :temporary | :transient,
                        shutdown: int64,
                        flavor: :plain | :dangerous
                    },
                    mem(normal)
                ]
                ) <- (
                    { strategy: :one_for_all, allowed_restart_count: 10, restarts_time_frame: 60 },
                    [
                        {
                            id: :e4e_w1,
                            agent_type: :worker,
                            start: (0, worker),
                            restart: :permanent,
                            shutdown: 0,
                            flavor: :plain
                        }
                    ]
                ) produces
                pure flags_and_children
            end;
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
