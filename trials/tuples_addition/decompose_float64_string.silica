// Trial: decompose a (float64, string) tuple.
//
// main returns int64, not the decomposed string: `main` is the program entry
// symbol and its X0 return becomes the process exit status, so returning a
// string made the exit code the low byte of a descriptor pointer (128). The
// specification only ever gives main an int64/int/atom return; string was never
// a supported shape. The decomposition under test is unchanged -- the string is
// still bound and checked, just compared here rather than returned. Want 0.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            t: (float64, string) <- (2.0, "world");
            (_f: float64, s: string) <- t;
            case s == "world" of { true -> 0; false -> 1 }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
