
use trial_support_int64;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            (_flags, _children): (int64, int64) <- sequence
                flags_and_children: (int64, int64) <- (0, 0)
            produces
                pure flags_and_children
            end;
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
