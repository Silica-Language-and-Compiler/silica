// defect A4: tuple parameter after a scalar, both items used; pick(5, (3, 10)) = 18
use trial_support_int64;

fn pick(acc: int64, x: (int64, int64)) -> int64 {
    (a: int64, b: int64) <- x;
    acc + a + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            pick(5, (3, 10))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
