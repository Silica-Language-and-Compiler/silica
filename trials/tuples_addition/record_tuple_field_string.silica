// A pair with a string element as a record field value, read back and decomposed.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            labelled: { start: (int64, string) } <- { start: (5, "go") };
            st: (int64, string) <- labelled.start;
            (a: int64, b: string) <- st;
            a + length_bytes(b)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
