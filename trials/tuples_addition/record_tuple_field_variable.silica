// A tuple bound to a name and then used as a record field value: the field holds the tuple's pointer.
// This shape always worked; it pins the layout the tuple-literal field must now share.
use trial_support_int64;

fn make(x: int64) -> { start: (int64, int64), n: int64 } {
    st0: (int64, int64) <- (x, x + 1);
    { start: st0, n: 7 }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            labelled: { start: (int64, int64), n: int64 } <- make(5);
            st: (int64, int64) <- labelled.start;
            (a: int64, b: int64) <- st;
            a + b + labelled.n
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
