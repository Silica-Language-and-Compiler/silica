use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            packaged: (atom, List[int64, mem(normal)]) <- sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [0];
                tuple_out: ( atom, List[int64, mem(normal)] ) <- (:a, xs)
            produces
                pure tuple_out
            end;
            _used_packaged: (atom, List[int64, mem(normal)]) <- packaged;
            1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
