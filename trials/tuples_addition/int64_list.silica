use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            list: List[int64, mem(normal)] <- sequence proc[mem(normal)]
                xs: List[int64, mem(normal)] <- [1, 2, 3]
            produces
                pure xs
            end;
            _used_list: List[int64, mem(normal)] <- list;
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
