// Tuple with atom as first element and binary fn as second; call the fn for a concrete int64 result.
use trial_support_int64;

fn mul_fn(x: int64, y: int64) -> int64 {
    x * y
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            t: (atom, fn(x: int64, y: int64) -> int64) <- (:a, mul_fn);
            (_ag, f) <- t;
            f(6, 7)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
