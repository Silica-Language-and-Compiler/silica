// Trial: decompose a nested ((uint8, string), uint64) tuple, then decompose the
// inner tuple.
//
// main returns int64, not the decomposed string: `main` is the program entry
// symbol and its X0 return becomes the process exit status, so returning a
// string made the exit code the low byte of a descriptor pointer (128). The
// specification only ever gives main an int64/int/atom return; string was never
// a supported shape. Both decompositions under test are unchanged. Want 0.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            t: ((uint8, string), uint64) <- ((1, "hello"), 42);
            (inner: (uint8, string), n: uint64) <- t;
            _used_n: uint64 <- n;
            (b: uint8, s: string) <- inner;
            _used_b: uint8 <- b;
            case s == "hello" and b == 1 and n == 42 of { true -> 0; false -> 1 }
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
