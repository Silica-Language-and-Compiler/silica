use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            ret_list: List[int64, mem(normal)] <- sequence proc[mem(normal)]
                list: List[int64, mem(normal)] <- [0]
            produces
                pure list
            end;
            children: (int64, List[int64, mem(normal)]) <- (0, ret_list);
            (_flag, _a_list): (int64, List[int64, mem(normal)]) <- children;
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
