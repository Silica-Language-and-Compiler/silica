// A (float32, int64) tuple matched by case patterns and kept in a list reads each element from its
// own word. classify takes the tuple: (1.5, k) matches a float32 literal and binds the int64,
// (f, 7) binds the float32 and matches an int64 literal, (f, k) binds both. Each call's result is
// printed after it; the second and third arms print f first. Then the head of a
// List[(float32, int64)] is destructured and both elements printed. Before the fix the Mac
// printed 100, 6.25, 0, 8.75, 0 and then faulted (status 70).
// Expected output:
//   109            (1.5, 9): 9 + 100
//   6.25 / 200     (6.25, 7): prints f, 0 + 200
//   8.75 / 40      (8.75, 40): prints f, 0 + 40
//   9.5 / 1        list head
//   0
use trial_support_int64;

fn pf(x: float32) -> int64 {
    sequence proc[device_io]
        _: atom <- print_float32(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn pi(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn classify(t: (float32, int64)) -> int64 {
    case t of {
        (1.5, k: int64) -> k + 100;
        (f: float32, 7) -> pf(f) + 200;
        (f: float32, k: int64) -> pf(f) + k
    }
}

fn mk(x: float32, n: int64) -> (float32, int64) {
    (x, n)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                k1: int64 <- classify(mk(1.5, 9));
                _: int64 <- pi(k1);
                k2: int64 <- classify(mk(6.25, 7));
                _: int64 <- pi(k2);
                k3: int64 <- classify(mk(8.75, 40));
                _: int64 <- pi(k3);
                l: List[(float32, int64), mem(normal)] <- [mk(9.5, 1), mk(10.5, 2)];
                h: (float32, int64) <- l.head;
                (h1, h2): (float32, int64) <- h
            produces
                pure pf(h1) + pi(h2)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
