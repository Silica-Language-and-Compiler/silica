use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            list: List[int64,mem(normal)] <- sequence proc[mem(normal)]
                xs: List[int64,mem(normal)] <- [0]
            produces
                pure xs
            end;
            x: { start: (int64, List[int64,mem(normal)]), } <- { start: (0, list) };
            _used_x: { start: (int64, List[int64,mem(normal)]), } <- x;
            1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
