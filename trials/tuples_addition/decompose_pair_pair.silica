use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            nested_tuple: ((boolean, boolean), (boolean, boolean)) <- (
                (true, false),
                (true, true)
            );
            (inner1: (boolean, boolean), inner2: (boolean, boolean)) <- nested_tuple;
            _used_inner1: (boolean, boolean) <- inner1;
            _used_inner2: (boolean, boolean) <- inner2;
            :ok
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
