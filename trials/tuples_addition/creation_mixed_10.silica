use trial_support_uint8;

fn main() -> uint8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_uint8@start();
        _: boolean <- trial_support_uint8@run(fn() -> uint8 {
            t:(boolean, string, uint64, uint8, atom, int8, int16, int32, int64, float64) <- (true, "hi", 999, 42, :ok, -1, 100, 2000, 30000, 3.14);
            _used_t:(boolean, string, uint64, uint8, atom, int8, int16, int32, int64, float64) <- t;
            0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
