use trial_support_int8;

fn main() -> int8 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int8@start();
        _: boolean <- trial_support_int8@run(fn() -> int8 {
            sequence proc[device_io]
            t: (int64, (float64, string), string) <- (75, (2.0, "world"), "suffix");
            (n: int64, pair: (float64, string), s: string) <- t;
            _used_n: int64 <- n;
            _used_pair: (float64, string) <- pair;
            print_string(s);
            println("")
            produces pure :ok end;
            13
        });
        _: int64 <- wait_for_exit()
    produces
        pure 13
    end
}
