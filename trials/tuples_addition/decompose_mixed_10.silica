use trial_support_float64;

fn main() -> float64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float64@start();
        _: boolean <- trial_support_float64@run(fn() -> float64 {
            t: (boolean, string, uint64, uint8, atom, int8, int16, int32, int64, float64) <- (true, "hi", 999, 42, :ok, -1, 100, 2000, 30000, 3.14);
            (b: boolean, s: string, u: uint64, x: uint8, a: atom, i8: int8, i16: int16, i32: int32, i64: int64, f: float64) <- t;
            _used_b: boolean <- b;
            _used_s: string <- s;
            _used_u: uint64 <- u;
            _used_x: uint8 <- x;
            _used_a: atom <- a;
            _used_i8: int8 <- i8;
            _used_i16: int16 <- i16;
            _used_i32: int32 <- i32;
            _used_i64: int64 <- i64;
            f
        });
        _: int64 <- wait_for_exit()
    produces
        pure 3.140000000000000
    end
}
