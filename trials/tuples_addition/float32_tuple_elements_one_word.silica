// A float32 or float16 tuple element takes one word, like every other element, wherever it sits in
// the tuple. Six helpers return (float32, int64), (int64, float32), (float16, int64),
// (float32, int64, int64), (int64, float32, int64) and (int64, int64, float32); the caller
// destructures each result and prints every element in order. Before the fix the Mac printed
// 0.0000000 and 8 for (2.5, 5), 0.0 for the float16 0.5 and 0.0000000 for the leading 4.5.
// Expected output:
//   2.5 5 8 3.5 0.5 10 4.5 10 11 20 5.5 21 30 31 6.5 (one per line)
//   0
use trial_support_int64;

fn fa(x: float32, n: int64) -> (float32, int64) {
    (x, n + 1)
}

fn fb(n: int64, x: float32) -> (int64, float32) {
    (n + 2, x)
}

fn fh(x: float16, n: int64) -> (float16, int64) {
    (x, n + 3)
}

fn t1(x: float32) -> (float32, int64, int64) {
    (x, 10, 11)
}

fn t2(x: float32) -> (int64, float32, int64) {
    (20, x, 21)
}

fn t3(x: float32) -> (int64, int64, float32) {
    (30, 31, x)
}

fn pf(x: float32) -> int64 {
    sequence proc[device_io]
        _: atom <- print_float32(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn ph(x: float16) -> int64 {
    sequence proc[device_io]
        _: atom <- print_float16(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn pi(x: int64) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(x);
        _: atom <- println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                ra: (float32, int64) <- fa(2.5, 4);
                rb: (int64, float32) <- fb(6, 3.5);
                rh: (float16, int64) <- fh(0.5, 7);
                rp: (float32, int64, int64) <- t1(4.5);
                rq: (int64, float32, int64) <- t2(5.5);
                rs: (int64, int64, float32) <- t3(6.5);
                (a1, a2): (float32, int64) <- ra;
                (b1, b2): (int64, float32) <- rb;
                (h1, h2): (float16, int64) <- rh;
                (p1, p2, p3): (float32, int64, int64) <- rp;
                (q1, q2, q3): (int64, float32, int64) <- rq;
                (s1, s2, s3): (int64, int64, float32) <- rs
            produces
                pure pf(a1) + pi(a2) + pi(b1) + pf(b2) + ph(h1) + pi(h2) + pf(p1) + pi(p2) + pi(p3) + pi(q1) + pf(q2) + pi(q3) + pi(s1) + pi(s2) + pf(s3)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
