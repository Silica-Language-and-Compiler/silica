// defect A4: tuple parameter after a scalar; second_sum_step(5, (3, 10)) = 15
use trial_support_int64;

fn second_sum_step(acc: int64, x: (int64, int64)) -> int64 {
    (_: int64, b: int64) <- x;
    acc + b
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            second_sum_step(5, (3, 10))
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
