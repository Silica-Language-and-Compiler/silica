// Minimal repro: nested fn inside generic brackets for head[...]
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            child: {
                start: fn(msg: int64, state: int64) -> int64
            } <- { start: fn(msg: int64, state: int64) -> int64{ 0 } };
            0
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}

