// A let-bound tuple returned from a helper must survive the helper's frame. The let-level
// promote is retired, so `t <- (...); t` hands back a frame pointer; a second call in between
// reuses that frame and the values change. Companion to tuple_value_escapes_frame.
use trial_support_int64;

fn mk(a: int64, b: int64, c: int64) -> (int64, int64, int64) {
    t: (int64, int64, int64) <- (a, b, c);
    t
}
fn churn(n: int64) -> int64 {
    u: (int64, int64, int64) <- (n + 1, n + 2, n + 3);
    (x: int64, y: int64, z: int64) <- u;
    x + y + z
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                t: (int64, int64, int64) <- mk(10, 20, 30);
                _: int64 <- churn(7);
                (a: int64, b: int64, c: int64) <- t
            produces
                pure case a == 10 and b == 20 and c == 30 of { true -> 0; false -> 1 }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
