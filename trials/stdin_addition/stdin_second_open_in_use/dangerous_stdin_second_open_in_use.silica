// One reader of standard input: while the carrier is open, a second (:open, other, "") is answered
// (:link_down, :in_use) to that other actor and changes nothing. The owner opens the carrier, and on
// (:link_up, ...) has a second actor open it again; that actor prints the answer and then closes it.
module dangerous_stdin_second_open_in_use;

use wireframe;
use dangerous_console_stdin_carrier;

carried_on input: (:serial) (:stdin);

fn say(s: string) -> atom {
    sequence proc[device_io]
        o: atom <- println(s)
    produces
        pure o
    end
}

fn say_n(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces
        pure o
    end
}

fn say_atom(label: string, a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_atom(a);
        o: atom <- println("")
    produces
        pure o
    end
}

fn tell_credit(car: dangerous_actor_ref, n: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:credit, n) impl ActorMessage {})
    produces
        pure r
    end
}

fn tell_close(car: dangerous_actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, :close impl ActorMessage {})
    produces
        pure r
    end
}

fn stop(code: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast_exit(code)
    produces
        pure r
    end
}

fn tell_open(car: dangerous_actor_ref, who: actor_ref) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:open, who, "") impl ActorMessage {})
    produces
        pure r
    end
}

// The second opener: the carrier is up, so its (:open, ...) is answered (:link_down, :in_use) and
// changes nothing. It prints that answer and closes the carrier.
fn intruder(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom), car: dangerous_actor_ref) -> (:no_reply, dangerous_actor_ref) {
    case msg of {
        (:link_up, _i: string) -> (:no_reply, car);
        (:rx, _s: string) -> (:no_reply, car);
        (:tx_credit, _n: int64) -> (:no_reply, car);
        (:tx_failed, _w: atom) -> (:no_reply, car);
        (:link_down, why: atom) -> {
            _: atom <- say_atom("second open answered link_down ", why);
            _: boolean <- tell_close(car);
            (:no_reply, car)
        }
    }
}

// ---- the owner -----------------------------------------------------------------------------

fn on_line(line: string, st: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref }) -> { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } {
    _: atom <- say(concat("line: ", line));
    { car: st.car, rx: st.rx, lines: st.lines + 1, down: st.down, peer: st.peer }
}

// One segment can hold many lines: answer each, then ask again with "" until only a partial is left.
// seg is the segment the call that produced r was given ("" when draining); st.rx is the state it was
// given. A :too_large line is dropped through its newline (skip_line) and what follows is kept.
fn drain(r: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom), seg: string, st: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref }) -> { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } {
    case r of {
        (:more, rx1: { mode: atom, expected: int64, pending: string }) -> { car: st.car, rx: rx1, lines: st.lines, down: st.down, peer: st.peer };
        (:frame, line: string, rx2: { mode: atom, expected: int64, pending: string }) -> {
            st2: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } <- on_line(line, { car: st.car, rx: rx2, lines: st.lines, down: st.down, peer: st.peer });
            drain(wireframe@unframe(st2.rx, "", 4096), "", st2)
        };
        (:rejected, why: atom) -> {
            _: atom <- say_atom("line rejected: ", why);
            drain(wireframe@unframe(wireframe@skip_line(st.rx, seg), "", 4096), "", st)
        }
    }
}

// The chunk is de-tainted (recreate, in the owner's (:rx) arm) before it is framed: this takes the pure bytes.
// The segment is answered line by line first; only then is the next credit given, so the carrier
// reads the end of input after every line of this segment has been printed.
fn on_bytes(segment: string, st: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref }) -> { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } {
    st2: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } <- drain(wireframe@unframe(st.rx, segment, 4096), segment, st);
    _: boolean <- tell_credit(st2.car, 1);
    st2
}

// A rejected chunk is reported and dropped; the next credit lets the carrier go on.
fn on_recreated(r: (:ok, string) | (:rejected, atom), st: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref }) -> { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } {
    case r of {
        (:ok, data: string) -> on_bytes(data, st);
        (:rejected, why: atom) -> {
            _: atom <- say_atom("chunk rejected: ", why);
            _: boolean <- tell_credit(st.car, 1);
            st
        }
    }
}

// The carrier ends right after (:link_down, why): the reason is kept and the report is waited for.
fn on_link_down(why: atom, st: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref }) -> { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } {
    { car: st.car, rx: st.rx, lines: st.lines, down: why, peer: st.peer }
}

// The carrier has ended (its failure report reached the reporter, which told the owner): the last
// unterminated line, if any, then the summary, then the program ends.
fn on_ended(st: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref }) -> { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } {
    st2: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } <- case wireframe@finish(st.rx) of {
        (:frame, last: string) -> on_line(last, st);
        :empty -> st
    };
    _: atom <- say_atom("input ended: ", st2.down);
    _: atom <- say_n("lines read: ", st2.lines);
    _: boolean <- stop(0);
    st2
}

fn owner(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:carrier_ended, int64), state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref }) -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref }) {
    case msg of {
        (:link_up, info: string) -> {
            _: atom <- say(concat("link up: ", info));
            _: boolean <- tell_open(state.car, state.peer);
            (:no_reply, state)
        };
        (:rx, chunk: string) -> {
            sequence proc[transport]
                r: (:ok, string) | (:rejected, atom) <- recreate(chunk, { max_bytes: 65536 });
                st2: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, lines: int64, down: atom, peer: actor_ref } <- on_recreated(r, state)
            produces
                pure (:no_reply, st2)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> {
            (:no_reply, state)
        };
        (:link_down, why2: atom) -> (:no_reply, on_link_down(why2, state));
        (:carrier_ended, _k: int64) -> (:no_reply, on_ended(state))
    }
}

// The runtime links against region_dump_limit when a failure reporter is registered.
fn region_dump_limit() -> int64 {
    0
}

// The carrier's end reaches the failure reporter as a report (even a normal end); the reporter tells the
// owner by its registered name, so the owner's last output follows the runtime's own line about the
// carrier on stderr.
fn reporter(_report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: boolean <- cast_registered(:link_owner, (:carrier_ended, 1) impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :release_on_return), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        car: dangerous_actor_ref <- spawn_dangerous_carrier(input, stack_policy(0, :release_on_return), state_policy(:keep_state_area));
        intr: actor_ref <- spawn(car, intruder, stack_policy(0, :release_on_return), state_policy(:keep_state_area));
        rx0: { mode: atom, expected: int64, pending: string } <- wireframe@fresh(:lines);
        own: actor_ref <- spawn_registered({ car: car, rx: rx0, lines: 0, down: :none, peer: intr }, owner, :link_owner, stack_policy(0, :release_on_return), state_policy(:keep_state_area));
        _: boolean <- cast(car, (:open, own, "") impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
