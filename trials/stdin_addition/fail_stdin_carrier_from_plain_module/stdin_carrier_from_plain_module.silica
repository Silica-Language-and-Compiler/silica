// Must NOT compile (E4021): a module that uses a dangerous_* module (here the stdin carrier) must itself be a
// dangerous_ module. This one is named stdin_carrier_from_plain_module.
module stdin_carrier_from_plain_module;

use dangerous_console_stdin_carrier;

carried_on input: (:serial) (:stdin);

fn main() -> int64 {
    sequence proc[concurrency]
        car: dangerous_actor_ref <- spawn_dangerous_carrier(input, stack_policy(0, :release_on_return), state_policy(:keep_state_area))
    produces
        pure 0
    end
}
