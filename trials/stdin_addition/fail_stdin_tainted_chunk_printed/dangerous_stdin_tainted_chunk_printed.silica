// Must NOT compile: the owner prints the raw (:rx, chunk) of the dangerous stdin carrier. The chunk is
// external-danger-touched until recreate(chunk, { max_bytes: N }) re-creates it, so it may not be used in a
// sequence that declares device_io (the de-taint is the point of the owner's (:rx) arm).
module dangerous_stdin_tainted_chunk_printed;

use dangerous_console_stdin_carrier;

carried_on input: (:serial) (:stdin);

fn owner(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom), state: dangerous_actor_ref) -> (:no_reply, dangerous_actor_ref) {
    case msg of {
        (:link_up, _info: string) -> (:no_reply, state);
        (:rx, chunk: string) -> {
            sequence proc[device_io]
                _: atom <- println(chunk)
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

fn region_dump_limit() -> int64 {
    0
}

fn reporter(_report: string, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :release_on_return), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        car: dangerous_actor_ref <- spawn_dangerous_carrier(input, stack_policy(0, :release_on_return), state_policy(:keep_state_area));
        own: actor_ref <- spawn(car, owner, stack_policy(0, :release_on_return), state_policy(:keep_state_area));
        _: boolean <- cast(car, (:open, own, "") impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
