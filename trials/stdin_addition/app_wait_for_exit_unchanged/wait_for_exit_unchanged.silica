// Regression: a program WITHOUT a (:stdin) link still has standard input watched by wait_for_exit, and
// an `exit` line (the .stdin file) ends it with status 0. Nothing is spawned, so no failure reporter is
// registered.
module wait_for_exit_unchanged;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- println("waiting for exit");
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
