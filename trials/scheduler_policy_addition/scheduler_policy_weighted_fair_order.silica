// set_scheduler_policy(:weighted_fair): deficit round robin over the priority tiers with a unit cost
// per dispatch and quanta high 4, normal 2, low 1, FIFO within a tier. A round starts at the high
// tier: H runs 4 times (then has no mail and parks), N twice, L once; the high tier is empty, so N
// runs twice more (its last two), L once; then only L is left and it runs its last two, one per round:
// H H H H N N L N N L L L. Same setup as scheduler_policy_priority_fifo_order (all twelve messages
// queued on core 0 before anything runs). Shared golden compared as a multiset (hosted targets define
// no order), board golden in order.
// One behaviour for the three actors: the state is the actor's tag (0 low, 1 normal, 2 high) and
// every message prints one line, so the sequence of lines is the sequence of dispatches.
fn turn(msg: int64, tag: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        name: string <- case tag of { 0 -> "L"; 1 -> "N"; _: int64 -> "H" };
        println(concat("turn ", name))
    produces
        pure (:no_reply, tag)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        l: actor_ref <- spawn(0, turn, stack_policy(0, :keep_last_message));
        n: actor_ref <- spawn(1, turn, stack_policy(0, :keep_last_message));
        h: actor_ref <- spawn(2, turn, stack_policy(0, :keep_last_message));
        _: atom <- migrate_actor(l, 0);
        _: atom <- migrate_actor(n, 0);
        _: atom <- migrate_actor(h, 0);
        _: atom <- set_actor_priority(l, :low);
        _: atom <- set_actor_priority(n, :normal);
        _: atom <- set_actor_priority(h, :high);
        p: atom <- set_scheduler_policy(:weighted_fair);
        print_atom(p);
        println("");
        _: boolean <- cast(l, 1 impl ActorMessage {});
        _: boolean <- cast(n, 1 impl ActorMessage {});
        _: boolean <- cast(h, 1 impl ActorMessage {});
        _: boolean <- cast(l, 2 impl ActorMessage {});
        _: boolean <- cast(n, 2 impl ActorMessage {});
        _: boolean <- cast(h, 2 impl ActorMessage {});
        _: boolean <- cast(l, 3 impl ActorMessage {});
        _: boolean <- cast(n, 3 impl ActorMessage {});
        _: boolean <- cast(h, 3 impl ActorMessage {});
        _: boolean <- cast(l, 4 impl ActorMessage {});
        _: boolean <- cast(n, 4 impl ActorMessage {});
        _: boolean <- cast(h, 4 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
