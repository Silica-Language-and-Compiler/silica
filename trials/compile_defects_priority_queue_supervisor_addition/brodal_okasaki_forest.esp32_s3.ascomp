.macro XADDR r, off
.if ((\off) >= -128) && ((\off) <= 127)
addi \r, a1, \off
.else
movi \r, \off
add \r, \r, a1
.endif
.endm
.macro XL32 r, off
.if ((\off) >= 0) && ((\off) <= 1020)
l32i \r, a1, \off
.else
movi \r, \off
add \r, \r, a1
l32i \r, \r, 0
.endif
.endm
.macro XS32 r, off, t
.if ((\off) >= 0) && ((\off) <= 1020)
s32i \r, a1, \off
.else
movi \t, \off
add \t, \t, a1
s32i \r, \t, 0
.endif
.endm
.macro XL16U r, off
.if ((\off) >= 0) && ((\off) <= 510)
l16ui \r, a1, \off
.else
movi \r, \off
add \r, \r, a1
l16ui \r, \r, 0
.endif
.endm
.macro XL16S r, off
.if ((\off) >= 0) && ((\off) <= 510)
l16si \r, a1, \off
.else
movi \r, \off
add \r, \r, a1
l16si \r, \r, 0
.endif
.endm
.macro XS16 r, off, t
.if ((\off) >= 0) && ((\off) <= 510)
s16i \r, a1, \off
.else
movi \t, \off
add \t, \t, a1
s16i \r, \t, 0
.endif
.endm
.macro XL8U r, off
.if ((\off) >= 0) && ((\off) <= 255)
l8ui \r, a1, \off
.else
movi \r, \off
add \r, \r, a1
l8ui \r, \r, 0
.endif
.endm
.macro XS8 r, off, t
.if ((\off) >= 0) && ((\off) <= 255)
s8i \r, a1, \off
.else
movi \t, \off
add \t, \t, a1
s8i \r, \t, 0
.endif
.endm
