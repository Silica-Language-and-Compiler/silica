.endm
.macro XL8U r, off
.if ((\off) >= 0) && ((\off) <= 255)
l8ui \r, a1, \off
.else
movi \r, \off
add \r, \r, a1
l8ui \r, \r, 0
.endif
.endm
.macro XS8 r, off, t
.if ((\off) >= 0) && ((\off) <= 255)
s8i \r, a1, \off
.else
movi \t, \off
add \t, \t, a1
s8i \r, \t, 0
.endif
.endm
