fn count(xs: List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> count(xs.tail, acc + 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal), device_io]
                xs: List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] <- table();
                n: int64 <- count(xs, 0);
                last: { name: atom, offset: uint64, width: uint64, access: atom } <- list_at[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)](xs, 399);
                second: { name: atom, offset: uint64, width: uint64, access: atom } <- list_at[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)](xs, 1);
                print_int64(n);
                println("");
                print_uint64(last.offset);
                println("");
                print_uint64(second.width);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
