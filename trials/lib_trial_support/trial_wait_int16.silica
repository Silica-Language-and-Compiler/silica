// Trial support (actor_memory_budget_plan.md item M), generated by
// programmer_tools/trial_shape_m/gen_support.py: the supervisor-actor shape for
// a trial whose work starts actors that print and then waits for the `exit` line. main
// starts the supervisor, casts the work to its one worker and waits; the worker runs the
// work and returns.

use Supervisor;

impl TrialWaitInt16Supervisor for Supervisor;

export start/0;
export run/1;

fn worker(msg: fn() -> int16, state: int64) -> (:no_reply, int64) {
    _: int16 <- msg();
    (:no_reply, state)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: fn() -> int16, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 1 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: fn() -> int16, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :trial_worker, agent_type: :worker, initial_state: initial_state, behavior: worker, restart: :transient, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

// Starts and registers the FailureReporter, then starts the supervisor and its worker.
fn start() -> supervisor_ref {
    sequence proc[concurrency]
        _: atom <- start_reporter();
        sup: supervisor_ref <- spawn_registered_supervisor(TrialWaitInt16Supervisor, 0, :trial_supervisor, stack_policy(0, :keep_last_message))
    produces
        pure sup
    end
}

// Casts the trial's work to the worker.
fn run(work: fn() -> int16) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast_registered(:trial_worker, work impl ActorMessage {})
    produces
        pure sent
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
