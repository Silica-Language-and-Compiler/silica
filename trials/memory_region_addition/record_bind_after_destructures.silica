// In a sequence that binds six allocated refs, binding a record whose fields include a
// function value (`t <- record_of(big)`) AFTER those bindings must not disturb the earlier
// refs. Found while writing binary_tree_core/bt_validate (count_cases); fixed 2026-09-18 by the same
// frame change as functions_addition/param_after_record_lets_kept: a callee's int64 entry-shadow
// registers now count toward its callee-saved save pairs, so it no longer destroys the caller's X21
// (`zero` read back as outside its arena, 1011 was printed). `without_record` is the control.
// Chunk 15 phase 2 retired ref_in_region (P7). The check keeps its shape (a holder record carrying
// a key, a ref? case, a callee that reads through the ref) but each probe now reads
// the node's count field back and compares it with the count the cell was built with (holder.key),
// so a clobbered `zero` / `neg` / `big` / `small` still shows as a 0 digit: the four digits are
// neg (count -5), zero (0), big (7) and small (2).
// Chunk 15 phase 5 (5b): the cells are allocated with the region-less alloc_rec (design §8.1), so
// `cell` returns the ref? alone and no region handle is threaded; `t` is read through its root.
// Expected output: 1111 and 1111, then exit 0.

use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cell(
    v: int64,
    count: int64,
    left: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec((v, count, left, right))
    produces
        pure c
    end
}

fn inside_ref(
    holder: { key: int64 },
    node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> int64 {
    sequence proc[mem(normal)]
        node: (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_: int64, cnt: int64, _: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure case cnt == holder.key of { true -> 1; false -> 0 }
    end
}

fn inside(
    node: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    want: int64
) -> int64 {
    holder: { key: int64 } <- { key: want };
    case node of {
        :none -> 9;
        node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> inside_ref(holder, node_ref)
    }
}

fn record_of(
    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    specialization_key: int64
} {
    out: {
        root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64
    } <- { root: root, compare_item: cmp_i64, specialization_key: 0 };
    out
}

fn with_record() -> int64 {
    sequence
        neg: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, -5, :none, :none);
        zero: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 0, :none, :none);
        l1: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(2, 1, :none, :none);
        l2: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(3, 1, :none, :none);
        big: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 7, l1, l2);
        small: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 2, l1, l2);
        t: {
            root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64
        } <- record_of(big);
        a: int64 <- inside(neg, -5);
        b: int64 <- inside(zero, 0);
        c: int64 <- inside(t.root, 7);
        d: int64 <- inside(small, 2)
    produces
        pure a * 1000 + b * 100 + c * 10 + d
    end
}

fn without_record() -> int64 {
    sequence
        neg: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, -5, :none, :none);
        zero: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 0, :none, :none);
        l1: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(2, 1, :none, :none);
        l2: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(3, 1, :none, :none);
        big: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 7, l1, l2);
        small: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- cell(1, 2, l1, l2);
        a: int64 <- inside(neg, -5);
        b: int64 <- inside(zero, 0);
        c: int64 <- inside(big, 7);
        d: int64 <- inside(small, 2)
    produces
        pure a * 1000 + b * 100 + c * 10 + d
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                w: int64 <- with_record();
                wo: int64 <- without_record();
                println("with_record (expected 1111)");
                print_int64(w);
                println("");
                println("without_record (expected 1111)");
                print_int64(wo);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
