// Trial: a region MOVED INTO a function that does not return it is owned by the
// callee, and is cleaned up there.
//
// silica-specification §3.247: "Region handles are move-only; they cannot be
// copied. When a region handle is passed to any function, ownership transfers
// (the handle is moved)."
//
// consume() takes the region, allocates 1.6 MB into it, and returns only an
// int64 -- the handle is never handed back, so ownership ends inside consume()
// and the region must be released there. The caller must NOT also release it:
// a double free is as much a failure as a leak.
//
// Sizing: 2000 iterations x 1.6 MB = 3.2 GB if the region is leaked, so a
// regression is fatal rather than cosmetic. Want 0.

// NOTE: the lifetime is written L1, not a generic R. The type checker compares
// type surfaces literally and does not unify lifetime variables, so a parameter
// declared region(R, normal) fails E2003 against a caller's region(L1, normal).
use trial_support_int64;

fn consume(r: region(L1, normal), n: int64) -> int64 {
    sequence proc[mem(normal)]
        cell: ref(L1, normal, int64) <- alloc_ref(r, n);
        pad: buf(L1, normal, int64, 200000) <- alloc_buf(r, 200000)
    produces
        pure read_ref(cell)
    end
}

fn move_one(n: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        v: int64 <- consume(r, n)
    produces
        pure v
    end
}

fn loop_move(i: int64, acc: int64) -> int64 {
    case i <= 0 of {
        true -> acc;
        false -> loop_move(i - 1, acc + move_one(i))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                total: int64 <- loop_move(2000, 0)
            produces
                pure case total == 2001000 of { true -> 0; false -> 1 }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
