// Recursive tuples (§4.2.2): the optional reference with its tuple element spelled out,
// ref?(L, normal, (atom, int64, ref?(L, normal, rec))), is the same type as ref?(L, normal, rec)
// when rec is that tuple: an actor state field of the spelled type is passed to alloc_rec's
// ref?(L, normal, rec) slot. Formerly project-bees SD-4 (compile_defects_ref_opt_spelled_type_addition,
// E2003 "field has type ref?(L,normal,(atom,...)), expected ref?(L, normal, rec)").
// Expected: exit 0.

use trial_support_int64;

fn beh(msg: int64, state: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }) -> (:no_reply, { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }) {
    sequence proc[mem(normal)]
        cell: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(state.r, (:ok, msg, state.root))
    produces pure (:no_reply, { r: state.r, root: :none }) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                a: actor_ref <- spawn({ r: r, root: :none }, beh, stack_policy(0, :keep_last_message));
                _: boolean <- cast(a, 5 impl ActorMessage {})
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
