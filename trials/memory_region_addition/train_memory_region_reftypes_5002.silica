// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: alloc_ref with element type boolean
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                flag: ref(L1, normal, boolean) <- alloc_ref(r, true);
                v: boolean <- read_ref(flag)
            produces
                pure case v of { true -> 1; false -> 0 }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
