// Chunk 15 phase 2 (P1): the region-less form alloc_buf(n). A buf(L1, normal, int64, 4) is allocated
// in the function's frame (zero-filled), written at every index and read back; the sum is 100 and
// index 3 holds 40. Expected: 100, 40, then status 0.
//   100
//   40
//   0

fn fill() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        bf: buf(L1, normal, int64, 4) <- alloc_buf(4);
        _: atom <- write_buf(bf, 0, 10);
        _: atom <- write_buf(bf, 1, 20);
        _: atom <- write_buf(bf, 2, 30);
        _: atom <- write_buf(bf, 3, 40);
        a: int64 <- read_buf(bf, 0);
        b: int64 <- read_buf(bf, 1);
        c: int64 <- read_buf(bf, 2);
        d: int64 <- read_buf(bf, 3)
    produces
        pure a + b + c + d
    end
}

fn last() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        bf: buf(L1, normal, int64, 4) <- alloc_buf(4);
        _: atom <- write_buf(bf, 3, 40);
        d: int64 <- read_buf(bf, 3)
    produces
        pure d
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- fill();
        print_int64(a);
        println("");
        b: int64 <- last();
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
