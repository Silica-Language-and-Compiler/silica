// Chunk 15 phase 2 (S5): a tail call (SIR kind 5) whose argument names a node of the frame being
// replaced. grow binds t <- concat(s, "x") (a frame block) and tail-calls grow(n - 1, t); the callee
// reads the string the previous iteration built. grow(3, "a") = "axxx". Expected: axxx, 4, then 0.
//   axxx
//   4
//   0

fn grow(n: int64, s: string) -> string {
    case n == 0 of {
        true -> s;
        false -> {
            t: string <- concat(s, "x");
            grow(n - 1, t)
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        r: string <- grow(3, "a");
        println(r);
        print_int64(length_bytes(r));
        println("")
    produces
        pure 0
    end
}
