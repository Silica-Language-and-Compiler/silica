// Trial (chunk 15 phase 1; spec §12.1.4; region_memory_safety_design.md §5, Q10 option A): the lifetime
// names of a signature are that function's own variables, instantiated at each call consistently across
// the arguments and the result. `put` and `get` are written over R; the caller's lifetime is L1. At each
// call R := L1 is bound from the region (or ref) argument and applied to the declared result
// (region(R, normal), ref(R, normal, int64)), which the caller destructures as L1 values. Before phase 1
// a callee had to spell its caller's lifetime name (the trials used L1 for that reason).
// Expected: get(a) + get(b) = 7 + 35, exit 42.

use trial_support_int64;

fn put(r: region(R, normal), v: int64) -> (region(R, normal), ref(R, normal, int64)) {
    sequence proc[mem(normal)]
        c: ref(R, normal, int64) <- alloc_ref(r, v)
    produces
        pure (r, c)
    end
}

fn get(c: ref(R, normal, int64)) -> int64 {
    sequence proc[mem(normal)]
        v: int64 <- read_ref(c)
    produces
        pure v
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r0: region(L1, normal) <- alloc_region(normal);
                (r1: region(L1, normal), a: ref(L1, normal, int64)) <- put(r0, 7);
                (_r2: region(L1, normal), b: ref(L1, normal, int64)) <- put(r1, 35);
                x: int64 <- get(a);
                y: int64 <- get(b)
            produces
                pure x + y
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
