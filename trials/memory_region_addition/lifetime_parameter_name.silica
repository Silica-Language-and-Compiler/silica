// Spec §12.1.4: a lifetime named in a function signature is a polymorphic parameter ("functions may take
// `L: lifetime` as a parameter for polymorphism"), a binder local to that signature, like a value parameter
// name. A function written with `ref(L, normal, int64)` therefore accepts an argument whose region was created
// under any lifetime name; here the caller's lifetime is `L1`. Until 2026-09-24 the type checker compared the
// lifetime identifier's source spelling and rejected the call with E2003 "type mismatch: x"; ref, ref?,
// region, buf and atomic_ref arguments are now compared modulo the lifetime binder, matched by position.
// Formerly compile_defects_lifetime_parameter_name_addition.
// Expected: reads back 42, exit 42.

use trial_support_int64;

fn leg_length(leg: ref(L, normal, int64)) -> int64 {
    sequence proc[mem(normal)]
        v: int64 <- read_ref(leg)
    produces
        pure v
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                x: ref(L1, normal, int64) <- alloc_ref(r, 42)
            produces
                pure leg_length(x)
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
