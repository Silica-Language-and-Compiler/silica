// Chunk 15 phase 2 (S6, L_str_forget cache rule): concat results reused across many iterations next to
// substring. The substring caches are one process-wide block keyed by string address; a concat result
// in a frame is overwritten by the next iteration's result at the same address, so every evacuation
// and every reuse must forget the cache entry (L_str_forget). Each iteration builds "abcd", slices
// "bc" out of it and counts the matches; 300 iterations. Then substring_until_char on a second
// reused string. Expected: 300, 300, then status 0.
//   300
//   300
//   0

fn count_sub(i: int64, acc: int64) -> int64 {
    case i == 0 of {
        true -> acc;
        false -> {
            s: string <- concat("ab", "cd");
            u: string <- substring(s, 1, 3);
            k: int64 <- case u == "bc" of { true -> 1; false -> 0 };
            count_sub(i - 1, acc + k)
        }
    }
}

fn count_until(i: int64, acc: int64) -> int64 {
    case i == 0 of {
        true -> acc;
        false -> {
            s: string <- concat("ab cd", " ef");
            u: string <- substring_until_char(s, 0, ' ');
            k: int64 <- case u == "ab" of { true -> 1; false -> 0 };
            count_until(i - 1, acc + k)
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        print_int64(count_sub(300, 0));
        println("");
        print_int64(count_until(300, 0));
        println("")
    produces
        pure 0
    end
}
