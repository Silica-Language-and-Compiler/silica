// Chunk 15 phase 2 (S4/S6): a list built in the innermost frame of a return-position chain
// (f -> g -> h). The cons blocks (handle and chunk) are frame blocks of the callee that h's caller
// adopts. h(3) builds [3, 4, 5]. Expected: sum 12, length 3, head 3, then status 0.
//   12
//   3
//   3
//   0

fn cons_int(x: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn nil_int() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure r
    end
}

fn h(x: int64) -> List[int64, mem(normal)] {
    c: List[int64, mem(normal)] <- cons_int(x + 2, nil_int());
    b: List[int64, mem(normal)] <- cons_int(x + 1, c);
    cons_int(x, b)
}

fn g(x: int64) -> List[int64, mem(normal)] {
    h(x)
}

fn f(x: int64) -> List[int64, mem(normal)] {
    g(x)
}

fn sum_list(l: List[int64, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[int64, mem(normal)](l)
    produces
        pure case n == 0 of {
            true -> 0;
            false -> l.head + sum_list(l.tail)
        }
    end
}

fn main() -> int64 {
    sequence proc[device_io, mem(normal)]
        l: List[int64, mem(normal)] <- f(3);
        total: int64 <- sum_list(l);
        print_int64(total);
        println("");
        len: int64 <- length[int64, mem(normal)](l);
        print_int64(len);
        println("");
        first: int64 <- l.head;
        print_int64(first);
        println("")
    produces
        pure 0
    end
}
