// Trial: regions allocated in a scope that does NOT return them must be released
// at scope exit (each scope holds a 1.6 MB buffer, so a leak is fatal, not cosmetic) (silica-specification §12.1.2: "when a sequence block exits, all
// regions allocated within that scope are deallocated", and "a region is *not*
// deallocated when a region reference is returned").
//
// alloc_one allocates a region + ref and returns only an int64, so nothing can
// escape. Calling it repeatedly must not grow memory: if scope-exit release
// regresses, this loop accumulates one region per iteration.
// Phase A (single scope) per §12.1.4. Want 0.

use trial_support_int64;

fn alloc_one(n: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        cell: ref(L1, normal, int64) <- alloc_ref(r, n);
        pad: buf(L1, normal, int64, 200000) <- alloc_buf(r, 200000)
    produces
        pure n
    end
}

fn loop_alloc(i: int64, acc: int64) -> int64 {
    case i <= 0 of {
        true -> acc;
        false -> loop_alloc(i - 1, acc + alloc_one(i))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                total: int64 <- loop_alloc(2000, 0)
            produces
                pure case total == 2001000 of { true -> 0; false -> 1 }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
