// Chunk 15 phase 2 (P1): the region-less form alloc_ref(v). The lifetime and the memory space come
// from the binding's annotation (spec §12.1.4 style), the cell lives in the calling function's frame.
// boxed(v) allocates a cell holding v, reads it back and adds one. Expected: 8, -4, then status 0.
//   8
//   -4
//   0

fn boxed(v: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        c: ref(L1, normal, int64) <- alloc_ref(v);
        back: int64 <- read_ref(c)
    produces
        pure back + 1
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- boxed(7);
        print_int64(a);
        println("");
        b: int64 <- boxed(0 - 5);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
