// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: atomic region needs both mem(atomic) and the atomic effect
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(atomic), atomic]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, atomic) <- alloc_region(atomic);
                counter: ref(L1, atomic, int64) <- alloc_ref(r, 47);
                value: int64 <- read_ref(counter)
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
