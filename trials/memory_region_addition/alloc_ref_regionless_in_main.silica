// Chunk 15 phase 2 (P1): alloc_ref(v) directly in main's own sequence (main's frame is the frame the
// cell lives in; main runs on the OS stack, design §13 item 11). The cell is written and read back.
// Expected: 41, 42, then status 0.
//   41
//   42
//   0

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        L1: lifetime <- fresh_lifetime();
        c: ref(L1, normal, int64) <- alloc_ref(41);
        first: int64 <- read_ref(c);
        _: atom <- write_ref(c, 42);
        second: int64 <- read_ref(c);
        print_int64(first);
        println("");
        print_int64(second);
        println("")
    produces
        pure 0
    end
}
