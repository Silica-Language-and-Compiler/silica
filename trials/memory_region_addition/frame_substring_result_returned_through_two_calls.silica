// Chunk 15 phase 2 (S7, frame substring blocks): a substring result longer than one byte returned
// through two calls, then compared afterwards. Both helpers are covered: substring and
// substring_until_char. mid(s) = substring(s, 2, 5) of "abcdefgh ij" = "cde"; first_word(s) =
// substring_until_char(s, 0, ' ') = "abcdefgh". outer calls are in return position (adopted); the
// results are compared with literals after a call that overwrites the stack below them.
// Expected: cde, abcdefgh, 1, 1, then status 0.
//   cde
//   abcdefgh
//   1
//   1
//   0

fn mid_inner(s: string) -> string {
    substring(s, 2, 5)
}

fn mid(s: string) -> string {
    mid_inner(s)
}

fn first_word_inner(s: string) -> string {
    substring_until_char(s, 0, ' ')
}

fn first_word(s: string) -> string {
    first_word_inner(s)
}

fn scrub(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            pad: string <- concat("zz", "yy");
            length_bytes(pad) + scrub(n - 1)
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        s: string <- concat("abcdefgh", " ij");
        a: string <- mid(s);
        b: string <- first_word(s);
        junk: int64 <- scrub(20);
        println(a);
        println(b);
        eq_a: int64 <- case a == "cde" of { true -> 1; false -> 0 };
        eq_b: int64 <- case b == "abcdefgh" of { true -> 1; false -> 0 };
        print_int64(eq_a);
        println("");
        print_int64(eq_b);
        println("")
    produces
        pure 0
    end
}
