// Recursive tuples (§4.2.2): a sequence binding annotated with the optional reference, its recursive
// tuple spelled out, ref?(L, normal, (atom, int64, ref?(L, normal, rec))), bound from alloc_rec (a
// ref is a ref?) and matched with :none / ref patterns. Formerly project-bees SD-5 (the binding did
// not parse: E1040, E1069 with the tuple spelled out). The bare form `cell: ref?(L, normal, rec)` has
// no enclosing tuple for `rec` (§4.2.2: rec is valid only inside a tuple type) and is rejected with
// E2010; see compile_defects_ref_opt_binding_annotation_addition/README.md.
// Expected: exit 2.

use trial_support_int64;

fn value_of(c: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> int64 {
    sequence proc[mem(normal)]
        node: (atom, int64, ref?(L, normal, rec)) <- read_ref(c);
        (_: atom, v: int64, _: ref?(L, normal, (atom, int64, ref?(L, normal, rec)))) <- node
    produces pure v end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- alloc_region(normal);
                c0: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, 1, :none));
                cell: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, 2, c0));
                n: int64 <- case cell of { :none -> 0; c: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> value_of(c) }
            produces pure n end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
