// Chunk 15 phase 2 (S6 evacuation): a non-adopting caller (main) calls a function that returns a list
// built in its frame, in a loop of 3000 iterations. Each call's result is evacuated into main's frame
// (and the callee's region dropped), the loop is a tail call that keeps only the running sum, so the
// frame growth stays bounded on the 8 MB OS stack. mk(i) = [i, i + 1]; the sum of the heads over
// i = 1..3000 is 3000 * 3001 / 2 = 4501500. Expected: 4501500, then status 0.
//   4501500
//   0

fn cons_int(x: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn nil_int() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure r
    end
}

fn mk(i: int64) -> List[int64, mem(normal)] {
    top: List[int64, mem(normal)] <- cons_int(i + 1, nil_int());
    cons_int(i, top)
}

fn run_loop(i: int64, acc: int64) -> int64 {
    case i == 0 of {
        true -> acc;
        false -> {
            l: List[int64, mem(normal)] <- mk(i);
            run_loop(i - 1, acc + l.head)
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        total: int64 <- run_loop(3000, 0);
        print_int64(total);
        println("")
    produces
        pure 0
    end
}
