// Trial: grow a runtime-sized region buffer by allocating a fresh region,
// copying live contents, and returning the new region-backed record.
// Step 0.2 for standard data structures: functional region grow/copy pattern.

use trial_support_int64;

fn grow_copy(
    old_capacity: int64,
    old_values: buf(L1, normal, int64, old_capacity),
    new_capacity: int64
) -> {
    region: region(L2, normal),
    capacity: int64,
    values: buf(L2, normal, int64, new_capacity)
} {
    sequence proc[mem(normal)]
        new_capacity_saved: int64 <- new_capacity;
        L2: lifetime <- fresh_lifetime();
        r2: region(L2, normal) <- alloc_region(normal);
        new_values: buf(L2, normal, int64, new_capacity) <- alloc_buf(r2, new_capacity_saved);
        v0: int64 <- read_buf(old_values, 0);
        v1: int64 <- read_buf(old_values, 1);
        last_old_index: int64 <- old_capacity - 1;
        v2: int64 <- read_buf(old_values, last_old_index);
        _: atom <- write_buf(new_values, 0, v0);
        _: atom <- write_buf(new_values, 1, v1);
        _: atom <- write_buf(new_values, 2, v2);
        grown: {
            region: region(L2, normal),
            capacity: int64,
            values: buf(L2, normal, int64, new_capacity)
        } <- {
            region: r2,
            capacity: new_capacity_saved,
            values: new_values
        }
    produces
        pure grown
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r1: region(L1, normal) <- alloc_region(normal);
                old_capacity: int64 <- 3;
                new_capacity: int64 <- 6;
                old_values: buf(L1, normal, int64, old_capacity) <- alloc_buf(r1, old_capacity);
                _: atom <- write_buf(old_values, 0, 11);
                _: atom <- write_buf(old_values, 1, 22);
                _: atom <- write_buf(old_values, 2, 33);
                grown: {
                    region: region(L2, normal),
                    capacity: int64,
                    values: buf(L2, normal, int64, new_capacity)
                } <- grow_copy(old_capacity, old_values, new_capacity);
                c0: int64 <- read_buf(grown.values, 0);
                c1: int64 <- read_buf(grown.values, 1);
                c2: int64 <- read_buf(grown.values, 2)
            produces
                pure c0 + c1 + c2 + grown.capacity
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
