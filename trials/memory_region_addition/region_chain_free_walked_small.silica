// SMALL VARIANT of region_chain_free_walked.silica for targets with a ~64 KB heap: buffers of 500 int64 and 200 iterations instead of 200000 and 2000.
// A leak is still fatal there (200 iterations x at least 3 KB cannot fit); the checked logic is unchanged.
// Trial: a region that GREW must have its whole extension chain freed at scope exit.
//
// A region is a 4128-byte pool; an allocation that does not fit triggers
// L_region_grow, which mallocs another block and links it onto the chain at
// [base+16]. Each buffer below is 500 * 8 = 1.6 MB, far over the 4096
// growth threshold, so each forces a fresh extension block -- the region ends up
// with a chain of several blocks rather than a single one.
//
// grow_and_drop returns only int64, so per silica-specification 12.1.2 nothing
// escapes and the region plus every block on its chain must be released at scope
// exit. Freeing only the root (not walking [base+16]) leaks the extensions, which
// this loop accumulates. Phase A, single scope, per 12.1.4. Want 0.

use trial_support_int64;

fn grow_and_drop(n: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        b1: buf(L1, normal, int64, 500) <- alloc_buf(r, 500);
        b2: buf(L1, normal, int64, 500) <- alloc_buf(r, 500);
        b3: buf(L1, normal, int64, 500) <- alloc_buf(r, 500)
    produces
        pure n
    end
}

fn loop_grow(i: int64, acc: int64) -> int64 {
    case i <= 0 of {
        true -> acc;
        false -> loop_grow(i - 1, acc + grow_and_drop(1))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence
                total: int64 <- loop_grow(200, 0)
            produces
                pure case total == 200 of { true -> 0; false -> 1 }
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
