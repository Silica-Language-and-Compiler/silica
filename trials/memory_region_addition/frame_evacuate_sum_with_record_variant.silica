// Chunk 15 phase 2 (S6, design §3.5): a non-return-position call whose result is a sum with a record
// variant, `:none | { id, name }`, the record built in the callee's frame with a concat string.
// The evacuation copies the boxed record and its string. Expected: 7, 3, 0, 0, then status 0
// (id, name length, then the :none case).
//   7
//   3
//   0
//   0
//   0

fn describe(r: :none | { id: uint32, name: string }) -> int64 {
    case r of {
        { id: i, name: n } -> length_bytes(n);
        :none -> 0
    }
}

fn ident(r: :none | { id: uint32, name: string }) -> uint32 {
    case r of {
        { id: i, name: n } -> i;
        :none -> 0
    }
}

fn tagged(v: uint32) -> :none | { id: uint32, name: string } {
    s: string <- concat("ab", "c");
    { id: v, name: s }
}

fn absent() -> :none | { id: uint32, name: string } {
    :none
}

fn main() -> int64 {
    sequence proc[device_io]
        seven: uint32 <- 7;
        r: :none | { id: uint32, name: string } <- tagged(seven);
        n: :none | { id: uint32, name: string } <- absent();
        a: atom <- print_uint32(ident(r));
        println("");
        print_int64(describe(r));
        println("");
        b: atom <- print_uint32(ident(n));
        println("");
        print_int64(describe(n));
        println("")
    produces
        pure 0
    end
}
