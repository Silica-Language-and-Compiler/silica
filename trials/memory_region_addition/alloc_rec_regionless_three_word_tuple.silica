// Chunk 15 phase 2 (P1): alloc_rec(v) of a three-word recursive tuple, read back word by word. The
// first frame implementation copied two of the three words (it sized the payload from a two-word
// tuple); this trial reads every word of both cells: first = (11, 22, next-pointer to second), second =
// (40, 50, :none). The result packs x*100000000 + y*1000000 + z*10000 + w*100 + flag, where flag is 1
// when first's third word is a ref (it points at second) and 0 for :none.
// 11*10^8 + 22*10^6 + 40*10^4 + 50*10^2 + 1 = 1122405001.
// Expected: 1122405001, then status 0.
//   1122405001
//   0

fn words() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        nothing: ref?(L1, normal, (int64, int64, ref?(L1, normal, rec))) <- :none;
        second: ref(L1, normal, (int64, int64, ref?(L1, normal, rec))) <- alloc_rec((40, 50, nothing));
        first: ref(L1, normal, (int64, int64, ref?(L1, normal, rec))) <- alloc_rec((11, 22, second));
        w1: (int64, int64, ref?(L1, normal, rec)) <- read_ref(first);
        (x: int64, y: int64, next_ref: ref?(L1, normal, (int64, int64, ref?(L1, normal, rec)))) <- w1;
        w2: (int64, int64, ref?(L1, normal, rec)) <- read_ref(second);
        (z: int64, w: int64, _: ref?(L1, normal, (int64, int64, ref?(L1, normal, rec)))) <- w2;
        flag: int64 <- case next_ref of {
            :none -> 0;
            _: ref(L1, normal, (int64, int64, ref?(L1, normal, rec))) -> 1
        }
    produces
        pure x * 100000000 + y * 1000000 + z * 10000 + w * 100 + flag
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        v: int64 <- words();
        print_int64(v);
        println("")
    produces
        pure 0
    end
}
