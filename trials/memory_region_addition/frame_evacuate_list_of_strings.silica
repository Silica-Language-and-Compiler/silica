// Chunk 15 phase 2 (S6, design §3.5): a non-return-position call whose result is a list of strings.
// words builds two concat results in its frame and conses them; the list handle, the chunk and both
// string blocks are copied to the caller's frame by the evacuation. Expected: ab, cd, abcd, then 0.
//   ab
//   cd
//   abcd
//   0

fn cons_str(x: string, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[string, mem(normal)] <- prepend[string, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn nil_str() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure r
    end
}

fn words() -> List[string, mem(normal)] {
    a: string <- concat("a", "b");
    c: string <- concat("c", "d");
    cons_str(a, cons_str(c, nil_str()))
}

fn main() -> int64 {
    sequence proc[device_io]
        l: List[string, mem(normal)] <- words();
        println(l.head);
        println(l.tail.head);
        println(concat(l.head, l.tail.head))
    produces
        pure 0
    end
}
