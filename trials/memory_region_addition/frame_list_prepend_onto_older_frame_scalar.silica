// Chunk 15 phase 2 (S6, free-slot rule): prepending a scalar to a list owned by an OLDER frame. The
// base list [10] is built in main; extend() conses 20 onto it in its own frame. The base must stay
// unchanged (copy on write) and the extended list must read [20, 10]. Expected: 10, 1, 20, 2, 10, 0.
//   10
//   1
//   20
//   2
//   10
//   0

fn cons_int(x: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn nil_int() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure r
    end
}

fn extend(base: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    cons_int(20, base)
}

fn main() -> int64 {
    sequence proc[device_io, mem(normal)]
        base: List[int64, mem(normal)] <- cons_int(10, nil_int());
        ext: List[int64, mem(normal)] <- extend(base);
        bh: int64 <- base.head;
        print_int64(bh);
        println("");
        bl: int64 <- length[int64, mem(normal)](base);
        print_int64(bl);
        println("");
        eh: int64 <- ext.head;
        print_int64(eh);
        println("");
        el: int64 <- length[int64, mem(normal)](ext);
        print_int64(el);
        println("");
        et: List[int64, mem(normal)] <- ext.tail;
        eth: int64 <- et.head;
        print_int64(eth);
        println("")
    produces
        pure 0
    end
}
