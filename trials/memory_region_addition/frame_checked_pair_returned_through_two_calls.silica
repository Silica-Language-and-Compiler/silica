// Chunk 15 phase 2 (S6, checked pairs are 16-byte frame blocks): a checked_int64 pair returned through
// two calls. pair_inner returns the primitive's pair in return position, pair_outer returns
// pair_inner's; the caller destructures. 20 + 22 = 42 with ok; max_int64 + 1 overflows (ok false).
// The result is 42 + 7 = 49 (the exit status, as in compiler_addition/prim_tuple_let).
// Expected: 49.

use trial_support_int64;

fn pair_inner(a: int64, b: int64) -> (boolean, int64) {
    checked_int64_add(a, b)
}

fn pair_outer(a: int64, b: int64) -> (boolean, int64) {
    pair_inner(a, b)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            p1: (boolean, int64) <- pair_outer(20, 22);
            (ok1: boolean, v1: int64) <- p1;
            p2: (boolean, int64) <- pair_outer(9223372036854775807, 1);
            (ok2: boolean, _: int64) <- p2;
            a: int64 <- case ok1 of { true -> v1; false -> 0 };
            b: int64 <- case ok2 of { true -> 1000; false -> 7 };
            a + b
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
