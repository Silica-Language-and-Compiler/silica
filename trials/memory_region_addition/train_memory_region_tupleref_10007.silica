// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: flat tuple stored in a ref and read back; expect 1
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                t: (int64, boolean, float64) <- (1, true, 2.5);
                cell: ref(L1, normal, (int64, boolean, float64)) <- alloc_ref(r, t);
                back: (int64, boolean, float64) <- read_ref(cell);
                (x: int64, flag: boolean, f: float64) <- back;
                _used_f: float64 <- f;
                value: int64 <- case flag of { true -> x; false -> 0 }
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
