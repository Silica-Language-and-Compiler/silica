// Chunk 15 phase 2 (S4/S6): a concat result built in the innermost frame of a return-position chain
// (f -> g -> h) and read by main after all three frames have returned. Expected: xyz, then status 0.
//   xyz
//   0

fn h(n: int64) -> string {
    a: string <- concat("x", "y");
    concat(a, "z")
}

fn g(n: int64) -> string {
    h(n + 1)
}

fn f(n: int64) -> string {
    g(n)
}

fn main() -> int64 {
    sequence proc[device_io]
        s: string <- f(0);
        println(s)
    produces
        pure 0
    end
}
