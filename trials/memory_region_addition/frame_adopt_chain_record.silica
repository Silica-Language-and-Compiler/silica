// Chunk 15 phase 2 (S4, design §3.4): return-position chains. f returns g(...) returns h(...), and h
// builds a record with a string made by concat. Every call is in return position, so each frame's
// nodes are adopted by the next caller (the callee's SP is kept). main reads both fields.
// f(4) -> g(5) -> h(10). Expected: 10, abcd, then status 0.
//   10
//   abcd
//   0

fn h(x: int64) -> { n: int64, label: string } {
    s: string <- concat("ab", "cd");
    out: { n: int64, label: string } <- { n: x, label: s };
    out
}

fn g(x: int64) -> { n: int64, label: string } {
    h(x * 2)
}

fn f(x: int64) -> { n: int64, label: string } {
    g(x + 1)
}

fn main() -> int64 {
    sequence proc[device_io]
        r: { n: int64, label: string } <- f(4);
        print_int64(r.n);
        println("");
        println(r.label)
    produces
        pure 0
    end
}
