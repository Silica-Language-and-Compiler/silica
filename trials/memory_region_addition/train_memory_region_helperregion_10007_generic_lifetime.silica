// Helper parameter written with a generic lifetime R against a caller lifetime L1.
// Legal since 2026-09-25 (spec 12.1.4); a type checker comparing lifetime surfaces literally
// rejected it as E2003. Fix covered by memory_region_addition/lifetime_parameter_name.
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: region handle moved into a helper; expect 3
use trial_support_int64;

fn consume(r: region(R, normal), n: int64) -> int64 {
    sequence proc[mem(normal)]
        cell: ref(R, normal, int64) <- alloc_ref(r, n)
    produces
        pure read_ref(cell)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                v: int64 <- consume(r, 3)
            produces
                pure v
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
