// read_buf(b, f(i)): the buffer is in X1 and the index operand is evaluated after it, so a call in the
// index must not cost the buffer pointer. Same hazard as write_buf_call_argument, on the load side and
// on every other two-operand memory prim (term_emit_kind_compound_part2 parks X1 across a computed
// second operand).
// Expected, by hand: 42, 7.

use trial_support_int64;

fn plus_one(n: int64) -> int64 {
    n + 1
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal), device_io]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                b: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
                _: atom <- write_buf(b, 2, 42);
                _: atom <- write_buf(b, plus_one(2), 7);
                v: int64 <- read_buf(b, plus_one(1));
                _: atom <- print_int64(v);
                println("");
                w: int64 <- read_buf(b, plus_one(2));
                _: atom <- print_int64(w);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
