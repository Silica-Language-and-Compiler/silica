// Size check on alloc_buf: a run-time element count whose byte size is far beyond any stack or heap
// (5 * 3,518,437,208,884 = 17,592,186,044,420 int64 elements, over 2^47 bytes) is a failed runtime
// check in main, which is a runtime abort: "[silica] abort: invalid buffer size at 0x<pc>" on stderr and
// exit status 71, on every target (the boards refuse it in the emitter's size cap).
// The count reaches alloc_buf through a parameter and is computed at run time. The first call allocates
// one element, stores 5 and reads it back; the second asks for the huge count, and nothing after it runs.
// compare_scout_normalized.sh folds everything after " at " to <PTR>.

fn fill(count: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, int64, count) <- alloc_buf(r, count);
        _: atom <- write_buf(buf, 0, 5);
        value: int64 <- read_buf(buf, 0)
    produces
        pure value
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- fill(1);
        print_int64(a);
        println("");
        b: int64 <- fill(a * 3518437208884);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
