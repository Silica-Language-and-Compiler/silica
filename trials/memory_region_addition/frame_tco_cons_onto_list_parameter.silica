// Chunk 15 phase 2 (S5): a TCO loop that conses onto a list parameter. Each iteration's cons block is
// a frame node the next iteration's list parameter names, so the tail call must keep the dynamic part
// of the frame (tco_params_frame_free is false for a pointer parameter; "keep_dynamic").
// count_up(5, []) yields [1, 2, 3, 4, 5]. Expected: sum 15, length 5, head 1, then status 0.
//   15
//   5
//   1
//   0

fn cons_int(x: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn nil_int() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure r
    end
}

fn count_up(n: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case n == 0 of {
        true -> acc;
        false -> count_up(n - 1, cons_int(n, acc))
    }
}

fn sum_list(l: List[int64, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[int64, mem(normal)](l)
    produces
        pure case n == 0 of {
            true -> 0;
            false -> l.head + sum_list(l.tail)
        }
    end
}

fn main() -> int64 {
    sequence proc[device_io, mem(normal)]
        l: List[int64, mem(normal)] <- count_up(5, nil_int());
        total: int64 <- sum_list(l);
        print_int64(total);
        println("");
        len: int64 <- length[int64, mem(normal)](l);
        print_int64(len);
        println("");
        first: int64 <- l.head;
        print_int64(first);
        println("")
    produces
        pure 0
    end
}
