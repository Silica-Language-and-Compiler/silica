// A reference taken into a region that arrived as a parameter, queried with ref_in_region through
// two levels of call, with the region handle threaded through every call by passing it in and
// returning it (spec §4.4.2: a region handle is move-only, passing it to a function moves it, and
// the function must return it). The region is a canonical arena, as in the stdlib collections.
//
// History (staged 2026-09-18 as emitter_defect_region_param_destroyed_after_ref_in_region, found
// while reducing record_bind_after_destructures.silica): the original program's `inside_ref(r,
// node_ref) -> int64` took the region and never returned it, and its callers went on using `r`
// after passing it. That breaks the move rule: by §4.4.2 the callee owned the handle, and the
// emitter's ownership rule (emitter_core@fn_destroys_region_param) destroyed it at the callee's
// end, exactly as it must for any owned region that does not move on. The crash it produced (a
// libmalloc assertion, SIGTRAP, exit 133) was a second, separate defect: _silica_rt_region_destroy
// freed a canonical arena, which is process-shared and belongs to the canonical arena table, as if
// it were a malloc block. That is fixed in the runtime on every target (the table is consulted
// before anything is released; trial canonical_arena_survives_owning_callee) and this program was
// rewritten to conform to the move rule: every function that receives `r` returns it, and each
// caller binds the returned handle before the next call.
// Expected output: two lines of 1111 and status 0.
//   with_record (expected 1111)
//   1111
//   without_record (expected 1111)
//   1111
//   0
//
// To run by hand:
//   mkdir -p /tmp/rb && cp <this file> /tmp/rb/m.silica && cd /tmp/rb && echo m.silica > silica.config
//   /Volumes/2T/silica/binaries/silica-compiler
//   clang -mmacosx-version-min=26.0 -c -x assembler m.sams -o m.o
//   clang -mmacosx-version-min=26.0 -c -x assembler __silica_runtime.sams -o rt.o
//   clang m.o rt.o -o m -Wl,-e,main -Wl,-macos_version_min,26.0 && ./m

use trial_support_int64;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cell(
    r: region(L, normal),
    v: int64,
    count: int64,
    left: ref?(L, normal, rec),
    right: ref?(L, normal, rec)
) -> (region(L, normal), ref?(L, normal, rec)) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (v, count, left, right))
    produces
        pure (r, c)
    end
}

fn inside_ref(
    r: region(L, normal),
    node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> (region(L, normal), int64) {
    sequence
        ok: boolean <- ref_in_region(node_ref, r);
        flag: int64 <- case ok of { true -> 1; false -> 0 }
    produces
        pure (r, flag)
    end
}

fn inside(r: region(L, normal), node: ref?(L, normal, rec)) -> (region(L, normal), int64) {
    case node of {
        :none -> (r, 9);
        node_ref: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> inside_ref(r, node_ref)
    }
}

fn record_of(
    r: region(L, normal),
    root: ref?(L, normal, rec)
) -> {
    root: ref?(L, normal, rec),
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64
} {
    out: {
        root: ref?(L, normal, rec),
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    } <- { root: root, compare_item: cmp_i64, region: r, specialization_key: 0 };
    out
}

fn with_record(r: region(L, normal)) -> (region(L, normal), int64) {
    sequence
        neg_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, -5, :none, :none);
        (r1: region(L, normal), neg: ref?(L, normal, rec)) <- neg_p;
        zero_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r1, 1, 0, :none, :none);
        (r2: region(L, normal), zero: ref?(L, normal, rec)) <- zero_p;
        l1_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r2, 2, 1, :none, :none);
        (r3: region(L, normal), l1: ref?(L, normal, rec)) <- l1_p;
        l2_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r3, 3, 1, :none, :none);
        (r4: region(L, normal), l2: ref?(L, normal, rec)) <- l2_p;
        big_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r4, 1, 7, l1, l2);
        (r5: region(L, normal), big: ref?(L, normal, rec)) <- big_p;
        small_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r5, 1, 2, l1, l2);
        (r6: region(L, normal), small: ref?(L, normal, rec)) <- small_p;
        t: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- record_of(r6, big);
        a_p: (region(L, normal), int64) <- inside(t.region, neg);
        (r7: region(L, normal), a: int64) <- a_p;
        b_p: (region(L, normal), int64) <- inside(r7, zero);
        (r8: region(L, normal), b: int64) <- b_p;
        c_p: (region(L, normal), int64) <- inside(r8, big);
        (r9: region(L, normal), c: int64) <- c_p;
        d_p: (region(L, normal), int64) <- inside(r9, small);
        (r10: region(L, normal), d: int64) <- d_p
    produces
        pure (r10, a * 1000 + b * 100 + c * 10 + d)
    end
}

fn without_record(r: region(L, normal)) -> (region(L, normal), int64) {
    sequence
        neg_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r, 1, -5, :none, :none);
        (r1: region(L, normal), neg: ref?(L, normal, rec)) <- neg_p;
        zero_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r1, 1, 0, :none, :none);
        (r2: region(L, normal), zero: ref?(L, normal, rec)) <- zero_p;
        l1_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r2, 2, 1, :none, :none);
        (r3: region(L, normal), l1: ref?(L, normal, rec)) <- l1_p;
        l2_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r3, 3, 1, :none, :none);
        (r4: region(L, normal), l2: ref?(L, normal, rec)) <- l2_p;
        big_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r4, 1, 7, l1, l2);
        (r5: region(L, normal), big: ref?(L, normal, rec)) <- big_p;
        small_p: (region(L, normal), ref?(L, normal, rec)) <- cell(r5, 1, 2, l1, l2);
        (r6: region(L, normal), small: ref?(L, normal, rec)) <- small_p;
        a_p: (region(L, normal), int64) <- inside(r6, neg);
        (r7: region(L, normal), a: int64) <- a_p;
        b_p: (region(L, normal), int64) <- inside(r7, zero);
        (r8: region(L, normal), b: int64) <- b_p;
        c_p: (region(L, normal), int64) <- inside(r8, big);
        (r9: region(L, normal), c: int64) <- c_p;
        d_p: (region(L, normal), int64) <- inside(r9, small);
        (r10: region(L, normal), d: int64) <- d_p
    produces
        pure (r10, a * 1000 + b * 100 + c * 10 + d)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal), device_io]
                L: lifetime <- fresh_lifetime();
                r: region(L, normal) <- canonical_arena_lookup(9085);
                w_p: (region(L, normal), int64) <- with_record(r);
                (r1: region(L, normal), w: int64) <- w_p;
                wo_p: (region(L, normal), int64) <- without_record(r1);
                (_: region(L, normal), wo: int64) <- wo_p;
                println("with_record (expected 1111)");
                print_int64(w);
                println("");
                println("without_record (expected 1111)");
                print_int64(wo);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
