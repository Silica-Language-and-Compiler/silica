// Chunk 15 phase 2 (S6, free-slot rule): as frame_list_prepend_onto_older_frame_scalar with POINTER
// elements. The base list ["p"] belongs to main; extend() conses a string it built with concat in its
// own frame onto it. The rule lets a pointer element into a chunk only when the chunk is in the
// caller's own frame, so the extension must not write the younger string into main's chunk slot.
// Expected: p, 1, qr, 2, p, then status 0.
//   p
//   1
//   qr
//   2
//   p
//   0

fn cons_str(x: string, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[string, mem(normal)] <- prepend[string, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn nil_str() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure r
    end
}

fn extend(base: List[string, mem(normal)]) -> List[string, mem(normal)] {
    s: string <- concat("q", "r");
    cons_str(s, base)
}

fn main() -> int64 {
    sequence proc[device_io, mem(normal)]
        base: List[string, mem(normal)] <- cons_str("p", nil_str());
        ext: List[string, mem(normal)] <- extend(base);
        bh: string <- base.head;
        println(bh);
        bl: int64 <- length[string, mem(normal)](base);
        print_int64(bl);
        println("");
        eh: string <- ext.head;
        println(eh);
        el: int64 <- length[string, mem(normal)](ext);
        print_int64(el);
        println("");
        et: List[string, mem(normal)] <- ext.tail;
        eth: string <- et.head;
        println(eth)
    produces
        pure 0
    end
}
