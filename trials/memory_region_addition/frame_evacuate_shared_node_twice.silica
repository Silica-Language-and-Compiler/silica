// Chunk 15 phase 2 (S5/S6, design §3.5): evacuation preserves sharing. twin builds ONE cell in its
// frame and returns a record whose two fields both name it. main binds the result (a non-return-position
// call: the result's reachable new nodes are copied to the caller's frame, once each), writes through
// `first` and reads through `second`. If the cell had been copied twice the write would not be seen.
// Expected: 99, 99, then status 0.
//   99
//   99
//   0

fn twin(r: region(L, normal), v: int64) -> { first: ref(L, normal, int64), second: ref(L, normal, int64), region: region(L, normal) } {
    sequence proc[mem(normal)]
        c: ref(L, normal, int64) <- alloc_ref(r, v);
        out: { first: ref(L, normal, int64), second: ref(L, normal, int64), region: region(L, normal) } <- { first: c, second: c, region: r }
    produces
        pure out
    end
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        t: { first: ref(L, normal, int64), second: ref(L, normal, int64), region: region(L, normal) } <- twin(r, 5);
        _: atom <- write_ref(t.first, 99);
        a: int64 <- read_ref(t.second);
        b: int64 <- read_ref(t.first);
        print_int64(a);
        println("");
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
