// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8).

// Trial: alloc_buf with flat tuple element type
// silica-specification §12.3.2, §22.1, §22.3

use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                buf: buf(L1, normal, (int64, int64), 4) <- alloc_buf(r, 4)
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
