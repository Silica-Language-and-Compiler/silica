// Classic Ackermann A(m,n); A(3,3) = 61 — split m==0 vs m>0 (no nested case)
// Nested ack(m-1, ack(m, n-1)): emitter evaluates the inner call before the outer first arg so m stays in X0.
// Runs in a behaviour (trial_support_int64@run): the call nests ~2,400 frames deep, which main's fixed stack cannot hold.
use trial_support_int64;

fn ack_nonzero(m: int64, n: int64) -> int64 {
    case n == 0 of {
        true -> ack(m - 1, 1);
        false -> ack(m - 1, ack(m, n - 1))
    }
}

fn ack(m: int64, n: int64) -> int64 {
    case m == 0 of {
        true -> n + 1;
        false -> ack_nonzero(m, n)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            ack(3, 3)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
