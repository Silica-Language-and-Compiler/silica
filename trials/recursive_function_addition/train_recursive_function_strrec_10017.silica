// string recursion via substring; count_rec("cherry") = 0
use trial_support_int64;

fn count_rec(s: string) -> int64 {
    case length_chars(s) == 0 of {
        true -> 0;
        false -> count_step(s)
    }
}

fn count_step(s: string) -> int64 {
    head: string <- substring(s, 0, 1);
    case head == "o" of {
        true -> 1 + count_rec(substring(s, 1, length_chars(s)));
        false -> count_rec(substring(s, 1, length_chars(s)))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            count_rec("cherry")
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
