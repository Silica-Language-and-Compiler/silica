// Recursively count the letter 'a' in an ASCII string (substring + case on head); no lists
use trial_support_int64;

fn count_a_step(s: string) -> int64 {
    head: string <- substring(s, 0, 1);
    bump: int64 <- case head of {
        "a" -> 1;
        _: string -> 0
    };
    bump + count_a_rec(substring(s, 1, length_chars(s)))
}

fn count_a_rec(s: string) -> int64 {
    case length_chars(s) == 0 of {
        true -> 0;
        false -> count_a_step(s)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            r: int64 <- count_a_rec("abracadabra");
            r * 1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
