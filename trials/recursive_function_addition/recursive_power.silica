// Linear non-tail recursion: base^exp for exp >= 0; 2^7 = 128 (exit code fits byte)
use trial_support_int64;

fn pow_int(base: int64, exp: int64) -> int64 {
    case exp <= 0 of {
        true -> 1;
        false -> base * pow_int(base, exp - 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            pow_int(2, 7)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
