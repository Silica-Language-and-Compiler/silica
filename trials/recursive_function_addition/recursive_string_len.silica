// Recursively count Unicode scalars (matches length_chars) using substring; no lists
use trial_support_int64;

fn str_len_rec(s: string) -> int64 {
    case length_chars(s) == 0 of {
        true -> 0;
        false -> 1 + str_len_rec(substring(s, 1, length_chars(s)))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            r: int64 <- str_len_rec("hello");
            r * 1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
