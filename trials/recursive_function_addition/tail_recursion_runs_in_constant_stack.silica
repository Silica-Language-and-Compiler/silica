// A self-call in tail position is a jump, not a call: 20,000,000 iterations of an accumulator loop
// run in constant stack (design_documents/sir_recursion_strategy.md -- tail recursion costs no
// stack; every BEAM-style loop is recursion). It used to be emitted as a BLR, so the loop overflowed
// the stack and faulted in `loop`. emitter_core@tco_tail_self_calls lists the self calls in tail
// position and the function gets a restart stub (L_tco_<fn>) that resets SP, re-runs the parameter
// moves and branches back into the body.
// Expected: 60000003 (sum of i % 7 for i in 1..20,000,000), exit 0.

use trial_support_int64;

fn loop(i: int64, acc: int64) -> int64 {
    case i == 0 of {
        true -> acc;
        false -> loop(i - 1, acc + (i % 7))
    }
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                _: atom <- print_int64(loop(20000000, 0));
                println("")
            produces pure 0 end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
