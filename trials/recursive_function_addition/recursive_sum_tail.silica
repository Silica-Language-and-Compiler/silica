// Tail recursion: sum 1..n via accumulator; sum_to(10, 0) = 55
use trial_support_int64;

fn sum_to(n: int64, acc: int64) -> int64 {
    case n <= 0 of {
        true -> acc;
        false -> sum_to(n - 1, acc + n)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sum_to(10, 0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
