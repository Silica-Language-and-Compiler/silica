    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o123_done
L_case_o123_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

train_recursive_function_strrec_10011_count_step:     STP X29, X30, [SP, #-16]!
