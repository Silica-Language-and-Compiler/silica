    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #29
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_substring_helper:
    STP X19, X20, [SP, #-80]!
    STP X21, X22, [SP, #16]
    STP X23, X14, [SP, #32]
    STP X15, X30, [SP, #48]
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2
    CMP X20, #0
    CSEL X20, XZR, X20, LT
    CMP X21, #0
    CSEL X21, XZR, X21, LT
    LDR X10, [X19]
    MVN X9, X10
    CMP X9, #1
    B.HI L_ss_bad
    LDR X8, [X19, #8]
    LDR X22, [X19, #16]
