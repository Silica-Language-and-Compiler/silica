L_ss_find_start:
    CMP X14, X20
    B.GE L_ss_start_found
    CMP X9, X22
    B.GE L_ss_start_found
    LDRB W10, [X8, X9]
    CMP W10, #0x80
    B.LO L_ss_adv1
    CMP W10, #0xC2
    B.LO L_ss_adv1
    CMP W10, #0xE0
    B.LO L_ss_adv2
    CMP W10, #0xF0
    B.LO L_ss_adv3
    CMP W10, #0xF8
    B.LO L_ss_adv4
L_ss_adv1:
    ADD X9, X9, #1
    ADD X14, X14, #1
