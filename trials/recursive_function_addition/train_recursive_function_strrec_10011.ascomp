L_ss_bwd_lead:
    MOV X17, #1
    CMP W10, #0xC2
    B.LO L_ss_bwd_len
    MOV X17, #2
    CMP W10, #0xE0
    B.LO L_ss_bwd_len
    MOV X17, #3
    CMP W10, #0xF0
    B.LO L_ss_bwd_len
