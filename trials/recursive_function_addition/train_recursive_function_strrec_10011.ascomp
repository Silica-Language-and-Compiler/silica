    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o542|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    MOV X8, XZR
    ADRP X9, trial_support_int64_start@PAGE
    ADD X9, X9, trial_support_int64_start@PAGEOFF
    BLR X9

    ADRP X16, train_recursive_function_strrec_10011.__lam0@PAGE
    ADD X16, X16, train_recursive_function_strrec_10011.__lam0@PAGEOFF

    STR X16, [SP, #-16]!
