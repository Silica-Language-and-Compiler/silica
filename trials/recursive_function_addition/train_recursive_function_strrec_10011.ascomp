L_ss_start_found:
    MOV X23, X9
L_ss_find_end:
    CMP X14, X21
    B.GE L_ss_end_found
    CMP X9, X22
    B.GE L_ss_end_found
    LDRB W10, [X8, X9]
    CMP W10, #0x80
    B.LO L_ss_eadv1
    CMP W10, #0xC2
    B.LO L_ss_eadv1
    CMP W10, #0xE0
    B.LO L_ss_eadv2
    CMP W10, #0xF0
    B.LO L_ss_eadv3
    CMP W10, #0xF8
    B.LO L_ss_eadv4
L_ss_eadv1:
