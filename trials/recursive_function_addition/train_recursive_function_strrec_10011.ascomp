    LDR X10, [X1, #16]
    LDR X11, [X1, #24]
    ADRP X1, L_ss_lock@PAGE
    ADD X1, X1, L_ss_lock@PAGEOFF
    STLR WZR, [X1]
    CMP X2, X19
    B.EQ L_ss_ascii_hit
    MOV X3, X11
    CMP X10, X19
    B.NE L_ss_ascii_classify
L_ss_ascii_hit:
