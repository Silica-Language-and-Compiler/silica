L_ss_bwd_cont:
    LDRB W10, [X8, X9]
    LSR W11, W10, #6
    CMP W11, #2
    B.NE L_ss_bwd_lead
    CBZ X9, L_ss_bwd_lead
    SUB X9, X9, #1
