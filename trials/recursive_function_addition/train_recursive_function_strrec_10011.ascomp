    BL _silica_rt_wait_for_exit

    MOV X19, X0
    MOV X0, X19



    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

train_recursive_function_strrec_10011.__lam0:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    ADRP X16, L_str_1@PAGE
    ADD X16, X16, L_str_1@PAGEOFF
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o645|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    MOV X8, XZR
