// string recursion via substring; str_len_acc("north", 0) = 5
use trial_support_int64;

fn str_len_acc(s: string, acc: int64) -> int64 {
    case length_chars(s) == 0 of {
        true -> acc;
        false -> str_len_acc(substring(s, 1, length_chars(s)), acc + 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            str_len_acc("north", 0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
