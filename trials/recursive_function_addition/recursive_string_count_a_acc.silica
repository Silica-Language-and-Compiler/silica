// Tail recursion: count 'a' with accumulator (same result as recursive_string_count_a)
use trial_support_int64;

fn count_a_step_acc(s: string, acc: int64) -> int64 {
    head: string <- substring(s, 0, 1);
    bump: int64 <- case head of {
        "a" -> 1;
        _: string -> 0
    };
    count_a_acc(substring(s, 1, length_chars(s)), acc + bump)
}

fn count_a_acc(s: string, acc: int64) -> int64 {
    case length_chars(s) == 0 of {
        true -> acc;
        false -> count_a_step_acc(s, acc)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            r: int64 <- count_a_acc("abracadabra", 0);
            r * 1
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
