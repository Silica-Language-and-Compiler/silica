// Tail recursion: base^exp via accumulator; pow_acc(2, 7, 1) = 128
use trial_support_int64;

fn pow_acc(base: int64, exp: int64, acc: int64) -> int64 {
    case exp <= 0 of {
        true -> acc;
        false -> pow_acc(base, exp - 1, acc * base)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            pow_acc(2, 7, 1)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
