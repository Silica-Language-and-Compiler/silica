// mutual recursion even/odd; even(8) + odd(0) = 1
use trial_support_int64;

fn even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> odd(n - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            even(8) + odd(0)
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
