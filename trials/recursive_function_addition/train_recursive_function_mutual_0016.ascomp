train_recursive_function_mutual_0016_even:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X9, X19
    MOV X10, #0


    CMP X9, X10
    CSET X3, EQ
L_case_o112_br_0:
    CMP W3, #1
    B.NE L_case_o112_br_1
    MOV X0, #1
