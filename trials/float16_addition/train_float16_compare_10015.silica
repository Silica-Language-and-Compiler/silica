// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((8.5 - 23.5) == 31.5);
                println("");
                _: atom <- print_boolean((38.25 + 16.5) > (38.5 - 21.75));
                println("");
                _: atom <- print_boolean((7.0 + 29.0) < (21.75 - 27.0));
                println("");
                done: atom <- print_boolean(3.75 * 15.0 == (8.75 - 32.5))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
