use trial_support_atom;

fn left16() -> float16 {
    40.5
}

fn right16() -> float16 {
    2.25
}

fn next16(x: float16) -> float16 {
    x + 1.0
}

fn add_with_next16(x: float16) -> float16 {
    x + next16(x)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                expected_sum: float16 <- 42.75;
                expected_param: float16 <- 5.0;
                _: atom <- print_boolean((left16() + right16()) == expected_sum);
                _: unit <- println("");
                base: float16 <- 40.5;
                _: atom <- print_boolean((base + right16()) == expected_sum);
                _: unit <- println("");
                done: atom <- print_boolean(add_with_next16(2.0) == expected_param);
                _: unit <- println("")
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
