// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(13.25 >= (16.5 + 39.5));
                println("");
                _: atom <- print_boolean((31.0 - 7.75) >= 9.25);
                println("");
                done: atom <- print_boolean(39.0 / 6.5 > 2.5)
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
