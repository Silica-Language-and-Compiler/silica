// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((6.0 - 27.75) == 5.5 * 2.5);
                println("");
                _: atom <- print_boolean((9.0 + 27.5) >= (35.75 + 6.25));
                println("");
                done: atom <- print_boolean((24.5 - 18.0) == 7.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
