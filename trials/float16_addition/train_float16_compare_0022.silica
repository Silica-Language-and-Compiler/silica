// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((35.5 + 27.75) < 14.5 / 32.0);
                println("");
                _: atom <- print_boolean((7.5 - 7.75) != (16.5 + 35.0));
                println("");
                done: atom <- print_boolean((5.0 + 14.5) < (22.5 + 19.5))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
