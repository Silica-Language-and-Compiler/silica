// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((2.5 + 33.0) != (2.0 + 10.5));
                println("");
                _: atom <- print_boolean(28.75 < 20.0);
                println("");
                _: atom <- print_boolean(7.25 == (16.5 - 29.0));
                println("");
                done: atom <- print_boolean(3.0 >= (26.75 + 12.0))
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
