// main returns float16; exit code is trunc(11.25 + 31.5 / 10.5) = 14
use trial_support_float16;

fn main() -> float16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            11.25 + 31.5 / 10.5
        });
        _: int64 <- wait_for_exit()
    produces
        pure 14.25
    end
}
