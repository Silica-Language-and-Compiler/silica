// main returns float16; exit code is trunc(25.0 + 33.0) = 58
use trial_support_float16;

fn main() -> float16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            25.0 + 33.0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 58.0
    end
}
