// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io] _: atom <- print_boolean((13.5 + 25.5) != 19.5);
                println("");
                _: atom <- print_boolean(26.0 > 27.75);
                println("");
                done: atom <- print_boolean((33.5 + 20.5) >= (17.5 - 4.5))
                produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
