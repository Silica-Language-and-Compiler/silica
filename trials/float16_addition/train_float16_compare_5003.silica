// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((27.0 + 26.0) <= (31.75 + 20.5));
                println("");
                _: atom <- print_boolean(27.5 > (33.5 - 26.75));
                println("");
                _: atom <- print_boolean((22.0 - 14.0) == (19.0 + 4.5));
                println("");
                done: atom <- print_boolean(27.0 > (36.0 - 6.5))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
