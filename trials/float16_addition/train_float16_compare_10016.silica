// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((2.0 + 9.5) < (26.0 + 5.0));
                println("");
                _: atom <- print_boolean((13.25 + 15.0) != (16.5 + 20.0));
                println("");
                _: atom <- print_boolean(34.0 == (1.5 + 29.5));
                println("");
                done: atom <- print_boolean((7.75 + 4.0) == (28.5 + 41.0))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
