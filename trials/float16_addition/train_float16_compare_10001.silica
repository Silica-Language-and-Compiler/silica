// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean(4.5 * 32.5 >= 37.0);
                println("");
                _: atom <- print_boolean((6.25 + 18.75) > 2.5);
                println("");
                done: atom <- print_boolean((6.0 + 15.75) <= 3.25 * 11.0)
            produces pure done end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
