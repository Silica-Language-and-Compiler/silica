// main returns float16; exit code is trunc(31.0) = 31
use trial_support_float16;

fn main() -> float16 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_float16@start();
        _: boolean <- trial_support_float16@run(fn() -> float16 {
            31.0
        });
        _: int64 <- wait_for_exit()
    produces
        pure 31.0
    end
}
