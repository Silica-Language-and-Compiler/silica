// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((2.5 - 5.75) < (28.5 - 8.5));
                println("");
                _: atom <- print_boolean(30.0 * 31.0 <= 34.0);
                println("");
                done: atom <- print_boolean(3.25 > (40.75 + 4.0))
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
