// float16 comparisons
use trial_support_atom;

fn main() -> atom {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_atom@start();
        _: boolean <- trial_support_atom@run(fn() -> atom {
            sequence proc[device_io]
                _: atom <- print_boolean((40.0 + 19.0) < (14.0 - 29.5));
                println("");
                _: atom <- print_boolean((37.5 - 7.75) != 15.0 * 31.0);
                println("");
                done: atom <- print_boolean(29.0 * 5.0 == 20.5 * 15.0)
            produces
                pure done
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure :ok
    end
}
