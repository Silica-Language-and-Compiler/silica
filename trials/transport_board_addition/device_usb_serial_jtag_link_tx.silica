// The (:usb_serial_jtag) carrier reached through its link declaration (transport_links_design.md §3.3,
// specification §16.4.9; stage S-C of transport_esp32s3_wifi_plan.md §8): `carried_on usb: (:serial)
// (:usb_serial_jtag);` names the carrier kind and the hardware under it, spawn_dangerous_carrier(usb, ...)
// expands on this board to spawn_device(:idle, device_esp32s3_usb_serial_jtag@usb_serial_jtag_carrier, ...)
// (the ESP32-S3 transport pack's carrier_spawn), and Carrier@mtu(usb) / Carrier@boundaries(usb) are the
// (:serial) kind's rows (mtu 0, :stream: the same framing as the tag form). Otherwise the program is
// device_usb_serial_jtag_carrier_tx: one 60-byte frame into the controller's 64-byte IN FIFO, then close.
// The declaration is checked against the pack: (:usb_serial_jtag) is provided here, UART0 would be
// E2412 (link_uart0_console_reserved).
// Expected (board only; the host emitter rejects the prims with E2220):
//   link up usb_serial_jtag / tx credit 8 / sent 60 bytes / link down :closed / status 0.
// spawn_dangerous_carrier adds this `use` implicitly for the compiler; it is written out because the board
// image tooling (trials/targets/board_suite.sh link_closure, board/tools) links a program with the modules its
// source names in `use` lines.
use device_esp32s3_usb_serial_jtag;
use wireframe;
use Carrier;
use trial_wait_int64;

carried_on usb: (:serial) (:usb_serial_jtag);

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

// 56 bytes of text: two 28-byte lines.
fn payload() -> string {
    line: string <- "usb serial jtag carrier tx\r\n";
    concat(line, line)
}

fn framed_payload() -> string {
    segs: List[string, mem(normal)] <- wireframe@frame(payload(), Carrier@mtu(usb), Carrier@boundaries(usb));
    first_segment(segs)
}

fn owner(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
         state: { car: device_actor_ref, sent: int64 }) -> (:no_reply, { car: device_actor_ref, sent: int64 }) {
    case msg of {
        (:link_up, info: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("link up ");
                _: atom <- println(info);
                seg: string <- framed_payload();
                _: boolean <- cast_device(state.car, (:tx, seg, self()) impl ActorMessage {})
            produces
                pure (:no_reply, { car: state.car, sent: length_bytes(seg) })
            end
        };
        (:tx_credit, n: int64) -> {
            sequence proc[concurrency, device_io]
                _: atom <- case n == 1 of {
                    true -> {
                        _: atom <- print("sent ");
                        _: atom <- print_int64(state.sent);
                        _: atom <- println(" bytes");
                        _: boolean <- cast_device(state.car, :close impl ActorMessage {});
                        :ok
                    };
                    false -> {
                        _: atom <- print("tx credit ");
                        _: atom <- print_int64(n);
                        println("")
                    }
                }
            produces
                pure (:no_reply, state)
            end
        };
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_failed, why: atom) -> {
            sequence proc[device_io]
                _: atom <- print("tx failed ");
                _: atom <- print_atom(why);
                _: atom <- println("")
            produces
                pure (:no_reply, state)
            end
        };
        (:link_down, why2: atom) -> {
            sequence proc[device_io, concurrency]
                _: atom <- print("link down ");
                _: atom <- print_atom(why2);
                _: atom <- println("");
                _: boolean <- case why2 == :closed of {
                    true -> cast_exit(0);
                    false -> cast_exit(1)
                }
            produces
                pure (:no_reply, state)
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: device_actor_ref <- spawn_dangerous_carrier(usb, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                me: actor_ref <- spawn({ car: car, sent: 0 }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast_device(car, (:open, me, "") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
