// Carriers (actor_memory_budget_plan.md item N, stage 1): a thousand plain actors on the one
// carrier thread, each spawned with a lowered reservation and :release_on_return, each called once
// with its number and replying twice it. The replies are summed (2 * (1 + ... + 1000) = 1001000)
// and every actor is checked afterwards: a wrong reply, or committed or retained stack held after
// the message (the release algorithm runs on the carrier's stack at the dispatch boundary), counts
// as bad.
//
// Expected output: 1001000, 0, exit status 0. The same with SILICA_CARRIERS=0.

use trial_support_int64;

fn doubler(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + msg, state + 1)
}

fn spawn_call_check(n: int64, sum: int64, bad: int64) -> int64 {
    case n == 0 of {
        true -> sum * 10 + bad;
        false -> {
            sequence proc[concurrency]
                w: actor_ref <- spawn(0, doubler, stack_policy(1048576, :release_on_return));
                r: int64 <- call(w, n impl ActorMessage {});
                u: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
                wrong: int64 <- case r == n + n and u.committed == 0 and u.retained == 0 and u.high_water > 0 of {
                    true -> 0;
                    false -> 1
                };
                rest: int64 <- spawn_call_check(n - 1, sum + r, bad + wrong)
            produces
                pure rest
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[device_io]
                packed: int64 <- spawn_call_check(1000, 0, 0);
                print_int64(packed / 10);
                println("");
                print_int64(packed - (packed / 10) * 10);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
