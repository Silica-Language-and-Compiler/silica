// Carriers (actor_memory_budget_plan.md item N, carrier-runtime gap 4: supervisor_add_child and
// supervisor_handle_notice in prims_actors_child_table_asm.silica, spawn_wait_started in
// prims_actors_carrier_asm.silica): the driver (the trial support's worker, a
// carrier actor that is not a row of the root) asks the root supervisor, through call_supervisor
// :add_child, to start a SECOND child supervisor (mid_b, with one counter). The operation runs on
// the driver's stack; a child supervisor starts in its first dispatch on its carrier, so the spawn
// waits for its started word. Before the fix add_child installed the ROOT as the thread's current
// actor for the start, and spawn_wait_started decided park-or-spin by that actor: the driver's SP
// is not in the root's reservation, so the driver SPUN on its carrier, and at
// SILICA_CARRIER_COUNT=1 mid_b (bound to the same carrier) could never run its first dispatch: a
// hang. Now the start leaves the driver the current actor and the wait is decided by the carrier's
// running actor (carrier +40), so the driver parks and mid_b starts. The same install was made by
// every ingress drain (handle_notice: a killer's drain respawning a supervisor child), fixed the
// same way. A plain killer then kills mid_b (its row is restarted by whoever drains first).
//
//   root counts 1 (9); add mid_b -> tag :child_started (9); root counts 2 (9); mid_b counts 1 (9);
//   call counter_b 5 -> 505; kill mid_b -> :ok (9); root counts 2 (9); call counter_b 5 -> 505.
//
// Expected output: 9, 9, 9, 9, 505, 9, 9, 505, two failure reports (mid_b with reason_tag 1 from
// the kill, counter_b with reason_tag 1 from mid_b's shutdown), done, exit status 0, at every
// SILICA_CARRIER_COUNT (a hang at 1 before the fix, at the add), compared as a multiset. Printed
// values avoid the digits 1-4 (compare_scout_multiset.sh folds those): 9 is a check that holds, 6
// one that does not.
//
// The driver runs on the trial support's worker (trial_wait_int64: a plain actor on a carrier) and
// prints done last; main waits for the exit line. trial_wait_int64 (not trial_support_int64) makes
// this unit compile after the suite's other trial_wait users, so its new atoms renumber none of
// theirs.

use Supervisor;
use trial_wait_int64;

impl G4DrainRootSup for Supervisor;

fn counter(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn mid_a_start(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :g4_counter_a, agent_type: :worker, initial_state: initial_state + 400, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn mid_b_start(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :g4_counter_b, agent_type: :worker, initial_state: initial_state + 500, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :g4_mid_a, agent_type: :supervisor, initial_state: 0, behavior: mid_a_start, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

// Kills mid_b and replies 9 when kill_abnormal returned :ok, else 6 (kill_abnormal is a
// behaviour-only builtin, E2091). A plain spawned actor: not a row of the root.
fn killer(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        killed: atom <- kill_abnormal(:g4_mid_b);
        v: int64 <- case killed of { :ok -> 9; _: atom -> 6 }
    produces
        pure (:reply, v, state)
    end
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

fn count_of(sup: supervisor_ref) -> int64 {
    sequence
        c: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :count_children } impl SupervisorMessage {})
    produces
        pure c.count
    end
}

fn count_of_child(sup: actor_ref) -> int64 {
    sequence
        c: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :count_children } impl SupervisorMessage {})
    produces
        pure c.count
    end
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        root: supervisor_ref <- spawn_registered_supervisor(G4DrainRootSup, 0, :g4_root, stack_policy(0, :keep_last_message));
        n_root: int64 <- count_of(root);
        added: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(root, { op: :add_child, child: { id: :g4_mid_b, agent_type: :supervisor, initial_state: 0, behavior: mid_b_start, restart: :permanent, shutdown: 0, flavor: :plain } } impl SupervisorMessage {});
        n_root2: int64 <- count_of(root);
        n_mid_b: int64 <- count_of_child(added.child);
        c1: int64 <- call_registered(:g4_counter_b, 5 impl ActorMessage {});
        k: actor_ref <- spawn(0, killer, stack_policy(1048576, :keep_last_message));
        killed: int64 <- call(k, 0 impl ActorMessage {});
        n_root3: int64 <- count_of(root);
        c2: int64 <- call_registered(:g4_counter_b, 5 impl ActorMessage {});
        print_int64(verdict(n_root == 1));
        println("");
        print_int64(verdict(case added.tag of { :child_started -> true; _: atom -> false }));
        println("");
        print_int64(verdict(n_root2 == 2));
        println("");
        print_int64(verdict(n_mid_b == 1));
        println("");
        print_int64(c1);
        println("");
        print_int64(killed);
        println("");
        print_int64(verdict(n_root3 == 2));
        println("");
        print_int64(c2);
        println("");
        println("done")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
