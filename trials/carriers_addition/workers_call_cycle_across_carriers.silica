// Carriers (actor_memory_budget_plan.md item N, stage 2): what a call
// cycle between two actors on two carriers does. Self-calls are rejected at compile time (E2240); longer
// cycles are deliberately not checked (Lee's decision, no runtime check at this point), so this is the
// behaviour, not a gap. A is spawned for core 1 and B for core 2,
// each registered so that each can call the other by name. A kicker (a cast-only relay) calls A;
// A's behaviour calls B; B's behaviour calls A. A is parked in its call to B, so B's call is mail
// A will never dispatch; B parks too, and so does the kicker. Nothing ends those waits: there is
// no cycle detection, by decision, and no timeout yet (chunk 11's call_with_timeout). What the stage guarantees
// is that only those actors are lost: a parked actor leaves its carrier, so both carriers are back
// in their loops and the siblings s1 (core 1) and s2 (core 2) still answer, and the process ends
// through wait_for_exit's `exit` line as any program does. The same holds with one carrier, where
// all share it, and with the gate off, where the three are threads blocked for ever.
//
//   s1 answers 7, s2 answers 9 after the cycle is in place; then `done` (the harness sends
//   `exit` after the marker and a quiet window).
//
// Expected output: 7, 9, done, exit status 0. The same with SILICA_CARRIERS=0 and at every carrier
// count. This output is expected to stay as it is.

use trial_wait_int64;

fn a_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        r: int64 <- call_registered(:carriers_cycle_b, msg + 1 impl ActorMessage {})
    produces
        pure (:reply, r, state)
    end
}

fn b_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        r: int64 <- call_registered(:carriers_cycle_a, msg + 1 impl ActorMessage {})
    produces
        pure (:reply, r, state)
    end
}

fn kicker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: int64 <- call_registered(:carriers_cycle_a, msg impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn echo(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                s1: actor_ref <- spawn(0, echo, stack_policy(1048576, :keep_last_message), 1);
                s2: actor_ref <- spawn(0, echo, stack_policy(1048576, :keep_last_message), 2);
                _: actor_ref <- spawn_registered(0, a_beh, :carriers_cycle_a, stack_policy(1048576, :keep_last_message), 1);
                _: actor_ref <- spawn_registered(0, b_beh, :carriers_cycle_b, stack_policy(1048576, :keep_last_message), 2);
                k: actor_ref <- spawn(0, kicker, stack_policy(1048576, :keep_last_message), 1);
                _: boolean <- cast(k, 0 impl ActorMessage {});
                r1: int64 <- call(s1, 7 impl ActorMessage {});
                r2: int64 <- call(s2, 9 impl ActorMessage {});
                print_int64(r1);
                println("");
                print_int64(r2);
                println("");
                println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
