// Carriers (actor_memory_budget_plan.md item N, stage 3): the error atoms of migrate_actor (spec
// §15.1.2). A core id the machine does not have (at or past the logical core count that
// get_cpu_topology reports) answers :invalid_target and the actor stays where it is; the core
// it is on answers :ok; an actor that has ended (remove_actor clears its alive flag before it
// returns) answers :actor_not_found. pin_actor_to_core with the bad core id is no move either.
// :migration_blocked is never produced on this target. Facts are equalities with a probe spawned
// for core 1, so they hold at every carrier count and with the gate off (where the thread actor's
// range check is the same).
//
// d's normal end is reported as every exit of an unsupervised actor is (the "root actor exited"
// line and a report with reason_tag 0), asynchronously: compared as a multiset.
//
// Expected output: :invalid_target, 9, :ok, :actor_not_found, 9, the root-exit line and d's
// report, exit status 0, as a multiset. The same with SILICA_CARRIERS=0 and at every carrier
// count.

use trial_support_int64;

fn probe(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        p1: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        a: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        d: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        i_p1: int64 <- actor_carrier_index(p1);
        m1: atom <- migrate_actor(a, 100000);
        _: atom <- print_atom(m1);
        println("");
        i1: int64 <- actor_carrier_index(a);
        print_int64(verdict(i1 == i_p1));
        println("");
        m2: atom <- migrate_actor(a, 1);
        _: atom <- print_atom(m2);
        println("");
        _: atom <- remove_actor(d);
        m3: atom <- migrate_actor(d, 1);
        _: atom <- print_atom(m3);
        println("");
        _: (int64, affinity_error) <- pin_actor_to_core(a, 100000);
        _: int64 <- call(a, 1 impl ActorMessage {});
        i2: int64 <- actor_carrier_index(a);
        print_int64(verdict(i2 == i_p1));
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 { drive() });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
