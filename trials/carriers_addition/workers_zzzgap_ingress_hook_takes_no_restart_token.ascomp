L_str_1:
    .quad -2
    .quad L_str_1_d
    .quad 1
L_str_1_d:
    .ascii "\n"
    .byte 0
    .p2align 3
L_str_2:
    .quad -2
    .quad L_str_2_d
    .quad 4
L_str_2_d:
    .ascii "done"
    .byte 0

L_newline:
    .byte 10

