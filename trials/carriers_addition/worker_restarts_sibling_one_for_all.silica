// Carriers (actor_memory_budget_plan.md item N, stage 1): a plain worker on the carrier asks a
// :one_for_all supervisor to restart one of its workers with :restart_child. The trial support's
// worker (the driver, a plain actor on the carrier) starts the supervisor with three counters and
// calls each once. call_supervisor runs :restart_child on the caller, and under :one_for_all it
// stops every child, one at a time, waiting for each row's exit_done (Lsrestart_ofa_wait) from the
// driver's own stack, parked under SILICA_CARRIERS=1, then respawns all three in order. Every
// replacement starts from its initial state again.
//
//   call a 5, b 5, c 5          -> 505, 605, 705
//   :restart_child of b         -> tag :child_started, 9  (three failure reports: a, b and c)
//   call a 5, the new b 7, c 5  -> 505, 607, 705  (all three reset)
//
// Expected output: 505, 605, 705, 9, 505, 607, 705, three failure reports of the counter
// (reason_tag 0: the supervisor's own stop sets no reason, as in supervisors_addition's
// phase_e_decl_10_one_for_all_restart_child), exit status 0, compared as a multiset. The same with
// SILICA_CARRIERS=0. Printed values avoid the digits 1-4 (compare_scout_multiset.sh folds those).

use Supervisor;
use trial_support_int64;

impl CarrierRestartOneForAllSup for Supervisor;

fn counter(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_all, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :carrier_restart_ofa_a, agent_type: :worker, initial_state: initial_state + 500, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :carrier_restart_ofa_b, agent_type: :worker, initial_state: initial_state + 600, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain },
            { id: :carrier_restart_ofa_c, agent_type: :worker, initial_state: initial_state + 700, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        sup: supervisor_ref <- spawn_registered_supervisor(CarrierRestartOneForAllSup, 0, :carrier_restart_ofa_sup, stack_policy(0, :keep_last_message));
        a1: int64 <- call_registered(:carrier_restart_ofa_a, 5 impl ActorMessage {});
        b1: int64 <- call_registered(:carrier_restart_ofa_b, 5 impl ActorMessage {});
        c1: int64 <- call_registered(:carrier_restart_ofa_c, 5 impl ActorMessage {});
        restarted: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :restart_child, id: :carrier_restart_ofa_b } impl SupervisorMessage {});
        a2: int64 <- call_registered(:carrier_restart_ofa_a, 5 impl ActorMessage {});
        b2: int64 <- call(restarted.child, 7 impl ActorMessage {});
        c2: int64 <- call_registered(:carrier_restart_ofa_c, 5 impl ActorMessage {});
        print_int64(a1);
        println("");
        print_int64(b1);
        println("");
        print_int64(c1);
        println("");
        print_int64(verdict(case restarted.tag of { :child_started -> true; _: atom -> false }));
        println("");
        print_int64(a2);
        println("");
        print_int64(b2);
        println("");
        print_int64(c2);
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 { drive() });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
