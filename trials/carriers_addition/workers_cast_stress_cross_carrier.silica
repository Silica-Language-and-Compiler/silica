// Carriers (actor_memory_budget_plan.md item N, stage 2): casts flooding actors on other carriers.
// Four cast-only counters are spawned for cores 1..4 (distinct carriers when there are four, shared
// when there are fewer) and the driver, bound in turn, casts 111 increments to each in an
// interleaved order, so the pushes land on four run queues from a fifth carrier (or main's thread
// when the gate is off) while those carriers are running, idle or asleep: every push that finds a
// carrier asleep wakes it (_silica_rt_actor_mail_signal -> _silica_rt_carrier_push). A counter that
// has drained its mail is marked idle and made ready by the next cast; one with mail waiting is
// re-queued. Each counter prints its total when it reaches the 111th message: the four lines come
// from four actors, in no fixed order (compared as a multiset).
//
//   counter k in {5, 6, 7, 9} receives 111 casts of k: 555, 666, 777, 999.
//
// The driver prints the `done` marker and main waits for the `exit` line (the harness sends it
// after the marker and a quiet window). Expected output: 555, 666, 777, 999 in any order, done,
// exit status 0. The same with SILICA_CARRIERS=0 and at every carrier count. The digits 1-4 and 8
// are avoided: compare_scout_multiset.sh folds them.

use trial_wait_int64;

fn counter(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        total: int64 <- state + msg;
        _: boolean <- case total == msg * 111 of {
            true -> {
                print_int64(total);
                println("");
                true
            };
            false -> false
        }
    produces
        pure (:no_reply, total)
    end
}

fn flood(c1: actor_ref, c2: actor_ref, c3: actor_ref, c4: actor_ref, n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            sequence proc[concurrency]
                _: boolean <- cast(c1, 5 impl ActorMessage {});
                _: boolean <- cast(c2, 6 impl ActorMessage {});
                _: boolean <- cast(c3, 7 impl ActorMessage {});
                _: boolean <- cast(c4, 9 impl ActorMessage {});
                rest: int64 <- flood(c1, c2, c3, c4, n - 1)
            produces
                pure rest
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                c1: actor_ref <- spawn(0, counter, stack_policy(1048576, :release_on_return), 1);
                c2: actor_ref <- spawn(0, counter, stack_policy(1048576, :release_on_return), 2);
                c3: actor_ref <- spawn(0, counter, stack_policy(1048576, :release_on_return), 3);
                c4: actor_ref <- spawn(0, counter, stack_policy(1048576, :release_on_return), 4);
                _: int64 <- flood(c1, c2, c3, c4, 111);
                println("done")
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
