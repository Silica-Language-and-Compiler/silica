// Carriers (actor_memory_budget_plan.md item N, stage 1): main is not an actor and has no carrier;
// its call keeps the futex wait while the callee, a plain actor on the carrier thread, serves the
// message and its reply wakes main's thread. main calls twice (the state carries over), prints both
// replies and returns 0, which ends the program without wait_for_exit (spec §15.1.2.5). The trial
// support's start() is called first only because a FailureReporter must be registered before any
// spawn (E2236).
//
// Expected output: 5, 12, exit status 0. The same with SILICA_CARRIERS=0.

use trial_support_int64;

fn counter(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        w: actor_ref <- spawn(0, counter, stack_policy(1048576, :keep_last_message));
        r1: int64 <- call(w, 5 impl ActorMessage {});
        r2: int64 <- call(w, 7 impl ActorMessage {});
        print_int64(r1);
        println("");
        print_int64(r2);
        println("")
    produces
        pure 0
    end
}
