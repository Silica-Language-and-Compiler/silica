Lph_w:
	mov	x0, #2
	mov	x1, x20
	mov	x2, #16
	bl	_write
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
