	mov	x29, sp
	bl	_silica_rt_ensure_actor_tls_key
	adrp	x8, _silica_actor_pthread_key@PAGE
	add	x8, x8, _silica_actor_pthread_key@PAGEOFF
	ldr	x0, [x8]
	bl	_pthread_getspecific
	cbz	x0, Loct_ret
	ldr	x0, [x0, #8]
Loct_ret:
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_carrier_self_on_own_stack
	.p2align	2
_silica_rt_carrier_self_on_own_stack:
; -> X0 = the carrier actor this thread runs when the caller is on that actor's own stack (it can
; park), else 0: main, an actor thread, or a runtime path on the carrier's own stack. The parked
; actor is the one the carrier runs (carrier +40), not the thread's current actor: an ingress drain
; installs the supervisor as the current actor while it runs on the drainer's stack.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_on_carrier_thread
	cbz	x0, Lcso_ret
	ldr	x0, [x0, #40]
	cbz	x0, Lcso_ret
	mov	x9, sp
	ldr	x10, [x0, #272]
	cmp	x9, x10
	b.lo	Lcso_no
	ldr	x11, [x0, #280]
	add	x10, x10, x11
	cmp	x9, x10
	b.hs	Lcso_no
	b	Lcso_ret
Lcso_no:
	mov	x0, xzr
Lcso_ret:
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_sup_on_own_dispatch
	.p2align	2
_silica_rt_sup_on_own_dispatch:
; X0 = a supervisor -> X0 = 1 when this thread is the supervisor's carrier running the supervisor
; itself (carrier +40: its own dispatch, the ingress served at LBB1_ingress_no_beh or a drain
; from its reply path, or its exit path), 0 anywhere else: a drain on another actor's stack
; (which installs the supervisor as the thread's CURRENT actor, so that word cannot be the
; test), main, or a dangerous actor's thread. The one place the restart-intensity breach and the
; duplicate-child-id failure make their synchronous root report, with the children shut down
; first: that wait could otherwise wait on the drainer itself (prims_actors_child_table_asm,
; Lmr_freq_escalate). What the thread identity (pthread_self against ACB #144) answered when a
; supervisor had a thread of its own.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	bl	_silica_rt_on_carrier_thread
	cbz	x0, Lsod_no
	ldr	x0, [x0, #40]
	cmp	x0, x19
	cset	x0, eq
	b	Lsod_ret
Lsod_no:
	mov	x0, xzr
Lsod_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_wait_park
	.p2align	2
_silica_rt_wait_park:
; X0 = the carrier actor parking (on its own stack), X1 = the wait list it joins (the address of
; the head word: a row's +120 or a supervision block's +128; the links are ACB #456, the list is
; recorded in #480 for a stop to find), X2 = the thread's current actor to restore after the
; resume. Called with the actor's lock and the wait lock held: it publishes status 4 (parked)
; under both, releases them and leaves for the carrier loop. Returns, with no lock held, when the
; actor has been made ready again (by the list's wake or by a stop that unlinked it).
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	ldr	x22, [x19, #440]
	mov	x0, x19
	bl	_silica_rt_ctx_save
	cbnz	x0, Lwpk_resumed
	ldr	x9, [x20]
	str	x9, [x19, #456]
	str	x19, [x20]
	str	x20, [x19, #480]
	mov	x9, #4
	str	x9, [x19, #448]
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
; The loop of the carrier this thread is (X22, read before the park was published).
	mov	x0, x22
	b	_silica_rt_carrier_loop_enter
Lwpk_resumed:
; The carrier made this actor the thread's current actor at the resume; the wait was entered with
; X21 as the current actor (the supervisor, in an ingress drain).
	cmp	x21, x19
	b.eq	Lwpk_ret
	mov	x0, x21
	bl	_silica_rt_tls_actor_set
Lwpk_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	_silica_rt_wait_list_wake
	.p2align	2
_silica_rt_wait_list_wake:
; X0 = the address of a wait list's head word: takes the whole list under the wait lock and makes
; every actor on it ready, each under its own lock, none under the wait lock. An actor on the list
; that is not parked cannot happen (it was parked under both locks, and only this wake or a stop,
; which unlinks it under the wait lock first, changes that): a runtime abort.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x20, [x19]
	str	xzr, [x19]
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
Lwlw_wake:
	cbz	x20, Lwlw_ret
	ldr	x19, [x20, #456]
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	ldr	x9, [x20, #448]
	cmp	x9, #4
	b.ne	Lwlw_not_parked
	str	xzr, [x20, #480]
	mov	x9, #2
	str	x9, [x20, #448]
	mov	x0, x20
	bl	_silica_rt_carrier_push
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x20, x19
	b	Lwlw_wake
Lwlw_not_parked:
	adrp	x0, Lrta_r_row_wake@PAGE
	add	x0, x0, Lrta_r_row_wake@PAGEOFF
	bl	_silica_rt_abort_with
Lwlw_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_row_wait
	.p2align	2
_silica_rt_row_wait:
; X0 = a row, X1 = the identity (ACB #408) of the child whose exit is waited for, X2 = 1 when that
; child is a carrier actor (0 = unknown), X3 = the waiting actor or 0 (main, or a wait that no stop
; may end). -> X0 = 1 once the row's exit_done (+56) holds that identity, 2 when X3 was ended
; meanwhile (its supervisor's cascade stops it while it waits in kill_abnormal: the wait is over
; and the victim is dead or dying). exit_done is a generation word, never cleared: the identity of
; the last child of the row that ended; a stale value from an earlier incarnation never matches.
; A carrier actor on its own stack parks on the row's wait list (the exit_done store wakes it, so
; does a stop of the waiter); anything else spins (main, a dangerous actor's thread). A runtime
; path on a carrier's own stack never comes here (every waiting path runs on the actor's own
; stack: the module header); when the awaited child is a carrier actor that is a runtime abort
; rather than a silent deadlock (the child could never run on the stack being spun on when it is
; bound to this carrier).
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	mov	x22, x2
	mov	x23, x3
	bl	_silica_rt_carrier_self_on_own_stack
	mov	x21, x0
	cbz	x21, Lrw_spin
	bl	_silica_rt_tls_current_actor_get
	mov	x24, x0
Lrw_park_loop:
; The check and the push onto the row's wait list are one critical section under the wait lock
; (the exit side stores exit_done and takes the list under it; a stop sets the waiter's alive flag
; under the waiter's own lock), so no wake is lost.
	add	x0, x21, #16
	bl	_os_unfair_lock_lock
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x8, [x19, #56]
	cmp	x8, x20
	b.eq	Lrw_done_locked
	cbz	x23, Lrw_park
	ldr	w8, [x23, #152]
	cbz	w8, Lrw_stopped_locked
Lrw_park:
	mov	x0, x21
	add	x1, x19, #120
	mov	x2, x24
	bl	_silica_rt_wait_park
	b	Lrw_park_loop
Lrw_done_locked:
	mov	x23, #1
	b	Lrw_unlock_ret
Lrw_stopped_locked:
	mov	x23, #2
Lrw_unlock_ret:
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	add	x0, x21, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x23
	b	Lrw_ret
Lrw_spin:
	cbz	x22, Lrw_spin_loop
	bl	_silica_rt_on_carrier_thread
	cbz	x0, Lrw_spin_loop
	adrp	x0, Lrta_r_carrier_wait@PAGE
	add	x0, x0, Lrta_r_carrier_wait@PAGEOFF
	bl	_silica_rt_abort_with
Lrw_spin_loop:
	ldr	x8, [x19, #56]
	cmp	x8, x20
	b.eq	Lrw_spin_done
	cbz	x23, Lrw_spin_loop
	ldr	w8, [x23, #152]
	cbnz	w8, Lrw_spin_loop
	mov	x0, #2
	b	Lrw_ret
Lrw_spin_done:
	mov	x0, #1
Lrw_ret:
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	_silica_rt_row_exit_done_store
	.p2align	2
_silica_rt_row_exit_done_store:
; X0 = a row whose child has ended (_silica_rt_sb_child_done, the child's last act), X1 = that
; child's identity: exit_done (+56) = the identity, under the wait lock, then every carrier actor
; parked on the row's wait list (+120) is made ready; each re-checks the identity it waits for.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	str	x20, [x19, #56]
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	add	x0, x19, #120
	bl	_silica_rt_wait_list_wake
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_actor_stop
	.p2align	2
_silica_rt_actor_stop:
; X0 = an actor to end at its next dispatch boundary, X1 = the exit reason tag to give it (0 keeps
; what it has: a supervisor's own stop, reason 0 in its report), X2 = the reason atom that goes
; with a tag (#384; 0 = none). -> X0 = 1 when it is a carrier actor. The one way the runtime ends
; another actor: under the target's lock its alive flag goes, the reason (tag and atom) is set
; only while it was still alive (an actor already ending keeps its own), its
; mailbox is signalled (an idle carrier actor is made ready), and an actor parked on a wait list
; (a row's exit_done, a supervision block's restart token: #480 names the list) is unlinked under
; the wait lock and made ready, so a wait that this stop ends (kill_abnormal's) sees it at once. A
; parked actor the list's wake has already taken (not found on the list) is made ready by that wake.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	w8, [x19, #152]
	cbz	w8, Lsto_was_ended
	cbz	x20, Lsto_was_ended
	str	x20, [x19, #232]
	cbz	x21, Lsto_was_ended
	str	x21, [x19, #384]
Lsto_was_ended:
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	ldr	x22, [x19, #440]
	cbz	x22, Lsto_unlock
	ldr	x9, [x19, #448]
	cmp	x9, #4
	b.ne	Lsto_unlock
	ldr	x21, [x19, #480]
	cbz	x21, Lsto_unlock
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x9, [x21]
	mov	x10, xzr
Lsto_find:
