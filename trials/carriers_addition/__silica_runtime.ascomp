	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	adrp	x20, _silica_rt_fault_hexbuf@PAGE
	add	x20, x20, _silica_rt_fault_hexbuf@PAGEOFF
