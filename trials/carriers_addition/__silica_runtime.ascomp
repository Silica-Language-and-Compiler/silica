; X0 = ucontext -> W0 = 1 when the fault interrupted code running on this thread's alternate signal
; stack. Only the signal handler, and the runtime code it calls or leaves the thread in, runs there, so
; that is a fault inside the handler. The test keeps no state: a per-thread in-handler flag would stay
; set after the handler leaves by siglongjmp (guarded FFI recovery, an actor failing) and would need
; TLS, whose first use can allocate. sigaltstack(NULL, &ss) is a plain system call. A thread without an
; alternate stack (SS_DISABLE) answers 0; every thread the runtime creates has one. The bounds are strict at both
; ends: an actor's execution stack can be mapped directly below the alternate stack, so its top is
; the alternate stack's base, and the growth fault of the first push of a behavior interrupts code
; whose SP is exactly that base (a whole trial of idle actors reported a fault instead of running).
	.p2align	2
_silica_rt_fault_in_handler:
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	str	x19, [sp, #16]
	cbz	x0, Lfih_no
; Darwin: uc_mcontext pointer at +48; __ss.__sp at mcontext +264 (__ss.__pc is +272).
	ldr	x9, [x0, #48]
	cbz	x9, Lfih_no
	ldr	x19, [x9, #264]
; Darwin stack_t at sp+24: ss_sp @0, ss_size @8, ss_flags (int) @16.
	mov	x0, xzr
	add	x1, sp, #24
	bl	_sigaltstack
	cbnz	w0, Lfih_no
	ldr	w9, [sp, #40]
	tbnz	w9, #2, Lfih_no
	ldr	x9, [sp, #24]
	ldr	x10, [sp, #32]
	cmp	x19, x9
	b.ls	Lfih_no
	add	x10, x9, x10
	cmp	x19, x10
	b.hs	Lfih_no
	mov	w0, #1
	b	Lfih_ret
Lfih_no:
	mov	w0, #0
Lfih_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
; Last-resort fault report (spec §15.4.5.5): X0 = siginfo, X1 = ucontext of the fault raised inside the
; handler. Writes the line [silica] fault at 0x<pc>  addr=0x<fault address> and ends with _exit(70). It uses
; only write(2) and _exit: no dladdr (it takes the loader's lock, which the faulting handler may hold,
; and it may be what faulted), no TLS, no actor fields. The first handler may have written part of its
; own line; the report tools fold everything after the first fault banner on a line. Never returns.
	.p2align	2
_silica_rt_fault_last_resort:
	mov	x19, x0
	mov	x20, xzr
	mov	x21, xzr
	cbz	x1, Llr_addr
	ldr	x9, [x1, #48]
	cbz	x9, Llr_addr
	ldr	x20, [x9, #272]
Llr_addr:
	cbz	x19, Llr_write
	ldr	x21, [x19, #24]
Llr_write:
	adrp	x0, Lpfs_pre@PAGE
	add	x0, x0, Lpfs_pre@PAGEOFF
	bl	_silica_rt_fault_puts
	mov	x0, x20
	bl	_silica_rt_fault_puthex
	adrp	x0, Lpfs_ad@PAGE
	add	x0, x0, Lpfs_ad@PAGEOFF
	bl	_silica_rt_fault_puts
	mov	x0, x21
	bl	_silica_rt_fault_puthex
	adrp	x0, Lpfs_eol@PAGE
	add	x0, x0, Lpfs_eol@PAGEOFF
	bl	_silica_rt_fault_puts
	mov	w0, #70
	bl	__exit
Llr_hang:
	b	Llr_hang
	.p2align	2
_silica_rt_fault_bufcat:
	mov	x4, x2
Lbc_loop:
	ldrb	w5, [x3], #1
	cbz	w5, Lbc_out
	cmp	x4, x1
	b.hs	Lbc_out
	add	x6, x0, x4
	strb	w5, [x6]
	add	x4, x4, #1
	b	Lbc_loop
Lbc_out:
	mov	x0, x4
	ret
	.p2align	2
_silica_rt_fault_bufhex:
	mov	x4, x2
	adrp	x7, Lpfs_nib@PAGE
	add	x7, x7, Lpfs_nib@PAGEOFF
	mov	x5, #0
Lbh_loop:
	cmp	x5, #16
	b.hs	Lbh_out
	cmp	x4, x1
	b.hs	Lbh_out
	mov	x6, #60
	sub	x6, x6, x5, lsl #2
	lsr	x8, x3, x6
	and	x8, x8, #0xf
	ldrb	w9, [x7, x8]
	add	x10, x0, x4
	strb	w9, [x10]
	add	x4, x4, #1
	add	x5, x5, #1
	b	Lbh_loop
Lbh_out:
	mov	x0, x4
	ret
	.globl	_silica_rt_fault_site_snprint
	.p2align	2
_silica_rt_fault_site_snprint:
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	adrp	x21, _silica_rt_fault_pc@PAGE
	add	x21, x21, _silica_rt_fault_pc@PAGEOFF
	ldr	x22, [x21]
	cbz	x22, Lfss_zero
	mov	x23, #0
	mov	x0, x19
	mov	x1, x20
	mov	x2, x23
	adrp	x3, Lfss_pre@PAGE
	add	x3, x3, Lfss_pre@PAGEOFF
	bl	_silica_rt_fault_bufcat
	mov	x23, x0
	mov	x0, x19
	mov	x1, x20
	mov	x2, x23
	mov	x3, x22
	bl	_silica_rt_fault_bufhex
	mov	x23, x0
	mov	x0, x22
	adrp	x1, _silica_rt_fault_dlinfo@PAGE
	add	x1, x1, _silica_rt_fault_dlinfo@PAGEOFF
	bl	_dladdr
	cbz	w0, Lfss_eol
	adrp	x24, _silica_rt_fault_dlinfo@PAGE
	add	x24, x24, _silica_rt_fault_dlinfo@PAGEOFF
	ldr	x2, [x24, #16]
	cbz	x2, Lfss_eol
	mov	x0, x19
	mov	x1, x20
	mov	x2, x23
	adrp	x3, Lpfs_in@PAGE
	add	x3, x3, Lpfs_in@PAGEOFF
	bl	_silica_rt_fault_bufcat
	mov	x23, x0
	ldr	x3, [x24, #16]
	mov	x0, x19
	mov	x1, x20
	mov	x2, x23
	bl	_silica_rt_fault_bufcat
	mov	x23, x0
	ldr	x3, [x24, #24]
	cbz	x3, Lfss_eol
	sub	x22, x22, x3
	mov	x0, x19
	mov	x1, x20
	mov	x2, x23
	adrp	x3, Lpfs_plus@PAGE
	add	x3, x3, Lpfs_plus@PAGEOFF
	bl	_silica_rt_fault_bufcat
	mov	x23, x0
	mov	x0, x19
	mov	x1, x20
	mov	x2, x23
	mov	x3, x22
	bl	_silica_rt_fault_bufhex
	mov	x23, x0
Lfss_eol:
	mov	x0, x19
	mov	x1, x20
	mov	x2, x23
	adrp	x3, Lpfs_eol@PAGE
	add	x3, x3, Lpfs_eol@PAGEOFF
	bl	_silica_rt_fault_bufcat
	b	Lfss_out
Lfss_zero:
	mov	x0, #0
Lfss_out:
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
