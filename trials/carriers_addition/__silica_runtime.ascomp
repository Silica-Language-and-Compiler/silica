	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_cv_signal
	.p2align	2
_silica_rt_cv_signal:                   ; X0 = cv_addr (4-byte futex word). Caller must hold the lock paired with this CV.
	.cfi_startproc
	stp	x29, x30, [sp, #-32]!
	stp	x19, x20, [sp, #16]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	mov	x19, x0
; bump seq (32-bit; wraparound after 4G signals is fine — only mismatch w/ waiter snapshot matters)
	ldr	w8, [x19]
	add	w8, w8, #1
	str	w8, [x19]
; ___ulock_wake(UL_COMPARE_AND_WAIT_SHARED=3, cv_addr, 0).
; bsd/sys/ulock.h: userland heap futex words use UL_COMPARE_AND_WAIT_SHARED (3).
	mov	w0, #3
	mov	x1, x19
	mov	x2, #0
	bl	___ulock_wake
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.cfi_endproc
	.globl	_silica_rt_cv_wait
	.p2align	2
_silica_rt_cv_wait:                     ; X0 = cv_addr, X1 = lock_addr. Caller must hold lock; lock held on return.
	.cfi_startproc
	stp	x29, x30, [sp, #-48]!
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0                         ; cv_addr (callee-saved)
	mov	x20, x1                         ; lock_addr (callee-saved)
; snapshot seq (under lock)
	ldr	w22, [x19]
; release lock
	mov	x0, x20
	bl	_os_unfair_lock_unlock
; ___ulock_wait(UL_COMPARE_AND_WAIT_SHARED=3, cv_addr, snapshot, 0 = no timeout).
	mov	w0, #3
	mov	x1, x19
	mov	x2, x22
	mov	w3, #0
	bl	___ulock_wait
; re-acquire lock
	mov	x0, x20
	bl	_os_unfair_lock_lock
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.cfi_endproc
	.section	__TEXT,__text,regular,pure_instructions
; --- Phase E e3a Option B: linked-list child table ---
; _silica_rt_child_table_free: X0=ACB* — walk nodes (+80 next), free each, clear anchors.
; _silica_rt_child_table_ensure_min_cap: X0=ACB*, X1=min node count — X0=0 ok, 1 OOM. Appends 88 B nodes (80 B row + next) until count >= X1.
	.globl	_silica_rt_child_table_free
	.p2align	2
_silica_rt_child_table_free:
	.cfi_startproc
	stp	x20, x19, [sp, #-32]!
	str	x30, [sp, #16]
	.cfi_def_cfa wsp, 32
	.cfi_offset w20, -32
	.cfi_offset w19, -24
	.cfi_offset w30, -16
	mov	x19, x0
