	b.le	Lwi_cmp_exit
	sub	x21, x20, #1
	add	x9, sp, #144
	ldrb	w9, [x9, x21]
	cmp	w9, #13
	b.ne	Lwi_cmp_exit
	mov	x20, x21
	b	Lwi_trim_cr
Lwi_cmp_exit:
	cmp	x20, #4
	b.ne	Lwi_line_reset
	add	x21, sp, #144
	ldrb	w9, [x21]
	cmp	w9, #101
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #1]
	cmp	w9, #120
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #2]
	cmp	w9, #105
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #3]
	cmp	w9, #116
	b.ne	Lwi_line_reset
	b	Lwi_process_exit
Lwi_line_reset:
