	ldrb	w8, [x9]
	orr	w8, w8, w11
	strb	w8, [x9]
	str	xzr, [sp, #128]
	movz	w9, #0xd090
	movk	w9, #3, lsl #16
	str	w9, [sp, #136]
	add	w0, w22, #1
	mov	x1, sp
	mov	x2, xzr
	mov	x3, xzr
	add	x4, sp, #128
