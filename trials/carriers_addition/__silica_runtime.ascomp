	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_stack_on_message_return
	.p2align	2
_silica_rt_stack_on_message_return:
; X0 = ACB. The behavior has returned and the stack is empty: apply the actor's release algorithm.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	ldr	x8, [x19, #272]
	cbz	x8, Lsmr_ret
	ldr	x9, [x19, #312]
	cmp	x9, #5
	b.eq	Lsmr_keep_all
	cmp	x9, #4
	b.eq	Lsmr_idle_stamp
	cmp	x9, #1
	b.eq	Lsmr_release_all
	mov	x0, x19
	bl	_silica_rt_stack_measure
	mov	x20, x0
	ldr	x9, [x19, #312]
	cmp	x9, #3
	b.ne	Lsmr_keep_depth
	ldr	x10, [x19, #328]
	cbz	x10, Lsmr_keep_depth
	ldr	x11, [x19, #336]
	and	x12, x11, #31
	str	x20, [x10, x12, lsl #3]
	add	x11, x11, #1
	str	x11, [x19, #336]
	mov	x12, xzr
	mov	x21, xzr
Lsmr_ring_max:
	ldr	x13, [x10, x12, lsl #3]
	cmp	x13, x21
	csel	x21, x13, x21, hi
	add	x12, x12, #1
	cmp	x12, #32
	b.lo	Lsmr_ring_max
	b	Lsmr_release_keep
Lsmr_keep_depth:
	mov	x21, x20
Lsmr_release_keep:
	mov	x0, x19
	mov	x1, x21
	mov	x2, x20
	bl	_silica_rt_stack_release_to
	b	Lsmr_ret
Lsmr_keep_all:
	ldr	x10, [x19, #288]
	str	x10, [x19, #320]
	b	Lsmr_ret
Lsmr_idle_stamp:
	ldr	x10, [x19, #288]
	str	x10, [x19, #320]
	bl	_silica_rt_stack_now_ns
	str	x0, [x19, #344]
	b	Lsmr_ret
Lsmr_release_all:
