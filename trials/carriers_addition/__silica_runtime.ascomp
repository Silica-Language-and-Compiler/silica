	.globl	_silica_rt_actor_fail_current
	.p2align	2
_silica_rt_actor_fail_current:
; X0 = the current actor's ACB, X1 = reason atom. Ends the actor with (:explicit, atom): wakes its
; waiters, delivers the exit to its supervisor, frees what it owns and exits the thread. For a
; dangerous actor (a thread of its own) it runs on the signal alt stack (stack exhaustion) or on
; the actor stack (a spawn whose reservation failed). For a carrier actor it is entered on the
; carrier's stack (the fault handler returns into it there, through the signal frame, so the
; carrier's alternate-stack state is intact for the next fault) or on the actor's own (a failed
; spawn inside a behaviour or a start trampoline, a duplicate child id) and ends in the carrier
; loop; the reservation is freed first, before any waiter is woken, unless the actor has a
; supervision block (X20 = 1): then its children are shut down in the delivering phase, each
; waited for, and the waits park, which needs a stack the carrier loop leaves alone: the top of
; its own reservation (every frame below it is abandoned: a fault's signal frame was unwound by
; the kernel, a failed spawn never returns), unmapped after that phase instead.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	str	x1, [x19, #384]
	ldr	x21, [x19, #440]
	mov	x20, xzr
	cbz	x21, Lafc_thread_actor
	ldr	x9, [x19, #216]
	cbz	x9, Lafc_carrier_stack
	ldr	x9, [x19, #272]
	cbz	x9, Lafc_carrier_stack
	ldr	x10, [x19, #280]
	add	x9, x9, x10
	mov	sp, x9
	mov	x20, #1
	b	Lafc_deliver
Lafc_carrier_stack:
	ldr	x9, [x21, #48]
	mov	sp, x9
	b	Lafc_on_stack
Lafc_thread_actor:
; Move onto the thread's alt stack (its top; nothing there is needed again) so the actor stack
; this may be running on can be unmapped now. On the exhaustion path we are already there.
; The stack is given back before any waiter is woken, as at a message boundary: a caller that
; wakes on the death and asks get_actor_memory_usage must already see the reservation gone.
	ldr	x9, [x19, #352]
	cbz	x9, Lafc_on_stack
	mov	x10, #65536
	add	x9, x9, x10
	mov	sp, x9
Lafc_on_stack:
	mov	x0, x19
	mov	x1, #1
	bl	_silica_rt_actor_stack_free
Lafc_deliver:
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x8, #4
	str	x8, [x19, #232]
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x8, [x19, #216]
	cbz	x8, Lsbg_5
	ldr	x8, [x8, #40]
Lsbg_5:
	cbnz	x8, Lafc_report_done
	mov	x0, x19
	bl	_silica_rt_actor_deliver_exit
	mov	x0, x19
	bl	_silica_rt_actor_deliver_unwind_report
Lafc_report_done:
; The started word (#224) is set after the report so a spawner spinning on it (actor_spawn /
; spawn_linked, while this actor's start trampoline ran) proceeds: 2 = the init trampoline failed (stack exhausted, a failed spawn reservation, a duplicate child id). The ACB is
; not freed under the spawner: it goes with its last holder (_silica_rt_acb_release); a row child's
; exit notice is parked at #400 until its spawner has committed it to the row.
	ldr	x8, [x19, #224]
	cbnz	x8, Lafc_started_set
	mov	x0, x19
	mov	x1, #2
	bl	_silica_rt_started_store
Lafc_started_set:
	mov	x0, x19
	bl	_silica_rt_actor_signal_pending_call_deaths
	mov	x0, x19
	bl	_silica_rt_ffi_arena_teardown
	mov	x0, x19
	bl	_silica_rt_child_table_free
; The delivering phase ran on the reservation (X20): nothing waits any more, so onto the carrier's
; stack and the reservation goes.
	cbz	x20, Lafc_stack_done
	ldr	x9, [x21, #48]
	mov	sp, x9
	mov	x0, x19
	mov	x1, xzr
	bl	_silica_rt_actor_stack_free
Lafc_stack_done:
	mov	x0, x19
	bl	_silica_rt_actor_dealloc_region
	mov	x0, x19
	bl	_silica_rt_actor_final_release
	cbz	x21, Lafc_thread_exit
	mov	x0, x21
	b	_silica_rt_carrier_loop_enter
Lafc_thread_exit:
	mov	x0, xzr
	bl	_pthread_exit
	b	Lafc_thread_exit
