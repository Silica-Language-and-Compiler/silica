	.section	__DATA,__bss
	.p2align	3
	.globl	_silica_rt_canonical_arena_table
_silica_rt_canonical_arena_table:
	.space	8192
	.globl	_silica_rt_canonical_arena_count
_silica_rt_canonical_arena_count:
	.space	8
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_canonical_arena_lookup
	.p2align	2
_silica_rt_canonical_arena_lookup:
	.cfi_startproc
; X0 = stable specialization key (non-zero) -> X0 = region base pointer
	stp	x21, x20, [sp, #-48]!
	stp	x19, x30, [sp, #16]
	.cfi_offset w30, -8
	.cfi_offset w19, -16
	.cfi_offset w20, -24
	.cfi_offset w21, -32
	mov	x19, x0
	cbz	x19, Lcal_abort_key
	mov	w20, #512
	mov	w9, w20
	udiv	w10, w19, w9
	msub	w8, w10, w9, w19
	mov	w21, wzr
Lcal_probe:
	cmp	w21, w20
	b.hs	Lcal_abort_full
	ubfiz	x11, x8, #4, #32
	adrp	x12, _silica_rt_canonical_arena_table@PAGE
	add	x12, x12, _silica_rt_canonical_arena_table@PAGEOFF
	add	x12, x12, x11
	ldr	x13, [x12]
	cbz	x13, Lcal_insert
	cmp	x13, x19
	b.eq	Lcal_found
	add	w8, w8, #1
	cmp	w8, w20
	csel	w8, wzr, w8, eq
	add	w21, w21, #1
	b	Lcal_probe
Lcal_found:
	ldr	x0, [x12, #8]
	ldp	x19, x30, [sp, #16]
	ldp	x21, x20, [sp], #48
	ret
Lcal_insert:
	stp	x12, x13, [sp, #-16]!
	mov	x0, #4128
	bl	_malloc
	ldp	x12, x13, [sp], #16
	cbz	x0, Lcal_abort_nomem
	add	x14, x0, #32
	str	x14, [x0]
	mov	x15, #4128
	add	x14, x0, x15
	str	x14, [x0, #8]
	str	xzr, [x0, #16]
	str	x14, [x0, #24]
	str	x19, [x12]
	str	x0, [x12, #8]
	adrp	x13, _silica_rt_canonical_arena_count@PAGE
	add	x13, x13, _silica_rt_canonical_arena_count@PAGEOFF
	ldr	x14, [x13]
	add	x14, x14, #1
	str	x14, [x13]
	ldp	x19, x30, [sp, #16]
	ldp	x21, x20, [sp], #48
	ret
Lcal_abort_key:
	bl	_silica_rt_abort_arena_key
Lcal_abort_full:
	bl	_silica_rt_abort_arena_full
Lcal_abort_nomem:
	bl	_silica_rt_abort_arena_nomem
	.cfi_endproc
	.globl	_silica_rt_canonical_arena_same
	.p2align	2
_silica_rt_canonical_arena_same:
	.cfi_startproc
; X0 = region A, X1 = region B -> X0 = 1 if same identity else 0
	cmp	x0, x1
	cset	w0, eq
	and	x0, x0, #1
	ret
	.cfi_endproc

