	add	x8, x8, _silica_rt_root_failure_reporter@PAGEOFF
	ldr	x8, [x8]
	mov	x0, #0
	cbz	x8, Lrne_ret
	bl	_silica_rt_root_note_write
	mov	x0, #1
Lrne_ret:
	ldp	x29, x30, [sp], #16
	ret
