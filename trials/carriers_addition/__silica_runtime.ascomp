; #440 may change once it is parked (a migration applied at its boundary elsewhere).
	mov	x0, x21
	b	_silica_rt_carrier_loop_enter
Lsws_started:
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	b	Lsws_ret
Lsws_spin:
	add	x9, x19, #224
Lsws_spin_loop:
	ldar	x8, [x9]
	cbz	x8, Lsws_spin_loop
Lsws_ret:
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_on_carrier_thread
	.p2align	2
_silica_rt_on_carrier_thread:
; -> X0 = the carrier block when this thread is a carrier's (the second word of the thread's
; record), else 0.
