; X0 = atom: kill_abnormal of the actor that holds the name in the ordinary registry (§20.3.1); no
; holder is :ok. An identity can be numerically small, so atoms have their own entry (§15.1.4).
	mov	x11, x0
	cmp	x11, #0
	b.lt	Lkabn_none
	adrp	x13, _silica_registry_slots@PAGE
	ldr	x13, [x13, _silica_registry_slots@PAGEOFF]
