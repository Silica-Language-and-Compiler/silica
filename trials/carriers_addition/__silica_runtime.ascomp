	cset	x0, ne
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_sup_restart_try
	.p2align	2
_silica_rt_sup_restart_try:
; X0 = a supervisor, X1 = the actor asking (0 = main). -> X0 = 1 when the caller now holds the
; supervisor's restart token (supervision block #120: the holder, or 1 for main), 0 when another
; holder has it, or the supervisor has no block or has ended. One holder at a time dequeues its
; ingress and runs the restarts (maybe_restart with its cascades), so no two cascades overlap.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x8, [x19, #216]
	cbz	x8, Lsrt_no
	ldr	w9, [x19, #152]
	cbz	w9, Lsrt_no
	ldr	x9, [x8, #120]
	cbnz	x9, Lsrt_no
	mov	x9, x20
	cbnz	x9, Lsrt_take
	mov	x9, #1
Lsrt_take:
	str	x9, [x8, #120]
	mov	x20, #1
	b	Lsrt_unlock
Lsrt_no:
	mov	x20, xzr
Lsrt_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x20
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_sup_restart_release
	.p2align	2
_silica_rt_sup_restart_release:
; X0 = a supervisor whose restart token the caller holds: lets it go. Notices still in the ingress
; are the supervisor's own thread's to drain (its mailbox is signalled; the thread skips the ingress
; while another holder has the token), and every actor parked for the token (block +128) is made
; ready to re-check.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x20, [x19, #216]
	cbz	x20, Lsrr_unlock
	str	xzr, [x20, #120]
	ldr	x9, [x20]
	ldr	x10, [x20, #8]
	orr	x9, x9, x10
	cbz	x9, Lsrr_unlock
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
Lsrr_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	cbz	x20, Lsrr_ret
	add	x0, x20, #128
	bl	_silica_rt_wait_list_wake
Lsrr_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_sup_restart_acquire
	.p2align	2
_silica_rt_sup_restart_acquire:
; X0 = a supervisor, X1 = the actor asking (0 = main), X2 = 1 to take the restart token, 0 to wait
; until the token is free and the ingress is empty (a row child of this supervisor never takes the
; token: the cascade it would run could stop the child itself; it waits for the holder, the
; supervisor's own dispatch or another drainer, to finish). -> X0 = 1 taken / settled, 2 when X1
; was ended while it waited (its supervisor's cascade stops it: the caller's wait is over), 0 when
; the supervisor has no block or has ended (nothing to drain or wait for). A carrier actor on its
; own stack parks on the block's wait list (+128; a release wakes it, so does a stop of the
; waiter); anything else (main, a dangerous actor's thread) polls. Lock order everywhere: the
; waiting actor, then the supervisor, then the wait lock, then (in the push of a woken actor) its
; carrier's lock. The waiting actor may BE the supervisor (its reply path drains its own ingress,
; LBB1_reply_drain, on its own stack): the one lock is then taken once and serves both positions
; (os_unfair_lock is not recursive).
