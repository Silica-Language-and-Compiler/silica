	.globl	_silica_rt_carrier_adopt
	.p2align	2
_silica_rt_carrier_adopt:
; X0 = a new ACB (reservation made, arena bookkeeping set), X1 = its start trampoline (0 = none),
; X2 = 1 for a dangerous actor. -> X0 = 1 when the actor was given to a carrier (no thread is to
; be made): every actor but a dangerous one, whose foreign calls may block and whose guarded-FFI
; state is per thread, so it keeps a thread of its own (X0 = 0). A supervisor or any other actor
; with a trampoline is bound and made READY (status 2, on its carrier's run queue) instead of
; started: its first dispatch runs the trampoline (Lcar_first) and then stores the started word
; (#224), which its spawner waits for; an actor without one is idle and started at once. The
; carrier: `core mod N` for a core id (#208) that names one of the machine's logical cores, 1 ..
; _silica_rt_logical_cpu_count - 1 (a row child's #208 is its row pointer, no core id; 0 is the
; default; a core the machine does not have is placed in turn, the board's rule for an
; out-of-range core at spawn); else the next carrier in turn.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x22, x1
	cbnz	x2, Lcad_no
	bl	_silica_rt_carriers_ensure
	mov	x21, x0
	adrp	x8, _silica_rt_carrier_count@PAGE
	add	x8, x8, _silica_rt_carrier_count@PAGEOFF
	ldr	x10, [x8]
	ldr	x9, [x19, #208]
	cmp	x9, #4096
	b.hs	Lcad_in_turn
	cbz	x9, Lcad_in_turn
	adrp	x8, _silica_rt_logical_cpu_count@PAGE
	add	x8, x8, _silica_rt_logical_cpu_count@PAGEOFF
	ldr	x11, [x8]
	cmp	x9, x11
	b.hs	Lcad_in_turn
	udiv	x11, x9, x10
	msub	x9, x11, x10, x9
	b	Lcad_have_index
Lcad_in_turn:
	adrp	x8, _silica_rt_carrier_next@PAGE
	add	x8, x8, _silica_rt_carrier_next@PAGEOFF
Lcad_turn_loop:
	ldaxr	x9, [x8]
	add	x11, x9, #1
	cmp	x11, x10
	b.lo	Lcad_turn_store
	mov	x11, xzr
Lcad_turn_store:
	stlxr	w12, x11, [x8]
	cbnz	w12, Lcad_turn_loop
Lcad_have_index:
	add	x20, x21, x9, lsl #8
	mov	x0, x20
	bl	_silica_rt_carrier_ensure_started
	str	x20, [x19, #440]
	mov	x9, #1
	str	x9, [x19, #448]
	str	xzr, [x19, #456]
	str	xzr, [x19, #464]
	str	xzr, [x19, #472]
	str	xzr, [x19, #512]
	cbnz	x22, Lcad_ready
	mov	x0, x19
	mov	x1, #1
	bl	_silica_rt_started_store
	mov	x0, #1
	b	Lcad_ret
Lcad_ready:
; A trampoline to run: ready on its carrier, under its lock (its identity resolves already, so a
; cast could race the status; a push needs the status guarded by the actor's lock).
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	_silica_rt_carrier_push
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, #1
	b	Lcad_ret
Lcad_no:
	mov	x0, xzr
Lcad_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_carriers_ensure
	.p2align	2
_silica_rt_carriers_ensure:
; -> X0 = the carrier table, made the first time: _silica_rt_carrier_count blocks of 256 B (the
; count was read by _silica_rt_stack_runtime_init; 1 when it was not), each knowing itself (+96)
; and its index (+112), its weighted-fair round starting at the high tier with its quantum (+200
; = 0 from calloc, +208 = 4, as the board's core block starts). Failure to make it is a runtime
; abort.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	adrp	x19, _silica_rt_carriers@PAGE
	add	x19, x19, _silica_rt_carriers@PAGEOFF
	ldar	x0, [x19]
	cbnz	x0, Lcen_ret
	adrp	x0, _silica_rt_carriers_lock@PAGE
	add	x0, x0, _silica_rt_carriers_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x0, [x19]
	cbnz	x0, Lcen_unlock
	adrp	x8, _silica_rt_carrier_count@PAGE
	add	x8, x8, _silica_rt_carrier_count@PAGEOFF
	ldr	x20, [x8]
	cbnz	x20, Lcen_have_count
	mov	x20, #1
	str	x20, [x8]
Lcen_have_count:
	mov	x0, x20
	mov	x1, #256
	bl	_calloc
	cbz	x0, Lcen_failed
	mov	x21, x0
	mov	x9, x0
	mov	x10, xzr
	mov	x11, #4
Lcen_fill:
	cmp	x10, x20
	b.hs	Lcen_filled
	str	x9, [x9, #96]
	str	x10, [x9, #112]
	str	x11, [x9, #208]
	add	x9, x9, #256
	add	x10, x10, #1
	b	Lcen_fill
Lcen_filled:
	stlr	x21, [x19]
Lcen_unlock:
	adrp	x0, _silica_rt_carriers_lock@PAGE
	add	x0, x0, _silica_rt_carriers_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	ldr	x0, [x19]
Lcen_ret:
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
Lcen_failed:
	adrp	x0, Lrta_r_carrier_table@PAGE
	add	x0, x0, Lrta_r_carrier_table@PAGEOFF
	bl	_silica_rt_abort_with
	b	Lcen_failed
	.globl	_silica_rt_carrier_ensure_started
	.p2align	2
_silica_rt_carrier_ensure_started:
; X0 = carrier block. Creates its thread the first time.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	add	x9, x19, #80
	ldar	x8, [x9]
	cbnz	x8, Lces_ret
	mov	x0, x19
	bl	_os_unfair_lock_lock
	ldr	x8, [x19, #80]
	cbnz	x8, Lces_unlock
	add	x0, x19, #64
	mov	x1, xzr
	adrp	x2, _silica_rt_carrier_main@PAGE
	add	x2, x2, _silica_rt_carrier_main@PAGEOFF
	mov	x3, x19
	bl	_pthread_create
	cbnz	w0, Lces_failed
	ldr	x0, [x19, #64]
	bl	_pthread_detach
	mov	x8, #1
	add	x9, x19, #80
	stlr	x8, [x9]
Lces_unlock:
	mov	x0, x19
	bl	_os_unfair_lock_unlock
Lces_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
Lces_failed:
	adrp	x0, Lrta_r_carrier_thread@PAGE
	add	x0, x0, Lrta_r_carrier_thread@PAGEOFF
	bl	_silica_rt_abort_with
	b	Lces_failed
	.globl	_silica_rt_tls_record_set
	.p2align	2
_silica_rt_tls_record_set:
; X0 = this thread's record: two words, the current actor and the carrier (0 when the thread is
; not a carrier's). An actor thread's record is in its control block (#496), a carrier's in its
; block (+88); main has none until _silica_rt_tls_actor_set makes it one.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	bl	_silica_rt_ensure_actor_tls_key
	adrp	x8, _silica_actor_pthread_key@PAGE
	add	x8, x8, _silica_actor_pthread_key@PAGEOFF
	ldr	x0, [x8]
	mov	x1, x19
	bl	_pthread_setspecific
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_tls_actor_set
	.p2align	2
_silica_rt_tls_actor_set:
; X0 = ACB or 0: this thread's current actor, stored in the thread's record. A thread without a
; record (main) gets a calloc'd one now, never freed (one thread).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	bl	_silica_rt_ensure_actor_tls_key
	adrp	x8, _silica_actor_pthread_key@PAGE
	add	x8, x8, _silica_actor_pthread_key@PAGEOFF
	ldr	x0, [x8]
	bl	_pthread_getspecific
	cbnz	x0, Ltas_store
	mov	x0, #1
	mov	x1, #16
	bl	_calloc
	cbz	x0, Ltas_failed
	mov	x20, x0
	adrp	x8, _silica_actor_pthread_key@PAGE
	add	x8, x8, _silica_actor_pthread_key@PAGEOFF
	ldr	x0, [x8]
	mov	x1, x20
	bl	_pthread_setspecific
	mov	x0, x20
Ltas_store:
	str	x19, [x0]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
Ltas_failed:
	adrp	x0, Lrta_r_thread_record@PAGE
	add	x0, x0, Lrta_r_thread_record@PAGEOFF
	bl	_silica_rt_abort_with
	b	Ltas_failed
	.globl	_silica_rt_carrier_main
	.p2align	2
_silica_rt_carrier_main:
; Thread entry: X0 = carrier block. Never returns.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x19, x0
	str	xzr, [x19, #88]
	add	x0, x19, #88
	bl	_silica_rt_tls_record_set
	add	x0, x19, #56
	bl	_silica_rt_altstack_install_at
; Affinity for logical core i (the carrier's index), asked of the OS as the thread actors asked
; it: THREAD_AFFINITY_POLICY with tag i + 1 (0 is the null tag). On macOS the tag is a placement
; hint the scheduler may ignore (Apple Silicon has no hard thread-to-core binding, and the call
; may answer KERN_NOT_SUPPORTED): best effort, the result is not checked.
	bl	_pthread_self
	bl	_pthread_mach_thread_np
	mov	x20, x0
	sub	sp, sp, #16
	ldr	x9, [x19, #112]
	add	w9, w9, #1
	str	w9, [sp]
	mov	x0, x20
	mov	w1, #4
	mov	x2, sp
	mov	w3, #1
	bl	_thread_policy_set
	add	sp, sp, #16
	mov	x9, sp
	str	x9, [x19, #48]
	mov	x8, #1
	add	x9, x19, #72
	stlr	x8, [x9]
Lcar_loop:
; Entered afresh from every path that leaves an actor: the stack below the base is abandoned.
	ldr	x9, [x19, #48]
	mov	sp, x9
	str	xzr, [x19, #40]
	str	xzr, [x19, #88]
	mov	x0, x19
	bl	_os_unfair_lock_lock
Lcar_pop:
	ldr	x9, [x19, #128]
	ldr	x10, [x19, #152]
	orr	x9, x9, x10
	ldr	x10, [x19, #176]
	orr	x9, x9, x10
	cbz	x9, Lcar_empty
; A busy carrier sweeps its idle :release_when_idle actors at most every quarter second.
	ldr	x9, [x19, #104]
	cbz	x9, Lcar_have
	bl	_silica_rt_stack_now_ns
	ldr	x9, [x19, #120]
	sub	x9, x0, x9
	movz	x10, #0xB280
	movk	x10, #0x0EE6, lsl #16
	cmp	x9, x10
	b.lo	Lcar_have
	mov	x0, x19
	bl	_silica_rt_carrier_sweep
	b	Lcar_pop
Lcar_empty:
; Nothing to run: sweep, then sleep until mail (or a parked actor's wake) or the earliest release.
	mov	x0, x19
	bl	_silica_rt_carrier_sweep
	mov	x2, x0
	mov	x9, #1
	str	x9, [x19, #16]
	add	x0, x19, #8
	mov	x1, x19
	bl	_silica_rt_cv_wait_timeout
	str	xzr, [x19, #16]
	b	Lcar_pop
Lcar_have:
; The policy's choice among the ready actors (some queue is non-empty, checked under this lock).
	mov	x0, x19
	bl	_silica_rt_rq_pop
	mov	x20, x0
	mov	x0, x19
	bl	_os_unfair_lock_unlock
	mov	x9, #3
	str	x9, [x20, #448]
	str	x20, [x19, #40]
	str	x20, [x19, #88]
	ldr	x9, [x20, #464]
	cbnz	x9, Lcar_resume
	ldr	x9, [x20, #224]
	cbz	x9, Lcar_first
	mov	x19, x20
	b	LBB1_loop
Lcar_first:
; Not started: the actor's start trampoline (SB #48; a supervisor's init and the
; materialisation of its children) runs first, on the actor's own stack as a behaviour does, so a
; wait inside it (a child supervisor's start) parks. The 48-byte frame is the one a resume
; rebuilds (Lcar_resume: the base less 48) and the carrier's SP is kept in #368 as a behaviour's
; dispatch keeps it; X19 = the carrier and X20 = the actor are callee-saved and survive the
; trampoline and any park. Then the started word goes to 1 (a spawner parked or spinning on it
; proceeds) and the mailbox loop begins. An actor that ends inside its trampoline (a duplicate
; child id, exhaustion, badarith) never returns here: its exit path stores 2 and enters the loop.
	ldr	x8, [x20, #216]
	cbz	x8, Lcar_started
	ldr	x8, [x8, #48]
	cbz	x8, Lcar_started
	sub	sp, sp, #48
	mov	x10, sp
	str	x10, [x20, #368]
	ldr	x9, [x20, #272]
	ldr	x10, [x20, #280]
	add	x9, x9, x10
	mov	sp, x9
	mov	x0, x20
	blr	x8
	ldr	x9, [x19, #48]
	mov	sp, x9
	str	xzr, [x20, #368]
Lcar_started:
	mov	x0, x20
	mov	x1, #1
	bl	_silica_rt_started_store
	mov	x19, x20
	b	LBB1_loop
Lcar_resume:
; Parked inside a behaviour: the dispatch frame its behaviour will return into is the same 48 bytes
; below the base that its dispatch used (the post-behaviour code reads the node from ACB #240).
	ldr	x9, [x19, #48]
	sub	x9, x9, #48
	str	x9, [x20, #368]
	mov	x0, x20
	b	_silica_rt_ctx_resume
	.globl	_silica_rt_carrier_loop_enter
	.p2align	2
_silica_rt_carrier_loop_enter:
; X0 = carrier block. An actor's exit path, run on the carrier's stack, ends here. Never returns.
	mov	x19, x0
	b	Lcar_loop
	.globl	_silica_rt_carrier_requeue
	.p2align	2
_silica_rt_carrier_requeue:
; X0 = a carrier actor whose message has been served (the dispatch boundary): a pending migration
; (#512) is applied first, then it is ready again when mail waits or it has been ended meanwhile
; (its exit path runs at its next dispatch), idle otherwise; then back to the loop of the carrier
; this thread is (X20, read before the move: after it the actor's #440 may name another carrier,
; whose thread may already be running the actor). Never returns.
	mov	x19, x0
	ldr	x20, [x19, #440]
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x0, x19
	bl	_silica_rt_carrier_apply_pending
	ldr	w9, [x19, #152]
	cbz	w9, Lcrq_ready
	ldr	x9, [x19, #216]
	cbz	x9, Lcrq_std
	ldr	x10, [x9]
	ldr	x11, [x9, #8]
	orr	x10, x10, x11
	cbnz	x10, Lcrq_ready
Lcrq_std:
	ldr	x10, [x19, #128]
	ldr	x11, [x19, #136]
	orr	x10, x10, x11
	cbnz	x10, Lcrq_ready
	mov	x0, x19
	bl	_silica_rt_carrier_mark_idle
	b	Lcrq_unlock
Lcrq_ready:
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	_silica_rt_carrier_push
Lcrq_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x20
	b	_silica_rt_carrier_loop_enter
	.globl	_silica_rt_carrier_apply_pending
	.p2align	2
_silica_rt_carrier_apply_pending:
; X0 = a carrier actor between dispatches (its message served, or dispatched with no mail), its
; lock held, not on any run queue or sweep list: a pending migration (#512, the target carrier
; block) becomes its binding (#440). The word is taken atomically, so a migrate_actor that stores
; a new target meanwhile (under the same lock today; the swap keeps it safe without) is not lost.
	add	x8, x0, #512
Lcap_swap:
	ldaxr	x9, [x8]
	stlxr	w10, xzr, [x8]
	cbnz	w10, Lcap_swap
	cbz	x9, Lcap_ret
	str	x9, [x0, #440]
Lcap_ret:
	ret
	.globl	_silica_rt_carrier_push
	.p2align	2
_silica_rt_carrier_push:
; X0 = a carrier actor whose status its caller has just set to ready (2), under the lock that guards
; that status. Appends it to the run queue of its own carrier (#440: the caller may be anywhere)
; that the policy chooses (_silica_rt_rq_push) and wakes that carrier when it sleeps. A pending
; migration is not applied here: a parked actor resumes on the carrier it parked on, inside the
; same dispatch (spec §15.1.2, scheduler yield points), and moves at its dispatch boundary
; (_silica_rt_carrier_requeue).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x20, x0
	ldr	x19, [x20, #440]
	str	xzr, [x20, #456]
	mov	x0, x19
	bl	_os_unfair_lock_lock
	mov	x0, x19
	mov	x1, x20
	bl	_silica_rt_rq_push
	ldr	x9, [x19, #16]
	cbz	x9, Lcpu_unlock
	add	x0, x19, #8
	bl	_silica_rt_cv_signal
Lcpu_unlock:
	mov	x0, x19
	bl	_os_unfair_lock_unlock
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_carrier_mark_idle
	.p2align	2
_silica_rt_carrier_mark_idle:
; X0 = a carrier actor with no mail, between dispatches, its lock held: a pending migration is
; applied, then it is idle (1), or, when it is :release_when_idle (#312 = 4) and still holds
; committed stack (#288), idle on its carrier's sweep list (5), linked through #456 under that
; carrier's lock (the carrier may be the one just moved to: its list changes under its lock).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	bl	_silica_rt_carrier_apply_pending
	ldr	x9, [x19, #312]
	cmp	x9, #4
	b.ne	Lcmi_plain
	ldr	x9, [x19, #288]
	cbz	x9, Lcmi_plain
	ldr	x20, [x19, #440]
	mov	x0, x20
	bl	_os_unfair_lock_lock
	ldr	x9, [x20, #104]
	str	x9, [x19, #456]
	str	x19, [x20, #104]
	mov	x9, #5
	str	x9, [x19, #448]
	mov	x0, x20
	bl	_os_unfair_lock_unlock
	b	Lcmi_ret
Lcmi_plain:
	mov	x9, #1
	str	x9, [x19, #448]
Lcmi_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_carrier_unlist
	.p2align	2
_silica_rt_carrier_unlist:
; X0 = a carrier actor its caller found on its carrier's sweep list (status 5), its lock held:
; taken off the list under the carrier's lock. Not found is fine: the sweep released it and took
; it off meanwhile.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	ldr	x20, [x19, #440]
	mov	x0, x20
	bl	_os_unfair_lock_lock
	add	x9, x20, #104
Lcul_find:
	ldr	x10, [x9]
	cbz	x10, Lcul_unlock
	cmp	x10, x19
	b.eq	Lcul_found
	add	x9, x10, #456
	b	Lcul_find
Lcul_found:
	ldr	x10, [x19, #456]
	str	x10, [x9]
	str	xzr, [x19, #456]
Lcul_unlock:
	mov	x0, x20
	bl	_os_unfair_lock_unlock
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_carrier_sweep
	.p2align	2
_silica_rt_carrier_sweep:
; X0 = a carrier, its lock held, on its own thread. Walks the sweep list (+104): an actor whose
; last message is a second old is released by _silica_rt_stack_idle_check (nothing of it runs: it
; is idle and off the run queue, and mail for it waits for this lock in _silica_rt_carrier_unlist)
; and becomes plainly idle (1), off the list; -> X0 = the microseconds until the earliest remaining
; one is due, 0 when the list is empty. Records the time of the sweep (+120).
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	bl	_silica_rt_stack_now_ns
	str	x0, [x19, #120]
	mov	x22, xzr
	add	x21, x19, #104
	ldr	x20, [x21]
Lcsw_next:
	cbz	x20, Lcsw_done
	mov	x0, x20
	bl	_silica_rt_stack_idle_check
	cbnz	x0, Lcsw_keep
	ldr	x9, [x20, #456]
	str	x9, [x21]
	str	xzr, [x20, #456]
	mov	x9, #1
	str	x9, [x20, #448]
	ldr	x20, [x21]
	b	Lcsw_next
Lcsw_keep:
	cbz	x22, Lcsw_set_min
	cmp	x0, x22
	b.hs	Lcsw_advance
Lcsw_set_min:
	mov	x22, x0
Lcsw_advance:
	add	x21, x20, #456
	ldr	x20, [x21]
	b	Lcsw_next
Lcsw_done:
	mov	x0, x22
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_actor_mail_signal
	.p2align	2
_silica_rt_actor_mail_signal:
; X0 = ACB; the caller holds ACB+16 and has enqueued mail or ended the actor. Signals the mailbox
; futex (an actor thread waits on it) and, for an idle carrier actor (plainly idle or on its
; carrier's sweep list), makes it ready on its own carrier.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	add	x0, x19, #80
	bl	_silica_rt_cv_signal
	ldr	x9, [x19, #440]
	cbz	x9, Lams_ret
	ldr	x9, [x19, #448]
	cmp	x9, #1
	b.eq	Lams_ready
	cmp	x9, #5
	b.ne	Lams_ret
	mov	x0, x19
	bl	_silica_rt_carrier_unlist
Lams_ready:
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	_silica_rt_carrier_push
Lams_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_call_wrapper_wake
	.p2align	2
_silica_rt_call_wrapper_wake:
; X0 = call wrapper; the caller holds wrapper+72 and has set reply_set. Signals the wrapper's futex
; (a thread waits on it) and makes a carrier actor parked on it (wrapper+48) ready on its carrier.
	stp	x29, x30, [sp, #-32]!
