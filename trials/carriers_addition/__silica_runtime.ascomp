	mov	x2, #60
	sub	x2, x2, x22, lsl #2
	lsr	x3, x19, x2
	and	x3, x3, #0xf
	ldrb	w4, [x21, x3]
	strb	w4, [x20, x22]
	add	x22, x22, #1
