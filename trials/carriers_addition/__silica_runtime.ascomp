	bl	_pthread_getspecific
	cbz	x0, L_gft_no
	mov	x20, x0
	ldr	x9, [x20, #24]
	cbz	x9, L_gft_no
	sxtw	x9, w21
	str	x9, [x20, #32]
	ldr	x9, [x19, #24]
	str	x9, [x20, #40]
	ldr	w10, [x19, #8]
	sxtw	x10, w10
	str	x10, [x20, #48]
	mov	x10, xzr
	ldr	x11, [x20, #8]
	cbz	x11, L_gft_store_arena
	ldr	x12, [x11, #248]
	ldr	x13, [x11, #256]
	cbz	x12, L_gft_store_arena
	cmp	x9, x12
	b.lo	L_gft_store_arena
	cmp	x9, x13
	b.hs	L_gft_store_arena
	mov	x10, #1
