L_gff_have_actor:
	mov	x0, x19
	bl	_silica_rt_ffi_arena_reset
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x8, #5
	str	x8, [x19, #232]
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x8, [x19, #216]
	cbz	x8, Lsbg_6
	ldr	x8, [x8, #40]
Lsbg_6:
