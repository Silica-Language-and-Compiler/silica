	mov	x0, sp
	mov	x1, xzr
	mov	x2, #128
	bl	_memset
	cbz	x19, Lwi_set_pipe
	ldr	w8, [sp]
	orr	w8, w8, #0x1
	str	w8, [sp]
Lwi_set_pipe:
