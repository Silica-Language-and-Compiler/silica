; fcntl(fd, F_SETFD, FD_CLOEXEC) for both ends; the third argument is variadic, so Apple arm64 passes it on the stack.
	sub	sp, sp, #16
	mov	x8, #1
	str	x8, [sp]
	ldr	w0, [x19]
	mov	w1, #2
	mov	x2, #1
	bl	_fcntl
	mov	x8, #1
	str	x8, [sp]
	ldr	w0, [x19, #4]
	mov	w1, #2
	mov	x2, #1
	bl	_fcntl
	add	sp, sp, #16
; Every death is reported once (§15.4.13.4), with or without a FailureReporter: exit waits for
; reports still in flight and prints the pending ones (_silica_rt_report_drain_at_exit).
	adrp	x0, _silica_rt_report_drain_at_exit@PAGE
	add	x0, x0, _silica_rt_report_drain_at_exit@PAGEOFF
	bl	_atexit
	mov	x0, #0
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.cfi_endproc
; §15.1.2.5 cast_exit(value: int64) -> boolean. X0 = value. Compare-and-swap _silica_rt_exit_flag from 0 to 1:
; the winner stores its value in _silica_rt_exit_request (release), writes one byte to the exit pipe so main's
; wait_for_exit wakes and returns that value, and returns 1. A later request returns 0 and changes nothing. Any
; actor thread may call this; nothing here allocates.
