	stp	x29, x30, [sp, #-80]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	str	x25, [sp, #64]
	.cfi_def_cfa w29, 80
	.cfi_offset w30, -72
	.cfi_offset w29, -80
