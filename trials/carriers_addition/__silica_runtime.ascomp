	mov	x19, x0
	cbz	x19, Lkab_not_found
	bl	_silica_rt_tls_current_actor_get
	mov	x22, x0
	cmp	x22, x19
	b.eq	Lkab_self
	ldr	x20, [x19, #208]
	ldr	x21, [x19, #192]
	mov	x23, xzr
	mov	x24, xzr
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
; While the target is still alive it holds its block reference and its supervisor, so ones taken
; now keep the row this call waits on and the supervisor it drains alive even if the supervisor
; ends meanwhile (X23 = the block, X24 = 1 when the supervisor is held; dropped at the end). A
; target that has ended, or has no row, is :ok with no wait.
	ldr	w8, [x19, #152]
	cbz	w8, Lkab_unlock
	cbz	x21, Lkab_unlock
	cmp	x20, #4096
	b.lo	Lkab_unlock
	ldr	x23, [x20, #88]
	cbz	x23, Lkab_unlock
	add	x9, x23, #112
Lkab_ref:
	ldaxr	x10, [x9]
	add	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lkab_ref
	mov	x0, x21
	bl	_silica_rt_acb_hold
	mov	x24, #1
Lkab_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x25, [x19, #408]
	mov	x0, x19
	mov	x1, #1
	mov	x2, xzr
	bl	_silica_rt_actor_stop
	cbz	x23, Lkab_done
	mov	x2, x0
	mov	x0, x20
	mov	x1, x25
	mov	x3, x22
	bl	_silica_rt_row_wait
	cmp	x0, #1
	b.ne	Lkab_done
	mov	x0, x21
	mov	x1, x22
	bl	_silica_rt_supervisor_drain_ingress
Lkab_done:
	mov	x0, x23
	bl	_silica_rt_sb_unref
	cbz	x24, Lkab_not_found
	mov	x0, x21
	bl	_silica_rt_acb_release
Lkab_not_found:
	mov	x0, x19
	bl	_silica_rt_acb_release
	mov	x0, #0
	ldr	x25, [sp, #64]
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #80
	ret
Lkab_self:
	mov	x0, x19
	bl	_silica_rt_acb_release
	ldr	x25, [sp, #64]
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #80
	b	_silica_rt_language_error_current
	.cfi_endproc
