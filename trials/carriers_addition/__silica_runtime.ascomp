	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	mov	x0, #40
	bl	_malloc
	cbz	x0, Lgmu_ret
	movz	x8, #1, lsl #16
	movk	x8, #7
	str	x8, [x0]
	cmp	x19, #4096
	b.lo	Lgmu_zero
	ldr	x8, [x19, #272]
	cbz	x8, Lgmu_zero
	ldr	x8, [x19, #280]
	str	x8, [x0, #8]
	ldr	x8, [x19, #288]
	str	x8, [x0, #16]
	ldr	x8, [x19, #320]
	str	x8, [x0, #24]
	ldr	x8, [x19, #296]
	str	x8, [x0, #32]
	b	Lgmu_ret
Lgmu_zero:
	str	xzr, [x0, #8]
	str	xzr, [x0, #16]
	str	xzr, [x0, #24]
	str	xzr, [x0, #32]
Lgmu_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
