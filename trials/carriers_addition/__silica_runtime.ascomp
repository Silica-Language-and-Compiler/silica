	.p2align	2
_silica_rt_actor_final_release:
; X0 = an ended actor's ACB; the last act of its thread before it exits. Its identity stops resolving
; (§15.1.4: a reference to it is dead from here on), its own hold goes, then its row's exit_done (=
; its identity) and block reference (sb_child_done), then its hold on its supervisor.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	mov	x19, x0
	bl	_silica_rt_idt_remove
	mov	x0, x19
	ldr	x21, [x0, #408]
	ldr	x19, [x0, #192]
	ldr	x20, [x0, #208]
	cmp	x19, #0
	csel	x20, x20, xzr, ne
	bl	_silica_rt_acb_release
	mov	x0, x20
	mov	x1, x21
	bl	_silica_rt_sb_child_done
	mov	x0, x19
	bl	_silica_rt_acb_release
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.globl	_silica_rt_spawner_let_go
	.p2align	2
_silica_rt_spawner_let_go:
; X0 = the actor a spawn made (0: none) -> X0 = the reference the spawn returns: its identity
