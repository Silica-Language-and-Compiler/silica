	str	xzr, [x19, #296]
	str	x23, [x19, #304]
	str	x21, [x19, #312]
	str	xzr, [x19, #320]
	str	xzr, [x19, #328]
	str	xzr, [x19, #336]
	str	xzr, [x19, #344]
	str	xzr, [x19, #352]
