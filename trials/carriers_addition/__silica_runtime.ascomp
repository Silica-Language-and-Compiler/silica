	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x29, sp
	mov	x19, x0
	mov	x20, x1
	ldr	x21, [x19, #8]       ; op atom index
	ldr	x22, [x19, #16]   ; name atom index
	ldr	x23, [x19, #24]  ; pid actor_ref
	mov	x0, #1
	mov	x1, #24
	bl	_calloc
	mov	x24, x0
	cbz	x24, L_pidreg_ret_null
	mov	x0, #1
	mov	x1, #16
