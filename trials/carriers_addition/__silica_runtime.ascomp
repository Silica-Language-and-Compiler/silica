	ldr	x9, [x19, #48]
	cbz	x9, Lcww_ret
	ldr	x10, [x9, #448]
	cmp	x10, #4
	b.ne	Lcww_ret
	mov	x10, #2
	str	x10, [x9, #448]
	mov	x0, x9
	bl	_silica_rt_carrier_push
Lcww_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_started_store
	.p2align	2
_silica_rt_started_store:
; X0 = ACB, X1 = its started word (#224): 1 started, 2 its start trampoline failed. Stores it and
; makes a carrier actor parked in the spawn (#472) ready. The parker stores #472 and then reads #224
; under its own lock; this side stores #224 and then reads #472: with the barriers one of them sees
; the other's store, and the status check under the parker's lock settles the rest.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	add	x9, x0, #224
	stlr	x1, [x9]
	dmb	ish
	ldr	x19, [x0, #472]
	cbz	x19, Lsts_ret
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x10, [x19, #448]
	cmp	x10, #4
	b.ne	Lsts_unlock
	mov	x10, #2
	str	x10, [x19, #448]
	mov	x0, x19
	bl	_silica_rt_carrier_push
Lsts_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
Lsts_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_spawn_wait_started
	.p2align	2
_silica_rt_spawn_wait_started:
; X0 = a child just spawned. Returns once its started word (#224) is set (at adoption for a plain
; actor; after the trampoline of its first dispatch for a supervisor). A carrier actor on its own
; stack parks (the child's started store wakes it); anything else spins (main spawning a root
; supervisor, a dangerous actor's thread), as the spawn always did.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	bl	_silica_rt_tls_current_actor_get
	mov	x20, x0
	cbz	x20, Lsws_spin
	ldr	x21, [x20, #440]
	cbz	x21, Lsws_spin
	mov	x9, sp
	ldr	x10, [x20, #272]
	cmp	x9, x10
	b.lo	Lsws_spin
	ldr	x11, [x20, #280]
	add	x10, x10, x11
	cmp	x9, x10
	b.hs	Lsws_spin
	str	x20, [x19, #472]
	dmb	ish
Lsws_park_loop:
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	add	x9, x19, #224
	ldar	x8, [x9]
	cbnz	x8, Lsws_started
	mov	x0, x20
	bl	_silica_rt_ctx_save
	cbnz	x0, Lsws_park_loop
	mov	x9, #4
	str	x9, [x20, #448]
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
