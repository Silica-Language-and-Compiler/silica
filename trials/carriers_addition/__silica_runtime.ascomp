; The end of a reservation the program lowered: (:explicit, :stack_exhausted) for this actor only.
	ldr	x9, [x20, #440]
	cbz	x9, L_sfh_exhausted_thread
; A carrier actor (item N stage 1): the exit runs on the carrier's stack, reached by returning from
; this handler into _silica_rt_actor_fail_current(ACB, atom) with the signal frame unwound by the
; kernel, so the carrier thread's alternate-stack state and signal mask are those of a thread
; outside a handler when the next actor on it faults. Darwin arm64 mcontext: x0 at +16, x1 at +24,
; sp at +264, pc at +272 (the handler reads pc from +272 above).
