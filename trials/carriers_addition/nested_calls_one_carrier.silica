// Carriers (actor_memory_budget_plan.md item N, stage 1): a chain of calls on the one carrier. The
// worker calls A; A's behaviour calls B (its state, the reference it was spawned with); B replies;
// A replies. Two actors are parked at once (the worker inside its call to A, A inside its call to
// B) and each resumes in turn when its reply arrives. Three rounds; B counts the calls it served
// and reports the count to a 0 message at the end.
//
//   round x: B replies (x + 1) * 2 and counts; A replies that + 1.
//   x = 10 -> 23, x = 20 -> 43, x = 30 -> 63; then B's count: 3.
//
// Expected output: 23, 43, 63, 3, exit status 0. The same with SILICA_CARRIERS=0.

use trial_support_int64;

fn b_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    case msg == 0 of {
        true -> (:reply, state, state);
        false -> (:reply, (msg + 1) * 2, state + 1)
    }
}

fn a_beh(msg: int64, state: actor_ref) -> (:reply, int64, actor_ref) {
    sequence proc[concurrency]
        r: int64 <- call(state, msg impl ActorMessage {})
    produces
        pure (:reply, r + 1, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                b: actor_ref <- spawn(0, b_beh, stack_policy(1048576, :keep_last_message));
                a: actor_ref <- spawn(b, a_beh, stack_policy(1048576, :keep_last_message));
                r1: int64 <- call(a, 10 impl ActorMessage {});
                r2: int64 <- call(a, 20 impl ActorMessage {});
                r3: int64 <- call(a, 30 impl ActorMessage {});
                b_count: int64 <- call(b, 0 impl ActorMessage {});
                print_int64(r1);
                println("");
                print_int64(r2);
                println("");
                print_int64(r3);
                println("");
                print_int64(b_count);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
