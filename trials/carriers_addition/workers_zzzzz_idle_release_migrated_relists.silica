// Carriers, :release_when_idle across a migration (release_when_idle_design.md §3, trial 5): an
// actor idle on its carrier's sweep list (called once, holding committed stack) that migrate_actor
// moves to another core is taken off that list, bound to the target and listed there, and the target
// carrier releases it when its idle period has passed (it joins the target's list behind newer
// entries, so at most one extra period late): the bounded poll (ticks, as in
// workers_zzzzz_idle_release_budget_bounds_burst) sees it released to nothing, and a call afterwards
// finds it on core 2's carrier (the carrier a probe spawned for core 2 is on, so the fact holds at
// every carrier count).
//
// Expected output: true (held after the call), true (:ok), true (released), true (on core 2's
// carrier), 0.

use trial_support_int64;

fn probe(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn tick(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn poll_released(w: actor_ref, t: actor_ref, n: int64) -> boolean {
    sequence proc[concurrency]
        u: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
        r: boolean <- case u.committed == 0 of {
            true -> true;
            false -> tick_then_poll(w, t, n)
        }
    produces
        pure r
    end
}

fn tick_then_poll(w: actor_ref, t: actor_ref, n: int64) -> boolean {
    case n == 0 of {
        true -> false;
        false -> {
            sequence proc[concurrency]
                _: int64 <- call(t, 200000 impl ActorMessage {});
                r: boolean <- poll_released(w, t, n - 1)
            produces
                pure r
            end
        }
    }
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        t: actor_ref <- spawn(0, tick, stack_policy(0, :release_on_return));
        p2: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 2);
        r: actor_ref <- spawn(0, probe, stack_policy(65536, :release_when_idle), 1);
        _: int64 <- call(r, 1 impl ActorMessage {});
        busy: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(r);
        print_boolean(busy.committed > 0 and busy.retained == busy.committed);
        println("");
        m: atom <- migrate_actor(r, 2);
        print_boolean(m == :ok);
        println("");
        released: boolean <- poll_released(r, t, 2000);
        print_boolean(released);
        println("");
        _: int64 <- call(r, 1 impl ActorMessage {});
        i_r: int64 <- actor_carrier_index(r);
        i_p2: int64 <- actor_carrier_index(p2);
        print_boolean(i_r == i_p2);
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 { drive() });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
