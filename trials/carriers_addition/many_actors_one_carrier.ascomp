    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pi_loop
    B L_pi_maybe_neg
L_pi_zero:
