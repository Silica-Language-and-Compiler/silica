// Carriers (actor_memory_budget_plan.md item N, stage 3): a move requested while the actor is
// running takes effect at its next dispatch boundary (spec §15.1.2, Actor Pinning Policy): the
// target is left pending (ACB #512) and applied by _silica_rt_carrier_requeue once the behaviour
// has returned, never during the dispatch. The mover migrates itself inside its behaviour and
// replies its own carrier index as read right after: still the old carrier. A later dispatch
// replies the new one. Facts are equalities with probes spawned for the cores, so they hold at
// every carrier count and with the gate off.
//
//   mover (core 1): call 2 -> migrates itself to core 2, replies core 1's carrier (deferred);
//   call 0 -> replies core 2's carrier; the query agrees.
//
// Expected output: 9, 9, 9, 9, exit status 0. The same with SILICA_CARRIERS=0 and at every
// carrier count.

use trial_support_int64;

fn probe(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

// msg 0: reply the carrier bound to now; msg k: migrate self to core k, then reply the carrier
// bound to now (the dispatch has not ended, so the move is still pending).
fn mover(msg: int64, state: int64) -> (:reply, int64, int64) {
    case msg == 0 of {
        true -> {
            sequence proc[concurrency]
                here: int64 <- actor_carrier_index(self())
            produces
                pure (:reply, here, state)
            end
        };
        false -> {
            sequence proc[concurrency]
                _: atom <- migrate_actor(self(), msg);
                here: int64 <- actor_carrier_index(self())
            produces
                pure (:reply, here, state)
            end
        }
    }
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        p1: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        p2: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 2);
        mv: actor_ref <- spawn(0, mover, stack_policy(1048576, :keep_last_message), 1);
        i_p1: int64 <- actor_carrier_index(p1);
        i_p2: int64 <- actor_carrier_index(p2);
        before: int64 <- actor_carrier_index(mv);
        print_int64(verdict(before == i_p1));
        println("");
        during: int64 <- call(mv, 2 impl ActorMessage {});
        print_int64(verdict(during == i_p1));
        println("");
        after: int64 <- call(mv, 0 impl ActorMessage {});
        print_int64(verdict(after == i_p2));
        println("");
        now: int64 <- actor_carrier_index(mv);
        print_int64(verdict(now == i_p2));
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 { drive() });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
