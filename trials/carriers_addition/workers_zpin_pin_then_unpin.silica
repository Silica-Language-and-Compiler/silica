// Carriers (actor_memory_budget_plan.md item N, stage 3): pin_actor_to_core is a move to the
// core's carrier (a shorthand for migrate_actor, spec §15.1.2), and unpin_actor is accepted but
// changes nothing: an actor has no unpinned state (spec §22.10). Facts are equalities with probes
// spawned for the cores (see workers_zpin_spawn_for_core_runs_there), so they hold at every
// carrier count and with the gate off.
//
//   a, spawned for core 1 and idle, is pinned to core 2: bound to core 2's carrier at once;
//   it answers a call there (5); unpin_actor answers :ok and a is still bound to core 2's
//   carrier; pinned back to core 1 (a may still be inside its last dispatch, so the move is
//   settled by one more call before the query) it is bound to core 1's carrier.
//
// Expected output: 9, 9, 5, :ok, 9, 9, exit status 0. The same with SILICA_CARRIERS=0 and at
// every carrier count.

use trial_support_int64;

fn probe(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        p1: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        p2: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 2);
        a: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        i_p1: int64 <- actor_carrier_index(p1);
        i_p2: int64 <- actor_carrier_index(p2);
        i0: int64 <- actor_carrier_index(a);
        print_int64(verdict(i0 == i_p1));
        println("");
        _: (int64, affinity_error) <- pin_actor_to_core(a, 2);
        i1: int64 <- actor_carrier_index(a);
        print_int64(verdict(i1 == i_p2));
        println("");
        v: int64 <- call(a, 5 impl ActorMessage {});
        print_int64(v);
        println("");
        u: atom <- unpin_actor(a);
        _: atom <- print_atom(u);
        println("");
        i2: int64 <- actor_carrier_index(a);
        print_int64(verdict(i2 == i_p2));
        println("");
        _: (int64, affinity_error) <- pin_actor_to_core(a, 1);
        _: int64 <- call(a, 1 impl ActorMessage {});
        i3: int64 <- actor_carrier_index(a);
        print_int64(verdict(i3 == i_p1));
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 { drive() });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
