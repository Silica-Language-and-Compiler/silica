// Supervisors on carriers (actor_memory_budget_plan.md item N, "Carriers are the only model"): a
// supervisor tree three levels deep, root -> mid -> leaf -> one counter, every supervisor a carrier
// actor whose start trampoline (its init and the start of its own children) runs in its first
// dispatch on its carrier: the root's trampoline spawns mid and parks until mid has started; mid's
// trampoline, on mid's carrier, spawns leaf and parks; leaf's starts the counter (started at
// adoption). At SILICA_CARRIER_COUNT=1 the whole tree, the driver and the killer share the one
// carrier, so every one of those waits is a park that lets the awaited actor run; at any other
// count the rows are bound in turn and the same parks cross carriers. Then: the counter is killed
// (leaf restarts it); the root is asked to terminate mid, whose exit path, on its own stack, shuts
// leaf down and parks for it while leaf's exit shuts the counter down and parks for it (three
// nested exits, each a park on a carrier); then to restart mid, which rebuilds the two levels below
// it through the same trampolines.
//
//   root counts 1 (9), mid counts 1 (9), leaf counts 1 (9); call the counter 5 -> 505;
//   the killer's kill_abnormal(counter) -> :ok (9); call the counter 5 -> 505 (restarted);
//   terminate mid: root counts 0 (9); restart mid: root counts 1, the new mid 1, the new leaf 1
//   (9); call the counter 5 -> 505 (started again from its initial state).
//
// Expected output: 9, 9, 9, 505, 9, 505, 9, 9, 505, four failure reports (the counter twice with
// reason_tag 1: the kill and leaf's shutdown with shutdown 0; leaf with reason_tag 1, shut down by
// mid with shutdown 0, frame #0 its start function; mid with reason_tag 0, terminated by the root,
// frame #0 its start function), done, exit status 0, compared as a multiset (the printed values
// avoid the digits 1-4 and 8, which compare_scout_multiset.sh folds).

use Supervisor;
use trial_wait_int64;

impl ZzsupTreeRootSup for Supervisor;

fn leaf_start(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :zzsup_tree_counter, agent_type: :worker, initial_state: initial_state + 500, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn mid_start(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :zzsup_tree_leaf, agent_type: :supervisor, initial_state: 0, behavior: leaf_start, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :zzsup_tree_mid, agent_type: :supervisor, initial_state: 0, behavior: mid_start, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn counter(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

fn count_of(sup: supervisor_ref) -> int64 {
    sequence
        c: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :count_children } impl SupervisorMessage {})
    produces
        pure c.count
    end
}

fn child_of(sup: supervisor_ref, id: atom) -> actor_ref {
    sequence
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: id } impl SupervisorMessage {})
    produces
        pure got.child
    end
}

// The same two queries of a supervisor reached as another supervisor's child (an actor_ref: the
// :get_child answer's child field; call_supervisor takes it as it takes a supervisor_ref).
fn count_of_child(sup: actor_ref) -> int64 {
    sequence
        c: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :count_children } impl SupervisorMessage {})
    produces
        pure c.count
    end
}

fn child_of_child(sup: actor_ref, id: atom) -> actor_ref {
    sequence
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: id } impl SupervisorMessage {})
    produces
        pure got.child
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}

// Kills the counter and replies 9 when kill_abnormal returned :ok, else 6.
fn killer(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        killed: atom <- kill_abnormal(:zzsup_tree_counter);
        v: int64 <- case killed of { :ok -> 9; _: atom -> 6 }
    produces
        pure (:reply, v, state)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        root: supervisor_ref <- spawn_registered_supervisor(ZzsupTreeRootSup, 0, :zzsup_tree_root, stack_policy(0, :keep_last_message), 1);
        n_root: int64 <- count_of(root);
        mid: actor_ref <- child_of(root, :zzsup_tree_mid);
        n_mid: int64 <- count_of_child(mid);
        leaf: actor_ref <- child_of_child(mid, :zzsup_tree_leaf);
        n_leaf: int64 <- count_of_child(leaf);
        c1: int64 <- call_registered(:zzsup_tree_counter, 5 impl ActorMessage {});
        k: actor_ref <- spawn(0, killer, stack_policy(1048576, :keep_last_message), 1);
        killed: int64 <- call(k, 0 impl ActorMessage {});
        c2: int64 <- call_registered(:zzsup_tree_counter, 5 impl ActorMessage {});
        _t: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(root, { op: :terminate_child, id: :zzsup_tree_mid } impl SupervisorMessage {});
        n_after_stop: int64 <- count_of(root);
        _r: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(root, { op: :restart_child, id: :zzsup_tree_mid } impl SupervisorMessage {});
        n_root2: int64 <- count_of(root);
        mid2: actor_ref <- child_of(root, :zzsup_tree_mid);
        n_mid2: int64 <- count_of_child(mid2);
        leaf2: actor_ref <- child_of_child(mid2, :zzsup_tree_leaf);
        n_leaf2: int64 <- count_of_child(leaf2);
        c3: int64 <- call_registered(:zzsup_tree_counter, 5 impl ActorMessage {});
        print_int64(verdict(n_root == 1));
        println("");
        print_int64(verdict(n_mid == 1));
        println("");
        print_int64(verdict(n_leaf == 1));
        println("");
        print_int64(c1);
        println("");
        print_int64(killed);
        println("");
        print_int64(c2);
        println("");
        print_int64(verdict(n_after_stop == 0));
        println("");
        print_int64(verdict(n_root2 == 1 and n_mid2 == 1 and n_leaf2 == 1));
        println("");
        print_int64(c3);
        println("");
        println("done")
    produces
        pure 0
    end
}
