// A function that returns a two-field record it was given as a parameter, from an actor whose state
// holds the list the record is the head of; the record then comes back through ident/1 after a
// worker that shared the carrier has been removed and its stack and blocks released.
//
// History: the original trial (2026-10) built the record as a 24-byte region box ending exactly at
// the end of the actor's 64 MB arena block, so the sret epilogue's copy of the 16-byte-rounded shell
// (32 bytes) read one word past the box into an unmapped page (the compiler itself faulted this way
// once in three runs, in constraint_core narrow_slot_backward). The epilogue now copies the value's
// flat size (emitter prims_tuple sret_aggregate_copy_bytes). The shape was built by counting bytes
// through heap_used() until exactly 32 + 24 bytes remained in the block.
// Chunk 15 phase 2: records and list cells built in a function now live in its frame, not in the
// actor's arena block, so heap_used() no longer counts them and the block-end placement cannot be
// constructed (the fill loop would never reach its target). The arena-block shape is therefore gone
// from this trial; the heap path it protected remains reachable only through actor state and
// message copies, which phase 3/4 rework. What stays is the behavioural part: a builds the record,
// prepends it to an empty list that becomes its state, b (a second actor) allocates and is removed,
// c (a relay) is polled until b's block is given back, and a returns the stored record through ident.
//
// Expected output:
//   9        a built the list and the record (the placement check of the old trial, minus the byte count)
//   3        ident returned the boxed record { 1, 2 }: 1 + 2
//   0        exit status
// followed by the runtime's normal-exit banner of the removed worker b (as before).
// Printed checks avoid the digits 1-4 and 8 (see compare_scout_normalized.sh): 9 holds, 6 does not.

use trial_support_int64;

fn mk(a: int64) -> { a: int64, b: int64 } {
    { a: a, b: a + 1 }
}

fn ident(r: { a: int64, b: int64 }) -> { a: int64, b: int64 } {
    r
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

fn cons_int(x: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn nil_int() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure r
    end
}

fn nil_rec() -> List[{ a: int64, b: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ a: int64, b: int64 }, mem(normal)] <- empty[{ a: int64, b: int64 }, mem(normal)]()
    produces
        pure r
    end
}

fn cons_rec(x: { a: int64, b: int64 }, acc: List[{ a: int64, b: int64 }, mem(normal)]) -> List[{ a: int64, b: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ a: int64, b: int64 }, mem(normal)] <- prepend[{ a: int64, b: int64 }, mem(normal)](x, acc)
    produces
        pure r
    end
}

// b: one allocation (its block is mapped by it) and the bytes it counted as its reply.
fn beh_b(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[mem(normal)]
        h0: int64 <- heap_used();
        l: List[int64, mem(normal)] <- cons_int(msg, nil_int());
        h1: int64 <- heap_used()
    produces
        pure (:reply, h1 - h0, h1 - h0 + l.head - msg)
    end
}

// c: a relay for the driver's polls; answers heap_used().
fn beh_c(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[mem(normal)]
        h: int64 <- heap_used()
    produces
        pure (:reply, h, state)
    end
}

// a: message 1 is the setup described above (the state becomes the list whose head is the box);
// message 2 returns the box through ident.
fn beh_a(msg: (int64, actor_ref), state: List[{ a: int64, b: int64 }, mem(normal)]) -> (:reply, int64, List[{ a: int64, b: int64 }, mem(normal)]) {
    (which: int64, b: actor_ref) <- msg;
    case which == 1 of {
        true -> {
            sequence proc[concurrency]
                first: List[int64, mem(normal)] <- cons_int(1, nil_int());
                b_bytes: int64 <- call(b, 1 impl ActorMessage {});
                last: { a: int64, b: int64 } <- mk(1);
                boxed: List[{ a: int64, b: int64 }, mem(normal)] <- cons_rec(last, nil_rec());
                placed: int64 <- case b_bytes >= 0 and first.head == 1 of {
                    true -> 9;
                    false -> 6
                }
            produces
                pure (:reply, placed, boxed)
            end
        };
        false -> {
            got: { a: int64, b: int64 } <- ident(state.head);
            (:reply, got.a + got.b, state)
        }
    }
}

// True once heap_used() has fallen by more than b's block (its 64 MB go back when its exit path
// unmaps them); false after `tries` polls, each a call to c (a park, so a carrier shared with b
// runs b's exit).
fn released(before: int64, c: actor_ref, tries: int64) -> boolean {
    sequence proc[concurrency]
        h: int64 <- call(c, 1 impl ActorMessage {});
        gone: boolean <- before - h > 60000000;
        r: boolean <- case gone or tries <= 0 of {
            true -> gone;
            false -> released(before, c, tries - 1)
        }
    produces
        pure r
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io, mem(normal)]
                a: actor_ref <- spawn(nil_rec(), beh_a, stack_policy(0, :keep_last_message));
                b: actor_ref <- spawn(0, beh_b, stack_policy(0, :keep_last_message));
                c: actor_ref <- spawn(0, beh_c, stack_policy(0, :keep_last_message));
                placed: int64 <- call(a, (1, b) impl ActorMessage {});
                print_int64(placed);
                println("");
                before: int64 <- heap_used();
                _: atom <- remove_actor(b);
                _: boolean <- released(before, c, 100000);
                sum: int64 <- call(a, (2, c) impl ActorMessage {});
                print_int64(sum);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
