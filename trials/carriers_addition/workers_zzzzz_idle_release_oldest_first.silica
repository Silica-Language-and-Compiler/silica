// Carriers, the :release_when_idle idle-stack budget (release_when_idle_design.md §3, trial 2): over
// budget, a carrier releases the OLDEST listed idle stack first, never the newest. The suite runs
// this trial with SILICA_IDLE_STACK_BUDGET=1048576 (the .env file beside it: 1 MB for the process,
// split over the carriers, at least 16 platform pages each). Every actor is spawned for core 1, so all
// of them are on the carrier of core 1 whatever the carrier count: a is spawned and called first, then
// 400 others are spawned and called in turn. 401 one-page stacks exceed the carrier's budget on every
// host (401 x 4 KB = 1.6 MB), so by the time the last call returns the carrier has swept its head, a,
// while the last one, the tail, is still held (the budget keeps at least 16 of them). Then every
// actor is released to nothing within the bounded poll (the idle period; the tick delay is the one
// workers_zzzzz_idle_release_budget_bounds_burst describes).
//
// Expected output: true (a released), true (the newest still held), true (all released), 0. The same
// at every carrier count.

use trial_support_int64;

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state + 1)
}

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn tick(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

// Spawns n :release_when_idle actors for core 1, calls each once, and returns them (newest first).
fn spawn_all(n: int64, acc: List[actor_ref, mem(normal)]) -> List[actor_ref, mem(normal)] {
    case n == 0 of {
        true -> acc;
        false -> {
            sequence proc[concurrency, mem(normal)]
                w: actor_ref <- spawn(0, beh, stack_policy(65536, :release_when_idle), 1);
                _: int64 <- call(w, n impl ActorMessage {});
                next: List[actor_ref, mem(normal)] <- prepend[actor_ref, mem(normal)](w, acc);
                rest: List[actor_ref, mem(normal)] <- spawn_all(n - 1, next)
            produces
                pure rest
            end
        }
    }
}

fn sum_committed(refs: List[actor_ref, mem(normal)], acc: int64) -> int64 {
    case refs.is_nil of {
        true -> acc;
        false -> {
            sequence proc[concurrency]
                u: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(refs.head);
                r: int64 <- sum_committed(refs.tail, acc + u.committed)
            produces
                pure r
            end
        }
    }
}

fn poll_released(refs: List[actor_ref, mem(normal)], t: actor_ref, n: int64) -> boolean {
    total: int64 <- sum_committed(refs, 0);
    case total == 0 of {
        true -> true;
        false -> tick_then_poll(refs, t, n)
    }
}

fn tick_then_poll(refs: List[actor_ref, mem(normal)], t: actor_ref, n: int64) -> boolean {
    case n == 0 of {
        true -> false;
        false -> {
            sequence proc[concurrency]
                _: int64 <- call(t, 200000 impl ActorMessage {});
                r: boolean <- poll_released(refs, t, n - 1)
            produces
                pure r
            end
        }
    }
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        t: actor_ref <- spawn(0, tick, stack_policy(0, :release_on_return));
        a: actor_ref <- spawn(0, beh, stack_policy(65536, :release_when_idle), 1);
        _: int64 <- call(a, 1 impl ActorMessage {});
        first: List[actor_ref, mem(normal)] <- [a];
        refs: List[actor_ref, mem(normal)] <- spawn_all(400, first);
        ua: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(a);
        ul: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(refs.head);
        print_boolean(ua.committed == 0 and ua.high_water > 0);
        println("");
        print_boolean(ul.committed > 0);
        println("");
        released: boolean <- poll_released(refs, t, 2000);
        print_boolean(released);
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 { drive() });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
