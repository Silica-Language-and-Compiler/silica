// Carriers (actor_memory_budget_plan.md item N, stage 2): calls between actors bound to different
// carriers. A is spawned for core 1 and B for core 2 (`core mod N`: distinct carriers whenever
// there are two, the same one when SILICA_CARRIER_COUNT=1), and the driver (the trial support's
// worker, bound in turn) calls A, whose behaviour calls B. Each call parks the caller on its own
// carrier; the reply pushes it back on that carrier's run queue from the callee's carrier and
// wakes the carrier when it sleeps (_silica_rt_call_wrapper_wake -> _silica_rt_carrier_push). Three
// hundred rounds, so the carriers wake each other hundreds of times; B counts its calls.
//
//   round x (1..300): B replies x * 2; A replies that + 1. The driver sums A's replies:
//   sum of (2x + 1) for x = 1..300 = 2 * 45150 + 300 = 90600. Then B's count: 300.
//
// Expected output: 90600, 300, exit status 0. The same with SILICA_CARRIERS=0 and at every
// carrier count.

use trial_support_int64;

fn b_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    case msg == 0 of {
        true -> (:reply, state, state);
        false -> (:reply, msg * 2, state + 1)
    }
}

fn a_beh(msg: int64, state: actor_ref) -> (:reply, int64, actor_ref) {
    sequence proc[concurrency]
        r: int64 <- call(state, msg impl ActorMessage {})
    produces
        pure (:reply, r + 1, state)
    end
}

fn rounds(a: actor_ref, n: int64, acc: int64) -> int64 {
    case n == 0 of {
        true -> acc;
        false -> {
            sequence proc[concurrency]
                r: int64 <- call(a, n impl ActorMessage {});
                rest: int64 <- rounds(a, n - 1, acc + r)
            produces
                pure rest
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                b: actor_ref <- spawn(0, b_beh, stack_policy(1048576, :keep_last_message), 2);
                a: actor_ref <- spawn(b, a_beh, stack_policy(1048576, :keep_last_message), 1);
                total: int64 <- rounds(a, 300, 0);
                b_count: int64 <- call(b, 0 impl ActorMessage {});
                print_int64(total);
                println("");
                print_int64(b_count);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
