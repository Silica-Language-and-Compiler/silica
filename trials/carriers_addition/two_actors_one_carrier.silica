// Carriers (actor_memory_budget_plan.md item N, stage 1): two plain actors share the one carrier
// thread, and the worker that drives them is a third actor on it. The worker calls A then B three
// hundred times in turn, so each call parks the worker, runs the callee on the carrier and resumes
// the worker with the reply; A counts ones and B counts twos. Both finish with the expected totals,
// read back with a peek (a 0 message) at the end.
//
// Expected output: 300, 600, exit status 0. The same with SILICA_CARRIERS=0 (a thread per actor).

use trial_support_int64;

fn counter(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn ping_both(a: actor_ref, b: actor_ref, n: int64, acc: int64) -> int64 {
    case n == 0 of {
        true -> acc;
        false -> {
            sequence proc[concurrency]
                ra: int64 <- call(a, 1 impl ActorMessage {});
                rb: int64 <- call(b, 2 impl ActorMessage {});
                rest: int64 <- ping_both(a, b, n - 1, acc + ra + rb)
            produces
                pure rest
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[concurrency, device_io]
                a: actor_ref <- spawn(0, counter, stack_policy(1048576, :release_on_return));
                b: actor_ref <- spawn(0, counter, stack_policy(1048576, :release_on_return));
                _: int64 <- ping_both(a, b, 300, 0);
                total_a: int64 <- call(a, 0 impl ActorMessage {});
                total_b: int64 <- call(b, 0 impl ActorMessage {});
                print_int64(total_a);
                println("");
                print_int64(total_b);
                println("")
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
