// Carriers (actor_memory_budget_plan.md item N, stage 3): migrate_actor of an idle carrier actor
// binds it to the target carrier at once (nothing of it is queued or listed; mail for it takes the
// lock the move holds), and of one idle on its carrier's sweep list (:release_when_idle with
// committed stack) takes it off that list first and lists it on the target. A move to the core it
// is on answers :ok and changes nothing. Facts are equalities with probes spawned for the cores,
// so they hold at every carrier count and with the gate off.
//
//   a (core 1, never messaged): migrate to 2 answers :ok and a is on core 2's carrier at once;
//   it answers a call there (5); migrate to 2 again: :ok, unchanged; migrate to 1: :ok, on core
//   1's carrier after one more call settles the dispatch the move may have been requested in;
//   r (:release_when_idle, core 1), called once so it holds committed stack and is listed when
//   idle: migrate to 2 answers :ok and r is on core 2's carrier.
//
// Expected output: 9, :ok, 9, 5, :ok, 9, :ok, 9, :ok, 9, exit status 0. The same with
// SILICA_CARRIERS=0 and at every carrier count.

use trial_support_int64;

fn probe(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        p1: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        p2: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 2);
        a: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        r: actor_ref <- spawn(0, probe, stack_policy(1048576, :release_when_idle), 1);
        i_p1: int64 <- actor_carrier_index(p1);
        i_p2: int64 <- actor_carrier_index(p2);
        i0: int64 <- actor_carrier_index(a);
        print_int64(verdict(i0 == i_p1));
        println("");
        m1: atom <- migrate_actor(a, 2);
        _: atom <- print_atom(m1);
        println("");
        i1: int64 <- actor_carrier_index(a);
        print_int64(verdict(i1 == i_p2));
        println("");
        v: int64 <- call(a, 5 impl ActorMessage {});
        print_int64(v);
        println("");
        m2: atom <- migrate_actor(a, 2);
        _: atom <- print_atom(m2);
        println("");
        _: int64 <- call(a, 1 impl ActorMessage {});
        i2: int64 <- actor_carrier_index(a);
        print_int64(verdict(i2 == i_p2));
        println("");
        m3: atom <- migrate_actor(a, 1);
        _: atom <- print_atom(m3);
        println("");
        _: int64 <- call(a, 1 impl ActorMessage {});
        i3: int64 <- actor_carrier_index(a);
        print_int64(verdict(i3 == i_p1));
        println("");
        _: int64 <- call(r, 1 impl ActorMessage {});
        m4: atom <- migrate_actor(r, 2);
        _: atom <- print_atom(m4);
        println("");
        _: int64 <- call(r, 1 impl ActorMessage {});
        i4: int64 <- actor_carrier_index(r);
        print_int64(verdict(i4 == i_p2));
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 { drive() });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
