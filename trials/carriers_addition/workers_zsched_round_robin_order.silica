// Carriers (actor_memory_budget_plan.md item N, stage 4): set_scheduler_policy(:round_robin) on one
// carrier: every push lands in the carrier's normal queue whatever the actor's priority, so the
// three actors take turns in arrival order (l was made ready first, then n, then h) and every
// actor with mail left goes to the tail: L N H L N H L N H L N H, against
// workers_zsched_priority_fifo_order, the same program under the default policy (the board's
// scheduler_policy_addition/scheduler_policy_round_robin_order). The actors and the driver share
// core 1's carrier at every count, and the driver's one dispatch queues everything before the
// first turn.
//
// Expected output under SILICA_CARRIERS=1, at every carrier count: :ok, then the twelve turns in
// that order, exit status 0. With the gate off the same lines, compared as a multiset.

use trial_wait_int64;

fn turn(msg: int64, tag: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        name: string <- case tag of { 0 -> "L"; 1 -> "N"; _: int64 -> "H" };
        println(concat("turn ", name))
    produces
        pure (:no_reply, tag)
    end
}

fn driver(msg: int64, refs: { l: actor_ref, n: actor_ref, h: actor_ref }) -> (:no_reply, { l: actor_ref, n: actor_ref, h: actor_ref }) {
    sequence proc[concurrency, device_io]
        _: atom <- set_actor_priority(refs.l, :low);
        _: atom <- set_actor_priority(refs.n, :normal);
        _: atom <- set_actor_priority(refs.h, :high);
        p: atom <- set_scheduler_policy(:round_robin);
        _: atom <- print_atom(p);
        println("");
        _: boolean <- cast(refs.l, 1 impl ActorMessage {});
        _: boolean <- cast(refs.n, 1 impl ActorMessage {});
        _: boolean <- cast(refs.h, 1 impl ActorMessage {});
        _: boolean <- cast(refs.l, 2 impl ActorMessage {});
        _: boolean <- cast(refs.n, 2 impl ActorMessage {});
        _: boolean <- cast(refs.h, 2 impl ActorMessage {});
        _: boolean <- cast(refs.l, 3 impl ActorMessage {});
        _: boolean <- cast(refs.n, 3 impl ActorMessage {});
        _: boolean <- cast(refs.h, 3 impl ActorMessage {});
        _: boolean <- cast(refs.l, 4 impl ActorMessage {});
        _: boolean <- cast(refs.n, 4 impl ActorMessage {});
        _: boolean <- cast(refs.h, 4 impl ActorMessage {})
    produces
        pure (:no_reply, refs)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency]
        l: actor_ref <- spawn(0, turn, stack_policy(1048576, :keep_last_message), 1);
        n: actor_ref <- spawn(1, turn, stack_policy(1048576, :keep_last_message), 1);
        h: actor_ref <- spawn(2, turn, stack_policy(1048576, :keep_last_message), 1);
        d: actor_ref <- spawn({ l: l, n: n, h: h }, driver, stack_policy(1048576, :keep_last_message), 1);
        _: boolean <- cast(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
