// Carriers (actor_memory_budget_plan.md item N, carrier-runtime gap 7: LBB1_wait in
// prims_actors_runtime_asm.silica): two Phase B trial-hook nodes (supervision_ingress_enqueue: an
// inline int64 the target's behaviour runs on) are put in a plain counter's ingress, then the
// counter is called. The hook nodes are served before standard mail. Before the fix the first hook
// node took the supervision block's restart token with it at LBB1_wait and neither result path
// released it (both clear w22), so the counter skipped its own ingress for the rest of its life:
// the second hook was never run and the call answered 5. Now a hook node takes no token: 5, then
// 7, then the call answers 12.
//
// Expected output: 12, done, exit status 0, at every SILICA_CARRIER_COUNT (5 before the fix).
//
// The driver runs on the trial support's worker (trial_wait_int64: a plain actor on a carrier) and
// prints done last; main waits for the exit line. trial_wait_int64 (not trial_support_int64) makes
// this unit compile after the suite's other trial_wait users, so its new atoms renumber none of
// theirs.

use trial_wait_int64;

fn counter(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

// The hooks are behaviour-only builtins (E2091): a hooker actor, given the counter as its
// message, enqueues both and replies with the counter's answer to a call.
fn hooker(msg: actor_ref, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        _: atom <- supervision_ingress_enqueue(msg, 5);
        _: atom <- supervision_ingress_enqueue(msg, 7);
        total: int64 <- call(msg, 0 impl ActorMessage {})
    produces
        pure (:reply, total, state)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, counter, stack_policy(0, :keep_last_message));
        h: actor_ref <- spawn(0, hooker, stack_policy(0, :keep_last_message));
        total: int64 <- call(h, w impl ActorMessage {});
        print_int64(total);
        println("");
        println("done")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
