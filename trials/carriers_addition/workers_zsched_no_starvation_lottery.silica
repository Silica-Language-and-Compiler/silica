// Carriers (actor_memory_budget_plan.md item N, stage 4): no starvation under :lottery. A high
// actor h feeds itself one message per dispatch for K dispatches, so its queue is never empty; a
// low actor l on the same carrier (both spawned for core 1) gets one message and, when it runs,
// casts a mark to h, which records its count at the mark. Under :lottery the low tier holds one
// ticket against the high tier's four at every draw, so l is expected at the fifth draw and the
// chance that K draws pass it by is 0.8 to the K: the count at the mark is below K. With the gate
// off the two are threads and the mark arrives while h is still counting, so the verdict is 9
// under either gate and at every carrier count.
//
// Expected output: 9, done, exit status 0.

use trial_wait_int64;

fn k() -> int64 {
    100000
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

// Casts the next step to the feeder (a cast inside a case arm is not parsed: the `impl` braces).
fn feed(me: actor_ref) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(me, 1 impl ActorMessage {})
    produces
        pure sent
    end
}

// Message 1: a step. Message 2: the mark (count below K).
fn feeder(msg: int64, count: int64) -> (:no_reply, int64) {
    case msg == 1 of {
        true -> {
            sequence proc[concurrency]
                next: int64 <- count + 1;
                below: boolean <- next < k();
                me: actor_ref <- self();
                _: boolean <- case below of {
                    true -> feed(me);
                    false -> true
                }
            produces
                pure (:no_reply, next)
            end
        };
        false -> {
            sequence proc[device_io]
                print_int64(verdict(count < k()));
                println("");
                println("done")
            produces
                pure (:no_reply, count)
            end
        }
    }
}

fn low(msg: int64, h: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        _: boolean <- cast(h, 2 impl ActorMessage {})
    produces
        pure (:no_reply, h)
    end
}

fn driver(msg: int64, refs: { h: actor_ref, l: actor_ref }) -> (:no_reply, { h: actor_ref, l: actor_ref }) {
    sequence proc[concurrency]
        _: atom <- set_actor_priority(refs.h, :high);
        _: atom <- set_actor_priority(refs.l, :low);
        _: atom <- set_scheduler_policy(:lottery);
        _: boolean <- cast(refs.h, 1 impl ActorMessage {});
        _: boolean <- cast(refs.l, 1 impl ActorMessage {})
    produces
        pure (:no_reply, refs)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency]
        h: actor_ref <- spawn(0, feeder, stack_policy(1048576, :keep_last_message), 1);
        l: actor_ref <- spawn(h, low, stack_policy(1048576, :keep_last_message), 1);
        d: actor_ref <- spawn({ h: h, l: l }, driver, stack_policy(1048576, :keep_last_message), 1);
        _: boolean <- cast(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
