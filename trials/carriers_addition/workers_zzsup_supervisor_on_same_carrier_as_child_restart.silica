// Supervisors on carriers (actor_memory_budget_plan.md item N, "Carriers are the only model"): a
// supervisor, its row child and the child's killer all on ONE carrier, core 1's (`core mod N`, the
// same carrier at every carrier count). The supervisor is spawned for core 1; its row child is
// bound in turn (a spec carries no core id) and the program moves it to core 1; the killer is
// spawned for core 1. kill_abnormal parks the killer on the child's row wait list; the child's
// exit runs on the carrier; the supervisor's own dispatch serves the exit notice on its own stack
// (LBB1_ingress_no_beh) and respawns the row, which the killer's drain then finds settled. Before
// supervisors ran on carriers the supervisor had a thread of its own and this needed no park.
// Facts are equalities with a probe spawned for core 1, so they hold at every carrier count.
//
//   call child 5 -> 505; migrate child to 1 -> :ok; after a call it is on core 1's carrier (9);
//   the killer's kill_abnormal -> :ok (9); the replacement answers 505 again (initial state);
//   migrate of the replacement to 1 -> :ok and after a call it is on core 1's carrier (9).
//
// Expected output: 505, :ok, 9, 9, 505, :ok, 9, one failure report (the kill, reason_tag 1, frame
// #0 the counter), done, exit status 0, compared as a multiset (the report is asynchronous; the
// printed values avoid the digits 1-4 and 8, which compare_scout_multiset.sh folds).

use Supervisor;
use trial_wait_int64;

impl ZzsupSameCarrierSup for Supervisor;

fn counter(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn probe(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

// The killer, on core 1's carrier with the supervisor and its child: its wait for the row's
// exit_done is a park on that carrier, which then runs the child's exit and the supervisor's
// restart. Replies 9 when kill_abnormal answered :ok.
fn killer(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        killed: atom <- kill_abnormal(:zzsup_same_child);
        v: int64 <- case killed of { :ok -> 9; _: atom -> 6 }
    produces
        pure (:reply, v, state)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :zzsup_same_child, agent_type: :worker, initial_state: initial_state + 500, behavior: counter, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        p1: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        i_p1: int64 <- actor_carrier_index(p1);
        sup: supervisor_ref <- spawn_registered_supervisor(ZzsupSameCarrierSup, 0, :zzsup_same_sup, stack_policy(0, :keep_last_message), 1);
        b1: int64 <- call_registered(:zzsup_same_child, 5 impl ActorMessage {});
        print_int64(b1);
        println("");
        first: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: :zzsup_same_child } impl SupervisorMessage {});
        child: actor_ref <- first.child;
        m1: atom <- migrate_actor(child, 1);
        _: atom <- print_atom(m1);
        println("");
        _: int64 <- call_registered(:zzsup_same_child, 0 impl ActorMessage {});
        i1: int64 <- actor_carrier_index(child);
        print_int64(verdict(i1 == i_p1));
        println("");
        k: actor_ref <- spawn(0, killer, stack_policy(1048576, :keep_last_message), 1);
        killed: int64 <- call(k, 0 impl ActorMessage {});
        print_int64(killed);
        println("");
        a1: int64 <- call_registered(:zzsup_same_child, 5 impl ActorMessage {});
        print_int64(a1);
        println("");
        second: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: :zzsup_same_child } impl SupervisorMessage {});
        replacement: actor_ref <- second.child;
        m2: atom <- migrate_actor(replacement, 1);
        _: atom <- print_atom(m2);
        println("");
        _: int64 <- call_registered(:zzsup_same_child, 0 impl ActorMessage {});
        i2: int64 <- actor_carrier_index(replacement);
        print_int64(verdict(i2 == i_p1));
        println("");
        println("done")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
