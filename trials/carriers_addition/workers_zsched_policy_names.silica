// Carriers (actor_memory_budget_plan.md item N, stage 4): set_scheduler_policy(policy: atom) ->
// :ok | :invalid_policy on a hosted target, as on the board (scheduler_policy_addition/
// scheduler_policy_names_accepted's board golden): the four names are accepted, an atom that names
// none of them is rejected and leaves the policy as it was, the policy may be changed at any time
// (here after an actor exists and again after the rejection), and a program keeps running under
// whichever policy is in force. The answer does not depend on the gate: with it off the runtime
// stores the policy and nothing reads it.
//
// Expected output: :ok, :ok, :ok, :ok, :invalid_policy, rejected, :ok, 0, done, exit status 0,
// under either gate and at every carrier count (the trial_wait support, so that its atoms are
// numbered after every trial_support trial's and no existing .ascomp moves).

use trial_wait_int64;

fn counter(msg: int64, count: int64) -> (:reply, int64, int64) {
    (:reply, count, count + 1)
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        c: actor_ref <- spawn(0, counter, stack_policy(1048576, :keep_last_message), 1);
        a: atom <- set_scheduler_policy(:priority_fifo);
        _: atom <- print_atom(a);
        println("");
        b: atom <- set_scheduler_policy(:round_robin);
        _: atom <- print_atom(b);
        println("");
        d: atom <- set_scheduler_policy(:weighted_fair);
        _: atom <- print_atom(d);
        println("");
        e: atom <- set_scheduler_policy(:lottery);
        _: atom <- print_atom(e);
        println("");
        f: atom <- set_scheduler_policy(:first_come_first_served);
        _: atom <- print_atom(f);
        println("");
        verdict: string <- case f of { :invalid_policy -> "rejected"; _: atom -> "accepted" };
        println(verdict);
        g: atom <- set_scheduler_policy(:priority_fifo);
        _: atom <- print_atom(g);
        println("");
        seen: int64 <- call(c, 7 impl ActorMessage {});
        print_int64(seen);
        println("");
        println("done")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
