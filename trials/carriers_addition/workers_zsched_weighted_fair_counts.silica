// Carriers (actor_memory_budget_plan.md item N, stage 4): set_scheduler_policy(:weighted_fair) with
// eighteen casts queued to three actors of the three priority tiers on one carrier before any of
// them runs: the program completes and every actor has seen exactly its five counted casts when it
// handles its report (the board's scheduler_policy_addition/scheduler_policy_weighted_fair_counts).
// Here the order of the three reports is defined too, since the driver and the actors share core
// 1's carrier at every count: the high actor's six messages (five counted and the report) are
// served in its first two quanta (H H H H, N N, L, H H), then the normal actor's last two in its
// next quantum, then the low actor's last ones: H, N, L.
//
// Expected output under SILICA_CARRIERS=1, at every carrier count: :ok, H seen 5, N seen 5,
// L seen 5, exit status 0. With the gate off the same lines, compared as a multiset.

use trial_wait_int64;

// A cast-only counter: the state starts at 0 (low), 100 (normal) or 200 (high) and every message
// adds one; message 0 is the report, cast after the five counted messages and so handled after them
// (one mailbox, FIFO): it prints one line naming the actor and its count. Any other count prints a
// line the golden does not have.
fn counter(msg: int64, count: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        next: int64 <- case msg of {
            0 -> {
                println(case count of { 5 -> "L seen 5"; 105 -> "N seen 5"; 205 -> "H seen 5"; _: int64 -> "unexpected count" });
                count
            }
            _: int64 -> count + 1
        }
    produces
        pure (:no_reply, next)
    end
}

fn driver(msg: int64, refs: { l: actor_ref, n: actor_ref, h: actor_ref }) -> (:no_reply, { l: actor_ref, n: actor_ref, h: actor_ref }) {
    sequence proc[concurrency, device_io]
        _: atom <- set_actor_priority(refs.l, :low);
        _: atom <- set_actor_priority(refs.n, :normal);
        _: atom <- set_actor_priority(refs.h, :high);
        p: atom <- set_scheduler_policy(:weighted_fair);
        _: atom <- print_atom(p);
        println("");
        _: boolean <- cast(refs.l, 1 impl ActorMessage {});
        _: boolean <- cast(refs.n, 1 impl ActorMessage {});
        _: boolean <- cast(refs.h, 1 impl ActorMessage {});
        _: boolean <- cast(refs.l, 2 impl ActorMessage {});
        _: boolean <- cast(refs.n, 2 impl ActorMessage {});
        _: boolean <- cast(refs.h, 2 impl ActorMessage {});
        _: boolean <- cast(refs.l, 3 impl ActorMessage {});
        _: boolean <- cast(refs.n, 3 impl ActorMessage {});
        _: boolean <- cast(refs.h, 3 impl ActorMessage {});
        _: boolean <- cast(refs.l, 4 impl ActorMessage {});
        _: boolean <- cast(refs.n, 4 impl ActorMessage {});
        _: boolean <- cast(refs.h, 4 impl ActorMessage {});
        _: boolean <- cast(refs.l, 5 impl ActorMessage {});
        _: boolean <- cast(refs.n, 5 impl ActorMessage {});
        _: boolean <- cast(refs.h, 5 impl ActorMessage {});
        _: boolean <- cast(refs.l, 0 impl ActorMessage {});
        _: boolean <- cast(refs.n, 0 impl ActorMessage {});
        _: boolean <- cast(refs.h, 0 impl ActorMessage {})
    produces
        pure (:no_reply, refs)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency]
        l: actor_ref <- spawn(0, counter, stack_policy(1048576, :keep_last_message), 1);
        n: actor_ref <- spawn(100, counter, stack_policy(1048576, :keep_last_message), 1);
        h: actor_ref <- spawn(200, counter, stack_policy(1048576, :keep_last_message), 1);
        d: actor_ref <- spawn({ l: l, n: n, h: h }, driver, stack_policy(1048576, :keep_last_message), 1);
        _: boolean <- cast(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
