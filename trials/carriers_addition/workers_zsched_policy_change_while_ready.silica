// Carriers (actor_memory_budget_plan.md item N, stage 4): a policy change takes effect at the next
// push or pop on every carrier and leaves queued actors where they are (the board's rule, rt_actors.S
// "Dispatch-order policies"). The driver, on the same carrier as the three actors, queues the
// twelve casts under :priority_fifo (l lands in the low queue, n in the normal, h in the high) and
// then switches to :round_robin before it returns. The first pop still takes the head of the
// highest-priority non-empty queue (h), but every push from then on lands in the normal queue, so
// h and n alternate from the normal queue while l waits in the low queue until the normal one is
// empty: H N H N H N H N L L L L.
//
// Expected output under SILICA_CARRIERS=1, at every carrier count: :ok (priority_fifo), then the
// twelve turns in that order, exit status 0. With the gate off the same lines, compared as a
// multiset (the switch's own answer is not printed: with the gate off the turn actors are threads
// already running while the driver prints, and two prints on two threads can share a line;
// workers_zsched_policy_names shows the answer).

use trial_wait_int64;

fn turn(msg: int64, tag: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        name: string <- case tag of { 0 -> "L"; 1 -> "N"; _: int64 -> "H" };
        println(concat("turn ", name))
    produces
        pure (:no_reply, tag)
    end
}

fn driver(msg: int64, refs: { l: actor_ref, n: actor_ref, h: actor_ref }) -> (:no_reply, { l: actor_ref, n: actor_ref, h: actor_ref }) {
    sequence proc[concurrency, device_io]
        _: atom <- set_actor_priority(refs.l, :low);
        _: atom <- set_actor_priority(refs.n, :normal);
        _: atom <- set_actor_priority(refs.h, :high);
        p: atom <- set_scheduler_policy(:priority_fifo);
        _: atom <- print_atom(p);
        println("");
        _: boolean <- cast(refs.l, 1 impl ActorMessage {});
        _: boolean <- cast(refs.n, 1 impl ActorMessage {});
        _: boolean <- cast(refs.h, 1 impl ActorMessage {});
        _: boolean <- cast(refs.l, 2 impl ActorMessage {});
        _: boolean <- cast(refs.n, 2 impl ActorMessage {});
        _: boolean <- cast(refs.h, 2 impl ActorMessage {});
        _: boolean <- cast(refs.l, 3 impl ActorMessage {});
        _: boolean <- cast(refs.n, 3 impl ActorMessage {});
        _: boolean <- cast(refs.h, 3 impl ActorMessage {});
        _: boolean <- cast(refs.l, 4 impl ActorMessage {});
        _: boolean <- cast(refs.n, 4 impl ActorMessage {});
        _: boolean <- cast(refs.h, 4 impl ActorMessage {});
        _: atom <- set_scheduler_policy(:round_robin)
    produces
        pure (:no_reply, refs)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency]
        l: actor_ref <- spawn(0, turn, stack_policy(1048576, :keep_last_message), 1);
        n: actor_ref <- spawn(1, turn, stack_policy(1048576, :keep_last_message), 1);
        h: actor_ref <- spawn(2, turn, stack_policy(1048576, :keep_last_message), 1);
        d: actor_ref <- spawn({ l: l, n: n, h: h }, driver, stack_policy(1048576, :keep_last_message), 1);
        _: boolean <- cast(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
