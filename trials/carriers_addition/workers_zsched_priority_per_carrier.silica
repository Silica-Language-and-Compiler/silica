// Carriers (actor_memory_budget_plan.md item N, stage 4): the priority queues are per carrier, and
// :priority_fifo is strict within a carrier. A high actor h on core 1's carrier feeds itself one
// message per dispatch for K dispatches, so it always has mail and its queue is never empty; a low
// actor l on core 2's carrier (core 1's own at a carrier count of 1) gets one message and, when it
// runs, casts a mark to h; h records its count at the mark. On another carrier l runs at once,
// whatever waits in core 1's high queue, so the mark arrives while h's count is below K; on the
// same carrier l waits until h's queue is empty, so the mark arrives at count K exactly: the
// documented caveat of :priority_fifo (prims_actors_carrier_asm.silica header; the bound of spec
// §22.10 holds there only while the higher tiers drain, and :weighted_fair gives it under load,
// workers_zsched_no_starvation_weighted_fair). l tells h which case holds, read from
// actor_carrier_index (equal and non-negative: the same carrier; -1 with the gate off: threads,
// independent), so the verdict is 9 at every carrier count and under either gate.
//
// Expected output: 9, done, exit status 0.

use trial_wait_int64;

fn k() -> int64 {
    100000
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

// Casts the next step to the feeder (a cast inside a case arm is not parsed: the `impl` braces).
fn feed(me: actor_ref) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast(me, 1 impl ActorMessage {})
    produces
        pure sent
    end
}

// Message 1: a step (the count rises by one and, below K, the next step is cast to itself).
// Message 2: the mark from a low actor on the same carrier (expects the count to be K).
// Message 3: the mark from a low actor elsewhere (expects the count to be below K).
fn feeder(msg: int64, count: int64) -> (:no_reply, int64) {
    case msg == 1 of {
        true -> {
            sequence proc[concurrency]
                next: int64 <- count + 1;
                below: boolean <- next < k();
                me: actor_ref <- self();
                _: boolean <- case below of {
                    true -> feed(me);
                    false -> true
                }
            produces
                pure (:no_reply, next)
            end
        };
        false -> {
            sequence proc[device_io]
                holds: boolean <- case msg == 2 of {
                    true -> count == k();
                    false -> count < k()
                };
                print_int64(verdict(holds));
                println("");
                println("done")
            produces
                pure (:no_reply, count)
            end
        }
    }
}

// The low actor: its state is the feeder; on its one message it marks the feeder with 2 when they
// share a carrier and 3 otherwise.
fn low(msg: int64, h: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        here: int64 <- actor_carrier_index(self());
        there: int64 <- actor_carrier_index(h);
        same: boolean <- here >= 0 and here == there;
        mark: int64 <- case same of { true -> 2; false -> 3 };
        _: boolean <- cast(h, mark impl ActorMessage {})
    produces
        pure (:no_reply, h)
    end
}

// The driver, on core 1's carrier with h: sets the levels and the policy and queues h's first step
// before l's message, in one dispatch.
fn driver(msg: int64, refs: { h: actor_ref, l: actor_ref }) -> (:no_reply, { h: actor_ref, l: actor_ref }) {
    sequence proc[concurrency]
        _: atom <- set_actor_priority(refs.h, :high);
        _: atom <- set_actor_priority(refs.l, :low);
        _: atom <- set_scheduler_policy(:priority_fifo);
        _: boolean <- cast(refs.h, 1 impl ActorMessage {});
        _: boolean <- cast(refs.l, 1 impl ActorMessage {})
    produces
        pure (:no_reply, refs)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency]
        h: actor_ref <- spawn(0, feeder, stack_policy(1048576, :keep_last_message), 1);
        l: actor_ref <- spawn(h, low, stack_policy(1048576, :keep_last_message), 2);
        d: actor_ref <- spawn({ h: h, l: l }, driver, stack_policy(1048576, :keep_last_message), 1);
        _: boolean <- cast(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
