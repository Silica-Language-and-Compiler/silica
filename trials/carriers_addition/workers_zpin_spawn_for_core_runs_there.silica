// Carriers (actor_memory_budget_plan.md item N, stage 3): an actor spawned for a core runs on that
// core's carrier and stays there for its life unless the program moves it. The observable is the
// test-only query actor_carrier_index(ref): the index of the carrier the actor is bound to (ACB
// #440, the word the dispatcher reads to pick a run queue), -1 for an actor with a thread of its
// own. Nothing printed depends on the carrier count: every fact is an equality with a probe
// actor spawned for the same core, which binds to the same carrier (`core mod N`) at every count,
// and -1 == -1 holds with the gate off.
//
//   a and b spawned for core 2 share the carrier of the probe for core 2, and each other's;
//   100 calls to a (replies 1..100, sum 5050) leave a where it was;
//   an actor spawned for core 1 from a behaviour running on core 2's carrier lands on core 1's
//   carrier, and its spawner stays on core 2's.
//
// Expected output: 9, 9, 9, 5050, 9, 9, 9, exit status 0. The same with SILICA_CARRIERS=0 and at
// every carrier count.

use trial_support_int64;

fn probe(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn verdict(holds: boolean) -> int64 {
    case holds of {
        true -> 9;
        false -> 6
    }
}

// Spawns a child for core 1 from its own carrier, calls it once and replies the child's carrier.
fn spawner(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        c: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        _: int64 <- call(c, msg impl ActorMessage {});
        idx: int64 <- actor_carrier_index(c)
    produces
        pure (:reply, idx, state)
    end
}

fn rounds(a: actor_ref, n: int64, acc: int64) -> int64 {
    case n == 0 of {
        true -> acc;
        false -> {
            sequence proc[concurrency]
                r: int64 <- call(a, 1 impl ActorMessage {});
                rest: int64 <- rounds(a, n - 1, acc + r)
            produces
                pure rest
            end
        }
    }
}

fn drive() -> int64 {
    sequence proc[concurrency, device_io]
        p1: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 1);
        p2: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 2);
        a: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 2);
        b: actor_ref <- spawn(0, probe, stack_policy(1048576, :keep_last_message), 2);
        s: actor_ref <- spawn(0, spawner, stack_policy(1048576, :keep_last_message), 2);
        i_p1: int64 <- actor_carrier_index(p1);
        i_p2: int64 <- actor_carrier_index(p2);
        i_a: int64 <- actor_carrier_index(a);
        i_b: int64 <- actor_carrier_index(b);
        print_int64(verdict(i_a == i_p2));
        println("");
        print_int64(verdict(i_b == i_p2));
        println("");
        print_int64(verdict(i_a == i_b));
        println("");
        total: int64 <- rounds(a, 100, 0);
        print_int64(total);
        println("");
        i_a2: int64 <- actor_carrier_index(a);
        print_int64(verdict(i_a2 == i_p2));
        println("");
        child_idx: int64 <- call(s, 7 impl ActorMessage {});
        print_int64(verdict(child_idx == i_p1));
        println("");
        i_s: int64 <- actor_carrier_index(s);
        print_int64(verdict(i_s == i_p2));
        println("")
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 { drive() });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
