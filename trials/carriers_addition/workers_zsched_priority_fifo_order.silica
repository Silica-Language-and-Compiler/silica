// Carriers (actor_memory_budget_plan.md item N, stage 4): set_scheduler_policy(:priority_fifo), the
// default, on one carrier: among the ready actors of a carrier the highest-priority one runs first,
// and an actor with more mail goes back to the tail of its own queue at its dispatch boundary, so
// the high actor drains before the normal one starts and the low one waits for both (spec §22.10
// priority hints, §23.1.1; the board's scheduler_policy_addition/scheduler_policy_priority_fifo_order).
// The three actors and the driver are spawned for core 1, so they share one carrier at every
// carrier count (`core mod N`); the driver's one dispatch sets the priorities and the policy and
// queues the twelve casts, and since a carrier dispatches nothing while a behaviour runs on it,
// every message is queued before the first turn, as main's casts are on the board. Turns:
// H H H H N N N N L L L L.
//
// Expected output under SILICA_CARRIERS=1, at every carrier count: :ok, then the twelve turns in
// that order, exit status 0 (the marker file: the harness sends the exit line after the twelfth
// turn). With the gate off the actors are threads and the order is the OS's: the same lines are
// then compared as a multiset (the .scout.ordered_on_carriers marker, Makefile).

use trial_wait_int64;

// One behaviour for the three actors: the state is the actor's tag (0 low, 1 normal, 2 high) and
// every message prints one line, so the sequence of lines is the sequence of dispatches.
fn turn(msg: int64, tag: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        name: string <- case tag of { 0 -> "L"; 1 -> "N"; _: int64 -> "H" };
        println(concat("turn ", name))
    produces
        pure (:no_reply, tag)
    end
}

// The driver, on the same carrier as l, n and h: one dispatch that nothing of them interrupts.
fn driver(msg: int64, refs: { l: actor_ref, n: actor_ref, h: actor_ref }) -> (:no_reply, { l: actor_ref, n: actor_ref, h: actor_ref }) {
    sequence proc[concurrency, device_io]
        _: atom <- set_actor_priority(refs.l, :low);
        _: atom <- set_actor_priority(refs.n, :normal);
        _: atom <- set_actor_priority(refs.h, :high);
        p: atom <- set_scheduler_policy(:priority_fifo);
        _: atom <- print_atom(p);
        println("");
        _: boolean <- cast(refs.l, 1 impl ActorMessage {});
        _: boolean <- cast(refs.n, 1 impl ActorMessage {});
        _: boolean <- cast(refs.h, 1 impl ActorMessage {});
        _: boolean <- cast(refs.l, 2 impl ActorMessage {});
        _: boolean <- cast(refs.n, 2 impl ActorMessage {});
        _: boolean <- cast(refs.h, 2 impl ActorMessage {});
        _: boolean <- cast(refs.l, 3 impl ActorMessage {});
        _: boolean <- cast(refs.n, 3 impl ActorMessage {});
        _: boolean <- cast(refs.h, 3 impl ActorMessage {});
        _: boolean <- cast(refs.l, 4 impl ActorMessage {});
        _: boolean <- cast(refs.n, 4 impl ActorMessage {});
        _: boolean <- cast(refs.h, 4 impl ActorMessage {})
    produces
        pure (:no_reply, refs)
    end
}

fn drive() -> int64 {
    sequence proc[concurrency]
        l: actor_ref <- spawn(0, turn, stack_policy(1048576, :keep_last_message), 1);
        n: actor_ref <- spawn(1, turn, stack_policy(1048576, :keep_last_message), 1);
        h: actor_ref <- spawn(2, turn, stack_policy(1048576, :keep_last_message), 1);
        d: actor_ref <- spawn({ l: l, n: n, h: h }, driver, stack_policy(1048576, :keep_last_message), 1);
        _: boolean <- cast(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 { drive() });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
