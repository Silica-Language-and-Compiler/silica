// A behaviour whose body is a case, with an arm that returns a behaviour-shaped helper's
// (:no_reply, record) result. The helper builds the new state record in its frame (next_state);
// the behaviour's call site adopts the helper's frame part, and the behaviour's own epilogue then
// runs before the dispatch end copies the state. On the STM32-L476RG_raw board the helper used to
// return with its auxiliary SP put back to its entry value (the epilogue behaviours used), so the
// record lay below the behaviour's SP and the behaviour's epilogue pushes overwrote its fields: the
// second dispatch printed garbage (fail=0x2000xxxx ticks=0x1000xxxx) and the case on st.out faulted
// with "no case arm matched" (2026-11-10, found by the device_grounded_pa6 hand app).
// Expected: n=1..4 with pass = n - 1, fail = 7 from n=2, ticks = 0, out = 1 from n=3, then DONE and
// status 0.
//   n=1 pass=0 fail=0 ticks=0 out=0
//   n=2 pass=1 fail=7 ticks=0 out=0
//   n=3 pass=2 fail=7 ticks=0 out=1
//   n=4 pass=3 fail=7 ticks=0 out=1
//   DONE
//   0
use trial_wait_int64;

fn next_state(pass: uint32, fail: uint32, ticks: uint32, out: boolean) -> { pass: uint32, fail: uint32, ticks: uint32, out: boolean } {
    { pass: pass, fail: fail, ticks: ticks, out: out }
}

fn word(b: boolean) -> uint32 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn finish(step: uint32) -> atom {
    case step < 4 of {
        true -> :ok;
        false -> {
            sequence proc[concurrency, device_io]
                _: atom <- print_string("DONE\n");
                _: boolean <- cast_exit(0)
            produces
                pure :ok
            end
        }
    }
}

fn on_result(msg: { step: uint32, level: boolean }, st: { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) {
    sequence proc[device_io]
        _: atom <- print_string("n=");
        _: atom <- print_uint32(msg.step);
        _: atom <- print_string(" pass=");
        _: atom <- print_uint32(st.pass);
        _: atom <- print_string(" fail=");
        _: atom <- print_uint32(st.fail);
        _: atom <- print_string(" ticks=");
        _: atom <- print_uint32(st.ticks);
        _: atom <- print_string(" out=");
        _: atom <- print_uint32(word(st.out));
        _: atom <- print_string("\n");
        out: boolean <- case msg.step == 2 of {
            true -> true;
            false -> st.out
        };
        _: atom <- finish(msg.step)
    produces
        pure (:no_reply, next_state(st.pass + 1, 7, st.ticks, out))
    end
}

fn other(st: { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) {
    (:no_reply, st)
}

fn step(msg: { step: uint32, level: boolean }, st: { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) {
    case msg.step > 300 of {
        true -> other(st);
        false -> on_result(msg, st)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                c: actor_ref <- spawn({ pass: 0, fail: 0, ticks: 0, out: false }, step, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(c, { step: 1, level: false } impl ActorMessage {});
                _: boolean <- cast(c, { step: 2, level: false } impl ActorMessage {});
                _: boolean <- cast(c, { step: 3, level: false } impl ActorMessage {});
                _: boolean <- cast(c, { step: 4, level: false } impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
