// Spec §20.3.1: cast_dangerous_registered sends to the dangerous worker (an FFI worker spawned with
// spawn_dangerous_registered) that holds the name in the dangerous registry when the message is
// sent, and raises actor_not_found when no worker holds it, as cast_registered does. Here the caller
// is main, so the failure is the language-level failure of §15.4.5.5: the failure atom's name on
// standard error and exit status 1; nothing after the cast runs. The runtimes once answered an
// unheld dangerous name with a silent false.
//
// Expected output:
//   before
//   actor_not_found
// exit status 1

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        println("before");
        _: boolean <- cast_dangerous_registered(:dangerous_nobody_holds_this, 4 impl ActorMessage {});
        println("not reached")
    produces
        pure 0
    end
}
