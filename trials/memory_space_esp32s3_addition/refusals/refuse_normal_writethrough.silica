// Board refusal: normal_writethrough is not a memory space this board provides. The shared compiler accepts the program; the
// board emitter writes an assembler .error line for the alloc_region(normal_writethrough) operand and the ref/region types,
// so the failure shows when the .sams is assembled (see README.md).
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal_writethrough)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal_writethrough) <- alloc_region(normal_writethrough);
                cell: ref(L1, normal_writethrough, int64) <- alloc_ref(r, 20);
                value: int64 <- read_ref(cell)
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
