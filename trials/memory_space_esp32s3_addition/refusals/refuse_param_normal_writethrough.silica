// Board refusal: normal_writethrough appears ONLY in a function parameter type (the body and main use normal memory only).
// The board emitter scans the parameter's type text and writes the assembler .error line for it.
use trial_support_int64;

fn peek_cell(c: ref(R, normal_writethrough, int64)) -> int64 {
    0
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(normal)]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, normal) <- alloc_region(normal);
                cell: ref(L1, normal, int64) <- alloc_ref(r, 20);
                value: int64 <- read_ref(cell)
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
