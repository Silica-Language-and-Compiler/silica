// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: an atomic cell: store 177 over 20, load it back; expect 177. Each read_ref/write_ref on an atomic
// ref carries a barrier on both sides (memw); the .ascomp golden shows them. Needs the atomic effect too.
use trial_support_int64;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_support_int64@start();
        _: boolean <- trial_support_int64@run(fn() -> int64 {
            sequence proc[mem(atomic), atomic]
                L1: lifetime <- fresh_lifetime();
                r: region(L1, atomic) <- alloc_region(atomic);
                cell: ref(L1, atomic, int64) <- alloc_ref(r, 20);
                _: atom <- write_ref(cell, 177);
                value: int64 <- read_ref(cell)
            produces
                pure value
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
