// dangerous_ffi_adapter_tail_call  (OPEN: staged in bees_gaps_open_addition, see README.md)
//
// FFI spec §3.3: an exported adapter in a library unit wraps a foreign c_wrapper call, and a
// worker spawned with spawn_dangerous calls the adapter inside its external_danger sequence.
// Found in project BEES triage (SD-17 a, repros bees_triage/sd17a and sd17a2).
// The adapter dangerous_tail_adapter@add is `add_raw(left, right)`: the guarded foreign call is in
// tail position. Today (the stable compiler used for the BEES triage, Mac, 2026-10-23) the
// tail-call path emits the adapter's epilogue before the guarded foreign call, so X30 is clobbered
// and the worker faults inside dangerous_tail_adapter_add: "[silica] fault at ... in
// dangerous_tail_adapter_add+0x...", status 70. The same adapter written as
// `t: int64 <- add_raw(left, right); t + 0` (the sd17a2 repro) works.
// Expected: the worker adds 2 + 3 in C and casts 5 to the sink, which prints it and ends main's
// wait_for_exit with cast_exit(0).
//   5
//   done
//   0
module dangerous_ffi_adapter_tail_call;

use dangerous_tail_adapter;

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        print_int64(msg);
        println("");
        println("done");
        _: boolean <- cast_exit(0)
    produces pure (:no_reply, state + 1) end
}

fn worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        sum: int64 <- dangerous_tail_adapter@add(2, msg);
        _: boolean <- cast(reply_to, sum impl ActorMessage {})
    produces pure (:no_reply, reply_to) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- start_reporter();
        s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        w: dangerous_actor_ref <- spawn_dangerous(s, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 3 impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces pure code end
}

fn region_dump_limit() -> int64 {
    0
}

// One line per report; any failure ends main's wait_for_exit with cast_exit(70).
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println("failure report");
        _: boolean <- cast_exit(70)
    produces
        pure (:no_reply, state + 1)
    end
}

fn start_reporter() -> actor_ref {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        _: atom <- register_failure_reporter(reporter_ref)
    produces
        pure reporter_ref
    end
}
