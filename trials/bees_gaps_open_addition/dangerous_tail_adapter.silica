// Helper unit for dangerous_ffi_adapter_tail_call (bees_gaps_open_addition, OPEN; see README.md).
// The FFI spec §3.3 wrapper shape: a library unit holds the foreign declaration and an exported
// adapter. Here the adapter's body is the foreign call itself, in tail position.
module dangerous_tail_adapter;

export add/2;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(left: int64, right: int64) -> int64;

fn add(left: int64, right: int64) -> int64 {
    add_raw(left, right)
}
