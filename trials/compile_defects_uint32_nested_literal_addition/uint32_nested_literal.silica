// Integer literals nested inside an expression on uint32 operands. The checker rejects each of the forms
// `n % 2 == 1`, `n - 1 == 1` and `(msg + 1) impl ActorMessage {}` (a message built from a uint32 parameter) with E2003 (type unification failure) on the Mac and
// STM32-L476RG_raw compilers, as though the nested literal were not typed from its uint32 sibling operand;
// `n % 2` on its own compiles. The same shapes on int64 operands are accepted. Open defect, staged:
// the .scout is the correct behaviour.
// Expected: odd=1 even=0 minus=1 other=0, then msg=7, msg=8 (each message is the previous one plus 1), then the exit status 0.

use trial_wait_int64;

fn is_odd(n: uint32) -> uint32 {
    case n % 2 == 1 of {
        true -> 1;
        false -> 0
    }
}

fn is_two(n: uint32) -> uint32 {
    case n - 1 == 1 of {
        true -> 1;
        false -> 0
    }
}

// The message is built from the received uint32 plus a literal: (msg + 1) impl ActorMessage {}.
fn echo(msg: uint32, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io, concurrency]
        _: atom <- print_string("msg=");
        _: atom <- print_uint32(msg);
        _: atom <- println("");
        me: actor_ref <- self();
        _: boolean <- case msg < 8 of {
            true -> cast(me, (msg + 1) impl ActorMessage {});
            false -> cast_exit(0)
        }
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[device_io, concurrency]
                n: uint32 <- 7;
                _: atom <- print_string("odd=");
                _: atom <- print_uint32(is_odd(n));
                _: atom <- print_string(" even=");
                _: atom <- print_uint32(is_odd(n + 1));
                _: atom <- print_string(" minus=");
                _: atom <- print_uint32(is_two(n - 5));
                _: atom <- print_string(" other=");
                _: atom <- print_uint32(is_two(n));
                _: atom <- println("");
                a: actor_ref <- spawn(0, echo, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(a, n impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
