fn insert_right_is_empty(
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> boolean {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, _, _: int64, _, right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure case right of {
            :none -> true;
            _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> false
        }
    end
}

fn insert_left_is_empty(
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> boolean {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, _, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _) <- node
    produces
        pure case left of {
            :none -> true;
            _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> false
        }
    end
}

fn insert_node_key(
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> KeyType {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (node_key, _, _: int64, _, _) <- node
    produces
        pure node_key
    end
}

fn insert_node_value(
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ValueType {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, node_value, _: int64, _, _) <- node
    produces
        pure node_value
    end
}

