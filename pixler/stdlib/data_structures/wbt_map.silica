    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    // Reuse left-shrunk rebuild so residual :none lowers as a literal.
    delete_rebuild_left_shrunk(map, repl_key, repl_value, right, residual_left)
}

