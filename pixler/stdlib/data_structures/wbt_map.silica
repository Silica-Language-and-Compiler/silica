fn map_with_root(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    new_root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
    compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence
        out: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- {
            root: new_root,
            compare_key: map.compare_key,
            compare_value: map.compare_value,
            region: map.region,
            specialization_key: map.specialization_key,
            compare_key_ordering_bundle: map.compare_key_ordering_bundle,
            compare_value_ordering_bundle: map.compare_value_ordering_bundle
        }
    produces
        pure out
    end
}

// §8A.8 — deterministic linear from_sorted (median split, bottom-up smart_node sizes).
// Emitter/runtime constraints discovered while implementing:
// - Finish/smart_node must run under a live List cons-match arm (scalar extract + finish).
// - Nested preflight that threads `original` then publishes corrupts the list; atom-only
//   preflight that fully unwinds before publish is safe.
// - Passing List tails as arguments is OK; do not store them in result records/tuples.
// - Atom indices are module-local: decode via from_sorted_error_code for portable codes.
// Builder: Adams consume via a mutable list cursor; mid is matched in-place so right
// build + finish_node stay under that cons frame.

fn from_sorted_ok(
    new_map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- {
            map: new_map,
            valid: true,
            error: :ok
        }
    produces
        pure out
    end
}

fn from_sorted_err(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    error: atom
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- {
            map: map_with_root(map, :none),
            valid: false,
            error: error
        }
    produces
        pure out
    end
}

fn from_sorted_build_ok(
    new_map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    from_sorted_ok(new_map)
}

fn from_sorted_build_err(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    error: atom
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    from_sorted_err(map, error)
}

fn from_sorted_preflight_pair(
    compare_key: fn(KeyType, KeyType) -> atom,
    prev: (KeyType, ValueType),
    next: (KeyType, ValueType)
) -> atom {
    prev_key: KeyType <- from_sorted_binding_key(prev);
    next_key: KeyType <- from_sorted_binding_key(next);
    sequence
        cmp: atom <- comparator_result_validate(compare_key(prev_key, next_key))
    produces
        pure case cmp of {
            :less -> :ok;
            :equal -> :equal_keys;
            :greater -> :not_ascending;
            _: atom -> :invalid_comparator_result
        }
    end
}

// Trial/status entry: map argument specializes KeyType/ValueType so an atom comparator can be injected.
fn from_sorted_preflight_status(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    injected_compare: fn(KeyType, KeyType) -> atom,
    prev: (KeyType, ValueType),
    next: (KeyType, ValueType)
) -> atom {
    sequence
        _: int64 <- map.specialization_key;
        out: atom <- from_sorted_preflight_pair(injected_compare, prev, next)
    produces
        pure out
    end
}

fn from_sorted_binding_key(item: (KeyType, ValueType)) -> KeyType {
    sequence
        (key, _) <- item
    produces
        pure key
    end
}

fn from_sorted_smart_node_item(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    item: (KeyType, ValueType),
    left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        (key, value) <- item
    produces
        pure smart_node(map, key, value, left, right)
    end
}

fn from_sorted_finish_node(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    item: (KeyType, ValueType),
    left_map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    right_map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        left_hold: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
        } <- {
            root: left_map.root
        };
        right_hold: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
        } <- {
            root: right_map.root
        };
        built_map: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- {
            root: from_sorted_smart_node_item(map, item, left_hold.root, right_hold.root),
            compare_key: map.compare_key,
            compare_value: map.compare_value,
            region: map.region,
            specialization_key: map.specialization_key,
            compare_key_ordering_bundle: map.compare_key_ordering_bundle,
            compare_value_ordering_bundle: map.compare_value_ordering_bundle
        };
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- case built_map.root of {
            :none -> from_sorted_build_err(map, :size_overflow);
            _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> from_sorted_build_ok(built_map)
        }
    produces
        pure out
    end
}

fn from_sorted_after_right(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    item: (KeyType, ValueType),
    left_map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    right_b: {
        map: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        valid: boolean,
        error: atom
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case right_b.valid of {
        false -> right_b;
        true -> from_sorted_finish_node(map, item, left_map, right_b.map)
    }
}

fn from_sorted_build_one_item(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    item: (KeyType, ValueType)
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        empty_child: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- map_with_root(map, :none);
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_finish_node(map, item, empty_child, empty_child)
    produces
        pure out
    end
}

// §8A.8: runtime-sized item buffer + Adams build.
// Constraints (emitter/runtime):
// - Do not alloc_buf under a live List cons (hangs).
// - Do not smart_node before the input list is fully peeled under cons (hangs).
// - Fill under cons (write_buf + adjacent preflight only); build after cons unwinds.

fn from_sorted_fill(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    items: List[(KeyType, ValueType), mem(normal)],
    remaining: int64,
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    cursor: {
        write_idx: int64,
        prev_ref: ref(L, normal, (KeyType, ValueType, int64)),
        has_prev: boolean
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case remaining == 0 of {
        true -> case items of {
            []: List[(KeyType, ValueType), mem(normal)] -> from_sorted_ok(map);
            _: List[(KeyType, ValueType), mem(normal)] -> from_sorted_err(map, :count_mismatch)
        };
        false -> case items of {
            []: List[(KeyType, ValueType), mem(normal)] -> from_sorted_err(map, :count_mismatch);
            [h: (KeyType, ValueType), t: List[(KeyType, ValueType), mem(normal)]] ->
                from_sorted_fill_cons(map, h, t, remaining, n, items_buf, cursor)
        }
    }
}

fn from_sorted_fill_cons(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    h: (KeyType, ValueType),
    t: List[(KeyType, ValueType), mem(normal)],
    remaining: int64,
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    cursor: {
        write_idx: int64,
        prev_ref: ref(L, normal, (KeyType, ValueType, int64)),
        has_prev: boolean
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        chk: atom <- from_sorted_peel_check(map, cursor.prev_ref, cursor.has_prev, h);
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- case chk of {
            :ok -> from_sorted_fill_cons_ok(map, h, t, remaining, n, items_buf, cursor);
            _: atom -> from_sorted_err(map, chk)
        }
    produces
        pure out
    end
}

fn from_sorted_peel_check(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    prev_ref: ref(L, normal, (KeyType, ValueType, int64)),
    has_prev: boolean,
    h: (KeyType, ValueType)
) -> atom {
    case has_prev of {
        false -> :ok;
        true -> from_sorted_peel_check_prev(map, prev_ref, h)
    }
}

fn from_sorted_peel_check_prev(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    prev_ref: ref(L, normal, (KeyType, ValueType, int64)),
    h: (KeyType, ValueType)
) -> atom {
    sequence proc[mem(normal)]
        wrapped: (KeyType, ValueType, int64) <- read_ref(prev_ref);
        (prev_key, _, _: int64) <- wrapped;
        next_key: KeyType <- from_sorted_binding_key(h);
        out: atom <- from_sorted_preflight_keys(map.compare_key, prev_key, next_key)
    produces
        pure out
    end
}

fn from_sorted_preflight_keys(
    compare_key: fn(KeyType, KeyType) -> atom,
    prev_key: KeyType,
    next_key: KeyType
) -> atom {
    sequence
        cmp: atom <- compare_key(prev_key, next_key)
    produces
        pure case cmp of {
            :less -> :ok;
            :equal -> :equal_keys;
            :greater -> :not_ascending;
            _: atom -> :invalid_comparator_result
        }
    end
}

fn from_sorted_fill_cons_ok(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    h: (KeyType, ValueType),
    t: List[(KeyType, ValueType), mem(normal)],
    remaining: int64,
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    cursor: {
        write_idx: int64,
        prev_ref: ref(L, normal, (KeyType, ValueType, int64)),
        has_prev: boolean
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        _: atom <- write_buf(items_buf, cursor.write_idx, h);
        (h_key, h_value) <- h;
        _: atom <- write_ref(cursor.prev_ref, (h_key, h_value, 1));
        next_cursor: {
            write_idx: int64,
            prev_ref: ref(L, normal, (KeyType, ValueType, int64)),
            has_prev: boolean
        } <- {
            write_idx: cursor.write_idx + 1,
            prev_ref: cursor.prev_ref,
            has_prev: true
        };
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_fill(map, t, remaining - 1, n, items_buf, next_cursor)
    produces
        pure out
    end
}

fn from_sorted_buf_build(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    start: int64,
    count: int64
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case count == 0 of {
        true -> from_sorted_ok(map_with_root(map, :none));
        false -> case count == 1 of {
            true -> from_sorted_buf_one(map, n, items_buf, start);
            false -> from_sorted_buf_split(map, n, items_buf, start, count)
        }
    }
}

fn from_sorted_buf_one(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    start: int64
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        item: (KeyType, ValueType) <- read_buf(items_buf, start);
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_build_one_item(map, item)
    produces
        pure out
    end
}

fn from_sorted_buf_split(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    start: int64,
    count: int64
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        left_count: int64 <- count / 2;
        right_count: int64 <- count - left_count - 1;
        left_b: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_buf_build(map, n, items_buf, start, left_count);
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_buf_after_left(map, n, items_buf, start, left_count, right_count, left_b)
    produces
        pure out
    end
}

fn from_sorted_buf_after_left(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    start: int64,
    left_count: int64,
    right_count: int64,
    left_b: {
        map: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        valid: boolean,
        error: atom
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case left_b.valid of {
        false -> left_b;
        true -> from_sorted_buf_mid(map, n, items_buf, start, left_count, right_count, left_b.map)
    }
}

fn from_sorted_buf_mid(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    start: int64,
    left_count: int64,
    right_count: int64,
    left_map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        mid: (KeyType, ValueType) <- read_buf(items_buf, start + left_count);
        right_b: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_buf_build(map, n, items_buf, start + left_count + 1, right_count);
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_after_right(map, mid, left_map, right_b)
    produces
        pure out
    end
}

fn from_sorted_after_fill(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n),
    filled: {
        map: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        valid: boolean,
        error: atom
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case filled.valid of {
        false -> filled;
        true -> from_sorted_buf_build(map, n, items_buf, 0, n)
    }
}

fn from_sorted_publish(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    items: List[(KeyType, ValueType), mem(normal)],
    n: int64
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case n == 0 of {
        true -> case items of {
            []: List[(KeyType, ValueType), mem(normal)] -> from_sorted_ok(map_with_root(map, :none));
            _: List[(KeyType, ValueType), mem(normal)] -> from_sorted_err(map, :count_mismatch)
        };
        false -> from_sorted_publish_alloc(map, items, n)
    }
}

fn from_sorted_publish_alloc(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    items: List[(KeyType, ValueType), mem(normal)],
    n: int64
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        items_buf: buf(L, normal, (KeyType, ValueType), n) <- alloc_buf(map.region, n);
        filled: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_publish_fill(map, items, n, items_buf);
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_after_fill(map, n, items_buf, filled)
    produces
        pure out
    end
}

fn from_sorted_publish_fill(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    items: List[(KeyType, ValueType), mem(normal)],
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n)
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case items of {
        []: List[(KeyType, ValueType), mem(normal)] -> from_sorted_err(map, :count_mismatch);
        [h: (KeyType, ValueType), t: List[(KeyType, ValueType), mem(normal)]] ->
            from_sorted_publish_fill_start(map, h, t, n, items_buf)
    }
}

fn from_sorted_publish_fill_start(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    h: (KeyType, ValueType),
    t: List[(KeyType, ValueType), mem(normal)],
    n: int64,
    items_buf: buf(L, normal, (KeyType, ValueType), n)
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        (h_key, h_value) <- h;
        prev_ref: ref(L, normal, (KeyType, ValueType, int64)) <- alloc_ref(map.region, (h_key, h_value, 1));
        _: atom <- write_buf(items_buf, 0, h);
        cursor: {
            write_idx: int64,
            prev_ref: ref(L, normal, (KeyType, ValueType, int64)),
            has_prev: boolean
        } <- {
            write_idx: 1,
            prev_ref: prev_ref,
            has_prev: true
        };
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_fill(map, t, n - 1, n, items_buf, cursor)
    produces
        pure out
    end
}




fn from_sorted_counted_matching(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    items: List[(KeyType, ValueType), mem(normal)],
    n: int64
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    from_sorted_publish(map, items, n)
}

fn from_sorted_counted(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    items: List[(KeyType, ValueType), mem(normal)],
    n: int64
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    case n < 0 of {
        true -> from_sorted_err(map, :negative_count);
        false -> from_sorted_counted_matching(map, items, n)
    }
}

fn from_sorted_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :not_ascending -> 1;
        :equal_keys -> 2;
        :invalid_comparator_result -> 3;
        :negative_count -> 4;
        :count_mismatch -> 5;
        :size_overflow -> 6;
        _: atom -> 99
    }
}

fn from_sorted(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    items: List[(KeyType, ValueType), mem(normal)]
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence proc[mem(normal)]
        n: int64 <- length[(KeyType, ValueType), mem(normal)](items);
        out: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            valid: boolean,
            error: atom
        } <- from_sorted_counted_matching(map, items, n)
    produces
        pure out
    end
}

// §8A.10 — postorder structural validation (same precedence as wbt_set).
// Map pairing is the node tuple itself; validate confirms key order and structure.

fn map_validate_result_ok(count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    sequence
        out: { valid: boolean, error: atom, logical_count: int64 } <- { valid: true, error: :ok, logical_count: count }
    produces
        pure out
    end
}

fn map_validate_result_err(error: atom, count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    sequence
        out: { valid: boolean, error: atom, logical_count: int64 } <- { valid: false, error: error, logical_count: count }
    produces
        pure out
    end
}

fn map_validate_ok_empty(placeholder: KeyType) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
} {
    sequence
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: KeyType,
            hi: KeyType
        } <- { error: :ok, count: 0, has_items: false, lo: placeholder, hi: placeholder }
    produces
        pure out
    end
}

fn map_validate_err(error: atom, count: int64, placeholder: KeyType) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
} {
    sequence
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: KeyType,
            hi: KeyType
        } <- { error: error, count: count, has_items: false, lo: placeholder, hi: placeholder }
    produces
        pure out
    end
}

fn map_validate_ok_node(count: int64, lo: KeyType, hi: KeyType) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
} {
    sequence
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: KeyType,
            hi: KeyType
        } <- { error: :ok, count: count, has_items: true, lo: lo, hi: hi }
    produces
        pure out
    end
}

fn map_validate_fuel_start(cached: int64) -> int64 {
    case cached < 0 of {
        true -> 64;
        false -> case cached > 1000000 of {
            true -> 1000002;
            false -> cached + 2
        }
    }
}

fn map_validate_order_left(
    compare_key: fn(KeyType, KeyType) -> atom,
    left_hi: KeyType,
    key: KeyType
) -> atom {
    sequence
        cmp: atom <- comparator_result_validate(compare_key(left_hi, key))
    produces
        pure case cmp of {
            :less -> :ok;
            :equal -> :order_violation;
            :greater -> :order_violation;
            _: atom -> :invalid_comparator_result
        }
    end
}

fn map_validate_order_right(
    compare_key: fn(KeyType, KeyType) -> atom,
    key: KeyType,
    right_lo: KeyType
) -> atom {
    sequence
        cmp: atom <- comparator_result_validate(compare_key(key, right_lo))
    produces
        pure case cmp of {
            :less -> :ok;
            :equal -> :order_violation;
            :greater -> :order_violation;
            _: atom -> :invalid_comparator_result
        }
    end
}

fn map_validate_bounds_left(
    compare_key: fn(KeyType, KeyType) -> atom,
    left: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: KeyType,
        hi: KeyType
    },
    key: KeyType
) -> atom {
    case left.has_items of {
        false -> :ok;
        true -> map_validate_order_left(compare_key, left.hi, key)
    }
}

fn map_validate_bounds_right(
    compare_key: fn(KeyType, KeyType) -> atom,
    key: KeyType,
    right: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: KeyType,
        hi: KeyType
    }
) -> atom {
    case right.has_items of {
        false -> :ok;
        true -> map_validate_order_right(compare_key, key, right.lo)
    }
}

fn map_validate_combine_lo(key: KeyType, left: {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
}) -> KeyType {
    case left.has_items of {
        true -> left.lo;
        false -> key
    }
}

fn map_validate_combine_hi(key: KeyType, right: {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
}) -> KeyType {
    case right.has_items of {
        true -> right.hi;
        false -> key
    }
}

fn map_validate_node_local(
    compare_key: fn(KeyType, KeyType) -> atom,
    key: KeyType,
    cached: int64,
    left: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: KeyType,
        hi: KeyType
    },
    right: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: KeyType,
        hi: KeyType
    }
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
} {
    sequence
        left_bound: atom <- map_validate_bounds_left(compare_key, left, key);
        right_bound: atom <- case left_bound of {
            :ok -> map_validate_bounds_right(compare_key, key, right);
            bad: atom -> bad
        };
        counts_ok: boolean <- case left.count < 0 of {
            true -> false;
            false -> case right.count < 0 of { true -> false; false -> true }
        };
        computed: int64 <- left.count + right.count + 1;
        wl: int64 <- left.count + 1;
        wr: int64 <- right.count + 1;
        bal_ok: boolean <- case counts_ok of {
            true -> weights_balanced(wl, wr);
            false -> false
        };
        combined_lo: KeyType <- map_validate_combine_lo(key, left);
        combined_hi: KeyType <- map_validate_combine_hi(key, right);
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: KeyType,
            hi: KeyType
        } <- case right_bound of {
            :invalid_comparator_result -> map_validate_err(:invalid_comparator_result, computed, key);
            :order_violation -> case cached <= 0 of {
                true -> map_validate_err(:negative_count, computed, key);
                false -> case counts_ok of {
                    false -> map_validate_err(:size_mismatch, computed, key);
                    true -> case computed == cached of {
                        false -> map_validate_err(:size_mismatch, computed, key);
                        true -> map_validate_err(:order_violation, computed, key)
                    }
                }
            };
            :ok -> case cached <= 0 of {
                true -> map_validate_err(:negative_count, computed, key);
                false -> case counts_ok of {
                    false -> map_validate_err(:size_mismatch, computed, key);
                    true -> case computed == cached of {
                        false -> map_validate_err(:size_mismatch, computed, key);
                        true -> case bal_ok of {
                            false -> map_validate_err(:balance_violation, computed, key);
                            true -> map_validate_ok_node(computed, combined_lo, combined_hi)
                        }
                    }
                }
            };
            bad: atom -> map_validate_err(bad, computed, key)
        }
    produces
        pure out
    end
}

// Single left-then-right walk (no left_only/right_only/both split).
fn map_validate_finish(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    left_res: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: KeyType,
        hi: KeyType
    },
    right_res: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: KeyType,
        hi: KeyType
    }
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
} {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (key, _, cached: int64, _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: KeyType,
            hi: KeyType
        } <- case left_res.error of {
            :ok -> case right_res.error of {
                :ok -> map_validate_node_local(map.compare_key, key, cached, left_res, right_res);
                bad: atom -> right_res
            };
            bad: atom -> left_res
        }
    produces
        pure out
    end
}

fn map_validate_after_children(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    fuel: int64,
    left_res: {
        error: atom,
        count: int64,
        has_items: boolean,
        lo: KeyType,
        hi: KeyType
    }
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
} {
    case left_res.error of {
        :ok -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (key, _, _: int64, _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
                right_res: {
                    error: atom,
                    count: int64,
                    has_items: boolean,
                    lo: KeyType,
                    hi: KeyType
                } <- map_validate_subtree(map, right, key, fuel)
            produces
                pure map_validate_finish(map, node_ref, left_res, right_res)
            end
        };
        bad: atom -> left_res
    }
}

fn map_edge_cycle(
    a: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    b: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence
        cyc: boolean <- ref_eq(a, b);
        out: atom <- case cyc of { true -> :cycle; false -> :ok }
    produces
        pure out
    end
}

fn map_edge_repeated(
    a: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    b: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence
        same: boolean <- ref_eq(a, b);
        out: atom <- case same of { true -> :repeated_child; false -> :ok }
    produces
        pure out
    end
}

fn map_edges_when_left(
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    left_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    case right of {
        :none -> map_edge_cycle(node_ref, left_ref);
        right_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence
                rep: atom <- map_edge_repeated(left_ref, right_ref);
                out: atom <- case rep of {
                    :repeated_child -> :repeated_child;
                    :ok -> {
                        sequence
                            e1: atom <- map_edge_cycle(node_ref, left_ref);
                            e2: atom <- case e1 of {
                                :ok -> map_edge_cycle(node_ref, right_ref);
                                bad: atom -> bad
                            }
                        produces
                            pure e2
                        end
                    };
                    bad: atom -> bad
                }
            produces
                pure out
            end
        }
    }
}

fn map_validate_child_edges_of(
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, _, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        out: atom <- case left of {
            :none -> case right of {
                :none -> :ok;
                right_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                    map_edge_cycle(node_ref, right_ref)
            };
            left_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                map_edges_when_left(node_ref, left_ref, right)
        }
    produces
        pure out
    end
}

fn map_validate_node(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: KeyType,
    fuel: int64
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
} {
    sequence
        in_arena: boolean <- true;
        out: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: KeyType,
            hi: KeyType
        } <- case fuel <= 0 of {
            true -> map_validate_err(:cycle, 0, placeholder);
            false -> case in_arena of {
                false -> map_validate_err(:wrong_arena, 0, placeholder);
                true -> {
                    sequence proc[mem(normal)]
                        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                        (key, _, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
                        next_fuel: int64 <- fuel - 1;
                        edges: atom <- map_validate_child_edges_of(node_ref);
                        walked: {
                            error: atom,
                            count: int64,
                            has_items: boolean,
                            lo: KeyType,
                            hi: KeyType
                        } <- case edges of {
                            :ok -> {
                                sequence
                                    left_res: {
                                        error: atom,
                                        count: int64,
                                        has_items: boolean,
                                        lo: KeyType,
                                        hi: KeyType
                                    } <- map_validate_subtree(map, left, key, next_fuel)
                                produces
                                    pure map_validate_after_children(map, node_ref, right, next_fuel, left_res)
                                end
                            };
                            bad: atom -> map_validate_err(bad, 0, key)
                        }
                    produces
                        pure walked
                    end
                }
            }
        }
    produces
        pure out
    end
}

fn map_validate_subtree(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    subtree: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: KeyType,
    fuel: int64
) -> {
    error: atom,
    count: int64,
    has_items: boolean,
    lo: KeyType,
    hi: KeyType
} {
    case subtree of {
        :none -> map_validate_ok_empty(placeholder);
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            map_validate_node(map, node_ref, placeholder, fuel)
    }
}

fn map_validate_at_root(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    root_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> { valid: boolean, error: atom, logical_count: int64 } {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
        (key, _, cached: int64, _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        fuel: int64 <- map_validate_fuel_start(cached);
        walk: {
            error: atom,
            count: int64,
            has_items: boolean,
            lo: KeyType,
            hi: KeyType
        } <- map_validate_node(map, root_ref, key, fuel);
        out: { valid: boolean, error: atom, logical_count: int64 } <- case walk.error of {
            :ok -> map_validate_result_ok(walk.count);
            bad: atom -> map_validate_result_err(bad, walk.count)
        }
    produces
        pure out
    end
}

fn validate(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    case map.root of {
        :none -> map_validate_result_ok(0);
        root_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            map_validate_at_root(map, root_ref)
    }
}

fn validate_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :cycle -> 1;
        :wrong_arena -> 2;
        :repeated_child -> 3;
        :invalid_comparator_result -> 4;
        :negative_count -> 5;
        :size_mismatch -> 6;
        :order_violation -> 7;
        :balance_violation -> 8;
        _: atom -> 99
    }
}
