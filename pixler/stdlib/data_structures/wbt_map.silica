// Layer 2 §8A.1–§8A.4, §8A.6–§8A.8, §8A.10 — Adams WBT map core: smart nodes, read-only helpers,
// (3,2) balance/rotations, insert/replace, delete / delete_min / delete_max, from_sorted, validate.
// Node shape (inline at every boundary): (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)); every ref? to a node spells it, so rec binds to it.

export empty/1;
export smart_node/5;
export subtree_cached_size/1;
export size/1;
export search_status/2;
export get/3;
export contains_key/2;
export find_value/3;
export fold/3;
export singleton/3;
export from_list/2;
export apply_compare_key/3;
export apply_compare_value/3;
export minimum/3;
export maximum/3;
export weight/1;
export weight_le_3x/2;
export weight_lt_2x/2;
export weights_balanced/2;
export balance_left/2;
export balance_right/2;
export insert/3;
export delete/2;
export delete_min/3;
export delete_max/3;
export from_sorted/2;
export from_sorted_counted/3;
export from_sorted_error_code/1;
export from_sorted_preflight_status/4;
export validate/1;
export validate_error_code/1;

fn empty_map(
    functions: {
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater
    }
) -> {
    root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
    compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        ph: region(L, normal) <- canonical_arena_lookup(1);
        out: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- {
            root: :none,
            compare_key: functions.compare_key,
            compare_value: functions.compare_value,
            region: ph,
            specialization_key: 0,
            compare_key_ordering_bundle: 0,
            compare_value_ordering_bundle: 0
        }
    produces
        pure out
    end
}

fn empty(
    functions: {
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater
    }
) -> {
    root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
    compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    empty_map(functions)
}

fn walk_search_cmp(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType,
    node_key: KeyType,
    left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    sequence
        cmp: atom <- compare_checked(key, node_key, tree.compare_key)
    produces
        pure case cmp of {
            :less -> walk_search(tree, key, left);
            :equal -> :found;
            :greater -> walk_search(tree, key, right);
            _: atom -> :invalid_comparator_result
        }
    end
}

fn compare_checked(
    key: KeyType,
    node_key: KeyType,
    compare_key: fn(KeyType, KeyType) -> atom
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare_key(key, node_key))
    produces
        pure result
    end
}

fn subtree_cached_size(subtree: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> int64 {
    case subtree of {
        :none -> 0;
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (_, _, sz: int64, _, _) <- node
            produces
                pure sz
            end
        }
    }
}

fn sum_lr_ok(left_sz: int64, right_sz: int64) -> boolean {
    sum_pair: (boolean, int64) <- checked_int64_add(left_sz, right_sz);
    (ok: boolean, _: int64) <- sum_pair;
    ok
}

fn sum_lr_partial(left_sz: int64, right_sz: int64) -> int64 {
    sum_pair: (boolean, int64) <- checked_int64_add(left_sz, right_sz);
    (_: boolean, partial: int64) <- sum_pair;
    partial
}

fn partial_add1_ok(partial: int64) -> boolean {
    add1_pair: (boolean, int64) <- checked_int64_add1(partial);
    (ok: boolean, _: int64) <- add1_pair;
    ok
}

fn partial_add1_size(partial: int64) -> int64 {
    add1_pair: (boolean, int64) <- checked_int64_add1(partial);
    (_: boolean, cached_size: int64) <- add1_pair;
    cached_size
}

fn smart_node_finish_alloc(
    node_key: KeyType,
    arena: region(L, normal),
    node_value: ValueType,
    left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    cached_size: int64
) -> (region(L, normal), ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) {
    sequence proc[mem(normal)]
        cell: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <-
            alloc_rec(arena, (node_key, node_value, cached_size, left, right))
    produces
        pure (arena, cell)
    end
}

fn smart_node(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    node_key: KeyType,
    node_value: ValueType,
    left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    left_sz: int64 <- subtree_cached_size(left);
    right_sz: int64 <- subtree_cached_size(right);
    sum_pair: (boolean, int64) <- checked_int64_add(left_sz, right_sz);
    (sum_ok: boolean, partial: int64) <- sum_pair;
    add1_pair: (boolean, int64) <- checked_int64_add1(partial);
    (add_ok: boolean, cached_size: int64) <- add1_pair;
    arena: region(L, normal) <- tree.region;
    case sum_ok of {
        false -> :none;
        true -> case add_ok of {
            false -> :none;
            true -> {
                alloc_pair: (region(L, normal), ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- smart_node_finish_alloc(node_key, arena, node_value, left, right, cached_size);
                (_: region(L, normal), cell: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- alloc_pair;
                cell
            }
        }
    }
}

fn get_subtree_cmp(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType,
    node_key: KeyType,
    node_value: ValueType,
    left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ValueType
) -> { status: :not_found | :found, value: ValueType } {
    sequence
        cmp: atom <- compare_checked(key, node_key, tree.compare_key)
    produces
        pure case cmp of {
            :less -> get_subtree(tree, key, left, placeholder);
            :equal -> { status: :found, value: node_value };
            :greater -> get_subtree(tree, key, right, placeholder);
            bad: atom -> get_invalid_halt(placeholder)
        }
    end
}


fn minimum_cmp(
    node_key: KeyType,
    node_value: ValueType,
    left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder_key: KeyType,
    placeholder_value: ValueType
) -> { status: :not_found | :found, key: KeyType, value: ValueType } {
    case left of {
        :none -> { status: :found, key: node_key, value: node_value };
        _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> minimum_subtree(left, placeholder_key, placeholder_value)
    }
}

fn maximum_cmp(
    node_key: KeyType,
    node_value: ValueType,
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder_key: KeyType,
    placeholder_value: ValueType
) -> { status: :not_found | :found, key: KeyType, value: ValueType } {
    case right of {
        :none -> { status: :found, key: node_key, value: node_value };
        _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> maximum_subtree(right, placeholder_key, placeholder_value)
    }
}

fn size(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> int64 {
    case tree.root of {
        :none -> 0;
        root_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (_, _, sz: int64, _, _) <- node
            produces
                pure sz
            end
        }
    }
}

fn weight_empty() -> (boolean, int64) {
    (true, 1)
}

fn weight_subtree(subtree: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> (boolean, int64) {
    case subtree of {
        :none -> weight_empty();
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (_, _, sz: int64, _, _) <- node
            produces
                pure checked_int64_add1(sz)
            end
        }
    }
}

fn weight(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> (boolean, int64) {
    case tree.root of {
        :none -> (true, 1);
        root_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (_, _, sz: int64, _, _) <- node
            produces
                pure checked_int64_add1(sz)
            end
        }
    }
}

fn walk_search(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType,
    subtree: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> atom {
    case subtree of {
        :none -> :not_found;
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (node_key, _, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure walk_search_cmp(tree, key, node_key, left, right)
            end
        }
    }
}

fn search_status(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType
) -> atom {
    case tree.root of {
        :none -> :not_found;
        root_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (node_key, _, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure walk_search_cmp(tree, key, node_key, left, right)
            end
        }
    }
}

fn get_subtree(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType,
    subtree: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ValueType
) -> { status: :not_found | :found, value: ValueType } {
    case subtree of {
        :none -> { status: :not_found, value: placeholder };
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (node_key, node_value, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure get_subtree_cmp(tree, key, node_key, node_value, left, right, placeholder)
            end
        }
    }
}

fn get_invalid_halt(ph: ValueType) -> { status: :not_found | :found, value: ValueType } {
    sequence
        _: int64 <- 1 / 0
    produces
        pure { status: :not_found, value: ph }
    end
}

fn get(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType,
    placeholder: ValueType
) -> { status: :not_found | :found, value: ValueType } {
    case tree.root of {
        :none -> { status: :not_found, value: placeholder };
        root_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
                (node_key, node_value, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
            produces
                pure get_subtree_cmp(tree, key, node_key, node_value, left, right, placeholder)
            end
        }
    }
}

fn contains_key(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType
) -> boolean {
    case search_status(tree, key) of {
        :found -> true;
        :not_found -> false;
        bad: atom -> contains_invalid_halt(bad)
    }
}

fn contains_invalid_halt(_: atom) -> boolean {
    sequence
        _: int64 <- 1 / 0
    produces
        pure false
    end
}

fn compare_value_checked(
    left: ValueType,
    right: ValueType,
    compare_value: fn(ValueType, ValueType) -> atom
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare_value(left, right))
    produces
        pure result
    end
}

fn apply_compare_key(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    a: KeyType,
    b: KeyType
) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_checked(a, b, tree.compare_key)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> apply_compare_invalid_halt_key(bad, a)
        }
    end
}

fn apply_compare_invalid_halt_key(_: atom, placeholder: KeyType) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0;
        _: KeyType <- placeholder
    produces
        pure :equal
    end
}

fn apply_compare_value(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    a: ValueType,
    b: ValueType
) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_value_checked(a, b, tree.compare_value)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> apply_compare_invalid_halt_value(bad, a)
        }
    end
}

fn apply_compare_invalid_halt_value(_: atom, placeholder: ValueType) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0;
        _: ValueType <- placeholder
    produces
        pure :equal
    end
}

fn find_value_after_left(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    value: ValueType,
    node_key: KeyType,
    node_value: ValueType,
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder_key: KeyType
) -> { status: :not_found | :found, key: KeyType } {
    sequence
        cmp: atom <- compare_value_checked(value, node_value, tree.compare_value)
    produces
        pure case cmp of {
            :equal -> { status: :found, key: node_key };
            :less -> find_value_subtree(tree, value, right, placeholder_key);
            :greater -> find_value_subtree(tree, value, right, placeholder_key);
            bad: atom -> find_value_invalid_halt(bad, placeholder_key)
        }
    end
}

fn find_value_invalid_halt(_: atom, placeholder_key: KeyType) -> { status: :not_found | :found, key: KeyType } {
    sequence
        _: int64 <- 1 / 0
    produces
        pure { status: :not_found, key: placeholder_key }
    end
}

fn find_value_node(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    value: ValueType,
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder_key: KeyType
) -> { status: :not_found | :found, key: KeyType } {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (node_key, node_value, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        left_hit: { status: :not_found | :found, key: KeyType } <- find_value_subtree(tree, value, left, placeholder_key)
    produces
        pure case left_hit.status of {
            :found -> left_hit;
            :not_found -> find_value_after_left(tree, value, node_key, node_value, right, placeholder_key)
        }
    end
}

fn find_value_subtree(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    value: ValueType,
    subtree: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder_key: KeyType
) -> { status: :not_found | :found, key: KeyType } {
    case subtree of {
        :none -> { status: :not_found, key: placeholder_key };
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            find_value_node(tree, value, node_ref, placeholder_key)
    }
}

// Ascending in-order search: smallest key whose value compares equal via compare_value.
fn find_value(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    value: ValueType,
    placeholder_key: KeyType
) -> { status: :not_found | :found, key: KeyType } {
    case tree.root of {
        :none -> { status: :not_found, key: placeholder_key };
        root_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            find_value_node(tree, value, root_ref, placeholder_key)
    }
}

fn singleton(
    functions: {
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater
    },
    key: KeyType,
    value: ValueType
) -> {
    root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
    compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence
        empty0: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- empty_map(functions);
        ins: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(empty0, key, value)
    produces
        pure ins.map
    end
}

fn from_list_cons(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    head: (KeyType, ValueType),
    tail: List[(KeyType, ValueType), mem(normal)]
) -> {
    root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
    compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence
        (k, v) <- head;
        ins: {
            map: {
                root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
                compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(map, k, v)
    produces
        pure from_list_go(ins.map, tail)
    end
}

fn from_list_go(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    items: List[(KeyType, ValueType), mem(normal)]
) -> {
    root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
    compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    case items of {
        []: List[(KeyType, ValueType), mem(normal)] -> map;
        [h: (KeyType, ValueType), t: List[(KeyType, ValueType), mem(normal)]] ->
            from_list_cons(map, h, t)
    }
}

fn from_list(
    functions: {
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater
    },
    items: List[(KeyType, ValueType), mem(normal)]
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    valid: boolean,
    error: atom
} {
    sequence
        empty0: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- empty_map(functions);
        built: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- from_list_go(empty0, items)
    produces
        pure { map: built, valid: true, error: :ok }
    end
}

fn fold_after_left(
    step: fn(AccType, KeyType, ValueType) -> AccType,
    left_acc: AccType,
    node_key: KeyType,
    node_value: ValueType,
    right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    sequence
        mid: AccType <- step(left_acc, node_key, node_value)
    produces
        pure fold_subtree(step, mid, right)
    end
}

fn fold_node(
    step: fn(AccType, KeyType, ValueType) -> AccType,
    acc: AccType,
    node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (node_key, node_value, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        left_acc: AccType <- fold_subtree(step, acc, left)
    produces
        pure fold_after_left(step, left_acc, node_key, node_value, right)
    end
}

fn fold_subtree(
    step: fn(AccType, KeyType, ValueType) -> AccType,
    acc: AccType,
    subtree: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    case subtree of {
        :none -> acc;
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            fold_node(step, acc, node_ref)
    }
}

fn fold(
    tree: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    init: AccType,
    visit_fn: fn(AccType, KeyType, ValueType) -> AccType
) -> AccType {
    case tree.root of {
        :none -> init;
        root_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            fold_node(visit_fn, init, root_ref)
    }
}

fn minimum_subtree(
    subtree: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder_key: KeyType,
    placeholder_value: ValueType
) -> { status: :not_found | :found, key: KeyType, value: ValueType } {
    case subtree of {
        :none -> { status: :not_found, key: placeholder_key, value: placeholder_value };
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (node_key, node_value, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _) <- node
            produces
                pure minimum_cmp(node_key, node_value, left, placeholder_key, placeholder_value)
            end
        }
    }
}

fn minimum(
