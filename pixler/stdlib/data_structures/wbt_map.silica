fn delete_max_after_child_left_present(
    left_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    residual: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    extracted_key: KeyType,
    extracted_value: ValueType,
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    node_key: KeyType,
    node_value: ValueType
) -> {
    root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    key: KeyType,
    value: ValueType
} {
    case residual of {
        :none -> delete_max_rebuild_left_only(left_ref, extracted_key, extracted_value, map, node_key, node_value);
        right_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            delete_max_rebuild_both_present(left_ref, right_ref, extracted_key, extracted_value, map, node_key, node_value)
    }
}

fn delete_max_rebuild_left_only(
    left_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    extracted_key: KeyType,
    extracted_value: ValueType,
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    node_key: KeyType,
    node_value: ValueType
) -> {
    root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    key: KeyType,
    value: ValueType
} {
    sequence
        rebuilt: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- insert_balance_right_root(map, smart_node(map, node_key, node_value, left_ref, :none));
        out: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            key: KeyType,
            value: ValueType
        } <- {
            root: rebuilt.root,
            key: extracted_key,
            value: extracted_value
        }
    produces
        pure out
    end
}

