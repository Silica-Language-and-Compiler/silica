    },
    node_key: KeyType,
    node_value: ValueType,
    left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    child_map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    removed: boolean
} {
    sequence
        rebuilt: {
            root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
            compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- delete_rebuild_right_shrunk(map, node_key, node_value, left, child_map.root)
    produces
        pure delete_pair_removed(rebuilt)
    end
}

// After recursive child delete, reread the sibling from ancestor_ref — do not close
// over a sequence-bound sibling ref? across the recursive call (null-deref hang).
fn delete_finish_after_left_reread(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    child_map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    ancestor_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> {
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    removed: boolean
} {
    sequence proc[mem(normal)]
        node: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(ancestor_ref);
        (node_key, node_value, _: int64, _, right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure delete_finish_after_left(map, node_key, node_value, child_map, right)
    end
}

fn delete_finish_after_right_reread(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
