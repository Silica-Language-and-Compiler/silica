// Public BinaryTree trait — Layer 3D over the tree_binary persistent fixed-arity binary tree.
// Authority: design_documents/Phase1_TODOs/data_structure_designs/binary_tree_trait.md §6.
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)).
//
// root_item/get/left_item/right_item keep a not-found placeholder argument (same as the
// tree_binary core and the OrderedMap trait: Silica source cannot conjure an ItemType zero).
// Paths are List[:left | :right, mem(normal)] built with tree_binary@path_root / path_left /
// path_right (atom values are numbered per compilation unit; see the tree_binary header).
// is_empty is the provided method: exactly node_count(tree) == 0.

use tree_binary;

export trait BinaryTree;
export node_count/1;
export is_empty/1;
export root_item/2;
export get/3;
export left_item/3;
export right_item/3;
export fold_preorder/3;
export fold_inorder/3;
export fold_postorder/3;

required {
    fn node_count(tree: BinaryTree) -> int64;
    fn root_item(tree: BinaryTree, placeholder: ItemType)
        -> { status: :not_found | :found, value: ItemType };
    fn get(tree: BinaryTree, path: List[:left | :right, mem(normal)], placeholder: ItemType)
        -> { status: :not_found | :found, value: ItemType };
    fn left_item(tree: BinaryTree, path: List[:left | :right, mem(normal)], placeholder: ItemType)
        -> { status: :not_found | :found, value: ItemType };
    fn right_item(tree: BinaryTree, path: List[:left | :right, mem(normal)], placeholder: ItemType)
        -> { status: :not_found | :found, value: ItemType };
    fn fold_preorder(
        tree: BinaryTree,
        init: AccType,
        step: fn(AccType, List[:left | :right, mem(normal)], ItemType) -> AccType
    ) -> AccType;
    fn fold_inorder(
        tree: BinaryTree,
        init: AccType,
        step: fn(AccType, List[:left | :right, mem(normal)], ItemType) -> AccType
    ) -> AccType;
    fn fold_postorder(
        tree: BinaryTree,
        init: AccType,
        step: fn(AccType, List[:left | :right, mem(normal)], ItemType) -> AccType
    ) -> AccType;
}

provided {
    fn is_empty(tree: BinaryTree) -> boolean {
        BinaryTree@node_count(tree) == 0
    }
}

impl fn node_count(
    tree: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    }
) -> int64 {
    tree_binary@node_count(tree)
}

impl fn root_item(
    tree: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    },
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    tree_binary@root_item(tree, placeholder)
}

impl fn get(
    tree: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    },
    path: List[:left | :right, mem(normal)],
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    tree_binary@get(tree, path, placeholder)
}

impl fn left_item(
    tree: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    },
    path: List[:left | :right, mem(normal)],
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    tree_binary@left_item(tree, path, placeholder)
}

impl fn right_item(
    tree: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    },
    path: List[:left | :right, mem(normal)],
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    tree_binary@right_item(tree, path, placeholder)
}

impl fn fold_preorder(
    tree: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, List[:left | :right, mem(normal)], ItemType) -> AccType
) -> AccType {
    tree_binary@fold_preorder(tree, init, step)
}

impl fn fold_inorder(
    tree: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, List[:left | :right, mem(normal)], ItemType) -> AccType
) -> AccType {
    tree_binary@fold_inorder(tree, init, step)
}

impl fn fold_postorder(
    tree: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, List[:left | :right, mem(normal)], ItemType) -> AccType
) -> AccType {
    tree_binary@fold_postorder(tree, init, step)
}
