// Layer 2 §8A.1–§8A.2 — Adams WBT set core: owning record, empty root, read-only helpers.
// Node shape (inline at every boundary): (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)).

export empty/1;
export size/1;
export search_status/2;
export contains/2;
export fold/3;
export minimum/2;
export maximum/2;
export weight/1;

fn empty(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }
) -> {
    root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64
} {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        ph: region(L, normal) <- canonical_arena_lookup(1);
        out: {
            root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- {
            root: :none,
            compare_item: functions.compare_item,
            region: ph,
            specialization_key: 0
        }
    produces
        pure out
    end
}

fn size(
    set: {
        root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> int64 {
    case set.root of {
        :none -> 0;
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
            (_: ItemType, sz: int64, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node;
            sz
        end
    }
}

fn weight_subtree(subtree: ref?(L, normal, rec)) -> (boolean, int64) {
    case subtree of {
        :none -> (true, 1);
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
            (_: ItemType, sz: int64, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node;
            checked_int64_add1(sz)
        end
    }
}

fn weight(
    set: {
        root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> (boolean, int64) {
    case set.root of {
        :none -> (true, 1);
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
            (_: ItemType, sz: int64, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node;
            checked_int64_add1(sz)
        end
    }
}

fn walk_search(
    set: {
        root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    subtree: ref?(L, normal, rec)
) -> atom {
    case subtree of {
        :none -> :not_found;
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
            (node_key: ItemType, _: int64, left: ref?(L, normal, rec), right: ref?(L, normal, rec)) <- node;
            raw_cmp: :less | :equal | :greater <- set.compare_item(item, node_key);
            cmp: atom <- comparator_result_validate(raw_cmp);
            case cmp of {
                :less -> walk_search(set, item, left);
                :equal -> :found;
                :greater -> walk_search(set, item, right);
                _: atom -> :invalid_comparator_result
            }
        end
    }
}

fn search_status(
    set: {
        root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> atom {
    case set.root of {
        :none -> :not_found;
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
            (node_key: ItemType, _: int64, left: ref?(L, normal, rec), right: ref?(L, normal, rec)) <- node;
            raw_cmp: :less | :equal | :greater <- set.compare_item(item, node_key);
            cmp: atom <- comparator_result_validate(raw_cmp);
            case cmp of {
                :less -> walk_search(set, item, left);
                :equal -> :found;
                :greater -> walk_search(set, item, right);
                _: atom -> :invalid_comparator_result
            }
        end
    }
}

fn contains_invalid_halt(_: atom) -> boolean {
    sequence
        _: int64 <- 1 / 0
    produces
        pure false
    end
}

fn contains(
    set: {
        root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> boolean {
    case search_status(set, item) of {
        :found -> true;
        :not_found -> false;
        bad: atom -> contains_invalid_halt(bad)
    }
}

fn fold_subtree(
    step: fn(AccType, ItemType) -> AccType,
    acc: AccType,
    subtree: ref?(L, normal, rec)
) -> AccType {
    case subtree of {
        :none -> acc;
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
            (node_key: ItemType, _: int64, left: ref?(L, normal, rec), right: ref?(L, normal, rec)) <- node;
            left_acc: AccType <- fold_subtree(step, acc, left);
            mid_acc: AccType <- step(left_acc, node_key);
            fold_subtree(step, mid_acc, right)
        end
    }
}

fn fold(
    set: {
        root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    init: AccType,
    step: fn(AccType, ItemType) -> AccType
) -> AccType {
    case set.root of {
        :none -> init;
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
            (node_key: ItemType, _: int64, left: ref?(L, normal, rec), right: ref?(L, normal, rec)) <- node;
            left_acc: AccType <- fold_subtree(step, init, left);
            mid_acc: AccType <- step(left_acc, node_key);
            fold_subtree(step, mid_acc, right)
        end
    }
}

fn minimum_subtree(
    subtree: ref?(L, normal, rec),
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case subtree of {
        :none -> { status: :not_found, item: placeholder };
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
            (node_key: ItemType, _: int64, left: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node;
            case left of {
                :none -> { status: :found, item: node_key };
                _: ref?(L, normal, rec) -> minimum_subtree(left, placeholder)
            }
        end
    }
}

fn minimum(
    set: {
        root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case set.root of {
        :none -> { status: :not_found, item: placeholder };
        root_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
            node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(root_ref);
            (node_key: ItemType, _: int64, left: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node;
            case left of {
                :none -> { status: :found, item: node_key };
                _: ref?(L, normal, rec) -> minimum_subtree(left, placeholder)
            }
        end
    }
}

fn maximum_subtree(
    subtree: ref?(L, normal, rec),
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case subtree of {
        :none -> { status: :not_found, item: placeholder };
