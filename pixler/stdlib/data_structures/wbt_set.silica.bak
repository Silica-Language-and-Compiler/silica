// §8A.2 trial-only fixtures (same module as node `rec`; not for production mutation paths).
export trial_build_i64_singleton/3;
export trial_build_i64_tree/2;

fn trial_build_i64_singleton(
    r: region(L, normal),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    key: ItemType
) -> {
    root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        leaf: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (key, 1, :none, :none));
        bundle: int64 <- ordering_identity_bundle_make(ordering_identity_materialize(compare_item), :min);
        out: {
            root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: leaf,
            compare_item: compare_item,
            region: r,
            specialization_key: 1,
            compare_item_ordering_bundle: bundle
        }
    produces
        pure out
    end
}

fn trial_build_i64_tree(
    r: region(L, normal),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater
) -> {
    root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        leaf30: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (30, 1, :none, :none));
        leaf60: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (60, 1, :none, :none));
        node70: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (70, 2, leaf60, :none));
        root50: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (50, 4, leaf30, node70));
        bundle: int64 <- ordering_identity_bundle_make(ordering_identity_materialize(compare_item), :min);
        out: {
            root: :none | ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: root50,
            compare_item: compare_item,
            region: r,
            specialization_key: 1,
            compare_item_ordering_bundle: bundle
        }
    produces
        pure out
    end
}
