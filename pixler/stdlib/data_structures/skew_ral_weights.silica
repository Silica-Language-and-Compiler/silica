// Layer 2 §15 — skew binary random-access list: weight arithmetic (pure int64 leaf).
// Authority: design_documents/Phase1_TODOs/data_structure_designs/skew_binary_random_access_list.md §2, §9.
// weight(k) = 2^(k+1) - 1. A forest tree of weight w > 1 has two children of weight w / 2.
// Linking two equal-weight trees under a new root yields 1 + 2w (checked for overflow).

export child_weight/1;
export link_weight/1;
export is_skew_weight/1;

fn child_weight(w: int64) -> int64 {
    w / 2
}

fn link_weight(w: int64) -> (boolean, int64) {
    dbl_pair: (boolean, int64) <- checked_int64_mul(w, 2);
    (dbl_ok: boolean, dbl: int64) <- dbl_pair;
    case dbl_ok of {
        false -> (false, 0);
        true -> checked_int64_add1(dbl)
    }
}

fn is_odd(w: int64) -> boolean {
    ((w / 2) * 2) != w
}

fn is_skew_weight_go(w: int64) -> boolean {
    case w == 1 of {
        true -> true;
        false -> case is_odd(w) of {
            false -> false;
            true -> is_skew_weight_go(w / 2)
        }
    }
}

fn is_skew_weight(w: int64) -> boolean {
    case w <= 0 of {
        true -> false;
        false -> is_skew_weight_go(w)
    }
}
