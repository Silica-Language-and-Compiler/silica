// Layer 2 §16 steps 1–2 — Brodal–Okasaki queue: flattened node encoding (leaf module).
// Authority: design_documents/Phase1_TODOs/data_structure_designs/brodal_okasaki_queue.md §3, §5.
// A node is (minimum, rank, child_count, anchor, children_and_deferred), spelled
// (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]).
// The list holds plain tree refs: the first child_count are this skew-binomial tree's children,
// the rest is the deferred primitive forest of the nested bootstrapped queue whose minimum this
// node holds. The rank is stored at allocation (0 for a root, r + 1 for a linked node); a
// "digit" is just the tree ref, and its rank is read from the node.
// Deviations forced by the bootstrap compiler (see brodal_okasaki.silica header): child_count is
// stored because the [BO96] type-B child boundary is not derivable in O(1); `anchor` is always
// :none and exists only because alloc_rec requires a direct recursive slot in the tuple (E2010
// when the only recursion is inside the List field).
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

export alloc_node/5;
export alloc_cell/5;
export read_present/2;
export read_node/3;
export read_rank/2;
export in_arena/2;
export empty_forest/0;
export cons_digit/4;

fn alloc_cell(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    rank: int64,
    child_count: int64,
    kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]
) -> (region(L, normal), ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) {
    sequence proc[mem(normal)]
        arena: region(L, normal) <- heap.region;
        cell: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- alloc_rec(arena, (item, rank, child_count, :none, kids))
    produces
        pure (arena, cell)
    end
}

fn alloc_node(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    rank: int64,
    child_count: int64,
    kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    alloc_pair: (region(L, normal), ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- alloc_cell(heap, item, rank, child_count, kids);
    (_: region(L, normal), cell: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- alloc_pair;
    cell
}

fn read_present(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } {
    sequence proc[mem(normal)]
        node: (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]) <- read_ref(node_ref);
        (item, _: int64, child_count: int64, _: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) <- node
    produces
        pure { present: true, item: item, child_count: child_count, kids: kids }
    end
}

fn empty_forest() -> List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- empty[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]()
    produces
        pure out
    end
}

fn read_absent(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } {
    sequence
        none_kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- empty_forest()
    produces
        pure { present: false, item: placeholder, child_count: 0, kids: none_kids }
    end
}

// Reads one node without allocating; `present = false` carries the placeholder and no digits.
fn read_node(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    tree: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    placeholder: ItemType
) -> { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } {
    case tree of {
        :none -> read_absent(heap, placeholder);
        node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> read_present(heap, node_ref)
    }
}

fn rank_present(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> int64 {
    sequence proc[mem(normal)]
        node: (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]) <- read_ref(node_ref);
        (_, rank: int64, _: int64, _: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), _: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) <- node
    produces
        pure rank
    end
}

// The stored rank of a tree; :none (a malformed digit) reads as rank 0.
fn read_rank(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    tree: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> int64 {
    case tree of {
        :none -> 0;
        node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> rank_present(heap, node_ref)
    }
}

// Lives here so the L_region_contains helper is emitted (only allocating units get it).
fn in_arena(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> boolean {
    sequence
        inside: boolean <- true
    produces
        pure inside
    end
}

// The rank argument is kept for the callers' readability; the rank lives in the node. The heap
// record comes first so a qualified call resolves ItemType in the tree parameter.
fn cons_digit(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    _: int64,
    tree: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    rest: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]
) -> List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- prepend[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)](tree, rest)
    produces
        pure out
    end
}
