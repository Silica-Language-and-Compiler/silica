}

// Generated {to, data} views of id's row in stored (ascending target) order.
fn neighbors(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, id: KeyType) -> List[{ to: KeyType, data: ValueType }, mem(normal)] {
    cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- cs_of(g);
    graph_csr_core@wrappers(cs, id)
}

// Streams id's {to, data} views without a list.
fn fold_neighbors(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, init: AccType, step: fn(AccType, { to: KeyType, data: ValueType }) -> AccType, id: KeyType) -> AccType {
    cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- cs_of(g);
    graph_csr_core@fold_wrappers(cs, init, step, id)
}

// Every logical edge once as (a, b, data) with a <= b: a self-loop once, a non-loop edge from its
// lesser endpoint.
fn fold_edges(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, init: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- cs_of(g);
    graph_csr_core@fold_entries_canonical(cs, init, step)
}

fn connected(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, a: KeyType, b: KeyType) -> boolean {
    cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- cs_of(g);
    graph_csr_core@reachable(cs, a, b)
}

fn weights_equal(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, a: ValueType, b: ValueType) -> boolean {
    wa: ItemType <- apply_weight(g.edge_weight, a);
    wb: ItemType <- apply_weight(g.edge_weight, b);
    c: :less | :equal | :greater <- compare_weight(g, wa, wb);
    case c of {
        :equal -> true;
        _: atom -> false
    }
}

fn weight_check(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, entries: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]) -> boolean {
    case entries.is_nil of {
        true -> true;
        false -> {
            e: { from: KeyType, to: KeyType, data: ValueType } <- entries.head;
            back: ValueType <- graph_csr_core@entry_value(cs, e.to, e.from);
            case weights_equal(g, e.data, back) of {
                false -> false;
                true -> weight_check(g, cs, entries.tail)
            }
        }
    }
}

// The undirected checks plus comparator-equal reverse weights (weighted_graph_trait.md §7, §11).
fn validate(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }) -> { valid: boolean, error: atom, logical_count: int64 } {
    cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- cs_of(g);
    base: { valid: boolean, error: atom, logical_count: int64 } <- graph_csr_core@validate_undirected(cs, g.edge_count, g.adjacency_entry_count);
    case base.valid of {
        false -> base;
        true -> {
            entries: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- graph_csr_core@entry_list(cs);
            case weight_check(g, cs, entries) of {
                true -> base;
                false -> { valid: false, error: graph_csr_core@asymmetry_error(), logical_count: 0 }
            }
        }
    }
}
