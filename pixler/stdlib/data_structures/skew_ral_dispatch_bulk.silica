// Layer 2 §15 — skew binary random-access list: thin dispatcher for bulk construction, folds,
// range traversal, and validation. Loads the build, traverse, validate, and weights leaf
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// interfaces; the facade (skew_ral) loads only this dispatcher and skew_ral_dispatch_access
// (tutorials_and_howtos/thin_dispatchers_for_compile_ram.md).
// Orientation (design §8) is applied here: reversed = false maps logical index i to physical i;
// reversed = true maps it to count - 1 - i so appends keep earlier logical indexes stable.
// Atom values are numbered per compilation unit (atoms/const_atoms.silica), so every atom that
// crosses a `use` boundary here is either seeded by the runtime (:ok, :overflow, :found, :not_found)
// or created and decoded inside skew_ral_validate; orientation is therefore a boolean, not an atom.

use skew_ral_build;
use skew_ral_traverse;
use skew_ral_validate;

export build_from_items/2;
export build_filled_count/3;
export fold_logical/3;
export fold_physical/3;
export range_valid/3;
export fold_range/5;
export validate/1;
export validate_error_code/1;

fn rebuild(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    count: int64
) -> {
    count: int64,
    reversed: boolean,
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    region: region(L, normal),
    specialization_key: int64
} {
    {
        count: count,
        reversed: ral.reversed,
        compare_item: ral.compare_item,
        forest: forest,
        region: ral.region,
        specialization_key: ral.specialization_key
    }
}

fn built_result(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    built: { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow },
    total: int64
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    case built.status of {
        :overflow -> { list: ral, valid: false, error: skew_ral_validate@overflow_error() };
        :ok -> { list: rebuild(ral, built.forest, total), valid: true, error: :ok }
    }
}

fn build_oriented(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    items: List[ItemType, mem(normal)],
    total: int64
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    case ral.reversed of {
        true -> built_result(ral, skew_ral_build@build_prepend_each(ral, ral.forest, items), total);
        false -> built_result(ral, skew_ral_build@build_prepend_reversed(ral, ral.forest, items), total)
    }
}

fn build_checked(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    items: List[ItemType, mem(normal)],
    n: int64
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    total_pair: (boolean, int64) <- checked_int64_add(ral.count, n);
    (total_ok: boolean, total: int64) <- total_pair;
    case total_ok of {
        false -> { list: ral, valid: false, error: skew_ral_validate@overflow_error() };
        true -> case skew_ral_validate@count_preflight(total) of {
            :ok -> build_oriented(ral, items, total);
            bad: atom -> { list: ral, valid: false, error: bad }
        }
    }
}

// Items arrive in logical order; the result reads back in that order under either orientation.
fn build_from_items(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    items: List[ItemType, mem(normal)]
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    n: int64 <- skew_ral_build@count_items(ral, items, 0);
    build_checked(ral, items, n)
}

fn filled_checked(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    n: int64,
    value: ItemType,
    total: int64
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    case skew_ral_validate@count_preflight(total) of {
        :ok -> built_result(ral, skew_ral_build@build_filled(ral, ral.forest, n, value), total);
        bad: atom -> { list: ral, valid: false, error: bad }
    }
}

fn filled_total(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    n: int64,
    value: ItemType
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    total_pair: (boolean, int64) <- checked_int64_add(ral.count, n);
    (total_ok: boolean, total: int64) <- total_pair;
    case total_ok of {
        false -> { list: ral, valid: false, error: skew_ral_validate@overflow_error() };
        true -> filled_checked(ral, n, value, total)
    }
}

// Negative n and weight overflow fail before any allocation (design §9); the error atoms come
// from skew_ral_validate so validate_error_code decodes them in the unit that created them.
fn build_filled_count(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    n: int64,
    value: ItemType
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    case skew_ral_validate@count_preflight(n) of {
        :ok -> filled_total(ral, n, value);
        bad: atom -> { list: ral, valid: false, error: bad }
    }
}

fn fold_logical(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, ItemType) -> AccType
) -> AccType {
    case ral.reversed of {
        false -> skew_ral_traverse@forest_fold_fwd(ral, init, step, ral.forest);
        true -> skew_ral_traverse@forest_fold_rev(ral, init, step, ral.forest)
    }
}

fn fold_physical(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, ItemType) -> AccType
) -> AccType {
    skew_ral_traverse@forest_fold_fwd(ral, init, step, ral.forest)
}

fn fold_range_oriented(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    start: int64,
    end_excl: int64,
    init: AccType,
    step: fn(AccType, ItemType) -> AccType
) -> AccType {
    case ral.reversed of {
        false -> skew_ral_traverse@forest_fold_range_fwd(ral, init, step, ral.forest, 0, start, end_excl);
        true -> skew_ral_traverse@forest_fold_range_rev(
            ral, init, step, ral.forest, 0, ral.count - end_excl, ral.count - start
        )
    }
}

fn range_end_valid(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    start: int64,
    count: int64
) -> boolean {
    end_pair: (boolean, int64) <- checked_int64_add(start, count);
    (end_ok: boolean, end_excl: int64) <- end_pair;
    case end_ok of {
        false -> false;
        true -> end_excl <= ral.count
    }
}

// A range is valid when 0 <= start, 0 <= count, and start + count <= size without overflow.
fn range_valid(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    start: int64,
    count: int64
) -> boolean {
    case start < 0 of {
        true -> false;
        false -> case count < 0 of {
            true -> false;
            false -> range_end_valid(ral, start, count)
        }
    }
}

// Visits exactly logical indexes [start, start + count) in O(log n + count); an invalid range
// visits nothing and returns init (check range_valid first when the distinction matters).
fn fold_range(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, ItemType) -> AccType,
    start: int64,
    count: int64
) -> AccType {
    case range_valid(ral, start, count) of {
        false -> init;
        true -> fold_range_oriented(ral, start, start + count, init, step)
    }
}

fn validate(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    skew_ral_validate@validate_forest(ral)
}

fn validate_error_code(error: atom) -> int64 {
    skew_ral_validate@validate_error_code(error)
}
