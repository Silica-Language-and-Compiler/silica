// Layer 2 §15 step 6 — skew binary random-access list: persistent tree update (leaf module).
// Authority: skew_binary_random_access_list.md §7. Update follows the lookup route and allocates
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// one replacement cell per level; the other child and every other tree are shared.
// Every exported function whose signature mentions ItemType takes the collection record first:
// the compiler resolves ItemType at a qualified call site from the record's compare_item witness
// (type_checker_collections@assoc_type_from_record_witness). The core never calls compare_item.

use skew_ral_weights;
use skew_ral_node;

export tree_update/5;

fn update_child(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    old_item: ItemType,
    left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    rest: int64,
    item: ItemType
) -> ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) {
    cw: int64 <- skew_ral_weights@child_weight(w);
    case rest < cw of {
        true -> skew_ral_node@alloc_node(ral, old_item, tree_update(ral, left, cw, rest, item), right);
        false -> skew_ral_node@alloc_node(ral, old_item, left, tree_update(ral, right, cw, rest - cw, item))
    }
}

fn update_cell(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    i: int64,
    item: ItemType
) -> ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        node: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (old_item, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure case i == 0 of {
            true -> skew_ral_node@alloc_node(ral, item, left, right);
            false -> update_child(ral, old_item, left, right, w, i - 1, item)
        }
    end
}

// Returns the replacement root, or :none when the route reaches a missing cell (malformed tree).
fn tree_update(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    i: int64,
    item: ItemType
) -> ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case tree of {
        :none -> :none;
        node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> update_cell(ral, node_ref, w, i, item)
    }
}
