// Layer 2 §15 step 10 — skew binary random-access list: full structural validation (leaf module).
// Authority: skew_binary_random_access_list.md §11, §12; common_contract.md §12 (result shape).
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// Read-only, O(n) in cells, O(log n) stack for valid input. Checks, in preorder of the spine:
// count sign, skew form of every weight, digit order (equal pair only at the front), tree
// presence, arena membership, exact shape for the declared weight, distinct children, and the
// weight sum against the recorded count. Payloads are never interpreted.

// Every exported function whose signature mentions ItemType takes the collection record first:
// the compiler resolves ItemType at a qualified call site from the record's compare_item witness
// (type_checker_collections@assoc_type_from_record_witness). The core never calls compare_item.

use skew_ral_weights;
use skew_ral_node;

export validate_forest/1;
export count_preflight/1;
export overflow_error/0;
export validate_error_code/1;

fn result_ok(count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: true, error: :ok, logical_count: count }
}

fn result_err(error: atom, count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: false, error: error, logical_count: count }
}

fn leaf_shape(left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) -> atom {
    case left of {
        :none -> case right of {
            :none -> :ok;
            _: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> :shape_violation
        };
        _: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> :shape_violation
    }
}

fn node_shape_both(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    l: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    r: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    cw: int64
) -> atom {
    sequence
        same: boolean <- ref_eq(l, r);
        out: atom <- case same of {
            true -> :repeated_child;
            false -> node_shape_children(ral, l, r, cw)
        }
    produces
        pure out
    end
}

fn node_shape_children(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    l: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    r: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    cw: int64
) -> atom {
    left_err: atom <- validate_cell(ral, l, cw);
    case left_err of {
        :ok -> validate_cell(ral, r, cw);
        bad: atom -> bad
    }
}

fn node_shape(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    cw: int64
) -> atom {
    case left of {
        :none -> :shape_violation;
        l: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> case right of {
            :none -> :shape_violation;
            r: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) ->
                node_shape_both(ral, l, r, cw)
        }
    }
}

fn validate_cell_children(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64
) -> atom {
    sequence proc[mem(normal)]
        node: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        out: atom <- case w == 1 of {
            true -> leaf_shape(left, right);
            false -> node_shape(ral, left, right, skew_ral_weights@child_weight(w))
        }
    produces
        pure out
    end
}

// w is always a skew weight here, so the descent halves it down to 1 and terminates.
fn validate_cell(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64
) -> atom {
    sequence
        in_arena: boolean <- skew_ral_node@in_arena(ral, node_ref);
        out: atom <- case in_arena of {
            false -> :wrong_arena;
            true -> validate_cell_children(ral, node_ref, w)
        }
    produces
        pure out
    end
}

fn validate_tree(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64
) -> atom {
    case t of {
        :none -> :missing_tree;
        node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) ->
            validate_cell(ral, node_ref, w)
    }
}

fn digit_order_ok(w: int64, prev_w: int64, pos: int64) -> boolean {
    case pos == 0 of {
        true -> true;
        false -> case pos == 1 of {
            true -> w >= prev_w;
            false -> w > prev_w
        }
    }
}

fn finish(count: int64, sum: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    case sum == count of {
        true -> result_ok(sum);
        false -> result_err(:size_mismatch, sum)
    }
}

fn add_and_continue(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    count: int64,
    w: int64,
    pos: int64,
    sum: int64
) -> { valid: boolean, error: atom, logical_count: int64 } {
    sum_pair: (boolean, int64) <- checked_int64_add(sum, w);
    (ok: boolean, next_sum: int64) <- sum_pair;
    case ok of {
        false -> result_err(:size_mismatch, sum);
        true -> walk_digits(ral, rest, count, w, pos + 1, next_sum)
    }
}

fn check_tree_then(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    count: int64,
    w: int64,
    pos: int64,
    sum: int64
) -> { valid: boolean, error: atom, logical_count: int64 } {
    tree_err: atom <- validate_tree(ral, t, w);
    case tree_err of {
        :ok -> add_and_continue(ral, rest, count, w, pos, sum);
        bad: atom -> result_err(bad, sum)
    }
}

fn check_digit(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    count: int64,
    prev_w: int64,
    pos: int64,
    sum: int64
) -> { valid: boolean, error: atom, logical_count: int64 } {
    (w: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    case skew_ral_weights@is_skew_weight(w) of {
        false -> result_err(:rank_violation, sum);
        true -> case digit_order_ok(w, prev_w, pos) of {
            false -> result_err(:rank_violation, sum);
            true -> check_tree_then(ral, t, rest, count, w, pos, sum)
        }
    }
}

fn walk_digits(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    count: int64,
    prev_w: int64,
    pos: int64,
    sum: int64
) -> { valid: boolean, error: atom, logical_count: int64 } {
    case forest of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> finish(count, sum);
        [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] ->
            check_digit(ral, d, rest, count, prev_w, pos, sum)
    }
}

fn validate_forest(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    case ral.count < 0 of {
        true -> result_err(:negative_count, 0);
        false -> walk_digits(ral, ral.forest, ral.count, 0, 0, 0)
    }
}

fn link_fits(n: int64) -> boolean {
    lw_pair: (boolean, int64) <- skew_ral_weights@link_weight(n);
    (ok: boolean, _: int64) <- lw_pair;
    ok
}

// Bulk-construction preflight (design §9): a sequence of n items never links a weight above
// 2n + 1, so rejecting an n whose link weight overflows rejects every overflow before allocation.
// Lives in this unit so its error atoms are created where validate_error_code decodes them.
fn count_preflight(n: int64) -> atom {
    case n < 0 of {
        true -> :negative_count;
        false -> case link_fits(n) of {
            true -> :ok;
            false -> :weight_overflow
        }
    }
}

fn overflow_error() -> atom {
    :weight_overflow
}

fn validate_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :negative_count -> 1;
        :size_mismatch -> 2;
        :rank_violation -> 3;
        :missing_tree -> 4;
        :shape_violation -> 5;
        :wrong_arena -> 6;
        :repeated_child -> 7;
        :weight_overflow -> 8;
        _: atom -> 99
    }
}
