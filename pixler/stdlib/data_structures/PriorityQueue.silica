// Public PriorityQueue trait — Layer 3 over brodal_okasaki_priority (the §16 Brodal–Okasaki core
// over priority/value entries).
// Authority: design_documents/Phase1_TODOs/data_structure_designs/priority_queue_trait.md §3.
//
// Required: len, peek. Provided: is_empty (exactly len(queue) == 0), peek_priority and peek_value
// (projections of the same peek, so the three describe one entry; design §3, §11.6).
// Deviations forced by the compiler (see the brodal_okasaki_priority header for the reasons):
//   - the priority type is spelled KeyType and the value type ValueType, not PriorityType/ItemType;
//   - peek, peek_priority and peek_value take placeholder priority and value arguments (Silica
//     source cannot conjure a zero value of a programmer-declared type; same as the core and the
//     BinaryTree trait), so the provided projections are arity 3 as well;
//   - the receiver is the inline brodal_okasaki_priority record; a `PriorityQueue[P, V, mem(normal)]`
//     binding is accepted only for the brodal_okasaki_priority@empty/1 constructor call.

use brodal_okasaki_priority;

export trait PriorityQueue;
export len/1;
export is_empty/1;
export peek/3;
export peek_priority/3;
export peek_value/3;

required {
    fn len(queue: PriorityQueue) -> int64;
    fn peek(queue: PriorityQueue, placeholder_priority: KeyType, placeholder_value: ValueType)
        -> { status: :not_found | :found, priority: KeyType, value: ValueType };
}

provided {
    fn is_empty(queue: PriorityQueue) -> boolean {
        PriorityQueue@len(queue) == 0
    }
    fn peek_priority(queue: PriorityQueue, placeholder_priority: KeyType, placeholder_value: ValueType)
        -> { status: :not_found | :found, priority: KeyType } {
        r: { status: :not_found | :found, priority: KeyType, value: ValueType }
            <- PriorityQueue@peek(queue, placeholder_priority, placeholder_value);
        { status: r.status, priority: r.priority }
    }
    fn peek_value(queue: PriorityQueue, placeholder_priority: KeyType, placeholder_value: ValueType)
        -> { status: :not_found | :found, value: ValueType } {
        r: { status: :not_found | :found, priority: KeyType, value: ValueType }
            <- PriorityQueue@peek(queue, placeholder_priority, placeholder_value);
        { status: r.status, value: r.value }
    }
}

impl fn len(queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    brodal_okasaki_priority@len(queue)
}

impl fn peek(queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, placeholder_priority: KeyType, placeholder_value: ValueType)
    -> { status: :not_found | :found, priority: KeyType, value: ValueType } {
    brodal_okasaki_priority@peek_priority_entry(queue, placeholder_priority, placeholder_value)
}
