// Layer 4 — graph_wbt_directed: the live WBT DirectedGraph generated module
// (directed_graph_trait.md §4–§10 over live_wbt_graph.md; common_contract.md).
//
// Record (inline at every boundary; the public DirectedGraph[N, P, mem(normal)] bracket type binds
// to empty/1 of this module):
//   { root, compare_node, compare_edge, edge_target, region, specialization_key, node_count,
//     edge_count, compare_node_ordering_bundle, compare_edge_ordering_bundle,
//     edge_target_ordering_bundle }
// Storage is graph_wbt_core's outer WBT map node -> inner WBT map target -> payload; every vertex,
// including isolated and target-only vertices, is an outer key (design §3).
//
// Deviations forced by the compiler (each mirrors an existing stdlib module):
//   1. Placeholders are spelled KeyType (NodeIdType) and ValueType (EdgePayloadType): the type
//      checker substitutes only ItemType/KeyType/ValueType inside composite formals and resolves
//      them from the compare_node / compare_edge record witnesses.
//   2. The inner structure is a WBT map target -> payload for every payload type, not a WBT set of
//      targets for the unweighted specialization: one generated module serves every EdgePayloadType
//      and the type is erased at run time. For EdgePayloadType = NodeIdType the payload is the
//      target itself, so the stored value repeats the key; order, identity and bounds are the
//      design's (neighbors ascend by target, one adjacency position per (from, to)).
//   3. Re-adding an existing (from, to) pair whose payload compares :equal under compare_edge is a
//      no-op (inserted = false, replaced = false, same graph): this is the design's unweighted
//      duplicate rule (payload = target). A different payload replaces (replaced = true).
//   4. fold_neighbors takes the accumulator second — fold_neighbors(g, init, step, id) — because
//      AccType is witnessed by argument two; the DirectedGraph trait keeps the design's order.
//   5. out_degree, has_edge and reachable are module functions here and required (not provided)
//      trait methods (see the DirectedGraph header); out_degree is the cached inner size.
//   6. The DirectedGraph[...] bracket binding is accepted only for empty/1; every other result is
//      bound with the inline record type. mem(normal) only.
//   7. Validation error atoms are created and decoded in graph_wbt_core (validate_error_code).
// Every exported function whose signature mentions KeyType/ValueType takes the graph first.
// compare_raw stays the first function in this unit (comparator atom numbering).
// Q19 node shapes (spelled at every use): inner (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)); outer, the graph root, (KeyType, ref?(L, normal, <inner>), int64, ref?(L, normal, rec), ref?(L, normal, rec)).

use graph_wbt_core;

export empty/1;
export add_vertex/2;
export add_edge/3;
export remove_edge/3;
export has_vertex/2;
export has_edge/3;
export neighbors/2;
export fold_neighbors/4;
export fold_vertices/3;
export fold_edges/3;
export vertices/1;
export node_count/1;
export edge_count/1;
export out_degree/2;
export reachable/3;
export compare_node/3;
export compare_edge/3;
export edge_target/2;
export validate/1;
export validate_error_code/1;

fn compare_raw(
    compare: fn(KeyType, KeyType) -> atom,
    a: KeyType,
    b: KeyType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_value_raw(
    compare: fn(ValueType, ValueType) -> atom,
    a: ValueType,
    b: ValueType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

// Deterministic collection error for an invalid comparator atom (common_contract.md §4).
fn invalid_halt(_: atom) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

// Deterministic collection error: count overflow or a malformed graph found by an update; nothing
// is published (common_contract.md §9).
fn update_halt(n: int64) -> int64 {
    sequence
        _: int64 <- 1 / 0
    produces
        pure n
    end
}

fn b2i(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

// Checked non-negative count addition (delta may be negative).
fn count_add(count: int64, delta: int64) -> int64 {
    case delta > 0 and count > 9223372036854775807 - delta of {
        true -> update_halt(count);
        false -> count + delta
    }
}

fn apply_target(f: fn(ValueType) -> KeyType, v: ValueType) -> KeyType {
    f(v)
}

// Compares two vertex IDs with the captured node comparator.
fn compare_node(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, a: KeyType, b: KeyType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_raw(g.compare_node, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// Compares two edge payloads with the captured edge comparator.
fn compare_edge(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, a: ValueType, b: ValueType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_value_raw(g.compare_edge, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// Extracts the target vertex ID from an edge payload with the captured extractor.
fn edge_target(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, edge: ValueType) -> KeyType {
    apply_target(g.edge_target, edge)
}

// The adjacency record graph_wbt_core works on (wbt_map's record shape over node -> value).
fn adj_of(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
        root: g.root,
        compare_key: g.compare_node,
        compare_value: g.compare_edge,
        region: g.region,
        specialization_key: g.specialization_key,
        compare_key_ordering_bundle: g.compare_node_ordering_bundle,
        compare_value_ordering_bundle: g.compare_edge_ordering_bundle
    };
    out
}

fn adj_at(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
        root: root,
        compare_key: g.compare_node,
        compare_value: g.compare_edge,
        region: g.region,
        specialization_key: g.specialization_key,
        compare_key_ordering_bundle: g.compare_node_ordering_bundle,
        compare_value_ordering_bundle: g.compare_edge_ordering_bundle
    };
    out
}

// A new graph value around root with adjusted cached counts; functions, region, specialization
// key and ordering bundles are copied unchanged (common_contract.md §7).
fn publish(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), dn: int64, de: int64) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- {
        root: root,
        compare_node: g.compare_node,
        compare_edge: g.compare_edge,
        edge_target: g.edge_target,
        region: g.region,
        specialization_key: g.specialization_key,
        node_count: count_add(g.node_count, dn),
        edge_count: count_add(g.edge_count, de),
        compare_node_ordering_bundle: g.compare_node_ordering_bundle,
        compare_edge_ordering_bundle: g.compare_edge_ordering_bundle,
        edge_target_ordering_bundle: g.edge_target_ordering_bundle
    };
    out
}

// An empty live graph in the canonical live-graph arena. The ordering identity of every captured
// function is materialized once here and preserved by every persistent update (common_contract.md §5).
fn empty(
    functions: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType }
) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        arena: region(L, normal) <- canonical_arena_lookup(90);
        t_compare_node: int64 <- ordering_identity_materialize(functions.compare_node);
        t_compare_edge: int64 <- ordering_identity_materialize(functions.compare_edge);
        t_edge_target: int64 <- ordering_identity_materialize(functions.edge_target);
        out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- {
            root: :none,
            compare_node: functions.compare_node,
            compare_edge: functions.compare_edge,
            edge_target: functions.edge_target,
            region: arena,
            specialization_key: 0,
            node_count: 0,
            edge_count: 0,
            compare_node_ordering_bundle: t_compare_node,
            compare_edge_ordering_bundle: t_compare_edge,
            edge_target_ordering_bundle: t_edge_target
        }
    produces
        pure out
    end
}

fn publish_vertex(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } {
    publish(g, root, 1, 0)
}

// Persistently adds an explicit vertex if it is absent (design §3); an existing vertex returns the
// same graph with inserted = false.
fn add_vertex(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, id: KeyType) -> { graph: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean } {
    sequence
        adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
        r: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), inserted: boolean } <- graph_wbt_core@add_vertex(adj, id)
    produces
        pure case r.inserted of {
            false -> { graph: g, inserted: false };
            true -> { graph: publish_vertex(g, r.root), inserted: true }
        }
    end
}

// Reports whether id is an explicit vertex: O(log V).
fn has_vertex(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, id: KeyType) -> boolean {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@has_vertex(adj, id)
}

// Reports whether the adjacency entry (from, to) is stored: O(log V + log d(from)).
fn has_edge(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, from: KeyType, to: KeyType) -> boolean {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@has_entry(adj, from, to)
}

// Visits every vertex once in ascending node order.
fn fold_vertices(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, init: AccType, step: fn(AccType, KeyType) -> AccType) -> AccType {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@fold_vertices(adj, init, step)
}

// Every vertex in ascending node order (a fresh list).
fn vertices(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> List[KeyType, mem(normal)] {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@vertices(adj)
}

// Cached vertex cardinality.
fn node_count(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> int64 {
    g.node_count
}

// Cached logical-edge cardinality.
fn edge_count(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> int64 {
    g.edge_count
}

// Stored adjacency entries at id (cached inner WBT size); zero for a missing or isolated vertex.
fn out_degree(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, id: KeyType) -> int64 {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@degree(adj, id)
}

fn validate_error_code(error: atom) -> int64 {
    graph_wbt_core@validate_error_code(error)
}

fn same_payload(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, from: KeyType, to: KeyType, edge: ValueType) -> boolean {
    case graph_wbt_core@has_entry(adj, from, to) of {
        false -> false;
        true -> {
            old: ValueType <- graph_wbt_core@entry_value(adj, from, to);
            c: :less | :equal | :greater <- compare_edge(g, old, edge);
            case c of {
                :equal -> true;
                _: atom -> false
            }
        }
    }
}

fn add_edge_set(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, from: KeyType, to: KeyType, edge: ValueType) -> { graph: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } {
    sequence
        r: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), inserted: boolean, replaced: boolean, nodes_added: int64 } <- graph_wbt_core@set_entry(adj, from, to, edge);
        out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 } <- publish(g, r.root, r.nodes_added, b2i(r.inserted))
    produces
        pure { graph: out, inserted: r.inserted, replaced: r.replaced }
    end
}

// Persistently inserts or replaces the outgoing edge from -> edge_target(edge) (design §4–§5):
// missing endpoints are added; an existing pair with a comparator-equal payload is a no-op.
fn add_edge(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, from: KeyType, edge: ValueType) -> { graph: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } {
    sequence
        to: KeyType <- apply_target(g.edge_target, edge);
        adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
        dup: boolean <- same_payload(g, adj, from, to, edge)
    produces
        pure case dup of {
            true -> { graph: g, inserted: false, replaced: false };
            false -> add_edge_set(g, adj, from, to, edge)
        }
    end
}

// Persistently removes the directed pair (from, to); a missing pair is a no-op. Endpoints stay.
fn remove_edge(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, from: KeyType, to: KeyType) -> { graph: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, removed: boolean } {
    sequence
        adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
        r: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), removed: boolean } <- graph_wbt_core@remove_entry(adj, from, to)
    produces
        pure case r.removed of {
            false -> { graph: g, removed: false };
            true -> { graph: publish(g, r.root, 0, -1), removed: true }
        }
    end
}

// Outgoing payloads of id in ascending target order; empty for a missing or isolated vertex.
fn neighbors(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, id: KeyType) -> List[ValueType, mem(normal)] {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@values(adj, id)
}

// Folds id's outgoing payloads in ascending target order without materializing a list.
fn fold_neighbors(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, init: AccType, step: fn(AccType, ValueType) -> AccType, id: KeyType) -> AccType {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@fold_values(adj, init, step, id)
}

// Visits every directed edge once as (from, payload): ascending from, then ascending target.
fn fold_edges(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, init: AccType, step: fn(AccType, KeyType, ValueType) -> AccType) -> AccType {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@fold_entries(adj, init, step)
}

// Reports whether to is reachable from from along outgoing edges (design §6).
fn reachable(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, from: KeyType, to: KeyType) -> boolean {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@reachable(adj, from, to)
}

// Checks WBT, endpoint, payload-target and count invariants (design §9).
fn validate(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> { valid: boolean, error: atom, logical_count: int64 } {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@validate_directed(adj, g.edge_target, g.node_count, g.edge_count)
}
