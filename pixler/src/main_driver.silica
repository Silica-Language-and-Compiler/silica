// Config read and first-vs-resume dispatch. String lists only.

use module_checker_core;
use main_lists;
use main_driver_first;
use main_driver_resume;
use main_crash;

export run/0;

fn run() -> int64 {
    sequence proc[DeviceIO]
        // After a crash (exit 76, main.silica) the next process finds the unit the crash was inside.
        crashed_now: boolean <- main_crash@note_crashed_unit();
        resumed: boolean <- crashed_now or file_exists(main_lists@compile_order_path());
        _: int64 <- main_crash@forget_crashed_if_fresh(resumed);
        config_path: string <- "silica.config";
        config_exists: boolean <- file_exists(config_path);
        content: string <- case config_exists of {
            true -> read_lines(config_path);
            false -> ""
        };
        empty_files: List[string, mem(normal)] <- module_checker_core@empty_list_string();
        files_rev: List[string, mem(normal)] <- case length_bytes(content) > 0 of {
            true -> main_lists@parse_config_lines(content, 0, empty_files);
            false -> empty_files
        };
        files: List[string, mem(normal)] <- main_lists@reverse_list_string(files_rev);
        result: int64 <- case main_lists@list_string_length(files) == 0 of {
            true -> {
                _: int8 <- println("Error: silica.config not found or empty. Create silica.config with one .silica file per line.");
                1
            };
            false -> {
                validation_files: int64 <- main_lists@validate_config_files(files);
                validation: int64 <- case validation_files != 0 of {
                    true -> validation_files;
                    false -> main_lists@validate_config_module_names(files)
                };
                case validation != 0 of {
                    true -> 1;
                    false -> {
                        _: int64 <- main_lists@reset_atoms_if_fresh(files);
                        // Small configs always compile in-process; drop any leftover reclaim-order
                        // file so a prior process-per-unit run cannot force "Resuming…" output.
                        _: int64 <- case main_lists@use_process_per_unit(files) of {
                            true -> 0;
                            false -> main_lists@clear_reclaim_artifacts()
                        };
                        order_exists: boolean <- file_exists(main_lists@compile_order_path());
                        case order_exists of {
                            true -> {
                                order_content: string <- read_lines(main_lists@compile_order_path());
                                empty_order: List[string, mem(normal)] <- module_checker_core@empty_list_string();
                                order_rev: List[string, mem(normal)] <- case length_bytes(order_content) > 0 of {
                                    true -> main_lists@parse_config_lines(order_content, 0, empty_order);
                                    false -> empty_order
                                };
                                order: List[string, mem(normal)] <- main_lists@reverse_list_string(order_rev);
                                _: int8 <- println("Resuming compile order; units left: ");
                                _: int8 <- print_int64(main_lists@list_string_length(order));
                                _: int8 <- println("");
                                main_driver_resume@resume_compile_order(order, files)
                            };
                            false -> {
                                _: int8 <- println("Files to compile: ");
                                _: int8 <- print_int64(main_lists@list_string_length(files));
                                _: int8 <- println("");
                                main_driver_first@first_compile(files)
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}
