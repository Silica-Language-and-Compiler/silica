                                case tc_out.is_ok of {
                                    true -> {
                                        // E2236: register_failure_reporter before any start in main (§15.4.13.4).
                                        start_order_ext: List[{ key: string, code: int64 }, mem(normal)] <- type_checker_start_order@start_order_table_from_ifaces(dep_ifaces);
                                        start_order_r0: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_start_order@start_order_check_main(mod_name, program, world_for_tc, start_order_ext);
                                        // E2237 / E2238: casts to call-only and calls to cast-only actors wherever the convention is known (§16.2.6.2-§16.2.6.4).
