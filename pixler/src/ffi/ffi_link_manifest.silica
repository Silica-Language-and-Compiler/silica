// Phase 9 link manifest: step 1 emits silica.link; step 3 validates prebuilt archives exist.

use sir_ast;
use parser_ast;
use module_checker_core;
use ffi_sidecar_loader;
use build_output;
use diagnostics_core;

export write_link_manifest_for_parsed/1;

fn append_sir_string_at_end(items: List[string, mem(normal)], s: string) -> List[string, mem(normal)] {
    case items.is_nil of {
        true -> sir_ast@cons_sir_string(s, sir_ast@nil_sir_strings());
        false -> sir_ast@cons_sir_string(items.head, append_sir_string_at_end(items.tail, s))
    }
}

fn append_sir_string_unique_end(items: List[string, mem(normal)], s: string) -> List[string, mem(normal)] {
    case length_bytes(s) == 0 of {
        true -> items;
        false -> case sir_ast@sir_string_list_contains(items, s) of {
            true -> items;
            false -> append_sir_string_at_end(items, s)
        }
    }
}

fn merge_sir_strings_unique_end(acc: List[string, mem(normal)], add: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case add.is_nil of {
        true -> acc;
        false -> merge_sir_strings_unique_end(append_sir_string_unique_end(acc, add.head), add.tail)
    }
}

fn collect_closure_link_libraries(parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case parsed.is_nil of {
        true -> acc;
        false -> {
            unit_libs: List[string, mem(normal)] <- ffi_sidecar_loader@collect_program_link_libraries(parsed.head.program);
            merged: List[string, mem(normal)] <- merge_sir_strings_unique_end(acc, unit_libs);
            collect_closure_link_libraries(parsed.tail, merged)
        }
    }
}

fn collect_closure_foreign_symbols(parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case parsed.is_nil of {
        true -> acc;
        false -> {
            unit_syms: List[string, mem(normal)] <- ffi_sidecar_loader@collect_program_foreign_symbols(parsed.head.program);
            merged: List[string, mem(normal)] <- merge_sir_strings_unique_end(acc, unit_syms);
            collect_closure_foreign_symbols(parsed.tail, merged)
        }
    }
}

fn archive_path_for_link_library(lib_name: string) -> string {
    concat(concat("dangerous_exposure_source/lib/lib", lib_name), ".a")
}

fn link_manifest_line_link_library(lib_name: string) -> string {
    concat(concat("link_library: \"", lib_name), "\"\n")
}

fn link_manifest_line_archive(lib_name: string) -> string {
    concat(concat("archive: \"", archive_path_for_link_library(lib_name)), "\"\n")
}

fn link_manifest_line_symbol(sym: string) -> string {
    concat(concat("symbol: \"", sym), "\"\n")
}

fn link_manifest_text_for_libraries(libs: List[string, mem(normal)]) -> string {
    case libs.is_nil of {
        true -> "";
        false -> concat(link_manifest_line_link_library(libs.head), concat(link_manifest_line_archive(libs.head), link_manifest_text_for_libraries(libs.tail)))
    }
}

fn link_manifest_text_for_symbols(symbols: List[string, mem(normal)]) -> string {
    case symbols.is_nil of {
        true -> "";
        false -> concat(link_manifest_line_symbol(symbols.head), link_manifest_text_for_symbols(symbols.tail))
    }
}

fn build_link_manifest_text(link_libraries: List[string, mem(normal)], symbols: List[string, mem(normal)]) -> string {
    concat(link_manifest_text_for_libraries(link_libraries), link_manifest_text_for_symbols(symbols))
}

fn closure_needs_link_manifest(link_libraries: List[string, mem(normal)], symbols: List[string, mem(normal)]) -> boolean {
    case link_libraries.is_nil of {
        false -> true;
        true -> case symbols.is_nil of {
            false -> true;
            true -> false
        }
    }
}

fn location_is_set(loc: { file: string, line: int64, column: int64, offset: int64 }) -> boolean {
    case loc.line == 0 of {
        false -> true;
        true -> case length_bytes(loc.file) == 0 of {
            false -> true;
            true -> false
        }
    }
}

fn first_ffi_location_in_parsed(parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { file: string, line: int64, column: int64, offset: int64 } {
    case parsed.is_nil of {
        true -> parser_ast@zero_location();
        false -> {
            loc: { file: string, line: int64, column: int64, offset: int64 } <- ffi_sidecar_loader@first_foreign_or_meta_location_from_program(parsed.head.program);
            case location_is_set(loc) of {
                true -> loc;
                false -> first_ffi_location_in_parsed(parsed.tail)
            }
        }
    }
}

fn print_link_manifest_error(code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string) -> int64 {
    _: int8 <- diagnostics_core@print_compiler_error("ModuleError", code, loc, msg, "sect14.2");
    1
}

fn validate_one_archive_exists(lib_name: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> int64 {
    sequence proc[DeviceIO]
        path: string <- archive_path_for_link_library(lib_name);
            exists: boolean <- file_exists(path);
        result: int64 <- case exists of {
                false -> {
                    p1: string <- concat("prebuilt library archive not found: ", path);
                    msg: string <- concat(p1, " (spec 14.2)");
                    print_link_manifest_error("E4034", loc, msg)
                };
                true -> 0
            }
    produces
        pure result
    end
}

fn validate_archives_exist_loop(libs: List[string, mem(normal)], loc: { file: string, line: int64, column: int64, offset: int64 }) -> int64 {
    case libs.is_nil of {
        true -> 0;
        false -> {
            st: int64 <- validate_one_archive_exists(libs.head, loc);
            case st != 0 of {
                true -> st;
                false -> validate_archives_exist_loop(libs.tail, loc)
            }
        }
    }
}

fn write_link_manifest_for_parsed(parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> int64 {
    link_libraries: List[string, mem(normal)] <- collect_closure_link_libraries(parsed, sir_ast@nil_sir_strings());
    symbols: List[string, mem(normal)] <- collect_closure_foreign_symbols(parsed, sir_ast@nil_sir_strings());
    case closure_needs_link_manifest(link_libraries, symbols) of {
        false -> build_output@write_link_manifest("");
        true -> {
            diag_loc: { file: string, line: int64, column: int64, offset: int64 } <- first_ffi_location_in_parsed(parsed);
            arch_st: int64 <- validate_archives_exist_loop(link_libraries, diag_loc);
            case arch_st != 0 of {
                true -> arch_st;
                false -> {
                    manifest: string <- build_link_manifest_text(link_libraries, symbols);
                    build_output@write_link_manifest(manifest)
                }
            }
        }
    }
}
