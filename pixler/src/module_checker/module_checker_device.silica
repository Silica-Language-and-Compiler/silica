// Device module rules (silica_device_actor_specification.md §3): the device_ prefix and its cascade
// along `use`, disjointness from dangerous_*, the device-worker surface only in device_* modules, and
// no device_* module defining a function named after a prim. Path rules only, like module_checker_ffi.

use parser_ast;
use type_checker_core;

export validate_device_module_rules/2;
export is_device_module_name/1;

fn is_device_module_name(name: string) -> boolean {
    length_bytes(name) >= 7 and substring(name, 0, 7) == "device_"
}

fn is_dangerous_module_name(name: string) -> boolean {
    length_bytes(name) >= 10 and substring(name, 0, 10) == "dangerous_"
}

fn ok_result() -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    (0, "", parser_ast@zero_location(), "", "")
}

fn contains_at(s: string, pat: string, i: int64) -> boolean {
    case i + length_bytes(pat) > length_bytes(s) of {
        true -> false;
        false -> case substring(s, i, i + length_bytes(pat)) == pat of {
            true -> true;
            false -> contains_at(s, pat, i + 1)
        }
    }
}

fn type_mentions_device(t: string) -> boolean {
    case contains_at(t, "device_actor_ref", 0) of {
        true -> true;
        false -> contains_at(t, "device_window(", 0)
    }
}

fn effects_have_register_rwr(effs: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> boolean {
    case effs.is_nil of {
        true -> false;
        false -> case effs.head.name == "register_rwr" of {
            true -> true;
            false -> effects_have_register_rwr(effs.tail)
        }
    }
}

fn is_device_surface_call(name: string) -> boolean {
    type_checker_core@call_name_is_module_qualified(name) == false and is_device_surface_name(name)
}

fn is_device_surface_name(name: string) -> boolean {
    case name of {
        "spawn_device" -> true;
        "spawn_device_registered" -> true;
        "cast_device" -> true;
        "cast_device_registered" -> true;
        _: string -> false
    }
}

fn is_prim_name(name: string) -> boolean {
    case name of {
        "map_device" -> true;
        "peek" -> true;
        "poke" -> true;
        _: string -> false
    }
}

fn device_surface_error() -> string {
    "spawn_device, spawn_device_registered, cast_device, cast_device_registered, device_actor_ref, device_window and register_rwr may only appear in modules whose name begins with device_ (silica_device_actor_specification.md §3.1)."
}

fn check_use_params(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], module_name: string) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case params.is_nil of {
        true -> ok_result();
        false -> {
            dep: string <- params.head.name;
            case is_device_module_name(dep) and is_dangerous_module_name(module_name) of {
                true -> (1, "E2231", params.head.location, "A module must not depend on both device_* and dangerous_* modules: a dangerous_* module may not use a device_* module (silica_device_actor_specification.md §3.2).", "sect3.2");
                false -> case is_dangerous_module_name(dep) and is_device_module_name(module_name) of {
                    true -> (1, "E2231", params.head.location, "A module must not depend on both device_* and dangerous_* modules: a device_* module may not use a dangerous_* module (silica_device_actor_specification.md §3.2).", "sect3.2");
                    false -> case is_device_module_name(dep) and is_device_module_name(module_name) == false of {
                        true -> (1, "E2230", params.head.location, "A module that uses a device_* module must use the device_ prefix in its own module name (silica_device_actor_specification.md §3.1).", "sect3.1");
                        false -> check_use_params(params.tail, module_name)
                    }
                }
            }
        }
    }
}

fn check_use_decls(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], module_name: string) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case decls.is_nil of {
        true -> ok_result();
        false -> case decls.head.tag == 2 of {
            false -> check_use_decls(decls.tail, module_name);
            true -> {
                (st: int64, ec: string, eloc: { file: string, line: int64, column: int64, offset: int64 }, emsg: string, espec: string) <- check_use_params(decls.head.parameters, module_name);
                case st == 0 of {
                    false -> (st, ec, eloc, emsg, espec);
                    true -> check_use_decls(decls.tail, module_name)
                }
            }
        }
    }
}

fn expr_has_device_surface(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case expr.root < 0 of {
        true -> ok_result();
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> ok_result();
                false -> case (node.kind == 4 and is_device_surface_call(node.name)) or (node.kind == 11 and effects_have_register_rwr(node.sequence_effects)) of {
                    true -> (1, "E2232", node.location, device_surface_error(), "sect3.1");
                    false -> {
                        (i_st: int64, i_ec: string, i_loc: { file: string, line: int64, column: int64, offset: int64 }, i_msg: string, i_spec: string) <- expr_has_device_surface(parser_ast@expr_at(expr, node.inner));
                        case i_st == 0 of {
                            false -> (i_st, i_ec, i_loc, i_msg, i_spec);
                            true -> {
                                (r_st: int64, r_ec: string, r_loc: { file: string, line: int64, column: int64, offset: int64 }, r_msg: string, r_spec: string) <- expr_has_device_surface(parser_ast@expr_at(expr, node.right_expr));
                                case r_st == 0 of {
                                    false -> (r_st, r_ec, r_loc, r_msg, r_spec);
                                    true -> case node.kind == 6 and type_mentions_device(node.value) of {
                                        true -> (1, "E2232", node.location, device_surface_error(), "sect3.1");
                                        false -> ok_result()
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn params_mention_device(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case params.is_nil of {
        true -> ok_result();
        false -> case type_mentions_device(params.head.type_name) of {
            true -> (1, "E2232", params.head.location, device_surface_error(), "sect3.1");
            false -> params_mention_device(params.tail)
        }
    }
}

fn check_no_device_surface(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case decls.is_nil of {
        true -> ok_result();
        false -> case decls.head.tag == 0 of {
            false -> check_no_device_surface(decls.tail);
            true -> {
                (p_st: int64, p_ec: string, p_loc: { file: string, line: int64, column: int64, offset: int64 }, p_msg: string, p_spec: string) <- params_mention_device(decls.head.parameters);
                case p_st == 0 of {
                    false -> (p_st, p_ec, p_loc, p_msg, p_spec);
                    true -> case type_mentions_device(decls.head.return_type_name) or effects_have_register_rwr(decls.head.declared_effects) of {
                        true -> (1, "E2232", decls.head.location, device_surface_error(), "sect3.1");
                        false -> {
                            (b_st: int64, b_ec: string, b_loc: { file: string, line: int64, column: int64, offset: int64 }, b_msg: string, b_spec: string) <- expr_has_device_surface(decls.head.body);
                            case b_st == 0 of {
                                false -> (b_st, b_ec, b_loc, b_msg, b_spec);
                                true -> check_no_device_surface(decls.tail)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_no_prim_definitions(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case decls.is_nil of {
        true -> ok_result();
        false -> case decls.head.tag == 0 and is_prim_name(decls.head.name) of {
            true -> (1, "E2217", decls.head.location, concat("a device_* module must not define a function named ", concat(decls.head.name, "; that name is the device prim there (silica_device_actor_specification.md §4.7).")), "sect4.7");
            false -> check_no_prim_definitions(decls.tail)
        }
    }
}

fn validate_device_module_rules(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, module_name: string) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    (u_st: int64, u_ec: string, u_loc: { file: string, line: int64, column: int64, offset: int64 }, u_msg: string, u_spec: string) <- check_use_decls(program.declarations, module_name);
    case u_st == 0 of {
        false -> (u_st, u_ec, u_loc, u_msg, u_spec);
        true -> case is_device_module_name(module_name) of {
            true -> check_no_prim_definitions(program.declarations);
            false -> check_no_device_surface(program.declarations)
        }
    }
}
