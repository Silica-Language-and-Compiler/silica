// FFI module rules (silica_ffi_wrapper_specification.md §3): dangerous_* naming, wrapper_meta paths,
// export surface for raw foreign bindings and adapter wrappers. Phase 3 — path rules only (no sidecar load).

use parser_ast;
use diagnostics_core;
use type_checker_core;

export validate_ffi_module_rules/2;
export validate_export_item_ffi/5;
export emit_ffi_wrapper_warnings/1;

fn dangerous_prefix() -> string {
    "dangerous_"
}

fn is_dangerous_module_name(name: string) -> boolean {
    pref: string <- dangerous_prefix();
    case length_bytes(name) >= length_bytes(pref) of {
        false -> false;
        true -> substring(name, 0, length_bytes(pref)) == pref
    }
}

fn sidecar_root_prefix() -> string {
    "dangerous_exposure_source/"
}

fn string_starts_with(s: string, prefix: string) -> boolean {
    case length_bytes(s) >= length_bytes(prefix) of {
        false -> false;
        true -> substring(s, 0, length_bytes(prefix)) == prefix
    }
}

fn strip_string_literal_quotes(lexeme: string) -> string {
    case length_bytes(lexeme) >= 2 of {
        false -> lexeme;
        true -> case substring(lexeme, 0, 1) == "\"" of {
            false -> lexeme;
            true -> case substring(lexeme, length_bytes(lexeme) - 1, length_bytes(lexeme)) == "\"" of {
                false -> lexeme;
                true -> substring(lexeme, 1, length_bytes(lexeme) - 1)
            }
        }
    }
}

fn list_param_length_ffi(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case params.is_nil of {
        true -> 0;
        false -> 1 + list_param_length_ffi(params.tail)
    }
}

fn program_has_foreign_binding_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 9 of {
            true -> true;
            false -> program_has_foreign_binding_loop(decls.tail)
        }
    }
}

fn program_has_wrapper_meta_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 8 of {
            true -> true;
            false -> program_has_wrapper_meta_loop(decls.tail)
        }
    }
}

fn foreign_binding_has_meta(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> boolean {
    case decl.tag == 9 of {
        false -> false;
        true -> {
            body_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(decl.body);
            length_bytes(body_node.name) > 0
        }
    }
}

fn all_foreign_bindings_have_meta_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    case decls.is_nil of {
        true -> true;
        false -> case decls.head.tag == 9 of {
            true -> case foreign_binding_has_meta(decls.head) of {
                false -> false;
                true -> all_foreign_bindings_have_meta_loop(decls.tail)
            };
            false -> all_foreign_bindings_have_meta_loop(decls.tail)
        }
    }
}

fn first_foreign_binding_location_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { file: string, line: int64, column: int64, offset: int64 } {
    case decls.is_nil of {
        true -> parser_ast@zero_location();
        false -> case decls.head.tag == 9 of {
            true -> decls.head.location;
            false -> first_foreign_binding_location_loop(decls.tail)
        }
    }
}

fn ffi_wrapper_warning_message(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> string {
    body_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(decl.body);
    c_symbol: string <- strip_string_literal_quotes(body_node.value);
    concat(
        "DANGER DANGER DANGER: this module uses FFI wrapper '",
        concat(
            decl.name,
            concat(
                "' for foreign symbol '",
                concat(
                    c_symbol,
                    "'. FFI breaks the Silica security model for this app and exposes the entire application to memory insecurity, ABI unsafety, undefined behavior, privilege-boundary collapse, and other security issues from the foreign code and wrapper boundary."
                )
            )
        )
    )
}

fn emit_ffi_wrapper_warnings_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> int64 {
    case decls.is_nil of {
        true -> 0;
        false -> case decls.head.tag == 9 of {
            true -> {
                msg: string <- ffi_wrapper_warning_message(decls.head);
                _: int8 <- diagnostics_core@print_compiler_warning("FFI_Warning", "W4001", decls.head.location, msg, "sect3");
                emit_ffi_wrapper_warnings_loop(decls.tail)
            };
            false -> emit_ffi_wrapper_warnings_loop(decls.tail)
        }
    }
}

fn emit_ffi_wrapper_warnings(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> int64 {
    emit_ffi_wrapper_warnings_loop(program.declarations)
}

fn validate_sidecar_path_lexeme(lexeme: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    path: string <- strip_string_literal_quotes(lexeme);
    case string_starts_with(path, sidecar_root_prefix()) of {
        false -> (1, "E4024", loc, "wrapper_meta and meta paths must be located under dangerous_exposure_source at the root of the Silica project.", "sect3.2");
        true -> (0, "", parser_ast@zero_location(), "", "")
    }
}

fn validate_wrapper_meta_paths_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case decls.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case decls.head.tag == 8 of {
            true -> {
                (st: int64, ec: string, eloc: { file: string, line: int64, column: int64, offset: int64 }, emsg: string, espec: string) <- validate_sidecar_path_lexeme(decls.head.name, decls.head.location);
                case st == 0 of {
                    false -> (st, ec, eloc, emsg, espec);
                    true -> validate_wrapper_meta_paths_loop(decls.tail)
                }
            };
            false -> validate_wrapper_meta_paths_loop(decls.tail)
        }
    }
}

fn validate_foreign_meta_paths_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case decls.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case decls.head.tag == 9 of {
            true -> {
                body_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(decls.head.body);
                case length_bytes(body_node.name) > 0 of {
                    false -> validate_foreign_meta_paths_loop(decls.tail);
                    true -> {
                        (st: int64, ec: string, eloc: { file: string, line: int64, column: int64, offset: int64 }, emsg: string, espec: string) <- validate_sidecar_path_lexeme(body_node.name, decls.head.location);
                        case st == 0 of {
                            false -> (st, ec, eloc, emsg, espec);
                            true -> validate_foreign_meta_paths_loop(decls.tail)
                        }
                    }
                }
            };
            false -> validate_foreign_meta_paths_loop(decls.tail)
        }
    }
}

fn validate_use_dangerous_dependency_loop(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case params.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case is_dangerous_module_name(params.head.name) of {
            true -> (1, "E4021", params.head.location, "A module that imports or uses a dangerous_* module must use the dangerous_ prefix in its own module name.", "sect3.1");
            false -> validate_use_dangerous_dependency_loop(params.tail)
        }
    }
}

fn validate_use_dangerous_dependency_declarations_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case decls.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case decls.head.tag == 2 of {
            true -> {
                (st: int64, ec: string, eloc: { file: string, line: int64, column: int64, offset: int64 }, emsg: string, espec: string) <- validate_use_dangerous_dependency_loop(decls.head.parameters);
                case st == 0 of {
                    false -> (st, ec, eloc, emsg, espec);
                    true -> validate_use_dangerous_dependency_declarations_loop(decls.tail)
                }
            };
            false -> validate_use_dangerous_dependency_declarations_loop(decls.tail)
        }
    }
}

fn dangerous_spawn_surface_error() -> string {
    "spawn_dangerous, spawn_dangerous_registered, and dangerous_actor_ref may only appear in modules whose name begins with dangerous_."
}

fn is_dangerous_spawn_surface_call(name: string) -> boolean {
    base: string <- type_checker_core@user_call_base_function_name(name);
    case base == "spawn_dangerous" of {
        true -> true;
        false -> base == "spawn_dangerous_registered"
    }
}

fn is_dangerous_actor_ref_type(type_name: string) -> boolean {
    type_name == "dangerous_actor_ref"
}

fn is_spawn_dangerous_call(name: string) -> boolean {
    is_dangerous_spawn_surface_call(name)
}

fn validate_expr_dangerous_spawn_surface(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case expr.root < 0 of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> (0, "", parser_ast@zero_location(), "", "");
                false -> case node.kind == 4 of {
                    true -> case is_dangerous_spawn_surface_call(node.name) of {
                        true -> (1, "E4026", node.location, dangerous_spawn_surface_error(), "sect3.1");
                        false -> validate_expr_pair_dangerous_spawn_surface(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr))
                    };
                    false -> case node.kind == 6 of {
                        true -> case is_dangerous_actor_ref_type(node.value) of {
                            true -> (1, "E4026", node.location, dangerous_spawn_surface_error(), "sect3.1");
                            false -> validate_expr_pair_dangerous_spawn_surface(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr))
                        };
                        false -> validate_expr_pair_dangerous_spawn_surface(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr))
                    }
                }
            }
        }
    }
}

fn validate_expr_pair_dangerous_spawn_surface(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    (i_st: int64, i_ec: string, i_loc: { file: string, line: int64, column: int64, offset: int64 }, i_msg: string, i_spec: string) <- validate_expr_dangerous_spawn_surface(inner);
    case i_st == 0 of {
        false -> (i_st, i_ec, i_loc, i_msg, i_spec);
        true -> validate_expr_dangerous_spawn_surface(right)
    }
}

fn validate_param_list_dangerous_spawn_surface(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case params.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case is_dangerous_actor_ref_type(params.head.type_name) of {
            true -> (1, "E4026", params.head.location, dangerous_spawn_surface_error(), "sect3.1");
            false -> validate_param_list_dangerous_spawn_surface(params.tail)
        }
    }
}

fn validate_declarations_dangerous_spawn_surface_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case decls.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case decls.head.tag == 0 of {
            true -> {
                (p_st: int64, p_ec: string, p_loc: { file: string, line: int64, column: int64, offset: int64 }, p_msg: string, p_spec: string) <- validate_param_list_dangerous_spawn_surface(decls.head.parameters);
                case p_st == 0 of {
                    false -> (p_st, p_ec, p_loc, p_msg, p_spec);
                    true -> case is_dangerous_actor_ref_type(decls.head.return_type_name) of {
                        true -> (1, "E4026", decls.head.return_type_location, dangerous_spawn_surface_error(), "sect3.1");
                        false -> {
                            (b_st: int64, b_ec: string, b_loc: { file: string, line: int64, column: int64, offset: int64 }, b_msg: string, b_spec: string) <- validate_expr_dangerous_spawn_surface(decls.head.body);
                            case b_st == 0 of {
                                false -> (b_st, b_ec, b_loc, b_msg, b_spec);
                                true -> validate_declarations_dangerous_spawn_surface_loop(decls.tail)
                            }
                        }
                    }
                }
            };
            false -> validate_declarations_dangerous_spawn_surface_loop(decls.tail)
        }
    }
}

fn validate_dangerous_spawn_surface_rules(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, module_name: string) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case is_dangerous_module_name(module_name) of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> validate_declarations_dangerous_spawn_surface_loop(program.declarations)
    }
}

fn validate_ffi_metadata_and_naming(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, module_name: string) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    sequence
        (wm_st: int64, wm_ec: string, wm_loc: { file: string, line: int64, column: int64, offset: int64 }, wm_msg: string, wm_spec: string) <- validate_wrapper_meta_paths_loop(program.declarations);
        result: (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) <- case wm_st == 0 of {
            false -> (wm_st, wm_ec, wm_loc, wm_msg, wm_spec);
            true -> {
                (fm_st: int64, fm_ec: string, fm_loc: { file: string, line: int64, column: int64, offset: int64 }, fm_msg: string, fm_spec: string) <- validate_foreign_meta_paths_loop(program.declarations);
                case fm_st == 0 of {
                    false -> (fm_st, fm_ec, fm_loc, fm_msg, fm_spec);
                    true -> {
                        has_foreign: boolean <- program_has_foreign_binding_loop(program.declarations);
                        case has_foreign of {
                            true -> case is_dangerous_module_name(module_name) of {
                                false -> {
                                    floc: { file: string, line: int64, column: int64, offset: int64 } <- first_foreign_binding_location_loop(program.declarations);
                                    (1, "E4020", floc, "Modules that declare or expose foreign functions must use the dangerous_ prefix.", "sect3.1")
                                };
                                true -> {
                                    has_wm: boolean <- program_has_wrapper_meta_loop(program.declarations);
                                    case has_wm of {
                                        true -> (0, "", parser_ast@zero_location(), "", "");
                                        false -> case all_foreign_bindings_have_meta_loop(program.declarations) of {
                                            true -> (0, "", parser_ast@zero_location(), "", "");
                                            false -> {
                                                mloc: { file: string, line: int64, column: int64, offset: int64 } <- first_foreign_binding_location_loop(program.declarations);
                                                (1, "E4023", mloc, "A module that declares foreign c_wrapper bindings must declare wrapper_meta paths or a meta path on each foreign binding.", "sect3.2")
                                            }
                                        }
                                    }
                                }
                            };
                            false -> (0, "", parser_ast@zero_location(), "", "")
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

fn validate_ffi_module_rules(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, module_name: string) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    (ffi_st: int64, ffi_ec: string, ffi_loc: { file: string, line: int64, column: int64, offset: int64 }, ffi_msg: string, ffi_spec: string) <- validate_ffi_metadata_and_naming(program, module_name);
    case ffi_st == 0 of {
        false -> (ffi_st, ffi_ec, ffi_loc, ffi_msg, ffi_spec);
        true -> {
            (dep_st: int64, dep_ec: string, dep_loc: { file: string, line: int64, column: int64, offset: int64 }, dep_msg: string, dep_spec: string) <- case is_dangerous_module_name(module_name) of {
                false -> validate_use_dangerous_dependency_declarations_loop(program.declarations);
                true -> (0, "", parser_ast@zero_location(), "", "")
            };
            case dep_st == 0 of {
                false -> (dep_st, dep_ec, dep_loc, dep_msg, dep_spec);
                true -> validate_dangerous_spawn_surface_rules(program, module_name)
            }
        }
    }
}

fn foreign_binding_matches_export_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string, arity: int64) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 9 of {
            true -> case decls.head.name == fn_name of {
                true -> case list_param_length_ffi(decls.head.parameters) == arity of {
                    true -> true;
                    false -> foreign_binding_matches_export_loop(decls.tail, fn_name, arity)
                };
                false -> foreign_binding_matches_export_loop(decls.tail, fn_name, arity)
            };
            false -> foreign_binding_matches_export_loop(decls.tail, fn_name, arity)
        }
    }
}

fn tag0_decl_matches_export_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string, arity: int64) -> (boolean, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 0 of {
            true -> case decls.head.name == fn_name of {
                true -> case list_param_length_ffi(decls.head.parameters) == arity of {
                    true -> (true, decls.head);
                    false -> tag0_decl_matches_export_loop(decls.tail, fn_name, arity)
                };
                false -> tag0_decl_matches_export_loop(decls.tail, fn_name, arity)
            };
            false -> tag0_decl_matches_export_loop(decls.tail, fn_name, arity)
        }
    }
}

fn decl_has_silica_body(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> boolean {
    case decl.tag == 0 of {
        false -> false;
        true -> case decl.body.root < 0 of {
            true -> false;
            false -> {
                body_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(decl.body);
                body_node.kind >= 0
            }
        }
    }
}

fn validate_export_item_ffi(unit_decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string, arity: int64, export_loc: { file: string, line: int64, column: int64, offset: int64 }, module_name: string) -> (int64, string, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    case foreign_binding_matches_export_loop(unit_decls, fn_name, arity) of {
        true -> (1, "E4022", export_loc, "raw foreign c_wrapper bindings must not be exported to application code (spec 3.3)", "sect3.3");
        false -> case is_dangerous_module_name(module_name) of {
            false -> (0, "", parser_ast@zero_location(), "", "");
            true -> {
                (found: boolean, fn_decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- tag0_decl_matches_export_loop(unit_decls, fn_name, arity);
                case found of {
                    false -> (0, "", parser_ast@zero_location(), "", "");
                    true -> case decl_has_silica_body(fn_decl) of {
                        false -> (1, "E4025", export_loc, "exported function from a dangerous_* module must be a Silica adapter wrapper with a body (spec 3.3)", "sect3.3");
                        true -> (0, "", parser_ast@zero_location(), "", "")
                    }
                }
            }
        }
    }
}
