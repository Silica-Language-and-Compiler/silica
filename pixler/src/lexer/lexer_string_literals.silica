// String and character literal parsing for Silica lexer
// Supports string literals with Unicode and escape sequences: \\, \', \", \n, \t, \r, \e, \xNN
// Per language spec §2.2: string_literal ::= "\"" {character | escape_sequence} "\""
// Character literals use same escape sequences per character_literal grammar
// UTF-8: the source is read one character at a time (substring is character-indexed);
// each character inside a literal is checked with lexer_core@utf8_char_is_valid.

// Import token kind
use lexer_token_kind;

// Import lexer core types
use lexer_core;
use lexer_integer_literals;

// Export entry points
export read_string_literal/1;
export read_char_literal/1;


fn is_simple_string_escape(next: string) -> boolean {
    case next of {
        "n" -> true;
        "t" -> true;
        "r" -> true;
        "e" -> true;
        "\\" -> true;
        "\"" -> true;
        "'" -> true;
        _: string -> false
    }
}

// { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } positioned at 'x' (char after '\\' in \\xNN). Validates the two hex digits after x.
fn is_valid_hex_escape_at(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> boolean {
    hi: string <- lexer_core@peek_next_char(lexer);
    lo: string <- substring(lexer.source, lexer.position + 2, lexer.position + 3);
    case lexer_integer_literals@is_hex_digit_char(hi) of {
        false -> false;
        true -> lexer_integer_literals@is_hex_digit_char(lo)
    }
}

// Advance past a validated escape sequence (lexer positioned at char after '\\').
fn advance_past_string_escape(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, boolean) {
    next: string <- lexer_core@peek_char(lexer);
    case next of {
        "x" -> case is_valid_hex_escape_at(lexer) of {
            false -> (lexer, false);
            true -> (lexer_core@advance_by(lexer, 3), true)
        };
        _: string -> case is_simple_string_escape(next) of {
            false -> (lexer, false);
            true -> (lexer_core@advance(lexer), true)
        }
    }
}


{-
- Reads a string literal from the current lexer position. Expects opening "\"" already seen.
- Advances past the opening quote, then consumes characters and escape sequences until closing "\"".
- Escape sequences: \\ (backslash), \' (single quote), \" (double quote), \n (newline), \t (tab), \r (carriage return).
- String content may include Unicode characters (UTF-8). Lexeme is the raw source text including quotes.
- Example: lexer at "\"" of "\"hello\"" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } string_literal "\"hello\"", lexer past closing quote).
- Example: lexer at "\"" of "\"hi\\nthere\"" — consumes \n as escape, returns token with lexeme "\"hi\\nthere\"".
- Time: O(k), Ω(1), Θ(k) where k is string length. Space: O(k), Ω(1), Θ(k).
- Last-date-modified: 2025-02-27
-}
fn read_string_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    sequence
        start_location: { file: string, line: int64, column: int64, offset: int64 } <- lexer_core@current_location(lexer);
        start_pos: int64 <- lexer.position;
        after_open: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
        (final_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, status: int64) <- read_string_content(after_open);
        result: ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- case status of {
            0 -> {
                lexeme: string <- lexer_core@extract_lexeme(final_lexer, start_pos);
                token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_string_literal(), lexeme, start_location);
                (token, final_lexer)
            };
            _: int64 -> (literal_error_token(status, "string", start_location, final_lexer), final_lexer)
        }
    produces
        pure result
    end
}

// The lexical error for a string or character literal whose reader stopped
// with `status` (1 end of file, 2 bad escape at `at`, 3 ill-formed UTF-8 at
// `at`, 4 character literal not closed after its character, 5 empty
// character literal).
fn literal_error_token(status: int64, what: string, start_location: { file: string, line: int64, column: int64, offset: int64 }, at: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    case status of {
        1 -> lexer_core@lexical_error_token(unterminated_literal_code(what), unterminated_literal_message(what), start_location);
        2 -> lexer_core@lexical_error_token("E0002", "invalid escape sequence: after '\\' a string or character literal allows only n, t, r, e, \\, ', \" or x followed by two hex digits (spec 2.2.3)", lexer_core@current_location(at));
        3 -> lexer_core@lexical_error_token("E0007", "invalid UTF-8: the source file must be UTF-8 encoded (spec 2.1), and the bytes here do not form a UTF-8 character", lexer_core@current_location(at));
        4 -> lexer_core@lexical_error_token("E0004", "unterminated character literal: a character literal holds exactly one character, and no closing \"'\" follows it", start_location);
        _: int64 -> lexer_core@lexical_error_token("E0004", "empty character literal: a character literal holds exactly one character", start_location)
    }
}

// E0003 for a string literal, E0004 for a character literal.
fn unterminated_literal_code(what: string) -> string {
    case what of {
        "string" -> "E0003";
        _: string -> "E0004"
    }
}

fn unterminated_literal_message(what: string) -> string {
    case what of {
        "string" -> "unterminated string literal: this '\"' has no closing '\"' before the end of the file";
        _: string -> "unterminated character literal: this \"'\" has no closing \"'\" before the end of the file"
    }
}

{-
- Reads string content up to and including the closing quote. Returns the lexer
- after the closing quote with status 0; or status 1 at the end of the source,
- 2 with the lexer at a backslash that starts no valid escape, 3 with the lexer
- at an ill-formed UTF-8 character.
-}
fn read_string_content(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, int64) {
    sequence
        current: string <- lexer_core@peek_char(lexer);
        result: ({ source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, int64) <- case current of {
            "" -> (lexer, 1);
            "\"" -> (lexer_core@advance(lexer), 0);
            "\\" -> {
                after_backslash: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                (after_escape: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, ok_escape: boolean) <- advance_past_string_escape(after_backslash);
                case ok_escape of {
                    true -> read_string_content(after_escape);
                    false -> case lexer_core@peek_char(after_backslash) == "" of {
                        true -> (after_backslash, 1);
                        false -> (lexer, 2)
                    }
                }
            };
            _: string -> case lexer_core@utf8_char_is_valid(current) of {
                true -> read_string_content(lexer_core@advance(lexer));
                false -> (lexer, 3)
            }
        }
    produces
        pure result
    end
}

fn read_char_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    sequence
        start_location: { file: string, line: int64, column: int64, offset: int64 } <- lexer_core@current_location(lexer);
        start_pos: int64 <- lexer.position;
        after_open: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
        (after_body: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, status: int64) <- read_char_body(after_open);
        result: ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- case status of {
            0 -> {
                lexeme: string <- lexer_core@extract_lexeme(after_body, start_pos);
                (lexer_core@make_token(lexer_token_kind@token_kind_char_literal(), lexeme, start_location), after_body)
            };
            _: int64 -> (literal_error_token(status, "character", start_location, after_body), after_body)
        }
    produces
        pure result
    end
}

// Reads one character (or escape) and the closing quote; statuses as in
// literal_error_token, 0 with the lexer after the closing quote.
fn read_char_body(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, int64) {
    sequence
        current: string <- lexer_core@peek_char(lexer);
        result: ({ source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, int64) <- case current of {
            "" -> (lexer, 1);
            "'" -> (lexer, 5);
            "\\" -> {
                after_backslash: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                (after_escape: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, ok_escape: boolean) <- advance_past_string_escape(after_backslash);
                case ok_escape of {
                    true -> char_closing_quote(after_escape);
                    false -> case lexer_core@peek_char(after_backslash) == "" of {
                        true -> (after_backslash, 1);
                        false -> (lexer, 2)
                    }
                }
            };
            _: string -> case lexer_core@utf8_char_is_valid(current) of {
                true -> char_closing_quote(lexer_core@advance(lexer));
                false -> (lexer, 3)
            }
        }
    produces
        pure result
    end
}

fn char_closing_quote(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, int64) {
    closing: string <- lexer_core@peek_char(lexer);
    case closing of {
        "'" -> (lexer_core@advance(lexer), 0);
        "" -> (lexer, 1);
        _: string -> (lexer, 4)
    }
}
