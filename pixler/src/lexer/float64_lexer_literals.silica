// Float64 literal parsing for Silica lexer
// Delegates to lexer_float_literals (shared with float32); float64 and float32 use the same literal grammar.

use lexer_core;
use lexer_float_literals;

// Export entry points (delegate to shared module)
export read_numeric_literal/1;
export read_negative_numeric_literal/2;


{-
- Reads one numeric literal (integer or float64) from the current lexer position. Delegates to lexer_float_literals.
- Last-date-modified: 2025-02-27
-}
fn read_numeric_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    lexer_float_literals@read_numeric_literal(lexer)
}

{-
- Reads a negative numeric literal. Delegates to lexer_float_literals.
- Last-date-modified: 2025-02-27
-}
fn read_negative_numeric_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    lexer_float_literals@read_negative_numeric_literal(lexer, start_location)
}
