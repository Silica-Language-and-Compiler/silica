// Kahn topo-sort of config units from parsed `use` edges.

use module_checker_core;
use main_lists;
use main_world;

export topological_sort_from_parsed/2;
export join_paths_arrow/1;

// Edge: dependent must compile after prerequisite (both are config file paths).
// Per-unit node for Kahn's algorithm (in-degree = unmet prerequisites in config).

fn nil_dep_edge_list() -> List[{ dependent: string, prerequisite: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ dependent: string, prerequisite: string }, mem(normal)] <- empty[{ dependent: string, prerequisite: string }, mem(normal)]()
    produces
        pure result
    end
}

fn cons_dep_edge(edge: { dependent: string, prerequisite: string }, tail: List[{ dependent: string, prerequisite: string }, mem(normal)]) -> List[{ dependent: string, prerequisite: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ dependent: string, prerequisite: string }, mem(normal)] <- prepend[{ dependent: string, prerequisite: string }, mem(normal)](edge, tail)
    produces
        pure result
    end
}

fn nil_compile_unit_deps_list() -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ path: string, in_degree: int64 }, mem(normal)] <- empty[{ path: string, in_degree: int64 }, mem(normal)]()
    produces
        pure result
    end
}

fn cons_compile_unit_deps(entry: { path: string, in_degree: int64 }, tail: List[{ path: string, in_degree: int64 }, mem(normal)]) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ path: string, in_degree: int64 }, mem(normal)] <- prepend[{ path: string, in_degree: int64 }, mem(normal)](entry, tail)
    produces
        pure result
    end
}

fn reverse_compile_unit_deps_list(lst: List[{ path: string, in_degree: int64 }, mem(normal)], acc: List[{ path: string, in_degree: int64 }, mem(normal)]) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    case lst.is_nil of {
        true -> acc;
        false -> reverse_compile_unit_deps_list(lst.tail, cons_compile_unit_deps(lst.head, acc))
    }
}

fn cons_dep_edges_for_paths(dependent: string, prereq_paths: List[string, mem(normal)], acc: List[{ dependent: string, prerequisite: string }, mem(normal)]) -> List[{ dependent: string, prerequisite: string }, mem(normal)] {
    case prereq_paths.is_nil of {
        true -> acc;
        false -> cons_dep_edges_for_paths(dependent, prereq_paths.tail, cons_dep_edge({ dependent: dependent, prerequisite: prereq_paths.head }, acc))
    }
}

fn build_dep_edges_rev(remaining: List[string, mem(normal)], all_files: List[string, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], acc: List[{ dependent: string, prerequisite: string }, mem(normal)]) -> List[{ dependent: string, prerequisite: string }, mem(normal)] {
    case remaining.is_nil of {
        true -> acc;
        false -> {
            dep_paths: List[string, mem(normal)] <- main_world@dep_paths_for_parsed_file(remaining.head, parsed, all_files);
            with_edges: List[{ dependent: string, prerequisite: string }, mem(normal)] <- cons_dep_edges_for_paths(remaining.head, dep_paths, acc);
            build_dep_edges_rev(remaining.tail, all_files, parsed, with_edges)
        }
    }
}

fn count_incoming_edges_for_path(edges: List[{ dependent: string, prerequisite: string }, mem(normal)], path: string) -> int64 {
    case edges.is_nil of {
        true -> 0;
        false -> case edges.head.dependent == path of {
            true -> 1 + count_incoming_edges_for_path(edges.tail, path);
            false -> count_incoming_edges_for_path(edges.tail, path)
        }
    }
}

fn build_compile_units_rev(config_files: List[string, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)], acc: List[{ path: string, in_degree: int64 }, mem(normal)]) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    case config_files.is_nil of {
        true -> acc;
        false -> {
            in_deg: int64 <- count_incoming_edges_for_path(edges, config_files.head);
            entry: { path: string, in_degree: int64 } <- { path: config_files.head, in_degree: in_deg };
            build_compile_units_rev(config_files.tail, edges, cons_compile_unit_deps(entry, acc))
        }
    }
}

fn has_edge_from_to(edges: List[{ dependent: string, prerequisite: string }, mem(normal)], dependent: string, prerequisite: string) -> boolean {
    case edges.is_nil of {
        true -> false;
        false -> case edges.head.dependent == dependent and edges.head.prerequisite == prerequisite of {
            true -> true;
            false -> has_edge_from_to(edges.tail, dependent, prerequisite)
        }
    }
}

fn remove_unit_from_dep_graph(graph: List[{ path: string, in_degree: int64 }, mem(normal)], path: string) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    case graph.is_nil of {
        true -> nil_compile_unit_deps_list();
        false -> case graph.head.path == path of {
            true -> graph.tail;
            false -> cons_compile_unit_deps(graph.head, remove_unit_from_dep_graph(graph.tail, path))
        }
    }
}

fn decrement_in_degrees_for_emit(graph: List[{ path: string, in_degree: int64 }, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)], emitted_path: string) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    case graph.is_nil of {
        true -> nil_compile_unit_deps_list();
        false -> {
            new_in_degree: int64 <- case has_edge_from_to(edges, graph.head.path, emitted_path) of {
                true -> graph.head.in_degree - 1;
                false -> graph.head.in_degree
            };
            updated: { path: string, in_degree: int64 } <- { path: graph.head.path, in_degree: new_in_degree };
            cons_compile_unit_deps(updated, decrement_in_degrees_for_emit(graph.tail, edges, emitted_path))
        }
    }
}

fn take_first_zero_in_degree(graph: List[{ path: string, in_degree: int64 }, mem(normal)]) -> (string, List[{ path: string, in_degree: int64 }, mem(normal)]) {
    take_first_zero_in_degree_impl(graph, graph)
}

fn take_first_zero_in_degree_impl(scan: List[{ path: string, in_degree: int64 }, mem(normal)], full_graph: List[{ path: string, in_degree: int64 }, mem(normal)]) -> (string, List[{ path: string, in_degree: int64 }, mem(normal)]) {
    case scan.is_nil of {
        true -> ("", full_graph);
        false -> case scan.head.in_degree == 0 of {
            true -> {
                rest: List[{ path: string, in_degree: int64 }, mem(normal)] <- remove_unit_from_dep_graph(full_graph, scan.head.path);
                (scan.head.path, rest)
            };
            false -> take_first_zero_in_degree_impl(scan.tail, full_graph)
        }
    }
}

fn remaining_unit_paths_acc(graph: List[{ path: string, in_degree: int64 }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case graph.is_nil of {
        true -> acc;
        false -> {
            next_acc: List[string, mem(normal)] <- module_checker_core@cons_string(graph.head.path, acc);
            remaining_unit_paths_acc(graph.tail, next_acc)
        }
    }
}

fn remaining_unit_paths(graph: List[{ path: string, in_degree: int64 }, mem(normal)]) -> List[string, mem(normal)] {
    main_lists@reverse_list_string(remaining_unit_paths_acc(graph, module_checker_core@empty_list_string()))
}

// Kahn's algorithm: O(V+E) over config files using AST-derived deps (no per-probe disk reads).
fn kahn_topological_sort(graph: List[{ path: string, in_degree: int64 }, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)], result_rev: List[string, mem(normal)]) -> (boolean, List[string, mem(normal)]) {
    case graph.is_nil of {
        true -> (true, main_lists@reverse_list_string(result_rev));
        false -> {
            (ready_path: string, rest_graph: List[{ path: string, in_degree: int64 }, mem(normal)]) <- take_first_zero_in_degree(graph);
            case length_bytes(ready_path) == 0 of {
                true -> (false, remaining_unit_paths(graph));
                false -> {
                    updated: List[{ path: string, in_degree: int64 }, mem(normal)] <- decrement_in_degrees_for_emit(rest_graph, edges, ready_path);
                    kahn_topological_sort(updated, edges, module_checker_core@cons_string(ready_path, result_rev))
                }
            }
        }
    }
}

fn join_paths_arrow(paths: List[string, mem(normal)]) -> string {
    case paths.is_nil of {
        true -> "";
        false -> case paths.tail.is_nil of {
            true -> paths.head;
            false -> concat(concat(paths.head, " -> "), join_paths_arrow(paths.tail))
        }
    }
}

fn cycle_suffix_newest_first(path: List[string, mem(normal)], next: string) -> List[string, mem(normal)] {
    case path.is_nil of {
        true -> module_checker_core@empty_list_string();
        false -> case path.head == next of {
            true -> module_checker_core@cons_string(path.head, module_checker_core@empty_list_string());
            false -> module_checker_core@cons_string(path.head, cycle_suffix_newest_first(path.tail, next))
        }
    }
}

fn cycle_close(path: List[string, mem(normal)], next: string) -> List[string, mem(normal)] {
    suffix: List[string, mem(normal)] <- cycle_suffix_newest_first(path, next);
    main_lists@reverse_list_string(module_checker_core@cons_string(next, suffix))
}

fn first_prereq_in_remaining(dependent: string, edges: List[{ dependent: string, prerequisite: string }, mem(normal)], remaining: List[string, mem(normal)]) -> string {
    case edges.is_nil of {
        true -> "";
        false -> case edges.head.dependent == dependent of {
            true -> case edges.head.prerequisite == dependent of {
                true -> first_prereq_in_remaining(dependent, edges.tail, remaining);
                false -> case main_lists@list_contains(remaining, edges.head.prerequisite) of {
                    true -> edges.head.prerequisite;
                    false -> first_prereq_in_remaining(dependent, edges.tail, remaining)
                }
            };
            false -> first_prereq_in_remaining(dependent, edges.tail, remaining)
        }
    }
}

fn find_kahn_cycle_walk(current: string, path: List[string, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)], remaining: List[string, mem(normal)]) -> List[string, mem(normal)] {
    next: string <- first_prereq_in_remaining(current, edges, remaining);
    case length_bytes(next) == 0 of {
        true -> module_checker_core@empty_list_string();
        false -> case main_lists@list_contains(path, next) of {
            true -> cycle_close(path, next);
            false -> find_kahn_cycle_walk(next, module_checker_core@cons_string(next, path), edges, remaining)
        }
    }
}

fn first_kahn_cycle(remaining: List[string, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)]) -> List[string, mem(normal)] {
    case remaining.is_nil of {
        true -> module_checker_core@empty_list_string();
        false -> {
            start: string <- remaining.head;
            walked: List[string, mem(normal)] <- find_kahn_cycle_walk(start, module_checker_core@cons_string(start, module_checker_core@empty_list_string()), edges, remaining);
            case walked.is_nil of {
                false -> walked;
                true -> first_kahn_cycle(remaining.tail, edges)
            }
        }
    }
}

fn direct_use_paths_for_file(path: string, parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], all_files: List[string, mem(normal)]) -> List[string, mem(normal)] {
    (found: boolean, prog: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- module_checker_core@find_program_in_parsed(parsed, path);
    case found of {
        true -> main_world@resolve_deps_to_paths(main_world@extract_use_modules_from_program(prog), all_files, module_checker_core@empty_list_string());
        false -> module_checker_core@empty_list_string()
    }
}

fn dfs_use_cycle(current: string, stack: List[string, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], all_files: List[string, mem(normal)]) -> List[string, mem(normal)] {
    uses: List[string, mem(normal)] <- direct_use_paths_for_file(current, parsed, all_files);
    dfs_use_cycle_edges(uses, current, stack, parsed, all_files)
}

fn dfs_use_cycle_edges(uses: List[string, mem(normal)], current: string, stack: List[string, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], all_files: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case uses.is_nil of {
        true -> module_checker_core@empty_list_string();
        false -> case main_lists@list_contains(stack, uses.head) of {
            true -> cycle_close(stack, uses.head);
            false -> {
                next_stack: List[string, mem(normal)] <- module_checker_core@cons_string(uses.head, stack);
                deeper: List[string, mem(normal)] <- dfs_use_cycle(uses.head, next_stack, parsed, all_files);
                case deeper.is_nil of {
                    false -> deeper;
                    true -> dfs_use_cycle_edges(uses.tail, current, stack, parsed, all_files)
                }
            }
        }
    }
}

fn first_direct_use_cycle(scan: List[string, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], all_files: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case scan.is_nil of {
        true -> module_checker_core@empty_list_string();
        false -> {
            start: string <- scan.head;
            found: List[string, mem(normal)] <- dfs_use_cycle(start, module_checker_core@cons_string(start, module_checker_core@empty_list_string()), parsed, all_files);
            case found.is_nil of {
                false -> found;
                true -> first_direct_use_cycle(scan.tail, parsed, all_files)
            }
        }
    }
}

fn cycle_paths_for_error(remaining: List[string, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], all_files: List[string, mem(normal)]) -> List[string, mem(normal)] {
    direct: List[string, mem(normal)] <- first_direct_use_cycle(all_files, parsed, all_files);
    case direct.is_nil of {
        false -> direct;
        true -> {
            kahn_c: List[string, mem(normal)] <- first_kahn_cycle(remaining, edges);
            case kahn_c.is_nil of {
                false -> kahn_c;
                true -> remaining
            }
        }
    }
}

fn topological_sort_from_parsed(config_files: List[string, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> (boolean, List[string, mem(normal)]) {
    sequence
        edges_rev: List[{ dependent: string, prerequisite: string }, mem(normal)] <- build_dep_edges_rev(config_files, config_files, parsed, nil_dep_edge_list());
        units_rev: List[{ path: string, in_degree: int64 }, mem(normal)] <- build_compile_units_rev(config_files, edges_rev, nil_compile_unit_deps_list());
        units: List[{ path: string, in_degree: int64 }, mem(normal)] <- reverse_compile_unit_deps_list(units_rev, nil_compile_unit_deps_list());
        (ok: boolean, paths: List[string, mem(normal)]) <- kahn_topological_sort(units, edges_rev, module_checker_core@empty_list_string());
        result: (boolean, List[string, mem(normal)]) <- case ok of {
            true -> (true, paths);
            false -> (false, cycle_paths_for_error(paths, edges_rev, parsed, config_files))
        }
    produces
        pure result
    end
}
