// Trait-site argument walk. Split from resolve so seed can type-check it alone.

use parser_ast;
use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_collections;
use type_checker_traits;
use type_checker_expressions_user_call_resolve_fit;

export infer_trait_site_call_args_walk/7;
export trait_arg_walk_state/3;

// A numeric literal has no type of its own: through a qualified call it takes the formal's, as it does
// in a same-module call, and check_user_call_args_recursive then checks it against that formal
// (E2011 out of range, E2001 float literal for an integer formal).
fn numeric_literal_surface(inferred: string) -> boolean {
    case inferred of {
        "int64" -> true;
        "float16" -> true;
        "float32" -> true;
        "float64" -> true;
        _: string -> false
    }
}

fn numeric_formal_surface(formal: string) -> boolean {
    case formal of {
        "int8" -> true;
        "int16" -> true;
        "int32" -> true;
        "int64" -> true;
        "uint8" -> true;
        "uint16" -> true;
        "uint32" -> true;
        "uint64" -> true;
        "float16" -> true;
        "float32" -> true;
        "float64" -> true;
        _: string -> false
    }
}

fn resolve_site_bucket_type_for_param(is_lit: boolean, inferred: string, formal_ty: string, callee_mod: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, loc: { file: string, line: int64, column: int64, offset: int64 }, call_name: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, string) {
    case type_checker_expressions_user_call_resolve_fit@call_site_actual_matches_formal(inferred, formal_ty, world) of {
        true -> (type_checker_core@type_check_ok(), type_checker_expressions_user_call_resolve_fit@trait_concrete_for_call_site(is_lit and inferred == "int64", inferred, formal_ty, world));
        false -> case is_lit and numeric_literal_surface(inferred) and numeric_formal_surface(type_checker_traits@trim_type_text(formal_ty)) of {
            true -> (type_checker_core@type_check_ok(), type_checker_traits@trim_type_text(formal_ty));
            false -> {
                ft: string <- type_checker_traits@trim_type_text(formal_ty);
                (is_trait: boolean, _: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- type_checker_traits@find_program_declaring_trait(world, ft);
                case is_trait of {
                    false -> (type_checker_core@type_check_err("E2003", loc, concat(concat(concat(concat(concat("argument type ", inferred), " does not match parameter type "), formal_ty), " for "), call_name), "sect6"), "");
                    true -> {
                        (st: int64, conc: string) <- type_checker_expressions_user_call_resolve_fit@infer_trait_dispatch_concrete_from_impls_status(callee_mod, ft, inferred, world);
                        case st == 1 of {
                            true -> (type_checker_core@type_check_ok(), conc);
                            false -> case st == 2 of {
                                true -> (type_checker_core@type_check_err("E2003", loc, concat("ambiguous trait dispatch: multiple implementation parameter types match this argument for ", call_name), "sect6"), "");
                                false -> (type_checker_core@type_check_err("E2003", loc, concat("no concrete trait implementation matches this argument for ", call_name), "sect6"), "")
                            }
                        }
                    }
                }
            }
        }
    }
}

fn trait_arg_walk_state(collection_ctx: string, record_ctx: string, param_index: int64) -> { collection_ctx: string, record_ctx: string, param_index: int64 } {
    out: { collection_ctx: string, record_ctx: string, param_index: int64 } <- { collection_ctx: collection_ctx, record_ctx: record_ctx, param_index: param_index };
    out
}

fn infer_trait_site_call_args_walk(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, params_lr: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, callee_mod: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, st: { collection_ctx: string, record_ctx: string, param_index: int64 }) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == -1 of {
        true -> case params_lr.is_nil of {
            true -> (type_checker_core@type_check_ok(), parser_ast@nil_list_param());
            false -> (type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(concat(type_checker_expressions_helpers@expr_name(call_expr), ": too few arguments for callee"), " (spec 6)"), "sect6"), parser_ast@nil_list_param())
        };
        false -> case params_lr.is_nil of {
            true -> (type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6"), parser_ast@nil_list_param());
            false -> {
                inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
                case length_bytes(inferred) == 0 of {
                    true -> (type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(type_checker_expressions_helpers@expr_child_inner(expr)), "cannot infer concrete type for qualified call argument (needed to resolve trait-parameter body)", "sect6"), parser_ast@nil_list_param());
                    false -> {
                        formal_ty: string <- type_checker_collections@resolve_trait_formal_with_contexts(params_lr.head.type_name, st.collection_ctx, st.record_ctx, st.param_index);
                        case length_bytes(formal_ty) == 0 and type_checker_collections@is_assoc_type_placeholder(params_lr.head.type_name) of {
                            true -> (type_checker_core@type_check_err("E2017", type_checker_expressions_helpers@expr_loc(type_checker_expressions_helpers@expr_child_inner(expr)), concat(concat(concat("cannot resolve assoc type placeholder ", params_lr.head.type_name), " without collection declaration context for "), type_checker_expressions_helpers@expr_name(call_expr)), "sect4"), parser_ast@nil_list_param());
                            false -> {
                                (res_ty: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, bucket_ty: string) <- resolve_site_bucket_type_for_param(type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == 0, inferred, formal_ty, callee_mod, type_checker_expressions_helpers@expr_loc(type_checker_expressions_helpers@expr_child_inner(expr)), type_checker_expressions_helpers@expr_name(call_expr), world);
                                case res_ty.is_ok of {
                                    false -> (res_ty, parser_ast@nil_list_param());
                                    true -> {
                                        next_ctx: string <- type_checker_collections@infer_collection_decl_from_receiver(inferred, type_checker_expressions_helpers@expr_child_inner(expr), context.env);
                                        ctx_after: string <- case length_bytes(next_ctx) > 0 of {
                                            true -> next_ctx;
                                            false -> case length_bytes(st.collection_ctx) > 0 of { true -> st.collection_ctx; false -> "" }
                                        };
                                        rec_after: string <- case st.param_index == 0 of {
                                            true -> bucket_ty;
                                            false -> st.record_ctx
                                        };
                                        case params_lr.tail.is_nil of {
                                            true -> {
                                                extra: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == -1 of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6")
                                                };
                                                case extra.is_ok of {
                                                    false -> (extra, parser_ast@nil_list_param());
                                                    true -> (type_checker_core@type_check_ok(), parser_ast@build_infer_type_bucket(bucket_ty, parser_ast@nil_list_param()))
                                                }
                                            };
                                            false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 of {
                                                true -> {
                                                    (rest_ok: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, rest_inf: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- infer_trait_site_call_args_walk(type_checker_expressions_helpers@expr_child_right(expr), params_lr.tail, context, world, call_expr, callee_mod, trait_arg_walk_state(ctx_after, rec_after, st.param_index + 1));
                                                    case rest_ok.is_ok of {
                                                        false -> (rest_ok, parser_ast@nil_list_param());
                                                        true -> (type_checker_core@type_check_ok(), parser_ast@build_infer_type_bucket(bucket_ty, rest_inf))
                                                    }
                                                };
                                                false -> {
                                                    (one_ok: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, one_tail: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- infer_one_flat_second_arg(type_checker_expressions_helpers@expr_child_right(expr), params_lr.tail, context, world, call_expr, callee_mod, trait_arg_walk_state(ctx_after, rec_after, st.param_index + 1));
                                                    case one_ok.is_ok of {
                                                        false -> (one_ok, parser_ast@nil_list_param());
                                                        true -> (type_checker_core@type_check_ok(), parser_ast@build_infer_type_bucket(bucket_ty, one_tail))
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn infer_one_flat_second_arg(second_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, params_tail: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64,