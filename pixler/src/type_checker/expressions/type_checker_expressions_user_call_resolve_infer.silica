    case params_tail.is_nil of {
        true -> (type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6"), parser_ast@nil_list_param());
        false -> case params_tail.tail.is_nil of {
            false -> (type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6"), parser_ast@nil_list_param());
            true -> {
                inf2: string <- type_checker_tuple_decompose_helpers@infer_expr_type(second_e, context);
                case length_bytes(inf2) == 0 of {
                    true -> (type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(second_e), "cannot infer concrete type for qualified call argument (needed to resolve trait-parameter body)", "sect6"), parser_ast@nil_list_param());
                    false -> {
                        formal_ty: string <- type_checker_collections@resolve_trait_formal_with_contexts(params_tail.head.type_name, st.collection_ctx, st.record_ctx, st.param_index);
                        case length_bytes(formal_ty) == 0 and type_checker_collections@is_assoc_type_placeholder(params_tail.head.type_name) of {
                            true -> (type_checker_core@type_check_err("E2017", type_checker_expressions_helpers@expr_loc(second_e), concat(concat(concat("cannot resolve assoc type placeholder ", params_tail.head.type_name), " without collection declaration context for "), type_checker_expressions_helpers@expr_name(call_expr)), "sect4"), parser_ast@nil_list_param());
                            false -> {
                                (res2: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, bucket2: string) <- resolve_site_bucket_type_for_param(type_checker_expressions_helpers@expr_kind(second_e) == 0, inf2, formal_ty, callee_mod, type_checker_expressions_helpers@expr_loc(second_e), type_checker_expressions_helpers@expr_name(call_expr), world);
                                case res2.is_ok of {
                                    false -> (res2, parser_ast@nil_list_param());
                                    true -> (type_checker_core@type_check_ok(), parser_ast@build_infer_type_bucket(bucket2, parser_ast@nil_list_param()))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

