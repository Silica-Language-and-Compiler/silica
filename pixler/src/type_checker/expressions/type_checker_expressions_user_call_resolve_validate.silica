// Call-site return-record validation. Tiny leaf so check_defined_body
// does not load the fat resolve interface.

use type_checker_core;
use type_checker_record_types;

export validate_callsite_return_record_type/2;

fn validate_callsite_return_record_type(rt: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_record_types@record_type_starts(rt) of {
        false -> type_checker_core@type_check_ok();
        true -> case type_checker_record_types@record_type_braces_balanced(rt) of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", loc, "malformed inline record type (unbalanced braces)", "sect3.4.2")
        }
    }
}

