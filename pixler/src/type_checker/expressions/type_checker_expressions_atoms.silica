// Capability: check atom literal expression (Expr kind 5)
// Verifies atom literal type matches expected return type.
// Accepts `atom` (any), `discard`, a single atom-literal type (`:name`), or an
// atom-literal union (`:a|:b|:c` — parser tokenizes with spaces; compare after
// stripping spaces). Atom unions are spec §3.3.6 / §15.4.13.2 (supervisor_flags
// strategy, child_spec restart).

use parser_ast;
use type_checker_core;
use type_checker_recursive_tuples;
use type_interner;

export check_expr/4;

fn strip_spaces_from_run_end(s: string, j: int64, n: int64) -> int64 {
    case j >= n of {
        true -> j;
        false -> case substring(s, j, j + 1) == " " of {
            true -> j;
            false -> strip_spaces_from_run_end(s, j + 1, n)
        }
    }
}

fn strip_spaces_from(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> case substring(s, i, i + 1) == " " of {
            true -> strip_spaces_from(s, i + 1, acc);
            false -> {
                n: int64 <- length_bytes(s);
                e: int64 <- strip_spaces_from_run_end(s, i, n);
                strip_spaces_from(s, e, concat(acc, substring(s, i, e)))
            }
        }
    }
}

fn strip_spaces_atom(s: string) -> string {
    strip_spaces_from(s, 0, "")
}

// Scan alternatives separated by `|` at top level (no nested delimiters in atom-only unions).
fn atom_union_contains_from(union_text: string, needle: string, start: int64) -> boolean {
    bar: int64 <- find_pipe_from(union_text, start);
    case bar < 0 of {
        true -> substring(union_text, start, length_bytes(union_text)) == needle;
        false -> case substring(union_text, start, bar) == needle of {
            true -> true;
            false -> atom_union_contains_from(union_text, needle, bar + 1)
        }
    }
}

fn find_pipe_from(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "|" of {
            true -> i;
            false -> find_pipe_from(s, i + 1)
        }
    }
}

fn normalize_atom_expected_type(context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, expected_type: int64) -> string {
    exp_ns: string <- strip_spaces_atom(type_checker_core@surface_for_type_id(context, expected_type));
    case length_bytes(exp_ns) >= 2 and substring(exp_ns, 0, 1) == "(" and substring(exp_ns, length_bytes(exp_ns) - 1, length_bytes(exp_ns)) == ")" of {
        false -> exp_ns;
        true -> {
            inner: string <- substring(exp_ns, 1, length_bytes(exp_ns) - 1);
            case length_bytes(inner) > 0 and substring(inner, 0, 1) == ":" of {
                true -> inner;
                false -> exp_ns
            }
        }
    }
}

// atom-literal-typed or atom-union-typed check (returns bool). The union may hold tagged-tuple options
// in any order, `(:found, uint32) | :none`; only an option that is exactly the atom matches.
fn atom_literal_matches_type(expr_value: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, expected_type: int64) -> boolean {
    exp_ns: string <- normalize_atom_expected_type(context, expected_type);
    case length_bytes(exp_ns) == 0 of {
        true -> false;
        false -> atom_union_contains_from(exp_ns, expr_value, 0)
    }
}

// Check Expr kind 5 (atom literal). `expr.value` holds the atom lexeme (e.g. ":ok").
// Expected type: `atom` (any), `discard` (ignored), a single atom-literal type
// (`:name`), or an atom-literal union (`:a|:b|…` possibly with spaces).
fn check_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) {
    interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } <- context.interner;
    k: int64 <- type_interner@node_kind(interner, expected_type);
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    case k == type_interner@kind_atom() or k == type_interner@kind_discard() of {
        true -> (type_checker_core@type_check_ok(), context);
        false -> case atom_literal_matches_type(node.value, context, expected_type) of {
            true -> (type_checker_core@type_check_ok(), context);
            false -> {
                expect_surf: string <- type_checker_core@surface_for_type_id(context, expected_type);
                case type_checker_recursive_tuples@atom_fits_ref_optional_slot(node.value, expect_surf) of {
                    true -> (type_checker_core@type_check_ok(), context);
                    false -> (type_checker_core@type_check_err("E2001", node.location, concat("atom literal requires atom return type, got ", case length_bytes(expect_surf) == 0 of { true -> "[EMPTY]"; false -> expect_surf }), "sect6"), context)
                }
            }
        }
    }
}
