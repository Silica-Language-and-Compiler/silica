// Thin re-export of identifier surface matchers. Callers that only need
// fn_types_eq_i / ident_fallback_ok_i must not `use` identifiers: that leaf
// also exports check_expr/4, and loading it into the expression facade OOMs.

use type_checker_expressions_identifiers;

export fn_types_eq_i/2;
export ident_fallback_ok_i/2;

fn fn_types_eq_i(resolved: string, expected: string) -> int64 {
    type_checker_expressions_identifiers@fn_types_eq_i(resolved, expected)
}

fn ident_fallback_ok_i(resolved: string, expect: string) -> int64 {
    type_checker_expressions_identifiers@ident_fallback_ok_i(resolved, expect)
}
