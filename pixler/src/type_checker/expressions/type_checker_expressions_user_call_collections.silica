// Collection-trait let / constructor witness checking. Open-recursive via check callbacks.

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_recursive_tuples;
use type_checker_lists;
use type_checker_collections;
use type_checker_expressions_actors;
use type_checker_supervisor;
use type_checker_record_types;
use type_checker_traits;
use type_checker_callee_env;
use type_checker_expressions_identifiers;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use string_parse;
use instantiated_fn_name;
use type_checker_expressions_user_call_helpers;
use type_checker_expressions_user_call_resolve;
use type_checker_expressions_bindings;

export check_collection_trait_let/7;

fn is_collection_constructor_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    type_checker_collections@is_collection_constructor_base_name(type_checker_expressions_helpers@expr_name(expr))
}

fn constructor_functions_record_expr(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(rhs)) of {
        "empty" -> type_checker_expressions_helpers@expr_child_inner(rhs);
        "with_root" -> type_checker_expressions_helpers@expr_child_inner(rhs);
        _: string -> type_checker_expressions_helpers@call_second_arg_expr(rhs)
    }
}

fn verify_collection_witness_for_family(bind_type: string, record_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, location: { file: string, line: int64, column: int64, offset: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_collections@is_ordered_set_type(bind_type) of {
        true -> {
            wit_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
            set_wit: string <- case length_bytes(wit_from_arg) > 0 of {
                true -> wit_from_arg;
                false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world)
            };
            case length_bytes(set_wit) == 0 of {
                true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                false -> type_checker_collections@witness_matches_ordered_set_declaration(bind_type, set_wit, location)
            }
        };
        false -> case type_checker_collections@is_search_tree_type(bind_type) of {
            true -> {
                wit_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                set_wit: string <- case length_bytes(wit_from_arg) > 0 of { true -> wit_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                case length_bytes(set_wit) == 0 of {
                    true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                    false -> type_checker_collections@witness_matches_search_tree_declaration(bind_type, set_wit, location)
                }
            };
            false -> case type_checker_collections@is_tree_type(bind_type) of {
                true -> {
                    wit_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                    set_wit: string <- case length_bytes(wit_from_arg) > 0 of { true -> wit_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                    case length_bytes(set_wit) == 0 of {
                        true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                        false -> type_checker_collections@witness_matches_tree_declaration(bind_type, set_wit, location)
                    }
                };
                false -> case type_checker_collections@is_ordered_map_type(bind_type) of {
                    true -> {
                        key_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_key", context);
                        val_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_value", context);
                        key_wit: string <- case length_bytes(key_from_arg) > 0 of { true -> key_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_key", context, world) };
                        val_wit: string <- case length_bytes(val_from_arg) > 0 of { true -> val_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_value", context, world) };
                        case length_bytes(key_wit) == 0 or length_bytes(val_wit) == 0 of {
                            true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_key or compare_value witness", "sect4");
                            false -> type_checker_collections@witness_matches_ordered_map_declaration(bind_type, key_wit, val_wit, location)
                        }
                    };
                    false -> case type_checker_collections@is_heap_type(bind_type) of {
                        true -> {
                            item_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                            heap_wit: string <- case length_bytes(item_from_arg) > 0 of { true -> item_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                            case length_bytes(heap_wit) == 0 of {
                                true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                                false -> type_checker_collections@witness_matches_heap_declaration(bind_type, heap_wit, location)
                            }
                        };
                        false -> case type_checker_collections@is_priority_queue_type(bind_type) of {
                            true -> {
                                pri_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_priority", context);
                                item_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                                pri_wit: string <- case length_bytes(pri_from_arg) > 0 of { true -> pri_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_priority", context, world) };
                                item_wit: string <- case length_bytes(item_from_arg) > 0 of { true -> item_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                                case length_bytes(pri_wit) == 0 or length_bytes(item_wit) == 0 of {
                                    true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_priority or compare_item witness", "sect4");
                                    false -> type_checker_collections@witness_matches_priority_queue_declaration(bind_type, pri_wit, item_wit, location)
                                }
                            };
                            false -> case type_checker_collections@is_directed_graph_type(bind_type) of {
                                true -> {
                                    node_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_node", context);
                                    edge_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_edge", context);
                                    target_from_arg: string <- constructor_record_field_fn_type(record_e, "edge_target", context);
                                    node_wit: string <- case length_bytes(node_from_arg) > 0 of { true -> node_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_node", context, world) };
                                    edge_wit: string <- case length_bytes(edge_from_arg) > 0 of { true -> edge_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_edge", context, world) };
                                    target_wit: string <- case length_bytes(target_from_arg) > 0 of { true -> target_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "edge_target", context, world) };
                                    case length_bytes(node_wit) == 0 or length_bytes(edge_wit) == 0 or length_bytes(target_wit) == 0 of {
                                        true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_node, compare_edge, or edge_target witness", "sect4");
                                        false -> type_checker_collections@witness_matches_directed_graph_declaration(bind_type, node_wit, edge_wit, target_wit, location)
                                    }
                                };
                                false -> case type_checker_collections@is_undirected_graph_type(bind_type) of {
                                    true -> {
                                        node_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_node", context);
                                        edge_data_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_edge_data", context);
                                        node_wit: string <- case length_bytes(node_from_arg) > 0 of { true -> node_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_node", context, world) };
                                        edge_data_wit: string <- case length_bytes(edge_data_from_arg) > 0 of { true -> edge_data_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_edge_data", context, world) };
                                        case length_bytes(node_wit) == 0 or length_bytes(edge_data_wit) == 0 of {
                                            true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_node or compare_edge_data witness", "sect4");
                                            false -> type_checker_collections@witness_matches_undirected_graph_declaration(bind_type, node_wit, edge_data_wit, location)
                                        }
                                    };
                                    false -> case type_checker_collections@is_weighted_graph_type(bind_type) of {
                                        true -> {
                                            node_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_node", context);
                                            edge_data_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_edge_data", context);
                                            weight_from_arg: string <- constructor_record_field_fn_type(record_e, "edge_weight", context);
                                            cmp_weight_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_weight", context);
                                            node_wit: string <- case length_bytes(node_from_arg) > 0 of { true -> node_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_node", context, world) };
                                            edge_data_wit: string <- case length_bytes(edge_data_from_arg) > 0 of { true -> edge_data_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_edge_data", context, world) };
                                            weight_wit: string <- case length_bytes(weight_from_arg) > 0 of { true -> weight_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "edge_weight", context, world) };
                                            cmp_weight_wit: string <- case length_bytes(cmp_weight_from_arg) > 0 of { true -> cmp_weight_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_weight", context, world) };
                                            case length_bytes(node_wit) == 0 or length_bytes(edge_data_wit) == 0 or length_bytes(weight_wit) == 0 or length_bytes(cmp_weight_wit) == 0 of {
                                                true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_node, compare_edge_data, edge_weight, or compare_weight witness", "sect4");
                                                false -> type_checker_collections@witness_matches_weighted_graph_declaration(bind_type, node_wit, edge_data_wit, weight_wit, cmp_weight_wit, location)
                                            }
                                        };
                                        false -> case type_checker_collections@is_binary_tree_type(bind_type) of {
                                            true -> {
                                                wit_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                                                bt_wit: string <- case length_bytes(wit_from_arg) > 0 of { true -> wit_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                                                case length_bytes(bt_wit) == 0 of {
                                                    true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                                                    false -> type_checker_collections@witness_matches_binary_tree_declaration(bind_type, bt_wit, location)
                                                }
                                            };
                                            false -> type_checker_core@type_check_err("E2017", location, "unsupported collection constructor binding type", "sect4")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn verify_collection_constructor_witness(bind_type: string, rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, location: { file: string, line: int64, column: int64, offset: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@expr_kind(rhs) == 4 of {
        false -> type_checker_core@type_check_err("E2017", location, "collection constructor binding requires a call to empty/1 or with_root/2", "sect4");
        true -> case is_collection_constructor_call(rhs) of {
            false -> type_checker_core@type_check_err("E2017", location, "collection constructor binding requires a call to empty/1 or with_root/2", "sect4");
            true -> {
                mod_name: string <- type_checker_collections@module_name_from_qualified_call(type_checker_expressions_helpers@expr_name(rhs));
                case length_bytes(mod_name) == 0 of {
                    true -> type_checker_core@type_check_err("E2017", location, "collection constructor requires qualified module@empty or module@with_root call", "sect4");
                    false -> case type_checker_collections@is_registered_construction_module(mod_name) of {
                        false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("module ", mod_name), " is not a registered collection construction module for binding type "), bind_type), ""), "sect4");
                        true -> case type_checker_collections@collection_trait_accepts_module(bind_type, mod_name) of {
                            false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("module ", mod_name), " does not match collection binding type "), bind_type), ""), "sect4");
                            true -> {
                                record_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- constructor_functions_record_expr(rhs);
                                fields_ok: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_collections@validate_constructor_record_field_names(bind_type, record_e, location);
                                case fields_ok.is_ok of {
                                    false -> fields_ok;
                                    true -> verify_collection_witness_for_family(bind_type, record_e, context, location, world, rhs)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn constructor_record_field_fn_type(record_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    case type_checker_expressions_helpers@expr_kind(record_expr) == 21 of {
        true -> case type_checker_expressions_helpers@expr_name(record_expr) == field of {
            true -> type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(record_expr), context);
            false -> constructor_record_field_fn_type(type_checker_expressions_helpers@expr_child_right(record_expr), field, context)
        };
        false -> {
            inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(record_expr, context);
            case length_bytes(inferred) > 0 of {
                true -> type_checker_record_types@find_field_type_in_record(inferred, field);
                false -> case type_checker_expressions_helpers@expr_kind(record_expr) == 1 of {
                    true -> {
                        (found: boolean, _: int64) <- type_checker_core@lookup_symbol_found(context.env, type_checker_expressions_helpers@expr_name(record_expr));
                        var_type: string <- type_checker_core@lookup_symbol_surface(context.env, type_checker_expressions_helpers@expr_name(record_expr));
                        case found of {
                            false -> "";
                            true -> type_checker_record_types@find_field_type_in_record(var_type, field)
                        }
                    };
                    false -> ""
                }
            }
        }
    }
}

fn empty_call_constructor_witness_fn_type(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> string {
    discard_out: { context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, id: int64 } <- type_checker_core@discard_type_id(context);
    (_: boolean, func_type: string) <- type_checker_expressions_user_call_resolve@try_resolve_qualified_call_func_type(rhs, discard_out.id, world, discard_out.context);
    case length_bytes(func_type) of {
        0 -> "";
        _: int64 -> {
            func_type_canon: string <- type_checker_expressions_identifiers@normalize_fn_type_idf(func_type);
            params_inner: string <- type_checker_expressions_user_call_helpers@get_params_inner_from_func_type(func_type_canon);
            (first_param: string, _: string) <- type_checker_expressions_user_call_helpers@get_first_param_type(params_inner);
            case length_bytes(first_param) == 0 of {
                true -> "";
                false -> type_checker_record_types@find_field_type_in_record(first_param, field)
            }
        }
    }
}

