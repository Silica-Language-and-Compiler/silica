// String and file builtin call checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_expressions_string_calls;
use type_checker_builtin_signatures;

export is_string_io_name/1;
export check_string_io/6;

fn is_string_io_name(n: string) -> boolean {
    type_checker_builtin_signatures@is_string_io_builtin(n)
}

fn check_string_io(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], check_surface: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }), check_typed: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, int64, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@expr_name(expr) == "read_lines" of {
        true -> {
            (rl, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
            type_checker_expressions_string_calls@check_read_lines_call(expr, expected_type, context, rl)
        };
        false -> case type_checker_expressions_helpers@expr_name(expr) == "file_exists" of {
            true -> {
                (fe, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                type_checker_expressions_string_calls@check_file_exists_call(expr, expected_type, context, fe)
            };
            false -> case type_checker_expressions_helpers@expr_name(expr) == "delete_file" of {
                true -> {
                    (df, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                    type_checker_expressions_string_calls@check_delete_file_call(expr, expected_type, context, df)
                };
                false -> case type_checker_expressions_helpers@expr_name(expr) == "append_file" of {
                    true -> {
                        (af1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                        (af2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string", context, world);
                        type_checker_expressions_string_calls@check_append_file_call(expr, expected_type, context, af1, af2)
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "concat" or type_checker_expressions_helpers@expr_name(expr) == "concatenate" of {
                        true -> case concatenate_has_two_args(expr) == false of {
                            // Defect B11: `concatenate("a")` compiled; the second argument is a kind-4 chain node.
                            true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "concatenate argument count mismatch", "sect6");
                            false -> {
                            (a1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                            (a2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string", context, world);
                            type_checker_expressions_string_calls@check_concatenate_call(expr, expected_type, context, a1, a2)
                            }
                        };
                        false -> case type_checker_expressions_helpers@expr_name(expr) == "substring" of {
                            true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                                true -> {
                                    (s1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                    (s2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "int64", context, world);
                                    (s3, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))), "int64", context, world);
                                    type_checker_expressions_string_calls@check_substring_call(expr, expected_type, context, s1, s2, s3)
                                };
                                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "substring requires 3 arguments: (s: string, start: int64, end: int64)", "sect6")
                            };
                            false -> case type_checker_expressions_helpers@expr_name(expr) == "substring_until_char" of {
                                true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                                    true -> {
                                        (u1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                        (u2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "int64", context, world);
                                        (u3, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))), "char", context, world);
                                        type_checker_expressions_string_calls@check_substring_until_char_call(expr, expected_type, context, u1, u2, u3)
                                    };
                                    false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "substring_until_char requires 3 arguments: (s: string, start: int64, char: char)", "sect6")
                                };
                                false -> case type_checker_expressions_helpers@expr_name(expr) == "length_bytes" of {
                                    true -> {
                                        (lb, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                        type_checker_expressions_string_calls@check_length_bytes_call(expr, expected_type, context, lb)
                                    };
                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "length_chars" of {
                                        true -> {
                                            (lc, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                            type_checker_expressions_string_calls@check_length_chars_call(expr, expected_type, context, lc)
                                        };
                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "starts_with" or type_checker_expressions_helpers@expr_name(expr) == "ends_with" or type_checker_expressions_helpers@expr_name(expr) == "contains" of {
                                            true -> {
                                                (p1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                (p2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string", context, world);
                                                type_checker_expressions_string_calls@check_string_predicate_call(expr, expected_type, context, p1, p2)
                                            };
                                            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "internal: string/io dispatcher miss", "sect6")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Two-argument shape: inner = arg1, right_expr = a kind-4 "" chain node holding arg2 with no tail.
fn concatenate_has_two_args(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) < 0 of {
        true -> false;
        false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
            false -> false;
            true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr))) < 0 of {
                true -> false;
                false -> type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))) < 0
            }
        }
    }
}
