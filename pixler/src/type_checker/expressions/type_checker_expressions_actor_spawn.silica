    type_checker_core@type_check_err("E2091", type_checker_expressions_helpers@expr_loc(expr), "spawn_linked is no longer part of the public supervisor surface; use spawn_registered for actors or spawn_registered_supervisor for supervisors", "sect15.4.13")
}

