            false -> case type_checker_expressions_helpers@expr_kind(place_e) == 5 of {
                true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(place_e), concat(concat(concat(builtin_label, ": "), which_arg), " must be uint64 or core_id(uint64), got atom §15.1.1"), "sect15");
                false -> {
                        (r, _) <- check_surface(place_e, "uint64", context, world);
                        r
                    }
            }
        }
    }
}

// §15.1.2.2: every spawn form takes a stack policy as its last required argument. The argument is
// checked as an expression of the built-in type stack_policy, so a bound name of that type is as
// good as an inline stack_policy(reserve, release); anything else names the migration in the message.
