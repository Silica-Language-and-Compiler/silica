        true -> {
            sup_type_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(expr);
            init_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_second_arg_expr(expr);
            name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_third_arg_expr(expr);
            case type_checker_expressions_helpers@expr_kind(sup_type_e) == 1 of {
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "spawn_registered_supervisor: first argument must name the supervisor implementation type", "sect15.4.13");
                true -> {
                    (r_init, _) <- check_surface(init_e, "discard", context, world);
                    case r_init.is_ok of {
                        false -> r_init;
                        true -> {
                            (r_name, _) <- check_surface(name_e, "atom", context, world);
                            case r_name.is_ok of {
                                false -> r_name;
                                true -> {
                                    policy_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_fourth_arg_expr(expr);
                                    r_pol: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_spawn_stack_policy_arg(policy_e, context, world, "spawn_registered_supervisor", "fourth argument", check_surface);
                                    case r_pol.is_ok of {
                                        false -> r_pol;
                                        true -> case ac == 5 of {
                                            true -> {
                                                place_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_fifth_arg_expr(expr);
                                                r_pl: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_spawn_core_id_placement(place_e, context, world, "spawn_registered_supervisor", "fifth argument", check_surface, check_typed);
                                                case r_pl.is_ok of {
                                                    false -> r_pl;
                                                    true -> check_supervisor_spawn_result_type(expr, expected_type, context, "spawn_registered_supervisor")
                                                }
                                            };
                                            false -> check_supervisor_spawn_result_type(expr, expected_type, context, "spawn_registered_supervisor")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_call_supervisor_result_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    inferred: string <- type_checker_expressions_actors@supervisor_reply_record_type();
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
        true -> type_checker_core@type_check_ok();
        false -> case type_checker_expressions_helpers@surface_type_matches_expected(context, inferred, expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("call_supervisor returns ", concat(inferred, concat(", expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)))), "sect15.4.13")
        }
    }
}

