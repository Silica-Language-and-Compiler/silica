int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    is_ctor: boolean <- type_checker_expressions_helpers@expr_kind(policy_e) == 4 and type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(policy_e)) == "stack_policy";
    (r0, _) <- check_surface(policy_e, "stack_policy", context, world);
    case r0.is_ok or is_ctor of {
        true -> r0;
        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(policy_e), concat(concat(concat(builtin_label, ": "), which_arg), " must be a stack_policy(reserve: int64, release: atom); the optional core id follows it §15.1.2.2"), "sect15")
    }
}

fn release_algorithm_atom_known(lexeme: string) -> boolean {
    lexeme == ":release_on_return" or lexeme == ":keep_last_message" or lexeme == ":track_recent_peak" or lexeme == ":release_when_idle" or lexeme == ":keep_high_water"
        or lexeme == "release_on_return" or lexeme == "keep_last_message" or lexeme == "track_recent_peak" or lexeme == "release_when_idle" or lexeme == "keep_high_water"
}

// stack_policy(reserve: int64, release: atom) -> stack_policy (§15.1.2.2). `reserve` is any int64
