arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }), check_typed: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, int64, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    eff: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
    inferred: string <- actor_runtime_builtin_return_type(eff);
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    // §22.14.1: monotonic_time() and current_time() take no argument and answer int64.
    case eff == "monotonic_time" or eff == "current_time" of {
        true -> case ac == 0 of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(eff, " expects 0 arguments"), "sect22.14");
            true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
        };
        // §22.14.2: cancel_timer(timer: timer_ref) -> :cancelled | :not_found.
        false -> case eff == "cancel_timer" of {
        true -> case ac == 1 of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "cancel_timer expects 1 argument: (timer: timer_ref)", "sect22.14");
            true -> {
                (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "timer_ref", context, world);
                case r0.is_ok of {
                    false -> r0;
                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                }
            }
        };
        false -> case eff == "set_scheduler_policy" of {
        true -> case ac == 1 of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "set_scheduler_policy expects 1 argument: (policy: atom)", "sect15");
            true -> {
                (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "atom", context, world);
                case r0.is_ok of {
                    false -> r0;
                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                }
            }
        };
        // actor_carrier_index(ref) -> int64: a test-only query of the hosted carrier runtime
        // (actor_memory_budget_plan.md item N stage 3; trials/carriers_addition).
        false -> case eff == "actor_carrier_index" of {
        true -> case ac == 1 of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "actor_carrier_index expects 1 argument: (actor_ref)", "sect15");
            true -> {
                (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "actor_ref", context, world);
                case r0.is_ok of {
                    false -> r0;
                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                }
            }
        };
        false -> case eff == "heap_used" of {
        true -> case ac == 0 of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "heap_used expects 0 arguments", "sect15");
            true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
        };
        false -> case eff == "get_cpu_topology" of {
        true -> case ac == 0 of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "get_cpu_topology expects 0 arguments", "sect15");
            true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
        };
        false -> case eff == "get_efficiency_cores" of {
            true -> case ac == 0 of {
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "get_efficiency_cores expects 0 arguments", "sect15");
                true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
            };
            false -> case eff == "get_performance_cores" of {
                true -> case ac == 0 of {
                    false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "get_performance_cores expects 0 arguments", "sect15");
                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                };
                false -> case eff == "get_core_capabilities" of {
                    true -> case ac == 1 of {
                        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "get_core_capabilities expects 1 argument: (core_id: int64)", "sect15");
                        true -> {
                            (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "int64", context, world);
                            case r0.is_ok of {
                                false -> r0;
                                true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                            }
                        }
                    };
                    false -> case eff == "pin_actor_to_core" of {
                        true -> case ac == 2 of {
                            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "pin_actor_to_core expects 2 arguments: (actor_ref, core_id)", "sect15");
                            true -> {
                                (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "actor_ref", context, world);
                                case r0.is_ok of {
                                    false -> r0;
                                    true -> {
                                        (r1, _) <- check_surface(type_checker_expressions_helpers@call_second_arg_expr(expr), "int64", context, world);
                                        case r1.is_ok of {
                                            false -> r1;
