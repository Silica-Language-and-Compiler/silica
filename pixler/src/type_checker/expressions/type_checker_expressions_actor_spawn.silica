        false -> case type_checker_expressions_helpers@expr_kind(place_e) == 1 and (type_checker_expressions_helpers@expr_name(place_e) == "performance_cores" or type_checker_expressions_helpers@expr_name(place_e) == "efficiency_cores") of {
