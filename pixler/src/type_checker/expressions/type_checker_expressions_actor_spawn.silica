        true -> {
            (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "int64", context, world);
            case r0.is_ok of {
                false -> r0;
                true -> {
                    release_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_second_arg_expr(expr);
                    case type_checker_expressions_helpers@expr_kind(release_e) == 5 of {
                        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(release_e), "stack_policy: release must be an atom literal naming a release algorithm: :release_on_return, :keep_last_message, :track_recent_peak, :release_when_idle or :keep_high_water §15.1.2.2", "sect15");
                        true -> case release_algorithm_atom_known(type_checker_expressions_helpers@expr_value(release_e)) or release_algorithm_atom_known(type_checker_expressions_helpers@expr_name(release_e)) of {
                            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(release_e), concat(concat("stack_policy: unknown release algorithm ", type_checker_expressions_helpers@expr_value(release_e)), "; expected :release_on_return, :keep_last_message, :track_recent_peak, :release_when_idle or :keep_high_water §15.1.2.2"), "sect15");
                            true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_stack_policy() of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("stack_policy(...) has type stack_policy, expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect15")
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_actor_spawn_result_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, builtin_label: string, spawn_result_type: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@surface_type_matches_expected(context, spawn_result_type, expected_type) of {
        true -> type_checker_core@type_check_ok();
        false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(builtin_label, " returns "), spawn_result_type), concat(", expected ", type_checker_expressions_helpers@expect_surf(context, expected_type))), "sect15")
        }
    }
}

