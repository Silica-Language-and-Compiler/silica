module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case type_checker_expressions_helpers@expr_name(expr) == "core_id" of {
        true -> case ac == 1 of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "core_id expects 1 argument (core id: uint64) §15.1.1", "sect15");
            true -> {
                (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "uint64", context, world);
                case r0.is_ok of {
                    false -> r0;
                    true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                        true -> type_checker_core@type_check_ok();
                        false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_uint64() of {
                            true -> type_checker_core@type_check_ok();
                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("core_id(...) has type uint64, expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect15")
                        }
                    }
                }
            }
        };
        false -> case type_checker_expressions_helpers@expr_name(expr) == "core_set" of {
            true -> case ac == 1 of {
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "core_set expects 1 argument (core set: List[int64,normal]) §15.1.1", "sect15");
                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_uint64() of {
                    true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "spawn's third argument is a uint64 core id, not core_set(...) §15.1.1", "sect15");
                    false -> {
                        (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "List[int64,normal]", context, world);
                        case r1.is_ok of {
                            false -> r1;
                            true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_core@surface_for_type_id(context, expected_type) == "List[int64,normal]" of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("core_set(...) has type List[int64,normal], expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect15")
                                }
                            }
                        }
                    }
                }
            };
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "internal: not a spawn affinity constructor", "sect15")
        }
    }
}


fn string_starts_with_prefix(s: string, prefix: string) -> boolean {
    case length_bytes(prefix) == 0 of {
        true -> true;
        false -> case length_bytes(s) < length_bytes(prefix) of {
            true -> false;
            false -> substring(s, 0, length_bytes(prefix)) == prefix
        }
    }
}

fn is_dangerous_module_name_for_spawn(name: string) -> boolean {
    case length_bytes(name) >= 10 of {
        true -> substring(name, 0, 10) == "dangerous_";
        false -> false
    }
}

fn is_dangerous_qualified_call_for_spawn(name: string) -> boolean {
    case type_checker_core@call_name_is_module_qualified(name) of {
        false -> false;
        true -> {
            (qmod: string, _: string) <- type_checker_core@split_module_qualified_call_name(name);
            is_dangerous_module_name_for_spawn(qmod)
        }
    }
}

fn effect_list_has_external_danger_for_spawn(effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> boolean {
    case effects.is_nil of {
        true -> false;
        false -> case effects.head.name == "external_danger" of {
            true -> true;
            false -> effect_list_has_external_danger_for_spawn(effects.tail)
        }
    }
}

fn statement_chain_has_external_danger_for_spawn(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case type_checker_expressions_helpers@expr_kind(expr) < 0 of {
        true -> false;
        false -> case type_checker_expressions_helpers@expr_kind(expr) == 11 of {
            true -> effect_list_has_external_danger_for_spawn(type_checker_expressions_helpers@expr_sequence_effects(expr));
            false -> case type_checker_expressions_helpers@expr_kind(expr) == 6 of {
                true -> statement_chain_has_external_danger_for_spawn(type_checker_expressions_helpers@expr_child_right(expr));
                false -> case type_checker_expressions_helpers@expr_kind(expr) == 10 of {
                    true -> statement_chain_has_external_danger_for_spawn(type_checker_expressions_helpers@expr_child_right(expr));
                    false -> false
                }
            }
        }
    }
}

fn expr_has_dangerous_qualified_call_for_spawn(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case type_checker_expressions_helpers@expr_kind(expr) < 0 of {
        true -> false;
        false -> case type_checker_expressions_helpers@expr_kind(expr) == 4 of {
            true -> case is_dangerous_qualified_call_for_spawn(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> true;
                false -> expr_has_dangerous_qualified_call_pair_for_spawn(type_checker_expressions_helpers@expr_child_inner(expr), type_checker_expressions_helpers@expr_child_right(expr))
            };
            false -> expr_has_dangerous_qualified_call_pair_for_spawn(type_checker_expressions_helpers@expr_child_inner(expr), type_checker_expressions_helpers@expr_child_right(expr))
        }
    }
}

fn expr_has_dangerous_qualified_call_pair_for_spawn(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr_has_dangerous_qualified_call_for_spawn(inner) of {
        true -> true;
        false -> expr_has_dangerous_qualified_call_for_spawn(right)
    }
}

fn find_fn_body_in_decls_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string) -> (boolean, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_expr());
        false -> case decls.head.tag == 0 and decls.head.name == fn_name of {
            true -> (true, decls.head.body);
            false -> find_fn_body_in_decls_loop(decls.tail, fn_name)
        }
    }
}

fn find_fn_body_in_world(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fn_name: string) -> (boolean, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) {
    (mod_part: string, fn_part: string) <- type_checker_core@split_module_qualified_call_name(fn_name);
    case length_bytes(mod_part) == 0 of {
        true -> find_fn_body_in_world_any(world, fn_name);
        false -> {
            (found: boolean, hit: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- find_fn_body_in_world_in_module(world, mod_part, fn_part);
            case found of {
                true -> (true, hit);
                false -> find_fn_body_in_world_any(world, fn_part)
            }
        }
    }
}

fn find_fn_body_in_world_in_module(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], mod: string, fn_name: string) -> (boolean, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) {
    case world.is_nil of {
        true -> (false, parser_ast@dummy_expr());
        false -> case world.head.module_name == mod of {
            true -> find_fn_body_in_decls_loop(world.head.program.declarations, fn_name);
            false -> find_fn_body_in_world_in_module(world.tail, mod, fn_name)
        }
    }
}

fn find_fn_body_in_world_any(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fn_name: string) -> (boolean, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) {
    case world.is_nil of {
        true -> (false, parser_ast@dummy_expr());
        false -> {
            (found: boolean, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- find_fn_body_in_decls_loop(world.head.program.declarations, fn_name);
            case found of {
                true -> (true, body);
                false -> find_fn_body_in_world_any(world.tail, fn_name)
            }
        }
    }
}

fn behavior_uses_dangerous_code(fn_name: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (found: boolean, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- find_fn_body_in_world(world, fn_name);
    case found of {
        false -> false;
        true -> case statement_chain_has_external_danger_for_spawn(body) of {
            true -> true;
            false -> expr_has_dangerous_qualified_call_for_spawn(body)
        }
    }
}

fn atom_literal_has_prefix(name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, prefix: string) -> boolean {
    case type_checker_expressions_helpers@expr_kind(name_e) == 5 of {
        true -> string_starts_with_prefix(type_checker_expressions_helpers@expr_value(name_e), prefix);
        false -> false
    }
}

fn atom_literal_has_dangerous_registry_prefix(name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case type_checker_expressions_helpers@expr_kind(name_e) == 5 of {
        true -> string_starts_with_prefix(type_checker_expressions_helpers@expr_value(name_e), ":dangerous_");
        false -> false
    }
}

fn find_fn_decl_in_decls_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string) -> (boolean, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 0 and decls.head.name == fn_name of {
            true -> (true, decls.head);
            false -> find_fn_decl_in_decls_loop(decls.tail, fn_name)
        }
    }
}

fn find_fn_decl_in_world(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fn_name: string) -> (boolean, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    (mod_part: string, fn_part: string) <- type_checker_core@split_module_qualified_call_name(fn_name);
    case length_bytes(mod_part) == 0 of {
        true -> find_fn_decl_in_world_any(world, fn_name);
        false -> {
            (found: boolean, hit: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_fn_decl_in_world_in_module(world, mod_part, fn_part);
            case found of {
                true -> (true, hit);
                false -> find_fn_decl_in_world_any(world, fn_part)
            }
        }
    }
}

fn find_fn_decl_in_world_in_module(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], mod: string, fn_name: string) -> (boolean, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case world.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case world.head.module_name == mod of {
            true -> find_fn_decl_in_decls_loop(world.head.program.declarations, fn_name);
            false -> find_fn_decl_in_world_in_module(world.tail, mod, fn_name)
        }
    }
}

fn find_fn_decl_in_world_any(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fn_name: string) -> (boolean, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case world.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> {
            (found: boolean, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_fn_decl_in_decls_loop(world.head.program.declarations, fn_name);
            case found of {
                true -> (true, decl);
                false -> find_fn_decl_in_world_any(world.tail, fn_name)
            }
        }
    }
}

// A behaviour is device code when it declares register_rwr, contains a register_rwr sequence, or
// calls a device prim (silica_device_actor_specification.md §4.2).
fn behavior_uses_device_code(fn_name: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (found: boolean, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_fn_decl_in_world(world, fn_name);
    case found of {
        false -> false;
        true -> type_checker_expressions_device@decl_uses_device_code(decl)
    }
}

fn check_spawn_plain_not_dangerous_spawn(builtin_label: string, beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case builtin_label == "spawn_device" of {
        true -> case behavior_uses_dangerous_code(type_checker_expressions_helpers@expr_name(beh_e), world) of {
            true -> type_checker_core@type_check_err("E2224", type_checker_expressions_helpers@expr_loc(expr), "spawn_device cannot start a behavior that uses external_danger or dangerous_* code (silica_device_actor_specification.md §4.2)", "sect4.2");
            false -> type_checker_core@type_check_ok()
        };
        false -> case behavior_uses_device_code(type_checker_expressions_helpers@expr_name(beh_e), world) of {
            true -> type_checker_core@type_check_err("E2223", type_checker_expressions_helpers@expr_loc(expr), concat(builtin_label, " cannot start a behavior that uses register_rwr or the device prims; use spawn_device and bind the result as device_actor_ref (silica_device_actor_specification.md §4.2)"), "sect4.2");
            false -> case builtin_label == "spawn" of {
                true -> {
                    dangerous_behavior: boolean <- behavior_uses_dangerous_code(type_checker_expressions_helpers@expr_name(beh_e), world);
                    case dangerous_behavior of {
                        true -> type_checker_core@type_check_err("E4044", type_checker_expressions_helpers@expr_loc(expr), "spawn cannot start a behavior that uses external_danger or dangerous_* code; use spawn_dangerous and bind the result as dangerous_actor_ref", "sect4");
                        false -> type_checker_core@type_check_ok()
                    }
                };
                false -> type_checker_core@type_check_ok()
            }
        }
    }
}

fn check_spawn_dangerous_requires_dangerous_behavior(builtin_label: string, beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case builtin_label == "spawn_dangerous" of {
        true -> {
            dangerous_behavior: boolean <- behavior_uses_dangerous_code(type_checker_expressions_helpers@expr_name(beh_e), world);
            case dangerous_behavior of {
                false -> type_checker_core@type_check_err("E4045", type_checker_expressions_helpers@expr_loc(expr), "spawn_dangerous requires a behavior whose body uses sequence proc[external_danger] or dangerous_* code", "sect4");
                true -> type_checker_core@type_check_ok()
            }
        };
        false -> type_checker_core@type_check_ok()
    }
}

fn check_cast_registered_registry_rules(name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case atom_literal_has_dangerous_registry_prefix(name_e) of {
        true -> type_checker_core@type_check_err("E4048", type_checker_expressions_helpers@expr_loc(name_e), "cast_registered must not use registry names whose spelling begins with :dangerous_; use cast_dangerous_registered (spec 4.9)", "sect4");
        false -> case atom_literal_has_prefix(name_e, ":device_") of {
            true -> type_checker_core@type_check_err("E2233", type_checker_expressions_helpers@expr_loc(name_e), "cast_registered must not use registry names whose spelling begins with :device_; use cast_device_registered (silica_device_actor_specification.md §1, §11)", "sect1");
            false -> type_checker_core@type_check_ok()
        }
    }
}

fn check_cast_dangerous_registered_registry_rules(name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case atom_literal_has_dangerous_registry_prefix(name_e) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E4049", type_checker_expressions_helpers@expr_loc(name_e), "cast_dangerous_registered requires the registration atom to begin with :dangerous_ (spec 4.9)", "sect4")
    }
}

fn check_spawn_registered_registry_rules(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    eff: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
    case eff == "spawn_device_registered" of {
        true -> case atom_literal_has_prefix(name_e, ":device_") of {
            true -> case behavior_uses_dangerous_code(type_checker_expressions_helpers@expr_name(beh_e), world) of {
                true -> type_checker_core@type_check_err("E2224", type_checker_expressions_helpers@expr_loc(expr), "spawn_device_registered cannot start a behavior that uses external_danger or dangerous_* code (silica_device_actor_specification.md §4.2)", "sect4.2");
                false -> type_checker_core@type_check_ok()
            };
            false -> type_checker_core@type_check_err("E2233", type_checker_expressions_helpers@expr_loc(name_e), "spawn_device_registered requires the registration atom to begin with :device_ (the device registry is separate, silica_device_actor_specification.md §1)", "sect1")
        };
        false -> case behavior_uses_device_code(type_checker_expressions_helpers@expr_name(beh_e), world) of {
            true -> type_checker_core@type_check_err("E2223", type_checker_expressions_helpers@expr_loc(expr), concat(eff, " cannot start a behavior that uses register_rwr or the device prims; use spawn_device_registered and bind the result as device_actor_ref (silica_device_actor_specification.md §4.2)"), "sect4.2");
            false -> case eff == "spawn_dangerous_registered" of {
                true -> case atom_literal_has_dangerous_registry_prefix(name_e) of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E4046", type_checker_expressions_helpers@expr_loc(name_e), "spawn_dangerous_registered requires the registration atom to begin with :dangerous_", "sect4")
                };
                false -> case eff == "spawn_registered" of {
                    true -> {
                        dangerous_behavior: boolean <- behavior_uses_dangerous_code(type_checker_expressions_helpers@expr_name(beh_e), world);
                        case dangerous_behavior of {
                            true -> type_checker_core@type_check_err("E4043", type_checker_expressions_helpers@expr_loc(name_e), "spawn_registered: actors whose behavior uses dangerous code must be registered with spawn_dangerous_registered and an atom whose spelling begins with 'dangerous_' (spec 4.7)", "sect4");
                            false -> type_checker_core@type_check_ok()
                        }
                    };
                    false -> type_checker_core@type_check_ok()
                }
            }
        }
    }
}

