    case ac == 2 of {
        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "call_supervisor expects 2 arguments: (supervisor_ref, SupervisorMessage)", "sect15.4.13");
        true -> {
            (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "supervisor_ref", context, world);
            r0_actor: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case r0.is_ok of {
                true -> r0;
                false -> {
