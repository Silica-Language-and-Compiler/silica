// Actor spawn, self, and runtime-helper built-in checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_recursive_tuples;
use type_checker_lists;
use type_checker_collections;
use type_checker_expressions_actors;
use type_checker_expressions_device;
use type_checker_supervisor;
use type_checker_record_types;
use type_checker_traits;
use type_checker_callee_env;
use type_checker_expressions_identifiers;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use string_parse;
use instantiated_fn_name;

export is_actor_runtime_helper_name/1;
export is_actor_concurrency_builtin/1;
export check_actor_runtime_helper_call/6;
export check_actor_self_call/3;
export check_actor_spawn_call/8;
export check_actor_spawn_registered_call/6;
export check_actor_spawn_dangerous_registered_call/6;
export check_actor_spawn_device_registered_call/6;
export check_spawn_registered_supervisor_call/6;
export check_actor_spawn_linked_call/4;
export check_call_supervisor_builtin/6;
export check_spawn_affinity_constructor_call/6;
export check_stack_policy_constructor_call/6;
export check_cast_registered_registry_rules/1;
export check_cast_dangerous_registered_registry_rules/1;

// Local copy: user_calls defines the same helper, but actor_spawn must not `use` user_calls (cycle).
fn is_function_type_user_call(type_str: string) -> boolean {
    type_checker_expressions_identifiers@find_arrow_idf(type_str, 0, 0, 0, 0) >= 0
}

fn actor_runtime_builtin_return_type(name: string) -> string {
    case name of {
        "pin_actor_to_core" -> "(int64,affinity_error)";
        "pin_actor_to_efficiency_core" -> "(int64,affinity_error)";
        "pin_actor_to_performance_core" -> "(int64,affinity_error)";
        "pin_actor_realtime" -> "(int64,affinity_error)";
        "remove_actor" -> "(int64,affinity_error)";
        "pin_actor_to_numa_node" -> "(int64,affinity_error)";
        "unpin_actor" -> "atom";
        "register_actor" -> "atom";
        "get_registry_actor" -> "actor_ref";
        "get_pid_registry" -> "actor_ref";
        "set_actor_priority" -> "atom";
        "get_cpu_topology" -> "{ cores: List[{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 },normal], numa_nodes: List[{ id: int64, cores: List[int64,normal], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 },normal] },normal], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64,normal] },normal] } }";
        "get_efficiency_cores" -> "List[int64,normal]";
        "get_performance_cores" -> "List[int64,normal]";
        "get_core_capabilities" -> "{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 }";
        "get_actor_memory_usage" -> "{ reserved: int64, committed: int64, retained: int64, high_water: int64 }";
        "migrate_actor" -> "atom";
        "set_scheduler_policy" -> "atom";
        "register_failure_reporter" -> "atom";
        "heap_used" -> "int64";
        "actor_carrier_index" -> "int64";
        // Clocks and timers (spec §22.14): send_after is checked in type_checker_expressions_actor_supervision_messaging.
        "monotonic_time" -> "int64";
        "current_time" -> "int64";
        "send_after" -> "timer_ref";
        "cancel_timer" -> "atom";
        _: string -> ""
    }
}

fn is_actor_runtime_helper_name(name: string) -> boolean {
    length_bytes(actor_runtime_builtin_return_type(name)) > 0
}

// §4.5 actor_ref, §15 spawn, §16 call/cast/send, self; recv forbidden §15.1.2.
// §15.4.8.5–§15.4.8.7: link, monitor, demonitor (Phase G: behavior-only for link/monitor/demonitor; E2091).
fn is_actor_concurrency_builtin(name: string) -> boolean {
    name == "spawn" or name == "spawn_device" or name == "spawn_device_registered" or name == "cast_device" or name == "cast_device_registered" or name == "spawn_dangerous" or name == "spawn_registered" or name == "spawn_dangerous_registered" or name == "spawn_registered_supervisor" or name == "spawn_linked" or name == "call_supervisor" or name == "add_child" or name == "link" or name == "monitor" or name == "demonitor" or name == "send" or name == "cast" or name == "cast_registered" or name == "cast_dangerous_registered" or name == "call" or name == "call_registered" or name == "self" or name == "recv" or name == "supervision_ingress_enqueue" or name == "supervision_wait_and_drain_one" or name == "failure_reason_tag" or name == "failure_reason_atom" or name == "failure_agent_type" or name == "failure_release" or name == "start_child" or name == "child_table_first_ref" or name == "child_table_row_ref" or name == "kill_abnormal" or name == "stop_self" or name == "fail_self" or name == "wait_for_exit" or name == "cast_exit" or name == "move" or is_actor_runtime_helper_name(name)
}

fn check_runtime_builtin_return(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, inferred: string, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    disp: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
        true -> type_checker_core@type_check_ok();
        false -> case type_checker_expressions_helpers@surface_type_matches_expected(context, inferred, expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> case type_checker_lists@types_equal_strip(inferred, type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat(disp, " returns "), inferred), ", expected "), type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect15")
            }
        }
    }
}

fn check_actor_runtime_helper_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, colum