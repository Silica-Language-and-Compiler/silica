rce_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_actors@type_context_has_behavior_marker(context) of {
        false -> type_checker_core@type_check_err("E2091", type_checker_expressions_helpers@expr_loc(expr), "spawn_linked may only be called from within an actor behavior function (§15.4.8.3; supervisors plan Phase D)", "sect15.4.8.3");
        true -> {
            ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
            case ac == 3 or ac == 4 of {
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "spawn_linked expects 3 or 4 arguments: (initial_state, behavior_fn, agent_type: atom [, core_id]) §15.4.8.3", "sect15");
                true -> {
            init_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_init_expr(expr);
            beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_behavior_expr(expr);
            agent_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_third_arg_expr(expr);
            case type_checker_expressions_helpers@expr_kind(beh_e) == 1 of {
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "spawn_linked: behavior must be a function identifier", "sect15");
                true -> {
                    (beh_found: boolean, _: int64) <- type_checker_core@lookup_behavior_found(context.env, type_checker_expressions_helpers@expr_name(beh_e));
                    beh_type: string <- type_checker_core@lookup_behavior_surface(context.env, type_checker_expressions_helpers@expr_name(beh_e));
                    case beh_found of {
                        false -> type_checker_core@type_check_err("E2007", type_checker_expressions_helpers@expr_loc(expr), concat("spawn_linked: unknown behavior function: ", type_checker_expressions_helpers@expr_name(beh_e)), "sect15");
                        true -> case is_function_type_user_call(beh_type) of {
                            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "spawn_linked: behavior must be a function", "sect15");
                            true -> {
                                sig_ok: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_expressions_actors@validate_spawn_behavior_function_type("spawn_linked", beh_type, type_checker_expressions_helpers@expr_loc(expr));
                                case sig_ok.is_ok of {
                                    false -> sig_ok;
                                    true -> {
                                        state_t: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_type);
                                        case length_bytes(state_t) == 0 of {
                                            true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "spawn_linked: could not parse behavior state parameter type", "sect15");
                                            false -> {
                                                (r_init, _) <- check_surface(init_e, state_t, context, world);
                                                case r_init.is_ok of {
                                                    false -> r_init;
                                                    true -> {
                                                        (r_atom, _) <- check_surface(agent_e, "atom", context, world);
                                                        case r_atom.is_ok of {
                                                            false -> r_atom;
                                                            true -> case ac == 4 of {
                                                                true -> {
                                                                    place_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_fourth_arg_expr(expr);
                                                                    r_pl: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_spawn_core_id_placement(place_e, context, world, "spawn_linked", "fourth argument", check_surface, check_typed);
                                                                    case r_pl.is_ok of {
                                                                        false -> r_pl;
                                                                        true -> check_actor_spawn_result_type(expr, expected_type, context, "spawn_linked", "actor_ref")
                                                                    }
                                                                };
                                                                false -> check_actor_spawn_result_type(expr, expected_type, context, "spawn_linked", "actor_ref")
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
        }
    }
}

// §15.4.8.5: link(target: actor_ref) -> :ok proc[concurrency]. Supervisors plan Phase D: behavior-only.
