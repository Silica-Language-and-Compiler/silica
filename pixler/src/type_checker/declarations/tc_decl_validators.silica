// Thin dispatcher (see tutorials_and_howtos/thin_dispatchers_for_compile_ram.md).
// type_checker_declarations_functions called 8 functions but imported 128 exported
// signatures (~35KB of interface) to get them. Routing through this module means the
// consumer materialises 8 signatures instead of 128 in a single compilation unit.

use type_checker_collections;
use type_checker_lists;
use type_checker_memory_regions;
use type_checker_record_types;
use type_checker_recursion;

export validate_collection_result_type_declaration/2;
export validate_collection_type_declaration/2;
export validate_list_type_declaration/2;
export is_memory_region_type/1;
export validate_memory_region_type/2;
export record_type_braces_balanced/1;
export record_type_starts/1;
export recursion_analyze_body/2;

fn validate_collection_result_type_declaration(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    type_checker_collections@validate_collection_result_type_declaration(type_str, location)
}

fn validate_collection_type_declaration(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    type_checker_collections@validate_collection_type_declaration(type_str, location)
}

fn validate_list_type_declaration(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    type_checker_lists@validate_list_type_declaration(type_str, location)
}

fn is_memory_region_type(type_str: string) -> boolean {
    type_checker_memory_regions@is_memory_region_type(type_str)
}

fn validate_memory_region_type(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    type_checker_memory_regions@validate_memory_region_type(type_str, location)
}

fn record_type_braces_balanced(s: string) -> boolean {
    type_checker_record_types@record_type_braces_balanced(s)
}

fn record_type_starts(s: string) -> boolean {
    type_checker_record_types@record_type_starts(s)
}

fn recursion_analyze_body(body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, function_name: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    type_checker_recursion@recursion_analyze_body(body, function_name)
}
