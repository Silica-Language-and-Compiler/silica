// Semantic hooks for recursion lowering (explicit frames, preemption, tail calls).
// Aligns with compiler/design_documents/recursion_implementation.md.
// Phase tags RECURSION_PHASE_* map to the design's steps: 1=frames/stack/saved state, 2=lowering/dispatch,
// 3=fuel/back-edges, 4=source-mapped frames / stack traces, 5=tail-call optimization, 6=trampoline fallback.
// Phases 1-4 and 6 (explicit frames, fuel preemption, source-mapped traces, trampoline fallback) are
// not implemented (compiler/design_documents/recursion_implementation.md, Implementation status); only the
// call-site classification below and native tail calls (phase 5) exist.
// After a function body type-checks, recursion_analyze_body walks the AST to classify call sites
// (direct self vs other, tail vs non-tail, back-edge hints) for downstream codegen — no new type errors.

use parser_ast;
use type_checker_core;

export RECURSION_PHASE_CORE_FRAMES/0;
export RECURSION_PHASE_LOWERING/0;
export RECURSION_PHASE_PREEMPTION/0;
export RECURSION_PHASE_DEBUG/0;
export RECURSION_PHASE_OPTIMIZATION/0;
export RECURSION_PHASE_FALLBACK/0;
export CALL_RECURSION_NONE/0;
export CALL_RECURSION_DIRECT_SELF/0;
export CALL_RECURSION_OTHER_FUNCTION/0;
export TAIL_CALL_HINT_NOT_TAIL/0;
export TAIL_CALL_HINT_TAIL/0;
export BACK_EDGE_HINT_NONE/0;
export BACK_EDGE_HINT_TAIL_OR_LOOP/0;
export source_location_eq/2;
export expr_same_by_location/2;
export expr_is_tail_position/2;
export classify_call_recursion/2;
export tail_call_hint_for_site/2;
export back_edge_hint_for_site/2;
export recursion_phase_name/1;
export recursion_analyze_body/2;

fn RECURSION_PHASE_CORE_FRAMES() -> int64 { 1 }
fn RECURSION_PHASE_LOWERING() -> int64 { 2 }
fn RECURSION_PHASE_PREEMPTION() -> int64 { 3 }
fn RECURSION_PHASE_DEBUG() -> int64 { 4 }
fn RECURSION_PHASE_OPTIMIZATION() -> int64 { 5 }
fn RECURSION_PHASE_FALLBACK() -> int64 { 6 }

fn CALL_RECURSION_NONE() -> int64 { 0 }
fn CALL_RECURSION_DIRECT_SELF() -> int64 { 1 }
fn CALL_RECURSION_OTHER_FUNCTION() -> int64 { 2 }

fn TAIL_CALL_HINT_NOT_TAIL() -> int64 { 0 }
fn TAIL_CALL_HINT_TAIL() -> int64 { 1 }

fn BACK_EDGE_HINT_NONE() -> int64 { 0 }
fn BACK_EDGE_HINT_TAIL_OR_LOOP() -> int64 { 1 }

fn source_location_eq(a: { file: string, line: int64, column: int64, offset: int64 }, b: { file: string, line: int64, column: int64, offset: int64 }) -> boolean {
    case a.line == b.line and a.column == b.column and a.offset == b.offset of {
        true -> a.file == b.file;
        false -> false
    }
}

fn expr_same_by_location(a: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, b: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    a_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(a);
    b_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(b);
    source_location_eq(a_node.location, b_node.location)
}

fn expr_is_tail_case_branches(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, target: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    branches_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(branches);
    case branches_node.kind == -1 of {
        true -> false;
        false -> case branches_node.kind == 17 of {
            true -> {
                b: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(branches, branches_node.inner);
                rest: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(branches, branches_node.right_expr);
                b_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(b);
                case b_node.kind == 18 of {
                    true -> {
                        branch_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(b, b_node.right_expr);
                        here: boolean <- expr_is_tail_position(branch_body, target);
                        case here of {
                            true -> true;
                            false -> expr_is_tail_case_branches(rest, target)
                        }
                    };
                    false -> expr_is_tail_case_branches(rest, target)
                }
            };
            false -> false
        }
    }
}

// If else branch is tail of target, true; else use then_ok (from then-branch tail check).
fn merge_tail_if_else(then_ok: boolean, tail_in_else: boolean) -> boolean {
    case tail_in_else of {
        true -> true;
        false -> then_ok
    }
}

fn expr_is_tail_if(root: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, target: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    root_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(root);
    case root_node.kind == 19 of {
        false -> false;
        true -> {
            then_else: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(root, root_node.right_expr);
            then_else_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(then_else);
            then_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(root, then_else_node.inner);
            else_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(root, then_else_node.right_expr);
            else_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(else_e);
            then_ok: boolean <- expr_is_tail_position(then_e, target);
            has_else: boolean <- else_node.kind >= 0;
            // List the merge call before plain then_ok: codegen incorrectly used alloca i64 for the first arm.
            case has_else of {
                true -> merge_tail_if_else(then_ok, expr_is_tail_position(else_e, target));
                false -> then_ok
            }
        }
    }
}

fn expr_is_tail_position(root: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, target: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr_same_by_location(root, target) of {
        true -> true;
        false -> {
            root_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(root);
            case root_node.kind of {
                2 -> expr_is_tail_position(parser_ast@expr_at(root, root_node.inner), target);
                4 -> false;
                6 -> expr_is_tail_position(parser_ast@expr_at(root, root_node.right_expr), target);
                9 -> false;
                10 -> expr_is_tail_position(parser_ast@expr_at(root, root_node.right_expr), target);
                11 -> expr_is_tail_position(parser_ast@expr_at(root, root_node.right_expr), target);
                12 -> false;
                13 -> expr_is_tail_case_branches(parser_ast@expr_at(root, root_node.right_expr), target);
                19 -> expr_is_tail_if(root, target);
                3 -> false;
                20 -> false;
                _: int64 -> false
            }
        }
    }
}

fn first_at_rec_call_name(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_rec_call_name(s, i + 1)
        }
    }
}

fn classify_call_recursion(callee_name: string, current_function_name: string) -> int64 {
    case length_bytes(current_function_name) == 0 of {
        true -> CALL_RECURSION_NONE();
        false -> case first_at_rec_call_name(callee_name, 0) >= 0 of {
            true -> CALL_RECURSION_OTHER_FUNCTION();
            false -> case callee_name == current_function_name of {
                true -> CALL_RECURSION_DIRECT_SELF();
                false -> CALL_RECURSION_OTHER_FUNCTION()
            }
        }
    }
}

fn tail_call_hint_for_site(call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, body_root: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    call_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(call_expr);
    body_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(body_root);
    case call_node.kind != 4 of {
        true -> TAIL_CALL_HINT_NOT_TAIL();
        false -> case body_node.kind < 0 of {
            true -> TAIL_CALL_HINT_NOT_TAIL();
            false -> case expr_is_tail_position(body_root, call_expr) of {
                true -> TAIL_CALL_HINT_TAIL();
                false -> TAIL_CALL_HINT_NOT_TAIL()
            }
        }
    }
}

fn back_edge_hint_for_site(call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, body_root: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case tail_call_hint_for_site(call_expr, body_root) == TAIL_CALL_HINT_TAIL() of {
        true -> BACK_EDGE_HINT_TAIL_OR_LOOP();
        false -> BACK_EDGE_HINT_NONE()
    }
}

fn recursion_phase_name(phase: int64) -> string {
    case phase of {
        1 -> "phase1_core_frames";
        2 -> "phase2_lowering";
        3 -> "phase3_preemption";
        4 -> "phase4_debug";
        5 -> "phase5_optimization";
        6 -> "phase6_fallback";
        _: int64 -> "phase_unknown"
    }
}

fn merge_two_results(a: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, b: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case a.is_ok of {
        true -> b;
        false -> a
    }
}

fn merge_three_results(a: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, b: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, c: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    merge_two_results(a, merge_two_results(b, c))
}

fn note_one_call_site(root_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, call: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, function_name: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    call_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(call);
    k: int64 <- classify_call_recursion(call_node.name, function_name);
    h: int64 <- tail_call_hint_for_site(call, root_body);
    b: int64 <- back_edge_hint_for_site(call, root_body);
    case k + h + b >= 0 of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_ok()
    }
}

fn recurse_branch_list(root_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, function_name: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    branches_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(branches);
    case branches_node.kind == -1 of {
        true -> type_checker_core@type_check_ok();
        false -> case branches_node.kind == 17 of {
            true -> {
                b: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(branches, branches_node.inner);
                rest: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(branches, branches_node.right_expr);
                b_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(b);
                r1: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(b, b_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(b, b_node.right_expr), function_name));
                case r1.is_ok of {
                    false -> r1;
                    true -> recurse_branch_list(root_body, rest, function_name)
                }
            };
            false -> recurse_analyze_expr(root_body, branches, function_name)
        }
    }
}

fn recurse_analyze_expr(root_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, function_name: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    e_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(e);
    case e_node.kind < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> {
            after_call: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case e_node.kind == 4 of {
                true -> note_one_call_site(root_body, e, function_name);
                false -> type_checker_core@type_check_ok()
            };
            case after_call.is_ok of {
                false -> after_call;
                true -> recurse_children(root_body, e, function_name)
            }
        }
    }
}

fn recurse_children(root_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, function_name: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    e_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(e);
    case e_node.kind of {
        0 -> type_checker_core@type_check_ok();
        1 -> type_checker_core@type_check_ok();
        5 -> type_checker_core@type_check_ok();
        7 -> type_checker_core@type_check_ok();
        8 -> type_checker_core@type_check_ok();
        2 -> recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name);
        12 -> recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name);
        3 -> merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.right_expr), function_name));
        4 -> merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.right_expr), function_name));
        6 -> merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.right_expr), function_name));
        9 -> merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.right_expr), function_name));
        10 -> merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.right_expr), function_name));
        11 -> merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.right_expr), function_name));
        13 -> merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_branch_list(root_body, parser_ast@expr_at(e, e_node.right_expr), function_name));
        19 -> {
            then_else: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(e, e_node.right_expr);
            then_else_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(then_else);
            merge_three_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, then_else_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, then_else_node.right_expr), function_name))
        };
        20 -> merge_two_results(recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.inner), function_name), recurse_analyze_expr(root_body, parser_ast@expr_at(e, e_node.right_expr), function_name));
        _: int64 -> type_checker_core@type_check_ok()
    }
}

// Walk body after successful type check: classify each call (Phase 1–6 metadata hooks; no new errors).
fn recursion_analyze_body(body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, function_name: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case length_bytes(function_name) == 0 of {
        true -> type_checker_core@type_check_ok();
        false -> recurse_analyze_expr(body, body, function_name)
    }
}
