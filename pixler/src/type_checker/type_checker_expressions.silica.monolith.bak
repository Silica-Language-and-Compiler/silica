                                                                                false -> {
                                                                                    rs: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_comparison_operands(expr, "string", context, world);
                                                                                    case rs.is_ok of {
                                                                                        true -> bool_result(context, expected_type, expr_loc(expr));
                                                                                        false -> {
                                                                                            ra: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_comparison_operands(expr, "atom", context, world);
                                                                                            case ra.is_ok of {
                                                                                                true -> bool_result(context, expected_type, expr_loc(expr));
                                                                                                false -> first_err
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Logical: and, or - operands boolean, result boolean
fn is_logical_op_lexeme(op: string) -> bool {
    op == "and" or op == "or"
}

fn check_binary_op(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    op: string <- expr_value(expr);
    case is_arithmetic_op_lexeme(op) of {
        true -> {
            operand_type: string <- case expect_surf(context, expected_type) of {
                "int64" -> "int64";
                "int32" -> "int32";
                "int16" -> "int16";
                "int8" -> "int8";
                "uint64" -> "uint64";
                "uint32" -> "uint32";
                "uint16" -> "uint16";
                "uint8" -> "uint8";
                "float64" -> "float64";
                "float32" -> "float32";
                "float16" -> "float16";
                _: string -> "int64"
            };
            (left_result, _) <- check_expr_surface(expr_child_inner(expr), operand_type, context, world);
            case left_result.is_ok of {
                false -> left_result;
                true -> {
                    (right_result, _) <- check_expr_surface(expr_child_right(expr), operand_type, context, world);
                    case right_result.is_ok of {
                        false -> right_result;
                        true -> case expect_surf(context, expected_type) of {
                            "int64" -> type_checker_core@type_check_ok();
                            "int32" -> type_checker_core@type_check_ok();
                            "int16" -> type_checker_core@type_check_ok();
                            "int8" -> type_checker_core@type_check_ok();
                            "uint64" -> type_checker_core@type_check_ok();
                            "uint32" -> type_checker_core@type_check_ok();
                            "uint16" -> type_checker_core@type_check_ok();
                            "uint8" -> type_checker_core@type_check_ok();
                            "float64" -> type_checker_core@type_check_ok();
                            "float32" -> type_checker_core@type_check_ok();
                            "float16" -> type_checker_core@type_check_ok();
                            "discard" -> type_checker_core@type_check_ok();
                            _: string -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("arithmetic op expects integer or float result (int64/.../float64/float32/float16), got ", expect_surf(context, expected_type)), "sect6")
                        }
                    }
                }
            }
        };
        false -> case is_bitwise_binary_op_lexeme(op) of {
            true -> check_bitwise_binary_op(expr, expected_type, context, world);
            false -> case is_comparison_op_lexeme(op) of {
            true -> check_comparison_result(expr, expected_type, context, world);
            false -> case is_logical_op_lexeme(op) of {
                true -> {
                    (left_result, _) <- check_expr_surface(expr_child_inner(expr), "boolean", context, world);
                    case left_result.is_ok of {
                        false -> left_result;
                        true -> {
                            (right_result, _) <- check_expr_surface(expr_child_right(expr), "boolean", context, world);
                            case right_result.is_ok of {
                                false -> right_result;
                            true -> case expect_surf(context, expected_type) of {
                                "boolean" -> type_checker_core@type_check_ok();
                                "discard" -> type_checker_core@type_check_ok();
                                _: string -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("logical op expects boolean result, got ", expect_surf(context, expected_type)), "sect6")
                            }
                            }
                        }
                    }
                };
                false -> type_checker_core@type_check_err("E2004", expr_loc(expr), concat("unknown operator: ", op), "sect6")
            }
        }
        }
    }
}

// Multi-arg calls use kind-4 continuations with name "" (see extract_call_rest). Second argument is inner of that node.
fn call_second_arg_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case expr_kind(expr_child_right(expr)) == 4 and expr_name(expr_child_right(expr)) == "" of {
        true -> expr_child_inner(expr_child_right(expr));
        false -> expr_child_right(expr)
    }
}

// Third argument of a 3-arg call like write_buf(buf, idx, val).
// Parser encodes as call(inner=buf, right=pair("", inner=idx, right=pair("", inner=val, right=dummy))).
fn call_third_arg_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case expr_kind(expr_child_right(expr)) == 4 and expr_name(expr_child_right(expr)) == "" of {
        true -> case expr_kind(expr_child_right(expr_child_right(expr))) == 4 and expr_name(expr_child_right(expr_child_right(expr))) == "" of {
            true -> expr_child_inner(expr_child_right(expr_child_right(expr)));
            false -> expr_child_right(expr_child_right(expr))
        };
        false -> expr_child_right(expr)
    }
}


// Fourth argument of spawn_linked(initial, behavior, agent_type, core_id).
fn call_fourth_arg_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case expr_kind(expr_child_right(expr)) == 4 and expr_name(expr_child_right(expr)) == "" of {
        true -> case expr_kind(expr_child_right(expr_child_right(expr))) == 4 and expr_name(expr_child_right(expr_child_right(expr))) == "" of {
            true -> case expr_kind(expr_child_right(expr_child_right(expr_child_right(expr)))) == 4 and expr_name(expr_child_right(expr_child_right(expr_child_right(expr)))) == "" of {
                true -> expr_child_inner(expr_child_right(expr_child_right(expr_child_right(expr))));
                false -> expr_child_right(expr_child_right(expr_child_right(expr)))
            };
            false -> expr_child_right(expr_child_right(expr))
        };
        false -> expr_child_right(expr)
    }
}


// Memory region built-ins per spec §4.4, §9.2.2, §12, §22
fn check_region_builtin_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_name(expr) == "alloc_region" of {
        true -> {
            mem_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_memory_regions@validate_memory_region_type(expect_surf(context, expected_type), expr_loc(expr));
            case mem_result.is_ok of {
                false -> mem_result;
                true -> case expr_kind(expr_child_inner(expr)) == 1 of {
                    true -> {
                        arg_space: string <- expr_name(expr_child_inner(expr));
                        expected_space: string <- type_checker_memory_regions@get_space_from_region_type(expect_surf(context, expected_type));
                        space_ok: boolean <- type_checker_memory_regions@is_valid_memory_space(arg_space);
                        case space_ok of {
                            false -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat(concat("alloc_region: invalid memory space '", arg_space), "'"), "sect4.4.1");
                            true -> case arg_space == expected_space of {
                                false -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat(concat("alloc_region: space '", arg_space), concat("' does not match expected type ", expect_surf(context, expected_type))), "sect4.4.1");
                                true -> type_checker_core@type_check_ok()
                            }
                        }
                    };
                    false -> type_checker_core@type_check_err("E2010", expr_loc(expr), "alloc_region: argument must be memory space identifier", "sect4.4.1")
                }
            }
        };
        false -> case expr_name(expr) == "alloc_ref" of {
            true -> {
                region_type: string <- type_checker_memory_regions@ref_type_to_region_type(expect_surf(context, expected_type));
                elem_type: string <- type_checker_memory_regions@extract_element_type_from_ref(expect_surf(context, expected_type));
                case len(region_type) == 0 of {
                    true -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat("alloc_ref result must be ref(R, Space, T), got ", expect_surf(context, expected_type)), "sect4.4.2");
                    false -> {
                        (r1, _) <- check_expr_surface(expr_child_inner(expr), region_type, context, world);
                        case r1.is_ok of { false -> r1; true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), elem_type, context, world);
                        r
                    }}
                    }
                }
            };
            false -> case expr_name(expr) == "alloc_rec" of {
                true -> {
                    region_type: string <- type_checker_memory_regions@ref_type_to_region_type(expect_surf(context, expected_type));
                    elem_type: string <- type_checker_memory_regions@extract_element_type_from_ref(expect_surf(context, expected_type));
                    case len(region_type) == 0 of {
                        true -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat("alloc_rec result must be ref(R, Space, T), got ", expect_surf(context, expected_type)), "recursive_tuple§2.3");
                        false -> {
                            rec_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_recursive_tuples@validate_alloc_rec_element_type(elem_type, expr_loc(expr));
                            case rec_result.is_ok of {
                                false -> rec_result;
                                true -> {
                                    (r1, _) <- check_expr_surface(expr_child_inner(expr), region_type, context, world);
                                    case r1.is_ok of { false -> r1; true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), elem_type, context, world);
                        r
                    }}
                                }
                            }
                        }
                    }
                };
                false -> case expr_name(expr) == "read_ref" of {
                true -> {
                    ref_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                    elem_type: string <- type_checker_memory_regions@extract_element_type_from_ref(ref_type);
                    case len(elem_type) == 0 of {
                        true -> type_checker_core@type_check_err("E2010", expr_loc(expr), "read_ref: argument must have ref(R, Space, T) type", "sect4.4.2");
                        false -> case surface_type_matches_expected(context, elem_type, expected_type) of {
                            false -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat(concat("read_ref: element type ", elem_type), concat(" does not match expected ", expect_surf(context, expected_type))), "sect4.4.2");
                            true -> {
                        (r, _) <- check_expr_surface(expr_child_inner(expr), ref_type, context, world);
                        r
                    }
                        }
                    }
                };
                false -> case expr_name(expr) == "write_ref" of {
                    true -> {
                        ref_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                        elem_type: string <- type_checker_memory_regions@extract_element_type_from_ref(ref_type);
                        case len(elem_type) == 0 of {
                            true -> type_checker_core@type_check_err("E2010", expr_loc(expr), "write_ref: first argument must have ref(R, Space, T) type", "sect4.4.2");
                            false -> {
                                (r1, _) <- check_expr_surface(expr_child_inner(expr), ref_type, context, world);
                                case r1.is_ok of {
                                    false -> r1;
                                    true -> {
                                        (r2, _) <- check_expr_surface(call_second_arg_expr(expr), elem_type, context, world);
                                        case r2.is_ok of {
                                            false -> r2;
                                            true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_atom() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "write_ref returns atom", "sect4.4.2")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    };
                    false -> case expr_name(expr) == "alloc_buf" of {
                        true -> {
                            region_type: string <- type_checker_memory_regions@buf_type_to_region_type(expect_surf(context, expected_type));
                            case len(region_type) == 0 of {
                                true -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat("alloc_buf result must be buf(R, Space, T, N), got ", expect_surf(context, expected_type)), "sect4.4.3");
                                false -> {
                                    (r1, _) <- check_expr_surface(expr_child_inner(expr), region_type, context, world);
                                    case r1.is_ok of { false -> r1; true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                        r
                    }}
                                }
                            }
                        };
                        false -> case expr_name(expr) == "read_buf" or expr_name(expr) == "buf_load" of {
                            true -> {
                                buf_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                                elem_type: string <- type_checker_memory_regions@extract_element_type_from_buf(buf_type);
                                case len(elem_type) == 0 of {
                                    true -> type_checker_core@type_check_err("E2010", expr_loc(expr), "read_buf/buf_load: first argument must have buf(R, Space, T, N) type", "sect4.4.3");
                                    false -> case surface_type_matches_expected(context, elem_type, expected_type) of {
                                        false -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat(concat("read_buf/buf_load: element type ", elem_type), concat(" does not match expected ", expect_surf(context, expected_type))), "sect4.4.3");
                                        true -> {
                                            (r1, _) <- check_expr_surface(expr_child_inner(expr), buf_type, context, world);
                                            case r1.is_ok of { false -> r1; true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                        r
                    }}
                                        }
                                    }
                                }
                            };
                            false -> case expr_name(expr) == "write_buf" or expr_name(expr) == "buf_store" of {
                                true -> {
                                    buf_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                                    elem_type: string <- type_checker_memory_regions@extract_element_type_from_buf(buf_type);
                                    case len(elem_type) == 0 of {
                                        true -> type_checker_core@type_check_err("E2010", expr_loc(expr), "write_buf/buf_store: first argument must have buf(R, Space, T, N) type", "sect4.4.3");
                                        false -> case expr_kind(expr_child_right(expr)) == 4 and expr_name(expr_child_right(expr)) == "" of {
                                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "write_buf/buf_store requires 3 arguments: (buf, index, value)", "sect12.3.2");
                                            true -> {
                                                (r1, _) <- check_expr_surface(expr_child_inner(expr), buf_type, context, world);
                                                case r1.is_ok of {
                                                    false -> r1;
                                                    true -> {
                                                        (r2, _) <- check_expr_surface(expr_child_inner(expr_child_right(expr)), "int64", context, world);
                                                        case r2.is_ok of {
                                                            false -> r2;
                                                            true -> {
                                                                (r3, _) <- check_expr_surface(call_third_arg_expr(expr), elem_type, context, world);
                                                                case r3.is_ok of {
                                                                    false -> r3;
                                                                    true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_atom() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                                                        true -> type_checker_core@type_check_ok();
                                                                        false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "write_buf/buf_store returns atom", "sect12.3.2")
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                };
                                false -> case expr_name(expr) == "fresh_lifetime" of {
                                        true -> case type_checker_core@surface_for_type_id(context, expected_type) == "lifetime" of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("fresh_lifetime returns lifetime, got ", expect_surf(context, expected_type)), "sect22.1")
                                        };
                                        false -> case expr_name(expr) == "canonical_arena_lookup" of {
                                            true -> {
                                                mem_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_memory_regions@validate_memory_region_type(expect_surf(context, expected_type), expr_loc(expr));
                                                case mem_result.is_ok of {
                                                    false -> mem_result;
                                                    true -> {
                        (r, _) <- check_expr_surface(expr_child_inner(expr), "int64", context, world);
                        r
                    }
                                                }
                                            };
                                            false -> case expr_name(expr) == "canonical_arena_same" of {
                                                true -> {
                                                    r1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                                                    r2_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(call_second_arg_expr(expr), context);
                                                    space1: string <- type_checker_memory_regions@get_space_from_region_type(r1_type);
                                                    space2: string <- type_checker_memory_regions@get_space_from_region_type(r2_type);
                                                    case len(space1) == 0 or len(space2) == 0 of {
                                                        true -> type_checker_core@type_check_err("E2010", expr_loc(expr), "canonical_arena_same: both arguments must be region(R, Space) values", "common_contract§7");
                                                        false -> case space1 == space2 of {
                                                            false -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat(concat("canonical_arena_same: memory spaces must match (", space1), concat(" vs ", concat(space2, ")"))), "common_contract§7");
                                                            true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() of {
                                                                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "canonical_arena_same returns boolean", "common_contract§7");
                                                                true -> {
                                                                    (r1, _) <- check_expr_surface(expr_child_inner(expr), r1_type, context, world);
                                                                    case r1.is_ok of {
                                                                        false -> r1;
                                                                        true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), r2_type, context, world);
                        r
                    }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                };
                                                false -> case expr_name(expr) == "ref_eq" of {
                                                    true -> {
                                                        r1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                                                        r2_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(call_second_arg_expr(expr), context);
                                                        e1: string <- type_checker_memory_regions@extract_element_type_from_ref(r1_type);
                                                        e2: string <- type_checker_memory_regions@extract_element_type_from_ref(r2_type);
                                                        case len(e1) == 0 or len(e2) == 0 of {
                                                            true -> type_checker_core@type_check_err("E2010", expr_loc(expr), "ref_eq: both arguments must be ref(R, Space, T) values", "sect4.4.2");
                                                            false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() of {
                                                                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "ref_eq returns boolean", "sect4.4.2");
                                                                true -> {
                                                                    (r1, _) <- check_expr_surface(expr_child_inner(expr), r1_type, context, world);
                                                                    case r1.is_ok of {
                                                                        false -> r1;
                                                                        true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), r2_type, context, world);
                        r
                    }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    };
                                                    false -> case expr_name(expr) == "ref_in_region" of {
                                                        true -> {
                                                            ref_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                                                            region_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(call_second_arg_expr(expr), context);
                                                            elem: string <- type_checker_memory_regions@extract_element_type_from_ref(ref_type);
                                                            space_r: string <- type_checker_memory_regions@get_space_from_region_type(region_type);
                                                            case len(elem) == 0 of {
                                                                true -> type_checker_core@type_check_err("E2010", expr_loc(expr), "ref_in_region: first argument must be ref(R, Space, T)", "sect4.4.2");
                                                                false -> case len(space_r) == 0 of {
                                                                    true -> type_checker_core@type_check_err("E2010", expr_loc(expr), "ref_in_region: second argument must be region(R, Space)", "sect4.4.2");
                                                                    false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() of {
                                                                        false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "ref_in_region returns boolean", "sect4.4.2");
                                                                        true -> {
                                                                            (r1, _) <- check_expr_surface(expr_child_inner(expr), ref_type, context, world);
                                                                            case r1.is_ok of {
                                                                                false -> r1;
                                                                                true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), region_type, context, world);
                        r
                    }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        };
                                                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("unknown region built-in: ", expr_name(expr)), "sect22")
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Built-in: print_int64/32/16/8, print_uint64/32/16/8 - arg matches type, returns atom
// Built-in: print_atom(atom:x) - arg atom, returns atom (:ok on success, :fail on failure)
