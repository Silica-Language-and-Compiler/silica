d: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    (arg_result, _) <- check_expr_surface(expr_child_inner(expr), arg_type, context, world);
    case arg_result.is_ok of {
        false -> arg_result;
        true -> case expect_surf(context, expected_type) of {
            "atom" -> type_checker_core@type_check_ok();
            "discard" -> type_checker_core@type_check_ok();
            _: string -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat("print_", concat(arg_type, " expects atom result, got ")), expect_surf(context, expected_type)), "sect6")
        }
    }
}

// Built-in: negate_<primitive>/1 — signed int and float only. negate_uint* are not builtins (unknown function, E2005). negate_unit is rejected below.
fn negate_builtin_arg_type(name: string) -> string {
    case name of {
        "negate_int8" -> "int8";
        "negate_int16" -> "int16";
        "negate_int32" -> "int32";
        "negate_int64" -> "int64";
        "negate_float16" -> "float16";
        "negate_float32" -> "float32";
        "negate_float64" -> "float64";
        _: string -> ""
    }
}

