 string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    has_postfix: bool <- type_checker_expressions_actors@call_has_impl_am_marker(expr);
    case has_postfix of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2005", expr_loc(msg_e), "message must satisfy ActorMessage (§16.3.2); use `expr impl ActorMessage {}`", "sect16")
