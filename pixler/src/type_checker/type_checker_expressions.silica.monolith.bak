            false -> (type_checker_core@type_check_err("E2005", expr_loc(call_expr), concat(expr_name(call_expr), " argument count mismatch"), "sect6"), parser_ast@nil_list_param());
            true -> {
                inf2: string <- type_checker_tuple_decompose_helpers@infer_expr_type(second_e, context);
                case len(inf2) == 0 of {
                    true -> (type_checker_core@type_check_err("E2005", expr_loc(second_e), "cannot infer concrete type for qualified call argument (needed to resolve trait-parameter body)", "sect6"), parser_ast@nil_list_param());
                    false -> {
                        formal_ty: string <- type_checker_collections@resolve_trait_formal_with_contexts(params_tail.head.type_name, st.collection_ctx, st.record_ctx, st.param_index);
                        case len(formal_ty) == 0 and type_checker_collections@is_assoc_type_placeholder(params_tail.head.type_name) of {
                            true -> (type_checker_core@type_check_err("E2017", expr_loc(second_e), concat(concat(concat("cannot resolve assoc type placeholder ", params_tail.head.type_name), " without collection declaration context for "), expr_name(call_expr)), "sect4"), parser_ast@nil_list_param());
