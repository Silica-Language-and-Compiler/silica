fn check_actor_concurrency_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    eff: string <- type_checker_core@user_call_base_function_name(expr_name(expr));
    case is_actor_runtime_helper_name(eff) of {
        true -> check_actor_runtime_helper_call(expr, expected_type, context, world);
        false -> case eff == "recv" of {
            true -> type_checker_core@type_check_err("E2005", expr_loc(expr), "recv() is runtime-internal only; user code cannot call recv (§15.1.2)", "sect15");
            false -> case eff == "self" of {
                true -> check_actor_self_call(expr, expected_type, context);
                false -> case eff == "spawn" of {
                    true -> check_actor_spawn_call(expr, expected_type, context, world, "spawn", "actor_ref");
                    false -> case eff == "spawn_dangerous" of {
                        true -> check_actor_spawn_call(expr, expected_type, context, world, "spawn_dangerous", "dangerous_actor_ref");
                    false -> case eff == "spawn_dangerous_registered" of {
                        true -> check_actor_spawn_dangerous_registered_call(expr, expected_type, context, world);
                        false -> case eff == "spawn_registered" of {
                        true -> check_actor_spawn_registered_call(expr, expected_type, context, world);
                        false -> case eff == "spawn_registered_supervisor" of {
                            true -> check_spawn_registered_supervisor_call(expr, expected_type, context, world);
                            false -> case eff == "spawn_linked" of {
                                true -> check_actor_spawn_linked_call(expr, expected_type, context, world);
                                false -> case eff == "call_supervisor" of {
                                    true -> check_call_supervisor_builtin(expr, expected_type, context, world);
                                    false -> case eff == "link" of {
                            true -> check_actor_link_call(expr, expected_type, context, world);
                            false -> case eff == "add_child" of {
                                true -> check_add_child_call(expr, expected_type, context, world);
                                false -> case eff == "monitor" of {
                                    true -> check_actor_monitor_call(expr, expected_type, context, world);
                                    false -> case eff == "demonitor" of {
                                        true -> check_actor_demonitor_call(expr, expected_type, context, world);
                                    false -> case eff == "supervision_ingress_enqueue" of {
                                        true -> check_supervision_ingress_enqueue_call(expr, expected_type, context, world);
                                        false -> case eff == "supervision_wait_and_drain_one" of {
                                            true -> check_supervision_wait_and_drain_one_call(expr, expected_type, context, world);
                                            false -> case eff == "failure_reason_tag" of {
                                                true -> check_failure_reason_tag_call(expr, expected_type, context, world);
                                            false -> case eff == "failure_reason_atom" of {
                                                true -> check_failure_reason_atom_call(expr, expected_type, context, world);
                                                false -> case eff == "failure_agent_type" of {
                                                    true -> check_failure_agent_type_call(expr, expected_type, context, world);
                                                    false -> case eff == "failure_release" of {
                                                        true -> check_failure_release_call(expr, expected_type, context, world);
                                                        false -> case eff == "start_child" of {
                                                            true -> check_start_child_call(expr, expected_type, context, world);
                                                            false -> case eff == "child_table_first_ref" of {
                                                                true -> check_child_table_first_ref_call(expr, expected_type, context, world);
                                                                false -> case eff == "child_table_row_ref" of {
                                                                    true -> check_child_table_row_ref_call(expr, expected_type, context, world);
                                                                    false -> case eff == "kill_abnormal" of {
                                                                        true -> check_kill_abnormal_call(expr, expected_type, context, world);
                                                                        false -> case eff == "wait_for_exit" of {
                                                                            true -> check_wait_for_exit_call(expr, expected_type, context, world);
                                                                            false -> case eff == "call" of {
                                                                                true -> check_actor_call_builtin(expr, expected_type, context, world);
                                                                                false -> case eff == "call_registered" of {
                                                                                    true -> check_actor_call_registered_builtin(expr, expected_type, context, world);
                                                                                    false -> case eff == "cast" of {
                                                                                        true -> check_actor_cast_builtin(expr, expected_type, context, world);
                                                                                        false -> case eff == "cast_registered" of {
                                                                                            true -> check_actor_cast_registered_builtin(expr, expected_type, context, world);
                                                                                            false -> case eff == "cast_dangerous_registered" of {
                                                                                                true -> check_actor_cast_dangerous_registered_builtin(expr, expected_type, context, world);
                                                                                                false -> check_actor_send_builtin(expr, expected_type, context, world)
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }}
                                                }
                                            }
                                        }
                                    }
                                    }
                                }
                            }}
                                }
                            }
                        }
                        }
                        }
                    }
                }
            }
        }
    }
}

fn is_float_special_const_name(name: string) -> bool {
    name == "float16_nan" or name == "float16_inf" or name == "float16_neg_inf" or name == "float32_nan" or name == "float32_inf" or name == "float32_neg_inf" or name == "float64_nan" or name == "float64_inf" or name == "float64_neg_inf"
}

fn float_special_const_type(name: string) -> string {
    case substring(name, 0, 7) == "float16" of {
        true -> "float16";
        false -> case substring(name, 0, 7) == "float32" of {
            true -> "float32";
            false -> "float64"
        }
    }
}

fn is_float_predicate_name(name: string) -> bool {
    name == "float16_is_nan" or name == "float16_is_inf" or name == "float16_is_finite" or name == "float32_is_nan" or name == "float32_is_inf" or name == "float32_is_finite" or name == "float64_is_nan" or name == "float64_is_inf" or name == "float64_is_finite"
}

fn float_predicate_arg_type(name: string) -> string {
    case substring(name, 0, 7) == "float16" of {
        true -> "float16";
        false -> case substring(name, 0, 7) == "float32" of {
            true -> "float32";
            false -> "float64"
        }
    }
}

fn check_float_special_const_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    ret: string <- float_special_const_type(expr_name(expr));
    case ac == 0 of {
        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " expects 0 arguments"), "sect6");
        true -> case expected_type == ret or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(expr_name(expr), " returns "), ret), concat(", expected ", expect_surf(context, expected_type))), "sect6")
        }
    }
}

fn check_float_predicate_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 1 of {
        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " expects 1 argument"), "sect6");
        true -> {
            arg_t: string <- float_predicate_arg_type(expr_name(expr));
            (r, _) <- check_expr_surface(expr_child_inner(expr), arg_t, context, world);
            case r.is_ok of {
                false -> r;
                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(expr_name(expr), concat(" returns bool, expected ", expect_surf(context, expected_type))), "sect6")
                }
            }
        }
    }
}

// Ordering identity built-ins (Layer 1 §7.2).
fn is_ordering_identity_builtin_call(call_name: string) -> bool {
    call_name == "ordering_identity_fresh_env" or call_name == "ordering_identity_materialize" or call_name == "ordering_identity_same" or call_name == "ordering_identity_bundle_make"
}

fn is_collection_result_builtin_call(call_name: string) -> bool {
    call_name == "comparator_result_valid" or call_name == "comparator_result_validate"
}

fn is_checked_int64_builtin_call(call_name: string) -> bool {
    call_name == "checked_int64_add" or call_name == "checked_int64_mul" or call_name == "checked_int64_add1" or call_name == "checked_int64_byte_size"
}

fn checked_int64_result_type_ok(expected_type: int64) -> bool {
    type_checker_core@surface_for_type_id(context, expected_type) == "(boolean, int64)"
}

fn check_checked_int64_builtin_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case checked_int64_result_type_ok(expected_type) of {
        false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("checked int64 built-in returns (boolean, int64), got ", expect_surf(context, expected_type)), "common_contract§9");
        true -> case expr_name(expr) of {
            "checked_int64_add1" -> {
                (r, _) <- check_expr_surface(expr_child_inner(expr), "int64", context, world);
                r
            };
            "checked_int64_byte_size" -> {
                (r1, _) <- check_expr_surface(expr_child_inner(expr), "int64", context, world);
                case r1.is_ok of {
                    false -> r1;
                    true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                        r
                    }
                }
            };
            _: string -> {
                (r1, _) <- check_expr_surface(expr_child_inner(expr), "int64", context, world);
                case r1.is_ok of {
                    false -> r1;
                    true -> {
                        (r, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                        r
                    }
                }
            }
        }
    }
}

fn check_collection_result_builtin_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    (arg_result, _) <- check_expr_surface(expr_child_inner(expr), "atom", context, world);
    case arg_result.is_ok of {
        false -> arg_result;
        true -> case expr_name(expr) of {
            "comparator_result_valid" -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("comparator_result_valid returns boolean, got ", expect_surf(context, expected_type)), "common_contract§4")
            };
            "comparator_result_validate" -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_atom() of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("comparator_result_validate returns atom, got ", expect_surf(context, expected_type)), "common_contract§4")
            };
            _: string -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("unknown collection result built-in: ", expr_name(expr)), "common_contract§4")
        }
    }
}

fn type_str_has_arrow_token(s: string, i: int64) -> bool {
    case i + 4 > len(s) of {
        true -> false;
        false -> case substring(s, i, i + 4) == " -> " of {
            true -> true;
            false -> type_str_has_arrow_token(s, i + 1)
        }
    }
}

fn is_fn_type_string(type_str: string) -> bool {
    case len(type_str) >= 3 and substring(type_str, 0, 3) == "fn(" of {
        true -> true;
        false -> case len(type_str) >= 4 and substring(type_str, 0, 4) == "fn (" of {
            true -> true;
            false -> type_str_has_arrow_token(type_str, 0)
        }
    }
}

fn check_ordering_identity_builtin_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_name(expr) of {
        "ordering_identity_fresh_env" -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_int64() of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("ordering_identity_fresh_env returns int64, got ", expect_surf(context, expected_type)), "common_contract§5")
        };
        "ordering_identity_materialize" -> {
            fn_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
            case is_fn_type_string(fn_type) of {
                false -> type_checker_core@type_check_err("E2010", expr_loc(expr), concat("ordering_identity_materialize: argument must be a function value, got ", fn_type), "common_contract§5");
                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_int64() of {
                    false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "ordering_identity_materialize returns int64", "common_contract§5");
                    true -> {
                        (r, _) <- check_expr_surface(expr_child_inner(expr), fn_type, context, world);
                        r
                    }
                }
            }
        };
        "ordering_identity_same" -> {
            (r1, _) <- check_expr_surface(expr_child_inner(expr), "int64", context, world);
            case r1.is_ok of {
                false -> r1;
                true -> {
                    (r2, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                    case r2.is_ok of {
                        false -> r2;
                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() of {
                            false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "ordering_identity_same returns boolean", "common_contract§5");
                            true -> type_checker_core@type_check_ok()
                        }
                    }
                }
            }
        };
        "ordering_identity_bundle_make" -> {
            (r1, _) <- check_expr_surface(expr_child_inner(expr), "int64", context, world);
            case r1.is_ok of {
                false -> r1;
                true -> {
                    (r2, _) <- check_expr_surface(call_second_arg_expr(expr), "atom", context, world);
                    case r2.is_ok of {
                        false -> r2;
                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_int64() of {
                            false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "ordering_identity_bundle_make returns int64", "common_contract§5");
                            true -> type_checker_core@type_check_ok()
                        }
                    }
                }
            }
        };
        _: string -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("unknown ordering identity built-in: ", expr_name(expr)), "common_contract§5")
    }
}

