// §4.5 actor_ref, §15 spawn, §16 call/cast/send, self; recv forbidden §15.1.2;
// CPU affinity / topology helpers (spec appendix): pin_actor_*, unpin_actor, remove_actor, set_actor_priority, get_cpu_topology, get_*_cores, get_core_capabilities.
fn actor_runtime_builtin_return_type(name: string) -> string {
    case name of {
        "pin_actor_to_core" -> "(int64,affinity_error)";
        "pin_actor_to_efficiency_core" -> "(int64,affinity_error)";
        "pin_actor_to_performance_core" -> "(int64,affinity_error)";
        "pin_actor_realtime" -> "(int64,affinity_error)";
        "remove_actor" -> "(int64,affinity_error)";
        "pin_actor_to_numa_node" -> "(int64,affinity_error)";
        "unpin_actor" -> "atom";
        "register_actor" -> "atom";
        "get_registry_actor" -> "actor_ref";
        "get_pid_registry" -> "actor_ref";
        "set_actor_priority" -> "atom";
        "get_cpu_topology" -> "{ cores: List[{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 },normal], numa_nodes: List[{ id: int64, cores: List[int64,normal], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 },normal] },normal], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64,normal] },normal] } }";
        "get_efficiency_cores" -> "List[int64,normal]";
        "get_performance_cores" -> "List[int64,normal]";
        "get_core_capabilities" -> "{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 }";
        "get_actor_memory_usage" -> "int64";
        "migrate_actor" -> "atom";
        "move" -> "atom";
        "register_failure_reporter" -> "atom";
        _: string -> ""
    }
}

fn is_actor_runtime_helper_name(name: string) -> bool {
    len(actor_runtime_builtin_return_type(name)) > 0
}

// §4.5 actor_ref, §15 spawn, §16 call/cast/send, self; recv forbidden §15.1.2.
// §15.4.8.5–§15.4.8.7: link, monitor, demonitor (Phase G: behavior-only for link/monitor/demonitor; E2091).
fn is_actor_concurrency_builtin(name: string) -> bool {
    name == "spawn" or name == "spawn_dangerous" or name == "spawn_registered" or name == "spawn_dangerous_registered" or name == "spawn_registered_supervisor" or name == "spawn_linked" or name == "call_supervisor" or name == "add_child" or name == "link" or name == "monitor" or name == "demonitor" or name == "send" or name == "cast" or name == "cast_registered" or name == "cast_dangerous_registered" or name == "call" or name == "call_registered" or name == "self" or name == "recv" or name == "supervision_ingress_enqueue" or name == "supervision_wait_and_drain_one" or name == "failure_reason_tag" or name == "failure_reason_atom" or name == "failure_agent_type" or name == "failure_release" or name == "start_child" or name == "child_table_first_ref" or name == "child_table_row_ref" or name == "kill_abnormal" or name == "wait_for_exit" or is_actor_runtime_helper_name(name)
}

fn check_runtime_builtin_return(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, inferred: string, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    disp: string <- type_checker_core@user_call_base_function_name(expr_name(expr));
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
        true -> type_checker_core@type_check_ok();
        false -> case surface_type_matches_expected(context, inferred, expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> case type_checker_lists@types_equal_strip(inferred, expect_surf(context, expected_type)) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(concat(disp, " returns "), inferred), ", expected "), expect_surf(context, expected_type)), "sect15")
            }
        }
    }
}

fn check_actor_runtime_helper_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    eff: string <- type_checker_core@user_call_base_function_name(expr_name(expr));
    inferred: string <- actor_runtime_builtin_return_type(eff);
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case eff == "get_cpu_topology" of {
        true -> case ac == 0 of {
            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "get_cpu_topology expects 0 arguments", "sect15");
            true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
        };
        false -> case eff == "get_efficiency_cores" of {
            true -> case ac == 0 of {
                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "get_efficiency_cores expects 0 arguments", "sect15");
                true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
            };
            false -> case eff == "get_performance_cores" of {
                true -> case ac == 0 of {
                    false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "get_performance_cores expects 0 arguments", "sect15");
                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                };
                false -> case eff == "get_core_capabilities" of {
                    true -> case ac == 1 of {
                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "get_core_capabilities expects 1 argument: (core_id: int64)", "sect15");
                        true -> {
                            (r0, _) <- check_expr_surface(expr_child_inner(expr), "int64", context, world);
                            case r0.is_ok of {
                                false -> r0;
                                true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                            }
                        }
                    };
                    false -> case eff == "pin_actor_to_core" of {
                        true -> case ac == 2 of {
                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "pin_actor_to_core expects 2 arguments: (actor_ref, core_id)", "sect15");
                            true -> {
                                (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                case r0.is_ok of {
                                    false -> r0;
                                    true -> {
                                        (r1, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                                        case r1.is_ok of {
                                            false -> r1;
                                            true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                        }
                                    }
                                }
                            }
                        };
                        false -> case eff == "pin_actor_realtime" of {
                            true -> case ac == 2 of {
                                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "pin_actor_realtime expects 2 arguments: (actor_ref, priority)", "sect15");
                                true -> {
                                    (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                    case r0.is_ok of {
                                        false -> r0;
                                        true -> {
                                            (r1, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                                            case r1.is_ok of {
                                                false -> r1;
                                                true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                            }
                                        }
                                    }
                                }
                            };
                            false -> case eff == "set_actor_priority" of {
                                true -> case ac == 2 of {
                                    false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "set_actor_priority expects 2 arguments: (actor_ref, priority_level)", "sect15");
                                    true -> {
                                        (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                        case r0.is_ok of {
                                            false -> r0;
                                            true -> {
                                                (r1, _) <- check_expr_surface(call_second_arg_expr(expr), "discard", context, world);
                                                case r1.is_ok of {
                                                    false -> r1;
                                                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                }
                                            }
                                        }
                                    }
                                };
                                false -> case eff == "pin_actor_to_numa_node" of {
                                    true -> case ac == 2 of {
                                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "pin_actor_to_numa_node expects 2 arguments: (actor_ref, numa_node)", "sect15");
                                        true -> {
                                            (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                            case r0.is_ok of {
                                                false -> r0;
                                                true -> {
                                                    (r1, _) <- check_expr_surface(call_second_arg_expr(expr), "discard", context, world);
                                                    case r1.is_ok of {
                                                        false -> r1;
                                                        true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                    }
                                                }
                                            }
                                        }
                                    };
                                    false -> case eff == "pin_actor_to_efficiency_core" of {
                                        true -> case ac == 1 of {
                                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "pin_actor_to_efficiency_core expects 1 argument: (actor_ref)", "sect15");
                                            true -> {
                                                (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                                case r0.is_ok of {
                                                    false -> r0;
                                                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                }
                                            }
                                        };
                                        false -> case eff == "pin_actor_to_performance_core" of {
                                            true -> case ac == 1 of {
                                                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "pin_actor_to_performance_core expects 1 argument: (actor_ref)", "sect15");
                                                true -> {
                                                    (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                                    case r0.is_ok of {
                                                        false -> r0;
                                                        true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                    }
                                                }
                                            };
                                            false -> case eff == "unpin_actor" of {
                                                true -> case ac == 1 of {
                                                    false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "unpin_actor expects 1 argument: (actor_ref)", "sect15");
                                                    true -> {
                                                        (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                                        case r0.is_ok of {
                                                            false -> r0;
                                                            true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                        }
                                                    }
                                                };
                                                false -> case eff == "remove_actor" of {
                                                    true -> case ac == 1 of {
                                                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "remove_actor expects 1 argument: (actor_ref)", "sect15");
                                                        true -> {
                                                            (r0, _) <- check_expr_surface(expr_child_inner(expr), "discard", context, world);
                                                            case r0.is_ok of {
                                                                false -> r0;
                                                                true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                            }
                                                        }
                                                    };
                                                    false -> case eff == "register_actor" of {
                                                        true -> case ac == 1 of {
                                                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "register_actor expects 1 argument: (actor_ref)", "sect15");
                                                            true -> {
                                                                (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                                                case r0.is_ok of {
                                                                    false -> r0;
                                                                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                                }
                                                            }
                                                        };
                                                        false -> case eff == "get_actor_memory_usage" of {
                                                        true -> case ac == 1 of {
                                                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "get_actor_memory_usage expects 1 argument: (actor_ref)", "sect15");
                                                            true -> {
                                                                (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                                                case r0.is_ok of {
                                                                    false -> r0;
                                                                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                                }
                                                            }
                                                        };
                                                        false -> case eff == "register_failure_reporter" of {
                                                            true -> case ac == 1 of {
                                                                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "register_failure_reporter expects 1 argument: (failure_reporter_actor: actor_ref)", "sect15.4.13.4");
                                                                true -> {
                                                                    (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                                                    case r0.is_ok of {
                                                                        false -> r0;
                                                                        true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                                    }
                                                                }
                                                            };
                                                            false -> case eff == "migrate_actor" of {
                                                                true -> case ac == 2 of {
                                                                    false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "migrate_actor expects 2 arguments: (actor_ref, target_core: int64)", "sect15");
                                                                    true -> {
                                                                        (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                                                        case r0.is_ok of {
                                                                            false -> r0;
                                                                            true -> {
                                                                                (r1, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                                                                                case r1.is_ok of {
                                                                                    false -> r1;
                                                                                    true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                };
                                                                false -> case eff == "move" of {
                                                                    true -> case ac == 3 of {
                                                                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "move expects 3 arguments: (actor_ref, from_core: int64, to_core: int64)", "sect15");
                                                                        true -> {
                                                                            (r0, _) <- check_expr_surface(expr_child_inner(expr), "actor_ref", context, world);
                                                                            case r0.is_ok of {
                                                                                false -> r0;
                                                                                true -> {
                                                                                    (r1, _) <- check_expr_surface(call_second_arg_expr(expr), "int64", context, world);
                                                                                    case r1.is_ok of {
                                                                                        false -> r1;
                                                                                        true -> {
                                                                                            (r2, _) <- check_expr_surface(call_third_arg_expr(expr), "int64", context, world);
                                                                                            case r2.is_ok of {
                                                                                                false -> r2;
                                                                                                true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    };
                                                                    false -> case eff == "get_registry_actor" of {
                                                                        true -> case ac == 0 of {
                                                                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "get_registry_actor expects 0 arguments", "sect15");
                                                                            true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                                        };
                                                                        false -> case eff == "get_pid_registry" of {
                                                                            true -> case ac == 0 of {
                                                                                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "get_pid_registry expects 0 arguments", "sect15");
                                                                                true -> check_runtime_builtin_return(expr, inferred, expected_type, context)
                                                                            };
                                                                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "unknown actor runtime helper", "sect15")
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_actor_self_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 0 of {
        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "self expects 0 arguments (§15.1.3)", "sect15");
        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_actor_ref() of {
            true -> type_checker_core@type_check_ok();
            false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("self returns actor_ref, expected ", expect_surf(context, expected_type)), "sect15")
            }
        }
    }
}

// §15.1.1: optional core placement is exactly one logical core id (`uint64`), or `core_id(uint64)`.
// Lists, `core_set`, `performance_cores`, and `efficiency_cores` are rejected here (not a range or set).
// `which_arg` is e.g. "third argument" for spawn, "fourth argument" for spawn_linked (§15.4.8.3).
fn check_spawn_core_id_placement(place_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], builtin_label: string, which_arg: string) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(place_e) == 20 of {
        true -> type_checker_core@type_check_err("E2005", expr_loc(place_e), concat(concat(concat(builtin_label, ": "), which_arg), " must be a single uint64 core id (not a list of cores) §15.1.1"), "sect15");
        false -> case expr_kind(place_e) == 1 and (expr_name(place_e) == "performance_cores" or expr_name(place_e) == "efficiency_cores") of {
            true -> type_checker_core@type_check_err("E2005", expr_loc(place_e), concat(concat(concat(builtin_label, ": "), which_arg), " must be a uint64 core id (not performance_cores or efficiency_cores) §15.1.1"), "sect15");
            false -> case expr_kind(place_e) == 5 of {
                true -> type_checker_core@type_check_err("E2005", expr_loc(place_e), concat(concat(concat(builtin_label, ": "), which_arg), " must be uint64 or core_id(uint64), got atom §15.1.1"), "sect15");
                false -> {
                        (r, _) <- check_expr_surface(place_e, "uint64", context, world);
                        r
                    }
            }
        }
    }
}

fn check_actor_spawn_result_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, builtin_label: string, spawn_result_type: string) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case surface_type_matches_expected(context, spawn_result_type, expected_type) of {
        true -> type_checker_core@type_check_ok();
        false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(builtin_label, " returns "), spawn_result_type), concat(", expected ", expect_surf(context, expected_type))), "sect15")
        }
    }
}

fn check_actor_spawn_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], builtin_label: string, spawn_result_type: string) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 or ac == 3 of {
        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(concat(builtin_label, " expects 2 or 3 arguments: (initial_state, behavior_fn [, core_id]) §15.1.1"), ""), "sect15");
        true -> {
            init_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_init_expr(expr);
            beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_behavior_expr(expr);
            case expr_kind(beh_e) == 1 of {
                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(builtin_label, ": behavior must be a function identifier"), "sect15");
                true -> {
                    (beh_found: boolean, _: int64) <- type_checker_core@lookup_symbol_found(context.env, expr_name(beh_e));
                    beh_type: string <- type_checker_core@lookup_symbol_surface(context.env, expr_name(beh_e));
                    case beh_found of {
                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(concat(builtin_label, ": unknown behavior function: "), expr_name(beh_e)), "sect15");
                        true -> case is_function_type_user_call(beh_type) of {
                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(builtin_label, ": behavior must be a function"), "sect15");
                            true -> {
                                plain_spawn_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_spawn_plain_not_dangerous_spawn(builtin_label, beh_e, expr, world);
                                case plain_spawn_ok.is_ok of {
                                    false -> plain_spawn_ok;
                                    true -> {
                                        dangerous_spawn_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_spawn_dangerous_requires_dangerous_behavior(builtin_label, beh_e, expr, world);
                                        case dangerous_spawn_ok.is_ok of {
                                            false -> dangerous_spawn_ok;
                                            true -> {
                                sig_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_expressions_actors@validate_spawn_behavior_function_type(builtin_label, beh_type, expr_loc(expr));
                                    case sig_ok.is_ok of {
                                    false -> sig_ok;
                                    true -> {
                                        state_t: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_type);
                                        case len(state_t) == 0 of {
                                            true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(builtin_label, ": could not parse behavior state parameter type"), "sect15");
                                            false -> {
                                                (r_init, _) <- check_expr_surface(init_e, state_t, context, world);
                                                case r_init.is_ok of {
                                                    false -> r_init;
                                                    true -> case ac == 3 of {
                                                        true -> {
                                                            place_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_placement_expr(expr);
                                                            r_pl: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_spawn_core_id_placement(place_e, context, world, builtin_label, "third argument");
                                                            case r_pl.is_ok of {
                                                                false -> r_pl;
                                                                true -> check_actor_spawn_result_type(expr, expected_type, context, builtin_label, spawn_result_type)
                                                            }
                                                        };
                                                        false -> check_actor_spawn_result_type(expr, expected_type, context, builtin_label, spawn_result_type)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Spawn: optional `core_id(x)` wrapper — x must be uint64; result is uint64 (same as spawn's third argument).
// `core_set` and list / performance_cores / efficiency_cores placement forms are not supported for spawn.
fn check_spawn_affinity_constructor_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case expr_name(expr) == "core_id" of {
        true -> case ac == 1 of {
            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "core_id expects 1 argument (core id: uint64) §15.1.1", "sect15");
            true -> {
                (r0, _) <- check_expr_surface(expr_child_inner(expr), "uint64", context, world);
                case r0.is_ok of {
                    false -> r0;
                    true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                        true -> type_checker_core@type_check_ok();
                        false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_uint64() of {
                            true -> type_checker_core@type_check_ok();
                            false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("core_id(...) has type uint64, expected ", expect_surf(context, expected_type)), "sect15")
                        }
                    }
                }
            }
        };
        false -> case expr_name(expr) == "core_set" of {
            true -> case ac == 1 of {
                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "core_set expects 1 argument (core set: List[int64,normal]) §15.1.1", "sect15");
                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_uint64() of {
                    true -> type_checker_core@type_check_err("E2005", expr_loc(expr), "spawn's third argument is a uint64 core id, not core_set(...) §15.1.1", "sect15");
                    false -> {
                        (r1, _) <- check_expr_surface(expr_child_inner(expr), "List[int64,normal]", context, world);
                        case r1.is_ok of {
                            false -> r1;
                            true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_core@surface_for_type_id(context, expected_type) == "List[int64,normal]" of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat("core_set(...) has type List[int64,normal], expected ", expect_surf(context, expected_type)), "sect15")
                                }
                            }
                        }
                    }
                }
            };
            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "internal: not a spawn affinity constructor", "sect15")
        }
    }
}


fn string_starts_with_prefix(s: string, prefix: string) -> bool {
    case len(prefix) == 0 of {
        true -> true;
        false -> case len(s) < len(prefix) of {
            true -> false;
            false -> substring(s, 0, len(prefix)) == prefix
        }
    }
}

fn is_dangerous_module_name_for_spawn(name: string) -> bool {
    case len(name) >= 10 of {
        true -> substring(name, 0, 10) == "dangerous_";
        false -> false
    }
}

fn is_dangerous_qualified_call_for_spawn(name: string) -> bool {
    case type_checker_core@call_name_is_module_qualified(name) of {
        false -> false;
        true -> {
            (qmod: string, _: string) <- type_checker_core@split_module_qualified_call_name(name);
            is_dangerous_module_name_for_spawn(qmod)
        }
    }
}

fn effect_list_has_external_danger_for_spawn(effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> bool {
    case effects.is_nil of {
        true -> false;
        false -> case effects.head.name == "external_danger" of {
            true -> true;
            false -> effect_list_has_external_danger_for_spawn(effects.tail)
        }
    }
}

fn statement_chain_has_external_danger_for_spawn(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> bool {
    case expr_kind(expr) < 0 of {
        true -> false;
        false -> case expr_kind(expr) == 11 of {
            true -> effect_list_has_external_danger_for_spawn(expr_sequence_effects(expr));
            false -> case expr_kind(expr) == 6 of {
                true -> statement_chain_has_external_danger_for_spawn(expr_child_right(expr));
                false -> case expr_kind(expr) == 10 of {
                    true -> statement_chain_has_external_danger_for_spawn(expr_child_right(expr));
                    false -> false
                }
            }
        }
    }
}

fn expr_has_dangerous_qualified_call_for_spawn(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> bool {
    case expr_kind(expr) < 0 of {
        true -> false;
        false -> case expr_kind(expr) == 4 of {
            true -> case is_dangerous_qualified_call_for_spawn(expr_name(expr)) of {
                true -> true;
                false -> expr_has_dangerous_qualified_call_pair_for_spawn(expr_child_inner(expr), expr_child_right(expr))
            };
            false -> expr_has_dangerous_qualified_call_pair_for_spawn(expr_child_inner(expr), expr_child_right(expr))
        }
    }
}

fn expr_has_dangerous_qualified_call_pair_for_spawn(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> bool {
    case expr_has_dangerous_qualified_call_for_spawn(inner) of {
        true -> true;
        false -> expr_has_dangerous_qualified_call_for_spawn(right)
    }
}

fn find_fn_body_in_decls_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string) -> (bool, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_expr());
        false -> case decls.head.tag == 0 and decls.head.name == fn_name of {
            true -> (true, decls.head.body);
            false -> find_fn_body_in_decls_loop(decls.tail, fn_name)
        }
    }
}

fn find_fn_body_in_world(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fn_name: string) -> (bool, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) {
    case world.is_nil of {
        true -> (false, parser_ast@dummy_expr());
        false -> {
            (found: bool, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- find_fn_body_in_decls_loop(world.head.program.declarations, fn_name);
            case found of {
                true -> (true, body);
                false -> find_fn_body_in_world(world.tail, fn_name)
            }
        }
    }
}

fn behavior_uses_dangerous_code(fn_name: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> bool {
    (found: bool, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- find_fn_body_in_world(world, fn_name);
    case found of {
        false -> false;
        true -> case statement_chain_has_external_danger_for_spawn(body) of {
            true -> true;
            false -> expr_has_dangerous_qualified_call_for_spawn(body)
        }
    }
}

fn atom_literal_has_dangerous_registry_prefix(name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> bool {
    case expr_kind(name_e) == 5 of {
        true -> string_starts_with_prefix(expr_value(name_e), ":dangerous_");
        false -> false
    }
}

fn check_spawn_plain_not_dangerous_spawn(builtin_label: string, beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case builtin_label == "spawn" of {
        true -> {
            dangerous_behavior: bool <- behavior_uses_dangerous_code(expr_name(beh_e), world);
            case dangerous_behavior of {
                true -> type_checker_core@type_check_err("E4044", expr_loc(expr), "spawn cannot start a behavior that uses external_danger or dangerous_* code; use spawn_dangerous and bind the result as dangerous_actor_ref", "sect4");
                false -> type_checker_core@type_check_ok()
            }
        };
        false -> type_checker_core@type_check_ok()
    }
}

fn check_spawn_dangerous_requires_dangerous_behavior(builtin_label: string, beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case builtin_label == "spawn_dangerous" of {
        true -> {
            dangerous_behavior: bool <- behavior_uses_dangerous_code(expr_name(beh_e), world);
            case dangerous_behavior of {
                false -> type_checker_core@type_check_err("E4045", expr_loc(expr), "spawn_dangerous requires a behavior whose body uses sequence proc[external_danger] or dangerous_* code", "sect4");
                true -> type_checker_core@type_check_ok()
            }
        };
        false -> type_checker_core@type_check_ok()
    }
}

fn check_cast_registered_registry_rules(name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case atom_literal_has_dangerous_registry_prefix(name_e) of {
        true -> type_checker_core@type_check_err("E4048", expr_loc(name_e), "cast_registered must not use registry names whose spelling begins with :dangerous_; use cast_dangerous_registered (spec 4.9)", "sect4");
        false -> type_checker_core@type_check_ok()
    }
}

fn check_cast_dangerous_registered_registry_rules(name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case atom_literal_has_dangerous_registry_prefix(name_e) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E4049", expr_loc(name_e), "cast_dangerous_registered requires the registration atom to begin with :dangerous_ (spec 4.9)", "sect4")
    }
}

fn check_spawn_registered_registry_rules(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    eff: string <- type_checker_core@user_call_base_function_name(expr_name(expr));
    case eff == "spawn_dangerous_registered" of {
        true -> case atom_literal_has_dangerous_registry_prefix(name_e) of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E4046", expr_loc(name_e), "spawn_dangerous_registered requires the registration atom to begin with :dangerous_", "sect4")
        };
        false -> case eff == "spawn_registered" of {
            true -> {
                dangerous_behavior: bool <- behavior_uses_dangerous_code(expr_name(beh_e), world);
                case dangerous_behavior of {
                    true -> type_checker_core@type_check_err("E4043", expr_loc(name_e), "spawn_registered: actors whose behavior uses dangerous code must be registered with spawn_dangerous_registered and an atom whose spelling begins with 'dangerous_' (spec 4.7)", "sect4");
                    false -> type_checker_core@type_check_ok()
                }
            };
            false -> type_checker_core@type_check_ok()
        }
    }
}

