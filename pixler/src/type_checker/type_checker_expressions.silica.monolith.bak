// Mirror of type_checker_core lookup_fn_type_by_name_and_module + lookup_function_type_for_call.
// Qualified calls: in-TU string return; also first_at for routing before check_call (must appear above check_call).
fn first_at_in_expr_call_name(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_expr_call_name(s, i + 1)
        }
    }
}

fn lookup_fn_type_by_name_and_module_local(env: ListSymbolEntry, fn_name: string, required_module: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case instantiated_fn_name@decl_name_matches(env.head.name, fn_name) and env.head.is_effect_alias == false of {
            true -> case len(required_module) == 0 of {
                true -> case env.head.source_module == "" of {
                    true -> env.head.type_id;
                    false -> lookup_fn_type_by_name_and_module_local(env.tail, fn_name, required_module)
                };
                false -> case env.head.source_module == required_module of {
                    true -> env.head.type_id;
                    false -> lookup_fn_type_by_name_and_module_local(env.tail, fn_name, required_module)
                }
            };
            false -> lookup_fn_type_by_name_and_module_local(env.tail, fn_name, required_module)
        }
    }
}

fn lookup_function_type_for_call_local(env: ListSymbolEntry, composite_name: string) -> string {
    at: int64 <- first_at_in_expr_call_name(composite_name, 0);
    case at < 0 of {
        true -> lookup_fn_type_by_name_and_module_local(env, composite_name, "");
        false -> lookup_fn_type_by_name_and_module_local(env, substring(composite_name, at + 1, len(composite_name)), substring(composite_name, 0, at))
    }
}

fn check_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    // Module-qualified calls (spec §19.3.2): use first_at in this TU. Routing via
    // type_checker_core@call_name_is_module_qualified misclassified on bootstrap (deep builtin chain / stack).
    // Supervisors Phase A: `spawn` / `spawn_linked` are intrinsics (§15.4.8.3); module@spawn_linked must type-check like the unqualified form.
    case first_at_in_expr_call_name(expr_name(expr), 0) >= 0 of {
        true -> {
            base: string <- type_checker_core@user_call_base_function_name(expr_name(expr));
            case base == "spawn" or base == "spawn_dangerous" or base == "spawn_registered" or base == "spawn_dangerous_registered" or base == "spawn_registered_supervisor" or base == "spawn_linked" or base == "call_supervisor" or base == "add_child" or base == "link" or base == "monitor" or base == "demonitor" or base == "supervision_ingress_enqueue" or base == "supervision_wait_and_drain_one" or base == "failure_reason_tag" or base == "failure_reason_atom" or base == "failure_agent_type" or base == "failure_release" or base == "start_child" or base == "child_table_first_ref" or base == "child_table_row_ref" or base == "kill_abnormal" or base == "wait_for_exit" or base == "get_registry_actor" or base == "get_pid_registry" or base == "call_registered" or base == "cast_registered" or base == "cast_dangerous_registered" of {
                true -> check_actor_concurrency_call(expr, expected_type, context, world);
                false -> check_user_defined_call(expr, expected_type, context, world)
            }
        };
        false -> check_call_builtins_dispatch(expr, expected_type, context, world)
    }
}

// User-defined function call: lookup in symbol table, parse function type "(T1,T2) -> R", check args and result
// Top-level `->` only: parameter types may contain nested `fn(...) -> ...`; naive substring match on ` -> ` splits there first.
fn outer_arrow_token_pos_call(func_type: string) -> int64 {
    type_checker_expressions_identifiers@find_arrow_idf(func_type, 0, 0, 0, 0)
}

fn trim_trailing_spaces_user_call_from(s: string, i: int64) -> string {
    case i <= 0 of {
        true -> "";
        false -> case substring(s, i - 1, i) == " " of {
            true -> trim_trailing_spaces_user_call_from(s, i - 1);
            false -> substring(s, 0, i)
        }
    }
}

fn trim_trailing_spaces_user_call(s: string) -> string {
    trim_trailing_spaces_user_call_from(s, len(s))
}

fn params_part_before_outer_arrow_call(func_type: string) -> string {
    arrow_at: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_at < 0 of {
        true -> "";
        false -> trim_trailing_spaces_user_call(trim_leading_user_call(substring(func_type, 0, arrow_at)))
    }
}

fn is_function_type_user_call(type_str: string) -> bool {
    outer_arrow_token_pos_call(type_str) >= 0
}

// Find first comma at depth 0 (top level). Respects parentheses, brackets, and braces in type strings
// so that a single tuple parameter like (int64, int64), ref(R, Space, T), or { x: int64, y: int64 } counts as 1 param.
fn find_top_level_comma_user_call(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == "(" or substring(s, i, i + 1) == "[" or substring(s, i, i + 1) == "{" of {
            true -> find_top_level_comma_user_call(s, i + 1, depth + 1);
            false -> case substring(s, i, i + 1) == ")" or substring(s, i, i + 1) == "]" or substring(s, i, i + 1) == "}" of {
                true -> case depth <= 0 of {
                    true -> len(s);
                    false -> find_top_level_comma_user_call(s, i + 1, depth - 1)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> i;
                        false -> find_top_level_comma_user_call(s, i + 1, depth)
                    };
                    false -> find_top_level_comma_user_call(s, i + 1, depth)
                }
            }
        }
    }
}

fn trim_leading_user_call(s: string) -> string {
    trim_leading_user_call_from(s, 0)
}

fn trim_leading_user_call_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_leading_user_call_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

fn parse_function_param_count(func_type: string) -> int64 {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> 0;
        false -> {
            params_part: string <- params_part_before_outer_arrow_call(func_type);
            case len(params_part) < 1 of {
                true -> 0;
                false -> case substring(params_part, 0, 1) == "(" and substring(params_part, len(params_part) - 1, len(params_part)) == ")" of {
                    true -> {
                        inner: string <- trim_leading_user_call(substring(params_part, 1, len(params_part) - 1));
                        case len(inner) == 0 of {
                            true -> 0;
                            false -> parse_param_count_inner(inner)
                        }
                    };
                    false -> {
                        inner_np: string <- trim_leading_user_call(params_part);
                        case len(inner_np) == 0 of {
                            true -> 0;
                            false -> parse_param_count_inner(inner_np)
                        }
                    }
                }
            }
        }
    }
}

fn parse_param_count_inner(inner: string) -> int64 {
    comma1: int64 <- find_top_level_comma_user_call(inner, 0, 0);
    case comma1 >= len(inner) of {
        true -> 1;
        false -> {
            rest: string <- trim_leading_user_call(substring(inner, comma1 + 1, len(inner)));
            case len(rest) == 0 of {
                true -> 2;
                false -> 1 + parse_param_count_inner(rest)
            }
        }
    }
}

fn parse_function_return_type(func_type: string) -> string {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> "";
        false -> trim_leading_user_call(substring(func_type, arrow_pos + 2, len(func_type)))
    }
}

fn get_params_inner_from_func_type(func_type: string) -> string {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> "";
        false -> {
            params_part: string <- params_part_before_outer_arrow_call(func_type);
            case len(params_part) < 1 of {
                true -> "";
                false -> case substring(params_part, 0, 1) == "(" and substring(params_part, len(params_part) - 1, len(params_part)) == ")" of {
                    true -> trim_leading_user_call(substring(params_part, 1, len(params_part) - 1));
                    false -> trim_leading_user_call(params_part)
                }
            }
        }
    }
}

fn get_first_param_type(params_inner: string) -> (string, string) {
    case len(params_inner) == 0 of {
        true -> ("", "");
        false -> {
            comma_pos: int64 <- find_top_level_comma_user_call(params_inner, 0, 0);
            case comma_pos >= len(params_inner) of {
                true -> (trim_leading_user_call(params_inner), "");
                false -> {
                    first: string <- trim_leading_user_call(substring(params_inner, 0, comma_pos));
                    rest: string <- trim_leading_user_call(substring(params_inner, comma_pos + 1, len(params_inner)));
                    (first, rest)
                }
            }
        }
    }
}

// Args after the first: kind-4 chain nodes only; anything else (non--1, non-4) does not add args (avoids counting 2 for a single-arg call when the tail is not dummy).
fn count_additional_call_args_user_call(er: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case expr_kind(er) == -1 of {
        true -> 0;
        false -> case expr_kind(er) == 4 of {
            true -> 1 + count_additional_call_args_user_call(expr_child_right(er));
            false -> 0
        }
    }
}

fn count_call_args_user_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case expr_kind(expr_child_inner(expr)) == -1 of {
        true -> 0;
        false -> 1 + count_additional_call_args_user_call(expr_child_right(expr))
    }
}

// Local helper (same as type_checker_modules / type_checker_callee_env list_param_length). Avoid importing type_checker_modules (declarations_functions → … → expressions cycle).
fn list_param_length_call(ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_length_call(ps.tail)
    }
}

// First tag-0 match with same name/arity (legacy fallback when receiver type is unknown or no overload fits).
fn find_function_decl_by_name_arity_call(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string, arity: int64) -> (bool, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 0 of {
            true -> case instantiated_fn_name@decl_name_matches(decls.head.name, fn_name) and list_param_length_call(decls.head.parameters) == arity of {
                true -> (true, decls.head);
                false -> find_function_decl_by_name_arity_call(decls.tail, fn_name, arity)
            };
            false -> find_function_decl_by_name_arity_call(decls.tail, fn_name, arity)
        }
    }
}

fn qualified_call_first_arg_matches_decl(inferred: string, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> bool {
    source_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@list_param_reverse_with_acc(decl.parameters, parser_ast@nil_list_param());
    case source_params.is_nil of {
        true -> false;
        false -> {
            expect: string <- type_checker_traits@trim_type_text(source_params.head.type_name);
            act: string <- type_checker_traits@trim_type_text(inferred);
            case act == expect of {
                true -> true;
                false -> case type_checker_lists@formal_type_accepts_actual(act, expect, world) of {
                    true -> true;
                    false -> dispatch_actual_fits_impl_parameter(act, expect, world)
                }
            }
        }
    }
}

fn qualified_call_first_arg_exact_matches_decl(inferred: string, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> bool {
    source_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@list_param_reverse_with_acc(decl.parameters, parser_ast@nil_list_param());
    case source_params.is_nil of {
        true -> false;
        false -> {
            expect: string <- type_checker_traits@trim_type_text(source_params.head.type_name);
            act: string <- type_checker_traits@trim_type_text(inferred);
            case type_checker_lists@types_equal_strip(act, expect) of {
                true -> true;
                false -> type_checker_tuple_decompose_helpers@types_equal_surface(act, expect)
            }
        }
    }
}

fn qualified_call_return_matches_expected(expected_ty: string, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> bool {
    case len(expected_ty) == 0 of {
        true -> true;
        false -> case expected_ty == "discard" of {
            true -> true;
            false -> {
                ret: string <- type_checker_traits@trim_type_text(decl.return_type_name);
                exp: string <- type_checker_traits@trim_type_text(expected_ty);
                case type_checker_lists@formal_type_accepts_actual(ret, exp, world) of {
                    true -> true;
                    false -> case type_checker_lists@formal_type_accepts_actual(exp, ret, world) of {
                        true -> true;
                        false -> type_checker_lists@types_equal_strip(ret, exp)
                    }
                }
            }
        }
    }
}

fn decl_exact_matches_qualified_call_target(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, fn_name: string, arity: int64, recv_ty: string, expected_ty: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> bool {
    case decl.tag == 0 of {
        false -> false;
        true -> case instantiated_fn_name@decl_name_matches(expr_name(decl), fn_name) and list_param_length_call(decl.parameters) == arity of {
            false -> false;
            true -> case len(recv_ty) == 0 of {
                true -> false;
                false -> case qualified_call_first_arg_exact_matches_decl(recv_ty, decl) of {
                    false -> false;
                    true -> qualified_call_return_matches_expected(expected_ty, decl, world)
                }
            }
        }
