                        false -> ret_rec;
                        true -> case decl.return_type_name == "unit" of {
                            true -> type_checker_core@type_check_err("E2006", decl.return_type_location, "unit is not a valid return type", "sect4");
                            false -> case type_checker_memory_regions@is_memory_region_type(decl.return_type_name) of {
                                true -> {
                                    mem_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_memory_regions@validate_memory_region_type(decl.return_type_name, decl.return_type_location);
                                    case mem_result.is_ok of {
                                        false -> mem_result;
                                        true -> {
                    (r, _) <- check_expr_surface(decl.body, decl.return_type_name, ctx_params, world);
                    r
                }
                                    }
                                };
                                false -> {
                    (r, _) <- check_expr_surface(decl.body, decl.return_type_name, ctx_params, world);
                    r
                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// §19.3.2: for `module@fn(args)`, resolve callee in `world` (includes the current module). Overloads share name/arity; pick by inferred first-argument type, then required trait signature (tag 7), then first tag-0 match.
fn try_resolve_qualified_call_func_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> (bool, string) {
    at: int64 <- first_at_in_expr_call_name(expr_name(expr), 0);
    case at < 0 of {
        true -> (false, "");
        false -> {
            mod_id: string <- substring(expr_name(expr), 0, at);
            fn_id: string <- substring(expr_name(expr), at + 1, len(expr_name(expr)));
            resolved_fn: string <- instantiated_fn_name@resolve_call_fn_name(fn_id, expr_value(expr));
            ac: int64 <- count_call_args_user_call(expr);
            (pf: bool, pprog: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- parser_ast@find_named_program(mod_id, world);
            case pf of {
                false -> (false, "");
                true -> {
                    recv_ty: string <- case ac > 0 of {
                        true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                        false -> ""
                    };
                    (df0: bool, d0: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_tag0_decl_for_qualified_call(pprog.declarations, resolved_fn, ac, recv_ty, expected_type, world);
                    case df0 of {
                        true -> (true, build_function_type_for_decl_call(d0));
                        false -> {
                            (df7: bool, d7: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_tag7_decl_for_qualified_call(pprog.declarations, resolved_fn, ac, recv_ty, expected_type, world);
                            case df7 of {
                                true -> (true, build_function_type_for_decl_call(d7));
                                false -> {
                                    (df: bool, ddecl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_function_decl_by_name_arity_call(pprog.declarations, resolved_fn, ac);
                                    case df of {
                                        true -> (true, build_function_type_for_decl_call(ddecl));
                                        false -> case ac == 0 of {
                                            true -> {
                                                (df1: bool, d1: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_function_decl_by_name_arity_call(pprog.declarations, resolved_fn, 1);
                                                case df1 of {
                                                    true -> (true, build_function_type_for_decl_call(d1));
                                                    false -> (false, "")
                                                }
                                            };
                                            false -> (false, "")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_user_call_result_user_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, return_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    receiver_resolved_return: string <- type_checker_collections@resolve_constructor_call_formal(expected_type, return_type);
    resolved_return: string <- type_checker_collections@resolve_accumulator_call_formal(expected_type, receiver_resolved_return);
    constructor_module: string <- type_checker_collections@module_name_from_qualified_call(expr_name(expr));
    registered_collection_constructor: bool <- type_checker_collections@is_collection_constructor_base_name(expr_name(expr)) and type_checker_collections@is_registered_construction_module(constructor_module);
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
        true -> type_checker_core@type_check_ok();
        false -> case type_checker_collections@is_collection_trait_type(expected_type) of {
            true -> case type_checker_collections@collection_return_accepts_constructor(expected_type, resolved_return, world) of {
                false -> type_checker_core@type_check_err("E2017", expr_loc(expr), concat(concat(concat(concat(expr_name(expr), " return type does not witness declared collection type "), expected_type), " (got "), concat(resolved_return, ")")), "sect4");
                true -> type_checker_core@type_check_ok()
            };
            false -> case registered_collection_constructor and type_checker_collections@runtime_record_accepts_constructor_return(expected_type, resolved_return, world) of {
                true -> type_checker_core@type_check_ok();
                false -> case type_checker_lists@formal_type_accepts_actual(resolved_return, expected_type, world) of {
                    true -> type_checker_core@type_check_ok();
                    false -> case type_checker_lists@formal_type_accepts_actual(expected_type, resolved_return, world) of {
                        true -> type_checker_core@type_check_ok();
                        false -> case type_checker_lists@types_equal_strip(expected_type, resolved_return) of {
                            true -> type_checker_core@type_check_ok();
                            false -> case trim_leading_user_call(expected_type) == "string" and return_type_has_ptr_len_out_fields(resolved_return) of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_traits@actual_type_satisfies_trait_expectation(resolved_return, expected_type, world) of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(concat(expr_name(expr), " returns "), resolved_return), ", expected "), expected_type), "sect6")
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn return_type_text_contains(s: string, needle: string) -> bool {
    case len(needle) == 0 of {
        true -> true;
        false -> case len(s) < len(needle) of {
            true -> false;
            false -> case substring(s, 0, len(needle)) == needle of {
                true -> true;
                false -> return_type_text_contains(substring(s, 1, len(s)), needle)
            }
        }
    }
}

fn return_type_has_ptr_len_out_fields(return_type: string) -> bool {
    ret: string <- trim_leading_user_call(return_type);
    case return_type_text_contains(ret, "text_ptr") of {
        true -> return_type_text_contains(ret, "text_len");
        false -> case return_type_text_contains(ret, "_ptr") of {
            true -> return_type_text_contains(ret, "_len");
            false -> false
        }
    }
}

fn params_inner_is_ptr_len_pair(params_inner: string) -> bool {
    (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
    (second_param: string, rest_rest: string) <- get_first_param_type(rest_params);
    case len(rest_rest) > 0 of {
        true -> false;
        false -> trim_leading_user_call(first_param) == "uint8" and trim_leading_user_call(second_param) == "uint64"
    }
}

fn check_user_call_args_recursive(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, params_inner: string, expected_type: int64, return_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(expr_child_inner(expr)) == -1 of {
        true -> case len(params_inner) == 0 of {
            true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world);
            false -> type_checker_core@type_check_err("E2005", expr_loc(call_expr), concat(expr_name(call_expr), " argument count mismatch"), "sect6")
        };
        false -> {
            (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
            case len(first_param) == 0 of {
                true -> type_checker_core@type_check_err("E2005", expr_loc(call_expr), concat(expr_name(call_expr), " argument count mismatch"), "sect6");
                false -> {
                    arg_inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                    formal_bind: string <- case type_checker_collections@is_collection_trait_type(expected_type) of {
                        true -> expected_type;
                        false -> case type_checker_collections@bind_type_has_collection_runtime_fields(expected_type) of {
                            true -> expected_type;
                            false -> case len(arg_inferred) > 0 of {
                                true -> arg_inferred;
                                false -> expected_type
                            }
                        }
                    };
                    resolved_param: string <- type_checker_collections@resolve_constructor_call_formal(formal_bind, first_param);
                    (r1, _) <- check_expr_surface(expr_child_inner(expr), resolved_param, context, world);
                    case r1.is_ok of {
                        false -> r1;
                        true -> case len(rest_params) == 0 of {
                            true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world);
                            false -> case expr_kind(expr_child_right(expr)) == -1 of {
                                true -> type_checker_core@type_check_err("E2005", expr_loc(call_expr), concat(expr_name(call_expr), " argument count mismatch"), "sect6");
                                false -> case expr_kind(expr_child_right(expr)) == 4 of {
                                    true -> case len(rest_params) == 0 of {
                                        true -> type_checker_core@type_check_err("E2005", expr_loc(call_expr), concat(expr_name(call_expr), " argument count mismatch"), "sect6");
                                        false -> check_user_call_args_recursive(expr_child_right(expr), rest_params, expected_type, return_type, context, call_expr, world)
                                    };
                                    false -> {
                                        (second_param: string, rest_rest: string) <- get_first_param_type(rest_params);
                                        case len(second_param) == 0 or len(rest_rest) > 0 of {
                                            true -> type_checker_core@type_check_err("E2005", expr_loc(call_expr), concat(expr_name(call_expr), " argument count mismatch"), "sect6");
                                            false -> {
                                                (r2, _) <- check_expr_surface(expr_child_right(expr), second_param, context, world);
                                                case r2.is_ok of {
                                                    false -> r2;
                                                    true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_user_defined_world_call_with_inference(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, params_inner: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    arg_inferred: string <- case count_call_args_user_call(expr) > 0 of {
        true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
        false -> ""
    };
    formal_bind: string <- case type_checker_collections@is_collection_trait_type(expected_type) of {
        true -> expected_type;
        false -> case type_checker_collections@bind_type_has_collection_runtime_fields(expected_type) of {
            true -> expected_type;
            false -> case len(arg_inferred) > 0 of {
                true -> arg_inferred;
                false -> expected_type
            }
        }
    };
    params_from_receiver: string <- type_checker_collections@resolve_constructor_call_formal(formal_bind, params_inner);
    return_from_receiver: string <- type_checker_collections@resolve_constructor_call_formal(formal_bind, return_type);
    // Collection witnesses resolve ItemType/KeyType/ValueType from argument
    // one.  AccType is independent and is witnessed by the expected result
    // type.  When the result is discarded, infer it from the initial
    // accumulator (argument two) instead; discarding a fold result must not
    // erase the callback's concrete signature.
    // AccType in callee formals is witnessed by the call's expected result, or —
    // when the result is discarded / still the AccType placeholder (trait impl
    // bodies) — by the concrete initial-accumulator argument.
    acc_witness: string <- case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() or type_checker_core@surface_for_type_id(context, expected_type) == "AccType" of {
        true -> case count_call_args_user_call(expr) >= 2 of {
            true -> {
                from_init: string <- type_checker_tuple_decompose_helpers@infer_expr_type(call_second_arg_expr(expr), context);
                case len(from_init) > 0 and from_init != "AccType" of {
                    true -> from_init;
                    false -> expected_type
                }
            };
            false -> expected_type
        };
        false -> expected_type
    };
    params_use: string <- type_checker_collections@resolve_accumulator_call_formal(acc_witness, params_from_receiver);
    resolved_return: string <- type_checker_collections@resolve_accumulator_call_formal(acc_witness, return_from_receiver);
    at: int64 <- first_at_in_expr_call_name(expr_name(expr), 0);
    case at < 0 of {
        true -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world);
        false -> {
            mod_id: string <- substring(expr_name(expr), 0, at);
            fn_id: string <- substring(expr_name(expr), at + 1, len(expr_name(expr)));
            ac: int64 <- count_call_args_user_call(expr);
            (pf: bool, pprog: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- parser_ast@find_named_program(mod_id, world);
            case pf of {
                false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world);
                true -> {
                    recv_ty: string <- case ac > 0 of {
                        true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                        false -> ""
                    };
                    (pfd: bool, callee_decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_qualified_call_resolved_declaration(pprog, fn_id, expr_value(expr), ac, recv_ty, expected_type, world);
                    case pfd of {
                        false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world);
                        true -> case callee_decl.tag == 0 of {
                            false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world);
                                true -> case params_use != params_inner of {
                                true -> {
                                    chk_args: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_user_call_args_recursive(expr, params_use, expected_type, resolved_return, context, expr, world);
                                    case chk_args.is_ok of {
                                        false -> chk_args;
                                        true -> check_user_call_result_user_call(expr, expected_type, resolved_return, context, world)
                                    }
                                };
                                false -> {
                                    // Collection bind types must witness ItemType/KeyType/ValueType inside
                                    // constructor formals (e.g. OrderedMap[...] <- wbt_map@empty({...})).
                                    col_ctx: string <- case type_checker_collections@is_collection_trait_type(expected_type) of {
                                        true -> expected_type;
                                        false -> ""
                                    };
                                    params_lr: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@list_param_reverse_with_acc(callee_decl.parameters, parser_ast@nil_list_param());
                                    (inf_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, inf_left: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- infer_trait_site_call_args_walk(expr, params_lr, context, world, expr, pprog, trait_arg_walk_state(col_ctx, "", 0));
                                    case inf_ok.is_ok of {
                                        false -> inf_ok;
                                        true -> {
                                            params_inner_inf: string <- inferred_types_concat_comma(inf_left);
                                            chk_args: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_user_call_args_recursive(expr, params_inner_inf, expected_type, return_type, context, expr, world);
                                            case chk_args.is_ok of {
                                                false -> chk_args;
                                                true -> {
                                                    conc_decl: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@list_param_reverse_with_acc(inf_left, parser_ast@nil_list_param());
                                                    body_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_callsite_body_with_concrete_params(callee_decl, world, conc_decl, mod_id, pprog);
                                                    case body_ok.is_ok of {
                                                        false -> body_ok;
                                                        true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_user_defined_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    (rw: bool, ft_world: string) <- try_resolve_qualified_call_func_type(expr, expected_type, world, context);
    local_name: string <- instantiated_fn_name@resolve_call_fn_name(expr_name(expr), expr_value(expr));
    resolved_type: string <- case rw of {
        true -> ft_world;
        false -> lookup_function_type_for_call_local(context.env, local_name)
    };
    case len(resolved_type) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("unknown or unsupported function: ", expr_name(expr)), "sect6");
        false -> case is_function_type_user_call(resolved_type) of {
            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " is not a function"), "sect6");
            true -> check_user_defined_call_parsed(expr, expected_type, context, resolved_type, world, rw)
        }
    }
}

fn check_user_defined_call_parsed(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, func_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], callee_type_from_world: bool) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    func_type_canon: string <- type_checker_expressions_identifiers@normalize_fn_type_idf(func_type);
    expected_arg_count: int64 <- parse_function_param_count(func_type_canon);
    params_inner: string <- get_params_inner_from_func_type(func_type_canon);
    return_type: string <- parse_function_return_type(func_type_canon);
    arg_count: int64 <- count_call_args_user_call(expr);
    case callee_type_from_world of {
        true -> check_user_defined_world_call_with_inference(expr, expected_type, context, params_inner, return_type, world);
                false -> case arg_count != expected_arg_count of {
        true -> case expected_arg_count == 2 and arg_count == 1 and params_inner_is_ptr_len_pair(params_inner) of {
            true -> {
                (r_str, _) <- check_expr_surface(expr_child_inner(expr), "string", context, world);
                case r_str.is_ok of {
                    false -> r_str;
                    true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
                }
            };
            false -> case expected_arg_count == 1 of {
            true -> case arg_count == 2 of {
                true -> case len(params_inner) >= 2 of {
                    true -> case substring(params_inner, 0, 1) == "(" of {
                        true -> case substring(params_inner, len(params_inner) - 1, len(params_inner)) == ")" of {
                            true -> check_user_call_two_args_as_tuple(expr, params_inner, expected_type, return_type, context, world);
                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6")
                        };
                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6")
                    };
                    false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6")
                };
                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6")
            };
            false -> case expected_arg_count == 2 of {
                true -> case arg_count == 1 of {
                    true -> case expr_kind(expr_child_inner(expr)) == 9 of {
                        true -> check_user_call_one_tuple_as_two_args(expr, params_inner, expected_type, return_type, context, world);
                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6")
                    };
                    false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6")
                };
                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6")
            }
            }
        };
        false -> check_user_call_args_recursive(expr, params_inner, expected_type, return_type, context, expr, world)
        }
    }
}

fn check_user_call_one_tuple_as_two_args(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, params_inner: string, expected_type: int64, return_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
    (second_param: string, _: string) <- get_first_param_type(rest_params);
    case len(first_param) == 0 or len(second_param) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6");
        false -> {
            tuple_type: string <- concat(concat(concat(concat("(", first_param), ","), second_param), ")");
            (r1, _) <- check_expr_surface(expr_child_inner(expr), tuple_type, context, world);
            case r1.is_ok of {
                false -> r1;
                true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
            }
        }
    }
}

fn check_user_call_two_args_as_tuple(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, tuple_param: string, expected_type: int64, return_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    inner: string <- trim_leading_user_call(substring(tuple_param, 1, len(tuple_param) - 1));
    comma_pos: int64 <- find_top_level_comma_user_call(inner, 0, 0);
    case comma_pos >= len(inner) of {
        true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(expr_name(expr), " argument count mismatch"), "sect6");
        false -> {
            first_type: string <- trim_leading_user_call(substring(inner, 0, comma_pos));
            second_type: string <- trim_leading_user_call(substring(inner, comma_pos + 1, len(inner)));
            (r1, _) <- check_expr_surface(expr_child_inner(expr), first_type, context, world);
            case r1.is_ok of {
                false -> r1;
                true -> {
                    (r2, _) <- check_expr_surface(expr_child_right(expr), second_type, context, world);
                    case r2.is_ok of {
                        false -> r2;
                        true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
                    }
                }
            }
        }
    }
}

fn is_collection_constructor_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> bool {
    type_checker_collections@is_collection_constructor_base_name(expr_name(expr))
}

fn constructor_functions_record_expr(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case type_checker_core@user_call_base_function_name(expr_name(rhs)) of {
        "empty" -> expr_child_inner(rhs);
        "with_root" -> expr_child_inner(rhs);
        _: string -> call_second_arg_expr(rhs)
    }
}

fn verify_collection_witness_for_family(bind_type: string, record_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, location: { file: string, line: int64, column: int64, offset: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_collections@is_ordered_set_type(bind_type) of {
        true -> {
            wit_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
            set_wit: string <- case len(wit_from_arg) > 0 of {
                true -> wit_from_arg;
                false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world)
            };
            case len(set_wit) == 0 of {
                true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                false -> type_checker_collections@witness_matches_ordered_set_declaration(bind_type, set_wit, location)
            }
        };
        false -> case type_checker_collections@is_search_tree_type(bind_type) of {
            true -> {
                wit_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                set_wit: string <- case len(wit_from_arg) > 0 of { true -> wit_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                case len(set_wit) == 0 of {
                    true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                    false -> type_checker_collections@witness_matches_search_tree_declaration(bind_type, set_wit, location)
                }
            };
            false -> case type_checker_collections@is_tree_type(bind_type) of {
                true -> {
                    wit_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                    set_wit: string <- case len(wit_from_arg) > 0 of { true -> wit_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                    case len(set_wit) == 0 of {
                        true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                        false -> type_checker_collections@witness_matches_tree_declaration(bind_type, set_wit, location)
                    }
                };
                false -> case type_checker_collections@is_ordered_map_type(bind_type) of {
                    true -> {
                        key_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_key", context);
                        val_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_value", context);
                        key_wit: string <- case len(key_from_arg) > 0 of { true -> key_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_key", context, world) };
                        val_wit: string <- case len(val_from_arg) > 0 of { true -> val_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_value", context, world) };
                        case len(key_wit) == 0 or len(val_wit) == 0 of {
                            true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_key or compare_value witness", "sect4");
                            false -> type_checker_collections@witness_matches_ordered_map_declaration(bind_type, key_wit, val_wit, location)
                        }
                    };
                    false -> case type_checker_collections@is_heap_type(bind_type) of {
                        true -> {
                            item_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                            heap_wit: string <- case len(item_from_arg) > 0 of { true -> item_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                            case len(heap_wit) == 0 of {
                                true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_item witness", "sect4");
                                false -> type_checker_collections@witness_matches_heap_declaration(bind_type, heap_wit, location)
                            }
                        };
                        false -> case type_checker_collections@is_priority_queue_type(bind_type) of {
                            true -> {
                                pri_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_priority", context);
                                item_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_item", context);
                                pri_wit: string <- case len(pri_from_arg) > 0 of { true -> pri_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_priority", context, world) };
                                item_wit: string <- case len(item_from_arg) > 0 of { true -> item_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_item", context, world) };
                                case len(pri_wit) == 0 or len(item_wit) == 0 of {
                                    true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_priority or compare_item witness", "sect4");
                                    false -> type_checker_collections@witness_matches_priority_queue_declaration(bind_type, pri_wit, item_wit, location)
                                }
                            };
                            false -> case type_checker_collections@is_directed_graph_type(bind_type) of {
                                true -> {
                                    node_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_node", context);
                                    edge_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_edge", context);
                                    target_from_arg: string <- constructor_record_field_fn_type(record_e, "edge_target", context);
                                    node_wit: string <- case len(node_from_arg) > 0 of { true -> node_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_node", context, world) };
                                    edge_wit: string <- case len(edge_from_arg) > 0 of { true -> edge_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_edge", context, world) };
                                    target_wit: string <- case len(target_from_arg) > 0 of { true -> target_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "edge_target", context, world) };
                                    case len(node_wit) == 0 or len(edge_wit) == 0 or len(target_wit) == 0 of {
                                        true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_node, compare_edge, or edge_target witness", "sect4");
                                        false -> type_checker_collections@witness_matches_directed_graph_declaration(bind_type, node_wit, edge_wit, target_wit, location)
                                    }
                                };
                                false -> case type_checker_collections@is_undirected_graph_type(bind_type) of {
                                    true -> {
                                        node_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_node", context);
                                        edge_data_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_edge_data", context);
                                        node_wit: string <- case len(node_from_arg) > 0 of { true -> node_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_node", context, world) };
                                        edge_data_wit: string <- case len(edge_data_from_arg) > 0 of { true -> edge_data_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_edge_data", context, world) };
                                        case len(node_wit) == 0 or len(edge_data_wit) == 0 of {
                                            true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_node or compare_edge_data witness", "sect4");
                                            false -> type_checker_collections@witness_matches_undirected_graph_declaration(bind_type, node_wit, edge_data_wit, location)
                                        }
                                    };
                                    false -> case type_checker_collections@is_weighted_graph_type(bind_type) of {
                                        true -> {
                                            node_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_node", context);
                                            edge_data_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_edge_data", context);
                                            weight_from_arg: string <- constructor_record_field_fn_type(record_e, "edge_weight", context);
                                            cmp_weight_from_arg: string <- constructor_record_field_fn_type(record_e, "compare_weight", context);
                                            node_wit: string <- case len(node_from_arg) > 0 of { true -> node_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_node", context, world) };
                                            edge_data_wit: string <- case len(edge_data_from_arg) > 0 of { true -> edge_data_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_edge_data", context, world) };
                                            weight_wit: string <- case len(weight_from_arg) > 0 of { true -> weight_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "edge_weight", context, world) };
                                            cmp_weight_wit: string <- case len(cmp_weight_from_arg) > 0 of { true -> cmp_weight_from_arg; false -> empty_call_constructor_witness_fn_type(rhs, "compare_weight", context, world) };
                                            case len(node_wit) == 0 or len(edge_data_wit) == 0 or len(weight_wit) == 0 or len(cmp_weight_wit) == 0 of {
                                                true -> type_checker_core@type_check_err("E2017", location, "constructor record missing compare_node, compare_edge_data, edge_weight, or compare_weight witness", "sect4");
                                                false -> type_checker_collections@witness_matches_weighted_graph_declaration(bind_type, node_wit, edge_data_wit, weight_wit, cmp_weight_wit, location)
                                            }
                                        };
                                        false -> type_checker_core@type_check_err("E2017", location, "unsupported collection constructor binding type", "sect4")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn verify_collection_constructor_witness(bind_type: string, rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, location: { file: string, line: int64, column: int64, offset: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case expr_kind(rhs) == 4 of {
        false -> type_checker_core@type_check_err("E2017", location, "collection constructor binding requires a call to empty/1 or with_root/2", "sect4");
        true -> case is_collection_constructor_call(rhs) of {
            false -> type_checker_core@type_check_err("E2017", location, "collection constructor binding requires a call to empty/1 or with_root/2", "sect4");
            true -> {
                mod_name: string <- type_checker_collections@module_name_from_qualified_call(expr_name(rhs));
                case len(mod_name) == 0 of {
                    true -> type_checker_core@type_check_err("E2017", location, "collection constructor requires qualified module@empty or module@with_root call", "sect4");
                    false -> case type_checker_collections@is_registered_construction_module(mod_name) of {
                        false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("module ", mod_name), " is not a registered collection construction module for binding type "), bind_type), ""), "sect4");
                        true -> case type_checker_collections@collection_trait_accepts_module(bind_type, mod_name) of {
                            false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("module ", mod_name), " does not match collection binding type "), bind_type), ""), "sect4");
                            true -> {
                                record_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- constructor_functions_record_expr(rhs);
                                fields_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_collections@validate_constructor_record_field_names(bind_type, record_e, location);
                                case fields_ok.is_ok of {
                                    false -> fields_ok;
                                    true -> verify_collection_witness_for_family(bind_type, record_e, context, location, world, rhs)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn constructor_record_field_fn_type(record_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    case expr_kind(record_expr) == 21 of {
        true -> case expr_name(record_expr) == field of {
            true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(record_expr), context);
            false -> constructor_record_field_fn_type(expr_child_right(record_expr), field, context)
        };
        false -> {
            inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(record_expr, context);
            case len(inferred) > 0 of {
                true -> type_checker_record_types@find_field_type_in_record(inferred, field);
                false -> case expr_kind(record_expr) == 1 of {
                    true -> {
                        (found: boolean, _: int64) <- type_checker_core@lookup_symbol_found(context.env, expr_name(record_expr));
                        var_type: string <- type_checker_core@lookup_symbol_surface(context.env, expr_name(record_expr));
                        case found of {
                            false -> "";
                            true -> type_checker_record_types@find_field_type_in_record(var_type, field)
                        }
                    };
                    false -> ""
                }
            }
        }
    }
}

fn empty_call_constructor_witness_fn_type(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> string {
    (rw: bool, func_type: string) <- try_resolve_qualified_call_func_type(rhs, "discard", world, context);
    case rw of {
        false -> "";
        true -> {
            func_type_canon: string <- type_checker_expressions_identifiers@normalize_fn_type_idf(func_type);
            params_inner: string <- get_params_inner_from_func_type(func_type_canon);
            (first_param: string, _: string) <- get_first_param_type(params_inner);
            case len(first_param) == 0 of {
                true -> "";
                false -> type_checker_record_types@find_field_type_in_record(first_param, field)
            }
        }
    }
}

fn check_collection_trait_let(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, bind_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    // Pass the declared collection type (OrderedMap[...], OrderedSet[...], ...) so
    // KeyType/ValueType/ItemType inside constructor formals are witnessed. Checking
    // with "discard" leaves those placeholders unresolved for generic empty/1.
    (rhs_result, _) <- check_expr_surface(expr_child_inner(expr), bind_type, context, world);
    case rhs_result.is_ok of {
        false -> rhs_result;
        true -> {
            witness_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- verify_collection_constructor_witness(bind_type, expr_child_inner(expr), context, expr_loc(expr), world);
            case witness_result.is_ok of {
                false -> witness_result;
                true -> {
                    bound_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@context_add_symbol_surface(context, expr_name(expr), bind_type, parser_ast@empty_effect_name_list(), "");
                    new_env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- enrich_env_for_actor_spawn(bound_ctx.env, expr_name(expr), bind_type, expr_child_inner(expr), context);
                    new_context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@type_context_with_env(bound_ctx, new_env);
                    (body_result, _) <- check_expr(expr_child_right(expr), expected_type, new_context, world);
                    body_result
                }
            }
        }
    }
}

// Let binding: name: type <- rhs; body. Check rhs has declared type, add to env, check body.
// Reject unit for named variables; allow _ : unit <- expr (discard pattern for expression statements).
// Memory region types (ref, region, buf) are validated before type checking.
// Untyped `name <- rhs` (empty annotation) is a type error (E2018), not a parse defect.
fn check_let(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    bind_type: string <- expr_value(expr);
    case len(bind_type) == 0 of {
        true -> type_checker_core@type_check_err("E2018", expr_loc(expr), concat(concat("variable binding '", expr_name(expr)), "' must have an explicit type annotation; write 'name: <type> <- ...'"), "sect8.3.1");
        false -> {
            list_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_lists@validate_list_type_declaration(bind_type, expr_loc(expr));
            case list_result.is_ok of {
                false -> list_result;
                true -> {
                    col_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_collections@validate_collection_type_declaration(bind_type, expr_loc(expr));
                    case col_result.is_ok of {
                        false -> col_result;
                        true -> {
                            result_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_collections@validate_collection_result_type_declaration(bind_type, expr_loc(expr));
                            case result_result.is_ok of {
                                false -> result_result;
                                true -> {
                                    rec_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_recursive_tuples@validate_recursive_type_declaration(bind_type, expr_loc(expr));
                                    case rec_result.is_ok of {
                                        false -> rec_result;
                                        true -> case type_checker_memory_regions@is_memory_region_type(bind_type) of {
                                            true -> check_let_memory_region(expr, expected_type, context, bind_type, world);
                                            false -> case type_checker_collections@is_collection_trait_type(bind_type) of {
                                                true -> check_collection_trait_let(expr, expected_type, context, bind_type, world);
                                                false -> check_let_after_validation(expr, expected_type, context, bind_type, world)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_let_memory_region(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, bind_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    mem_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_memory_regions@validate_memory_region_type_in_context(bind_type, expr_loc(expr), context);
    case mem_result.is_ok of {
        false -> mem_result;
        true -> check_let_after_validation(expr, expected_type, context, bind_type, world)
    }
}

// When a let-binding creates an actor_ref from spawn (or dangerous_actor_ref from spawn_dangerous),
// record the behavior function type and enforce region move semantics (§12.1.5).
fn enrich_env_for_actor_spawn(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], var_name: string, bind_type: string, rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] {
    rhs_base: string <- type_checker_core@user_call_base_function_name(expr_name(rhs));
    spawn_pair_ok: bool <- case bind_type == "actor_ref" and rhs_base == "spawn" of {
        true -> true;
        false -> case bind_type == "dangerous_actor_ref" and rhs_base == "spawn_dangerous" of {
            true -> true;
            false -> bind_type == "dangerous_actor_ref" and rhs_base == "spawn_dangerous_registered"
        }
    };
    case expr_kind(rhs) == 4 and spawn_pair_ok of {
        true -> {
            beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_behavior_expr(rhs);
            env1: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- case expr_kind(beh_e) == 1 of {
                true -> {
                    (beh_found: boolean, beh_id: int64) <- type_checker_core@lookup_symbol_found(context.env, expr_name(beh_e));
                    beh_type: string <- type_checker_core@lookup_symbol_surface(context.env, expr_name(beh_e));
                    case beh_found of {
                        true -> {
                            env_beh: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- type_checker_core@add_symbol(env, concat("__actor_beh__", var_name), beh_id, beh_type, parser_ast@empty_effect_name_list(), "");
                            state_t: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_type);
                            sup_csv: string <- type_checker_core@lookup_supervisor_csv(context);
                            case type_checker_core@type_name_in_supervisor_csv(state_t, sup_csv) or len(sup_csv) > 0 of {
                                true -> {
                                    bool_p: { context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, id: int64, ok: boolean } <- type_checker_core@parse_type_into_context(context, "boolean");
                                    type_checker_core@add_symbol(env_beh, actor_ref_supervisor_marker_name(var_name), bool_p.id, "boolean", parser_ast@empty_effect_name_list(), "")
                                };
                                false -> env_beh
                            }
                        };
                        false -> env
                    }
                };
                false -> env
            };
            state_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- expr_child_inner(rhs);
            case expr_kind(state_e) == 1 of {
                true -> {
                    (st_found: boolean, _: int64) <- type_checker_core@lookup_symbol_found(context.env, expr_name(state_e));
                    st_type: string <- type_checker_core@lookup_symbol_surface(context.env, expr_name(state_e));
                    case st_found and type_checker_memory_regions@is_memory_region_type(st_type) of {
                        true -> {
                            moved_p: { context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, id: int64, ok: boolean } <- type_checker_core@parse_type_into_context(context, "moved_region");
                            type_checker_core@add_symbol(env1, expr_name(state_e), moved_p.id, "moved_region", parser_ast@empty_effect_name_list(), "")
                        };
                        false -> env1
                    }
                };
                false -> env1
            }
        };
        false -> env
    }
}

// Lambda (kind 991): formals in pattern_bindings; value = synthesized `(T1,...) -> R`; right_expr kind 992 holds return type text.
// Body is checked in a context extended with formals on top of the current env so outer bindings remain visible (closure capture).
fn lambda_formal_bindings_valid(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case bindings.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case len(bindings.head.type_str) == 0 of {
            true -> type_checker_core@type_check_err("E2006", location, "lambda parameter must have an explicit type", "sect4");
            false -> lambda_formal_bindings_valid(bindings.tail, location)
        }
    }
}

fn check_lambda_expression(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    formal_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- lambda_formal_bindings_valid(expr_pattern_bindings(expr), expr_loc(expr));
    case formal_ok.is_ok of {
        false -> formal_ok;
        true -> {
            ret_ty: string <- expr_value(expr_child_right(expr));
            inner_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_tuple_decompose_helpers@add_bindings_to_context(context, expr_pattern_bindings(expr));
            case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                true -> {
                        (r, _) <- check_expr_surface(expr_child_inner(expr), ret_ty, inner_ctx, world);
                        r
                    }
                false -> {
                    synth: string <- expr_value(expr);
                    expect_surf: string <- type_checker_core@surface_for_type_id(context, expected_type);
                    compat: bool <- type_checker_expressions_identifiers@function_types_compatible_first_class_closure(synth, expect_surf);
                    case compat of {
                        false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat("lambda type ", synth), concat(" is incompatible with context ", expect_surf)), "sect6");
                        true -> {
                        (r, _) <- check_expr_surface(expr_child_inner(expr), ret_ty, inner_ctx, world);
                        r
                    }
                    }
                }
            }
        }
    }
}

fn check_let_after_validation(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, bind_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case bind_type == "unit" of {
        true -> case expr_name(expr) == "_" of {
            true -> {
                (rhs_result, _) <- check_expr_surface(expr_child_inner(expr), "discard", context, world);
                case rhs_result.is_ok of {
                    false -> rhs_result;
                    true -> {
                        (body_result, _) <- check_expr(expr_child_right(expr), expected_type, context, world);
                        body_result
                    }
                }
            };
            false -> type_checker_core@type_check_err("E2006", expr_loc(expr), "unit is not a valid type for variables or parameters", "sect4")
        };
        false -> {
            is_discard: bool <- len(expr_name(expr)) == 1 and substring(expr_name(expr), 0, 1) == "_";
            rhs_expected: string <- case is_discard of { true -> "discard"; false -> bind_type };
            (rhs_result, _) <- check_expr_surface(expr_child_inner(expr), rhs_expected, context, world);
            case rhs_result.is_ok of {
                false -> rhs_result;
                true -> {
                    bound_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@context_add_symbol_surface(context, expr_name(expr), bind_type, parser_ast@empty_effect_name_list(), "");
                    new_env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- enrich_env_for_actor_spawn(bound_ctx.env, expr_name(expr), bind_type, expr_child_inner(expr), context);
                    new_context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@type_context_with_env(bound_ctx, new_env);
                    (body_result, _) <- check_expr(expr_child_right(expr), expected_type, new_context, world);
                    body_result
                }
            }
        }
    }
}

// Build context with all bindings from sequence body (let chain and tuple decomposes).
// The produces pure expr sees variables bound in the body.
fn context_after_sequence_body(body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } {
    case expr_kind(body) == 6 of {
        true -> {
            is_discard: bool <- expr_value(body) == "unit" and expr_name(body) == "_";
            new_context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- case is_discard of {
                true -> context;
                false -> {
                    bound_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@context_add_symbol_surface(context, expr_name(body), expr_value(body), parser_ast@empty_effect_name_list(), "");
                    enriched_env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- enrich_env_for_actor_spawn(bound_ctx.env, expr_name(body), expr_value(body), expr_child_inner(body), context);
                    type_checker_core@type_context_with_env(bound_ctx, enriched_env)
                }
            };
            context_after_sequence_body(expr_child_right(body), new_context)
        };
        false -> case expr_kind(body) == 10 of {
            true -> {
                rhs_type: string <- case expr_kind(expr_child_inner(body)) == 11 of {
                    true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_right(expr_child_inner(body)), context_after_sequence_body(expr_child_inner(expr_child_inner(body)), context));
                    false -> type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(body), context)
                };
                rhs_trimmed: string <- type_checker_tuple_decompose_helpers@tuple_trim(rhs_type);
                tuple_for_fill: string <- case len(expr_value(body)) > 0 of {
                    true -> type_checker_tuple_decompose_helpers@tuple_trim(expr_value(body));
                    false -> rhs_trimmed
                };
                filled: List[{ name: string, path: string, type_str: string }, mem(normal)] <- type_checker_tuple_decompose_helpers@fill_empty_binding_types_from_rhs(expr_pattern_bindings(body), tuple_for_fill);
                extended: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_tuple_decompose_helpers@add_bindings_to_context(context, filled);
                context_after_sequence_body(expr_child_right(body), extended)
            };
            false -> context
        }
    }
}

// Sequence block (kind 11): sequence [proc[ε]] {statements} produces pure expr end
// inner = body (statements before produces), right_expr = result (pure expr); sequence_effects validated by effect checker
// The produces expr is in scope of all bindings from the body.
// Phase A lifetime analysis: when return type contains ref/buf, region must be returned (spec §12.1.4).
fn check_sequence_block(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    (body_result, _) <- check_expr_surface(expr_child_inner(expr), "discard", context, world);
    case body_result.is_ok of {
        false -> body_result;
        true -> {
            result_context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- context_after_sequence_body(expr_child_inner(expr), context);
            (expr_result, _) <- check_expr(expr_child_right(expr), expected_type, result_context, world);
            case expr_result.is_ok of {
                false -> expr_result;
                true -> type_checker_memory_regions@check_sequence_return_lifetime(expected_type, expr_loc(expr_child_right(expr)))
            }
        }
    }
}

// Parsed tuple types may spell atom slots as lexemes (:reply, :no_reply, :ok). For checking expressions, that field has type atom.
fn tuple_elem_type_for_check(field_type: string) -> string {
    case len(field_type) > 0 and substring(field_type, 0, 1) == ":" of {
        true -> "atom";
        false -> field_type
    }
}

// Tuple literal (kind 9): check against expected tuple type "(T1, T2)"
fn check_tuple_literal_inline(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case len(expect_surf(context, expected_type)) == 7 and substring(expect_surf(context, expected_type), 0, 1) == "d" and substring(expect_surf(context, expected_type), 1, 2) == "i" and substring(expect_surf(context, expected_type), 2, 3) == "s" and substring(expect_surf(context, expected_type), 3, 4) == "c" and substring(expect_surf(context, expected_type), 4, 5) == "a" and substring(expect_surf(context, expected_type), 5, 6) == "r" and substring(expect_surf(context, expected_type), 6, 7) == "d" of {
        true -> type_checker_core@type_check_ok();
        false -> case len(expect_surf(context, expected_type)) < 2 of {
            true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("tuple literal requires tuple type, got ", expect_surf(context, expected_type)), "sect4");
            false -> case substring(expect_surf(context, expected_type), 0, 1) == "(" of {
                true -> case substring(expect_surf(context, expected_type), len(expect_surf(context, expected_type)) - 1, len(expect_surf(context, expected_type))) == ")" of {
                    true -> {
                        inner: string <- substring(expect_surf(context, expected_type), 1, len(expect_surf(context, expected_type)) - 1);
                        comma_pos: int64 <- case expr_kind(expr_child_inner(expr)) == 9 of {
                            true -> tuple_find_last_top_level_comma(inner);
                            false -> tuple_find_top_level_comma(inner, 0)
                        };
                        first_type_raw: string <- substring(inner, 0, comma_pos);
                        first_type: string <- tuple_trim_leading(first_type_raw);
                        first_type_wrapped: string <- case tuple_find_top_level_comma(first_type, 0) < len(first_type) of {
                            true -> concat(concat("(", first_type), ")");
                            false -> first_type
                        };
                        rest_start: int64 <- comma_pos + 1;
                        second_type_raw: string <- case rest_start < len(inner) of {
                            true -> substring(inner, rest_start, len(inner));
                            false -> ""
                        };
                        second_type: string <- tuple_trim_leading(second_type_raw);
                        second_type_wrapped: string <- case tuple_find_top_level_comma(second_type, 0) < len(second_type) of {
                            true -> concat(concat("(", second_type), ")");
                            false -> second_type
                        };
                        first_expect: string <- tuple_elem_type_for_check(first_type_wrapped);
                        second_expect: string <- tuple_elem_type_for_check(second_type_wrapped);
                        (first_result, _) <- check_expr_surface(expr_child_inner(expr), first_expect, context, world);
                        case first_result.is_ok of {
                            false -> first_result;
                            true -> {
                                (second_result, _) <- check_expr_surface(expr_child_right(expr), second_expect, context, world);
                                second_result
                            }
                        }
                    };
                    false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("tuple literal requires tuple type, got ", expect_surf(context, expected_type)), "sect4")
                };
                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("tuple literal requires tuple type, got ", expect_surf(context, expected_type)), "sect4")
            }
        }
    }
}

fn tuple_trim_leading(s: string) -> string {
    tuple_trim_leading_from(s, 0)
}

fn tuple_trim_leading_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_leading_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

// Find first comma at top level (not inside parentheses). Handles nested tuples recursively.
fn tuple_find_top_level_comma(s: string, i: int64) -> int64 {
    tc_tuple_find_top_level_comma_from(s, i, 0, 0, 0)
}

// Top-level over paren/brace/bracket depth (all three must be 0 for a comma to split tuple components).
// Spec: `(A, B)` tuple may carry record or list components (`{...}`, `List[...]`) whose internal commas
// are not tuple separators (§3.3 / §15.4.13.2 for supervisor init return shape).
// Prefixed `tc_` to avoid collision with parser_tuples' paren-only variant under the bootstrap compiler's
// flat function namespace.
fn tc_tuple_find_top_level_comma_from(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> case paren <= 0 and brace == 0 and bracket == 0 of {
                        true -> len(s);
                        false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren - 1, brace, bracket)
                    };
                    false -> case c == "{" of {
                        true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket - 1);
                                    false -> case c == "," of {
                                        true -> case paren == 0 and brace == 0 and bracket == 0 of {
                                            true -> i;
                                            false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket)
                                        };
                                        false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Find last comma at top level (over paren/brace/bracket). For right-nested (a,(b,c)),
// inner has type (A,B), right_expr has type C; record/list components must not confuse the split.
fn tuple_find_last_top_level_comma(s: string) -> int64 {
    tc_tuple_find_last_top_level_comma_from(s, 0, 0, 0, 0, -1)
}

fn tc_tuple_find_last_top_level_comma_from(s: string, i: int64, paren: int64, brace: int64, bracket: int64, last: int64) -> int64 {
    case i >= len(s) of {
        true -> case last < 0 of { true -> len(s); false -> last };
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren + 1, brace, bracket, last);
                false -> case c == ")" of {
                    true -> case paren <= 0 and brace == 0 and bracket == 0 of {
                        true -> case last < 0 of { true -> len(s); false -> last };
                        false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren - 1, brace, bracket, last)
                    };
                    false -> case c == "{" of {
                        true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace + 1, bracket, last);
                        false -> case c == "}" of {
                            true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace - 1, bracket, last);
                            false -> case c == "[" of {
                                true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket + 1, last);
                                false -> case c == "]" of {
                                    true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket - 1, last);
                                    false -> case c == "," of {
                                        true -> case paren == 0 and brace == 0 and bracket == 0 of {
                                            true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, i);
                                            false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, last)
                                        };
                                        false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, last)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Whether expression mentions identifier `name` (for case guard rule §3.4: guard must depend on pattern bindings).
fn expr_references_name(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, name: string) -> bool {
    case expr_kind(e) < 0 of {
        true -> false;
        false -> case expr_kind(e) of {
            0 -> false;
            1 -> expr_name(e) == name;
            2 -> expr_references_name(expr_child_inner(e), name);
            3 -> expr_references_name(expr_child_inner(e), name) or expr_references_name(expr_child_right(e), name);
            4 -> expr_references_name(expr_child_inner(e), name) or expr_references_name(expr_child_right(e), name);
            5 -> false;
            6 -> expr_references_name(expr_child_inner(e), name) or expr_references_name(expr_child_right(e), name);
            7 -> false;
            8 -> false;
            9 -> expr_references_name(expr_child_inner(e), name) or expr_references_name(expr_child_right(e), name);
            10 -> expr_references_name(expr_child_inner(e), name);
            11 -> expr_references_name(expr_child_inner(e), name) or expr_references_name(expr_child_right(e), name);
            12 -> expr_references_name(expr_child_inner(e), name);
            13 -> expr_references_name(expr_child_inner(e), name) or expr_references_name(expr_child_right(e), name);
            19 -> expr_references_name(expr_child_inner(e), name) or expr_references_name(expr_child_inner(expr_child_right(e)), name) or expr_references_name(expr_child_right(expr_child_right(e)), name);
            20 -> expr_references_name(expr_child_inner(e), name) or expr_references_name(expr_child_right(e), name);
            _: int64 -> false
        }
    }
}

fn case_record_guard_refs_any(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pat_str: string, scrutinee_type: string) -> bool {
    inner: string <- type_checker_record_types@record_case_inner_body(pat_str);
    case_record_guard_refs_loop(branch, inner, scrutinee_type)
}

fn case_record_guard_refs_loop(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rem: string, scrutinee_type: string) -> bool {
    (seg: string, rest2: string) <- type_checker_record_types@record_case_field_step(rem);
    case len(seg) == 0 of {
        true -> false;
        false -> {
            (fname: string, sub: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
            case len(fname) == 0 of {
                true -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                false -> {
                    fty: string <- type_checker_record_types@find_field_type_in_record(scrutinee_type, fname);
                    case len(fty) == 0 of {
                        true -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                        false -> {
                            spi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string } <- type_checker_tuple_decompose_helpers@case_parse_record_field_subpat(sub, fty);
                            case spi.is_valid of {
                                false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                                true -> case spi.pattern_kind of {
                                    2 -> case expr_references_name(expr_child_inner(branch), spi.bind_name) of {
                                        true -> true;
                                        false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                    };
                                    8 -> case case_record_guard_refs_any(branch, spi.bind_type, fty) of {
                                        true -> true;
                                        false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                    };
                                    _: int64 -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn case_list_cons_guard_ok_expr(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string }) -> bool {
    head_bound: bool <- len(pi.bind_name) > 0 and pi.bind_name != "_";
    tail_bound: bool <- len(pi.list_tail_name) > 0 and pi.list_tail_name != "_";
    case head_bound of {
        false -> case tail_bound of {
            false -> true;
            true -> expr_references_name(expr_child_inner(branch), pi.list_tail_name)
        };
        true -> case tail_bound of {
            false -> expr_references_name(expr_child_inner(branch), pi.bind_name);
            true -> expr_references_name(expr_child_inner(branch), pi.bind_name) or expr_references_name(expr_child_inner(branch), pi.list_tail_name)
        }
    }
}

fn check_case_guard_invariant(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string }, scrutinee_type: string) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_tuple_decompose_helpers@case_pattern_has_named_binding(pi, scrutinee_type) of {
        true -> case pi.pattern_kind of {
            6 -> case case_list_cons_guard_ok_expr(branch, pi) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", expr_loc(expr_child_inner(branch)), "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            };
            8 -> case case_record_guard_refs_any(branch, pi.bind_type, scrutinee_type) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", expr_loc(expr_child_inner(branch)), "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            };
            _: int64 -> case expr_references_name(expr_child_inner(branch), type_checker_tuple_decompose_helpers@case_pattern_binding_name(pi)) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", expr_loc(expr_child_inner(branch)), "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            }
        };
        false -> type_checker_core@type_check_err("E2014", expr_loc(expr_child_inner(branch)), "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
    }
}

fn check_case_branch_guard(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string }, ext_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, scrutinee_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(expr_child_inner(branch)) < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> {
            (g, _) <- check_expr_surface(expr_child_inner(branch), "boolean", ext_ctx, world);
            case g.is_ok of {
                false -> g;
                true -> check_case_guard_invariant(branch, pi, scrutinee_type)
            }
        }
    }
}

fn check_one_case_branch(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, scrutinee_type: string, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(branch) == 18 of {
        false -> type_checker_core@type_check_err("E2005", expr_loc(branch), "malformed case branch", "sect3");
        true -> {
            pi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string } <- type_checker_tuple_decompose_helpers@case_parse_pattern(expr_value(branch));
            case pi.is_valid of {
                false -> type_checker_core@type_check_err("E2005", expr_loc(branch), "invalid or unsupported case pattern", "sect3");
                true -> {
                    pat_list_r: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_lists@validate_list_type_declaration(pi.bind_type, expr_loc(branch));
                    case pat_list_r.is_ok of {
                        false -> pat_list_r;
                        true -> {
                            tail_list_r: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_lists@validate_list_type_declaration(pi.list_tail_type, expr_loc(branch));
                            case tail_list_r.is_ok of {
                                false -> tail_list_r;
                                true -> case type_checker_tuple_decompose_helpers@case_pattern_matches_scrutinee(pi, scrutinee_type) of {
                                    false -> type_checker_core@type_check_err("E2005", expr_loc(branch), "case pattern does not match scrutinee type", "sect3");
                                    true -> {
                                        ext_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_tuple_decompose_helpers@case_extend_context_for_pattern(context, scrutinee_type, expr_value(branch));
                                        guard_r: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_case_branch_guard(branch, pi, ext_ctx, scrutinee_type, world);
                                        case guard_r.is_ok of {
                                            false -> guard_r;
                                            true -> {
                            (r, _) <- check_expr(expr_child_right(branch), expected_type, ext_ctx, world);
                            r
                        }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_case_branch_list(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, scrutinee_type: string, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, case_loc: { file: string, line: int64, column: int64, offset: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(branches) == -1 of {
        true -> type_checker_core@type_check_ok();
        false -> case expr_kind(branches) == 17 of {
            true -> {
                b: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- expr_child_inner(branches);
                rest: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- expr_child_right(branches);
                r: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_one_case_branch(b, scrutinee_type, expected_type, context, world);
                case r.is_ok of {
                    false -> r;
                    true -> check_case_branch_list(rest, scrutinee_type, expected_type, context, case_loc, world)
                }
            };
            false -> type_checker_core@type_check_err("E2005", case_loc, "malformed case branch list", "sect3")
        }
    }
}

fn check_case_boolean_exhaustive(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, scrutinee_type: string, case_loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case scrutinee_type == "boolean" of {
        false -> type_checker_core@type_check_ok();
        true -> {
            cov: { has_true: int64, has_false: int64, has_wild: int64 } <- type_checker_tuple_decompose_helpers@case_scan_bool_coverage(branches, scrutinee_type);
            case type_checker_tuple_decompose_helpers@case_bool_coverage_ok(cov) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2005", case_loc, "case on boolean must cover true and false or include a wildcard branch (_ : boolean)", "sect3")
            }
        }
    }
}

fn check_case_expression(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(expr_child_right(expr)) == -1 of {
        true -> type_checker_core@type_check_err("E2005", expr_loc(expr), "case expression must have at least one branch", "sect3");
        false -> {
            scrutinee_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
            case len(scrutinee_type) == 0 of {
                true -> type_checker_core@type_check_err("E2005", expr_loc(expr), "cannot infer type of case scrutinee", "sect3");
                false -> {
                    (rscr, _) <- check_expr_surface(expr_child_inner(expr), scrutinee_type, context, world);
                    case rscr.is_ok of {
                        false -> rscr;
                        true -> {
                            branches_r: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_case_branch_list(expr_child_right(expr), scrutinee_type, expected_type, context, expr_loc(expr), world);
                            case branches_r.is_ok of {
                                false -> branches_r;
                                true -> check_case_boolean_exhaustive(expr_child_right(expr), scrutinee_type, expr_loc(expr))
                            }
                        }
                    }
                }
            }
        }
    }
}

// true/false as identifiers: lexer may emit identifier; treat as boolean literal (spec: boolean values)
fn is_true_or_false_identifier(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> bool {
    case len(expr_name(expr)) of {
        4 -> case substring(expr_name(expr), 0, 1) of {
            "t" -> case substring(expr_name(expr), 1, 2) of {
                "r" -> case substring(expr_name(expr), 2, 3) of {
                    "u" -> case substring(expr_name(expr), 3, 4) of { "e" -> true; _: string -> false };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        5 -> case substring(expr_name(expr), 0, 1) of {
            "f" -> case substring(expr_name(expr), 1, 2) of {
                "a" -> case substring(expr_name(expr), 2, 3) of {
                    "l" -> case substring(expr_name(expr), 3, 4) of {
                        "s" -> case substring(expr_name(expr), 4, 5) of { "e" -> true; _: string -> false };
                        _: string -> false
                    };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        _: int64 -> false
    }
}

// List literal (kind 20): value = full List[T, S] on root; inner/right_expr chain like tuple kind 9.
fn check_list_literal(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    lit_t: string <- case len(expr_value(expr)) > 0 of {
        true -> expr_value(expr);
        false -> expect_surf(context, expected_type)
    };
    case len(lit_t) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr_loc(expr), "list literal requires a typed binding (name: List[T, S] <- [...])", "list");
        false -> {
            case type_checker_lists@list_types_compatible(expect_surf(context, expected_type), lit_t) of {
                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(concat("list literal type ", lit_t), " does not match expected "), expect_surf(context, expected_type)), ""), "list");
                true -> {
                    (_ok: bool, elem_t: string, _: string) <- type_checker_lists@parse_list_type_params(lit_t);
                    case expr_kind(expr_child_inner(expr)) == -1 of {
                        true -> type_checker_core@type_check_ok();
                        false -> check_list_elem_tree(expr, elem_t, context, world)
                    }
                }
            }
        }
    }
}

fn check_list_elem_tree(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, elem_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(expr) == 20 of {
        true -> {
            (r1, _) <- check_expr_surface(expr_child_inner(expr), elem_type, context, world);
            case r1.is_ok of {
                false -> r1;
                true -> case expr_kind(expr_child_right(expr)) == -1 of {
                    true -> type_checker_core@type_check_ok();
                    false -> check_list_elem_tree(expr_child_right(expr), elem_type, context, world)
                }
            }
        };
        false -> {
                        (r, _) <- check_expr_surface(expr, elem_type, context, world);
                        r
                    }
    }
}

// Compiler-known list primitives (list_implementation_design.md §7): empty, length, prepend, remove_head, head.
// Phase 0.4: resolve List[Collectable, S] from expected_type once, then check like concrete generics.
fn check_list_primitive_resolved(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, elem_res: string, list_t: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_name(expr) == "empty" of {
        true -> {
            ac: int64 <- type_checker_lists@list_empty_effective_arg_count(expr);
            case ac == 0 of {
                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "empty expects 0 arguments", "list");
                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                    true -> type_checker_core@type_check_err("E2016", expr_loc(expr), "empty[Collectable, S]() requires a typed List binding on the left-hand side", "list");
                    false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                        true -> type_checker_core@type_check_ok();
                        false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(concat("empty returns ", list_t), ", expected "), expected_type), ""), "list")
                    }
                }
            }
        };
        false -> case expr_name(expr) == "length" of {
            true -> {
                ac: int64 <- type_checker_lists@count_call_args_list(expr);
                case ac == 1 of {
                    false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "length expects 1 argument", "list");
                    true -> {
                        (r1, _) <- check_expr_surface(expr_child_inner(expr), list_t, context, world);
                        case r1.is_ok of {
                            false -> r1;
                            true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_int64() of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat("length returns int64, expected ", expect_surf(context, expected_type)), ""), "list")
                                }
                            }
                        }
                    }
                }
            };
            false -> case expr_name(expr) == "prepend" of {
                true -> {
                    ac: int64 <- type_checker_lists@count_call_args_list(expr);
                    case ac == 2 of {
                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "prepend expects 2 arguments (element, list)", "list");
                        true -> {
                            (r1, _) <- check_expr_surface(expr_child_inner(expr), elem_res, context, world);
                            case r1.is_ok of {
                                false -> r1;
                                true -> {
                                    (r2, _) <- check_expr_surface(call_second_arg_expr(expr), list_t, context, world);
                                    case r2.is_ok of {
                                        false -> r2;
                                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(concat("prepend returns ", list_t), ", expected "), expected_type), ""), "list")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                };
                false -> case expr_name(expr) == "remove_head" of {
                    true -> {
                        ac: int64 <- type_checker_lists@count_call_args_list(expr);
                        case ac == 1 of {
                            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "remove_head expects 1 argument", "list");
                            true -> {
                                (r1, _) <- check_expr_surface(expr_child_inner(expr), list_t, context, world);
                                case r1.is_ok of {
                                    false -> r1;
                                    true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                        true -> type_checker_core@type_check_ok();
                                        false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(concat("remove_head returns ", list_t), ", expected "), expected_type), ""), "list")
                                        }
                                    }
                                }
                            }
                        }
                    };
                    false -> case expr_name(expr) == "head" of {
                        true -> {
                            ac: int64 <- type_checker_lists@count_call_args_list(expr);
                            case ac == 1 of {
                                false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "head expects 1 argument", "list");
                                true -> {
                                    (r1, _) <- check_expr_surface(expr_child_inner(expr), list_t, context, world);
                                    case r1.is_ok of {
                                        false -> r1;
                                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> case type_checker_lists@types_equal_strip(expected_type, elem_res) of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(concat("head returns ", elem_res), ", expected "), expected_type), ""), "list")
                                            }
                                        }
                                    }
                                }
                            }
                        };
                        false -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("unknown list primitive: ", expr_name(expr)), "list")
                    }
                }
            }
        }
    }
}

fn list_primitive_collectable_context_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    case node.name == "empty" of {
        true -> type_checker_core@surface_for_type_id(context, expected_type);
        false -> case node.name == "prepend" of {
            true -> type_checker_tuple_decompose_helpers@infer_expr_type(call_second_arg_expr(expr), context);
            false -> type_checker_tuple_decompose_helpers@infer_expr_type(parser_ast@expr_at(expr, node.inner), context)
        }
    }
}

fn check_list_primitive_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    (elem: string, space: string) <- type_checker_lists@parse_generic_ts(expr_value(expr));
    case len(elem) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(concat("list primitive ", expr_name(expr)), " requires [T, S], [T], or [Collectable, S] with a typed binding"), "list");
        false -> {
            list_context: string <- list_primitive_collectable_context_type(expr, expected_type, context);
            (ok_lt: bool, elem_res: string, space_res: string, list_t: string) <- type_checker_lists@resolve_list_type_from_collectable_generic(elem, space, list_context);
            case ok_lt of {
                false -> type_checker_core@type_check_err("E2016", expr_loc(expr), concat(concat("cannot resolve List[Collectable, Space] for ", expr_name(expr)), " without a concrete List type in context"), "list");
                true -> check_list_primitive_resolved(expr, expected_type, elem_res, list_t, context, world)
            }
        }
    }
}

fn count_struct_chain_nodes(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case expr_kind(expr) == -1 or expr_kind(expr) == 999 of {
        true -> 0;
        false -> case expr_kind(expr) == 21 of {
            true -> 1 + count_struct_chain_nodes(expr_child_right(expr));
            false -> 0
        }
    }
}

fn check_struct_literal_discard_chain(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(expr) == -1 or expr_kind(expr) == 999 of {
        true -> type_checker_core@type_check_ok();
        false -> case expr_kind(expr) == 21 of {
            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "ill-formed struct literal (expected kind 21)", "sect3");
            true -> {
                it: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
                case len(it) == 0 of {
                    true -> type_checker_core@type_check_err("E2005", expr_loc(expr), "cannot infer field expression type in struct literal", "sect3");
                    false -> {
                        (r1, _) <- check_expr_surface(expr_child_inner(expr), it, context, world);
                        case r1.is_ok of {
                            false -> r1;
                            true -> check_struct_literal_discard_chain(expr_child_right(expr), context, world)
                        }
                    }
                }
            }
        }
    }
}

fn check_struct_literal_chain(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case expr_kind(expr) == -1 or expr_kind(expr) == 999 of {
        true -> type_checker_core@type_check_ok();
        false -> case expr_kind(expr) == 21 of {
            false -> type_checker_core@type_check_err("E2005", expr_loc(expr), "ill-formed struct literal (expected kind 21)", "sect3");
            true -> {
                ft: string <- type_checker_record_types@find_field_type_in_record(expected_type, expr_name(expr));
                case len(ft) == 0 of {
                    true -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat("field ", expr_name(expr)), " is not part of the record type"), "sect3");
                    false -> {
                        (r1, _) <- check_expr_surface(expr_child_inner(expr), ft, context, world);
                        case r1.is_ok of {
                            false -> r1;
                            true -> check_struct_literal_chain(expr_child_right(expr), expected_type, context, world)
                        }
                    }
                }
            }
        }
    }
}

fn check_struct_literal_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
        true -> check_struct_literal_discard_chain(expr, context, world);
        false -> {
            exp_rec: string <- type_checker_record_types@expand_named_topology_type(expected_type);
            rec_expected: string <- case len(exp_rec) > 0 of { true -> exp_rec; false -> expected_type };
            case type_checker_record_types@record_type_starts(rec_expected) of {
                false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat("expected record type, got ", expect_surf(context, expected_type)), ""), "sect3");
                true -> {
                    n_type: int64 <- type_checker_record_types@count_record_fields(rec_expected);
                    n_lit: int64 <- count_struct_chain_nodes(expr);
                    case n_type == n_lit of {
                        false -> type_checker_core@type_check_err("E2003", expr_loc(expr), "struct literal field count does not match record type", "sect3");
                        true -> check_struct_literal_chain(expr, rec_expected, context, world)
                    }
                }
            }
        }
    }
}

fn check_field_access_field_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, base_t: string, ft: string, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    sequence proc[DeviceIO]
        result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case len(ft) == 0 of {
            true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(concat("no field ", expr_name(expr)), " on this type"), "sect3");
            false -> {
                (rbase, _) <- check_expr_surface(expr_child_inner(expr), base_t, context, world);
                case rbase.is_ok of {
                    false -> rbase;
                    true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                        true -> type_checker_core@type_check_ok();
                        false -> case type_checker_tuple_decompose_helpers@types_equal_surface(ft, expected_type) of {
                            true -> type_checker_core@type_check_ok();
                            false -> case type_checker_expressions_identifiers@function_types_compatible(ft, expected_type) of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_lists@formal_type_accepts_actual(ft, expected_type, world) of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", expr_loc(expr), concat(concat(concat(concat("field has type ", ft), ", expected "), expected_type), ""), "sect3")
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

fn check_field_access_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    sequence proc[DeviceIO]
        base_t: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context);
        result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case len(base_t) == 0 of {
            true -> type_checker_core@type_check_err("E2005", expr_loc(expr), "cannot infer type of field access base", "sect3");
            false -> {
                exp_base: string <- type_checker_record_types@expand_named_topology_type(base_t);
                rec_base: string <- case len(exp_base) > 0 of { true -> exp_base; false -> base_t };
                case type_checker_record_types@record_type_starts(rec_base) of {
                    true -> check_field_access_field_type(expr, base_t, type_checker_record_types@find_field_type_in_record(rec_base, expr_name(expr)), expected_type, context, world);
                    false -> {
                        list_ft: string <- type_checker_lists@list_field_access_type(rec_base, expr_name(expr));
                        case len(list_ft) == 0 of {
                            true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat(concat("field access base must be record, List[T, S], or topology type (cpu_topology, core_info, ...), got ", base_t), ""), "sect3");
                            false -> check_field_access_field_type(expr, base_t, list_ft, expected_type, context, world)
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

// Dispatch on Expr kind: 0=literal, 1=identifier, 2=parenthesized, 3=binary, 4=call, 5=atom, 6=let, 7=boolean, 8=string, 12=unary minus; 20=list; 21=struct; 22=field; 991=lambda
fn check_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) proc[DeviceIO] {
    case expr_kind(expr) of {
        0 -> type_checker_expressions_literals@check_expr(expr, expected_type, context, world);
        1 -> case is_true_or_false_identifier(expr) of {
            true -> boolean_type_checker_expressions@check_expr(expr, expected_type, context, world);
            false -> type_checker_expressions_identifiers@check_expr(expr, expected_type, context, world)
        };
        2 -> check_expr(expr_child_inner(expr), expected_type, context, world);
        3 -> (check_binary_op(expr, expected_type, context, world), context);
        4 -> (check_call(expr, expected_type, context, world), context);
        5 -> type_checker_expressions_atoms@check_expr(expr, expected_type, context, world);
        6 -> (check_let(expr, expected_type, context, world), context);
        7 -> boolean_type_checker_expressions@check_expr(expr, expected_type, context, world);
        8 -> (type_checker_expressions_string_calls@check_string_literal(expr, expected_type, context), context);
        9 -> (check_tuple_literal_inline(expr, expected_type, context, world), context);
        10 -> (check_tuple_decompose(expr, expected_type, context, world), context);
        11 -> (check_sequence_block(expr, expected_type, context, world), context);
        12 -> (check_unary_minus_forbidden(expr, context), context);
        13 -> (check_case_expression(expr, expected_type, context, world), context);
        19 -> (check_if_expression(expr, expected_type, context, world), context);
        20 -> (check_list_literal(expr, expected_type, context, world), context);
        21 -> (check_struct_literal_expr(expr, expected_type, context, world), context);
        22 -> (check_field_access_expr(expr, expected_type, context, world), context);
        991 -> (check_lambda_expression(expr, expected_type, context, world), context);
        996 -> (type_checker_core@type_check_err("E1040", expr_loc(expr), "expected ';' after this statement before the next statement", "sect3"), context);
        995 -> (type_checker_core@type_check_err("E1000", expr_loc(expr), "There is an uncategorized syntactic defect in the code you are working on.", "sect3"), context);
        997 -> (type_checker_core@type_check_err("E1041", expr_loc(expr), "the last expression in this block must not be followed by ';'", "sect3"), context);
        _: int64 -> (type_checker_core@type_check_ok(), context)
    }
}

// Parse a surface type into the interner, then check_expr with the resulting type id.
fn check_expr_surface(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, surface: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) proc[DeviceIO] {
    out: { context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, id: int64, ok: boolean } <- type_checker_core@parse_type_into_context(context, surface);
    case out.ok of {
        true -> check_expr(expr, out.id, out.context, world);
        false -> (type_checker_core@type_check_err("E2003", expr_loc(expr), concat("invalid type: ", surface), "sect6"), context)
    }
}

fn check_if_expression(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    (rc, _) <- check_expr_surface(expr_child_inner(expr), "boolean", context, world);
    case rc.is_ok of {
        false -> rc;
        true -> {
            (rt, _) <- check_expr(expr_child_inner(expr_child_right(expr)), expected_type, context, world);
            case rt.is_ok of {
                false -> rt;
                true -> case expr_kind(expr_child_right(expr_child_right(expr))) < 0 of {
                    true -> type_checker_core@type_check_ok();
                    false -> {
                        (r, _) <- check_expr(expr_child_right(expr_child_right(expr)), expected_type, context, world);
                        r
                    }
                }
            }
        }
    }
}

// Tuple decomposition (kind 10): (pattern) <- rhs; body
// Structured pattern_bindings from AST. Bare identifiers get types from the RHS tuple; explicit `ident : type` must agree with RHS.
fn check_tuple_decompose(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    rhs_type: string <- case expr_kind(expr_child_inner(expr)) == 11 of {
        true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_right(expr_child_inner(expr)), context_after_sequence_body(expr_child_inner(expr_child_inner(expr)), context));
        false -> type_checker_tuple_decompose_helpers@infer_expr_type(expr_child_inner(expr), context)
    };
    case len(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
        true -> type_checker_core@type_check_err("E2005", expr_loc(expr), concat("tuple decomposition RHS must have tuple type, got ", case len(rhs_type) == 0 of { true -> "[unknown]"; false -> rhs_type }), "sect4");
        false -> {
            bindings: List[{ name: string, path: string, type_str: string }, mem(normal)] <- expr_pattern_bindings(expr);
            rhs_trimmed: string <- type_checker_tuple_decompose_helpers@tuple_trim(rhs_type);
            tuple_for_fill: string <- case len(expr_value(expr)) > 0 of {
                true -> type_checker_tuple_decompose_helpers@tuple_trim(expr_value(expr));
                false -> rhs_trimmed
            };
            filled: List[{ name: string, path: string, type_str: string }, mem(normal)] <- type_checker_tuple_decompose_helpers@fill_empty_binding_types_from_rhs(bindings, tuple_for_fill);
            valid_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_tuple_decompose_helpers@pattern_bindings_valid(filled, expr_loc(expr));
            case valid_result.is_ok of {
                false -> valid_result;
                true -> check_tuple_decompose_after_valid(expr, expected_type, context, rhs_type, filled, world)
            }
        }
    }
}

