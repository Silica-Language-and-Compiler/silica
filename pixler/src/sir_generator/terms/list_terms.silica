// List AST lowering helpers (list_implementation_design.md §5–§7): SIR prims for lists.
// Backend lowers list_nil / list_cons / list_length / list_head / list_remove_head to region+buffer code.

use sir_ast;
use types;
use type_checker_lists;

export is_list_primitive_name/1;
export build_list_nil/2;
export build_list_cons/3;
export build_list_length_prim/1;
export build_list_head_prim/2;
export build_list_at_prim/3;
export build_list_remove_head_prim/2;

fn is_list_primitive_name(n: string) -> boolean {
    type_checker_lists@is_list_primitive_name(n)
}

fn elem_type_tag_const(elem_t: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case elem_t of {
        "int8" -> sir_ast@make_sir_term(0, "int8", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "int16" -> sir_ast@make_sir_term(0, "int16", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "int32" -> sir_ast@make_sir_term(0, "int32", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "int64" -> sir_ast@make_sir_term(0, "int64", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "uint8" -> sir_ast@make_sir_term(0, "uint8", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "uint16" -> sir_ast@make_sir_term(0, "uint16", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "uint32" -> sir_ast@make_sir_term(0, "uint32", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "uint64" -> sir_ast@make_sir_term(0, "uint64", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "float32" -> sir_ast@make_sir_term(0, "float32", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "float64" -> sir_ast@make_sir_term(0, "float64", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "boolean" -> sir_ast@make_sir_term(0, "bool", "false", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        _: string -> sir_ast@make_sir_term(0, "int64", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
    }
}

fn build_list_nil(elem_t: string, list_t: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    lt_sir: string <- types@type_name_to_sir(list_t);
    tag: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- elem_type_tag_const(elem_t);
    sir_ast@make_sir_term(6, lt_sir, "", "list_nil", tag, sir_ast@dummy_sir_term())
}

fn build_list_cons(head: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, tail: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, list_t: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    lt_sir: string <- types@type_name_to_sir(list_t);
    sir_ast@make_sir_term(6, lt_sir, "", "list_cons", head, tail)
}

fn build_list_length_prim(list_arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(6, "int64", "", "list_length", list_arg, sir_ast@dummy_sir_term())
}

fn build_list_head_prim(list_arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, elem_t: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    elem_sir: string <- types@type_name_to_sir(elem_t);
    sir_ast@make_sir_term(6, elem_sir, "", "list_head", list_arg, sir_ast@dummy_sir_term())
}


// list_at(xs, i): the i-th element from the head, without walking through .tail handles.
// Binary prim: inner = list, right_expr = index; L_list_at_helper aborts when out of range.
fn build_list_at_prim(list_arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx_arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, elem_t: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    elem_sir: string <- types@type_name_to_sir(elem_t);
    sir_ast@make_sir_term(6, elem_sir, "", "list_at", list_arg, idx_arg)
}

fn build_list_remove_head_prim(list_arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, list_t: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    lt_sir: string <- types@type_name_to_sir(list_t);
    sir_ast@make_sir_term(6, lt_sir, "", "list_remove_head", list_arg, sir_ast@dummy_sir_term())
}
