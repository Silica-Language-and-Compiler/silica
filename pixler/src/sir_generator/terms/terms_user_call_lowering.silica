                    arg1_type: string <- terms_helpers@user_call_first_arg_expected_type(context, type_checker_expressions_helpers@expr_name(expr), inferred1);
                    arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), arg1_type);
                    rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_rest_chain_with_formals(context, type_checker_expressions_helpers@expr_child_right(expr), terms_helpers@tuple_rest_element_type(terms_helpers@call_params_tuple_for_sir(context, type_checker_expressions_helpers@expr_name(expr))), lower_expected, lower_in_body);
                    user_calls@build_tail_call_with_rest(callee, arg1, rest, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr))
                };
                false -> case terms_helpers@user_call_expects_single_tuple_param(context, type_checker_expressions_helpers@expr_name(expr)) of {
