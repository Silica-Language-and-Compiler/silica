// User/tail/rest-chain call SIR lowering (open recursion callbacks).

use overload_mangle;
use recursion_terms;
use sir_ast;
use type_checker_expressions_helpers;
use types;
use user_calls;
use terms_helpers;

export build_user_call_from_expr/5;
export build_user_call_from_expr_in_body/7;
export build_user_call_from_expr_tail/5;

fn build_rest_chain_in_body(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, curried: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(curried) == 4 and type_checker_expressions_helpers@expr_name(curried) == "" of {
        true -> {
            arg_type: string <- terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(curried));
            arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(curried), bound_name, bound_type, arg_type);
            rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_rest_chain_in_body(context, type_checker_expressions_helpers@expr_child_right(curried), bound_name, bound_type, lower_expected, lower_in_body);
            sir_ast@make_sir_term(6, "unit", "", "user_call_rest", arg, rest)
        };
        false -> {
            arg_type: string <- terms_helpers@sir_infer_expr_type(context, curried);
            lower_in_body(context, curried, bound_name, bound_type, arg_type)
        }
    }
}

// Cross-module (spec §19, §3.3.2): module@function for imported calls, bare name for local.
// If type_checker_expressions_helpers@expr_name(expr) is already mangled by the qualified_call_mangler pass (e.g. "Shape@area__int32"),
// that form is emitted verbatim so link-time resolution matches overload_mangle@sir_fn_link_name.

fn build_rest_chain_in_body_with_formals(
    context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] },
    curried: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 },
    formal_types: string,
    bound_name: string,
    bound_type: string
, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    formal_tuple: string <- case length_bytes(formal_types) > 0 and substring(formal_types, 0, 1) == "(" of {
        true -> formal_types;
        false -> case length_bytes(formal_types) > 0 of {
            true -> concat("(", concat(formal_types, ")"));
            false -> ""
        }
    };
    formal_first: string <- terms_helpers@tuple_first_element_type(formal_tuple);
    formal_rest: string <- terms_helpers@tuple_rest_element_type(formal_tuple);
    case type_checker_expressions_helpers@expr_kind(curried) == 4 and type_checker_expressions_helpers@expr_name(curried) == "" of {
        true -> {
            arg_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_inner(curried), formal_first);
            arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(curried), bound_name, bound_type, arg_type);
            rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_rest_chain_in_body_with_formals(context, type_checker_expressions_helpers@expr_child_right(curried), formal_rest, bound_name, bound_type, lower_expected, lower_in_body);
            sir_ast@make_sir_term(6, "unit", "", "user_call_rest", arg, rest)
        };
        false -> {
            arg_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, curried, formal_first);
            lower_in_body(context, curried, bound_name, bound_type, arg_type)
        }
    }
}

fn build_user_call_from_expr_in_body(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, bound_name: string, bound_type: string, expected_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    callee: string <- terms_helpers@user_call_callee_sir_name(context, type_checker_expressions_helpers@expr_name(expr));
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) < 0 of {
        true -> user_calls@build_user_call_0(callee, expected_type, recursion_terms@user_call_effect_value_fn(expr));
        false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) < 0 of {
            true -> {
                inferred1: string <- terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
                arg1_type: string <- terms_helpers@user_call_first_arg_expected_type(context, type_checker_expressions_helpers@expr_name(expr), inferred1);
                arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, arg1_type);
                user_calls@build_user_call_1(callee, arg1, expected_type, recursion_terms@user_call_effect_value_fn(expr))
            };
            false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                true -> {
                    formal_tuple: string <- terms_helpers@call_params_tuple_for_sir(context, type_checker_expressions_helpers@expr_name(expr));
                    formal_first: string <- terms_helpers@tuple_first_element_type(formal_tuple);
                    formal_rest: string <- terms_helpers@tuple_rest_element_type(formal_tuple);
                    arg1_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_inner(expr), formal_first);
                    arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, arg1_type);
                    rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_rest_chain_in_body_with_formals(context, type_checker_expressions_helpers@expr_child_right(expr), formal_rest, bound_name, bound_type, lower_expected, lower_in_body);
                    user_calls@build_user_call_with_rest(callee, arg1, rest, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                };
                false -> case terms_helpers@user_call_expects_single_tuple_param(context, type_checker_expressions_helpers@expr_name(expr)) of {
                    true -> {
                        func_type: string <- terms_helpers@lookup_function_type_for_call_sir(context.env, type_checker_expressions_helpers@expr_name(expr));
                        tuple_param: string <- terms_helpers@sir_params_inner_from_func_type(func_type);
                        first_type: string <- terms_helpers@tuple_first_element_type(tuple_param);
                        second_type: string <- terms_helpers@tuple_rest_element_type(tuple_param);
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, first_type);
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_right(expr), bound_name, bound_type, second_type);
                        sir_type: string <- types@type_name_to_sir(tuple_param);
                        tuple_arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(6, sir_type, "", "tuple_make", arg1, arg2);
                        user_calls@build_user_call_1(callee, tuple_arg, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                    };
                    false -> {
                        formal_tuple2: string <- terms_helpers@call_params_tuple_for_sir(context, type_checker_expressions_helpers@expr_name(expr));
                        arg1_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_inner(expr), terms_helpers@tuple_first_element_type(formal_tuple2));
                        arg2_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_right(expr), terms_helpers@tuple_rest_element_type(formal_tuple2));
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, arg1_type);
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_right(expr), bound_name, bound_type, arg2_type);
                        user_calls@build_user_call_2(callee, arg1, arg2, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                    }
                }
            }
        }
    }
}

// Top-level twin of build_rest_chain_in_body_with_formals: numeric literal arguments take
// the callee's formal type (defect A1; see terms_helpers@expected_or_inferred_call_arg_type).
fn build_rest_chain_with_formals(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, curried: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, formal_types: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    formal_tuple: string <- case length_bytes(formal_types) > 0 and substring(formal_types, 0, 1) == "(" of {
        true -> formal_types;
        false -> case length_bytes(formal_types) > 0 of {
            true -> concat("(", concat(formal_types, ")"));
            false -> ""
        }
    };
    formal_first: string <- terms_helpers@tuple_first_element_type(formal_tuple);
    formal_rest: string <- terms_helpers@tuple_rest_element_type(formal_tuple);
    case type_checker_expressions_helpers@expr_kind(curried) == 4 and type_checker_expressions_helpers@expr_name(curried) == "" of {
        true -> {
            arg_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_inner(curried), formal_first);
            arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(curried), arg_type);
            rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_rest_chain_with_formals(context, type_checker_expressions_helpers@expr_child_right(curried), formal_rest, lower_expected, lower_in_body);
            sir_ast@make_sir_term(6, "unit", "", "user_call_rest", arg, rest)
        };
        false -> {
            arg_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, curried, formal_first);
            lower_expected(context, curried, arg_type)
        }
    }
}
fn build_rest_chain(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, curried: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(curried) == 4 and type_checker_expressions_helpers@expr_name(curried) == "" of {
        true -> {
            arg_type: string <- terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(curried));
            arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(curried), arg_type);
            rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_rest_chain(context, type_checker_expressions_helpers@expr_child_right(curried), lower_expected, lower_in_body);
            sir_ast@make_sir_term(6, "unit", "", "user_call_rest", arg, rest)
        };
        false -> {
            arg_type: string <- terms_helpers@sir_infer_expr_type(context, curried);
            lower_expected(context, curried, arg_type)
        }
    }
}

fn build_user_call_from_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    callee: string <- terms_helpers@user_call_callee_sir_name(context, type_checker_expressions_helpers@expr_name(expr));
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) < 0 of {
        true -> user_calls@build_user_call_0(callee, expected_type, recursion_terms@user_call_effect_value_fn(expr));
        false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) < 0 of {
            true -> {
                inferred1: string <- terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
                arg1_type: string <- terms_helpers@user_call_first_arg_expected_type(context, type_checker_expressions_helpers@expr_name(expr), inferred1);
                arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), arg1_type);
                user_calls@build_user_call_1(callee, arg1, expected_type, recursion_terms@user_call_effect_value_fn(expr))
            };
            false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                true -> {
                    formal_tuple_top: string <- terms_helpers@call_params_tuple_for_sir(context, type_checker_expressions_helpers@expr_name(expr));
                    arg1_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_inner(expr), terms_helpers@tuple_first_element_type(formal_tuple_top));
                    arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), arg1_type);
                    rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_rest_chain_with_formals(context, type_checker_expressions_helpers@expr_child_right(expr), terms_helpers@tuple_rest_element_type(formal_tuple_top), lower_expected, lower_in_body);
                    user_calls@build_user_call_with_rest(callee, arg1, rest, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                };
                false -> case terms_helpers@user_call_expects_single_tuple_param(context, type_checker_expressions_helpers@expr_name(expr)) of {
                    true -> {
                        func_type: string <- terms_helpers@lookup_function_type_for_call_sir(context.env, type_checker_expressions_helpers@expr_name(expr));
                        tuple_param: string <- terms_helpers@sir_params_inner_from_func_type(func_type);
                        first_type: string <- terms_helpers@tuple_first_element_type(tuple_param);
                        second_type: string <- terms_helpers@tuple_rest_element_type(tuple_param);
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), first_type);
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_right(expr), second_type);
                        sir_type: string <- types@type_name_to_sir(tuple_param);
                        tuple_arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(6, sir_type, "", "tuple_make", arg1, arg2);
                        user_calls@build_user_call_1(callee, tuple_arg, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                    };
                    false -> {
                        formal_tuple2: string <- terms_helpers@call_params_tuple_for_sir(context, type_checker_expressions_helpers@expr_name(expr));
                        arg1_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_inner(expr), terms_helpers@tuple_first_element_type(formal_tuple2));
                        arg2_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_right(expr), terms_helpers@tuple_rest_element_type(formal_tuple2));
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), arg1_type);
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_right(expr), arg2_type);
                        user_calls@build_user_call_2(callee, arg1, arg2, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                    }
                }
            }
        }
    }
}

// True when the function body is a single { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } (kind 4) that lowers to a user call (not builtin).
// Used to emit tail_call (kind 5) for phase 5 / p3 back-edge metadata on the root body only.

fn build_user_call_from_expr_tail(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
