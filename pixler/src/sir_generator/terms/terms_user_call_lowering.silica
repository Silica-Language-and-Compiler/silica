                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_right(expr), second_type);
                        sir_type: string <- types@type_name_to_sir(tuple_param);
                        tuple_arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(6, sir_type, "", "tuple_make", arg1, arg2);
                        user_calls@build_tail_call_1(callee, tuple_arg, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr))
