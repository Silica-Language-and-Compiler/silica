        true -> user_calls@build_tail_call_0(callee, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr));
        false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) < 0 of {
