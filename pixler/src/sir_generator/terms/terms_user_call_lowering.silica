                user_calls@build_tail_call_1(callee, arg1, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr))
            };
            false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
