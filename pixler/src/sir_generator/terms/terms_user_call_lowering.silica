                        arg2_type: string <- terms_helpers@expected_or_inferred_call_arg_type(context, type_checker_expressions_helpers@expr_child_right(expr), terms_helpers@tuple_rest_element_type(formal_tuple2));
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), arg1_type);
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_right(expr), arg2_type);
