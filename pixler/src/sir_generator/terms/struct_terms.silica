// Inline record struct literals (Expr kind 21) and field access (kind 22), silica-spec §3.3.7 / §3.4.2.
// Lowers to prim record_make / record_proj per sir_design_spec §7.6.

use parser_ast;
use sir_ast;
use terms_helpers;
use type_checker_record_types;
use type_checker_tuple_decompose_helpers;

export record_type_for_struct_literal/3;
export is_last_struct_literal_node/1;
export build_record_make_layer/4;
export build_record_proj_prim/3;

// Prefer contextual record type (the record variant of an expected inline sum type, chosen as the
// type checker chose it); otherwise infer `{ f: T, ... }` from field initializers.
fn record_type_for_struct_literal(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string) -> string {
    sum_variant: string <- case type_checker_tuple_decompose_helpers@case_sum_bar_depth0(expected_type, 0, 0) >= 0 of {
        true -> type_checker_tuple_decompose_helpers@struct_literal_sum_variant(expr, expected_type);
        false -> ""
    };
    case length_bytes(sum_variant) > 0 of {
        true -> sum_variant;
        false -> case type_checker_record_types@record_type_starts(expected_type) of {
            true -> expected_type;
            false -> terms_helpers@sir_infer_struct_literal_type(context, expr)
        }
    }
}

fn is_last_struct_literal_node(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, node.right_expr);
    right_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(right);
    right_node.kind != 21
}

// Right-nested record_make chain: record_make(f0, v0, record_make(f1, v1, ... dummy)).
fn build_record_make_layer(sir_record_type: string, field_name: string, value_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(6, sir_record_type, field_name, "record_make", value_term, rest)
}

fn build_record_proj_prim(field_sir_type: string, field_name: string, base_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(6, field_sir_type, field_name, "record_proj", base_term, sir_ast@dummy_sir_term())
}
