// Layer 1 §7.5/§7.9: canonical arena injection and ordering-bundle materialization at collection constructor let-bindings.

use parser_ast;
use sir_ast;
use types;
use type_checker_collections;
use type_checker_record_types;
use memory_region_calls;
use struct_terms;
use literals;
use ordering_identity_calls;

export is_collection_constructor_let/2;
export is_collection_constructor_let_in/3;
export build_collection_constructor_lets/6;
export env_lookup_type_name/2;

fn first_at_ctor(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_ctor(s, i + 1)
        }
    }
}

fn ctor_base_ok_i(call_name: string) -> int64 {
    at: int64 <- first_at_ctor(call_name, 0);
    base: string <- case at < 0 of {
        true -> call_name;
        false -> substring(call_name, at + 1, length_bytes(call_name))
    };
    case base == "empty" of {
        true -> 1;
        false -> case base == "with_root" of {
            true -> 1;
            false -> 0
        }
    }
}

fn bind_has_runtime_fields_i(bind_type: string) -> int64 {
    key_ty: string <- type_checker_record_types@find_field_type_in_record(bind_type, "specialization_key");
    region_ty: string <- type_checker_record_types@find_field_type_in_record(bind_type, "region");
    case length_bytes(key_ty) of {
        0 -> 0;
        _: int64 -> case length_bytes(region_ty) of {
            0 -> 0;
            _: int64 -> 1
        }
    }
}

// The call-site lowering below re-anchors a constructor's record: its `region` becomes the
// canonical arena of the binding's specialization key and its `specialization_key` that key
// (value_for_merge_field). That is the contract of a representation whose constructor publishes a
// PLACEHOLDER (wbt_set, wbt_map: `region: canonical_arena_lookup(1)`, `specialization_key: 0`)
// and allocates from the record's region afterwards. A representation that owns ONE fixed arena
// for every value (tree_rose, tree_binary: `canonical_arena_lookup(arena_key())`, and every read
// validates a node with ref_in_region against the record's region) must keep the region it
// published: re-anchoring it made every validated read miss, so tree_binary@get returned its
// default and bt_generic_payloads printed empty strings. Such a module exports `arena_key/0`;
// that export is the mark, and the lowering leaves its constructor calls as plain lets.
fn module_owns_fixed_arena_i(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], mod_name: string) -> int64 {
    case length_bytes(env_lookup_type_name_in_module(env, "arena_key", mod_name)) > 0 of {
        true -> 1;
        false -> 0
    }
}

fn is_collection_constructor_let_in(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], bind_type: string, rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case is_collection_constructor_let(bind_type, rhs_expr) of {
        0 -> 0;
        _: int64 -> {
            mod_name: string <- type_checker_collections@module_name_from_qualified_call(parser_ast@expr_root_node(rhs_expr).name);
            case module_owns_fixed_arena_i(env, mod_name) of {
                1 -> 0;
                _: int64 -> 1
            }
        }
    }
}

// Seed-built selfhost drops cross-module bools from collections predicates.
fn is_collection_constructor_let(bind_type: string, rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(rhs_expr);
    case node.kind == 4 of {
        false -> 0;
        true -> case ctor_base_ok_i(node.name) of {
            0 -> 0;
            _: int64 -> {
                mod_name: string <- type_checker_collections@module_name_from_qualified_call(node.name);
                case type_checker_collections@representation_id_from_module(mod_name) of {
                    0 -> 0;
                    _: int64 -> case type_checker_collections@public_trait_family_tag(bind_type) of {
                        0 -> bind_has_runtime_fields_i(bind_type);
                        _: int64 -> 1
                    }
                }
            }
        }
    }
}

fn spec_key_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__spec_key")
}

fn arena_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__arena")
}

fn raw_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__raw")
}

fn region_type_for_bind(bind_type: string) -> string {
    space: string <- type_checker_collections@collection_space_from_type(bind_type);
    case length_bytes(space) == 0 of {
        true -> "region(L, normal)";
        false -> {
            inner: string <- case length_bytes(space) >= 5 and substring(space, 0, 4) == "mem(" of {
                true -> substring(space, 4, length_bytes(space) - 1);
                false -> "normal"
            };
            concat(concat("region(L, ", inner), ")")
        }
    }
}

// A module-qualified call denotes the callee module's declaration. env is keyed by bare
// name, so falling back to the bare name alone let `wbt_set@empty` pick up `wbt_map`'s
// `empty` whenever both were imported: the record was then built with the map's field
// names against the set's record type, every unmatched name resolved to the same
// not-found offset, and compare_item was never written. Confine the fallback to the
// module named in the call.
fn env_lookup_type_name_in_module(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string, module_name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name and env.head.source_module == module_name of {
            true -> env.head.type_name;
            false -> env_lookup_type_name_in_module(env.tail, name, module_name)
        }
    }
}

fn env_lookup_type_name(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name of {
            true -> env.head.type_name;
            false -> env_lookup_type_name(env.tail, name)
        }
    }
}

fn return_type_from_call(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(call_expr);
    fn_type: string <- env_lookup_type_name(context.env, node.name);
    fn_use: string <- case length_bytes(fn_type) of {
        0 -> {
            at: int64 <- first_at_ctor(node.name, 0);
            case at < 0 of {
                true -> "";
                false -> env_lookup_type_name_in_module(context.env, substring(node.name, at + 1, length_bytes(node.name)), substring(node.name, 0, at))
            }
        };
        _: int64 -> fn_type
    };
    case length_bytes(fn_use) > 0 of {
        true -> extract_return_from_fn_type(fn_use);
        false -> ""
    }
}

// The declared type text spells the arrow as `-> {`, so the span after it starts
// with a space. Emitter spill selection keys on the first character of the SIR type
// (term_reg_spill@let_rhs_type_spills_across_io), and " {" is not a record: the
// constructor re-anchor binding then stays in a caller-saved register and the merged
// record reads it back after an intervening call has overwritten it.
fn skip_leading_spaces_ctor(s: string, i: int64) -> string {
    case i >= length_bytes(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> skip_leading_spaces_ctor(s, i + 1);
            false -> substring(s, i, length_bytes(s))
        }
    }
}

fn extract_return_from_fn_type(fn_type: string) -> string {
    t: string <- fn_type;
    arrow: int64 <- find_arrow_in_fn_type(t, 0, 0);
    case arrow < 0 of {
        true -> "";
        false -> skip_leading_spaces_ctor(substring(t, arrow + 2, length_bytes(t)), 0)
    }
}

fn find_arrow_in_fn_type(s: string, i: int64, depth: int64) -> int64 {
    case i + 2 > length_bytes(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "{" or c == "[" of {
                true -> find_arrow_in_fn_type(s, i + 1, depth + 1);
                false -> case c == ")" or c == "}" or c == "]" of {
                    true -> find_arrow_in_fn_type(s, i + 1, depth - 1);
                    false -> case depth == 0 and substring(s, i, i + 2) == "->" of {
                        true -> i;
                        false -> find_arrow_in_fn_type(s, i + 1, depth)
                    }
                }
            }
        }
    }
}

fn int64_const_sir(value: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    dec: string <- literals@int64_to_decimal_string(value);
    sir_ast@make_sir_term(0, "i64", dec, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn atom_const_sir(lexeme: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(0, "atom", lexeme, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn var_ref_sir(prefixed: string, sir_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(1, sir_type, "", prefixed, sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn build_arena_lookup_sir(key_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, region_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    memory_region_calls@build_region_prim_from_sir("canonical_arena_lookup", key_sir, sir_ast@dummy_sir_term(), region_type)
}

fn field_type_from_segment(seg: string) -> string {
    colon: int64 <- find_colon_in_segment(seg, 0, 0, 0);
    case colon < 0 of {
        true -> "";
        false -> substring(seg, colon + 1, length_bytes(seg))
    }
}

fn find_colon_in_segment(s: string, i: int64, depth: int64, paren: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "{" of {
                true -> find_colon_in_segment(s, i + 1, depth + 1, paren);
                false -> case c == "}" of {
                    true -> find_colon_in_segment(s, i + 1, depth - 1, paren);
                    false -> case c == "(" of {
                        true -> find_colon_in_segment(s, i + 1, depth, paren + 1);
                        false -> case c == ")" of {
                            true -> find_colon_in_segment(s, i + 1, depth, paren - 1);
                            false -> case c == ":" and depth == 0 and paren == 0 of {
                                true -> i;
                                false -> find_colon_in_segment(s, i + 1, depth, paren)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn ordering_bundle_field_name(fn_field: string) -> string {
    concat(fn_field, "_ordering_bundle")
}

fn fn_field_projection(
    fn_field: string,
    fn_type: string,
    raw_ast_type: string,
    raw_var: string
) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    base: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- var_ref_sir(raw_var, types@type_name_to_sir(raw_ast_type));
    struct_terms@build_record_proj_prim(types@type_name_to_sir(fn_type), fn_field, base)
}

fn bundle_side_binding_name(bind_name: string, fn_field: string) -> string {
    concat(concat(bind_name, "."), ordering_bundle_field_name(fn_field))
}

fn ordering_field_count_for_merge(bind_type: string, mod_name: string) -> int64 {
    from_bind: int64 <- type_checker_collections@constructor_ordering_field_count(bind_type);
    case from_bind > 0 of {
        true -> from_bind;
        false -> type_checker_collections@constructor_ordering_field_count_for_module(mod_name)
    }
}

fn ordering_field_at_for_merge(bind_type: string, mod_name: string, idx: int64) -> string {
    from_bind: int64 <- type_checker_collections@constructor_ordering_field_count(bind_type);
    case from_bind > 0 of {
        true -> type_checker_collections@constructor_ordering_field_at(bind_type, idx);
        false -> type_checker_collections@constructor_ordering_field_at_for_module(mod_name, idx)
    }
}

fn raw_reanchor_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__raw_anchor")
}

fn key_reanchor_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__key_anchor")
}

fn fn_side_binding_name(bind_name: string, fn_field: string) -> string {
    concat(concat(concat(bind_name, ".__fn_"), fn_field), "")
}

fn should_inject_ordering_bundles_i(bind_name: string) -> int64 {
    case length_bytes(bind_name) == 1 and substring(bind_name, 0, 1) == "_" of {
        true -> 0;
        false -> 1
    }
}

fn record_literal_field_expr(record_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field_name: string) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(record_expr);
    case node.kind == 21 of {
        false -> parser_ast@dummy_expr();
        true -> case node.name == field_name of {
            true -> parser_ast@expr_at(record_expr, node.inner);
            false -> record_literal_field_expr(parser_ast@expr_at(record_expr, node.right_expr), field_name)
        }
    }
}

fn build_fn_ordering_bundle_from_fn_ref(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, fn_ref: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, fn_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, orient_lexeme: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    env_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- ordering_identity_calls@build_ordering_env_for_fn_operand(context, fn_expr);
    fn_token: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- ordering_identity_calls@build_ordering_identity_prim_from_sir("ordering_identity_materialize", fn_ref, env_sir, "int64");
    orient: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- atom_const_sir(orient_lexeme);
    ordering_identity_calls@build_ordering_identity_prim_from_sir("ordering_identity_bundle_make", fn_token, orient, "int64")
}

// Packed config keeps arity ≤8 (E3010 / AArch64 register args).
fn wrap_bundle_side_lets(
    context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] },
    call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 },
    cfg: { bind_name: string, bind_type: string, mod_name: string, raw_ast_type: string, raw_var: string, orient_lexeme: string, field_count: int64 },
    field_idx: int64,
    inner_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }
) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case field_idx >= cfg.field_count of {
        true -> inner_sir;
        false -> {
            fname: string <- ordering_field_at_for_merge(cfg.bind_type, cfg.mod_name, field_idx);
            side_name: string <- bundle_side_binding_name(cfg.bind_name, fname);
            side_prefixed: string <- concat("%", side_name);
            fn_side_name: string <- fn_side_binding_name(cfg.bind_name, fname);
            fn_side_prefixed: string <- concat("%", fn_side_name);
            fn_type: string <- type_checker_record_types@find_field_type_in_record(cfg.raw_ast_type, fname);
            fn_type_sir: string <- types@type_name_to_sir(fn_type);
            fn_proj: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- fn_field_projection(fname, fn_type, cfg.raw_ast_type, cfg.raw_var);
            fn_ref: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- var_ref_sir(fn_side_prefixed, fn_type_sir);
            call_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(call_expr);
            fn_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- record_literal_field_expr(parser_ast@expr_at(call_expr, call_node.inner), fname);
            bundle_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_fn_ordering_bundle_from_fn_ref(context, fn_ref, fn_expr, cfg.orient_lexeme);
            next: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- wrap_bundle_side_lets(context, call_expr, cfg, field_idx + 1, inner_sir);
            bundle_let: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(2, "i64", "", side_prefixed, bundle_sir, next);
            sir_ast@make_sir_term(2, fn_type_sir, "", fn_side_prefixed, fn_proj, bundle_let)
        }
    }
}

fn merged_record_type_with_bundle_fields(
    bind_type: string,
    mod_name: string,
    field_idx: int64,
    field_count: int64
) -> string {
    case field_idx >= field_count of {
        true -> bind_type;
        false -> {
            fname: string <- ordering_field_at_for_merge(bind_type, mod_name, field_idx);
            bundle_name: string <- ordering_bundle_field_name(fname);
            with_field: string <- case length_bytes(type_checker_record_types@find_field_type_in_record(bind_type, bundle_name)) > 0 of {
                true -> bind_type;
                false -> concat(
                    substring(bind_type, 0, length_bytes(bind_type) - 1),
                    concat(", ", concat(bundle_name, ": int64}"))
                )
            };
            merged_record_type_with_bundle_fields(with_field, mod_name, field_idx + 1, field_count)
        }
    }
}

fn append_bundle_var_merge_layers(
    bind_name: string,
    bind_type: string,
    mod_name: string,
    field_idx: int64,
    field_count: int64,
    merged_ast_type: string,
    acc: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }
) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case field_idx >= field_count of {
        true -> acc;
        false -> {
            fname: string <- ordering_field_at_for_merge(bind_type, mod_name, field_idx);
            side_name: string <- bundle_side_binding_name(bind_name, fname);
            side_prefixed: string <- concat("%", side_name);
            bname: string <- ordering_bundle_field_name(fname);
            val: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- var_ref_sir(side_prefixed, "i64");
            sir_rt: string <- types@type_name_to_sir(merged_ast_type);
            next: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(sir_rt, bname, val, acc);
            append_bundle_var_merge_layers(bind_name, bind_type, mod_name, field_idx + 1, field_count, merged_ast_type, next)
        }
    }
}

fn value_for_merge_field(
    field_name: string,
    field_type: string,
    raw_ast_type: string,
    raw_var: string,
    arena_var: string,
    key_var: string,
    region_type: string
) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case field_name == "region" of {
        true -> var_ref_sir(arena_var, types@type_name_to_sir(region_type));
        false -> case field_name == "specialization_key" of {
            true -> var_ref_sir(key_var, "i64");
            false -> fn_field_projection(field_name, field_type, raw_ast_type, raw_var)
        }
    }
}

fn build_merge_layers(
    remaining: string,
    raw_ast_type: string,
    merged_ast_type: string,
    raw_var: string,
    arena_var: string,
    key_var: string,
    region_type: string,
    acc: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }
) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case length_bytes(remaining) == 0 of {
        true -> acc;
        false -> build_merge_layers_step(remaining, raw_ast_type, merged_ast_type, raw_var, arena_var, key_var, region_type, acc)
    }
}

fn build_merge_layers_step(
    rem: string,
    raw_ast_type: string,
    merged_ast_type: string,
    raw_var: string,
    arena_var: string,
    key_var: string,
    region_type: string,
    acc: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }
) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    (seg: string, rest: string) <- type_checker_record_types@record_case_field_step(rem);
    (fname: string, _: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
    ftype: string <- field_type_from_segment(seg);
    val: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- value_for_merge_field(fname, ftype, raw_ast_type, raw_var, arena_var, key_var, region_type);
    sir_rt: string <- types@type_name_to_sir(merged_ast_type);
    next: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(sir_rt, fname, val, acc);
    build_merge_layers(rest, raw_ast_type, merged_ast_type, raw_var, arena_var, key_var, region_type, next)
}

// Packed cfg keeps arity ≤8 (E3010 / AArch64 register args).
fn build_merged_record(
    cfg: { bind_name: string, bind_type: string, mod_name: string, raw_ast_type: string, raw_var: string, arena_var: string, key_var: string, region_type: string },
    field_count: int64
) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    inner: string <- type_checker_record_types@record_case_inner_body(cfg.raw_ast_type);
    merged_base_type: string <- case length_bytes(cfg.bind_type) > 0 and substring(cfg.bind_type, 0, 1) == "{" of {
        true -> cfg.bind_type;
        false -> cfg.raw_ast_type
    };
    merged_ast_type: string <- merged_record_type_with_bundle_fields(merged_base_type, cfg.mod_name, 0, field_count);
    // Record-make layers are emitted from outer to inner.  Seed the ordinary
    // field merge with bundle overrides as its tail so the computed bundle is
    // stored after the raw constructor field, not overwritten by it.
    bundle_overrides: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- append_bundle_var_merge_layers(
        cfg.bind_name,
        cfg.bind_type,
        cfg.mod_name,
        0,
        field_count,
        merged_ast_type,
        sir_ast@dummy_sir_term()
    );
    build_merge_layers(inner, cfg.raw_ast_type, merged_ast_type, cfg.raw_var, cfg.arena_var, cfg.key_var, cfg.region_type, bundle_overrides)
}

fn build_collection_constructor_lets(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, bind_name: string, bind_type: string, rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rhs_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, inner_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    rhs_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(rhs_expr);
    mod_name: string <- type_checker_collections@module_name_from_qualified_call(rhs_node.name);
    key: int64 <- type_checker_collections@collection_specialization_key(bind_type, mod_name);
    region_type: string <- region_type_for_bind(bind_type);
    bind_type_sir: string <- types@type_name_to_sir(bind_type);
    raw_looked_up: string <- return_type_from_call(context, rhs_expr);
    bind_trim: string <- case length_bytes(bind_type) > 0 and substring(bind_type, 0, 1) == " " of {
        true -> substring(bind_type, 1, length_bytes(bind_type));
        false -> bind_type
    };
    raw_ast_type: string <- case length_bytes(raw_looked_up) of {
        0 -> case length_bytes(bind_trim) > 0 and substring(bind_trim, 0, 1) == "{" of {
            true -> bind_trim;
            false -> ""
        };
        _: int64 -> raw_looked_up
    };
    orient_lexeme: string <- type_checker_collections@constructor_orientation_atom_lexeme(mod_name);
    case length_bytes(raw_ast_type) == 0 of {
        true -> {
            prefixed_fn: string <- concat("%", bind_name);
            sir_ast@make_sir_term(2, bind_type_sir, "", prefixed_fn, rhs_sir, inner_sir)
        };
        false -> {
            key_name: string <- spec_key_binding_name(bind_name);
            arena_name: string <- arena_binding_name(bind_name);
            raw_name: string <- raw_binding_name(bind_name);
            key_prefixed: string <- concat("%", key_name);
            arena_prefixed: string <- concat("%", arena_name);
            raw_prefixed: string <- concat("%", raw_name);
            bind_prefixed: string <- concat("%", bind_name);
            key_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- int64_const_sir(key);
            arena_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_arena_lookup_sir(var_ref_sir(key_prefixed, "i64"), region_type);
            inject_bundles: int64 <- should_inject_ordering_bundles_i(bind_name);
            field_count_total: int64 <- ordering_field_count_for_merge(bind_type, mod_name);
            field_count: int64 <- case inject_bundles of {
                1 -> field_count_total;
                _: int64 -> 0
            };
            merge_raw_var: string <- case inject_bundles of {
                1 -> {
                    reanchor_name: string <- raw_reanchor_binding_name(bind_name);
                    concat("%", reanchor_name)
                };
                _: int64 -> raw_prefixed
            };
            merge_key_var: string <- case inject_bundles of {
                1 -> {
                    key_anchor_name: string <- key_reanchor_binding_name(bind_name);
                    concat("%", key_anchor_name)
                };
                _: int64 -> key_prefixed
            };
            merge_cfg: { bind_name: string, bind_type: string, mod_name: string, raw_ast_type: string, raw_var: string, arena_var: string, key_var: string, region_type: string } <- { bind_name: bind_name, bind_type: bind_type, mod_name: mod_name, raw_ast_type: raw_ast_type, raw_var: merge_raw_var, arena_var: arena_prefixed, key_var: merge_key_var, region_type: region_type };
            merged: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_merged_record(merge_cfg, field_count);
            bind_let: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(2, bind_type_sir, "", bind_prefixed, merged, inner_sir);
            bundle_cfg: { bind_name: string, bind_type: string, mod_name: string, raw_ast_type: string, raw_var: string, orient_lexeme: string, field_count: int64 } <- { bind_name: bind_name, bind_type: bind_type, mod_name: mod_name, raw_ast_type: raw_ast_type, raw_var: merge_raw_var, orient_lexeme: orient_lexeme, field_count: field_count };
            bind_with_bundles: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- wrap_bundle_side_lets(context, rhs_expr, bundle_cfg, 0, bind_let);
            bind_for_bundles: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case inject_bundles of {
                1 -> {
                    key_anchor_name: string <- key_reanchor_binding_name(bind_name);
                    key_anchor_prefixed: string <- concat("%", key_anchor_name);
                    key_reanchor_let: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(2, "i64", "", key_anchor_prefixed, var_ref_sir(key_prefixed, "i64"), bind_with_bundles);
                    key_reanchor_let
                };
                _: int64 -> bind_with_bundles
            };
            raw_body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case inject_bundles of {
                1 -> {
                    reanchor_name: string <- raw_reanchor_binding_name(bind_name);
                    reanchor_prefixed: string <- concat("%", reanchor_name);
                    reanchor_let: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(2, types@type_name_to_sir(raw_ast_type), "", reanchor_prefixed, var_ref_sir(raw_prefixed, types@type_name_to_sir(raw_ast_type)), bind_for_bundles);
                    sir_ast@make_sir_term(2, types@type_name_to_sir(raw_ast_type), "", raw_prefixed, rhs_sir, reanchor_let)
                };
                _: int64 -> sir_ast@make_sir_term(2, types@type_name_to_sir(raw_ast_type), "", raw_prefixed, rhs_sir, bind_for_bundles)
            };
            raw_let: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- raw_body;
            arena_let: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(2, types@type_name_to_sir(region_type), "", arena_prefixed, arena_sir, raw_let);
            sir_ast@make_sir_term(2, "i64", "", key_prefixed, key_sir, arena_let)
        }
    }
}
