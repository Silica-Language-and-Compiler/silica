// User-defined function calls to SIR ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 4, extension)
// Calls to user-defined functions (fn add(x, y) -> T) become call(callee, args)
// tail_call (kind 5) when the call is in tail position (sir_design_spec §5.2.6).
// effect_value: effect set + optional |sir_rec:... metadata (recursion_terms)

use sir_ast;
use types;

export build_user_call_0/3;
export build_user_call_1/4;
export build_user_call_2/5;
export build_user_call_3/6;
export build_user_call_with_rest/5;
export build_tail_call_0/3;
export build_tail_call_1/4;
export build_tail_call_2/5;
export build_tail_call_3/6;
export build_tail_call_with_rest/5;
export qual_name/1;

// Local function names: bare name; "m" → "main" (parser quirk for entry point)
fn qual_name(name: string) -> string {
    case name of {
        "m" -> "main";
        _: string -> name
    }
}

fn build_user_call_0(callee_name: string, expected_type: string, effect_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(4, sir_type, effect_value, callee_name, sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn build_user_call_1(callee_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string, effect_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(4, sir_type, effect_value, callee_name, arg1, sir_ast@dummy_sir_term())
}

fn build_user_call_2(callee_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string, effect_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(4, sir_type, effect_value, callee_name, arg1, arg2)
}

fn build_user_call_3(callee_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg3: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string, effect_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(6, "unit", "", "user_call_rest", arg2, arg3);
    sir_ast@make_sir_term(4, sir_type, effect_value, callee_name, arg1, rest)
}

fn build_user_call_with_rest(callee_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string, effect_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(4, sir_type, effect_value, callee_name, arg1, rest)
}

fn build_tail_call_0(callee_name: string, expected_type: string, effect_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(5, sir_type, effect_value, callee_name, sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn build_tail_call_1(callee_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string, effect_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(5, sir_type, effect_value, callee_name, arg1, sir_ast@dummy_sir_term())
}

fn build_tail_call_2(callee_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string, effect_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(5, sir_type, effect_value, callee_name, arg1, arg2)
