// Atom literal expression to SIR term ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 5) and atom built-in calls
// Literal: const(atom, value); print_atom(atom) -> call(atom, main.print_atom, [arg], [device_io])

use parser_ast;
use type_checker_core;
use sir_ast;
use types;

export expr_to_sir/2;
export build_print_atom_from_sir/2;
export build_atom_bits_from_sir/2;
export build_actor_ref_bits_from_sir/2;
export build_actor_id_from_sir/1;
export build_actor_ref_identity_from_sir/3;
export build_actor_ref_of_word_from_sir/2;

fn qual_name(name: string) -> string {
    concat("main.", name)
}

// Build SIR const term for atom literal ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 5)
fn expr_to_sir(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    sir_ast@make_sir_term(0, types@type_name_to_sir("atom"), node.value, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

// Build SIR call term for print_atom(atom) -> atom (:ok on success, :fail on failure). Effect: device_io.
fn build_print_atom_from_sir(call_name: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    callee: string <- qual_name(call_name);
    sir_ast@make_sir_term(4, "atom", "[device_io]", callee, arg, sir_ast@dummy_sir_term())
}

// atom_bits(atom) -> int64 dense id (opaque index into process atom table); pure; emitter inlines GPR move.
fn build_atom_bits_from_sir(call_name: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    callee: string <- qual_name(call_name);
    sir_ast@make_sir_term(4, "int64", "[]", callee, arg, sir_ast@dummy_sir_term())
}

// actor_ref_bits(actor_ref) -> int64 opaque word suitable for storing in buffers; pure; GPR identity lowering.
fn build_actor_ref_bits_from_sir(call_name: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    callee: string <- qual_name(call_name);
    sir_ast@make_sir_term(4, "int64", "[]", callee, arg, sir_ast@dummy_sir_term())
}

// actor_id(ref) -> uint64 (spec 15.1.4): a reference IS its actor's identity (position << 32 | child
// number), so the value is the reference word itself; it lowers like actor_ref_bits, typed uint64.
fn build_actor_id_from_sir(arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(4, "uint64", "[]", "main.actor_ref_bits", arg, sir_ast@dummy_sir_term())
}

// actor_ref_of_word(int64) -> actor_ref reciprocal of actor_ref_bits; trusts word encoding.
fn build_actor_ref_of_word_from_sir(call_name: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    callee: string <- qual_name(call_name);
    sir_ast@make_sir_term(4, "actor_ref", "[]", callee, arg, sir_ast@dummy_sir_term())
}

// actor_ref_equal / actor_ref_not_equal(left, right) -> boolean: identity comparison of two references
// of the same reference type (silica-specification section 7.4 and 15.1.4). Pure; lowers to the
// eq / nq compare prim, whose operands are the two reference words.
fn build_actor_ref_identity_from_sir(call_name: string, left: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    op: string <- case call_name == "actor_ref_equal" of {
        true -> "eq";
        false -> "nq"
    };
    sir_ast@make_sir_term(6, "bool", "", op, left, right)
}
