// Case and if-expression SIR lowering (open recursion callbacks).

use literals;
use parser_ast;
use sir_ast;
use type_checker_expressions_helpers;
use type_checker_lists;
use type_checker_record_types;
use type_checker_recursive_tuples;
use types;
use terms_helpers;
use type_checker_tuple_decompose_helpers;
use string_parse;

export case_expr_to_sir/8;
export if_expr_to_sir/8;
export label_copy_suffix/1;

fn trim_leading_ws(s: string) -> string {
    case length_bytes(s) == 0 of {
        true -> "";
        false -> case substring(s, 0, 1) == " " of {
            true -> trim_leading_ws(substring(s, 1, length_bytes(s)));
            false -> s
        }
    }
}

fn trim_trailing_ws(s: string) -> string {
    case length_bytes(s) == 0 of {
        true -> "";
        false -> case substring(s, length_bytes(s) - 1, length_bytes(s)) == " " of {
            true -> trim_trailing_ws(substring(s, 0, length_bytes(s) - 1));
            false -> s
        }
    }
}

fn trim_pat(s: string) -> string {
    trim_trailing_ws(trim_leading_ws(s))
}

fn find_colon_from(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == ":" of {
            true -> i;
            false -> find_colon_from(s, i + 1)
        }
    }
}

// Atom literal pattern :name (no ':' inside suffix); aligns with type_checker case_try_atom_literal_pattern.

fn is_atom_literal_pat(raw: string) -> boolean {
    case substring(raw, 0, 1) == ":" of {
        false -> false;
        true -> {
            atom_rest: string <- substring(raw, 1, length_bytes(raw));
            case length_bytes(atom_rest) == 0 of {
                true -> false;
                false -> find_colon_from(atom_rest, 0) < 0
            }
        }
    }
}

fn case_branch_opts(expected_type: string, bound_name: string, bound_type: string, in_body: boolean) -> { expected_type: string, bound_name: string, bound_type: string, in_body: boolean } {
    out: { expected_type: string, bound_name: string, bound_type: string, in_body: boolean } <- { expected_type: expected_type, bound_name: bound_name, bound_type: bound_type, in_body: in_body };
    out
}

fn make_case_branch(pkind: string, ptype: string, pname: string, ctx_use: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, opts: { expected_type: string, bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    guard_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(branch)) < 0 of {
        true -> sir_ast@dummy_sir_term();
        false -> case opts.in_body of {
            true -> lower_in_body(ctx_use, type_checker_expressions_helpers@expr_child_inner(branch), opts.bound_name, opts.bound_type, "boolean");
            false -> lower_expected(ctx_use, type_checker_expressions_helpers@expr_child_inner(branch), "boolean")
        }
    };
    body_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case opts.in_body of {
        true -> lower_in_body(ctx_use, type_checker_expressions_helpers@expr_child_right(branch), opts.bound_name, opts.bound_type, opts.expected_type);
        false -> lower_expected(ctx_use, type_checker_expressions_helpers@expr_child_right(branch), opts.expected_type)
    };
    sir_ast@make_sir_term(8, ptype, pkind, pname, guard_sir, body_sir)
}

// Pattern text like "hello" (string literal) — no colon; must not fall through to branch_from_bind_or_wild (dummy).

fn case_close_quote_index(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "\\" of {
            true -> case i + 1 >= length_bytes(s) of {
                true -> -1;
                false -> case_close_quote_index(s, i + 2)
            };
            false -> case substring(s, i, i + 1) == "\"" of {
                true -> i;
                false -> case_close_quote_index(s, i + 1)
            }
        }
    }
}

fn extract_string_pat_content(s: string) -> string {
    case length_bytes(s) < 2 of {
        true -> "";
        false -> case substring(s, 0, 1) == "\"" of {
            true -> {
                cq: int64 <- case_close_quote_index(s, 1);
                case cq < 0 of {
                    true -> "";
                    false -> substring(s, 1, cq)
                }
            };
            false -> ""
        }
    }
}

fn list_cons_bind_payload(hn: string, tn: string) -> string {
    concat(list_one_bind_list(hn), concat("|", list_one_bind_list(tn)))
}

fn list_one_bind_list(n: string) -> string {
    case n == "_" of { true -> "_"; false -> concat("%", n) }
}

fn make_case_branch_list_cons(cons: { head_name: string, head_type: string, tail_name: string, tail_list_type: string }, ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, opts: { expected_type: string, bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    ctx_h: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- case length_bytes(cons.head_name) > 0 and cons.head_name != "_" of {
        true -> terms_helpers@extend_context_for_bind(ctx, cons.head_name, cons.head_type);
        false -> ctx
    };
    ctx_ht: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- case length_bytes(cons.tail_name) > 0 and cons.tail_name != "_" of {
        true -> terms_helpers@extend_context_for_bind(ctx_h, cons.tail_name, cons.tail_list_type);
        false -> ctx_h
    };
    guard_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(branch)) < 0 of {
        true -> sir_ast@dummy_sir_term();
        false -> case opts.in_body of {
            true -> lower_in_body(ctx_ht, type_checker_expressions_helpers@expr_child_inner(branch), opts.bound_name, opts.bound_type, "boolean");
            false -> lower_expected(ctx_ht, type_checker_expressions_helpers@expr_child_inner(branch), "boolean")
        }
    };
    body_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case opts.in_body of {
        true -> lower_in_body(ctx_ht, type_checker_expressions_helpers@expr_child_right(branch), opts.bound_name, opts.bound_type, opts.expected_type);
        false -> lower_expected(ctx_ht, type_checker_expressions_helpers@expr_child_right(branch), opts.expected_type)
    };
    ht_sir: string <- concat(types@type_name_to_sir(cons.head_type), concat("|", types@type_name_to_sir(cons.tail_list_type)));
    bind_s: string <- list_cons_bind_payload(cons.head_name, cons.tail_name);
    sir_ast@make_sir_term(8, ht_sir, "list_cons", bind_s, guard_sir, body_sir)
}

fn branch_from_bind_or_wild(raw: string, scrutinee_ast_type: string, branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, opts: { expected_type: string, bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case raw == "_" of {
        true -> make_case_branch("wild", types@type_name_to_sir(scrutinee_ast_type), "_", ctx, branch, opts, lower_expected, lower_in_body);
        false -> {
            cp: int64 <- find_colon_from(raw, 0);
            case cp < 1 of {
                true -> sir_ast@dummy_sir_term();
                false -> {
                    left: string <- trim_pat(substring(raw, 0, cp));
                    right: string <- trim_pat(substring(raw, cp + 1, length_bytes(raw)));
                    case left == "_" of {
                        true -> make_case_branch("wild", types@type_name_to_sir(right), "_", ctx, branch, opts, lower_expected, lower_in_body);
                        false -> {
                            ctx_b: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- terms_helpers@extend_context_for_bind(ctx, left, right);
                            make_case_branch("bind", types@type_name_to_sir(right), concat("%", left), ctx_b, branch, opts, lower_expected, lower_in_body)
                        }
                    }
                }
            }
        }
    }
}

fn branch_ast_to_sir(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, scrutinee_ast_type: string, opts: { expected_type: string, bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    raw: string <- trim_pat(type_checker_expressions_helpers@expr_value(branch));
    case raw == ":none" of {
        true -> make_case_branch("atom", "atom", raw, ctx, branch, opts, lower_expected, lower_in_body);
        false -> case is_atom_literal_pat(raw) and (type_checker_recursive_tuples@is_ref_optional_type(scrutinee_ast_type) or (length_bytes(scrutinee_ast_type) >= 6 and substring(scrutinee_ast_type, 0, 6) == ":none|")) of {
            true -> make_case_branch("atom", "atom", raw, ctx, branch, opts, lower_expected, lower_in_body);
            false -> branch_ast_to_sir_after_atom(raw, branch, ctx, scrutinee_ast_type, opts, lower_expected, lower_in_body)
        }
    }
}

fn branch_ast_to_sir_after_atom(raw: string, branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, scrutinee_ast_type: string, opts: { expected_type: string, bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    lep: { ok: boolean, list_type: string } <- type_checker_lists@parse_list_empty_case_pattern(raw);
    case lep.ok of {
        true -> make_case_branch("list_nil", types@type_name_to_sir(lep.list_type), "", ctx, branch, opts, lower_expected, lower_in_body);
        false -> {
            lcp: { ok: boolean, head_name: string, head_type: string, tail_name: string, tail_list_type: string } <- type_checker_lists@parse_list_cons_case_pattern(raw);
            case lcp.ok of {
                true -> make_case_branch_list_cons({ head_name: lcp.head_name, head_type: lcp.head_type, tail_name: lcp.tail_name, tail_list_type: lcp.tail_list_type }, ctx, branch, opts, lower_expected, lower_in_body);
                false -> case raw == "true" of {
                    true -> make_case_branch("bool", "bool", "true", ctx, branch, opts, lower_expected, lower_in_body);
                    false -> case raw == "false" of {
                        true -> make_case_branch("bool", "bool", "false", ctx, branch, opts, lower_expected, lower_in_body);
                        false -> case substring(raw, 0, 1) == "\"" of {
                            true -> {
                                str_content: string <- extract_string_pat_content(raw);
                                make_case_branch("string", "string", str_content, ctx, branch, opts, lower_expected, lower_in_body)
                            };
                            false -> case length_bytes(raw) >= 3 and substring(raw, 0, 1) == "'" and substring(raw, length_bytes(raw) - 1, length_bytes(raw)) == "'" of {
                                true -> make_case_branch("int", "int64", literals@int64_to_decimal_string(literals@char_lexeme_to_utf8_encoded(raw)), ctx, branch, opts, lower_expected, lower_in_body);
                                false -> case string_parse@is_integer_literal_text(raw) of {
                                    true -> make_case_branch("int", types@type_name_to_sir(scrutinee_ast_type), raw, ctx, branch, opts, lower_expected, lower_in_body);
                                    false -> case is_atom_literal_pat(raw) of {
                                        true -> case scrutinee_ast_type == "failure_reason" of {
                                            // Phase C: §15.4.11 failure_reason variants; branch pattern type carries scrutinee (emitter still matches via kind atom).
                                            true -> make_case_branch("atom", "failure_reason", raw, ctx, branch, opts, lower_expected, lower_in_body);
                                            false -> make_case_branch("atom", "atom", raw, ctx, branch, opts, lower_expected, lower_in_body)
                                        };
                                        false -> case type_checker_record_types@record_type_starts(raw) of {
                                            true -> case type_checker_record_types@record_type_braces_balanced(raw) of {
                                                true -> {
                                                    ctx_re: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- terms_helpers@sir_case_extend_context_for_pattern(ctx, scrutinee_ast_type, raw);
                                                    // A sum-typed scrutinee (`:none | { id: uint32 }`, spec §3.4.2, §15.4.8): the branch
                                                    // carries the record variant this pattern matches, chosen as the type checker chose it.
                                                    record_branch_t: string <- case type_checker_tuple_decompose_helpers@case_sum_bar_depth0(scrutinee_ast_type, 0, 0) >= 0 of {
                                                        false -> scrutinee_ast_type;
                                                        true -> {
                                                            variant_r: string <- type_checker_tuple_decompose_helpers@case_record_variant_for_pattern(raw, scrutinee_ast_type);
                                                            case length_bytes(variant_r) >= 2 of { true -> variant_r; false -> scrutinee_ast_type }
                                                        }
                                                    };
                                                    make_case_branch("record", types@type_name_to_sir(record_branch_t), raw, ctx_re, branch, opts, lower_expected, lower_in_body)
                                                };
                                                false -> branch_from_bind_or_wild(raw, scrutinee_ast_type, branch, ctx, opts, lower_expected, lower_in_body)
                                            };
                                            false -> case length_bytes(raw) >= 2 and substring(raw, 0, 1) == "(" and substring(raw, length_bytes(raw) - 1, length_bytes(raw)) == ")" of {
                                                true -> {
                                                    ctx_tu: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- terms_helpers@sir_case_extend_context_for_pattern(ctx, scrutinee_ast_type, raw);
                                                    // A sum-typed scrutinee (`:none | (:some, T)`, spec §15.4.11.2): the branch carries the
                                                    // tuple variant this pattern matches, chosen exactly as the type checker chose it
                                                    // (case_tuple_variant_for_pattern), so the emitter indexes that variant's elements.
                                                    tuple_branch_t: string <- case type_checker_tuple_decompose_helpers@case_sum_bar_depth0(scrutinee_ast_type, 0, 0) >= 0 of {
                                                        false -> scrutinee_ast_type;
                                                        true -> {
                                                            variant_t: string <- type_checker_tuple_decompose_helpers@case_tuple_variant_for_pattern(raw, scrutinee_ast_type);
                                                            case length_bytes(variant_t) >= 2 of { true -> variant_t; false -> scrutinee_ast_type }
                                                        }
                                                    };
                                                    make_case_branch("tuple", types@type_name_to_sir(tuple_branch_t), raw, ctx_tu, branch, opts, lower_expected, lower_in_body)
                                                };
                                                false -> branch_from_bind_or_wild(raw, scrutinee_ast_type, branch, ctx, opts, lower_expected, lower_in_body)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn case_branches_to_sir_list(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, scrutinee_ast_type: string, opts: { expected_type: string, bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(e) < 0 of {
        true -> sir_ast@dummy_sir_term();
        false -> case type_checker_expressions_helpers@expr_kind(e) - 17 == 0 of {
            true -> {
                one: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- branch_ast_to_sir(type_checker_expressions_helpers@expr_child_inner(e), ctx, scrutinee_ast_type, opts, lower_expected, lower_in_body);
                rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case_branches_to_sir_list(type_checker_expressions_helpers@expr_child_right(e), ctx, scrutinee_ast_type, opts, lower_expected, lower_in_body);
                sir_ast@make_sir_term(7, "", "", "", one, rest)
            };
            false -> sir_ast@dummy_sir_term()
        }
    }
}

// Per-implementation copies of one function (trait_specialization) lower the same source expression
// once per copy, so an offset-derived label id alone would repeat in the unit. The copy pass stores
// the copy's tag in the otherwise empty `name` of case / if / and / or nodes; this appends it. Empty
// for every ordinary function, whose labels are unchanged.
fn label_copy_suffix(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    tag: string <- type_checker_expressions_helpers@expr_name(expr);
    case length_bytes(tag) == 0 of {
        true -> "";
        false -> concat("_", tag)
    }
}

fn case_expr_to_sir(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, bound_name: string, bound_type: string, in_body: boolean, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    scrut_ast_t: string <- terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
    scrut_sir_t: string <- types@type_name_to_sir(scrut_ast_t);
    scrut: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
        true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, scrut_ast_t);
        false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), scrut_ast_t);
    };
    branches: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case_branches_to_sir_list(type_checker_expressions_helpers@expr_child_right(expr), context, scrut_ast_t, case_branch_opts(expected_type, bound_name, bound_type, in_body), lower_expected, lower_in_body);
    case_emit_suffix: string <- concat(concat("o", literals@int64_to_decimal_string(type_checker_expressions_helpers@expr_loc(expr).offset)), label_copy_suffix(expr));
    sir_ast@make_sir_term(3, types@type_name_to_sir(expected_type), scrut_sir_t, case_emit_suffix, scrut, branches)
}

// Lower `if` / `else` (AST kind 19) to a boolean `case` on the condition. Placed after `case_expr_to_sir`; callers use forward reference.

fn if_expr_to_sir(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, bound_name: string, bound_type: string, in_body: boolean, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    loc: { file: string, line: int64, column: int64, offset: int64 } <- type_checker_expressions_helpers@expr_loc(expr);
    dummy_g: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    then_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr));
    else_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr));
    true_br: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(18, "true", "", loc, dummy_g, then_e, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
    false_br: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(18, "false", "", loc, dummy_g, else_e, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
    rest_dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    list_inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(17, "", "", loc, false_br, rest_dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
    list_head: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(17, "", "", loc, true_br, list_inner, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
    case_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(13, "", type_checker_expressions_helpers@expr_name(expr), loc, type_checker_expressions_helpers@expr_child_inner(expr), list_head, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
    case_expr_to_sir(context, case_e, expected_type, bound_name, bound_type, in_body, lower_expected, lower_in_body)
}

