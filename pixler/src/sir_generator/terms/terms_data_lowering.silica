// List/struct/field-access SIR lowering (open recursion callbacks).

use collection_constructor_calls;
use list_terms;
use sir_ast;
use struct_terms;
use type_checker_expressions_helpers;
use type_checker_lists;
use type_checker_record_types;
use types;
use terms_helpers;

export build_list_primitive_from_expr/8;
export expr_list_literal_from_expected_type/8;
export expr_list_literal_from_root/7;
export lower_field_access_expr/7;
export lower_struct_literal_expr/8;

fn lower_list_literal_elems(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, elem_t: string, list_t: string, body_opts: { bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(expr) == 20 of {
        true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == -1 of {
            true -> list_terms@build_list_nil(elem_t, list_t);
            false -> {
                head: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case body_opts.in_body of {
                    true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), body_opts.bound_name, body_opts.bound_type, elem_t);
                    false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), elem_t)
                };
                tail: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == -1 of {
                    true -> list_terms@build_list_nil(elem_t, list_t);
                    // Spine pairs carry name ","; a kind-20 node without it in the right slot is the last
                    // element and itself a list literal (`[[1], [2, 3]]`), lowered as one element.
                    false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 20 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) != "," of {
                        true -> lower_list_literal_leaf(context, type_checker_expressions_helpers@expr_child_right(expr), elem_t, list_t, body_opts, lower_expected, lower_in_body);
                        false -> lower_list_literal_elems(context, type_checker_expressions_helpers@expr_child_right(expr), elem_t, list_t, body_opts, lower_expected, lower_in_body)
                    }
                };
                list_terms@build_list_cons(head, tail, list_t)
            }
        };
        false -> lower_list_literal_leaf(context, expr, elem_t, list_t, body_opts, lower_expected, lower_in_body)
    }
}

// One element as a singleton cons (the last element of a spine, or a bare single element).
fn lower_list_literal_leaf(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, elem_t: string, list_t: string, body_opts: { bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    leaf_head: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case body_opts.in_body of {
        true -> lower_in_body(context, expr, body_opts.bound_name, body_opts.bound_type, elem_t);
        false -> lower_expected(context, expr, elem_t)
    };
    list_terms@build_list_cons(leaf_head, list_terms@build_list_nil(elem_t, list_t), list_t)
}

fn expr_list_literal_from_root(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    (ok: boolean, elem: string, space: string) <- type_checker_lists@parse_list_type_params(type_checker_expressions_helpers@expr_value(expr));
    case ok of {
        false -> sir_ast@dummy_sir_term();
        true -> {
            lt: string <- type_checker_lists@format_list_type_from_parts(elem, space);
            lower_list_literal_elems(context, expr, elem, lt, { bound_name: bound_name, bound_type: bound_type, in_body: in_body }, lower_expected, lower_in_body)
        }
    }
}

fn expr_list_literal_from_expected_type(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    (ok: boolean, elem: string, space: string) <- type_checker_lists@parse_list_type_params(expected_type);
    case ok of {
        false -> sir_ast@dummy_sir_term();
        true -> {
            lt: string <- type_checker_lists@format_list_type_from_parts(elem, space);
            lower_list_literal_elems(context, expr, elem, lt, { bound_name: bound_name, bound_type: bound_type, in_body: in_body }, lower_expected, lower_in_body)
        }
    }
}

// Kind 21: struct literal `{ f: e, ... }` -> nested prim record_make (sir_design_spec §7.6).

fn lower_struct_literal_chain(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rt: string, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(expr) != 21 of {
        true -> sir_ast@dummy_sir_term();
        false -> {
            ft0: string <- type_checker_record_types@find_field_type_in_record(rt, type_checker_expressions_helpers@expr_name(expr));
            inferred_ft: string <- terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
            ft: string <- case length_bytes(ft0) == 0 of {
                true -> case inferred_ft == "" of { true -> "int64"; false -> inferred_ft };
                false -> ft0
            };
            case length_bytes(ft) == 0 of {
                true -> sir_ast@dummy_sir_term();
                false -> {
                    val: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                        true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, ft);
                        false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), ft)
                    };
                    sir_rt: string <- types@type_name_to_sir(rt);
                    case struct_terms@is_last_struct_literal_node(expr) of {
                        true -> struct_terms@build_record_make_layer(sir_rt, type_checker_expressions_helpers@expr_name(expr), val, sir_ast@dummy_sir_term());
                        false -> {
                            rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_struct_literal_chain(context, type_checker_expressions_helpers@expr_child_right(expr), rt, in_body, bound_name, bound_type, lower_expected, lower_in_body);
                            struct_terms@build_record_make_layer(sir_rt, type_checker_expressions_helpers@expr_name(expr), val, rest)
                        }
                    }
                }
            }
        }
    }
}

fn lower_struct_literal_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    rt0: string <- struct_terms@record_type_for_struct_literal(context, expr, expected_type);
    rt: string <- case type_checker_record_types@record_type_starts(rt0) of {
        true -> rt0;
        false -> terms_helpers@sir_infer_struct_literal_type(context, expr)
    };
    case length_bytes(rt) == 0 of {
        true -> sir_ast@dummy_sir_term();
        false -> case type_checker_record_types@record_type_starts(rt) of {
            false -> sir_ast@dummy_sir_term();
            true -> lower_struct_literal_chain(context, expr, rt, in_body, bound_name, bound_type, lower_expected, lower_in_body)
        }
    }
}

// Kind 22: field access `base.field` -> list surface fields or record_proj.

fn lower_list_field_access(
    base_s: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 },
    list_t: string,
    elem: string,
    field: string
) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case field == "is_nil" of {
        true -> {
            len_t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- list_terms@build_list_length_prim(base_s);
            zero: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(0, "int64", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
            sir_ast@make_sir_term(6, "bool", "", "eq", len_t, zero)
        };
        false -> case field == "head" of {
            true -> list_terms@build_list_head_prim(base_s, elem);
            false -> case field == "tail" of {
                true -> list_terms@build_list_remove_head_prim(base_s, list_t);
                false -> sir_ast@dummy_sir_term()
            }
        }
    }
}

fn lower_field_access_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    base_t: string <- terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
    (ok_list: boolean, elem: string, space: string) <- type_checker_lists@parse_list_type_params(base_t);
    case ok_list of {
        true -> {
            base_s: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, base_t);
                false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), base_t)
            };
            list_t: string <- type_checker_lists@format_list_type_from_parts(elem, space);
            lower_list_field_access(base_s, list_t, elem, type_checker_expressions_helpers@expr_name(expr))
        };
        false -> {
            ft: string <- type_checker_record_types@find_field_type_in_record(base_t, type_checker_expressions_helpers@expr_name(expr));
            case length_bytes(ft) == 0 of {
                true -> sir_ast@dummy_sir_term();
                false -> {
                    base_s: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                        true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, base_t);
                        false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), base_t)
                    };
                    ft_sir: string <- types@type_name_to_sir(ft);
                    struct_terms@build_record_proj_prim(ft_sir, type_checker_expressions_helpers@expr_name(expr), base_s)
                }
            }
        }
    }
}

fn build_list_primitive_from_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    (elem0: string, space: string) <- type_checker_lists@parse_generic_ts(type_checker_expressions_helpers@expr_value(expr));
    list_t0: string <- type_checker_lists@format_list_type_from_parts(elem0, space);
    // list_nth carries no [T, S] generic args, so the list type comes from the list argument
    // itself. It must be INFERRED from the expression (as the type checker and the seed do):
    // looking it up by the argument's name only works for a plain variable, and for a field
    // projection such as `expr.nodes` the lookup came back empty, the element type was lost,
    // and the emitter treated a record element as a scalar (`LDR X0, [X10]` on the slot
    // address). That is why gen3 faulted in parser_ast@expr_root_kind on its first parse.
    list_t: string <- case type_checker_expressions_helpers@expr_name(expr) == "list_nth" of {
        true -> terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
        false -> list_t0
    };
    elem: string <- case type_checker_expressions_helpers@expr_name(expr) == "list_nth" of {
        true -> type_checker_lists@list_element_type_from_list_type(list_t);
        false -> elem0
    };
    case type_checker_expressions_helpers@expr_name(expr) == "list_at" or type_checker_expressions_helpers@expr_name(expr) == "list_nth" of {
            true -> {
                a: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                    true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, list_t);
                    false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), list_t)
                };
                i: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                    true -> lower_in_body(context, terms_helpers@region_call_second_arg(expr), bound_name, bound_type, "int64");
                    false -> lower_expected(context, terms_helpers@region_call_second_arg(expr), "int64")
                };
                list_terms@build_list_at_prim(a, i, elem)
            };
            false -> case type_checker_expressions_helpers@expr_name(expr) == "empty" of {
        true -> list_terms@build_list_nil(elem, list_t);
        false -> case type_checker_expressions_helpers@expr_name(expr) == "prepend" of {
            true -> {
                h: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                    true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, elem);
                    false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), elem)
                };
                t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                    true -> lower_in_body(context, terms_helpers@region_call_second_arg(expr), bound_name, bound_type, list_t);
                    false -> lower_expected(context, terms_helpers@region_call_second_arg(expr), list_t)
                };
                list_terms@build_list_cons(h, t, list_t)
            };
            false -> case type_checker_expressions_helpers@expr_name(expr) == "length" of {
                true -> {
                    a: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                        true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, list_t);
                        false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), list_t)
                    };
                    list_terms@build_list_length_prim(a)
                };
                false -> case type_checker_expressions_helpers@expr_name(expr) == "remove_head" of {
                    true -> {
                        a: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                            true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, list_t);
                            false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), list_t)
                        };
                        list_terms@build_list_remove_head_prim(a, list_t)
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "head" of {
                        true -> {
                            a: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                                true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, list_t);
                                false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), list_t)
                            };
                            list_terms@build_list_head_prim(a, elem)
                        };
                        false -> sir_ast@dummy_sir_term()
                    }
                }
            }
        }
    }
        }
}

// Convert { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } to SIR handle with expected type (for function body). Dispatches on kind.

