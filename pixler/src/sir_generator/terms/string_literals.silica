// String literal expression to SIR term ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 8, extension)
// Per language spec §2.2: string_literal ::= "\"" {character | escape_sequence} "\""
// { source: string, position: int64, line: int64, column: int64, file: string } produces string_literal token; parser builds { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } { kind: 8, value: lexeme }
// SIR: const(string, content) — content is lexeme with quotes stripped and escapes resolved
// Strings are UTF-8 (Unicode) per spec §2.1

use parser_ast;
use sir_ast;
use types;
use string_escapes;

export expr_to_sir/2;

// Strip surrounding double quotes from lexeme. Lexeme is "\"content\"" from lexer.
// Use character length: runtime substring is character-indexed, while len is bytes.
fn string_content(lexeme: string) -> string {
    n: int64 <- length_chars(lexeme);
    case n >= 2 of {
        true -> substring(lexeme, 1, n - 1);
        false -> lexeme
    }
}

// Build SIR const term for string literal ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 8)
fn expr_to_sir(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    raw_content: string <- string_content(node.value);
    content: string <- string_escapes@resolve_string_escapes(raw_content);
    sir_type: string <- types@type_name_to_sir("string");
    sir_ast@make_sir_term(0, sir_type, raw_content, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}
