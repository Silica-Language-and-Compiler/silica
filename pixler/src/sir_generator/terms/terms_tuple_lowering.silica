// Tuple inline and decompose SIR lowering (open recursion callbacks).

use sir_ast;
use tuple_decompose;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use types;
use terms_helpers;

export expr_to_sir_tuple_decompose/5;
export expr_to_sir_tuple_decompose_in_body/7;
export expr_to_sir_tuple_inline/5;
export sir_tuple_decompose_rhs_type/2;

fn sir_tuple_decompose_rhs_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }) -> string {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == 11 of {
        true -> terms_helpers@sir_infer_expr_type(terms_helpers@sir_context_after_sequence_body(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_inner(expr)), context), type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_inner(expr)));
        false -> terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr))
    }
}

fn expr_to_sir_tuple_decompose(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    rhs_type_infer: string <- sir_tuple_decompose_rhs_type(expr, context);
    rhs_type: string <- case length_bytes(rhs_type_infer) < 2 or substring(rhs_type_infer, 0, 1) != "(" of {
        true -> type_checker_tuple_decompose_helpers@build_pattern_type_from_bindings(type_checker_expressions_helpers@expr_pattern_bindings(expr));
        false -> rhs_type_infer
    };
    case length_bytes(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
        true -> sir_ast@dummy_sir_term();
        false -> {
            filled_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)] <- tuple_decompose@tuple_decompose_filled_bindings(expr, rhs_type);
            rhs_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), rhs_type);
            extended_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- terms_helpers@add_bindings_to_context(context, filled_bindings);
            body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(extended_context, type_checker_expressions_helpers@expr_child_right(expr), "", "", expected_type);
            tuple_decompose@build_decompose_lets(rhs_term, filled_bindings, body, context, rhs_type)
        }
    }
}

fn expr_to_sir_tuple_decompose_in_body(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, bound_name: string, bound_type: string, expected_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    rhs_type_infer: string <- sir_tuple_decompose_rhs_type(expr, context);
    rhs_type: string <- case length_bytes(rhs_type_infer) < 2 or substring(rhs_type_infer, 0, 1) != "(" of {
        true -> type_checker_tuple_decompose_helpers@build_pattern_type_from_bindings(type_checker_expressions_helpers@expr_pattern_bindings(expr));
        false -> rhs_type_infer
    };
    case length_bytes(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
        true -> sir_ast@dummy_sir_term();
        false -> {
            filled_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)] <- tuple_decompose@tuple_decompose_filled_bindings(expr, rhs_type);
            rhs_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, rhs_type);
            extended_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- terms_helpers@add_bindings_to_context(context, filled_bindings);
            body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_in_body(extended_context, type_checker_expressions_helpers@expr_child_right(expr), "", "", expected_type);
            tuple_decompose@build_decompose_lets(rhs_term, filled_bindings, body, context, rhs_type)
        }
    }
}

fn expr_to_sir_tuple_inline(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    // An expected inline sum type (`:none | (:some, T)`, silica-specification §15.4.11.2) contributes
    // the tagged-tuple variant this literal builds; the tuple itself carries that variant's type.
    variant_type: string <- sum_variant_for_tuple_literal(expr, expected_type);
    first_type: string <- terms_helpers@tuple_first_element_type(variant_type);
    rest_type: string <- terms_helpers@tuple_rest_element_type(variant_type);
    first: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), first_type);
    second: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_right(expr), rest_type);
    sir_type: string <- types@type_name_to_sir(variant_type);
    sir_ast@make_sir_term(6, sir_type, "", "tuple_make", first, second)
}

// The tagged-tuple variant of an inline sum type that this tuple literal builds: the variant whose
// first element is the literal's leading atom, else the sum's first tuple variant. A non-sum
// expected type is returned unchanged.
fn sum_variant_for_tuple_literal(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string) -> string {
    case type_checker_tuple_decompose_helpers@case_sum_bar_depth0(expected_type, 0, 0) < 0 of {
        true -> expected_type;
        false -> {
            head_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(expr);
            tag: string <- case type_checker_expressions_helpers@expr_kind(head_e) == 5 of {
                true -> type_checker_expressions_helpers@expr_value(head_e);
                false -> ""
            };
            found: string <- sum_variant_scan_sir(expected_type, tag);
            case length_bytes(found) == 0 of {
                true -> expected_type;
                false -> found
            }
        }
    }
}

fn sum_variant_scan_sir(rest: string, tag: string) -> string {
    bar: int64 <- type_checker_tuple_decompose_helpers@case_sum_bar_depth0(rest, 0, 0);
    head: string <- case bar < 0 of {
        true -> type_checker_tuple_decompose_helpers@tuple_trim(rest);
        false -> type_checker_tuple_decompose_helpers@tuple_trim(substring(rest, 0, bar))
    };
    hit: boolean <- case type_checker_tuple_decompose_helpers@case_is_tuple_pattern_form(head) of {
        false -> false;
        true -> case length_bytes(tag) == 0 of {
            true -> true;
            false -> type_checker_tuple_decompose_helpers@tuple_trim(terms_helpers@tuple_first_element_type(head)) == tag
        }
    };
    case hit of {
        true -> head;
        false -> case bar < 0 of {
            true -> "";
            false -> sum_variant_scan_sir(substring(rest, bar + 1, length_bytes(rest)), tag)
        }
    }
}
