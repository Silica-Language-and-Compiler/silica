// SIR internal data structures (AST representation)
// SIR is held in memory; text .sir format is for debugging/export only
//
// Wave C (seed-legal): no named struct declarations.
//   SIRTerm handle = { nodes: List[<Node>, mem(normal)], root: int64 } with root == -1 for none/dummy
//   Node = { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }
//   Linear collections use List[T, mem(normal)].

export dummy_sir_term/0;
export make_sir_term/6;
export dummy_sir_function/0;
export cons_sir_functions/2;
export nil_sir_functions/0;
export nil_sir_strings/0;
export cons_sir_string/2;
export sir_string_list_contains/2;
export dummy_export_item/0;
export nil_sir_exports/0;
export cons_sir_export/2;
export dummy_required_method_sig/0;
export nil_required_method_sigs/0;
export cons_required_method_sig/2;
export dummy_supervisor_phase_e/0;
export nil_supervisor_phase_e/0;
export cons_supervisor_phase_e/2;
export sir_supervisor_phase_e_rows_to_text/2;
export dummy_sir_foreign_binding/0;
export nil_sir_foreign_bindings/0;
export cons_sir_foreign_binding/2;
export dummy_sir_module/0;
export nil_sir_modules/0;
export cons_sir_module/2;
export sir_term_to_text/1;
export sir_module_to_text/1;

// Supervisors plan Phase E (supervisors_implementation_development_plan.md §15.4.12–15.4.13.2):
// concrete `impl T for Supervisor` + SIR of `init`'s return type (static child_spec / supervisor_flags used by
// runtime internal child table and automatic restart; pairs with `impl_supervisor T` in module text).
// Row: { actor_type: string, init_return_sir: string, init_return_type_name: string }

// SIRTerm node kinds: 0=const, 1=var, 2=let, 3=case, 4=call, 5=tail_call, 6=prim,
//   7=case_branch_seq, 8=case_branch; see prior comments for slot layout.

fn empty_sir_term_nodes() -> List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- empty[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]()
    produces
        pure result
    end
}

fn dummy_sir_term() -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sequence
        nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- empty_sir_term_nodes();
        result: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- { nodes: nodes, root: -1 }
    produces
        pure result
    end
}

fn sir_term_nodes_reverse_acc(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], acc: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- case nodes.is_nil of {
            true -> acc;
            false -> {
                stepped: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- prepend[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes.head, acc);
                sir_term_nodes_reverse_acc(nodes.tail, stepped)
                
            }
        }
    produces
        pure result
    end
}

fn sir_term_nodes_reverse(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] {
    sir_term_nodes_reverse_acc(nodes, empty_sir_term_nodes())
}

fn sir_term_nodes_append(a: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], b: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- case a.is_nil of {
            true -> b;
            false -> prepend[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](a.head, sir_term_nodes_append(a.tail, b))
        }
    produces
        pure result
    end
}

fn sir_term_remap_node(n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, offset: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    inner2: int64 <- case n.inner < 0 of { true -> -1; false -> n.inner + offset };
    right2: int64 <- case n.right_expr < 0 of { true -> -1; false -> n.right_expr + offset };
    { kind: n.kind, type_name: n.type_name, value: n.value, name: n.name, inner: inner2, right_expr: right2 }
}

fn sir_term_remap_nodes(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], offset: int64) -> List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] {
    sequence proc[mem(normal)]  
    result: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- case nodes.is_nil of {
        true -> empty_sir_term_nodes();
        false -> {
            hd: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_remap_node(nodes.head, offset);
            prepend[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](hd, sir_term_remap_nodes(nodes.tail, offset))
            }
        }
    produces
        pure result
    end
}

// Build a binary SIRTerm handle by merging child arenas (Wave C). Dummy children use root == -1.
fn make_sir_term(kind_v: int64, type_name_v: string, value_v: string, name_v: string,
                 left: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 },
                 right: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sequence proc[mem(normal)]
        empty_n: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- empty_sir_term_nodes();
        left_absent: boolean <- left.root < 0;
        right_absent: boolean <- right.root < 0;
        left_nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- case left_absent of { true -> empty_n; false -> left.nodes };
        right_nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- case right_absent of { true -> empty_n; false -> right.nodes };
        left_len: int64 <- case left_absent of { true -> 0; false -> length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](left_nodes) };
        right_len: int64 <- case right_absent of { true -> 0; false -> length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](right_nodes) };
        left_idx: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- sir_term_nodes_reverse(left_nodes);
        right_remapped: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- sir_term_remap_nodes(right_nodes, left_len);
        right_idx: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- sir_term_nodes_reverse(right_remapped);
        combined_idx: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- sir_term_nodes_append(left_idx, right_idx);
        left_root: int64 <- case left_absent of { true -> -1; false -> left.root };
        right_root: int64 <- case right_absent of { true -> -1; false -> right.root + left_len };
        new_node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- { kind: kind_v, type_name: type_name_v, value: value_v, name: name_v, inner: left_root, right_expr: right_root };
        with_new: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- sir_term_nodes_append(combined_idx, prepend[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](new_node, empty_n));
        new_root: int64 <- left_len + right_len;
        result: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- { nodes: sir_term_nodes_reverse(with_new), root: new_root }
    produces
        pure result
    end
}

fn dummy_sir_function() -> { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string } {
    out: { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string } <- { name: "", return_type: "", effects: "[]", body: dummy_sir_term(), param_names: "", param_types: "" };
    out
}

fn cons_sir_functions(fn_val: { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, rest: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] <- prepend[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)](fn_val, rest)
    produces
        pure result
    end
}

fn nil_sir_functions() -> List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] <- empty[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]()
    produces
        pure result
    end
}

fn nil_sir_strings() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure result
    end
}

fn cons_sir_string(s: string, rest: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- prepend[string, mem(normal)](s, rest)
    produces
        pure result
    end
}

fn sir_string_list_contains(items: List[string, mem(normal)], needle: string) -> boolean {
    case items.is_nil of {
        true -> false;
        false -> case items.head == needle of {
            true -> true;
            false -> sir_string_list_contains(items.tail, needle)
        }
    }
}

