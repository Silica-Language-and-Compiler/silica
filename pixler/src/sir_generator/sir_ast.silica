fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}

// Nodes are prepend-built with ascending indices; index i is at list position (len - 1 - i).
fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                // Direct return of the list element, as emitter_core's node_at has done since the
                // 2026-09-09 revert: the bind-then-rebuild copy cost 0.15 GB during emission alone
                // and the seed no longer miscompiles the direct form (builds 3-11, suites green).
                false -> list_nth(nodes, n - 1 - idx)
            }
        }
    }
}

fn sir_term_to_text_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> string {
    case idx < 0 of {
        true -> "dummy";
        false -> {
            term: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_node_at(nodes, idx);
            case term.kind < 0 of {
                true -> "dummy";
                false -> case term.kind of {
                    0 -> {
                        c1: string <- concat("const(", term.type_name);
                        c2: string <- concat(", ", term.value);
                        concat(c1, concat(c2, ")"))
                    };
                    1 -> concat("var(", concat(term.name, ")"));
                    2 -> {
                        inner_t: string <- sir_term_to_text_at(nodes, term.inner);
                        body_t: string <- sir_term_to_text_at(nodes, term.right_expr);
                        part1: string <- concat("let(", term.name);
                        part2: string <- concat(part1, concat(", ", inner_t));
                        part3: string <- concat(part2, concat(", ", body_t));
                        concat(part3, ")")
                    };
                    4 -> {
                        arg_t: string <- sir_term_to_text_at(nodes, term.inner);
                        c1: string <- concat("call(", term.name);
                        c2: string <- concat(c1, concat(", ", arg_t));
                        c3: string <- case term.right_expr < 0 of {
                            true -> c2;
                            false -> concat(c2, concat(", ", sir_term_to_text_at(nodes, term.right_expr)))
                        };
                        concat(c3, ")")
                    };
                    5 -> {
                        arg_t: string <- sir_term_to_text_at(nodes, term.inner);
                        c1: string <- concat("tail_call(", term.name);
                        c2: string <- concat(c1, concat(", ", arg_t));
                        c3: string <- case term.right_expr < 0 of {
                            true -> c2;
                            false -> concat(c2, concat(", ", sir_term_to_text_at(nodes, term.right_expr)))
                        };
                        concat(c3, ")")
                    };
                    6 -> {
                        left_t: string <- sir_term_to_text_at(nodes, term.inner);
                        right_t: string <- sir_term_to_text_at(nodes, term.right_expr);
                        p1: string <- concat("prim(", term.name);
                        p2: string <- concat(p1, concat(", ", left_t));
                        p3: string <- concat(p2, concat(", ", right_t));
                        concat(p3, ")")
                    };
                    3 -> {
                        sct: string <- sir_term_to_text_at(nodes, term.inner);
                        br: string <- sir_term_to_text_at(nodes, term.right_expr);
                        p1: string <- concat("case(", term.type_name);
                        p2: string <- concat(p1, concat(", ", term.value));
                        p3: string <- concat(p2, concat(", ", sct));
                        concat(p3, concat(", ", concat(br, ")")))
                    };
                    7 -> {
                        b: string <- sir_term_to_text_at(nodes, term.inner);
                        r: string <- sir_term_to_text_at(nodes, term.right_expr);
                        concat(concat("case_seq(", b), concat(", ", concat(r, ")")))
                    };
                    8 -> {
                        g: string <- sir_term_to_text_at(nodes, term.inner);
                        bd: string <- sir_term_to_text_at(nodes, term.right_expr);
                        p1: string <- concat("branch(", term.value);
                        p2: string <- concat(p1, concat(", ", term.type_name));
                        p3: string <- concat(p2, concat(", ", term.name));
                        p4: string <- concat(p3, concat(", guard=", g));
                        concat(p4, concat(", ", concat(bd, ")")))
                    };
                    _: int64 -> concat("term(kind=", "?)")
                }
            }
        }
    }
}

fn sir_term_to_text(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    sir_term_to_text_at(term.nodes, term.root)
}

fn sir_function_to_text(fn_val: { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }) -> string {
    body_str: string <- sir_term_to_text(fn_val.body);
    concat(concat(concat(concat(concat(concat("fn ", fn_val.name), " -> "), concat(fn_val.return_type, " ")), concat(fn_val.effects, " ")), "body: "), body_str)
}

fn sir_used_modules_to_text(uses: List[string, mem(normal)], acc: string) -> string {
    case uses.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_used_modules_to_text(uses.tail, acc);
            case length_bytes(rest) > 0 of {
                true -> concat(concat(uses.head, ", "), rest);
                false -> uses.head
            }
        }
    }
}

fn sir_exports_to_text(exps: List[{ fn_name: string, arity: string }, mem(normal)], acc: string) -> string {
    case exps.is_nil of {
        true -> acc;
        false -> {
            one: string <- concat(concat(exps.head.fn_name, "/"), exps.head.arity);
            rest: string <- sir_exports_to_text(exps.tail, acc);
            case length_bytes(rest) > 0 of {
                true -> concat(concat(one, ", "), rest);
                false -> one
            }
        }
    }
}

fn sir_trait_exports_to_text(names: List[string, mem(normal)], acc: string) -> string {
    case names.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_trait_exports_to_text(names.tail, acc);
            line: string <- concat("  export_trait ", concat(names.head, "\n"));
            case length_bytes(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_marker_impls_to_text(types: List[string, mem(normal)], acc: string) -> string {
    case types.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_marker_impls_to_text(types.tail, acc);
            line: string <- concat("  marker_impl ", concat(types.head, "\n"));
            case length_bytes(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_supervisor_impls_to_text(types: List[string, mem(normal)], acc: string) -> string {
    case types.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_supervisor_impls_to_text(types.tail, acc);
            line: string <- concat("  impl_supervisor ", concat(types.head, "\n"));
            case length_bytes(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_supervisor_phase_e_rows_to_text(rows: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], acc: string) -> string {
    case rows.is_nil of {
        true -> acc;
        false -> {
            r: { actor_type: string, init_return_sir: string, init_return_type_name: string } <- rows.head;
            p1: string <- concat("  supervisor_phase_e ", r.actor_type);
            p2: string <- concat(p1, " init_returns ");
            p3: string <- concat(p2, concat(r.init_return_sir, "\n"));
            rest: string <- sir_supervisor_phase_e_rows_to_text(rows.tail, acc);
            case length_bytes(rest) > 0 of {
                true -> concat(p3, rest);
                false -> p3
            }
        }
    }
}

fn sir_failure_reporter_impls_to_text(types: List[string, mem(normal)], acc: string) -> string {
    case types.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_failure_reporter_impls_to_text(types.tail, acc);
            line: string <- concat("  impl_failure_reporter ", concat(types.head, "\n"));
            case length_bytes(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_wrapper_meta_paths_to_text(paths: List[string, mem(normal)], acc: string) -> string {
    case paths.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_wrapper_meta_paths_to_text(paths.tail, acc);
            line: string <- concat("  wrapper_meta ", concat(paths.head, "\n"));
            case length_bytes(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_foreign_bindings_to_text(bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], acc: string) -> string {
    case bindings.is_nil of {
        true -> acc;
        false -> {
            b: { local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string } <- bindings.head;
            p1: string <- concat("  foreign_binding ", b.local_name);
            p2: string <- concat(p1, " ");
            p3: string <- concat(p2, b.c_symbol);
            p4: string <- concat(p3, " ");
            p5: string <- concat(p4, b.param_names);
            p6: string <- concat(p5, " ");
            p7: string <- concat(p6, b.param_types);
            p8: string <- concat(p7, " -> ");
            p9: string <- concat(p8, b.return_type);
            p10: string <- case length_bytes(b.meta_path) > 0 of {
                true -> concat(p9, concat(" meta=", b.meta_path));
                false -> p9
            };
            one: string <- concat(p10, "\n");
            rest: string <- sir_foreign_bindings_to_text(bindings.tail, acc);
            case length_bytes(rest) > 0 of {
                true -> concat(one, rest);
                false -> one
            }
        }
    }
}

fn sir_required_sigs_to_text(sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], acc: string) -> string {
    case sigs.is_nil of {
        true -> acc;
        false -> {
            s: { name: string, param_names: string, param_types: string, return_type: string, effects: string } <- sigs.head;
            p1: string <- concat("  required_fn ", s.name);
            p2: string <- concat(p1, " ");
            p3: string <- concat(p2, s.param_names);
            p4: string <- concat(p3, " ");
            p5: string <- concat(p4, s.param_types);
            p6: string <- concat(p5, " -> ");
            p7: string <- concat(p6, s.return_type);
            p8: string <- concat(p7, " ");
            one2: string <- concat(p8, concat(s.effects, "\n"));
            rest: string <- sir_required_sigs_to_text(sigs.tail, acc);
            case length_bytes(rest) > 0 of {
                true -> concat(one2, rest);
                false -> one2
            }
        }
    }
}

fn sir_module_to_text_acc(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], acc: string) -> string {
    case fns.is_nil of {
        true -> acc;
        false -> {
            fn_str: string <- sir_function_to_text(fns.head);
            rest: string <- sir_module_to_text_acc(fns.tail, acc);
            case length_bytes(rest) > 0 of {
                true -> concat(concat(fn_str, "\n"), rest);
                false -> fn_str
            }
        }
    }
}

fn sir_module_to_text(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> string {
    header: string <- concat(concat("SIRModule ", sir_module.module_name), "\n");
    uses_line: string <- case sir_module.used_modules.is_nil of {
        true -> "";
        false -> concat(concat(" use ", sir_used_modules_to_text(sir_module.used_modules, "")), "\n")
    };
    exports_line: string <- case sir_module.exports.is_nil of {
        true -> "";
        false -> concat(concat("  export ", sir_exports_to_text(sir_module.exports, "")), "\n")
    };
    trait_exports_line: string <- case sir_module.export_trait_names.is_nil of {
        true -> "";
        false -> sir_trait_exports_to_text(sir_module.export_trait_names, "")
    };
    marker_line: string <- case sir_module.marker_impl_types.is_nil of {
        true -> "";
        false -> sir_marker_impls_to_text(sir_module.marker_impl_types, "")
    };
    sup_line: string <- case sir_module.supervisor_impl_types.is_nil of {
        true -> "";
        false -> sir_supervisor_impls_to_text(sir_module.supervisor_impl_types, "")
    };
    phe_line: string <- case sir_module.supervisor_phase_e.is_nil of {
        true -> "";
        false -> sir_supervisor_phase_e_rows_to_text(sir_module.supervisor_phase_e, "")
    };
    fr_line: string <- case sir_module.failure_reporter_impl_types.is_nil of {
        true -> "";
        false -> sir_failure_reporter_impls_to_text(sir_module.failure_reporter_impl_types, "")
    };
    req_line: string <- case sir_module.required_method_sigs.is_nil of {
        true -> "";
        false -> sir_required_sigs_to_text(sir_module.required_method_sigs, "")
    };
    rt_line: string <- case sir_module.runtime_dependencies.is_nil of {
        true -> "";
        false -> concat(concat("  runtime ", sir_used_modules_to_text(sir_module.runtime_dependencies, "")), "\n")
    };
    dangerous_line: string <- case sir_module.is_dangerous_module of {
        true -> "  dangerous_module true\n";
        false -> ""
    };
    wm_line: string <- case sir_module.wrapper_meta_paths.is_nil of {
        true -> "";
        false -> sir_wrapper_meta_paths_to_text(sir_module.wrapper_meta_paths, "")
    };
    fb_line: string <- case sir_module.foreign_bindings.is_nil of {
        true -> "";
        false -> sir_foreign_bindings_to_text(sir_module.foreign_bindings, "")
    };
    ll_line: string <- case sir_module.link_libraries.is_nil of {
        true -> "";
        false -> concat(concat("  link_library ", sir_used_modules_to_text(sir_module.link_libraries, "")), "\n")
    };
    funcs: string <- sir_module_to_text_acc(sir_module.functions, "");
    part1: string <- concat(header, uses_line);
    part2: string <- concat(part1, exports_line);
    part3: string <- concat(part2, trait_exports_line);
    part4: string <- concat(part3, marker_line);
    part4b: string <- concat(part4, sup_line);
    part4b2: string <- concat(part4b, phe_line);
    part4c: string <- concat(part4b2, fr_line);
    part5: string <- concat(part4c, req_line);
    part6: string <- concat(part5, rt_line);
    part7: string <- concat(part6, dangerous_line);
    part8: string <- concat(part7, wm_line);
    part9: string <- concat(part8, fb_line);
    part10: string <- concat(part9, ll_line);
    concat(part10, funcs)
}
