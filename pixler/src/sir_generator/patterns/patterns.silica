// Case pattern text helpers for sir_generator (language spec §3.3: case_expression, case_branch).
// Parser stores pattern source in { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } (kind 18).value; we classify literals vs bind _: T vs n: T here.

use string_parse;

export trim_pat/1;
export find_colon_from/2;
export is_int_literal_pat/1;

fn trim_leading_ws(s: string) -> string {
    case length_bytes(s) == 0 of {
        true -> "";
        false -> case substring(s, 0, 1) == " " of {
            true -> trim_leading_ws(substring(s, 1, length_bytes(s)));
            false -> s
        }
    }
}

fn trim_trailing_ws(s: string) -> string {
    case length_bytes(s) == 0 of {
        true -> "";
        false -> case substring(s, length_bytes(s) - 1, length_bytes(s)) == " " of {
            true -> trim_trailing_ws(substring(s, 0, length_bytes(s) - 1));
            false -> s
        }
    }
}

fn trim_pat(s: string) -> string {
    trim_trailing_ws(trim_leading_ws(s))
}

fn find_colon_from(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == ":" of {
            true -> i;
            false -> find_colon_from(s, i + 1)
        }
    }
}

fn is_int_literal_pat(t: string) -> boolean {
    string_parse@is_integer_literal_text(t)
}
