// Effect serialization: effect-name list -> SIR text format string
// Converts parser AST effect lists to SIR effect set notation: "[]", "[device_io]", "[mem(normal), device_io]"
// Implements sir_design_spec §4.1 effect set syntax

use parser_ast;

export serialize_effects/1;

// Serialize effects to SIR text format: "[e1, e2, ...]"
fn serialize_effects(effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case effects.is_nil of {
        true -> "[]";
        false -> concat("[", concat(serialize_effect_items(effects), "]"))
    }
}

// Serialize effect items as comma-separated list (no outer brackets)
fn serialize_effect_items(effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case effects.is_nil of {
        true -> "";
        false -> {
            head_str: string <- serialize_one_effect(effects.head);
            case effects.tail.is_nil of {
                true -> head_str;
                false -> concat(head_str, concat(", ", serialize_effect_items(effects.tail)))
            }
        }
    }
}

// Serialize a single effect: "device_io" or "mem(normal)"
// Use parameter == "" not length_bytes(parameter) == 0: bootstrap compiler length_bytes("") bug
fn serialize_one_effect(eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> string {
    normalized: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- normalize_for_sir(eff);
    case normalized.parameter == "" of {
        true -> normalized.name;
        false -> concat(normalized.name, concat("(", concat(normalized.parameter, ")")))
    }
}

// Normalize legacy names before serialization (DeviceIO -> device_io)
fn normalize_for_sir(eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    case eff.name of {
        "DeviceIO" -> { name: "device_io", parameter: "", location: eff.location };
        _: string -> eff
    }
}
