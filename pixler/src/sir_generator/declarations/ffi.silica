// FFI declarations (silica_ffi_wrapper_specification.md): parser_ast.{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } tags 8–9.
// Tag 8 = wrapper_meta (name = sidecar path), tag 9 = foreign c_wrapper binding.

use parser_ast;
use sir_ast;
use functions;
use type_checker_traits;

export collect_wrapper_meta_paths/1;
export collect_referenced_sidecar_paths/1;
export collect_foreign_bindings/1;
export module_name_is_dangerous/1;

fn dangerous_prefix() -> string {
    "dangerous_"
}

fn module_name_is_dangerous(mod_name: string) -> boolean {
    pref: string <- dangerous_prefix();
    case length_bytes(mod_name) >= length_bytes(pref) of {
        false -> false;
        true -> substring(mod_name, 0, length_bytes(pref)) == pref
    }
}

fn collect_wrapper_meta_paths_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 8 of {
            true -> sir_ast@cons_sir_string(decls.head.name, collect_wrapper_meta_paths_loop(decls.tail));
            false -> collect_wrapper_meta_paths_loop(decls.tail)
        }
    }
}

fn collect_wrapper_meta_paths(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    collect_wrapper_meta_paths_loop(decls)
}

fn append_sir_strings(a: List[string, mem(normal)], b: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> sir_ast@cons_sir_string(a.head, append_sir_strings(a.tail, b))
    }
}

fn collect_per_binding_meta_paths_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 9 of {
            true -> case length_bytes(parser_ast@expr_root_node(decls.head.body).name) > 0 of {
                true -> sir_ast@cons_sir_string(parser_ast@expr_root_node(decls.head.body).name, collect_per_binding_meta_paths_loop(decls.tail));
                false -> collect_per_binding_meta_paths_loop(decls.tail)
            };
            false -> collect_per_binding_meta_paths_loop(decls.tail)
        }
    }
}

fn collect_referenced_sidecar_paths(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    wm: List[string, mem(normal)] <- collect_wrapper_meta_paths(decls);
    bm: List[string, mem(normal)] <- collect_per_binding_meta_paths_loop(decls);
    append_sir_strings(wm, bm)
}

fn foreign_binding_from_decl(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> { local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string } {
    body_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(decl.body);
    raw_sym: string <- body_node.value;
    c_sym: string <- case length_bytes(raw_sym) >= 2 and substring(raw_sym, 0, 1) == "\"" and substring(raw_sym, length_bytes(raw_sym) - 1, length_bytes(raw_sym)) == "\"" of {
        true -> substring(raw_sym, 1, length_bytes(raw_sym) - 1);
        false -> raw_sym
    };
    {
        local_name: decl.name,
        c_symbol: c_sym,
        meta_path: body_node.name,
        return_type: type_checker_traits@trim_type_text(decl.return_type_name),
        param_names: functions@param_names_from_list(decl.parameters),
        param_types: functions@param_types_from_list(decl.parameters)
    }
}

fn collect_foreign_bindings_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_foreign_bindings();
        false -> case decls.head.tag == 9 of {
            true -> sir_ast@cons_sir_foreign_binding(foreign_binding_from_decl(decls.head), collect_foreign_bindings_loop(decls.tail));
            false -> collect_foreign_bindings_loop(decls.tail)
        }
    }
}

fn collect_foreign_bindings(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)] {
    collect_foreign_bindings_loop(decls)
}
