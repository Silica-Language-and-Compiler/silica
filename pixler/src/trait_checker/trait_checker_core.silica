// Trait checking phase: after type checking, before effect checking.
// Validates trait declarations, impls, and required/provided method consistency (spec).
//
// Supervisors Phase A (supervisors_implementation_development_plan.md): runtime will record
// supervisor refs and `agent_type` at `spawn_linked` time; later phases call `Supervisor::init`
// (silica-specification §15.4.13). Enforce the canonical required-method shape for
// `export trait Supervisor` so the stdlib contract stays aligned with that entry point.
// Required `init` must surface in the AST as exactly one tag-7 method with one parameter of
// type `ActorState` (parameter name unrestricted: `self` in source currently breaks required-fn
// parsing, so use e.g. `st: ActorState` until the parser accepts `self` in trait signatures).

use parser_ast;
use diagnostics_core;
use type_checker_core;
use type_checker_traits;
use type_checker_trait_placeholders;

export trait_checker_check_program/1;

fn program_exports_trait_named(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], trait_id: string) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 5 of {
            true -> case decls.head.name == trait_id of {
                true -> true;
                false -> program_exports_trait_named(decls.tail, trait_id)
            };
            false -> program_exports_trait_named(decls.tail, trait_id)
        }
    }
}

fn count_tag7_declarations(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: int64) -> int64 {
    case decls.is_nil of {
        true -> acc;
        false -> case decls.head.tag == 7 of {
            true -> count_tag7_declarations(decls.tail, acc + 1);
            false -> count_tag7_declarations(decls.tail, acc)
        }
    }
}

fn find_first_tag7_declaration(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (boolean, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 7 of {
            true -> (true, decls.head);
            false -> find_first_tag7_declaration(decls.tail)
        }
    }
}

// Phase D: init must return `(supervisor_flags, static_children)` — a tuple with at least two components (spec §15.4.13.1).
fn supervisor_init_return_tuple_has_flags_and_children(ret: string) -> boolean {
    t: string <- type_checker_traits@trim_type_text(ret);
    case length_bytes(t) < 2 of {
        true -> false;
        false -> case substring(t, 0, 1) == "(" and substring(t, length_bytes(t) - 1, length_bytes(t)) == ")" of {
            false -> false;
            true -> {
                inner: string <- type_checker_traits@trim_type_text(substring(t, 1, length_bytes(t) - 1));
                comma_at_top: int64 <- trait_top_level_comma_in_type(inner, 0, 0);
                comma_at_top >= 0
            }
        }
    }
}

fn trait_top_level_comma_in_type(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case depth == 0 and substring(s, i, i + 1) == "," of {
            true -> i;
            false -> {
                c: string <- substring(s, i, i + 1);
                d2: int64 <- case c == "(" of {
                    true -> depth + 1;
                    false -> case c == ")" of {
                        true -> depth - 1;
                        false -> case c == "{" of {
                            true -> depth + 1;
                            false -> case c == "}" of {
                                true -> depth - 1;
                                false -> case c == "[" of {
                                    true -> depth + 1;
                                    false -> case c == "]" of {
                                        true -> depth - 1;
                                        false -> depth
                                    }
                                }
                            }
                        }
                    }
                };
                trait_top_level_comma_in_type(s, i + 1, d2)
            }
        }
    }
}

fn check_supervisor_trait_required_shape(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> int64 {
    sequence
        decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- program.declarations;
        result: int64 <- case program_exports_trait_named(decls, "Supervisor") of {
            false -> 0;
            true -> {
                n_req: int64 <- count_tag7_declarations(decls, 0);
                case n_req == 1 of {
                    false -> {
                        _: int8 <- diagnostics_core@print_compiler_error("TraitError", "E2090", program.location, "export trait Supervisor must declare exactly one required method init (supervisors plan Phase A; spec §15.4.13)", "sect15.4.13");
                        1
                    };
                    true -> {
                        (found: boolean, req: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_first_tag7_declaration(decls);
                        case found of {
                            false -> {
                                _: int8 <- diagnostics_core@print_compiler_error("TraitError", "E2090", program.location, "Supervisor trait required block must declare init (spec §15.4.13)", "sect15.4.13");
                                1
                            };
                            true -> case req.name == "init" of {
                                false -> {
                                    _: int8 <- diagnostics_core@print_compiler_error("TraitError", "E2090", program.location, "Supervisor trait required block must declare init (spec §15.4.13)", "sect15.4.13");
                                    1
                                };
                                true -> {
                                    params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- req.parameters;
                                    case params.is_nil of {
                                        true -> {
                                            _: int8 <- diagnostics_core@print_compiler_error("TraitError", "E2090", req.location, "Supervisor init must take exactly one parameter of type ActorState (spec §15.4.13)", "sect15.4.13");
                                            1
                                        };
                                        false -> case params.tail.is_nil of {
                                            false -> {
                                                _: int8 <- diagnostics_core@print_compiler_error("TraitError", "E2090", req.location, "Supervisor init must take exactly one parameter of type ActorState (spec §15.4.13)", "sect15.4.13");
                                                1
                                            };
                                            true -> {
                                                p0: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- params.head;
                                                t0: string <- type_checker_traits@trim_type_text(p0.type_name);
                                                case t0 == "ActorState" of {
                                                    false -> {
                                                        _: int8 <- diagnostics_core@print_compiler_error("TraitError", "E2090", p0.location, "Supervisor init first parameter must have type ActorState (spec §15.4.13)", "sect15.4.13");
                                                        1
                                                    };
                                                    true -> case length_bytes(type_checker_traits@trim_type_text(req.return_type_name)) > 0 of {
                                                        false -> {
                                                            _: int8 <- diagnostics_core@print_compiler_error("TraitError", "E2090", req.return_type_location, "Supervisor init must declare a non-empty return type (flags and child_spec tuple; spec §15.4.13)", "sect15.4.13");
                                                            1
                                                        };
                                                        true -> case supervisor_init_return_tuple_has_flags_and_children(req.return_type_name) of {
                                                            false -> {
                                                                _: int8 <- diagnostics_core@print_compiler_error("TraitError", "E2090", req.return_type_location, "Supervisor init must return a tuple (supervisor_flags, List[child_spec, …]) per spec §15.4.13 and supervisors plan Phase D", "sect15.4.13");
                                                                1
                                                            };
                                                            true -> 0
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

fn trait_checker_check_program(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> int64 {
    sequence
        sup_st: int64 <- check_supervisor_trait_required_shape(program);
        result: int64 <- case sup_st != 0 of {
            true -> sup_st;
            false -> {
                ph_result: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_trait_placeholders@check_trait_impl_required_consistency(program);
                case ph_result.is_ok of {
                    false -> {
                        err_code: string <- case ph_result.error_code == "" of {
                            true -> "E2092";
                            false -> ph_result.error_code
                        };
                        _: int8 <- diagnostics_core@print_compiler_error("TraitError", err_code, ph_result.error_location, ph_result.error_message, "sect3.4.8");
                        1
                    };
                    true -> 0
                }
            }
        }
    produces
        pure result
    end
}
