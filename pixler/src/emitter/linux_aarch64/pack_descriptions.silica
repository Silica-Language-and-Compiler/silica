// Board-pack device descriptions (silica_device_actor_specification.md §4.9 rule 5, §4.9.1): for each
// device tag the board pack describes, the name of the one module that is its description; "" for a
// tag the pack does not describe. Every emit target carries its own copy at
// emitter/<TARGET>/pack_descriptions.silica (see emitter/ESP32-S3_raw/pack_descriptions.silica). This
// target is OS-hosted and has no board pack, so no tag is a board-pack tag; the device prims are
// rejected for this target before emit (E2220).

export description_module_for_tag/1;

fn description_module_for_tag(tag: string) -> string {
    case tag of {
        _: string -> ""
    }
}
