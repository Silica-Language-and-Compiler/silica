// Ordering identity prim emission (Layer 1 §7.2).


use xt_isa;

export is_ordering_identity_prim/1;
export emit_prim_op/2;
export module_uses_ordering_identity/1;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn is_ordering_identity_prim(name: string) -> boolean {
    name == "ordering_identity_fresh_env" or name == "ordering_identity_make" or name == "ordering_identity_same" or name == "ordering_identity_bundle_make"
}

fn emit_ordering_identity_fresh_env(dest: string) -> string {
    concat(xt_isa@xt_call("_silica_rt_ordering_env_fresh"), xt_isa@xt_mov(dest, "X0"))
}

// Two-argument runtime call: operands in X1, X2 -> arguments X0, X1; result X0 -> dest.
fn emit_ordering_rt2(rt_name: string, dest: string) -> string {
    concat(concat(xt_isa@xt_mov("X0", "X1"), xt_isa@xt_mov("X1", "X2")), concat(xt_isa@xt_call(rt_name), xt_isa@xt_mov(dest, "X0")))
}

fn emit_ordering_identity_make(dest: string) -> string {
    emit_ordering_rt2("_silica_rt_ordering_identity_make", dest)
}

fn emit_ordering_identity_same(dest: string) -> string {
    emit_ordering_rt2("_silica_rt_ordering_identity_same", dest)
}

fn emit_ordering_identity_bundle_make(dest: string) -> string {
    emit_ordering_rt2("_silica_rt_ordering_bundle_make", dest)
}

fn term_has_ordering_identity_prim(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> case sir_term_root_node(term).kind of {
            6 -> case is_ordering_identity_prim(sir_term_root_node(term).name) of {
                true -> true;
                false -> case term_has_ordering_identity_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                    true -> true;
                    false -> term_has_ordering_identity_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
                }
            };
            2 -> case term_has_ordering_identity_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_ordering_identity_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            _: int64 -> false
        }
    }
}

fn ordering_identity_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_ordering_identity_prim(fns.head.body) of {
            true -> true;
            false -> ordering_identity_in_functions(fns.tail)
        }
    }
}

fn module_uses_ordering_identity(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    ordering_identity_in_functions(sir_module.functions)
}

fn emit_prim_op(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    case sir_term_root_node(term).name of {
        "ordering_identity_fresh_env" -> emit_ordering_identity_fresh_env(dest);
        "ordering_identity_make" -> emit_ordering_identity_make(dest);
        "ordering_identity_same" -> emit_ordering_identity_same(dest);
        "ordering_identity_bundle_make" -> emit_ordering_identity_bundle_make(dest);
        _: string -> concat(".error \"unsupported ordering identity prim: ", concat(sir_term_root_node(term).name, "\"\n"))
    }
}
