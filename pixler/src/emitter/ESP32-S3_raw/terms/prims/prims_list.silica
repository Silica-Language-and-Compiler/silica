// List prim emission: list_nil, list_cons, list_length, list_head, list_remove_head
// list_implementation_design.md §4–§9: chunk-based spine; immutable handles, mutable chunks.
//
// List handle (24 bytes, heap-allocated; pointer = 0 for nil):
//   [0..8)   = length  (int64, total list length)
//   [8..16)  = chunk_ptr (pointer to first data chunk)
//   [16..24) = cursor   (byte offset of first element within chunk data area)
//
// Data chunk (CDATA + 8 bytes, heap-allocated):
//   [0..CDATA)          = element slots (filled back-to-front per §9.5)
//   [CDATA..CDATA+8)    = next chunk pointer (0 = end of spine)
//
// CDATA = max(16, elem_slot_bytes).  Capacity = CDATA / elem_slot_bytes.
// Empty list: register value 0.  Chunks are mutable (new slots filled in place);
// elements once written are immutable.  Handles are immutable once created.

use reg_conventions;
use var;
use prims_tuple;
use prims_record;
use atom_table;
use xt_isa;
use xt_mem;

export is_list_prim/1;
export emit_prim_op/2;
export module_uses_list_prims/1;
export emit_list_helpers/0;
export emit_list_at_helper/0;
export module_uses_list_at/1;
export emit_region_alloc_stub/0;
export list_element_payload_bytes/1;
export chunk_elem_slot_bytes/1;
export chunk_data_bytes/1;
export chunk_elem_slot_bytes_from_list_t/1;
export chunk_data_bytes_from_list_t/1;
export list_elem_is_inline_aggregate/1;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn is_list_prim(name: string) -> boolean {
    name == "list_nil" or name == "list_cons" or name == "list_length" or name == "list_head" or name == "list_remove_head" or name == "list_at"
}

fn term_has_list_prim(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> case sir_term_root_node(term).kind of {
            6 -> case is_list_prim(sir_term_root_node(term).name) of {
                true -> true;
                false -> case term_has_list_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                    true -> true;
                    false -> term_has_list_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
                }
            };
            2 -> case term_has_list_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            3 -> case term_has_list_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            4 -> case term_has_list_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            5 -> case term_has_list_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            7 -> case term_has_list_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            8 -> case term_has_list_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            _: int64 -> false
        }
    }
}

// L_list_at_helper is emitted only for modules that actually use list_at, so adding the
// builtin leaves every other list-using module byte-identical. Cloned verbatim from
// term_has_list_prim / list_prim_in_functions so the record element types match exactly.
fn term_has_list_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> case sir_term_root_node(term).kind of {
            6 -> case sir_term_root_node(term).name == "list_at" of {
                true -> true;
                false -> case term_has_list_at(sir_term_at(term, sir_term_root_node(term).inner)) of {
                    true -> true;
                    false -> term_has_list_at(sir_term_at(term, sir_term_root_node(term).right_expr))
                }
            };
            2 -> case term_has_list_at(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_at(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            3 -> case term_has_list_at(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_at(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            4 -> case term_has_list_at(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_at(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            5 -> case term_has_list_at(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_at(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            7 -> case term_has_list_at(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_at(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            8 -> case term_has_list_at(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_at(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            _: int64 -> false
        }
    }
}


fn list_at_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_list_at(fns.head.body) of {
            true -> true;
            false -> list_at_in_functions(fns.tail)
        }
    }
}


fn list_prim_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_list_prim(fns.head.body) of {
            true -> true;
            false -> list_prim_in_functions(fns.tail)
        }
    }
}

fn term_has_list_cons_pattern(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> case sir_term_root_node(term).kind of {
            8 -> case sir_term_root_node(term).value == "list_cons" of {
                true -> true;
                false -> case term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).inner)) of {
                    true -> true;
                    false -> term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).right_expr))
                }
            };
            2 -> case term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            3 -> case term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            4 -> case term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            5 -> case term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            6 -> case term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            7 -> case term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_list_cons_pattern(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            _: int64 -> false
        }
    }
}

fn list_cons_pattern_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_list_cons_pattern(fns.head.body) of {
            true -> true;
            false -> list_cons_pattern_in_functions(fns.tail)
        }
    }
}

fn module_uses_list_prims(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    case list_prim_in_functions(sir_module.functions) of {
        true -> true;
        false -> list_cons_pattern_in_functions(sir_module.functions)
    }
}

fn module_uses_list_at(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    list_at_in_functions(sir_module.functions)
}

// Comma at depth 0; depth increases for [, (, {; decreases for ], ), }.
fn find_first_comma_depth0_pb(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> length_bytes(s);
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> find_first_comma_depth0_pb(s, i + 1, depth + 1);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> find_first_comma_depth0_pb(s, i + 1, depth - 1);
                    false -> case c == "," of {
                        true -> case depth == 0 of {
                            true -> i;
                            false -> find_first_comma_depth0_pb(s, i + 1, depth)
                        };
                        false -> find_first_comma_depth0_pb(s, i + 1, depth)
                    }
                }
            }
        }
    }
}

// Strips spaces so "List [ T , mem ]" becomes "List[T,mem]".
fn list_elem_type_from_list_t(list_t: string) -> string {
    t: string <- prims_record@strip_spaces_rt(list_t);
    case length_bytes(t) < 6 of {
        true -> "";
        false -> case substring(t, 0, 5) == "List[" of {
            false -> "";
            true -> case substring(t, length_bytes(t) - 1, length_bytes(t)) == "]" of {
                false -> "";
                true -> {
                    inner: string <- substring(t, 5, length_bytes(t) - 1);
                    inner_trim: string <- prims_record@strip_spaces_rt(inner);
                    comma: int64 <- find_first_comma_depth0_pb(inner_trim, 0, 0);
                    case comma >= length_bytes(inner_trim) of {
                        true -> inner_trim;
                        false -> prims_record@strip_spaces_rt(substring(inner_trim, 0, comma))
                    }
                }
            }
        }
    }
}

// Byte size of one element slot in a chunk.  Narrow scalars use their natural width
// so that multiple elements pack into the 128-bit data area.
fn element_type_is_child_spec_record(elem_t: string) -> boolean {
    length_bytes(prims_record@find_field_type_in_record(elem_t, "id")) > 0
        and length_bytes(prims_record@find_field_type_in_record(elem_t, "agent_type")) > 0
        and length_bytes(prims_record@find_field_type_in_record(elem_t, "initial_state")) > 0
        and length_bytes(prims_record@find_field_type_in_record(elem_t, "behavior")) > 0
        and length_bytes(prims_record@find_field_type_in_record(elem_t, "restart")) > 0
        and length_bytes(prims_record@find_field_type_in_record(elem_t, "shutdown")) > 0
        and length_bytes(prims_record@find_field_type_in_record(elem_t, "flavor")) > 0
}

fn chunk_elem_slot_bytes(elem_t: string) -> int64 {
    case reg_conventions@is_inline_struct_type(elem_t) of {
        true -> {
            // Boxed layout (prims_record header): a record element is one pointer word to the
            // region copy emit_list_cons makes, the same word a generic List[ItemType] cell holds.
            // The lists the actor runtime reads or builds itself are the exception and keep the
            // record spliced into the cell: child-spec lists (+8 for the hidden trampoline word in
            // the initial_state form) and the supervisor's which_children list of child-info
            // records (_silica_rt_supervisor_which_children writes 32-byte cells).
            visible_bytes: int64 <- prims_record@record_type_list_cons_payload_bytes(elem_t);
            case element_type_is_child_spec_record(elem_t) of {
                true -> visible_bytes + 8;
                false -> case element_type_is_runtime_inline_record(elem_t) of {
                    true -> visible_bytes;
                    false -> 8
                }
            }
        };
        false -> case reg_conventions@is_tuple_type(elem_t) of {
            true -> 8;
            false -> case elem_t of {
                "int8"  -> 1;
                "uint8" -> 1;
                "int16" -> 2;
                "uint16" -> 2;
                "int32" -> 4;
                "uint32" -> 4;
                "float32" -> 4;
                _: string -> 8
            }
        }
    }
}

// Total data area per chunk (128-bit minimum, or elem_slot_bytes if element is larger).
fn chunk_data_bytes(elem_t: string) -> int64 {
    es: int64 <- chunk_elem_slot_bytes(elem_t);
    case es > 16 of {
        true -> es;
        false -> 16
    }
}

fn list_elem_or_int64(list_t: string) -> string {
    em: string <- list_elem_type_from_list_t(list_t);
    case length_bytes(em) == 0 of {
        true -> "int64";
        false -> em
    }
}

fn chunk_elem_slot_bytes_from_list_t(list_t: string) -> int64 {
    chunk_elem_slot_bytes(list_elem_or_int64(list_t))
}

fn chunk_data_bytes_from_list_t(list_t: string) -> int64 {
    chunk_data_bytes(list_elem_or_int64(list_t))
}

// Legacy export: flat byte size of one list element.
fn list_element_payload_bytes(elem_t: string) -> int64 {
    chunk_elem_slot_bytes(elem_t)
}


// Only a record whose list the actor runtime reads or builds is spliced into its cell (child
// specs, supervisor child info); every other aggregate element is a pointer word, so `.head`, `list_at` and `[h | t]`
// load it like a scalar. See chunk_elem_slot_bytes.
fn list_elem_is_inline_aggregate(elem_t: string) -> boolean {
    reg_conventions@is_aggregate_struct_or_tuple_return_type(elem_t)
        and (element_type_is_child_spec_record(elem_t) or element_type_is_runtime_inline_record(elem_t))
}

// Element records whose list cells the actor runtime lays out itself (besides the initial_state
// child spec above): the `start:`-form child spec, and the supervisor child-info record
// { id, agent_type, child, restart } of which_children replies.
fn element_type_is_runtime_inline_record(elem_t: string) -> boolean {
    prims_record@record_type_is_start_child_spec(elem_t)
        or (prims_record@count_record_fields(elem_t) == 4
            and length_bytes(prims_record@find_field_type_in_record(elem_t, "id")) > 0
            and length_bytes(prims_record@find_field_type_in_record(elem_t, "agent_type")) > 0
            and length_bytes(prims_record@find_field_type_in_record(elem_t, "child")) > 0
            and length_bytes(prims_record@find_field_type_in_record(elem_t, "restart")) > 0)
}

// Bytes the region copy of one boxed element carries: the element's own flat size.
fn list_elem_box_bytes(elem_t: string) -> int64 {
    case reg_conventions@is_inline_struct_type(elem_t) of {
        true -> prims_record@record_type_value_flat_byte_size(elem_t);
        false -> case reg_conventions@is_tuple_type(elem_t) of {
            true -> prims_tuple@flat_alloc_size(prims_tuple@count_type_elements(elem_t));
            false -> 0
        }
    }
}

fn list_head_box_copy_words(i: int64, words: int64) -> string {
    case i >= words of {
        true -> "";
        false -> {
            off: string <- atom_table@int64_to_decimal_string(i * 8);
            one: string <- concat(xt_mem@xt_ldr("X3", concat("[X1, #", concat(off, "]"))), xt_mem@xt_str("X3", concat("[X0, #", concat(off, "]"))));
            concat(one, list_head_box_copy_words(i + 1, words))
        }
    }
}

// Box the aggregate head in X1 before the prepend: copy it to the region and leave the copy's
// pointer in X1, keeping X2 (the tail). The cell then stores that word. Copying (rather than
// storing the pointer we were handed) is what keeps a let-bound, frame-resident record safe in
// the list after the frame is gone, exactly as the old inline memcpy did.
fn emit_list_head_box(nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> {
            save: string <- xt_mem@xt_stp("X1", "X2", "[SP, #-16]!");
            alloc: string <- concat(xt_isa@xt_movi("X0", nbytes), xt_isa@xt_call("_silica_rt_region_alloc"));
            restore: string <- xt_mem@xt_ldp("X1", "X2", "[SP], #16");
            copy: string <- list_head_box_copy_words(0, nbytes / 8);
            concat(save, concat(alloc, concat(restore, concat(copy, xt_isa@xt_mov("X1", "X0")))))
        }
    }
}

fn emit_list_nil(dest: string) -> string {
    xt_isa@xt_mov(dest, "#0")
}

// X1 = head value (or ptr to aggregate), X2 = tail list handle (or 0).
// The slot size, chunk data size and aggregate flag are compile-time constants packed into X0
// (low word: slot | chunk << 16; high word: 1 for an aggregate element), so the runtime routine
// takes three pair arguments: silica_rt_list_prepend(X0 = packed, X1 = head, X2 = tail) -> X0.
fn emit_list_cons(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    et: string <- sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name;
    es: int64 <- chunk_elem_slot_bytes(et);
    cd: int64 <- chunk_data_bytes(et);
    is_agg: boolean <- reg_conventions@is_aggregate_struct_or_tuple_return_type(et);
    // Boxed layout: an aggregate head is copied to the region here and its pointer is stored as
    // a plain word; only a child-spec head is still memcpy'd into the cell (agg flag = 1).
    inline_agg: boolean <- list_elem_is_inline_aggregate(et);
    box_asm: string <- case is_agg and inline_agg == false of {
        true -> emit_list_head_box(list_elem_box_bytes(et));
        false -> ""
    };
    agg: int64 <- case inline_agg of { true -> 1; false -> 0 };
    packed: string <- xt_isa@xt_movi("X0", es + cd * 65536 + agg * 4294967296);
    bl: string <- xt_isa@xt_call("silica_rt_list_prepend");
    concat(box_asm, concat(concat(packed, bl), xt_isa@xt_mov(dest, "X0")))
}

// X9 = list handle pointer.  Dereference handle → chunk → cursor → element.
fn emit_list_head(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    load_chunk: string <- xt_mem@xt_ldr("X10", "[X9, #8]");
    load_cursor: string <- xt_mem@xt_ldr("X11", "[X9, #16]");
    addr: string <- xt_isa@xt_add("X10", "X10", "X11");
    case list_elem_is_inline_aggregate(sir_term_root_node(term).type_name) of {
        true -> concat(load_chunk, concat(load_cursor, concat(addr, xt_isa@xt_mov(dest, "X10"))));
        false -> {
            ed: string <- case reg_conventions@is_narrow_type(sir_term_root_node(term).type_name) of {
                true -> case length_bytes(dest) > 0 of {
                    true -> case substring(dest, 0, 1) == "X" of {
                        true -> concat("W", substring(dest, 1, length_bytes(dest)));
                        false -> dest
                    };
                    false -> dest
                };
                false -> dest
            };
            ld: string <- case reg_conventions@is_narrow_type(sir_term_root_node(term).type_name) of {
                true -> case sir_term_root_node(term).type_name of {
                    "int8" -> xt_mem@xt_ldrsb(ed, "[X10]");
                    "uint8" -> xt_mem@xt_ldrb(ed, "[X10]");
                    "int16" -> xt_mem@xt_ldrsh(ed, "[X10]");
                    "uint16" -> xt_mem@xt_ldrh(ed, "[X10]");
                    _: string -> xt_mem@xt_ldr(ed, "[X10]")
                };
                false -> xt_mem@xt_ldr(dest, "[X10]")
            };
            concat(concat(load_chunk, load_cursor), concat(addr, ld))
        }
    }
}

// X9 = list handle, X10 = index.  L_list_at_helper walks chunks in registers and returns the
// element address in X0 -- no handle is allocated per step, unlike a .tail walk. Out of range
// aborts, like a buf bounds failure. The element is then produced exactly as list_head does.
fn emit_list_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    em: string <- list_elem_type_from_list_t(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name);
    et: string <- case length_bytes(em) == 0 of { true -> "int64"; false -> em };
    es: int64 <- chunk_elem_slot_bytes(et);
    cd: int64 <- chunk_data_bytes(et);
    // silica_rt_list_at(X0 = handle, X1 = index, X2 = slot | chunk << 16) -> X0 = element address
    setup: string <- concat(xt_isa@xt_mov("X0", "X9"), concat(xt_isa@xt_mov("X1", "X10"), xt_isa@xt_movi("X2", es + cd * 65536)));
    bl: string <- concat(xt_isa@xt_call("silica_rt_list_at"), xt_isa@xt_mov("X10", "X0"));
    case list_elem_is_inline_aggregate(sir_term_root_node(term).type_name) of {
        true -> concat(setup, concat(bl, xt_isa@xt_mov(dest, "X10")));
        false -> {
            ed: string <- case reg_conventions@is_narrow_type(sir_term_root_node(term).type_name) of {
                true -> case length_bytes(dest) > 0 of {
                    true -> case substring(dest, 0, 1) == "X" of {
                        true -> concat("W", substring(dest, 1, length_bytes(dest)));
                        false -> dest
                    };
                    false -> dest
                };
                false -> dest
            };
            ld: string <- case reg_conventions@is_narrow_type(sir_term_root_node(term).type_name) of {
                true -> case sir_term_root_node(term).type_name of {
                    "int8" -> xt_mem@xt_ldrsb(ed, "[X10]");
                    "uint8" -> xt_mem@xt_ldrb(ed, "[X10]");
                    "int16" -> xt_mem@xt_ldrsh(ed, "[X10]");
                    "uint16" -> xt_mem@xt_ldrh(ed, "[X10]");
                    _: string -> xt_mem@xt_ldr(ed, "[X10]")
                };
                false -> xt_mem@xt_ldr(dest, "[X10]")
            };
            concat(concat(setup, bl), ld)
        }
    }
}

// X9 = list handle.  Produce tail handle via helper.
fn emit_list_remove_head(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    em: string <- list_elem_type_from_list_t(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name);
    et: string <- case length_bytes(em) == 0 of { true -> "int64"; false -> em };
    es: int64 <- chunk_elem_slot_bytes(et);
    cd: int64 <- chunk_data_bytes(et);
    es_s: string <- atom_table@int64_to_decimal_string(es);
    cd_s: string <- atom_table@int64_to_decimal_string(cd);
    setup: string <- concat(xt_isa@xt_mov("X0", "X9"), concat("\n", concat(xt_isa@xt_mov("X1", concat("#", es_s)), xt_isa@xt_mov("X2", concat("#", cd_s)))));
    bl: string <- xt_isa@xt_call("silica_rt_list_tail");
    concat(concat(setup, bl), xt_isa@xt_mov(dest, "X0"))
}

// X9 = list handle.  Length is memoized at handle[0].  O(1).
// Call helper: X0=handle → X0=length.  Helper returns 0 for nil handle.
fn emit_list_length(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    mov_arg: string <- xt_isa@xt_mov("X0", "X9");
    bl: string <- xt_isa@xt_call("silica_rt_list_length");
    concat(concat(mov_arg, bl), xt_isa@xt_mov(dest, "X0"))
}

// ESP32-S3: the list routines are board runtime code (board/runtime/rt_list.S, silica_rt_list_*),
// so no helper body is emitted into the module. The functions stay so emitter_core's calls resolve.
fn emit_list_length_helper() -> string {
    ""
}

fn emit_prim_op(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    case sir_term_root_node(term).name of {
        "list_nil" -> emit_list_nil(dest);
        "list_cons" -> emit_list_cons(term, dest);
        "list_length" -> emit_list_length(term, dest);
        "list_at" -> emit_list_at(term, dest);
        "list_head" -> emit_list_head(term, dest);
        "list_remove_head" -> emit_list_remove_head(term, dest);
        _: string -> concat(".error \"unsupported list prim: ", concat(sir_term_root_node(term).name, "\"\n"))
    }
}

fn emit_list_prepend_helper() -> string {
    ""
}

fn emit_list_tail_helper() -> string {
    ""
}

fn emit_list_at_helper() -> string {
    ""
}

fn emit_list_helpers() -> string {
    ""
}

// silica_rt_region_alloc is part of the board runtime (rt_heap.S); nothing to append.
fn emit_region_alloc_stub() -> string {
    ""
}
