// SIRTerm arena accessors and synthetic term constructors for the term emitter.

use sir_ast;

export sir_term_root_node/1;
export sir_term_at/2;
export sir_tail_case_label/1;
export let_duplicates_same_case/2;
export let_unit_wrap_duplicates/1;
export let_rhs_value_type/1;
export make_leaf_sir_const/2;
export make_call_sir_term_no_arg/3;
export make_call_sir_term/4;

fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                // Direct return of the list element, as emitter_core's node_at has done since the
                // 2026-09-09 revert: the bind-then-rebuild copy cost 0.15 GB during emission alone
                // and the seed no longer miscompiles the direct form (builds 3-11, suites green).
                false -> list_nth(nodes, n - 1 - idx)
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

// Walk let tails (SIR kind 2) to the first non-let root.
fn sir_non_let_root(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term.root < 0 of {
        true -> -1;
        false -> case sir_term_root_node(term).kind == 2 of {
            true -> sir_non_let_root(sir_term_at(term, sir_term_root_node(term).right_expr));
            false -> term.root
        }
    }
}

// The value type of a let's right-hand side. A nested let chain (`v <- sequence ... end`, which
// lowers to `let v = (let %_ = stmt in ... in value)`) carries its value in the chain's TAIL;
// the root node is the first statement's own let, and when that statement is discarded
// (`println(..)`, SIR `%_` of type unit) every reader of the root's type_name saw a unit-typed
// RHS: no callee-saved spill was taken (the next call clobbered X0), and a float, tuple or
// string value was staged through the int64 path. Walk to the non-let tail and read its type;
// when the tail carries none, the let's own declared type is the value type.
// See trials/sequence_block_addition/defect_nested_sequence_value_clobbered_by_call.
fn let_rhs_value_type(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term.root < 0 of {
        true -> "";
        false -> {
            inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_term_at(term, sir_term_root_node(term).inner);
            case inner.root < 0 of {
                true -> "";
                false -> case sir_term_root_node(inner).kind == 2 of {
                    false -> sir_term_root_node(inner).type_name;
                    true -> {
                        tail_type: string <- sir_term_root_node(sir_term_at(term, sir_non_let_root(inner))).type_name;
                        case length_bytes(tail_type) > 0 of {
                            true -> tail_type;
                            false -> sir_term_root_node(term).type_name
                        }
                    }
                }
            }
        }
    }
}

// Walk let tails (SIR kind 2) to the case (kind 3) name used for L_case_* labels.
fn sir_tail_case_label(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term.root < 0 of {
        true -> "";
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case n.kind == 3 of {
                true -> n.name;
                false -> case n.kind == 2 of {
                    true -> sir_tail_case_label(sir_term_at(term, n.right_expr));
                    false -> ""
                }
            }
        }
    }
}

fn let_duplicates_same_case(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    ir: int64 <- sir_non_let_root(inner);
    rr: int64 <- sir_non_let_root(right);
    case ir >= 0 and ir == rr of {
        true -> true;
        false -> {
            a: string <- sir_tail_case_label(inner);
            b: string <- sir_tail_case_label(right);
            case length_bytes(a) > 0 of {
                true -> a == b;
                false -> false
            }
        }
    }
}

// `wrap_let_or_return` of a non-let can become `let _ = L in L` (unit name `%_`).
// Skip only when the discarded RHS is the same term as the body. Matching SIR kind
// alone is wrong: `let _ = kill_abnormal(me) in tuple_make(...)` is two different
// prims (both kind 6) and must still emit the kill.
fn let_unit_wrap_duplicates(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case n.name == "%_" or n.name == "_" of {
                true -> {
                    inner_n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(sir_term_at(term, n.inner));
                    right_n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(sir_term_at(term, n.right_expr));
                    case n.inner == n.right_expr of {
                        true -> true;
                        false -> inner_n.kind == right_n.kind and inner_n.name == right_n.name and inner_n.value == right_n.value and inner_n.inner == right_n.inner and inner_n.right_expr == right_n.right_expr and (inner_n.kind == 2 or inner_n.kind == 3 or inner_n.kind == 6)
                    }
                };
                false -> false
            }
        }
    }
}

fn make_leaf_sir_const(type_name_v: string, value_v: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sequence
        result: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(0, type_name_v, value_v, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
    produces
        pure result
    end
}

fn make_call_sir_term_no_arg(type_name_v: string, value_v: string, name_v: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sequence
        result: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(4, type_name_v, value_v, name_v, sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
    produces
        pure result
    end
}

fn make_call_sir_term(type_name_v: string, value_v: string, name_v: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sequence
        result: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(4, type_name_v, value_v, name_v, arg, sir_ast@dummy_sir_term())
    produces
        pure result
    end
}

