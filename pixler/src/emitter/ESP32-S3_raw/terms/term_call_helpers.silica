// Thin forwarders for term_emit_kind_call.
// Five leaves were imported whole for 9 call sites: atom_table (9.3K),
// term_aggregate_helpers (8.4K), recursion_support (4.3K), term_reg_spill (1.9K)
// and control (0.7K) -- 24.6K of the unit's 41.3K interface. Each is re-exported
// here behind a narrow signature.
// See tutorials_and_howtos/thin_dispatchers_for_compile_ram.md.

use atom_table;
use term_aggregate_helpers;
use recursion_support;
use term_reg_spill;
use control;

export dec_str/1;
export tuple_elem_sret_reclaim/2;
export flat_tuple_dealloc_size/1;
export call_tuple_args_dealloc_bytes/1;
export emit_fuel_backedge_stub_comment/0;
export is_aggregate_make/1;
export function_tail_frame_release/1;

fn dec_str(n: int64) -> string {
    atom_table@int64_to_decimal_string(n)
}

fn tuple_elem_sret_reclaim(reg: string, nbytes: int64) -> string {
    term_aggregate_helpers@tuple_elem_sret_reclaim(reg, nbytes)
}

fn flat_tuple_dealloc_size(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    term_aggregate_helpers@flat_tuple_dealloc_size(term)
}

fn call_tuple_args_dealloc_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    term_aggregate_helpers@call_tuple_args_dealloc_bytes(term)
}

fn emit_fuel_backedge_stub_comment() -> string {
    recursion_support@emit_fuel_backedge_stub_comment()
}

fn is_aggregate_make(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    term_reg_spill@is_aggregate_make(t)
}

fn function_tail_frame_release(fn_effects: string) -> string {
    control@function_tail_frame_release(fn_effects)
}
