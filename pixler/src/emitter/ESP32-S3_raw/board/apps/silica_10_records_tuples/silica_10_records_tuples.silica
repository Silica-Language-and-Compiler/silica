// ESP32-S3 port early app 10: records and tuples. Inline record construction, field access, records
// as parameters and results, nested records, tuple construction and decomposition, a tuple literal
// inside a record read back out, and a list of records (aggregate list elements go through the
// runtime's copy path).
fn distance2(p: { x: int64, y: int64 }) -> int64 {
    p.x * p.x + p.y * p.y
}

fn move_point(p: { x: int64, y: int64 }, dx: int64, dy: int64) -> { x: int64, y: int64 } {
    moved: { x: int64, y: int64 } <- { x: p.x + dx, y: p.y + dy };
    moved
}

fn rectangle_area(rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } }) -> int64 {
    tl: { x: int64, y: int64 } <- rect.top_left;
    br: { x: int64, y: int64 } <- rect.bottom_right;
    (br.x - tl.x) * (tl.y - br.y)
}

fn swap(t: (int64, int64)) -> (int64, int64) {
    (a: int64, b: int64) <- t;
    (b, a)
}

fn sum_points(ps: List[{ x: int64, y: int64 }, mem(normal)]) -> int64 {
    case ps of {
        []: List[{ x: int64, y: int64 }, mem(normal)] -> 0;
        [h: { x: int64, y: int64 }, t: List[{ x: int64, y: int64 }, mem(normal)]] -> h.x + h.y + sum_points(t);
        _: List[{ x: int64, y: int64 }, mem(normal)] -> 0
    }
}

fn main() -> atom {
    sequence proc[mem(normal), device_io]
        point: { x: int64, y: int64 } <- { x: 3, y: 4 };
        p1: atom <- print_int64(distance2(point));
        println();
        moved: { x: int64, y: int64 } <- move_point(point, 5, 6);
        p2: atom <- print_int64(moved.x * 100 + moved.y);
        println();
        rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
            top_left: { x: 0, y: 10 },
            bottom_right: { x: 10, y: 0 }
        };
        p3: atom <- print_int64(rectangle_area(rect));
        println();
        pair: (int64, int64) <- (7, 9);
        (a: int64, b: int64) <- swap(pair);
        p4: atom <- print_int64(a * 10 + b);
        println();
        nested: ((int64, string), int64) <- ((1, "in"), 42);
        (inner: (int64, string), n: int64) <- nested;
        (k: int64, s: string) <- inner;
        p5: atom <- print_int64(n + k);
        println();
        print_string(s);
        println();
        // A tuple literal inside a record: copied with the record, read back out and decomposed
        // (trials/tuples_addition/decompose_record_tuple_field and record_tuple_field_*).
        labelled: { start: (int64, atom) } <- { start: (5, :go) };
        copy: { start: (int64, atom) } <- labelled;
        start: (int64, atom) <- copy.start;
        (sx: int64, tag: atom) <- start;
        tag_code: int64 <- case tag of {
            :go -> 1;
            _: atom -> 0
        };
        p6: atom <- print_int64(sx * 10 + tag_code);
        println();
        ps: List[{ x: int64, y: int64 }, mem(normal)] <- [{ x: 1, y: 2 }, { x: 3, y: 4 }, { x: 5, y: 6 }];
        p7: atom <- print_int64(sum_points(ps));
        println();
        p8: atom <- print_int64(length[{ x: int64, y: int64 }, mem(normal)](ps));
        println()
    produces pure :ok end
}
