// SPI2 (GP-SPI2, "FSPI" in the GPIO signal map) on the ESP32-S3 port test board: the device
// description and the master-mode helpers the display driver uses. Interim: the device
// specification (§4.9.1) says an on-board device is described only by the board pack, but the
// compiler does not read board-pack descriptions yet, so this description lives in device_lib like
// the GPIO and UART ones until esp32s3_board_peripherals_plan.md step 2 (the generated pack)
// replaces it. The window is board_pack.silica window 9 (0x60024000, 4 KB) whose base is
// TRM-unconfirmed; the SYSTEM window is window 8 (0x600C0000).
//
// Sources, all ESP-IDF v5.1, components/soc/esp32s3/include/soc/ (github.com/espressif/esp-idf),
// none yet checked against the ESP32-S3 TRM (every offset and bit below is TRM-unconfirmed):
//   reg_base.h    DR_REG_SPI2_BASE 0x60024000, DR_REG_SYSTEM_BASE 0x600C0000
//   spi_reg.h     SPI_CMD_REG 0x00 (SPI_UPDATE bit 23, SPI_USR bit 24), SPI_ADDR_REG 0x04,
//                 SPI_CTRL_REG 0x08 (SPI_WR_BIT_ORDER bits 25-26, 0 = MSB first), SPI_CLOCK_REG 0x0C
//                 (CLKCNT_L bits 0-5, CLKCNT_H 6-11, CLKCNT_N 12-17, CLKDIV_PRE 18-21,
//                 CLK_EQU_SYSCLK 31), SPI_USER_REG 0x10 (DOUTDIN bit 0, CS_HOLD 6, CS_SETUP 7,
//                 CK_OUT_EDGE 9, USR_MOSI 27, USR_MISO 28, USR_DUMMY 29, USR_ADDR 30,
//                 USR_COMMAND 31), SPI_USER1_REG 0x14, SPI_USER2_REG 0x18, SPI_MS_DLEN_REG 0x1C
//                 (MS_DATA_BITLEN bits 0-17), SPI_MISC_REG 0x20 (CS0_DIS..CS5_DIS bits 0-5, CK_DIS 6,
//                 CK_IDLE_EDGE 29), SPI_W0_REG 0x98 .. SPI_W15_REG 0xD4, SPI_CLK_GATE_REG 0xE8
//                 (CLK_EN bit 0, MST_CLK_ACTIVE 1, MST_CLK_SEL 2: 1 = PLL 80 MHz, 0 = XTAL)
//   system_reg.h  SYSTEM_PERIP_CLK_EN0_REG 0x18 and SYSTEM_PERIP_RST_EN0_REG 0x20, SPI2 bit 6 in
//                 both (clock enable defaults to 1, reset to 0)
//   hal/esp32s3/include/hal/spi_ll.h  the order of operations (clock gate, mode, length, UPDATE and
//                 wait, USR) and the clock-field arithmetic
//
// How the driver uses it: half duplex, MOSI phase only, no command/address/dummy phases. The
// 64-byte buffer W0..W15 holds up to 512 bits; :ms_dlen is the length minus one; SPI_UPDATE copies
// the configuration (clock, user, length, ...) into the SPI clock domain and clears when done;
// SPI_USR starts one transfer and clears when it completes. Bytes go out from W0's low byte
// upward, most significant bit of each byte first. The hardware chip selects are all disabled
// (:misc CS0..5_DIS): the display's CS is a GPIO because the panel wants a chip-select transaction
// per command. Clock: XTAL 40 MHz (MST_CLK_SEL 0 -- the ROM hands off without the PLL, board_pack
// cpu_hz_at_boot) divided by 4 = 10 MHz, inside the ST7789's 15 MHz write limit and twice the
// half-period the bit-banged path used; CLKDIV_PRE 0, CLKCNT_N 3, CLKCNT_H 1, CLKCNT_L 3 (spi_ll's
// values for pre 1, n 4). Mode 0: CK_IDLE_EDGE 0 and CK_OUT_EDGE 0. A slower first try is one
// constant: CLKCNT_N 7, H 3, L 7 (0x70C7) is 5 MHz.
//
// A run of the same bytes (a solid fill) is loaded into W0..W15 once (spi2_load_run) and then
// started as many times as needed (spi2_start_runs): sixteen pokes per fill, not per transfer.

use device_esp32s3_spi2_registers;
use device_esp32s3_system_registers;
use board_pack_spi2_values;
use board_pack_system_values;

export spi2_enable/1;
export spi2_init/1;
export spi2_send_bytes/3;
export spi2_load_run/2;
export spi2_start_runs/2;

fn wait_update(w: device_window(L, (:esp32s3_spi2))) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        upd: uint32 <- board_pack_spi2_values@spi2_update_mask();
        c: uint32 <- peek(w, :cmd) impl Register32 {};
        r: device_window(L, (:esp32s3_spi2)) <- case (c band upd) == 0 of {
            true -> w;
            false -> wait_update(w)
        }
    produces
        pure r
    end
}

fn wait_usr(w: device_window(L, (:esp32s3_spi2))) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        usr: uint32 <- board_pack_spi2_values@spi2_usr_mask();
        c: uint32 <- peek(w, :cmd) impl Register32 {};
        r: device_window(L, (:esp32s3_spi2)) <- case (c band usr) == 0 of {
            true -> w;
            false -> wait_usr(w)
        }
    produces
        pure r
    end
}

// Copies the configuration registers into the SPI clock domain; needed after any of them changes.
fn sync(w: device_window(L, (:esp32s3_spi2))) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        upd: uint32 <- board_pack_spi2_values@spi2_update_mask();
        _: atom <- poke(w, :cmd, upd impl Register32 {});
        r: device_window(L, (:esp32s3_spi2)) <- wait_update(w)
    produces
        pure r
    end
}

fn transfer(w: device_window(L, (:esp32s3_spi2))) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        usr: uint32 <- board_pack_spi2_values@spi2_usr_mask();
        _: atom <- poke(w, :cmd, usr impl Register32 {});
        r: device_window(L, (:esp32s3_spi2)) <- wait_usr(w)
    produces
        pure r
    end
}

fn store_word(w: device_window(L, (:esp32s3_spi2)), i: uint32, word: uint32) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        _: atom <- case i of {
            0 -> poke(w, :w0, word impl Register32 {});
            1 -> poke(w, :w1, word impl Register32 {});
            2 -> poke(w, :w2, word impl Register32 {});
            3 -> poke(w, :w3, word impl Register32 {});
            4 -> poke(w, :w4, word impl Register32 {});
            5 -> poke(w, :w5, word impl Register32 {});
            6 -> poke(w, :w6, word impl Register32 {});
            7 -> poke(w, :w7, word impl Register32 {});
            8 -> poke(w, :w8, word impl Register32 {});
            9 -> poke(w, :w9, word impl Register32 {});
            10 -> poke(w, :w10, word impl Register32 {});
            11 -> poke(w, :w11, word impl Register32 {});
            12 -> poke(w, :w12, word impl Register32 {});
            13 -> poke(w, :w13, word impl Register32 {});
            14 -> poke(w, :w14, word impl Register32 {});
            15 -> poke(w, :w15, word impl Register32 {});
            _: uint32 -> :ok
        }
    produces
        pure w
    end
}

fn load_words(w: device_window(L, (:esp32s3_spi2)), word: uint32, i: uint32, n: uint32) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        one: uint32 <- 1;
        r: device_window(L, (:esp32s3_spi2)) <- case i == n of {
            true -> w;
            false -> load_words(store_word(w, i, word), word, i + one, n)
        }
    produces
        pure r
    end
}

// Clock on and out of reset; both are the reset defaults, set here so the driver does not depend
// on what ran before it.
fn spi2_enable(s: device_window(L, (:esp32s3_system))) -> device_window(L, (:esp32s3_system)) {
    sequence proc[register_rwr]
        spi2: uint32 <- board_pack_system_values@system_spi2_clk_en_mask();
        rst_bit: uint32 <- board_pack_system_values@system_spi2_rst_mask();
        keep: uint32 <- bnot rst_bit;
        en: uint32 <- peek(s, :perip_clk_en0) impl Register32 {};
        _: atom <- poke(s, :perip_clk_en0, (en bor spi2) impl Register32 {});
        rst: uint32 <- peek(s, :perip_rst_en0) impl Register32 {};
        _: atom <- poke(s, :perip_rst_en0, (rst band keep) impl Register32 {})
    produces
        pure s
    end
}

// Master, mode 0, 10 MHz from the crystal, MOSI phase only, hardware chip selects off, MSB first.
fn spi2_init(w: device_window(L, (:esp32s3_spi2))) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        clk_en: uint32 <- board_pack_spi2_values@spi2_clk_en_mask();
        clk_active: uint32 <- board_pack_spi2_values@spi2_mst_clk_active_mask();
        gate_on_xtal: uint32 <- clk_en bor clk_active;
        one: uint32 <- 1;
        three: uint32 <- 3;
        n_shift: uint32 <- board_pack_spi2_values@spi2_clkcnt_n_shift();
        h_shift: uint32 <- board_pack_spi2_values@spi2_clkcnt_h_shift();
        l_shift: uint32 <- board_pack_spi2_values@spi2_clkcnt_l_shift();
        div_by_4: uint32 <- (three shl n_shift) bor (one shl h_shift) bor (three shl l_shift);
        mosi_only: uint32 <- board_pack_spi2_values@spi2_usr_mosi_mask();
        cs0: uint32 <- board_pack_spi2_values@spi2_cs0_dis_mask();
        cs1: uint32 <- board_pack_spi2_values@spi2_cs1_dis_mask();
        cs2: uint32 <- board_pack_spi2_values@spi2_cs2_dis_mask();
        cs3: uint32 <- board_pack_spi2_values@spi2_cs3_dis_mask();
        cs4: uint32 <- board_pack_spi2_values@spi2_cs4_dis_mask();
        cs5: uint32 <- board_pack_spi2_values@spi2_cs5_dis_mask();
        all_cs_off: uint32 <- cs0 bor cs1 bor cs2 bor cs3 bor cs4 bor cs5;
        zero: uint32 <- 0;
        order_mask: uint32 <- board_pack_spi2_values@spi2_wr_bit_order_mask();
        keep_order: uint32 <- bnot order_mask;
        _: atom <- poke(w, :clk_gate, gate_on_xtal impl Register32 {});
        _: atom <- poke(w, :clock, div_by_4 impl Register32 {});
        _: atom <- poke(w, :user, mosi_only impl Register32 {});
        _: atom <- poke(w, :user1, zero impl Register32 {});
        _: atom <- poke(w, :user2, zero impl Register32 {});
        _: atom <- poke(w, :addr, zero impl Register32 {});
        _: atom <- poke(w, :misc, all_cs_off impl Register32 {});
        ctrl: uint32 <- peek(w, :ctrl) impl Register32 {};
        _: atom <- poke(w, :ctrl, (ctrl band keep_order) impl Register32 {});
        r: device_window(L, (:esp32s3_spi2)) <- sync(w)
    produces
        pure r
    end
}

// One transfer of 1..64 bytes, every word of the buffer the same `word` (a byte, a byte pair, or a
// pixel pair repeated); the first byte out is word's low byte.
fn spi2_send_bytes(w: device_window(L, (:esp32s3_spi2)), word: uint32, nbytes: uint32) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        one: uint32 <- 1;
        three: uint32 <- 3;
        w1: device_window(L, (:esp32s3_spi2)) <- load_words(w, word, 0, (nbytes + three) shr 2);
        _: atom <- poke(w1, :ms_dlen, ((nbytes shl 3) - one) impl Register32 {});
        w2: device_window(L, (:esp32s3_spi2)) <- sync(w1);
        r: device_window(L, (:esp32s3_spi2)) <- transfer(w2)
    produces
        pure r
    end
}

// Loads all 64 bytes with `word` and sets a 512-bit transfer; spi2_start_runs then repeats it.
fn spi2_load_run(w: device_window(L, (:esp32s3_spi2)), word: uint32) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        full: uint32 <- 511;
        w1: device_window(L, (:esp32s3_spi2)) <- load_words(w, word, 0, 16);
        _: atom <- poke(w1, :ms_dlen, full impl Register32 {});
        r: device_window(L, (:esp32s3_spi2)) <- sync(w1)
    produces
        pure r
    end
}

fn spi2_start_runs(w: device_window(L, (:esp32s3_spi2)), n: uint32) -> device_window(L, (:esp32s3_spi2)) {
    sequence proc[register_rwr]
        one: uint32 <- 1;
        r: device_window(L, (:esp32s3_spi2)) <- case n == 0 of {
            true -> w;
            false -> spi2_start_runs(transfer(w), n - one)
        }
    produces
        pure r
    end
}
