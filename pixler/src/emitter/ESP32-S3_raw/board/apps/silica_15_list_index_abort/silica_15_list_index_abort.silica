// ESP32-S3 port app 15: a runtime abort (spec §15.4.5.5). list_at one past the end of a list is a failed
// runtime check: the board runtime (rt_list.S -> silica_rt_abort_list_index in rt_console.S) prints
// "[silica] abort: list index out of range at 0x<pc>" as program output and exits with status 71, as
// the host prints the same line (with " in <symbol>+0x<offset>") on stderr. The first call is in range
// and prints 9. The addresses differ by run and target: compare with tools/compare_sout.sh. The same
// program is trials/list_addition/list_at_out_of_range_aborts.
fn pick(i: int64) -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [7, 8, 9];
        v: int64 <- list_at[int64, mem(normal)](xs, i)
    produces
        pure v
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- pick(2);
        print_int64(a);
        println("");
        b: int64 <- pick(3);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
