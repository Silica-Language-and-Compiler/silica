// Control flow: function prologue/epilogue for the Xtensa windowed ABI (ESP32-S3).
// Effect-aware: mem(atomic) gets a MEMW barrier at entry and exit (DMB ISH on AArch64, spec §9.1.1).
//
// Frame size and home offsets are assembler symbols (SFRAME, SFP, SVR_*) that emitter_core defines in
// front of the label once the body is known; see design_documents/ports/esp32s3_xtensa_port.md §3.

use emitter_effects;

export function_prologue/1;
export function_epilogue_with_frame/0;
export function_prologue_with_effects/2;
export function_epilogue_with_effects/1;
export function_tail_frame_release/1;

// Section, label and ENTRY. Each function is in its own .text.<name> section (its L32R literals go to
// the matching .literal.<name> the assembler derives), so the board link's --gc-sections drops unused
// functions. Every function must be 4-byte aligned: the assembler rejects an unaligned ENTRY.
// Incoming arguments arrive in a2-a7 (the caller's a10-a15); they are moved to the X0-X2 homes
// a10-a15 at once, which is where every emitter path expects parameters -- as X0-X2 on AArch64.
//
// Stack check and growth. Right after ENTRY the new a1 is compared with this context's machine-stack
// limit, the word at THREADPTR+116 (VRG_MLIMIT, rt_actors.S: the current stack chunk's guard band
// top plus the deepest runtime chain emitted code can call, so the runtime frames below this one
// stay above the band too). Below it the frame, which holds nothing yet, moves to the top of the
// next chunk: it parks itself 32 bytes under the limit (MOVSP, legal because the caller's window is
// live this early), calls silica_rt_stack_grow with its ENTRY size and its real a0, and moves to
// the a1 the runtime returns, with the a0 it returns: the address of silica_rt_chunk_return, which
// puts the chunk below back when this frame returns (actor_memory_budget_plan.md item F; the
// runtime's "Growable stacks"). Both MOVSPs run with a0 holding a windowed return address, which the
// alloca exception handler reads to tell the call size when the caller's window has been spilled.
// In main, whose stacks are fixed, the runtime raises the fatal overflow instead. a8-a11 are scratch
// here; a2-a7, the incoming arguments, survive the call.
fn function_prologue(name: string) -> string {
    head: string <- concat("    .section .text.", concat(name, concat(",\"ax\",@progbits\n    .align 4\n", concat(name, ":\n    entry a1, SFRAME\n"))));
    check: string <- "    rur a8, threadptr\n    l32i a8, a8, 116\n    bgeu a1, a8, 1f\n    addi a8, a8, -32\n    movsp a1, a8\n    movi a10, SFRAME\n    mov a11, a0\n    call8 silica_rt_stack_grow\n    mov a0, a11\n    movsp a1, a10\n1:\n";
    concat(head, concat(check, "    mov a10, a2\n    mov a11, a3\n    mov a12, a4\n    mov a13, a5\n    mov a14, a6\n    mov a15, a7\n"))
}

// Integer result: X0 (a10:a11) goes back in a2:a3, which the caller sees as its a10:a11.
fn function_epilogue_with_frame() -> string {
    "    mov a2, a10\n    mov a3, a11\n    retw\n"
}

fn has_atomic_effect(fn_effects: string) -> boolean {
    case emitter_effects@is_pure(fn_effects) of {
        true -> false;
        false -> emitter_effects@has_mem_atomic(fn_effects)
    }
}

fn function_prologue_with_effects(name: string, fn_effects: string) -> string {
    base: string <- function_prologue(name);
    case has_atomic_effect(fn_effects) of {
        true -> concat(base, "    memw\n");
        false -> base
    }
}

fn function_epilogue_with_effects(fn_effects: string) -> string {
    base: string <- function_epilogue_with_frame();
    case has_atomic_effect(fn_effects) of {
        true -> concat("    memw\n", base);
        false -> base
    }
}

// The windowed ABI has no tail transfer (ENTRY needs the rotation of a real CALLn), so there is no
// frame to release before one: emitter_core never takes the tail path on this target.
fn function_tail_frame_release(fn_effects: string) -> string {
    case has_atomic_effect(fn_effects) of {
        true -> "    memw\n";
        false -> ""
    }
}
