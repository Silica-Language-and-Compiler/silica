// ESP32-S3 port early app 12: floating point. float64 (libgcc soft float), float32 (the FPU) and
// float16 (widened through the runtime) arithmetic, comparisons, negation, and printing with the
// host's digit algorithm (board/runtime/rt_float.S).
// Comparisons feed boolean cases that yield integers, and cases on a comparison of two float
// parameters that yield one of those parameters (float64, float32 and float16;
// trials/float64_addition/case_float_compare_params and the float32/float16 twins).
fn lt64(a: float64, b: float64) -> int64 {
    case a < b of {
        true -> 1;
        false -> 0
    }
}

fn lt32(a: float32, b: float32) -> int64 {
    case a < b of {
        true -> 1;
        false -> 0
    }
}

fn max64(a: float64, b: float64) -> float64 {
    case a < b of {
        true -> b;
        false -> a
    }
}

fn max32(a: float32, b: float32) -> float32 {
    case a < b of {
        true -> b;
        false -> a
    }
}

fn max16(a: float16, b: float16) -> float16 {
    case a < b of {
        true -> b;
        false -> a
    }
}

fn main() -> atom {
    sequence proc[device_io]
        a: atom <- print_float64(22.0 / 7.0);
        println();
        b: atom <- print_float64(6.5 + 40.5 / 2.25);
        println();
        c: atom <- print_float64((6.5 + 40.25) / 2.5);
        println();
        d: atom <- print_float64(0.0 - 1.5);
        println();
        e: atom <- print_int64(lt64(3.25, -8.0) * 10 + lt64(-8.0, 3.25));
        println();
        f: atom <- print_float64(1000000.0 * 1000000.0 + 0.5);
        println();
        g: atom <- print_float32(2.5 + 3.2 * 3.9375);
        println();
        h: atom <- print_int64(lt32(0.1, 0.2) * 10 + lt32(0.3, 0.2));
        println();
        h2: atom <- print_float32(0.1 + 0.2 - 0.3);
        println();
        i: atom <- print_float32(-7.0 / 2.0);
        println();
        j: atom <- print_float16(2.5 + 3.2 * 3.9375);
        println();
        k: atom <- print_float16(1.0 / 3.0);
        println();
        l: atom <- print_float16(-0.5 * 8.0);
        println();
        m: atom <- print_float64(max64(3.25, -8.0) * 4.0);
        println();
        n: atom <- print_float32(max32(0.1, 0.2));
        println();
        o: atom <- print_float16(max16(-2.5, 1.5));
        println()
    produces pure :ok end
}
