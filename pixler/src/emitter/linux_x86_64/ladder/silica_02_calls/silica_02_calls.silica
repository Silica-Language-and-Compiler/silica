// ESP32-S3 port early app 02: calls with one and two arguments, nested calls as arguments, and
// recursion. ack(2, 3) = 9, gcd(1071, 462) = 21, fib(10) = 55; 9 + 21 + 55 = 85.
fn ack_nonzero(m: int64, n: int64) -> int64 {
    case n == 0 of {
        true -> ack(m - 1, 1);
        false -> ack(m - 1, ack(m, n - 1))
    }
}

fn ack(m: int64, n: int64) -> int64 {
    case m == 0 of {
        true -> n + 1;
        false -> ack_nonzero(m, n)
    }
}

fn gcd(a: int64, b: int64) -> int64 {
    case b == 0 of {
        true -> a;
        false -> gcd(b, a % b)
    }
}

fn fib(n: int64) -> int64 {
    case n < 2 of {
        true -> n;
        false -> fib(n - 1) + fib(n - 2)
    }
}

fn main() -> int64 {
    ack(2, 3) + gcd(1071, 462) + fib(10)
}
