// ESP32-S3 port early app 11: memory regions. alloc_region, scalar and tuple refs (alloc_ref,
// read_ref, write_ref), int64 buffers (alloc_buf, write_buf, read_buf), and a buffer far
// larger than a region block so the region grows (silica_rt_region_grow in board/runtime/rt_heap.S).
// Writes every 20th slot (100 levels of recursion: each level costs a windowed frame plus an
// aux-stack slab for the write_buf argument tuple, and the board's stacks hold about 2000 frames).
fn fill(b: buf(L1, normal, int64, 2000), i: int64) -> atom {
    sequence proc[mem(normal)]
        _: atom <- write_buf(b, i, i * 3);
        r: atom <- case i == 1980 of {
            true -> :done;
            false -> fill(b, i + 20)
        }
    produces pure r end
}

fn main() -> atom {
    sequence proc[mem(normal), device_io]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        cell: ref(L1, normal, int64) <- alloc_ref(r, 20);
        _: atom <- write_ref(cell, 177);
        p1: atom <- print_int64(read_ref(cell));
        println();
        pair: (int64, int64) <- (10, 20);
        pref: ref(L1, normal, (int64, int64)) <- alloc_ref(r, pair);
        back: (int64, int64) <- read_ref(pref);
        (a: int64, b: int64) <- back;
        p2: atom <- print_int64(a * 100 + b);
        println();
        capacity: int64 <- 12;
        nums: buf(L1, normal, int64, capacity) <- alloc_buf(r, capacity);
        _: atom <- write_buf(nums, 7, 123);
        _: atom <- write_buf(nums, 11, -5);
        p3: atom <- print_int64(read_buf(nums, 7) + read_buf(nums, 11) + read_buf(nums, 0));
        println();
        big: buf(L1, normal, int64, 2000) <- alloc_buf(r, 2000);
        _: atom <- fill(big, 0);
        p6: atom <- print_int64(read_buf(big, 0) + read_buf(big, 1000) + read_buf(big, 1980) + read_buf(big, 1999));
        println();
        after: ref(L1, normal, int64) <- alloc_ref(r, 8);
        p7: atom <- print_int64(read_ref(after) + read_ref(cell));
        println()
    produces pure :ok end
}
