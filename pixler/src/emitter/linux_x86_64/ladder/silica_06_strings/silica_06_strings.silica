// ESP32-S3 port early app 06: strings -- literals, concat, byte length, substring.
fn main() -> atom {
    sequence proc[device_io]
        s: string <- concat("esp32", "-s3");
        print_string(s);
        println();
        print_int64(length_bytes(s));
        println();
        print_string(substring(s, 0, 5));
        println();
        print_string(concat(substring(s, 6, 8), " board"));
        println()
    produces pure :ok end
}
