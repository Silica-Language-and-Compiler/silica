// Record stack layout sizes and field store offsets for term emission.

use prims_record;
use term_child_spec;

export record_store_offset_for_field/5;
export record_make_stack_alloc_size/1;
export stack_alloc_round16/1;
export record_shape_store_offset/3;

fn record_store_offset_for_field(R: string, fname: string, field_prefix: int64, base_off: int64, sp_adjust: int64) -> int64 {
    case base_off < 0 of {
        true -> -1;
        false -> record_store_offset_for_field_found(R, fname, field_prefix, base_off, sp_adjust)
    }
}

fn record_store_offset_for_field_found(R: string, fname: string, field_prefix: int64, base_off: int64, sp_adjust: int64) -> int64 {
    case term_child_spec@is_child_spec_record_type(R) of {
        false -> field_prefix + base_off + sp_adjust;
        true -> {
            abi: int64 <- term_child_spec@child_spec_field_abi_offset(fname);
            case abi < 0 of {
                true -> field_prefix + base_off + sp_adjust;
                false -> field_prefix + abi
            }
        }
    }
}

// Child spec: shape word, seven field slots, the hidden trampoline word (72 B). Supervisor reply:
// shape word, five slots, the spliced child_info (shape word + four slots), error (96 B).
fn record_make_stack_alloc_size(R: string) -> int64 {
    case term_child_spec@is_child_spec_record_type(R) of {
        true -> 80;
        false -> case term_child_spec@is_supervisor_reply_record_type(R) of {
            true -> 96;
            false -> stack_alloc_round16(prims_record@record_type_value_flat_byte_size(R))
        }
    }
}

// Where a record_make writes its shape word: slot 0 of the record, placed as its fields are.
fn record_shape_store_offset(R: string, field_prefix: int64, sp_adjust: int64) -> int64 {
    case term_child_spec@is_child_spec_record_type(R) of {
        true -> field_prefix;
        false -> field_prefix + sp_adjust
    }
}

fn stack_alloc_round16(nbytes: int64) -> int64 {
    (nbytes + 15) / 16 * 16
}

