// Checked int64 runtime helpers (Layer 1 §7.8), Linux x86-64: rdi rsi in; ok in edi, value in rsi.

export emit_checked_int64_runtime_asm/0;

fn emit_checked_int64_runtime_asm() -> string {
    add_fn: string <- "    .globl silica_rt_checked_i64_add\nsilica_rt_checked_i64_add:\n    mov rdx, rdi\n    add rdx, rsi\n    setno al\n    movzx edi, al\n    mov esi, 0\n    cmovno rsi, rdx\n    ret\n";
    add1_fn: string <- "    .globl silica_rt_checked_i64_add1\nsilica_rt_checked_i64_add1:\n    mov rdx, rdi\n    add rdx, 1\n    setno al\n    movzx edi, al\n    mov esi, 0\n    cmovno rsi, rdx\n    ret\n";
    mul_fn: string <- "    .globl silica_rt_checked_i64_mul\nsilica_rt_checked_i64_mul:\n    mov rdx, rdi\n    imul rdx, rsi\n    setno al\n    movzx edi, al\n    mov esi, 0\n    cmovno rsi, rdx\n    ret\n";
    concat(concat(add_fn, add1_fn), mul_fn)
}
