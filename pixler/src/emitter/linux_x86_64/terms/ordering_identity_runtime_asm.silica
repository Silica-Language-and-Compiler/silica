// Exact function-value ordering identity (Layer 1 §7.2), Linux x86-64.
// Tokens mix code pointer and captured-environment instance id; not forgeable from behavior alone.
// Arguments arrive in rdi rsi, results leave in rdi.

export emit_ordering_identity_runtime_asm/0;

fn emit_ordering_identity_runtime_asm() -> string {
    "
	.bss
	.p2align	3
	.globl	silica_rt_ordering_env_next
silica_rt_ordering_env_next:
	.space	8
	.text
	.globl	silica_rt_ordering_env_fresh
	.p2align	4
silica_rt_ordering_env_fresh:
# -> rdi = fresh non-zero environment instance id
	lea	rax, [rip + silica_rt_ordering_env_next]
	mov	rdi, QWORD PTR [rax]
	lea	rsi, [rdi + 1]
	mov	QWORD PTR [rax], rsi
	test	rdi, rdi
	jnz	Loid_ret
	mov	edi, 1
Loid_ret:
	ret
	.globl	silica_rt_ordering_identity_make
	.p2align	4
silica_rt_ordering_identity_make:
# rdi = code pointer, rsi = environment instance id -> rdi = opaque int64 token
	mov	rdx, rsi
	shl	rdx, 32
	xor	rdx, rdi
	mov	rcx, 0x9e379b977f4a7c15
	mov	r8, rsi
	imul	r8, rcx
	xor	rdx, r8
	mov	rdi, rdx
	ret
	.globl	silica_rt_ordering_identity_same
	.p2align	4
silica_rt_ordering_identity_same:
# rdi = token A, rsi = token B -> rdi = 1 if equal else 0
	cmp	rdi, rsi
	sete	al
	movzx	edi, al
	ret
	.globl	silica_rt_ordering_bundle_make
	.p2align	4
silica_rt_ordering_bundle_make:
# rdi = function token, rsi = orientation atom (int64) -> rdi = bundle token
	mov	rdx, 0x517cc1b727220a95
	imul	rdx, rsi
	xor	rdi, rdx
	mov	rcx, 0x7fffffffffffffff
	and	rdi, rcx
	ret
"
}
