// Runtime helpers for FFI string in/out (Phase 8/12), Linux x86-64. Linked once per executable using foreign calls.
// Arguments arrive in rdi rsi; results leave in rdi (rsi rdx for the extra X1/X2 results of string_in);
// malloc's result arrives in rax. X19..X24 live in frame slots [rbp-8]..[rbp-48].

export emit_ffi_foreign_runtime_helpers/0;

fn emit_ffi_foreign_runtime_helpers() -> string {
    // Phase 12: string-in and sret buffers prefer the per-actor FFI arena (rdx=0 => no heap free).
    // C wrapper malloc'd output spans are copied into Silica strings; arena/sret blocks are not freed.
    helper_in: string <- "silica_rt_ffi_string_in:\n    push rbp\n    mov rbp, rsp\n    sub rsp, 80\n    mov QWORD PTR [rbp - 8], rdi\n    test rdi, rdi\n    jz L_ffi_in_empty\n    mov r10, QWORD PTR [rdi]\n    not r10\n    cmp r10, 1\n    ja L_ffi_in_bad\n    mov r10, QWORD PTR [rdi + 8]\n    mov QWORD PTR [rbp - 24], r10\n    mov r10, QWORD PTR [rdi + 16]\n    mov QWORD PTR [rbp - 32], r10\n    jmp L_ffi_in_have_src\nL_ffi_in_empty:\n    mov QWORD PTR [rbp - 24], 0\n    mov QWORD PTR [rbp - 32], 0\nL_ffi_in_have_src:\n    call silica_rt_tls_current_actor_get\n    test rdi, rdi\n    jz L_ffi_in_heap\n    mov QWORD PTR [rbp - 40], rdi\n    mov rdi, QWORD PTR [rbp - 32]\n    inc rdi\n    call silica_rt_ffi_arena_bump\n    test rdi, rdi\n    jz L_ffi_in_oom\n    mov QWORD PTR [rbp - 48], rdi\n    mov r11, QWORD PTR [rbp - 32]\n    test r11, r11\n    jz L_ffi_in_nul_arena\n    mov r10, rdi\n    mov r8, QWORD PTR [rbp - 24]\nL_ffi_in_cp_arena:\n    movzx eax, BYTE PTR [r8]\n    inc r8\n    mov BYTE PTR [r10], al\n    inc r10\n    dec r11\n    jnz L_ffi_in_cp_arena\nL_ffi_in_nul_arena:\n    mov rdi, QWORD PTR [rbp - 48]\n    mov rsi, QWORD PTR [rbp - 32]\n    mov BYTE PTR [rdi + rsi], 0\n    xor edx, edx\n    leave\n    ret\nL_ffi_in_heap:\n    mov rdi, QWORD PTR [rbp - 32]\n    inc rdi\n    call malloc\n    mov rdi, rax\n    test rdi, rdi\n    jz L_ffi_in_oom\n    mov r11, QWORD PTR [rbp - 32]\n    test r11, r11\n    jz L_ffi_in_done\n    mov r10, rdi\n    mov r8, QWORD PTR [rbp - 24]\nL_ffi_in_cp:\n    movzx eax, BYTE PTR [r8]\n    inc r8\n    mov BYTE PTR [r10], al\n    inc r10\n    dec r11\n    jnz L_ffi_in_cp\nL_ffi_in_done:\n    mov rsi, QWORD PTR [rbp - 32]\n    mov rdx, rdi\n    leave\n    ret\nL_ffi_in_oom:\n    xor edi, edi\n    xor esi, esi\n    xor edx, edx\n    leave\n    ret\n\nL_ffi_in_bad:\n    ud2\n";
    helper_from: string <- "silica_rt_ffi_string_from_bytes:\n    push rbp\n    mov rbp, rsp\n    sub rsp, 80\n    mov QWORD PTR [rbp - 8], rdi\n    mov QWORD PTR [rbp - 16], rsi\n    test rsi, rsi\n    jz L_ffi_from_empty\n    lea rdi, [rsi + 25]\n    call malloc\n    test rax, rax\n    jz L_ffi_from_empty\n    mov QWORD PTR [rax], -1\n    lea r10, [rax + 24]\n    mov QWORD PTR [rax + 8], r10\n    mov r11, QWORD PTR [rbp - 16]\n    mov QWORD PTR [rax + 16], r11\n    mov r8, QWORD PTR [rbp - 8]\nL_ffi_from_cp:\n    test r11, r11\n    jz L_ffi_from_nul\n    movzx ecx, BYTE PTR [r8]\n    inc r8\n    mov BYTE PTR [r10], cl\n    inc r10\n    dec r11\n    jmp L_ffi_from_cp\nL_ffi_from_nul:\n    mov BYTE PTR [r10], 0\n    mov rdi, rax\n    leave\n    ret\nL_ffi_from_empty:\n    xor edi, edi\n    leave\n    ret\n";
    helper_out: string <- "silica_rt_ffi_string_out_and_free:\n    push rbp\n    mov rbp, rsp\n    sub rsp, 80\n    test rdi, rdi\n    jz L_ffi_out_no_sret\n    mov QWORD PTR [rbp - 8], rdi\n    mov r10, QWORD PTR [rdi]\n    test r10, r10\n    jnz L_ffi_out_err\n    mov rsi, QWORD PTR [rdi + 16]\n    mov rdi, QWORD PTR [rdi + 8]\n    call silica_rt_ffi_string_from_bytes\n    mov QWORD PTR [rbp - 16], rdi\n    mov rax, QWORD PTR [rbp - 8]\n    mov rdi, QWORD PTR [rax + 8]\n    test rdi, rdi\n    jz L_ffi_out_no_cfree\n    call silica_rt_ffi_ptr_in_active_arena\n    test rdi, rdi\n    jnz L_ffi_out_no_cfree\n    mov rax, QWORD PTR [rbp - 8]\n    mov rdi, QWORD PTR [rax + 8]\n    call free\nL_ffi_out_no_cfree:\n    mov rdi, QWORD PTR [rbp - 8]\n    call silica_rt_ffi_ptr_in_active_arena\n    test rdi, rdi\n    jnz L_ffi_out_no_sret_free\n    mov rdi, QWORD PTR [rbp - 8]\n    call free\nL_ffi_out_no_sret_free:\n    mov rdi, QWORD PTR [rbp - 16]\n    leave\n    ret\nL_ffi_out_err:\n    mov rdi, QWORD PTR [rdi + 8]\n    test rdi, rdi\n    jz L_ffi_out_err_skip\n    call silica_rt_ffi_ptr_in_active_arena\n    test rdi, rdi\n    jnz L_ffi_out_err_skip\n    mov rax, QWORD PTR [rbp - 8]\n    mov rdi, QWORD PTR [rax + 8]\n    call free\nL_ffi_out_err_skip:\n    mov rdi, QWORD PTR [rbp - 8]\n    call silica_rt_ffi_ptr_in_active_arena\n    test rdi, rdi\n    jnz L_ffi_out_err_done\n    mov rdi, QWORD PTR [rbp - 8]\n    call free\nL_ffi_out_err_done:\n    xor edi, edi\n    leave\n    ret\nL_ffi_out_no_sret:\n    xor edi, edi\n    leave\n    ret\n";
    concat(concat(helper_in, helper_from), helper_out)
}
