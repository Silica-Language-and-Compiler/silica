// String length helpers: byte length and UTF-8 scalar count. Hand-written x86-64 leaves (same normalize as io.rs).
// Char count: for valid UTF-8, equals Rust str::chars().count() (non-continuation bytes).
// X0 = rdi = string pointer; returns length in X0 = rdi. Leaves: the AArch64 X19-X22 saves are not
// needed (a helper may clobber anything but rbp/rsp); X19 -> r10, X20 -> r8, X21 -> r9, X9 -> r11.

export emit_length_bytes_helper/0;
export emit_length_chars_helper/0;

fn emit_length_bytes_helper() -> string {
    "L_length_bytes_helper:\n    push rbp\n    mov rbp, rsp\n    mov r10, rdi\n    test r10, r10\n    jz Llb_z\n    mov rsi, QWORD PTR [r10]\n    not rsi\n    cmp rsi, 1\n    ja Llb_bad\n    mov rdi, QWORD PTR [r10 + 16]\n    pop rbp\n    ret\nLlb_z:\n    xor edi, edi\n    pop rbp\n    ret\nLlb_bad:\n    ud2\n"
}

fn emit_length_chars_helper() -> string {
    "L_length_chars_helper:\n    push rbp\n    mov rbp, rsp\n    mov r10, rdi\n    test r10, r10\n    jz Lch_z\n    mov rsi, QWORD PTR [r10]\n    not rsi\n    cmp rsi, 1\n    ja Lch_bad\n    mov r8, QWORD PTR [r10 + 8]\n    mov r9, QWORD PTR [r10 + 16]\n    xor edi, edi\n    xor r11d, r11d\nLch_lp:\n    cmp r11, r9\n    jae Lch_done\n    movzx eax, BYTE PTR [r8 + r11]\n    add rdi, 1\n    cmp eax, 0x80\n    jb Lch_a1\n    mov ecx, eax\n    and ecx, 0xE0\n    cmp ecx, 0xC0\n    je Lch_a2\n    mov ecx, eax\n    and ecx, 0xF0\n    cmp ecx, 0xE0\n    je Lch_a3\n    mov ecx, eax\n    and ecx, 0xF8\n    cmp ecx, 0xF0\n    je Lch_a4\nLch_a1:\n    add r11, 1\n    jmp Lch_lp\nLch_a2:\n    add r11, 2\n    jmp Lch_lp\nLch_a3:\n    add r11, 3\n    jmp Lch_lp\nLch_a4:\n    add r11, 4\n    jmp Lch_lp\nLch_done:\n    pop rbp\n    ret\nLch_z:\n    xor edi, edi\n    pop rbp\n    ret\nLch_bad:\n    ud2\n"
}
