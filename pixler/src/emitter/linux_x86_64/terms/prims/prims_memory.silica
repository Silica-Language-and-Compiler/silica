// L_ev_heap's allocator: the actor runtime's silica_rt_region_alloc (rdi = bytes -> rdi = block) where
// the module uses actors; elsewhere the label exists so the evacuation routine assembles, and is never
// reached.
fn emit_ev_region_alloc(with_runtime: boolean) -> string {
    case with_runtime of {
        true -> "L_ev_region_alloc:\n    jmp silica_rt_region_alloc\n";
        false -> "L_ev_region_alloc:\n    ud2\n"
    }
}

// L_stack_top -> rdi = the top of the stack this code runs on: the current actor's reservation (ACB
// +272 base, +280 bytes), or the thread's own stack through glibc (main, a dangerous actor's thread,
// an actor that has no reservation). Everything a send, a spawn or a reply may hand to another actor
// that lies in [rsp, top) is frame memory and is copied out first (phase 2 interim, phases 3/4).
fn emit_stack_top_helper() -> string {
    "L_stack_top:\n    push rbp\n    mov rbp, rsp\n    sub rsp, 96\n    call silica_rt_tls_current_actor_get\n    test rdi, rdi\n    jz 1f\n    mov rax, QWORD PTR [rdi + 272]\n    test rax, rax\n    jz 1f\n    add rax, QWORD PTR [rdi + 280]\n    mov rdi, rax\n    jmp 2f\n1:\n    call pthread_self\n    mov rdi, rax\n    mov rsi, rsp\n    call pthread_getattr_np\n    mov rdi, rsp\n    lea rsi, [rsp + 64]\n    lea rdx, [rsp + 72]\n    call pthread_attr_getstack\n    mov rax, QWORD PTR [rsp + 64]\n    add rax, QWORD PTR [rsp + 72]\n    mov QWORD PTR [rsp + 80], rax\n    mov rdi, rsp\n    call pthread_attr_destroy\n    mov rdi, QWORD PTR [rsp + 80]\n2:\n    leave\n    ret\n"
}

// The three failure labels end the current actor with (:explicit, :region_alloc_failed / :buf_invalid /
// :buf_bounds) and abort the process (71) in main (design region_memory_safety_design.md H5 and Q9 (a),
// runtime entries in prims_actors_stack_asm); the access or allocation was never performed.
fn emit_region_helpers() -> string {
    aborts: string <- "L_region_overflow:\n    call silica_rt_region_alloc_failed\nL_buf_invalid:\n    call silica_rt_buf_invalid_failed\nL_buf_bounds:\n    call silica_rt_buf_bounds_failed\n";
    concat(aborts, concat(emit_region_grow_helper(), emit_region_contains_helper()))
}

fn emit_prim_op(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    case sir_term_root_node(term).name of {
        "alloc_region" -> case alloc_in_frame(term) of {
            // The lifetime witness (design §3.2): the allocating frame's X29, never dereferenced.
            true -> x86_isa@x86_mov(dest, "X29");
            false -> emit_alloc_region(dest)
        };
        "alloc_ref" -> emit_alloc_ref(term, dest);
        "alloc_rec" -> emit_alloc_rec(term, dest);
        "read_ref" -> emit_read_ref(dest);
        "write_ref" -> emit_write_ref(term, dest);
        "alloc_buf" -> emit_alloc_buf(term, dest);
        "buf_load" -> emit_buf_load(term, dest);
        "buf_store" -> emit_buf_store(term, dest, "");
        "read_buf" -> emit_buf_load(term, dest);
        "write_buf" -> emit_buf_store(term, dest, "");
        "fresh_lifetime" -> emit_fresh_lifetime(dest);
        "canonical_arena_lookup" -> emit_canonical_arena_lookup(dest);
        "canonical_arena_same" -> emit_canonical_arena_same(dest);
        "ref_eq" -> emit_ref_eq(dest);
        _: string -> concat(concat(".error \"unsupported memory prim: ", concat(sir_term_root_node(term).name, "\"\n")), "")
    }
}
