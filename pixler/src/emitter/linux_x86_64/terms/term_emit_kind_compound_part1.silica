export emit_kind_compound_part1/6;

fn join_alloc_stores_tail(alloc: string, stores: string, tail: string) -> string {
    concat(alloc, concat(stores, tail))
}

// The shape word of a record literal (record_shape): its build-wide number, stored in slot 0 of
// the record before the field stores, through the same addressing the fields use.
fn emit_record_shape_store(R: string, store_base: string, off: int64, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }) -> string {
    ld: string <- term_case_patterns@emit_shape_const("X9", atom_table@atom_lexeme_to_index(pools.table, record_shape@record_shape_lexeme(R)));
    concat(ld, concat("\n", concat(term_aggregate_helpers@agg_addr_prefix(store_base, off), concat(x86_mem@x86_str("X9", term_aggregate_helpers@tuple_flat_memref(store_base, off)), "\n"))))
}

fn emit_flat_tuple_stores(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, walk: { idx: int64, count: int64 }, sp_adjust: int64, byte_cursor: int64, store_base: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
    idx: int64 <- walk.idx;
    count: int64 <- walk.count;
    case idx < count - 1 and term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
        true -> {
            elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
            elem_is_agg: boolean <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and (term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" or term_sir_helpers@sir_term_root_node(elem).name == "record_make");
            type_prefix: string <- reg_conventions@reg_prefix_for_type(term_sir_helpers@sir_term_root_node(elem).type_name);
            elem_prefix: string <- case elem_is_agg of {
                true -> "X";
                false -> case type_prefix == "X" and term_sir_helpers@sir_term_root_node(elem).kind == 0 and term_user_call_abi@const_value_dot_implies_float64(term_sir_helpers@sir_term_root_node(elem).type_name, term_sir_helpers@sir_term_root_node(elem).value) of {
                    true -> "D";
                    false -> type_prefix
                }
            };
            temp_reg: string <- concat(elem_prefix, "9");
            elem_outer: string <- case elem_is_agg of { true -> term_reg_spill@hide_actor_sret(bound.outer_reg); false -> bound.outer_reg };
            elem_asm: string <- case bound.debug of {
                true -> { emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: elem_outer, debug: true }) };
                false -> emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: elem_outer, debug: false })
            };
            new_adjust: int64 <- sp_adjust;
            case elem_is_agg of {
                true -> {
                    store_offset: int64 <- idx * 8 + sp_adjust;
                    store_asm: string <- concat(term_aggregate_helpers@agg_addr_prefix(store_base, store_offset), x86_mem@x86_str(temp_reg, term_aggregate_helpers@tuple_flat_memref(store_base, store_offset)));
                    next_bc: int64 <- store_offset + 8;
                    rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), { idx: idx + 1, count: count }, sp_adjust, next_bc, store_base, bound, pools, emit_child);
                    concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
                };
                false -> {
                    store_asm: string <- concat(term_aggregate_helpers@agg_addr_prefix(store_base, byte_cursor), x86_mem@x86_str(temp_reg, term_aggregate_helpers@tuple_flat_memref(store_base, byte_cursor)));
                    rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), { idx: idx + 1, count: count }, new_adjust, byte_cursor + 8, store_base, bound, pools, emit_child);
                    concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
                }
            }
        };
        false -> {
            elem_is_agg: boolean <- term_sir_helpers@sir_term_root_node(term).kind == 6 and (term_sir_helpers@sir_term_root_node(term).name == "tuple_make" or term_sir_helpers@sir_term_root_node(term).name == "record_make");
            type_prefix2: string <- reg_conventions@reg_prefix_for_type(term_sir_helpers@sir_term_root_node(term).type_name);
            elem_prefix: string <- case elem_is_agg of {
                true -> "X";
                false -> case type_prefix2 == "X" and term_sir_helpers@sir_term_root_node(term).kind == 0 and term_user_call_abi@const_value_dot_implies_float64(term_sir_helpers@sir_term_root_node(term).type_name, term_sir_helpers@sir_term_root_node(term).value) of {
                    true -> "D";
                    false -> type_prefix2
                }
            };
            temp_reg: string <- concat(elem_prefix, "9");
            elem_outer: string <- case elem_is_agg of { true -> term_reg_spill@hide_actor_sret(bound.outer_reg); false -> bound.outer_reg };
            elem_asm: string <- case bound.debug of {
                true -> { emit_child(term,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: elem_outer, debug: true }) };
                false -> emit_child(term,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: elem_outer, debug: false })
            };
            case elem_is_agg of {
                true -> {
                    store_offset: int64 <- idx * 8 + sp_adjust;
                    store_asm: string <- concat(term_aggregate_helpers@agg_addr_prefix(store_base, store_offset), x86_mem@x86_str(temp_reg, term_aggregate_helpers@tuple_flat_memref(store_base, store_offset)));
                    concat(elem_asm, concat("\n", store_asm))
                };
                false -> {
                    store_asm: string <- concat(term_aggregate_helpers@agg_addr_prefix(store_base, byte_cursor), x86_mem@x86_str(temp_reg, term_aggregate_helpers@tuple_flat_memref(store_base, byte_cursor)));
                    concat(elem_asm, concat("\n", store_asm))
                }
            }
        }
    }
}



// -1 from offset_bytes_before_field is poison: adding it to the prefix would silently
// shift every field of the nested record. Keep it poison so it reaches tuple_flat_memref.
fn record_nested_prefix(field_prefix: int64, base_off: int64) -> int64 {
    case base_off < 0 of {
        true -> -1;
        false -> field_prefix + base_off
    }
}

fn emit_flat_record_stores(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, R: string, sp_adjust: int64, field_prefix: int64, store_base: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> "";
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind < 0 of {
            true -> {
                elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
                fname: string <- term_sir_helpers@sir_term_root_node(term).value;
                fty: string <- prims_record@find_field_type_in_record(R, fname);
                base_off: int64 <- prims_record@offset_bytes_before_field(R, fname);
                elem_is_agg: boolean <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and (term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" or term_sir_helpers@sir_term_root_node(elem).name == "record_make");
                // Inline EVERY nested record literal into the outer slab, whatever its fields hold. This is the
                // layout every reader already assumes: offset_bytes_before_field and
                // record_type_value_flat_byte_size both recurse into a nested record field unconditionally, so
                // a field after one is placed as if it were inlined. Storing a pointer instead put one word
                // where several were expected AND leaked a pointer to a stack copy that dies with the frame,
                // so reading `outer.nested.field` yielded the nested record's address.
                // type_checker_core:parse_type_into_context returns
                //     { context: { env: ctx.env, interner: pr.interner }, id: pr.id, ok: pr.ok }
                // whose `context` holds a List and a record, so create_type_context handed that address to
                // prepend as a list handle -- the fault that stopped type checking.
                //
                // This is only affordable because strip_spaces_rt no longer rebuilds an already-stripped
                // string: placing fields this way asks for record_type_starts and flat sizes far more often,
                // and with the old quadratic strip the seed was OOM-killed emitting
                // parser/constraint_extract_expr.silica. That unit now costs the same 40s it did before.
                //
                // A tuple literal in field position is built the way emit_flat_tuple_stores builds a nested
                // aggregate: built in its own frame region (chunk 15: no promote copy), and its pointer stored in the field's slot
                // (the slot is the pointer word; the shell keeps the inline reservation the readers expect).
                // It used to be stored inline for exactly two elements -- the reader then took the first element
                // as the tuple pointer -- and left in the frame for more, where the record base was off by the
                // nested slab. See trials/tuples_addition/decompose_record_tuple_field and record_tuple_field_*.
                // Records only: tuples keep a uniform 8-byte stride with boxed pointers, which is what
                // the lexer's Token*/Lexer* returns need (see the rec_flat note in emit_flat_tuple_stores).
                // See trials/codegen_regressions/rec_nested_nonscalar.silica.
                // Boxed layout (prims_record header, 2026-09-18): a nested record literal is no longer
                // spliced into the outer slab. It takes the same path as a tuple literal -- its own
                // frame region, pointer in the field's 8-byte slot -- so a record built here
                // and one built by a generic unit (one word per ItemType field) have the same shape.
                // The runtime-laid-out records (prims_record@record_type_keeps_inline_layout) keep splicing
                // a nested record literal inline.
                inline_nested_rec: boolean <- elem_is_agg and term_sir_helpers@sir_term_root_node(elem).name == "record_make" and prims_record@record_type_keeps_inline_layout(R);
                case inline_nested_rec of {
                    true -> concat(emit_record_shape_store(fty, store_base, record_nested_prefix(field_prefix, base_off) + sp_adjust, pools), emit_flat_record_stores(elem, fty, sp_adjust, record_nested_prefix(field_prefix, base_off), store_base, bound, pools, emit_child));
                    false -> {
                        type_prefix: string <- reg_conventions@reg_prefix_for_type(fty);
                        elem_prefix: string <- case elem_is_agg of {
                            true -> "X";
                            false -> case type_prefix == "X" and term_sir_helpers@sir_term_root_node(elem).kind == 0 and term_user_call_abi@const_value_dot_implies_float64(term_sir_helpers@sir_term_root_node(elem).type_name, term_sir_helpers@sir_term_root_node(elem).value) of {
                                true -> "D";
                                false -> type_prefix
                            }
                        };
                        temp_reg: string <- concat(elem_prefix, "9");
                        elem_asm: string <- case bound.debug of {
                            true -> { emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                            false -> emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                        };
                        new_adjust: int64 <- sp_adjust;
                        store_offset: int64 <- term_record_layout@record_store_offset_for_field(R, fname, field_prefix, base_off, new_adjust);
                        copy_inline_struct_field: boolean <- term_aggregate_helpers@record_field_inline_pointer_value(elem, fty, R);
                        store_asm: string <- case copy_inline_struct_field of {
                            true -> term_aggregate_helpers@emit_inline_record_field_copy_words(temp_reg, store_base, store_offset, 0, prims_record@record_type_value_flat_byte_size(fty) / 8);
                            false -> concat(term_aggregate_helpers@agg_addr_prefix(store_base, store_offset), x86_mem@x86_str(temp_reg, term_aggregate_helpers@tuple_flat_memref(store_base, store_offset)))
                        };
                        concat(elem_asm, concat("\n", store_asm))
                    }
                }
            };
            false -> {
                elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
                fname: string <- term_sir_helpers@sir_term_root_node(term).value;
                fty: string <- prims_record@find_field_type_in_record(R, fname);
                base_off: int64 <- prims_record@offset_bytes_before_field(R, fname);
                elem_is_agg: boolean <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and (term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" or term_sir_helpers@sir_term_root_node(elem).name == "record_make");
                // Inline EVERY nested record literal into the outer slab, whatever its fields hold. This is the
                // layout every reader already assumes: offset_bytes_before_field and
                // record_type_value_flat_byte_size both recurse into a nested record field unconditionally, so
                // a field after one is placed as if it were inlined. Storing a pointer instead put one word
                // where several were expected AND leaked a pointer to a stack copy that dies with the frame,
                // so reading `outer.nested.field` yielded the nested record's address.
                // type_checker_core:parse_type_into_context returns
                //     { context: { env: ctx.env, interner: pr.interner }, id: pr.id, ok: pr.ok }
                // whose `context` holds a List and a record, so create_type_context handed that address to
                // prepend as a list handle -- the fault that stopped type checking.
                //
                // This is only affordable because strip_spaces_rt no longer rebuilds an already-stripped
                // string: placing fields this way asks for record_type_starts and flat sizes far more often,
                // and with the old quadratic strip the seed was OOM-killed emitting
                // parser/constraint_extract_expr.silica. That unit now costs the same 40s it did before.
                //
                // A tuple literal in field position is built the way emit_flat_tuple_stores builds a nested
                // aggregate: built in its own frame region (chunk 15: no promote copy), and its pointer stored in the field's slot
                // (the slot is the pointer word; the shell keeps the inline reservation the readers expect).
                // It used to be stored inline for exactly two elements -- the reader then took the first element
                // as the tuple pointer -- and left in the frame for more, where the record base was off by the
                // nested slab. See trials/tuples_addition/decompose_record_tuple_field and record_tuple_field_*.
                // Records only: tuples keep a uniform 8-byte stride with boxed pointers, which is what
                // the lexer's Token*/Lexer* returns need (see the rec_flat note in emit_flat_tuple_stores).
                // See trials/codegen_regressions/rec_nested_nonscalar.silica.
                // Boxed layout (prims_record header, 2026-09-18): a nested record literal is no longer
                // spliced into the outer slab. It takes the same path as a tuple literal -- its own
                // frame region, pointer in the field's 8-byte slot -- so a record built here
                // and one built by a generic unit (one word per ItemType field) have the same shape.
                // The runtime-laid-out records (prims_record@record_type_keeps_inline_layout) keep splicing
                // a nested record literal inline.
                inline_nested_rec: boolean <- elem_is_agg and term_sir_helpers@sir_term_root_node(elem).name == "record_make" and prims_record@record_type_keeps_inline_layout(R);
                case inline_nested_rec of {
                    true -> {
                        inner_asm: string <- concat(emit_record_shape_store(fty, store_base, record_nested_prefix(field_prefix, base_off) + sp_adjust, pools), emit_flat_record_stores(elem, fty, sp_adjust, record_nested_prefix(field_prefix, base_off), store_base, bound, pools, emit_child));
                        rest_asm: string <- emit_flat_record_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), R, sp_adjust, field_prefix, store_base, bound, pools, emit_child);
                        concat(concat(inner_asm, "\n"), rest_asm)
                    };
                    false -> {
                        type_prefix: string <- reg_conventions@reg_prefix_for_type(fty);
                        elem_prefix: string <- case elem_is_agg of {
                            true -> "X";
                            false -> case type_prefix == "X" and term_sir_helpers@sir_term_root_node(elem).kind == 0 and term_user_call_abi@const_value_dot_implies_float64(term_sir_helpers@sir_term_root_node(elem).type_name, term_sir_helpers@sir_term_root_node(elem).value) of {
                                true -> "D";
                                false -> type_prefix
                            }
                        };
                        temp_reg: string <- concat(elem_prefix, "9");
                        elem_asm: string <- case bound.debug of {
                            true -> { emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                            false -> emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                        };
                        new_adjust: int64 <- sp_adjust;
                        store_offset: int64 <- term_record_layout@record_store_offset_for_field(R, fname, field_prefix, base_off, new_adjust);
                        copy_inline_struct_field: boolean <- term_aggregate_helpers@record_field_inline_pointer_value(elem, fty, R);
                        store_asm: string <- case copy_inline_struct_field of {
                            true -> term_aggregate_helpers@emit_inline_record_field_copy_words(temp_reg, store_base, store_offset, 0, prims_record@record_type_value_flat_byte_size(fty) / 8);
                            false -> concat(term_aggregate_helpers@agg_addr_prefix(store_base, store_offset), x86_mem@x86_str(temp_reg, term_aggregate_helpers@tuple_flat_memref(store_base, store_offset)))
                        };
                        rest_asm: string <- emit_flat_record_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), R, new_adjust, field_prefix, store_base, bound, pools, emit_child);
                        concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
                    }
                }
            }
        }
    }
}


fn emit_tuple_make_stack(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
    count: int64 <- prims_tuple@count_flat_elements(term);
    sret_base: string <- var@find_sp_binding(bound.outer_reg, "_tuple_sret");
    outer_flat_bytes_tm: int64 <- term_aggregate_helpers@tuple_make_rec_flat_outer_alloc_bytes(term, count);
    // Aggregate regions live in the fixed frame, not on a moved SP. The region base
    // is a frame memref; tuple_flat_memref_at renders element k as X29-(base-k), so
    // the address survives any call and needs no displacement correction. Recording the
    // region in outer_reg makes a nested make pick a deeper, non-overlapping one.
    region_tm: string <- case length_bytes(sret_base) > 0 of {
        true -> "";
        false -> term_reg_spill@frame_region_for(term, bound.outer_reg)
    };
    // Chunk 15 phase 2: in a TCO loop that keeps its dynamic part (`_dynagg`, emitter_core) a make is
    // built in a block of the dynamic part, its address kept in the make's frame slot: the slot is
    // reused by the next iteration, the block is not, and a value can reach the next iteration only
    // through the loop's (pointer) parameters.
    dyn_tm: boolean <- length_bytes(sret_base) == 0 and length_bytes(var@find_sp_binding(bound.outer_reg, "_dynagg")) > 0;
    store_base_tm: string <- case length_bytes(sret_base) > 0 of {
        true -> sret_base;
        false -> case dyn_tm of {
            true -> concat("*", region_tm);
            false -> region_tm
        }
    };
    region_base_tm: int64 <- var@parse_x29_neg_offset_bytes(region_tm);
    alloc_asm: string <- case dyn_tm of {
        true -> term_aggregate_helpers@agg_dyn_block_asm(region_tm, term_reg_spill@frame_region_bytes(term));
        false -> ""
    };
    nested_raw: int64 <- term_aggregate_helpers@flat_tuple_nested_alloc(term, count, 0);
    // Value-flat tuple head (record_make, …): fields sit at the innermost SP after nested SUBs.
    // flat_tuple_nested_alloc counts nested bytes for ADD SP — that points past the payload; heap
    // promote then copied garbage (supervisor init / e4a).
    rec_flat_tuple: boolean <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" and count >= 2;
    nested_adjust: int64 <- case rec_flat_tuple of {
        true -> 0;
        false -> nested_raw
    };
    dest_ptr: string <- case length_bytes(dest) > 0 and substring(dest, 0, 1) == "W" of {
        true -> concat("X", substring(dest, 1, length_bytes(dest)));
        false -> dest
    };
    mov_asm: string <- case dest == "SP" of {
        true -> "";
        false -> case length_bytes(sret_base) > 0 of {
            true -> case nested_adjust == 0 of {
                true -> x86_isa@x86_mov(dest_ptr, sret_base);
                false -> x86_isa@x86_add(dest_ptr, sret_base, concat("#", atom_table@int64_to_decimal_string(nested_adjust)))
            };
            false -> case dyn_tm of {
                true -> term_aggregate_helpers@agg_dyn_load(dest_ptr, region_tm, 0);
                false -> term_aggregate_helpers@emit_sub_from_fp(dest_ptr, region_base_tm)
            }
        }
    };
    join_alloc_stores_tail(alloc_asm, emit_flat_tuple_stores(term, { idx: 0, count: count }, 0, 0, store_base_tm, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug }, pools, emit_child), concat("\n", mov_asm))
}

fn emit_kind_compound_part1(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
case term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
    true -> emit_tuple_make_stack(term, dest, bound, pools, emit_child);
    false -> case term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
    true -> {
                                count_r: int64 <- prims_record@count_record_fields(term_sir_helpers@sir_term_root_node(term).type_name);
                                Rm: string <- term_sir_helpers@sir_term_root_node(term).type_name;
                            // Outer SUB = shell + user-call padding reserved in this frame. Nested record_make/tuple_make
                            // self-SUB (exclude them — structs_addition/04); user-call returns are memcpy'd in
                            // (include them — wbt from_sorted_err). flat_record_total_alloc stays for dealloc/nested_adjust.
                            alloc_sz_r: int64 <- term_record_layout@record_make_stack_alloc_size(Rm) + term_aggregate_helpers@flat_record_sum_nested_reserved_in_outer(term);
                            // Ignore |_tuple_sret for record_make: always SUB SP + SP-relative stores. Tuple path may use X8
                            // safely when the make has no prior BL; record_make often follows region_alloc / other BL.
                            sret_base_r: string <- "";
                            // Frame region, not a moved SP -- see emit_tuple_make_stack.
                            region_r: string <- term_reg_spill@frame_region_for(term, bound.outer_reg);
                            region_base_r: int64 <- var@parse_x29_neg_offset_bytes(region_r);
                            // A `_dynagg` record is built in a dynamic-part block (see emit_tuple_make_stack).
                            dyn_r: boolean <- length_bytes(var@find_sp_binding(bound.outer_reg, "_dynagg")) > 0;
                            store_base_r: string <- case dyn_r of {
                                true -> concat("*", region_r);
                                false -> region_r
                            };
                            alloc_asm_r: string <- case dyn_r of {
                                true -> term_aggregate_helpers@agg_dyn_block_asm(region_r, term_reg_spill@frame_region_bytes(term));
                                false -> ""
                            };
                            // Stores start already shifted past the reserved user-call area, because the shell sits ABOVE
                            // it: nested_adjust_r below places the returned base at SP + reserved + self-SUB'd makes.
                            // sp_adjust only tracks SP actually moving, which a memcpy'd user-call return never does, so
                            // starting at 0 shifted a field only from the reserving field onwards. Fields emitted EARLIER
                            // then landed below the shell base and the shell's own slot was never written, so reading the
                            // field back returned whatever the preceding call left on the stack. That is what fed the
                            // slots list into `declarations` in constraint_extract_decls:slots_to_program,
                            //     { declarations: decls, location: program_location_from_decls(decls) }
                            // whose declarations were later walked as if they were declarations. See
                            // trials/codegen_regressions/rec_call_field.silica.
                            hidden_child_tramp_r: string <- term_child_spec@emit_child_spec_hidden_trampoline_store(term, Rm, store_base_r);
                            nested_adjust_r: int64 <- term_aggregate_helpers@flat_record_sum_nested_inners(term);
                            dest_ptr_r: string <- case length_bytes(dest) > 0 and substring(dest, 0, 1) == "W" of {
                                true -> concat("X", substring(dest, 1, length_bytes(dest)));
                                false -> dest
                            };
                            mov_asm_r: string <- case dest == "SP" of {
                                true -> "";
                                false -> case length_bytes(sret_base_r) > 0 of {
                                    true -> case nested_adjust_r == 0 of {
                                        true -> x86_isa@x86_mov(dest_ptr_r, sret_base_r);
                                        false -> x86_isa@x86_add(dest_ptr_r, sret_base_r, concat("#", atom_table@int64_to_decimal_string(nested_adjust_r)))
                                    };
                                    // nested_adjust_r is an offset WITHIN the region (the record shell sits
                                    // above the reserved user-call area), not SP compensation -- the fields
                                    // are stored at region_base_r - nested_adjust_r upward, so the returned
                                    // pointer must start there too.
                                    false -> case dyn_r of {
                                        true -> term_aggregate_helpers@agg_dyn_load(dest_ptr_r, region_r, nested_adjust_r);
                                        false -> term_aggregate_helpers@emit_sub_from_fp(dest_ptr_r, region_base_r - nested_adjust_r)
                                    }
                                }
                            };
                            stores_asm_r: string <- case length_bytes(hidden_child_tramp_r) > 0 of {
                                true -> concat("\n", hidden_child_tramp_r);
                                false -> ""
                            };
                            shape_asm_r: string <- emit_record_shape_store(Rm, store_base_r, term_record_layout@record_shape_store_offset(Rm, 0, term_aggregate_helpers@flat_record_sum_nested_reserved_in_outer(term)), pools);
                            join_alloc_stores_tail(alloc_asm_r, concat(shape_asm_r, emit_flat_record_stores(term, Rm, term_aggregate_helpers@flat_record_sum_nested_reserved_in_outer(term), 0, store_base_r, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug }, pools, emit_child)), concat(stores_asm_r, concat("\n", mov_asm_r)))
                        };
    false -> case term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
    true -> {
                            rp_var: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name; false -> "" };
                            // The chain may bottom out in a value rather than a variable (`slots.head.token.kind`
                            // roots at a list_head prim, kind 6). Evaluate that base into X0 instead of falling
                            // through to the variable path, which finds no slot and loads [SP, #0].
                            call_inner_rp: boolean <- term_aggregate_helpers@record_proj_chain_base_is_value(term);
                            rp_base_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_aggregate_helpers@record_proj_chain_base_term(term);
                            // Boxed layout: `v.inner.x` projects `v.inner` (a pointer word) as the base value.
                            // Load that link into X12 and address through it, not through X0 or X11: a
                            // variable-rooted chain used to be a single LDR off the variable, X0 may still hold
                            // a live first parameter here, and X11 is the copy of an X0-bound record that later
                            // projections of the same variable address through (see base_rp_was_x0 below), so
                            // `s.end.x - s.start.x` read s.start out of s.end.
                            base_in_link_reg_rp: boolean <- call_inner_rp and term_sir_helpers@sir_term_root_node(rp_base_term).kind == 6 and term_sir_helpers@sir_term_root_node(rp_base_term).name == "record_proj";
                            rp_base_dest: string <- case base_in_link_reg_rp of { true -> "X12"; false -> "X0" };
                            call_inner_asm_rp: string <- case call_inner_rp of {
                                true -> case bound.debug of {
                                    true -> { emit_child(rp_base_term,  rp_base_dest, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                    false -> emit_child(rp_base_term,  rp_base_dest, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                false -> ""
                            };
                            chain_root: string <- term_aggregate_helpers@record_proj_chain_root_var_name(term);
                            rp_var_use: string <- case length_bytes(chain_root) > 0 of {
                                true -> chain_root;
                                false -> rp_var
                            };
                            va_key_rp: string <- concat("_va.", rp_var_use);
                            va_str_rp: string <- case length_bytes(rp_var_use) > 0 of { true -> var@find_sp_binding(bound.outer_reg, va_key_rp); false -> "" };
                            // Last, not first: a tuple destructuring registers the element's slab offset and then
                            // the register it was actually loaded into, so outer_reg holds `%r=[SP, #8]|%r=X21`.
                            // The offset points into a slab the callee already promoted to the heap and popped,
                            // so taking the first binding loads garbage. Variable loads and calls resolve the
                            // innermost binding for the same reason (see var@find_sp_binding_bare_or_percent_param).
                            var_binding_rp: string <- case length_bytes(rp_var_use) > 0 of { true -> var@find_reg_pref_binding(bound.outer_reg, rp_var_use); false -> "" };
                            saved_ptr_reg_rp: string <- case length_bytes(rp_var_use) > 0 of { true -> var@find_last_sp_binding(bound.outer_reg, concat("_ptr.", rp_var_use)); false -> "" };
                            tuple_in_reg_rp: boolean <- length_bytes(var_binding_rp) > 0 and var@is_memory_ref(var_binding_rp) == false;
                            // Spill slots arrive as bound_reg=[X29,#-N] before (or instead of) outer_reg sp bindings.
                            // Never feed a memory ref into reg_offset_for_byte — that yields LDR X0, [[X29,#-N], #0].
                            bound_mem_rp: boolean <- rp_var_use == bound.bound_name and length_bytes(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg);
                            saved_ptr_mem_rp: boolean <- length_bytes(saved_ptr_reg_rp) > 0 and var@is_memory_ref(saved_ptr_reg_rp);
                            mem_ref_src_rp: string <- case length_bytes(var_binding_rp) > 0 and var@is_memory_ref(var_binding_rp) of {
                                true -> var_binding_rp;
                                false -> case bound_mem_rp of {
                                    true -> bound.bound_reg;
                                    false -> case saved_ptr_mem_rp of { true -> saved_ptr_reg_rp; false -> "" }
                                }
                            };
                            mem_ref_binding_rp: boolean <- length_bytes(mem_ref_src_rp) > 0;
                            mem_ref_load_rp: string <- case mem_ref_binding_rp of {
                                true -> concat(var@emit_ldr_mem_ref("X11", mem_ref_src_rp), "\n");
                                false -> ""
                            };
                            tuple_base_reg_raw_rp: string <- case call_inner_rp of {
                                true -> rp_base_dest;
                                false -> case mem_ref_binding_rp of {
                                    true -> "X11";
                                    false -> case rp_var_use == bound.bound_name and length_bytes(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg) == false of {
                                        true -> bound.bound_reg;
                                        false -> case length_bytes(saved_ptr_reg_rp) > 0 and var@is_memory_ref(saved_ptr_reg_rp) == false of {
                                            true -> saved_ptr_reg_rp;
                                            false -> case tuple_in_reg_rp of {
                                                true -> var_binding_rp;
                                                false -> ""
                                            }
                                        }
                                    }
                                }
                            };
                            reg_base_for_va_rp: boolean <- length_bytes(tuple_base_reg_raw_rp) > 0 and substring(tuple_base_reg_raw_rp, 0, 1) == "X";
                            tuple_base_reg_rp: string <- case length_bytes(va_str_rp) > 0 of {
                                true -> case reg_base_for_va_rp of {
                                    true -> tuple_base_reg_raw_rp;
                                    false -> ""
                                };
                                false -> tuple_base_reg_raw_rp
                            };
                            // Remap X0 -> X11 for LDR addressing when binding still says X0 (call returned pointer in X0).
                            // If %v is already bound to X11, do not MOV X11, X0 — X0 may hold an unrelated value.
                            // When base is X0: MOV X11, X0 only for the first field (byte offset 0). Later fields use
                            // [X11, #off] — X11 still holds the struct after that first load; a second MOV from X0 would
                            // copy a stale value (e.g. list_length result) after X0 was clobbered.
                            base_rp_was_x0: boolean <- length_bytes(tuple_base_reg_rp) > 0 and tuple_base_reg_rp == "X0";
                            effective_base_rp: string <- case base_rp_was_x0 of { true -> "X11"; false -> tuple_base_reg_rp };
                            byte_off: int64 <- term_aggregate_helpers@record_proj_chain_byte_offset(term);
                            // _va now names the aggregate's frame region ("[X29, #-32]") when the
                            // aggregate was built by a make. A region base is absolute, so it is NOT
                            // a region base is absolute -- no SP movement left to correct for.
                            va_fb_rp: int64 <- var@parse_x29_neg_offset_bytes(va_str_rp);
                            va_adj_rp: int64 <- case length_bytes(va_str_rp) > 0 and va_fb_rp < 0 of {
                                true -> string_parse@string_to_int64(va_str_rp);
                                false -> 0
                            };
                            proj_mem_ref_rp: string <- case length_bytes(tuple_base_reg_rp) > 0 of {
                                true -> var@reg_offset_for_byte(effective_base_rp, byte_off + va_adj_rp);
                                false -> case va_fb_rp > 0 of {
                                    true -> term_aggregate_helpers@tuple_flat_memref_at(va_str_rp, byte_off);
                                    false -> {
                                    // _va now names the aggregate region; no displacement term is added.
                                    var@sp_offset_for_byte(byte_off)
                                    }
                                }
                            };
                            proj_prefix_rp: string <- prims_tuple@ldr_prefix_for_type(term_sir_helpers@sir_term_root_node(term).type_name);
                            proj_dest_num_rp: string <- case length_bytes(dest) > 0 of { true -> substring(dest, 1, length_bytes(dest)); false -> "0" };
                            proj_ldr_reg_rp: string <- concat(proj_prefix_rp, proj_dest_num_rp);
                            preserve_base_rp: string <- case call_inner_rp of {
                                true -> case base_in_link_reg_rp of { true -> "\n"; false -> x86_isa@x86_mov("X11", "X0") };
                                false -> case base_rp_was_x0 of {
                                    true -> case byte_off == 0 of {
                                        true -> x86_isa@x86_mov("X11", "X0");
                                        false -> ""
                                    };
                                    false -> ""
                                }
                            };
                            root_rec_ty: string <- term_aggregate_helpers@record_proj_root_record_type(term);
                            root_rec_stripped: string <- prims_record@strip_spaces_rt(root_rec_ty);
                            // Boxed layout: a record-typed field is a pointer and is LOADED like any other
                            // word. Only the supervisor reply record (laid out by the actor runtime with
                            // child_info spliced inline) still yields the address of an embedded substruct.
                            use_add_for_embedded_substruct: boolean <- length_bytes(root_rec_stripped) > 0 and prims_record@record_type_starts(root_rec_stripped) and reg_conventions@is_inline_struct_type(term_sir_helpers@sir_term_root_node(term).type_name) and prims_record@record_type_keeps_inline_layout(root_rec_stripped);
                            // Supervisor reply get_child path stores the live child_ref in top-level `child`.
                            // Accesses written as `reply.child_info.child` should resolve to that same live ref.
                            supervisor_child_info_child_chain: boolean <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj"
                                and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).value == "child_info" and term_sir_helpers@sir_term_root_node(term).value == "child"
                                and term_child_spec@is_supervisor_reply_record_type(root_rec_ty);
                            eff_byte_off: int64 <- case supervisor_child_info_child_chain of {
                                true -> prims_record@offset_bytes_before_field(root_rec_ty, "child");
                                false -> byte_off
                            };
                            add_imm_rp: int64 <- eff_byte_off + va_adj_rp;
                            add_imm_s_rp: string <- atom_table@int64_to_decimal_string(add_imm_rp);
                            proj_asm_rp: string <- case use_add_for_embedded_substruct of {
                                true -> concat(preserve_base_rp, x86_isa@x86_add(proj_ldr_reg_rp, effective_base_rp, concat("#", add_imm_s_rp)));
                                false -> concat(preserve_base_rp, x86_mem@x86_ldr(proj_ldr_reg_rp, case length_bytes(tuple_base_reg_rp) > 0 of {
                                    true -> var@reg_offset_for_byte(effective_base_rp, add_imm_rp);
                                    false -> {
                                        var@sp_offset_for_byte(eff_byte_off)
                                    }
                                }))
                            };
                            concat(concat(call_inner_asm_rp, mem_ref_load_rp), proj_asm_rp)
                        };
    false -> case term_sir_helpers@sir_term_root_node(term).name == "tuple_proj" of {
    true -> {
                            tp_var: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name; false -> "" };
                            va_key: string <- concat("_va.", tp_var);
                            va_str: string <- case length_bytes(tp_var) > 0 of { true -> var@find_sp_binding(bound.outer_reg, va_key); false -> "" };
                            // Last, not first, for the same reason as the _ptr lookup below and as record_proj:
                            // every tuple destructure names its root %_td_0, so two destructures in one scope leave
                            // bound.outer_reg holding `%_td_0=X19|...|%_td_0=X23`. Taking the first match read fields
                            // out of the earlier tuple's pointer -- field 0 happened to be right only because it
                            // resolves through bound.bound_reg instead, which is why the wrong base showed up from
                            // field 1 onwards.
                            var_binding: string <- case length_bytes(tp_var) > 0 of { true -> var@find_reg_pref_binding(bound.outer_reg, tp_var); false -> "" };
                            // Look up the saved tuple pointer using find_last_sp_binding to get the INNERMOST binding.
                            // When nested tuple decompositions reuse the same root variable (e.g. %_td_0 for both
                            // outer and inner destructuring), bound.outer_reg accumulates multiple _ptr.%_td_0=... entries.
                            // find_last_sp_binding returns the last (most recently added, innermost) occurrence,
                            // which is the correct register for the current scope rather than a stale outer binding.
                            saved_ptr_reg: string <- case length_bytes(tp_var) > 0 of { true -> var@find_last_sp_binding(bound.outer_reg, concat("_ptr.", tp_var)); false -> "" };
                            tuple_in_reg: boolean <- length_bytes(var_binding) > 0 and var@is_memory_ref(var_binding) == false;
                            bound_mem_tp: boolean <- tp_var == bound.bound_name and length_bytes(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg);
                            saved_ptr_mem_tp: boolean <- length_bytes(saved_ptr_reg) > 0 and var@is_memory_ref(saved_ptr_reg);
                            mem_ref_src_tp: string <- case length_bytes(var_binding) > 0 and var@is_memory_ref(var_binding) of {
                                true -> var_binding;
                                false -> case bound_mem_tp of {
                                    true -> bound.bound_reg;
                                    false -> case saved_ptr_mem_tp of { true -> saved_ptr_reg; false -> "" }
                                }
                            };
                            mem_ref_load_tp: string <- case length_bytes(mem_ref_src_tp) > 0 of {
                                true -> concat(var@emit_ldr_mem_ref("X11", mem_ref_src_tp), "\n");
                                false -> ""
                            };
                            // Priority: real register bindings only. Spill slots load into X11 first (never
                            // pass [X29,#-N] to reg_offset_for_byte).
                            tuple_base_reg_raw: string <- case length_bytes(mem_ref_src_tp) > 0 of {
                                true -> "X11";
                                false -> case tp_var == bound.bound_name and length_bytes(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg) == false of {
                                    true -> bound.bound_reg;
                                    false -> case length_bytes(saved_ptr_reg) > 0 and var@is_memory_ref(saved_ptr_reg) == false of {
                                        true -> saved_ptr_reg;
                                        false -> case tuple_in_reg of {
                                            true -> var_binding;
                                            false -> ""
                                        }
                                    }
                                }
                            };
                            // RA: address a value THROUGH ITS BINDING, not through a remembered
                            // stack location. This previously discarded the register base whenever a
                            // _va stack offset existed, so a projection read the aggregate's old slot
                            // -- which is wrong the moment that slot is released or SP moves. In
                            // decompose_nested_bare the inner tuple is heap-promoted and its pointer
                            // lives in a register, yet the fields were read from the freed stack slot
                            // at [SP, #-16]. The register binding is the value's home; the _va offset
                            // is only a fallback for when there is no register.
                            // Mirrors the _rp block above: use the raw base only when it is a
                            // REGISTER. Previously this discarded the register base outright whenever a
                            // _va stack offset existed, so a projection read the aggregate's old slot --
                            // wrong the moment that slot is released or SP moves.
                            reg_base_for_va: boolean <- length_bytes(tuple_base_reg_raw) > 0 and substring(tuple_base_reg_raw, 0, 1) == "X";
                            tuple_base_reg: string <- case length_bytes(va_str) > 0 of {
                                true -> case reg_base_for_va of {
                                    true -> tuple_base_reg_raw;
                                    false -> ""
                                };
                                false -> tuple_base_reg_raw
                            };
                            base_was_x0: boolean <- length_bytes(tuple_base_reg) > 0 and tuple_base_reg == "X0";
                            effective_base: string <- case base_was_x0 of { true -> "X11"; false -> tuple_base_reg };
                            proj_index: int64 <- string_parse@string_to_int64(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).value);
                            proj_byte_off: int64 <- prims_tuple@tuple_field_start_byte_offset(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name, proj_index);
                            // Flat tuple layout uses tuple_field_start_byte_offset for every tuple (aggregates are not all 8 bytes wide).
                            proj_mem_ref: string <- case length_bytes(tuple_base_reg) > 0 of {
                                true -> var@reg_offset_for_byte(effective_base, proj_byte_off);
                                false -> {
                                    // _va names the aggregate's fixed-frame region. Regions are absolute, so
                                    // nothing is added for SP movement -- see frame_region_for.
                                    va_only: int64 <- case length_bytes(va_str) > 0 and var@parse_x29_neg_offset_bytes(va_str) < 0 of {
                                        true -> string_parse@string_to_int64(va_str);
                                        false -> 0
                                    };
                                    // A frame region is absolute: address it directly, it needs no displacement term.
                                    case var@parse_x29_neg_offset_bytes(va_str) > 0 of {
                                        true -> term_aggregate_helpers@tuple_flat_memref_at(va_str, proj_byte_off);
                                        false -> var@sp_offset_for_byte(proj_byte_off)
                                    }
                                }
                            };
                            proj_prefix: string <- prims_tuple@ldr_prefix_for_type(term_sir_helpers@sir_term_root_node(term).type_name);
                            proj_dest_num: string <- case length_bytes(dest) > 0 of { true -> substring(dest, 1, length_bytes(dest)); false -> "0" };
                            proj_ldr_reg: string <- concat(proj_prefix, proj_dest_num);
                            // Same X0/X11 discipline as record_proj: only index 0 copies X0→X11; later indices use [X11,#off].
                            preserve_base: string <- case base_was_x0 of {
                                true -> case proj_index == 0 of {
                                    true -> x86_isa@x86_mov("X11", "X0");
                                    false -> ""
                                };
                                false -> ""
                            };
                            proj_body_tp: string <- concat(preserve_base, x86_mem@x86_ldr(proj_ldr_reg, proj_mem_ref));
                            concat(mem_ref_load_tp, proj_body_tp)
                        };
    false -> term_emit_kind_compound_part2@emit_kind_compound_part2(term, dest, bound, table, pools, emit_child)
}
}
}
}
}
