// int64/int32/uint64/uint32 comparison prim emission: lt, gt, le, ge, eq, ne
// sir_emitter_pattern_spec §7.2: CMP r1, r2; CSET dest, cond
// Signed: LT, GT, LE, GE. Unsigned: LO, HI, LS, HS. eq/ne same for both.
// Operands in r1, r2. reg_prefix: "X" (int64/uint64) or "W" (int32/uint32/etc).

use sir_ast;

export emit_lt_op/2;
export emit_gt_op/2;
export emit_le_op/2;
export emit_ge_op/2;
export emit_eq_op/2;
export emit_ne_op/2;
export emit_ult_op/2;
export emit_ugt_op/2;
export emit_ule_op/2;
export emit_uge_op/2;
export emit_fcmp_lt_op/2;
export emit_fcmp_gt_op/2;
export emit_fcmp_le_op/2;
export emit_fcmp_ge_op/2;
export emit_fcmp_eq_op/2;
export emit_fcmp_ne_op/2;

fn emit_compare_op(dest: string, cond: string, reg_prefix: string) -> string {
    r1: string <- concat(reg_prefix, "9");
    r2: string <- concat(reg_prefix, "10");
    cmp_line: string <- concat(concat(concat(concat("    CMP ", r1), ", "), r2), "");
    cset_line: string <- concat(concat(concat(concat("    CSET ", dest), ", "), cond), "");
    concat(concat(cmp_line, "\n"), cset_line)
}

fn emit_lt_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "LT", reg_prefix)
}

fn emit_gt_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "GT", reg_prefix)
}

fn emit_le_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "LE", reg_prefix)
}

fn emit_ge_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "GE", reg_prefix)
}

fn emit_eq_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "EQ", reg_prefix)
}

fn emit_ne_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "NE", reg_prefix)
}

fn emit_ult_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "LO", reg_prefix)
}

fn emit_ugt_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "HI", reg_prefix)
}

fn emit_ule_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "LS", reg_prefix)
}

fn emit_uge_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "HS", reg_prefix)
}

// FCMP sets flags; CSET writes 0/1 to a GPR. H/S/D are invalid CSET destinations (clang: invalid operand).
fn gpr_for_fcmp_bool_dest(dest: string) -> string {
    case length_bytes(dest) > 0 of {
        false -> dest;
        true -> case substring(dest, 0, 1) of {
            "H" -> concat("W", substring(dest, 1, length_bytes(dest)));
            "S" -> concat("W", substring(dest, 1, length_bytes(dest)));
            "D" -> concat("W", substring(dest, 1, length_bytes(dest)));
            _: string -> dest
        }
    }
}

fn emit_fcmp_op(dest: string, cond: string, float_prefix: string) -> string {
    r1: string <- concat(float_prefix, "1");
    r2: string <- concat(float_prefix, "2");
    fcmp_line: string <- concat(concat(concat(concat("    FCMP ", r1), ", "), r2), "");
    bool_dest: string <- gpr_for_fcmp_bool_dest(dest);
    cset_line: string <- concat(concat(concat(concat("    CSET ", bool_dest), ", "), cond), "");
    concat(concat(fcmp_line, "\n"), cset_line)
}

fn emit_fcmp_lt_op(dest: string, float_prefix: string) -> string {
    emit_fcmp_op(dest, "LT", float_prefix)
}

fn emit_fcmp_gt_op(dest: string, float_prefix: string) -> string {
    emit_fcmp_op(dest, "GT", float_prefix)
}

fn emit_fcmp_le_op(dest: string, float_prefix: string) -> string {
    emit_fcmp_op(dest, "LE", float_prefix)
}

fn emit_fcmp_ge_op(dest: string, float_prefix: string) -> string {
    emit_fcmp_op(dest, "GE", float_prefix)
}

fn emit_fcmp_eq_op(dest: string, float_prefix: string) -> string {
    emit_fcmp_op(dest, "EQ", float_prefix)
}

fn emit_fcmp_ne_op(dest: string, float_prefix: string) -> string {
    emit_fcmp_op(dest, "NE", float_prefix)
}
