// int64/int32/uint64/uint32 arithmetic prim emission: add, sub, mul, div, rem
// sir_emitter_pattern_spec §7.1: ADD/SUB/MUL/SDIV; rem = SDIV + MSUB (AArch64 has no SREM)
// Unsigned: UDIV; urem = UDIV + MSUB. Operands in r1, r2; result to dest.
// reg_prefix is "X" (int64/uint64) or "W" (int32/int16/int8/uint32/uint16/uint8).

use sir_ast;

export emit_add_op/2;
export emit_sub_op/2;
export emit_mul_op/2;
export emit_div_op/2;
export emit_rem_op/2;
export emit_udiv_op/2;
export emit_urem_op/2;
export emit_fadd_op/1;
export emit_fsub_op/1;
export emit_fmul_op/1;
export emit_fdiv_op/1;
export emit_fadd_s_op/1;
export emit_fsub_s_op/1;
export emit_fmul_s_op/1;
export emit_fdiv_s_op/1;
export emit_fadd_h_op/1;
export emit_fsub_h_op/1;
export emit_fmul_h_op/1;
export emit_fdiv_h_op/1;
export emit_neg_op/2;
export emit_fneg_op/1;
export emit_fneg_s_op/1;
export emit_fneg_h_op/1;

fn op_reg(prefix: string, n: string) -> string {
    concat(prefix, n)
}

fn emit_add_op(dest: string, reg_prefix: string) -> string {
    r1: string <- op_reg(reg_prefix, "9");
    r2: string <- op_reg(reg_prefix, "10");
    concat(concat(concat(concat(concat("    ADD ", dest), ", "), r1), ", "), r2)
}

fn emit_sub_op(dest: string, reg_prefix: string) -> string {
    r1: string <- op_reg(reg_prefix, "9");
    r2: string <- op_reg(reg_prefix, "10");
    // term_emitter emits left->r1, right->r2 (same as add/mul). SUB rd,rn,rm = rn-rm. Use r1,r2 so dest=r1-r2=left-right.
    concat(concat(concat(concat(concat("    SUB ", dest), ", "), r1), ", "), r2)
}

fn emit_mul_op(dest: string, reg_prefix: string) -> string {
    r1: string <- op_reg(reg_prefix, "9");
    r2: string <- op_reg(reg_prefix, "10");
    concat(concat(concat(concat(concat("    MUL ", dest), ", "), r1), ", "), r2)
}

fn emit_div_op(dest: string, reg_prefix: string) -> string {
    r1: string <- op_reg(reg_prefix, "9");
    r2: string <- op_reg(reg_prefix, "10");
    // term_emitter emits left->r1, right->r2. SDIV rd,rn,rm = rn/rm. Use r1,r2 so dest=r1/r2=left/right.
    check: string <- concat(concat(concat("    CMP ", r2), ", #0\n    B.NE 1f\n    BL _silica_rt_badarith\n1:\n"), "");
    concat(check, concat(concat(concat(concat(concat("    SDIV ", dest), ", "), r1), ", "), r2))
}

// AArch64 has no SREM; remainder = dividend - (quotient * divisor) via SDIV + MSUB
// term_emitter: left->r1 (dividend), right->r2 (divisor). SDIV r0,r1,r2 gives quotient.
// MSUB Rd,Rn,Rm,Ra = Rd = Ra - (Rn*Rm). Need Rd = dividend - quotient*divisor, so MSUB rd,r0,r2,r1.
fn emit_rem_op(dest: string, reg_prefix: string) -> string {
    // Quotient scratch: X16/W16 (IP0), never X0/W0 -- X0 still holds the first parameter and
    // the right operand of a later prim may read it (defect A7: `y % 27 + (z + x)` read x as the quotient).
    r0: string <- op_reg(reg_prefix, "16");
    r1: string <- op_reg(reg_prefix, "9");
    r2: string <- op_reg(reg_prefix, "10");
    check: string <- concat(concat(concat("    CMP ", r2), ", #0\n    B.NE 1f\n    BL _silica_rt_badarith\n1:\n"), "");
    sdiv_line: string <- concat(check, concat(concat(concat(concat(concat("    SDIV ", r0), ", "), concat(r1, ", ")), r2), "\n"));
    case dest == r1 of {
        true -> concat(sdiv_line, concat(concat(concat(concat(concat(concat("    MSUB ", r1), ", "), concat(r0, ", ")), concat(r2, ", ")), r1), ""));
        false -> case dest == r2 of {
            true -> concat(sdiv_line, concat(concat(concat(concat(concat(concat("    MSUB ", r2), ", "), concat(r0, ", ")), concat(r2, ", ")), r1), ""));
            false -> concat(sdiv_line, concat(concat(concat(concat(concat(concat("    MSUB ", dest), ", "), concat(r0, ", ")), concat(r2, ", ")), r1), ""))
        }
    }
}

fn emit_udiv_op(dest: string, reg_prefix: string) -> string {
    r1: string <- op_reg(reg_prefix, "9");
    r2: string <- op_reg(reg_prefix, "10");
    // term_emitter: left->r1, right->r2. UDIV rd,r1,r2.
    check: string <- concat(concat(concat("    CMP ", r2), ", #0\n    B.NE 1f\n    BL _silica_rt_badarith\n1:\n"), "");
    concat(check, concat(concat(concat(concat(concat("    UDIV ", dest), ", "), r1), ", "), r2))
}

fn emit_fadd_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FADD ", dest), ", D1, D2"), ""), ""), "")
}

fn emit_fsub_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FSUB ", dest), ", D1, D2"), ""), ""), "")
}

fn emit_fmul_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FMUL ", dest), ", D1, D2"), ""), ""), "")
}

fn emit_fdiv_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FDIV ", dest), ", D1, D2"), ""), ""), "")
}

fn emit_fadd_s_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FADD ", dest), ", S1, S2"), ""), ""), "")
}

fn emit_fsub_s_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FSUB ", dest), ", S1, S2"), ""), ""), "")
}

fn emit_fmul_s_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FMUL ", dest), ", S1, S2"), ""), ""), "")
}

fn emit_fdiv_s_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FDIV ", dest), ", S1, S2"), ""), ""), "")
}

fn emit_fadd_h_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FADD ", dest), ", H1, H2"), ""), ""), "")
}

fn emit_fsub_h_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FSUB ", dest), ", H1, H2"), ""), ""), "")
}

fn emit_fmul_h_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FMUL ", dest), ", H1, H2"), ""), ""), "")
}

fn emit_fdiv_h_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FDIV ", dest), ", H1, H2"), ""), ""), "")
}

// Unary neg (built-in negate_<type>/1 -> prim neg): operand in r1 (X9/W9/D1/S1/H1 per term_emitter)
fn emit_neg_op(dest: string, reg_prefix: string) -> string {
    r1: string <- op_reg(reg_prefix, "9");
    concat(concat(concat("    NEG ", dest), ", "), r1)
}

fn emit_fneg_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FNEG ", dest), ", D1"), ""), ""), "")
}

fn emit_fneg_s_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FNEG ", dest), ", S1"), ""), ""), "")
}

fn emit_fneg_h_op(dest: string) -> string {
    concat(concat(concat(concat(concat("    FNEG ", dest), ", H1"), ""), ""), "")
}

// AArch64 has no UREM; unsigned remainder = dividend - (quotient * divisor) via UDIV + MSUB
// term_emitter: left->r1 (dividend), right->r2 (divisor). UDIV r0,r1,r2 gives quotient.
// MSUB Rd,Rn,Rm,Ra = Rd = Ra - (Rn*Rm). Need Rd = dividend - quotient*divisor, so MSUB rd,r0,r2,r1.
fn emit_urem_op(dest: string, reg_prefix: string) -> string {
    // Quotient scratch: X16/W16 (IP0), never X0/W0 -- X0 still holds the first parameter and
    // the right operand of a later prim may read it (defect A7: `y % 27 + (z + x)` read x as the quotient).
    r0: string <- op_reg(reg_prefix, "16");
    r1: string <- op_reg(reg_prefix, "9");
    r2: string <- op_reg(reg_prefix, "10");
    check: string <- concat(concat(concat("    CMP ", r2), ", #0\n    B.NE 1f\n    BL _silica_rt_badarith\n1:\n"), "");
    udiv_line: string <- concat(check, concat(concat(concat(concat(concat("    UDIV ", r0), ", "), concat(r1, ", ")), r2), "\n"));
    case dest == r1 of {
        true -> concat(udiv_line, concat(concat(concat(concat(concat(concat("    MSUB ", r1), ", "), concat(r0, ", ")), concat(r2, ", ")), r1), ""));
        false -> case dest == r2 of {
            true -> concat(udiv_line, concat(concat(concat(concat(concat(concat("    MSUB ", r2), ", "), concat(r0, ", ")), concat(r2, ", ")), r1), ""));
            false -> concat(udiv_line, concat(concat(concat(concat(concat(concat("    MSUB ", dest), ", "), concat(r0, ", ")), concat(r2, ", ")), r1), ""))
        }
    }
}
