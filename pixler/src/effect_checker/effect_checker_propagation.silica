                    true -> {
                        head_eff: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, binding_type, include_foreign);
                        tail_eff: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_struct_literal_chain_effects_outside(parser_ast@expr_at(expr, node.right_expr), ctx, binding_type, include_foreign);
                        union_effect_lists(head_eff, tail_eff)
                    };
                    false -> collect_expr_effects_outside_sequence_blocks_with_binding(expr, ctx, binding_type, include_foreign)
                }
            }
    produces
        pure result
    end
}

{- Resolve the effects of a called function by name.
   Lookup order: region builtins (alloc_region, alloc_ref, etc.), user-defined, then other builtins.
   Unknown functions are treated as pure (empty effects). -}
fn resolve_call_effects(fn_name: string, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            resolve_call_effects_with_binding(fn_name, ctx, parser_ast@dummy_expr(), "", parser_ast@zero_location(), "", true)
    produces
        pure result
    end
}

fn dangerous_module_prefix() -> string {
    "dangerous_"
}

fn is_dangerous_module_name(name: string) -> boolean {
    pref: string <- dangerous_module_prefix();
    case length_bytes(name) >= length_bytes(pref) of {
        false -> false;
        true -> substring(name, 0, length_bytes(pref)) == pref
    }
}

fn external_danger_effect_singleton(location: { file: string, line: int64, column: int64, offset: int64 }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    ed: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: "external_danger", parameter: "", location: location };
    parser_ast@cons_effect_name(ed, parser_ast@empty_effect_name_list())
}

fn first_arg_region_type(first_arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }) -> string {
    sequence
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(first_arg);
        result: string <-
            case node.kind == 1 of {
                true -> {
                    (found: boolean, typ: string) <- effect_checker_core@lookup_type_entry(ctx.type_env, node.name);
                    case found of { true -> typ; false -> "" }
                };
                false -> ""
            }
    produces
        pure result
    end
}

{- generic_value: kind-4 call value field (generic instantiation text), empty if none.
   include_foreign_c_wrapper_effects: when false, raw FOREIGN c_wrapper calls are treated as pure
   (adapter stubs may call them outside SEQUENCE blocks; dangerous_* module calls still carry external_danger). -}
fn resolve_call_effects_with_binding(fn_name: string, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }, first_arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, binding_type: string, location: { file: string, line: int64, column: int64, offset: int64 }, generic_value: string, include_foreign_c_wrapper_effects: boolean) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            case effect_checker_lists@is_list_primitive_fn(fn_name) of {
                true -> stamp_effect_locations(effect_checker_lists@mem_effects_for_list_call(fn_name, generic_value, location), location);
                false -> case fn_name == "checked_int64_add" or fn_name == "checked_int64_mul" or fn_name == "checked_int64_add1" or fn_name == "checked_int64_byte_size" of {
                    true -> parser_ast@empty_effect_name_list();
                    false -> case fn_name == "comparator_result_valid" or fn_name == "comparator_result_validate" of {
                    true -> parser_ast@empty_effect_name_list();
                    false -> case fn_name == "ordering_identity_fresh_env" or fn_name == "ordering_identity_materialize" or fn_name == "ordering_identity_same" or fn_name == "ordering_identity_bundle_make" of {
                    true -> parser_ast@empty_effect_name_list();
                    false -> case effect_checker_memory_regions@is_region_builtin_fn(fn_name) of {
                    true -> {
                        first_arg_type: string <- first_arg_region_type(first_arg, ctx);
                        (handled: boolean, region_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_memory_regions@get_region_call_effects(fn_name, first_arg, first_arg_type, binding_type, location);
                        case handled of {
                            true -> stamp_effect_locations(region_effects, location);
                            false -> parser_ast@empty_effect_name_list()
                        }
                    };
                    false -> {
                        case type_checker_core@call_name_is_module_qualified(fn_name) of {
                            true -> {
                                (qmod: string, _: string) <- type_checker_core@split_module_qualified_call_name(fn_name);
                                case is_dangerous_module_name(qmod) of {
                                    true -> stamp_effect_locations(external_danger_effect_singleton(location), location);
                                    false -> {
                                        base: string <- type_checker_core@user_call_base_function_name(fn_name);
                                        resolved: string <- instantiated_fn_name@resolve_call_fn_name(base, generic_value);
                                        (found_mod: boolean, mod_prog: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- parser_ast@find_named_program(qmod, ctx.world);
                                        (found_mq: boolean, mq_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- case found_mod of {
                                            true -> effect_checker_declarations@lookup_fn_declared_effects(mod_prog.declarations, resolved);
                                            false -> (false, parser_ast@empty_effect_name_list())
                                        };
                                        inst_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- effect_checker_lists@mem_effects_from_fn_instantiation(generic_value, resolved, location);
                                        resolved_mq_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- case found_mq of {
                                            true -> case effect_checker_core@effect_list_length(mq_effects) > 0 of {
                                                true -> mq_effects;
                                                false -> inst_effects
                                            };
                                            false -> inst_effects
                                        };
                                        case found_mq or effect_checker_core@effect_list_length(resolved_mq_effects) > 0 of {
                                            true -> stamp_effect_locations(expand_effect_list(resolved_mq_effects, ctx.alias_env), location);
                                            false -> {
                                                (found_local: boolean, local_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@lookup_fn_effects(ctx.fn_env, resolved);
                                                case found_local of {
                                                    true -> stamp_effect_locations(expand_effect_list(local_effects, ctx.alias_env), location);
                                                    false -> {
                                                        (found_builtin_mq: boolean, builtin_mq_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@builtin_fn_effects(base);
                                                        case found_builtin_mq of {
                                                            true -> stamp_effect_locations(builtin_mq_effects, location);
                                                            false -> parser_ast@empty_effect_name_list()
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            };
                            false -> {
                                (found_user: boolean, user_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@lookup_fn_effects(ctx.fn_env, fn_name);
                                case found_user of {
                                    true -> stamp_effect_locations(expand_effect_list(user_effects, ctx.alias_env), location);
                                    false -> {
                                        case include_foreign_c_wrapper_effects of {
                                            true -> {
                                                (found_foreign: boolean, _: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@lookup_fn_effects(ctx.foreign_c_wrapper_env, fn_name);
                                                case found_foreign of {
                                                    true -> stamp_effect_locations(external_danger_effect_singleton(location), location);
                                                    false -> {
                                                        (found_builtin: boolean, builtin_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@builtin_fn_effects(fn_name);
                                                        case found_builtin of {
                                                            true -> stamp_effect_locations(builtin_effects, location);
                                                            false -> parser_ast@empty_effect_name_list()
                                                        }
                                                    }
                                                }
                                            };
                                            false -> {
                                                (found_builtin: boolean, builtin_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@builtin_fn_effects(fn_name);
                                                case found_builtin of {
                                                    true -> stamp_effect_locations(builtin_effects, location);
                                                    false -> parser_ast@empty_effect_name_list()
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
            }
            }
    produces
        pure result
    end
}

{- kind 17 branch list: inner is kind 18 branch; right_expr is next 17 or dummy. -}
fn collect_single_case_branch_effects(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(branch);
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            case node.kind == 18 of {
                true -> {
                    pat_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- effect_checker_lists@mem_effects_from_case_pattern(node.value, node.location);
                    rhs_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(branch, node.right_expr), ctx, "");
                    // The guard (inner; absent = -1) is evaluated in the enclosing sequence like the arm body.
                    guard_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(branch, node.inner), ctx, "");
                    union_effect_lists(pat_effects, union_effect_lists(guard_effects, rhs_effects))
                };
                false -> collect_expr_effects_with_binding(branch, ctx, "")
            }
    produces
        pure result
    end
}

fn collect_case_branch_list_effects(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(branches);
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            case node.kind == -1 of {
                true -> parser_ast@empty_effect_name_list();
                false -> case node.kind == 17 of {
                    true -> {
                        one: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_single_case_branch_effects(parser_ast@expr_at(branches, node.inner), ctx);
                        rest: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_case_branch_list_effects(parser_ast@expr_at(branches, node.right_expr), ctx);
                        union_effect_lists(one, rest)
                    };
                    false -> parser_ast@empty_effect_name_list()
                }
            }
    produces
        pure result
    end
}

{- Case branch RHS only: List[..., mem(S)] in pattern text is a type annotation for
   the type checker and E3011 alignment inside SEQUENCE blocks, not list allocation. -}
fn collect_single_case_branch_effects_outside(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }, include_foreign: boolean) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(branch);
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            case node.kind == 18 of {
                // The guard (inner; absent = -1) runs in the enclosing sequence: its operations count toward
                // that sequence's used set for both E3002 (missing) and E3010 (unused).
                true -> union_effect_lists(
                    collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(branch, node.inner), ctx, "", include_foreign),
                    collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(branch, node.right_expr), ctx, "", include_foreign)
                );
                false -> collect_expr_effects_outside_sequence_blocks_with_binding(branch, ctx, "", include_foreign)
            }
    produces
        pure result
    end
}

fn collect_case_branch_list_effects_outside(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }, include_foreign: boolean) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(branches);
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            case node.kind == -1 of {
                true -> parser_ast@empty_effect_name_list();
                false -> case node.kind == 17 of {
                    true -> {
                        one: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_single_case_branch_effects_outside(parser_ast@expr_at(branches, node.inner), ctx, include_foreign);
                        rest: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_case_branch_list_effects_outside(parser_ast@expr_at(branches, node.right_expr), ctx, include_foreign);
                        union_effect_lists(one, rest)
                    };
                    false -> parser_ast@empty_effect_name_list()
                }
            }
    produces
        pure result
    end
}

// --- Effect set union ---

{- Compute the union of two effect lists (no duplicates).
   For each effect in list_a, add to list_b if not already present.
   Normalizes effects before comparison. -}
fn union_effect_lists(list_a: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], list_b: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case list_a.is_nil of {
        true -> list_b;
        false -> {
            merged: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- add_effect_if_absent(list_b, effect_checker_core@normalize_effect(list_a.head));
            union_effect_lists(list_a.tail, merged)
        }
    }
}

{- Add an effect to the list if it is not already present (by equality after normalization). -}
fn add_effect_if_absent(list: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case effect_checker_core@effect_list_contains(list, eff) of {
        true -> list;
        false -> parser_ast@cons_effect_name(eff, list)
    }
}

// --- Alias expansion ---

{- Expand all aliases in an effect list.
   Each effect that is a built-in alias or user-defined alias is replaced
   by its expansion. Built-in effects pass through unchanged. -}
fn expand_effect_list(effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case effects.is_nil of {
        true -> parser_ast@empty_effect_name_list();
        false -> {
            expanded_head: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- expand_single_effect(effects.head, alias_env);
            expanded_tail: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- expand_effect_list(effects.tail, alias_env);
            union_effect_lists(expanded_head, expanded_tail)
        }
    }
}

{- Expand a single effect. If it is a built-in effect, return as singleton list.
   If it is a built-in alias, return its expansion.
   If it is a user-defined alias, return its expansion.
   Otherwise, return as singleton list (will be caught by validation). -}
fn expand_single_effect(eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    norm: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- effect_checker_core@normalize_effect(eff);
    case effect_checker_core@is_builtin_effect(norm) of {
        true -> parser_ast@cons_effect_name(norm, parser_ast@empty_effect_name_list());
        false -> case effect_checker_core@is_builtin_alias_name(norm.name) of {
            true -> {
                (found_alias: boolean, alias_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@expand_builtin_alias(norm.name);
                case found_alias of {
                    true -> alias_effects;
                    false -> parser_ast@cons_effect_name(norm, parser_ast@empty_effect_name_list())
                }
            };
            false -> {
                (found_user: boolean, user_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@lookup_fn_effects(alias_env, norm.name);
                case found_user of {
                    true -> user_effects;
                    false -> parser_ast@cons_effect_name(norm, parser_ast@empty_effect_name_list())
                }
            }
        }
    }
}
