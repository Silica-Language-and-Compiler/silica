{- Effect propagation.
   Traverses { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } trees to collect effects from function calls,
   computes effect set unions, and expands effect aliases.
   Implements spec Section 9.3.1 (Effect Propagation, Effect Set Union Algorithm).

   Supervisors (design_documents/supervisors_implementation_development_plan.md):
   Phases B/C: ingress vs mailbox ordering and Phase C exit/failure payload delivery are
   runtime concerns; effect propagation only sees proc[concurrency] for actor builtins
   (spawn_linked, link, monitor, demonitor, call, cast, send, self, recv via builtin_fn_effects).
   Phase D: behavior-only rules for spawn_linked and link are type-checked (E2091), not
   allocated separate effects here.
   Phase E (?15.4.12??15.4.13.2, ?15.4.13.3): runtime restart from supervisor_flags/child_spec,
   static child table, escalation, and dynamic spawn_linked (no auto-restart) do not surface as
   new call effects; the effect propagator still classifies those intrinsics as proc[concurrency] only.
   Phase F (?15.4.11.4, ?15.4.13.4): runtime unwind delivery to FailureReporter is not a call the
   effect propagator models; user handle_report / region_dump_limit bodies USE normal rules.
   Phase G (?15.4.8.4??15.4.8.7): `link` / `monitor` / `demonitor`, `DOWN` to standard mailbox,
   and supervisor death signaling; ingress vs mailbox routing is not represented as extra effects;
   propagation still unifies to proc[concurrency] for these intrinsics and for messaging.
   Memory region ops (alloc_region, alloc_ref, alloc_buf, read_ref, write_ref,
   read_buf, write_buf, buf_load, buf_store, alloc_rec, build, alloc_region_on_numa_node)
   require mem(Space) per spec Section 4.4, Sections 22.1-22.3; alloc_ref/alloc_buf/alloc_rec into atomic space also require atomic (Section 17.1.2).
   List[T,S] literals and list primitives require mem(S) per list_implementation_design.md Section 9.3, Section 9.8.
   Tuple literals (parser kind 9) are right-nested like struct literals; effects are the union of element expressions (see constraint_extract extract_tuple_elements_tail).
   Struct literals (parser kind 21) and field access (kind 22) follow silica:StructLiterals / Section 3.3.7:
   effects are the union of subexpressions (field initializers; base expr for .field).
-}

use parser_ast;
use lexer_core;
use effect_checker_core;
use effect_checker_declarations;
use effect_checker_memory_regions;
use effect_checker_lists;
use type_checker_core;
use instantiated_fn_name;

export collect_expr_effects/2;
export collect_expr_effects_outside_sequence_blocks/2;
export collect_sequence_block_direct_effects/2;
export resolve_call_effects/2;
export union_effect_lists/2;
export add_effect_if_absent/2;
export expand_effect_list/2;
export expand_single_effect/2;

fn stamp_effect_locations(effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case effects.is_nil of {
        true -> parser_ast@empty_effect_name_list();
        false -> {
            stamped_head: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- {
                name: effects.head.name,
                parameter: effects.head.parameter,
                location: location
            };
            stamped_tail: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- stamp_effect_locations(effects.tail, location);
            parser_ast@cons_effect_name(stamped_head, stamped_tail)
        }
    }
}

// --- Effect collection from expressions ---

{- Traverse an { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } tree and collect the union of all effects from function calls.
   { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kinds: 0=integer literal, 1=identifier, 2=parenthesized, 3=binary_op, 4=call, 5=atom literal, 6=let binding, 9=tuple literal (right-nested inner/right_expr; also then/else payload under kind 19), 21=struct literal, 22=field access, -1=dummy.
   For calls (kind 4): resolve callee effects (region ops USE binding_type for Space), union with arg subtree.
   For let bindings (kind 6): pass expr.value (binding type) when recursing into RHS for region op effect extraction.
   Pure expressions contribute no effects (spec Section 9.3.1). -}
fn collect_expr_effects(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            collect_expr_effects_with_binding(expr, ctx, "")
    produces
        pure result
    end
}

{- Effects from calls that appear outside any SEQUENCE block (kind 11).
   Used for function-body E3001: nested SEQUENCE proc[...] blocks declare their own
   effects; those must not be attributed to the enclosing function body.
   Foreign c_wrapper calls are treated as pure here so adapter stubs may invoke them
   outside SEQUENCE blocks; SEQUENCE-block checking uses collect_sequence_block_direct_effects. -}
fn collect_expr_effects_outside_sequence_blocks(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            collect_expr_effects_outside_sequence_blocks_with_binding(expr, ctx, "", false)
    produces
        pure result
    end
}

{- Same as collect_expr_effects_outside_sequence_blocks, but foreign c_wrapper calls
   contribute external_danger. Used for SEQUENCE-block E3001/E3010 used-effect sets. -}
fn collect_sequence_block_direct_effects(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            collect_expr_effects_outside_sequence_blocks_with_binding(expr, ctx, "", true)
    produces
        pure result
    end
}

fn collect_expr_effects_outside_sequence_blocks_with_binding(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }, binding_type: string, include_foreign: boolean) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            case node.kind == 11 of {
                true -> parser_ast@empty_effect_name_list();
                false -> case node.kind == 4 of {
                    true -> {
                        callee_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- resolve_call_effects_with_binding(node.name, ctx, parser_ast@expr_at(expr, node.inner), binding_type, node.location, node.value, include_foreign);
                        // Walk first arg (inner) and remaining args (right_expr chain: kind-4 name=="" pairs).
                        arg_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "", include_foreign);
                        rest_arg_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.right_expr), ctx, "", include_foreign);
                        union_effect_lists(callee_effects, union_effect_lists(arg_effects, rest_arg_effects))
                    };
                    false -> case node.kind == 3 of {
                        true -> {
                            left_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "", include_foreign);
                            right_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.right_expr), ctx, "", include_foreign);
                            union_effect_lists(left_effects, right_effects)
                        };
                        false -> case node.kind == 6 of {
                            true -> {
                                rhs_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, node.value, include_foreign);
                                next_type_env: List[{ name: string, type_name: string }, mem(normal)] <- effect_checker_core@add_type_entry(ctx.type_env, node.name, node.value);
                                extended_ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] } <- effect_checker_core@effect_context_with_type_env(ctx, next_type_env);
                                body_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.right_expr), extended_ctx, "", include_foreign);
                                union_effect_lists(rhs_effects, body_effects)
                            };
                            false -> case node.kind == 2 of {
                                true -> collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, binding_type, include_foreign);
                                false -> case node.kind == 10 of {
                                    true -> {
                                        rhs_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "", include_foreign);
                                        body_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.right_expr), ctx, "", include_foreign);
                                        union_effect_lists(rhs_effects, body_effects)
                                    };
                                    false -> case node.kind == 20 of {
                                        true -> {
                                            lit_type_src: string <- case length_bytes(node.value) > 0 of {
                                                true -> node.value;
                                                false -> binding_type
                                            };
                                            lit_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- effect_checker_lists@mem_effects_for_list_literal(lit_type_src, node.location);
                                            rest_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "", include_foreign);
                                            union_effect_lists(lit_effects, rest_effects)
                                        };
                                        false -> case node.kind == 13 of {
                                            true -> {
                                                scrut_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "", include_foreign);
                                                branch_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_case_branch_list_effects_outside(parser_ast@expr_at(expr, node.right_expr), ctx, include_foreign);
                                                union_effect_lists(scrut_effects, branch_effects)
                                            };
                                            false -> case node.kind == 9 of {
                                                true -> collect_tuple_literal_chain_effects_outside(expr, ctx, binding_type, include_foreign);
                                                false -> case node.kind == 21 of {
                                                    true -> collect_struct_literal_chain_effects_outside(expr, ctx, binding_type, include_foreign);
                                                    false -> case node.kind == 22 of {
                                                        true -> collect_expr_effects_outside_sequence_blocks_with_binding(parser_ast@expr_at(expr, node.inner), ctx, binding_type, include_foreign);
                                                        false -> parser_ast@empty_effect_name_list();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
    produces
        pure result
    end
}

fn collect_expr_effects_with_binding(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }, binding_type: string) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            case node.kind == 4 of {
                true -> {
                    callee_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- resolve_call_effects_with_binding(node.name, ctx, parser_ast@expr_at(expr, node.inner), binding_type, node.location, node.value, true);
                    binding_list_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- case type_checker_core@user_call_base_function_name(node.name) == "call_supervisor" of {
                        true -> parser_ast@empty_effect_name_list();
                        false -> effect_checker_lists@mem_effects_for_list_literal(binding_type, node.location)
                    };
                    // Walk first arg (inner) and remaining args (right_expr chain: kind-4 name=="" pairs).
                    arg_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "");
                    rest_arg_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.right_expr), ctx, "");
                    union_effect_lists(union_effect_lists(callee_effects, binding_list_effects), union_effect_lists(arg_effects, rest_arg_effects))
                };
                false -> case node.kind == 3 of {
                    true -> {
                        left_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "");
                        right_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.right_expr), ctx, "");
                        union_effect_lists(left_effects, right_effects)
                    };
                    false -> case node.kind == 6 of {
                        true -> {
                            rhs_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, node.value);
                            next_type_env: List[{ name: string, type_name: string }, mem(normal)] <- effect_checker_core@add_type_entry(ctx.type_env, node.name, node.value);
                                extended_ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] } <- effect_checker_core@effect_context_with_type_env(ctx, next_type_env);
                            body_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.right_expr), extended_ctx, "");
                            union_effect_lists(rhs_effects, body_effects)
                        };
                        false -> case node.kind == 2 of {
                            true -> collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, binding_type);
                            false -> case node.kind == 10 of {
                                true -> {
                                    rhs_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "");
                                    body_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.right_expr), ctx, "");
                                    union_effect_lists(rhs_effects, body_effects)
                                };
                                false -> case node.kind == 11 of {
                                    // Nested sequence blocks encapsulate their effects (checked separately).
                                    // Callers that need this sequence's own used-set must walk inner/right_expr
                                    // with collect_expr_effects_outside_sequence_blocks.
                                    true -> parser_ast@empty_effect_name_list();
                                    false -> case node.kind == 20 of {
                                        true -> {
                                            lit_type_src: string <- case length_bytes(node.value) > 0 of {
                                                true -> node.value;
                                                false -> binding_type
                                            };
                                            lit_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- effect_checker_lists@mem_effects_for_list_literal(lit_type_src, node.location);
                                            rest_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "");
                                            union_effect_lists(lit_effects, rest_effects)
                                        };
                                        false -> case node.kind == 13 of {
                                            true -> {
                                                scrut_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, "");
                                                branch_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_case_branch_list_effects(parser_ast@expr_at(expr, node.right_expr), ctx);
                                                union_effect_lists(scrut_effects, branch_effects)
                                            };
                                            false -> case node.kind == 9 of {
                                                true -> collect_tuple_literal_chain_effects(expr, ctx, binding_type);
                                                false -> case node.kind == 21 of {
                                                    true -> collect_struct_literal_chain_effects(expr, ctx, binding_type);
                                                    false -> case node.kind == 22 of {
                                                        true -> collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, binding_type);
                                                        false -> parser_ast@empty_effect_name_list();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
    produces
        pure result
    end
}

// --- Tuple literals (kind 9), right-nested inner/right_expr ---

{- Right-nested chain of kind-9 nodes: inner = first element, right_expr = next element or tail { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }.
   Same spine shape as struct literals (kind 21); used for `(\.,\.[,])` and for then/else pair under kind 19 (union of branches). -}
fn collect_tuple_literal_chain_effects(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }, binding_type: string) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <-
            case node.kind == -1 of {
                true -> parser_ast@empty_effect_name_list();
                false -> case node.kind == 9 of {
                    true -> {
                        head_eff: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_expr_effects_with_binding(parser_ast@expr_at(expr, node.inner), ctx, binding_type);
                        tail_eff: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_tuple_literal_chain_effects(parser_ast@expr_at(expr, node.right_expr), ctx, binding_type);
                        union_effect_lists(head_eff, tail_eff)
                    };
                    false -> collect_expr_effects_with_binding(expr, ctx, binding_type)
                }
            }
    produces
        pure result
    end
}

