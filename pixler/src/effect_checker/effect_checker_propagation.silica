                        tail_eff: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- collect_struct_literal_chain_effects(parser_ast@expr_at(expr, node.right_expr), ctx, binding_type);
                        union_effect_lists(head_eff, tail_eff)
                    };
                    false -> collect_expr_effects_with_binding(expr, ctx, binding_type)
                }
            }
    produces
        pure result
    end
}

