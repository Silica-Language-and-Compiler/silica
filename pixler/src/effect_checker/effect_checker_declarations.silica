{- Effect declaration validation.
   Builds effect environments from parsed declarations and validates that
   all declared effect names are recognized built-in, alias, or user-defined effects.
   Implements spec §9.1 (valid effect names), §9.3.1 (explicit declaration requirement).
-}

use parser_ast;
use lexer_core;
use effect_checker_core;
use instantiated_fn_name;

export build_fn_env/1;
export lookup_fn_declared_effects/2;
export build_foreign_c_wrapper_env/1;
export build_alias_env/1;
export validate_effect_name/2;
export validate_declared_effects/2;
export validate_all_fn_declarations/2;

// --- Environment construction ---

{- Tag 9 FFI c-wrapper binding names (effects attributed only inside kind-11 effect blocks). -}
fn build_foreign_c_wrapper_env(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence
        empty: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- effect_checker_core@empty_effect_entry_list();
        result: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- build_foreign_c_wrapper_env_acc(decls, empty)
    produces
        pure result
    end
}

fn build_foreign_c_wrapper_env_acc(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    case decls.is_nil of {
        true -> acc;
        false -> List[ {
            new_acc: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- case decls.head.tag == 9 of {
                true -> effect_checker_core@add_effect_entry(acc, decls.head.name, parser_ast@empty_effect_name_list());
                false -> acc
            };
            build_foreign_c_wrapper_env_acc(decls.tail, new_acc)
        }, mem(normal)]
    }
}

{- Scan List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] to build function name -> declared effects mapping.
   Only processes function declarations (tag 0). -}
fn build_fn_env(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence
        empty: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- effect_checker_core@empty_effect_entry_list();
        result: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- build_fn_env_acc(decls, empty)
    produces
        pure result
    end
}

fn build_fn_env_acc(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    case decls.is_nil of {
        true -> acc;
        false -> List[ {
            new_acc: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- case decls.head.tag == 0 of {
                true -> effect_checker_core@add_effect_entry(acc, decls.head.name, effect_checker_core@fn_effective_effects(decls.head));
                false -> acc
            };
            build_fn_env_acc(decls.tail, new_acc)
        }, mem(normal)]
    }
}

{- First tag-0 function declaration whose name matches target (bracket instantiation aware). -}
fn lookup_fn_declared_effects(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], target_name: string) -> (boolean, List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) {
    case decls.is_nil of {
        true -> {
            sequence
                empty: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@empty_effect_name_list();
                result: (boolean, List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- (false, empty)
            produces
                pure result
            end
        };
        false -> case decls.head.tag == 0 of {
            true -> case instantiated_fn_name@decl_name_matches(decls.head.name, target_name) of {
                true -> (true, effect_checker_core@fn_effective_effects(decls.head));
                false -> lookup_fn_declared_effects(decls.tail, target_name)
            };
            false -> lookup_fn_declared_effects(decls.tail, target_name)
        }
    }
}

{- Scan List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] to build effect alias name -> effects mapping.
   Only processes effect declarations (tag 1). -}
fn build_alias_env(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence
        empty: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- effect_checker_core@empty_effect_entry_list();
        result: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- build_alias_env_acc(decls, empty)
    produces
        pure result
    end
}

fn build_alias_env_acc(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    case decls.is_nil of {
        true -> acc;
        false -> List[ {
            new_acc: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- case decls.head.tag == 1 of {
                true -> effect_checker_core@add_effect_entry(acc, decls.head.name, decls.head.declared_effects);
                false -> acc
            };
            build_alias_env_acc(decls.tail, new_acc)
        }, mem(normal)]
    }
}

// --- Effect name validation ---

{- Validate that a single effect name is a recognized built-in effect,
   a built-in alias, or a user-defined effect/alias in the alias environment.
   Returns effect_check_ok if valid, E3005 if unrecognized, E3007 if invalid parameter. -}
fn validate_effect_name(eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    norm: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- effect_checker_core@normalize_effect(eff);
    case effect_checker_core@is_builtin_effect(norm) of {
        true -> effect_checker_core@effect_check_ok();
        false -> case effect_checker_core@is_builtin_alias_name(norm.name) of {
            true -> case effect_checker_core@is_empty_param(norm.parameter) of {
                true -> effect_checker_core@effect_check_ok();
                false -> effect_checker_core@effect_check_err(
                    "E3007",
                    eff.location,
                    concat("Invalid parameter on effect alias: ", effect_checker_core@effect_name_to_string(eff)),
                    "sect9.1.2"
                )
            };
            false -> {
                (found_user: boolean, user_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- effect_checker_core@lookup_fn_effects(alias_env, norm.name);
                case found_user of {
                    true -> case effect_checker_core@is_empty_param(norm.parameter) of {
                        true -> effect_checker_core@effect_check_ok();
                        false -> effect_checker_core@effect_check_err(
                            "E3007",
                            eff.location,
                            concat("Invalid parameter on user-defined effect: ", effect_checker_core@effect_name_to_string(eff)),
                            "sect9.1.3"
                        )
                    };
                    false -> {
                        param_empty_str: string <- case effect_checker_core@is_empty_param(eff.parameter) of { true -> "yes"; false -> "no" };
                        debug_suffix: string <- concat(" [DEBUG: name='", concat(eff.name, concat("' param='", concat(eff.parameter, concat("' param_empty=", concat(param_empty_str, "]"))))));
                        effect_checker_core@effect_check_err(
                            "E3005",
                            eff.location,
                            concat(concat("Undeclared effect: ", effect_checker_core@effect_name_to_string(eff)), debug_suffix),
                            "sect9.1"
                        )
                    }
                }
            }
        }
    }
}

{- Validate all effects in a function's declared_effects list.
   Returns the first error found, or effect_check_ok if all are valid. -}
fn validate_declared_effects(effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case effects.is_nil of {
        true -> effect_checker_core@effect_check_ok();
        false -> {
            one: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- validate_effect_name(effects.head, alias_env);
            case one.is_ok of {
                true -> validate_declared_effects(effects.tail, alias_env);
                false -> one
            }
        }
    }
}

{- Validate declared effects across all function declarations (tag 0) in the program.
   Returns the first error found, or effect_check_ok if all are valid. -}
fn validate_all_fn_declarations(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case decls.is_nil of {
        true -> effect_checker_core@effect_check_ok();
        false -> case decls.head.tag == 0 of {
            true -> {
                one: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- validate_declared_effects(decls.head.declared_effects, alias_env);
                case one.is_ok of {
                    true -> validate_all_fn_declarations(decls.tail, alias_env);
                    false -> one
                }
            };
            false -> validate_all_fn_declarations(decls.tail, alias_env)
        }
    }
}
