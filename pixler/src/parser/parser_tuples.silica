// Tuple type extraction helpers
// Used by constraint_extract for bindings with tuple types

use lexer_core;
use lexer_token_kind;
use constraint_core;
use parser_ast;

export extract_fn_type_from_slots/1;
export extract_tuple_type_from_slots/1;
export extract_parametrized_type_from_slots/1;
export extract_inline_record_type_from_slots/1;
export extract_list_type_from_slots/1;
export slots_start_bracketed_collection_type/1;
export extract_atom_option_type_from_slots/1;
export atom_option_binding_has_arrow_after_type/1;
export extract_top_level_or_type_from_slots/1;
export is_tuple_type_binding_start/1;
export binding_starts_paren_tuple_type_after_colon/1;
export is_struct_type_binding_start/1;
export is_memory_region_type_binding_start/1;
export is_single_element_tuple_type/1;
export extract_tuple_decompose_pattern_from_slots/1;
export get_bindings_for_ast/1;
export slots_start_fn_type/1;
export slots_fn_or_export_kind/1;
export token_introduces_use/1;
export token_introduces_export/1;
export token_introduces_trait/1;
export token_is_slash_lexeme/1;
export token_is_semicolon_lexeme/1;
export token_is_comma_lexeme/1;
export token_is_integer_lexeme/1;
export token_is_name_lexeme/1;


// TupleTypeResult: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] }

// `fn` is usually `fn_keyword`, but lexer/slot attribution can expose it as `identifier` + lexeme "fn".
// Treat both so nested function types (`start: fn(...) ->`) are not parsed as `fn(...) ` calls.
fn token_introduces_fn_type(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_fn_keyword() or (tok.kind == lexer_token_kind@token_kind_identifier() and tok.lexeme == "fn")
}

fn token_introduces_use(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_use_keyword() or (tok.kind == lexer_token_kind@token_kind_identifier() and tok.lexeme == "use") or tok.lexeme == "use"
}

fn token_introduces_export(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_export_keyword() or (tok.kind == lexer_token_kind@token_kind_identifier() and tok.lexeme == "export") or tok.lexeme == "export"
}

fn token_introduces_trait(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.lexeme == "trait" or tok.kind == lexer_token_kind@token_kind_trait_keyword()
}

fn token_is_slash_lexeme(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_slash() or tok.lexeme == "/"
}

fn token_is_semicolon_lexeme(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_semicolon() or tok.lexeme == ";"
}

fn token_is_comma_lexeme(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_comma() or tok.lexeme == ","
}

fn token_lexeme_starts_digit(s: string) -> boolean {
    case length_bytes(s) < 1 of {
        true -> false;
        false -> {
            c: string <- substring(s, 0, 1);
            c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
        }
    }
}

fn token_is_integer_lexeme(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    token_lexeme_starts_digit(tok.lexeme) or tok.kind == lexer_token_kind@token_kind_integer_literal()
}

fn token_lexeme_starts_ident_char(s: string) -> boolean {
    case length_bytes(s) < 1 of {
        true -> false;
        false -> {
            c: string <- substring(s, 0, 1);
            c == "_" or c == "a" or c == "b" or c == "c" or c == "d" or c == "e" or c == "f" or c == "g" or c == "h" or c == "i" or c == "j" or c == "k" or c == "l" or c == "m" or c == "n" or c == "o" or c == "p" or c == "q" or c == "r" or c == "s" or c == "t" or c == "u" or c == "v" or c == "w" or c == "x" or c == "y" or c == "z" or c == "A" or c == "B" or c == "C" or c == "D" or c == "E" or c == "F" or c == "G" or c == "H" or c == "I" or c == "J" or c == "K" or c == "L" or c == "M" or c == "N" or c == "O" or c == "P" or c == "Q" or c == "R" or c == "S" or c == "T" or c == "U" or c == "V" or c == "W" or c == "X" or c == "Y" or c == "Z"
        }
    }
}

fn token_is_name_lexeme(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    token_lexeme_starts_ident_char(tok.lexeme) or lexer_token_kind@is_identifier_lexeme_token(tok.kind)
}

fn slots_start_fn_type(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
        case slots.is_nil of {
        true -> false;
        false -> token_introduces_fn_type(slots.head.token)
    }
}

fn slots_fn_or_export_kind(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> int64 {
    case slots.is_nil of {
        true -> 0;
        false -> case token_introduces_export(slots.head.token) of {
            true -> 2;
            false -> case token_introduces_use(slots.head.token) of {
                true -> 1;
                false -> case token_introduces_fn_type(slots.head.token) of {
                    true -> 3;
                    false -> 0
                }
            }
        }
    }
}

// Cannot import constraint_extract (it imports this module); keep in sync with skip_leading_whitespace_slots there.
fn skip_leading_whitespace_slots_for_types(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.lexeme == " " or slots.head.token.lexeme == "\t" or slots.head.token.lexeme == "\n" or slots.head.token.lexeme == "\r" of {
            true -> skip_leading_whitespace_slots_for_types(slots.tail);
            false -> slots
        }
    }
}

fn is_type_keyword(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_int8_keyword() or token_kind == lexer_token_kind@token_kind_int16_keyword() or token_kind == lexer_token_kind@token_kind_int32_keyword() or token_kind == lexer_token_kind@token_kind_int64_keyword() or token_kind == lexer_token_kind@token_kind_uint8_keyword() or token_kind == lexer_token_kind@token_kind_uint16_keyword() or token_kind == lexer_token_kind@token_kind_uint32_keyword() or token_kind == lexer_token_kind@token_kind_uint64_keyword() or token_kind == lexer_token_kind@token_kind_float16_keyword() or token_kind == lexer_token_kind@token_kind_float32_keyword() or token_kind == lexer_token_kind@token_kind_float64_keyword() or token_kind == lexer_token_kind@token_kind_bool_keyword() or token_kind == lexer_token_kind@token_kind_char_keyword() or token_kind == lexer_token_kind@token_kind_string_keyword() or token_kind == lexer_token_kind@token_kind_bytes_keyword() or token_kind == lexer_token_kind@token_kind_unit_keyword() or token_kind == lexer_token_kind@token_kind_atom_keyword() or token_kind == lexer_token_kind@token_kind_ref_keyword() or token_kind == lexer_token_kind@token_kind_rec_keyword() or token_kind == lexer_token_kind@token_kind_region_keyword() or token_kind == lexer_token_kind@token_kind_device_window_keyword() or token_kind == lexer_token_kind@token_kind_buf_keyword() or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword() or token_kind == lexer_token_kind@token_kind_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_device_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_timer_ref_keyword() or token_kind == lexer_token_kind@token_kind_supervisor_ref_keyword() or token_kind == lexer_token_kind@token_kind_failure_reason_keyword()
}

fn is_memory_region_type_binding_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
        case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> case slots.tail.tail.is_nil of {
                true -> false;
                false -> case lexer_token_kind@is_identifier_lexeme_token(slots.head.token.kind) or slots.head.token.kind == lexer_token_kind@token_kind_ref_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_buf_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_region_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_device_window_keyword() of {
                    true -> case slots.tail.head.token.kind == lexer_token_kind@token_kind_colon() of {
                        true -> {
                            ac: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots_for_types(slots.tail.tail);
                            case ac.is_nil of {
                                true -> false;
                                false -> case ac.head.token.kind == lexer_token_kind@token_kind_ref_keyword() or ac.head.token.kind == lexer_token_kind@token_kind_region_keyword() or ac.head.token.kind == lexer_token_kind@token_kind_device_window_keyword() or ac.head.token.kind == lexer_token_kind@token_kind_buf_keyword() of {
                                    true -> case ac.tail.is_nil of {
                                        true -> false;
                                        false -> case ac.tail.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
                                            true -> true;
                                            // `name: ref?(L, S, T) <- rhs` (optional reference, §4.2.2): same
                                            // parametrized-type path; extract_parametrized_type_from_slots reads `ref ? (`.
                                            false -> case ac.head.token.kind == lexer_token_kind@token_kind_ref_keyword() and ac.tail.head.token.lexeme == "?" of {
                                                false -> false;
                                                true -> case ac.tail.tail.is_nil of {
                                                    true -> false;
                                                    false -> ac.tail.tail.head.token.kind == lexer_token_kind@token_kind_left_paren()
                                                }
                                            }
                                        }
                                    };
                                    false -> case ac.head.token.kind == lexer_token_kind@token_kind_atomic_keyword() of {
                                        true -> case ac.tail.is_nil of {
                                            true -> false;
                                            false -> case ac.tail.head.token.kind == lexer_token_kind@token_kind_ref_keyword() of {
                                                true -> case ac.tail.tail.is_nil of {
                                                    true -> false;
                                                    false -> ac.tail.tail.head.token.kind == lexer_token_kind@token_kind_left_paren()
                                                };
                                                false -> false
                                            }
                                        };
                                        false -> false
                                    }
                                }
                            }
                        };
                        false -> false
                    };
                    false -> false
                }
            }
        }
    }
}

fn kind_to_type_name(token_kind: int64) -> string {
        case token_kind == lexer_token_kind@token_kind_failure_reason_keyword() of {
        true -> "failure_reason";
        false -> kind_to_type_name_inner(token_kind);
    }
}

fn kind_to_type_name_inner(token_kind: int64) -> string {
        case token_kind == lexer_token_kind@token_kind_supervisor_ref_keyword() of {
        true -> "supervisor_ref";
        false -> case token_kind == lexer_token_kind@token_kind_timer_ref_keyword() of {
        true -> "timer_ref";
        false -> case token_kind == lexer_token_kind@token_kind_actor_ref_keyword() of {
            true -> "actor_ref";
            false -> case token_kind == lexer_token_kind@token_kind_int64_keyword() of {
        true -> "int64";
        false -> case token_kind == lexer_token_kind@token_kind_int32_keyword() of {
            true -> "int32";
            false -> case token_kind == lexer_token_kind@token_kind_int16_keyword() of {
                true -> "int16";
                false -> case token_kind == lexer_token_kind@token_kind_int8_keyword() of {
                    true -> "int8";
                    false -> case token_kind == lexer_token_kind@token_kind_uint64_keyword() of {
                        true -> "uint64";
                        false -> case token_kind == lexer_token_kind@token_kind_uint32_keyword() of {
                            true -> "uint32";
                            false -> case token_kind == lexer_token_kind@token_kind_uint16_keyword() of {
                                true -> "uint16";
                                false -> case token_kind == lexer_token_kind@token_kind_uint8_keyword() of {
                                    true -> "uint8";
                                    false -> case token_kind == lexer_token_kind@token_kind_float64_keyword() of {
                                        true -> "float64";
                                        false -> case token_kind == lexer_token_kind@token_kind_float32_keyword() of {
                                            true -> "float32";
                                            false -> case token_kind == lexer_token_kind@token_kind_float16_keyword() of {
                                                true -> "float16";
                                                false -> case token_kind == lexer_token_kind@token_kind_bool_keyword() of {
                                                    true -> "boolean";
                                                    false -> case token_kind == lexer_token_kind@token_kind_char_keyword() of {
                                                        true -> "char";
                                                        false -> case token_kind == lexer_token_kind@token_kind_unit_keyword() of {
                                                            true -> "unit";
                                                            false -> case token_kind == lexer_token_kind@token_kind_atom_keyword() of {
                                                                true -> "atom";
                                                                false -> case token_kind == lexer_token_kind@token_kind_string_keyword() of {
                                                                    true -> "string";
                                                                    false -> case token_kind == lexer_token_kind@token_kind_bytes_keyword() of {
                                                                        true -> "bytes";
                                                                        false -> case token_kind == lexer_token_kind@token_kind_ref_keyword() of {
                                                                        true -> "ref";
                                                                        false -> case token_kind == lexer_token_kind@token_kind_device_window_keyword() of {
                                                                            true -> "device_window";
                                                                        false -> case token_kind == lexer_token_kind@token_kind_region_keyword() of {
                                                                            true -> "region";
                                                                            false -> case token_kind == lexer_token_kind@token_kind_buf_keyword() of {
                                                                                true -> "buf";
                                                                                false -> case token_kind == lexer_token_kind@token_kind_atomic_keyword() of {
                                                                                    true -> "atomic";
                                                                                    false -> case token_kind == lexer_token_kind@token_kind_normal_keyword() of {
                                                                                        true -> "normal";
                                                                                        false -> case token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() of {
                                                                                            true -> "normal_writeback";
                                                                                            false -> case token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() of {
                                                                                                true -> "normal_writethrough";
                                                                                                false -> case token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() of {
                                                                                                    true -> "normal_noncacheable";
                                                                                                    false -> case token_kind == lexer_token_kind@token_kind_device_keyword() of {
                                                                                                        true -> "device";
                                                                                                        false -> ""
                                                                                                    }
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}
}
}
}

fn token_is_bracketed_collection_type_name(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_list_keyword()
}

fn slots_tail_has_left_bracket(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots_for_types(slots);
    case trimmed.is_nil of {
        true -> false;
        false -> trimmed.head.token.kind == lexer_token_kind@token_kind_left_bracket()
    }
}

fn is_collection_trait_type_lexeme(lex: string) -> boolean {
    lex == "OrderedSet" or lex == "OrderedMap" or lex == "Heap" or lex == "DirectedGraph"
        or lex == "SearchTree" or lex == "UndirectedGraph" or lex == "WeightedGraph"
        or lex == "PriorityQueue" or lex == "Tree" or lex == "BinaryTree"
}

fn slots_start_bracketed_collection_type(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots_for_types(slots);
    case trimmed.is_nil of {
        true -> false;
        false -> case token_is_bracketed_collection_type_name(trimmed.head.token) of {
            true -> slots_tail_has_left_bracket(trimmed.tail);
            false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_identifier() of {
                true -> case is_collection_trait_type_lexeme(trimmed.head.token.lexeme) of {
                    false -> false;
                    true -> slots_tail_has_left_bracket(trimmed.tail)
                };
                false -> false
            }
        }
    }
}

fn token_is_list_type_name(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    token_is_bracketed_collection_type_name(tok)
}

fn slot_lexemes_join_pt(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> string {
    case slots.is_nil of {
        true -> "";
        false -> case slots.tail.is_nil of {
            true -> slots.head.token.lexeme;
            false -> {
                rest_s: string <- slot_lexemes_join_pt(slots.tail);
                concat(concat(slots.head.token.lexeme, " "), rest_s)
            }
        }
    }
}
{-
fn take_prefix_slots_pt(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
