// Capability: immutable list surface — List[T, S], list literals [...]: List[...], generic calls name[T,S](...),
// list case patterns []: List[...] and [h: T, _: List[...]] (design_documents/list_implementation_design.md §3, §7).
// Excludes map/filter/reduce (not special-cased in the parser).

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;
export role_list_type_kw/0;
export role_list_type_lbracket/0;
export role_list_type_param/0;
export role_list_type_comma/0;
export role_list_type_rbracket/0;
export role_list_lit_lbracket/0;
export role_list_lit_rbracket/0;
export role_list_lit_comma/0;
export role_list_lit_colon/0;
export role_call_gen_lbracket/0;
export role_call_gen_rbracket/0;
export role_case_pat_list_lbracket/0;
export role_case_pat_list_empty_rbracket/0;
export role_case_pat_list_comma/0;
export role_case_pat_list_tail_rbracket/0;

fn role_list_type_kw() -> int64 { 200 }
fn role_list_type_lbracket() -> int64 { 201 }
fn role_list_type_param() -> int64 { 202 }
fn role_list_type_comma() -> int64 { 203 }
fn role_list_type_rbracket() -> int64 { 204 }
fn role_list_lit_lbracket() -> int64 { 205 }
fn role_list_lit_rbracket() -> int64 { 206 }
fn role_list_lit_comma() -> int64 { 207 }
fn role_list_lit_colon() -> int64 { 208 }
fn role_call_gen_lbracket() -> int64 { 209 }
fn role_call_gen_rbracket() -> int64 { 210 }
fn role_case_pat_list_lbracket() -> int64 { 211 }
fn role_case_pat_list_empty_rbracket() -> int64 { 212 }
fn role_case_pat_list_comma() -> int64 { 213 }
fn role_case_pat_list_tail_rbracket() -> int64 { 214 }

// Shared role codes (must match capability_bind / capability_fn_decl)
fn role_bind_colon() -> int64 { 41 }
fn role_bind_arrow() -> int64 { 43 }
fn role_tuple_type_lparen() -> int64 { 44 }
fn role_tuple_type_rparen() -> int64 { 45 }
fn role_tuple_type_comma() -> int64 { 46 }
fn role_right_arrow() -> int64 { 5 }
fn role_param_colon() -> int64 { 26 }
fn role_param_comma() -> int64 { 28 }
fn role_right_paren() -> int64 { 4 }
fn role_left_brace() -> int64 { 7 }
fn role_stmt_sep() -> int64 { 55 }
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_name() -> int64 { 14 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_case_branch_arrow() -> int64 { 112 }
fn role_case_pat_colon() -> int64 { 115 }
fn role_case_pat_type() -> int64 { 116 }
fn role_case_branch_lbrace() -> int64 { 126 }
fn role_case_branch_stmt_sep() -> int64 { 119 }
fn role_case_pat_ident() -> int64 { 114 }
fn role_case_pat_int() -> int64 { 113 }
fn role_case_pat_bool() -> int64 { 118 }
fn role_right_brace() -> int64 { 8 }
fn role_memory_type_start() -> int64 { 60 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

fn is_type_keyword_for_list_param(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_int8_keyword() or token_kind == lexer_token_kind@token_kind_int16_keyword() or token_kind == lexer_token_kind@token_kind_int32_keyword() or token_kind == lexer_token_kind@token_kind_int64_keyword() or token_kind == lexer_token_kind@token_kind_uint8_keyword() or token_kind == lexer_token_kind@token_kind_uint16_keyword() or token_kind == lexer_token_kind@token_kind_uint32_keyword() or token_kind == lexer_token_kind@token_kind_uint64_keyword() or token_kind == lexer_token_kind@token_kind_float16_keyword() or token_kind == lexer_token_kind@token_kind_float32_keyword() or token_kind == lexer_token_kind@token_kind_float64_keyword() or token_kind == lexer_token_kind@token_kind_bool_keyword() or token_kind == lexer_token_kind@token_kind_char_keyword() or token_kind == lexer_token_kind@token_kind_string_keyword() or token_kind == lexer_token_kind@token_kind_bytes_keyword() or token_kind == lexer_token_kind@token_kind_unit_keyword() or token_kind == lexer_token_kind@token_kind_atom_keyword() or token_kind == lexer_token_kind@token_kind_ref_keyword() or token_kind == lexer_token_kind@token_kind_region_keyword() or token_kind == lexer_token_kind@token_kind_buf_keyword() or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword() or token_kind == lexer_token_kind@token_kind_list_keyword() or token_kind == lexer_token_kind@token_kind_failure_reason_keyword()
}

fn seven_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, six_roles(r2, r3, r4, r5, r6, r7))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // List keyword in type position -> [
    c_lkw: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_type_kw(), next_token_roles: single_role(role_list_type_lbracket()), prev_token_roles: five_roles(role_bind_colon(), role_right_arrow(), role_param_colon(), role_case_pat_colon(), role_list_lit_colon()), constraint_id: 200 };
    // [ after List
    c_llb: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_type_lbracket(), next_token_roles: three_roles(role_list_type_param(), role_tuple_type_lparen(), role_memory_type_start()), prev_token_roles: single_role(role_list_type_kw()), constraint_id: 201 };
    // Type parameters inside List[ ] or generic name[ ] before (
    c_ltp: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_type_param(), next_token_roles: three_roles(role_list_type_comma(), role_list_type_rbracket(), role_call_gen_rbracket()), prev_token_roles: three_roles(role_list_type_lbracket(), role_list_type_comma(), role_call_gen_lbracket()), constraint_id: 202 };
    c_ltc: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_type_comma(), next_token_roles: three_roles(role_list_type_param(), role_tuple_type_lparen(), role_memory_type_start()), prev_token_roles: single_role(role_list_type_param()), constraint_id: 203 };
    // ] closes List[...] in type position; may be followed by another ] that closes the whole list pattern
    c_ltr: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_type_rbracket(), next_token_roles: seven_roles(role_bind_arrow(), role_tuple_type_comma(), role_tuple_type_rparen(), role_case_branch_arrow(), role_param_comma(), role_right_paren(), role_case_pat_list_tail_rbracket()), prev_token_roles: single_role(role_list_type_param()), constraint_id: 204 };
    c_ltr_tail: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_list_tail_rbracket(), next_token_roles: single_role(role_case_branch_arrow()), prev_token_roles: single_role(role_list_type_rbracket()), constraint_id: 215 };
    // Generic call: name [ T,S ] (
    c_cgl: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_gen_lbracket(), next_token_roles: three_roles(role_list_type_param(), role_tuple_type_lparen(), role_memory_type_start()), prev_token_roles: single_role(role_call_name()), constraint_id: 209 };
    c_cgr: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_gen_rbracket(), next_token_roles: single_role(role_call_lparen()), prev_token_roles: single_role(role_list_type_param()), constraint_id: 210 };
    // List literal [ ... ] : List[...]
    c_lli: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_lit_lbracket(), next_token_roles: two_roles(role_operand(), role_list_lit_rbracket()), prev_token_roles: single_role(role_bind_arrow()), constraint_id: 205 };
    c_llc: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_lit_comma(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_operand()), constraint_id: 207 };
    c_llr: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_lit_rbracket(), next_token_roles: single_role(role_stmt_sep()), prev_token_roles: two_roles(role_operand(), role_list_lit_lbracket()), constraint_id: 206 };
    c_llco: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_list_lit_colon(), next_token_roles: single_role(role_list_type_kw()), prev_token_roles: single_role(role_list_lit_rbracket()), constraint_id: 208 };
    // Operand inside [...] literal (narrow next to comma, ], or operator)
    c_op_list: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_operand(), next_token_roles: three_roles(role_list_lit_comma(), role_list_lit_rbracket(), role_op()), prev_token_roles: two_roles(role_list_lit_lbracket(), role_list_lit_comma()), constraint_id: 220 };
    // Case: list pattern start
    c_plb: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_list_lbracket(), next_token_roles: three_roles(role_case_pat_list_empty_rbracket(), role_case_pat_ident(), role_case_pat_int()), prev_token_roles: two_roles(role_case_branch_lbrace(), role_case_branch_stmt_sep()), constraint_id: 211 };
    c_peb: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_list_empty_rbracket(), next_token_roles: single_role(role_case_pat_colon()), prev_token_roles: single_role(role_case_pat_list_lbracket()), constraint_id: 212 };
    c_plc: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_list_comma(), next_token_roles: three_roles(role_case_pat_ident(), role_case_pat_int(), role_case_pat_bool()), prev_token_roles: single_role(role_case_pat_type()), constraint_id: 213 };
    r_pl: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_plc, constraint_core@cons_constraint(c_peb, constraint_core@cons_constraint(c_plb, constraint_core@empty_list_constraint())));
    r_lit: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_op_list, constraint_core@cons_constraint(c_llco, constraint_core@cons_constraint(c_llr, constraint_core@cons_constraint(c_llc, constraint_core@cons_constraint(c_lli, constraint_core@empty_list_constraint())))));
    r_gen: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_cgr, constraint_core@cons_constraint(c_cgl, constraint_core@empty_list_constraint()));
    r_type: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_ltr_tail, constraint_core@cons_constraint(c_ltr, constraint_core@cons_constraint(c_ltc, constraint_core@cons_constraint(c_ltp, constraint_core@cons_constraint(c_llb, constraint_core@cons_constraint(c_lkw, constraint_core@empty_list_constraint()))))));
    constraint_core@append_list_constraint(r_type, constraint_core@append_list_constraint(r_gen, constraint_core@append_list_constraint(r_lit, r_pl)))
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_list_keyword() of {
        true -> single_role(role_list_type_kw());
        false -> case token_kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> four_roles(role_list_type_lbracket(), role_list_lit_lbracket(), role_call_gen_lbracket(), role_case_pat_list_lbracket());
            false -> case token_kind == lexer_token_kind@token_kind_right_bracket() of {
                true -> five_roles(role_list_type_rbracket(), role_list_lit_rbracket(), role_call_gen_rbracket(), role_case_pat_list_empty_rbracket(), role_case_pat_list_tail_rbracket());
                false -> case token_kind == lexer_token_kind@token_kind_comma() of {
                    true -> two_roles(role_list_type_comma(), role_list_lit_comma());
                    false -> case token_kind == lexer_token_kind@token_kind_colon() of {
                        true -> single_role(role_list_lit_colon());
                        false -> case token_kind == lexer_token_kind@token_kind_semicolon() of {
                            true -> single_role(role_stmt_sep());
                            false -> case is_type_keyword_for_list_param(token_kind) of {
                                true -> single_role(role_list_type_param());
                                false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
                                    true -> single_role(role_list_type_param());
                                    false -> constraint_core@empty_list_int()
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
