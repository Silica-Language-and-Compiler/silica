// Capability: ( ident, ident, ... ) <- expr  or  ( ident: type, ident: type, ... ) <- expr  (tuple decomposition)
// Example: (atom_value, uint64_value) <- some_tuple;
// Example: (a_value:atom, b_value:uint64) <- some_tuple;
// Supports nested tuples: ((a, b), c) <- nested_tuple;
// Elements can be any type, any order, any recursive depth

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_case;
use capability_list;
use capability_bind;

export constraints/0;
export initial_roles/1;
export role_td_lparen/0;
export role_td_rparen/0;

// Role codes for tuple decomposition (50-59). Shared: left_brace 7, role_operand 12.
fn role_td_lparen() -> int64 { 50 }
fn role_td_ident() -> int64 { 51 }
fn role_td_comma() -> int64 { 52 }
fn role_td_rparen() -> int64 { 53 }
fn role_td_arrow() -> int64 { 54 }
fn role_td_colon() -> int64 { 56 }
fn role_td_type() -> int64 { 57 }
fn role_right_brace() -> int64 { 8 }
fn role_stmt_sep() -> int64 { 55 }
fn role_left_brace() -> int64 { 7 }
fn role_operand() -> int64 { 12 }
fn role_call_rparen() -> int64 { 16 }
fn role_bind_arrow() -> int64 { 43 }
fn role_atom_literal() -> int64 { 17 }
fn role_bind_ident() -> int64 { 40 }
fn role_call_name() -> int64 { 14 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

// role_tuple_type_rparen (45): whole-pattern `(p): (T1, T2) <-` — <- is td_arrow after type tuple closing paren.
fn role_tuple_type_rparen_for_td_arrow() -> int64 { 45 }

fn eight_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64, r8: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, constraint_core@cons_int(r2, constraint_core@cons_int(r3, constraint_core@cons_int(r4, four_roles(r5, r6, r7, r8)))))
}

fn nine_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64, rest: { r8: int64, r9: int64 }) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, eight_roles(r2, r3, r4, r5, r6, r7, rest.r8, rest.r9))
}

fn ten_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64, rest: { r8: int64, r9: int64, r10: int64 }) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, nine_roles(r2, r3, r4, r5, r6, r7, rest.r8, { r8: rest.r9, r9: rest.r10 }))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // td_lparen can be preceded by fn_decl left_paren (role 3) for tuple decompose in fn params
    c0b: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_lparen(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: single_role(3), constraint_id: 49 };
    // td_rparen can be followed by fn_decl right_paren (role 4) to close fn params
    c0c: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_rparen(), next_token_roles: single_role(4), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 49 };
    // left_brace can be followed by tuple decomposition (
    c1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_left_brace(), next_token_roles: single_role(role_td_lparen()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 50 };
    // semicolon (stmt_sep): can precede tuple/bind/operand/call or next case branch pattern
    c2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_stmt_sep(), next_token_roles: ten_roles(role_td_lparen(), role_bind_ident(), role_operand(), role_call_name(), capability_case@role_case_pat_int(), capability_case@role_case_pat_ident(), capability_case@role_case_pat_bool(), { r8: capability_case@role_case_pat_atom(), r9: role_right_brace(), r10: capability_list@role_case_pat_list_lbracket() }), prev_token_roles: four_roles(role_operand(), role_call_rparen(), role_bind_arrow(), role_atom_literal()), constraint_id: 51 };
    // td_lparen: ( starts tuple pattern; next is ident, nested (, or atom tag (`:explicit`, …)
    c3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_lparen(), next_token_roles: three_roles(role_td_ident(), role_td_lparen(), capability_case@role_case_pat_atom()), prev_token_roles: three_roles(role_left_brace(), role_stmt_sep(), capability_case@role_case_branch_lbrace()), constraint_id: 52 };
    // td_ident: identifier in pattern; next is comma, ), or colon (for ident: type)
    c4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_ident(), next_token_roles: three_roles(role_td_comma(), role_td_rparen(), role_td_colon()), prev_token_roles: two_roles(role_td_lparen(), role_td_comma()), constraint_id: 53 };
    // td_colon: after ident in typed pattern, or after whole-pattern `)` for `(p): (T1, T2) <- rhs`
    c4b: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_colon(), next_token_roles: three_roles(role_td_type(), role_td_lparen(), capability_bind@role_tuple_type_lparen()), prev_token_roles: two_roles(role_td_ident(), role_td_rparen()), constraint_id: 53 };
    // td_type: type keyword or tuple type; next is comma or )
    c4c: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_type(), next_token_roles: two_roles(role_td_comma(), role_td_rparen()), prev_token_roles: two_roles(role_td_colon(), role_td_lparen()), constraint_id: 53 };
    // td_comma: comma in pattern; next is ident or nested (; prev is ident, type, or )
    c5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_comma(), next_token_roles: three_roles(role_td_ident(), role_td_lparen(), capability_case@role_case_pat_atom()), prev_token_roles: four_roles(role_td_ident(), role_td_type(), role_td_rparen(), capability_case@role_case_pat_atom()), constraint_id: 54 };
    // Atom tag in tuple pattern: `(:explicit, r)` — role_case_pat_atom (127) after `(` or `,`
    c5b: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: capability_case@role_case_pat_atom(), next_token_roles: two_roles(role_td_comma(), role_td_rparen()), prev_token_roles: two_roles(role_td_lparen(), role_td_comma()), constraint_id: 60 };
    // td_rparen: ) ends pattern; next is <-, whole-pattern `:`, comma (nested), ) (nested call), } (end of block) or case `->`
    c6: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_rparen(), next_token_roles: six_roles(role_td_arrow(), role_td_colon(), role_td_comma(), role_call_rparen(), role_right_brace(), capability_case@role_case_branch_arrow()), prev_token_roles: four_roles(role_td_ident(), role_td_type(), role_td_rparen(), capability_case@role_case_pat_atom()), constraint_id: 55 };
    // td_arrow: <- after pattern or after whole-pattern tuple type; next is RHS operand
    c7: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_arrow(), next_token_roles: single_role(role_operand()), prev_token_roles: two_roles(role_td_rparen(), role_tuple_type_rparen_for_td_arrow()), constraint_id: 56 };
    c8: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_arrow(), next_token_roles: single_role(role_operand()), prev_token_roles: two_roles(role_td_rparen(), role_tuple_type_rparen_for_td_arrow()), constraint_id: 57 };
    c9: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_arrow(), next_token_roles: single_role(role_operand()), prev_token_roles: two_roles(role_td_rparen(), role_tuple_type_rparen_for_td_arrow()), constraint_id: 58 };
    c10: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_td_arrow(), next_token_roles: single_role(role_operand()), prev_token_roles: two_roles(role_td_rparen(), role_tuple_type_rparen_for_td_arrow()), constraint_id: 59 };
    r10: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c10, constraint_core@empty_list_constraint());
    r9: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c9, r10);
    r8: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c8, r9);
    r7: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c7, r8);
    r6: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c6, r7);
    r5b: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c5b, r6);
    r5: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c5, r5b);
    r4c: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c4c, r5);
    r4b: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c4b, r4c);
    r4: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c4, r4b);
    r3: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c3, r4);
    r2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c2, r3);
    r1: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c1, r2);
    r0c: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c0c, r1);
    constraint_core@cons_constraint(c0b, r0c)
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_left_paren() of {
        true -> single_role(role_td_lparen());
        false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
            true -> single_role(role_td_ident());
            false -> case token_kind == lexer_token_kind@token_kind_colon() of {
                true -> single_role(role_td_colon());
                false -> case token_kind == lexer_token_kind@token_kind_comma() of {
                    true -> single_role(role_td_comma());
                    false -> case token_kind == lexer_token_kind@token_kind_right_paren() of {
                        true -> single_role(role_td_rparen());
                        false -> case token_kind == lexer_token_kind@token_kind_left_arrow() of {
                            true -> single_role(role_td_arrow());
                            false -> case token_kind == lexer_token_kind@token_kind_semicolon() of {
                                true -> single_role(role_stmt_sep());
                                false -> case is_type_token(token_kind) of {
                                    true -> single_role(role_td_type());
                                    false -> constraint_core@empty_list_int()
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn is_type_token(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_int8_keyword() or token_kind == lexer_token_kind@token_kind_int16_keyword() or token_kind == lexer_token_kind@token_kind_int32_keyword() or token_kind == lexer_token_kind@token_kind_int64_keyword() or token_kind == lexer_token_kind@token_kind_uint8_keyword() or token_kind == lexer_token_kind@token_kind_uint16_keyword() or token_kind == lexer_token_kind@token_kind_uint32_keyword() or token_kind == lexer_token_kind@token_kind_uint64_keyword() or token_kind == lexer_token_kind@token_kind_float16_keyword() or token_kind == lexer_token_kind@token_kind_float32_keyword() or token_kind == lexer_token_kind@token_kind_float64_keyword() or token_kind == lexer_token_kind@token_kind_bool_keyword() or token_kind == lexer_token_kind@token_kind_char_keyword() or token_kind == lexer_token_kind@token_kind_string_keyword() or token_kind == lexer_token_kind@token_kind_bytes_keyword() or token_kind == lexer_token_kind@token_kind_atom_keyword()
}
