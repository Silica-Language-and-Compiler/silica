// Capability: atom literal as expression
// Atom literals (:ok, :error, etc.) as body_expr and operand

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes: 9 body_expr (shared), 12 operand (from expr_int64_ops), 17 atom_literal
// 7 left_brace, 8 right_brace from fn_decl (prev/next for body context)
// 50, 52, 53: role_td_lparen / role_td_comma / role_td_rparen (capability_tuple_decompose) for
// case-branch tuple patterns and failure_reason variants (§15.4.11.2), e.g. `(:explicit, r)`.
// 15 call_lparen, 16 call_rparen (capability_expr_int64_ops): allow atom literals as call
// arguments, e.g. spawn(init, beh, :name), call(ref, msg, :name), cast(ref, msg, :name).
// 21 effect_comma (capability_fn_decl), 28 param_comma (capability_fn_decl): allow atoms
// before or after a call-argument comma so constraint propagation does not assign empty roles
// to the surrounding comma and closing paren when the atom is in a call-arg position.
// 13 op (capability_expr_int64_ops): atoms as operands of <, >, <=, >=, ==, !=, +, -, etc.
fn role_body_expr() -> int64 { 9 }
fn role_operand() -> int64 { 12 }
fn role_atom_literal() -> int64 { 17 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_td_lparen() -> int64 { 50 }
fn role_td_comma() -> int64 { 52 }
fn role_td_rparen() -> int64 { 53 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_effect_comma() -> int64 { 21 }
fn role_param_comma() -> int64 { 28 }
fn role_op() -> int64 { 13 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

fn seven_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, six_roles(r2, r3, r4, r5, r6, r7))
}

fn eight_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64, r8: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, seven_roles(r2, r3, r4, r5, r6, r7, r8))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // atom_literal: `{ :ok }`, tuple atoms `( :tag , x )`, call args `f(:name)`, and operands
    // next to binary ops e.g. `:a < :b`, `:ok >= :fail` (constraint_core: next/prev = later/earlier in source).
    //
    // next_token_roles — token AFTER atom:
    //   right_brace, td_*, call_lparen, effect_comma, param_comma, op(13)
    // prev_token_roles — token BEFORE atom:
    //   left_brace, td_*, operand, call_rparen, effect_comma, param_comma, op(13)
    c: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { 
        trigger_role: role_atom_literal(),
        next_token_roles: seven_roles(role_right_brace(), role_td_comma(), role_td_rparen(), role_call_lparen(), role_effect_comma(), role_param_comma(), role_op()),
        prev_token_roles: eight_roles(role_left_brace(), role_td_lparen(), role_td_comma(), role_operand(), role_call_rparen(), role_effect_comma(), role_param_comma(), role_op()),
        constraint_id: 17
    };
    constraint_core@cons_constraint(c, constraint_core@empty_list_constraint())
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_atom_literal() of {
        true -> three_roles(role_atom_literal(), role_body_expr(), role_operand());
        false -> constraint_core@empty_list_int()
    }
}
