// Parser capability: design_documents/supervisors_implementation_development_plan.md
// Phase B (ingress + scheduler ordering, §15.4.9, §16.2.2): token-kind queries only.
// Phase C (exit notification / §15.4.10–11): user matching uses `failure_reason`, `actor_ref`, atom
// patterns — see capability_case (role_case_pat_atom), capability_tuple_decompose (`(:explicit, r)`),
// capability_expr_atom, lexer failure_reason_keyword.
// Phase D (Supervisor trait, §15.4.13): trait file parsing in capability_trait + capability_actors;
// token-kind grouping in lexer_supervisor_phases. Empty constraints/initial_roles here.
// Phase E (declarative child_spec + automatic restart, §15.4.12–15.4.13.2, §15.4.13.3): same
// `supervisor_flags` / `child_spec` / `List[..., normal]` / `spawn_linked` surface as Phase D; runtime
// applies restart (parser uses atom/int/record/paren/callable tokens only — lexer_supervisor_phases E).
// Phase F (FailureReporter + unwind, §15.4.11.4, §15.4.13.4–13.6): `trait FailureReporter` uses the
// same trait/capability_module paths as Phase D; `String` / `bytes` / atom tuple lists use
// string_keyword / bytes_keyword / atom_keyword — token-kind query only (lexer_supervisor_phases F).
// Phase G (§15.4.8.4–§15.4.8.7 link/monitor/demonitor, DOWN to standard mailbox): lexer_supervisor_phases G.

use lexer_token_kind;
use lexer_supervisor_phases;
use constraint_core;

export constraints/0;
export initial_roles/1;
export supervisor_jsonld_phase_b_ingress_ordering_token_kind/1;
export supervisor_jsonld_phase_c_failure_payload_token_kind/1;
export supervisor_jsonld_phase_d_supervisor_trait_token_kind/1;
export supervisor_jsonld_phase_e_automatic_restart_token_kind/1;
export supervisor_jsonld_phase_f_failure_reporter_token_kind/1;
export supervisor_jsonld_phase_g_link_monitor_down_token_kind/1;

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    constraint_core@empty_list_constraint()
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
    constraint_core@empty_list_int()
}

fn supervisor_jsonld_phase_b_ingress_ordering_token_kind(k: int64) -> boolean {
        lexer_supervisor_phases@token_kind_supervisor_phase_b_ingress_ordering(k)
}

fn supervisor_jsonld_phase_c_failure_payload_token_kind(k: int64) -> boolean {
        lexer_supervisor_phases@token_kind_supervisor_phase_c_failure_payload(k)
}

fn supervisor_jsonld_phase_d_supervisor_trait_token_kind(k: int64) -> boolean {
        lexer_supervisor_phases@token_kind_supervisor_phase_d_supervisor_trait_surface(k)
}

fn supervisor_jsonld_phase_e_automatic_restart_token_kind(k: int64) -> boolean {
        lexer_supervisor_phases@token_kind_supervisor_phase_e_automatic_restart_surface(k)
}

fn supervisor_jsonld_phase_f_failure_reporter_token_kind(k: int64) -> boolean {
        lexer_supervisor_phases@token_kind_supervisor_phase_f_failure_reporter_surface(k)
}

fn supervisor_jsonld_phase_g_link_monitor_down_token_kind(k: int64) -> boolean {
        lexer_supervisor_phases@token_kind_supervisor_phase_g_link_monitor_down_surface(k)
}
