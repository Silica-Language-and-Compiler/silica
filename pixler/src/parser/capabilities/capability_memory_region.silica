// Capability: memory region types - ref(R, Space, T), region(R, Space), buf(R, Space, T, N); atomic uses ref(R, atomic, T)
// Supports: bindings, function return types, function parameters
// Memory space keywords: normal, normal_writeback, normal_writethrough, normal_noncacheable, atomic, device

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes for memory region (60-68). Integrates with bind's role_bind_type (42), role_tuple_type_lparen (44).
// role_memory_type_start: ref, region, buf as type constructors
// role_atomic_prefix: "atomic ref" parses as ref(R, Space, T) (Space often atomic)
fn role_memory_type_start() -> int64 { 60 }
fn role_atomic_prefix() -> int64 { 61 }
fn role_tuple_type_lparen() -> int64 { 44 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // ref/region/buf (role_memory_type_start) must be followed by ( to open params
    c1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_memory_type_start(), next_token_roles: single_role(role_tuple_type_lparen()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 60 };
    // atomic (role_atomic_prefix) must be followed by ref (role_memory_type_start)
    c2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_atomic_prefix(), next_token_roles: single_role(role_memory_type_start()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 61 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c2, constraint_core@empty_list_constraint()))
}

fn is_memory_space_keyword(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword()
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_ref_keyword() of {
        true -> single_role(role_memory_type_start());
        false -> case token_kind == lexer_token_kind@token_kind_region_keyword() of {
            true -> single_role(role_memory_type_start());
            false -> case token_kind == lexer_token_kind@token_kind_buf_keyword() of {
                true -> single_role(role_memory_type_start());
                false -> case token_kind == lexer_token_kind@token_kind_atomic_keyword() of {
                    true -> single_role(role_atomic_prefix());
                    false -> case is_memory_space_keyword(token_kind) of {
                        true -> single_role(42);
                        false -> constraint_core@empty_list_int()
                    }
                }
            }
        }
    }
}
