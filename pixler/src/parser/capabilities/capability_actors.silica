// Actors (silica-specification §3.3 postfix impl ActorMessage, §3.4.9 impl_actor_message_decl,
// §4.5 actor_ref, §15 spawn/spawn_linked/link/monitor/demonitor/send/cast/call, §15.2 / appendix CPU affinity runtime helpers, placement keywords).
// { source: string, position: int64, line: int64, column: int64, file: string } exposes actor/spawn/spawn_linked/link/monitor/demonitor/send/cast/self/recv, register_actor, pin_actor_*/unpin/remove/set_priority/get_cpu_topology/get_*_cores/get_core_capabilities, impl/for, placement kinds.
// Phase C (cpu_topology_implementation_plan): spawn(..., ..., core_id) third argument is a uint64 (or core_id(uint64)); same expr/call grammar as other commas.
// Phase A (supervisors_implementation_development_plan.md): spawn_linked(initial_state, behavior_fn, agent_type [, core_id]) uses the same call/argument-list roles as spawn (§15.4.8.3).
// Phase B: link/monitor/demonitor (§15.4.8.5–§15.4.8.7) share the same call-name + operand lexer/parser roles as spawn/send/cast for ingress vs standard mailbox trials.
// Comma + call_name propagation is shared with capability_expr_int64_ops / capability_expr_float32 (role_comma, role_call_name).

use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

fn role_actor_impl_kw() -> int64 { 215 }
fn role_actor_impl_trait_name() -> int64 { 216 }
fn role_actor_impl_for_kw() -> int64 { 217 }

fn role_fn_keyword() -> int64 { 1 }
fn role_type_name() -> int64 { 6 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_operand() -> int64 { 12 }
fn role_call_name() -> int64 { 14 }
fn role_call_rparen() -> int64 { 16 }
fn role_comma_param() -> int64 { 17 }
fn role_param_type() -> int64 { 27 }
fn role_stmt_sep() -> int64 { 55 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    c_post1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_operand(), next_token_roles: single_role(role_actor_impl_kw()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 400 };
    c_post2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_call_rparen(), next_token_roles: single_role(role_actor_impl_kw()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 401 };
    // After `;` or end of block: next stmt may be `impl`, top-level `fn`, or closing `}` (trait required/provided sections).
    c_stmt_impl: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_stmt_sep(), next_token_roles: three_roles(role_actor_impl_kw(), role_fn_keyword(), role_right_brace()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 402 };
    c_rb_impl: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_right_brace(), next_token_roles: single_role(role_actor_impl_kw()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 403 };
    // `impl Trait` (actor) vs `impl fn` (trait implementation): second token is identifier vs fn.
    c_impl_trait: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_actor_impl_kw(), next_token_roles: two_roles(role_actor_impl_trait_name(), role_fn_keyword()), prev_token_roles: four_roles(role_operand(), role_call_rparen(), role_stmt_sep(), role_right_brace()), constraint_id: 404 };
    // After trait name: "for" (top-level), marker brace, end of arg ), comma, or ; only if mistaken parse paths eliminated elsewhere
    c_trait_next: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_actor_impl_trait_name(), next_token_roles: five_roles(role_actor_impl_for_kw(), role_left_brace(), role_call_rparen(), role_comma_param(), role_stmt_sep()), prev_token_roles: single_role(role_actor_impl_kw()), constraint_id: 405 };
    c_for_type: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_actor_impl_for_kw(), next_token_roles: two_roles(role_type_name(), role_param_type()), prev_token_roles: single_role(role_actor_impl_trait_name()), constraint_id: 406 };
    c_impl_type_next: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_param_type(), next_token_roles: three_roles(role_stmt_sep(), role_left_brace(), role_call_rparen()), prev_token_roles: single_role(role_actor_impl_for_kw()), constraint_id: 407 };
    c_impl_type_next_tn: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_type_name(), next_token_roles: three_roles(role_stmt_sep(), role_left_brace(), role_call_rparen()), prev_token_roles: single_role(role_actor_impl_for_kw()), constraint_id: 408 };
    c_semi_after_impl_type: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_stmt_sep(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: two_roles(role_param_type(), role_type_name()), constraint_id: 409 };
    constraint_core@cons_constraint(c_post1, constraint_core@cons_constraint(c_post2, constraint_core@cons_constraint(c_stmt_impl, constraint_core@cons_constraint(c_rb_impl, constraint_core@cons_constraint(c_impl_trait, constraint_core@cons_constraint(c_trait_next, constraint_core@cons_constraint(c_for_type, constraint_core@cons_constraint(c_impl_type_next, constraint_core@cons_constraint(c_impl_type_next_tn, constraint_core@cons_constraint(c_semi_after_impl_type, constraint_core@empty_list_constraint()))))))))))
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_impl_keyword() of {
        true -> single_role(role_actor_impl_kw());
        false -> case token_kind == lexer_token_kind@token_kind_for_keyword() of {
            true -> single_role(role_actor_impl_for_kw());
            false -> case token_kind == lexer_token_kind@token_kind_spawn_keyword() or token_kind == lexer_token_kind@token_kind_spawn_dangerous_keyword() or token_kind == lexer_token_kind@token_kind_spawn_dangerous_registered_keyword() or token_kind == lexer_token_kind@token_kind_spawn_device_keyword() or token_kind == lexer_token_kind@token_kind_spawn_device_registered_keyword() or token_kind == lexer_token_kind@token_kind_spawn_registered_keyword() or token_kind == lexer_token_kind@token_kind_spawn_registered_supervisor_keyword() or token_kind == lexer_token_kind@token_kind_spawn_linked_keyword() or token_kind == lexer_token_kind@token_kind_call_supervisor_keyword() or token_kind == lexer_token_kind@token_kind_link_keyword() or token_kind == lexer_token_kind@token_kind_monitor_keyword() or token_kind == lexer_token_kind@token_kind_demonitor_keyword() of {
                true -> two_roles(role_call_name(), role_operand());
                false -> case token_kind == lexer_token_kind@token_kind_send_keyword() of {
                    true -> two_roles(role_call_name(), role_operand());
                    false -> case token_kind == lexer_token_kind@token_kind_cast_keyword() of {
                        true -> two_roles(role_call_name(), role_operand());
                        false -> case token_kind == lexer_token_kind@token_kind_self_keyword() of {
                            true -> two_roles(role_call_name(), role_operand());
                            false -> case token_kind == lexer_token_kind@token_kind_recv_keyword() of {
                                true -> two_roles(role_call_name(), role_operand());
                                false -> case lexer_token_kind@is_actor_runtime_helper_kind(token_kind) of {
                                    true -> two_roles(role_call_name(), role_operand());
                                    false -> case token_kind == lexer_token_kind@token_kind_performance_cores_keyword() of {
                                        true -> single_role(role_operand());
                                        false -> case token_kind == lexer_token_kind@token_kind_efficiency_cores_keyword() of {
                                            true -> single_role(role_operand());
                                            false -> case token_kind == lexer_token_kind@token_kind_core_id_keyword() of {
                                                true -> two_roles(role_call_name(), role_operand());
                                                false -> case token_kind == lexer_token_kind@token_kind_core_set_keyword() of {
                                                    true -> two_roles(role_call_name(), role_operand());
                                                    false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
                                                        true -> single_role(role_actor_impl_trait_name());
                                                        false -> constraint_core@empty_list_int()
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
