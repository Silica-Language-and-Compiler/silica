// Capability: module system surface syntax (silica-specification §3.4.4–3.4.5, §3.4.10, §19)
// use a, b;   export f/1, g/2;   module name;

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes (module-only; merged with other capabilities at propagation)
fn role_use_kw() -> int64 { 220 }
fn role_use_mod_name() -> int64 { 221 }
fn role_use_comma() -> int64 { 222 }
fn role_use_semi() -> int64 { 223 }
fn role_export_kw() -> int64 { 224 }
fn role_export_fn_name() -> int64 { 225 }
fn role_export_slash() -> int64 { 226 }
fn role_export_arity() -> int64 { 227 }
fn role_export_comma() -> int64 { 228 }
fn role_export_semi() -> int64 { 229 }
fn role_module_kw() -> int64 { 230 }
fn role_module_name() -> int64 { 231 }
fn role_module_semi() -> int64 { 232 }
// export trait Name; — `trait` and trait name roles (silica-specification §3.4.8)
fn role_export_trait_mid() -> int64 { 235 }
fn role_trait_export_name() -> int64 { 236 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn no_prev() -> List[int64, mem(normal)] {
    constraint_core@empty_list_int()
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    u1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_use_kw(), next_token_roles: single_role(role_use_mod_name()), prev_token_roles: no_prev(), constraint_id: 240 };
    u2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_use_mod_name(), next_token_roles: two_roles(role_use_comma(), role_use_semi()), prev_token_roles: two_roles(role_use_kw(), role_use_comma()), constraint_id: 241 };
    u3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_use_comma(), next_token_roles: single_role(role_use_mod_name()), prev_token_roles: single_role(role_use_mod_name()), constraint_id: 242 };
    u4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_use_semi(), next_token_roles: no_prev(), prev_token_roles: single_role(role_use_mod_name()), constraint_id: 243 };
    e1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_export_kw(), next_token_roles: two_roles(role_export_fn_name(), role_export_trait_mid()), prev_token_roles: no_prev(), constraint_id: 244 };
    et1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_export_trait_mid(), next_token_roles: single_role(role_trait_export_name()), prev_token_roles: single_role(role_export_kw()), constraint_id: 253 };
    et2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_trait_export_name(), next_token_roles: single_role(role_export_semi()), prev_token_roles: single_role(role_export_trait_mid()), constraint_id: 254 };
    e2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_export_fn_name(), next_token_roles: single_role(role_export_slash()), prev_token_roles: two_roles(role_export_kw(), role_export_comma()), constraint_id: 245 };
    e3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_export_slash(), next_token_roles: single_role(role_export_arity()), prev_token_roles: single_role(role_export_fn_name()), constraint_id: 246 };
    e4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_export_arity(), next_token_roles: two_roles(role_export_comma(), role_export_semi()), prev_token_roles: single_role(role_export_slash()), constraint_id: 247 };
    e5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_export_comma(), next_token_roles: single_role(role_export_fn_name()), prev_token_roles: single_role(role_export_arity()), constraint_id: 248 };
    e6: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_export_semi(), next_token_roles: no_prev(), prev_token_roles: two_roles(role_export_arity(), role_trait_export_name()), constraint_id: 249 };
    m1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_module_kw(), next_token_roles: single_role(role_module_name()), prev_token_roles: no_prev(), constraint_id: 250 };
    m2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_module_name(), next_token_roles: single_role(role_module_semi()), prev_token_roles: single_role(role_module_kw()), constraint_id: 251 };
    m3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_module_semi(), next_token_roles: no_prev(), prev_token_roles: single_role(role_module_name()), constraint_id: 252 };
    tail_m: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(m3, constraint_core@empty_list_constraint());
    tail_m2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(m2, tail_m);
    tail_m1: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(m1, tail_m2);
    tail_e6: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(e6, tail_m1);
    tail_e5: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(e5, tail_e6);
    tail_e4: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(e4, tail_e5);
    tail_e3: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(e3, tail_e4);
    tail_e2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(e2, tail_e3);
    tail_e1: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(e1, tail_e2);
    tail_et2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(et2, tail_e1);
    tail_et1: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(et1, tail_et2);
    tail_u4: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(u4, tail_et1);
    tail_u3: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(u3, tail_u4);
    tail_u2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(u2, tail_u3);
    constraint_core@cons_constraint(u1, tail_u2)
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_use_keyword() of {
        true -> single_role(role_use_kw());
        false -> case token_kind == lexer_token_kind@token_kind_export_keyword() of {
            true -> single_role(role_export_kw());
            false -> case token_kind == lexer_token_kind@token_kind_trait_keyword() of {
                true -> single_role(role_export_trait_mid());
                false -> case token_kind == lexer_token_kind@token_kind_module_keyword() of {
                    true -> single_role(role_module_kw());
                    false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
                    true -> four_roles(role_use_mod_name(), role_export_fn_name(), role_trait_export_name(), role_module_name());
                    false -> case token_kind == lexer_token_kind@token_kind_comma() of {
                        true -> two_roles(role_use_comma(), role_export_comma());
                        false -> case token_kind == lexer_token_kind@token_kind_semicolon() of {
                            true -> three_roles(role_use_semi(), role_export_semi(), role_module_semi());
                            false -> case token_kind == lexer_token_kind@token_kind_slash() of {
                                true -> single_role(role_export_slash());
                                false -> case token_kind == lexer_token_kind@token_kind_integer_literal() of {
                                    true -> single_role(role_export_arity());
                                    false -> constraint_core@empty_list_int()
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
