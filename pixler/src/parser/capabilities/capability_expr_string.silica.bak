// Capability: string literal as expression
// String literals ("hello", etc.) as body_expr
// Per language spec §2.2: string_literal ::= "\"" {character | escape_sequence} "\""
// Lexer produces string_literal token (kind 75)

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes: 9 body_expr (shared), 12 operand (from expr_int64_ops), 18 string_literal
// 7 left_brace, 8 right_brace from fn_decl; 15 call_lparen, 16 call_rparen from expr_int64_ops
fn role_body_expr() -> int64 { 9 }
fn role_operand() -> int64 { 12 }
fn role_string_literal() -> int64 { 18 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn constraints() -> ListConstraint {
    // string_literal (as body_expr) -> next must be right_brace; prev must be left_brace
    c: Constraint <- Constraint { trigger_role: role_string_literal(), next_token_roles: single_role(role_right_brace()), prev_token_roles: single_role(role_left_brace()), constraint_id: 18 };
    constraint_core@cons_constraint(c, constraint_core@empty_list_constraint())
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.string_literal of {
        true -> three_roles(role_string_literal(), role_body_expr(), role_operand());
        false -> constraint_core@empty_list_int()
    }
}
