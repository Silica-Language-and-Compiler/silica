// Lambda lifting: free-variable capture and synthetic top-level functions.

use parser_ast;
use atom_table;
use constraint_extract_decls;

export lift_lambda_expressions/1;



// --- Lambda lifting: outer-visible bindings (let + outer lambda formals) for capture params ---

fn append_tb_front(a: List[{ name: string, path: string, type_str: string }, mem(normal)], b: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(a.head.name, a.head.path, a.head.type_str), append_tb_front(a.tail, b))
    }
}



fn merge_tb_union(a: List[{ name: string, path: string, type_str: string }, mem(normal)], b: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(a.head.name, a.head.path, a.head.type_str), merge_tb_union(a.tail, b))
    }
}



fn tuple_bindings_contains_name(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], nm: string) -> boolean {
    case bindings.is_nil of {
        true -> false;
        false -> case bindings.head.name == nm of {
            true -> true;
            false -> tuple_bindings_contains_name(bindings.tail, nm)
        }
    }
}



fn lookup_outer_binding_type(outer_visible: List[{ name: string, path: string, type_str: string }, mem(normal)], nm: string) -> string {
    case outer_visible.is_nil of {
        true -> "";
        false -> case outer_visible.head.name == nm of {
            true -> outer_visible.head.type_str;
            false -> lookup_outer_binding_type(outer_visible.tail, nm)
        }
    }
}



fn reverse_tb_loop(tb: List[{ name: string, path: string, type_str: string }, mem(normal)], acc: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case tb.is_nil of {
        true -> acc;
        false -> reverse_tb_loop(tb.tail, parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(tb.head.name, tb.head.path, tb.head.type_str), acc))
    }
}



fn dedupe_tb_unique_first(tb: List[{ name: string, path: string, type_str: string }, mem(normal)], acc: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case tb.is_nil of {
        true -> reverse_tb_loop(acc, parser_ast@nil_tuple_decompose_bindings());
        false -> case tuple_bindings_contains_name(acc, tb.head.name) of {
            true -> dedupe_tb_unique_first(tb.tail, acc);
            false -> dedupe_tb_unique_first(tb.tail, parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(tb.head.name, tb.head.path, tb.head.type_str), acc))
        }
    }
}



// Capture parameters carry the lambda literal's own (non-zero) location; the formals, rebuilt from the
// literal's bindings, keep the zero location. constraint_extract_hof_wrap counts the formals by that
// (count_lambda_formal_params) to wrap a capturing literal sent as an actor message.
fn capture_tb_to_params(tb: List[{ name: string, path: string, type_str: string }, mem(normal)], loc: { file: string, line: int64, column: int64, offset: int64 }) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case tb.is_nil of {
        true -> parser_ast@nil_list_param();
        false -> parser_ast@cons_param(parser_ast@rebuild_param(tb.head.name, tb.head.type_str, loc), capture_tb_to_params(tb.tail, loc))
    }
}



fn is_discard_let_name(nm: string) -> boolean {
    nm == "_"
}



// The names a sequence's statement chain binds (kind 6 lets and kind 10 tuple decompositions along
// the chain's right spine), latest first in front of acc, as the chain's own walk extends its scope.
fn sequence_chain_bindings(chain: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case chain.root < 0 of {
        true -> acc;
        false -> case parser_ast@expr_root_kind(chain) == 6 of {
            true -> {
                ext: List[{ name: string, path: string, type_str: string }, mem(normal)] <- case is_discard_let_name(parser_ast@expr_root_name(chain)) of {
                    true -> acc;
                    false -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(parser_ast@expr_root_name(chain), "", parser_ast@expr_root_value(chain)), acc)
                };
                sequence_chain_bindings(parser_ast@expr_at(chain, parser_ast@expr_root_right(chain)), ext)
            };
            false -> case parser_ast@expr_root_kind(chain) == 10 of {
                true -> sequence_chain_bindings(parser_ast@expr_at(chain, parser_ast@expr_root_right(chain)), append_tb_front(parser_ast@rebuild_tuple_decompose_binding_list(parser_ast@expr_root_node(chain).pattern_bindings), acc));
                false -> acc
            }
        }
    }
}



// Free variables that must be captured from enclosing scope for a lambda body (lexical closures).
fn collect_free_for_lambda(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, lambda_formals: List[{ name: string, path: string, type_str: string }, mem(normal)], inner_lets: List[{ name: string, path: string, type_str: string }, mem(normal)], outer_visible: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case expr.root < 0 of {
        true -> parser_ast@nil_tuple_decompose_bindings();
        false -> case parser_ast@expr_root_kind(expr) == 991 of {
            true -> collect_free_for_lambda(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), parser_ast@expr_root_node(expr).pattern_bindings, parser_ast@nil_tuple_decompose_bindings(), outer_visible);
            false -> case parser_ast@expr_root_kind(expr) == 6 of {
                true -> {
                    left_tb: List[{ name: string, path: string, type_str: string }, mem(normal)] <- collect_free_for_lambda(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), lambda_formals, inner_lets, outer_visible);
                    ext_inner: List[{ name: string, path: string, type_str: string }, mem(normal)] <- case is_discard_let_name(parser_ast@expr_root_name(expr)) of {
                        true -> inner_lets;
                        false -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(parser_ast@expr_root_name(expr), "", parser_ast@expr_root_value(expr)), inner_lets)
                    };
                    right_tb: List[{ name: string, path: string, type_str: string }, mem(normal)] <- collect_free_for_lambda(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), lambda_formals, ext_inner, outer_visible);
                    merge_tb_union(left_tb, right_tb)
                };
                false -> case parser_ast@expr_root_kind(expr) == 10 of {
                    true -> {
                        inner_tb_td: List[{ name: string, path: string, type_str: string }, mem(normal)] <- collect_free_for_lambda(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), lambda_formals, inner_lets, outer_visible);
                        merged_td: List[{ name: string, path: string, type_str: string }, mem(normal)] <- append_tb_front(parser_ast@rebuild_tuple_decompose_binding_list(parser_ast@expr_root_node(expr).pattern_bindings), inner_lets);
                        right_tb_td: List[{ name: string, path: string, type_str: string }, mem(normal)] <- collect_free_for_lambda(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), lambda_formals, merged_td, outer_visible);
                        merge_tb_union(inner_tb_td, right_tb_td)
                    };
                    false -> case parser_ast@expr_root_kind(expr) == 1 of {
                        true -> {
                            nm: string <- parser_ast@expr_root_name(expr);
                            case tuple_bindings_contains_name(lambda_formals, nm) of {
                                true -> parser_ast@nil_tuple_decompose_bindings();
                                false -> case tuple_bindings_contains_name(inner_lets, nm) of {
                                    true -> parser_ast@nil_tuple_decompose_bindings();
                                    false -> {
                                        cap_ty: string <- lookup_outer_binding_type(outer_visible, nm);
                                        case length_bytes(cap_ty) > 0 of {
                                            true -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(nm, "", cap_ty), parser_ast@nil_tuple_decompose_bindings());
                                            false -> parser_ast@nil_tuple_decompose_bindings()
                                        }
                                    }
                                }
                            }
                        };
                        false -> {
                            lv: List[{ name: string, path: string, type_str: string }, mem(normal)] <- collect_free_for_lambda(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), lambda_formals, inner_lets, outer_visible);
                            right_lets: List[{ name: string, path: string, type_str: string }, mem(normal)] <- case parser_ast@expr_root_kind(expr) == 11 of {
                                true -> sequence_chain_bindings(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), inner_lets);
                                false -> inner_lets
                            };
                            rv: List[{ name: string, path: string, type_str: string }, mem(normal)] <- collect_free_for_lambda(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), lambda_formals, right_lets, outer_visible);
                            merge_tb_union(lv, rv)
                        }
                    }
                }
            }
        }
    }
}



fn lift_lambda_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, fn_name: string, seq: int64, outer_visible: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> { expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], seq: int64 } {
    case expr.root < 0 of {
        true -> { expr: expr, decls: parser_ast@empty_list_decl(), seq: seq };
        false -> case parser_ast@expr_root_kind(expr) == 991 of {
            true -> {
                rebuilt_lam_tb: List[{ name: string, path: string, type_str: string }, mem(normal)] <- parser_ast@rebuild_tuple_decompose_binding_list(parser_ast@expr_root_node(expr).pattern_bindings);
                inner_lift_env: List[{ name: string, path: string, type_str: string }, mem(normal)] <- append_tb_front(rebuilt_lam_tb, outer_visible);
                _lp_body2: { expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], seq: int64 } <- lift_lambda_expr(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), fn_name, seq, inner_lift_env);
                body2: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- _lp_body2.expr;
                l_inner: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- _lp_body2.decls;
                seq1: int64 <- _lp_body2.seq;
                syn: string <- concat(fn_name, concat(".__lam", atom_table@int64_to_decimal_string(seq1)));
                ret_ty: string <- parser_ast@expr_root_value(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr));
                raw_caps: List[{ name: string, path: string, type_str: string }, mem(normal)] <- collect_free_for_lambda(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), rebuilt_lam_tb, parser_ast@nil_tuple_decompose_bindings(), outer_visible);
                caps_tb: List[{ name: string, path: string, type_str: string }, mem(normal)] <- dedupe_tb_unique_first(raw_caps, parser_ast@nil_tuple_decompose_bindings());
                capt_lp: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- capture_tb_to_params(caps_tb, parser_ast@expr_root_node(expr).location);
                decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@declaration_from_lambda_lift(syn, parser_ast@expr_root_node(expr).pattern_bindings, capt_lp, ret_ty, parser_ast@expr_root_node(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr)).location, parser_ast@expr_root_node(expr).location, body2, parser_ast@expr_root_node(expr).sequence_effects);
                dummy_i: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                ident: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(1, "", syn, parser_ast@expr_root_node(expr).location, dummy_i, dummy_i, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                batch: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- parser_ast@cons_declaration(decl, parser_ast@empty_list_decl());
                { expr: ident, decls: constraint_extract_decls@append_declaration_lists(l_inner, batch), seq: seq1 + 1 }
            };
            false -> case parser_ast@expr_root_kind(expr) == 6 of {
                true -> {
                    _lp_i2: { expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], seq: int64 } <- lift_lambda_expr(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), fn_name, seq, outer_visible);
                    i2: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- _lp_i2.expr;
                    li: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- _lp_i2.decls;
                    s1: int64 <- _lp_i2.seq;
                    ext: List[{ name: string, path: string, type_str: string }, mem(normal)] <- case is_discard_let_name(parser_ast@expr_root_name(expr)) of {
                        true -> outer_visible;
