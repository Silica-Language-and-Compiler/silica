// String-list helpers for the compile facade. Small types only.

use module_checker_core;

export compile_order_path/0;
export atom_file_path/0;
export read_atom_file/0;
export shape_file_path/0;
export read_shape_file/0;
export reset_atoms_if_fresh/1;
export needs_runtime_marker_path/0;
export continue_exit_code/0;
export list_string_contains_hygiene/2;
export list_string_cons_unique/2;
export append_list_string_hygiene/2;
export write_paths_file/2;
export clear_reclaim_artifacts/0;
export list_string_length/1;
export use_process_per_unit/1;
export parse_config_lines/3;
export reverse_list_string/1;
export list_contains/2;
export validate_config_files/1;
export validate_config_module_names/1;

fn compile_order_path() -> string {
     "silica.compile.order" 
}

fn needs_runtime_marker_path() -> string {
     "silica.needs_runtime" 
}

fn continue_exit_code() -> int64 {
     75 
}

fn list_string_contains_hygiene(lst: List[string, mem(normal)], s: string) -> boolean {
    case lst.is_nil of {
        true -> false;
        false -> case lst.head == s of {
            true -> true;
            false -> list_string_contains_hygiene(lst.tail, s)
        }
    }
}

fn list_string_cons_unique(s: string, lst: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case list_string_contains_hygiene(lst, s) of {
        true -> lst;
        false -> module_checker_core@cons_string(s, lst)
    }
}

fn append_list_string_hygiene(a: List[string, mem(normal)], b: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> module_checker_core@cons_string(a.head, append_list_string_hygiene(a.tail, b))
    }
}

fn write_paths_file_rec(path: string, paths: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        case paths.is_nil of {
            true -> 0;
            false -> {
                _: boolean <- append_file(path, concat(paths.head, "\n"));
                write_paths_file_rec(path, paths.tail)
            }
        }
        }
    produces
        pure result
    end
}

fn write_paths_file(path: string, paths: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        delete_file(path);
        write_paths_file_rec(path, paths)
        }
    produces
        pure result
    end
}

fn clear_reclaim_artifacts() -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        delete_file(compile_order_path());
        delete_file(needs_runtime_marker_path());
        0
        }
    produces
        pure result
    end
}

fn list_string_length(lst: List[string, mem(normal)]) -> int64 {
    case lst.is_nil of {
        true -> 0;
        false -> 1 + list_string_length(lst.tail)
    }
}

// Large batches (e.g. src) use process-per-unit reclaim; small batches stay in-process
// so compiler stdout matches historical .golden_fail captures.
fn use_process_per_unit(files: List[string, mem(normal)]) -> boolean {
    list_string_length(files) > 32
}

// Parse config: split by newlines, skip empty and # lines, return list (order preserved)
fn parse_config_lines(content: string, start: int64, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case start >= length_bytes(content) of {
        true -> acc;
        false -> {
            line: string <- substring_until_char(content, start, '\n');
            line_len: int64 <- length_bytes(line);
            next_start: int64 <- start + line_len + 1;
            trimmed: string <- trim_leading(line);
            is_comment: boolean <- starts_with(trimmed, "#");
            is_empty: boolean <- length_bytes(trimmed) == 0;
            new_acc: List[string, mem(normal)] <- case is_comment of {
                true -> acc;
                false -> case is_empty of {
                    true -> acc;
                    false -> module_checker_core@cons_string(trimmed, acc)
                }
            };
            parse_config_lines(content, next_start, new_acc)
        }
    }
}

fn trim_leading(s: string) -> string {
    trim_leading_from(s, 0)
}

fn trim_leading_from(s: string, pos: int64) -> string {
    case pos >= length_bytes(s) of {
        true -> "";
        false -> case is_whitespace_at(s, pos) of {
            true -> trim_leading_from(s, pos + 1);
            false -> substring(s, pos, length_bytes(s))
        }
    }
}

fn is_whitespace_at(s: string, pos: int64) -> boolean {
    c: string <- substring(s, pos, pos + 1);
    c == " " or c == "\t" or c == "\n" or c == "\r"
}

fn trim_trailing(s: string) -> string {
    trim_trailing_from(s, length_bytes(s) - 1)
}

fn trim_trailing_from(s: string, pos: int64) -> string {
    case pos < 0 of {
        true -> "";
        false -> case is_whitespace_at(s, pos) of {
            true -> trim_trailing_from(s, pos - 1);
            false -> substring(s, 0, pos + 1)
        }
    }
}

// Reverse a List[string, mem(normal)] (since we cons in reverse order during parse)
fn reverse_list_string(lst: List[string, mem(normal)]) -> List[string, mem(normal)] {
    reverse_list_string_acc(lst, module_checker_core@empty_list_string())
}

fn reverse_list_string_acc(lst: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case lst.is_nil of {
        true -> acc;
        // Stage head/tail/cons before the recursive call: a nested lst.tail plus cons(...)
        // as call args clobbers the cons result (field access loads offsets into X1).
        false -> {
            h: string <- lst.head;
            t: List[string, mem(normal)] <- lst.tail;
            new_acc: List[string, mem(normal)] <- module_checker_core@cons_string(h, acc);
            reverse_list_string_acc(t, new_acc)
        }
    }
}

// Check if list contains string (exact match)
fn list_contains(lst: List[string, mem(normal)], s: string) -> boolean {
    case lst.is_nil of {
        true -> false;
        false -> case lst.head == s of {
            true -> true;
            false -> list_contains(lst.tail, s)
        }
    }
}

// Get file path for module from our file list (module name -> path)
fn validate_config_files(files: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- case files.is_nil of {
            true -> 0;
            false -> {
                exists: boolean <- file_exists(files.head);
                case exists of {
                    true -> validate_config_files(files.tail);
                    false -> {
                        _: int8 <- println(concat("Error: File not found: ", files.head));
                        _: int8 <- println("Check silica.config - the file listed does not exist.");
                        1
                    }
                }
            }
        }
    produces
        pure result
    end
}

// First path in the list (other than `path` itself) whose module name is `mod_name`, or "".
fn config_other_path_for_module(files: List[string, mem(normal)], mod_name: string, path: string) -> string {
    case files.is_nil of {
        true -> "";
        false -> case files.head != path and module_checker_core@module_from_path(files.head) == mod_name of {
            true -> files.head;
            false -> config_other_path_for_module(files.tail, mod_name, path)
        }
    }
}

// Two different files in one build must not share a module name (spec 19.3.1, E4012).
fn validate_config_module_names_loop(files: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- case files.is_nil of {
            true -> 0;
            false -> {
                mod_name: string <- module_checker_core@module_from_path(files.head);
                other: string <- config_other_path_for_module(files.tail, mod_name, files.head);
                case length_bytes(other) == 0 of {
                    true -> validate_config_module_names_loop(files.tail);
                    false -> {
                        _: int8 <- println(concat(concat(concat(concat(concat("Error E4012: two modules named ", mod_name), ": "), files.head), " and "), other));
                        _: int8 <- println("Every file in a build needs a distinct module name (spec 19.3.1).");
                        1
                    }
                }
            }
        }
    produces
        pure result
    end
}

fn validate_config_module_names(files: List[string, mem(normal)]) -> int64 {
    validate_config_module_names_loop(files)
}

// The build-wide atom table: one atom lexeme per line, in index order (runtime prefix first).
fn atom_file_path() -> string {
    "silica.atoms"
}

fn read_atom_file() -> List[string, mem(normal)] {
    sequence proc[DeviceIO]
        present: boolean <- file_exists(atom_file_path());
        content: string <- case present of {
            true -> read_lines(atom_file_path());
            false -> ""
        };
        empty: List[string, mem(normal)] <- module_checker_core@empty_list_string();
        result: List[string, mem(normal)] <- reverse_list_string(parse_config_lines(content, 0, empty))
    produces
        pure result
    end
}

// The build-wide record shapes (emitter record_shape.silica), one canonical type per line, in
// shape-number order: numbered beside the atoms but in their own index space.
fn shape_file_path() -> string {
    "silica.shapes"
}

fn read_shape_file() -> List[string, mem(normal)] {
    sequence proc[DeviceIO]
        present: boolean <- file_exists(shape_file_path());
        content: string <- case present of {
            true -> read_lines(shape_file_path());
            false -> ""
        };
        empty: List[string, mem(normal)] <- module_checker_core@empty_list_string();
        result: List[string, mem(normal)] <- reverse_list_string(parse_config_lines(content, 0, empty))
    produces
        pure result
    end
}

fn unit_sams_path(path: string) -> string {
    n: int64 <- length_bytes(path);
    base: string <- case n > 7 and substring(path, n - 7, n) == ".silica" of {
        true -> substring(path, 0, n - 7);
        false -> path
    };
    concat(base, ".sams")
}

fn any_unit_assembled(units: List[string, mem(normal)]) -> boolean {
    sequence proc[DeviceIO]
        result: boolean <- case units.is_nil of {
            true -> false;
            false -> {
                assembled: boolean <- file_exists(unit_sams_path(units.head));
                case assembled of {
                    true -> true;
                    false -> any_unit_assembled(units.tail)
                }
            }
        }
    produces
        pure result
    end
}

// A batch in which no unit has been assembled yet starts its atom numbering afresh, so a fresh build
// numbers atoms the same way whatever an earlier, unrelated build in this directory left behind.
fn reset_atoms_if_fresh(units: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- case any_unit_assembled(units) of {
            true -> 0;
            false -> {
                delete_file(atom_file_path());
                delete_file(shape_file_path());
                0
            }
        }
    produces
        pure result
    end
}
