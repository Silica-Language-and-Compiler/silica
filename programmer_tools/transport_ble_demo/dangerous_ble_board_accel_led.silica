// The board end of the end-to-end Bluetooth demo (transport_ble_plan.md stage 8): the USB-C demo's board
// program, board/apps/silica_33_transport_usb_serial_jtag_etf, on the (:ble_gatt) carrier. The owner
// opens the carrier on the chip's radio as a peripheral; when the Mac has connected and subscribed
// (:link_up, "mtu:<n>") it encodes (:accel, { x: 1, y: -2, z: 512, at_ms: 1000 }) with ETF, frames it and
// casts it as one :tx. The Mac (dangerous_ble_mac_led, the hosted (:ble_gatt) carrier as central)
// decodes it and answers one LED command, (:led, { which: :red, on: true }); the owner reassembles it
// with wireframe@unframe, decodes it, prints "led red on", closes the carrier and ends after :link_down.
// Expected console: "link up mtu:253", "tx credit 8", "sent 48 bytes", "led red on", "link down :closed",
// status 0.
//
// What differs from the USB-C program: the carrier's declaration (and its name), its reference type and
// send call (an actor_ref and cast, where the USB carrier is a device_actor_ref and cast_device), the
// :open address ("peripheral:"), and the mtu given to wireframe@frame: the link's, from :link_up, where
// the (:serial) kind's is 0. Run through run_accel_led.sh as a guest of ESP-IDF.
use wire_etf;
// spawn_dangerous_carrier adds this `use` implicitly for the compiler; it is written out because the board
// image tooling (trials/targets/board_suite.sh link_closure, board/tools) links a program with the modules its
// source names in `use` lines.
use dangerous_ble_gatt_board_carrier;
use wireframe;
use Carrier;
use Supervisor;

carried_on ble: (:ble_gatt) (:bluetooth, 0);

impl AppSupervisor for Supervisor;

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

// byte_at is a transport operation, called inside a sequence that declares `transport`.
fn at(s: string, i: int64) -> int64 {
    sequence proc[transport]
        b: int64 <- byte_at(s, i)
    produces
        pure b
    end
}

fn digits_from(s: string, i: int64, acc: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> {
            d: int64 <- at(s, i) - 48;
            case d < 0 or d > 9 of {
                true -> acc;
                false -> digits_from(s, i + 1, acc * 10 + d)
            }
        }
    }
}

// The largest segment the link carries, from :link_up's "mtu:<n>" (transport_ble_plan.md §8, decision 5).
fn mtu_of(info: string) -> int64 {
    digits_from(info, 4, 0)
}

// The reading as one framed segment: the link carries segments of up to `mtu` bytes, more than the frame and
// its segment header, so the frame is not cut (at the kind's own mtu, 20, it would be three segments).
fn reading_segment(mtu: int64) -> string {
    sequence proc[mem(normal), transport]
        frame: string <- encode((:etf), (:accel, { x: 1, y: 0 - 2, z: 512, at_ms: 1000 }));
        segs: List[string, mem(normal)] <- wireframe@frame(frame, mtu, Carrier@boundaries(ble));
        seg: string <- first_segment(segs)
    produces
        pure seg
    end
}

fn show_led(cmd: { which: :single | :red | :green | :blue, on: boolean }) -> atom {
    sequence proc[device_io]
        _: atom <- print("led ");
        _: atom <- case cmd.which of {
            :single -> print("single");
            :red -> print("red");
            :green -> print("green");
            :blue -> print("blue")
        };
        _: atom <- case cmd.on of {
            true -> print(" on");
            false -> print(" off")
        };
        o: atom <- println("")
    produces
        pure o
    end
}

// One complete frame from the peer: decode it, print it, close the carrier. Returns the exit code.
fn take_frame(car: actor_ref, frame0: string) -> int64 {
    sequence proc[mem(normal), device_io, concurrency, transport]
        decoded: (:ok, (:led, { which: :single | :red | :green | :blue, on: boolean })) | (:rejected, atom) <- decode((:etf), frame0);
        code: int64 <- case decoded of {
            (:ok, (:led, cmd: { which: :single | :red | :green | :blue, on: boolean })) -> {
                _: atom <- show_led(cmd);
                0
            };
            (:rejected, why: atom) -> {
                _: atom <- print("rejected ");
                _: atom <- print_atom(why);
                _: atom <- println("");
                2
            }
        };
        _: boolean <- cast(car, :close impl ActorMessage {})
    produces
        pure code
    end
}

fn owner(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
         state: { car: actor_ref, rx: { mode: atom, expected: int64, pending: string }, sent: int64, code: int64 })
    -> (:no_reply, { car: actor_ref, rx: { mode: atom, expected: int64, pending: string }, sent: int64, code: int64 }) {
    case msg of {
        (:link_up, info: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("link up ");
                _: atom <- println(info);
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {});
                seg: string <- reading_segment(mtu_of(info));
                _: boolean <- cast(state.car, (:tx, seg, self()) impl ActorMessage {})
            produces
                pure (:no_reply, { car: state.car, rx: state.rx, sent: length_bytes(seg), code: state.code })
            end
        };
        (:tx_credit, n: int64) -> {
            sequence proc[device_io]
                _: atom <- case n == 1 of {
                    true -> {
                        _: atom <- print("sent ");
                        _: atom <- print_int64(state.sent);
                        println(" bytes")
                    };
                    false -> {
                        _: atom <- print("tx credit ");
                        _: atom <- print_int64(n);
                        println("")
                    }
                }
            produces
                pure (:no_reply, state)
            end
        };
        (:rx, segment: string) -> {
            sequence proc[concurrency]
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                code2: int64 <- case un of {
                    (:more, _r0: { mode: atom, expected: int64, pending: string }) -> state.code;
                    (:frame, frame0: string, _r3: { mode: atom, expected: int64, pending: string }) -> take_frame(state.car, frame0);
                    (:rejected, _why1: atom) -> 3
                };
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, _frame: string, r2: { mode: atom, expected: int64, pending: string }) -> r2;
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io, concurrency]
                            _: atom <- print("framing rejected ");
                            _: atom <- print_atom(why2);
                            _: atom <- println("");
                            _: boolean <- cast(state.car, :close impl ActorMessage {})
                        produces pure state.rx end
                    }
                };
                _: boolean <- cast(state.car, (:credit, 1) impl ActorMessage {})
            produces
                pure (:no_reply, { car: state.car, rx: rx2, sent: state.sent, code: code2 })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print("tx failed ");
                _: atom <- print_atom(why3);
                _: atom <- println("")
            produces
                pure (:no_reply, state)
            end
        };
        (:link_down, why4: atom) -> {
            sequence proc[device_io, concurrency]
                _: atom <- print("link down ");
                _: atom <- print_atom(why4);
                _: atom <- println("");
                _: boolean <- case why4 == :closed of {
                    true -> cast_exit(state.code);
                    false -> cast_exit(1)
                }
            produces
                pure (:no_reply, state)
            end
        }
    }
}

// The app's work, run by the supervisor's one worker: spawn the carrier worker and the owner, open the link.
fn app_worker(msg: atom, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        car: actor_ref <- spawn_dangerous_carrier(ble, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        me: actor_ref <- spawn({ car: car, rx: wireframe@fresh(Carrier@boundaries(ble)), sent: 0, code: 4 }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(car, (:open, me, "peripheral:") impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: atom, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 1 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: atom, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)] <- [
            { id: :app_worker, agent_type: :worker, initial_state: initial_state, behavior: app_worker, restart: :transient, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: supervisor_ref <- spawn_registered_supervisor(AppSupervisor, 0, :app_supervisor, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast_registered(:app_worker, (:start) impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
fn region_dump_limit() -> int64 {
    0
}

fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
