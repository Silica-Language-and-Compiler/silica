// Stage 1 spike of transport_ble_plan.md: a dangerous actor drives the CoreBluetooth wrapper through
// Fifi, polling between its mailbox messages as the hosted carriers do, and tells a plain owner actor
// what happened. role() is patched by run_spike.sh: 0 central, 1 peripheral, 2 scan only. Throwaway.
module dangerous_ble_spike;

use dangerous_ble;
use trial_wait_int64;

fn role() -> int64 { 2 }

fn pure_int(r: (:ok, int64) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, v: int64) -> v;
        (:rejected, _why: atom) -> 0 - 1
    }
}

fn none_res() -> { tag: int64, value: int64, error_code: int64 } {
    { tag: 2, value: 0 - 1, error_code: 0 }
}

fn msg_is_start(msg: (:start, actor_ref) | :poll) -> boolean {
    case msg of {
        (:start, _o: actor_ref) -> true;
        :poll -> false
    }
}

fn msg_owner(msg: (:start, actor_ref) | :poll, fallback: actor_ref) -> actor_ref {
    case msg of {
        (:start, o: actor_ref) -> o;
        :poll -> fallback
    }
}

fn ble(msg: (:start, actor_ref) | :poll, state: { owner: actor_ref, phase: int64, ticks: int64 }) -> (:no_reply, { owner: actor_ref, phase: int64, ticks: int64 }) {
    sequence proc[external_danger, concurrency, transport]
        starting: boolean <- msg_is_start(msg);
        owner: actor_ref <- msg_owner(msg, state.owner);
        res_open: { tag: int64, value: int64, error_code: int64 } <- case starting of {
            true -> dangerous_ble@ble_open(role(), 10000);
            false -> none_res()
        };
        open_tag_raw: int64 <- res_open.tag;
        open_code_raw: int64 <- res_open.error_code;
        open_tag: int64 <- pure_int(recreate(open_tag_raw));
        open_code: int64 <- pure_int(recreate(open_code_raw));
        _: boolean <- case starting of {
            true -> cast(owner, (:opened, open_tag, open_code) impl ActorMessage {});
            false -> true
        };
        polling: boolean <- case starting of { true -> false; false -> state.phase != 3 };
        res_phase: { tag: int64, value: int64, error_code: int64 } <- case polling of {
            true -> dangerous_ble@ble_phase(state.phase, 200);
            false -> none_res()
        };
        phase_raw: int64 <- res_phase.value;
        phase_seen: int64 <- pure_int(recreate(phase_raw));
        phase_now: int64 <- case polling of { true -> phase_seen; false -> state.phase };
        came_up: boolean <- polling and phase_now == 2 and state.phase != 2;
        res_mtu: { tag: int64, value: int64, error_code: int64 } <- case came_up of {
            true -> dangerous_ble@ble_mtu(1);
            false -> none_res()
        };
        mtu_raw: int64 <- res_mtu.value;
        mtu: int64 <- pure_int(recreate(mtu_raw));
        _: boolean <- case came_up of {
            true -> cast(owner, (:up, mtu) impl ActorMessage {});
            false -> true
        };
        res_hello: { tag: int64, value: int64, error_code: int64 } <- case came_up of {
            true -> dangerous_ble@ble_send("hello from silica", 5000);
            false -> none_res()
        };
        hello_tag_raw: int64 <- res_hello.tag;
        hello_tag: int64 <- pure_int(recreate(hello_tag_raw));
        _: boolean <- case came_up of {
            true -> cast(owner, (:sent, hello_tag) impl ActorMessage {});
            false -> true
        };
        do_rx: boolean <- polling and phase_now == 2;
        res_rx: { tag: int64, value: int64, error_code: int64 } <- case do_rx of {
            true -> dangerous_ble@ble_recv(1, 512, 100);
            false -> none_res()
        };
        rx_tag_raw: int64 <- res_rx.tag;
        rx_tag: int64 <- pure_int(recreate(rx_tag_raw));
        got: boolean <- do_rx and rx_tag == 0;
        bytes_in: string <- case got of {
            true -> dangerous_ble@ble_take(1);
            false -> ""
        };
        _: boolean <- case got of {
            true -> cast(owner, (:rx, bytes_in) impl ActorMessage {});
            false -> true
        };
        res_ack: { tag: int64, value: int64, error_code: int64 } <- case got of {
            true -> dangerous_ble@ble_send("ack from silica", 5000);
            false -> none_res()
        };
        ack_tag_raw: int64 <- res_ack.tag;
        ack_tag: int64 <- pure_int(recreate(ack_tag_raw));
        _: boolean <- case got of {
            true -> cast(owner, (:sent, ack_tag) impl ActorMessage {});
            false -> true
        };
        ticks_next: int64 <- case polling of { true -> state.ticks + 1; false -> state.ticks };
        report_seen: boolean <- polling and role() == 2 and ticks_next == 25;
        res_seen: { tag: int64, value: int64, error_code: int64 } <- case report_seen of {
            true -> dangerous_ble@ble_seen(1);
            false -> none_res()
        };
        seen_raw: int64 <- res_seen.value;
        seen: int64 <- pure_int(recreate(seen_raw));
        _: boolean <- case report_seen of {
            true -> cast(owner, (:seen, seen) impl ActorMessage {});
            false -> true
        };
        went_down: boolean <- polling and phase_now == 3;
        _: boolean <- case went_down of {
            true -> cast(owner, :down impl ActorMessage {});
            false -> true
        };
        keep_polling: boolean <- starting or (polling and phase_now != 3);
        poll_delay: uint64 <- 20;
        _: boolean <- case keep_polling of {
            true -> {
                sequence proc[concurrency]
                    _: timer_ref <- send_after(poll_delay, self(), :poll impl ActorMessage {})
                produces
                    pure true
                end
            };
            false -> true
        }
    produces
        pure (:no_reply, { owner: owner, phase: phase_now, ticks: ticks_next })
    end
}

fn show_int(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces
        pure o
    end
}

fn owner(msg: (:opened, int64, int64) | (:up, int64) | (:sent, int64) | (:rx, string) | (:seen, int64) | :down, state: int64) -> (:no_reply, int64) {
    case msg of {
        (:opened, tag: int64, code: int64) -> {
            sequence proc[concurrency]
                _: atom <- show_int("open tag=", tag);
                _: atom <- show_int("open code=", code);
                _: boolean <- case tag == 0 of { true -> true; false -> cast_exit(2) }
            produces
                pure (:no_reply, state)
            end
        };
        (:up, mtu: int64) -> {
            _: atom <- show_int("link up, mtu=", mtu);
            (:no_reply, state)
        };
        (:sent, tag2: int64) -> {
            _: atom <- show_int("sent, tag=", tag2);
            (:no_reply, state)
        };
        (:rx, text: string) -> {
            sequence proc[device_io]
                _: atom <- print("rx: ");
                _: atom <- println(text)
            produces
                pure (:no_reply, state + 1)
            end
        };
        (:seen, n: int64) -> {
            sequence proc[concurrency]
                _: atom <- show_int("advertisers seen=", n);
                _: boolean <- cast_exit(0)
            produces
                pure (:no_reply, state)
            end
        };
        :down -> {
            sequence proc[device_io, concurrency]
                _: atom <- println("link down");
                _: boolean <- cast_exit(0)
            produces
                pure (:no_reply, state)
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), phase: 0, ticks: 0 }, ble, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                me: actor_ref <- spawn(0, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(car, (:start, me) impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
