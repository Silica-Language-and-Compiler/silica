link_library: "silica_ble"

wrapper silica_ble_set_args {
    symbol: "silica_ble_set_args"
    result: "tagged_result"
    error_domain: "dangerous_ble"
}

wrapper silica_ble_open {
    symbol: "silica_ble_open"
    result: "tagged_result"
    error_domain: "dangerous_ble"
}

wrapper silica_ble_phase {
    symbol: "silica_ble_phase"
    result: "tagged_result"
    error_domain: "dangerous_ble"
}

wrapper silica_ble_mtu {
    symbol: "silica_ble_mtu"
    result: "tagged_result"
    error_domain: "dangerous_ble"
}

wrapper silica_ble_seen {
    symbol: "silica_ble_seen"
    result: "tagged_result"
    error_domain: "dangerous_ble"
}

wrapper silica_ble_send {
    symbol: "silica_ble_send"
    result: "tagged_result"
    error_domain: "dangerous_ble"
    arguments: [
        { name: "data_ptr", lifetime: "borrowed", retain: false },
        { name: "data_len", role: "length", length_of: "data_ptr" }
    ]
}

wrapper silica_ble_recv {
    symbol: "silica_ble_recv"
    result: "tagged_result"
    error_domain: "dangerous_ble"
}

wrapper silica_ble_take {
    symbol: "silica_ble_take"
    result: "struct"
    error_domain: "dangerous_ble"
}

wrapper silica_ble_close {
    symbol: "silica_ble_close"
    result: "tagged_result"
    error_domain: "dangerous_ble"
}
