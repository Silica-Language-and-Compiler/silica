// Stage 1 spike of transport_ble_plan.md: the CoreBluetooth wrapper (silica_ble.m) as a dangerous
// module, in the shape of compiler/stdlib/dangerous_sockets.silica. Every answer is the wrapper's
// tagged result { tag, value, error_code } with tag 0 ok, 1 error, 2 timeout, 3 link down; received
// bytes come back through ble_take/1 as a string. Throwaway.
module dangerous_ble;

wrapper_meta "dangerous_exposure_source/ble/silica_ble_wrapper.meta";

export ble_open/2;
export ble_phase/2;
export ble_mtu/1;
export ble_seen/1;
export ble_send/2;
export ble_recv/3;
export ble_take/1;
export ble_close/1;

foreign c_wrapper "silica_ble_set_args"
fn set_args_raw(a: int64, b: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_open"
fn open_raw(role: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_phase"
fn phase_raw(from: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_mtu"
fn mtu_raw(handle: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_seen"
fn seen_raw(handle: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_send"
fn send_raw(data_ptr: uint8, data_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_recv"
fn recv_raw(handle: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_take"
fn take_raw(handle: int64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

foreign c_wrapper "silica_ble_close"
fn close_raw(handle: int64) -> { tag: int64, value: int64, error_code: int64 };

// role: 0 central, 1 peripheral, 2 scan only.
fn ble_open(role: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- open_raw(role, timeout_ms);
    r
}

// The phase (0 starting, 1 scanning or advertising, 2 up, 3 down), after waiting up to timeout_ms
// for it to differ from `from`.
fn ble_phase(from: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- phase_raw(from, timeout_ms);
    r
}

fn ble_mtu(handle: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- mtu_raw(handle);
    r
}

fn ble_seen(handle: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- seen_raw(handle);
    r
}

fn ble_send(data: string, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(1, timeout_ms);
    r: { tag: int64, value: int64, error_code: int64 } <- send_raw(data);
    r
}

fn ble_recv(handle: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- recv_raw(handle, max, timeout_ms);
    r
}

// The bytes of the last ble_recv on this worker.
fn ble_take(handle: int64) -> string {
    out: string <- take_raw(handle);
    out
}

fn ble_close(handle: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- close_raw(handle);
    r
}
