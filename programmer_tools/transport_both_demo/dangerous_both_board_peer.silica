// Both radios in one image (transport_ble_plan.md stage 12): the board ends of the Wi-Fi demo
// (transport_wifi_demo/dangerous_wifi_board_peer) and of the Bluetooth demo
// (transport_ble_demo/dangerous_ble_board_peer) in one program, on the ESP32-S3 the bare-metal runtime
// owns. Two carriers are declared, `carried_on lan: (:tcp) (:wifi, 0);` and
// `carried_on phone: (:ble_gatt) (:bluetooth, 0);`, and each has an owner that makes the demos'
// exchange on it: on :link_up the owner sends (:accel, { x: 1, y: -2, z: 512, at_ms: 1000 }) as an ETF
// frame behind wireframe's 4-byte length, takes the frame the peer sends back, and closes the link;
// links() and ble_links() exchanges, each on a link of its own. The two owners are the same function
// written twice, for the two carriers' declarations and reference types: a (:tcp) carrier ends with
// its link and the next link has a new one, the Bluetooth carrier stays. When an owner's links are
// done it tells the coordinator its code (0 for all whole), and the program ends with the sum when
// both have. A busy actor keeps the actors' core occupied throughout. Run it through
// spike_r1/run_r1_both.sh, which puts the addresses and counts in place of the ones below.
module dangerous_both_board_peer;

use wire_etf;
use wireframe;
use Carrier;
use trial_support_hex;
use trial_wait_int64;

carried_on lan: (:tcp) (:wifi, 0);
carried_on phone: (:ble_gatt) (:bluetooth, 0);

// Patched per run by the script: the Wi-Fi peer's address and port, "a.b.c.d:port", and the Bluetooth
// role and service, "peripheral:<uuid>".
fn address() -> string { "0.0.0.0:0" }

fn ble_address() -> string { "peripheral:" }

// Patched per run by the script: how many whole exchanges on each radio.
fn links() -> int64 { 1 }

fn ble_links() -> int64 { 1 }

// The demos' other settings, not used here: no link is cut short or kept, and the board connects.
fn cut_link() -> int64 { 0 - 1 }

fn hold_ms() -> uint64 { 0 }

fn listening() -> boolean { false }

// A busy actor: each message is a long computation, and the next message is already in its mailbox
// when it ends, so its core's scheduler never goes idle.
fn churn(n: int64, acc: int64) -> int64 {
    case n == 0 of {
        true -> acc;
        false -> churn(n - 1, (acc * 31 + n) % 1000003)
    }
}

fn busy(msg: actor_ref, rounds: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: int64 <- churn(100000, rounds);
        _: boolean <- case rounds % 10 == 9 of {
            true -> cast(msg, (:rounds, 10) impl ActorMessage {});
            false -> true
        };
        _: boolean <- cast(self(), msg impl ActorMessage {})
    produces
        pure (:no_reply, rounds + 1)
    end
}

fn show_rounds(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print("busy rounds ");
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces
        pure o
    end
}

fn show_reading(r: { x: int16, y: int16, z: int16, at_ms: uint64 }) -> atom {
    sequence proc[device_io]
        _: atom <- print("accel x=");
        _: atom <- print_int64(to_int64(r.x));
        _: atom <- print(" y=");
        _: atom <- print_int64(to_int64(r.y));
        _: atom <- print(" z=");
        _: atom <- print_int64(to_int64(r.z));
        _: atom <- print(" at_ms=");
        _: atom <- print_int64(to_int64(r.at_ms));
        o: atom <- println("")
    produces
        pure o
    end
}

fn only_first(segs: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case segs of {
        []: List[string, mem(normal)] -> segs;
        [h: string, _t: List[string, mem(normal)]] -> [h]
    }
}

// The Wi-Fi link, (:tcp) on (:wifi, 0).

// Every segment to the carrier, in order; the count sent.
fn send_all(car: dangerous_actor_ref, segs: List[string, mem(normal)], sent: int64) -> int64 {
    case segs of {
        []: List[string, mem(normal)] -> sent;
        [h: string, t: List[string, mem(normal)]] -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("tx segment ");
                _: atom <- print_int64(sent);
                _: atom <- print(" ");
                _: atom <- println(trial_support_hex@hex(h));
                _: boolean <- cast(car, (:tx, h, self()) impl ActorMessage {});
                n: int64 <- send_all(car, t, sent + 1)
            produces
                pure n
            end
        }
    }
}

// cutting: only the frame's first segment goes out.
fn send_reading(car: dangerous_actor_ref, cutting: boolean) -> int64 {
    sequence proc[mem(normal), device_io, transport]
        frame: string <- encode((:etf), (:accel, { x: 1, y: 0 - 2, z: 512, at_ms: 1000 }));
        _: atom <- print("frame out ");
        _: atom <- print_int64(length_bytes(frame));
        _: atom <- println(" bytes");
        segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu(lan), Carrier@boundaries(lan));
        n: int64 <- send_all(car, case cutting of { true -> only_first(segs); false -> segs }, 0)
    produces
        pure n
    end
}

// The exchange is over: close now, or after hold_ms() when the link is to be kept (never when cutting).
fn finish(car: dangerous_actor_ref, cutting: boolean) -> boolean {
    sequence proc[concurrency]
        done: boolean <- case hold_ms() == 0 or cutting of {
            true -> cast(car, :close impl ActorMessage {});
            false -> {
                sequence proc[concurrency]
                    _: timer_ref <- send_after(hold_ms(), self(), :finish impl ActorMessage {})
                produces
                    pure true
                end
            }
        }
    produces
        pure done
    end
}

// How long the Wi-Fi owner waits for a link to end, from its carrier's :open, before it gives its links up.
fn watch_ms() -> uint64 { 60000 }

fn owner(msg: (:rounds, int64) | (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:accepted, dangerous_actor_ref, string) | (:watch, int64) | :reopen | :finish,
         state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, code: int64, up: boolean, sent: int64, acked: int64, got: boolean, cut: boolean, done: int64, lost: int64, rounds: int64, bound: boolean, coord: actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, code: int64, up: boolean, sent: int64, acked: int64, got: boolean, cut: boolean, done: int64, lost: int64, rounds: int64, bound: boolean, coord: actor_ref }) {
    case msg of {
        (:rounds, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, code: state.code, up: state.up, sent: state.sent, acked: state.acked, got: state.got, cut: state.cut, done: state.done, lost: state.lost, rounds: state.rounds + n, bound: state.bound, coord: state.coord });
        // a listener is bound: it carries no bytes itself, and tells of each peer it accepts
        // a peer connected: the listener made a carrier for the connection, which this owner opens
        (:accepted, conn: dangerous_actor_ref, who: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("accepted ");
                _: atom <- println(who);
                _: boolean <- cast(conn, (:open, self(), "") impl ActorMessage {})
            produces
                pure (:no_reply, { car: conn, rx: wireframe@fresh(Carrier@boundaries(lan)), code: state.code, up: true, sent: 0, acked: 0, got: false, cut: false, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
            end
        };
        // a listener's first :link_up says it is bound: it carries no bytes itself, and tells of each peer
        // it accepts
        (:link_up, info: string) -> case listening() and state.bound == false of {
          true -> {
            sequence proc[device_io]
                _: atom <- print("listening ");
                _: atom <- println(info)
            produces
                pure (:no_reply, { car: state.car, rx: state.rx, code: state.code, up: false, sent: 0, acked: 0, got: false, cut: false, done: state.done, lost: state.lost, rounds: state.rounds, bound: true, coord: state.coord })
            end
          };
          false -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("wifi link up ");
                _: atom <- println(info);
                _: atom <- show_rounds(state.rounds);
                // each link has a carrier of its own, which starts with no credit
                _: boolean <- cast(state.car, (:credit, 8) impl ActorMessage {});
                cutting: boolean <- state.done + state.lost == cut_link();
                n: int64 <- send_reading(state.car, cutting);
                _: atom <- print("sent ");
                _: atom <- print_int64(n);
                _: atom <- println(" segments; waiting for a frame from the peer")
            produces
                pure (:no_reply, { car: state.car, rx: state.rx, code: 4, up: true, sent: n, acked: 0, got: false, cut: cutting, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
            end
          }
        };
        (:tx_credit, n: int64) -> {
            acked: int64 <- case n == 1 of { true -> state.acked + 1; false -> state.acked };
            _: boolean <- case state.up and acked == state.sent and (state.got or state.cut) and n == 1 of {
                true -> finish(state.car, state.cut);
                false -> true
            };
            (:no_reply, { car: state.car, rx: state.rx, code: state.code, up: state.up, sent: state.sent, acked: acked, got: state.got, cut: state.cut, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
        };
        (:rx, segment: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("rx segment ");
                _: atom <- println(trial_support_hex@hex(segment));
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                code2: int64 <- case un of {
                    (:more, _r0: { mode: atom, expected: int64, pending: string }) -> state.code;
                    (:frame, frame0: string, _r3: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), device_io, transport]
                            _: atom <- print("wifi frame in ");
                            _: atom <- print_int64(length_bytes(frame0));
                            _: atom <- println(" bytes");
                            decoded: (:ok, (:accel, { x: int16, y: int16, z: int16, at_ms: uint64 })) | (:rejected, atom) <- decode((:etf), frame0);
                            code: int64 <- case decoded of {
                                (:ok, (:accel, r: { x: int16, y: int16, z: int16, at_ms: uint64 })) -> {
                                    _: atom <- show_reading(r);
                                    0
                                };
                                (:rejected, why: atom) -> {
                                    _: atom <- print("rejected ");
                                    _: atom <- print_atom(why);
                                    _: atom <- println("");
                                    2
                                }
                            }
                        produces pure code end
                    };
                    (:rejected, _why1: atom) -> 3
                };
                got2: boolean <- case un of {
                    (:more, _r5: { mode: atom, expected: int64, pending: string }) -> state.got;
                    (:frame, _f5: string, _r6: { mode: atom, expected: int64, pending: string }) -> true;
                    (:rejected, _why5: atom) -> state.got
                };
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, _frame: string, r2: { mode: atom, expected: int64, pending: string }) -> r2;
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print("framing rejected ");
                            _: atom <- print_atom(why2);
                            _: atom <- println("; send the frame again from its first segment")
                        produces pure wireframe@fresh(Carrier@boundaries(lan)) end
                    }
                };
                _: boolean <- cast(state.car, (:credit, 1) impl ActorMessage {});
                _: boolean <- case state.up and got2 and state.acked == state.sent of {
                    true -> finish(state.car, false);
                    false -> true
                }
            produces
                pure (:no_reply, { car: state.car, rx: rx2, code: code2, up: state.up, sent: state.sent, acked: state.acked, got: got2, cut: state.cut, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print("tx failed ");
                _: atom <- print_atom(why3);
                _: atom <- println("")
            produces pure (:no_reply, state) end
        };
        // a carrier answers :close with :link_down even when the peer ended the link first, so only the
        // first :link_down after an :open counts (up: the carrier is open, from :open to :link_down)
        (:link_down, why4: atom) -> case state.up of {
            false -> (:no_reply, state);
            true -> {
                sequence proc[device_io, concurrency]
                    whole: boolean <- state.got and state.cut == false and state.code == 0;
                    done: int64 <- case whole of { true -> state.done + 1; false -> state.done };
                    lost: int64 <- case whole of { true -> state.lost; false -> state.lost + 1 };
                    _: atom <- print("wifi link down ");
                    _: atom <- print_atom(why4);
                    _: atom <- println(case whole of { true -> ""; false -> case state.cut of { true -> " (cut short by this end)"; false -> case state.sent == 0 of { true -> " (the link is not there yet, or the peer is not)"; false -> " (before the exchange was whole)" } } });
                _: atom <- show_rounds(state.rounds);
                        again: boolean <- done < links() and lost < 40;
                    // a listener that is bound stays: the next link is the next peer it accepts
                    _: boolean <- case again of {
                        true -> case state.bound of { true -> true; false -> {
                            sequence proc[concurrency]
                                _: timer_ref <- send_after(500, self(), :reopen impl ActorMessage {})
                            produces
                                pure true
                            end
                        } };
                        false -> cast(state.coord, (:done, case done == links() of { true -> 0; false -> case why4 == :fault of { true -> 1; false -> 5 } }) impl ActorMessage {})
                    }
                produces
                    pure (:no_reply, { car: state.car, rx: wireframe@fresh(Carrier@boundaries(lan)), code: state.code, up: false, sent: 0, acked: state.acked, got: state.got, cut: state.cut, done: done, lost: lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
                end
            }
        };
        // the link that was opened watch_ms() ago is still the one in hand: its carrier ended without a
        // word (one refused its memory does); the Wi-Fi side is given up with code 6
        (:watch, n: int64) -> case n == state.done + state.lost and state.up of {
            false -> (:no_reply, state);
            true -> {
                sequence proc[device_io, concurrency]
                    _: atom <- print("wifi link ");
                    _: atom <- print_int64(n);
                    _: atom <- println(": no end to it; giving the Wi-Fi links up");
                    _: boolean <- cast(state.coord, (:done, 6) impl ActorMessage {})
                produces pure (:no_reply, { car: state.car, rx: state.rx, code: state.code, up: false, sent: state.sent, acked: state.acked, got: state.got, cut: state.cut, done: state.done, lost: 40, rounds: state.rounds, bound: state.bound, coord: state.coord }) end
            }
        };
        :finish -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, :close impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        // the carrier ended with its link, so each link has a carrier of its own
        :reopen -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("link ");
                _: atom <- print_int64(state.done + state.lost);
                _: atom <- println(": opening again");
                car: dangerous_actor_ref <- spawn_dangerous_carrier(lan, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(car, (:open, self(), address()) impl ActorMessage {});
                _: timer_ref <- send_after(watch_ms(), self(), (:watch, state.done + state.lost) impl ActorMessage {})
            produces
                pure (:no_reply, { car: car, rx: state.rx, code: state.code, up: true, sent: 0, acked: 0, got: false, cut: false, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
            end
        }
    }
}

// The Bluetooth link, (:ble_gatt) on (:bluetooth, 0): the same, for a carrier that stays.

// The same for the Bluetooth link.
fn ble_send_all(car: actor_ref, segs: List[string, mem(normal)], sent: int64) -> int64 {
    case segs of {
        []: List[string, mem(normal)] -> sent;
        [h: string, t: List[string, mem(normal)]] -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("tx segment ");
                _: atom <- print_int64(sent);
                _: atom <- print(" ");
                _: atom <- println(trial_support_hex@hex(h));
                _: boolean <- cast(car, (:tx, h, self()) impl ActorMessage {});
                n: int64 <- ble_send_all(car, t, sent + 1)
            produces
                pure n
            end
        }
    }
}

fn ble_send_reading(car: actor_ref, cutting: boolean) -> int64 {
    sequence proc[mem(normal), device_io, transport]
        frame: string <- encode((:etf), (:accel, { x: 1, y: 0 - 2, z: 512, at_ms: 1000 }));
        _: atom <- print("frame out ");
        _: atom <- print_int64(length_bytes(frame));
        _: atom <- println(" bytes");
        segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu(phone), Carrier@boundaries(phone));
        n: int64 <- ble_send_all(car, case cutting of { true -> only_first(segs); false -> segs }, 0)
    produces
        pure n
    end
}

fn ble_finish(car: actor_ref, cutting: boolean) -> boolean {
    sequence proc[concurrency]
        done: boolean <- case hold_ms() == 0 or cutting of {
            true -> cast(car, :close impl ActorMessage {});
            false -> {
                sequence proc[concurrency]
                    _: timer_ref <- send_after(hold_ms(), self(), :finish impl ActorMessage {})
                produces
                    pure true
                end
            }
        }
    produces
        pure done
    end
}

fn ble_owner(msg: (:rounds, int64) | (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:accepted, actor_ref, string) | :reopen | :finish,
         state: { car: actor_ref, rx: { mode: atom, expected: int64, pending: string }, code: int64, up: boolean, sent: int64, acked: int64, got: boolean, cut: boolean, done: int64, lost: int64, rounds: int64, bound: boolean, coord: actor_ref })
    -> (:no_reply, { car: actor_ref, rx: { mode: atom, expected: int64, pending: string }, code: int64, up: boolean, sent: int64, acked: int64, got: boolean, cut: boolean, done: int64, lost: int64, rounds: int64, bound: boolean, coord: actor_ref }) {
    case msg of {
        (:rounds, n: int64) -> (:no_reply, { car: state.car, rx: state.rx, code: state.code, up: state.up, sent: state.sent, acked: state.acked, got: state.got, cut: state.cut, done: state.done, lost: state.lost, rounds: state.rounds + n, bound: state.bound, coord: state.coord });
        // a listener is bound: it carries no bytes itself, and tells of each peer it accepts
        // a peer connected: the listener made a carrier for the connection, which this owner opens
        (:accepted, conn: actor_ref, who: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("accepted ");
                _: atom <- println(who);
                _: boolean <- cast(conn, (:open, self(), "") impl ActorMessage {})
            produces
                pure (:no_reply, { car: conn, rx: wireframe@fresh(Carrier@boundaries(phone)), code: state.code, up: true, sent: 0, acked: 0, got: false, cut: false, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
            end
        };
        // a listener's first :link_up says it is bound: it carries no bytes itself, and tells of each peer
        // it accepts
        (:link_up, info: string) -> case listening() and state.bound == false of {
          true -> {
            sequence proc[device_io]
                _: atom <- print("listening ");
                _: atom <- println(info)
            produces
                pure (:no_reply, { car: state.car, rx: state.rx, code: state.code, up: false, sent: 0, acked: 0, got: false, cut: false, done: state.done, lost: state.lost, rounds: state.rounds, bound: true, coord: state.coord })
            end
          };
          false -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("ble link up ");
                _: atom <- println(info);
                _: atom <- show_rounds(state.rounds);
                // one carrier for every link: its credit is granted once
                _: boolean <- case state.done + state.lost == 0 of {
                    true -> cast(state.car, (:credit, 8) impl ActorMessage {});
                    false -> true
                };
                cutting: boolean <- state.done + state.lost == cut_link();
                n: int64 <- ble_send_reading(state.car, cutting);
                _: atom <- print("sent ");
                _: atom <- print_int64(n);
                _: atom <- println(" segments; waiting for a frame from the peer")
            produces
                pure (:no_reply, { car: state.car, rx: state.rx, code: 4, up: true, sent: n, acked: 0, got: false, cut: cutting, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
            end
          }
        };
        (:tx_credit, n: int64) -> {
            acked: int64 <- case n == 1 of { true -> state.acked + 1; false -> state.acked };
            _: boolean <- case state.up and acked == state.sent and (state.got or state.cut) and n == 1 of {
                true -> ble_finish(state.car, state.cut);
                false -> true
            };
            (:no_reply, { car: state.car, rx: state.rx, code: state.code, up: state.up, sent: state.sent, acked: acked, got: state.got, cut: state.cut, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
        };
        (:rx, segment: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("rx segment ");
                _: atom <- println(trial_support_hex@hex(segment));
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                code2: int64 <- case un of {
                    (:more, _r0: { mode: atom, expected: int64, pending: string }) -> state.code;
                    (:frame, frame0: string, _r3: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), device_io, transport]
                            _: atom <- print("ble frame in ");
                            _: atom <- print_int64(length_bytes(frame0));
                            _: atom <- println(" bytes");
                            decoded: (:ok, (:accel, { x: int16, y: int16, z: int16, at_ms: uint64 })) | (:rejected, atom) <- decode((:etf), frame0);
                            code: int64 <- case decoded of {
                                (:ok, (:accel, r: { x: int16, y: int16, z: int16, at_ms: uint64 })) -> {
                                    _: atom <- show_reading(r);
                                    0
                                };
                                (:rejected, why: atom) -> {
                                    _: atom <- print("rejected ");
                                    _: atom <- print_atom(why);
                                    _: atom <- println("");
                                    2
                                }
                            }
                        produces pure code end
                    };
                    (:rejected, _why1: atom) -> 3
                };
                got2: boolean <- case un of {
                    (:more, _r5: { mode: atom, expected: int64, pending: string }) -> state.got;
                    (:frame, _f5: string, _r6: { mode: atom, expected: int64, pending: string }) -> true;
                    (:rejected, _why5: atom) -> state.got
                };
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, _frame: string, r2: { mode: atom, expected: int64, pending: string }) -> r2;
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print("framing rejected ");
                            _: atom <- print_atom(why2);
                            _: atom <- println("; send the frame again from its first segment")
                        produces pure wireframe@fresh(Carrier@boundaries(phone)) end
                    }
                };
                _: boolean <- cast(state.car, (:credit, 1) impl ActorMessage {});
                _: boolean <- case state.up and got2 and state.acked == state.sent of {
                    true -> ble_finish(state.car, false);
                    false -> true
                }
            produces
                pure (:no_reply, { car: state.car, rx: rx2, code: code2, up: state.up, sent: state.sent, acked: state.acked, got: got2, cut: state.cut, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print("tx failed ");
                _: atom <- print_atom(why3);
                _: atom <- println("")
            produces pure (:no_reply, state) end
        };
        // a carrier answers :close with :link_down even when the peer ended the link first, so only the
        // first :link_down after an :open counts (up: the carrier is open, from :open to :link_down)
        (:link_down, why4: atom) -> case state.up of {
            false -> (:no_reply, state);
            true -> {
                sequence proc[device_io, concurrency]
                    whole: boolean <- state.got and state.cut == false and state.code == 0;
                    done: int64 <- case whole of { true -> state.done + 1; false -> state.done };
                    lost: int64 <- case whole of { true -> state.lost; false -> state.lost + 1 };
                    _: atom <- print("ble link down ");
                    _: atom <- print_atom(why4);
                    _: atom <- println(case whole of { true -> ""; false -> case state.cut of { true -> " (cut short by this end)"; false -> case state.sent == 0 of { true -> " (the link is not there yet, or the peer is not)"; false -> " (before the exchange was whole)" } } });
                _: atom <- show_rounds(state.rounds);
                        again: boolean <- why4 != :fault and done < ble_links() and lost < 4;
                    // a listener that is bound stays: the next link is the next peer it accepts
                    _: boolean <- case again of {
                        true -> case state.bound of { true -> true; false -> {
                            sequence proc[concurrency]
                                _: timer_ref <- send_after(500, self(), :reopen impl ActorMessage {})
                            produces
                                pure true
                            end
                        } };
                        false -> cast(state.coord, (:done, case done == ble_links() of { true -> 0; false -> case why4 == :fault of { true -> 1; false -> 5 } }) impl ActorMessage {})
                    }
                produces
                    pure (:no_reply, { car: state.car, rx: wireframe@fresh(Carrier@boundaries(phone)), code: state.code, up: false, sent: 0, acked: state.acked, got: state.got, cut: state.cut, done: done, lost: lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
                end
            }
        };
        :finish -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, :close impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        // the Bluetooth carrier stays, and is opened again
        :reopen -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("link ");
                _: atom <- print_int64(state.done + state.lost);
                _: atom <- println(": opening again");
                car: actor_ref <- state.car;
                _: boolean <- cast(car, (:open, self(), ble_address()) impl ActorMessage {})
            produces
                pure (:no_reply, { car: car, rx: state.rx, code: state.code, up: true, sent: 0, acked: 0, got: false, cut: false, done: state.done, lost: state.lost, rounds: state.rounds, bound: state.bound, coord: state.coord })
            end
        }
    }
}

// Told each owner's code when its links are done; ends the program with the sum when both have.
fn both(msg: (:done, int64), state: { left: int64, code: int64 }) -> (:no_reply, { left: int64, code: int64 }) {
    case msg of {
        (:done, code: int64) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("a radio's links are done, code ");
                _: atom <- print_int64(code);
                _: atom <- println("");
                _: boolean <- case state.left == 1 of {
                    true -> cast_exit(state.code + code);
                    false -> true
                }
            produces
                pure (:no_reply, { left: state.left - 1, code: state.code + code })
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                coord: actor_ref <- spawn({ left: 2, code: 0 }, both, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                car: dangerous_actor_ref <- spawn_dangerous_carrier(lan, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                me: actor_ref <- spawn({ car: car, rx: wireframe@fresh(Carrier@boundaries(lan)), code: 4, up: true, sent: 0, acked: 0, got: false, cut: false, done: 0, lost: 0, rounds: 0, bound: false, coord: coord }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                bcar: actor_ref <- spawn_dangerous_carrier(phone, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                bme: actor_ref <- spawn({ car: bcar, rx: wireframe@fresh(Carrier@boundaries(phone)), code: 4, up: true, sent: 0, acked: 0, got: false, cut: false, done: 0, lost: 0, rounds: 0, bound: false, coord: coord }, ble_owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                b0: actor_ref <- spawn(0, busy, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(b0, me impl ActorMessage {});
                _: timer_ref <- send_after(watch_ms(), me, (:watch, 0) impl ActorMessage {});
                _: boolean <- cast(car, (:open, me, address()) impl ActorMessage {});
                _: boolean <- cast(bcar, (:open, bme, ble_address()) impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
