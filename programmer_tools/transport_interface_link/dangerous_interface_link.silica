// A listener and a dialer on one program, both declared on the host's loopback interface by name
// (hosted Ethernet plan E2, trial app_transport_tcp_interface_link of the plan): (:interface, "IFNAME") binds the
// carrier to that interface's first IPv4 address through getifaddrs, so "listen:0" listens on 127.0.0.1 and the
// dial leaves from it. IFNAME is lo0 on macOS and lo on Linux, so this program is a template that run.sh fills
// in per host; that is why it is not part of `make integrate`. The client sends "ping", the session prints it and
// answers "pong", the client prints that and ends.
module dangerous_interface_link;

use dangerous_sockets;
use trial_wait_int64;

carried_on lan: (:tcp) (:interface, "IFNAME");

fn server(msg: (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { n: int64 })
    -> (:no_reply, { n: int64 }) {
    case msg of {
        (:link_up, info: string) -> case starts_with(info, "port:") of {
            // bound: start the client against the port the listener got
            true -> {
                sequence proc[concurrency]
                    cli_link: dangerous_actor_ref <- spawn_dangerous_carrier(lan, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    cli: actor_ref <- spawn({ car: cli_link }, client, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    _: boolean <- cast(cli_link, (:open, cli, concat("127.0.0.1:", substring(info, 5, length_bytes(info)))) impl ActorMessage {})
                produces
                    pure (:no_reply, state)
                end
            };
            false -> (:no_reply, state)
        };
        // the accepted peer's connection carrier gets a session actor of its own
        (:accepted, conn: dangerous_actor_ref, _peer: string) -> {
            sequence proc[concurrency]
                ses: actor_ref <- spawn({ car: conn }, session, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(conn, (:open, ses, "") impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_credit, _n2: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

fn session(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
           state: { car: dangerous_actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:rx, segment: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- println(segment);
                _: boolean <- cast(state.car, (:tx, "pong", self()) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

fn client(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
          state: { car: dangerous_actor_ref })
    -> (:no_reply, { car: dangerous_actor_ref }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {});
                _: boolean <- cast(state.car, (:tx, "ping", self()) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:rx, segment: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- println(segment);
                _: atom <- println("done");
                _: boolean <- cast(state.car, :close impl ActorMessage {});
                _: boolean <- cast_exit(0)
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                srv_link: dangerous_actor_ref <- spawn_dangerous_carrier(lan, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                srv: actor_ref <- spawn({ n: 0 }, server, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(srv_link, (:open, srv, "listen:0") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
