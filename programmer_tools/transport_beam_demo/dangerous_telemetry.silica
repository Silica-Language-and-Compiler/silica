// The hosted BEAM demo of transport_serialization_design.md §13: this program connects to an Erlang
// node's gen_tcp listener (peer.erl, {packet, 4}), sends one accelerometer reading as an ETF frame and
// prints the LED command the Erlang side answers with. Run it through run_demo.sh.
module dangerous_telemetry;

use wire_etf;
use wireframe;
use Carrier;
use dangerous_sockets;
use dangerous_tcp_carrier;
use trial_wait_int64;

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn send_reading(car: dangerous_actor_ref, x: int16, y: int16, z: int16, at: uint64) -> boolean {
    sequence proc[mem(normal), concurrency]
        frame: string <- encode((:etf), (:accel, { x: x, y: y, z: z, at_ms: at }));
        segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu((:tcp)), Carrier@boundaries((:tcp)));
        seg: string <- first_segment(segs);
        sent: boolean <- cast(car, (:tx, seg, self()) impl ActorMessage {})
    produces
        pure sent
    end
}

fn show_led(cmd: { which: :single | :red | :green | :blue, on: boolean }) -> atom {
    sequence proc[device_io]
        _: atom <- print("led ");
        _: atom <- case cmd.which of {
            :single -> print("single");
            :red -> print("red");
            :green -> print("green");
            :blue -> print("blue")
        };
        _: atom <- case cmd.on of {
            true -> print(" on");
            false -> print(" off")
        };
        o: atom <- println("")
    produces
        pure o
    end
}

fn owner(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
         state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string } })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string } }) {
    case msg of {
        (:link_up, _info: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- println("connected");
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {});
                _: boolean <- send_reading(state.car, 1, 0 - 2, 512, 1000)
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:rx, segment: string) -> {
            sequence proc[concurrency]
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, frame: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), device_io, concurrency]
                            decoded: (:ok, (:led, { which: :single | :red | :green | :blue, on: boolean })) | (:rejected, atom) <- decode((:etf), frame);
                            _: atom <- case decoded of {
                                (:ok, (:led, cmd: { which: :single | :red | :green | :blue, on: boolean })) -> show_led(cmd);
                                (:rejected, why: atom) -> print_atom(why)
                            };
                            _: atom <- println("done");
                            _: boolean <- cast(state.car, :close impl ActorMessage {});
                            _: boolean <- cast_exit(0)
                        produces pure r2 end
                    };
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why2)
                        produces pure state.rx end
                    }
                };
                _: boolean <- cast(state.car, (:credit, 1) impl ActorMessage {})
            produces
                pure (:no_reply, { car: state.car, rx: rx2 })
            end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, state) end
        };
        (:link_down, why4: atom) -> {
            sequence proc[device_io, concurrency]
                _: atom <- print("link down: ");
                _: atom <- print_atom(why4);
                _: atom <- println("");
                _: boolean <- cast_exit(1)
            produces pure (:no_reply, state) end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                me: actor_ref <- spawn({ car: car, rx: wireframe@fresh(Carrier@boundaries((:tcp))) }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(car, (:open, me, "127.0.0.1:4040") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
