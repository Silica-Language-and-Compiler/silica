# The Bluetooth controller with no Bluetooth host: the application speaks HCI to it (plan §2.1).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Silica's schedulers spin when idle, so the idle tasks do not run while a program does.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Silica switches to stacks of its own, outside the task's stack: only the canary check is valid.
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=n
