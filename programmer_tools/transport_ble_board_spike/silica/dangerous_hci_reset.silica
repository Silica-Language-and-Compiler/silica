// Stage 4 spike of transport_ble_plan.md: a Silica program on the board sends an HCI Reset to
// Espressif's controller and prints the controller's answer. A dangerous actor makes the foreign
// call and tells a plain owner actor what came back, as the hosted carriers do. Throwaway.
module dangerous_hci_reset;

use dangerous_hci;
use trial_support_hex;
use trial_wait_int64;

fn pure_int(r: (:ok, int64) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, v: int64) -> v;
        (:rejected, _why: atom) -> 0 - 1
    }
}

fn hci(msg: (:reset, actor_ref), state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger, concurrency, transport]
        owner: actor_ref <- case msg of { (:reset, o: actor_ref) -> o };
        len_raw: int64 <- dangerous_hci@reset(2000);
        len: int64 <- pure_int(recreate(len_raw));
        event: string <- case len > 0 of {
            true -> dangerous_hci@take(0);
            false -> ""
        };
        _: boolean <- cast(owner, (:answer, len, event) impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn owner(msg: (:answer, int64, string), state: int64) -> (:no_reply, int64) {
    case msg of {
        (:answer, len: int64, event: string) -> {
            sequence proc[device_io, concurrency]
                _: atom <- print("hci reset length=");
                _: atom <- print_int64(len);
                _: atom <- print(" event=");
                _: atom <- println(trial_support_hex@hex(event));
                // Command Complete for Reset, status 0: 04 0E 04 xx 03 0C 00
                _: boolean <- case len == 7 and length_bytes(event) == 7 of {
                    true -> cast_exit(0);
                    false -> cast_exit(1)
                }
            produces
                pure (:no_reply, state)
            end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: dangerous_actor_ref <- spawn_dangerous(0, hci, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                me: actor_ref <- spawn(0, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(car, (:reset, me) impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
