// Stage 4 spike of transport_ble_plan.md: ESP-IDF's virtual HCI calls as a dangerous module
// (silica_hci.c). reset answers the length of the controller's event, or -1 error, -2 timeout; the
// event comes back through take/1 as a string. Throwaway.
module dangerous_hci;

wrapper_meta "dangerous_exposure_source/spike/silica_hci_wrapper.meta";

export reset/1;
export take/1;

foreign c_wrapper "silica_hci_reset"
fn reset_raw(timeout_ms: int64) -> int64;

foreign c_wrapper "silica_hci_take"
fn take_raw(handle: int64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

// Sends HCI Reset and waits for the controller's event; the event's length, or a negative number.
fn reset(timeout_ms: int64) -> int64 {
    r: int64 <- reset_raw(timeout_ms);
    r
}

// The bytes of the event the last reset received.
fn take(handle: int64) -> string {
    out: string <- take_raw(handle);
    out
}
