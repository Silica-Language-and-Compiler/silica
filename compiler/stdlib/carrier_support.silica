// What the carriers of the §6.2 contract have in common that is not in the contract: the small pure
// functions each of them otherwise keeps a copy of (transport_ble_plan.md decision 9). The readers
// of a carrier's own message (msg_kind and the rest) stay with the carrier: they follow its message
// type. So does pure_int, each carrier's reader of a recreate() of a wrapper's result field: the
// compiler does not infer the type of a recreate() that is the argument of a call into another
// module (E2005).
//
//   starts(s, p)     s begins with p: the role or form at the head of an :open address
//   int_text(n)      n >= 0 in decimal: the "mtu:<n>" of a :link_up
//   none_res()       the result record of a wrapper that was not called in this pass (tag 2)
module carrier_support;

export starts/2;
export int_text/1;
export none_res/0;

fn starts(s: string, p: string) -> boolean {
    length_bytes(s) >= length_bytes(p) and substring(s, 0, length_bytes(p)) == p
}

fn int_text_from(n: int64, acc: string) -> string {
    case n < 10 of {
        true -> concat(substring("0123456789", n, n + 1), acc);
        false -> int_text_from(n / 10, concat(substring("0123456789", n % 10, n % 10 + 1), acc))
    }
}

fn int_text(n: int64) -> string {
    int_text_from(n, "")
}

fn none_res() -> { tag: int64, value: int64, error_code: int64 } {
    { tag: 2, value: 0 - 1, error_code: 0 }
}
