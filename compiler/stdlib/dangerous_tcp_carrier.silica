// The (:tcp) carrier of transport_serialization_design.md §6.3: a dangerous actor over the socket
// wrappers (dangerous_sockets) speaking the carrier contract of §6.2. It is spawned with
// spawn_dangerous(initial(), carrier, ...) and opened with (:open, owner, address):
//
//   address "host:port"   connects to the peer;
//   address "listen:port" listens on 127.0.0.1 and serves the first peer to connect (port 0 picks a
//                          free port); this phase serves one connection per listening carrier.
//
// After :link_up the carrier grants the owner 8 send credits; each :tx consumes one and :tx_credit
// hands it back once the bytes are written. Received bytes are delivered as :rx only while the owner
// has granted :credit; the carrier polls its socket between mailbox messages with a 20 ms timeout,
// so it never blocks its thread for longer than that.
module dangerous_tcp_carrier;

use dangerous_sockets;

export initial/0;
export carrier/2;

fn initial() -> { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean } {
    { owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false }
}

fn starts(s: string, p: string) -> boolean {
    length_bytes(s) >= length_bytes(p) and substring(s, 0, length_bytes(p)) == p
}

// byte_at is a transport operation (specification §9.1.1, §16.4): called inside a sequence that
// declares `transport`, here, so the address parsers stay pure.
fn at(s: string, i: int64) -> int64 {
    sequence proc[transport]
        b: int64 <- byte_at(s, i)
    produces
        pure b
    end
}

fn digits_from(s: string, i: int64, acc: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> {
            d: int64 <- at(s, i) - 48;
            case d < 0 or d > 9 of {
                true -> acc;
                false -> digits_from(s, i + 1, acc * 10 + d)
            }
        }
    }
}

fn host_of(address: string) -> string {
    substring_until_char(address, 0, ':')
}

fn port_of(address: string) -> int64 {
    h: string <- host_of(address);
    digits_from(address, length_bytes(h) + 1, 0)
}

fn pure_int(r: (:ok, int64) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, v: int64) -> v;
        (:rejected, _why: atom) -> 0 - 1
    }
}

fn int_text_from(n: int64, acc: string) -> string {
    case n < 10 of {
        true -> concat(substring("0123456789", n, n + 1), acc);
        false -> int_text_from(n / 10, concat(substring("0123456789", n % 10, n % 10 + 1), acc))
    }
}

fn int_text(n: int64) -> string {
    int_text_from(n, "")
}

// The message read without the worker's effects: pure selectors a sequence can bind.
fn msg_kind(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll) -> atom {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> :open;
        (:tx, _s: string, _f: actor_ref) -> :tx;
        (:credit, _n: int64) -> :credit;
        :close -> :close;
        :poll -> :poll
    }
}

fn msg_owner(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, fallback: actor_ref) -> actor_ref {
    case msg of {
        (:open, o: actor_ref, _a: string) -> o;
        (:tx, _s: string, _f: actor_ref) -> fallback;
        (:credit, _n: int64) -> fallback;
        :close -> fallback;
        :poll -> fallback
    }
}

fn msg_text(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll) -> string {
    case msg of {
        (:open, _o: actor_ref, a: string) -> a;
        (:tx, s: string, _f: actor_ref) -> s;
        (:credit, _n: int64) -> "";
        :close -> "";
        :poll -> ""
    }
}

fn msg_count(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll) -> int64 {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> 0;
        (:tx, _s: string, _f: actor_ref) -> 0;
        (:credit, n: int64) -> n;
        :close -> 0;
        :poll -> 0
    }
}

fn none_res() -> { tag: int64, value: int64, error_code: int64 } {
    { tag: 2, value: 0 - 1, error_code: 0 }
}

// One mailbox message, one pass over the socket: the sequence proc[external_danger] is the whole body
// (the language allows it only there), so the work is chosen by the message and the state and each
// wrapper is called at most once per message. Received bytes reach the owner in the one tainted cast
// a worker may make per message.
fn carrier(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean }) -> (:no_reply, { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean }) {
    sequence proc[external_danger, concurrency, transport]
        kind: atom <- msg_kind(msg);
        owner: actor_ref <- msg_owner(msg, state.owner);
        text: string <- msg_text(msg);
        listen_mode: boolean <- starts(text, "listen:");
        do_connect: boolean <- kind == :open and listen_mode == false;
        do_listen: boolean <- kind == :open and listen_mode;
        res_open: { tag: int64, value: int64, error_code: int64 } <- case do_connect of {
            true -> dangerous_sockets@tcp_connect(host_of(text), port_of(text));
            false -> case do_listen of {
                true -> dangerous_sockets@tcp_listen(port_of(text));
                false -> none_res()
            }
        };
        open_tag_raw: int64 <- res_open.tag;
        open_fd_raw: int64 <- res_open.value;
        open_tag: int64 <- pure_int(recreate(open_tag_raw));
        open_fd: int64 <- pure_int(recreate(open_fd_raw));
        do_accept: boolean <- kind == :poll and state.listening;
        res_acc: { tag: int64, value: int64, error_code: int64 } <- case do_accept of {
            true -> dangerous_sockets@tcp_accept(state.fd, 20);
            false -> none_res()
        };
        acc_tag_raw: int64 <- res_acc.tag;
        acc_fd_raw: int64 <- res_acc.value;
        acc_tag: int64 <- pure_int(recreate(acc_tag_raw));
        acc_fd: int64 <- pure_int(recreate(acc_fd_raw));
        accepted: boolean <- do_accept and acc_tag == 0;
        bound: boolean <- do_listen and open_tag == 0;
        res_port: { tag: int64, value: int64, error_code: int64 } <- case bound of {
            true -> dangerous_sockets@local_port(open_fd);
            false -> none_res()
        };
        port_raw: int64 <- res_port.value;
        port: int64 <- pure_int(recreate(port_raw));
        _: { tag: int64, value: int64, error_code: int64 } <- case accepted of {
            true -> dangerous_sockets@close_fd(state.fd);
            false -> none_res()
        };
        do_tx: boolean <- kind == :tx and state.up;
        res_tx: { tag: int64, value: int64, error_code: int64 } <- case do_tx of {
            true -> dangerous_sockets@send_bytes(state.fd, text, 1000);
            false -> none_res()
        };
        tx_tag_raw: int64 <- res_tx.tag;
        tx_tag: int64 <- pure_int(recreate(tx_tag_raw));
        do_rx: boolean <- kind == :poll and state.up and state.listening == false and state.rx_credit > 0;
        res_rx: { tag: int64, value: int64, error_code: int64 } <- case do_rx of {
            true -> dangerous_sockets@recv_bytes(state.fd, 65536, 20);
            false -> none_res()
        };
        rx_tag_raw: int64 <- res_rx.tag;
        rx_tag: int64 <- pure_int(recreate(rx_tag_raw));
        got: boolean <- do_rx and rx_tag == 0;
        bytes_in: string <- case got of {
            true -> dangerous_sockets@take(state.fd);
            false -> ""
        };
        do_close: boolean <- kind == :close;
        _: { tag: int64, value: int64, error_code: int64 } <- case do_close of {
            true -> dangerous_sockets@close_fd(state.fd);
            false -> none_res()
        };
        // :link_up once when connected; for a listener once when bound ("port:<n>", the port the
        // system chose when asked for 0) and once more when a peer is accepted ("peer:accepted").
        link_up_now: boolean <- (do_connect and open_tag == 0) or bound or accepted;
        link_down_now: boolean <- (kind == :open and open_tag != 0) or (do_rx and (rx_tag == 1 or rx_tag == 3)) or do_close;
        down_reason: atom <- case do_close of {
            true -> :closed;
            false -> case do_rx and rx_tag == 3 of {
                true -> :closed;
                false -> :fault
            }
        };
        _: boolean <- case link_up_now of {
            true -> cast(owner, (:link_up, case bound of { true -> concat("port:", int_text(port)); false -> case accepted of { true -> "peer:accepted"; false -> text } }) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case (do_connect and open_tag == 0) or accepted of {
            true -> cast(owner, (:tx_credit, 8) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case do_tx of {
            true -> case tx_tag == 0 of {
                true -> cast(owner, (:tx_credit, 1) impl ActorMessage {});
                false -> cast(owner, (:tx_failed, :link_down) impl ActorMessage {})
            };
            false -> case kind == :tx of {
                true -> cast(owner, (:tx_failed, :link_down) impl ActorMessage {});
                false -> true
            }
        };
        _: boolean <- case got of {
            true -> cast(owner, (:rx, bytes_in) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case link_down_now of {
            true -> cast(owner, (:link_down, down_reason) impl ActorMessage {});
            false -> true
        };
        up_next: boolean <- case link_down_now of {
            true -> false;
            false -> state.up or (do_connect and open_tag == 0) or accepted
        };
        listening_next: boolean <- case link_down_now of {
            true -> false;
            false -> (do_listen and open_tag == 0) or (state.listening and accepted == false)
        };
        fd_next: int64 <- case kind == :open of {
            true -> open_fd;
            false -> case accepted of {
                true -> acc_fd;
                false -> case do_close of { true -> 0 - 1; false -> state.fd }
            }
        };
        credit_next: int64 <- case kind == :credit of {
            true -> state.rx_credit + msg_count(msg);
            false -> case got of { true -> state.rx_credit - 1; false -> state.rx_credit }
        };
        keep_polling: boolean <- (kind == :open and open_tag == 0) or (kind == :poll and (up_next or listening_next));
        poll_delay: uint64 <- case kind == :poll and up_next and listening_next == false and state.rx_credit == 0 of { true -> 20; false -> 1 };
        _: boolean <- case keep_polling of {
            true -> {
                sequence proc[concurrency]
                    _: timer_ref <- send_after(poll_delay, self(), :poll impl ActorMessage {})
                produces
                    pure true
                end
            };
            false -> true
        }
    produces
        pure (:no_reply, { owner: owner, fd: fd_next, rx_credit: credit_next, up: up_next, listening: listening_next })
    end
}
