// The (:tcp) carrier of transport_serialization_design.md §6.3: a dangerous actor over the socket
// wrappers (dangerous_sockets) speaking the carrier contract of §6.2. It is spawned with
// spawn_dangerous(initial(), carrier, ...) and opened with (:open, owner, address):
//
//   address "host:port"        connects to the peer: a connection carrier;
//   address "listen:port"      binds 127.0.0.1:port (port 0 picks a free port) and becomes a listener;
//   address "listen:ipv4:port" binds the one given IPv4 address (dotted quad) and becomes a listener;
//   address "listen:any:port"  binds 0.0.0.0:port, every IPv4 interface of the host, and becomes a listener
//                              that behaves exactly as the loopback one. It is the explicit wildcard form for a
//                              carrier spawned without a link; nothing chooses it by default.
//
// The link (transport_links_design.md §3.2, hosted Ethernet plan stage E2). The state's `link_spec` is written by
// the target's transport pack when spawn_dangerous_carrier expands a `carried_on` declaration: "" for a carrier
// spawned directly (no declaration), "loopback", "interface:<name>", "ethernet:<n>" or "wifi:<n>". A named link
// (interface, ethernet, wifi) binds the socket to that interface's IPv4 address, looked up with getifaddrs at
// :open: a bare "listen:port" listens on it, "listen:ipv4:port" must name one of its addresses, and a connection
// leaves from it. "listen:any:port" is refused under every link, and (:loopback) refuses a "listen:ipv4:port"
// outside 127.0.0.0/8. An interface that is absent or has no IPv4 address, fewer than n+1 interfaces of the
// family, or a refused address end the carrier with (:explicit, :link_unavailable); a "listen:ipv4:port" whose
// address is not a dotted quad ends it with (:explicit, :bad_address). Before ending, the carrier tells its owner
// (:link_down, :fault), as for a lost link (links design §6.3); the supervisor's restart policy is the retry.
//
// SECURITY: the (:tcp) carrier is plain TCP. It provides no authentication, no encryption and no peer identity:
// anyone who can reach a listening port can connect and send frames, and anyone on the path can read and change
// the bytes. For "listen:any:port" that means anyone who can reach the port from any network the host is on; the
// host's firewall (a source-address rule) is then the only protection, so keep such a listener up only while it is
// needed. Secure interchange is being built on top of this carrier in Project BEES
// (https://github.com/Silica-Language-and-Compiler/project-bees): SEMP/TRUST over mutual TLS 1.3 (ALPN trust/1, a
// certificate whitelist; the TLS engine is selected: OpenSSL on macOS and Linux, Mbed TLS on the NUCLEO-L476RG and
// the ESP32-S3) and an Erlang-compatible BEAM mode with cookie authentication. As of 2026-11-10 BEES's TLS and
// TRUST code is not built yet and its cookie handshake is in progress; both build on this carrier's non-loopback
// support
// ("listen:any:port" and dialing a non-loopback address). Today BEES's BEAM-mode wire runs between BEES nodes on
// loopback only, without the cookie digest (test-only, unauthenticated).
//
// A connection carrier answers :link_up, grants 8 send credits, and then moves bytes: each :tx
// consumes one credit and :tx_credit hands it back once the bytes are written; received bytes are
// delivered as :rx only while the owner has granted :credit.
//
// A listener answers (:link_up, "port:<n>") once bound and never carries bytes itself. For every
// peer it accepts it spawns one connection carrier holding the accepted descriptor and tells its
// owner (:accepted, conn: dangerous_actor_ref, "peer:<ipv4>:<port>") (getpeername; "peer:accepted" if the
// peer's address cannot be read). That connection carrier waits
// for its own (:open, owner, _) (the address is ignored: the peer is already connected); whoever
// sends it becomes the connection's owner and receives its :link_up, its credits, its :rx and its
// :link_down, exactly as the owner of a connecting carrier does. The listener keeps listening until
// it is sent :close, which closes the listening socket only; the connections it spawned live on.
//
// A carrier polls its descriptor between mailbox messages with a 20 ms timeout, so it never
// blocks its thread for longer than that.
module dangerous_tcp_carrier;

use dangerous_sockets;

export initial/0;
export carrier/2;

fn initial() -> { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string } {
    { owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false, link_spec: "" }
}

fn starts(s: string, p: string) -> boolean {
    length_bytes(s) >= length_bytes(p) and substring(s, 0, length_bytes(p)) == p
}

// byte_at is a transport operation (specification §9.1.1, §16.4): called inside a sequence that
// declares `transport`, here, so the address parsers stay pure.
fn at(s: string, i: int64) -> int64 {
    sequence proc[transport]
        b: int64 <- byte_at(s, i)
    produces
        pure b
    end
}

fn digits_from(s: string, i: int64, acc: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> {
            d: int64 <- at(s, i) - 48;
            case d < 0 or d > 9 of {
                true -> acc;
                false -> digits_from(s, i + 1, acc * 10 + d)
            }
        }
    }
}

fn host_of(address: string) -> string {
    substring_until_char(address, 0, ':')
}

fn port_of(address: string) -> int64 {
    h: string <- host_of(address);
    digits_from(address, length_bytes(h) + 1, 0)
}

// The port of a listener address: "listen:any:<port>", "listen:<ipv4>:<port>" or "listen:<port>".
fn listen_port_of(address: string) -> int64 {
    case starts(address, "listen:any:") of {
        true -> digits_from(address, 11, 0);
        false -> {
            rest: string <- substring(address, 7, length_bytes(address));
            first: string <- substring_until_char(rest, 0, ':');
            case length_bytes(first) == length_bytes(rest) of {
                true -> port_of(address);
                false -> digits_from(rest, length_bytes(first) + 1, 0)
            }
        }
    }
}

// The listener forms: "listen:any:<port>" -> :any; "listen:<ipv4>:<port>" -> :ip; "listen:<port>" -> :port.
fn listen_form(address: string) -> atom {
    rest: string <- substring(address, 7, length_bytes(address));
    case starts(address, "listen:any:") of {
        true -> :any;
        false -> case length_bytes(substring_until_char(rest, 0, ':')) == length_bytes(rest) of {
            true -> :port;
            false -> :ip
        }
    }
}

// The address text of "listen:<ipv4>:<port>".
fn listen_ip_text(address: string) -> string {
    substring_until_char(address, 7, ':')
}

// The kind of the state's link ("" when the carrier was spawned without a carried_on declaration).
fn link_kind(spec: string) -> atom {
    case substring_until_char(spec, 0, ':') of {
        "loopback" -> :loopback;
        "interface" -> :interface;
        "ethernet" -> :ethernet;
        "wifi" -> :wifi;
        _: string -> :none
    }
}

// The family code of dangerous_sockets@link_select: 0 by name, 1 wired, 2 wireless.
fn link_family(kind: atom) -> int64 {
    case kind of {
        :ethernet -> 1;
        :wifi -> 2;
        _: atom -> 0
    }
}

// What follows the link's tag: the interface name of "interface:<name>", the instance of "ethernet:<n>".
fn link_param(spec: string) -> string {
    tag: string <- substring_until_char(spec, 0, ':');
    substring(spec, length_bytes(tag) + 1, length_bytes(spec))
}

fn link_instance(spec: string) -> int64 {
    digits_from(link_param(spec), 0, 0)
}

fn ipv4_text(a: int64) -> string {
    concat(concat(concat(concat(int_text(a / 16777216 % 256), "."), concat(int_text(a / 65536 % 256), ".")), concat(int_text(a / 256 % 256), ".")), int_text(a % 256))
}

fn is_loopback_ipv4(a: int64) -> boolean {
    a / 16777216 == 127
}

// Which listen wrapper an :open uses: :any (0.0.0.0), :addr (one IPv4 address), :loopback (127.0.0.1), :none.
fn listen_call(do_listen: boolean, refused: boolean, form: atom, named: boolean) -> atom {
    case do_listen and refused == false of {
        false -> :none;
        true -> case form of {
            :any -> :any;
            :ip -> :addr;
            _: atom -> case named of {
                true -> :addr;
                false -> :loopback
            }
        }
    }
}

fn pure_int(r: (:ok, int64) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, v: int64) -> v;
        (:rejected, _why: atom) -> 0 - 1
    }
}

fn int_text_from(n: int64, acc: string) -> string {
    case n < 10 of {
        true -> concat(substring("0123456789", n, n + 1), acc);
        false -> int_text_from(n / 10, concat(substring("0123456789", n % 10, n % 10 + 1), acc))
    }
}

fn int_text(n: int64) -> string {
    int_text_from(n, "")
}

// The message read without the worker's effects: pure selectors a sequence can bind.
fn msg_kind(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll) -> atom {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> :open;
        (:tx, _s: string, _f: actor_ref) -> :tx;
        (:credit, _n: int64) -> :credit;
        :close -> :close;
        :poll -> :poll
    }
}

fn msg_owner(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, fallback: actor_ref) -> actor_ref {
    case msg of {
        (:open, o: actor_ref, _a: string) -> o;
        (:tx, _s: string, _f: actor_ref) -> fallback;
        (:credit, _n: int64) -> fallback;
        :close -> fallback;
        :poll -> fallback
    }
}

fn msg_text(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll) -> string {
    case msg of {
        (:open, _o: actor_ref, a: string) -> a;
        (:tx, s: string, _f: actor_ref) -> s;
        (:credit, _n: int64) -> "";
        :close -> "";
        :poll -> ""
    }
}

fn msg_count(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll) -> int64 {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> 0;
        (:tx, _s: string, _f: actor_ref) -> 0;
        (:credit, n: int64) -> n;
        :close -> 0;
        :poll -> 0
    }
}

fn none_res() -> { tag: int64, value: int64, error_code: int64 } {
    { tag: 2, value: 0 - 1, error_code: 0 }
}

// One mailbox message, one pass over the socket: the sequence proc[external_danger] is the whole body
// (the language allows it only there), so the work is chosen by the message and the state and each
// wrapper is called at most once per message. Received bytes reach the owner in the one tainted cast
// a worker may make per message.
//
// The state tells the three roles apart: `listening` is a listener; `up` is a connection carrying
// bytes; a descriptor with neither (fd >= 0, not up, not listening) is a connection a listener
// accepted that is waiting for its (:open, owner, _).
fn carrier(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }) -> (:no_reply, { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }) {
    sequence proc[external_danger, concurrency, transport]
        kind: atom <- msg_kind(msg);
        owner: actor_ref <- msg_owner(msg, state.owner);
        text: string <- msg_text(msg);
        adoptable: boolean <- state.fd >= 0 and state.up == false and state.listening == false;
        do_adopt: boolean <- kind == :open and adoptable;
        listen_mode: boolean <- starts(text, "listen:");
        do_connect: boolean <- kind == :open and adoptable == false and listen_mode == false;
        do_listen: boolean <- kind == :open and adoptable == false and listen_mode;
        // The link's address rules (header): the interface's address from link_select, the literal of
        // "listen:<ipv4>:<port>" from parse_ipv4, and link_owns for a literal under a named link.
        lkind: atom <- link_kind(state.link_spec);
        named: boolean <- lkind == :interface or lkind == :ethernet or lkind == :wifi;
        form: atom <- listen_form(text);
        do_select: boolean <- (do_connect and named) or (do_listen and named and form != :any);
        res_sel: { tag: int64, value: int64, error_code: int64 } <- case do_select of {
            true -> dangerous_sockets@link_select(link_param(state.link_spec), link_family(lkind), link_instance(state.link_spec));
            false -> none_res()
        };
        sel_tag_raw: int64 <- res_sel.tag;
        sel_addr_raw: int64 <- res_sel.value;
        sel_tag: int64 <- pure_int(recreate(sel_tag_raw));
        sel_addr: int64 <- pure_int(recreate(sel_addr_raw));
        do_parse: boolean <- do_listen and form == :ip;
        res_ip: { tag: int64, value: int64, error_code: int64 } <- case do_parse of {
            true -> dangerous_sockets@parse_ipv4(listen_ip_text(text));
            false -> none_res()
        };
        ip_tag_raw: int64 <- res_ip.tag;
        ip_addr_raw: int64 <- res_ip.value;
        ip_tag: int64 <- pure_int(recreate(ip_tag_raw));
        ip_addr: int64 <- pure_int(recreate(ip_addr_raw));
        bad_address: boolean <- do_parse and ip_tag != 0;
        do_owns: boolean <- do_parse and named and bad_address == false and sel_tag == 0;
        res_owns: { tag: int64, value: int64, error_code: int64 } <- case do_owns of {
            true -> dangerous_sockets@link_owns(ip_addr);
            false -> none_res()
        };
        owns_raw: int64 <- res_owns.value;
        owns: int64 <- pure_int(recreate(owns_raw));
        link_refused: boolean <- (do_listen and form == :any and lkind != :none) or (do_select and sel_tag != 0) or (do_parse and bad_address == false and lkind == :loopback and is_loopback_ipv4(ip_addr) == false) or (do_owns and owns != 1);
        refused: boolean <- bad_address or link_refused;
        bind_ip: string <- case form == :ip of {
            true -> listen_ip_text(text);
            false -> ipv4_text(sel_addr)
        };
        res_open: { tag: int64, value: int64, error_code: int64 } <- case do_connect and refused == false of {
            true -> case named of {
                true -> dangerous_sockets@tcp_connect_from(host_of(text), port_of(text), sel_addr);
                false -> dangerous_sockets@tcp_connect(host_of(text), port_of(text))
            };
            false -> case listen_call(do_listen, refused, form, named) of {
                :any -> dangerous_sockets@tcp_listen_any(listen_port_of(text));
                :addr -> dangerous_sockets@tcp_listen_addr(bind_ip, listen_port_of(text));
                :loopback -> dangerous_sockets@tcp_listen(listen_port_of(text));
                _: atom -> none_res()
            }
        };
        open_tag_raw: int64 <- res_open.tag;
        open_fd_raw: int64 <- res_open.value;
        open_tag: int64 <- pure_int(recreate(open_tag_raw));
        open_fd: int64 <- pure_int(recreate(open_fd_raw));
        do_accept: boolean <- kind == :poll and state.listening;
        res_acc: { tag: int64, value: int64, error_code: int64 } <- case do_accept of {
            true -> dangerous_sockets@tcp_accept(state.fd, 20);
            false -> none_res()
        };
        acc_tag_raw: int64 <- res_acc.tag;
        acc_fd_raw: int64 <- res_acc.value;
        acc_tag: int64 <- pure_int(recreate(acc_tag_raw));
        acc_fd: int64 <- pure_int(recreate(acc_fd_raw));
        accepted: boolean <- do_accept and acc_tag == 0;
        // Who connected (getpeername): read by the listener for its :accepted and by the accepted
        // connection for its :link_up.
        peer_fd: int64 <- case accepted of {
            true -> acc_fd;
            false -> case do_adopt of {
                true -> state.fd;
                false -> 0 - 1
            }
        };
        res_pa: { tag: int64, value: int64, error_code: int64 } <- case peer_fd >= 0 of {
            true -> dangerous_sockets@peer_addr(peer_fd);
            false -> none_res()
        };
        res_pp: { tag: int64, value: int64, error_code: int64 } <- case peer_fd >= 0 of {
            true -> dangerous_sockets@peer_port(peer_fd);
            false -> none_res()
        };
        pa_tag_raw: int64 <- res_pa.tag;
        pa_raw: int64 <- res_pa.value;
        pp_tag_raw: int64 <- res_pp.tag;
        pp_raw: int64 <- res_pp.value;
        pa_tag: int64 <- pure_int(recreate(pa_tag_raw));
        pa: int64 <- pure_int(recreate(pa_raw));
        pp_tag: int64 <- pure_int(recreate(pp_tag_raw));
        pp: int64 <- pure_int(recreate(pp_raw));
        peer_text: string <- case pa_tag == 0 and pp_tag == 0 of {
            true -> concat(concat(concat("peer:", ipv4_text(pa)), ":"), int_text(pp));
            false -> "peer:accepted"
        };
        bound: boolean <- do_listen and open_tag == 0;
        res_port: { tag: int64, value: int64, error_code: int64 } <- case bound of {
            true -> dangerous_sockets@local_port(open_fd);
            false -> none_res()
        };
        port_raw: int64 <- res_port.value;
        port: int64 <- pure_int(recreate(port_raw));
        do_tx: boolean <- kind == :tx and state.up;
        res_tx: { tag: int64, value: int64, error_code: int64 } <- case do_tx of {
            true -> dangerous_sockets@send_bytes(state.fd, text, 1000);
            false -> none_res()
        };
        tx_tag_raw: int64 <- res_tx.tag;
        tx_tag: int64 <- pure_int(recreate(tx_tag_raw));
        do_rx: boolean <- kind == :poll and state.up and state.listening == false and state.rx_credit > 0;
        res_rx: { tag: int64, value: int64, error_code: int64 } <- case do_rx of {
            true -> dangerous_sockets@recv_bytes(state.fd, 65536, 20);
            false -> none_res()
        };
        rx_tag_raw: int64 <- res_rx.tag;
        rx_tag: int64 <- pure_int(recreate(rx_tag_raw));
        got: boolean <- do_rx and rx_tag == 0;
        bytes_in: string <- case got of {
            true -> dangerous_sockets@take(state.fd);
            false -> ""
        };
        do_close: boolean <- kind == :close and state.fd >= 0;
        _: { tag: int64, value: int64, error_code: int64 } <- case do_close of {
            true -> dangerous_sockets@close_fd(state.fd);
            false -> none_res()
        };
        // An accepted peer gets a connection carrier of its own, holding the accepted descriptor;
        // the owner learns of it and chooses who opens it.
        _: boolean <- case accepted of {
            true -> {
                sequence proc[concurrency]
                    conn: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: acc_fd, rx_credit: 0, up: false, listening: false, link_spec: state.link_spec }, carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                    told: boolean <- cast(owner, (:accepted, conn, peer_text) impl ActorMessage {})
                produces
                    pure told
                end
            };
            false -> true
        };
        // :link_up once when connected, once when a listener is bound ("port:<n>", the port the
        // system chose when asked for 0), and once when an accepted connection is opened.
        connected: boolean <- do_connect and open_tag == 0;
        link_up_now: boolean <- connected or bound or do_adopt;
        link_down_now: boolean <- (kind == :open and adoptable == false and open_tag != 0) or (do_rx and (rx_tag == 1 or rx_tag == 3)) or (kind == :close);
        down_reason: atom <- case kind == :close of {
            true -> :closed;
            false -> case do_rx and rx_tag == 3 of {
                true -> :closed;
                false -> :fault
            }
        };
        _: boolean <- case link_up_now of {
            true -> cast(owner, (:link_up, case bound of { true -> concat("port:", int_text(port)); false -> case do_adopt of { true -> peer_text; false -> text } }) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case connected or do_adopt of {
            true -> cast(owner, (:tx_credit, 8) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case do_tx of {
            true -> case tx_tag == 0 of {
                true -> cast(owner, (:tx_credit, 1) impl ActorMessage {});
                false -> cast(owner, (:tx_failed, :link_down) impl ActorMessage {})
            };
            false -> case kind == :tx of {
                true -> cast(owner, (:tx_failed, :link_down) impl ActorMessage {});
                false -> true
            }
        };
        _: boolean <- case got of {
            true -> cast(owner, (:rx, bytes_in) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case link_down_now of {
            true -> cast(owner, (:link_down, down_reason) impl ActorMessage {});
            false -> true
        };
        // A link refusal or a malformed listen address ends the carrier (header; links design §6.3): the owner
        // has its (:link_down, :fault), and the supervisor's restart policy is the retry.
        _: atom <- case refused of {
            true -> case bad_address of {
                true -> stop_self((:explicit, :bad_address));
                false -> stop_self((:explicit, :link_unavailable))
            };
            false -> :ok
        };
        up_next: boolean <- case link_down_now of {
            true -> false;
            false -> state.up or connected or do_adopt
        };
        listening_next: boolean <- case link_down_now of {
            true -> false;
            false -> bound or state.listening
        };
        fd_next: int64 <- case kind == :open and adoptable == false of {
            true -> open_fd;
            false -> case kind == :close of { true -> 0 - 1; false -> state.fd }
        };
        credit_next: int64 <- case kind == :credit of {
            true -> state.rx_credit + msg_count(msg);
            false -> case got of { true -> state.rx_credit - 1; false -> state.rx_credit }
        };
        keep_polling: boolean <- connected or bound or do_adopt or (kind == :poll and (up_next or listening_next));
        poll_delay: uint64 <- case kind == :poll and up_next and listening_next == false and state.rx_credit == 0 of { true -> 20; false -> 1 };
        _: boolean <- case keep_polling of {
            true -> {
                sequence proc[concurrency]
                    _: timer_ref <- send_after(poll_delay, self(), :poll impl ActorMessage {})
                produces
                    pure true
                end
            };
            false -> true
        }
    produces
        pure (:no_reply, { owner: owner, fd: fd_next, rx_credit: credit_next, up: up_next, listening: listening_next, link_spec: state.link_spec })
    end
}
