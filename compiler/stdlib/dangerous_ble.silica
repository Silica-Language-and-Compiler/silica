// The Fifi Bluetooth wrapper (compiler/stdlib/ble/silica_ble.m, CoreBluetooth on macOS) as a dangerous
// module: the raw bindings and their adapters, in the shape of dangerous_sockets. Every answer is the
// wrapper's tagged result { tag, value, error_code } with tag 0 ok, 1 error, 2 timeout, 3 link down;
// received bytes come back through take/1 as a string. A project that uses the hosted (:ble_gatt)
// carrier links the archive libsilica_ble.a with -framework CoreBluetooth -framework Foundation and
// places silica_ble_wrapper.meta under dangerous_exposure_source/ble.
module dangerous_ble;

wrapper_meta "dangerous_exposure_source/ble/silica_ble_wrapper.meta";

export open/3;
export phase/3;
export mtu/1;
export send_bytes/3;
export recv_bytes/3;
export take/1;
export close/1;

// The FFI carries a pointer-plus-length pair only as a binding's sole parameters, so a wrapper that
// needs a string and scalars takes the scalars first (set_args; kept per worker thread).
foreign c_wrapper "silica_ble_set_args"
fn set_args_raw(a: int64, b: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_open"
fn open_raw(uuid_ptr: uint8, uuid_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_phase"
fn phase_raw(from: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_mtu"
fn mtu_raw(handle: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_send"
fn send_raw(data_ptr: uint8, data_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_recv"
fn recv_raw(handle: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_ble_take"
fn take_raw(handle: int64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

foreign c_wrapper "silica_ble_close"
fn close_raw(handle: int64) -> { tag: int64, value: int64, error_code: int64 };

// role: 0 central, 1 peripheral. service: the service's UUID text, "" for the Nordic UART Service.
// value: the session's handle.
fn open(role: int64, service: string, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(role, timeout_ms);
    r: { tag: int64, value: int64, error_code: int64 } <- open_raw(service);
    r
}

// The phase (0 starting, 1 scanning or advertising, 2 up, 3 closed by the peer, 4 lost, 5 fault),
// after waiting up to timeout_ms for it to differ from `from`.
fn phase(handle: int64, from: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(handle, 0);
    r: { tag: int64, value: int64, error_code: int64 } <- phase_raw(from, timeout_ms);
    r
}

// The largest segment the link carries: the negotiated ATT_MTU minus 3 once it is up.
fn mtu(handle: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- mtu_raw(handle);
    r
}

// One segment; error_code 4 when it is empty or longer than the link's mtu.
fn send_bytes(handle: int64, data: string, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(handle, timeout_ms);
    r: { tag: int64, value: int64, error_code: int64 } <- send_raw(data);
    r
}

fn recv_bytes(handle: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- recv_raw(handle, max, timeout_ms);
    r
}

// The bytes of the last recv_bytes on this worker.
fn take(handle: int64) -> string {
    out: string <- take_raw(handle);
    out
}

fn close(handle: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- close_raw(handle);
    r
}
