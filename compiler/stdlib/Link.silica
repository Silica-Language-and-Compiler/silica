// The language-wide link facts of transport_links_design.md §3.1 and §3.4 (specification §16.4.9),
// beside Carrier.silica and closed like it: a link is the hardware a carrier runs on, named in a
// `carried_on <name>: (<:kind>) (<:link>, <params>...);` declaration, and these rows say which link
// tags the language names, how many parameters each takes and which carrier kinds each can carry.
// The parameter is the link tag's atom (:loopback, :uart, ...): a one-atom tagged tuple is not a
// run-time value, and the design's spelling Link@carries((:uart), :serial) names the same row as
// Link@carries(:uart, :serial). The target-specific question, whether this build provides the link,
// is the transport pack's (provides_link), read by the compiler, not by programs.
//
// The compiler's own copy of this table is type_checker/type_checker_links.silica (E2413 unknown tag,
// E2414 kind and link do not pair, E2417 parameter count): the two are kept in step by hand.

export known/1;
export arity/1;
export carries/2;
export instance_indexed/1;

// Every link tag the language names (the union of every target's pack, as for carriers).
fn known(l: atom) -> boolean {
    case l of {
        :loopback -> true;
        :interface -> true;
        :ethernet -> true;
        :wifi -> true;
        :uart -> true;
        :serial_port -> true;
        :usb_cdc -> true;
        :usb_serial_jtag -> true;
        :bluetooth -> true;
        _: atom -> false
    }
}

// The number of parameters after the tag: (:loopback) 0, (:interface, name) 1, (:ethernet, n) 1,
// (:wifi, n) 1, (:uart, n, baud) 2, (:serial_port, path, baud) 2, (:usb_cdc, n) 1, (:usb_serial_jtag) 0,
// (:bluetooth, n) 1.
// -1 for a tag the language does not name.
fn arity(l: atom) -> int64 {
    case l of {
        :loopback -> 0;
        :interface -> 1;
        :ethernet -> 1;
        :wifi -> 1;
        :uart -> 2;
        :serial_port -> 2;
        :usb_cdc -> 1;
        :usb_serial_jtag -> 0;
        :bluetooth -> 1;
        _: atom -> 0 - 1
    }
}

// Whether the first parameter is an instance number (decision 6: two links of the same kind are told
// apart by instance; E2415 when two declarations name the same tag and instance).
fn instance_indexed(l: atom) -> boolean {
    case l of {
        :ethernet -> true;
        :wifi -> true;
        :uart -> true;
        :usb_cdc -> true;
        :bluetooth -> true;
        _: atom -> false
    }
}

// The pairing table of §3.1: which carrier kinds a link can carry. The network links carry :tcp and
// :udp; the serial links (UART, a host serial port, USB CDC, the ESP32-S3's USB-Serial-JTAG) carry
// :serial. The Bluetooth link (:bluetooth, n), the n-th Bluetooth adapter, carries :ble_gatt and
// nothing else (transport_ble_plan.md §4). A mismatch is E2414.
fn carries(l: atom, kind: atom) -> boolean {
    case l of {
        :loopback -> kind == :tcp or kind == :udp;
        :interface -> kind == :tcp or kind == :udp;
        :ethernet -> kind == :tcp or kind == :udp;
        :wifi -> kind == :tcp or kind == :udp;
        :uart -> kind == :serial;
        :serial_port -> kind == :serial;
        :usb_cdc -> kind == :serial;
        :usb_serial_jtag -> kind == :serial;
        :bluetooth -> kind == :ble_gatt;
        _: atom -> false
    }
}
