link_library: "silica_wifi_lwip"

wrapper silica_wifi_start {
    symbol: "silica_wifi_start"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_event {
    symbol: "silica_wifi_event"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_event_field {
    symbol: "silica_wifi_event_field"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_advertise {
    symbol: "silica_wifi_advertise"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
    arguments: [
        { name: "uuid_ptr", lifetime: "borrowed", retain: false },
        { name: "uuid_len", role: "length", length_of: "uuid_ptr" }
    ]
}

wrapper silica_wifi_stop_advertising {
    symbol: "silica_wifi_stop_advertising"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_memory {
    symbol: "silica_wifi_memory"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_serve {
    symbol: "silica_wifi_serve"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
    arguments: [
        { name: "uuid_ptr", lifetime: "borrowed", retain: false },
        { name: "uuid_len", role: "length", length_of: "uuid_ptr" }
    ]
}

wrapper silica_wifi_set_args {
    symbol: "silica_wifi_set_args"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_mtu {
    symbol: "silica_wifi_mtu"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_send {
    symbol: "silica_wifi_send"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
    arguments: [
        { name: "data_ptr", lifetime: "borrowed", retain: false },
        { name: "data_len", role: "length", length_of: "data_ptr" }
    ]
}

wrapper silica_wifi_recv {
    symbol: "silica_wifi_recv"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_take {
    symbol: "silica_wifi_take"
    result: "struct"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_drop {
    symbol: "silica_wifi_drop"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
}

wrapper silica_wifi_seek {
    symbol: "silica_wifi_seek"
    result: "tagged_result"
    error_domain: "dangerous_wifi"
    arguments: [
        { name: "uuid_ptr", lifetime: "borrowed", retain: false },
        { name: "uuid_len", role: "length", length_of: "uuid_ptr" }
    ]
}
