// The Fifi wrapper around NimBLE (compiler/stdlib/ble/silica_ble_nimble.c) as a dangerous module: the
// raw bindings and their adapters, for a program that runs on the ESP32-S3 as a guest of ESP-IDF
// (transport_ble_plan.md §2.1). Every answer is the wrapper's tagged result { tag, value, error_code }
// with tag 0 ok, 1 error, 2 nothing yet. No call waits for the radio: what NimBLE reports later comes
// out of event/1. Only the radio actor (dangerous_ble_radio) calls this module. A project that uses it
// places silica_ble_nimble_wrapper.meta under dangerous_exposure_source/ble and adds
// silica_ble_nimble.c to its guest image.
module dangerous_nimble;

wrapper_meta "dangerous_exposure_source/ble/silica_ble_nimble_wrapper.meta";

export start/0;
export event/1;
export event_field/1;
export advertise/1;
export stop_advertising/0;
export memory/1;

foreign c_wrapper "silica_nimble_start"
fn start_raw(reserved: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_nimble_event"
fn event_raw(timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_nimble_event_field"
fn event_field_raw(index: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_nimble_advertise"
fn advertise_raw(uuid_ptr: uint8, uuid_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_nimble_stop_advertising"
fn stop_advertising_raw(reserved: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_nimble_memory"
fn memory_raw(which: int64) -> { tag: int64, value: int64, error_code: int64 };

// Starts the controller and the host, once. Event 1 (synced) says when requests are accepted.
fn start() -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- start_raw(0);
    r
}

// The next event, waiting up to timeout_ms for one (0: only look); tag 2 when there is none. value:
// 1 synced, 2 reset, 3 advertising ended, 4 connected, 5 disconnected.
fn event(timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- event_raw(timeout_ms);
    r
}

// Field 0 or 1 of the event that event/1 answered last (the wrapper says what each event carries).
fn event_field(index: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- event_field_raw(index);
    r
}

// service: the service's UUID text (4, 8 or 36 characters), "" for the Nordic UART Service.
// error_code 6 for text that is no UUID, 7 before the synced event.
fn advertise(service: string) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- advertise_raw(service);
    r
}

fn stop_advertising() -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- stop_advertising_raw(0);
    r
}

// ESP-IDF's internal heap in bytes: 0 free now, 1 the least free since start, 2 the largest free block.
fn memory(which: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- memory_raw(which);
    r
}
