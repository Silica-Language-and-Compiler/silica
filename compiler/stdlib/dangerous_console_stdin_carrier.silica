// The (:stdin) link of the (:serial) carrier (stdin_carrier_design.md): a dangerous actor over the
// process's standard input (descriptor 0, through the Fifi wrapper dangerous_console), speaking the carrier
// contract of transport_serialization_design.md §6.2 receive-only. It is opened with (:open, owner, "") and
// answers (:link_up, "stdin:tty") or (:link_up, "stdin:pipe"), with no :tx_credit (nothing can be sent to
// standard input; a :tx is answered (:tx_failed, :no_credit)). Bytes are delivered as (:rx, segment) against
// the owner's (:credit, n), one credit per segment; the segments are whatever read(2) returned, cut
// anywhere. With no credit nothing is read, so the writer of a pipe blocks when the OS buffer fills.
//
// THE POLL LOOP. A :credit starts the :poll loop when it is not running; a :poll with credit reads at most
// 65536 bytes without blocking: data is delivered and :poll follows 1 ms later, nothing waiting retries
// after 20 ms (as dangerous_serial_carrier does), and a :poll with no credit ends the loop. Foreign bytes
// leave the carrier only as the (:rx, bytes) cast; they never enter its state.
//
// THE END. The end of input answers (:link_down, :closed) and ends the carrier (stop_self(:normal)); a read
// error answers (:link_down, :fault) and ends it with (:explicit, :link_lost). :close answers
// (:link_down, :closed) and ends it normally. Descriptor 0 is never closed. A second (:open, ...) while open
// is answered (:link_down, :in_use) to its sender and changes nothing.
//
// THE OWNER is a dangerous module too: the (:rx, chunk) bytes are external-danger-touched, so it de-taints
// each chunk in its (:rx) handler with `recreate(chunk, { max_bytes: 65536 })` BEFORE framing, and frames the
// pure bytes with wireframe's :lines mode (unframe, then finish at the end, skip_line after :too_large). A
// chunk can end in the middle of a UTF-8 sequence, so utf8 validation (`{ max_bytes: N, utf8: true }`)
// belongs on complete lines, not on chunks.
module dangerous_console_stdin_carrier;

use dangerous_console;

export initial/0;
export carrier/2;

fn initial() -> { owner: actor_ref, up: boolean, rx_credit: int64, polling: boolean, ending: atom } {
    { owner: actor_ref_of_word(0), up: false, rx_credit: 0, polling: false, ending: :no }
}

// The message read without the worker's effects: pure selectors a sequence can bind. msg_kind's arms
// return the atoms, which interns the tags the tuple patterns match.
fn msg_kind(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll) -> atom {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> :open;
        (:tx, _s: string, _f: actor_ref) -> :tx;
        (:credit, _n: int64) -> :credit;
        :close -> :close;
        :poll -> :poll
    }
}

// The opener of an :open, the sender of a :tx, else the fallback.
fn msg_peer(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, fallback: actor_ref) -> actor_ref {
    case msg of {
        (:open, o: actor_ref, _a: string) -> o;
        (:tx, _s: string, f: actor_ref) -> f;
        (:credit, _n: int64) -> fallback;
        :close -> fallback;
        :poll -> fallback
    }
}

fn msg_count(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll) -> int64 {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> 0;
        (:tx, _s: string, _f: actor_ref) -> 0;
        (:credit, n: int64) -> n;
        :close -> 0;
        :poll -> 0
    }
}

fn pure_int(r: (:ok, int64) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, v: int64) -> v;
        (:rejected, _why: atom) -> 0 - 1
    }
}

fn none_res() -> { tag: int64, value: int64, error_code: int64 } {
    { tag: 2, value: 0 - 1, error_code: 0 }
}

fn carrier(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, up: boolean, rx_credit: int64, polling: boolean, ending: atom }) -> (:no_reply, { owner: actor_ref, up: boolean, rx_credit: int64, polling: boolean, ending: atom }) {
    sequence proc[external_danger, concurrency, transport]
        kind: atom <- msg_kind(msg);
        peer: actor_ref <- msg_peer(msg, state.owner);
        do_open: boolean <- kind == :open and state.up == false;
        refuse_open: boolean <- kind == :open and state.up;
        // the owner of this dispatch: the opener on a first :open, else the one already held
        owner: actor_ref <- case do_open of { true -> peer; false -> state.owner };
        res_probe: { tag: int64, value: int64, error_code: int64 } <- case do_open of {
            true -> dangerous_console@probe();
            false -> none_res()
        };
        probe_value_raw: int64 <- res_probe.value;
        probe_value: int64 <- pure_int(recreate(probe_value_raw));
        // bound before the cast: a call nested in a tuple argument clobbers the argument registers
        up_text: string <- case probe_value == 1 of { true -> "stdin:tty"; false -> "stdin:pipe" };
        do_rx: boolean <- kind == :poll and state.up and state.rx_credit > 0;
        res_rx: { tag: int64, value: int64, error_code: int64 } <- case do_rx of {
            true -> dangerous_console@read(65536);
            false -> none_res()
        };
        rx_tag_raw: int64 <- res_rx.tag;
        rx_tag: int64 <- pure_int(recreate(rx_tag_raw));
        got: boolean <- do_rx and rx_tag == 0;
        bytes_in: string <- case got of {
            true -> dangerous_console@take();
            false -> ""
        };
        rx_idle: boolean <- do_rx and rx_tag == 2;
        rx_end: boolean <- do_rx and rx_tag == 3;
        rx_fault: boolean <- do_rx and rx_tag == 1;
        do_close: boolean <- kind == :close;
        closing: boolean <- do_close or rx_end;
        _: boolean <- case do_open of {
            true -> cast(owner, (:link_up, up_text) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case refuse_open of {
            true -> cast(peer, (:link_down, :in_use) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case kind == :tx of {
            true -> cast(peer, (:tx_failed, :no_credit) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case got of {
            true -> cast(owner, (:rx, bytes_in) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case closing of {
            true -> cast(owner, (:link_down, :closed) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case rx_fault of {
            true -> cast(owner, (:link_down, :fault) impl ActorMessage {});
            false -> true
        };
        // The carrier ends with its link (transport design 6.2): :link_down is the last message its owner
        // receives. stop_self takes effect when this dispatch returns.
        ending_next: atom <- case closing of {
            true -> :normal;
            false -> case rx_fault of { true -> :lost; false -> :no }
        };
        _: atom <- case closing of {
            true -> stop_self(:normal);
            false -> case rx_fault of {
                true -> stop_self((:explicit, :link_lost));
                false -> :ok
            }
        };
        up_next: boolean <- case closing or rx_fault of { true -> false; false -> state.up or do_open };
        credit_next: int64 <- case kind == :credit of {
            true -> state.rx_credit + msg_count(msg);
            false -> case got of { true -> state.rx_credit - 1; false -> state.rx_credit }
        };
        // the loop starts when credit is held and none is running, and goes on after data or an idle read
        start_poll: boolean <- up_next and state.polling == false and credit_next > 0 and (kind == :credit or do_open);
        keep_polling: boolean <- start_poll or got or rx_idle;
        poll_delay: uint64 <- case rx_idle of { true -> 20; false -> 1 };
        _: boolean <- case keep_polling of {
            true -> {
                sequence proc[concurrency]
                    _: timer_ref <- send_after(poll_delay, self(), :poll impl ActorMessage {})
                produces
                    pure true
                end
            };
            false -> true
        };
        polling_next: boolean <- case up_next of {
            false -> false;
            true -> case kind == :poll of { true -> keep_polling; false -> state.polling or keep_polling }
        }
    produces
        pure (:no_reply, { owner: owner, up: up_next, rx_credit: credit_next, polling: polling_next, ending: ending_next })
    end
}
