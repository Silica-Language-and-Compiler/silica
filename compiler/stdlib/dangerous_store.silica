// The Fifi wrappers of the hosted (:backing) storage medium (compiler/stdlib/net/silica_store.c) as a
// dangerous module: the raw bindings and their adapters. Every answer is the wrapper's tagged result
// { tag, value, error_code } with tag 0 ok, 1 error (errno in error_code), 4 the backing is already
// open (locked), 5 the backing exists at another size; bytes read come back through take/1 as a
// string. A project that uses a (:backing) store links the archive libsilica_store.a and places
// silica_store_wrapper.meta under dangerous_exposure_source/sockets, beside the socket wrappers'.
module dangerous_store;

wrapper_meta "dangerous_exposure_source/sockets/silica_store_wrapper.meta";

export open_backing/2;
export headers/4;
export read_at/3;
export take/1;
export write_entries/2;
export flush/1;
export close_fd/1;

// The FFI carries a pointer-plus-length pair only as a binding's sole parameters, so a wrapper that
// needs a string and scalars takes the scalars first (set_args; kept per worker thread).
foreign c_wrapper "silica_store_set_args"
fn set_args_raw(a: int64, b: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_store_open"
fn open_raw(path_ptr: uint8, path_len: uint64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_store_headers"
fn headers_raw(fd: int64, count: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_store_read"
fn read_raw(fd: int64, offset: int64, length: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_store_take"
fn take_raw(fd: int64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };
foreign c_wrapper "silica_store_write"
fn write_raw(data_ptr: uint8, data_len: uint64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_store_flush"
fn flush_raw(fd: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_store_close"
fn close_raw(fd: int64) -> { tag: int64, value: int64, error_code: int64 };

// Opens the backing at path, capacity bytes long, under its exclusive lock; value is the descriptor.
fn open_backing(path: string, capacity: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(capacity, 0);
    r: { tag: int64, value: int64, error_code: int64 } <- open_raw(path);
    r
}

// The 16-byte headers of `count` blocks of block_size bytes, from block `first` on, one after another
// (take/1 answers them).
fn headers(fd: int64, block_size: int64, first: int64, count: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(block_size, first);
    r: { tag: int64, value: int64, error_code: int64 } <- headers_raw(fd, count);
    r
}

fn read_at(fd: int64, offset: int64, length: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- read_raw(fd, offset, length);
    r
}

// The bytes of the last headers or read_at on this worker.
fn take(fd: int64) -> string {
    out: string <- take_raw(fd);
    out
}

// Makes a list of pending writes (storelog@entry, one after another), in order.
fn write_entries(fd: int64, entries: string) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(fd, 0);
    r: { tag: int64, value: int64, error_code: int64 } <- write_raw(entries);
    r
}

fn flush(fd: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- flush_raw(fd);
    r
}

fn close_fd(fd: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- close_raw(fd);
    r
}
