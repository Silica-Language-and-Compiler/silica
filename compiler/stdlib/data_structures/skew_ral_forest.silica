// Layer 2 §15 steps 2–4 — skew binary random-access list: forest spine (leaf module).
// Authority: skew_binary_random_access_list.md §2 (digits), §4 (prepend), §5 (head and tail).
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// The spine is an immutable List of digits (weight, tree) in increasing weight order; only the
// first two digits may share a weight. Prepend links at most once, so it is O(1) worst case.
// The forest is passed separately from the record so callers can thread intermediate spines.
// Every exported function whose signature mentions ItemType takes the collection record first:
// the compiler resolves ItemType at a qualified call site from the record's compare_item witness
// (type_checker_collections@assoc_type_from_record_witness). The core never calls compare_item.

use skew_ral_weights;
use skew_ral_node;

export forest_empty/0;
export forest_prepend/3;
export forest_head/3;
export forest_tail/1;

fn forest_empty() -> List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- empty[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]()
    produces
        pure out
    end
}

fn push_digit(
    w: int64,
    t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] {
    sequence proc[mem(normal)]
        d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- (w, t);
        out: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- prepend[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)](d, rest)
    produces
        pure out
    end
}

fn prepend_leaf(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    item: ItemType
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    sequence
        grown: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- push_digit(1, skew_ral_node@alloc_leaf(ral, item), forest)
    produces
        pure { forest: grown, status: :ok }
    end
}

fn prepend_link_alloc(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    rest2: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    item: ItemType,
    lw: int64,
    t1: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    t2: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    sequence
        grown: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- push_digit(lw, skew_ral_node@alloc_node(ral, item, t1, t2), rest2)
    produces
        pure { forest: grown, status: :ok }
    end
}

// Overflow of 1 + 2w publishes nothing: the caller's forest is returned unchanged.
fn prepend_link(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    rest2: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    item: ItemType,
    w1: int64,
    t1: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    t2: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    lw_pair: (boolean, int64) <- skew_ral_weights@link_weight(w1);
    (ok: boolean, lw: int64) <- lw_pair;
    case ok of {
        false -> { forest: forest, status: :overflow };
        true -> prepend_link_alloc(ral, rest2, item, lw, t1, t2)
    }
}

fn prepend_pair(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    item: ItemType,
    d1: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    d2: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest2: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    (w1: int64, t1: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d1;
    (w2: int64, t2: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d2;
    case w1 == w2 of {
        false -> prepend_leaf(ral, forest, item);
        true -> prepend_link(ral, forest, rest2, item, w1, t1, t2)
    }
}

fn prepend_second(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    item: ItemType,
    d1: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest1: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    case rest1 of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> prepend_leaf(ral, forest, item);
        [d2: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest2: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> prepend_pair(ral, forest, item, d1, d2, rest2)
    }
}

fn forest_prepend(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    item: ItemType
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    case forest of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> prepend_leaf(ral, forest, item);
        [d1: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest1: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> prepend_second(ral, forest, item, d1, rest1)
    }
}

fn head_digit(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    (_: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    parts: { present: boolean, item: ItemType, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) } <- skew_ral_node@read_node(ral, t, placeholder);
    case parts.present of {
        true -> { status: :found, value: parts.item };
        false -> { status: :not_found, value: placeholder }
    }
}

fn forest_head(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    case forest of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> { status: :not_found, value: placeholder };
        [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), _: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> head_digit(ral, d, placeholder)
    }
}

// Removing a node of weight w exposes its children as two digits of weight w / 2, left first.
fn tail_split_cell(
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    cw: int64,
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :not_found | :found } {
    sequence proc[mem(normal)]
        node: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (_, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        with_right: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- push_digit(cw, right, rest);
        with_both: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- push_digit(cw, left, with_right)
    produces
        pure { forest: with_both, status: :found }
    end
}

fn tail_split(
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    cw: int64,
    t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :not_found | :found } {
    case t of {
        :none -> { forest: rest, status: :found };
        node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> tail_split_cell(rest, cw, node_ref)
    }
}

fn tail_digit(
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :not_found | :found } {
    (w: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    case w == 1 of {
        true -> { forest: rest, status: :found };
        false -> tail_split(rest, skew_ral_weights@child_weight(w), t)
    }
}

fn forest_tail(
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :not_found | :found } {
    case forest of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> { forest: forest, status: :not_found };
        [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> tail_digit(d, rest)
    }
}
