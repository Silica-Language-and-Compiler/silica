// Layer 3E — persistent rose tree with skew-binary child-slot sequences: the `tree_rose`
// generated module. Authority: design_documents/Phase1_TODOs/data_structure_designs/tree_trait.md
// (§4 node, §6 generated surface, §7–§14 semantics) over skew_binary_random_access_list.md (§8
// reverse orientation); the public Tree trait forwards here.
//
// Representation (inline at every boundary; ItemType appears only inside nodes):
//   { root: ref?, compare_item, region, specialization_key, compare_item_ordering_bundle }
// A node is (item, subtree_node_count, live_child_count, slot_count, anchor, child_slots) with
// child_slots the forest spine of a skew binary random-access list in the REVERSE orientation
// (design §4: physical_index = slot_count - 1 - logical_slot, so append is O(1) and every earlier
// slot number is stable). The list's item type is ref?(L, normal, rec): :none is a vacant slot and
// a reference is an occupied slot (design §4 writes this as :vacant | (:occupied, ref); an optional
// reference is that sum with nothing added). The anchor is always :none and exists only because
// alloc_rec requires a direct recursive slot in the tuple (as brodal_okasaki_node).
//
// Composition with skew_ral (the nested-generic rule): a node stores only the RAL's forest spine and
// its length; every skew_ral call rebuilds the collection record { count: slot_count, reversed: true,
// compare_item: slot_compare, forest, region: tree.region, specialization_key: 0 } through slots_of,
// so each qualified call has a flat, concrete item type (ref?) and its own compare_item witness, and
// the RAL cells live in the tree's canonical arena. slot_compare is never called (child placement
// never depends on ordering, design §2).
//
// Deviations forced by the bootstrap compiler (each mirrors an existing stdlib module):
//   1. add_child is a supervisor built-in name (spawn/add_child/link/...): a user function so named
//      is typed and emitted as the built-in and callers must declare proc[concurrency]. The design's
//      add_child/3 is therefore exported as add_leaf/3 with the same contract.
//   2. get/child_at/find_first take a placeholder item: Silica source cannot conjure an ItemType zero
//      value for a :not_found payload (as tree_binary, brodal_okasaki). root_item/1 keeps the design
//      arity: the tree is never empty through public constructors, so a :none root (a malformed
//      fixture) is a deterministic collection error.
//   3. Atom values are numbered per compilation unit, so validation error atoms are created and
//      decoded here only (validate_error_code). Paths are List[int64, mem(normal)] and need no atom.
//   4. Memory space is normal only, as in every other Phase 1 module.
//   5. The Tree[ItemType, mem(SpaceType)] bracket family is registered: a program may annotate a
//      tree as Tree[string, mem(normal)] (trials/ordered_data_structures/tree_collections/
//      tree_field_annotation.silica); this module itself declares the inline record above.
//   6. Preorder traversal materializes each visited node's occupied (slot, child) entries in
//      ascending slot order (children_of, O(b) cells per node) because a fold callback in this unit
//      cannot carry this unit's AccType through skew_ral's AccType; the design's cursor remark (§5)
//      permits an internal cursor. Bounds are unchanged: O(n + s) time.
//   7. Single parentage (design §13 item 3) is checked on the active path only (cycle detection);
//      a node reachable through two different parents validates with its count per occurrence, as
//      tree_binary does. compare_item results are validated at every search comparison; an atom
//      outside :less | :equal | :greater is a deterministic collection error (division by zero).
//   8. Known open emitter defect, not worked around here: when ItemType is a tuple, a concrete unit
//      reads a record field that FOLLOWS the ItemType field at an inline-pair offset while this unit
//      stored one slot, so child_at's child_path and find_first's path are unreadable for tuple items
//      (get's value, the last field, is fine). Repro: trials/ordered_data_structures/tree_collections/
//      staged/record_tuple_field_then_list_read.silica.
// Every exported function whose signature mentions ItemType takes the tree record first; folds
// take the accumulator second (AccType is witnessed by argument two). A user unit that cases on
// compare_item's result must list :less, :equal, :greater in that order where they first appear
// (atoms are numbered per unit; see the brodal_okasaki_compare header).
//
// Arena: canonical_arena_lookup(arena_key()) — one application-lifetime arena for every value of
// this representation.

use skew_ral;

export arena_key/0;
export with_root/2;
export node_count/1;
export root_item/1;
export get/3;
export child_count/2;
export child_slot_count/2;
export child_at/4;
export find_first/3;
export fold_preorder/3;
export compare_item/3;
export replace_item/3;
export add_leaf/3;
export add_subtree/3;
export remove_child/3;
export validate/1;
export validate_error_code/1;
export path_root/0;
export path_with/2;
export path_length/1;
export compatible_trees/2;

// ---------------------------------------------------------------------------------------------
// Comparator (design §2, common_contract §4). compare_raw stays the first function in this unit:
// the emitter numbers :less/:equal/:greater at the first comparator_result_validate call.
// ---------------------------------------------------------------------------------------------

fn compare_raw(
    compare: fn(ItemType, ItemType) -> atom,
    a: ItemType,
    b: ItemType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

// Deterministic collection error: an atom outside the comparator triple never becomes a branch.
fn invalid_comparator_halt(_: atom, placeholder: ItemType) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0;
        _: ItemType <- placeholder
    produces
        pure :equal
    end
}

// Compares two items with the comparator captured by the tree.
fn compare_item(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    a: ItemType,
    b: ItemType
) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_raw(tree.compare_item, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_comparator_halt(bad, a)
        }
    end
}

fn arena_key() -> int64 {
    85
}

// ---------------------------------------------------------------------------------------------
// Paths (design §3): stable child-slot numbers, root first; the empty path is the root.
// ---------------------------------------------------------------------------------------------

fn path_root() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure e
    end
}

fn path_cons(slot: int64, rest: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        p: List[int64, mem(normal)] <- prepend[int64, mem(normal)](slot, rest)
    produces
        pure p
    end
}

// The path that follows `path` and then selects `slot`.
fn path_with(path: List[int64, mem(normal)], slot: int64) -> List[int64, mem(normal)] {
    case path.is_nil of {
        true -> path_cons(slot, path);
        false -> path_cons(path.head, path_with(path.tail, slot))
    }
}

fn path_length_go(path: List[int64, mem(normal)], acc: int64) -> int64 {
    case path.is_nil of {
        true -> acc;
        false -> path_length_go(path.tail, acc + 1)
    }
}

fn path_length(path: List[int64, mem(normal)]) -> int64 {
    path_length_go(path, 0)
}

// Reverses a root-most-last cursor into a root-first path (design §5: paths handed to a fold are
// immutable snapshots; the cursor itself is shared between visits).
fn reverse_path_go(rev: List[int64, mem(normal)], acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case rev.is_nil of {
        true -> acc;
        false -> reverse_path_go(rev.tail, path_cons(rev.head, acc))
    }
}

fn reverse_path(rev: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    reverse_path_go(rev, path_root())
}

// ---------------------------------------------------------------------------------------------
// Nodes and child-slot sequences.
// ---------------------------------------------------------------------------------------------

fn slot_compare(_: ref?(L, normal, rec), _: ref?(L, normal, rec)) -> :less | :equal | :greater {
    :equal
}

fn none_slot() -> ref?(L, normal, rec) {
    :none
}

fn empty_forest() -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[(int64, ref?(L, normal, rec)), mem(normal)] <- empty[(int64, ref?(L, normal, rec)), mem(normal)]()
    produces
        pure out
    end
}

fn read_node(node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)]))) -> { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } {
    sequence proc[mem(normal)]
        node: (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)]) <- read_ref(node_ref);
        (item, count: int64, live: int64, slots: int64, _: ref?(L, normal, rec), forest: List[(int64, ref?(L, normal, rec)), mem(normal)]) <- node
    produces
        pure { item: item, count: count, live: live, slots: slots, forest: forest }
    end
}

fn read_count(node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)]))) -> int64 {
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
    parts.count
}

// Cached logical count of a subtree; zero for :none.
fn cached_count(node: ref?(L, normal, rec)) -> int64 {
    case node of {
        :none -> 0;
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> read_count(node_ref)
    }
}

// Allocators return (region, ref) pairs: a bare reference return would outlive its region (E2100).
fn alloc_node(
    arena: region(L, normal),
    item: ItemType,
    count: int64,
    live: int64,
    slots: int64,
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> (region(L, normal), ref?(L, normal, rec)) {
    sequence proc[mem(normal)]
        cell: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) <- alloc_rec(arena, (item, count, live, slots, :none, forest))
    produces
        pure (arena, cell)
    end
}

// The child-slot random-access list of one node, rebuilt around its stored spine (reverse
// orientation, design §4); its cells live in the tree's canonical arena.
fn slots_of(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] }
) -> {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    } {
    out: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    } <- {
        count: parts.slots,
        reversed: true,
        compare_item: slot_compare,
        forest: parts.forest,
        region: tree.region,
        specialization_key: 0
    };
    out
}

// The occupied child at a logical slot, :none when the slot is vacant, negative, or past the end.
fn slot_ref(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    slot: int64
) -> ref?(L, normal, rec) {
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    } <- slots_of(tree, parts);
    got: { status: :not_found | :found, value: ref?(L, normal, rec) } <- skew_ral@get(ral, slot, none_slot());
    case got.status of {
        :not_found -> :none;
        :found -> got.value
    }
}

// Physical order is descending logical order under the reverse orientation, so prepending each
// occupied entry while walking physically yields ascending slot order.
fn collect_step(acc: { entries: List[(int64, ref?(L, normal, rec)), mem(normal)], next: int64 }, item: ref?(L, normal, rec)) -> { entries: List[(int64, ref?(L, normal, rec)), mem(normal)], next: int64 } {
    sequence proc[mem(normal)]
        out: { entries: List[(int64, ref?(L, normal, rec)), mem(normal)], next: int64 } <- case item of {
            :none -> { entries: acc.entries, next: acc.next - 1 };
            _: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
                e: (int64, ref?(L, normal, rec)) <- (acc.next, item);
                grown: List[(int64, ref?(L, normal, rec)), mem(normal)] <- prepend[(int64, ref?(L, normal, rec)), mem(normal)](e, acc.entries);
                { entries: grown, next: acc.next - 1 }
            }
        }
    produces
        pure out
    end
}

// The occupied (slot, child) entries of one node in ascending slot order; vacant slots are skipped.
fn children_of(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] }
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence
        ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    } <- slots_of(tree, parts);
        e0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- empty_forest();
        acc0: { entries: List[(int64, ref?(L, normal, rec)), mem(normal)], next: int64 } <- { entries: e0, next: parts.slots - 1 };
        acc1: { entries: List[(int64, ref?(L, normal, rec)), mem(normal)], next: int64 } <- skew_ral@fold_physical(ral, acc0, collect_step)
    produces
        pure acc1.entries
    end
}

fn entry_count(entries: List[(int64, ref?(L, normal, rec)), mem(normal)], acc: int64) -> int64 {
    case entries.is_nil of {
        true -> acc;
        false -> entry_count(entries.tail, acc + 1)
    }
}

// ---------------------------------------------------------------------------------------------
// Owning value (design §2).
// ---------------------------------------------------------------------------------------------

fn publish(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root: ref?(L, normal, rec)
) -> {
    root: ref?(L, normal, rec),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    out: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- {
        root: root,
        compare_item: tree.compare_item,
        region: tree.region,
        specialization_key: tree.specialization_key,
        compare_item_ordering_bundle: tree.compare_item_ordering_bundle
    };
    out
}

// A one-node tree in the canonical arena; the ordering identity of the comparator is captured
// once here (common_contract §5) and preserved by every persistent update.
fn with_root(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    root_item: ItemType
) -> {
    root: ref?(L, normal, rec),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        arena: region(L, normal) <- canonical_arena_lookup(85);
        token: int64 <- ordering_identity_materialize(functions.compare_item);
        f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- empty_forest();
        pair: (region(L, normal), ref?(L, normal, rec)) <- alloc_node(arena, root_item, 1, 0, 0, f0);
        (_: region(L, normal), root: ref?(L, normal, rec)) <- pair;
        out: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- {
            root: root,
            compare_item: functions.compare_item,
            region: arena,
            specialization_key: 0,
            compare_item_ordering_bundle: token
        }
    produces
        pure out
    end
}

// Compatibility (design §8): same item type and space are static; canonical arena identity,
// comparator ordering identity, and specialization key are checked at runtime.
fn compatible_trees(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    other: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> boolean {
    sequence
        same_arena: boolean <- canonical_arena_same(tree.region, other.region);
        same_order: boolean <- ordering_identity_same(tree.compare_item_ordering_bundle, other.compare_item_ordering_bundle)
    produces
        pure same_arena and same_order and tree.specialization_key == other.specialization_key
    end
}

// ---------------------------------------------------------------------------------------------
// Queries (design §7): no query allocates a node.
// ---------------------------------------------------------------------------------------------

fn node_count(tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> int64 {
    cached_count(tree.root)
}

// Unreachable through public constructors: the tree is never empty (design §2).
fn root_item_halt(tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> ItemType {
    sequence
        _: int64 <- 1 / 0
    produces
        pure root_item(tree)
    end
}

fn root_item(tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> ItemType {
    case tree.root of {
        :none -> root_item_halt(tree);
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            parts.item
        }
    }
}

// Follows a root-first path of stable slots; :none when any component is vacant or out of range.
fn find_node(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    path: List[int64, mem(normal)]
) -> ref?(L, normal, rec) {
    case node of {
        :none -> :none;
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> case path.is_nil of {
            true -> node;
            false -> {
                parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
                find_node(tree, slot_ref(tree, parts, path.head), path.tail)
            }
        }
    }
}

fn item_of(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    case node of {
        :none -> { status: :not_found, value: placeholder };
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            { status: :found, value: parts.item }
        }
    }
}

fn get(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)],
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    item_of(tree, find_node(tree, tree.root, path), placeholder)
}

fn live_of(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec)
) -> { status: :not_found | :found, count: int64 } {
    case node of {
        :none -> { status: :not_found, count: 0 };
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            { status: :found, count: parts.live }
        }
    }
}

fn slots_at(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec)
) -> { status: :not_found | :found, count: int64 } {
    case node of {
        :none -> { status: :not_found, count: 0 };
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            { status: :found, count: parts.slots }
        }
    }
}

// Number of occupied child slots at a path.
fn child_count(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)]
) -> { status: :not_found | :found, count: int64 } {
    live_of(tree, find_node(tree, tree.root, path))
}

// Number of occupied and vacant child slots at a path (slots are never compacted, design §11).
fn child_slot_count(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)]
) -> { status: :not_found | :found, count: int64 } {
    slots_at(tree, find_node(tree, tree.root, path))
}

fn child_at_parent(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])),
    path: List[int64, mem(normal)],
    slot: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType, child_path: List[int64, mem(normal)] } {
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(parent_ref);
    found: { status: :not_found | :found, value: ItemType } <- item_of(tree, slot_ref(tree, parts, slot), placeholder);
    case found.status of {
        :not_found -> { status: :not_found, value: placeholder, child_path: path };
        :found -> { status: :found, value: found.value, child_path: path_with(path, slot) }
    }
}

// The direct child at a stable slot of the node at `path`, with the child's own path.
fn child_at(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)],
    slot: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType, child_path: List[int64, mem(normal)] } {
    case find_node(tree, tree.root, path) of {
        :none -> { status: :not_found, value: placeholder, child_path: path };
        parent_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> child_at_parent(tree, parent_ref, path, slot, placeholder)
    }
}

// ---------------------------------------------------------------------------------------------
// Preorder traversal (design §10): node, then occupied slots ascending, each subtree recursively.
// The cursor `rev` is root-most-last; the callback receives a root-first snapshot.
// ---------------------------------------------------------------------------------------------

fn fold_children(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    acc: AccType,
    step: fn(AccType, List[int64, mem(normal)], ItemType) -> AccType,
    entries: List[(int64, ref?(L, normal, rec)), mem(normal)],
    rev: List[int64, mem(normal)]
) -> AccType {
    case entries.is_nil of {
        true -> acc;
        false -> {
            (slot: int64, child: ref?(L, normal, rec)) <- entries.head;
            acc_child: AccType <- fold_node(tree, acc, step, child, path_cons(slot, rev));
            fold_children(tree, acc_child, step, entries.tail, rev)
        }
    }
}

fn fold_node(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    acc: AccType,
    step: fn(AccType, List[int64, mem(normal)], ItemType) -> AccType,
    node: ref?(L, normal, rec),
    rev: List[int64, mem(normal)]
) -> AccType {
    case node of {
        :none -> acc;
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            here: List[int64, mem(normal)] <- reverse_path(rev);
            acc_node: AccType <- step(acc, here, parts.item);
            entries: List[(int64, ref?(L, normal, rec)), mem(normal)] <- children_of(tree, parts);
            fold_children(tree, acc_node, step, entries, rev)
        }
    }
}

fn fold_preorder(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    init: AccType,
    step: fn(AccType, List[int64, mem(normal)], ItemType) -> AccType
) -> AccType {
    fold_node(tree, init, step, tree.root, path_root())
}

// ---------------------------------------------------------------------------------------------
// find_first (design §10): the first preorder node whose item compares :equal to the query.
// ---------------------------------------------------------------------------------------------

fn search_children(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    entries: List[(int64, ref?(L, normal, rec)), mem(normal)],
    rev: List[int64, mem(normal)],
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType, path: List[int64, mem(normal)] } {
    case entries.is_nil of {
        true -> { status: :not_found, value: placeholder, path: rev };
        false -> {
            (slot: int64, child: ref?(L, normal, rec)) <- entries.head;
            hit: { status: :not_found | :found, value: ItemType, path: List[int64, mem(normal)] } <- search_node(tree, item, child, path_cons(slot, rev), placeholder);
            case hit.status of {
                :found -> hit;
                :not_found -> search_children(tree, item, entries.tail, rev, placeholder)
            }
        }
    }
}

fn search_node(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    node: ref?(L, normal, rec),
    rev: List[int64, mem(normal)],
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType, path: List[int64, mem(normal)] } {
    case node of {
        :none -> { status: :not_found, value: placeholder, path: rev };
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            case compare_item(tree, item, parts.item) of {
                :equal -> { status: :found, value: parts.item, path: reverse_path(rev) };
                _: atom -> {
                    entries: List[(int64, ref?(L, normal, rec)), mem(normal)] <- children_of(tree, parts);
                    search_children(tree, item, entries, rev, placeholder)
                }
            }
        }
    }
}

fn find_first(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType, path: List[int64, mem(normal)] } {
    hit: { status: :not_found | :found, value: ItemType, path: List[int64, mem(normal)] } <- search_node(tree, item, tree.root, path_root(), placeholder);
    case hit.status of {
        :found -> hit;
        :not_found -> { status: :not_found, value: placeholder, path: path_root() }
    }
}

// ---------------------------------------------------------------------------------------------
// Persistent updates (design §8–§10): the root-to-target path is copied, every copied ancestor
// persistently updates the one child-slot entry that changed (O(log b_i)), and every other slot
// and subtree is shared. A rebuild result carries the replacement node, the subtree-count delta
// it applies to each ancestor, and the operation's own number (child slot / removed count).
// ---------------------------------------------------------------------------------------------

fn res_missing() -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    out: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- { found: false, changed: false, node: :none, delta: 0, info: 0 };
    out
}

// Found but nothing published: a vacant/out-of-range remove slot or a count overflow.
fn res_declined(info: int64) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    out: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- { found: true, changed: false, node: :none, delta: 0, info: info };
    out
}

// Allocates the replacement node and wraps it; the pair is let-bound before use (an aggregate
// returned straight into an argument list is not promoted by the bootstrap emitter).
fn res_alloc(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    count: int64,
    live: int64,
    slots: int64,
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
    delta: int64,
    info: int64
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    pair: (region(L, normal), ref?(L, normal, rec)) <- alloc_node(tree.region, item, count, live, slots, forest);
    (_: region(L, normal), cell: ref?(L, normal, rec)) <- pair;
    out: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- { found: true, changed: true, node: cell, delta: delta, info: info };
    out
}

fn rebuild_changed(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    slot: int64,
    sub: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 }
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    count_pair: (boolean, int64) <- checked_int64_add(parts.count, sub.delta);
    (count_ok: boolean, new_count: int64) <- count_pair;
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    } <- slots_of(tree, parts);
    upd: { list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }, updated: boolean } <- skew_ral@set(ral, slot, sub.node);
    case count_ok and upd.updated of {
        false -> res_declined(sub.info);
        true -> res_alloc(tree, parts.item, new_count, parts.live, parts.slots, upd.list.forest, sub.delta, sub.info)
    }
}

// Copies the ancestor when its subtree changed; otherwise propagates the missing/declined result.
fn rebuild_ancestor(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    slot: int64,
    sub: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 }
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    case sub.changed of {
        false -> sub;
        true -> rebuild_changed(tree, parts, slot, sub)
    }
}

fn replace_item_at(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    path: List[int64, mem(normal)],
    value: ItemType
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    case node of {
        :none -> res_missing();
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            case path.is_nil of {
                true -> res_alloc(tree, value, parts.count, parts.live, parts.slots, parts.forest, 0, 0);
                false -> {
                    sub: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- replace_item_at(tree, slot_ref(tree, parts, path.head), path.tail, value);
                    rebuild_ancestor(tree, parts, path.head, sub)
                }
            }
        }
    }
}

// Replaces the item at `path`: shape, counts and slot numbers unchanged; changed = true whenever
// the path is found (no item equality is consulted), the exact old tree otherwise.
fn replace_item(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)],
    value: ItemType
) -> {
    tree: {
    root: ref?(L, normal, rec),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
},
    changed: boolean
} {
    result: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- replace_item_at(tree, tree.root, path, value);
    case result.changed of {
        false -> { tree: tree, changed: false };
        true -> { tree: publish(tree, result.node), changed: true }
    }
}

// Appends `child` (a subtree of `k` nodes) as a new occupied slot of the node described by
// `parts`: the new slot number is the old slot count; counts are checked before allocation.
fn attach_child(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    child: ref?(L, normal, rec),
    k: int64
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    count_pair: (boolean, int64) <- checked_int64_add(parts.count, k);
    (count_ok: boolean, new_count: int64) <- count_pair;
    slots_pair: (boolean, int64) <- checked_int64_add1(parts.slots);
    (slots_ok: boolean, new_slots: int64) <- slots_pair;
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    } <- slots_of(tree, parts);
    app: { list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }, appended: boolean } <- skew_ral@append(ral, child);
    case count_ok and slots_ok and app.appended of {
        false -> res_declined(0);
        true -> res_alloc(tree, parts.item, new_count, parts.live + 1, new_slots, app.list.forest, k, parts.slots)
    }
}

fn add_leaf_here(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    value: ItemType
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    f0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- empty_forest();
    leaf_pair: (region(L, normal), ref?(L, normal, rec)) <- alloc_node(tree.region, value, 1, 0, 0, f0);
    (_: region(L, normal), leaf: ref?(L, normal, rec)) <- leaf_pair;
    attach_child(tree, parts, leaf, 1)
}

fn add_leaf_at(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    path: List[int64, mem(normal)],
    value: ItemType
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    case node of {
        :none -> res_missing();
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            case path.is_nil of {
                true -> add_leaf_here(tree, parts, value);
                false -> {
                    sub: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- add_leaf_at(tree, slot_ref(tree, parts, path.head), path.tail, value);
                    rebuild_ancestor(tree, parts, path.head, sub)
                }
            }
        }
    }
}

// The design's add_child/3 (deviation 1): appends a one-node child subtree at `parent_path` and
// reports its stable slot; a missing parent answers added = false with the exact old tree.
fn add_leaf(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent_path: List[int64, mem(normal)],
    value: ItemType
) -> {
    tree: {
    root: ref?(L, normal, rec),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
},
    added: boolean,
    child_slot: int64
} {
    result: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- add_leaf_at(tree, tree.root, parent_path, value);
    case result.changed of {
        false -> { tree: tree, added: false, child_slot: -1 };
        true -> { tree: publish(tree, result.node), added: true, child_slot: result.info }
    }
}

fn add_subtree_at(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    path: List[int64, mem(normal)],
    child: ref?(L, normal, rec),
    k: int64
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    case node of {
        :none -> res_missing();
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            case path.is_nil of {
                true -> attach_child(tree, parts, child, k);
                false -> {
                    sub: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- add_subtree_at(tree, slot_ref(tree, parts, path.head), path.tail, child, k);
                    rebuild_ancestor(tree, parts, path.head, sub)
                }
            }
        }
    }
}

fn add_subtree_checked(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent_path: List[int64, mem(normal)],
    subtree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
    tree: {
    root: ref?(L, normal, rec),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
},
    added: boolean,
    child_slot: int64,
    compatible: boolean
} {
    k: int64 <- cached_count(subtree.root);
    result: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- add_subtree_at(tree, tree.root, parent_path, subtree.root, k);
    case result.changed and k > 0 of {
        false -> { tree: tree, added: false, child_slot: -1, compatible: true };
        true -> { tree: publish(tree, result.node), added: true, child_slot: result.info, compatible: true }
    }
}

// Appends a compatible whole tree as a child subtree (its root is shared, its cached count is
// added along the copied path). Incompatibility fails before any allocation.
fn add_subtree(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent_path: List[int64, mem(normal)],
    subtree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
    tree: {
    root: ref?(L, normal, rec),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
},
    added: boolean,
    child_slot: int64,
    compatible: boolean
} {
    case compatible_trees(tree, subtree) of {
        false -> { tree: tree, added: false, child_slot: -1, compatible: false };
        true -> add_subtree_checked(tree, parent_path, subtree)
    }
}

fn remove_occupied(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    slot: int64,
    k: int64
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    } <- slots_of(tree, parts);
    upd: { list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }, updated: boolean } <- skew_ral@set(ral, slot, none_slot());
    case upd.updated of {
        false -> res_declined(0);
        true -> res_alloc(tree, parts.item, parts.count - k, parts.live - 1, parts.slots, upd.list.forest, 0 - k, k)
    }
}

// Vacates one occupied slot: the slot number stays reserved, no sibling moves (design §9).
fn remove_here(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    slot: int64
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    case slot_ref(tree, parts, slot) of {
        :none -> res_declined(0);
        child_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> remove_occupied(tree, parts, slot, read_count(child_ref))
    }
}

fn remove_child_at(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    path: List[int64, mem(normal)],
    slot: int64
) -> { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } {
    case node of {
        :none -> res_missing();
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
            case path.is_nil of {
                true -> remove_here(tree, parts, slot);
                false -> {
                    sub: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- remove_child_at(tree, slot_ref(tree, parts, path.head), path.tail, slot);
                    rebuild_ancestor(tree, parts, path.head, sub)
                }
            }
        }
    }
}

// Removes the complete subtree in `child_slot` of the node at `parent_path`; a missing parent,
// vacant slot or out-of-range slot answers removed = false with the exact old tree.
fn remove_child(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent_path: List[int64, mem(normal)],
    child_slot: int64
) -> {
    tree: {
    root: ref?(L, normal, rec),
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
},
    removed: boolean,
    removed_node_count: int64
} {
    result: { found: boolean, changed: boolean, node: ref?(L, normal, rec), delta: int64, info: int64 } <- remove_child_at(tree, tree.root, parent_path, child_slot);
    case result.changed of {
        false -> { tree: tree, removed: false, removed_node_count: 0 };
        true -> { tree: publish(tree, result.node), removed: true, removed_node_count: result.info }
    }
}

// ---------------------------------------------------------------------------------------------
// Validation (design §13–§14): depth-first, O(n + s) including tombstones. Per node, in order:
// arena membership, active-path cycle, count signs and live <= slots, the child-slot list's own
// invariants and its length against slot_count, the occupied count against live_child_count,
// then every child, then the cached subtree count against 1 + the exact child counts (checked).
// Error atoms are created and decoded here only: :ok, :cycle, :wrong_arena, :missing_root,
// :rank_violation, :negative_count, :size_mismatch, :slot_count_mismatch, :live_count_mismatch,
// :count_overflow.
// ---------------------------------------------------------------------------------------------

fn same_ref(a: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])), b: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)]))) -> boolean {
    sequence
        same: boolean <- ref_eq(a, b)
    produces
        pure same
    end
}

fn in_arena(tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)]))) -> boolean {
    sequence
        inside: boolean <- ref_in_region(node_ref, tree.region)
    produces
        pure inside
    end
}

fn on_active_path(node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])), ancestors: List[(int64, ref?(L, normal, rec)), mem(normal)]) -> boolean {
    case ancestors.is_nil of {
        true -> false;
        false -> {
            (_: int64, ancestor: ref?(L, normal, rec)) <- ancestors.head;
            case ancestor of {
                :none -> on_active_path(node_ref, ancestors.tail);
                ancestor_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> case same_ref(node_ref, ancestor_ref) of {
                    true -> true;
                    false -> on_active_path(node_ref, ancestors.tail)
                }
            }
        }
    }
}

fn validate_err(error: atom) -> { error: atom, count: int64 } {
    { error: error, count: 0 }
}

// Sign and range checks that need no child (design §13: 0 <= live_child_count <= slot_count).
fn shape_error(parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] }) -> atom {
    case parts.count <= 0 of {
        true -> :negative_count;
        false -> case parts.live < 0 or parts.slots < 0 of {
            true -> :negative_count;
            false -> case parts.live > parts.slots of {
                true -> :live_count_mismatch;
                false -> :ok
            }
        }
    }
}

// The child-slot list's own invariants (skew_ral@validate) and its length against slot_count. The
// list's error atoms are decoded through skew_ral@validate_error_code: 2 is its size mismatch (the
// spine does not sum to slot_count), 6 is a cell outside the arena; anything else is a digit or
// tree-shape violation.
fn slots_error(tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] }) -> atom {
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ref?(L, normal, rec), ref?(L, normal, rec)) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    } <- slots_of(tree, parts);
    v: { valid: boolean, error: atom, logical_count: int64 } <- skew_ral@validate(ral);
    case v.valid of {
        true -> case v.logical_count == parts.slots of {
            true -> :ok;
            false -> :slot_count_mismatch
        };
        false -> case skew_ral@validate_error_code(v.error) of {
            2 -> :slot_count_mismatch;
            6 -> :wrong_arena;
            _: int64 -> :rank_violation
        }
    }
}

// Postorder count check: cached = 1 + sum of exact child counts, derived with checked arithmetic.
fn validate_total(cached: int64, child_sum: int64) -> { error: atom, count: int64 } {
    add1_pair: (boolean, int64) <- checked_int64_add1(child_sum);
    (add_ok: boolean, expected: int64) <- add1_pair;
    case add_ok of {
        false -> validate_err(:count_overflow);
        true -> case cached == expected of {
            true -> { error: :ok, count: expected };
            false -> validate_err(:size_mismatch)
        }
    }
}

fn validate_entries(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    entries: List[(int64, ref?(L, normal, rec)), mem(normal)],
    ancestors: List[(int64, ref?(L, normal, rec)), mem(normal)],
    sum: int64
) -> { error: atom, count: int64 } {
    case entries.is_nil of {
        true -> { error: :ok, count: sum };
        false -> {
            (_: int64, child: ref?(L, normal, rec)) <- entries.head;
            child_res: { error: atom, count: int64 } <- validate_node(tree, child, ancestors);
            case child_res.error of {
                :ok -> {
                    sum_pair: (boolean, int64) <- checked_int64_add(sum, child_res.count);
                    (sum_ok: boolean, next_sum: int64) <- sum_pair;
                    case sum_ok of {
                        false -> validate_err(:count_overflow);
                        true -> validate_entries(tree, entries.tail, ancestors, next_sum)
                    }
                };
                bad: atom -> child_res
            }
        }
    }
}

fn validate_children(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    ancestors: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> { error: atom, count: int64 } {
    sequence proc[mem(normal)]
        entry: (int64, ref?(L, normal, rec)) <- (parts.count, node);
        deeper: List[(int64, ref?(L, normal, rec)), mem(normal)] <- prepend[(int64, ref?(L, normal, rec)), mem(normal)](entry, ancestors);
        entries: List[(int64, ref?(L, normal, rec)), mem(normal)] <- children_of(tree, parts);
        occupied: int64 <- entry_count(entries, 0);
        out: { error: atom, count: int64 } <- case occupied == parts.live of {
            false -> validate_err(:live_count_mismatch);
            true -> {
                kids: { error: atom, count: int64 } <- validate_entries(tree, entries, deeper, 0);
                case kids.error of {
                    :ok -> validate_total(parts.count, kids.count);
                    bad: atom -> kids
                }
            }
        }
    produces
        pure out
    end
}

fn validate_parts(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    ancestors: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> { error: atom, count: int64 } {
    case shape_error(parts) of {
        :ok -> case slots_error(tree, parts) of {
            :ok -> validate_children(tree, node, parts, ancestors);
            bad: atom -> validate_err(bad)
        };
        bad: atom -> validate_err(bad)
    }
}

fn validate_node(
    tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node: ref?(L, normal, rec),
    ancestors: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> { error: atom, count: int64 } {
    case node of {
        :none -> { error: :ok, count: 0 };
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> case in_arena(tree, node_ref) of {
            false -> validate_err(:wrong_arena);
            true -> case on_active_path(node_ref, ancestors) of {
                true -> validate_err(:cycle);
                false -> {
                    parts: { item: ItemType, count: int64, live: int64, slots: int64, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- read_node(node_ref);
                    validate_parts(tree, node, parts, ancestors)
                }
            }
        }
    }
}

fn validate_root(tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> { error: atom, count: int64 } {
    sequence proc[mem(normal)]
        ancestors0: List[(int64, ref?(L, normal, rec)), mem(normal)] <- empty[(int64, ref?(L, normal, rec)), mem(normal)]();
        res: { error: atom, count: int64 } <- validate_node(tree, tree.root, ancestors0)
    produces
        pure res
    end
}

fn validate(tree: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }) -> { valid: boolean, error: atom, logical_count: int64 } {
    case tree.root of {
        :none -> { valid: false, error: :missing_root, logical_count: 0 };
        _: ref(L, normal, (ItemType, int64, int64, int64, ref?(L, normal, rec), List[(int64, ref?(L, normal, rec)), mem(normal)])) -> {
            res: { error: atom, count: int64 } <- validate_root(tree);
            case res.error of {
                :ok -> { valid: true, error: :ok, logical_count: res.count };
                bad: atom -> { valid: false, error: bad, logical_count: res.count }
            }
        }
    }
}

// Decodes a validate error atom in the unit that created it.
fn validate_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :cycle -> 1;
        :wrong_arena -> 2;
        :missing_root -> 3;
        :rank_violation -> 4;
        :negative_count -> 5;
        :size_mismatch -> 6;
        :slot_count_mismatch -> 7;
        :live_count_mismatch -> 8;
        :count_overflow -> 9;
        _: atom -> 99
    }
}
