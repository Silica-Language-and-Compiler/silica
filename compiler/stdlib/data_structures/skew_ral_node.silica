// Layer 2 §15 step 1 — skew binary random-access list: tree cell encoding (leaf module).
// Authority: design_documents/Phase1_TODOs/data_structure_designs/skew_binary_random_access_list.md §3.
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// A cell is (item, left, right) with children ref?(L, normal, rec); a leaf stores :none twice.
// Only forest digits carry weights (skew_ral_forest); child weights derive as weight / 2.
// Every cell is allocated in the collection's canonical arena (ral.region).
// Every exported function whose signature mentions ItemType takes the collection record first:
// the compiler resolves ItemType at a qualified call site from the record's compare_item witness
// (type_checker_collections@assoc_type_from_record_witness). The core never calls compare_item.

export alloc_leaf/2;
export alloc_node/4;
export read_node/3;
export in_arena/2;

fn alloc_cell(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> (region(L, normal), ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) {
    sequence proc[mem(normal)]
        arena: region(L, normal) <- ral.region;
        cell: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(arena, (item, left, right))
    produces
        pure (arena, cell)
    end
}

fn alloc_node(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    item: ItemType,
    left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) {
    alloc_pair: (region(L, normal), ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- alloc_cell(ral, item, left, right);
    (_: region(L, normal), cell: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- alloc_pair;
    cell
}

fn alloc_leaf(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    item: ItemType
) -> ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) {
    alloc_node(ral, item, :none, :none)
}

fn read_node_present(
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> { present: boolean, item: ItemType, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) } {
    sequence proc[mem(normal)]
        node: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (item, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node
    produces
        pure { present: true, item: item, left: left, right: right }
    end
}

// Reads one cell without allocating. `present = false` carries the placeholder and :none children.
fn read_node(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    placeholder: ItemType
) -> { present: boolean, item: ItemType, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) } {
    case tree of {
        :none -> { present: false, item: placeholder, left: :none, right: :none };
        node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> read_node_present(node_ref)
    }
}

// Arena membership of one cell. Lives here, not in skew_ral_validate: the emitter appends the
// L_region_contains helper only to units that allocate, and this is the unit that does.
fn in_arena(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> boolean {
    sequence
        inside: boolean <- ref_in_region(node_ref, ral.region)
    produces
        pure inside
    end
}
