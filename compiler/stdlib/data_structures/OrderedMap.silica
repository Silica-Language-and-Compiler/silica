// Public OrderedMap trait — Layer 3 over the §8A wbt_map core.
// Authority: design_documents/Phase1_TODOs/data_structure_designs/ordered_map_trait.md
// Node shape, spelled in every ref? to a node so rec binds to it: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)).
//
// get/find_value keep a not-found placeholder argument (same as the §8A core).

use wbt_map;

export trait OrderedMap;
export compare_key/3;
export compare_value/3;
export get/3;
export fold/3;
export contains_key/2;
export find_value/3;
export size/1;

required {
    fn compare_key(map: OrderedMap, a: KeyType, b: KeyType) -> :less | :equal | :greater;
    fn compare_value(map: OrderedMap, a: ValueType, b: ValueType) -> :less | :equal | :greater;
    fn get(map: OrderedMap, key: KeyType, placeholder: ValueType)
        -> { status: :not_found | :found, value: ValueType };
    fn fold(
        map: OrderedMap,
        init: AccType,
        step: fn(AccType, KeyType, ValueType) -> AccType
    ) -> AccType;
    fn contains_key(map: OrderedMap, key: KeyType) -> boolean;
    fn find_value(map: OrderedMap, value: ValueType, placeholder_key: KeyType)
        -> { status: :not_found | :found, key: KeyType };
    // WBT supplies O(1) cached size; fold-derived size remains available via fold.
    fn size(map: OrderedMap) -> int64;
}

impl fn compare_key(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    a: KeyType,
    b: KeyType
) -> :less | :equal | :greater {
    wbt_map@apply_compare_key(map, a, b)
}

impl fn compare_value(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    a: ValueType,
    b: ValueType
) -> :less | :equal | :greater {
    wbt_map@apply_compare_value(map, a, b)
}

impl fn get(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType,
    placeholder: ValueType
) -> { status: :not_found | :found, value: ValueType } {
    wbt_map@get(map, key, placeholder)
}

impl fn fold(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    init: AccType,
    step: fn(AccType, KeyType, ValueType) -> AccType
) -> AccType {
    wbt_map@fold(map, init, step)
}

impl fn contains_key(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: KeyType
) -> boolean {
    wbt_map@contains_key(map, key)
}

impl fn find_value(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    value: ValueType,
    placeholder_key: KeyType
) -> { status: :not_found | :found, key: KeyType } {
    wbt_map@find_value(map, value, placeholder_key)
}

impl fn size(
    map: {
        root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }
) -> int64 {
    wbt_map@size(map)
}
