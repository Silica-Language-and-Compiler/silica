// Layer 2 §15 step 7 — skew binary random-access list: deterministic bulk construction.
// Authority: skew_binary_random_access_list.md §9. Every builder is a chain of O(1) prepends, so
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// n items cost O(n); overflow inside any prepend publishes nothing (the input forest is returned).
// Every exported function whose signature mentions ItemType takes the collection record first:
// the compiler resolves ItemType at a qualified call site from the record's compare_item witness
// (type_checker_collections@assoc_type_from_record_witness). The core never calls compare_item.

use skew_ral_forest;

export count_items/3;
export build_prepend_each/3;
export build_prepend_reversed/3;
export build_filled/4;

fn count_items_step(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    _: ItemType,
    t: List[ItemType, mem(normal)],
    acc: int64
) -> int64 {
    count_items(ral, t, acc + 1)
}

fn count_items(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    items: List[ItemType, mem(normal)],
    acc: int64
) -> int64 {
    case items of {
        []: List[ItemType, mem(normal)] -> acc;
        [h: ItemType, t: List[ItemType, mem(normal)]] -> count_items_step(ral, h, t, acc)
    }
}

fn prepend_each_step(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    h: ItemType,
    t: List[ItemType, mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    one: { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } <- skew_ral_forest@forest_prepend(ral, forest, h);
    case one.status of {
        :overflow -> { forest: forest, status: :overflow };
        :ok -> build_prepend_each(ral, one.forest, t)
    }
}

// Prepends items in input order: physical order is the reverse of the input (orientation :reverse).
fn build_prepend_each(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    items: List[ItemType, mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    case items of {
        []: List[ItemType, mem(normal)] -> { forest: forest, status: :ok };
        [h: ItemType, t: List[ItemType, mem(normal)]] -> prepend_each_step(ral, forest, h, t)
    }
}

fn prepend_reversed_step(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    h: ItemType,
    t: List[ItemType, mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    inner: { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } <- build_prepend_reversed(ral, forest, t);
    case inner.status of {
        :overflow -> { forest: forest, status: :overflow };
        :ok -> skew_ral_forest@forest_prepend(ral, inner.forest, h)
    }
}

// Prepends from the last item backwards: physical order equals input order (orientation :front).
fn build_prepend_reversed(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    items: List[ItemType, mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    case items of {
        []: List[ItemType, mem(normal)] -> { forest: forest, status: :ok };
        [h: ItemType, t: List[ItemType, mem(normal)]] -> prepend_reversed_step(ral, forest, h, t)
    }
}

fn filled_step(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    n: int64,
    value: ItemType
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    one: { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } <- skew_ral_forest@forest_prepend(ral, forest, value);
    case one.status of {
        :overflow -> { forest: forest, status: :overflow };
        :ok -> build_filled(ral, one.forest, n - 1, value)
    }
}

fn build_filled(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    n: int64,
    value: ItemType
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } {
    case n <= 0 of {
        true -> { forest: forest, status: :ok };
        false -> filled_step(ral, forest, n, value)
    }
}
