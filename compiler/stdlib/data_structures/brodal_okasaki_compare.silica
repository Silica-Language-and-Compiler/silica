// Layer 2 §16 step 11 — Brodal–Okasaki queue: checked comparison and the min/max orientation
// adapter (leaf module). Authority: brodal_okasaki_queue.md §2; common_contract.md §4.
// `le(heap, a, b)` is true when `a` may sit above `b`: comparator order for a min heap, reversed
// for a max heap (no value negation, so any ItemType works). An atom other than :less, :equal,
// :greater is a deterministic collection error (division by zero halt), never an ordering branch.
// compare_raw must stay the first function in this unit: the emitter numbers :less/:equal/
// :greater at the first comparator_result_validate call, and user comparators list them first.
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

export le/3;
export compare_checked/3;

fn compare_raw(
    compare: fn(ItemType, ItemType) -> atom,
    a: ItemType,
    b: ItemType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn invalid_halt_boolean(_: atom, placeholder: ItemType) -> boolean {
    sequence
        _: int64 <- 1 / 0;
        _: ItemType <- placeholder
    produces
        pure false
    end
}

fn invalid_halt_atom(_: atom, placeholder: ItemType) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0;
        _: ItemType <- placeholder
    produces
        pure :equal
    end
}

fn le(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    a: ItemType,
    b: ItemType
) -> boolean {
    cmp: atom <- compare_raw(heap.compare_item, a, b);
    case cmp of {
        :less -> case heap.max_oriented of {
            true -> false;
            false -> true
        };
        :equal -> true;
        :greater -> heap.max_oriented;
        bad: atom -> invalid_halt_boolean(bad, a)
    }
}

// The captured comparator in its natural ascending sense (Heap trait `compare_item`).
fn compare_checked(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    a: ItemType,
    b: ItemType
) -> :less | :equal | :greater {
    cmp: atom <- compare_raw(heap.compare_item, a, b);
    case cmp of {
        :less -> :less;
        :equal -> :equal;
        :greater -> :greater;
        bad: atom -> invalid_halt_atom(bad, a)
    }
}
