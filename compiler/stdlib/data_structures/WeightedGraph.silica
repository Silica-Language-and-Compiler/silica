// Public WeightedGraph trait — the orthogonal edge-weight capability of weighted directed and
// undirected graphs. Authority: design_documents/Phase1_TODOs/data_structure_designs/
// weighted_graph_trait.md §4. A weighted graph also implements DirectedGraph or UndirectedGraph.
//
// Implementations (static conformance; distinct concrete records, no runtime representation tag):
//   graph_weighted_undirected
//   graph_csr_weighted
//   graph_csr_weighted_undirected
//   graph_dense_weighted
//   graph_dense_weighted_undirected
//   graph_weighted
//
// Deviations forced by the compiler:
//   1. Placeholders are spelled KeyType (NodeIdType), ValueType (EdgeDataType) and ItemType
//      (WeightType): the type checker substitutes only these three inside composite formals and
//      resolves ItemType from the records' compare_item witness (a copy of compare_weight).
//   2. weight_of takes a placeholder weight — weight_of/4 — because Silica source cannot conjure a
//      WeightType value for the :not_found result (as OrderedMap@get, BinaryTree@get).
//   3. A WeightedGraph[N, E, W, mem(normal)] binding is accepted only for graph_weighted@empty/1.
//      mem(normal) only.
//   4. Trait calls take the representations' inline record types: a WeightedGraph[...]-typed value
//      is rejected by every trait call (E2003; the bracket-to-record fit check compares the
//      edge_weight function without placeholder acceptance, the same defect as DirectedGraph:
//      trials/compile_defects_graph_bracket_receiver_addition). graph_weighted is listed last.
//   5. edge_weight, weighted_neighbors, fold_weighted_neighbors and weight_of have results that
//      mention a placeholder and are dispatched to the LAST implementation whatever the receiver
//      (trials/compile_defects_trait_placeholder_result_dispatch_addition); graph_weighted is last.
//      For the other representations call their module functions of the same names until the
//      checker is fixed. compare_edge_data and compare_weight dispatch by receiver.
//   6. A function with a WeightedGraph-typed parameter runs one implementation (the last listed)
//      for every argument (trials/traits_addition/emitter_defect_trait_param_single_impl).
// Q19 node shapes: each impl record spells its representation's nodes (see graph_wbt_core, graph_dense_core and graph_csr_core).

use graph_weighted_undirected;
use graph_csr_weighted;
use graph_csr_weighted_undirected;
use graph_dense_weighted;
use graph_dense_weighted_undirected;
use graph_weighted;

export trait WeightedGraph;

/// Extracts a weight from direction-independent edge data.
export edge_weight/2;

/// Compares two direction-independent edge-data values.
export compare_edge_data/3;

/// Compares two extracted weights with the graph's captured comparator.
export compare_weight/3;

/// Materializes weighted adjacency entries in ascending target order.
export weighted_neighbors/2;

/// Folds weighted adjacency entries without materializing a list.
export fold_weighted_neighbors/4;

/// Looks up an edge by endpoint pair and returns its extracted weight.
export weight_of/4;

required {
    fn edge_weight(g: WeightedGraph, data: ValueType) -> ItemType;
    fn compare_edge_data(g: WeightedGraph, a: ValueType, b: ValueType) -> :less | :equal | :greater;
    fn compare_weight(g: WeightedGraph, a: ItemType, b: ItemType) -> :less | :equal | :greater;
    fn weighted_neighbors(g: WeightedGraph, id: KeyType) -> List[{ to: KeyType, data: ValueType }, mem(normal)];
    fn fold_weighted_neighbors(
        g: WeightedGraph,
        id: KeyType,
        init: AccType,
        step: fn(AccType, { to: KeyType, data: ValueType }) -> AccType
    ) -> AccType;
    fn weight_of(g: WeightedGraph, from: KeyType, to: KeyType, placeholder: ItemType)
        -> { status: :not_found | :found, weight: ItemType };
}

// ---- graph_weighted_undirected ----

impl fn edge_weight(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, data: ValueType) -> ItemType {
    graph_weighted_undirected@edge_weight(g, data)
}

impl fn compare_edge_data(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, a: ValueType, b: ValueType) -> :less | :equal | :greater {
    graph_weighted_undirected@compare_edge_data(g, a, b)
}

impl fn compare_weight(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, a: ItemType, b: ItemType) -> :less | :equal | :greater {
