// Layer 2 §16 steps 6–10 — Brodal–Okasaki queue: bootstrapped roots (leaf module).
// Authority: brodal_okasaki_queue.md §5, §7, §8, §9. A root is a rank-0 node whose trees are the
// primitive forest of nested non-empty queues; meld keeps the smaller root and skew-inserts the
// other whole root as a rank-0 tree (O(1)); insert melds a singleton; pop removes the minimum
// nested queue and melds its forest with the rest (O(log n)).
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

use brodal_okasaki_node;
use brodal_okasaki_compare;
use brodal_okasaki_forest;
use brodal_okasaki_extract;

export boot_singleton/2;
export boot_meld/3;
export boot_peek/3;
export boot_pop/3;
export compatible/2;

fn boot_singleton(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    brodal_okasaki_node@alloc_node(heap, item, 0, 0, brodal_okasaki_node@empty_forest())
}

// A root is a rank-0 node, so the root ref is already its rank-0 digit.
fn zero_digit(tree: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    tree
}

// Keeps `winner` as the root and skew-inserts the other whole root as a rank-0 tree. The inserted
// forest is bound before the node allocation: a tuple literal inside a call nested in another
// call's argument list corrupts the outer call's staged arguments in the bootstrap emitter.
fn meld_keep(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    winner: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] },
    other_root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        d0: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) <- zero_digit(other_root);
        kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- brodal_okasaki_forest@insert_tree0(heap, d0, winner.kids)
    produces
        pure brodal_okasaki_node@alloc_node(heap, winner.item, 0, 0, kids)
    end
}

fn meld_nodes(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    ra: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    rb: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    na: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    nb: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        pa: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_present(heap, na);
        pb: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_present(heap, nb);
        a_wins: boolean <- brodal_okasaki_compare@le(heap, pa.item, pb.item)
    produces
        pure case a_wins of {
            true -> meld_keep(heap, pa, rb);
            false -> meld_keep(heap, pb, ra)
        }
    end
}

// Empty is the identity; otherwise the losing root is nested whole, never flattened.
fn boot_meld(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    ra: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    rb: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    case ra of {
        :none -> rb;
        na: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> case rb of {
            :none -> ra;
            nb: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> meld_nodes(heap, ra, rb, na, nb)
        }
    }
}

fn boot_peek(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_node(heap, root, placeholder);
    case parts.present of {
        false -> { status: :not_found, value: placeholder };
        true -> { status: :found, value: parts.item }
    }
}

fn pop_present(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] },
    placeholder: ItemType
) -> { found: boolean, item: ItemType, root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) } {
    removed: { found: boolean, item: ItemType, forest: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <-
        brodal_okasaki_extract@delete_min_forest(heap, parts.kids, placeholder);
    case removed.found of {
        false -> { found: true, item: parts.item, root: :none };
        true -> { found: true, item: parts.item, root: brodal_okasaki_node@alloc_node(heap, removed.item, 0, 0, removed.forest) }
    }
}

// Removes the distinguished root; the new root is the smallest nested queue's minimum.
fn boot_pop(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    placeholder: ItemType
) -> { found: boolean, item: ItemType, root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) } {
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_node(heap, root, placeholder);
    case parts.present of {
        false -> { found: false, item: placeholder, root: root };
        true -> pop_present(heap, parts, placeholder)
    }
}

fn compatible(
    left: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    right: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> boolean {
    brodal_okasaki_forest@merge_compatible(left, right)
}
