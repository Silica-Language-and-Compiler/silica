// Layer 2 §16 — brodal_okasaki_max: the max-oriented Heap generated-module surface (heap_trait.md
// §4) as a thin forwarder to the brodal_okasaki core with max_oriented = true. The core reverses the
// captured comparator's order (no value negation, so any ItemType works); user comparators still
// describe their natural ascending order (design §2).
// Authority: heap_trait.md §4–§8; brodal_okasaki_queue.md.
//
// The type checker registers this module name as a Heap construction module, so
//     h: Heap[ItemType, mem(normal)] <- brodal_okasaki_max@empty({ compare_item: f });
// type-checks. Deviations forced by the compiler:
//   - the checker accepts a bracket-typed binding only for a module@empty/1 call, so the results of
//     singleton, push, pop, meld and from_list are bound with the inline brodal_okasaki record;
//   - peek and pop take a placeholder item (Silica source cannot conjure an ItemType zero);
//   - mem(normal) only; the core's orientation is a boolean, fixed here (see the brodal_okasaki
//     header, deviation 3).

use brodal_okasaki;

export empty/1;
export singleton/2;
export push/2;
export peek/2;
export pop/2;
export meld/2;
export len/1;
export is_empty/1;
export from_list/2;
export validate/1;
export validate_error_code/1;

fn empty(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }
) -> { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    brodal_okasaki@empty(functions, true)
}

fn singleton(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    item: ItemType
) -> { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    brodal_okasaki@singleton(functions, true, item)
}

// O(1) worst case; the length check is the core's.
fn push(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, item: ItemType) -> { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    brodal_okasaki@push(heap, item)
}

// O(1), no allocation; empty answers :not_found with the placeholder.
fn peek(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, placeholder: ItemType) -> { status: :not_found | :found, value: ItemType } {
    brodal_okasaki@peek(heap, placeholder)
}

// O(log n); empty returns the same heap with :not_found.
fn pop(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, placeholder: ItemType) -> { heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: ItemType } {
    brodal_okasaki@pop(heap, placeholder)
}

// O(1); incompatible inputs (comparator function value, orientation, arena) return `left` with
// compatible = false before any allocation.
fn meld(left: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, right: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> { heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } {
    brodal_okasaki@meld(left, right)
}

fn len(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    brodal_okasaki@size(heap)
}

fn is_empty(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> boolean {
    brodal_okasaki@is_empty(heap)
}

// Folds push over the list in order: O(n); duplicates retained.
fn from_list(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    items: List[ItemType, mem(normal)]
) -> { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } {
    brodal_okasaki@from_list(functions, true, items)
}

fn validate(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> { valid: boolean, error: atom, logical_count: int64 } {
    brodal_okasaki@validate(heap)
}

fn validate_error_code(error: atom) -> int64 {
    brodal_okasaki@validate_error_code(error)
}
