// A dense graph over a fixed, strictly ascending universe of vertex IDs with every cell absent
// (design §2, §5; Θ(V^2)). A universe that is not strictly ascending under compare_node, or whose
// V * V would overflow int64 (design §3), yields the empty universe; valid_universe/2 answers which
// case applies (header deviation "construction result"). The ordering identity of every captured
// function is materialized here and preserved by every update.
fn empty_for_nodes(
    functions: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater },
    nodes: List[KeyType, mem(normal)]
) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } {
    sequence
        w: { compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater } <- { compare_key: functions.compare_node, compare_value: functions.compare_edge_data };
        r: { ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, valid: boolean } <- graph_dense_core@empty_for_nodes(w, nodes);
        t_compare_node: int64 <- ordering_identity_materialize(functions.compare_node);
        t_compare_edge_data: int64 <- ordering_identity_materialize(functions.compare_edge_data);
        t_edge_weight: int64 <- ordering_identity_materialize(functions.edge_weight);
        t_compare_weight: int64 <- ordering_identity_materialize(functions.compare_weight);
        out: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } <- {
            cells: r.ds.cells,
            cell_count: r.ds.cell_count,
            slots: r.ds.slots,
            slot_root: r.ds.slot_root,
            compare_node: functions.compare_node,
            compare_edge_data: functions.compare_edge_data,
            compare_value: functions.compare_edge_data,
            edge_weight: functions.edge_weight,
            compare_weight: functions.compare_weight,
            compare_item: functions.compare_weight,
            region: r.ds.region,
            specialization_key: 0,
            node_count: r.ds.node_count,
            edge_count: 0,
            compare_node_ordering_bundle: t_compare_node,
            compare_edge_data_ordering_bundle: t_compare_edge_data,
            edge_weight_ordering_bundle: t_edge_weight,
            compare_weight_ordering_bundle: t_compare_weight
        }
    produces
        pure out
    end
}

// Whether empty_for_nodes accepts this universe.
fn valid_universe(functions: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater }, nodes: List[KeyType, mem(normal)]) -> boolean {
    graph_dense_core@valid_universe(functions, nodes)
}

// Reports whether id is in the fixed universe: node_to_slot lookup, O(log V).
fn has_vertex(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, id: KeyType) -> boolean {
    ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- ds_of(g);
    graph_dense_core@has_vertex(ds, id)
}

// Reports whether cell(from, to) is present: two slot lookups and one cell read, O(log V).
