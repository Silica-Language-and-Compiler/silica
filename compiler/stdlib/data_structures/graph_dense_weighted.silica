        slots: g.slots,
        slot_root: g.slot_root,
        compare_key: g.compare_node,
        compare_value: g.compare_edge_data,
        region: g.region,
        specialization_key: g.specialization_key,
        node_count: g.node_count,
        entry_count: g.edge_count
    };
    out
}

// A new graph value around an updated cell sequence; indexes, functions, ordering fields shared.
