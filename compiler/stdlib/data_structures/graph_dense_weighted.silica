// Cell lookup: :found carries the extracted weight, :not_found the placeholder.
fn weight_of(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, from: KeyType, to: KeyType, placeholder: ItemType) -> { status: :not_found | :found, weight: ItemType } {
    ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- ds_of(g);
    case graph_dense_core@has_entry(ds, from, to) of {
        false -> { status: :not_found, weight: placeholder };
        true -> {
            data: ValueType <- graph_dense_core@entry_value(ds, from, to);
            w: ItemType <- apply_weight(g.edge_weight, data);
            { status: :found, weight: w }
        }
    }
}

// Sets cell(from, to) to the complete edge data (design §6): absent -> present counts one edge,
// present -> present replaces the data only; an endpoint outside the universe is rejected. O(log V).
fn add_edge(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, from: KeyType, to: KeyType, data: ValueType) -> { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, inserted: boolean, replaced: boolean, rejected: boolean } {
    ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- ds_of(g);
    r: { ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, status: int64 } <- graph_dense_core@set_entry(ds, from, to, data);
    case r.status of {
        2 -> { graph: g, inserted: false, replaced: false, rejected: true };
        _: int64 -> { graph: publish(g, r.ds, r.ds.entry_count), inserted: r.status == 0, replaced: r.status == 1, rejected: false }
    }
}

// Clears cell(from, to); an absent cell or an ID outside the universe is a no-op (design §6).
fn remove_edge(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, from: KeyType, to: KeyType) -> { graph: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edg