// Layer 6 — graph_dense_weighted: the dense matrix weighted directed graph generated module
// (dense_matrix_graph.md; weighted_graph_trait.md §6, §9). Cells hold the complete edge data; a
// view is {to: slot_to_node[to_slot], data}. It implements WeightedGraph (not DirectedGraph: see
// graph_weighted header deviation 9).
// Representation (CSR-D1: compiler-version-private inline layout; only this module's functions and
// the graph traits are source-level access paths):
//   { cells (V*V cell sequence forest), cell_count, slots (slot_to_node forest), slot_root
//     (node_to_slot WBT map), <functions>, region, specialization_key, counts, <ordering fields> }
// The universe is fixed by empty_for_nodes; add_edge rejects an endpoint outside it (rejected = true,
// the graph unchanged) and never adds a vertex (design §2, §6). See graph_dense_core for the cell
// layout (header deviation 1: optional-reference cells) and the row scan. Construction result:
// empty_for_nodes returns the graph itself (an unaccepted universe yields the empty universe) and
// valid_universe/2 reports acceptance, because a result record wrapping the graph leaves the
// edge-data placeholder without a type witness at the call (E2003); the design leaves the failure
// channel open.
//
// Deviations forced by the compiler (each mirrors graph_weighted):
//   1. Placeholders KeyType (NodeIdType), ValueType (EdgeDataType), ItemType (WeightType);
//      compare_value / compare_item are the ValueType / ItemType witnesses.
//   2. weight_of takes a placeholder weight; folds take the accumulator second; compare_edge is
//      lexicographic on the {to, data} view.
//   3. Cells are optional references (graph_dense_core deviation 1), not `:none | (:some, data)`.
//   4. mem(normal) only; validation error atoms are created and decoded in graph_dense_core.
// Q19 node shapes (spelled at every use): cell (ValueType, ref?(L, normal, rec)); cells and slots are skew_ral forests of (int64, ref?(L, normal, (Item, ref?(L, normal, rec), ref?(L, normal, rec)))) digits, Item = ref?(L, normal, <cell>) / KeyType; slot_root is a wbt_map node (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)).

use graph_dense_core;

export empty_for_nodes/2;
export valid_universe/2;
export add_edge/4;
export remove_edge/3;
export has_vertex/2;
export has_edge/3;
export neighbors/2;
export weighted_neighbors/2;
export weight_of/4;
export fold_neighbors/4;
export fold_weighted_neighbors/4;
export fold_vertices/3;
export fold_edges/3;
export vertices/1;
export node_count/1;
export edge_count/1;
export out_degree/2;
export reachable/3;
export compare_node/3;
export compare_edge/3;
export edge_target/2;
export compare_edge_data/3;
export edge_weight/2;
export compare_weight/3;
export validate/1;
export validate_error_code/1;

fn compare_raw(
    compare: fn(KeyType, KeyType) -> atom,
    a: KeyType,
    b: KeyType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_value_raw(
    compare: fn(ValueType, ValueType) -> atom,
    a: ValueType,
    b: ValueType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_item_raw(
    compare: fn(ItemType, ItemType) -> atom,
    a: ItemType,
    b: ItemType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

// Deterministic collection error for an invalid comparator atom (common_contract.md §4).
fn invalid_halt(_: atom) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

// Deterministic collection error: count overflow or a malformed graph found by an update; nothing
// is published (common_contract.md §9).
fn update_halt(n: int64) -> int64 {
    sequence
        _: int64 <- 1 / 0
    produces
        pure n
    end
}

fn b2i(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

// Checked non-negative count addition (delta may be negative).
fn count_add(count: int64, delta: int64) -> int64 {
    case delta > 0 and count > 9223372036854775807 - delta of {
        true -> update_halt(count);
        false -> count + delta
    }
}

fn apply_target(f: fn(ValueType) -> KeyType, v: ValueType) -> KeyType {
    f(v)
}

fn apply_weight(f: fn(ValueType) -> ItemType, v: ValueType) -> ItemType {
    f(v)
}

// Compares two vertex IDs with the captured node comparator.
fn compare_node(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, a: KeyType, b: KeyType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_raw(g.compare_node, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// Compares two edge-data values with the captured comparator.
fn compare_edge_data(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, a: ValueType, b: ValueType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_value_raw(g.compare_edge_data, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// Compares two extracted weights with the captured weight comparator.
fn compare_weight(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, a: ItemType, b: ItemType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_item_raw(g.compare_weight, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// The dense record graph_dense_core works on.
fn ds_of(g: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } {
    out: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- {
        cells: g.cells,
