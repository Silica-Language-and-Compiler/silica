// Layer 2 §16 — Brodal–Okasaki queue: thin dispatcher for bulk construction, validation, and the
// captured comparator. Loads the boot, compare, and validate leaves; the facade loads only this
// dispatcher and brodal_okasaki_dispatch_core.
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

use brodal_okasaki_boot;
use brodal_okasaki_compare;
use brodal_okasaki_validate;

export from_items/2;
export compare_item/3;
export validate/1;
export validate_error_code/1;

fn rebuild(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    count: int64
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    {
        root: root,
        count: count,
        max_oriented: heap.max_oriented,
        compare_item: heap.compare_item,
        region: heap.region,
        specialization_key: heap.specialization_key,
        compare_item_ordering_bundle: heap.compare_item_ordering_bundle
    }
}

fn overflow_halt(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    sequence
        _: int64 <- 1 / 0
    produces
        pure heap
    end
}

fn from_items_step(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    count: int64,
    h: ItemType,
    t: List[ItemType, mem(normal)]
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    count_pair: (boolean, int64) <- checked_int64_add1(count);
    (count_ok: boolean, new_count: int64) <- count_pair;
    case count_ok of {
        false -> overflow_halt(heap);
        true -> from_items_go(heap, brodal_okasaki_boot@boot_meld(heap, brodal_okasaki_boot@boot_singleton(heap, h), root), new_count, t)
    }
}

fn from_items_go(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    count: int64,
    items: List[ItemType, mem(normal)]
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    case items of {
        []: List[ItemType, mem(normal)] -> rebuild(heap, root, count);
        [h: ItemType, t: List[ItemType, mem(normal)]] -> from_items_step(heap, root, count, h, t)
    }
}

// Pushes every item in list order onto `heap`; O(n) since each push is O(1).
fn from_items(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    items: List[ItemType, mem(normal)]
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    from_items_go(heap, heap.root, heap.count, items)
}

fn compare_item(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    a: ItemType,
    b: ItemType
) -> :less | :equal | :greater {
    brodal_okasaki_compare@compare_checked(heap, a, b)
}

fn validate(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    brodal_okasaki_validate@validate(heap)
}

fn validate_error_code(error: atom) -> int64 {
    brodal_okasaki_validate@validate_error_code(error)
}
