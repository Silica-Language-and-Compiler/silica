fn from_entries_go(queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, entries: List[{ priority: KeyType, value: ValueType }, mem(normal)]) -> { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } {
    case entries of {
        []: List[{ priority: KeyType, value: ValueType }, mem(normal)] -> queue;
        [h: { priority: KeyType, value: ValueType }, t: List[{ priority: KeyType, value: ValueType }, mem(normal)]] ->
            from_entries_go(push_priority(queue, h.priority, h.value), t)
    }
}

// Folds push_priority over the list in order: O(n), no entry deduplicated (design §8).
fn from_entries(
    functions: {
        compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater
    },
    entries: List[{ priority: KeyType, value: ValueType }, mem(normal)]
) -> { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } {
    from_entries_go(empty_priority_queue(functions), entries)
}

fn validate(queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }) -> { valid: boolean, error: atom, logical_count: int64 } {
    brodal_okasaki@validate(queue.heap)
}

fn validate_error_code(error: atom) -> int64 {
    brodal_okasaki@validate_error_code(error)
}
