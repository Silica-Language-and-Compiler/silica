fn is_empty(queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }) -> boolean {
