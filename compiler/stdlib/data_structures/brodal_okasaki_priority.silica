// O(1); a different priority or item comparator function value, or a different arena, returns
// `left` unchanged with compatible = false before any allocation (design §6, §9).
fn meld_priority(left: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, right: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }) -> { queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } {
    same_order: boolean <- left.compare_priority_ordering_bundle == right.compare_priority_ordering_bundle
        and left.compare_item_ordering_bundle == right.compare_item_ordering_bundle;
    case same_order of {
        false -> { queue: left, compatible: false };
        true -> {
            m: { heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, compatible: boolean } <- brodal_okasaki@meld(left.heap, right.heap);
            { queue: rebuild(left, m.heap), compatible: m.compatible }
        }
    }
}

