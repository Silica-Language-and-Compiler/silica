// Layer 2 §16 — brodal_okasaki_priority: the Brodal–Okasaki core over priority/value entries
// (the PriorityQueue generated-module surface, priority_queue_trait.md §4).
// Authority: priority_queue_trait.md §1, §4–§11; brodal_okasaki_queue.md; common_contract.md.
//
// A queue is the min-oriented brodal_okasaki heap over entries
//     { priority, value, priority_order, value_order }
// plus the captured comparator pair and one ordering token per comparator. compare_entry is
// lexicographic: priorities first, values only when the priorities compare :equal (design §1, §6);
// both comparator results are validated. Every push adds one occurrence; fully equal entries coexist
// and pop in an unspecified order among themselves (design §5). Old queues stay valid (design §10).
//
// Deviations forced by the compiler (type checker and emitter of the 2026-09-18 fixed point):
//   1. Placeholder spelling: the priority type is written KeyType and the value type ValueType, not
//      the design's PriorityType/ItemType. The type checker never substitutes PriorityType inside a
//      composite type (resolve_constructor_call_formal handles ItemType/KeyType/ValueType only), and
//      it resolves ItemType to the FIRST bracket parameter of PriorityQueue[P, V, mem(S)] and to the
//      compare_priority witness of a record, i.e. to the priority; an ItemType token inside the entry
//      type is also re-substituted by the core's own ItemType. KeyType/ValueType reach bracket
//      parameters 1 and 2 and the compare_key/compare_value record witnesses.
//   2. The queue record carries the comparator pair twice: compare_priority/compare_item are what
//      the checker's bracket constructor check reads for a `q: PriorityQueue[P, V, mem(normal)]
//      <- brodal_okasaki_priority@empty({...})` binding; compare_key/compare_value are the record
//      witnesses that resolve KeyType/ValueType when a queue is bound with its inline record type.
//      The constructor argument keeps the design's field names { compare_priority, compare_item }.
//   3. Each stored entry carries the comparator pair (priority_order, value_order): the entry
//      comparator handed to the core is a plain top-level function because a returned closure loses
//      its captures in the current emitter, so it reads the user comparators from the entries.
//      The entry field names are not witness names (compare_*), so a bare ItemType inside the core
//      resolves to the whole entry.
//   4. The core stores an entry as one pointer word in its `value: ItemType` result slot; a reader
//      whose surface type names the entry record applies the emitter's inline nested-record layout
//      to that slot, so item_of_peek/item_of_pop read it with a surface `ItemType` instead.
//   5. peek/pop take placeholder priority and value: Silica source cannot conjure a zero value of a
//      programmer-declared type (same as the core and the BinaryTree trait). empty/1 is the name
//      the checker requires for a bracket-typed binding; empty_priority_queue/1 is the design's
//      name for the same constructor. Every other result must be bound with the inline record type.
//   6. meld_priority compares the two ordering tokens itself before delegating to the core: the
//      core's bundle is built from compare_entry, which is the same function for every queue, so
//      the core alone cannot tell two comparator bundles apart. The core then checks the arena.
//   7. mem(normal) only; validate is the core's validator over entries (error atoms decoded by
//      validate_error_code; :ok is 0).
// compare_raw stays the first function in this unit (comparator atom numbering; see
// brodal_okasaki_compare).

use brodal_okasaki;

export empty/1;
export empty_priority_queue/1;
export push_priority/3;
export peek_priority_entry/3;
export pop_priority/3;
export meld_priority/2;
export len/1;
export is_empty/1;
export from_entries/2;
export validate/1;
export validate_error_code/1;
export compare_entry/2;

fn compare_raw(
    compare: fn(KeyType, KeyType) -> atom,
    a: KeyType,
    b: KeyType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_raw_value(
    compare: fn(ValueType, ValueType) -> atom,
    a: ValueType,
    b: ValueType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

// An atom other than :less, :equal, :greater is a deterministic collection error (design §9;
// common_contract.md §4), never an ordering branch.
fn invalid_halt_atom(_: atom) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn compare_entry_value(a: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, b: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater {
    cmp: atom <- compare_raw_value(a.value_order, a.value, b.value);
    case cmp of {
        :less -> :less;
        :equal -> :equal;
        :greater -> :greater;
        bad: atom -> invalid_halt_atom(bad)
    }
}

// Lexicographic entry order: priority first, value only on equal priorities (design §1, §6).
fn compare_entry(a: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, b: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater {
    cmp: atom <- compare_raw(a.priority_order, a.priority, b.priority);
    case cmp of {
        :less -> :less;
        :equal -> compare_entry_value(a, b);
        :greater -> :greater;
        bad: atom -> invalid_halt_atom(bad)
    }
}

// Opaque readers for the core's ItemType-valued result slot (header deviation 4).
fn item_of_peek(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, r: { status: :not_found | :found, value: ItemType }) -> ItemType {
    r.value
}

fn item_of_pop(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, r: { heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: ItemType }) -> ItemType {
    r.value
}

fn make_entry(queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, priority: KeyType, value: ValueType) -> { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater } {
    { priority: priority, value: value, priority_order: queue.compare_priority, value_order: queue.compare_item }
}

fn rebuild(queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } {
    {
        compare_priority: queue.compare_priority,
        compare_item: queue.compare_item,
        compare_key: queue.compare_key,
        compare_value: queue.compare_value,
        heap: heap,
        specialization_key: queue.specialization_key,
        compare_priority_ordering_bundle: queue.compare_priority_ordering_bundle,
        compare_item_ordering_bundle: queue.compare_item_ordering_bundle
    }
}

fn empty_priority_queue(
    functions: {
        compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater
    }
) -> { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } {
    sequence
        heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- brodal_okasaki@empty({ compare_item: compare_entry }, false);
        p_token: int64 <- ordering_identity_materialize(functions.compare_priority);
        v_token: int64 <- ordering_identity_materialize(functions.compare_item);
        out: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } <- {
            compare_priority: functions.compare_priority,
            compare_item: functions.compare_item,
            compare_key: functions.compare_priority,
            compare_value: functions.compare_item,
            heap: heap,
            specialization_key: 0,
            compare_priority_ordering_bundle: p_token,
            compare_item_ordering_bundle: v_token
        }
    produces
        pure out
    end
}

// Registered constructor name for a bracket-typed binding (header deviation 5).
fn empty(
    functions: {
        compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater
    }
) -> { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } {
    empty_priority_queue(functions)
}

// O(1): one core push of a fresh entry; the length check is the core's.
fn push_priority(queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, priority: KeyType, value: ValueType) -> { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 } {
    entry: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater } <- make_entry(queue, priority, value);
    rebuild(queue, brodal_okasaki@push(queue.heap, entry))
}

// O(1), no allocation beyond the placeholder entry; empty answers :not_found with the placeholders.
fn peek_priority_entry(
    queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 },
    placeholder_priority: KeyType,
    placeholder_value: ValueType
) -> { status: :not_found | :found, priority: KeyType, value: ValueType } {
    ph: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater } <- make_entry(queue, placeholder_priority, placeholder_value);
    r: { status: :not_found | :found, value: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater } } <- brodal_okasaki@peek(queue.heap, ph);
    found: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater } <- item_of_peek(queue.heap, r);
    { status: r.status, priority: found.priority, value: found.value }
}

// O(log n); empty returns the same queue with :not_found and the placeholders (design §9).
fn pop_priority(
    queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 },
    placeholder_priority: KeyType,
    placeholder_value: ValueType
) -> { queue: { compare_priority: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_item: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, specialization_key: int64, compare_priority_ordering_bundle: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, priority: KeyType, value: ValueType } {
    ph: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater } <- make_entry(queue, placeholder_priority, placeholder_value);
    r: { heap: { root: ref?(L, normal, ({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn({ priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }, { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater }) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, status: :not_found | :found, value: { priority: KeyType, value: ValueType, priority_order: fn(KeyType, KeyType) -> :less | :equal | :greater, value_order: fn(ValueType, ValueType) -> :less | :equal | :greater } } <- brodal_okasaki@pop(queue.heap, ph);
