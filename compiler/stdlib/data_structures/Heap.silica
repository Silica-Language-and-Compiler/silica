// Public Heap trait — Layer 3 over the §16 brodal_okasaki core; the min and max generated modules
// (brodal_okasaki_min, brodal_okasaki_max) share the core record, so one impl serves both.
// Authority: design_documents/Phase1_TODOs/data_structure_designs/heap_trait.md §3.
//
// Required: len, peek, compare_item (the captured comparator in its natural ascending sense, on a
// max heap too: the max module reverses ordering internally, design §2). Provided: is_empty, exactly
// len(heap) == 0.
// Deviations forced by the compiler:
//   - peek keeps a placeholder item argument (same as the core and the BinaryTree trait: Silica
//     source cannot conjure an ItemType zero);
//   - the receiver is the inline brodal_okasaki record; a `Heap[ItemType, mem(normal)]` binding is
//     accepted only for a brodal_okasaki_min@empty/1 or brodal_okasaki_max@empty/1 call, every other
//     result is bound with the inline record type (see the brodal_okasaki_min header);
//   - mem(normal) only.

use brodal_okasaki;

export trait Heap;
export len/1;
export is_empty/1;
export peek/2;
export compare_item/3;

required {
    fn len(heap: Heap) -> int64;
    fn peek(heap: Heap, placeholder: ItemType) -> { status: :not_found | :found, value: ItemType };
    fn compare_item(heap: Heap, a: ItemType, b: ItemType) -> :less | :equal | :greater;
}

provided {
    fn is_empty(heap: Heap) -> boolean {
        Heap@len(heap) == 0
    }
}

impl fn len(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }) -> int64 {
    brodal_okasaki@size(heap)
}

impl fn peek(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, placeholder: ItemType) -> { status: :not_found | :found, value: ItemType } {
    brodal_okasaki@peek(heap, placeholder)
}

impl fn compare_item(heap: { root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), count: int64, max_oriented: boolean, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, a: ItemType, b: ItemType) -> :less | :equal | :greater {
    brodal_okasaki@compare_item(heap, a, b)
}
