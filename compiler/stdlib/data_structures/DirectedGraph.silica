impl fn neighbors(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }, id: KeyType) -> List[ValueType, mem(normal)] {
