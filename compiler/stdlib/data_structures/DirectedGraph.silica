// Public DirectedGraph trait — query behavior shared by the directed graph representations.
// Authority: design_documents/Phase1_TODOs/data_structure_designs/directed_graph_trait.md §3.
//
// Implementations (static conformance; each representation is a distinct concrete record, no
// runtime representation tag — csr_dense_representation_contract.md CSR-D7):
//   graph_csr_directed (payload EdgePayloadType)
//   graph_dense_directed (payload EdgePayloadType)
//   graph_wbt_directed (payload EdgePayloadType)
//
// Deviations forced by the compiler:
//   1. Placeholders are spelled KeyType (NodeIdType) and ValueType (EdgePayloadType): the type
//      checker substitutes only ItemType/KeyType/ValueType inside composite formals.
//   2. out_degree, has_edge and reachable are required, not provided. A provided body cannot carry
//      the queried target or the graph's comparator into a fold step (Silica has no closures), and a
//      trait method whose result mentions a placeholder (neighbors) cannot be called on a
//      trait-typed value (E2003; trials/compile_defects_trait_placeholder_return_addition). Each
//      representation implements
//      them directly, which also meets the design's bounds (cached out-degree, O(log V + log d)
//      has_edge, WBT-visited reachability) instead of an O(d) scan.
//   3. A DirectedGraph[N, P, mem(normal)] binding is accepted only for graph_wbt_directed@empty/1
//      (the checker's registered construction module); see 6 for trait calls on it.
//   4. mem(normal) only.
//   5. graph_weighted (the weighted directed graph) does not implement DirectedGraph. Its edge
//      payload is the generated {to, data} view, and the trait checker matches a placeholder only at
//      the top level of a type, so an impl returning List[{ to: KeyType, data: ValueType }] against
//      the required List[ValueType] is E2092 (trials/compile_defects_trait_nested_placeholder_addition).
//      Its directed queries are graph_weighted module functions of the same names.
//   6. Trait calls take the representations' inline record types. A DirectedGraph[...]-typed
//      value is rejected by every trait call (E2003: the bracket-to-record fit check compares the
//      edge_target function without placeholder acceptance;
//      trials/compile_defects_graph_bracket_receiver_addition). graph_wbt_directed stays the last
//      impl because a bracket receiver that fits several impls is dispatched by declaration order
//      (trials/traits_addition/emitter_defect_bracket_receiver_impl_order).
//   7. A method whose result mentions a placeholder — neighbors, fold_neighbors, edge_target — is
//      dispatched to the LAST implementation in this unit whatever the receiver
//      (trials/compile_defects_trait_placeholder_result_dispatch_addition;
//      graph_collections/emitter_defect_trait_placeholder_result_dispatch). graph_wbt_directed is
//      last, so they are right for live graphs; on a snapshot call the representation module's
//      functions of the same names until the checker is fixed. The other methods dispatch by
//      receiver for every representation.
//   8. A function with a DirectedGraph-typed parameter (an algorithm written once over the trait) is
//      emitted with every trait call in its body bound to one implementation — the last listed in
//      the stdlib's per-unit compiles — whatever the argument
//      (trials/traits_addition/emitter_defect_trait_param_single_impl). Such algorithms are correct
//      for live graphs today.
// A unit that cases on compare_node / compare_edge results lists :less, :equal, :greater in that
// order where they first appear (per-unit atom numbering).
// Q19 node shapes: each impl record spells its representation's nodes (see graph_wbt_core, graph_dense_core and graph_csr_core).

use graph_csr_directed;
use graph_dense_directed;
use graph_wbt_directed;

export trait DirectedGraph;

/// Returns the number of vertices.
export node_count/1;

/// Returns the number of directed endpoint pairs.
export edge_count/1;

/// Reports whether `id` is an explicit vertex.
export has_vertex/2;

/// Materializes outgoing edges in ascending target order.
export neighbors/2;

/// Folds outgoing edges without materializing a list.
export fold_neighbors/4;

/// Compares two vertex IDs with the comparator captured by the graph.
export compare_node/3;

/// Compares two edge payloads with the comparator captured by the graph.
export compare_edge/3;

/// Extracts the target vertex ID from an edge payload.
export edge_target/2;

/// Returns the number of outgoing edges from `id`.
export out_degree/2;

/// Reports whether the directed endpoint pair `(from, to)` exists.
export has_edge/3;

/// Reports whether `to` is reachable from `from`.
export reachable/3;

required {
    fn node_count(g: DirectedGraph) -> int64;
    fn edge_count(g: DirectedGraph) -> int64;
    fn has_vertex(g: DirectedGraph, id: KeyType) -> boolean;
    fn neighbors(g: DirectedGraph, id: KeyType) -> List[ValueType, mem(normal)];
    fn fold_neighbors(
        g: DirectedGraph,
        id: KeyType,
        init: AccType,
        step: fn(AccType, ValueType) -> AccType
    ) -> AccType;
    fn compare_node(g: DirectedGraph, a: KeyType, b: KeyType) -> :less | :equal | :greater;
    fn compare_edge(g: DirectedGraph, a: ValueType, b: ValueType) -> :less | :equal | :greater;
    fn edge_target(g: DirectedGraph, edge: ValueType) -> KeyType;
    fn out_degree(g: DirectedGraph, id: KeyType) -> int64;
    fn has_edge(g: DirectedGraph, from: KeyType, to: KeyType) -> boolean;
    fn reachable(g: DirectedGraph, from: KeyType, to: KeyType) -> boolean;
}

// ---- graph_csr_directed ----

impl fn node_count(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> int64 {
    graph_csr_directed@node_count(g)
}

impl fn edge_count(g: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_target: fn(ValueType) -> KeyType, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_ordering_bundle: int64, edge_target_ordering_bundle: int64 }) -> int64 {
    graph_csr_directed@edge_count(g)
}

