// Layer 2 §16 — Brodal–Okasaki queue: thin dispatcher for push/peek/pop/meld on the heap record.
// Loads only the boot leaf (which owns the bootstrapped root operations) so the facade never pays
// for every leaf interface at once (tutorials_and_howtos/thin_dispatchers_for_compile_ram.md).
// Meld checks compatibility (ordering identity, orientation, arena) BEFORE any allocation
// (plan §16 step 9) and returns the left input unchanged when incompatible.
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

use brodal_okasaki_boot;

export push/2;
export peek/2;
export pop/2;
export meld/2;

fn rebuild(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    count: int64
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    {
        root: root,
        count: count,
        max_oriented: heap.max_oriented,
        compare_item: heap.compare_item,
        region: heap.region,
        specialization_key: heap.specialization_key,
        compare_item_ordering_bundle: heap.compare_item_ordering_bundle
    }
}

// Count overflow is a deterministic collection error: nothing is published.
fn overflow_halt(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    sequence
        _: int64 <- 1 / 0
    produces
        pure heap
    end
}

fn push_counted(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType,
    new_count: int64
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    rebuild(heap, brodal_okasaki_boot@boot_meld(heap, brodal_okasaki_boot@boot_singleton(heap, item), heap.root), new_count)
}

fn push(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    count_pair: (boolean, int64) <- checked_int64_add1(heap.count);
    (count_ok: boolean, new_count: int64) <- count_pair;
    case count_ok of {
        false -> overflow_halt(heap);
        true -> push_counted(heap, item, new_count)
    }
}

fn peek(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    brodal_okasaki_boot@boot_peek(heap, heap.root, placeholder)
}

fn pop(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> { heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, status: :not_found | :found, value: ItemType } {
    popped: { found: boolean, item: ItemType, root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) } <-
        brodal_okasaki_boot@boot_pop(heap, heap.root, placeholder);
    case popped.found of {
        false -> { heap: heap, status: :not_found, value: placeholder };
        true -> { heap: rebuild(heap, popped.root, heap.count - 1), status: :found, value: popped.item }
    }
}

fn meld_counted(
    left: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    right: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> { heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, compatible: boolean } {
    total_pair: (boolean, int64) <- checked_int64_add(left.count, right.count);
    (total_ok: boolean, total: int64) <- total_pair;
    case total_ok of {
        false -> { heap: overflow_halt(left), compatible: true };
        true -> { heap: rebuild(left, brodal_okasaki_boot@boot_meld(left, left.root, right.root), total), compatible: true }
    }
}

fn meld(
    left: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    right: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> { heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, compatible: boolean } {
    case brodal_okasaki_boot@compatible(left, right) of {
        false -> { heap: left, compatible: false };
        true -> meld_counted(left, right)
    }
}
