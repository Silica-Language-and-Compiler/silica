// Layer 6 — graph_dense_core: the dense matrix graph engine shared by the dense graph families
// (graph_dense_directed, graph_dense_undirected, graph_dense_weighted,
// graph_dense_weighted_undirected). Authority: design_documents/Phase1_TODOs/data_structure_designs/
// dense_matrix_graph.md over skew_binary_random_access_list.md; standard_data_structures_baseline/
// csr_dense_representation_contract.md (CSR-D1..D3, D5..D7); common_contract.md.
//
// Record (compiler-version-private layout, CSR-D1; the families wrap it):
//   { cells (forest of the V*V cell sequence), cell_count, slots (forest of slot_to_node),
//     slot_root (node_to_slot WBT map), compare_key (compare_node), compare_value (edge value
//     comparator), region, specialization_key, node_count (V), entry_count (stored entries) }
// The vertex universe is fixed at construction (empty_for_nodes, design §2, §5) from a strictly
// ascending ID list: slot_to_node is a skew binary random-access list in slot order and node_to_slot a
// WBT map built with wbt_map@from_sorted. Public IDs and int64 slots are distinct domains (CSR-D2):
// every operation resolves IDs through node_to_slot. cell(from_slot, to_slot) = from_slot * V +
// to_slot, with V * V checked (design §3). Updates path-copy one cell (two for an undirected
// non-loop edge) in O(log V); the other cells and both indexes are shared (design §9). A row is the
// logical range [from_slot * V, from_slot * V + V), scanned once with skew_ral@fold_range (design §7).
//
// Deviations forced by the compiler:
//   1. A cell is an optional reference, :none (absent) or a reference to a (value, anchor) node in
//      the graph's arena (present), for every family. The contract's cell types cannot be written:
//      the parser rejects `:none | (:some, EdgeDataType)` in every type position (E1040,
//      trials/compile_defects_tagged_optional_type_addition), and the one generic directed module
//      cannot use CSR-D5's boolean cells because it must return EdgePayloadType payloads. An optional
//      reference is that tagged sum with nothing added (as tree_rose's vacant/occupied child slots):
//      one cell sequence, presence and data in the same cell, no second presence sequence.
//   2. The RAL is handled through its forest and count (the nested-generic rule, as tree_rose): each
//      skew_ral call rebuilds the RAL record with a flat item type. Cells and indexes live in the
//      canonical skew_ral arena that skew_ral@filled returns, which is also the graph's region.
//   3. Rows are scanned with a concrete accumulator (hit list) because a fold callback in this unit
//      cannot carry this unit's AccType through skew_ral's (tree_rose deviation 6); neighbor folds
//      then walk the O(degree) hit list.
// Every comparison validates the comparator atom. compare_raw stays the first function in this unit.
// Validation error atoms are created and decoded here (validate_error_code).
// Q19 node shapes (spelled at every use): cell (ValueType, ref?(L, normal, rec)); cells and slots are skew_ral forests of (int64, ref?(L, normal, (Item, ref?(L, normal, rec), ref?(L, normal, rec)))) digits, Item = ref?(L, normal, <cell>) / KeyType; slot_root is a wbt_map node (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)).

use wbt_map;
use wbt_set;
use skew_ral;

export empty_for_nodes/2;
export valid_universe/2;
export slot_of/2;
export has_vertex/2;
export has_entry/3;
export entry_value/3;
export lookup/4;
export set_entry/4;
export clear_entry/3;
export degree/2;
export self_loop_count/2;
export values/2;
export wrappers/2;
export vertices/1;
export fold_values/4;
export fold_wrappers/4;
export fold_vertices/3;
export fold_entries/3;
export fold_entries_wrapped/3;
export fold_entries_canonical/3;
export entry_list/1;
export reachable/3;
export validate_directed/3;
export validate_keyed/2;
export validate_undirected/3;
export asymmetry_error/0;
export validate_error_code/1;

fn compare_raw(
    compare: fn(KeyType, KeyType) -> atom,
    a: KeyType,
    b: KeyType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_value_raw(
    compare: fn(ValueType, ValueType) -> atom,
    a: ValueType,
    b: ValueType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn invalid_halt(_: atom) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

fn value_halt(n: int64) -> ValueType {
    sequence
        _: int64 <- 1 / 0
    produces
        pure value_halt(n + 1)
    end
}

fn b2i(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

// Cells are never ordered: the RAL's compare_item witness only.
fn cell_compare(_: ref?(L, normal, (ValueType, ref?(L, normal, rec))), _: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater {
    :equal
}

fn none_cell() -> ref?(L, normal, (ValueType, ref?(L, normal, rec))) {
    :none
}

fn cmp_slot(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_nodes(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, a: KeyType, b: KeyType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_raw(ds.compare_key, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

fn compare_values(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, a: ValueType, b: ValueType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_value_raw(ds.compare_value, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

fn nodes_equal(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, a: KeyType, b: KeyType) -> boolean {
    c: :less | :equal | :greater <- compare_nodes(ds, a, b);
    case c of {
        :equal -> true;
        _: atom -> false
    }
}

// ---------------------------------------------------------------------------------------------
// The two random-access lists and the node -> slot index.
// ---------------------------------------------------------------------------------------------

fn cells_of(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } {
    out: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- {
        count: ds.cell_count,
        reversed: false,
        compare_item: cell_compare,
        forest: ds.cells,
        region: ds.region,
        specialization_key: 0
    };
    out
}

fn slots_of(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> { count: int64, reversed: boolean, compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } {
    out: { count: int64, reversed: boolean, compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- {
        count: ds.node_count,
        reversed: false,
        compare_item: ds.compare_key,
        forest: ds.slots,
        region: ds.region,
        specialization_key: 0
    };
    out
}

fn slot_map(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
        root: ds.slot_root,
        compare_key: ds.compare_key,
        compare_value: cmp_slot,
        region: ds.region,
        specialization_key: ds.specialization_key,
        compare_key_ordering_bundle: 0,
        compare_value_ordering_bundle: 0
    };
    out
}

// The dense slot of a public vertex ID, or -1 when the ID is not in the universe.
fn slot_of(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> int64 {
    m: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- slot_map(ds);
    got: { status: :not_found | :found, value: int64 } <- wbt_map@get(m, id, -1);
    got.value
}

fn has_vertex(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> boolean {
    slot_of(ds, id) >= 0
}

// slot_to_node[s]; placeholder answers an out-of-range slot (callers pass an ID they hold).
fn node_at(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, placeholder: KeyType) -> KeyType {
    r: { count: int64, reversed: boolean, compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- slots_of(ds);
    got: { status: :not_found | :found, value: KeyType } <- skew_ral@get(r, s, placeholder);
    got.value
}

fn cell_at(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, i: int64) -> ref?(L, normal, (ValueType, ref?(L, normal, rec))) {
    r: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- cells_of(ds);
    got: { status: :not_found | :found, value: ref?(L, normal, (ValueType, ref?(L, normal, rec))) } <- skew_ral@get(r, i, none_cell());
    got.value
}

fn present(c: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> boolean {
    case c of {
        :none -> false;
        _: ref(L, normal, (ValueType, ref?(L, normal, rec))) -> true
    }
}

// The value stored in a present cell; an absent cell is a deterministic collection error.
fn cell_value(c: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> ValueType {
    case c of {
        :none -> value_halt(0);
        node_ref: ref(L, normal, (ValueType, ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                n: (ValueType, ref?(L, normal, rec)) <- read_ref(node_ref);
                (v, _: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- n
            produces
                pure v
            end
        }
    }
}

fn alloc_cell(arena: region(L, normal), v: ValueType) -> (region(L, normal), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (ValueType, ref?(L, normal, rec))) <- alloc_rec(arena, (v, :none))
    produces
        pure (arena, c)
    end
}

// cell(from, to) or :none when either endpoint is outside the universe.
fn cell_of(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> ref?(L, normal, (ValueType, ref?(L, normal, rec))) {
    a: int64 <- slot_of(ds, from);
    b: int64 <- slot_of(ds, to);
    case a < 0 or b < 0 of {
        true -> :none;
        false -> cell_at(ds, a * ds.node_count + b)
    }
}

fn has_entry(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> boolean {
    present(cell_of(ds, from, to))
}

fn entry_value(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> ValueType {
    cell_value(cell_of(ds, from, to))
}

fn lookup(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType, placeholder: ValueType) -> { status: :not_found | :found, value: ValueType } {
    case has_entry(ds, from, to) of {
        false -> { status: :not_found, value: placeholder };
        true -> {
            v: ValueType <- entry_value(ds, from, to);
            { status: :found, value: v }
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Updates (design §6): one cell path-copied per call; entry_count changes only on
// absent <-> present. status: 0 inserted, 1 replaced, 2 rejected (an endpoint outside the universe;
// a dense graph never adds a vertex).
// ---------------------------------------------------------------------------------------------

fn with_cells(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], entries: int64) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } {
    out: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- {
        cells: cells,
        cell_count: ds.cell_count,
        slots: ds.slots,
        slot_root: ds.slot_root,
        compare_key: ds.compare_key,
        compare_value: ds.compare_value,
        region: ds.region,
        specialization_key: ds.specialization_key,
        node_count: ds.node_count,
        entry_count: entries
    };
    out
}

fn write_cell(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, i: int64, value: ValueType, was_present: boolean) -> { ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, status: int64 } {
    sequence
        pair: (region(L, normal), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- alloc_cell(ds.region, value);
        (_: region(L, normal), c: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- pair;
        r0: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- cells_of(ds);
        r: { list: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 }, updated: boolean } <- skew_ral@set(r0, i, c);
        out: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- with_cells(ds, r.list.forest, ds.entry_count + 1 - b2i(was_present))
    produces
        pure { ds: out, status: b2i(was_present) }
    end
}

fn set_entry(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType, value: ValueType) -> { ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, status: int64 } {
    a: int64 <- slot_of(ds, from);
    b: int64 <- slot_of(ds, to);
    case a < 0 or b < 0 of {
        true -> { ds: ds, status: 2 };
        false -> {
            i: int64 <- a * ds.node_count + b;
            was: boolean <- present(cell_at(ds, i));
            write_cell(ds, i, value, was)
        }
    }
}

fn clear_at(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, i: int64) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } {
    sequence
        r0: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- cells_of(ds);
        r: { list: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 }, updated: boolean } <- skew_ral@set(r0, i, none_cell())
    produces
        pure with_cells(ds, r.list.forest, ds.entry_count - 1)
    end
}

// Writes :none into cell(from, to); an absent cell or an ID outside the universe is a no-op.
fn clear_entry(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> { ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, removed: boolean } {
    a: int64 <- slot_of(ds, from);
    b: int64 <- slot_of(ds, to);
    case a < 0 or b < 0 of {
        true -> { ds: ds, removed: false };
        false -> {
            i: int64 <- a * ds.node_count + b;
            case present(cell_at(ds, i)) of {
                false -> { ds: ds, removed: false };
                true -> { ds: clear_at(ds, i), removed: true }
            }
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Rows (design §7): one fold_range over [s * V, s * V + V) collects the present cells as
// (to_slot, cell) hits; hits come back in descending slot order and are reversed once.
// ---------------------------------------------------------------------------------------------

fn hit_step(acc: { next: int64, hits: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] }, cell: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> { next: int64, hits: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] } {
    sequence proc[mem(normal)]
        out: { next: int64, hits: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] } <- case cell of {
            :none -> { next: acc.next + 1, hits: acc.hits };
            _: ref(L, normal, (ValueType, ref?(L, normal, rec))) -> {
                e: (int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- (acc.next, cell);
                grown: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] <- prepend[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)](e, acc.hits);
                { next: acc.next + 1, hits: grown }
            }
        }
    produces
        pure out
    end
}

fn reverse_hits(xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], acc: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)]) -> List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                more: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] <- prepend[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)](xs.head, acc)
            produces
                pure reverse_hits(xs.tail, more)
            end
        }
    }
}

fn empty_hits() -> List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] {
    sequence proc[mem(normal)]
        e: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] <- empty[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)]()
    produces
        pure e
    end
}

// Present cells of row s in ascending to_slot order.
fn row_hits(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64) -> List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] {
    sequence
        r: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- cells_of(ds);
        e: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] <- empty_hits();
        a0: { next: int64, hits: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] } <- { next: 0, hits: e };
        a1: { next: int64, hits: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] } <- skew_ral@fold_range(r, a0, hit_step, s * ds.node_count, ds.node_count);
        e2: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] <- empty_hits()
    produces
        pure reverse_hits(a1.hits, e2)
    end
}

fn hits_of(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)] {
    s: int64 <- slot_of(ds, id);
    case s < 0 of {
        true -> empty_hits();
        false -> row_hits(ds, s)
    }
}

fn count_hits(xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> count_hits(xs.tail, acc + 1)
    }
}

// Present cells in id's row: stored adjacency entries; zero when id is absent or isolated. O(V).
fn degree(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> int64 {
    count_hits(hits_of(ds, id), 0)
}

fn self_loop_count(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> int64 {
    b2i(has_entry(ds, id, id))
}

fn values_go(xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], acc: List[ValueType, mem(normal)]) -> List[ValueType, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                (_: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
                v: ValueType <- cell_value(hc);
                rest: List[ValueType, mem(normal)] <- values_go(xs.tail, acc);
                out: List[ValueType, mem(normal)] <- prepend[ValueType, mem(normal)](v, rest)
            produces
                pure out
            end
        }
    }
}

fn wrappers_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], placeholder: KeyType, acc: List[{ to: KeyType, data: ValueType }, mem(normal)]) -> List[{ to: KeyType, data: ValueType }, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                (hs: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
                k: KeyType <- node_at(ds, hs, placeholder);
                v: ValueType <- cell_value(hc);
                w: { to: KeyType, data: ValueType } <- { to: k, data: v };
                rest: List[{ to: KeyType, data: ValueType }, mem(normal)] <- wrappers_go(ds, xs.tail, placeholder, acc);
                out: List[{ to: KeyType, data: ValueType }, mem(normal)] <- prepend[{ to: KeyType, data: ValueType }, mem(normal)](w, rest)
            produces
                pure out
            end
        }
    }
}

fn empty_values() -> List[ValueType, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[ValueType, mem(normal)] <- empty[ValueType, mem(normal)]()
    produces
        pure e
    end
}

fn empty_wrappers() -> List[{ to: KeyType, data: ValueType }, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[{ to: KeyType, data: ValueType }, mem(normal)] <- empty[{ to: KeyType, data: ValueType }, mem(normal)]()
    produces
        pure e
    end
}

fn empty_keys() -> List[KeyType, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[KeyType, mem(normal)] <- empty[KeyType, mem(normal)]()
    produces
        pure e
    end
}

// Stored values of id's row in ascending target (slot) order.
fn values(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> List[ValueType, mem(normal)] {
    e: List[ValueType, mem(normal)] <- empty_values();
    values_go(hits_of(ds, id), e)
}

// {to: slot_to_node[to_slot], data} views of id's row in ascending target order (design §10 item 5).
fn wrappers(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> List[{ to: KeyType, data: ValueType }, mem(normal)] {
    e: List[{ to: KeyType, data: ValueType }, mem(normal)] <- empty_wrappers();
    wrappers_go(ds, hits_of(ds, id), id, e)
}

fn cons_key(acc: List[KeyType, mem(normal)], k: KeyType) -> List[KeyType, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[KeyType, mem(normal)] <- prepend[KeyType, mem(normal)](k, acc)
    produces
        pure out
    end
}

fn reverse_keys(xs: List[KeyType, mem(normal)], acc: List[KeyType, mem(normal)]) -> List[KeyType, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> reverse_keys(xs.tail, cons_key(acc, xs.head))
    }
}

// The fixed universe in slot (ascending node) order: one logical fold of slot_to_node, O(V).
fn vertices(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> List[KeyType, mem(normal)] {
    r: { count: int64, reversed: boolean, compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- slots_of(ds);
    e: List[KeyType, mem(normal)] <- empty_keys();
    rev: List[KeyType, mem(normal)] <- skew_ral@fold_logical(r, e, cons_key);
    e2: List[KeyType, mem(normal)] <- empty_keys();
    reverse_keys(rev, e2)
}

// Some KeyType value of a non-empty universe (slot 0's ID), used as the placeholder of node_at.
fn first_key_placeholder(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> KeyType {
    vs: List[KeyType, mem(normal)] <- vertices(ds);
    vs.head
}

fn fold_values_go(xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], acc: AccType, step: fn(AccType, ValueType) -> AccType) -> AccType {
    case xs.is_nil of {
        true -> acc;
        false -> {
            (_: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
            v: ValueType <- cell_value(hc);
            fold_values_go(xs.tail, step(acc, v), step)
        }
    }
}

fn fold_wrappers_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], placeholder: KeyType, acc: AccType, step: fn(AccType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
    case xs.is_nil of {
        true -> acc;
        false -> {
            (hs: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
            k: KeyType <- node_at(ds, hs, placeholder);
            v: ValueType <- cell_value(hc);
            w: { to: KeyType, data: ValueType } <- { to: k, data: v };
            fold_wrappers_go(ds, xs.tail, placeholder, step(acc, w), step)
        }
    }
}

fn fold_values(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, ValueType) -> AccType, id: KeyType) -> AccType {
    fold_values_go(hits_of(ds, id), init, step)
}

fn fold_wrappers(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, { to: KeyType, data: ValueType }) -> AccType, id: KeyType) -> AccType {
    fold_wrappers_go(ds, hits_of(ds, id), id, init, step)
}

// Visits every vertex of the universe once in slot (ascending node) order.
fn fold_vertices(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, KeyType) -> AccType) -> AccType {
    r: { count: int64, reversed: boolean, compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- slots_of(ds);
    skew_ral@fold_logical(r, init, step)
}

fn fold_row_go(xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], from: KeyType, acc: AccType, step: fn(AccType, KeyType, ValueType) -> AccType) -> AccType {
    case xs.is_nil of {
        true -> acc;
        false -> {
            (_: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
            v: ValueType <- cell_value(hc);
            fold_row_go(xs.tail, from, step(acc, from, v), step)
        }
    }
}

fn fold_entries_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: AccType, step: fn(AccType, KeyType, ValueType) -> AccType, placeholder: KeyType) -> AccType {
    case s >= ds.node_count of {
        true -> acc;
        false -> {
            from: KeyType <- node_at(ds, s, placeholder);
            a1: AccType <- fold_row_go(row_hits(ds, s), from, acc, step);
            fold_entries_go(ds, s + 1, a1, step, from)
        }
    }
}

// Every present cell as (from, value) in row-major (ascending from, then target) order. Θ(V^2).
fn fold_entries(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, KeyType, ValueType) -> AccType) -> AccType {
    case ds.node_count <= 0 of {
        true -> init;
        false -> fold_entries_go(ds, 0, init, step, first_key_placeholder(ds))
    }
}

fn fold_wrow_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], from: KeyType, acc: AccType, step: fn(AccType, KeyType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
    case xs.is_nil of {
        true -> acc;
        false -> {
            (hs: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
            k: KeyType <- node_at(ds, hs, from);
            v: ValueType <- cell_value(hc);
            w: { to: KeyType, data: ValueType } <- { to: k, data: v };
            fold_wrow_go(ds, xs.tail, from, step(acc, from, w), step)
        }
    }
}

fn fold_wentries_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: AccType, step: fn(AccType, KeyType, { to: KeyType, data: ValueType }) -> AccType, placeholder: KeyType) -> AccType {
    case s >= ds.node_count of {
        true -> acc;
        false -> {
            from: KeyType <- node_at(ds, s, placeholder);
            a1: AccType <- fold_wrow_go(ds, row_hits(ds, s), from, acc, step);
            fold_wentries_go(ds, s + 1, a1, step, from)
        }
    }
}

fn fold_entries_wrapped(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, KeyType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
    case ds.node_count <= 0 of {
        true -> init;
        false -> fold_wentries_go(ds, 0, init, step, first_key_placeholder(ds))
    }
}

fn fold_crow_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], from: KeyType, acc: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    case xs.is_nil of {
        true -> acc;
        false -> {
            (hs: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
            col: int64 <- hs;
            a1: AccType <- case col >= s of {
                false -> acc;
                true -> {
                    k: KeyType <- node_at(ds, col, from);
                    v: ValueType <- cell_value(hc);
                    step(acc, from, k, v)
                }
            };
            fold_crow_go(ds, s, xs.tail, from, a1, step)
        }
    }
}

fn fold_centries_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType, placeholder: KeyType) -> AccType {
    case s >= ds.node_count of {
        true -> acc;
        false -> {
            from: KeyType <- node_at(ds, s, placeholder);
            a1: AccType <- fold_crow_go(ds, s, row_hits(ds, s), from, acc, step);
            fold_centries_go(ds, s + 1, a1, step, from)
        }
    }
}

// Undirected logical-edge fold: the diagonal cell once, a mirrored pair from its lower slot.
fn fold_entries_canonical(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    case ds.node_count <= 0 of {
        true -> init;
        false -> fold_centries_go(ds, 0, init, step, first_key_placeholder(ds))
    }
}

fn entry_row_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], from: KeyType, acc: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                (hs: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
                k: KeyType <- node_at(ds, hs, from);
                v: ValueType <- cell_value(hc);
                e: { from: KeyType, to: KeyType, data: ValueType } <- { from: from, to: k, data: v };
                rest: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- entry_row_go(ds, xs.tail, from, acc);
                out: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- prepend[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)](e, rest)
            produces
                pure out
            end
        }
    }
}

fn entry_list_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, placeholder: KeyType, acc: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    case s < 0 of {
        true -> acc;
        false -> {
            from: KeyType <- node_at(ds, s, placeholder);
            next: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- entry_row_go(ds, row_hits(ds, s), from, acc);
            entry_list_go(ds, s - 1, from, next)
        }
    }
}

// Every present cell as {from, to, data} in row-major order.
fn entry_list(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- empty[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]()
    produces
        pure case ds.node_count <= 0 of {
            true -> e;
            false -> entry_list_go(ds, ds.node_count - 1, first_key_placeholder(ds), e)
        }
    end
}

// ---------------------------------------------------------------------------------------------
// Reachability over slots: depth-first with a wbt_set visited set; terminates on cycles.
// ---------------------------------------------------------------------------------------------

fn prepend_slot(s: int64, rest: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- prepend[int64, mem(normal)](s, rest)
    produces
        pure out
    end
}

fn push_hits(xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], stack: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case xs.is_nil of {
        true -> stack;
        false -> {
            sequence proc[mem(normal)]
                (s: int64, _: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
                more: List[int64, mem(normal)] <- prepend[int64, mem(normal)](s, stack)
            produces
                pure push_hits(xs.tail, more)
            end
        }
    }
}

fn search_go(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, visited: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, stack: List[int64, mem(normal)], goal: int64) -> boolean {
    case stack.is_nil of {
        true -> false;
        false -> {
            s: int64 <- stack.head;
            seen: boolean <- wbt_set@contains(visited, s);
            case seen of {
                true -> search_go(ds, visited, stack.tail, goal);
                false -> case s == goal of {
                    true -> true;
                    false -> {
                        ins: { set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(visited, s);
                        more: List[int64, mem(normal)] <- push_hits(row_hits(ds, s), stack.tail);
                        search_go(ds, ins.set, more, goal)
                    }
                }
            }
        }
    }
}

fn empty_slots() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure e
    end
}

fn reachable(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> boolean {
    a: int64 <- slot_of(ds, from);
    b: int64 <- slot_of(ds, to);
    case a < 0 or b < 0 of {
        true -> false;
        false -> case a == b of {
            true -> true;
            false -> {
                visited: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- wbt_set@empty({ compare_item: cmp_slot });
                e: List[int64, mem(normal)] <- empty_slots();
                stack: List[int64, mem(normal)] <- prepend_slot(a, e);
                search_go(ds, visited, stack, b)
            }
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Construction (design §5): Θ(V^2) cells, all absent.
// ---------------------------------------------------------------------------------------------

fn count_keys(xs: List[KeyType, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> count_keys(xs.tail, acc + 1)
    }
}

fn strictly_ascending(w: { compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater }, xs: List[KeyType, mem(normal)]) -> boolean {
    case xs.is_nil of {
        true -> true;
        false -> {
            rest: List[KeyType, mem(normal)] <- xs.tail;
            case rest.is_nil of {
                true -> true;
                false -> {
                    r: atom <- compare_raw(w.compare_key, xs.head, rest.head);
                    case r of {
                        :less -> strictly_ascending(w, rest);
                        :equal -> false;
                        :greater -> false;
                        bad: atom -> invalid_halt(bad) == :less
                    }
                }
            }
        }
    }
}

fn slot_pairs(xs: List[KeyType, mem(normal)], i: int64) -> List[(KeyType, int64), mem(normal)] {
    case xs.is_nil of {
        true -> {
            sequence proc[mem(normal)]
                e: List[(KeyType, int64), mem(normal)] <- empty[(KeyType, int64), mem(normal)]()
            produces
                pure e
            end
        };
        false -> {
            sequence proc[mem(normal)]
                rest: List[(KeyType, int64), mem(normal)] <- slot_pairs(xs.tail, i + 1);
                p: (KeyType, int64) <- (xs.head, i);
                out: List[(KeyType, int64), mem(normal)] <- prepend[(KeyType, int64), mem(normal)](p, rest)
            produces
                pure out
            end
        }
    }
}

fn slot_root_of(w: { compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater }, arena: region(L, normal), xs: List[KeyType, mem(normal)]) -> ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        m0: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
            root: :none,
            compare_key: w.compare_key,
            compare_value: cmp_slot,
            region: arena,
            specialization_key: 0,
            compare_key_ordering_bundle: 0,
            compare_value_ordering_bundle: 0
        };
        pairs: List[(KeyType, int64), mem(normal)] <- slot_pairs(xs, 0);
        fs: { map: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, valid: boolean, error: atom } <- wbt_map@from_sorted(m0, pairs)
    produces
        pure fs.map.root
    end
}

fn build_dense(w: { compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater }, xs: List[KeyType, mem(normal)], n: int64) -> { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } {
    sequence
        cells: { list: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 }, valid: boolean, error: atom } <- skew_ral@filled({ compare_item: cell_compare }, false, n * n, none_cell());
        slots: { list: { count: int64, reversed: boolean, compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 }, valid: boolean, error: atom } <- skew_ral@from_list({ compare_item: w.compare_key }, false, xs);
        arena: region(L, normal) <- cells.list.region;
        out: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } <- {
            cells: cells.list.forest,
            cell_count: n * n,
            slots: slots.list.forest,
            slot_root: slot_root_of(w, arena, xs),
            compare_key: w.compare_key,
            compare_value: w.compare_value,
            region: arena,
            specialization_key: 0,
            node_count: n,
            entry_count: 0
        }
    produces
        pure out
    end
}

// A dense graph over a strictly ascending universe of IDs (design §2, §5). valid = false — with an
// empty universe — when the list is not strictly ascending under compare_node or V * V would
// overflow int64 (design §3: checked before any allocation).
// Whether a universe is accepted: strictly ascending under compare_node, V * V within int64.
fn valid_universe(w: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater }, nodes: List[KeyType, mem(normal)]) -> boolean {
    n: int64 <- count_keys(nodes, 0);
    n <= 3037000499 and ascending_keys(w.compare_node, nodes)
}

fn ascending_keys(compare: fn(KeyType, KeyType) -> :less | :equal | :greater, xs: List[KeyType, mem(normal)]) -> boolean {
    case xs.is_nil of {
        true -> true;
        false -> {
            rest: List[KeyType, mem(normal)] <- xs.tail;
            case rest.is_nil of {
                true -> true;
                false -> {
                    r: atom <- compare_raw(compare, xs.head, rest.head);
                    case r of {
                        :less -> ascending_keys(compare, rest);
                        :equal -> false;
                        :greater -> false;
                        bad: atom -> invalid_halt(bad) == :less
                    }
                }
            }
        }
    }
}

fn empty_for_nodes(w: { compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater }, nodes: List[KeyType, mem(normal)]) -> { ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, valid: boolean } {
    n: int64 <- count_keys(nodes, 0);
    ok: boolean <- n <= 3037000499 and strictly_ascending(w, nodes);
    case ok of {
        true -> { ds: build_dense(w, nodes, n), valid: true };
        false -> {
            e: List[KeyType, mem(normal)] <- empty_keys();
            { ds: build_dense(w, e, 0), valid: false }
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Validation (design §10–§11; common_contract.md §12): Θ(V^2). logical_count is the logical edge
// count on success and 0 on failure.
// ---------------------------------------------------------------------------------------------

fn ok_result(n: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: true, error: :ok, logical_count: n }
}

fn fail_result(e: atom) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: false, error: e, logical_count: 0 }
}

fn asymmetry_error() -> atom {
    :undirected_asymmetry
}

fn check_extents(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> atom {
    case ds.node_count > 3037000499 or ds.cell_count != ds.node_count * ds.node_count of {
        true -> :dense_cell_mismatch;
        false -> {
            rc: { count: int64, reversed: boolean, compare_item: fn(ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- cells_of(ds);
            vc: { valid: boolean, error: atom, logical_count: int64 } <- skew_ral@validate(rc);
            rk: { count: int64, reversed: boolean, compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, forest: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], region: region(L, normal), specialization_key: int64 } <- slots_of(ds);
            vk: { valid: boolean, error: atom, logical_count: int64 } <- skew_ral@validate(rk);
            case vc.valid and vk.valid of {
                false -> :ral_violation;
                true -> case vc.logical_count == ds.cell_count and vk.logical_count == ds.node_count of {
                    true -> :ok;
                    false -> :dense_cell_mismatch
                }
            }
        }
    }
}

fn slots_ok(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, prev: KeyType) -> atom {
    case s >= ds.node_count of {
        true -> :ok;
        false -> {
            k: KeyType <- node_at(ds, s, prev);
            c: :less | :equal | :greater <- compare_nodes(ds, prev, k);
            ordered: boolean <- case c of {
                :less -> true;
                _: atom -> false
            };
            case s > 0 and ordered == false of {
                true -> :order_violation;
                false -> case slot_of(ds, k) == s of {
                    false -> :slot_mismatch;
                    true -> slots_ok(ds, s + 1, k)
                }
            }
        }
    }
}

fn check_slots(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> atom {
    m: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- slot_map(ds);
    r: { valid: boolean, error: atom, logical_count: int64 } <- wbt_map@validate(m);
    case r.valid and r.logical_count == ds.node_count of {
        false -> :slot_mismatch;
        true -> case ds.node_count <= 0 of {
            true -> :ok;
            false -> slots_ok(ds, 0, first_key_placeholder(ds))
        }
    }
}

fn count_present(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: int64) -> int64 {
    case s >= ds.node_count of {
        true -> acc;
        false -> count_present(ds, s + 1, acc + count_hits(row_hits(ds, s), 0))
    }
}

fn check_common(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> atom {
    case ds.node_count < 0 or ds.cell_count < 0 or ds.entry_count < 0 of {
        true -> :negative_count;
        false -> {
            x: atom <- check_extents(ds);
            case x of {
                :ok -> {
                    sl: atom <- check_slots(ds);
                    case sl of {
                        :ok -> case count_present(ds, 0, 0) == ds.entry_count of {
                            true -> :ok;
                            false -> :edge_count_mismatch
                        };
                        _: atom -> sl
                    }
                };
                _: atom -> x
            }
        }
    }
}

fn apply_target(f: fn(ValueType) -> KeyType, v: ValueType) -> KeyType {
    f(v)
}

fn target_row(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, target_of: fn(ValueType) -> KeyType, xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], from: KeyType) -> boolean {
    case xs.is_nil of {
        true -> true;
        false -> {
            (hs: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
            k: KeyType <- node_at(ds, hs, from);
            t: KeyType <- apply_target(target_of, cell_value(hc));
            case nodes_equal(ds, t, k) of {
                false -> false;
                true -> target_row(ds, target_of, xs.tail, from)
            }
        }
    }
}

fn targets_ok(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, target_of: fn(ValueType) -> KeyType, s: int64, placeholder: KeyType) -> boolean {
    case s >= ds.node_count of {
        true -> true;
        false -> {
            from: KeyType <- node_at(ds, s, placeholder);
            case target_row(ds, target_of, row_hits(ds, s), from) of {
                false -> false;
                true -> targets_ok(ds, target_of, s + 1, from)
            }
        }
    }
}

// Directed dense graph over payload cells: every stored payload's extracted target is the cell's
// column vertex (design §10 item 5), and edge_count is the number of present cells.
fn validate_directed(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, target_of: fn(ValueType) -> KeyType, edge_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    e: atom <- check_common(ds);
    case e of {
        :ok -> case ds.node_count > 0 and targets_ok(ds, target_of, 0, first_key_placeholder(ds)) == false of {
            true -> fail_result(:target_mismatch);
            false -> case edge_count == ds.entry_count of {
                true -> ok_result(edge_count);
                false -> fail_result(:edge_count_mismatch)
            }
        };
        _: atom -> fail_result(e)
    }
}

fn validate_keyed(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, edge_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    e: atom <- check_common(ds);
    case e of {
        :ok -> case edge_count == ds.entry_count of {
            true -> ok_result(edge_count);
            false -> fail_result(:edge_count_mismatch)
        };
        _: atom -> fail_result(e)
    }
}

// The mirrored cell is present and carries comparator-equal data.
fn mirrored(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, cell: ref?(L, normal, (ValueType, ref?(L, normal, rec))), back: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) -> boolean {
    case present(back) of {
        false -> false;
        true -> {
            v: ValueType <- cell_value(cell);
            w: ValueType <- cell_value(back);
            c: :less | :equal | :greater <- compare_values(ds, v, w);
            case c of {
                :equal -> true;
                _: atom -> false
            }
        }
    }
}

fn sym_row(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, xs: List[(int64, ref?(L, normal, (ValueType, ref?(L, normal, rec)))), mem(normal)], loops: int64) -> { error: atom, loops: int64 } {
    case xs.is_nil of {
        true -> { error: :ok, loops: loops };
        false -> {
            (hs: int64, hc: ref?(L, normal, (ValueType, ref?(L, normal, rec)))) <- xs.head;
            col: int64 <- hs;
            case col == s of {
                true -> sym_row(ds, s, xs.tail, loops + 1);
                false -> case mirrored(ds, hc, cell_at(ds, col * ds.node_count + s)) of {
                    true -> sym_row(ds, s, xs.tail, loops);
                    false -> { error: :undirected_asymmetry, loops: loops }
                }
            }
        }
    }
}

fn sym_rows(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, loops: int64) -> { error: atom, loops: int64 } {
    case s >= ds.node_count of {
        true -> { error: :ok, loops: loops };
        false -> {
            r: { error: atom, loops: int64 } <- sym_row(ds, s, row_hits(ds, s), loops);
            case r.error of {
                :ok -> sym_rows(ds, s + 1, r.loops);
                _: atom -> r
            }
        }
    }
}

// Undirected dense graph: mirrored cells present together with comparator-equal data, the diagonal
// stored once, adjacency_entry_count = present cells = L + 2N, edge_count = L + N (design §10 items 6–8).
fn validate_undirected(ds: { cells: List[(int64, ref?(L, normal, (ref?(L, normal, (ValueType, ref?(L, normal, rec))), ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], cell_count: int64, slots: List[(int64, ref?(L, normal, (KeyType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, edge_count: int64, adjacency_entry_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    e: atom <- check_common(ds);
    case e of {
        :ok -> {
            r: { error: atom, loops: int64 } <- sym_rows(ds, 0, 0);
            case r.error of {
                :ok -> case adjacency_entry_count == ds.entry_count and edge_count == r.loops + (ds.entry_count - r.loops) / 2 of {
                    true -> ok_result(edge_count);
                    false -> fail_result(:edge_count_mismatch)
                };
                _: atom -> fail_result(r.error)
            }
        };
        _: atom -> fail_result(e)
    }
}

fn validate_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :negative_count -> 1;
        :dense_cell_mismatch -> 2;
        :ral_violation -> 3;
        :order_violation -> 4;
        :slot_mismatch -> 5;
        :target_mismatch -> 6;
        :edge_count_mismatch -> 7;
        :undirected_asymmetry -> 8;
        _: atom -> 99
    }
}
