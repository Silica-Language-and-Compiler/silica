// Public OrderedSet trait — Layer 3 over the §8A wbt_set core.
// Authority: design_documents/Phase1_TODOs/data_structure_designs/ordered_set_trait.md
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)).

use wbt_set;

export trait OrderedSet;
export compare_item/3;
export fold/3;
export contains/2;
export size/1;

required {
    fn compare_item(set: OrderedSet, a: ItemType, b: ItemType) -> :less | :equal | :greater;
    fn fold(
        set: OrderedSet,
        init: AccType,
        step: fn(AccType, ItemType) -> AccType
    ) -> AccType;
    // WBT supplies O(log n) contains and O(1) cached size; fold-derived
    // fallbacks remain available for other impls via fold.
    fn contains(set: OrderedSet, item: ItemType) -> boolean;
    fn size(set: OrderedSet) -> int64;
}

impl fn compare_item(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    a: ItemType,
    b: ItemType
) -> :less | :equal | :greater {
    wbt_set@apply_compare_item(set, a, b)
}

impl fn fold(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    init: AccType,
    step: fn(AccType, ItemType) -> AccType
) -> AccType {
    wbt_set@fold(set, init, step)
}

impl fn contains(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> boolean {
    wbt_set@contains(set, item)
}

impl fn size(
    set: {
        root: ref?(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> int64 {
    wbt_set@size(set)
}
