// Layer 2 §16 steps 1 and 3 — Brodal–Okasaki queue: simple and skew links (leaf module).
// Authority: brodal_okasaki_queue.md §3. A simple link joins two rank-r trees under the smaller
// root (rank r + 1, one more child). A skew link joins a rank-0 tree and two rank-r trees under
// the smallest of the three roots in the [BO96] shapes: type A when the rank-0 root wins (its two
// children are the rank-r trees), type B otherwise (the rank-0 tree and the losing rank-r tree
// join the winner's children). Both are O(1): every child is prepended.
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

use brodal_okasaki_node;
use brodal_okasaki_compare;

export link_trees/3;
export skew_link/4;
export digit_rank/2;

// A digit is the tree ref itself: the rank is read from the node.
fn digit_rank(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> int64 {
    brodal_okasaki_node@read_rank(heap, d)
}

fn digit_tree(d: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    d
}

// A digit whose tree is :none is malformed; halt deterministically rather than guess.
fn malformed_halt(_: int64) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :none
    end
}

// Allocates the linked node (storing rank_out) and returns it; every tuple-returning call is bound to a let
// before use (a tuple-returning call nested directly in an argument list corrupts the caller's
// staged arguments in the bootstrap emitter).
fn linked_digit(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    rank_out: int64,
    item: ItemType,
    child_count: int64,
    kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        pair: (region(L, normal), ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- brodal_okasaki_node@alloc_cell(heap, item, rank_out, child_count, kids);
        (_: region(L, normal), tree: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) <- pair
    produces
        pure tree
    end
}

fn link_nodes(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    rank: int64,
    d1: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    d2: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    n1: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    n2: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        p1: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_present(heap, n1);
        p2: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_present(heap, n2);
        first_wins: boolean <- brodal_okasaki_compare@le(heap, p1.item, p2.item)
    produces
        pure case first_wins of {
            true -> link_under(heap, rank, p1, digit_tree(d2));
            false -> link_under(heap, rank, p2, digit_tree(d1))
        }
    end
}

fn link_under(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    rank: int64,
    winner: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] },
    loser_tree: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- brodal_okasaki_node@cons_digit(heap, rank, loser_tree, winner.kids)
    produces
        pure linked_digit(heap, rank + 1, winner.item, winner.child_count + 1, kids)
    end
}

// Both digits must carry the same rank.
fn link_trees(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d1: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    d2: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    case digit_tree(d1) of {
        :none -> malformed_halt(0);
        n1: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> case digit_tree(d2) of {
            :none -> malformed_halt(1);
            n2: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> link_nodes(heap, digit_rank(heap, d1), d1, d2, n1, n2)
        }
    }
}

fn skew_type_a(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    rank: int64,
    p0: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] },
    winner: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    loser: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        with_loser: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- brodal_okasaki_node@cons_digit(heap, rank, digit_tree(loser), p0.kids);
        kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- brodal_okasaki_node@cons_digit(heap, rank, digit_tree(winner), with_loser)
    produces
        pure linked_digit(heap, rank + 1, p0.item, 2, kids)
    end
}

fn skew_type_b(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    rank: int64,
    pw: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] },
    d0: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    loser: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        with_loser: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- brodal_okasaki_node@cons_digit(heap, rank, digit_tree(loser), pw.kids);
        kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] <- brodal_okasaki_node@cons_digit(heap, 0, digit_tree(d0), with_loser)
    produces
        pure linked_digit(heap, rank + 1, pw.item, pw.child_count + 2, kids)
    end
}

// One nested call per argument list (see brodal_okasaki_extract@min_tree_choose).
fn skew_after_pair(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    rank: int64,
    d0: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    winner: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    loser: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    p0: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] },
    pw: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] }
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        zero_wins: boolean <- brodal_okasaki_compare@le(heap, p0.item, pw.item)
    produces
        pure case zero_wins of {
            true -> skew_type_a(heap, rank, p0, winner, loser);
            false -> skew_type_b(heap, rank, pw, d0, loser)
        }
    end
}

fn skew_nodes(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    rank: int64,
    d0: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    d1: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    d2: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    n0: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    n1: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    n2: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    sequence
        p0: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_present(heap, n0);
        p1: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_present(heap, n1);
        p2: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_present(heap, n2);
        first_wins: boolean <- brodal_okasaki_compare@le(heap, p1.item, p2.item)
    produces
        pure case first_wins of {
            true -> skew_after_pair(heap, rank, d0, d1, d2, p0, p1);
            false -> skew_after_pair(heap, rank, d0, d2, d1, p0, p2)
        }
    end
}

// d0 has rank 0; d1 and d2 share a rank.
fn skew_link(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d0: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    d1: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    d2: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) {
    case digit_tree(d0) of {
        :none -> malformed_halt(2);
        n0: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> case digit_tree(d1) of {
            :none -> malformed_halt(3);
            n1: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> case digit_tree(d2) of {
                :none -> malformed_halt(4);
                n2: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> skew_nodes(heap, digit_rank(heap, d1), d0, d1, d2, n0, n1, n2)
            }
        }
    }
}
