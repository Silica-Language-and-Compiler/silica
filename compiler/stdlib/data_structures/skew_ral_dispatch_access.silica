// Layer 2 §15 — skew binary random-access list: thin dispatcher for the O(1) front and the
// O(min(i, log n)) index operations. Loads only the forest and index leaf interfaces so the
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// facade (skew_ral) never pays for every leaf at once (tutorials_and_howtos/thin_dispatchers_for_compile_ram.md).
// The collection record is repeated inline at every boundary; the facade owns its construction.
// The record's compare_item field is the ItemType witness the compiler needs at qualified calls.

use skew_ral_forest;
use skew_ral_index;

export push_front/2;
export peek_front/2;
export pop_front/1;
export lookup_physical/3;
export update_physical/3;

fn rebuild(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    count: int64
) -> {
    count: int64,
    reversed: boolean,
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    region: region(L, normal),
    specialization_key: int64
} {
    {
        count: count,
        reversed: ral.reversed,
        compare_item: ral.compare_item,
        forest: forest,
        region: ral.region,
        specialization_key: ral.specialization_key
    }
}

fn push_front_grown(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    item: ItemType,
    new_count: int64
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    status: :ok | :overflow
} {
    grown: { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :ok | :overflow } <-
        skew_ral_forest@forest_prepend(ral, ral.forest, item);
    case grown.status of {
        :overflow -> { list: ral, status: :overflow };
        :ok -> { list: rebuild(ral, grown.forest, new_count), status: :ok }
    }
}

// O(1) worst case; on count or weight overflow the input value is returned with :overflow.
fn push_front(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    item: ItemType
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    status: :ok | :overflow
} {
    count_pair: (boolean, int64) <- checked_int64_add1(ral.count);
    (count_ok: boolean, new_count: int64) <- count_pair;
    case count_ok of {
        false -> { list: ral, status: :overflow };
        true -> push_front_grown(ral, item, new_count)
    }
}

fn peek_front(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    skew_ral_forest@forest_head(ral, ral.forest, placeholder)
}

fn pop_front(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    status: :not_found | :found
} {
    shrunk: { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], status: :not_found | :found } <-
        skew_ral_forest@forest_tail(ral.forest);
    case shrunk.status of {
        :not_found -> { list: ral, status: :not_found };
        :found -> { list: rebuild(ral, shrunk.forest, ral.count - 1), status: :found }
    }
}

fn lookup_physical(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    i: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    skew_ral_index@forest_lookup(ral, ral.forest, i, placeholder)
}

fn update_physical(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    i: int64,
    item: ItemType
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    updated: boolean
} {
    changed: { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], updated: boolean } <-
        skew_ral_index@forest_update(ral, ral.forest, i, item);
    case changed.updated of {
        false -> { list: ral, updated: false };
        true -> { list: rebuild(ral, changed.forest, ral.count), updated: true }
    }
}
