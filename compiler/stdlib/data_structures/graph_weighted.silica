// A new graph value around root with adjusted cached counts; functions, region, specialization
// key and ordering bundles are copied unchanged (common_contract.md §7).
fn publish(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), dn: int64, de: int64) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 } {
