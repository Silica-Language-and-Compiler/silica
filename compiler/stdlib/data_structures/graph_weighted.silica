// Layer 4 — graph_weighted: the live WBT weighted directed graph generated module
// (weighted_graph_trait.md §1–§12 with directed_graph_trait.md §4–§10 over live_wbt_graph.md).
// The design has the value implement DirectedGraph (edge payload = the generated {to, data} view)
// and WeightedGraph; it implements WeightedGraph only (deviation 9).
//
// Record (inline at every boundary; the public WeightedGraph[N, E, W, mem(normal)] bracket type
// binds to empty/1 of this module — graph_weighted is the construction-module name the type
// checker registers for WeightedGraph):
//   { root, compare_node, compare_edge_data, compare_value, edge_weight, compare_weight,
//     compare_item, region, specialization_key, node_count, edge_count,
//     compare_node_ordering_bundle, compare_edge_data_ordering_bundle, edge_weight_ordering_bundle,
//     compare_weight_ordering_bundle }
// Storage is graph_wbt_core's outer WBT map node -> inner WBT map target -> edge data (design §1:
// inner map to -> edge data). Edge identity is (from, to); inserting an existing pair replaces the
// complete edge data and changes no count (design §5–§6). Weights are extracted, never stored.
//
// Deviations forced by the compiler (each mirrors an existing stdlib module):
//   1. Placeholders: KeyType (NodeIdType), ValueType (EdgeDataType), ItemType (WeightType).
//      compare_value repeats compare_edge_data and compare_item repeats compare_weight: they are
//      the record witnesses the type checker reads for ValueType and ItemType.
//   2. The design's example constructor graph_wbt_directed@empty_weighted is graph_weighted@empty/1,
//      and its add_edge/4 is graph_weighted@add_edge/4 (graph_wbt_directed@add_edge is /3 and Silica
//      has no arity overloading).
//   3. weight_of takes a placeholder weight (Silica source cannot conjure a WeightType value for
//      :not_found; as OrderedMap@get and BinaryTree@get).
//   4. fold_neighbors / fold_weighted_neighbors take the accumulator second.
//   5. compare_edge (DirectedGraph payload order) is lexicographic on the {to, data} view: target
//      under compare_node, then data under compare_edge_data.
//   6. out_degree, has_edge and reachable are module functions (the design's DirectedGraph queries).
//   7. The WeightedGraph[...] bracket binding is accepted only for empty/1; mem(normal) only.
//   8. Validation error atoms are created and decoded in graph_wbt_core (validate_error_code).
//   9. No DirectedGraph impl: the trait checker matches a placeholder only at the top level of a
//      type, so neighbors returning List[{ to: KeyType, data: ValueType }] against the required
//      List[ValueType] is E2092 (trials/compile_defects_trait_nested_placeholder_addition). The
//      DirectedGraph queries (node_count, edge_count, has_vertex, neighbors, fold_neighbors,
//      compare_node, compare_edge, edge_target, out_degree, has_edge, reachable) are exported here.
// compare_raw stays the first function in this unit (comparator atom numbering).
// Q19 node shapes (spelled at every use): inner (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)); outer, the graph root, (KeyType, ref?(L, normal, <inner>), int64, ref?(L, normal, rec), ref?(L, normal, rec)).

use graph_wbt_core;

export empty/1;
export add_vertex/2;
export add_edge/4;
export remove_edge/3;
export has_vertex/2;
export has_edge/3;
export neighbors/2;
export weighted_neighbors/2;
export weight_of/4;
export fold_neighbors/4;
export fold_weighted_neighbors/4;
export fold_vertices/3;
export fold_edges/3;
export vertices/1;
export node_count/1;
export edge_count/1;
export out_degree/2;
export reachable/3;
export compare_node/3;
export compare_edge/3;
export edge_target/2;
export compare_edge_data/3;
export edge_weight/2;
export compare_weight/3;
export validate/1;
export validate_error_code/1;

fn compare_raw(
    compare: fn(KeyType, KeyType) -> atom,
    a: KeyType,
    b: KeyType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_value_raw(
    compare: fn(ValueType, ValueType) -> atom,
    a: ValueType,
    b: ValueType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_item_raw(
    compare: fn(ItemType, ItemType) -> atom,
    a: ItemType,
    b: ItemType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

// Deterministic collection error for an invalid comparator atom (common_contract.md §4).
fn invalid_halt(_: atom) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

// Deterministic collection error: count overflow or a malformed graph found by an update; nothing
// is published (common_contract.md §9).
fn update_halt(n: int64) -> int64 {
    sequence
        _: int64 <- 1 / 0
    produces
        pure n
    end
}

fn b2i(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

// Checked non-negative count addition (delta may be negative).
fn count_add(count: int64, delta: int64) -> int64 {
    case delta > 0 and count > 9223372036854775807 - delta of {
        true -> update_halt(count);
        false -> count + delta
    }
}

fn apply_target(f: fn(ValueType) -> KeyType, v: ValueType) -> KeyType {
    f(v)
}

fn apply_weight(f: fn(ValueType) -> ItemType, v: ValueType) -> ItemType {
    f(v)
}

// Compares two vertex IDs with the captured node comparator.
fn compare_node(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, a: KeyType, b: KeyType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_raw(g.compare_node, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// Compares two direction-independent edge-data values with the captured comparator.
fn compare_edge_data(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, a: ValueType, b: ValueType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_value_raw(g.compare_edge_data, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// Compares two extracted weights with the captured weight comparator.
fn compare_weight(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }, a: ItemType, b: ItemType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_item_raw(g.compare_weight, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// The adjacency record graph_wbt_core works on (wbt_map's record shape over node -> value).
fn adj_of(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, compare_node_ordering_bundle: int64, compare_edge_data_ordering_bundle: int64, edge_weight_ordering_bundle: int64, compare_weight_ordering_bundle: int64 }) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
        root: g.root,
        compare_key: g.compare_node,
        compare_value: g.compare_edge_data,
        region: g.region,
        specialization_key: g.specialization_key,
        compare_key_ordering_bundle: g.compare_node_ordering_bundle,
