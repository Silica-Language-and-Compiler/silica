// Layer 2 §16 step 12 — Brodal–Okasaki queue: full structural validation (leaf module).
// Authority: brodal_okasaki_queue.md §12, §13; common_contract.md §12 (result shape).
// Read-only, O(n). Walks the root with a node budget of count + 1 (a cycle or a shared node
// exhausts it), checking arena membership, heap order (parent may sit above each child and each
// deferred root), the child region against the node's stored rank (the root must be rank 0;
// rank 0: no children; rank R: the exact
// child-list grammar brodal_okasaki_link builds -- positives R - 1, R - 2, ..., 1 in order or a
// closing type A pair, one optional rank-0 extra in front of each positive, one or two rank-0 trees
// at the rank-0 level; see children_ok), the deferred forest's skew-digit order, and finally that
// the visited node count equals the recorded count. Error atoms are created and decoded here only.
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

use brodal_okasaki_node;
use brodal_okasaki_compare;
use brodal_okasaki_link;

export validate/1;
export validate_error_code/1;

fn result_ok(count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: true, error: :ok, logical_count: count }
}

fn result_err(error: atom, count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: false, error: error, logical_count: count }
}

// Walk state: (error, nodes visited so far). error = :ok while valid.
fn state_ok(seen: int64) -> { error: atom, seen: int64 } {
    { error: :ok, seen: seen }
}

fn state_err(error: atom, seen: int64) -> { error: atom, seen: int64 } {
    { error: error, seen: seen }
}

fn digit_ok(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent: ItemType,
    d: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    seen: int64,
    budget: int64
) -> { error: atom, seen: int64 } {
    rank: int64 <- brodal_okasaki_link@digit_rank(heap, d);
    case d of {
        :none -> state_err(:missing_tree, seen);
        node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> node_ok(heap, parent, true, rank, node_ref, seen, budget)
    }
}







// Children region of a rank-R node (R >= 1). brodal_okasaki_link builds exactly these child lists:
//   simple link   [R-1] ++ children(winner of rank R-1)
//   skew type B   [0, R-1] ++ children(winner of rank R-1)
//   skew type A   [R-1, R-1]                                   (the list ends there)
// with children(rank 0) = []. Unfolded, the positives step down R-1, R-2, ..., 1 in order (a type A
// pair closes the list), each level may carry one rank-0 extra in front of its positive, and the
// rank-0 level holds one or two rank-0 trees. So a rank-R node has between 1 and 2R children and up
// to R + 1 rank-0 children (design §3, §10: extras are rank-0 trees, one per skew link per level).
// Walk state: digits still to read, node rank, the rank the next structural child must have, whether
// a type-B extra was just read (the structural child must follow), zeros read at the rank-0 level,
// the rank of the structural child just read (type A detection), whether a type A pair closed the
// list, nodes visited, and the budget.
fn advance(
    st: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 },
    next: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 },
    seen: int64
) -> { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 } {
    {
        remaining: st.remaining - 1,
        node_rank: st.node_rank,
        expect: next.expect,
        need_top: next.need_top,
        tail_zeros: next.tail_zeros,
        last_structural: next.last_structural,
        finished: next.finished,
        seen: seen,
        budget: st.budget
    }
}

fn step_state(st: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 }, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean) -> { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 } {
    {
        remaining: st.remaining,
        node_rank: st.node_rank,
        expect: expect,
        need_top: need_top,
        tail_zeros: tail_zeros,
        last_structural: last_structural,
        finished: finished,
        seen: st.seen,
        budget: st.budget
    }
}

// One child digit of rank `rank` against the grammar above; (false, st) rejects it.
fn child_step(st: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 }, rank: int64) -> (boolean, { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 }) {
    case st.finished of {
        true -> (false, st);
        false -> case st.need_top of {
            true -> case rank == st.expect of {
                true -> (true, step_state(st, st.expect - 1, false, st.tail_zeros, rank, false));
                false -> (false, st)
            };
            false -> case rank == st.last_structural and rank == st.expect + 1 of {
                true -> (true, step_state(st, st.expect, false, st.tail_zeros, -1, true));
                false -> case st.expect <= 0 of {
                    true -> case rank == 0 and st.tail_zeros < 2 of {
                        true -> (true, step_state(st, 0, false, st.tail_zeros + 1, -1, false));
                        false -> (false, st)
                    };
                    false -> case rank == st.expect of {
                        true -> (true, step_state(st, st.expect - 1, false, st.tail_zeros, rank, false));
                        false -> case rank == 0 of {
                            true -> (true, step_state(st, st.expect, true, st.tail_zeros, -1, false));
                            false -> (false, st)
                        }
                    }
                }
            }
        }
    }
}

// All structural levels consumed: a type A pair closed the list, or the walk reached the rank-0
// level and read one or two rank-0 trees with no type-B extra left dangling.
fn children_complete(st: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 }) -> boolean {
    case st.finished of {
        true -> true;
        false -> st.expect <= 0 and st.need_top == false and st.tail_zeros >= 1 and st.tail_zeros <= 2
    }
}

fn children_ok(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent: ItemType,
    kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)],
    st: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 }
) -> { error: atom, seen: int64, deferred: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } {
    case st.remaining <= 0 of {
        true -> case children_complete(st) of {
            true -> { error: :ok, seen: st.seen, deferred: kids };
            false -> { error: :rank_violation, seen: st.seen, deferred: kids }
        };
        false -> case kids of {
            []: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] -> { error: :rank_violation, seen: st.seen, deferred: kids };
            [d: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), rest: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]] -> child_ok(heap, parent, d, rest, st)
        }
    }
}

fn child_ok(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent: ItemType,
    d: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    rest: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)],
    st: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 }
) -> { error: atom, seen: int64, deferred: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } {
    rank: int64 <- brodal_okasaki_link@digit_rank(heap, d);
    (shape_ok: boolean, next: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 }) <- child_step(st, rank);
    case shape_ok of {
        false -> { error: :rank_violation, seen: st.seen, deferred: rest };
        true -> child_after_shape(heap, parent, d, rest, st, next)
    }
}

fn child_after_shape(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent: ItemType,
    d: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    rest: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)],
    st: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 },
    next: { remaining: int64, node_rank: int64, expect: int64, need_top: boolean, tail_zeros: int64, last_structural: int64, finished: boolean, seen: int64, budget: int64 }
) -> { error: atom, seen: int64, deferred: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } {
    sub: { error: atom, seen: int64 } <- digit_ok(heap, parent, d, st.seen, st.budget);
    case sub.error of {
        :ok -> children_ok(heap, parent, rest, advance(st, next, sub.seen));
        bad: atom -> { error: bad, seen: sub.seen, deferred: rest }
    }
}

// A rank-0 node is a singleton; a rank-R node carries between 1 and 2R children (see children_ok).
fn node_shape_ok(parts: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] }, rank: int64) -> boolean {
    case rank == 0 of {
        true -> parts.child_count == 0;
        false -> parts.child_count >= 1 and parts.child_count <= 2 * rank
    }
}

fn node_children_then_deferred(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] },
    rank: int64,
    seen: int64,
    budget: int64
) -> { error: atom, seen: int64 } {
    kids: { error: atom, seen: int64, deferred: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <-
        children_ok(heap, parts.item, parts.kids, { remaining: parts.child_count, node_rank: rank, expect: rank - 1, need_top: false, tail_zeros: 0, last_structural: -1, finished: rank == 0, seen: seen, budget: budget });
    case kids.error of {
        :ok -> deferred_ok(heap, parts.item, kids.deferred, -1, 0, kids.seen, budget);
        bad: atom -> state_err(bad, kids.seen)
    }
}

// Deferred forest: increasing ranks, only the first two may be equal; every root is a nested
// queue whose minimum may sit below `parent`.
fn deferred_ok(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent: ItemType,
    forest: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)],
    prev_rank: int64,
    position: int64,
    seen: int64,
    budget: int64
) -> { error: atom, seen: int64 } {
    case forest of {
        []: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] -> state_ok(seen);
        [d: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), rest: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]] -> deferred_digit_ok(heap, parent, d, rest, prev_rank, position, seen, budget)
    }
}

fn deferred_digit_ok(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent: ItemType,
    d: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    rest: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)],
    prev_rank: int64,
    position: int64,
    seen: int64,
    budget: int64
) -> { error: atom, seen: int64 } {
    rank: int64 <- brodal_okasaki_link@digit_rank(heap, d);
    order_ok: boolean <- case rank < 0 of {
        true -> false;
        false -> case position == 0 of {
            true -> true;
            false -> case position == 1 of {
                true -> rank >= prev_rank;
                false -> rank > prev_rank
            }
        }
    };
    case order_ok of {
        false -> state_err(:rank_violation, seen);
        true -> {
            sub: { error: atom, seen: int64 } <- digit_ok(heap, parent, d, seen, budget);
            case sub.error of {
                :ok -> deferred_ok(heap, parent, rest, rank, position + 1, sub.seen, budget);
                bad: atom -> sub
            }
        }
    }
}



fn node_after_read(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent: ItemType,
    has_parent: boolean,
    rank: int64,
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] },
    seen: int64,
    budget: int64
) -> { error: atom, seen: int64 } {
    sequence
        order_ok: boolean <- case has_parent of {
            false -> true;
            true -> brodal_okasaki_compare@le(heap, parent, parts.item)
        }
    produces
        pure case order_ok of {
            false -> state_err(:heap_order_violation, seen);
            true -> case node_shape_ok(parts, rank) of {
                false -> state_err(:rank_violation, seen);
                true -> node_children_then_deferred(heap, parts, rank, seen + 1, budget)
            }
        }
    end
}

fn node_ok(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parent: ItemType,
    has_parent: boolean,
    rank: int64,
    node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
    seen: int64,
    budget: int64
) -> { error: atom, seen: int64 } {
    case seen >= budget of {
        true -> state_err(:cycle, seen);
        false -> case brodal_okasaki_node@in_arena(heap, node_ref) of {
            false -> state_err(:wrong_arena, seen);
            true -> node_after_read(heap, parent, has_parent, rank, brodal_okasaki_node@read_present(heap, node_ref), seen, budget)
        }
    }
}

fn validate_root(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))
) -> { valid: boolean, error: atom, logical_count: int64 } {
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)] } <- brodal_okasaki_node@read_present(heap, node_ref);
    walked: { error: atom, seen: int64 } <- node_ok(heap, parts.item, false, 0, node_ref, 0, heap.count + 1);
    root_rank: int64 <- brodal_okasaki_link@digit_rank(heap, heap.root);
    case walked.error of {
        :ok -> case root_rank == 0 of {
            false -> result_err(:rank_violation, walked.seen);
            true -> case walked.seen == heap.count of {
                true -> result_ok(walked.seen);
                false -> result_err(:size_mismatch, walked.seen)
            }
        };
        bad: atom -> result_err(bad, walked.seen)
    }
}

fn validate(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    case heap.count < 0 of {
        true -> result_err(:negative_count, 0);
        false -> case heap.root of {
            :none -> case heap.count == 0 of {
                true -> result_ok(0);
                false -> result_err(:size_mismatch, 0)
            };
            node_ref: ref(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> validate_root(heap, node_ref)
        }
    }
}

fn validate_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :negative_count -> 1;
        :size_mismatch -> 2;
        :heap_order_violation -> 3;
        :rank_violation -> 4;
        :wrong_arena -> 5;
        :cycle -> 6;
        :missing_tree -> 7;
        _: atom -> 99
    }
}
