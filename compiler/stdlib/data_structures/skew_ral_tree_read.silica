// Layer 2 §15 steps 5 and 8 — skew binary random-access list: read-only tree walks (leaf module).
// Authority: skew_binary_random_access_list.md §6 (lookup), §10 (fold and range traversal).
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// A tree of weight w covers w consecutive physical indexes in preorder: root, left subtree, right
// subtree. Nothing in this module allocates a tree cell.
// Every exported function whose signature mentions ItemType takes the collection record first:
// the compiler resolves ItemType at a qualified call site from the record's compare_item witness
// (type_checker_collections@assoc_type_from_record_witness). The core never calls compare_item.

use skew_ral_weights;
use skew_ral_node;

export tree_lookup/5;
export tree_fold_fwd/4;
export tree_fold_rev/4;
export tree_fold_range_fwd/8;
export tree_fold_range_rev/8;

fn lookup_below(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    parts: { present: boolean, item: ItemType, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) },
    w: int64,
    rest: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    cw: int64 <- skew_ral_weights@child_weight(w);
    case rest < cw of {
        true -> tree_lookup(ral, parts.left, cw, rest, placeholder);
        false -> tree_lookup(ral, parts.right, cw, rest - cw, placeholder)
    }
}

// Index 0 addresses the root; i > 0 skips the root, then goes left when i - 1 < w / 2.
fn tree_lookup(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    i: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    parts: { present: boolean, item: ItemType, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) } <- skew_ral_node@read_node(ral, tree, placeholder);
    case parts.present of {
        false -> { status: :not_found, value: placeholder };
        true -> case i == 0 of {
            true -> { status: :found, value: parts.item };
            false -> lookup_below(ral, parts, w, i - 1, placeholder)
        }
    }
}

fn fold_fwd_cell(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    sequence proc[mem(normal)]
        node: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (item, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        acc_root: AccType <- step(acc, item);
        acc_left: AccType <- tree_fold_fwd(ral, acc_root, step, left)
    produces
        pure tree_fold_fwd(ral, acc_left, step, right)
    end
}

fn tree_fold_fwd(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    case tree of {
        :none -> acc;
        node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> fold_fwd_cell(ral, acc, step, node_ref)
    }
}

fn fold_rev_cell(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    sequence proc[mem(normal)]
        node: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (item, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        acc_right: AccType <- tree_fold_rev(ral, acc, step, right);
        acc_left: AccType <- tree_fold_rev(ral, acc_right, step, left)
    produces
        pure step(acc_left, item)
    end
}

fn tree_fold_rev(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> AccType {
    case tree of {
        :none -> acc;
        node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> fold_rev_cell(ral, acc, step, node_ref)
    }
}

// Range folds visit the items whose physical index p satisfies lo <= p < hi.
// The tree covers [base, base + w); base + w never exceeds the sequence length.

fn inside(base: int64, lo: int64, hi: int64) -> boolean {
    (lo <= base) and (base < hi)
}

fn covered(base: int64, end_excl: int64, lo: int64, hi: int64) -> boolean {
    (lo <= base) and (end_excl <= hi)
}

fn range_fwd_cell(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    sequence proc[mem(normal)]
        node: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (item, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        cw: int64 <- skew_ral_weights@child_weight(w);
        acc_root: AccType <- case inside(base, lo, hi) of {
            true -> step(acc, item);
            false -> acc
        };
        acc_left: AccType <- tree_fold_range_fwd(ral, acc_root, step, left, cw, base + 1, lo, hi)
    produces
        pure tree_fold_range_fwd(ral, acc_left, step, right, cw, base + 1 + cw, lo, hi)
    end
}

fn range_fwd_partial(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    case tree of {
        :none -> acc;
        node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> range_fwd_cell(ral, acc, step, node_ref, w, base, lo, hi)
    }
}

fn tree_fold_range_fwd(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    end_excl: int64 <- base + w;
    case end_excl <= lo of {
        true -> acc;
        false -> case base >= hi of {
            true -> acc;
            false -> case covered(base, end_excl, lo, hi) of {
                true -> tree_fold_fwd(ral, acc, step, tree);
                false -> range_fwd_partial(ral, acc, step, tree, w, base, lo, hi)
            }
        }
    }
}

fn range_rev_cell(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    sequence proc[mem(normal)]
        node: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
        (item, left: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- node;
        cw: int64 <- skew_ral_weights@child_weight(w);
        acc_right: AccType <- tree_fold_range_rev(ral, acc, step, right, cw, base + 1 + cw, lo, hi);
        acc_left: AccType <- tree_fold_range_rev(ral, acc_right, step, left, cw, base + 1, lo, hi)
    produces
        pure case inside(base, lo, hi) of {
            true -> step(acc_left, item);
            false -> acc_left
        }
    end
}

fn range_rev_partial(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    case tree of {
        :none -> acc;
        node_ref: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> range_rev_cell(ral, acc, step, node_ref, w, base, lo, hi)
    }
}

fn tree_fold_range_rev(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    w: int64,
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    end_excl: int64 <- base + w;
    case end_excl <= lo of {
        true -> acc;
        false -> case base >= hi of {
            true -> acc;
            false -> case covered(base, end_excl, lo, hi) of {
                true -> tree_fold_rev(ral, acc, step, tree);
                false -> range_rev_partial(ral, acc, step, tree, w, base, lo, hi)
            }
        }
    }
}
