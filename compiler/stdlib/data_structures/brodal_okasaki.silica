// Layer 2 §16 — Brodal–Okasaki bootstrapped skew-binomial queue: core surface (facade).
// Authority: design_documents/Phase1_TODOs/data_structure_designs/brodal_okasaki_queue.md.
//
// Module map (thin dispatchers, tutorials_and_howtos/thin_dispatchers_for_compile_ram.md):
//   brodal_okasaki (facade) ── uses ──> brodal_okasaki_dispatch_core ──> brodal_okasaki_boot
//                           └─ uses ──> brodal_okasaki_dispatch_bulk ──> boot, compare, validate
//   leaves: brodal_okasaki_node (cells, arena), brodal_okasaki_compare (checked comparison and
//           orientation), brodal_okasaki_link (simple and skew links), brodal_okasaki_forest
//           (primitive skew forest: insert, normalize, merge, compatibility), brodal_okasaki_extract
//           (find-min and delete-min normalization), brodal_okasaki_boot (bootstrapped roots),
//           brodal_okasaki_validate. The facade never uses a leaf directly.
//
// Representation (inline at every boundary):
//   { root: ref?, count, max_oriented: boolean, compare_item, region, specialization_key,
//     compare_item_ordering_bundle }
// A node is (minimum, rank, child_count, anchor, children_and_deferred), spelled
// (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]) (design §3):
// the list holds plain tree refs, the first child_count are the skew-binomial children, the rest is
// the deferred primitive forest of the nested queue (design §5, one flattened node type, one list).
// The rank is stored in the node at allocation: 0 for a root, r + 1 for a linked node.
// Deviations forced by the bootstrap compiler:
//   1. child_count is stored: the [BO96] type-B child boundary cannot be derived from rank alone
//      in O(1) (a rank-1 tree's one or two rank-0 children are indistinguishable from a deferred
//      forest that starts with rank-0 trees).
//   2. `anchor` is a never-used :none slot because alloc_rec requires a direct recursive slot.
//   3. Orientation is `max_oriented: boolean`, not :min | :max, and the constructor takes it as a
//      boolean: atom values are numbered per compilation unit, so a non-seeded atom must not cross
//      a `use` boundary. Comparator atoms cross into brodal_okasaki_compare only, where the
//      comparator_result_validate call is the first function (matching user comparators that list
//      :less, :equal, :greater first). Validation error atoms are created and decoded in
//      brodal_okasaki_validate only.
//   4. peek and pop take a placeholder item: Silica source cannot conjure an ItemType zero value;
//      the §19 generated modules supply one from the constructor witness.
// The ordering bundle is materialized here from the exact comparator function value and the
// orientation; meld compares bundles and arenas before allocating (design §8).
// Arena: canonical_arena_lookup(arena_key()) until the Heap family registers specializations.

use brodal_okasaki_dispatch_core;
use brodal_okasaki_dispatch_bulk;

export arena_key/0;
export empty/2;
export singleton/3;
export push/2;
export peek/2;
export pop/2;
export meld/2;
export size/1;
export is_empty/1;
export is_max_oriented/1;
export compare_item/3;
export from_list/3;
export validate/1;
export validate_error_code/1;

fn arena_key() -> int64 {
    82
}

fn make_bundle(
    compare: fn(ItemType, ItemType) -> :less | :equal | :greater,
    max_oriented: boolean
) -> int64 {
    sequence
        token: int64 <- ordering_identity_materialize(compare);
        bundle: int64 <- case max_oriented of {
            true -> ordering_identity_bundle_make(token, :max);
            false -> ordering_identity_bundle_make(token, :min)
        }
    produces
        pure bundle
    end
}

// Internal name: an unqualified local `empty(...)` call resolves to the list primitive.
fn empty_heap(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    max_oriented: boolean
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        arena: region(L, normal) <- canonical_arena_lookup(82);
        bundle: int64 <- make_bundle(functions.compare_item, max_oriented);
        out: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } <- {
            root: :none,
            count: 0,
            max_oriented: max_oriented,
            compare_item: functions.compare_item,
            region: arena,
            specialization_key: 0,
            compare_item_ordering_bundle: bundle
        }
    produces
        pure out
    end
}

fn empty(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    max_oriented: boolean
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    empty_heap(functions, max_oriented)
}

fn singleton(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    max_oriented: boolean,
    item: ItemType
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    brodal_okasaki_dispatch_core@push(empty_heap(functions, max_oriented), item)
}

// O(1) worst case (one skew link at most).
fn push(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    item: ItemType
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    brodal_okasaki_dispatch_core@push(heap, item)
}

fn peek(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    brodal_okasaki_dispatch_core@peek(heap, placeholder)
}

// O(log n) worst case; an empty heap answers :not_found with the same value.
fn pop(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    placeholder: ItemType
) -> { heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, status: :not_found | :found, value: ItemType } {
    brodal_okasaki_dispatch_core@pop(heap, placeholder)
}

// O(1); incompatible inputs return `left` with compatible = false before any allocation.
fn meld(
    left: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    right: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> { heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }, compatible: boolean } {
    brodal_okasaki_dispatch_core@meld(left, right)
}

fn size(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> int64 {
    heap.count
}

fn is_empty(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> boolean {
    heap.count == 0
}

fn is_max_oriented(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> boolean {
    heap.max_oriented
}

fn compare_item(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    a: ItemType,
    b: ItemType
) -> :less | :equal | :greater {
    brodal_okasaki_dispatch_bulk@compare_item(heap, a, b)
}

fn from_list(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    max_oriented: boolean,
    items: List[ItemType, mem(normal)]
) -> {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    } {
    brodal_okasaki_dispatch_bulk@from_items(empty_heap(functions, max_oriented), items)
}

fn validate(
    heap: {
        root: ref?(L, normal, (ItemType, int64, int64, ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    brodal_okasaki_dispatch_bulk@validate(heap)
}

fn validate_error_code(error: atom) -> int64 {
    brodal_okasaki_dispatch_bulk@validate_error_code(error)
}
