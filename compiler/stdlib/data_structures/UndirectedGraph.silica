// Public UndirectedGraph trait — query behavior shared by the undirected graph representations.
// Authority: design_documents/Phase1_TODOs/data_structure_designs/undirected_graph_trait.md §3.
//
// Implementations (static conformance; distinct concrete records, no runtime representation tag):
//   graph_weighted_undirected
//   graph_csr_undirected
//   graph_csr_weighted_undirected
//   graph_dense_undirected
//   graph_dense_weighted_undirected
//   graph_wbt_undirected
//
// Neighbor views are the generated {to, data} wrappers; a self-loop appears once in neighbors and
// counts twice in degree.
// Deviations forced by the compiler:
//   1. Placeholders are spelled KeyType (NodeIdType) and ValueType (EdgeDataType).
//   2. degree, has_edge and connected are required, not provided (same reasons as DirectedGraph:
//      no closures for fold steps; E2003 on placeholder-result trait calls on a trait-typed value,
//      trials/compile_defects_trait_placeholder_return_addition); each representation implements
//      them within the design's bounds.
//   3. An UndirectedGraph[N, E, mem(normal)] binding is accepted only for
//      graph_wbt_undirected@empty/1; see 5 for trait calls on it.
//   4. mem(normal) only.
//   5. Trait calls take the representations' inline record types. An UndirectedGraph[...]-typed
//      value fits every implementation that carries compare_node/compare_edge_data, and the checker
//      picks one by declaration order instead of by the value's constructor (the last one in a
//      per-unit compile; trials/traits_addition/emitter_defect_bracket_receiver_impl_order); with
//      arguments beyond the receiver it is rejected (E2003,
//      trials/compile_defects_bracket_receiver_arguments_addition). graph_wbt_undirected, the
//      bracket-constructible representation, is listed last.
//   6. A method whose result mentions a placeholder — neighbors, fold_neighbors, edge_target — is
//      dispatched to the LAST implementation whatever the receiver
//      (trials/compile_defects_trait_placeholder_result_dispatch_addition). graph_wbt_undirected is
//      last; for the other representations call their module functions of the same names until
//      the checker is fixed. The other methods dispatch by receiver.
//   7. A function with an UndirectedGraph-typed parameter runs one implementation (the last listed)
//      for every argument (trials/traits_addition/emitter_defect_trait_param_single_impl).
// Q19 node shapes: each impl record spells its representation's nodes (see graph_wbt_core, graph_dense_core and graph_csr_core).

use graph_weighted_undirected;
use graph_csr_undirected;
use graph_csr_weighted_undirected;
use graph_dense_undirected;
use graph_dense_weighted_undirected;
use graph_wbt_undirected;

export trait UndirectedGraph;

/// Returns the number of vertices.
export node_count/1;

/// Returns the number of logical unordered endpoint pairs.
export edge_count/1;

/// Reports whether `id` is an explicit vertex.
export has_vertex/2;

/// Materializes adjacency entries in ascending target order.
export neighbors/2;

/// Folds adjacency entries without materializing a list.
export fold_neighbors/4;

/// Compares two vertex IDs with the comparator captured by the graph.
export compare_node/3;

/// Compares two direction-independent edge-data values.
export compare_edge_data/3;

/// Extracts the target ID from an internal directional edge wrapper.
export edge_target/2;

/// Returns graph-theoretic degree, counting a self-loop twice.
export degree/2;

/// Reports whether the unordered endpoint pair `(a, b)` exists.
export has_edge/3;

/// Reports whether `a` and `b` are in the same connected component.
export connected/3;

required {
    fn node_count(g: UndirectedGraph) -> int64;
    fn edge_count(g: UndirectedGraph) -> int64;
    fn has_vertex(g: UndirectedGraph, id: KeyType) -> boolean;
    fn neighbors(g: UndirectedGraph, id: KeyType) -> List[{ to: KeyType, data: ValueType }, mem(normal)];
    fn fold_neighbors(
        g: UndirectedGraph,
        id: KeyType,
        init: AccType,
        step: fn(AccType, { to: KeyType, data: ValueType }) -> AccType
    ) -> AccType;
    fn compare_node(g: UndirectedGraph, a: KeyType, b: KeyType) -> :less | :equal | :greater;
    fn compare_edge_data(g: UndirectedGraph, a: ValueType, b: ValueType) -> :less | :equal | :greater;
    fn edge_target(g: UndirectedGraph, edge: { to: KeyType, data: ValueType }) -> KeyType;
    fn degree(g: UndirectedGraph, id: KeyType) -> int64;
    fn has_edge(g: UndirectedGraph, a: KeyType, b: KeyType) -> boolean;
    fn connected(g: UndirectedGraph, a: KeyType, b: KeyType) -> boolean;
}

// ---- graph_weighted_undirected ----

impl fn node_count(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }) -> int64 {
    graph_weighted_undirected@node_count(g)
}

