// The Fifi socket wrappers (compiler/stdlib/net/silica_sockets.c) as a dangerous module: the raw
// bindings and their adapters. Every answer is the wrapper's tagged result { tag, value, error_code }
// with tag 0 ok, 1 error (errno in error_code), 2 timeout, 3 closed by the peer; received bytes come
// back through take/1 as a string. A project that uses the hosted carriers links the archive
// libsilica_sockets.a and places silica_sockets_wrapper.meta under dangerous_exposure_source/sockets.
module dangerous_sockets;

wrapper_meta "dangerous_exposure_source/sockets/silica_sockets_wrapper.meta";

export tcp_connect/2;
export tcp_listen/1;
export tcp_listen_any/1;
export local_port/1;
export tcp_accept/2;
export udp_bind/1;
export udp_send/4;
export udp_recv/3;
export serial_open/2;
export send_bytes/3;
export recv_bytes/3;
export take/1;
export close_fd/1;

// The FFI carries a pointer-plus-length pair only as a binding's sole parameters, so a wrapper that
// needs a string and scalars takes the scalars first (set_args, set_host; kept per worker thread).
foreign c_wrapper "silica_sockets_set_args"
fn set_args_raw(a: int64, b: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_set_host"
fn set_host_raw(host_ptr: uint8, host_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_tcp_connect"
fn tcp_connect_raw(host_ptr: uint8, host_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_tcp_listen"
fn tcp_listen_raw(port: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_tcp_listen_any"
fn tcp_listen_any_raw(port: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_local_port"
fn local_port_raw(fd: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_tcp_accept"
fn tcp_accept_raw(fd: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_udp_bind"
fn udp_bind_raw(port: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_udp_send"
fn udp_send_raw(data_ptr: uint8, data_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_udp_recv"
fn udp_recv_raw(fd: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_serial_open"
fn serial_open_raw(path_ptr: uint8, path_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_send"
fn send_raw(data_ptr: uint8, data_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_recv"
fn recv_raw(fd: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_sockets_take"
fn take_raw(fd: int64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

foreign c_wrapper "silica_sockets_close"
fn close_raw(fd: int64) -> { tag: int64, value: int64, error_code: int64 };

fn tcp_connect(host: string, port: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(port, 0);
    r: { tag: int64, value: int64, error_code: int64 } <- tcp_connect_raw(host);
    r
}

fn tcp_listen(port: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- tcp_listen_raw(port);
    r
}

// tcp_listen binds 127.0.0.1 only; tcp_listen_any binds every IPv4 interface (0.0.0.0). The wildcard is the
// explicit form until interface binding exists (transport_links_design.md, (:interface, name)): plain TCP with
// no authentication, so the host's firewall is the only protection of such a port.
fn tcp_listen_any(port: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- tcp_listen_any_raw(port);
    r
}

fn local_port(fd: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- local_port_raw(fd);
    r
}

fn tcp_accept(fd: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- tcp_accept_raw(fd, timeout_ms);
    r
}

fn udp_bind(port: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- udp_bind_raw(port);
    r
}

fn udp_send(fd: int64, host: string, port: int64, data: string) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(fd, port);
    _: { tag: int64, value: int64, error_code: int64 } <- set_host_raw(host);
    r: { tag: int64, value: int64, error_code: int64 } <- udp_send_raw(data);
    r
}

fn udp_recv(fd: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- udp_recv_raw(fd, max, timeout_ms);
    r
}

fn serial_open(path: string, baud: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(baud, 0);
    r: { tag: int64, value: int64, error_code: int64 } <- serial_open_raw(path);
    r
}

fn send_bytes(fd: int64, data: string, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(fd, timeout_ms);
    r: { tag: int64, value: int64, error_code: int64 } <- send_raw(data);
    r
}

fn recv_bytes(fd: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- recv_raw(fd, max, timeout_ms);
    r
}

// The bytes of the last recv or udp_recv on this worker.
fn take(fd: int64) -> string {
    out: string <- take_raw(fd);
    out
}

fn close_fd(fd: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- close_raw(fd);
    r
}
