}

wrapper silica_nimble_mtu {
    symbol: "silica_nimble_mtu"
    result: "tagged_result"
    error_domain: "dangerous_nimble"
}

wrapper silica_nimble_send {
    symbol: "silica_nimble_send"
    result: "tagged_result"
    error_domain: "dangerous_nimble"
    arguments: [
        { name: "data_ptr", lifetime: "borrowed", retain: false },
