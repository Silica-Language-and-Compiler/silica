link_library: "silica_ble_nimble"

wrapper silica_nimble_start {
    symbol: "silica_nimble_start"
    result: "tagged_result"
    error_domain: "dangerous_nimble"
}

wrapper silica_nimble_event {
    symbol: "silica_nimble_event"
    result: "tagged_result"
    error_domain: "dangerous_nimble"
}

wrapper silica_nimble_event_field {
    symbol: "silica_nimble_event_field"
    result: "tagged_result"
    error_domain: "dangerous_nimble"
}

wrapper silica_nimble_advertise {
    symbol: "silica_nimble_advertise"
    result: "tagged_result"
    error_domain: "dangerous_nimble"
    arguments: [
        { name: "uuid_ptr", lifetime: "borrowed", retain: false },
        { name: "uuid_len", role: "length", length_of: "uuid_ptr" }
    ]
}

wrapper silica_nimble_stop_advertising {
    symbol: "silica_nimble_stop_advertising"
    result: "tagged_result"
    error_domain: "dangerous_nimble"
}

wrapper silica_nimble_memory {
    symbol: "silica_nimble_memory"
    result: "tagged_result"
    error_domain: "dangerous_nimble"
}
