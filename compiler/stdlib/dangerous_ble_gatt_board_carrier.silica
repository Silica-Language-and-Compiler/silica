// The (:ble_gatt) carrier of transport_serialization_design.md §6.3 and §6.5 on the ESP32-S3
// (transport_ble_plan.md stage 7): the connection actor of §2.2, speaking the carrier contract of §6.2
// to its owner and casting to the radio actor (dangerous_ble_radio), which alone calls the Bluetooth
// host. The program runs as a guest of ESP-IDF (board/guest) with compiler/stdlib/ble/
// silica_ble_nimble.c in its image. The carrier is declared on the chip's radio,
// `carried_on <name>: (:ble_gatt) (:bluetooth, 0);`, spawned with spawn_dangerous_carrier(<name>, ...)
// and opened with (:open, owner, address), the address as on a hosted target
// (dangerous_ble_gatt_carrier). It calls no foreign code itself, so it is an ordinary actor and the
// spawn answers an actor_ref, where the hosted carrier is a dangerous_actor_ref:
//
//   "peripheral:<uuid>"  publishes and advertises the service and waits for a central to subscribe.
//   "central:<uuid>"     is not provided on the board yet (the plan's stage 9): (:link_down, :fault).
//
// <uuid> is the service's UUID in text (4, 8 or 36 characters); nothing after the colon means the
// Nordic UART Service. :open answers nothing while the carrier waits for its central; when one has
// subscribed the owner gets (:link_up, "mtu:<n>"), n being the largest segment the link carries (the
// negotiated ATT_MTU minus 3, at least 20), and 8 send credits.
//
// One :tx is one segment, an indication: :tx_credit comes back when the central has confirmed it.
// A segment longer than the link's mtu is (:tx_failed, :too_long); a :tx while the link is not up,
// or one the central did not confirm, is (:tx_failed, :link_down). Received segments (the central's
// writes with response) are delivered as :rx, one per :credit the owner granted.
//
// (:link_down, reason): :closed after :close or when the central ended the link, :timeout when the
// link was lost, :fault for an address that names no role the board provides, a UUID that cannot be
// read, a radio that did not start, or any other failure. After :link_down the carrier can be opened
// again, with the same service: the host publishes one service for as long as the program runs.
//
// The first :open spawns the radio actor under the name :dangerous_ble_radio. One carrier at a time
// holds the radio: the board serves one central (the plan's stage 9 adds the other roles).
module dangerous_ble_gatt_board_carrier;

use dangerous_ble_radio;

export initial/0;
export carrier/2;

// phase: 0 not open, 1 waiting for a central, 2 up. radio: this carrier has spawned the radio actor.
fn initial() -> { owner: actor_ref, phase: int64, radio: boolean } {
    { owner: actor_ref_of_word(0), phase: 0, radio: false }
}

fn starts(s: string, p: string) -> boolean {
    length_bytes(s) >= length_bytes(p) and substring(s, 0, length_bytes(p)) == p
}

fn int_text_from(n: int64, acc: string) -> string {
    case n < 10 of {
        true -> concat(substring("0123456789", n, n + 1), acc);
        false -> int_text_from(n / 10, concat(substring("0123456789", n % 10, n % 10 + 1), acc))
    }
}

fn int_text(n: int64) -> string {
    int_text_from(n, "")
}

// NimBLE's reason for a disconnection as the contract's: 0x213 the central ended the link, 0x216 this
// end did, 0x208 the link was lost.
fn down_reason_of(reason: int64) -> atom {
    case reason == 531 or reason == 534 of {
        true -> :closed;
        false -> case reason == 520 of {
            true -> :timeout;
            false -> :fault
        }
    }
}

// The tags of the messages this actor takes, as values. Nothing calls it. An atom that a program
// first meets as the tag of a tuple pattern is numbered 0 in that module's code on the compiler's first
// pass (found 2026-11-14, transport_ble_plan.md §6, stage 7), so no message matches until the program
// is compiled again; an atom that is also written as a value is numbered rightly. The other carriers
// name their tags as values in msg_kind.
fn tag_of(n: int64) -> atom {
    case n of {
        0 -> :open;
        1 -> :tx;
        2 -> :credit;
        3 -> :close;
        4 -> :radio;
        _: int64 -> :radio_rx
    }
}

// Tells the radio actor, spawning it first when this carrier has not done so (a cast to a name that
// no actor holds ends the sender, so the name is not tried).
fn to_radio(spawned: boolean, msg: (:start, actor_ref) | (:serve, actor_ref, string) | (:advertise, string) | :stop_advertising | :memory | (:send, string) | (:rx_credit, int64) | :drop | :poll) -> boolean {
    sequence proc[concurrency]
        _: boolean <- case spawned of {
            true -> true;
            false -> {
                sequence proc[concurrency]
                    _: dangerous_actor_ref <- spawn_dangerous_registered({ owner: actor_ref_of_word(0), phase: 0, service: "", wanted: false, serving: false, up: false, central: 0 - 1, rx_credit: 0 }, dangerous_ble_radio@radio, :dangerous_ble_radio, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
                produces
                    pure true
                end
            }
        };
        told: boolean <- cast_dangerous_registered(:dangerous_ble_radio, msg impl ActorMessage {})
    produces
        pure told
    end
}

fn own_ref() -> actor_ref {
    sequence proc[concurrency]
        me: actor_ref <- self()
    produces
        pure me
    end
}

fn tell(owner: actor_ref, down: boolean, reason: atom) -> boolean {
    sequence proc[concurrency]
        _: boolean <- case down of {
            true -> cast(owner, (:link_down, reason) impl ActorMessage {});
            false -> true
        }
    produces
        pure true
    end
}

fn carrier(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:radio, atom, int64) | (:radio_rx, string), state: { owner: actor_ref, phase: int64, radio: boolean }) -> (:no_reply, { owner: actor_ref, phase: int64, radio: boolean }) {
    case msg of {
        (:open, o: actor_ref, address: string) -> case state.phase == 0 of {
            // an :open while the carrier is open is ignored: the owner closes first
            false -> (:no_reply, state);
            true -> case starts(address, "peripheral:") of {
                true -> {
                    me: actor_ref <- own_ref();
                    // bound first: a call inside a later argument's tuple overwrites an earlier argument
                    // (found 2026-11-14, transport_ble_plan.md §6, stage 7)
                    service: string <- substring(address, 11, length_bytes(address));
                    _: boolean <- to_radio(state.radio, (:serve, me, service));
                    (:no_reply, { owner: o, phase: 1, radio: true })
                };
                false -> {
                    sequence proc[concurrency]
                        _: boolean <- cast(o, (:link_down, :fault) impl ActorMessage {})
                    produces
                        pure (:no_reply, { owner: o, phase: 0, radio: state.radio })
                    end
                }
            }
        };
        (:tx, seg: string, _from: actor_ref) -> {
            sequence proc[concurrency]
                _: boolean <- case state.phase == 2 of {
                    true -> to_radio(true, (:send, seg));
                    false -> cast(state.owner, (:tx_failed, :link_down) impl ActorMessage {})
                }
            produces
                pure (:no_reply, state)
            end
        };
        // a credit granted before the first :open has no radio to go to
        (:credit, n: int64) -> {
            _: boolean <- case state.radio of {
                true -> to_radio(true, (:rx_credit, n));
                false -> true
            };
            (:no_reply, state)
        };
        :close -> {
            sequence proc[concurrency]
                _: boolean <- case state.phase != 0 of {
                    true -> to_radio(true, :drop);
                    false -> true
                };
                _: boolean <- cast(state.owner, (:link_down, :closed) impl ActorMessage {})
            produces
                pure (:no_reply, { owner: state.owner, phase: 0, radio: state.radio })
            end
        };
        (:radio_rx, seg: string) -> {
            sequence proc[concurrency]
                _: boolean <- case state.phase == 2 of {
                    true -> cast(state.owner, (:rx, seg) impl ActorMessage {});
                    false -> true
                }
            produces
                pure (:no_reply, state)
            end
        };
        (:radio, what: atom, n: int64) -> {
            sequence proc[concurrency]
                came_up: boolean <- what == :link_up and state.phase == 1;
                _: boolean <- case came_up of {
                    true -> cast(state.owner, (:link_up, concat("mtu:", int_text(n))) impl ActorMessage {});
                    false -> true
                };
                _: boolean <- case came_up of {
                    true -> cast(state.owner, (:tx_credit, 8) impl ActorMessage {});
                    false -> true
                };
                _: boolean <- case what == :sent and state.phase == 2 of {
                    true -> case n == 0 of {
                        true -> cast(state.owner, (:tx_credit, 1) impl ActorMessage {});
                        false -> cast(state.owner, (:tx_failed, :link_down) impl ActorMessage {})
                    };
                    false -> true
                };
                _: boolean <- case what == :send_failed and state.phase == 2 of {
                    true -> cast(state.owner, (:tx_failed, case n == 4 of { true -> :too_long; false -> :link_down }) impl ActorMessage {});
                    false -> true
                };
                // the radio did not start or would not publish the service: nothing to drop
                failed: boolean <- state.phase != 0 and (what == :start_failed or what == :serve_failed or what == :advertise_failed);
                // the central left, or the host lost the controller, under a link that was up
                lost: boolean <- state.phase == 2 and (what == :disconnected or what == :reset);
                _: boolean <- case failed and what == :advertise_failed of {
                    true -> to_radio(true, :drop);
                    false -> true
                };
                _: boolean <- tell(state.owner, failed or lost, case what == :disconnected of { true -> down_reason_of(n); false -> :fault })
            produces
                pure (:no_reply, { owner: state.owner, phase: case failed or lost of { true -> 0; false -> case came_up of { true -> 2; false -> state.phase } }, radio: state.radio })
            end
        }
    }
}
