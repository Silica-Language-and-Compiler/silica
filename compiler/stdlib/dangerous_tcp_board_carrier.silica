// The (:tcp) carrier on the ESP32-S3 over the chip's Wi-Fi (transport_ble_plan.md stage 12, part 6;
// the Wi-Fi plan's stage 7): the connection actor, speaking the carrier contract of
// transport_serialization_design.md §6.2 to its owner and casting to the radio actor
// (dangerous_wifi_radio), which alone calls the station and lwIP. It is
// dangerous_ble_gatt_board_carrier, the (:ble_gatt) carrier of the same board, with the radio actor
// and the address's words changed. The compiler's pack for this target has no (:tcp) carrier and no
// (:wifi, n) link yet, so no `carried_on` names it: a program spawns it as an ordinary actor,
// spawn({ owner: actor_ref_of_word(0), phase: 0, radio: false }, dangerous_tcp_board_carrier@carrier,
// ...) (the state initial/0 answers, written out: a call into a dangerous module is allowed only in
// an FFI worker), and opens it with (:open, owner, address):
//
//   "<a.b.c.d>:<port>"  joins the access point compiled into the wrapper, takes an address and connects
//                       to the peer over TCP;
//   "listen:<port>"     not built: (:link_down, :fault).
//
// The two forms are the hosted (:tcp) carrier's (dangerous_tcp_carrier), which has more of them.
//
// :open answers nothing while the carrier seeks its peer; when the connection is up the owner gets
// (:link_up, "mtu:<n>"), n being the largest segment one :tx carries, and 8 send credits.
//
// One :tx is one segment, written to the connection whole; :tx_credit comes back when lwIP has taken
// it. A segment longer than the mtu is (:tx_failed, :too_long); a :tx while the link is not up is
// (:tx_failed, :link_down). What comes in is delivered as :rx, one per :credit the owner granted: a
// TCP connection keeps no boundaries, so an :rx is whatever had come, and the owner frames by
// wireframe's :stream mode.
//
// (:link_down, reason): :closed after :close or when the peer closed, :timeout when the connection
// was lost, :fault for an address that cannot be read, a carrier that does not hold the station, or
// a station that did not start. After :link_down the carrier can be opened again.
//
// The link is not encrypted above Wi-Fi's own protection of the air.
//
// The board holds one connection. The first carrier a program opens takes the station for as long as
// the program runs: it registers itself under the name :dangerous_tcp_board_carrier and spawns the
// radio actor under the name :dangerous_wifi_radio. An :open to any other carrier answers
// (:link_down, :fault).
module dangerous_tcp_board_carrier;

use dangerous_wifi_radio;

export initial/0;
export carrier/2;

// phase: 0 not open, 1 waiting for the peer, 2 up. radio: this carrier has spawned the radio actor.
fn initial() -> { owner: actor_ref, phase: int64, radio: boolean } {
    { owner: actor_ref_of_word(0), phase: 0, radio: false }
}

fn starts(s: string, p: string) -> boolean {
    length_bytes(s) >= length_bytes(p) and substring(s, 0, length_bytes(p)) == p
}

fn int_text_from(n: int64, acc: string) -> string {
    case n < 10 of {
        true -> concat(substring("0123456789", n, n + 1), acc);
        false -> int_text_from(n / 10, concat(substring("0123456789", n % 10, n % 10 + 1), acc))
    }
}

fn int_text(n: int64) -> string {
    int_text_from(n, "")
}

// The wrapper's reason for a disconnection, in the Bluetooth wrapper's numbers, as the contract's. :closed when an
// end chose to end the link: 0x213 the peer's user, 0x214 the peer short of resources, 0x215 the peer
// powering off, 0x216 this end. :timeout when the peer stopped answering: 0x208 the link was lost,
// 0x222 no answer to a request, 0x23E the connection was never established.
fn down_reason_of(reason: int64) -> atom {
    case reason >= 531 and reason <= 534 of {
        true -> :closed;
        false -> case reason == 520 or reason == 546 or reason == 574 of {
            true -> :timeout;
            false -> :fault
        }
    }
}

// The tags of the messages this actor takes, as values. Nothing calls it. An atom that a program
// first meets as the tag of a tuple pattern is numbered 0 in that module's code on the compiler's first
// pass (found 2026-11-14, transport_ble_plan.md §6, stage 7), so no message matches until the program
// is compiled again; an atom that is also written as a value is numbered rightly. The other carriers
// name their tags as values in msg_kind.
fn tag_of(n: int64) -> atom {
    case n of {
        0 -> :open;
        1 -> :tx;
        2 -> :credit;
        3 -> :close;
        4 -> :radio;
        _: int64 -> :radio_rx
    }
}

// Tells the radio actor, spawning it first when this carrier has not done so (a cast to a name that
// no actor holds ends the sender, so the name is not tried).
fn to_radio(spawned: boolean, msg: (:start, actor_ref) | (:serve, actor_ref, string) | (:seek, actor_ref, string) | (:advertise, string) | :stop_advertising | :memory | (:send, string) | (:rx_credit, int64) | :drop | :poll) -> boolean {
    sequence proc[concurrency]
        _: boolean <- case spawned of {
            true -> true;
            false -> {
                sequence proc[concurrency]
                    _: dangerous_actor_ref <- spawn_dangerous_registered({ owner: actor_ref_of_word(0), phase: 0, service: "", wanted: false, serving: false, seeking: false, up: false, central: 0 - 1, rx_credit: 0, waiting: 0 }, dangerous_wifi_radio@radio, :dangerous_wifi_radio, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
                produces
                    pure true
                end
            }
        };
        told: boolean <- cast_dangerous_registered(:dangerous_wifi_radio, msg impl ActorMessage {})
    produces
        pure told
    end
}

// This carrier holds the radio: it does already, or the name is free and it takes it now.
fn holds_radio(spawned: boolean) -> boolean {
    case spawned of {
        true -> true;
        false -> {
            sequence proc[concurrency]
                me: actor_ref <- self();
                reg: actor_ref <- get_pid_registry();
                answer: (atom, actor_ref) <- call(reg, { op: :insert, name: :dangerous_tcp_board_carrier, pid: me } impl ActorMessage {});
                (what: atom, _who: actor_ref) <- answer
            produces
                pure what == :ok
            end
        }
    }
}

fn own_ref() -> actor_ref {
    sequence proc[concurrency]
        me: actor_ref <- self()
    produces
        pure me
    end
}

fn tell(owner: actor_ref, down: boolean, reason: atom) -> boolean {
    sequence proc[concurrency]
        _: boolean <- case down of {
            true -> cast(owner, (:link_down, reason) impl ActorMessage {});
            false -> true
        }
    produces
        pure true
    end
}

fn carrier(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:radio, atom, int64) | (:radio_rx, string), state: { owner: actor_ref, phase: int64, radio: boolean }) -> (:no_reply, { owner: actor_ref, phase: int64, radio: boolean }) {
    case msg of {
        (:open, o: actor_ref, address: string) -> case state.phase == 0 of {
            // an :open while the carrier is open is ignored: the owner closes first
            false -> (:no_reply, state);
            true -> case holds_radio(state.radio) and starts(address, "listen:") of {
                true -> {
                    me: actor_ref <- own_ref();
                    // bound first: a call inside a later argument's tuple overwrites an earlier argument
                    // (found 2026-11-14, transport_ble_plan.md §6, stage 7)
                    service: string <- substring(address, 7, length_bytes(address));
                    _: boolean <- to_radio(state.radio, (:serve, me, service));
                    (:no_reply, { owner: o, phase: 1, radio: true })
                };
                // any other address is a peer's, "a.b.c.d:port", as the hosted (:tcp) carrier reads it
                false -> case holds_radio(state.radio) of {
                    true -> {
                        me: actor_ref <- own_ref();
                        service: string <- address;
                        _: boolean <- to_radio(state.radio, (:seek, me, service));
                        (:no_reply, { owner: o, phase: 1, radio: true })
                    };
                    false -> {
                        sequence proc[concurrency]
                            _: boolean <- cast(o, (:link_down, :fault) impl ActorMessage {})
                        produces
                            pure (:no_reply, { owner: o, phase: 0, radio: state.radio })
                        end
                    }
                }
            }
        };
        (:tx, seg: string, _from: actor_ref) -> {
            sequence proc[concurrency]
                _: boolean <- case state.phase == 2 of {
                    true -> to_radio(true, (:send, seg));
                    false -> cast(state.owner, (:tx_failed, :link_down) impl ActorMessage {})
                }
            produces
                pure (:no_reply, state)
            end
        };
        // a credit granted before the first :open has no radio to go to
        (:credit, n: int64) -> {
            _: boolean <- case state.radio of {
                true -> to_radio(true, (:rx_credit, n));
                false -> true
            };
            (:no_reply, state)
        };
        :close -> {
            sequence proc[concurrency]
                _: boolean <- case state.phase != 0 of {
                    true -> to_radio(true, :drop);
                    false -> true
                };
                _: boolean <- cast(state.owner, (:link_down, :closed) impl ActorMessage {})
            produces
                pure (:no_reply, { owner: state.owner, phase: 0, radio: state.radio })
            end
        };
        (:radio_rx, seg: string) -> {
            sequence proc[concurrency]
                _: boolean <- case state.phase == 2 of {
                    true -> cast(state.owner, (:rx, seg) impl ActorMessage {});
                    false -> true
                }
            produces
                pure (:no_reply, state)
            end
        };
        (:radio, what: atom, n: int64) -> {
            sequence proc[concurrency]
                came_up: boolean <- what == :link_up and state.phase == 1;
                _: boolean <- case came_up of {
                    true -> cast(state.owner, (:link_up, concat("mtu:", int_text(n))) impl ActorMessage {});
                    false -> true
                };
                _: boolean <- case came_up of {
                    true -> cast(state.owner, (:tx_credit, 8) impl ActorMessage {});
                    false -> true
                };
                _: boolean <- case what == :sent and state.phase == 2 of {
                    true -> case n == 0 of {
                        true -> cast(state.owner, (:tx_credit, 1) impl ActorMessage {});
                        false -> cast(state.owner, (:tx_failed, :link_down) impl ActorMessage {})
                    };
                    false -> true
                };
                _: boolean <- case what == :send_failed and state.phase == 2 of {
                    true -> cast(state.owner, (:tx_failed, case n == 4 of { true -> :too_long; false -> :link_down }) impl ActorMessage {});
                    false -> true
                };
                // the radio did not start or would not publish the service: nothing to drop
                failed: boolean <- state.phase != 0 and (what == :start_failed or what == :serve_failed or what == :seek_failed or what == :advertise_failed);
                // the peer left, or the station lost the access point, under a link that was up
                lost: boolean <- state.phase == 2 and (what == :disconnected or what == :reset);
                _: boolean <- case failed and what == :advertise_failed of {
                    true -> to_radio(true, :drop);
                    false -> true
                };
                _: boolean <- tell(state.owner, failed or lost, case what == :disconnected of { true -> down_reason_of(n); false -> :fault })
            produces
                pure (:no_reply, { owner: state.owner, phase: case failed or lost of { true -> 0; false -> case came_up of { true -> 2; false -> state.phase } }, radio: state.radio })
            end
        }
    }
}
