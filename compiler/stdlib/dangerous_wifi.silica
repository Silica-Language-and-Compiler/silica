// The Fifi wrapper around Espressif's Wi-Fi station and lwIP (compiler/stdlib/wifi/silica_wifi_lwip.c)
// as a dangerous module: the raw bindings and their adapters, for a program on the ESP32-S3
// (transport_ble_plan.md stage 12, part 6). It has the shape of dangerous_nimble, the Bluetooth
// host's module, binding for binding, so that the radio actor above it (dangerous_wifi_radio) is
// that host's radio actor with the names changed. Every answer is the wrapper's tagged result
// { tag, value, error_code } with tag 0 ok, 1 error, 2 nothing yet. No call waits for the network:
// what happens later comes out of event/1. Only the radio actor makes requests of the station;
// memory/1 can be called by any dangerous actor. A project that uses it places
// silica_wifi_lwip_wrapper.meta under dangerous_exposure_source/wifi and adds silica_wifi_lwip.c to
// its image.
module dangerous_wifi;

wrapper_meta "dangerous_exposure_source/wifi/silica_wifi_lwip_wrapper.meta";

export start/0;
export event/1;
export event_field/1;
export advertise/1;
export stop_advertising/0;
export memory/1;
export serve/1;
export mtu/1;
export send_bytes/2;
export recv_bytes/1;
export take/1;
export drop/1;
export start_error/0;
export event_kind/0;
export event_value/1;
export advertise_error/1;
export stop_advertising_error/0;
export memory_value/1;
export serve_error/1;
export mtu_value/1;
export send_error/2;
export recv_length/1;
export drop_error/1;
export seek_error/1;

foreign c_wrapper "silica_wifi_start"
fn start_raw(reserved: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_event"
fn event_raw(timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_event_field"
fn event_field_raw(index: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_advertise"
fn advertise_raw(uuid_ptr: uint8, uuid_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_stop_advertising"
fn stop_advertising_raw(reserved: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_memory"
fn memory_raw(which: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_serve"
fn serve_raw(uuid_ptr: uint8, uuid_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

// The FFI carries a pointer-plus-length pair only as a binding's sole parameters, so send_bytes hands
// its connection over first (as dangerous_ble's set_args).
foreign c_wrapper "silica_wifi_set_args"
fn set_args_raw(a: int64, b: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_mtu"
fn mtu_raw(conn: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_send"
fn send_raw(data_ptr: uint8, data_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_recv"
fn recv_raw(conn: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_take"
fn take_raw(conn: int64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

foreign c_wrapper "silica_wifi_seek"
fn seek_raw(uuid_ptr: uint8, uuid_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_wifi_drop"
fn drop_raw(conn: int64) -> { tag: int64, value: int64, error_code: int64 };

// Starts the station, once. Event 1 (ready) says when it has joined and has an address.
fn start() -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- start_raw(0);
    r
}

// The next event (timeout_ms is not used: the call never waits); tag 2 when there is none. value:
// 1 ready, 2 reset, 4 connected, 5 disconnected, 6 subscribed, 7 sent, 8 written.
fn event(timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- event_raw(timeout_ms);
    r
}

// Field 0 or 1 of the event that event/1 answered last (the wrapper says what each event carries).
fn event_field(index: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- event_field_raw(index);
    r
}

// Not built (listening): error_code 9.
fn advertise(service: string) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- advertise_raw(service);
    r
}

fn stop_advertising() -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- stop_advertising_raw(0);
    r
}

// The memory the Wi-Fi libraries and lwIP take theirs from, in bytes: 0 free now, 1 the least free
// since start, 2 the largest free block.
fn memory(which: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- memory_raw(which);
    r
}

// Not built (listening): error_code 9.
fn serve(service: string) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- serve_raw(service);
    r
}

// The largest segment the connection carries.
fn mtu(conn: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- mtu_raw(conn);
    r
}

// Sends one segment; event 7 (sent) follows. error_code 3 when there is no connection, 4 when the
// segment is empty or longer than mtu/1, 5 when lwIP cannot take it now.
fn send_bytes(conn: int64, data: string) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(conn, 0);
    r: { tag: int64, value: int64, error_code: int64 } <- send_raw(data);
    r
}

// Takes the bytes that came: value their count, tag 2 when there are none.
fn recv_bytes(conn: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- recv_raw(conn);
    r
}

// The bytes of the last recv_bytes.
fn take(conn: int64) -> string {
    out: string <- take_raw(conn);
    out
}

// Ends the connection; event 5 (disconnected) follows.
fn drop(conn: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- drop_raw(conn);
    r
}

// One field of each answer, for a caller that keeps many of them in one frame: a record costs a stack
// frame far more than its fields, and the largest frame in a program sets the stack reserve of every
// actor on the board (dangerous_wifi_radio). An error_code is 0 when the call answered ok; a value is 0
// when there was nothing (no event, no segment).
fn start_error() -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- start_raw(0);
    v: int64 <- r.error_code;
    v
}

// The next event's kind, 0 when there is none.
fn event_kind() -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- event_raw(0);
    v: int64 <- r.value;
    v
}

fn event_value(index: int64) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- event_field_raw(index);
    v: int64 <- r.value;
    v
}

fn advertise_error(service: string) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- advertise_raw(service);
    v: int64 <- r.error_code;
    v
}

fn stop_advertising_error() -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- stop_advertising_raw(0);
    v: int64 <- r.error_code;
    v
}

fn memory_value(which: int64) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- memory_raw(which);
    v: int64 <- r.value;
    v
}

fn serve_error(service: string) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- serve_raw(service);
    v: int64 <- r.error_code;
    v
}

fn mtu_value(conn: int64) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- mtu_raw(conn);
    v: int64 <- r.value;
    v
}

fn send_error(conn: int64, data: string) -> int64 {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(conn, 0);
    r: { tag: int64, value: int64, error_code: int64 } <- send_raw(data);
    v: int64 <- r.error_code;
    v
}

// The next segment's length, 0 when there is none.
fn recv_length(conn: int64) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- recv_raw(conn);
    v: int64 <- r.value;
    v
}

fn drop_error(conn: int64) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- drop_raw(conn);
    v: int64 <- r.error_code;
    v
}

// Begins a TCP connection to address, "a.b.c.d:port"; event 4 (connected) says how it ended and event
// 6 (subscribed) that the link is up. 6 for text that is not an address, 7 before the ready event.
fn seek_error(service: string) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- seek_raw(service);
    v: int64 <- r.error_code;
    v
}
