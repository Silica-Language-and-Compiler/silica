// The Carrier properties of transport_serialization_design.md §6.1 for the carriers the hosted
// paths provide (§6.3), one literal per tag. The tag is the atom (:tcp, :udp, :serial): a one-atom
// tagged tuple is not a run-time value in this language, so the properties take the atom.
// Carrier is a closed trait (§9.1): these rows are the language's, maintained with the compiler.

export mtu/1;
export boundaries/1;
export delivery/1;
export addressing/1;
export provided/1;

fn provided(c: atom) -> boolean {
    case c of {
        :tcp -> true;
        :udp -> true;
        :serial -> true;
        _: atom -> false
    }
}

// Largest segment in bytes; 0 means unbounded.
fn mtu(c: atom) -> int64 {
    case c of {
        :udp -> 65507;
        _: atom -> 0
    }
}

fn boundaries(c: atom) -> atom {
    case c of {
        :udp -> :datagram;
        _: atom -> :stream
    }
}

fn delivery(c: atom) -> atom {
    case c of {
        :udp -> :unreliable;
        _: atom -> :reliable_ordered
    }
}

fn addressing(c: atom) -> atom {
    case c of {
        :serial -> :none;
        _: atom -> :endpoint
    }
}
