// The Carrier properties of transport_serialization_design.md §6.1 for the carriers the hosted
// paths provide (§6.3) and the ESP32-S3 board provides (§6.4), one literal per tag. The parameter is
// the tag's atom (:tcp, :udp, :serial, :uart1, :usb_serial_jtag): a one-atom tagged tuple is not a
// run-time value in this language. The design's spelling carrier@mtu((:tcp)) works all the same,
// because `(:tcp)` as an expression is a parenthesised atom literal whose value is the atom :tcp;
// carrier@mtu(:tcp) names the same row. A carrier declared with `carried_on <name>: (<:kind>) (<:link>,
// ...)` (transport_links_design.md §3.3) is read through its name, Carrier@mtu(<name>): the compiler
// resolves the name to the kind's atom, and in phases A to C the link narrows no property (§7).
// Carrier is a closed trait (§9.1): these rows are the language's, maintained with the compiler.
// The membership test is `provides`, not `provided`: `provided` is a keyword (a trait's provided
// block), so a call spelled with it cannot be parsed. The board rows (:uart1) and (:usb_serial_jtag)
// were added on 2026-11-09 (stage S-C of transport_esp32s3_wifi_plan.md): both are serial links with
// no address, so their addressing is :none; their mtu, boundaries and delivery are the defaults.

export mtu/1;
export boundaries/1;
export delivery/1;
export addressing/1;
export provides/1;

fn provides(c: atom) -> boolean {
    case c of {
        :tcp -> true;
        :udp -> true;
        :serial -> true;
        :uart1 -> true;
        :usb_serial_jtag -> true;
        _: atom -> false
    }
}

// Largest segment in bytes; 0 means unbounded.
fn mtu(c: atom) -> int64 {
    case c of {
        :udp -> 65507;
        _: atom -> 0
    }
}

fn boundaries(c: atom) -> atom {
    case c of {
        :udp -> :datagram;
        _: atom -> :stream
    }
}

fn delivery(c: atom) -> atom {
    case c of {
        :udp -> :unreliable;
        _: atom -> :reliable_ordered
    }
}

fn addressing(c: atom) -> atom {
    case c of {
        :serial -> :none;
        :uart1 -> :none;
        :usb_serial_jtag -> :none;
        _: atom -> :endpoint
    }
}
