// The Fifi console wrapper (compiler/stdlib/net/silica_console.c) as a dangerous module: standard input,
// descriptor 0, read without blocking. Every answer is the wrapper's tagged result { tag, value,
// error_code } with tag 0 ok, 1 error (errno in error_code), 2 nothing ready, 3 end of input; the bytes
// of a read come back through take/0 as a string. A project that uses the (:stdin) link links the
// archive libsilica_console.a and places silica_console_wrapper.meta under dangerous_exposure_source/sockets.
module dangerous_console;

wrapper_meta "dangerous_exposure_source/sockets/silica_console_wrapper.meta";

export probe/0;
export read/1;
export take/0;

// The wrappers take one int64 that probe and take do not use, so every binding has a parameter list.
foreign c_wrapper "silica_console_probe"
fn probe_raw(unused: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_console_read"
fn read_raw(max: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "silica_console_take"
fn take_raw(unused: int64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

// Value 1 when standard input is a terminal, 0 when it is a pipe or a file.
fn probe() -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- probe_raw(0);
    r
}

// Reads at most max bytes (65536 at most) if any are ready now: tag 0 with the count, 2 when nothing is
// ready, 3 at the end of input, 1 for an error. It never blocks.
fn read(max: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- read_raw(max);
    r
}

// The bytes of the last read on this worker.
fn take() -> string {
    out: string <- take_raw(0);
    out
}
