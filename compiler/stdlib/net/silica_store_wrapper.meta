link_library: "silica_store"

wrapper silica_store_set_args {
    symbol: "silica_store_set_args"
    result: "tagged_result"
    error_domain: "dangerous_store"
}

wrapper silica_store_open {
    symbol: "silica_store_open"
    result: "tagged_result"
    error_domain: "dangerous_store"
    arguments: [
        { name: "path_ptr", lifetime: "borrowed", retain: false },
        { name: "path_len", role: "length", length_of: "path_ptr" }
    ]
}

wrapper silica_store_headers {
    symbol: "silica_store_headers"
    result: "tagged_result"
    error_domain: "dangerous_store"
}

wrapper silica_store_read {
    symbol: "silica_store_read"
    result: "tagged_result"
    error_domain: "dangerous_store"
}

wrapper silica_store_take {
    symbol: "silica_store_take"
    result: "struct"
    error_domain: "dangerous_store"
}

wrapper silica_store_write {
    symbol: "silica_store_write"
    result: "tagged_result"
    error_domain: "dangerous_store"
    arguments: [
        { name: "data_ptr", lifetime: "borrowed", retain: false },
        { name: "data_len", role: "length", length_of: "data_ptr" }
    ]
}

wrapper silica_store_flush {
    symbol: "silica_store_flush"
    result: "tagged_result"
    error_domain: "dangerous_store"
}

wrapper silica_store_close {
    symbol: "silica_store_close"
    result: "tagged_result"
    error_domain: "dangerous_store"
}
