link_library: "silica_console"

wrapper silica_console_probe {
    symbol: "silica_console_probe"
    result: "tagged_result"
    error_domain: "dangerous_console"
}

wrapper silica_console_read {
    symbol: "silica_console_read"
    result: "tagged_result"
    error_domain: "dangerous_console"
}

wrapper silica_console_take {
    symbol: "silica_console_take"
    result: "struct"
    error_domain: "dangerous_console"
}
