// Shared string→int64 / numeric-string→int64 maps for compiler-internal emitter pools.
// No type aliases. Explicit OrderedMap[string, int64, mem(normal)] at bindings.

use wbt_map;
use OrderedMap;
use string_parse;

export compare_string/2;
export compare_int64/2;
export compare_string_as_int64/2;
export empty_string_int64_map/0;
export empty_numeric_string_int64_map/0;
export map_insert_or_get_index/3;
export map_index_of/2;
export empty_int64_int64_map/0;
export int64_map_insert_or_get_index/3;

fn compare_string(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_int64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

// Numeric compare of integer-literal keys (decimal, 0x hexadecimal, 0b binary).
fn compare_string_as_int64(a: string, b: string) -> :less | :equal | :greater {
    compare_int64(string_parse@string_to_int64(a), string_parse@string_to_int64(b))
}

fn empty_string_int64_map() -> {
    root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(string, string) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence
        m: OrderedMap[string, int64, mem(normal)] <- wbt_map@empty({
            compare_key: compare_string,
            compare_value: compare_int64
        })
    produces
        pure m
    end
}

fn empty_numeric_string_int64_map() -> {
    root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(string, string) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence
        m: OrderedMap[string, int64, mem(normal)] <- wbt_map@empty({
            compare_key: compare_string_as_int64,
            compare_value: compare_int64
        })
    produces
        pure m
    end
}

fn insert_new_index(
    map: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: string,
    next_index: int64
) -> {
    map: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    index: int64,
    inserted: boolean
} {
    sequence
        r: {
            map: {
                root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(string, string) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(map, key, next_index);
        out: {
            map: {
                root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(string, string) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            index: int64,
            inserted: boolean
        } <- {
            map: r.map,
            index: next_index,
            inserted: true
        }
    produces
        pure out
    end
}

fn map_insert_or_get_index(
    map: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: string,
    next_index: int64
) -> {
    map: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    index: int64,
    inserted: boolean
} {
    sequence
        g: { status: :not_found | :found, value: int64 } <- OrderedMap@get(map, key, 0);
        out: {
            map: {
                root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(string, string) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            index: int64,
            inserted: boolean
        } <- case g.status of {
            :found -> {
                map: map,
                index: g.value,
                inserted: false
            };
            :not_found -> insert_new_index(map, key, next_index)
        }
    produces
        pure out
    end
}

fn map_index_of(
    map: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    key: string
) -> int64 {
    sequence
        g: { status: :not_found | :found, value: int64 } <- OrderedMap@get(map, key, 0);
        idx: int64 <- case g.status of {
            :found -> g.value;
            :not_found -> 0 - 1
        }
    produces
        pure idx
    end
}

// int64-keyed twin of the string map above (same call shapes), used by the device register overlap check.
fn empty_int64_int64_map() -> {
    root: ref?(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence
        m: OrderedMap[int64, int64, mem(normal)] <- wbt_map@empty({
            compare_key: compare_int64,
            compare_value: compare_int64
        })
    produces
        pure m
    end
}

