{- Core effect checking infrastructure.
   Provides EffectCheckResult, EffectEntry environment, and helper functions
   for effect comparison, validation, and built-in effect recognition.
   Implements spec §9.1 (Effect Types), §9.1.2 (Effect Aliases).

   Supervisors — design_documents/supervisors_implementation_development_plan.md:
   Phase B (§15.4.9, §16.2.7): ingress vs standard mailbox ordering is runtime-only — no extra
   compile-time effect for “ingress”.
   Phase C (§15.4.10–§15.4.11): exit notifications and failure_reason payloads are constructed
   in the runtime; no separate user-visible effect for delivering to supervisor ingress.
   Phase D (§15.4.8.3, §15.4.13): behavior-only spawn_linked / link are enforced in the type
   checker (E2091), not here; when they appear in an effect-checked body they still require
   proc[concurrency] like other actor intrinsics.
   Phase E (§15.4.12.1, §15.4.12.3, §15.4.13.1–§15.4.13.2, §15.4.13.3): static child_spec table,
   automatic restart, restart caps / escalation, and dynamic children (spawn_linked only, no
   auto-restart row) are applied by the runtime; there is no additional compile-time effect.
   Module-level Supervisor init return shape (flags + List[child_spec, normal]) is validated
   in module_checker (E2092), not here; dynamic child spawn in behavior still uses the same
   proc[concurrency] classification as Phase D.
   Phase F (§15.4.11.4, §15.4.13.4–§15.4.13.6): unwind reports go to the root FailureReporter via
   runtime-invoked handle_report; that path is independent of supervisor ingress and does not
   introduce a separate compile-time effect—implementations of region_dump_limit / handle_report
   are ordinary functions: declare proc[device_io], proc[concurrency], etc. only for what the
   body actually uses (stderr fallback when no reporter is runtime-only).
   Phase G (§15.4.8.4–§15.4.8.7): `link` / `monitor` / `demonitor`, linked-exit to supervisor
   ingress vs `DOWN` to standard mailbox, and cascading shutdown on supervisor death are all
   runtime routing and scheduling concerns. The effect checker still classifies `link`, `monitor`,
   and `demonitor` (and recv/cast/send for matching `DOWN` / messages) as proc[concurrency] only
   (§15.4.8.3 behavior-only rules for `link` / `spawn_linked` remain in the type checker as E2091;
   there is no separate `mailbox` or `ingress` effect in this layer).
   User-facing actor intrinsics (including spawn_linked, link, monitor, demonitor, call, cast,
   send, self, recv) are classified as proc[concurrency] here (is_builtin_fn / builtin_fn_effects).
   Note: user code cannot call recv today (§15.1.2; type checker), but recv is listed for parity
   with the actor-runtime surface and module_checker intrinsics.
-}

use parser_ast;
use lexer_core;

export effect_check_ok/0;
export effect_check_err/4;
export effects_equal/2;
export effect_list_contains/2;
export effect_list_length/1;
export effect_name_to_string/1;
export normalize_effect/1;
export empty_effect_entry_list/0;
export add_effect_entry/3;
export lookup_fn_effects/2;
export create_effect_context/4;
export effect_context_with_type_env/2;
export empty_type_entry_list/0;
export add_type_entry/3;
export lookup_type_entry/2;
export is_builtin_effect/1;
export is_empty_param/1;
export is_valid_mem_parameter/1;
export is_builtin_alias_name/1;
export is_builtin_fn/1;
export fn_effective_effects/1;
export expand_builtin_alias/1;
export builtin_fn_effects/1;

// --- Record constructors / env helpers (inline records + List; no named structs) ---

fn effect_check_ok() -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    result: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- {
        is_ok: true,
        error_code: "",
        error_location: parser_ast@zero_location(),
        error_message: "",
        spec_section: ""
    };
    result
}

fn effect_check_err(error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    result: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- {
        is_ok: false,
        error_code: error_code,
        error_location: error_location,
        error_message: error_message,
        spec_section: spec_section
    };
    result
}

fn empty_effect_entry_list() -> List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- empty[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]()
    produces
        pure result
    end
}

fn add_effect_entry(env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        entry: { name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { name: name, effects: effects };
        result: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- prepend[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)](entry, env)
    produces
        pure result
    end
}

fn lookup_fn_effects(env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], name: string) -> (boolean, List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) {
    sequence
        result: (boolean, List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- case env of {
            []: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] -> (false, parser_ast@empty_effect_name_list());
            [head: { name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, tail: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]] -> case head.name == name of {
                true -> (true, head.effects);
                false -> lookup_fn_effects(tail, name)
            };
            _: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] -> (false, parser_ast@empty_effect_name_list())
        }
    produces
        pure result
    end
}

fn create_effect_context(fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] } {
    sequence
        type_env_t: List[{ name: string, type_name: string }, mem(normal)] <- empty_type_entry_list();
        result: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] } <- {
            fn_env: fn_env,
            foreign_c_wrapper_env: foreign_c_wrapper_env,
            alias_env: alias_env,
            type_env: type_env_t,
            world: world
        }
    produces
        pure result
    end
}

fn effect_context_with_type_env(ctx: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] }, type_env: List[{ name: string, type_name: string }, mem(normal)]) -> { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] } {
    result: { fn_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], foreign_c_wrapper_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], alias_env: List[{ name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], type_env: List[{ name: string, type_name: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] } <- {
        fn_env: ctx.fn_env,
        foreign_c_wrapper_env: ctx.foreign_c_wrapper_env,
        alias_env: ctx.alias_env,
        type_env: type_env,
        world: ctx.world
    };
    result
