// Process-per-unit reclaim (order file, runtime marker, exit 75).

use main_lists;
use main_emit;
use main_crash;

export mark_needs_runtime_if/1;
export finish_batch_artifacts/0;
export after_unit_compiled/2;

fn mark_needs_runtime_if(needs: boolean) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        case needs of {
            false -> 0;
            true -> {
                _: boolean <- append_file(main_lists@needs_runtime_marker_path(), "1\n");
                0
            }
        }
        }
    produces
        pure result
    end
}

fn finish_batch_artifacts() -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        needs_rt: boolean <- file_exists(main_lists@needs_runtime_marker_path());
        _: int64 <- main_emit@maybe_write_runtime_assembly(needs_rt);
        delete_file(main_lists@compile_order_path());
        delete_file(main_lists@needs_runtime_marker_path());
        // Units the compiler crashed on (main_crash) make the batch fail even when the rest compiled.
        crashed: int64 <- main_crash@crashed_status();
        case crashed != 0 of {
            true -> crashed;
            false -> {
                println("Compilation complete.");
                0
            }
        }
        }
    produces
        pure result
    end
}

fn after_unit_compiled(rest: List[string, mem(normal)], unit_rt: boolean) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
            _: int64 <- mark_needs_runtime_if(unit_rt);
            case rest.is_nil of {
                true -> finish_batch_artifacts();
                false -> {
                    _: int64 <- main_lists@write_paths_file(main_lists@compile_order_path(), rest);
                    _: int8 <- println("Unit compiled; exiting to reclaim memory before next unit...");
                    main_lists@continue_exit_code()
                }
            }
        }
    produces
        pure result
    end
}
