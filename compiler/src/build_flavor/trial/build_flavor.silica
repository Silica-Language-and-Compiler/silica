// Build flavor of this compiler: TRIAL_BUILD (built with `make ... TRIAL_BUILD=1` in compiler/src).
//
// A trial build is the compiler the trials are compiled with: it also knows the trial-only builtins.
// It is never published as silica-compiler: its outputs are named with the TRIAL_BUILD_ prefix
// (compiler/build/TRIAL_BUILD_<TARGET>/TRIAL_BUILD_silica-compiler, and binaries/TRIAL_BUILD_silica-compiler
// or binaries/TRIAL_BUILD_silica-compiler-<TARGET> when it is installed). See build_flavor/normal/
// for how the flavor is chosen; both files export the same functions with the same types.

export trial_hooks_enabled/0;
export build_flavor_marker/0;

// True only in a trial build: supervision_ingress_enqueue is a builtin.
fn trial_hooks_enabled() -> boolean {
    true
}

// The line the compiler prints where it names itself (main_driver: run with no silica.config).
fn build_flavor_marker() -> string {
    "silica-compiler build flavor: TRIAL_BUILD (trial-only builtins enabled; never publish)"
}
