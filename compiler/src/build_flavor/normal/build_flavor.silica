// Build flavor of this compiler: NORMAL (every release, published and self-hosted build).
//
// compiler/src/Makefile chooses the flavor with one switch, TRIAL_BUILD (default 0). It passes
// `--flavor normal` or `--flavor trial` to topo_silica_config.sh, which makes exactly one of
// build_flavor/normal/build_flavor.silica and build_flavor/trial/build_flavor.silica a unit of the
// build (the same way only emitter/<TARGET>/ is a unit). Both files export the same functions with
// the same types, so no other unit depends on which one is linked. A trial build also writes its
// outputs under TRIAL_BUILD_-prefixed names (compiler/build/TRIAL_BUILD_<TARGET>/TRIAL_BUILD_silica-compiler).

export trial_hooks_enabled/0;
export build_flavor_marker/0;

// True only in a trial build. The trial-only builtins (supervision_ingress_enqueue) are known to the
// type checker, the effect checker and the SIR generator only when this is true; otherwise the name is
// an ordinary identifier (an unknown function, E2007, unless the program defines it), and the hosted
// runtimes do not contain its entry point.
fn trial_hooks_enabled() -> boolean {
    false
}

// The line the compiler prints where it names itself (main_driver: run with no silica.config).
fn build_flavor_marker() -> string {
    "silica-compiler build flavor: normal"
}
