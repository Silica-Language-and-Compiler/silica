// SIR→assembly for one unit (pipeline/sir/emitter kept off main).

use emitter_core;
use atom_table;
use build_output;
use module_checker_core;
use main_compile_pipeline;
use main_lists;

export maybe_write_runtime_assembly/1;
export compile_parsed_unit/6;

// The runtime module is written once, after every unit of the batch, from the build-wide atom table
// (silica.atoms is complete by then): the fixed runtime prefix first, so the indices the runtime text
// embeds are stable, then the program's atoms, which size the registries (item J). A runtime module
// already in the directory is rewritten whenever a unit was compiled, so an incremental build that
// adds atoms never leaves a registry sized by an older table.
fn maybe_write_runtime_assembly(any_needs_runtime: boolean) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        case any_needs_runtime or file_exists("__silica_runtime.sams") of {
            true -> {
                build_atoms: List[string, mem(normal)] <- main_lists@read_atom_file();
                seeded: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] } <- atom_table@build_runtime_atom_table(build_atoms);
                runtime_asm: string <- emitter_core@emit_actor_runtime_module_with_atom_table(seeded);
                build_output@write_runtime_assembly(runtime_asm)
            };
            false -> 0
        }
        }
    produces
        pure result
    end
}

fn announce_compiled_file(filename: string) -> int64 {
    sequence proc[DeviceIO]
        mod_name: string <- module_checker_core@module_from_path(filename);
        _: int8 <- println(concat("Finished compiling ", mod_name));
        result: int64 <- 0
    produces
        pure result
    end
}

fn filename_ends_with(path: string, suffix: string) -> boolean {
    ls: int64 <- length_bytes(path);
    lf: int64 <- length_bytes(suffix);
    case ls < lf of {
        true -> false;
        false -> substring(path, ls - lf, ls) == suffix
    }
}

fn debug_compile(filename: string) -> boolean {
    case filename_ends_with(filename, "dangerous_legacy_math.silica") of {
        true -> true;
        false -> case filename_ends_with(filename, "dangerous_legacy_math_meta.silica") of {
            true -> true;
            false -> filename_ends_with(filename, "dangerous_net.silica")
        }
    }
}

// Module-check, type-check, trait-check, effect-check, SIR, emit for one unit; module_world is other parsed units (spec §19).
fn compile_parsed_unit(filename: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, module_world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], config_files: List[string, mem(normal)], all_parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], specialized_all: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> (int64, boolean) {
    sequence proc[DeviceIO]
        (sir_code: int64, sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) <- main_compile_pipeline@compile_to_sir_module(filename, program, module_world, config_files, all_parsed, specialized_all);
        result: (int64, boolean) <- case sir_code != 0 of {
            true -> (sir_code, false);
            false -> {
                _: int8 <- println("  Emitting...");
                prior_atoms: List[string, mem(normal)] <- main_lists@read_atom_file();
                atoms: List[string, mem(normal)] <- case prior_atoms.is_nil of {
                    true -> prior_atoms;
                    false -> main_lists@append_list_string_hygiene(prior_atoms, main_lists@read_shape_file())
                };
                table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] } <- atom_table@build_atom_table_extending(atoms, sir_module);
                _: int64 <- main_lists@write_paths_file(main_lists@atom_file_path(), atom_table@atom_table_lexemes_in_order(table));
                _: int64 <- main_lists@write_paths_file(main_lists@shape_file_path(), atom_table@shape_lexemes_in_order(table));
                asm: string <- emitter_core@emit_module_with_atom_and_debug(sir_module, table, debug_compile(filename));
                _: int8 <- build_output@write_assembly(filename, asm);
                _: int64 <- main_compile_pipeline@publish_unit_iface(filename, program, config_files);
                _: int64 <- announce_compiled_file(filename);
                (0, emitter_core@module_needs_actor_runtime(sir_module))
            }
        }
    produces
        pure result
    end
}
