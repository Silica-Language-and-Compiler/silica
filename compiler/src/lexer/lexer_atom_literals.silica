// Atom literal parsing for Silica lexer
// Supports :atom_name with Unicode (emojis, accented chars, etc.)
// Atoms are functional programming symbols with no stored value; compared by identity
// Relational operators `<`, `>`, `<=`, `>=` are delimiters (is_atom_delimiter) so they never
// merge into an atom lexeme; the lexer emits those as separate tokens from lexer_operators.

// Import token kind
use lexer_token_kind;

// Import lexer core types
use lexer_core;

// Export functions for atom literal parsing
export is_atom_start_char/1;
export read_colon_or_atom_literal/1;


{-
- Returns true if the single-character string is a delimiter that ends an atom name: whitespace, operators, grouping, colon, or other punctuation per silica-specification §2.2.3 (including `@`, which ends atoms so `module@function(args)` tokenizes as identifier, at_sign, identifier, …).
- Used by is_atom_start_char and is_atom_char: any character not in this set is valid in an atom, enabling Unicode (emojis, accented letters, etc.).
- Example: is_atom_delimiter(" ") and is_atom_delimiter(":") return true; they end the atom.
- Example: is_atom_delimiter("a") and is_atom_delimiter("é") return false; letters (including Unicode) are valid in atoms.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match; no recursion or allocation.
- Last-date-modified: 2025-02-19
- Last-modified-by: Silica { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } Code Generator
-}
fn is_atom_delimiter(c: string) -> boolean {
    case c of {
        "" -> true;
        " " -> true;
        "\t" -> true;
        "\n" -> true;
        "\r" -> true;
        "(" -> true;
        ")" -> true;
        "{" -> true;
        "}" -> true;
        "[" -> true;
        "]" -> true;
        "," -> true;
        "+" -> true;
        "-" -> true;
        "*" -> true;
        "/" -> true;
        "%" -> true;
        "<" -> true;
        ">" -> true;
        "=" -> true;
        "!" -> true;
        ":" -> true;
        ";" -> true;
        "." -> true;
        "|" -> true;
        "&" -> true;
        "@" -> true;
        "#" -> true;
        "?" -> true;
        "~" -> true;
        "^" -> true;
        "`" -> true;
        "\\" -> true;
        _: string -> false
    }
}


{-
- Returns true if the single-character string is a valid start of an atom name: any character that is not a delimiter (whitespace, operators, grouping, etc.). Enables Unicode including emojis and accented characters.
- Used by the lexer to detect when ":" is followed by an atom literal (e.g. :ok, :🔥, :café).
- Example: is_atom_start_char("a") and is_atom_start_char("🔥") return true; ASCII and Unicode are valid.
- Example: is_atom_start_char(" ") and is_atom_start_char(":") return false; delimiters cannot start atom names.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match; no recursion or allocation.
- Last-date-modified: 2025-02-19
- Last-modified-by: Silica { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } Code Generator
-}
fn is_atom_start_char(c: string) -> boolean {
    // An ill-formed UTF-8 character ends the atom; the tokenizer reports it.
    case is_atom_delimiter(c) of {
        true -> false;
        false -> lexer_core@utf8_char_is_valid(c)
    }
}


{-
- Returns true if the single-character string is valid inside an atom name: any character that is not a delimiter. Enables Unicode including emojis and accented characters.
- Used when scanning the body of an atom after the first character.
- Example: is_atom_char("a") and is_atom_char("9") return true; letters and digits are allowed.
- Example: is_atom_char("🔥") returns true; emojis and other Unicode are valid in atoms.
- Example: is_atom_char(":") and is_atom_char(" ") return false; colon and spaces end the atom.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match; no recursion or allocation.
- Last-date-modified: 2025-02-19
- Last-modified-by: Silica { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } Code Generator
-}
fn is_atom_char(c: string) -> boolean {
    // An ill-formed UTF-8 character ends the atom; the tokenizer reports it.
    case is_atom_delimiter(c) of {
        true -> false;
        false -> lexer_core@utf8_char_is_valid(c)
    }
}

fn char_at_offset(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, offset: int64) -> string {
    pos: int64 <- lexer.position + offset;
    case pos >= length_bytes(lexer.source) of {
        true -> "";
        false -> substring(lexer.source, pos, pos + 1)
    }
}

fn colon_followed_by_word(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, word: string) -> boolean {
    start: int64 <- lexer.position + 1;
    end_pos: int64 <- start + length_bytes(word);
    case end_pos > length_bytes(lexer.source) of {
        true -> false;
        false -> case substring(lexer.source, start, end_pos) == word of {
            false -> false;
            true -> is_atom_delimiter(char_at_offset(lexer, 1 + length_bytes(word)))
        }
    }
}

fn colon_followed_by_bitwise_keyword(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> boolean {
    colon_followed_by_word(lexer, "bor")
        or colon_followed_by_word(lexer, "band")
        or colon_followed_by_word(lexer, "bnot")
        or colon_followed_by_word(lexer, "shl")
        or colon_followed_by_word(lexer, "shr")
}


{-
- Consumes zero or more atom name characters (letters, digits, underscores) from the lexer, appends them to the given lexeme, and returns the atom_literal token and the lexer at the first non-atom character or EOF.
- Used by read_atom_literal after ":" and the first atom character: pass the lexer past ":" and the first char, start_location at the start of ":...", and lexeme ":x" (for example); read_atom_chars consumes the rest and returns the complete token.
- Example: lexer at "k" of ":ok" with lexeme ":" — consumes "o" then "k", returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } atom_literal ":ok", lexer past "k").
- Example: lexer at "r" of ":error" with lexeme ":" — consumes "e","r","r","o","r", returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } atom_literal ":error", lexer past "r").
- Time: O(k), Ω(1), Θ(k) where k is the number of atom characters. Space: O(k), Ω(1), Θ(k) for recursion and lexeme.
- Last-date-modified: 2025-02-19
- Last-modified-by: Silica { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } Code Generator
-}
fn read_atom_chars(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }, lexeme: string) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
        next: string <- lexer_core@peek_char(lexer);
    case next of {
        "" -> (lexer_core@make_token(lexer_token_kind@token_kind_atom_literal(), lexeme, start_location), lexer);
        _: string -> case is_atom_char(next) of {
            true -> {
                updated_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                updated_lexeme: string <- concat(lexeme, next);
                read_atom_chars(updated_lexer, start_location, updated_lexeme)
            };
            false -> (lexer_core@make_token(lexer_token_kind@token_kind_atom_literal(), lexeme, start_location), lexer)
        }
    }
}


{-
- When the lexer is at ":" followed by an atom start character (lowercase letter or underscore), consumes ":" and the full atom name, and returns the atom_literal token with lexeme (e.g. ":ok") and the updated lexer.
- Used as the inner path when read_colon_or_atom_literal has confirmed ":" and atom start. Advances past ":", then past the first atom char, then read_atom_chars consumes the rest.
- Example: lexer at ":" of ":ok" — advances past ":", first char "o" is atom start, read_atom_chars consumes "o","k"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } atom_literal ":ok", lexer past "k").
- Example: lexer at ":" of ":_private" — advances past ":", first char "_" is atom start, read_atom_chars consumes "_","p","r","i","v","a","t","e"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } atom_literal ":_private", lexer past "e").
- Time: O(k), Ω(1), Θ(k) where k is the length of the atom. Space: O(k), Ω(1), Θ(k).
- Last-date-modified: 2025-02-19
- Last-modified-by: Silica { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } Code Generator
-}
fn read_atom_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    after_colon: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
    first_char: string <- lexer_core@peek_char(after_colon);
    case first_char of {
        "" -> {
                        (lexer_core@make_token(lexer_token_kind@token_kind_atom_literal(), ":", start_location), after_colon)
        };
        _: string -> case is_atom_start_char(first_char) of {
            true -> {
                after_first: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(after_colon);
                lexeme_so_far: string <- concat(":", first_char);
                read_atom_chars(after_first, start_location, lexeme_so_far)
            };
            false -> {
                                (lexer_core@make_token(lexer_token_kind@token_kind_colon(), ":", start_location), after_colon)
            }
        }
    }
}


{-
- When the lexer is at ":", either reads `::` (double colon, per silica-spec §2.2.4), an atom literal (if followed by atom start character), or a standalone colon token (for type annotations). Dispatches to read_atom_literal for the full logic.
- Entry point for ":" tokenization: the lexer calls this when peek_char is ":". If peek_next is ":", emits double_colon. Else if next is atom start, reads full atom. Otherwise emits colon for type annotations like "x: int64" or `]: List[int64]`.
- Example: lexer at ":" of ":ok" — next is "o" (atom start), read_atom_literal consumes ":ok"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } atom_literal ":ok", lexer past "k").
- Example: lexer at ":" of "x: int64" — next is " " (not atom start), read_atom_literal emits colon and advances; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } colon ":", lexer past ":").
- Time: O(1) for colon, O(k) for atom. Space: O(1) for colon, O(k) for atom.
- Last-date-modified: 2025-02-19
- Last-modified-by: Silica { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } Code Generator
-}
fn read_colon_or_atom_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    start_location: { file: string, line: int64, column: int64, offset: int64 } <- lexer_core@current_location(lexer);
    first: string <- lexer_core@peek_char(lexer);
    case first of {
        ":" -> {
            second: string <- lexer_core@peek_next_char(lexer);
            case second of {
                ":" -> {
                                        after_double: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer_core@advance(lexer));
                    (lexer_core@make_token(lexer_token_kind@token_kind_double_colon(), "::", start_location), after_double)
                };
                "" -> {
                                        updated_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                    (lexer_core@make_token(lexer_token_kind@token_kind_colon(), ":", start_location), updated_lexer)
                };
                _: string -> case colon_followed_by_bitwise_keyword(lexer) of {
                    true -> {
                                                updated_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                        (lexer_core@make_token(lexer_token_kind@token_kind_colon(), ":", start_location), updated_lexer)
                    };
                    false -> case is_atom_start_char(second) of {
                        true -> read_atom_literal(lexer, start_location);
                        false -> {
                                                        updated_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                            (lexer_core@make_token(lexer_token_kind@token_kind_colon(), ":", start_location), updated_lexer)
                        }
                    }
                }
            }
        };
        _: string -> {
                        (lexer_core@make_token(lexer_token_kind@token_kind_eof(), "", start_location), lexer)
        }
    }
}
