{- True for actor scheduling / topology runtime helpers (silica-spec §15.2, appendix CPU affinity).
   Parser initial_roles treats these like spawn/send: call target then operand. -}
fn is_actor_runtime_helper_kind(token_kind: int64) -> boolean {
    token_kind == token_kind_pin_actor_to_core_keyword() or token_kind == token_kind_pin_actor_to_efficiency_core_keyword() or token_kind == token_kind_pin_actor_to_performance_core_keyword() or token_kind == token_kind_pin_actor_realtime_keyword() or token_kind == token_kind_unpin_actor_keyword() or token_kind == token_kind_remove_actor_keyword() or token_kind == token_kind_register_actor_keyword() or token_kind == token_kind_set_actor_priority_keyword() or token_kind == token_kind_pin_actor_to_numa_node_keyword() or token_kind == token_kind_get_cpu_topology_keyword() or token_kind == token_kind_get_efficiency_cores_keyword() or token_kind == token_kind_get_performance_cores_keyword() or token_kind == token_kind_get_core_capabilities_keyword()
}

{- True if token can start an effect in proc[effect, ...] (silica-spec §9.2.1).
   mem(...) uses mem_keyword; bare built-ins may be lexed as dedicated keywords (device_io, concurrency, …), not identifiers. -}
fn is_proc_list_effect_head_token(token_kind: int64) -> boolean {
    is_identifier_lexeme_token(token_kind) or token_kind == token_kind_mem_keyword() or token_kind == token_kind_device_io_keyword() or token_kind == token_kind_concurrency_keyword() or token_kind == token_kind_mailbox_keyword() or token_kind == token_kind_atomic_keyword() or token_kind == token_kind_external_danger_keyword()
}

fn is_negate_builtin_kind(token_kind: int64) -> boolean {
    token_kind == token_kind_negate_int8_keyword() or token_kind == token_kind_negate_int16_keyword() or token_kind == token_kind_negate_int32_keyword() or token_kind == token_kind_negate_int64_keyword() or token_kind == token_kind_negate_float16_keyword() or token_kind == token_kind_negate_float32_keyword() or token_kind == token_kind_negate_float64_keyword()
}

fn is_identifier_lexeme_token(token_kind: int64) -> boolean {
    token_kind == token_kind_identifier() or is_negate_builtin_kind(token_kind)
}
