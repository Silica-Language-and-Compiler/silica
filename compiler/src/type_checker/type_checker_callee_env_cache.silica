// Callee-env cache: a named stateful actor (registered as :callee_env_cache in the PID
// registry) that remembers, per callee module id, the env entries produced by
// type_checker_callee_env@add_all_declarations_with_world on a FRESH context.
//
// Why: check_callsite_body_with_concrete_params rebuilt the callee module's whole env
// (every declaration + every import) on every user call site and then discarded it. That
// rebuild was the #1 allocator when type-checking emitter_core (10.5 GB / 270M allocs).
//
// Message shape: see cache_beh. What is cached: the env entries minus their type ids (type ids belong to the interner of
// the fresh context they were built in). On a hit the entries are replayed, oldest first,
// into a new fresh context with the same helper each was originally added with (interned
// surface / uninterned surface / effect alias), so the rebuilt context is equivalent to what
// the full walk would have produced. The interner never enters the actor.
//
// The actor is spawned lazily on first use with spawn_registered(init, beh, :callee_env_cache) and
// reached with call_registered(:callee_env_cache, msg); every unit compile is its own process under
// the exit-75 reclaim loop, so the cache never outlives a unit. Actor traffic stays inside
// sequence ... produces pure ... end so callers remain ordinary pure functions.

use type_checker_core;
use type_checker_callee_env;
use type_interner;

export callee_context_cached/4;

fn empty_entries() -> List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] <- empty[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)]()
    produces
        pure r
    end
}

fn cons_entry(e: { name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, acc: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)]) -> List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] <- prepend[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)](e, acc)
    produces
        pure r
    end
}

// env lists are newest-first; prepending while walking yields oldest-first, the replay order.
fn entries_from_env(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], acc: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)]) -> List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] {
    case env.is_nil of {
        true -> acc;
        false -> {
            ent: { name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string } <- { name: env.head.name, surface_type: env.head.surface_type, declared_effects: env.head.declared_effects, is_effect_alias: env.head.is_effect_alias, interned: env.head.type_id != type_interner@invalid_type_id(), source_module: env.head.source_module };
            entries_from_env(env.tail, cons_entry(ent, acc))
        }
    }
}

fn replay_entries(entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)], ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } {
    case entries.is_nil of {
        true -> ctx;
        false -> {
            next: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- case entries.head.is_effect_alias of {
                true -> type_checker_core@type_context_with_env(ctx, type_checker_core@add_effect_alias_symbol(ctx.env, entries.head.name, entries.head.declared_effects));
                false -> case entries.head.interned of {
                    true -> type_checker_core@context_add_symbol_surface(ctx, entries.head.name, entries.head.surface_type, entries.head.declared_effects, entries.head.source_module);
                    false -> type_checker_core@context_add_symbol_uninterned(ctx, entries.head.name, entries.head.surface_type, entries.head.declared_effects, entries.head.source_module)
                }
            };
            replay_entries(entries.tail, next)
        }
    }
}

fn find_entries(state: List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)], mod_id: string) -> List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] {
    case state.is_nil of {
        true -> empty_entries();
        false -> case state.head.mod_id == mod_id of {
            true -> state.head.entries;
            false -> find_entries(state.tail, mod_id)
        }
    }
}

fn cons_slot(mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)], state: List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)]) -> List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)] <- prepend[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)]({ mod_id: mod_id, entries: entries }, state)
    produces
        pure r
    end
}

// Protocol: the message IS a List[entry]. Its head is a control entry (name = module id,
// surface_type = "lookup" | "store"); its tail = the entries to store. Reply = entries, nil = miss.
// A record message with a List-typed state is a parameter shape the seed still miscompiles
// (its aggregate first-param shadow register collides with the reply buffer), and the body is one
// tuple make with helper calls rather than a case at the tail; both keep the seed on a path that
// trials/actors_addition exercises.
fn control_entry(mod_id: string, op: string) -> { name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string } {
    sequence proc[mem(normal)]
        eff: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- empty[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]()
    produces
        pure { name: mod_id, surface_type: op, declared_effects: eff, is_effect_alias: false, interned: false, source_module: "" }
    end
}

fn reply_for(msg: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)], state: List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)]) -> List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] {
    case msg.is_nil of {
        true -> empty_entries();
        false -> case msg.head.surface_type == "store" of {
            true -> msg.tail;
            false -> find_entries(state, msg.head.name)
        }
    }
}

fn next_state(msg: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)], state: List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)]) -> List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)] {
    case msg.is_nil of {
        true -> state;
        false -> case msg.head.surface_type == "store" of {
            true -> cons_slot(msg.head.name, msg.tail, state);
            false -> state
        }
    }
}

fn cache_beh(msg: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)], state: List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)]) -> (:reply, List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)], List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)]) {
    (:reply, reply_for(msg, state), next_state(msg, state))
}

fn spawn_cache() -> actor_ref {
    sequence proc[concurrency, mem(normal)]
        init: List[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)] <- empty[{ mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] }, mem(normal)]();
        w: actor_ref <- spawn_registered(init, cache_beh, :callee_env_cache, stack_policy(0, :keep_high_water))
    produces
        pure w
    end
}

fn ensure_cache() -> boolean {
    sequence proc[concurrency]
        reg: actor_ref <- get_pid_registry();
        lr: (atom, actor_ref) <- call(reg, { op: :lookup, name: :callee_env_cache, pid: reg } impl ActorMessage {});
        (st: atom, _found: actor_ref) <- lr;
        ok: boolean <- case st of {
            :found -> true;
            _: atom -> {
                _w: actor_ref <- spawn_cache();
                true
            }
        }
    produces
        pure ok
    end
}

fn lookup_entries(mod_id: string) -> List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] {
    sequence proc[concurrency]
        _ready: boolean <- ensure_cache();
        ctl: { name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string } <- control_entry(mod_id, "lookup");
        msg: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] <- cons_entry(ctl, empty_entries());
        r: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] <- call_registered(:callee_env_cache, msg impl ActorMessage {})
    produces
        pure r
    end
}

fn store_entries(mod_id: string, entries: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)]) -> boolean {
    sequence proc[concurrency]
        _ready: boolean <- ensure_cache();
        ctl: { name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string } <- control_entry(mod_id, "store");
        msg: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] <- cons_entry(ctl, entries);
        stored: List[{ name: string, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, interned: boolean, source_module: string }, mem(normal)] <- call_registered(:callee_env_cache, msg impl ActorMessage {})
    produces
        pure stored.is_nil == false or entries.is_nil
    end
}


// Drop-in for add_all_declarations_with_world(decls, decls, <empty env>, world, mod) as used per call
// site. Miss: run the full walk and remember its env. Hit: replay. The callee context starts with an
// EMPTY env but the CALLER's interner: every signature the caller imported is already interned there,
// so replaying a cached env hits parse_type's surface memo instead of re-stripping and re-parsing
// every export into a fresh interner (that re-parse filled ~2.7 GB of string arena on emitter_core).
