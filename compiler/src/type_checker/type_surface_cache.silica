// Type-surface strip cache: a named stateful actor (registered as :type_surface_cache) that
// remembers, process-wide, the space-stripped form of every type surface the interner has
// stripped. The interner's own memo lives in the interner record, which the type checker
// discards at 133 sites, so the same 10 KB annotation was stripped again and again (927x for
// the SIR-term record on emitter_core); every strip writes into the never-released string arena.
// State: { count, index: raw surface -> slot, texts: stripped texts newest-first }.
// A store sends a two-element List[string]; a lookup a one-element list; reply is the
// stripped text, "" = miss. The message list is always bound to a name before the call:
// the seed miscompiles call/call_registered when the message argument is a call expression
// (the reply comes back null; with spawn/call the actor ref is clobbered) -- trials
// scratchpad tsc_trial t6a/t7a/t7c, 2026-09-10.

use wbt_map;
use OrderedMap;

export stripped_for/1;
export remember_stripped/2;

fn cmp_key(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn cmp_val(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn fresh_state() -> { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] } {
    sequence proc[mem(normal)]
        m: OrderedMap[string, int64, mem(normal)] <- wbt_map@empty({ compare_key: cmp_key, compare_value: cmp_val });
        t: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure { count: 0, index: m, texts: t }
    end
}

fn text_at(state: { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] }, slot: int64) -> string {
    case slot < 0 or slot >= state.count of {
        true -> "";
        false -> list_nth(state.texts, state.count - 1 - slot)
    }
}

fn lookup_in(state: { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] }, raw: string) -> string {
    sequence
        g: { status: :not_found | :found, value: int64 } <- OrderedMap@get(state.index, raw, 0);
        r: string <- case g.status of {
            :found -> text_at(state, g.value);
            :not_found -> ""
        }
    produces
        pure r
    end
}

fn store_in(state: { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] }, raw: string, stripped: string) -> { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] } {
    sequence
        g: { status: :not_found | :found, value: int64 } <- OrderedMap@get(state.index, raw, 0);
        out: { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] } <- case g.status of {
            :found -> state;
            :not_found -> {
                sequence proc[mem(normal)]
                    r: { map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, inserted: boolean, replaced: boolean } <- wbt_map@insert(state.index, raw, state.count);
                    t: List[string, mem(normal)] <- prepend[string, mem(normal)](stripped, state.texts)
                produces
                    pure { count: state.count + 1, index: r.map, texts: t }
                end
            }
        }
    produces
        pure out
    end
}

// Message: List[string]. [raw] = lookup; [raw, stripped] = store (reply echoes stripped).
// The behaviour body is a single tuple make: the seed miscompiles a case at the tail of a
// behaviour (see the callee-env cache); reply_for/next_state hold the per-message logic.
fn reply_for(msg: List[string, mem(normal)], state: { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] }) -> string {
    case msg.is_nil of {
        true -> "";
        false -> case msg.tail.is_nil of {
            true -> lookup_in(state, msg.head);
            false -> msg.tail.head
        }
    }
}

fn next_state(msg: List[string, mem(normal)], state: { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] }) -> { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] } {
    case msg.is_nil of {
        true -> state;
        false -> case msg.tail.is_nil of {
            true -> state;
            false -> store_in(state, msg.head, msg.tail.head)
        }
    }
}

fn cache_beh(msg: List[string, mem(normal)], state: { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] }) -> (:reply, string, { count: int64, index: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, texts: List[string, mem(normal)] }) {
    (:reply, reply_for(msg, state), next_state(msg, state))
}

fn spawn_cache() -> actor_ref {
    sequence proc[concurrency]
        w: actor_ref <- spawn_registered(fresh_state(), cache_beh, :type_surface_cache, stack_policy(0, :keep_high_water))
    produces
        pure w
    end
}

fn ensure_cache() -> boolean {
    sequence proc[concurrency]
        reg: actor_ref <- get_pid_registry();
        lr: (atom, actor_ref) <- call(reg, { op: :lookup, name: :type_surface_cache, pid: reg } impl ActorMessage {});
        (st: atom, _found: actor_ref) <- lr;
        ok: boolean <- case st of {
            :found -> true;
            _: atom -> {
                _w: actor_ref <- spawn_cache();
                true
            }
        }
    produces
        pure ok
    end
}

fn one(s: string) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[string, mem(normal)] <- empty[string, mem(normal)]();
        r: List[string, mem(normal)] <- prepend[string, mem(normal)](s, e)
    produces
        pure r
    end
}

fn two(a: string, b: string) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[string, mem(normal)] <- prepend[string, mem(normal)](a, one(b))
    produces
        pure r
    end
}

// Stripped text for `raw`, or "" when not cached.
fn stripped_for(raw: string) -> string {
    sequence proc[concurrency]
        _ready: boolean <- ensure_cache();
        m1: List[string, mem(normal)] <- one(raw);
        r: string <- call_registered(:type_surface_cache, m1 impl ActorMessage {})
    produces
        pure r
    end
}

fn remember_stripped(raw: string, stripped: string) -> string {
    sequence proc[concurrency]
        _ready: boolean <- ensure_cache();
        m2: List[string, mem(normal)] <- two(raw, stripped);
        r: string <- call_registered(:type_surface_cache, m2 impl ActorMessage {})
    produces
        pure r
    end
}
