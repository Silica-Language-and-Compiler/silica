    type_interner_nodes@nodes_at(interner.nodes, idx)
}

fn list_int_at_dag(xs: List[int64, mem(normal)], i: int64) -> int64 {
    case xs.is_nil of {
        true -> 0 - 1;
        false -> case i <= 0 of {
            true -> xs.head;
            false -> list_int_at_dag(xs.tail, i - 1)
        }
    }
}

fn list_int_append_dag(xs: List[int64, mem(normal)], v: int64) -> List[int64, mem(normal)] {
    case xs.is_nil of {
        true -> {
            sequence proc[mem(normal)]
                result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](v, type_interner_core@empty_int_list())
            produces
                pure result
            end
        };
        false -> {
            sequence proc[mem(normal)]
                rest: List[int64, mem(normal)] <- list_int_append_dag(xs.tail, v);
                result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](xs.head, rest)
            produces
                pure result
            end
        }
    }
}

fn remap_dag_id(remap: List[int64, mem(normal)], old_id: int64) -> int64 {
    case old_id < 0 of {
        true -> old_id;
        false -> list_int_at_dag(remap, old_id)
    }
}

fn remap_dag_arg(role: int64, value: int64, type_remap: List[int64, mem(normal)], name_remap: List[int64, mem(normal)]) -> int64 {
    case role of {
        1 -> remap_dag_id(type_remap, value);
        2 -> remap_dag_id(name_remap, value);
        _: int64 -> value
    }
}

fn intern_dag_names_loop(
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    names: List[string, mem(normal)],
    remap: List[int64, mem(normal)]
) -> {
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    remap: List[int64, mem(normal)]
} {
    case names.is_nil of {
        true -> { interner: interner, remap: remap };
        false -> {
            nr: { interner: {
                nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
                by_key: {
                    root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                },
                names: {
                    root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                },
                name_lexemes: List[string, mem(normal)],
                next_id: int64,
                seq_nil_id: int64
            }, id: int64 } <- type_interner_core@intern_name(interner, names.head);
            intern_dag_names_loop(nr.interner, names.tail, list_int_append_dag(remap, nr.id))
        }
    }
}

fn intern_dag_nodes_loop(
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    type_remap: List[int64, mem(normal)],
    name_remap: List[int64, mem(normal)]
) -> {
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    remap: List[int64, mem(normal)]
} {
    case nodes.is_nil of {
        true -> { interner: interner, remap: type_remap };
        false -> {
            n: { kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean } <- nodes.head;
            a2: int64 <- remap_dag_arg(type_interner_kinds@dag_arg_role(n.kind, 0, n.buf_size_is_name), n.arg_a, type_remap, name_remap);
            b2: int64 <- remap_dag_arg(type_interner_kinds@dag_arg_role(n.kind, 1, n.buf_size_is_name), n.arg_b, type_remap, name_remap);
            c2: int64 <- remap_dag_arg(type_interner_kinds@dag_arg_role(n.kind, 2, n.buf_size_is_name), n.arg_c, type_remap, name_remap);
            kr: { interner: {
                nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
                by_key: {
                    root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                },
                names: {
                    root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                },
                name_lexemes: List[string, mem(normal)],
                next_id: int64,
                seq_nil_id: int64
            }, id: int64 } <- type_interner_core@intern_key(interner, n.kind, a2, b2, c2, n.buf_size_is_name);
            intern_dag_nodes_loop(kr.interner, nodes.tail, list_int_append_dag(type_remap, kr.id), name_remap)
        }
    }
}

fn replay_type_dag(
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    names: List[string, mem(normal)],
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)]
) -> {
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    remap: List[int64, mem(normal)]
} {
    nr: {
        interner: {
            nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
            by_key: {
                root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(string, string) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            names: {
                root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
                compare_key: fn(string, string) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            name_lexemes: List[string, mem(normal)],
            next_id: int64,
            seq_nil_id: int64
        },
        remap: List[int64, mem(normal)]
    } <- intern_dag_names_loop(interner, names, type_interner_core@empty_int_list());
    intern_dag_nodes_loop(nr.interner, nodes, type_interner_core@empty_int_list(), nr.remap)
}
