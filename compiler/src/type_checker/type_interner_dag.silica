// Phase 4 iface type-DAG persist / rematerialize: the interner_dag_* readers, replay_type_dag
// and remap_dag_id. Split from type_interner.silica; the interner itself is in type_interner_core.

use type_interner_kinds;
use type_interner_nodes;
use type_interner_core;

export interner_dag_names/1;
export interner_dag_nodes/1;
export interner_dag_name_count/1;
export interner_dag_node_count/1;
export interner_dag_name_at/2;
export interner_dag_node_at/2;
export replay_type_dag/3;
export remap_dag_id/2;

// --- Phase 4 iface type-DAG persist / rematerialize ---

fn interner_dag_names(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}) -> List[string, mem(normal)] {
    interner.name_lexemes
}

