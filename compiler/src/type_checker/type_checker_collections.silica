    }
}

fn collection_return_accepts_tree(decl_type: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (ok: boolean, item: string, _: string) <- parse_tree_type(decl_type);
    case ok of {
        false -> false;
        true -> record_field_fn_witnesses_item_with_world(return_type, "compare_item", item, world)
    }
}

fn collection_return_accepts_binary_tree(decl_type: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (ok: boolean, item: string, _: string) <- parse_binary_tree_type(decl_type);
    case ok of {
        false -> false;
        true -> record_field_fn_witnesses_item_with_world(return_type, "compare_item", item, world)
    }
}

fn collection_return_accepts_undirected_graph(decl_type: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (ok: boolean, node: string, edge_data: string, _: string) <- parse_undirected_graph_type(decl_type);
    case ok of {
        false -> false;
        true -> record_field_fn_witnesses_item_with_world(return_type, "compare_node", node, world)
            and record_field_fn_witnesses_item_with_world(return_type, "compare_edge_data", edge_data, world)
    }
}

fn collection_return_accepts_weighted_graph(decl_type: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (ok: boolean, node: string, edge_data: string, weight: string, _: string) <- parse_weighted_graph_type(decl_type);
    case ok of {
        false -> false;
        true -> record_field_fn_witnesses_item_with_world(return_type, "compare_node", node, world)
            and record_field_fn_witnesses_item_with_world(return_type, "compare_edge_data", edge_data, world)
            and record_field_fn_witnesses_edge_target_with_world(return_type, "edge_weight", edge_data, weight, world)
            and record_field_fn_witnesses_item_with_world(return_type, "compare_weight", weight, world)
    }
}

fn collection_return_accepts_priority_queue(decl_type: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (ok: boolean, priority: string, item: string, _: string) <- parse_priority_queue_type(decl_type);
    case ok of {
        false -> false;
        true -> record_field_fn_witnesses_item_with_world(return_type, "compare_priority", priority, world)
            and record_field_fn_witnesses_item_with_world(return_type, "compare_item", item, world)
    }
}

fn collection_return_accepts_directed_graph(decl_type: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (ok: boolean, node: string, edge: string, _: string) <- parse_directed_graph_type(decl_type);
    case ok of {
        false -> false;
        true -> record_field_fn_witnesses_item_with_world(return_type, "compare_node", node, world)
            and record_field_fn_witnesses_item_with_world(return_type, "compare_edge", edge, world)
            and record_field_fn_witnesses_edge_target_with_world(return_type, "edge_target", edge, node, world)
    }
}

fn record_field_fn_witnesses_edge_target_with_world(record_type: string, field: string, edge_type: string, node_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    ft: string <- type_checker_record_types@find_field_type_in_record(record_type, field);
    case length_bytes(ft) == 0 of {
        true -> false;
        false -> {
            expected: string <- expected_edge_target_fn_type(edge_type, node_type);
            fn_type_witnesses_edge_target(ft, edge_type, node_type)
                or type_checker_lists@formal_type_accepts_actual(expected, ft, world)
                or type_checker_lists@formal_type_accepts_actual(ft, expected, world)
        }
    }
}

fn collection_return_accepts_constructor(decl_type: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    case is_ordered_set_type(decl_type) of {
        true -> collection_return_accepts_ordered_set(decl_type, return_type, world);
        false -> case is_ordered_map_type(decl_type) of {
            true -> collection_return_accepts_ordered_map(decl_type, return_type, world);
            false -> case is_heap_type(decl_type) of {
                true -> collection_return_accepts_heap(decl_type, return_type, world);
                false -> case is_search_tree_type(decl_type) of {
                    true -> collection_return_accepts_search_tree(decl_type, return_type, world);
                    false -> case is_tree_type(decl_type) of {
                        true -> collection_return_accepts_tree(decl_type, return_type, world);
                        false -> case is_priority_queue_type(decl_type) of {
                            true -> collection_return_accepts_priority_queue(decl_type, return_type, world);
                            false -> case is_directed_graph_type(decl_type) of {
                                true -> collection_return_accepts_directed_graph(decl_type, return_type, world);
                                false -> case is_undirected_graph_type(decl_type) of {
                                    true -> collection_return_accepts_undirected_graph(decl_type, return_type, world);
                                    false -> case is_weighted_graph_type(decl_type) of {
                                        true -> collection_return_accepts_weighted_graph(decl_type, return_type, world);
                                        false -> case is_binary_tree_type(decl_type) of {
                                            true -> collection_return_accepts_binary_tree(decl_type, return_type, world);
                                            false -> false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn collection_type_fits_concrete_record(collection_type: string, record_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    collection_return_accepts_constructor(collection_type, record_type, world)
}

fn collection_type_fits_impl_parameter(collection_type: string, impl_param: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    case collection_type_fits_concrete_record(collection_type, impl_param, world) of {
        true -> true;
        false -> type_checker_lists@formal_type_accepts_actual(impl_param, collection_type, world)
    }
}

fn collection_param_type_for_trait_arg(collection_type: string, arg_index: int64) -> string {
    case is_ordered_set_type(collection_type) of {
        true -> {
            (ok: boolean, item: string, _: string) <- parse_ordered_set_type(collection_type);
            case ok of { true -> item; false -> "" }
        };
        false -> case is_ordered_map_type(collection_type) of {
            true -> case arg_index of {
                1 -> {
                    (ok: boolean, key: string, _: string, _: string) <- parse_ordered_map_type(collection_type);
                    case ok of { true -> key; false -> "" }
                };
                2 -> {
                    (ok: boolean, _: string, value: string, _: string) <- parse_ordered_map_type(collection_type);
                    case ok of { true -> value; false -> "" }
                };
                _: int64 -> ""
            };
            false -> case is_heap_type(collection_type) of {
                true -> {
                    (ok: boolean, item: string, _: string) <- parse_heap_type(collection_type);
                    case ok of { true -> item; false -> "" }
                };
                false -> case is_directed_graph_type(collection_type) of {
                    true -> case arg_index of {
                        1 -> {
                            (ok: boolean, node: string, _: string, _: string) <- parse_directed_graph_type(collection_type);
                            case ok of { true -> node; false -> "" }
                        };
                        2 -> {
                            (ok: boolean, _: string, edge: string, _: string) <- parse_directed_graph_type(collection_type);
                            case ok of { true -> edge; false -> "" }
                        };
                        _: int64 -> ""
                    };
                    false -> case is_search_tree_type(collection_type) or is_tree_type(collection_type) or is_heap_type(collection_type) of {
                        true -> {
                            (ok: boolean, item: string, _: string) <- case is_heap_type(collection_type) of {
                                true -> parse_heap_type(collection_type);
                                false -> case is_tree_type(collection_type) of {
                                    true -> parse_tree_type(collection_type);
                                    false -> parse_search_tree_type(collection_type)
                                }
                            };
                            case ok of { true -> item; false -> "" }
                        };
                        false -> case is_undirected_graph_type(collection_type) of {
                            true -> case arg_index of {
                                1 -> {
                                    (ok: boolean, node: string, _: string, _: string) <- parse_undirected_graph_type(collection_type);
                                    case ok of { true -> node; false -> "" }
                                };
                                2 -> {
                                    (ok: boolean, _: string, edge_data: string, _: string) <- parse_undirected_graph_type(collection_type);
                                    case ok of { true -> edge_data; false -> "" }
                                };
                                _: int64 -> ""
                            };
                            false -> case is_weighted_graph_type(collection_type) of {
                                true -> case arg_index of {
                                    1 -> {
                                        (ok: boolean, node: string, _: string, _: string, _: string) <- parse_weighted_graph_type(collection_type);
                                        case ok of { true -> node; false -> "" }
                                    };
                                    2 -> {
                                        (ok: boolean, _: string, edge_data: string, _: string, _: string) <- parse_weighted_graph_type(collection_type);
                                        case ok of { true -> edge_data; false -> "" }
                                    };
                                    3 -> {
                                        (ok: boolean, _: string, _: string, weight: string, _: string) <- parse_weighted_graph_type(collection_type);
                                        case ok of { true -> weight; false -> "" }
                                    };
                                    _: int64 -> ""
                                };
                                false -> case is_priority_queue_type(collection_type) of {
                                    true -> case arg_index of {
                                        1 -> {
                                            (ok: boolean, priority: string, _: string, _: string) <- parse_priority_queue_type(collection_type);
                                            case ok of { true -> priority; false -> "" }
                                        };
                                        2 -> {
                                            (ok: boolean, _: string, item: string, _: string) <- parse_priority_queue_type(collection_type);
                                            case ok of { true -> item; false -> "" }
                                        };
                                        _: int64 -> ""
                                    };
                                    false -> case is_binary_tree_type(collection_type) of {
                                        true -> {
                                            (ok: boolean, item: string, _: string) <- parse_binary_tree_type(collection_type);
                                            case ok of { true -> item; false -> "" }
                                        };
                                        false -> ""
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn is_assoc_type_placeholder(t: string) -> boolean {
    // parse_type's name->kind table is the single authority; see type_interner.
    type_interner@is_placeholder_surface(strip_spaces_col(t))
}

fn collection_space_from_type(collection_type: string) -> string {
    case is_ordered_set_type(collection_type) of {
        true -> {
            (ok: boolean, _: string, space: string) <- parse_ordered_set_type(collection_type);
            case ok of { true -> space; false -> "" }
        };
        false -> case is_ordered_map_type(collection_type) of {
            true -> {
                (ok: boolean, _: string, _: string, space: string) <- parse_ordered_map_type(collection_type);
                case ok of { true -> space; false -> "" }
            };
            false -> case is_heap_type(collection_type) of {
                true -> {
                    (ok: boolean, _: string, space: string) <- parse_heap_type(collection_type);
                    case ok of { true -> space; false -> "" }
                };
                false -> case is_directed_graph_type(collection_type) of {
                    true -> {
                        (ok: boolean, _: string, _: string, space: string) <- parse_directed_graph_type(collection_type);
                        case ok of { true -> space; false -> "" }
                    };
                    false -> case is_search_tree_type(collection_type) of {
                        true -> {
                            (ok: boolean, _: string, space: string) <- parse_search_tree_type(collection_type);
                            case ok of { true -> space; false -> "" }
                        };
                        false -> case is_undirected_graph_type(collection_type) of {
                            true -> {
                                (ok: boolean, _: string, _: string, space: string) <- parse_undirected_graph_type(collection_type);
                                case ok of { true -> space; false -> "" }
                            };
                            false -> case is_weighted_graph_type(collection_type) of {
                                true -> {
                                    (ok: boolean, _: string, _: string, _: string, space: string) <- parse_weighted_graph_type(collection_type);
                                    case ok of { true -> space; false -> "" }
                                };
                                false -> case is_priority_queue_type(collection_type) of {
                                    true -> {
                                        (ok: boolean, _: string, _: string, space: string) <- parse_priority_queue_type(collection_type);
                                        case ok of { true -> space; false -> "" }
                                    };
                                    false -> case is_tree_type(collection_type) of {
                                        true -> {
                                            (ok: boolean, _: string, space: string) <- parse_tree_type(collection_type);
                                            case ok of { true -> space; false -> "" }
                                        };
                                        false -> case is_binary_tree_type(collection_type) of {
                                            true -> {
                                                (ok: boolean, _: string, space: string) <- parse_binary_tree_type(collection_type);
                                                case ok of { true -> space; false -> "" }
                                            };
                                            false -> record_runtime_space_from_region_field(collection_type)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn resolve_assoc_type_placeholder(placeholder: string, collection_type: string, param_index: int64) -> string {
    p: string <- strip_spaces_col(placeholder);
    pk: int64 <- type_interner@placeholder_kind_of_surface(p);
    case is_assoc_type_placeholder(p) of {
        false -> p;
        // PriorityQueue[PriorityType, ItemType, mem(S)] (priority_queue_trait.md §1): ItemType is the
        // stored value, bracket parameter 2; every other family keeps its item first.
        true -> case pk == type_interner@kind_ph_item_type() of {
            true -> case is_priority_queue_type(collection_type) of {
                true -> collection_param_type_for_trait_arg(collection_type, 2);
                false -> collection_param_type_for_trait_arg(collection_type, 1)
            };
            false -> case pk == type_interner@kind_ph_priority_type() or pk == type_interner@kind_ph_key_type() or pk == type_interner@kind_ph_node_id_type() of {
                true -> collection_param_type_for_trait_arg(collection_type, 1);
                false -> case pk == type_interner@kind_ph_value_type() or pk == type_interner@kind_ph_edge_payload_type() of {
                    true -> collection_param_type_for_trait_arg(collection_type, 2);
                    false -> case pk == type_interner@kind_ph_space_type() of {
                        true -> collection_space_from_type(collection_type);
                        false -> case p == "SetType" of {
                            true -> case is_ordered_set_type(collection_type) of { true -> collection_type; false -> "" };
                            false -> case p == "MapType" of {
                                true -> case is_ordered_map_type(collection_type) of { true -> collection_type; false -> "" };
                                false -> case p == "HeapType" of {
                                    true -> case is_heap_type(collection_type) of { true -> collection_type; false -> "" };
                                    false -> case p == "GraphType" of {
                                        true -> case is_directed_graph_type(collection_type) or is_undirected_graph_type(collection_type) or is_weighted_graph_type(collection_type) of { true -> collection_type; false -> "" };
                                        false -> case p == "QueueType" or p == "TreeType" or p == "EdgeDataType" or p == "WeightType" or p == "AccType" of {
                                            true -> collection_type;
                                            false -> ""
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn resolve_trait_formal_type(formal: string, collection_type: string, param_index: int64) -> string {
    f: string <- strip_spaces_col(formal);
    case length_bytes(collection_type) == 0 of {
        true -> f;
        false -> case is_assoc_type_placeholder(f) of {
            true -> resolve_assoc_type_placeholder(f, collection_type, param_index);
            false -> f
        }
    }
}

fn witness_type_from_record_field(record_type: string, field: string) -> string {
    ft: string <- type_checker_record_types@find_field_type_in_record(record_type, field);
    case length_bytes(ft) == 0 of {
        true -> "";
        false -> {
            (ok: boolean, left: string, _: string) <- parse_fn_binary_param_types(ft);
            case ok of { true -> left; false -> "" }
        }
    }
}

fn assoc_type_from_record_witness(placeholder: string, record_type: string) -> string {
    p: string <- strip_spaces_col(placeholder);
    pk: int64 <- type_interner@placeholder_kind_of_surface(p);
    case length_bytes(record_type) == 0 of {
        true -> "";
        // PriorityType is witnessed by compare_priority, ItemType (the stored value) by compare_item
        // (priority_queue_trait.md §1-§2); each falls back to the other field when it is the only one.
        false -> case pk == type_interner@kind_ph_priority_type() of {
            true -> case length_bytes(witness_type_from_record_field(record_type, "compare_priority")) > 0 of {
                true -> witness_type_from_record_field(record_type, "compare_priority");
                false -> witness_type_from_record_field(record_type, "compare_item")
            };
            false -> case pk == type_interner@kind_ph_item_type() of {
            true -> case length_bytes(witness_type_from_record_field(record_type, "compare_item")) > 0 of {
                true -> witness_type_from_record_field(record_type, "compare_item");
                false -> witness_type_from_record_field(record_type, "compare_priority")
            };
            false -> case pk == type_interner@kind_ph_key_type() or pk == type_interner@kind_ph_node_id_type() of {
                true -> case length_bytes(witness_type_from_record_field(record_type, "compare_node")) > 0 of {
                    true -> witness_type_from_record_field(record_type, "compare_node");
                    false -> witness_type_from_record_field(record_type, "compare_key")
                };
                false -> case pk == type_interner@kind_ph_value_type() or pk == type_interner@kind_ph_edge_payload_type() of {
                    true -> case length_bytes(witness_type_from_record_field(record_type, "compare_edge")) > 0 of {
                        true -> witness_type_from_record_field(record_type, "compare_edge");
                        false -> witness_type_from_record_field(record_type, "compare_value")
                    };
                    false -> ""
                }
            }
            }
        }
    }
}

fn resolve_trait_formal_with_contexts(formal: string, collection_type: string, record_type: string, param_index: int64) -> string {
    f: string <- strip_spaces_col(formal);
    case is_assoc_type_placeholder(f) of {
        true -> {
            from_col: string <- case length_bytes(collection_type) > 0 of {
                true -> resolve_assoc_type_placeholder(f, collection_type, param_index);
                false -> ""
            };
            case length_bytes(from_col) > 0 of {
                true -> from_col;
                false -> {
                    from_rec: string <- assoc_type_from_record_witness(f, record_type);
                    case length_bytes(from_rec) > 0 of {
                        true -> from_rec;
                        // AccType is witnessed by the call's accumulator/result, not by a
                        // collection receiver.  Leave the placeholder so AccType~AccType
                        // matches inside trait impl bodies that forward to wbt_map@fold.
                        false -> case f == "AccType" of {
                            true -> "AccType";
                            false -> ""
                        }
                    }
                }
            }
        };
        // Composite formals (constructor records, fn types) may embed ItemType/KeyType/ValueType.
        false -> case length_bytes(collection_type) > 0 of {
            true -> resolve_constructor_call_formal(collection_type, formal);
            false -> case length_bytes(record_type) > 0 of {
                true -> resolve_constructor_call_formal(record_type, formal);
                false -> f
            }
        }
    }
}

fn replace_assoc_token_in_type(s: string, token: string, replacement: string) -> string {
    case length_bytes(replacement) == 0 or length_bytes(token) == 0 of {
        true -> s;
        false -> replace_assoc_token_scan(s, token, replacement, 0, "")
    }
}

fn replace_assoc_run_end(s: string, token: string, tlen: int64, j: int64, n: int64) -> int64 {
    case j >= n of {
        true -> j;
        false -> case j + tlen <= n and substring(s, j, j + tlen) == token of {
            true -> j;
            false -> replace_assoc_run_end(s, token, tlen, j + 1, n)
        }
    }
}

fn replace_assoc_token_scan(s: string, token: string, replacement: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> case i + length_bytes(token) <= length_bytes(s) and substring(s, i, i + length_bytes(token)) == token of {
            true -> replace_assoc_token_scan(s, token, replacement, i + length_bytes(token), concat(acc, replacement));
            false -> {
                n: int64 <- length_bytes(s);
                tlen: int64 <- length_bytes(token);
                e: int64 <- replace_assoc_run_end(s, token, tlen, i, n);
                replace_assoc_token_scan(s, token, replacement, e, concat(acc, substring(s, i, e)))
            }
        }
    }
}

fn constructor_witness_type_for_placeholder(bind_type: string, placeholder: string) -> string {
    case is_collection_trait_type(bind_type) of {
        true -> resolve_assoc_type_placeholder(placeholder, bind_type, 1);
        false -> {
            // Full runtime records (root/region/specialization_key) and bare
            // constructor records ({compare_key, compare_value}) both witness
            // ItemType/KeyType/ValueType via their comparator fields.
            from_rec: string <- assoc_type_from_record_witness(placeholder, bind_type);
            case length_bytes(from_rec) > 0 of {
                true -> from_rec;
                false -> ""
            }
        }
    }
}

// ---- call-site placeholder substitution ---------------------------------------------------------
//
// A callee's formal (a parameter or result type) spells the callee's placeholders. A call site knows
// what they stand for: ItemType/KeyType/ValueType/PriorityType from the receiver argument (a
// collection type, or a record whose comparator fields witness them), from the expected type where
// the receiver leaves one open, and AccType from the expected result. The witnesses are gathered
// first and put into the callee's ORIGINAL formal in ONE pass (replace_call_placeholders): each
// placeholder token of the formal is replaced once and the text of a witness is never scanned
// again. That keeps the caller's placeholders apart from the callee's. A witness may itself spell
// the caller's own placeholders -- a generic module calling another has ValueType witnessed by
// `ref?(L, S, (KeyType, ValueType, ...))`, or ItemType by `{ p: KeyType, v: ValueType, ... }` -- and
// those names belong to the caller (silica-specification §3.4.12). Before 2026-10-23 the tokens were
// substituted in sequence (PriorityType, ItemType, KeyType, ValueType, then AccType, and at a call's
// result a second round from the expected type), every pass rescanning the previous pass's output,
// so a witness holding ValueType had that ValueType replaced again: a node type nested inside its
// own ValueType slot, rejected as E2003 against the declared type.

// AccType is witnessed by the call's expected result; a discarded, absent or still-placeholder
// expectation leaves it open (AccType ~ AccType inside trait impl bodies that forward to a fold).
fn acc_witness_of(expected_type: string) -> string {
    e: string <- strip_spaces_col(expected_type);
    case length_bytes(e) == 0 or e == "discard" or e == "AccType" of {
        true -> "";
        false -> expected_type
    }
}

// The placeholder token starting at i: 0 none, 1 ItemType, 2 KeyType, 3 ValueType, 4 PriorityType,
// 5 AccType. One character read decides for every position that starts no token.
fn ph_token_at(s: string, i: int64, n: int64) -> int64 {
    case substring(s, i, i + 1) of {
        "I" -> case i + 8 <= n and substring(s, i, i + 8) == "ItemType" of { true -> 1; false -> 0 };
        "K" -> case i + 7 <= n and substring(s, i, i + 7) == "KeyType" of { true -> 2; false -> 0 };
        "V" -> case i + 9 <= n and substring(s, i, i + 9) == "ValueType" of { true -> 3; false -> 0 };
        "P" -> case i + 12 <= n and substring(s, i, i + 12) == "PriorityType" of { true -> 4; false -> 0 };
        "A" -> case i + 7 <= n and substring(s, i, i + 7) == "AccType" of { true -> 5; false -> 0 };
        _: string -> 0
    }
}

fn ph_token_len(code: int64) -> int64 {
    case code of {
        1 -> 8;
        2 -> 7;
        3 -> 9;
        4 -> 12;
        5 -> 7;
        _: int64 -> 0
    }
}

fn ph_token_witness(code: int64, w: { item: string, key: string, val: string, pri: string, acc: string }) -> string {
    case code of {
        1 -> w.item;
        2 -> w.key;
        3 -> w.val;
        4 -> w.pri;
        5 -> w.acc;
        _: int64 -> ""
    }
}

// Index of the next placeholder token at or after i, or n.
fn ph_run_end(s: string, i: int64, n: int64) -> int64 {
    case i >= n of {
        true -> n;
        false -> case ph_token_at(s, i, n) > 0 of {
            true -> i;
            false -> ph_run_end(s, i + 1, n)
        }
    }
}

fn replace_call_placeholders_scan(s: string, w: { item: string, key: string, val: string, pri: string, acc: string }, i: int64, n: int64, acc: string) -> string {
    case i >= n of {
        true -> acc;
        false -> {
            e: int64 <- ph_run_end(s, i, n);
            case e > i of {
                true -> replace_call_placeholders_scan(s, w, e, n, concat(acc, substring(s, i, e)));
                false -> {
                    code: int64 <- ph_token_at(s, i, n);
                    len: int64 <- ph_token_len(code);
                    witness: string <- ph_token_witness(code, w);
                    // A token without a witness stays the callee's placeholder.
                    piece: string <- case length_bytes(witness) == 0 of {
                        true -> substring(s, i, i + len);
                        false -> witness
                    };
                    replace_call_placeholders_scan(s, w, i + len, n, concat(acc, piece))
                }
            }
        }
    }
}

// One simultaneous pass over `formal`. Every placeholder name ends in "Type", so a formal without
// that text is returned as is without gathering anything.
fn replace_call_placeholders(formal: string, w: { item: string, key: string, val: string, pri: string, acc: string }) -> string {
    case contains(formal, "Type") of {
        false -> formal;
        true -> replace_call_placeholders_scan(formal, w, 0, length_bytes(formal), "")
    }
}

// The receiver's witnesses, with `exp_bind` (the expected type at a call's result, "" elsewhere)
// filling only what the receiver leaves open: the first binding of each placeholder wins.
fn call_witnesses(recv_bind: string, exp_bind: string, acc_expected: string) -> { item: string, key: string, val: string, pri: string, acc: string } {
    item_r: string <- constructor_witness_type_for_placeholder(recv_bind, "ItemType");
    key_r: string <- constructor_witness_type_for_placeholder(recv_bind, "KeyType");
    val_r: string <- constructor_witness_type_for_placeholder(recv_bind, "ValueType");
    pri_r: string <- constructor_witness_type_for_placeholder(recv_bind, "PriorityType");
    item_w: string <- case length_bytes(item_r) > 0 or length_bytes(exp_bind) == 0 of {
        true -> item_r;
        false -> constructor_witness_type_for_placeholder(exp_bind, "ItemType")
    };
    key_w: string <- case length_bytes(key_r) > 0 or length_bytes(exp_bind) == 0 of {
        true -> key_r;
        false -> constructor_witness_type_for_placeholder(exp_bind, "KeyType")
    };
    val_w: string <- case length_bytes(val_r) > 0 or length_bytes(exp_bind) == 0 of {
        true -> val_r;
        false -> constructor_witness_type_for_placeholder(exp_bind, "ValueType")
    };
    pri_w: string <- case length_bytes(pri_r) > 0 or length_bytes(exp_bind) == 0 of {
        true -> pri_r;
        false -> constructor_witness_type_for_placeholder(exp_bind, "PriorityType")
    };
    acc_w: string <- acc_witness_of(acc_expected);
    { item: item_w, key: key_w, val: val_w, pri: pri_w, acc: acc_w }
}

// The callee's formal instantiated for one call site: receiver witnesses, then the expected
// type's for what the receiver leaves open, and AccType from `acc_expected`, in one pass.
fn resolve_call_formal(recv_bind: string, exp_bind: string, acc_expected: string, formal: string) -> string {
    case contains(formal, "Type") of {
        false -> formal;
        true -> replace_call_placeholders(formal, call_witnesses(recv_bind, exp_bind, acc_expected))
    }
}

fn resolve_constructor_call_formal(bind_type: string, formal: string) -> string {
    resolve_call_formal(bind_type, "", "", formal)
}

// AccType alone, for callers that have no receiver witnesses to place in the same pass.
fn resolve_accumulator_call_formal(expected_type: string, formal: string) -> string {
    acc_w: string <- acc_witness_of(expected_type);
    case length_bytes(acc_w) == 0 of {
        true -> formal;
        false -> replace_call_placeholders(formal, { item: "", key: "", val: "", pri: "", acc: acc_w })
    }
}

fn infer_collection_decl_from_receiver(inferred: string, arg_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context_env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)]) -> string {
    inf: string <- strip_all_spaces_col(inferred);
    case is_collection_trait_type(inf) of {
        true -> inferred;
        false -> {
            arg_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(arg_expr);
            case arg_node.kind == 4 of {
                true -> {
                    inner_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(arg_expr, arg_node.inner);
                    inner_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(inner_e);
                    case inner_node.kind == 1 of {
                        true -> {
                            bound: string <- type_checker_core@lookup_symbol_surface(context_env, inner_node.name);
                            case length_bytes(bound) == 0 of {
                                true -> "";
                                false -> case is_collection_trait_type(bound) of { true -> bound; false -> "" }
                            }
                        };
                        false -> ""
                    }
                };
                false -> ""
            }
        }
    }
}

fn find_collection_keyword_index(s: string, i: int64, kw: string) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case length_bytes(s) - i >= length_bytes(kw) and substring(s, i, i + length_bytes(kw)) == kw of {
            true -> i;
            false -> find_collection_keyword_index(s, i + 1, kw)
        }
    }
}

fn find_matching_closing_bracket_col(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> length_bytes(s);
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "[" or c == "(" or c == "{" of {
                true -> find_matching_closing_bracket_col(s, i + 1, depth + 1);
                false -> case c == "]" or c == ")" or c == "}" of {
                    true -> case depth == 1 of {
                        true -> i;
                        false -> find_matching_closing_bracket_col(s, i + 1, depth - 1)
                    };
                    false -> find_matching_closing_bracket_col(s, i + 1, depth)
                }
            }
        }
    }
}

fn validate_one_collection_surface(col_type: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case is_ordered_set_type(col_type) of {
        true -> {
            (ok: boolean, _: string, space: string) <- parse_ordered_set_type(col_type);
            case ok of {
                false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid OrderedSet type: ", col_type), ""), "sect4");
                true -> case collection_space_has_mem_form(space) of {
                    false -> type_checker_core@type_check_err("E2015", location, concat(concat("OrderedSet requires mem(Space): ", col_type), ""), "sect4");
                    true -> type_checker_core@type_check_ok()
                }
            }
        };
        false -> case is_ordered_map_type(col_type) of {
            true -> {
                (ok: boolean, _: string, _: string, space: string) <- parse_ordered_map_type(col_type);
                case ok of {
                    false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid OrderedMap type: ", col_type), ""), "sect4");
                    true -> case collection_space_has_mem_form(space) of {
                        false -> type_checker_core@type_check_err("E2015", location, concat(concat("OrderedMap requires mem(Space): ", col_type), ""), "sect4");
                        true -> type_checker_core@type_check_ok()
                    }
                }
            };
            false -> case is_heap_type(col_type) of {
                true -> {
                    (ok: boolean, _: string, space: string) <- parse_heap_type(col_type);
                    case ok of {
                        false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid Heap type: ", col_type), ""), "sect4");
                        true -> case collection_space_has_mem_form(space) of {
                            false -> type_checker_core@type_check_err("E2015", location, concat(concat("Heap requires mem(Space): ", col_type), ""), "sect4");
                            true -> type_checker_core@type_check_ok()
                        }
                    }
                };
                false -> case is_directed_graph_type(col_type) of {
                    true -> {
                        (ok: boolean, _: string, _: string, space: string) <- parse_directed_graph_type(col_type);
                        case ok of {
                            false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid DirectedGraph type: ", col_type), ""), "sect4");
                            true -> case collection_space_has_mem_form(space) of {
                                false -> type_checker_core@type_check_err("E2015", location, concat(concat("DirectedGraph requires mem(Space): ", col_type), ""), "sect4");
                                true -> type_checker_core@type_check_ok()
                            }
                        }
                    };
                    false -> case is_search_tree_type(col_type) of {
                        true -> {
                            (ok: boolean, _: string, space: string) <- parse_search_tree_type(col_type);
                            case ok of {
                                false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid SearchTree type: ", col_type), ""), "sect4");
                                true -> case collection_space_has_mem_form(space) of {
                                    false -> type_checker_core@type_check_err("E2015", location, concat(concat("SearchTree requires mem(Space): ", col_type), ""), "sect4");
                                    true -> type_checker_core@type_check_ok()
                                }
                            }
                        };
                        false -> case is_undirected_graph_type(col_type) of {
                            true -> {
                                (ok: boolean, _: string, _: string, space: string) <- parse_undirected_graph_type(col_type);
                                case ok of {
                                    false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid UndirectedGraph type: ", col_type), ""), "sect4");
                                    true -> case collection_space_has_mem_form(space) of {
                                        false -> type_checker_core@type_check_err("E2015", location, concat(concat("UndirectedGraph requires mem(Space): ", col_type), ""), "sect4");
                                        true -> type_checker_core@type_check_ok()
                                    }
                                }
                            };
                            false -> case is_weighted_graph_type(col_type) of {
                                true -> {
                                    (ok: boolean, _: string, _: string, _: string, space: string) <- parse_weighted_graph_type(col_type);
                                    case ok of {
                                        false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid WeightedGraph type: ", col_type), ""), "sect4");
                                        true -> case collection_space_has_mem_form(space) of {
                                            false -> type_checker_core@type_check_err("E2015", location, concat(concat("WeightedGraph requires mem(Space): ", col_type), ""), "sect4");
                                            true -> type_checker_core@type_check_ok()
                                        }
                                    }
                                };
                                false -> case is_priority_queue_type(col_type) of {
                                    true -> {
                                        (ok: boolean, _: string, _: string, space: string) <- parse_priority_queue_type(col_type);
                                        case ok of {
                                            false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid PriorityQueue type: ", col_type), ""), "sect4");
                                            true -> case collection_space_has_mem_form(space) of {
                                                false -> type_checker_core@type_check_err("E2015", location, concat(concat("PriorityQueue requires mem(Space): ", col_type), ""), "sect4");
                                                true -> type_checker_core@type_check_ok()
                                            }
                                        }
                                    };
                                    false -> case is_tree_type(col_type) of {
                                        true -> {
                                            (ok: boolean, _: string, space: string) <- parse_tree_type(col_type);
                                            case ok of {
                                                false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid Tree type: ", col_type), ""), "sect4");
                                                true -> case collection_space_has_mem_form(space) of {
                                                    false -> type_checker_core@type_check_err("E2015", location, concat(concat("Tree requires mem(Space): ", col_type), ""), "sect4");
                                                    true -> type_checker_core@type_check_ok()
                                                }
                                            }
                                        };
                                        false -> case is_binary_tree_type(col_type) of {
                                            true -> {
                                                (ok: boolean, _: string, space: string) <- parse_binary_tree_type(col_type);
                                                case ok of {
                                                    false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid BinaryTree type: ", col_type), ""), "sect4");
                                                    true -> case collection_space_has_mem_form(space) of {
                                                        false -> type_checker_core@type_check_err("E2015", location, concat(concat("BinaryTree requires mem(Space): ", col_type), ""), "sect4");
                                                        true -> type_checker_core@type_check_ok()
                                                    }
                                                }
                                            };
                                            false -> type_checker_core@type_check_ok()
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn min_pos4(a: int64, b: int64, c: int64, d: int64) -> int64 {
    m: int64 <- min_pos3(a, b, c);
    case d < 0 of {
        true -> m;
        false -> case m < 0 of {
            true -> d;
            false -> case d < m of { true -> d; false -> m }
        }
    }
}

fn collection_keyword_len_at(s: string, pos: int64) -> int64 {
    case pos >= 0 and length_bytes(s) - pos >= 15 and substring(s, pos, pos + 15) == "UndirectedGraph" of {
        true -> 15;
        false -> case pos >= 0 and length_bytes(s) - pos >= 13 and substring(s, pos, pos + 13) == "DirectedGraph" of {
            true -> 13;
            false -> case pos >= 0 and length_bytes(s) - pos >= 13 and substring(s, pos, pos + 13) == "WeightedGraph" of {
                true -> 13;
                false -> case pos >= 0 and length_bytes(s) - pos >= 13 and substring(s, pos, pos + 13) == "PriorityQueue" of {
                    true -> 13;
                    false -> case pos >= 0 and length_bytes(s) - pos >= 10 and substring(s, pos, pos + 10) == "OrderedSet" of {
                        true -> 10;
                        false -> case pos >= 0 and length_bytes(s) - pos >= 10 and substring(s, pos, pos + 10) == "OrderedMap" of {
                            true -> 10;
                            false -> case pos >= 0 and length_bytes(s) - pos >= 10 and (substring(s, pos, pos + 10) == "SearchTree" or substring(s, pos, pos + 10) == "BinaryTree") of {
                                true -> 10;
                                false -> case pos >= 0 and length_bytes(s) - pos >= 4 and substring(s, pos, pos + 4) == "Heap" of {
                                    true -> 4;
                                    false -> case pos >= 0 and length_bytes(s) - pos >= 4 and substring(s, pos, pos + 4) == "Tree" of {
                                        true -> 4;
                                        false -> 0
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn collection_keyword_valid_at(s: string, pos: int64, kw: string) -> boolean {
    case pos < 0 or length_bytes(s) - pos < length_bytes(kw) of {
        true -> false;
        false -> case substring(s, pos, pos + length_bytes(kw)) == kw of {
            false -> false;
            true -> case pos > 0 of {
                true -> {
                    prev: string <- substring(s, pos - 1, pos);
                    case prev == "A" or prev == "B" or prev == "C" or prev == "D" or prev == "E" or prev == "F" or prev == "G" or prev == "H" or prev == "I" or prev == "J" or prev == "K" or prev == "L" or prev == "M" or prev == "N" or prev == "O" or prev == "P" or prev == "Q" or prev == "R" or prev == "S" or prev == "T" or prev == "U" or prev == "V" or prev == "W" or prev == "X" or prev == "Y" or prev == "Z" of {
                        true -> false;
                        false -> case prev == "a" or prev == "b" or prev == "c" or prev == "d" or prev == "e" or prev == "f" or prev == "g" or prev == "h" or prev == "i" or prev == "j" or prev == "k" or prev == "l" or prev == "m" or prev == "n" or prev == "o" or prev == "p" or prev == "q" or prev == "r" or prev == "s" or prev == "t" or prev == "u" or prev == "v" or prev == "w" or prev == "x" or prev == "y" or prev == "z" of {
                            true -> false;
                            false -> true
                        }
                    }
                };
                false -> true
            }
        }
    }
}

fn find_valid_collection_keyword_index(s: string, i: int64, kw: string) -> int64 {
    raw: int64 <- find_collection_keyword_index(s, i, kw);
    case raw < 0 of {
        true -> -1;
        false -> case collection_keyword_valid_at(s, raw, kw) of {
            true -> raw;
            false -> find_valid_collection_keyword_index(s, raw + 1, kw)
        }
    }
}

fn find_earliest_collection_keyword(s: string, i: int64) -> (int64, int64) {
    pos_set: int64 <- find_valid_collection_keyword_index(s, i, "OrderedSet");
    pos_map: int64 <- find_valid_collection_keyword_index(s, i, "OrderedMap");
    pos_search: int64 <- find_valid_collection_keyword_index(s, i, "SearchTree");
    pos_heap: int64 <- find_valid_collection_keyword_index(s, i, "Heap");
    pos_dg: int64 <- find_valid_collection_keyword_index(s, i, "DirectedGraph");
    pos_ug: int64 <- find_valid_collection_keyword_index(s, i, "UndirectedGraph");
    pos_wg: int64 <- find_valid_collection_keyword_index(s, i, "WeightedGraph");
    pos_pq: int64 <- find_valid_collection_keyword_index(s, i, "PriorityQueue");
    pos_tree: int64 <- find_valid_collection_keyword_index(s, i, "Tree");
    pos_bt: int64 <- find_valid_collection_keyword_index(s, i, "BinaryTree");
    pos0123: int64 <- min_pos4(pos_set, pos_map, pos_search, pos_heap);
    pos4567: int64 <- min_pos4(pos_dg, pos_ug, pos_wg, pos_pq);
    pos: int64 <- min_pos4(pos0123, pos4567, pos_tree, pos_bt);
    case pos < 0 of {
        true -> (-1, 0);
        false -> (pos, collection_keyword_len_at(s, pos))
    }
}

fn validate_collection_in_type_string(s: string, location: { file: string, line: int64, column: int64, offset: int64 }, i: int64) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case i >= length_bytes(s) of {
        true -> type_checker_core@type_check_ok();
        false -> {
            (pos: int64, kw_len: int64) <- find_earliest_collection_keyword(s, i);
            case pos < 0 of {
                true -> type_checker_core@type_check_ok();
                false -> {
                    j: int64 <- skip_spaces_index_col(s, pos + kw_len);
                    case j >= length_bytes(s) of {
                        true -> validate_collection_in_type_string(s, location, pos + kw_len);
                        false -> case substring(s, j, j + 1) == "[" of {
                            false -> validate_collection_in_type_string(s, location, pos + kw_len);
                            true -> {
                                end_j: int64 <- find_matching_closing_bracket_col(s, j, 0);
                                case end_j >= length_bytes(s) of {
                                    true -> validate_collection_in_type_string(s, location, pos + kw_len);
                                    false -> {
                                        col_ty: string <- substring(s, pos, end_j + 1);
                                        one_r: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- validate_one_collection_surface(col_ty, location);
                                        case one_r.is_ok of {
                                            false -> one_r;
                                            true -> validate_collection_in_type_string(s, location, end_j + 1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn min_pos3(a: int64, b: int64, c: int64) -> int64 {
    case a < 0 of {
        true -> case b < 0 of { true -> c; false -> case c < 0 of { true -> b; false -> case b < c of { true -> b; false -> c } } };
        false -> case b < 0 of {
            true -> case c < 0 of { true -> a; false -> case a < c of { true -> a; false -> c } };
            false -> case c < 0 of {
                true -> case a < b of { true -> a; false -> b };
                false -> case a < b of {
                    true -> case a < c of { true -> a; false -> c };
                    false -> case b < c of { true -> b; false -> c }
                }
            }
        }
    }
}

fn validate_collection_type_declaration(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    validate_collection_in_type_string(type_str, location, 0)
}

fn is_lookup_status_union_type(type_str: string) -> boolean {
    s: string <- strip_all_spaces_col(type_str);
    case s == ":not_found|:found" of {
        true -> true;
        false -> s == ":found|:not_found"
    }
}

fn record_type_has_field(type_str: string, field: string) -> boolean {
    ft: string <- type_checker_record_types@find_field_type_in_record(type_str, field);
    length_bytes(ft) > 0
}

// Collection lookup/update results use { status: :not_found | :found, payload } per common_contract §6.
// Only records with status plus a collection payload field (value or item) are validated; unrelated
// records such as supervisor replies may also carry a status field with a different meaning.
fn is_collection_lookup_result_record_shape(type_str: string) -> boolean {
    case record_type_has_field(type_str, "status") of {
        false -> false;
        true -> case record_type_has_field(type_str, "value") of {
            true -> true;
            false -> record_type_has_field(type_str, "item")
        }
    }
}

fn validate_lookup_result_record_type(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case is_collection_lookup_result_record_shape(type_str) of {
        false -> type_checker_core@type_check_ok();
        true -> {
            status_type: string <- type_checker_record_types@find_field_type_in_record(type_str, "status");
            case is_lookup_status_union_type(status_type) of {
                false -> type_checker_core@type_check_err("E2017", location, concat(concat("collection lookup status must be :not_found | :found, got ", status_type), ""), "common_contract§6");
                true -> case type_checker_record_types@count_record_fields(type_str) < 2 of {
                    true -> type_checker_core@type_check_err("E2017", location, "collection lookup result record must include status and a separate payload field", "common_contract§6");
                    false -> type_checker_core@type_check_ok()
                }
            }
        }
    }
}

fn validate_collection_result_type_declaration(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_record_types@record_type_starts(type_str) of {
        true -> validate_lookup_result_record_type(type_str, location);
        false -> type_checker_core@type_check_ok()
    }
}

// List[string, mem(normal)] is List[string, mem(normal)] (spec §3.4.2).

fn empty_constructor_field_list() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure result
    end
}


fn cons_constructor_field(s: string, tail: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- prepend[string, mem(normal)](s, tail)
    produces
        pure result
    end
}


fn constructor_field_list_contains(lst: List[string, mem(normal)], name: string) -> boolean {
    case lst.is_nil of {
        true -> false;
        false -> case lst.head == name of {
            true -> true;
            false -> constructor_field_list_contains(lst.tail, name)
        }
    }
}

// An expanded structural record carries its construction shape in its own field names,
// so the surface parsers (OrderedSet[...], OrderedMap[...]) are not the only source of
// truth. Without this, a record written out in full parses as none of the named
// collection surfaces and falls through to the module-name table, which picks whichever
// collection module happens to be in scope. That stored wbt_map's compare_key /
// compare_value into a wbt_set record: every unmatched name resolves to the same
// not-found offset, all four collided on one slot, compare_item was never written, and
// the stale word was called as the comparator (SIGFPE, then a _sigtramp loop).
// Checked most-specific first: weighted graphs also carry compare_edge_data/compare_node.
fn record_has_ordering_field(bind_type: string, field: string) -> boolean {
    length_bytes(type_checker_record_types@find_field_type_in_record(bind_type, field)) > 0
}

fn required_constructor_fields_from_record(bind_type: string) -> List[string, mem(normal)] {
    case record_has_ordering_field(bind_type, "edge_target") of {
        true -> cons_constructor_field("edge_target", cons_constructor_field("compare_edge", cons_constructor_field("compare_node", empty_constructor_field_list())));
        false -> case record_has_ordering_field(bind_type, "compare_weight") of {
            true -> cons_constructor_field("compare_weight", cons_constructor_field("edge_weight", cons_constructor_field("compare_edge_data", cons_constructor_field("compare_node", empty_constructor_field_list()))));
            false -> case record_has_ordering_field(bind_type, "compare_edge_data") of {
                true -> cons_constructor_field("compare_edge_data", cons_constructor_field("compare_node", empty_constructor_field_list()));
                false -> case record_has_ordering_field(bind_type, "compare_key") of {
                    true -> cons_constructor_field("compare_value", cons_constructor_field("compare_key", empty_constructor_field_list()));
                    false -> case record_has_ordering_field(bind_type, "compare_priority") of {
                        true -> cons_constructor_field("compare_item", cons_constructor_field("compare_priority", empty_constructor_field_list()));
                        false -> case record_has_ordering_field(bind_type, "compare_item") of {
                            true -> cons_constructor_field("compare_item", empty_constructor_field_list());
                            false -> empty_constructor_field_list()
                        }
                    }
                }
            }
        }
    }
}


fn required_constructor_fields(bind_type: string) -> List[string, mem(normal)] {
    case is_ordered_set_type(bind_type) of {
        true -> cons_constructor_field("compare_item", empty_constructor_field_list());
        false -> case is_search_tree_type(bind_type) of {
            true -> cons_constructor_field("compare_item", empty_constructor_field_list());
            false -> case is_ordered_map_type(bind_type) of {
                true -> cons_constructor_field("compare_value", cons_constructor_field("compare_key", empty_constructor_field_list()));
                false -> case is_heap_type(bind_type) of {
                    true -> cons_constructor_field("compare_item", empty_constructor_field_list());
                    false -> case is_tree_type(bind_type) or is_binary_tree_type(bind_type) of {
                        true -> cons_constructor_field("compare_item", empty_constructor_field_list());
                        false -> case is_priority_queue_type(bind_type) of {
                            true -> cons_constructor_field("compare_item", cons_constructor_field("compare_priority", empty_constructor_field_list()));
                            false -> case is_directed_graph_type(bind_type) of {
                                true -> cons_constructor_field("edge_target", cons_constructor_field("compare_edge", cons_constructor_field("compare_node", empty_constructor_field_list())));
                                false -> case is_undirected_graph_type(bind_type) of {
                                    true -> cons_constructor_field("compare_edge_data", cons_constructor_field("compare_node", empty_constructor_field_list()));
                                    false -> case is_weighted_graph_type(bind_type) of {
                                        true -> cons_constructor_field("compare_weight", cons_constructor_field("edge_weight", cons_constructor_field("compare_edge_data", cons_constructor_field("compare_node", empty_constructor_field_list()))));
                                        false -> required_constructor_fields_from_record(bind_type)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn record_literal_field_names(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    case node.kind == 21 of {
        true -> {
            right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, node.right_expr);
            record_literal_field_names(right, cons_constructor_field(node.name, acc))
        };
        false -> acc
    }
}

fn validate_required_constructor_fields(required_fields: List[string, mem(normal)], provided_fields: List[string, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case required_fields.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case constructor_field_list_contains(provided_fields, required_fields.head) of {
            false -> type_checker_core@type_check_err("E2017", location, concat(concat("constructor record missing required field ", required_fields.head), ""), "sect4");
            true -> validate_required_constructor_fields(required_fields.tail, provided_fields, location)
        }
    }
}

fn validate_no_extra_constructor_fields(required_fields: List[string, mem(normal)], provided_fields: List[string, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case provided_fields.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case constructor_field_list_contains(required_fields, provided_fields.head) of {
            false -> type_checker_core@type_check_err("E2017", location, concat(concat("constructor record has unexpected field ", provided_fields.head), ""), "sect4");
            true -> validate_no_extra_constructor_fields(required_fields, provided_fields.tail, location)
        }
    }
}

fn validate_constructor_record_field_names(bind_type: string, record_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    required_fields: List[string, mem(normal)] <- required_constructor_fields(bind_type);
    case required_fields.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> {
            provided_fields: List[string, mem(normal)] <- record_literal_field_names(record_expr, empty_constructor_field_list());
            missing_ok: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- validate_required_constructor_fields(required_fields, provided_fields, location);
            case missing_ok.is_ok of {
                false -> missing_ok;
                true -> validate_no_extra_constructor_fields(required_fields, provided_fields, location)
            }
        }
    }
}

fn representation_id_from_module(module_name: string) -> int64 {
    case module_name of {
        "wbt_set" -> 1;
        "StubWbtSet" -> 1;
        "wbt_map" -> 2;
        "StubWbtMap" -> 2;
        "graph_wbt_directed" -> 3;
        "StubGraphDirected" -> 3;
        "graph_csr_directed" -> 10;
        "graph_wbt_undirected" -> 4;
        "StubGraphUndirected" -> 4;
        "graph_csr_undirected" -> 11;
        "graph_weighted" -> 5;
        "StubGraphWeighted" -> 5;
        "graph_dense_directed" -> 12;
        "graph_dense_undirected" -> 13;
        "brodal_okasaki_min" -> 6;
        "StubHeap" -> 6;
        "brodal_okasaki_max" -> 9;
        "StubHeapMax" -> 9;
        "brodal_okasaki_priority" -> 7;
        "StubPriorityQueue" -> 7;
        "tree_rose" -> 8;
        "StubTreeRose" -> 8;
        "tree_binary" -> 14;
        _: string -> 0
    }
}

fn constructor_orientation_atom_lexeme(module_name: string) -> string {
    case module_name of {
        "StubHeapMax" -> ":max";
        "brodal_okasaki_max" -> ":max";
        _: string -> ":min"
    }
}

fn constructor_field_list_length(lst: List[string, mem(normal)]) -> int64 {
    case lst.is_nil of {
        true -> 0;
        false -> 1 + constructor_field_list_length(lst.tail)
    }
}

fn constructor_field_at_index(lst: List[string, mem(normal)], idx: int64) -> string {
    case lst.is_nil of {
        true -> "";
        false -> case idx == 0 of {
            true -> lst.head;
            false -> constructor_field_at_index(lst.tail, idx - 1)
        }
    }
}

fn required_constructor_fields_for_module(module_name: string) -> List[string, mem(normal)] {
    case module_name of {
        "wbt_set" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        "StubWbtSet" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        "wbt_map" -> cons_constructor_field("compare_value", cons_constructor_field("compare_key", empty_constructor_field_list()));
        "StubWbtMap" -> cons_constructor_field("compare_value", cons_constructor_field("compare_key", empty_constructor_field_list()));
        "graph_wbt_directed" -> cons_constructor_field("edge_target", cons_constructor_field("compare_edge", cons_constructor_field("compare_node", empty_constructor_field_list())));
        "StubGraphDirected" -> cons_constructor_field("edge_target", cons_constructor_field("compare_edge", cons_constructor_field("compare_node", empty_constructor_field_list())));
        "graph_wbt_undirected" -> cons_constructor_field("compare_edge_data", cons_constructor_field("compare_node", empty_constructor_field_list()));
        "StubGraphUndirected" -> cons_constructor_field("compare_edge_data", cons_constructor_field("compare_node", empty_constructor_field_list()));
        "graph_weighted" -> cons_constructor_field("compare_weight", cons_constructor_field("edge_weight", cons_constructor_field("compare_edge_data", cons_constructor_field("compare_node", empty_constructor_field_list()))));
        "StubGraphWeighted" -> cons_constructor_field("compare_weight", cons_constructor_field("edge_weight", cons_constructor_field("compare_edge_data", cons_constructor_field("compare_node", empty_constructor_field_list()))));
        "brodal_okasaki_min" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        "StubHeap" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        "brodal_okasaki_max" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        "StubHeapMax" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        "brodal_okasaki_priority" -> cons_constructor_field("compare_item", cons_constructor_field("compare_priority", empty_constructor_field_list()));
        "StubPriorityQueue" -> cons_constructor_field("compare_item", cons_constructor_field("compare_priority", empty_constructor_field_list()));
        "tree_rose" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        "StubTreeRose" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        "tree_binary" -> cons_constructor_field("compare_item", empty_constructor_field_list());
        _: string -> empty_constructor_field_list()
    }
}

fn constructor_ordering_field_count(bind_type: string) -> int64 {
    required_fields: List[string, mem(normal)] <- required_constructor_fields(bind_type);
    constructor_field_list_length(required_fields)
}

fn constructor_ordering_field_at(bind_type: string, idx: int64) -> string {
    required_fields: List[string, mem(normal)] <- required_constructor_fields(bind_type);
    constructor_field_at_index(required_fields, idx)
}

fn constructor_ordering_field_count_for_module(module_name: string) -> int64 {
    required_fields: List[string, mem(normal)] <- required_constructor_fields_for_module(module_name);
    constructor_field_list_length(required_fields)
}

fn constructor_ordering_field_at_for_module(module_name: string, idx: int64) -> string {
    required_fields: List[string, mem(normal)] <- required_constructor_fields_for_module(module_name);
    constructor_field_at_index(required_fields, idx)
}

fn bind_type_has_collection_runtime_fields(bind_type: string) -> boolean {
    key_ty: string <- type_checker_record_types@find_field_type_in_record(bind_type, "specialization_key");
    region_ty: string <- type_checker_record_types@find_field_type_in_record(bind_type, "region");
    length_bytes(key_ty) > 0 and length_bytes(region_ty) > 0
}

fn record_runtime_space_from_region_field(bind_type: string) -> string {
    region_ty: string <- type_checker_record_types@find_field_type_in_record(bind_type, "region");
    space: string <- type_checker_memory_regions@get_space_from_region_type(region_ty);
    case length_bytes(space) == 0 of {
        true -> "";
        false -> concat(concat("mem(", space), ")")
    }
}

fn is_registered_construction_module(module_name: string) -> boolean {
    representation_id_from_module(module_name) > 0
}

fn public_trait_family_tag(bind_type: string) -> int64 {
    case is_ordered_set_type(bind_type) of {
        true -> 1;
        false -> case is_ordered_map_type(bind_type) of {
            true -> 2;
            false -> case is_search_tree_type(bind_type) of {
                true -> 3;
                false -> case is_heap_type(bind_type) of {
                    true -> 4;
                    false -> case is_directed_graph_type(bind_type) of {
                        true -> 5;
                        false -> case is_undirected_graph_type(bind_type) of {
                            true -> 6;
                            false -> case is_weighted_graph_type(bind_type) of {
                                true -> 7;
                                false -> case is_priority_queue_type(bind_type) of {
                                    true -> 8;
                                    false -> case is_tree_type(bind_type) of {
                                        true -> 9;
                                        false -> case is_binary_tree_type(bind_type) of {
                                            true -> 10;
                                            false -> 0
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn combine_type_param_tags(a: int64, b: int64) -> int64 {
    au: int64 <- case a == 0 of { true -> 1; false -> a };
    bu: int64 <- case b == 0 of { true -> 1; false -> b };
    (au * 16) + bu
}

fn space_tag_from_mem_space(space: string) -> int64 {
    s: string <- strip_all_spaces_col(space);
    case s == "mem(normal)" of {
        true -> 1;
        false -> case s == "mem(normal_writeback)" of {
            true -> 2;
            false -> case s == "mem(normal_writethrough)" of {
                true -> 3;
                false -> case s == "mem(normal_noncacheable)" of {
                    true -> 4;
                    false -> case s == "mem(atomic)" of {
                        true -> 5;
                        false -> case s == "mem(device)" of {
                            true -> 6;
                            false -> 0
                        }
                    }
                }
            }
        }
    }
}

fn record_constructor_field_compatible(expected_type: string, return_type: string, field_name: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    expected_field: string <- type_checker_record_types@find_field_type_in_record(expected_type, field_name);
    actual_field: string <- type_checker_record_types@find_field_type_in_record(return_type, field_name);
    case length_bytes(expected_field) == 0 of {
        true -> true;
        false -> case length_bytes(actual_field) == 0 of {
            true -> false;
            false -> type_checker_lists@types_equal_strip(expected_field, actual_field)
                or type_checker_lists@formal_type_accepts_actual(expected_field, actual_field, world)
                or type_checker_lists@formal_type_accepts_actual(actual_field, expected_field, world)
        }
    }
}

fn runtime_record_accepts_constructor_return(expected_type: string, return_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    case bind_type_has_collection_runtime_fields(expected_type) and bind_type_has_collection_runtime_fields(return_type) of {
        false -> false;
        true ->
            record_constructor_field_compatible(expected_type, return_type, "stored_root", world)
            and record_constructor_field_compatible(expected_type, return_type, "root", world)
            and record_constructor_field_compatible(expected_type, return_type, "stored_size", world)
            and record_constructor_field_compatible(expected_type, return_type, "heap_size", world)
            and record_constructor_field_compatible(expected_type, return_type, "compare_item", world)
            and record_constructor_field_compatible(expected_type, return_type, "compare_key", world)
            and record_constructor_field_compatible(expected_type, return_type, "compare_value", world)
            and record_constructor_field_compatible(expected_type, return_type, "compare_priority", world)
            and record_constructor_field_compatible(expected_type, return_type, "compare_node", world)
            and record_constructor_field_compatible(expected_type, return_type, "compare_edge", world)
            and record_constructor_field_compatible(expected_type, return_type, "compare_edge_data", world)
            and record_constructor_field_compatible(expected_type, return_type, "compare_weight", world)
            and record_constructor_field_compatible(expected_type, return_type, "edge_target", world)
            and record_constructor_field_compatible(expected_type, return_type, "edge_weight", world)
    }
}

fn type_param_tag(s: string) -> int64 {
    t: string <- strip_spaces_col(s);
    case t == "int64" of {
        true -> 1;
        false -> case t == "string" of {
            true -> 2;
            false -> case t == "unit" of {
                true -> 3;
                false -> 4
            }
        }
    }
}

fn collection_type_param_tag(bind_type: string) -> int64 {
    case is_ordered_set_type(bind_type) of {
        true -> {
            (ok: boolean, item: string, _: string) <- parse_ordered_set_type(bind_type);
            case ok of { true -> type_param_tag(item); false -> 0 }
        };
        false -> case is_search_tree_type(bind_type) of {
            true -> {
                (ok: boolean, item: string, _: string) <- parse_search_tree_type(bind_type);
                case ok of { true -> type_param_tag(item); false -> 0 }
            };
            false -> case is_heap_type(bind_type) of {
                true -> {
                    (ok: boolean, item: string, _: string) <- parse_heap_type(bind_type);
                    case ok of { true -> type_param_tag(item); false -> 0 }
                };
                false -> case is_tree_type(bind_type) or is_binary_tree_type(bind_type) of {
                    true -> {
                        (ok: boolean, item: string, _: string) <- case is_tree_type(bind_type) of {
                            true -> parse_tree_type(bind_type);
                            false -> parse_binary_tree_type(bind_type)
                        };
                        case ok of { true -> type_param_tag(item); false -> 0 }
                    };
                    false -> case is_ordered_map_type(bind_type) of {
                        true -> {
                            (ok: boolean, key: string, value: string, _: string) <- parse_ordered_map_type(bind_type);
                            case ok of {
                                true -> combine_type_param_tags(type_param_tag(key), type_param_tag(value));
                                false -> 0
                            }
                        };
                        false -> case is_directed_graph_type(bind_type) of {
                            true -> {
                                (ok: boolean, node: string, edge: string, _: string) <- parse_directed_graph_type(bind_type);
                                case ok of {
                                    true -> combine_type_param_tags(type_param_tag(node), type_param_tag(edge));
                                    false -> 0
                                }
                            };
                            false -> case is_undirected_graph_type(bind_type) of {
                                true -> {
                                    (ok: boolean, node: string, edge_data: string, _: string) <- parse_undirected_graph_type(bind_type);
                                    case ok of {
                                        true -> combine_type_param_tags(type_param_tag(node), type_param_tag(edge_data));
                                        false -> 0
                                    }
                                };
                                false -> case is_weighted_graph_type(bind_type) of {
                                    true -> {
                                        (ok: boolean, node: string, edge_data: string, weight: string, _: string) <- parse_weighted_graph_type(bind_type);
                                        case ok of {
                                            true -> combine_type_param_tags(combine_type_param_tags(type_param_tag(node), type_param_tag(edge_data)), type_param_tag(weight));
                                            false -> 0
                                        }
                                    };
                                    false -> case is_priority_queue_type(bind_type) of {
                                        true -> {
                                            (ok: boolean, priority: string, item: string, _: string) <- parse_priority_queue_type(bind_type);
                                            case ok of {
                                                true -> combine_type_param_tags(type_param_tag(priority), type_param_tag(item));
                                                false -> 0
                                            }
                                        };
                                        false -> 0
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn record_binary_field_param_tag(bind_type: string, field_name: string) -> int64 {
    fn_type: string <- type_checker_record_types@find_field_type_in_record(bind_type, field_name);
    (ok: boolean, left: string, _: string) <- parse_fn_binary_param_types(fn_type);
    case ok of {
        true -> type_param_tag(left);
        false -> 0
    }
}

fn record_collection_type_param_tag(bind_type: string, rep: int64) -> int64 {
    case rep of {
        1 -> record_binary_field_param_tag(bind_type, "compare_item");
        2 -> combine_type_param_tags(
            record_binary_field_param_tag(bind_type, "compare_key"),
            record_binary_field_param_tag(bind_type, "compare_value")
        );
        3 -> combine_type_param_tags(
            record_binary_field_param_tag(bind_type, "compare_node"),
            record_binary_field_param_tag(bind_type, "compare_edge")
        );
        4 -> combine_type_param_tags(
            record_binary_field_param_tag(bind_type, "compare_node"),
            record_binary_field_param_tag(bind_type, "compare_edge_data")
        );
        5 -> combine_type_param_tags(
            combine_type_param_tags(
                record_binary_field_param_tag(bind_type, "compare_node"),
                record_binary_field_param_tag(bind_type, "compare_edge_data")
            ),
            record_binary_field_param_tag(bind_type, "compare_weight")
        );
        6 -> record_binary_field_param_tag(bind_type, "compare_item");
        7 -> combine_type_param_tags(
            record_binary_field_param_tag(bind_type, "compare_priority"),
            record_binary_field_param_tag(bind_type, "compare_item")
        );
        8 -> record_binary_field_param_tag(bind_type, "compare_item");
        9 -> record_binary_field_param_tag(bind_type, "compare_item");
        10 -> combine_type_param_tags(
            record_binary_field_param_tag(bind_type, "compare_node"),
            record_binary_field_param_tag(bind_type, "compare_edge")
        );
        11 -> combine_type_param_tags(
            record_binary_field_param_tag(bind_type, "compare_node"),
            record_binary_field_param_tag(bind_type, "compare_edge_data")
        );
        12 -> combine_type_param_tags(
            record_binary_field_param_tag(bind_type, "compare_node"),
            record_binary_field_param_tag(bind_type, "compare_edge")
        );
        13 -> combine_type_param_tags(
            record_binary_field_param_tag(bind_type, "compare_node"),
            record_binary_field_param_tag(bind_type, "compare_edge_data")
        );
        14 -> record_binary_field_param_tag(bind_type, "compare_item");
        _: int64 -> 0
    }
}

fn collection_specialization_key(bind_type: string, module_name: string) -> int64 {
    rep: int64 <- representation_id_from_module(module_name);
    case rep == 0 of {
        true -> 0;
        false -> {
            family: int64 <- public_trait_family_tag(bind_type);
            family_use: int64 <- case family == 0 of { true -> 1; false -> family };
            space: string <- collection_space_from_type(bind_type);
            st: int64 <- case length_bytes(space) == 0 of {
                true -> 1;
                false -> space_tag_from_mem_space(space)
            };
            public_tp: int64 <- collection_type_param_tag(bind_type);
            tp: int64 <- case public_tp == 0 of {
                true -> record_collection_type_param_tag(bind_type, rep);
                false -> public_tp
            };
            tp_use: int64 <- case tp == 0 of { true -> 1; false -> tp };
            (family_use * 16777216) + (rep * 65536) + (st * 256) + tp_use
        }
    }
}

fn collection_trait_accepts_module(bind_type: string, module_name: string) -> boolean {
    rep: int64 <- representation_id_from_module(module_name);
    case rep == 0 of {
        true -> false;
        false -> case is_ordered_set_type(bind_type) of {
            true -> rep == 1;
            false -> case is_search_tree_type(bind_type) of {
                true -> rep == 1;
                false -> case is_ordered_map_type(bind_type) of {
                    true -> rep == 2;
                    false -> case is_heap_type(bind_type) of {
                        true -> rep == 6 or rep == 9;
                        false -> case is_priority_queue_type(bind_type) of {
                            true -> rep == 7;
                            false -> case is_directed_graph_type(bind_type) of {
                                true -> rep == 3;
                                false -> case is_undirected_graph_type(bind_type) of {
                                    true -> rep == 4;
                                    false -> case is_weighted_graph_type(bind_type) of {
                                        true -> rep == 5;
                                        false -> case is_tree_type(bind_type) of {
                                            true -> rep == 8;
                                            false -> case is_binary_tree_type(bind_type) of {
                                                true -> rep == 14;
                                                false -> false
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn module_name_from_qualified_call(call_name: string) -> string {
    (mod_part: string, _: string) <- type_checker_core@split_module_qualified_call_name(call_name);
    mod_part
}

fn is_collection_constructor_base_name(call_name: string) -> boolean {
    base: string <- type_checker_core@user_call_base_function_name(call_name);
    base == "empty" or base == "with_root"
}

// ---------------------------------------------------------------------------
// Collection-aware structural compatibility (defect batch 2, D6/D7).
//
// A collection bracket type (OrderedSet[...], Tree[...], PriorityQueue[...], ...) resolves to the
// concrete inline record its construction module returns (common_contract.md §2). The top-level
// checks already accept that record for a bracket-typed binding; this walk applies the same rule
// wherever the bracket type sits inside a composite type: a record field
// (`r: { set: OrderedSet[string, mem(normal)], inserted: boolean } <- wbt_set@insert(s, x)`,
// ordered_set_trait.md §10), a list element, a tuple element or a function type's parameter or
// result (a supervisor child spec's `behavior`). Two spellings of the same type also meet here:
// `fn(...)` against the interner's `(...)`, named against unnamed function parameters, and
// `mem(normal)` against `normal`. A placeholder (ItemType, KeyType, ...) on either side is an
// unbound schema variable and matches any leaf, as in surface_matches_schema.
// Callers use this only after their exact checks failed, so it can widen but never narrow.

fn cat_normalize_leaf(s: string) -> string {
    t: string <- strip_all_spaces_col(s);
    replace_assoc_token_in_type(t, "mem(normal)", "normal")
}

fn cat_is_fn_type(s: string) -> boolean {
    t: string <- strip_spaces_col(s);
    arrow: int64 <- find_arrow_col_depth(t, 0, 0);
    case arrow < 0 of {
        true -> false;
        false -> starts_with_col(t, "fn(") or starts_with_col(t, "(")
    }
}

fn cat_is_tuple_type(s: string) -> boolean {
    t: string <- strip_spaces_col(s);
    case length_bytes(t) >= 2 and starts_with_col(t, "(") of {
        false -> false;
        true -> case find_arrow_col_depth(t, 0, 0) < 0 of {
            false -> false;
            true -> substring(t, length_bytes(t) - 1, length_bytes(t)) == ")"
        }
    }
}

fn cat_paren_inner(s: string) -> string {
    t: string <- strip_spaces_col(s);
    case length_bytes(t) >= 2 of {
        false -> "";
        true -> substring(t, 1, length_bytes(t) - 1)
    }
}

fn cat_is_ident_char(c: string) -> boolean {
    length_bytes(c) == 1 and contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c)
}

fn cat_all_ident_chars(s: string, i: int64) -> boolean {
    case i >= length_bytes(s) of {
        true -> true;
        false -> case cat_is_ident_char(substring(s, i, i + 1)) of {
            false -> false;
            true -> cat_all_ident_chars(s, i + 1)
        }
    }
}

fn cat_first_colon(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == ":" of {
            true -> i;
            false -> cat_first_colon(s, i + 1)
        }
    }
}

// `msg: int64` -> `int64`; an atom-union parameter type (`:a | :b`) starts with ':' and keeps it.
fn cat_strip_param_name(seg: string) -> string {
    t: string <- strip_spaces_col(seg);
    colon: int64 <- cat_first_colon(t, 0);
    case colon <= 0 of {
        true -> t;
        false -> {
            name: string <- strip_spaces_col(substring(t, 0, colon));
            case length_bytes(name) > 0 and cat_all_ident_chars(name, 0) of {
                true -> strip_spaces_col(substring(t, colon + 1, length_bytes(t)));
                false -> t
            }
        }
    }
}

fn cat_fn_params_inner(s: string) -> string {
    t0: string <- strip_spaces_col(s);
    t: string <- case starts_with_col(t0, "fn") of {
        true -> strip_spaces_col(substring(t0, 2, length_bytes(t0)));
        false -> t0
    };
    arrow: int64 <- find_arrow_col_depth(t, 0, 0);
    case arrow < 0 of {
        true -> "";
        false -> cat_paren_inner(substring(t, 0, arrow))
    }
}

fn cat_fn_result(s: string) -> string {
    t0: string <- strip_spaces_col(s);
    t: string <- case starts_with_col(t0, "fn") of {
        true -> strip_spaces_col(substring(t0, 2, length_bytes(t0)));
        false -> t0
    };
    arrow: int64 <- find_arrow_col_depth(t, 0, 0);
    case arrow < 0 of {
        true -> "";
        false -> strip_spaces_col(substring(t, arrow + 2, length_bytes(t)))
    }
}

fn cat_leaf_equal(a: string, f: string) -> boolean {
    case cat_normalize_leaf(a) == cat_normalize_leaf(f) of {
        true -> true;
        // Every placeholder name ends in "Type"; the substring test keeps the interner parse off
        // the common path.
        false -> (contains(a, "Type") and is_assoc_type_placeholder(a)) or (contains(f, "Type") and is_assoc_type_placeholder(f))
    }
}

fn collection_aware_types_compatible(actual: string, formal: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    cat_compat(actual, formal, world, 32)
}

fn cat_compat(actual: string, formal: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> boolean {
    // Printed surfaces carry spaces ("List [ ValueType , mem ( normal ) ]"); compare space-free.
    a: string <- strip_all_spaces_col(actual);
    f: string <- strip_all_spaces_col(formal);
    case fuel <= 0 or length_bytes(a) == 0 or length_bytes(f) == 0 of {
        true -> false;
        false -> case cat_leaf_equal(a, f) of {
            true -> true;
            false -> cat_compat_shapes(a, f, world, fuel)
        }
    }
}

fn cat_compat_shapes(a: string, f: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> boolean {
    a_col: boolean <- is_collection_trait_type(a);
    f_col: boolean <- is_collection_trait_type(f);
    case a_col or f_col of {
        true -> cat_compat_collection(a, f, a_col, f_col, world);
        false -> case type_checker_record_types@record_type_starts(a) and type_checker_record_types@record_type_starts(f) of {
            true -> cat_records_compatible(a, f, world, fuel);
            false -> case starts_with_col(a, "List[") and starts_with_col(f, "List[") of {
                true -> cat_lists_compatible(a, f, world, fuel);
                false -> case cat_is_fn_type(a) and cat_is_fn_type(f) of {
                    true -> cat_fns_compatible(a, f, world, fuel);
                    false -> case cat_is_tuple_type(a) and cat_is_tuple_type(f) of {
                        true -> cat_seq_compatible(cat_paren_inner(a), cat_paren_inner(f), false, world, fuel);
                        false -> type_checker_lists@formal_type_accepts_actual(a, f, world) or type_checker_lists@formal_type_accepts_actual(f, a, world)
                    }
                }
            }
        }
    }
}

fn cat_compat_collection(a: string, f: string, a_col: boolean, f_col: boolean, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    case a_col and f_col of {
        // Two bracket types: the same family with the same parameters (spellings normalized).
        true -> public_trait_family_tag(a) == public_trait_family_tag(f) and cat_normalize_leaf(a) == cat_normalize_leaf(f);
        false -> case f_col of {
            true -> type_checker_record_types@record_type_starts(a) and collection_return_accepts_constructor(f, a, world);
            false -> type_checker_record_types@record_type_starts(f) and collection_return_accepts_constructor(a, f, world)
        }
    }
}

fn cat_records_compatible(a: string, f: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> boolean {
    case type_checker_record_types@count_record_fields(a) == type_checker_record_types@count_record_fields(f) of {
        false -> false;
        true -> cat_record_fields_loop(type_checker_record_types@record_case_inner_body(f), a, world, fuel)
    }
}

fn cat_record_fields_loop(rem: string, a: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> boolean {
    case length_bytes(strip_spaces_col(rem)) == 0 of {
        true -> true;
        false -> {
            (seg: string, rest: string) <- type_checker_record_types@record_case_field_step(rem);
            (fname: string, ftype: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
            case length_bytes(fname) == 0 of {
                true -> false;
                false -> {
                    atype: string <- type_checker_record_types@find_field_type_in_record(a, fname);
                    case length_bytes(atype) == 0 of {
                        true -> false;
                        false -> case cat_compat(atype, ftype, world, fuel - 1) of {
                            false -> false;
                            true -> cat_record_fields_loop(rest, a, world, fuel)
                        }
                    }
                }
            }
        }
    }
}

fn cat_lists_compatible(a: string, f: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> boolean {
    (ok_a: boolean, ea: string, sa: string) <- type_checker_lists@parse_list_type_params(a);
    (ok_f: boolean, ef: string, sf: string) <- type_checker_lists@parse_list_type_params(f);
    case ok_a and ok_f of {
        false -> false;
        true -> case length_bytes(sa) == 0 or length_bytes(sf) == 0 or cat_normalize_leaf(sa) == cat_normalize_leaf(sf) of {
            false -> false;
            true -> cat_compat(ea, ef, world, fuel - 1)
        }
    }
}

fn cat_fns_compatible(a: string, f: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> boolean {
    case cat_seq_compatible(cat_fn_params_inner(a), cat_fn_params_inner(f), true, world, fuel) of {
        false -> false;
        true -> cat_compat(cat_fn_result(a), cat_fn_result(f), world, fuel - 1)
    }
}

// Pairwise over top-level comma-separated elements; strip_names drops `name:` prefixes (fn params).
fn cat_seq_compatible(a_inner: string, f_inner: string, strip_names: boolean, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> boolean {
    a_t: string <- strip_spaces_col(a_inner);
    f_t: string <- strip_spaces_col(f_inner);
    case length_bytes(a_t) == 0 or length_bytes(f_t) == 0 of {
        true -> length_bytes(a_t) == 0 and length_bytes(f_t) == 0;
        false -> {
            ca: int64 <- find_first_comma_depth0_col(a_t, 0, 0);
            cf: int64 <- find_first_comma_depth0_col(f_t, 0, 0);
            head_a0: string <- substring(a_t, 0, ca);
            head_f0: string <- substring(f_t, 0, cf);
            head_a: string <- case strip_names of { true -> cat_strip_param_name(head_a0); false -> head_a0 };
            head_f: string <- case strip_names of { true -> cat_strip_param_name(head_f0); false -> head_f0 };
            case cat_compat(head_a, head_f, world, fuel - 1) of {
                false -> false;
                true -> {
                    rest_a: string <- case ca >= length_bytes(a_t) of { true -> ""; false -> substring(a_t, ca + 1, length_bytes(a_t)) };
                    rest_f: string <- case cf >= length_bytes(f_t) of { true -> ""; false -> substring(f_t, cf + 1, length_bytes(f_t)) };
                    cat_seq_compatible(rest_a, rest_f, strip_names, world, fuel - 1)
                }
            }
        }
    }
}

// The bracket-constructible representation of a collection bracket type: the result record of
// the empty/with_root constructor of the registered construction module in `world` that the
// bracket family accepts (collection_trait_accepts_module). A value typed with the bracket was
// built by that constructor (or is its update result), so trait dispatch on a bracket-typed
// receiver selects the implementation whose parameter is this record, not whichever
// implementation merely carries the family's comparator witnesses. "" when none is in scope.
fn bracket_canonical_representation(bracket_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> string {
    case is_collection_trait_type(bracket_type) of {
        false -> "";
        true -> bracket_rep_scan(bracket_type, world)
    }
}

fn bracket_rep_scan(bracket_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> string {
    case world.is_nil of {
        true -> "";
        false -> case collection_trait_accepts_module(bracket_type, world.head.module_name) of {
            false -> bracket_rep_scan(bracket_type, world.tail);
            true -> {
                r: string <- bracket_rep_ctor_return(world.head.program.declarations);
                case length_bytes(r) > 0 of {
                    true -> r;
                    false -> bracket_rep_scan(bracket_type, world.tail)
                }
            }
        }
    }
}

fn bracket_rep_ctor_return(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> string {
    case decls.is_nil of {
        true -> "";
        false -> case decls.head.tag == 0 and (decls.head.name == "empty" or decls.head.name == "with_root") of {
            true -> decls.head.return_type_name;
            false -> bracket_rep_ctor_return(decls.tail)
        }
    }
}

// True when some registered construction module of this bracket family (in `world`) returns a record
// that instantiates `formal` -- the implementation parameter under test. A program may have more
// than one representation of a family in scope (the stdlib's and a trial's stub), so every one is
// tried; dispatch is unique when exactly one implementation matches one of them.
fn bracket_representation_fits_formal(bracket_type: string, formal: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    case is_collection_trait_type(bracket_type) of {
        false -> false;
        true -> brf_scan(bracket_type, formal, world)
    }
}

fn brf_scan(bracket_type: string, formal: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    case world.is_nil of {
        true -> false;
        false -> case collection_trait_accepts_module(bracket_type, world.head.module_name) of {
            false -> brf_scan(bracket_type, formal, world.tail);
            true -> {
                r: string <- bracket_rep_ctor_return(world.head.program.declarations);
                case length_bytes(r) > 0 and type_interner@surface_matches_schema(r, formal) of {
                    true -> true;
                    false -> brf_scan(bracket_type, formal, world.tail)
                }
            }
        }
    }
}
