        true -> case collection_space_has_mem_form(space) of {
            false -> type_checker_core@type_check_err("E2015", location, concat(concat("OrderedMap requires mem(Space): ", decl_type), ""), "sect4");
            true -> case fn_type_witnesses_item(key_fn_type, key) of {
                false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_key type ", key_fn_type), " does not witness OrderedMap key type "), key), ""), "sect4");
                true -> case fn_type_witnesses_item(value_fn_type, value) of {
                    false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_value type ", value_fn_type), " does not witness OrderedMap value type "), value), ""), "sect4");
                    true -> type_checker_core@type_check_ok()
                }
            }
        }
    }
}

fn witness_matches_heap_declaration(decl_type: string, witness_fn_type: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
