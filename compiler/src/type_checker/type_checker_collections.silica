fn witness_matches_weighted_graph_declaration(
    decl_type: string,
    node_fn_type: string,
    edge_data_fn_type: string,
    weight_fn_type: string,
    compare_weight_fn_type: string,
    location: { file: string, line: int64, column: int64, offset: int64 }
) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (ok: boolean, node: string, edge_data: string, weight: string, space: string) <- parse_weighted_graph_type(decl_type);
    case ok of {
        false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid WeightedGraph type declaration: ", decl_type), ""), "sect4");
        true -> case collection_space_has_mem_form(space) of {
            false -> type_checker_core@type_check_err("E2015", location, concat(concat("WeightedGraph requires mem(Space): ", decl_type), ""), "sect4");
            true -> case fn_type_witnesses_item(node_fn_type, node) of {
                false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_node type ", node_fn_type), " does not witness WeightedGraph node type "), node), ""), "sect4");
                true -> case fn_type_witnesses_item(edge_data_fn_type, edge_data) of {
                    false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_edge_data type ", edge_data_fn_type), " does not witness WeightedGraph EdgeDataType "), edge_data), ""), "sect4");
                    true -> case fn_type_witnesses_edge_target(weight_fn_type, edge_data, weight) of {
                        false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor edge_weight type ", weight_fn_type), " does not witness WeightedGraph weight type "), weight), ""), "sect4");
                        true -> case fn_type_witnesses_item(compare_weight_fn_type, weight) of {
                            false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_weight type ", compare_weight_fn_type), " does not witness WeightedGraph weight type "), weight), ""), "sect4");
                            true -> type_checker_core@type_check_ok()
                        }
                    }
                }
            }
        }
    }
}

