// BinaryTree[ItemType, mem(SpaceType)] (common_contract.md §1, binary_tree_trait.md): the
// tree_binary representation's bracket family.
fn parse_binary_tree_type(full: string) -> (boolean, string, string) {
    (ok: boolean, item: string, space: string, _: string, _: string) <- parse_bracketed_collection(full, "BinaryTree", 2);
    case ok of { true -> (true, item, space); false -> (false, "", "") }
}

fn is_binary_tree_type(s: string) -> boolean {
    (ok: boolean, _: string, _: string) <- parse_binary_tree_type(s);
    ok
}

fn is_ordered_set_type(s: string) -> boolean {
    (ok: boolean, _: string, _: string) <- parse_ordered_set_type(s);
    ok
}

fn is_ordered_map_type(s: string) -> boolean {
    (ok: boolean, _: string, _: string, _: string) <- parse_ordered_map_type(s);
