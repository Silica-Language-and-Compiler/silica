    (ok: boolean, _: string, _: string) <- parse_tree_type(s);
    ok
}

fn is_collection_trait_type(s: string) -> boolean {
    is_ordered_set_type(s) or is_ordered_map_type(s) or is_heap_type(s) or is_directed_graph_type(s)
        or is_search_tree_type(s) or is_undirected_graph_type(s) or is_weighted_graph_type(s)
        or is_priority_queue_type(s) or is_tree_type(s) or is_binary_tree_type(s)
}

fn comparator_return_type_ok(ret: string) -> boolean {
    r: string <- strip_spaces_col(ret);
    contains_less_equal_greater(r)
}

fn contains_atom_token_at(s: string, token: string, i: int64, n: int64, m: int64) -> boolean {
    case i + m > n of {
        true -> false;
        false -> case substring(s, i, i + m) == token of {
            true -> true;
            false -> contains_atom_token_at(s, token, i + 1, n, m)
        }
    }
}

fn contains_atom_token(s: string, token: string) -> boolean {
    m: int64 <- length_bytes(token);
    n: int64 <- length_bytes(s);
    case m == 0 of {
        true -> true;
        false -> contains_atom_token_at(s, token, 0, n, m)
    }
}

fn contains_less_equal_greater(s: string) -> boolean {
    contains_atom_token(s, ":less") and contains_atom_token(s, ":equal") and contains_atom_token(s, ":greater")
}

fn expected_compare_item_fn_type(item_type: string) -> string {
    item: string <- strip_spaces_col(item_type);
    concat(concat(concat("fn(", item), ", "), concat(item, ") -> :less | :equal | :greater"))
}

fn expected_compare_key_fn_type(key_type: string) -> string {
    expected_compare_item_fn_type(key_type)
}

fn expected_compare_value_fn_type(value_type: string) -> string {
    expected_compare_item_fn_type(value_type)
}

fn expected_compare_priority_fn_type(item_type: string) -> string {
    expected_compare_item_fn_type(item_type)
}

fn expected_edge_target_fn_type(edge_type: string, node_type: string) -> string {
    edge: string <- strip_spaces_col(edge_type);
    node: string <- strip_spaces_col(node_type);
    concat(concat(concat("fn(", edge), ") -> "), node)
}

fn find_arrow_col_depth(s: string, i: int64, depth: int64) -> int64 {
    case i + 2 > length_bytes(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "{" or c == "[" of {
                true -> find_arrow_col_depth(s, i + 1, depth + 1);
                false -> case c == ")" or c == "}" or c == "]" of {
                    true -> find_arrow_col_depth(s, i + 1, depth - 1);
                    false -> case depth == 0 and substring(s, i, i + 2) == "->" of {
                        true -> i;
                        false -> find_arrow_col_depth(s, i + 1, depth)
                    }
                }
            }
        }
    }
}

fn params_inner_before_arrow_col(t: string, arrow: int64) -> string {
    prefix: string <- substring(t, 0, arrow);
    case length_bytes(prefix) < 5 of {
        true -> "";
        false -> case substring(prefix, 0, 3) == "fn(" and substring(prefix, length_bytes(prefix) - 1, length_bytes(prefix)) == ")" of {
            true -> substring(prefix, 3, length_bytes(prefix) - 1);
            false -> ""
        }
    }
}

fn fn_return_after_arrow_col(fn_type: string) -> string {
    t: string <- strip_all_spaces_col(fn_type);
    arrow: int64 <- find_arrow_col_depth(t, 0, 0);
    case arrow < 0 of {
        true -> "";
        false -> strip_spaces_col(substring(t, arrow + 2, length_bytes(t)))
    }
}

fn params_inner_paren_before_arrow(t: string, arrow: int64) -> string {
    prefix: string <- substring(t, 0, arrow);
    case length_bytes(prefix) < 2 of {
        true -> "";
        false -> case substring(prefix, 0, 1) == "(" and substring(prefix, length_bytes(prefix) - 1, length_bytes(prefix)) == ")" of {
            true -> substring(prefix, 1, length_bytes(prefix) - 1);
            false -> ""
        }
    }
}

fn binary_params_from_inner(inner: string) -> (boolean, string, string) {
    comma: int64 <- find_first_comma_depth0_col(inner, 0, 0);
    case comma >= length_bytes(inner) of {
        true -> (false, "", "");
        false -> {
            left: string <- strip_spaces_col(substring(inner, 0, comma));
            right: string <- strip_spaces_col(substring(inner, comma + 1, length_bytes(inner)));
            (true, left, right)
        }
    }
}

fn parse_fn_binary_param_types(fn_type: string) -> (boolean, string, string) {
    t: string <- strip_all_spaces_col(fn_type);
    case length_bytes(t) < 5 of {
        true -> (false, "", "");
        false -> {
            arrow: int64 <- find_arrow_col_depth(t, 0, 0);
            case arrow < 0 of {
                true -> (false, "", "");
                false -> {
                    inner: string <- case substring(t, 0, 3) == "fn(" of {
                        true -> params_inner_before_arrow_col(t, arrow);
                        false -> params_inner_paren_before_arrow(t, arrow)
                    };
                    case length_bytes(inner) == 0 of {
                        true -> (false, "", "");
                        false -> binary_params_from_inner(inner)
                    }
                }
            }
        }
    }
}

fn parse_fn_unary_param_type(fn_type: string) -> (boolean, string) {
    t: string <- strip_all_spaces_col(fn_type);
    case length_bytes(t) < 5 of {
        true -> (false, "");
        false -> {
            arrow: int64 <- find_arrow_col_depth(t, 0, 0);
            case arrow < 0 of {
                true -> (false, "");
                false -> {
                    inner: string <- case substring(t, 0, 3) == "fn(" of {
                        true -> params_inner_before_arrow_col(t, arrow);
                        false -> params_inner_paren_before_arrow(t, arrow)
                    };
                    case length_bytes(inner) == 0 of {
                        true -> (false, "");
                        false -> {
                            comma: int64 <- find_first_comma_depth0_col(inner, 0, 0);
                            case comma >= length_bytes(inner) of {
                                true -> (true, strip_spaces_col(inner));
                                false -> (false, "")
                            }
                        }
                    }
                }
            }
        }
    }
}

// A collection module spells its comparator with the module's own type placeholder
// (compare_item: fn(ItemType, ItemType) -> ...), so demanding the parameter equal the
// concrete item type rejects every legitimate constructor with E2003. A placeholder is
// an unbound universally-quantified parameter: it witnesses any item type.
fn param_witnesses_item_col(param: string, item: string) -> boolean {
    case type_interner@is_placeholder_surface(param) of {
        true -> true;
        false -> type_checker_lists@types_equal_strip(param, item)
    }
}

fn fn_type_witnesses_item_with_world(fn_type: string, item_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    (ok: boolean, left: string, right: string) <- parse_fn_binary_param_types(fn_type);
    case ok of {
        false -> false;
        true -> {
            item: string <- strip_spaces_col(item_type);
            params_ok: boolean <- param_witnesses_item_col(left, item) and param_witnesses_item_col(right, item);
            case params_ok of {
                false -> false;
                true -> case type_interner@is_placeholder_surface(left) or type_interner@is_placeholder_surface(right) of {
                    true -> comparator_return_type_ok(fn_return_after_arrow_col(fn_type));
                    false -> {
                        expected: string <- expected_compare_item_fn_type(item);
                        type_checker_lists@formal_type_accepts_actual(expected, fn_type, world) or type_checker_lists@formal_type_accepts_actual(fn_type, expected, world)
                    }
                }
            }
        }
    }
}

fn record_field_fn_witnesses_item_with_world(record_type: string, field: string, item_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    ft: string <- type_checker_record_types@find_field_type_in_record(record_type, field);
    case length_bytes(ft) == 0 of {
        true -> false;
        false -> fn_type_witnesses_item_with_world(ft, item_type, world)
    }
}

fn fn_type_witnesses_item(fn_type: string, item_type: string) -> boolean {
    (ok: boolean, left: string, right: string) <- parse_fn_binary_param_types(fn_type);
    case ok of {
        false -> false;
        true -> {
            item: string <- strip_spaces_col(item_type);
            params_ok: boolean <- param_witnesses_item_col(left, item) and param_witnesses_item_col(right, item);
            case params_ok of {
                false -> false;
                true -> {
                    ret: string <- fn_return_after_arrow_col(fn_type);
                    comparator_return_type_ok(ret)
                }
            }
        }
    }
}

fn record_field_fn_witnesses_item(record_type: string, field: string, item_type: string) -> boolean {
    ft: string <- type_checker_record_types@find_field_type_in_record(record_type, field);
    case length_bytes(ft) == 0 of {
        true -> false;
        false -> fn_type_witnesses_item(ft, item_type)
    }
}

fn witness_matches_ordered_set_declaration(decl_type: string, witness_fn_type: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (ok: boolean, item: string, space: string) <- parse_ordered_set_type(decl_type);
    case ok of {
        false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid OrderedSet type declaration: ", decl_type), ""), "sect4");
        true -> case collection_space_has_mem_form(space) of {
            false -> type_checker_core@type_check_err("E2015", location, concat(concat("OrderedSet requires mem(Space): ", decl_type), ""), "sect4");
            true -> case fn_type_witnesses_item(witness_fn_type, item) of {
                false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_item type ", witness_fn_type), " does not witness OrderedSet item type "), item), ""), "sect4");
                true -> type_checker_core@type_check_ok()
            }
        }
    }
}

fn witness_matches_ordered_map_declaration(decl_type: string, key_fn_type: string, value_fn_type: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
