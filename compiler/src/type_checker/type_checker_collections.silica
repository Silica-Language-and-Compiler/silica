fn fn_type_witnesses_edge_target(fn_type: string, edge_type: string, node_type: string) -> boolean {
    (ok: boolean, param: string) <- parse_fn_unary_param_type(fn_type);
    case ok of {
        false -> false;
        true -> {
            edge: string <- strip_spaces_col(edge_type);
            node: string <- strip_spaces_col(node_type);
            // A generated record spells edge_target with the module's own placeholders
            // (fn(ValueType) -> KeyType); a placeholder witnesses any concrete type, exactly as
            // param_witnesses_item_col accepts one for the compare_* fields.
            param_ok: boolean <- param_witnesses_item_col(param, edge);
            case param_ok of {
                false -> false;
                true -> {
                    ret: string <- fn_return_after_arrow_col(fn_type);
                    param_witnesses_item_col(ret, node)
                }
            }
        }
    }
}

fn witness_matches_search_tree_declaration(decl_type: string, witness_fn_type: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (ok: boolean, item: string, space: string) <- parse_search_tree_type(decl_type);
    case ok of {
        false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid SearchTree type declaration: ", decl_type), ""), "sect4");
        true -> case collection_space_has_mem_form(space) of {
            false -> type_checker_core@type_check_err("E2015", location, concat(concat("SearchTree requires mem(Space): ", decl_type), ""), "sect4");
            true -> witness_matches_ordered_set_declaration(concat(concat(concat("OrderedSet[", item), ", "), concat(space, "]")), witness_fn_type, location)
        }
    }
}

