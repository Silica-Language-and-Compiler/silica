    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    open_at: int64 <- length_bytes(prefix) - 1;
    close: int64 <- type_interner_surface_text@find_matching_parens(t, open_at, 0);
    case close < 0 of {
        true -> type_interner_surface_leaf@parse_fail(interner);
        false -> {
            inner: string <- substring(t, open_at + 1, close);
            c1: int64 <- type_interner_surface_text@find_top_comma(inner, 0, 0, 0, 0);
            case c1 < 0 of {
                true -> type_interner_surface_leaf@parse_fail(interner);
