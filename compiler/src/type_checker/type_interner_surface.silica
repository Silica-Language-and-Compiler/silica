    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    t: string <- type_interner_surface_text@trim_type(s);
    case length_bytes(t) == 0 of {
        true -> {
            sequence
                empty_acc: List[{ name: string, ty: int64 }, mem(normal)] <- type_interner_surface_text@empty_field_list();
                fwd: List[{ name: string, ty: int64 }, mem(normal)] <- type_interner_surface_text@reverse_fields(acc, empty_acc);
                r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
