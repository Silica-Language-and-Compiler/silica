        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- type_interner_surface_leaf@parse_space_slot(er.interner, space_s);
                                                        step4: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- case sr.id == type_interner_kinds@invalid_type_id() of {
                                                            true -> sr;
                                                            false -> {
                                                                sequence
                                                                    r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- type_interner_core@mk_ordered_set(sr.interner, er.id, sr.id)
                                                                produces
                                                                    pure { interner: r.interner, id: r.id, ok: true }
                                                                end
                                                            }
                                                        }
                                                    produces
                                                        pure step4
                                                    end
                                                }
                                            }
                                        produces
                                            pure step3
                                        end
                                    }
                                }
                            produces
                                pure step2
                            end
                        }
                    }
                produces
                    pure step
                end
            }
        }
    produces
        pure out
    end
}

fn parse_fn_or_tuple(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, s: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    t0: string <- type_interner_surface_text@strip_fn_prefix(s);
    t: string <- type_interner_surface_text@trim_type(t0);
    arrow: int64 <- type_interner_surface_text@find_top_arrow(t, 0, 0, 0, 0);
    case arrow >= 0 of {
        true -> {
            left: string <- type_interner_surface_text@trim_type(substring(t, 0, arrow));
            right: string <- type_interner_surface_text@trim_type(substring(t, arrow + 2, length_bytes(t)));
            case starts_with(left, "(") of {
                false -> type_interner_surface_leaf@parse_fail(interner);
                true -> {
                    close: int64 <- type_interner_surface_text@find_matching_parens(left, 0, 0);
                    case close != length_bytes(left) - 1 of {
                        true -> type_interner_surface_leaf@parse_fail(interner);
                        false -> {
                            raw_inner: string <- substring(left, 1, close);
                            inner: string <- type_interner_surface_text@strip_named_params_work(raw_inner, "");
                            sequence
                                empty_acc: List[int64, mem(normal)] <- type_interner_core@empty_int_list();
                                pr: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, ids: List[int64, mem(normal)], ok: boolean } <- case length_bytes(type_interner_surface_text@trim_type(inner)) == 0 of {
                                    true -> { interner: interner, ids: empty_acc, ok: true };
                                    false -> parse_comma_list_acc(interner, inner, empty_acc)
                                };
                                result: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- case pr.ok of {
                                    false -> type_interner_surface_leaf@parse_fail(pr.interner);
                                    true -> {
                                        sequence
                                            params: List[int64, mem(normal)] <- type_interner_surface_text@reverse_ids(pr.ids);
                                            rr: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- parse_type_inner(pr.interner, right);
                                            out: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- case rr.ok of {
                                                false -> rr;
                                                true -> {
                                                    fr: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- type_interner_core@mk_fn(rr.interner, params, rr.id);
                                                    type_interner_surface_leaf@parse_ok(fr.interner, fr.id)
                                                }
                                            }
                                        produces
                                            pure out
                                        end
                                    }
                                }
                            produces
                                pure result
                            end
                        }
                    }
                }
            }
        };
        false -> case starts_with(t, "(") of {
            true -> {
                close: int64 <- type_interner_surface_text@find_matching_parens(t, 0, 0);
                case close != length_bytes(t) - 1 of {
                    true -> type_interner_surface_leaf@parse_fail(interner);
                    false -> {
                        inner: string <- substring(t, 1, close);
                        tin: string <- type_interner_surface_text@trim_type(inner);
                        // Parenthesized atom unions use `|` (`:a | :b`). A leading `:` with
                        // top-level commas is an atom-headed tuple (`:reply, int64, int64`).
                        case starts_with(tin, ":") and type_interner_surface_text@find_top_comma(tin, 0, 0, 0, 0) < 0 of {
                            true -> type_interner_surface_leaf@parse_atom_union_or_lit(interner, tin);
                            false -> {
                                sequence
                                    empty_acc: List[int64, mem(normal)] <- type_interner_core@empty_int_list();
                                    pr: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, ids: List[int64, mem(normal)], ok: boolean } <- case length_bytes(tin) == 0 of {
                                        true -> { interner: interner, ids: empty_acc, ok: false };
                                        false -> parse_comma_list_acc(interner, inner, empty_acc)
                                    };
                                    result: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- case pr.ok of {
                                        false -> type_interner_surface_leaf@parse_fail(pr.interner);
                                        true -> {
                                            sequence
                                                fields: List[int64, mem(normal)] <- type_interner_surface_text@reverse_ids(pr.ids);
                                                tr: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- type_interner_core@mk_tuple(pr.interner, fields);
                                                out: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- type_interner_surface_leaf@parse_ok(tr.interner, tr.id)
                                            produces
                                                pure out
                                            end
                                        }
                                    }
                                produces
                                    pure result
                                end
                            }
                        }
                    }
                }
            };
            false -> type_interner_surface_leaf@parse_fail(interner)
        }
    }
}

fn parse_type_sum_ids(
    interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
},
    parts: List[string, mem(normal)],
    acc: List[int64, mem(normal)]
) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    case parts.is_nil of {
        true -> {
            sequence
                ids: List[int64, mem(normal)] <- type_interner_surface_text@reverse_ids(acc);
                r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- type_interner_core@mk_type_sum(interner, ids);
                result: { interner: {
