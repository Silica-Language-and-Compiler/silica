        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- type_interner_core@mk_record(interner, fwd);
                result: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- type_interner_surface_leaf@parse_ok(r.interner, r.id)
            produces
                pure result
            end
        };
        false -> {
            cpos: int64 <- type_interner_surface_text@find_top_comma(t, 0, 0, 0, 0);
            piece: string <- case cpos < 0 of { true -> t; false -> substring(t, 0, cpos) };
            rest: string <- case cpos < 0 of { true -> ""; false -> substring(t, cpos + 1, length_bytes(t)) };
            colon: int64 <- type_interner_surface_text@find_colon_top(piece, 0, 0);
            case colon < 0 of {
                true -> type_interner_surface_leaf@parse_fail(interner);
                false -> {
                    fname: string <- type_interner_surface_text@trim_type(substring(piece, 0, colon));
                    fty_s: string <- type_interner_surface_text@trim_type(substring(piece, colon + 1, length_bytes(piece)));
                    tr: { interner: {
