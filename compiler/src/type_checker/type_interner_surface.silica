                    c2: int64 <- type_interner_surface_text@find_top_comma(inner, c1 + 1, 0, 0, 0);
                    case c2 < 0 of {
                        true -> type_interner_surface_leaf@parse_fail(interner);
                        false -> {
                            rgn_s: string <- type_interner_surface_text@trim_type(substring(inner, 0, c1));
                            sp_s: string <- type_interner_surface_text@trim_type(substring(inner, c1 + 1, c2));
                            pl_s: string <- type_interner_surface_text@trim_type(substring(inner, c2 + 1, length_bytes(inner)));
