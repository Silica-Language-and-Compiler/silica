        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- parse_type_inner(spr.interner, substring(inner, c2 + 1, c3));
                                            case plr.ok of {
                                                false -> plr;
                                                true -> {
                                                    size_s: string <- type_interner_surface_text@trim_type(substring(inner, c3 + 1, length_bytes(inner)));
                                                    dec: { ok: boolean, value: int64 } <- type_interner_surface_text@parse_decimal(size_s);
                                                    case dec.ok of {
                                                        true -> {
                                                            r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
