// Recursive tuple types: `rec`, `ref?(R, Space, T)`, `alloc_rec`, structural equality with occurs check.
// Authority: design_documents/recursive_tuple_specification.md; Layer 1 §7.3.

use parser_ast;
use type_checker_core;

export needs_recursive_compare/2;
export recursive_types_equal/2;
export is_ref_optional_type/1;
export ref_optional_inner_ref_type/1;
export ref_optional_atom_union/1;
export atom_fits_ref_optional_slot/2;
export ref_fits_ref_optional_slot/2;
export type_contains_rec/1;
export tuple_type_contains_rec/1;
export validate_recursive_type_declaration/2;
export validate_rec_bound/2;
export validate_alloc_rec_element_type/2;
export case_pattern_matches_ref_optional/2;

// Every helper below starts from trim_type, so this is the module's hot path, and a spelled node
// type (Q19, 2026-10-24) made its operands long: the run-by-run strip copied the whole accumulated
// prefix once per run of non-spaces (O(n * runs) bytes into the never-released string arena), and
// trim_type ran it twice per call. A surface without a space is returned as it is (no copy at all);
// one with spaces is stripped by halves (O(n log n) bytes). Same text either way.
fn strip_spaces(s: string) -> string {
    case contains(s, " ") of {
        false -> s;
        true -> strip_spaces_range(s, 0, length_bytes(s))
    }
}

fn strip_spaces_range(s: string, lo: int64, hi: int64) -> string {
    case hi - lo <= 64 of {
        true -> strip_spaces_small(s, lo, hi, "");
        false -> {
            mid: int64 <- lo + (hi - lo) / 2;
            concat(strip_spaces_range(s, lo, mid), strip_spaces_range(s, mid, hi))
        }
    }
}

// Strips [i, hi) run by run: each run of non-spaces is appended to acc (short ranges only).
fn strip_spaces_small(s: string, i: int64, hi: int64, acc: string) -> string {
    case i >= hi of {
        true -> acc;
        false -> case substring(s, i, i + 1) == " " of {
            true -> strip_spaces_small(s, i + 1, hi, acc);
            false -> {
                e: int64 <- strip_spaces_from_run_end(s, i, hi);
                strip_spaces_small(s, e, hi, concat(acc, substring(s, i, e)))
            }
        }
    }
}

fn strip_spaces_from_run_end(s: string, j: int64, n: int64) -> int64 {
    case j >= n of {
        true -> j;
        false -> case substring(s, j, j + 1) == " " of {
            true -> j;
            false -> strip_spaces_from_run_end(s, j + 1, n)
        }
    }
}

// strip_spaces leaves no space at either end, so trimming its result (which this did, with a full
// copy, after stripping twice) changes nothing: the stripped text is the trimmed text.
fn trim_type(s: string) -> string {
    strip_spaces(s)
}

fn top_level_param_count(inner: string) -> int64 {
    top_level_param_count_from(inner, 0, 0, 0)
}

// Top-level means outside every pair of (), [] and {}: a `List[E, mem(S)]` or a record `{ a: T, b: U }`
// inside a tuple holds commas of its own (before 2026-10-23 only parentheses nested, so a tuple
// `(int64, List[ref?(L, S, rec), mem(normal)])` counted three fields and never compared equal).
fn top_level_param_count_from(s: string, i: int64, depth: int64, count: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> case count == 0 of { true -> 0; false -> count + 1 };
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == "(" or ch == "[" or ch == "{" of {
                true -> top_level_param_count_from(s, i + 1, depth + 1, count);
                false -> case ch == ")" or ch == "]" or ch == "}" of {
                    true -> case depth == 0 of {
                        true -> case count == 0 of { true -> 0; false -> count + 1 };
                        false -> top_level_param_count_from(s, i + 1, depth - 1, count)
                    };
                    false -> case ch == "," of {
                        true -> case depth == 0 of {
                            true -> top_level_param_count_from(s, i + 1, 0, count + 1);
                            false -> top_level_param_count_from(s, i + 1, depth, count)
                        };
                        false -> top_level_param_count_from(s, i + 1, depth, count)
                    }
                }
            }
        }
    }
}

fn nth_top_level_param(inner: string, target: int64) -> string {
    nth_top_level_param_from(inner, 0, target, 0, 0, 0)
}

// The parameter being read is the text from `start` (just after its top-level comma) to the
// current index; it is cut out once when it ends. (Before 2026-10-25 it was rebuilt by appending
// one character at a time, which copied O(n^2) bytes of a long spelled node type.)
fn nth_top_level_param_from(s: string, i: int64, target: int64, depth: int64, idx: int64, start: int64) -> string {
    case i >= length_bytes(s) of {
        true -> case idx == target of { true -> trim_type(substring(s, start, i)); false -> "" };
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == "(" or ch == "[" or ch == "{" of {
                true -> nth_top_level_param_from(s, i + 1, target, depth + 1, idx, start);
                false -> case ch == ")" or ch == "]" or ch == "}" of {
                    true -> case depth == 0 of {
                        true -> case idx == target of { true -> trim_type(substring(s, start, i)); false -> "" };
                        false -> nth_top_level_param_from(s, i + 1, target, depth - 1, idx, start)
                    };
                    false -> case ch == "," of {
                        true -> case depth == 0 of {
                            true -> case idx == target of {
                                true -> trim_type(substring(s, start, i));
                                false -> nth_top_level_param_from(s, i + 1, target, 0, idx + 1, i + 1)
                            };
                            false -> nth_top_level_param_from(s, i + 1, target, depth, idx, start)
                        };
                        false -> nth_top_level_param_from(s, i + 1, target, depth, idx, start)
                    }
                }
            }
        }
    }
}

fn parse_ref_q_type(type_str: string) -> (boolean, string) {
    t: string <- trim_type(type_str);
    case length_bytes(t) >= 5 and substring(t, 0, 4) == "ref?" and substring(t, 4, 5) == "(" of {
        true -> case substring(t, length_bytes(t) - 1, length_bytes(t)) == ")" of {
            true -> (true, substring(t, 5, length_bytes(t) - 1));
            false -> (false, "")
        };
        // Token-joined annotation text (a sequence binding's nested type) spells `ref ?(`.
        false -> case length_bytes(t) >= 6 and substring(t, 0, 6) == "ref ?(" and substring(t, length_bytes(t) - 1, length_bytes(t)) == ")" of {
            true -> (true, substring(t, 6, length_bytes(t) - 1));
            false -> (false, "")
        }
    }
}

fn parse_ref_type(type_str: string) -> (boolean, string) {
    t: string <- trim_type(type_str);
    case length_bytes(t) >= 4 and substring(t, 0, 3) == "ref" and substring(t, 3, 4) == "(" of {
        true -> case substring(t, length_bytes(t) - 1, length_bytes(t)) == ")" of {
            true -> (true, substring(t, 4, length_bytes(t) - 1));
            false -> (false, "")
        };
        false -> (false, "")
    }
}

fn is_tuple_type(type_str: string) -> boolean {
    t: string <- trim_type(type_str);
    length_bytes(t) >= 2 and substring(t, 0, 1) == "(" and substring(t, length_bytes(t) - 1, length_bytes(t)) == ")"
}

fn tuple_inner(type_str: string) -> string {
    t: string <- trim_type(type_str);
    substring(t, 1, length_bytes(t) - 1)
}

fn third_param_type(param_list: string) -> string {
    nth_top_level_param(param_list, 2)
}

fn type_contains_rec_in_ref_params(type_str: string) -> boolean {
    (ok_q: boolean, params_q: string) <- parse_ref_q_type(type_str);
    case ok_q of {
        true -> type_contains_rec(third_param_type(params_q));
        false -> {
            (ok_r: boolean, params_r: string) <- parse_ref_type(type_str);
            case ok_r of {
                true -> type_contains_rec(third_param_type(params_r));
                false -> false
            }
        }
    }
}

fn type_contains_rec(type_str: string) -> boolean {
    t: string <- trim_type(type_str);
    case t == "rec" of {
        true -> true;
        false -> case is_tuple_type(t) of {
            true -> tuple_fields_contain_rec(tuple_inner(t));
            // A list's element may hold the `rec` (a node's children as List[ref?(L, S, rec), ...]).
            false -> case is_list_type(t) of {
                true -> type_contains_rec(list_elem_type(t));
                false -> type_contains_rec_in_ref_params(t)
            }
        }
    }
}

// The element type of `List[E, mem(S)]`: the text before the top-level comma.
fn list_elem_type(t: string) -> string {
    inner: string <- substring(t, 5, length_bytes(t) - 1);
    trim_type(substring(inner, 0, rt_top_sep(inner, 0, 0, ",")))
}

fn tuple_fields_contain_rec(inner: string) -> boolean {
    n: int64 <- top_level_param_count(inner);
    tuple_fields_contain_rec_idx(inner, 0, n)
}

fn tuple_fields_contain_rec_idx(inner: string, idx: int64, n: int64) -> boolean {
    case idx >= n of {
        true -> false;
        false -> case type_contains_rec(nth_top_level_param(inner, idx)) of {
            true -> true;
            false -> tuple_fields_contain_rec_idx(inner, idx + 1, n)
        }
    }
}

fn tuple_type_contains_rec(type_str: string) -> boolean {
    t: string <- trim_type(type_str);
    case is_tuple_type(t) of {
        true -> type_contains_rec(t);
        false -> false
    }
}

// A record holding a `rec` or `ref?` field (a structure's `{ root: ref?(L, S, rec), ... }`) needs
// the recursive compare as much as a tuple or a ref does: type_contains_rec does not look into
// records, so the text is scanned as well.
fn needs_recursive_compare(a: string, b: string) -> boolean {
    type_contains_rec(a) or type_contains_rec(b) or is_ref_optional_type(a) or is_ref_optional_type(b) or substring(trim_type(a), 0, 4) == "ref?" or substring(trim_type(b), 0, 4) == "ref?"
        or contains(a, "rec") or contains(b, "rec") or contains(a, "ref?") or contains(b, "ref?") or contains(a, "ref ?") or contains(b, "ref ?")
}

fn is_ref_optional_type(type_str: string) -> boolean {
    (ok: boolean, _inner: string) <- parse_ref_q_type(type_str);
    ok
}

fn ref_optional_inner_ref_type(type_str: string) -> string {
    (ok: boolean, inner: string) <- parse_ref_q_type(type_str);
    case ok of {
        false -> "";
        true -> {
            r: string <- trim_type(nth_top_level_param(inner, 0));
            space: string <- trim_type(nth_top_level_param(inner, 1));
            elem: string <- trim_type(nth_top_level_param(inner, 2));
            concat(concat(concat(concat("ref(", r), ", "), space), concat(", ", concat(elem, ")")))
        }
    }
}

fn ref_optional_atom_union(type_str: string) -> string {
    inner_ref: string <- ref_optional_inner_ref_type(type_str);
    case length_bytes(inner_ref) == 0 of {
        true -> "";
        false -> concat(":none|", inner_ref)
    }
}

fn atom_fits_ref_optional_slot(atom_value: string, field_type: string) -> boolean {
    case is_ref_optional_type(field_type) of {
        false -> false;
        true -> atom_value == ":none"
    }
}

fn ref_fits_ref_optional_slot(actual: string, expected: string) -> boolean {
    case is_ref_optional_type(expected) of {
        false -> false;
        true -> {
            (ok_a: boolean, params_a: string) <- parse_ref_type(actual);
            case ok_a of {
                false -> false;
                true -> {
                    (ok_e: boolean, params_e: string) <- parse_ref_q_type(expected);
                    case ok_e of {
                        false -> false;
                        true -> {
                            lr: string <- trim_type(nth_top_level_param(params_a, 0));
                            ls: string <- trim_type(nth_top_level_param(params_a, 1));
                            er: string <- trim_type(nth_top_level_param(params_e, 0));
                            es: string <- trim_type(nth_top_level_param(params_e, 1));
                            elem_a: string <- trim_type(third_param_type(params_a));
                            elem_e: string <- trim_type(third_param_type(params_e));
                            // The slot may name its element as `rec` or spell the recursive tuple out (§4.2.2).
                            lr == er and ls == es and is_tuple_type(elem_a) and type_contains_rec(elem_a) and (elem_e == "rec" or recursive_types_equal(elem_a, elem_e))
                        }
                    }
                }
            }
        }
    }
}

// An empty root means `rec` is unanchored: the compared type is not itself a recursive tuple
// (e.g. a record field or binding typed ref?(L, S, rec)), so its `rec` names whatever recursive
// tuple the value belongs to. The token then stays "rec" and equal_core matches it against any
// recursive tuple (§4.2.2: ref?(L, S, rec) and ref?(L, S, (..., ref?(L, S, rec))) are the same type
// when rec is that tuple), as ref_fits_ref_optional_slot already does for ref -> ref?.
fn expand_rec_token(type_str: string, root: string) -> string {
    case trim_type(type_str) == "rec" of {
        true -> case length_bytes(root) == 0 of {
            true -> "rec";
            false -> root
        };
        false -> type_str
    }
}

fn recursive_root_for(type_str: string) -> string {
    t: string <- trim_type(type_str);
    case is_tuple_type(t) and type_contains_rec(t) of {
        true -> t;
        false -> ""
    }
}

fn is_recursive_tuple_type(t: string) -> boolean {
    is_tuple_type(t) and type_contains_rec(t)
}

// Equality of recursive tuple types is COINDUCTIVE (equi-recursive types): `stack` holds the pairs
// of tuple types under comparison ("~a~~b~" entries), and a pair that recurs is equal by assumption.
// A raw `rec` on both sides names the enclosing tuples, which are under comparison, and is equal
// at once; only a `rec` on one side is unfolded (expand_rec_token) and compared with the other side's
// tuple, which puts that pair on the stack. So each pair of tuple texts is entered at most once per
// comparison and the work is linear in the two surfaces. Before 2026-10-23 both sides were unfolded
// at every `rec` slot until the depth cut, which cost k^16 tuple comparisons for a shape with k `rec`
// slots (13 s for a two-slot node; the wbt_map node spelled out never finished). The depth cut is
// kept only as a safety net.
fn recursive_types_equal(a: string, b: string) -> boolean {
    // An interner surface spells its tokens apart (`ref ? ( L , normal , rec )`); the parsers here
    // read the compact spelling, so both sides are compacted first.
    ta: string <- rt_strip_spaces(trim_type(a), 0, "");
    tb: string <- rt_strip_spaces(trim_type(b), 0, "");
    root_a: string <- recursive_root_for(ta);
    root_b: string <- recursive_root_for(tb);
    equal_core(ta, tb, root_a, root_b, 0, "")
}

// Both callers pass trim_type's result, which holds no space; only a tab or a newline is left to
// drop, and almost no surface has one, so the text is returned without the character-by-character
// copy (O(n^2) bytes per call on a spelled node type).
fn rt_strip_spaces(s: string, i: int64, acc: string) -> string {
    case i == 0 and length_bytes(acc) == 0 of {
        false -> rt_strip_spaces_each(s, i, acc);
        true -> case contains(s, " ") or contains(s, "\t") or contains(s, "\n") of {
            false -> s;
            true -> rt_strip_spaces_each(s, i, acc)
        }
    }
}

fn rt_strip_spaces_each(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == " " or c == "\t" or c == "\n" of {
                true -> rt_strip_spaces_each(s, i + 1, acc);
                false -> rt_strip_spaces_each(s, i + 1, concat(acc, c))
            }
        }
    }
}

fn equal_core(a: string, b: string, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    case depth > 64 of {
        true -> true;
        false -> {
            ta: string <- trim_type(a);
            tb: string <- trim_type(b);
            case ta == "rec" and tb == "rec" of {
                true -> true;
                false -> {
                    ea: string <- expand_rec_token(ta, root_a);
                    eb: string <- expand_rec_token(tb, root_b);
                    case (ea == "rec" and is_recursive_tuple_type(eb)) or (eb == "rec" and is_recursive_tuple_type(ea)) of {
                        true -> true;
                        false -> case is_ref_optional_type(ea) or is_ref_optional_type(eb) of {
                            true -> equal_ref_optional(ea, eb, root_a, root_b, depth, stack);
                            false -> equal_non_optional_types(ea, eb, root_a, root_b, depth, stack)
                        }
                    }
                }
            }
        }
    }
}

fn equal_non_optional_types(ea: string, eb: string, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    (ok_a: boolean, params_a: string) <- parse_ref_type(ea);
    case ok_a of {
        true -> {
            (ok_b: boolean, params_b: string) <- parse_ref_type(eb);
            case ok_b of {
                true -> equal_ref_params(params_a, params_b, root_a, root_b, depth, stack);
                false -> false
            }
        };
        // A function type is spelled `fn(A) -> R` by a declaration and `(A) -> R` by an interner
        // surface; the two spellings are one type.
        false -> case is_fn_type(ea) and is_fn_type(eb) of {
            true -> rt_drop_fn_prefix(ea) == rt_drop_fn_prefix(eb);
            // A list inside a node compares by its element type, under the same `rec` binder:
            // `List[ref?(L, S, rec), mem(normal)]` inside node N is `List[ref?(L, S, N), mem(normal)]`
            // (a List is not a tuple, so `rec` still names the innermost enclosing tuple).
            false -> case is_list_type(ea) and is_list_type(eb) of {
            true -> equal_list_types(ea, eb, root_a, root_b, depth, stack);
            false -> case is_tuple_type(ea) and is_tuple_type(eb) of {
            true -> equal_tuple_types(ea, eb, root_a, root_b, depth, stack);
            // Two records are compared field by field, so a field spelled `ref?(L, S, rec)` on one
            // side and `ref?(L, S, (..., ref?(L, S, rec)))` on the other (a bound caller against the
            // stdlib's unbound root, or the reverse) is one type (§4.2.2). Names and order must agree.
            false -> case is_record_type(ea) and is_record_type(eb) of {
                true -> equal_record_types(ea, eb, root_a, root_b, depth, stack);
                false -> ea == eb
            }
        }
        }
        }
    }
}

// `List[E, S]`: the element through equal_core, the space textually.
fn is_list_type(t: string) -> boolean {
    length_bytes(t) >= 6 and substring(t, 0, 5) == "List[" and substring(t, length_bytes(t) - 1, length_bytes(t)) == "]"
}

fn equal_list_types(ea: string, eb: string, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    ia: string <- substring(ea, 5, length_bytes(ea) - 1);
    ib: string <- substring(eb, 5, length_bytes(eb) - 1);
    ca: int64 <- rt_top_sep(ia, 0, 0, ",");
    cb: int64 <- rt_top_sep(ib, 0, 0, ",");
    case trim_type(substring(ia, ca, length_bytes(ia))) == trim_type(substring(ib, cb, length_bytes(ib))) of {
        false -> false;
        true -> equal_core(substring(ia, 0, ca), substring(ib, 0, cb), root_a, root_b, depth + 1, stack)
    }
}

// `fn(A) -> R`, or `(A) -> R` with the arrow at nesting depth zero after the parameter list.
fn is_fn_type(t: string) -> boolean {
    case length_bytes(t) >= 3 and substring(t, 0, 3) == "fn(" of {
        true -> true;
        false -> case length_bytes(t) >= 1 and substring(t, 0, 1) == "(" of {
            true -> {
                close: int64 <- rt_matching_close(t, 1, 1);
                close + 3 <= length_bytes(t) and substring(t, close + 1, close + 3) == "->"
            };
            false -> false
        }
    }
}

// Index of the `)` that closes the paren before i (depth counts the parens open at i).
fn rt_matching_close(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> length_bytes(s);
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> rt_matching_close(s, i + 1, depth + 1);
                false -> case c == ")" of {
                    true -> case depth == 1 of {
                        true -> i;
                        false -> rt_matching_close(s, i + 1, depth - 1)
                    };
                    false -> rt_matching_close(s, i + 1, depth)
                }
            }
        }
    }
}

fn rt_drop_fn_prefix(t: string) -> string {
    case length_bytes(t) >= 3 and substring(t, 0, 3) == "fn(" of {
        true -> substring(t, 2, length_bytes(t));
        false -> t
    }
}

fn equal_ref_optional(a: string, b: string, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    case is_ref_optional_type(a) and is_ref_optional_type(b) of {
        true -> {
            (ok_a: boolean, inner_a: string) <- parse_ref_q_type(a);
            (ok_b: boolean, inner_b: string) <- parse_ref_q_type(b);
            case ok_a and ok_b of {
                false -> false;
                true -> equal_ref_params(inner_a, inner_b, root_a, root_b, depth, stack)
            }
        };
        false -> false
    }
}

fn equal_ref_params(inner_a: string, inner_b: string, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    case nth_top_level_param(inner_a, 0) == nth_top_level_param(inner_b, 0) of {
        false -> false;
        true -> case nth_top_level_param(inner_a, 1) == nth_top_level_param(inner_b, 1) of {
            false -> false;
            true -> equal_core(nth_top_level_param(inner_a, 2), nth_top_level_param(inner_b, 2), root_a, root_b, depth + 1, stack)
        }
    }
}

fn equal_tuple_types(a: string, b: string, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    key: string <- concat("~", concat(trim_type(a), concat("~~", concat(trim_type(b), "~"))));
    case contains(stack, key) of {
        true -> true;
        false -> {
            new_root_a: string <- case type_contains_rec(a) of { true -> a; false -> root_a };
            new_root_b: string <- case type_contains_rec(b) of { true -> b; false -> root_b };
            inner_a: string <- tuple_inner(a);
            inner_b: string <- tuple_inner(b);
            n_a: int64 <- top_level_param_count(inner_a);
            n_b: int64 <- top_level_param_count(inner_b);
            case n_a == n_b of {
                false -> false;
                true -> equal_tuple_fields_idx(inner_a, inner_b, 0, n_a, new_root_a, new_root_b, depth + 1, concat(stack, key))
            }
        }
    }
}

fn equal_tuple_fields_idx(inner_a: string, inner_b: string, idx: int64, n: int64, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    case idx >= n of {
        true -> true;
        false -> case equal_core(nth_top_level_param(inner_a, idx), nth_top_level_param(inner_b, idx), root_a, root_b, depth, stack) of {
            false -> false;
            true -> equal_tuple_fields_idx(inner_a, inner_b, idx + 1, n, root_a, root_b, depth, stack)
        }
    }
}

// ---- records, field by field ---------------------------------------------------------------------

fn is_record_type(type_str: string) -> boolean {
    t: string <- trim_type(type_str);
    length_bytes(t) >= 2 and substring(t, 0, 1) == "{" and substring(t, length_bytes(t) - 1, length_bytes(t)) == "}"
}

// Index of the first `sep` at nesting depth zero (over (), [], {}) at or after i, or the length.
fn rt_top_sep(s: string, i: int64, depth: int64, sep: string) -> int64 {
    case i >= length_bytes(s) of {
        true -> length_bytes(s);
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> rt_top_sep(s, i + 1, depth + 1, sep);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> rt_top_sep(s, i + 1, depth - 1, sep);
                    false -> case c == sep and depth == 0 of {
                        true -> i;
                        false -> rt_top_sep(s, i + 1, depth, sep)
                    }
                }
            }
        }
    }
}

fn equal_record_types(ea: string, eb: string, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    ta: string <- trim_type(ea);
    tb: string <- trim_type(eb);
    equal_record_fields(substring(ta, 1, length_bytes(ta) - 1), 0, substring(tb, 1, length_bytes(tb) - 1), 0, root_a, root_b, depth + 1, stack)
}

fn equal_record_fields(ca: string, ia: int64, cb: string, ib: int64, root_a: string, root_b: string, depth: int64, stack: string) -> boolean {
    case ia >= length_bytes(ca) or ib >= length_bytes(cb) of {
        true -> ia >= length_bytes(ca) and ib >= length_bytes(cb);
        false -> {
            ea_end: int64 <- rt_top_sep(ca, ia, 0, ",");
            eb_end: int64 <- rt_top_sep(cb, ib, 0, ",");
            seg_a: string <- substring(ca, ia, ea_end);
            seg_b: string <- substring(cb, ib, eb_end);
            colon_a: int64 <- rt_top_sep(seg_a, 0, 0, ":");
            colon_b: int64 <- rt_top_sep(seg_b, 0, 0, ":");
            case colon_a >= length_bytes(seg_a) or colon_b >= length_bytes(seg_b) of {
                true -> trim_type(seg_a) == trim_type(seg_b);
                false -> case trim_type(substring(seg_a, 0, colon_a)) == trim_type(substring(seg_b, 0, colon_b)) of {
                    false -> false;
                    true -> case equal_core(substring(seg_a, colon_a + 1, length_bytes(seg_a)), substring(seg_b, colon_b + 1, length_bytes(seg_b)), root_a, root_b, depth, stack) of {
                        false -> false;
                        true -> equal_record_fields(ca, ea_end + 1, cb, eb_end + 1, root_a, root_b, depth, stack)
                    }
                }
            }
        }
    }
}

fn has_non_rec_base_in_ref_params(type_str: string) -> boolean {
    (ok_q: boolean, params_q: string) <- parse_ref_q_type(type_str);
    case ok_q of {
        true -> has_non_rec_base(third_param_type(params_q));
        false -> {
            (ok_r: boolean, params_r: string) <- parse_ref_type(type_str);
            case ok_r of {
                true -> has_non_rec_base(third_param_type(params_r));
                false -> true
            }
        }
    }
}

fn has_non_rec_base(type_str: string) -> boolean {
    t: string <- trim_type(type_str);
    case t == "rec" of {
        true -> false;
        false -> case is_tuple_type(t) of {
            true -> tuple_has_non_rec_base(tuple_inner(t));
            false -> has_non_rec_base_in_ref_params(t)
        }
    }
}

fn tuple_has_non_rec_base(inner: string) -> boolean {
    n: int64 <- top_level_param_count(inner);
    tuple_has_non_rec_base_idx(inner, 0, n)
}

fn tuple_has_non_rec_base_idx(inner: string, idx: int64, n: int64) -> boolean {
    case idx >= n of {
        true -> false;
        false -> case has_non_rec_base(nth_top_level_param(inner, idx)) of {
            true -> true;
            false -> tuple_has_non_rec_base_idx(inner, idx + 1, n)
        }
    }
}

fn recursive_type_subject(type_str: string) -> string {
    t: string <- trim_type(type_str);
    (ok_ref: boolean, ref_params: string) <- parse_ref_type(t);
    case ok_ref of {
        true -> nth_top_level_param(ref_params, 2);
        // ref?(L, S, T) as a binding annotation (§4.2.2) is checked on its element like ref(L, S, T), so
        // the spelled form ref?(L, S, (..., ref?(L, S, rec))) is accepted. A bare `rec` element keeps the
        // whole type as subject: outside a tuple type `rec` has no enclosing tuple to name (§4.2.2
        // "rec is valid only inside a tuple type"), so the binding is rejected with E2010.
        false -> {
            (ok_q: boolean, q_params: string) <- parse_ref_q_type(t);
            case ok_q and trim_type(nth_top_level_param(q_params, 2)) != "rec" of {
                true -> nth_top_level_param(q_params, 2);
                // A list binding is checked on its element the same way: `List[ref?(L, S, (..., rec)),
                // mem(S)]` names the element's tuple, while `List[rec, mem(S)]` has no tuple to name.
                false -> case is_list_type(t) and trim_type(list_elem_type(t)) != "rec" of {
                    true -> recursive_type_subject(list_elem_type(t));
                    false -> t
                }
            }
        }
    }
}

fn validate_recursive_type_declaration(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    subject: string <- recursive_type_subject(type_str);
    case trim_type(subject) == "rec" of {
        true -> type_checker_core@type_check_ok();
        false -> case type_contains_rec(subject) of {
            false -> case is_ref_optional_type(subject) of {
                true -> validate_ref_q_type(subject, location);
                false -> type_checker_core@type_check_ok()
            };
            true -> case is_tuple_type(subject) of {
                false -> type_checker_core@type_check_err("E2010", location, concat("rec is valid only inside tuple types, got ", type_str), "recursive_tuple§2");
                true -> case has_non_rec_base(subject) of {
                    false -> type_checker_core@type_check_err("E2010", location, concat("unguarded recursive tuple type lacks a non-recursive base: ", type_str), "recursive_tuple§3");
                    true -> validate_ref_q_in_type(subject, location)
                }
            }
        }
    }
}

fn validate_ref_q_in_type(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    t: string <- trim_type(type_str);
    case is_ref_optional_type(t) of {
        true -> validate_ref_q_type(t, location);
        false -> case is_tuple_type(t) of {
            true -> validate_ref_q_fields(tuple_inner(t), location);
            false -> type_checker_core@type_check_ok()
        }
    }
}

fn validate_ref_q_fields(inner: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    n: int64 <- top_level_param_count(inner);
    validate_ref_q_fields_idx(inner, 0, n, location)
}

fn validate_ref_q_fields_idx(inner: string, idx: int64, n: int64, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case idx >= n of {
        true -> type_checker_core@type_check_ok();
        false -> {
            r1: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- validate_ref_q_in_type(nth_top_level_param(inner, idx), location);
            case r1.is_ok of {
                false -> r1;
                true -> validate_ref_q_fields_idx(inner, idx + 1, n, location)
            }
        }
    }
}

fn validate_ref_q_type(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (ok: boolean, inner: string) <- parse_ref_q_type(type_str);
    case ok of {
        false -> type_checker_core@type_check_err("E2010", location, concat("invalid ref? type: ", type_str), "recursive_tuple§2");
        true -> case length_bytes(nth_top_level_param(inner, 0)) == 0 or length_bytes(nth_top_level_param(inner, 1)) == 0 or length_bytes(nth_top_level_param(inner, 2)) == 0 of {
            true -> type_checker_core@type_check_err("E2010", location, "ref?(R, Space, T) requires three parameters", "recursive_tuple§2");
            false -> validate_recursive_type_declaration(nth_top_level_param(inner, 2), location)
        }
    }
}

fn validate_alloc_rec_element_type(elem_type: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case tuple_type_contains_rec(elem_type) of {
        false -> type_checker_core@type_check_err("E2010", location, concat("alloc_rec element type must be a recursive tuple, got ", elem_type), "recursive_tuple§2.3");
        true -> validate_recursive_type_declaration(elem_type, location)
    }
}

fn ref_types_equal_for_case(inner_ref: string, pattern_ref: string) -> boolean {
    (ok_i: boolean, params_i: string) <- parse_ref_type(inner_ref);
    (ok_p: boolean, params_p: string) <- parse_ref_type(pattern_ref);
    case ok_i and ok_p of {
        false -> recursive_types_equal(inner_ref, pattern_ref);
        true -> case nth_top_level_param(params_i, 0) == nth_top_level_param(params_p, 0) of {
            false -> false;
            true -> case nth_top_level_param(params_i, 1) == nth_top_level_param(params_p, 1) of {
                false -> false;
                true -> {
                    elem_i: string <- trim_type(nth_top_level_param(params_i, 2));
                    elem_p: string <- trim_type(nth_top_level_param(params_p, 2));
                    case elem_i == "rec" of {
                        true -> is_tuple_type(elem_p) and type_contains_rec(elem_p) and has_non_rec_base(elem_p);
                        false -> recursive_types_equal(elem_i, elem_p)
                    }
                }
            }
        }
    }
}

fn case_pattern_matches_ref_optional(scrutinee_type: string, pattern_type: string) -> boolean {
    case is_ref_optional_type(scrutinee_type) of {
        false -> ref_types_equal_for_case(scrutinee_type, pattern_type);
        true -> case trim_type(pattern_type) == "atom" of {
            true -> true;
            false -> {
                inner: string <- ref_optional_inner_ref_type(scrutinee_type);
                ref_types_equal_for_case(inner, pattern_type)
            }
        }
    }
}

// ---- Q19: an unbound `rec` is E2010 in every position ---------------------------------------------
//
// data_structure_redesign_requirements.md §2 row Q19 and decision 38; chunk15_stack_memory_design.md
// §5.1 and §11.1 phase 0 (2026-10-24). `rec` binds to its innermost enclosing TUPLE TYPE, so a `rec`
// with no enclosing tuple type names no layout: it is rejected in binding annotations, record
// fields, parameter and return types, case-pattern and tuple-pattern annotations alike. A tuple type
// is `(A, B, ...)`; the parentheses of ref?(...), ref(...), fn(...), buf(...), region(...) and of any
// other constructor are not tuples, and a record `{ ... }` or a `List[...]` is looked through to the
// tuple around it (so `List[ref?(L, S, rec), mem(S)]` inside a node tuple is bound to that node).
// The check is a single left-to-right walk of the type text with a stack of the open brackets; it
// runs only on types that mention `rec`.
fn validate_rec_bound(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case contains(type_str, "rec") of {
        false -> type_checker_core@type_check_ok();
        true -> case rec_unbound_at(type_str, 0, "", length_bytes(type_str)) of {
            false -> type_checker_core@type_check_ok();
            true -> type_checker_core@type_check_err("E2010", location, concat("rec is valid only inside tuple types, got ", type_str), "recursive_tuple§2")
        }
    }
}

// The open brackets so far: "t" a tuple paren, "c" a constructor's paren, "[" and "{". True when a
// `rec` token appears with no "t" open.
fn rec_unbound_at(s: string, i: int64, stack: string, n: int64) -> boolean {
    case i >= n of {
        true -> false;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> rec_unbound_at(s, i + 1, concat(stack, case rec_paren_is_tuple(s, i) of { true -> "t"; false -> "c" }), n);
                false -> case c == "[" or c == "{" of {
                    true -> rec_unbound_at(s, i + 1, concat(stack, c), n);
                    false -> case c == ")" or c == "]" or c == "}" of {
                        true -> rec_unbound_at(s, i + 1, rec_stack_pop(stack), n);
                        false -> case c == "r" and rec_token_at(s, i, n) of {
                            true -> case contains(stack, "t") of {
                                true -> rec_unbound_at(s, i + 3, stack, n);
                                false -> true
                            };
                            false -> rec_unbound_at(s, i + 1, stack, n)
                        }
                    }
                }
            }
        }
    }
}

fn rec_stack_pop(stack: string) -> string {
    case length_bytes(stack) == 0 of {
        true -> stack;
        false -> substring(stack, 0, length_bytes(stack) - 1)
    }
}

fn rec_is_ident_char(c: string) -> boolean {
    length_bytes(c) == 1 and contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c)
}

// `rec` at i as a whole word (not `record`, `recent`, `prec`).
fn rec_token_at(s: string, i: int64, n: int64) -> boolean {
    case i + 3 > n or substring(s, i, i + 3) != "rec" of {
        true -> false;
        false -> case i > 0 and rec_is_ident_char(substring(s, i - 1, i)) of {
            true -> false;
            false -> case i + 3 < n and rec_is_ident_char(substring(s, i + 3, i + 4)) of {
                true -> false;
                false -> true
            }
        }
    }
}

// A `(` is a tuple's unless an identifier or `?` precedes it (ref?(, ref(, fn(, buf(, region(, a name).
fn rec_paren_is_tuple(s: string, i: int64) -> boolean {
    j: int64 <- rec_prev_nonspace(s, i - 1);
    case j < 0 of {
        true -> true;
        false -> {
            p: string <- substring(s, j, j + 1);
            case p == "?" or rec_is_ident_char(p) of {
                true -> false;
                false -> true
            }
        }
    }
}

fn rec_prev_nonspace(s: string, j: int64) -> int64 {
    case j < 0 of {
        true -> 0 - 1;
        false -> {
            c: string <- substring(s, j, j + 1);
            case c == " " or c == "\t" or c == "\n" or c == "\r" of {
                true -> rec_prev_nonspace(s, j - 1);
                false -> j
            }
        }
    }
}
