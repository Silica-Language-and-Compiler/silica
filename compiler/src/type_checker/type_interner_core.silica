fn list_int_reverse(xs: List[int64, mem(normal)], acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                next: List[int64, mem(normal)] <- prepend[int64, mem(normal)](xs.head, acc);
                result: List[int64, mem(normal)] <- list_int_reverse(xs.tail, next)
            produces
                pure result
            end
        }
    }
}

fn empty_int_list() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure result
    end
}

