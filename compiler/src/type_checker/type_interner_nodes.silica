// Type DAG node accessors (kind / a / b / c by id) and type-id equality. Split from
// type_interner.silica so the expression checkers that only read nodes load a small interface;
// the interner itself is in type_interner_core.

export types_equal/2;
export node_kind/2;
export node_a/2;
export node_b/2;
export node_c/2;
export seq_nil_id/1;

// Used by the other type_interner_* modules.
export nodes_at/2;

// The interner's node list is stored NEWEST-FIRST (nodes_append prepends), so node id `idx`
// is element n-1-idx from the head. list_nth is the allocation-free chunk walk; the old form
// recursed with remove_head per step (a 40 B handle each) and re-measured the list every step:
// 15.9 M allocations / 0.64 GB while type-checking emitter_core.
fn nodes_at(nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], idx: int64) -> { kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean } {
    n: int64 <- nodes_len_ti(nodes);
    case idx < 0 or idx >= n of {
        true -> { kind: 0, arg_a: 0, arg_b: 0, arg_c: 0, buf_size_is_name: false };
        false -> list_nth(nodes, n - 1 - idx)
    }
}

fn nodes_len_ti(nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- length[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)](nodes)
    produces
        pure n
    end
}

fn seq_nil_id(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}) -> int64 {
    interner.seq_nil_id
}

fn types_equal(a: int64, b: int64) -> boolean {
    a == b
}

fn node_kind(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> int64 {
    case id < 0 of {
        true -> 0;
        false -> case id >= interner.next_id of {
            true -> 0;
            false -> {
                sequence
                    n: { kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean } <- nodes_at(interner.nodes, id);
                    k: int64 <- n.kind
                produces
                    pure k
                end
            }
        }
    }
}

fn node_a(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> int64 {
    case id < 0 or id >= interner.next_id of {
        true -> 0;
        false -> {
            sequence
                n: { kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean } <- nodes_at(interner.nodes, id);
                v: int64 <- n.arg_a
            produces
                pure v
            end
        }
    }
}

