fn parse_type_remember(parsed: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean }, surface: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    case parsed.ok of {
        false -> parsed;
        true -> {
            sequence
                names1: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    } <- type_interner_core@repair_string_int_map(parsed.interner.names);
                r: :unchanged | (:inserted, {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }) | (:replaced, {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }) <- wbt_map@insert(names1, type_interner_surface_text@memo_key(surface), parsed.id);
                names2: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- case r of {
                    :unchanged -> names1;
                    (:inserted, m_ins: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> m_ins;
                    (:replaced, m_rep: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> m_rep
                };
                done: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- { interner: { nodes: parsed.interner.nodes, by_key: parsed.interner.by_key, names: names2, name_lexemes: parsed.interner.name_lexemes, next_id: parsed.interner.next_id, seq_nil_id: parsed.interner.seq_nil_id }, id: parsed.id, ok: true }
            produces
                pure done
            end
        }
    }
}

fn space_kind_of(name: string) -> int64 {
    case name of {
        "normal" -> type_interner_kinds@kind_space_normal();
        "normal_writeback" -> type_interner_kinds@kind_space_normal_writeback();
        "normal_writethrough" -> type_interner_kinds@kind_space_normal_writethrough();
        "normal_noncacheable" -> type_interner_kinds@kind_space_normal_noncacheable();
        "atomic" -> type_interner_kinds@kind_space_atomic();
        "device" -> type_interner_kinds@kind_space_device();
        _: string -> 0 - 1
    }
}

fn base_kind_of(name: string) -> int64 {
    case name of {
        "unit" -> type_interner_kinds@kind_unit();
        "boolean" -> type_interner_kinds@kind_boolean();
        "bool" -> type_interner_kinds@kind_boolean();
        "int8" -> type_interner_kinds@kind_int8();
        "int16" -> type_interner_kinds@kind_int16();
        "int32" -> type_interner_kinds@kind_int32();
        "int64" -> type_interner_kinds@kind_int64();
        "int" -> type_interner_kinds@kind_int64();
        "uint8" -> type_interner_kinds@kind_uint8();
        "uint16" -> type_interner_kinds@kind_uint16();
        "uint32" -> type_interner_kinds@kind_uint32();
        "uint64" -> type_interner_kinds@kind_uint64();
        "float16" -> type_interner_kinds@kind_float16();
        "float32" -> type_interner_kinds@kind_float32();
        "float64" -> type_interner_kinds@kind_float64();
        "float" -> type_interner_kinds@kind_float64();
        "char" -> type_interner_kinds@kind_char();
        "string" -> type_interner_kinds@kind_string();
        "atom" -> type_interner_kinds@kind_atom();
        "lifetime" -> type_interner_kinds@kind_lifetime();
        "discard" -> type_interner_kinds@kind_discard();
        "rec" -> type_interner_kinds@kind_rec();
        "Collectable" -> type_interner_kinds@kind_collectable();
        "ActorMessage" -> type_interner_kinds@kind_actor_message();
        "actor_ref" -> type_interner_kinds@kind_actor_ref();
        "dangerous_actor_ref" -> type_interner_kinds@kind_dangerous_actor_ref();
        "device_actor_ref" -> type_interner_kinds@kind_device_actor_ref();
        "timer_ref" -> type_interner_kinds@kind_timer_ref();
        "supervisor_ref" -> type_interner_kinds@kind_supervisor_ref();
        "monitor_ref" -> type_interner_kinds@kind_monitor_ref();
        "supervisor_flags" -> type_interner_kinds@kind_supervisor_flags();
        "failure_reason" -> type_interner_kinds@kind_failure_reason();
        "child_spec" -> type_interner_kinds@kind_child_spec();
        "stack_policy" -> type_interner_kinds@kind_stack_policy();
        "state_policy" -> type_interner_kinds@kind_state_policy();
        "cpu_topology" -> type_interner_kinds@kind_cpu_topology();
        "core_info" -> type_interner_kinds@kind_core_info();
        "numa_info" -> type_interner_kinds@kind_numa_info();
        "memory_range" -> type_interner_kinds@kind_memory_range();
        "cache_info" -> type_interner_kinds@kind_cache_info();
        "cache_level" -> type_interner_kinds@kind_cache_level();
        "ItemType" -> type_interner_kinds@kind_ph_item_type();
        "KeyType" -> type_interner_kinds@kind_ph_key_type();
        "ValueType" -> type_interner_kinds@kind_ph_value_type();
        "SpaceType" -> type_interner_kinds@kind_ph_space_type();
        "SetType" -> type_interner_kinds@kind_ph_set_type();
        "MapType" -> type_interner_kinds@kind_ph_map_type();
        "HeapType" -> type_interner_kinds@kind_ph_heap_type();
        "GraphType" -> type_interner_kinds@kind_ph_graph_type();
        "QueueType" -> type_interner_kinds@kind_ph_queue_type();
        "TreeType" -> type_interner_kinds@kind_ph_tree_type();
