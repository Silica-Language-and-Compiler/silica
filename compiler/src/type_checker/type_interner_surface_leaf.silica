        "PriorityType" -> type_interner_kinds@kind_ph_priority_type();
        "WeightType" -> type_interner_kinds@kind_ph_weight_type();
        "AccType" -> type_interner_kinds@kind_ph_acc_type();
        "normal" -> type_interner_kinds@kind_space_normal();
        "normal_writeback" -> type_interner_kinds@kind_space_normal_writeback();
        "normal_writethrough" -> type_interner_kinds@kind_space_normal_writethrough();
        "normal_noncacheable" -> type_interner_kinds@kind_space_normal_noncacheable();
