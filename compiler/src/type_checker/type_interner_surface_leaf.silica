        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- type_interner_core@mk_atom_lit(interner, parts.head);
                        parse_ok(r.interner, r.id)
                    };
                    false -> {
                        sequence
                            empty_acc: List[string, mem(normal)] <- type_interner_surface_text@empty_string_list();
                            fwd: List[string, mem(normal)] <- type_interner_surface_text@reverse_strings(parts, empty_acc);
                            r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
