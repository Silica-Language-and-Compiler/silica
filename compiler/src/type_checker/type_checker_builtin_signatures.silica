// Single authority for built-in name -> type facts.
//
// Before this, negate_builtin_operand_type (type_checker_tuple_decompose_helpers) and
// negate_builtin_arg_type (type_checker_expressions_print_negate) were byte-identical
// copies of one table, and the string-builtin return table sat beside a deeply nested
// inline cascade doing the same kind of mapping. Two copies of one table is how a single
// name acquires two meanings -- the shape of the wbt_set/wbt_map field-name corruption.
//
// Returns "" for a name that is not a built-in here, so membership is length_bytes(..) > 0.
//
// Deliberately NOT here: built-ins whose result depends on the call expression or on
// another module -- call_supervisor, core_id, core_set, and the actor runtime table.
// They stay with the code that can answer them.

export builtin_operand_type/1;
export builtin_string_return_type/1;
export builtin_return_type/1;
export is_string_io_builtin/1;

// negate_<T> takes and returns <T>, so this is both the operand type and the return type.
fn builtin_operand_type(name: string) -> string {
    case name of {
        "negate_int8" -> "int8";
        "negate_int16" -> "int16";
        "negate_int32" -> "int32";
        "negate_int64" -> "int64";
        "negate_float16" -> "float16";
        "negate_float32" -> "float32";
        "negate_float64" -> "float64";
        _: string -> ""
    }
}

fn builtin_string_return_type(name: string) -> string {
    case name of {
        "starts_with" -> "boolean";
        "ends_with" -> "boolean";
        "contains" -> "boolean";
        "concat" -> "string";
        "concatenate" -> "string";
        "substring" -> "string";
        "substring_until_char" -> "string";
        "len" -> "int64";
        "length_bytes" -> "int64";
        "length_chars" -> "int64";
        _: string -> ""
    }
}

fn builtin_actor_return_type(name: string) -> string {
    case name of {
        "spawn" -> "actor_ref";
        "spawn_registered" -> "actor_ref";
        "spawn_dangerous" -> "dangerous_actor_ref";
        "spawn_dangerous_registered" -> "dangerous_actor_ref";
        "spawn_device" -> "device_actor_ref";
        "spawn_device_registered" -> "device_actor_ref";
        "cast_device" -> "boolean";
        "cast_device_registered" -> "boolean";
        "spawn_registered_supervisor" -> "supervisor_ref";
        "link" -> "atom";
        "add_child" -> "atom";
        "monitor" -> "monitor_ref";
        "demonitor" -> "atom";
        "self" -> "actor_ref";
        // Clocks and timers (spec §22.14).
        "monotonic_time" -> "int64";
        "current_time" -> "int64";
        "send_after" -> "timer_ref";
        "cancel_timer" -> "atom";
        // §15.1.2.2 stack policy constructor: a scalar of the built-in type stack_policy.
        "stack_policy" -> "stack_policy";
        "cast" -> "boolean";
        "send" -> "atom";
        // Actor reference identity comparison (spec 7.4, 15.1.4, 22.4): pure, boolean result.
        "actor_ref_equal" -> "boolean";
        "actor_ref_not_equal" -> "boolean";
        // actor_id(ref) -> uint64: the identity a reference denotes (spec 15.1.4).
        "actor_id" -> "uint64";
        _: string -> ""
    }
}

fn builtin_return_type(name: string) -> string {
    op: string <- builtin_operand_type(name);
    case length_bytes(op) > 0 of {
        true -> op;
        false -> {
            s: string <- builtin_string_return_type(name);
            case length_bytes(s) > 0 of {
                true -> s;
                false -> case name == "bnot" of {
                    true -> "uint64";
                    false -> case name == "not" of {
                        true -> "boolean";
                        false -> builtin_actor_return_type(name)
                    }
                }
            }
        }
    }
}

// The file-IO built-ins have no entry in builtin_string_return_type -- their result type is
// decided by check_string_io, not by a name table -- so they are listed here and only here.
fn is_string_file_io_name(name: string) -> boolean {
    name == "read_lines" or name == "file_exists" or name == "delete_file" or name == "append_file"
}

// Exactly the set check_string_io handles: every string built-in except `len`, plus file IO.
// Before this the nine shared names were listed both here and in builtin_string_return_type,
// so adding a string built-in meant editing two lists and half-adding it if you forgot one.
// `len` is excluded to preserve the current set -- it still has a return type for user
// programs that call it, but check_string_io does not handle it.
fn is_string_io_builtin(name: string) -> boolean {
    case name == "len" of {
        true -> false;
        false -> case length_bytes(builtin_string_return_type(name)) > 0 of {
            true -> true;
            false -> is_string_file_io_name(name)
        }
    }
}
