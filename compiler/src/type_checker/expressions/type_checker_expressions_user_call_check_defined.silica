normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }), check_typed: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, int64, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (_: boolean, ft_world: string) <- type_checker_expressions_user_call_resolve@try_resolve_qualified_call_func_type(expr, expected_type, world, context);
    local_name: string <- instantiated_fn_name@resolve_call_fn_name(type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr));
    call_name: string <- type_checker_expressions_helpers@expr_name(expr);
    qualified: boolean <- type_checker_core@call_name_is_module_qualified(call_name);
    from_env_eq: string <- type_checker_core@lookup_function_surface_for_call(context.env, local_name);
    // A bare name is the current module's own function or a binding; imported rows
    // only answer to module@name (spec 19.3.3).
    from_env_i: string <- case qualified of {
        true -> type_checker_expressions_user_call_resolve@env_surface_by_name(context.env, local_name);
        false -> type_checker_expressions_user_call_resolve@env_local_surface_by_name(context.env, local_name)
    };
    from_env_expr: string <- case qualified of {
        true -> type_checker_expressions_user_call_resolve@env_surface_by_name(context.env, call_name);
        false -> type_checker_expressions_user_call_resolve@env_local_surface_by_name(context.env, call_name)
    };
    from_env: string <- case length_bytes(from_env_eq) of {
        0 -> case length_bytes(from_env_i) of {
            0 -> from_env_expr;
            _: int64 -> from_env_i
        };
        _: int64 -> from_env_eq
    };
    // Cross-module bool from try_resolve is untrusted under seed-built selfhost.
    // A nonempty world type wins; otherwise the env surface (names_eq_i if == misses);
    // the world walk for a bare name stays inside the module that declares the call site
    // (a callee body re-checked from a caller carries no module marker).
    resolved_type: string <- case length_bytes(ft_world) of {
        0 -> case length_bytes(from_env) of {
            0 -> case qualified of {
                true -> type_checker_expressions_user_call_resolve@unqualified_func_type_from_world(world, local_name);
                false -> type_checker_expressions_user_call_resolve@module_func_type_from_world(world, type_checker_expressions_device@module_of_location(type_checker_expressions_helpers@expr_loc(expr), context), local_name)
            };
            _: int64 -> from_env
        };
        _: int64 -> ft_world
    };
    from_world_i: int64 <- case length_bytes(ft_world) of {
        0 -> 0;
        _: int64 -> 1
    };
    case length_bytes(resolved_type) of {
        0 -> case type_checker_expressions_device@is_device_prim_name(type_checker_core@user_call_base_function_name(call_name)) and type_checker_core@call_name_is_module_qualified(call_name) == false of {
            true -> type_checker_expressions_device@check_device_prim_call(expr, expected_type, context, world, check_surface, check_typed);
            false -> unknown_function_err(expr, context.env, call_name, qualified)
        };
        _: int64 -> case type_checker_expressions_user_call_helpers@is_function_type_user_call(resolved_type) of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " is not a function"), "sect6");
            true -> type_checker_expressions_user_call_check_defined_parsed@check_user_defined_call_parsed(expr, expected_type, context, resolved_type, world, from_world_i, check_surface, check_typed)
        }
    }
}
