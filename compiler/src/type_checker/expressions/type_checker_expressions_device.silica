// The device prims map_device / peek / poke in the type checker (silica_device_actor_specification.md
// §4.7-§4.9, §11; codes E2209-E2219 and W2201 from esp32s3_peek_poke_implementation_details.md §2).
// The names are not reserved: an unqualified call that names no function in scope is the prim inside
// a device_* module and an error elsewhere. A `sequence proc[register_rwr]` and the prims may appear in
// any function of a device_* module except main; the effect system carries register_rwr to callers,
// and the spawn checks keep such behaviours out of spawn / spawn_registered / spawn_dangerous*.
//
// Register markers (§4.8) reach this module two ways from the parser: on a call argument as the
// argument pair node's value ("R8".."R64"); on a binding's right-hand side as a kind-2 node with that
// value wrapping the marked expression (type_checker_expressions routes those here).

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_expressions_actors;
use type_checker_tuple_decompose_helpers;
use type_checker_device_descriptions;
use diagnostics_core;

export is_device_prim_name/1;
export is_register_marker/1;
export marker_type/1;
export marker_width/1;
export module_marker_name/0;
export current_module_name/1;
export module_of_location/2;
export is_device_module_name/1;
export check_device_prim_call/6;
export check_marked_expression/7;
export expr_uses_device_code/1;
export decl_uses_device_code/1;
export effects_include_register_rwr/1;
export check_register_rwr_sequence_allowed/2;
export emit_w1c_warnings_for_program/3;

fn is_device_prim_name(n: string) -> boolean {
    case n of {
        "map_device" -> true;
        "peek" -> true;
        "poke" -> true;
        _: string -> false
    }
}

fn is_register_marker(m: string) -> boolean {
    case m of {
        "R8" -> true;
        "R16" -> true;
        "R32" -> true;
        "R64" -> true;
        _: string -> false
    }
}

fn marker_type(m: string) -> string {
    case m of {
        "R8" -> "uint8";
        "R16" -> "uint16";
        "R32" -> "uint32";
        "R64" -> "uint64";
        _: string -> ""
    }
}

fn marker_width(m: string) -> int64 {
    case m of {
        "R8" -> 8;
        "R16" -> 16;
        "R32" -> 32;
        "R64" -> 64;
        _: string -> 0
    }
}

fn marker_trait_name(m: string) -> string {
    concat("Register", substring(m, 1, length_bytes(m)))
}

// Type-checker-only env symbol whose surface type is the module being checked (set by
// type_checker_modules); "" when the module is not known.
fn module_marker_name() -> string {
    "__silica_tc_module"
}

fn current_module_name(context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    type_checker_core@lookup_symbol_surface(context.env, module_marker_name())
}

// The module that declares the code at `loc`: its file's base name. Code re-examined from another unit
// (a callee's body typed while checking its caller) carries its own file, not the caller's marker.
fn module_of_location(loc: { file: string, line: int64, column: int64, offset: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    case length_bytes(loc.file) > 0 of {
        true -> file_module_name(loc.file, length_bytes(loc.file) - 1);
        false -> current_module_name(context)
    }
}

fn file_module_name(path: string, i: int64) -> string {
    case i < 0 of {
        true -> strip_silica_suffix(path);
        false -> case substring(path, i, i + 1) == "/" of {
            true -> strip_silica_suffix(substring(path, i + 1, length_bytes(path)));
            false -> file_module_name(path, i - 1)
        }
    }
}

fn strip_silica_suffix(name: string) -> string {
    n: int64 <- length_bytes(name);
    case n > 7 and substring(name, n - 7, n) == ".silica" of {
        true -> substring(name, 0, n - 7);
        false -> name
    }
}

fn is_device_module_name(name: string) -> boolean {
    length_bytes(name) >= 7 and substring(name, 0, 7) == "device_"
}

fn context_in_main(context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> boolean {
    (f: boolean, _: int64) <- type_checker_core@lookup_symbol_found(context.env, type_checker_expressions_actors@tc_in_main_marker_name());
    f
}

fn placement_error(what: string, loc: { file: string, line: int64, column: int64, offset: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case is_device_module_name(module_of_location(loc, context)) of {
        false -> type_checker_core@type_check_err("E2216", loc, concat(what, " names no function in scope; the device prims map_device, peek and poke are only available inside a device_* module (silica_device_actor_specification.md §4.7)"), "sect4.7");
        true -> case context_in_main(context) of {
            true -> type_checker_core@type_check_err("E2219", loc, concat(what, " may not appear in main: device access runs in a device worker (silica_device_actor_specification.md §4.2)"), "sect4.2");
            false -> type_checker_core@type_check_ok()
        }
    }
}

fn strip_spaces_from(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == " " of {
                true -> strip_spaces_from(s, i + 1, acc);
                false -> strip_spaces_from(s, i + 1, concat(acc, c))
            }
        }
    }
}

fn find_char_from(s: string, c: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> case substring(s, i, i + 1) == c of {
            true -> i;
            false -> find_char_from(s, c, i + 1)
        }
    }
}

// "device_window(R, (:esp32s3_uart))" -> "(:esp32s3_uart)"; "" when the surface is not a window.
fn window_tag_of_surface(surface: string) -> string {
    s: string <- strip_spaces_from(surface, 0, "");
    case length_bytes(s) > 14 and substring(s, 0, 14) == "device_window(" of {
        false -> "";
        true -> {
            c: int64 <- find_char_from(s, ",", 14);
            case c < 0 of {
                true -> "";
                false -> substring(s, c + 1, length_bytes(s) - 1)
            }
        }
    }
}

// `(:esp32s3_uart)` as an expression: a parenthesised (or one-element tuple) atom literal.
fn tag_of_argument(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    k: int64 <- type_checker_expressions_helpers@expr_kind(e);
    inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(e);
    case (k == 2 or k == 9) and type_checker_expressions_helpers@expr_kind(inner) == 5 and type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(e)) < 0 of {
        true -> concat("(", concat(type_checker_expressions_helpers@expr_value(inner), ")"));
        false -> ""
    }
}

fn is_prim_call(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, prim: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> boolean {
    n: string <- type_checker_expressions_helpers@expr_name(e);
    case type_checker_expressions_helpers@expr_kind(e) == 4 and type_checker_core@user_call_base_function_name(n) == prim of {
        false -> false;
        true -> case type_checker_core@call_name_is_module_qualified(n) of {
            true -> false;
            false -> length_bytes(type_checker_core@lookup_function_surface_for_call(context.env, prim)) == 0
        }
    }
}

fn expected_is_discard(context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, expected_type: int64) -> boolean {
    type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard()
}

fn check_window_result(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, tag: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case expected_is_discard(context, expected_type) of {
        true -> type_checker_core@type_check_ok();
        false -> {
            surf: string <- type_checker_expressions_helpers@expect_surf(context, expected_type);
            case window_tag_of_surface(surf) == tag of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("map_device returns device_window(R, ", concat(tag, concat("), expected ", surf))), "sect4.7")
            }
        }
    }
}

fn check_atom_result(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, what: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case expected_is_discard(context, expected_type) of {
        true -> type_checker_core@type_check_ok();
        false -> {
            surf: string <- type_checker_expressions_helpers@expect_surf(context, expected_type);
            case surf == "atom" of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(what, concat(" returns atom, expected ", surf)), "sect4.7")
            }
        }
    }
}

fn check_marker_result(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, marker: string, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case expected_is_discard(context, expected_type) of {
        true -> type_checker_core@type_check_ok();
        false -> {
            surf: string <- type_checker_expressions_helpers@expect_surf(context, expected_type);
            case surf == marker_type(marker) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2212", type_checker_expressions_helpers@expr_loc(expr), concat("an expression marked impl ", concat(marker_trait_name(marker), concat(" {} has type ", concat(marker_type(marker), concat(", expected ", concat(surf, " (silica_device_actor_specification.md §4.8)")))))), "sect4.8")
            }
        }
    }
}

