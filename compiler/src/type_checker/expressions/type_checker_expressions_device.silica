    name: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
    placed: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- placement_error(name, type_checker_expressions_helpers@expr_loc(expr), context);
    case placed.is_ok of {
        false -> placed;
        true -> case name of {
            "map_device" -> check_map_device(expr, expected_type, context, world, check_surface, check_typed);
            "poke" -> check_poke(expr, expected_type, context, world, check_surface, check_typed);
            "peek" -> type_checker_core@type_check_err("E2211", type_checker_expressions_helpers@expr_loc(expr), "peek requires a width marker: peek(window, :register) impl Register8|Register16|Register32|Register64 {} (silica_device_actor_specification.md §4.8)", "sect4.8");
            _: string -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "internal: not a device prim", "sect4.7")
        }
    }
}

