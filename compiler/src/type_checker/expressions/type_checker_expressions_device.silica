        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "map_device expects 2 arguments: (device: (:tag), base: uint64) (silica_device_actor_specification.md §4.7)", "sect4.7");
        true -> {
            tag: string <- tag_of_argument(type_checker_expressions_helpers@expr_child_inner(expr));
            case tag == "" of {
                true -> type_checker_core@type_check_err("E2213", type_checker_expressions_helpers@expr_loc(expr), "map_device's first argument must be a device tag such as (:esp32s3_uart) (silica_device_actor_specification.md §4.7)", "sect4.7");
                false -> case type_checker_device_descriptions@description_visible(world, current_module_name(context), tag) of {
                    false -> type_checker_core@type_check_err("E2209", type_checker_expressions_helpers@expr_loc(expr), concat("no device description for ", concat(tag, concat(" is visible from this module: write `impl fn registers(device: ", concat(tag, ")` here or in a module this one uses (silica_device_actor_specification.md §4.9)")))), "sect4.9");
                    true -> {
                        (r0, _) <- check_surface(type_checker_expressions_helpers@call_second_arg_expr(expr), "uint64", context, world);
                        case r0.is_ok of {
                            false -> r0;
                            true -> check_window_result(expr, expected_type, context, tag)
                        }
                    }
                }
            }
        }
    }
}

// The value argument of poke and its marker: the marker sits on the argument pair node that holds
// the value, or on a kind-2 wrapper around the value when the parser stored the value without a pair.
fn poke_value_and_marker(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) {
    p1: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_right(expr);
    p2: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_right(p1);
    is_pair: boolean <- type_checker_expressions_helpers@expr_kind(p2) == 4 and type_checker_expressions_helpers@expr_name(p2) == "";
    v: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- case is_pair of {
        true -> type_checker_expressions_helpers@expr_child_inner(p2);
        false -> p2
    };
    m: string <- case is_pair of {
        true -> type_checker_expressions_helpers@expr_value(p2);
        false -> ""
    };
    case type_checker_expressions_helpers@expr_kind(v) == 2 and is_register_marker(type_checker_expressions_helpers@expr_value(v)) of {
        true -> (type_checker_expressions_helpers@expr_child_inner(v), type_checker_expressions_helpers@expr_value(v));
        false -> case is_register_marker(m) of {
            true -> (v, m);
            false -> (v, "")
        }
    }
}

