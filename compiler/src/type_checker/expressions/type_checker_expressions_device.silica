        true -> check_peek(inner, marker, expected_type, context, world, check_surface);
        false -> {
            (r, _) <- check_surface(inner, marker_type(marker), context, world);
            case r.is_ok of {
                false -> r;
                true -> check_marker_result(inner, marker, expected_type, context)
            }
        }
    }
}

// --- device code detection (for the spawn checks and the module rules) --------------------------

fn effects_include_register_rwr(effs: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> boolean {
    case effs.is_nil of {
        true -> false;
        false -> case effs.head.name == "register_rwr" of {
            true -> true;
            false -> effects_include_register_rwr(effs.tail)
        }
    }
}

fn is_unqualified_prim_name(n: string) -> boolean {
    case type_checker_core@call_name_is_module_qualified(n) of {
        true -> false;
        false -> is_device_prim_name(type_checker_core@user_call_base_function_name(n))
    }
}

fn expr_uses_device_code(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    k: int64 <- type_checker_expressions_helpers@expr_kind(expr);
    case k < 0 or k == 999 of {
        true -> false;
        false -> case k == 11 and effects_include_register_rwr(type_checker_expressions_helpers@expr_sequence_effects(expr)) of {
            true -> true;
            false -> case k == 4 and is_unqualified_prim_name(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> true;
                false -> case expr_uses_device_code(type_checker_expressions_helpers@expr_child_inner(expr)) of {
                    true -> true;
                    false -> expr_uses_device_code(type_checker_expressions_helpers@expr_child_right(expr))
                }
            }
        }
    }
}

fn decl_uses_device_code(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> boolean {
    case effects_include_register_rwr(decl.declared_effects) of {
        true -> true;
        false -> expr_uses_device_code(decl.body)
    }
}

// The sequence node's own location is its `end` keyword; the effect entry is on the `sequence proc[...]` line.
fn register_rwr_effect_location(effs: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> { file: string, line: int64, column: int64, offset: int64 } {
    case effs.is_nil of {
        true -> parser_ast@zero_location();
        false -> case effs.head.name == "register_rwr" of {
            true -> effs.head.location;
            false -> register_rwr_effect_location(effs.tail)
        }
    }
}

fn check_register_rwr_sequence_allowed(seq: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case effects_include_register_rwr(type_checker_expressions_helpers@expr_sequence_effects(seq)) of {
        false -> type_checker_core@type_check_ok();
        true -> placement_error("sequence proc[register_rwr]", register_rwr_effect_location(type_checker_expressions_helpers@expr_sequence_effects(seq)), context)
    }
}

// --- W2201: poke of the unmodified result of a peek of the same :write_one_to_clear register -------

fn window_tag_in_params(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], w: string) -> string {
    case params.is_nil of {
        true -> "";
        false -> case params.head.name == w of {
            true -> window_tag_of_surface(params.head.type_name);
            false -> window_tag_in_params(params.tail, w)
        }
    }
}

fn window_tag_in_expr(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, w: string) -> string {
    k: int64 <- type_checker_expressions_helpers@expr_kind(e);
    case k < 0 or k == 999 of {
        true -> "";
        false -> case k == 6 and type_checker_expressions_helpers@expr_name(e) == w and window_tag_of_surface(type_checker_expressions_helpers@expr_value(e)) != "" of {
            true -> window_tag_of_surface(type_checker_expressions_helpers@expr_value(e));
            false -> {
                t: string <- window_tag_in_expr(type_checker_expressions_helpers@expr_child_inner(e), w);
                case t == "" of {
                    true -> window_tag_in_expr(type_checker_expressions_helpers@expr_child_right(e), w);
                    false -> t
                }
            }
        }
    }
}

// The tag of the window bound to identifier `w` in a declaration: a parameter's type or a let's type.
fn window_tag_in_decl(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, w: string) -> string {
    t: string <- window_tag_in_params(decl.parameters, w);
    case t == "" of {
        true -> window_tag_in_expr(decl.body, w);
        false -> t
    }
}

fn ident_name(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    case type_checker_expressions_helpers@expr_kind(e) == 1 of {
        true -> type_checker_expressions_helpers@expr_name(e);
        false -> ""
    }
}

fn atom_value(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    case type_checker_expressions_helpers@expr_kind(e) == 5 of {
        true -> type_checker_expressions_helpers@expr_value(e);
        false -> ""
    }
}

fn is_unqualified_call_named(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, prim: string) -> boolean {
    n: string <- type_checker_expressions_helpers@expr_name(e);
    case type_checker_expressions_helpers@expr_kind(e) == 4 and type_checker_core@user_call_base_function_name(n) == prim of {
        false -> false;
        true -> type_checker_core@call_name_is_module_qualified(n) == false
    }
}

// rhs is `peek(w, :r) impl RegisterN {}`: returns w and r, "" when it is not.
fn peek_window_of_rhs(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(rhs);
    case type_checker_expressions_helpers@expr_kind(rhs) == 2 and is_register_marker(type_checker_expressions_helpers@expr_value(rhs)) and is_unqualified_call_named(inner, "peek") of {
        true -> ident_name(type_checker_expressions_helpers@expr_child_inner(inner));
        false -> ""
    }
}

fn peek_register_of_rhs(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(rhs);
    case type_checker_expressions_helpers@expr_kind(rhs) == 2 and is_register_marker(type_checker_expressions_helpers@expr_value(rhs)) and is_unqualified_call_named(inner, "peek") of {
        true -> atom_value(type_checker_expressions_helpers@call_second_arg_expr(inner));
        false -> ""
    }
}

fn poke_writes_back(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pv: string, pw: string, pr: string) -> boolean {
    case pv != "" and is_unqualified_call_named(rhs, "poke") of {
        false -> false;
        true -> {
            (value_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, _: string) <- poke_value_and_marker(rhs);
            ident_name(type_checker_expressions_helpers@expr_child_inner(rhs)) == pw and atom_value(type_checker_expressions_helpers@call_second_arg_expr(rhs)) == pr and ident_name(value_e) == pv
        }
    }
}

fn warn_w1c(loc: { file: string, line: int64, column: int64, offset: int64 }, pr: string) -> int64 {
    _: int8 <- diagnostics_core@print_compiler_warning("DeviceWarning", "W2201", loc, concat("poke of ", concat(pr, concat(" writes back the unmodified value read from it; ", concat(pr, " is write-one-to-clear, so this clears every bit that was set (silica_device_actor_specification.md §4.9)")))), "sect4.9");
    1
}

// Walk one sequence body's statements with the pending `v <- peek(w, :r)` binding, if any.
fn warn_statements(stmt: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pv: string, pw: string, pr: string, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mod: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> int64 {
    k: int64 <- type_checker_expressions_helpers@expr_kind(stmt);
    case k == 10 of {
        true -> warn_statements(type_checker_expressions_helpers@expr_child_right(stmt), pv, pw, pr, decl, mod, world);
        false -> case k == 6 of {
            false -> 0;
            true -> {
                rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(stmt);
                bound: string <- type_checker_expressions_helpers@expr_name(stmt);
                hit: int64 <- case poke_writes_back(rhs, pv, pw, pr) and type_checker_device_descriptions@register_access_of(world, mod, window_tag_in_decl(decl, pw), pr) == ":write_one_to_clear" of {
                    true -> warn_w1c(type_checker_expressions_helpers@expr_loc(rhs), pr);
                    false -> 0
                };
                nw: string <- peek_window_of_rhs(rhs);
                nr: string <- peek_register_of_rhs(rhs);
                next: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_right(stmt);
                case nw != "" and nr != "" of {
                    true -> hit + warn_statements(next, bound, nw, nr, decl, mod, world);
                    false -> case hit > 0 or bound == pv or bound == pw of {
                        true -> hit + warn_statements(next, "", "", "", decl, mod, world);
                        false -> warn_statements(next, pv, pw, pr, decl, mod, world)
                    }
                }
            }
        }
    }
}

fn warn_expr(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mod: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> int64 {
    k: int64 <- type_checker_expressions_helpers@expr_kind(e);
    case k < 0 or k == 999 of {
        true -> 0;
        false -> {
            here: int64 <- case k == 11 of {
                true -> warn_statements(type_checker_expressions_helpers@expr_child_inner(e), "", "", "", decl, mod, world);
                false -> 0
            };
            here + warn_expr(type_checker_expressions_helpers@expr_child_inner(e), decl, mod, world) + warn_expr(type_checker_expressions_helpers@expr_child_right(e), decl, mod, world)
        }
    }
}

fn warn_decls(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], mod: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> int64 {
    case decls.is_nil of {
        true -> 0;
        false -> case decls.head.tag == 0 of {
            true -> warn_expr(decls.head.body, decls.head, mod, world) + warn_decls(decls.tail, mod, world);
            false -> warn_decls(decls.tail, mod, world)
        }
    }
}

// Number of W2201 warnings printed for the program (0 outside device_* modules).
fn emit_w1c_warnings_for_program(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, module_name: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> int64 {
    case is_device_module_name(module_name) of {
        false -> 0;
        true -> warn_decls(program.declarations, module_name, world)
    }
}
