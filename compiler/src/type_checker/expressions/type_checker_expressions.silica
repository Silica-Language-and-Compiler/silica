// Expression type-checker facade: kind dispatch.
// Leaf work lives in thin dispatchers so this process does not intern
// control_and_data + bindings + user_calls together.
// Open recursion uses check_expr / check_expr_surface as callbacks.
// check_collection_trait_let_cb stays here because a callback must be a local function
// value; qualified references (module@fn) are not valid arguments (E2005).
// The callback body forwards to dispatch_collections, not the collections leaf.
// Kind 4 calls user_call_check directly: wrapping that leaf in dispatch_ops
// recopies two /6 exports and OOMs. user_call_check is already the dispatcher.
// Decl/context queries for the SIR manglers live in type_checker_expressions_decl_queries.

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_expressions_device;
use type_checker_expressions_ident_match;
use type_checker_expressions_dispatch_direct;
use type_checker_expressions_dispatch_ops;
use type_checker_expressions_dispatch_collections;
use type_checker_expressions_dispatch_data;
use type_checker_expressions_user_call_check;

export check_expr/4;

fn is_ops_kind(k: int64) -> boolean {
    case k of {
        3 -> true;
        12 -> true;
        _: int64 -> false
    }
}

fn is_data_kind(k: int64) -> boolean {
    case k of {
        6 -> true;
        9 -> true;
        10 -> true;
        11 -> true;
        13 -> true;
        19 -> true;
        20 -> true;
        21 -> true;
        22 -> true;
        991 -> true;
        _: int64 -> false
    }
}

