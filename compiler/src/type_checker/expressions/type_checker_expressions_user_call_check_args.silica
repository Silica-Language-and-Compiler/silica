// Recursive argument walk. Result checking lives in check_args_result.

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_collections;
use type_checker_expressions_user_call_helpers;
use type_checker_expressions_user_call_check_args_result;
use type_checker_expressions_user_call_resolve_fit;

export check_user_call_args_recursive/8;

// `params_inner` is the callee's DECLARED parameter list: each formal is instantiated here, once
// (resolve_call_formal), as it meets its argument. Callers must not hand over a list they have
// already instantiated -- before 2026-10-23 the cross-module path did, and a ValueType witnessed by
// a node type over ValueType was substituted twice (an argument expected as the outer node).

fn check_user_call_args_recursive(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, params_inner: string, expected_type: int64, return_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], check_surface: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == -1 of {
        true -> case length_bytes(params_inner) == 0 of {
            true -> type_checker_expressions_user_call_check_args_result@check_user_call_result_user_call(call_expr, expected_type, return_type, context, world);
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6")
        };
        false -> {
            (first_param: string, rest_params: string) <- type_checker_expressions_user_call_helpers@get_first_param_type(params_inner);
            case length_bytes(first_param) == 0 of {
                true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                false -> {
                    arg_inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
                    receiver_inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(call_expr), context);
                    formal_bind: string <- case type_checker_collections@is_collection_trait_type(type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                        true -> type_checker_expressions_helpers@expect_surf(context, expected_type);
                        false -> case type_checker_collections@bind_type_has_collection_runtime_fields(type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                            true -> type_checker_expressions_helpers@expect_surf(context, expected_type);
                            false -> case length_bytes(receiver_inferred) > 0 of {
                                true -> receiver_inferred;
                                false -> case length_bytes(arg_inferred) > 0 of {
                                    true -> arg_inferred;
                                    false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
                                }
                            }
                        }
                    };
                    resolved_param: string <- type_checker_collections@resolve_call_formal(formal_bind, "", type_checker_expressions_user_call_check_args_result@call_acc_witness(call_expr, expected_type, context), first_param);
                    check_param: string <- type_checker_expressions_user_call_resolve_fit@specialize_trait_formal_from_actual(arg_inferred, resolved_param, world);
                    (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), check_param, context, world);
                    case r1.is_ok of {
                        false -> r1;
                        true -> case length_bytes(rest_params) == 0 of {
                            // Formals exhausted: an argument still chained on the right is one too many (E2005, spec §10.3.4).
                            true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 of {
                                true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                                false -> type_checker_expressions_user_call_check_args_result@check_user_call_result_user_call(call_expr, expected_type, return_type, context, world)
                            };
                            false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == -1 of {
                                true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                                false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 of {
                                    true -> case length_bytes(rest_params) == 0 of {
                                        true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                                        false -> check_user_call_args_recursive(type_checker_expressions_helpers@expr_child_right(expr), rest_params, expected_type, return_type, context, call_expr, world, check_surface)
                                    };
                                    false -> {
                                        (second_param: string, rest_rest: string) <- type_checker_expressions_user_call_helpers@get_first_param_type(rest_params);
                                        case length_bytes(second_param) == 0 or length_bytes(rest_rest) > 0 of {
                                            true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                                            false -> {
                                                resolved_second: string <- type_checker_collections@resolve_call_formal(formal_bind, "", type_checker_expressions_user_call_check_args_result@call_acc_witness(call_expr, expected_type, context), second_param);
                                                second_inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_right(expr), context);
                                                check_second: string <- type_checker_expressions_user_call_resolve_fit@specialize_trait_formal_from_actual(second_inferred, resolved_second, world);
                                                (r2, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), check_second, context, world);
                                                case r2.is_ok of {
                                                    false -> r2;
                                                    true -> type_checker_expressions_user_call_check_args_result@check_user_call_result_user_call(call_expr, expected_type, return_type, context, world)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
