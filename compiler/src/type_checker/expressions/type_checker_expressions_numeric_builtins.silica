// Float/checked-int64/collection-result/ordering built-in checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_recursive_tuples;
use type_checker_lists;
use type_checker_collections;
use type_checker_expressions_actors;
use type_checker_supervisor;
use type_checker_record_types;
use type_checker_traits;
use type_checker_callee_env;
use type_checker_expressions_identifiers;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use string_parse;
use instantiated_fn_name;

export is_float_special_const_name/1;
export is_float_predicate_name/1;
export check_float_special_const_call/3;
export check_float_predicate_call/6;
export is_ordering_identity_builtin_call/1;
export is_collection_result_builtin_call/1;
export is_checked_int64_builtin_call/1;
export check_checked_int64_builtin_call/6;
export check_collection_result_builtin_call/6;
export check_ordering_identity_builtin_call/6;
export is_actor_ref_equality_builtin_call/1;
export check_actor_ref_equality_builtin_call/6;

fn is_float_special_const_name(name: string) -> boolean {
    name == "float16_nan" or name == "float16_inf" or name == "float16_neg_inf" or name == "float32_nan" or name == "float32_inf" or name == "float32_neg_inf" or name == "float64_nan" or name == "float64_inf" or name == "float64_neg_inf"
}

fn float_special_const_type(name: string) -> string {
    case substring(name, 0, 7) == "float16" of {
        true -> "float16";
        false -> case substring(name, 0, 7) == "float32" of {
            true -> "float32";
            false -> "float64"
        }
    }
}

fn is_float_predicate_name(name: string) -> boolean {
    name == "float16_is_nan" or name == "float16_is_inf" or name == "float16_is_finite" or name == "float32_is_nan" or name == "float32_is_inf" or name == "float32_is_finite" or name == "float64_is_nan" or name == "float64_is_inf" or name == "float64_is_finite"
}

fn float_predicate_arg_type(name: string) -> string {
    case substring(name, 0, 7) == "float16" of {
        true -> "float16";
        false -> case substring(name, 0, 7) == "float32" of {
            true -> "float32";
            false -> "float64"
        }
    }
}

fn check_float_special_const_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    ret: string <- float_special_const_type(type_checker_expressions_helpers@expr_name(expr));
    case ac == 0 of {
        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " expects 0 arguments"), "sect6");
        true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) == ret or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(type_checker_expressions_helpers@expr_name(expr), " returns "), ret), concat(", expected ", type_checker_expressions_helpers@expect_surf(context, expected_type))), "sect6")
        }
    }
}

