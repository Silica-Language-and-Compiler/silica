            "comparator_result_valid" -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("comparator_result_valid returns boolean, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "common_contract§4")
            };
            "comparator_result_validate" -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_atom() of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("comparator_result_validate returns atom, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "common_contract§4")
            };
            _: string -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("unknown collection result built-in: ", type_checker_expressions_helpers@expr_name(expr)), "common_contract§4")
        }
    }
}

fn type_str_has_arrow_token(s: string, i: int64) -> boolean {
    case i + 4 > length_bytes(s) of {
        true -> false;
        false -> case substring(s, i, i + 4) == " -> " of {
            true -> true;
            false -> type_str_has_arrow_token(s, i + 1)
        }
    }
}

fn is_fn_type_string(type_str: string) -> boolean {
    case length_bytes(type_str) >= 3 and substring(type_str, 0, 3) == "fn(" of {
        true -> true;
        false -> case length_bytes(type_str) >= 4 and substring(type_str, 0, 4) == "fn (" of {
            true -> true;
            false -> type_str_has_arrow_token(type_str, 0)
        }
    }
}

