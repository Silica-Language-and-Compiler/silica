        "ordering_identity_fresh_env" -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_int64() of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("ordering_identity_fresh_env returns int64, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "common_contract§5")
        };
        "ordering_identity_materialize" -> {
            fn_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
            case is_fn_type_string(fn_type) of {
                false -> type_checker_core@type_check_err("E2010", type_checker_expressions_helpers@expr_loc(expr), concat("ordering_identity_materialize: argument must be a function value, got ", fn_type), "common_contract§5");
                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_int64() of {
                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), "ordering_identity_materialize returns int64", "common_contract§5");
                    true -> {
                        (r, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), fn_type, context, world);
                        r
                    }
                }
            }
        };
        "ordering_identity_same" -> {
            (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "int64", context, world);
            case r1.is_ok of {
                false -> r1;
                true -> {
                    (r2, _) <- check_surface(type_checker_expressions_helpers@call_second_arg_expr(expr), "int64", context, world);
                    case r2.is_ok of {
                        false -> r2;
                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_boolean() of {
                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), "ordering_identity_same returns boolean", "common_contract§5");
                            true -> type_checker_core@type_check_ok()
                        }
                    }
                }
            }
        };
        "ordering_identity_bundle_make" -> {
            (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "int64", context, world);
            case r1.is_ok of {
                false -> r1;
                true -> {
                    (r2, _) <- check_surface(type_checker_expressions_helpers@call_second_arg_expr(expr), "atom", context, world);
                    case r2.is_ok of {
                        false -> r2;
                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_int64() of {
                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), "ordering_identity_bundle_make returns int64", "common_contract§5");
                            true -> type_checker_core@type_check_ok()
                        }
                    }
                }
            }
        };
        _: string -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("unknown ordering identity built-in: ", type_checker_expressions_helpers@expr_name(expr)), "common_contract§5")
    }
