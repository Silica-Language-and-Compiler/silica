        20 -> (type_checker_expressions_data@check_list_literal(expr, expected_type, context, world, check_surface, check_typed), context);
        21 -> (type_checker_expressions_data@check_struct_literal_expr(expr, expected_type, context, world, check_surface, check_typed), context);
        22 -> (type_checker_expressions_data@check_field_access_expr(expr, expected_type, context, world, check_surface, check_typed), context);
        991 -> (type_checker_expressions_bindings@check_lambda_expression(expr, expected_type, context, world, check_surface, check_typed), context);
        _: int64 -> (type_checker_core@type_check_ok(), context)
    }
}
