ation: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }), caller_context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case decl.body.root + 1 of {
        0 -> type_checker_core@type_check_ok();
        _: int64 -> case parser_ast@expr_root_node(decl.body).kind + 1 of {
            0 -> type_checker_core@type_check_ok();
            _: int64 -> case type_checker_expressions_user_call_helpers@list_param_length_call(decl.parameters) == type_checker_expressions_user_call_helpers@list_param_length_call(conc_decl_order) of {
        false -> type_checker_core@type_check_err("E2005", decl.location, "internal: call-site parameter type list length mismatch", "sect6");
        true -> {
            (pass1: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, ctx_callee: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) <- type_checker_callee_env_cache@callee_context_cached(callee_prog.declarations, world, callee_mod_id, caller_context);
            case pass1.is_ok of {
                false -> pass1;
                true -> {
                    dp: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@param_list_normalize(decl.parameters);
                    cp: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@param_list_normalize(conc_decl_order);
                    ctx_params: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@add_params_concrete_loop1({ decl_params: dp, concrete_types: cp, base: ctx_callee });
                    ret_rec: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_expressions_user_call_resolve_validate@validate_callsite_return_record_type(decl.return_type_name, decl.return_type_location);
                    case ret_rec.is_ok of {
                        false -> ret_rec;
                        true -> case decl.return_type_name == "unit" of {
                            true -> type_checker_core@type_check_err("E2006", decl.return_type_location, "unit is not a valid return type", "sect4");
                            false -> case type_checker_memory_regions@is_memory_region_type(decl.return_type_name) of {
                                true -> {
                                    mem_result: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_memory_regions@validate_memory_region_type(decl.return_type_name, decl.return_type_location);
                                    case mem_result.is_ok of {
                                        false -> mem_result;
                                        true -> {
                    (r, _) <- check_surface(decl.body, decl.return_type_name, ctx_params, world);
                    case r.is_ok of {
                        true -> r;
                        // The parameters are concrete here, so a call in the body that returns
                        // ItemType (or a record/tuple naming it) resolves against the concrete
                        // receiver while the declared return still names the placeholder. Accept the
                        // body when it checks against the return resolved from the first concrete
                        // parameter (the same argument-one witness a caller uses); otherwise keep the
                        // original diagnostic.
                        false -> {
                            ret_conc: string <- callsite_concrete_return(cp, decl.return_type_name);
                            case ret_conc == decl.return_type_name of {
                                true -> r;
                                false -> {
                                    (rc, _) <- check_surface(decl.body, ret_conc, ctx_params, world);
                                    case rc.is_ok of {
                                        true -> rc;
                                        false -> r
                                    }
                                }
                            }
                        }
                    }
                }
                                    }
                                };
                                false -> {
                    (r, _) <- check_surface(decl.body, decl.return_type_name, ctx_params, world);
                    case r.is_ok of {
                        true -> r;
                        // The parameters are concrete here, so a call in the body that returns
                        // ItemType (or a record/tuple naming it) resolves against the concrete
                        // receiver while the declared return still names the placeholder. Accept the
                        // body when it checks against the return resolved from the first concrete
                        // parameter (the same argument-one witness a caller uses); otherwise keep the
                        // original diagnostic.
                        false -> {
                            ret_conc: string <- callsite_concrete_return(cp, decl.return_type_name);
                            case ret_conc == decl.return_type_name of {
                                true -> r;
                                false -> {
                                    (rc, _) <- check_surface(decl.body, ret_conc, ctx_params, world);
                                    case rc.is_ok of {
                                        true -> rc;
                                        false -> r
                                    }
                                }
                            }
                        }
                    }
                }
                            }
                        }
                    }
                }
            }
        }
            }
        }
    }
}

