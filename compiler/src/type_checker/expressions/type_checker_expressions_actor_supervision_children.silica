                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(reason_e), concat(concat("stop_self reason must be :normal or (:explicit, atom), got ", type_checker_expressions_helpers@expr_value(reason_e)), " (§15.1.2.3)"), "sect15.1.2.3")
                        };
                        false -> case type_checker_expressions_helpers@expr_kind(reason_e) == 9 and self_stop_tuple_is_explicit(reason_e) of {
                            true -> {
                                (r_atom, _) <- check_surface(self_stop_explicit_atom_expr(reason_e), "atom", context, world);
                                r_atom
                            };
                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(reason_e), "stop_self reason must be :normal or (:explicit, atom) (§15.1.2.3)", "sect15.1.2.3")
                        }
                    };
                    case r0.is_ok of {
                        false -> r0;
                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_atom() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                            true -> type_checker_core@type_check_ok();
                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("stop_self returns atom, expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect15.1.2.3")
                        }
                    }
                }
            }
        }
    }
}

// Spec §15.1.2.3: fail_self(reason: atom) -> !, an immediate abnormal stop of the calling actor with
// failure_reason (:explicit, reason). It never returns, so it has the type its context expects: the
// result check is skipped (the `!` of the signature; the checker has no never type of its own). A
// behaviour-only builtin, as kill_abnormal and stop_self are (E2091).
