// Actor failure/child-table/kill/start_child checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_expressions_actors;
use type_checker_supervisor;

export check_failure_reason_tag_call/6;
export check_failure_reason_atom_call/6;
export check_failure_agent_type_call/6;
export check_failure_release_call/6;
export check_start_child_call/6;
export check_child_table_first_ref_call/4;
export check_child_table_row_ref_call/6;
export check_kill_abnormal_call/6;
export check_stop_self_call/6;
export check_fail_self_call/6;
export self_stop_tuple_is_explicit/1;
export self_stop_explicit_atom_expr/1;
export self_stop_unparen/1;
export check_wait_for_exit_call/4;
export check_cast_exit_call/6;

fn check_child_table_first_ref_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_actors@type_context_has_behavior_marker(context) of {
        false -> type_checker_core@type_check_err("E2091", type_checker_expressions_helpers@expr_loc(expr), "child_table_first_ref may only be called from within an actor behavior function (supervisors plan Phase E e4a)", "sect15.4.13");
        true -> {
            ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
            case ac == 0 of {
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "child_table_first_ref expects 0 arguments", "sect15.4.13");
                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_int64() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_actor_ref() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("child_table_first_ref returns int64 (actor_ref as pointer), expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect15.4.13")
                }
            }
        }
    }
}

