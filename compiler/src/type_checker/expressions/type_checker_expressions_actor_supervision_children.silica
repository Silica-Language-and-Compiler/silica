                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "fail_self expects 1 argument: (reason: atom)", "sect15.1.2.3");
                true -> {
                    (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "atom", context, world);
