                                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_atom() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("supervision_ingress_enqueue returns atom (:ok), expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect15")
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

