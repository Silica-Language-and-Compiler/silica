, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_actors@type_context_has_behavior_marker(context) of {
        false -> type_checker_core@type_check_err("E2091", type_checker_expressions_helpers@expr_loc(expr), "link may only be called from within an actor behavior function (§15.4.8.5; supervisors plan Phase D)", "sect15.4.8.5");
        true -> {
            ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
            case ac == 1 of {
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "link expects 1 argument: (target: actor_ref) §15.4.8.5", "sect15");
                true -> {
                    (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "actor_ref", context, world);
                    case r0.is_ok of {
                        false -> r0;
                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_atom() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                            true -> type_checker_core@type_check_ok();
                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("link returns atom (:ok), expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect15")
                        }
                    }
                }
            }
        }
    }
}

fn actor_ref_supervisor_marker_name(var_name: string) -> string {
    concat("__actor_sup__", var_name)
}

fn check_add_child_parent_supervisor(parent_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@expr_kind(parent_e) == 1 of {
        false -> type_checker_core@type_check_ok();
        true -> {
            (marked: boolean, _: int64) <- type_checker_core@lookup_symbol_found(context.env, actor_ref_supervisor_marker_name(type_checker_expressions_helpers@expr_name(parent_e)));
            case marked of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2091", location, "add_child parent must be an actor_ref spawned from a state type implementing Supervisor", "sect15.4.13")
            }
        }
    }
}

// Explicit supervisor parent/child registration: add_child(parent: actor_ref, child: actor_ref) -> :ok.
// The parent ref is accepted only when this type-checking pass can prove it came from a Supervisor impl spawn.
