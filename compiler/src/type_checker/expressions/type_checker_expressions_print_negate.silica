            _: string -> case type_checker_expressions_helpers@surface_type_matches_expected(context, num_type, expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat(type_checker_expressions_helpers@expr_name(expr), " returns "), num_type), ", expected "), type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
            }
        }
    }
}

// §4.5 actor_ref, §15 spawn, §16 call/cast/send, self; recv forbidden §15.1.2;
// CPU affinity / topology helpers (spec appendix): pin_actor_*, unpin_actor, remove_actor, set_actor_priority, get_cpu_topology, get_*_cores, get_core_capabilities.
