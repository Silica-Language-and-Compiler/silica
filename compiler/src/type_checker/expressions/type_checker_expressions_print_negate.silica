    case arg_result.is_ok of {
        false -> arg_result;
        true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
            "atom" -> type_checker_core@type_check_ok();
            "discard" -> type_checker_core@type_check_ok();
            _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat("print_", concat(arg_type, " expects atom result, got ")), type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
        }
    }
}

// Built-in: negate_<primitive>/1 — signed int and float only. negate_uint* are not builtins (unknown function, E2005). negate_unit is rejected below.
fn negate_builtin_arg_type(name: string) -> string {
    type_checker_builtin_signatures@builtin_operand_type(name)
}

