// Tuple literal and tuple-decompose expression checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_expressions_bindings;
use type_checker_collections;

export check_tuple_literal_inline/6;
export check_tuple_decompose/6;

fn tuple_elem_type_for_check(field_type: string) -> string {
    case length_bytes(field_type) > 0 and substring(field_type, 0, 1) == ":" of {
        true -> "atom";
        false -> field_type
    }
}

// Tuple literal (kind 9): check against expected tuple type "(T1, T2)"
