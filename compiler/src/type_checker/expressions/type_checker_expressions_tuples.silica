ing }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    // Expected inline sum type with tagged-tuple variants (`:none | (:some, T)`,
    // silica-specification §15.4.11.2, §20.1.1): the literal must be one of its tuple variants.
    case type_checker_tuple_decompose_helpers@case_sum_bar_depth0(type_checker_tuple_decompose_helpers@tuple_trim(type_checker_expressions_helpers@expect_surf(context, expected_type)), 0, 0) >= 0 of {
        true -> {
            sum_r: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_tuple_literal_against_sum(expr, type_checker_tuple_decompose_helpers@tuple_trim(type_checker_expressions_helpers@expect_surf(context, expected_type)), type_checker_tuple_decompose_helpers@tuple_trim(type_checker_expressions_helpers@expect_surf(context, expected_type)), context, world, check_surface);
            case sum_r.is_ok of {
                true -> sum_r;
                // No variant fits: keep the plain diagnostic this expectation produced before.
                false -> check_tuple_literal_inline_plain(expr, expected_type, context, world, check_surface, check_typed)
            }
        };
        false -> check_tuple_literal_inline_plain(expr, expected_type, context, world, check_surface, check_typed)
    }
}

