    case length_bytes(type_checker_expressions_helpers@expect_surf(context, expected_type)) == 7 and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 0, 1) == "d" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 1, 2) == "i" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 2, 3) == "s" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 3, 4) == "c" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 4, 5) == "a" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 5, 6) == "r" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 6, 7) == "d" of {
        true -> type_checker_core@type_check_ok();
        false -> case length_bytes(type_checker_expressions_helpers@expect_surf(context, expected_type)) < 2 of {
            true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("tuple literal requires tuple type, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect4");
            false -> case substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 0, 1) == "(" of {
                true -> case substring(type_checker_expressions_helpers@expect_surf(context, expected_type), length_bytes(type_checker_expressions_helpers@expect_surf(context, expected_type)) - 1, length_bytes(type_checker_expressions_helpers@expect_surf(context, expected_type))) == ")" of {
                    true -> {
                        inner: string <- substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 1, length_bytes(type_checker_expressions_helpers@expect_surf(context, expected_type)) - 1);
                        comma_pos: int64 <- case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == 9 of {
                            true -> tuple_find_last_top_level_comma(inner);
                            false -> tuple_find_top_level_comma(inner, 0)
                        };
                        first_type_raw: string <- substring(inner, 0, comma_pos);
                        first_type: string <- tuple_trim_leading(first_type_raw);
                        first_type_wrapped: string <- case tuple_find_top_level_comma(first_type, 0) < length_bytes(first_type) of {
                            true -> concat(concat("(", first_type), ")");
                            false -> first_type
                        };
                        rest_start: int64 <- comma_pos + 1;
                        second_type_raw: string <- case rest_start < length_bytes(inner) of {
                            true -> substring(inner, rest_start, length_bytes(inner));
                            false -> ""
                        };
                        second_type: string <- tuple_trim_leading(second_type_raw);
                        second_type_wrapped: string <- case tuple_find_top_level_comma(second_type, 0) < length_bytes(second_type) of {
                            true -> concat(concat("(", second_type), ")");
                            false -> second_type
                        };
                        first_expect: string <- tuple_elem_type_for_check(first_type_wrapped);
                        second_expect: string <- tuple_elem_type_for_check(second_type_wrapped);
                        (first_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), first_expect, context, world);
                        case first_result.is_ok of {
                            false -> first_result;
                            true -> {
                                (second_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), second_expect, context, world);
                                second_result
                            }
                        }
                    };
                    false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("tuple literal requires tuple type, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect4")
                };
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("tuple literal requires tuple type, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect4")
            }
        }
    }
}

fn tuple_trim_leading(s: string) -> string {
    tuple_trim_leading_from(s, 0)
}

fn tuple_trim_leading_from(s: string, i: int64) -> string {
    case i >= length_bytes(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_leading_from(s, i + 1);
            false -> substring(s, i, length_bytes(s))
        }
    }
}

// Find first comma at top level (not inside parentheses). Handles nested tuples recursively.
fn tuple_find_top_level_comma(s: string, i: int64) -> int64 {
    tc_tuple_find_top_level_comma_from(s, i, 0, 0, 0)
}

// Top-level over paren/brace/bracket depth (all three must be 0 for a comma to split tuple components).
// Spec: `(A, B)` tuple may carry record or list components (`{...}`, `List[...]`) whose internal commas
// are not tuple separators (§3.3 / §15.4.13.2 for supervisor init return shape).
// Prefixed `tc_` to avoid collision with parser_tuples' paren-only variant under the bootstrap compiler's
// flat function namespace.
fn tc_tuple_find_top_level_comma_from(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> length_bytes(s);
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> case paren <= 0 and brace == 0 and bracket == 0 of {
                        true -> length_bytes(s);
                        false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren - 1, brace, bracket)
                    };
                    false -> case c == "{" of {
                        true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket - 1);
                                    false -> case c == "," of {
                                        true -> case paren == 0 and brace == 0 and bracket == 0 of {
                                            true -> i;
                                            false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket)
                                        };
                                        false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Find last comma at top level (over paren/brace/bracket). For right-nested (a,(b,c)),
// inner has type (A,B), right_expr has type C; record/list components must not confuse the split.
fn tuple_find_last_top_level_comma(s: string) -> int64 {
    tc_tuple_find_last_top_level_comma_from(s, 0, 0, 0, 0, -1)
}

fn tc_tuple_find_last_top_level_comma_from(s: string, i: int64, paren: int64, brace: int64, bracket: int64, last: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> case last < 0 of { true -> length_bytes(s); false -> last };
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren + 1, brace, bracket, last);
                false -> case c == ")" of {
                    true -> case paren <= 0 and brace == 0 and bracket == 0 of {
                        true -> case last < 0 of { true -> length_bytes(s); false -> last };
                        false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren - 1, brace, bracket, last)
                    };
                    false -> case c == "{" of {
                        true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace + 1, bracket, last);
                        false -> case c == "}" of {
                            true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace - 1, bracket, last);
                            false -> case c == "[" of {
                                true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket + 1, last);
                                false -> case c == "]" of {
                                    true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket - 1, last);
                                    false -> case c == "," of {
                                        true -> case paren == 0 and brace == 0 and bracket == 0 of {
                                            true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, i);
                                            false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, last)
                                        };
                                        false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, last)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn tc_decompose_call_rhs_type(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rhs_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    case type_checker_expressions_helpers@expr_kind(rhs) == 4 and length_bytes(type_checker_expressions_helpers@expr_name(rhs)) > 0 of {
        true -> type_checker_collections@resolve_constructor_call_formal(type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(rhs), context), rhs_type);
        false -> rhs_type
    }
}

