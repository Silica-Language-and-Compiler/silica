            false -> type_checker_core@type_check_err("E2006", type_checker_expressions_helpers@expr_loc(expr), "unit is not a valid type for variables or parameters", "sect4")
        };
        false -> {
            is_discard: boolean <- length_bytes(type_checker_expressions_helpers@expr_name(expr)) == 1 and substring(type_checker_expressions_helpers@expr_name(expr), 0, 1) == "_";
            rhs_expected: string <- case is_discard of { true -> "discard"; false -> bind_type };
            range_result: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case is_discard of {
                true -> discard_literal_range_check(type_checker_expressions_helpers@expr_child_inner(expr), bind_type);
                false -> type_checker_core@type_check_ok()
            };
            (rhs_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), rhs_expected, context, world);
            case range_result.is_ok and rhs_result.is_ok of {
                false -> case range_result.is_ok of {
                    true -> rhs_result;
                    false -> range_result
                };
                true -> {
                    bound_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@context_add_symbol_surface(context, type_checker_expressions_helpers@expr_name(expr), bind_type, parser_ast@empty_effect_name_list(), "");
                    new_env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- enrich_env_for_actor_spawn(bound_ctx.env, type_checker_expressions_helpers@expr_name(expr), bind_type, type_checker_expressions_helpers@expr_child_inner(expr), context);
                    new_context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@type_context_with_env(bound_ctx, new_env);
                    (body_result, _) <- check_typed(type_checker_expressions_helpers@expr_child_right(expr), expected_type, new_context, world);
                    body_result
                }
            }
        }
    }
}

// A discard binding `_: T <- <integer literal>` gets the range check a named binding gets (E2011, spec §6).
fn discard_literal_range_check(rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, bind_type: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    surface: string <- type_checker_record_types@strip_spaces_rt(bind_type);
    case type_checker_expressions_helpers@expr_kind(rhs) == 0 and discard_integer_surface(surface) and string_parse@is_integer_literal_text(type_checker_expressions_helpers@expr_value(rhs)) of {
        true -> type_checker_expressions_literals@check_numeric_literal_against_integer_kind(type_checker_expressions_helpers@expr_value(rhs), type_checker_expressions_helpers@expr_loc(rhs), true, surface);
        false -> type_checker_core@type_check_ok()
    }
}

fn discard_integer_surface(surface: string) -> boolean {
    case surface of {
        "int8" -> true;
        "int16" -> true;
        "int32" -> true;
        "int64" -> true;
        "uint8" -> true;
        "uint16" -> true;
        "uint32" -> true;
        "uint64" -> true;
        _: string -> false
    }
}

// Build context with all bindings from sequence body (let chain and tuple decomposes).
// The produces pure expr sees variables bound in the body.
fn context_after_sequence_body(body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } {
    case type_checker_expressions_helpers@expr_kind(body) == 6 of {
        true -> {
            is_discard: boolean <- type_checker_expressions_helpers@expr_value(body) == "unit" and type_checker_expressions_helpers@expr_name(body) == "_";
            new_context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- case is_discard of {
                true -> context;
                false -> {
                    bound_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@context_add_symbol_surface(context, type_checker_expressions_helpers@expr_name(body), type_checker_expressions_helpers@expr_value(body), parser_ast@empty_effect_name_list(), "");
                    enriched_env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- enrich_env_for_actor_spawn(bound_ctx.env, type_checker_expressions_helpers@expr_name(body), type_checker_expressions_helpers@expr_value(body), type_checker_expressions_helpers@expr_child_inner(body), context);
                    type_checker_core@type_context_with_env(bound_ctx, enriched_env)
                }
            };
            context_after_sequence_body(type_checker_expressions_helpers@expr_child_right(body), new_context)
        };
        false -> case type_checker_expressions_helpers@expr_kind(body) == 10 of {
            true -> {
                rhs_type: string <- case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(body)) == 11 of {
                    true -> type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_inner(body)), context_after_sequence_body(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_inner(body)), context));
                    false -> type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(body), context)
                };
                rhs_trimmed: string <- type_checker_tuple_decompose_helpers@tuple_trim(rhs_type);
                tuple_for_fill: string <- case length_bytes(type_checker_expressions_helpers@expr_value(body)) > 0 of {
                    true -> type_checker_tuple_decompose_helpers@tuple_trim(type_checker_expressions_helpers@expr_value(body));
                    false -> rhs_trimmed
                };
                filled: List[{ name: string, path: string, type_str: string }, mem(normal)] <- type_checker_tuple_decompose_helpers@fill_empty_binding_types_from_rhs(type_checker_expressions_helpers@expr_pattern_bindings(body), tuple_for_fill);
                extended: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_tuple_decompose_helpers@add_bindings_to_context(context, filled);
                context_after_sequence_body(type_checker_expressions_helpers@expr_child_right(body), extended)
            };
            false -> context
        }
    }
}

// Sequence block (kind 11): sequence [proc[ε]] {statements} produces pure expr end
// inner = body (statements before produces), right_expr = result (pure expr); sequence_effects validated by effect checker
