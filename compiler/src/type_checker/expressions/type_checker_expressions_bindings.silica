    bind_type: string <- type_checker_expressions_helpers@expr_value(expr);
    case length_bytes(bind_type) == 0 of {
        true -> type_checker_core@type_check_err("E2018", type_checker_expressions_helpers@expr_loc(expr), concat(concat("variable binding '", type_checker_expressions_helpers@expr_name(expr)), "' must have an explicit type annotation; write 'name: <type> <- ...'"), "sect8.3.1");
