} }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    mem_result: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_memory_regions@validate_memory_region_type_in_context(bind_type, type_checker_expressions_helpers@expr_loc(expr), context);
    case mem_result.is_ok of {
        false -> mem_result;
        true -> check_let_after_validation(expr, expected_type, context, bind_type, world, check_surface, check_typed)
    }
}

// When a let-binding creates an actor_ref from spawn (or dangerous_actor_ref from spawn_dangerous),
// record the behavior function type and enforce region move semantics (§12.1.5).
fn enrich_env_for_actor_spawn(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], var_name: string, bind_type: string, rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] {
    rhs_base: string <- case type_checker_core@call_name_is_module_qualified(type_checker_expressions_helpers@expr_name(rhs)) of {
        true -> "";
        false -> type_checker_expressions_helpers@expr_name(rhs)
    };
    spawn_pair_ok: boolean <- case bind_type == "actor_ref" and rhs_base == "spawn" of {
        true -> true;
        false -> case bind_type == "dangerous_actor_ref" and rhs_base == "spawn_dangerous" of {
            true -> true;
            false -> case bind_type == "dangerous_actor_ref" and rhs_base == "spawn_dangerous_registered" of {
                true -> true;
                false -> bind_type == "device_actor_ref" and (rhs_base == "spawn_device" or rhs_base == "spawn_device_registered")
            }
        }
    };
    spawned_env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- case type_checker_expressions_helpers@expr_kind(rhs) == 4 and spawn_pair_ok of {
        true -> {
            beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_behavior_expr(rhs);
            env1: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- case type_checker_expressions_helpers@expr_kind(beh_e) == 1 of {
                true -> {
                    (beh_found: boolean, beh_id: int64) <- type_checker_core@lookup_behavior_found(context.env, type_checker_expressions_helpers@expr_name(beh_e));
                    beh_type: string <- type_checker_core@lookup_behavior_surface(context.env, type_checker_expressions_helpers@expr_name(beh_e));
                    case beh_found of {
                        true -> {
                            beh_name: string <- type_checker_expressions_actors@qualified_behavior_name(type_checker_expressions_helpers@expr_name(beh_e), type_checker_expressions_helpers@expr_loc(beh_e).file);
                            env_named: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- type_checker_core@add_symbol(env, type_checker_expressions_actors@actor_behavior_name_key(var_name), beh_id, beh_name, parser_ast@empty_effect_name_list(), "");
                            env_beh: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- type_checker_core@add_symbol(env_named, concat("__actor_beh__", var_name), beh_id, beh_type, parser_ast@empty_effect_name_list(), "");
                            state_t: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_type);
                            sup_csv: string <- type_checker_core@lookup_supervisor_csv(context);
                            case type_checker_core@type_name_in_supervisor_csv(state_t, sup_csv) or length_bytes(sup_csv) > 0 of {
                                true -> {
                                    bool_p: { context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, id: int64, ok: boolean } <- type_checker_core@parse_type_into_context(context, "boolean");
                                    type_checker_core@add_symbol(env_beh, actor_ref_supervisor_marker_name(var_name), bool_p.id, "boolean", parser_ast@empty_effect_name_list(), "")
                                };
                                false -> env_beh
                            }
                        };
                        false -> env
                    }
                };
                false -> env
            };
            state_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(rhs);
            case type_checker_expressions_helpers@expr_kind(state_e) == 1 of {
                true -> {
                    (st_found: boolean, _: int64) <- type_checker_core@lookup_symbol_found(context.env, type_checker_expressions_helpers@expr_name(state_e));
                    st_type: string <- type_checker_core@lookup_symbol_surface(context.env, type_checker_expressions_helpers@expr_name(state_e));
                    case st_found and type_checker_memory_regions@is_memory_region_type(st_type) of {
                        true -> {
                            moved_p: { context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, id: int64, ok: boolean } <- type_checker_core@parse_type_into_context(context, "moved_region");
                            type_checker_core@add_symbol(env1, type_checker_expressions_helpers@expr_name(state_e), moved_p.id, "moved_region", parser_ast@empty_effect_name_list(), "")
                        };
                        false -> env1
                    }
                };
                false -> env1
            }
        };
        false -> env
    };
    self_alias_env(spawned_env, var_name, bind_type, rhs, context)
}

// Records whether an actor_ref binding holds self() (spec 15.1.2.3, 16.2.6.5), so call() to it
// and remove_actor or kill_abnormal of it are rejected like the self() forms. A later actor_ref
// binding of the same name to anything else clears the mark.
fn self_alias_env(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], var_name: string, bind_type: string, rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] {
    case bind_type == "actor_ref" of {
        false -> env;
        true -> {
            marker: string <- type_checker_expressions_actors@self_alias_marker_name(var_name);
            case type_checker_expressions_actors@actor_target_self_kind(rhs, context) == 0 of {
                false -> type_checker_core@add_symbol(env, marker, 0, "1", parser_ast@empty_effect_name_list(), "");
                true -> case type_checker_expressions_actors@env_lookup_surface(context.env, marker) == "1" of {
                    true -> type_checker_core@add_symbol(env, marker, 0, "0", parser_ast@empty_effect_name_list(), "");
                    false -> env
                }
            }
        }
    }
}

// Lambda (kind 991): formals in pattern_bindings; value = synthesized `(T1,...) -> R`; right_expr kind 992 holds return type text.
// Body is checked in a context extended with formals on top of the current env so outer bindings remain visible (closure capture).
fn lambda_formal_bindings_valid(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case bindings.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case length_bytes(bindings.head.type_str) == 0 of {
            true -> type_checker_core@type_check_err("E2006", location, "lambda parameter must have an explicit type", "sect4");
            false -> {
