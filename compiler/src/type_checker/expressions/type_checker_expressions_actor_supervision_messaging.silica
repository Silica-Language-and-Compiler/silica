fn check_cast_device_registered_registry_rules(name_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@expr_kind(name_e) == 5 and length_bytes(type_checker_expressions_helpers@expr_value(name_e)) >= 8 and substring(type_checker_expressions_helpers@expr_value(name_e), 0, 8) == ":device_" of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2233", type_checker_expressions_helpers@expr_loc(name_e), "cast_device_registered requires a registry name whose spelling begins with :device_ (silica_device_actor_specification.md §1)", "sect1")
    }
}

