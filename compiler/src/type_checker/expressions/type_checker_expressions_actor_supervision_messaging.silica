_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 of {
        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "send expects 2 arguments: (actor_ref, message) §16.1", "sect16");
        true -> {
            (r0, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "actor_ref", context, world);
            case r0.is_ok of {
                false -> r0;
                true -> {
                    beh_type: string <- type_checker_expressions_actors@lookup_actor_behavior_type(expr, context);
                    msg_expected: string <- case length_bytes(beh_type) > 0 of {
                        true -> type_checker_expressions_actors@parse_behavior_msg_param_type(beh_type);
                        false -> "discard"
                    };
                    msg_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_second_arg_expr(expr);
                    (r1, _) <- check_surface(msg_e, msg_expected, context, world);
                    case r1.is_ok of {
                        false -> r1;
                        true -> {
                            am_check: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_actor_message_satisfies_am(expr, msg_e, context);
                            case am_check.is_ok of {
                                false -> am_check;
                                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_atom() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("send returns atom, expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect16")
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}


// "<module>@<name> " for the behaviour an actor was spawned with, "" when it is not known.
fn behaviour_text(name: string) -> string {
    case length_bytes(name) == 0 of {
        true -> "";
        false -> concat(name, " ")
    }
}

// Spec 16.2.6.5. `alias` is the name bound from self() that the call names, or "" for self().
fn self_call_message(alias: string) -> string {
    head: string <- case length_bytes(alias) == 0 of {
        true -> "cannot call(self(), ...)";
        false -> concat(concat("cannot call(self(), ...): '", alias), "' is bound to self()")
    };
    concat(head, "\n  - self() returns the current actor's reference\n  - calling self() would deadlock (actor waits for reply from itself)\n  - use cast(self(), ...) for asynchronous self-messages instead")
}
