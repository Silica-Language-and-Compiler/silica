// Actor call/cast/send built-in checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_expressions_actors;
use type_checker_tuple_decompose_helpers;
use type_checker_expressions_actor_spawn;

export check_actor_call_builtin/6;
export check_actor_call_registered_builtin/6;
export check_actor_cast_builtin/6;
export check_send_after_builtin/6;
export check_actor_cast_registered_builtin/6;
export check_actor_cast_device_builtin/6;
export check_actor_cast_device_registered_builtin/6;
export check_actor_cast_dangerous_registered_builtin/6;
export check_actor_send_builtin/6;

fn check_actor_message_satisfies_am(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, msg_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    has_postfix: boolean <- type_checker_expressions_actors@call_has_impl_am_marker(expr);
    case has_postfix of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(msg_e), "message must satisfy ActorMessage (§16.3.2); use `expr impl ActorMessage {}`", "sect16")
    }
}

// cast/send/call accept actor_ref or dangerous_actor_ref as the target (same runtime handle; distinct types at bind sites).
