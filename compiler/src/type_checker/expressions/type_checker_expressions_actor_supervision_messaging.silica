 :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    ref_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(ref_e, context);
    case ref_type == "device_actor_ref" of {
        true -> type_checker_core@type_check_err("E2225", type_checker_expressions_helpers@expr_loc(ref_e), "cast, call and send cannot target a device_actor_ref; use cast_device or cast_device_registered (silica_device_actor_specification.md §4.1, §4.5)", "sect4.1");
        false -> check_actor_message_target_ordinary(ref_type, ref_e, context, world, check_surface, check_typed)
    }
}

