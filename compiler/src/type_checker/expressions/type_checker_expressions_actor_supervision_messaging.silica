            (rd, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "uint64", context, world);
            case rd.is_ok of {
                false -> rd;
                true -> {
                    // The target and the message are the second and third arguments. The parser nests
                    // them as a pair with the shape of a two-argument call, so the cast rules of
                    // §16.2.6.3 are checked on that pair exactly as check_actor_cast_builtin checks a cast.
                    sub: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_right(expr);
                    r0: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_actor_message_target(type_checker_expressions_helpers@expr_child_inner(sub), context, world, check_surface, check_typed);
                    case r0.is_ok of {
                        false -> r0;
                        true -> {
                            beh_type: string <- type_checker_expressions_actors@lookup_actor_behavior_type(sub, context);
                            call_only: boolean <- case length_bytes(beh_type) > 0 of {
                                true -> type_checker_expressions_actors@behavior_return_is_call_only(type_checker_expressions_actors@parse_function_return_actor(beh_type));
                                false -> false
                            };
                            case call_only of {
                                true -> type_checker_core@type_check_err("E2237", type_checker_expressions_helpers@expr_loc(expr), concat(concat("cannot send_after() to a call-only actor: its behaviour ", behaviour_text(type_checker_expressions_actors@lookup_actor_behavior_name(sub, context))), "returns (:reply, ...); a timer's message is a cast (§22.14.2, §16.2.6.3)"), "sect22.14");
                                false -> {
                                    msg_expected: string <- case length_bytes(beh_type) > 0 of {
                                        true -> type_checker_expressions_actors@parse_behavior_msg_param_type(beh_type);
                                        false -> "discard"
                                    };
                                    msg_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_second_arg_expr(sub);
                                    (r1, _) <- check_surface(msg_e, msg_expected, context, world);
                                    case r1.is_ok of {
                                        false -> r1;
                                        true -> {
                                            am_check: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_actor_message_satisfies_am(sub, msg_e, context);
                                            case am_check.is_ok of {
                                                false -> am_check;
                                                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_timer_ref() or type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("send_after returns timer_ref, expected ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect22.14")
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

