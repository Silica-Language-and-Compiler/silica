// Thin kind dispatcher: binary ops and unary minus.
// Kind 4 (user call) is routed from the facade to user_call_check so this
// process does not intern that leaf's two /6 exports plus a local /6.
// No type_checker_core: ok/error records are built locally so this unit
// does not intern that module's 33 exports.

use type_checker_expressions_helpers;
use type_checker_expressions_binary_ops;

export check_ops/6;

fn type_check_ok_local() -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    { is_ok: true, error_code: "", error_location: { file: "", line: 0, column: 0, offset: 0 }, error_message: "", spec_section: "" }
}

fn type_check_err_local(error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    { is_ok: false, error_code: error_code, error_location: error_location, error_message: error_message, spec_section: spec_section }
}

