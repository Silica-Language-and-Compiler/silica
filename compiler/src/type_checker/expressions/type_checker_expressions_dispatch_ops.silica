    case type_checker_expressions_helpers@expr_kind(expr) of {
        3 -> (type_checker_expressions_binary_ops@check_binary_op(expr, expected_type, context, world, check_surface, check_typed), context);
        12 -> (type_checker_expressions_binary_ops@check_unary_minus_forbidden(expr, context), context);
