// Numeric, bitwise, negate, and print builtin call checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_expressions_numeric_builtins;
use type_checker_expressions_print_negate;
use type_checker_expressions_binary_ops;
use type_checker_expressions_float32_calls;

export is_numeric_print_name/1;
export check_numeric_print/6;

fn is_numeric_print_name(n: string) -> boolean {
    case type_checker_expressions_numeric_builtins@is_float_special_const_name(n) of {
        true -> true;
        false -> case type_checker_expressions_numeric_builtins@is_float_predicate_name(n) of {
            true -> true;
            false -> case type_checker_expressions_numeric_builtins@is_checked_int64_builtin_call(n) of {
                true -> true;
                false -> case type_checker_expressions_numeric_builtins@is_collection_result_builtin_call(n) of {
                    true -> true;
                    false -> case type_checker_expressions_numeric_builtins@is_ordering_identity_builtin_call(n) of {
                        true -> true;
                        false -> case type_checker_expressions_numeric_builtins@is_actor_ref_equality_builtin_call(n) of {
                        true -> true;
                        false -> case n == "bnot" or n == "not" or n == "negate_unit" of {
                            true -> true;
                            false -> case length_bytes(type_checker_expressions_print_negate@negate_builtin_arg_type(n)) > 0 of {
                                true -> true;
                                false -> case n == "print_int64" or n == "print_int32" or n == "print_int16" or n == "print_int8" or n == "print_uint64" or n == "print_uint32" or n == "print_uint16" or n == "print_uint8" or n == "print_boolean" or n == "print_char" or n == "print_atom" or n == "atom_bits" or n == "actor_ref_bits" or n == "actor_ref_of_word" or n == "print_float64" or n == "print_float32" or n == "print_float16" or n == "print_string" or n == "print" or n == "println" or n == "print_string_stderr" or n == "println_stderr" of {
                                    true -> true;
                                    false -> false
                                }
                            }
                        }
                        }
                    }
                }
            }
        }
    }
}

fn check_numeric_print(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], check_surface: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }), check_typed: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, int64, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_numeric_builtins@is_float_special_const_name(type_checker_expressions_helpers@expr_name(expr)) of {
        true -> type_checker_expressions_numeric_builtins@check_float_special_const_call(expr, expected_type, context);
        false -> case type_checker_expressions_numeric_builtins@is_float_predicate_name(type_checker_expressions_helpers@expr_name(expr)) of {
            true -> type_checker_expressions_numeric_builtins@check_float_predicate_call(expr, expected_type, context, world, check_surface, check_typed);
            false -> case type_checker_expressions_numeric_builtins@is_checked_int64_builtin_call(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> type_checker_expressions_numeric_builtins@check_checked_int64_builtin_call(expr, expected_type, context, world, check_surface, check_typed);
                false -> case type_checker_expressions_numeric_builtins@is_collection_result_builtin_call(type_checker_expressions_helpers@expr_name(expr)) of {
                    true -> type_checker_expressions_numeric_builtins@check_collection_result_builtin_call(expr, expected_type, context, world, check_surface, check_typed);
                    false -> case type_checker_expressions_numeric_builtins@is_ordering_identity_builtin_call(type_checker_expressions_helpers@expr_name(expr)) of {
                        true -> type_checker_expressions_numeric_builtins@check_ordering_identity_builtin_call(expr, expected_type, context, world, check_surface, check_typed);
                        false -> case type_checker_expressions_numeric_builtins@is_actor_ref_equality_builtin_call(type_checker_expressions_helpers@expr_name(expr)) of {
                        true -> type_checker_expressions_numeric_builtins@check_actor_ref_equality_builtin_call(expr, expected_type, context, world, check_surface, check_typed);
                        false -> case type_checker_expressions_helpers@expr_name(expr) == "bnot" or type_checker_expressions_helpers@expr_name(expr) == "not" of {
                            true -> type_checker_expressions_binary_ops@check_unary_keyword_call(expr, expected_type, context, world, check_surface, check_typed);
                            false -> case type_checker_expressions_helpers@expr_name(expr) == "negate_unit" of {
                                true -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), "negation is not supported for unit", "sect6");
                                false -> case length_bytes(type_checker_expressions_print_negate@negate_builtin_arg_type(type_checker_expressions_helpers@expr_name(expr))) > 0 of {
                                    true -> type_checker_expressions_print_negate@check_negate_call(expr, type_checker_expressions_print_negate@negate_builtin_arg_type(type_checker_expressions_helpers@expr_name(expr)), expected_type, context, world, check_surface, check_typed);
                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int64" of {
                                        true -> type_checker_expressions_print_negate@check_print_call(expr, "int64", expected_type, context, world, check_surface, check_typed);
                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int32" of {
                                            true -> type_checker_expressions_print_negate@check_print_call(expr, "int32", expected_type, context, world, check_surface, check_typed);
                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int16" of {
                                                true -> type_checker_expressions_print_negate@check_print_call(expr, "int16", expected_type, context, world, check_surface, check_typed);
                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int8" of {
                                                    true -> type_checker_expressions_print_negate@check_print_call(expr, "int8", expected_type, context, world, check_surface, check_typed);
                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint64" of {
                                                        true -> type_checker_expressions_print_negate@check_print_call(expr, "uint64", expected_type, context, world, check_surface, check_typed);
                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint32" of {
                                                            true -> type_checker_expressions_print_negate@check_print_call(expr, "uint32", expected_type, context, world, check_surface, check_typed);
                                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint16" of {
                                                                true -> type_checker_expressions_print_negate@check_print_call(expr, "uint16", expected_type, context, world, check_surface, check_typed);
                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint8" of {
                                                                    true -> type_checker_expressions_print_negate@check_print_call(expr, "uint8", expected_type, context, world, check_surface, check_typed);
                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_boolean" or type_checker_expressions_helpers@expr_name(expr) == "print_char" of {
                                                                        // print_boolean is the spec name (section 5.1.4).
                                                                        // print_char takes a char and answers an atom like the numeric prints.
                                                                        true -> case type_checker_expressions_helpers@expr_name(expr) == "print_char" of {
                                                                            true -> type_checker_expressions_print_negate@check_print_call(expr, "char", expected_type, context, world, check_surface, check_typed);
                                                                            false -> {
                                                                            (arg_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "boolean", context, world);
                                                                            case arg_result.is_ok of {
                                                                                false -> arg_result;
                                                                                true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                                                    "boolean" -> type_checker_core@type_check_ok();
                                                                                    "atom" -> type_checker_core@type_check_ok();
                                                                                    "discard" -> type_checker_core@type_check_ok();
                                                                                    _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("print_boolean expects boolean or atom result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                                                }
                                                                            }
                                                                            }
                                                                        };
                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_atom" of {
                                                                            true -> {
                                                                                (arg_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "atom", context, world);
                                                                                case arg_result.is_ok of {
                                                                                    false -> arg_result;
                                                                                    true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                                                        "atom" -> type_checker_core@type_check_ok();
                                                                                        "discard" -> type_checker_core@type_check_ok();
                                                                                        _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("print_atom expects atom result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                                                    }
                                                                                }
                                                                            };
                                                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "atom_bits" of {
                                                                                true -> {
                                                                                    (ra, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "atom", context, world);
                                                                                    case ra.is_ok of {
                                                                                        false -> ra;
                                                                                        true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                                                            "int64" -> type_checker_core@type_check_ok();
                                                                                            "discard" -> type_checker_core@type_check_ok();
                                                                                            _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("atom_bits expects int64 result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                                                        }
                                                                                    }
                                                                                };
                                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "actor_ref_bits" of {
                                                                                    true -> {
                                                                                        (rr, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "actor_ref", context, world);
                                                                                        case rr.is_ok of {
                                                                                            false -> rr;
                                                                                            true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                                                                "int64" -> type_checker_core@type_check_ok();
                                                                                                "discard" -> type_checker_core@type_check_ok();
                                                                                                _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("actor_ref_bits expects int64 result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                                                            }
                                                                                        }
                                                                                    };
                                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "actor_ref_of_word" of {
                                                                                        true -> {
                                                                                            (rw, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "int64", context, world);
                                                                                            case rw.is_ok of {
                                                                                                false -> rw;
                                                                                                true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                                                                    "actor_ref" -> type_checker_core@type_check_ok();
                                                                                                    "discard" -> type_checker_core@type_check_ok();
                                                                                                    _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("actor_ref_of_word expects actor_ref result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                                                                }
                                                                                            }
                                                                                        };
                                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_float64" of {
                                                                                            true -> type_checker_expressions_print_negate@check_print_call(expr, "float64", expected_type, context, world, check_surface, check_typed);
                                                                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "print_float32" of {
                                                                                                true -> {
                                                                                                    (arg_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "float32", context, world);
                                                                                                    type_checker_expressions_float32_calls@check_print_float32_call(expr, expected_type, context, arg_result)
                                                                                                };
                                                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_float16" of {
                                                                                                    true -> {
                                                                                                        (arg_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "float16", context, world);
                                                                                                        type_checker_expressions_float32_calls@check_print_float32_call(expr, expected_type, context, arg_result)
                                                                                                    };
                                                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_string" or type_checker_expressions_helpers@expr_name(expr) == "print" or type_checker_expressions_helpers@expr_name(expr) == "println" or type_checker_expressions_helpers@expr_name(expr) == "print_string_stderr" or type_checker_expressions_helpers@expr_name(expr) == "println_stderr" of {
                                                                                                        true -> type_checker_expressions_print_negate@check_print_call(expr, "string", expected_type, context, world, check_surface, check_typed);
                                                                                                        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "internal: numeric/print dispatcher miss", "sect6")
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
