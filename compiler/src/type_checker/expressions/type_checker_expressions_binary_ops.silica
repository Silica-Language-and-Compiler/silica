> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    op: string <- type_checker_expressions_helpers@expr_value(expr);
    literal_left: boolean <- type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == 0;
    context_fixes: boolean <- is_unsigned_operand_surface(type_checker_expressions_helpers@expect_surf(context, expected_type));
    op_type: string <- case literal_left and context_fixes == false and is_shift_op_lexeme(op) == false of {
        true -> first_unsigned_type_of(type_checker_expressions_helpers@expr_child_right(expr), context, world, check_surface, check_typed);
        false -> bitwise_operand_type(expr, expected_type, context, world, check_surface, check_typed)
    };
    (left_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), op_type, context, world);
    case left_result.is_ok of {
        false -> left_result;
        true -> case is_shift_op_lexeme(op) of {
            true -> case shift_amount_literal_out_of_range(type_checker_expressions_helpers@expr_child_right(expr), unsigned_width(op_type)) of {
                true -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(type_checker_expressions_helpers@expr_child_right(expr)), concat("shift amount literal must be in range ", shift_range_text(op_type)), "sect6");
                false -> {
                    (right_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), "int64", context, world);
                    case right_result.is_ok of {
                        true -> check_unsigned_result(context, expected_type, type_checker_expressions_helpers@expr_loc(expr), concat("bitwise ", op), op_type);
                        false -> case expr_checks_as(type_checker_expressions_helpers@expr_child_right(expr), op_type, context, world, check_surface, check_typed) of {
                            true -> check_unsigned_result(context, expected_type, type_checker_expressions_helpers@expr_loc(expr), concat("bitwise ", op), op_type);
                            false -> right_result
                        }
                    }
                }
            };
            false -> {
                (right_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), op_type, context, world);
                case right_result.is_ok of {
                    false -> right_result;
                    true -> check_unsigned_result(context, expected_type, type_checker_expressions_helpers@expr_loc(expr), concat("bitwise ", op), op_type)
                }
            }
        }
    }
}

// Comparison: <, >, <=, >=, ==, != — operands boolean, numeric primitives, string, or atom; result bool
fn is_comparison_op_lexeme(op: string) -> boolean {
    op == "<" or op == ">" or op == "<=" or op == ">=" or op == "==" or op == "!="
}

// Try checking both operands with operand_type; return result if both ok.
