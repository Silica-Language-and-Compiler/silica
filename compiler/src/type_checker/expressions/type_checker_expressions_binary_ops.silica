fn shift_amount_literal_out_of_range(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, width: int64) -> boolean {
    case type_checker_expressions_helpers@expr_kind(expr) == 0 of {
        true -> {
            amount: int64 <- string_parse@string_to_int64(type_checker_expressions_helpers@expr_value(expr));
            amount < 0 or amount >= width
        };
        false -> false
    }
}

