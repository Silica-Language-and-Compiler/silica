// Binary, comparison, bitwise, and unary-minus checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_recursive_tuples;
use type_checker_lists;
use type_checker_collections;
use type_checker_expressions_actors;
use type_checker_supervisor;
use type_checker_record_types;
use type_checker_traits;
use type_checker_callee_env;
use type_checker_expressions_identifiers;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use string_parse;
use instantiated_fn_name;

export check_unary_minus_forbidden/2;
export check_binary_op/6;
export check_bnot_call/6;
export check_not_call/6;
export check_unary_keyword_call/6;

fn check_unary_minus_forbidden(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    inner_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, node.inner);
    inner_t: string <- type_checker_tuple_decompose_helpers@infer_expr_type(inner_e, context);
    case length_bytes(inner_t) == 0 of {
        true -> type_checker_core@type_check_err("E2013", node.location, "Unary minus (-) is not allowed; use negate_<type>(...) instead of the `-` symbol, where <type> matches the operand's numeric type (operand type could not be inferred)", "sect6");
        false -> case type_checker_expressions_helpers@is_primitive_numeric_type_name(inner_t) of {
            true -> {
                suggest: string <- concat("negate_", inner_t);
                type_checker_core@type_check_err("E2013", node.location, concat(concat("Unary minus (-) is not allowed; use ", suggest), "(...) instead of the `-` symbol"), "sect6")
            };
            false -> type_checker_core@type_check_err("E2013", node.location, concat(concat("Unary minus (-) is not allowed; use negate_<type>(...) instead of the `-` symbol (operand type is ", inner_t), ", not a primitive numeric)"), "sect6")
        }
    }
}

// Arithmetic: +, -, *, /, % (mod) - operands int64/int32/int16/int8/uint64/uint32/uint16/uint8, result matches operands
fn is_arithmetic_op_lexeme(op: string) -> boolean {
    op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
}

// Bitwise operators work on one unsigned width: uint64, uint32, uint16 or uint8 (§3.9).
fn is_bitwise_binary_op_lexeme(op: string) -> boolean {
    op == "bor" or op == "band" or op == "shl" or op == "shr"
}

fn is_shift_op_lexeme(op: string) -> boolean {
    op == "shl" or op == "shr"
}

fn is_unsigned_operand_surface(t: string) -> boolean {
    t == "uint64" or t == "uint32" or t == "uint16" or t == "uint8"
}

fn unsigned_kind(t: string) -> int64 {
    case t of {
        "uint8" -> type_interner@kind_uint8();
        "uint16" -> type_interner@kind_uint16();
        "uint32" -> type_interner@kind_uint32();
        _: string -> type_interner@kind_uint64()
    }
}

fn unsigned_width(t: string) -> int64 {
    case t of {
        "uint8" -> 8;
        "uint16" -> 16;
        "uint32" -> 32;
        _: string -> 64
    }
}

fn shift_range_text(t: string) -> string {
    case t of {
        "uint8" -> "0..7";
        "uint16" -> "0..15";
        "uint32" -> "0..31";
        _: string -> "0..63"
    }
}

fn check_unsigned_result(context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, expected_type: int64, location: { file: string, line: int64, column: int64, offset: int64 }, op_label: string, op_type: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@expected_kind_or_discard(context, expected_type, unsigned_kind(op_type)) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2003", location, concat(concat(concat(op_label, " returns "), concat(op_type, ", expected ")), type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
    }
}

