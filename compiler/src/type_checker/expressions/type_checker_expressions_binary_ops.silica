ring, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    op: string <- type_checker_expressions_helpers@expr_value(expr);
    case is_arithmetic_op_lexeme(op) of {
        true -> {
            operand_type: string <- case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                "int64" -> "int64";
                "int32" -> "int32";
                "int16" -> "int16";
                "int8" -> "int8";
                "uint64" -> "uint64";
                "uint32" -> "uint32";
                "uint16" -> "uint16";
                "uint8" -> "uint8";
                "float64" -> "float64";
                "float32" -> "float32";
                "float16" -> "float16";
                _: string -> "int64"
            };
            (left_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), operand_type, context, world);
            case left_result.is_ok of {
                false -> left_result;
                true -> {
                    (right_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), operand_type, context, world);
                    case right_result.is_ok of {
                        false -> right_result;
                        true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                            "int64" -> type_checker_core@type_check_ok();
                            "int32" -> type_checker_core@type_check_ok();
                            "int16" -> type_checker_core@type_check_ok();
                            "int8" -> type_checker_core@type_check_ok();
                            "uint64" -> type_checker_core@type_check_ok();
                            "uint32" -> type_checker_core@type_check_ok();
                            "uint16" -> type_checker_core@type_check_ok();
                            "uint8" -> type_checker_core@type_check_ok();
                            "float64" -> type_checker_core@type_check_ok();
                            "float32" -> type_checker_core@type_check_ok();
                            "float16" -> type_checker_core@type_check_ok();
                            "discard" -> type_checker_core@type_check_ok();
                            _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("arithmetic op expects integer or float result (int64/.../float64/float32/float16), got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                        }
                    }
                }
            }
        };
        false -> case is_bitwise_binary_op_lexeme(op) of {
            true -> check_bitwise_binary_op(expr, expected_type, context, world, check_surface, check_typed);
            false -> case is_comparison_op_lexeme(op) of {
            true -> check_comparison_result(expr, expected_type, context, world, check_surface, check_typed);
            false -> case is_logical_op_lexeme(op) of {
                true -> {
                    (left_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "boolean", context, world);
                    case left_result.is_ok of {
                        false -> left_result;
                        true -> {
                            (right_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), "boolean", context, world);
                            case right_result.is_ok of {
                                false -> right_result;
                            true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                "boolean" -> type_checker_core@type_check_ok();
                                "discard" -> type_checker_core@type_check_ok();
                                _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("logical op expects boolean result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                            }
                            }
                        }
                    }
                };
                false -> type_checker_core@type_check_err("E2004", type_checker_expressions_helpers@expr_loc(expr), concat("unknown operator: ", op), "sect6")
            }
        }
        }
    }
}

// Multi-arg calls use kind-4 continuations with name "" (see extract_call_rest). Second argument is inner of that node.
