    (left_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), operand_type, context, world);
    case left_result.is_ok of {
        false -> left_result;
        true -> {
                        (r, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), operand_type, context, world);
                        r
                    }
    }
}

fn is_comparison_operand_type(t: string) -> boolean {
    t == "boolean" or t == "int64" or t == "int32" or t == "int16" or t == "int8" or t == "uint64" or t == "uint32" or t == "uint16" or t == "uint8" or t == "float64" or t == "float32" or t == "float16" or t == "string" or t == "atom"
        // Actor references compare by identity, (position, child number) (spec 15.1.4).
        or t == "actor_ref" or t == "dangerous_actor_ref" or t == "device_actor_ref" or t == "supervisor_ref"
}

fn inferred_comparison_operand_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    left_t: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
    right_t: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_right(expr), context);
    case length_bytes(left_t) > 0 of {
        true -> case is_comparison_operand_type(left_t) of {
            false -> "";
            true -> case length_bytes(right_t) > 0 of {
                true -> case left_t == right_t of { true -> left_t; false -> "" };
                false -> left_t
            }
        };
        false -> case length_bytes(right_t) > 0 of {
            true -> case is_comparison_operand_type(right_t) of { true -> right_t; false -> "" };
            false -> ""
        }
    }
}

// Try each supported comparison operand type; first match wins.
// Signed: int64, int32, int16, int8. Unsigned: uint64, uint32, uint16, uint8. Also float32, float16, string, atom (ordering by atom table index), boolean.
fn bool_result(context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, expected_type: int64, location: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@expected_kind_or_discard(context, expected_type, type_interner@kind_boolean()) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2003", location, concat("comparison op expects boolean result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
    }
}

