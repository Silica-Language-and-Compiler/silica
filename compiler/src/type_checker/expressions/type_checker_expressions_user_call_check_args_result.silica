// Call-result type check. Split from args so world/tuple do not share one fat iface.

use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_lists;
use type_checker_collections;
use type_checker_traits;
use type_checker_expressions_user_call_helpers;
use type_checker_memory_regions;

export check_user_call_result_user_call/5;
export call_acc_witness/3;

fn strip_spaces_res_run_end(s: string, j: int64, n: int64) -> int64 {
    case j >= n of {
        true -> j;
        false -> case substring(s, j, j + 1) == " " of {
            true -> j;
            false -> strip_spaces_res_run_end(s, j + 1, n)
        }
    }
}

fn strip_spaces_res(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> case substring(s, i, i + 1) == " " of {
            true -> strip_spaces_res(s, i + 1, acc);
            false -> {
                n: int64 <- length_bytes(s);
                e: int64 <- strip_spaces_res_run_end(s, i, n);
                strip_spaces_res(s, e, concat(acc, substring(s, i, e)))
            }
        }
    }
}

fn strip_fn_paren_res_run_end(s: string, j: int64, n: int64) -> int64 {
    case j >= n of {
        true -> j;
        false -> case j + 3 <= n and substring(s, j, j + 3) == "fn(" of {
            true -> j;
            false -> strip_fn_paren_res_run_end(s, j + 1, n)
        }
    }
}

fn strip_fn_paren_res(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> case i + 3 <= length_bytes(s) and substring(s, i, i + 3) == "fn(" of {
            true -> strip_fn_paren_res(s, i + 3, concat(acc, "("));
            false -> {
                n: int64 <- length_bytes(s);
                e: int64 <- strip_fn_paren_res_run_end(s, i, n);
                strip_fn_paren_res(s, e, concat(acc, substring(s, i, e)))
            }
        }
    }
}

fn surfaces_eq_res_i(a: string, b: string) -> int64 {
    na: string <- strip_fn_paren_res(strip_spaces_res(a, 0, ""), 0, "");
    nb: string <- strip_fn_paren_res(strip_spaces_res(b, 0, ""), 0, "");
    case na == nb of {
        true -> 1;
        false -> 0
    }
}

// AccType's witness for one call: the call's expected result, or -- when the result is discarded
// or is still the AccType placeholder (a trait impl body forwarding to a fold) -- the concrete
// initial accumulator, argument two. Shared by the argument check (check_args) and the result
// check, so a callee's formals meet one witness wherever they are instantiated.
fn call_acc_witness(call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() or type_checker_core@surface_for_type_id(context, expected_type) == "AccType" of {
        true -> case type_checker_expressions_user_call_helpers@count_call_args_user_call(call_expr) >= 2 of {
            true -> {
                from_init: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@call_second_arg_expr(call_expr), context);
                case length_bytes(from_init) > 0 and from_init != "AccType" of {
                    true -> from_init;
                    false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
                }
            };
            false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
        };
        false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
    }
}

fn check_user_call_result_user_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, return_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    exp_surf: string <- type_checker_expressions_helpers@expect_surf(context, expected_type);
    arg_inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
    // Receiver witnesses first, the expected type's for what they leave open, AccType from the
    // call's accumulator witness: ONE pass over the callee's declared return (resolve_call_formal).
    // `return_type` is the declared text; every caller hands it over unsubstituted, so no witness
    // is ever scanned a second time.
    resolved_return: string <- type_checker_collections@resolve_call_formal(arg_inferred, exp_surf, call_acc_witness(expr, expected_type, context), return_type);
    constructor_module: string <- type_checker_collections@module_name_from_qualified_call(type_checker_expressions_helpers@expr_name(expr));
    registered_collection_constructor: boolean <- type_checker_collections@is_collection_constructor_base_name(type_checker_expressions_helpers@expr_name(expr)) and type_checker_collections@is_registered_construction_module(constructor_module);
    ret_ids_match: boolean <- type_checker_expressions_helpers@surface_type_matches_expected(context, resolved_return, expected_type);
    lists_match: boolean <- type_checker_lists@list_types_compatible(exp_surf, resolved_return);
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
        true -> type_checker_core@type_check_ok();
        false -> case ret_ids_match or lists_match of {
            true -> type_checker_core@type_check_ok();
            false -> case type_checker_collections@is_collection_trait_type(exp_surf) of {
            true -> case type_checker_collections@collection_return_accepts_constructor(exp_surf, resolved_return, world) of {
                false -> type_checker_core@type_check_err("E2017", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat(type_checker_expressions_helpers@expr_name(expr), " return type does not witness declared collection type "), exp_surf), " (got "), concat(resolved_return, ")")), "sect4");
                true -> type_checker_core@type_check_ok()
            };
            false -> case registered_collection_constructor and type_checker_collections@runtime_record_accepts_constructor_return(exp_surf, resolved_return, world) of {
                true -> type_checker_core@type_check_ok();
                false -> case type_checker_lists@formal_type_accepts_actual(resolved_return, exp_surf, world) of {
                    true -> type_checker_core@type_check_ok();
                    false -> case type_checker_lists@formal_type_accepts_actual(exp_surf, resolved_return, world) of {
                        true -> type_checker_core@type_check_ok();
                        false -> case type_checker_lists@types_equal_strip(exp_surf, resolved_return) of {
                            true -> type_checker_core@type_check_ok();
                            false -> case type_checker_expressions_user_call_helpers@trim_leading_user_call(exp_surf) == "string" and type_checker_expressions_user_call_helpers@return_type_has_ptr_len_out_fields(resolved_return) of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_traits@actual_type_satisfies_trait_expectation(resolved_return, exp_surf, world) of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> case surfaces_eq_res_i(resolved_return, exp_surf) of {
                                        1 -> type_checker_core@type_check_ok();
                                        // A collection bracket type nested in the expected record, list, tuple or
                                        // function type meets the constructor's concrete record there too (D6:
                                        // `{ set: OrderedSet[...], inserted: boolean } <- wbt_set@insert(s, x)`), and
                                        // a result still naming a placeholder (a trait method on a trait-typed
                                        // receiver) is a schema that the expectation instantiates. Last, the recursive
                                        // tuple equality (types_equal_surface): a result whose record spells a root
                                        // `ref?(L, S, rec)` meets an expectation that spells the node out (§4.2.2). And the
                                        // reverse schema case: an expectation that still names a placeholder (the
                                        // projection `call(...).field` is typed from the declared result record) is a
                                        // schema the instantiated result meets.
                                        _: int64 -> case type_checker_collections@collection_aware_types_compatible(resolved_return, exp_surf, world) or type_checker_memory_regions@device_window_types_equal_modulo_lifetime(resolved_return, exp_surf) or type_checker_tuple_decompose_helpers@types_equal_surface(resolved_return, exp_surf) or (type_interner@surface_contains_placeholder(exp_surf) and type_interner@surface_matches_schema(resolved_return, exp_surf)) of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat(type_checker_expressions_helpers@expr_name(expr), " returns "), resolved_return), ", expected "), exp_surf), "sect6")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }
}
