ef?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    loc: { file: string, line: int64, column: int64, offset: int64 } <- type_checker_expressions_helpers@expr_loc(expr);
    arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_second_arg_expr(expr);
    surf: string <- type_checker_expressions_helpers@expect_surf(context, expected_type);
    nt: string <- transport_types@decode_target_of_surface(surf);
    case length_bytes(nt) == 0 of {
        true -> type_checker_core@type_check_err("E2403", loc, concat("decode needs a binding typed (:ok, T) | (:rejected, atom) to know the type to build, got ", surf), "sect16.4");
        false -> {
            lim: { found: boolean, type_text: string, max_bytes: int64, max_depth: int64, max_length: int64, utf8: boolean } <- type_checker_transport@world_transportable_limits(world, nt);
            case lim.found of {
                false -> type_checker_core@type_check_err("E2411", loc, concat(concat("decode: the type ", nt), " is not declared Transportable; add `impl Transportable for <type> { max_bytes: N };` (design §4.1)"), "sect16.4");
                true -> {
                    (r, _) <- check_surface(arg, "string", context, world);
                    case r.is_ok of {
                        false -> r;
                        true -> type_checker_core@type_check_ok()
                    }
                }
            }
        }
    }
}
