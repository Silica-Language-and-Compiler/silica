ef?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    loc: { file: string, line: int64, column: int64, offset: int64 } <- type_checker_expressions_helpers@expr_loc(expr);
    arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_second_arg_expr(expr);
    surf: string <- type_checker_expressions_helpers@expect_surf(context, expected_type);
    nt: string <- transport_types@decode_target_of_surface(surf);
    case length_bytes(nt) == 0 of {
        true -> type_checker_core@type_check_err("E2403", loc, concat("decode needs a binding typed (:ok, T) | (:rejected, atom) to know the type to build, got ", surf), "sect16.4");
        false -> {
            problem: string <- transport_types@transport_problem(nt);
            case length_bytes(problem) > 0 of {
                true -> type_problem_err(loc, "decode", nt, problem);
                false -> {
                    (r, _) <- check_surface(arg, "string", context, world);
                    case r.is_ok of {
                        false -> r;
                        true -> check_limits_then_region(expr, loc, nt, context, world, check_surface)
                    }
                }
            }
        }
    }
}

// E2401 for a component that cannot cross, E2404 for a sum whose variants cannot be told apart.
fn type_problem_err(loc: { file: string, line: int64, column: int64, offset: int64 }, name: string, t: string, problem: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    code: string <- case length_bytes(problem) >= 11 and substring(problem, 0, 11) == "variants of" of { true -> "E2404"; false -> "E2401" };
    type_checker_core@type_check_err(code, loc, concat(concat(concat(name, " of "), t), concat(": ", problem)), "sect16.4")
}

// ---- the limits argument ------------------------------------------------------------------------
// `{ max_bytes: N, max_depth: D, max_length: L, utf8: true }`, any subset, every value a literal: the
// limits are compile-time constants that select the derived decoder (design §4.1).

fn third_argument(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr)))
}

fn literal_text(v: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    k: int64 <- type_checker_expressions_helpers@expr_kind(v);
    case k == 0 or k == 7 of {
        true -> type_checker_expressions_helpers@expr_value(v);
        false -> case k == 2 of {
            true -> literal_text(type_checker_expressions_helpers@expr_child_inner(v));
            false -> ""
        }
    }
}

fn limits_walk(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: { ok: boolean, message: string, max_bytes: int64, max_depth: int64, max_length: int64, utf8: boolean, has_bytes: boolean, has_length: boolean }) -> { ok: boolean, message: string, max_bytes: int64, max_depth: int64, max_length: int64, utf8: boolean, has_bytes: boolean, has_length: boolean } {
    k: int64 <- type_checker_expressions_helpers@expr_kind(e);
    case k == -1 or k == 999 of {
        true -> acc;
        false -> case k == 21 of {
            false -> { ok: false, message: "the limits of decode must be a record literal { max_bytes: N, max_depth: D, max_length: L }", max_bytes: 0, max_depth: 0, max_length: 0, utf8: false, has_bytes: false, has_length: false };
            true -> {
                field: string <- type_checker_expressions_helpers@expr_name(e);
                lit: string <- literal_text(type_checker_expressions_helpers@expr_child_inner(e));
                rest: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_right(e);
                n: int64 <- transport_types@parse_decimal(lit);
                case field == "max_bytes" and n >= 0 of {
                    true -> limits_walk(rest, { ok: acc.ok, message: acc.message, max_bytes: n, max_depth: acc.max_depth, max_length: acc.max_length, utf8: acc.utf8, has_bytes: true, has_length: acc.has_length });
                    false -> case field == "max_depth" and n >= 0 of {
                        true -> limits_walk(rest, { ok: acc.ok, message: acc.message, max_bytes: acc.max_bytes, max_depth: n, max_length: acc.max_length, utf8: acc.utf8, has_bytes: acc.has_bytes, has_length: acc.has_length });
                        false -> case field == "max_length" and n >= 0 of {
                            true -> limits_walk(rest, { ok: acc.ok, message: acc.message, max_bytes: acc.max_bytes, max_depth: acc.max_depth, max_length: n, utf8: acc.utf8, has_bytes: acc.has_bytes, has_length: true });
                            false -> case field == "utf8" and (lit == "true" or lit == "false") of {
                                true -> limits_walk(rest, { ok: acc.ok, message: acc.message, max_bytes: acc.max_bytes, max_depth: acc.max_depth, max_length: acc.max_length, utf8: lit == "true", has_bytes: acc.has_bytes, has_length: acc.has_length });
                                false -> { ok: false, message: concat(concat("the limits of decode: field `", field), "` is not max_bytes, max_depth or max_length with a non-negative integer literal, or utf8 with a boolean literal"), max_bytes: 0, max_depth: 0, max_length: 0, utf8: false, has_bytes: false, has_length: false }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn limits_of_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { ok: boolean, message: string, max_bytes: int64, max_depth: int64, max_length: int64, utf8: boolean, has_bytes: boolean, has_length: boolean } {
    start: { ok: boolean, message: string, max_bytes: int64, max_depth: int64, max_length: int64, utf8: boolean, has_bytes: boolean, has_length: boolean } <- { ok: true, message: "", max_bytes: 1048576, max_depth: 64, max_length: 0, utf8: false, has_bytes: false, has_length: false };
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 3 or ac == 4 of {
        true -> limits_walk(third_argument(expr), start);
        false -> start
    }
}

// The limits of a decode call as the text the derivation is keyed by (transport_types@limits_text);
// max_length defaults to max_bytes.
fn limits_text_of_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    r: { ok: boolean, message: string, max_bytes: int64, max_depth: int64, max_length: int64, utf8: boolean, has_bytes: boolean, has_length: boolean } <- limits_of_call(expr);
    ml: int64 <- case r.has_length of { true -> r.max_length; false -> r.max_bytes };
    transport_types@limits_text(r.max_bytes, r.max_depth, ml, r.utf8)
}

fn check_limits(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, loc: { file: string, line: int64, column: int64, offset: int64 }, nt: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    r: { ok: boolean, message: string, max_bytes: int64, max_depth: int64, max_length: int64, utf8: boolean, has_bytes: boolean, has_length: boolean } <- limits_of_call(expr);
    case r.ok of {
        false -> type_checker_core@type_check_err("E2402", loc, r.message, "sect16.4");
        true -> case transport_types@is_variable_sized(nt) and r.has_bytes == false of {
            true -> type_checker_core@type_check_err("E2402", loc, concat(concat("decode of ", nt), " needs limits: the type holds a string or a list, so its size is not fixed; give decode a third argument { max_bytes: N, max_depth: D, max_length: L } (design §4.1)"), "sect16.4");
            false -> type_checker_core@type_check_ok()
        }
    }
}

// A recursive type (a tuple with `ref?(L, S, rec)` slots) decodes into a region the caller owns: the
// fourth argument, `region(L, normal)` with the slot's lifetime (design §4.1, §4.2).
fn check_region(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, loc: { file: string, line: int64, column: int64, offset: int64 }, nt: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: