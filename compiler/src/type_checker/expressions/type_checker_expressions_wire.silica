    loc: { file: string, line: int64, column: int64, offset: int64 } <- type_checker_expressions_helpers@expr_loc(expr);
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case name == "recreate" of {
        true -> check_recreate(expr, expected_type, context, world, check_surface, check_typed);
        false -> check_wire_format_call(expr, expected_type, context, world, check_surface, check_typed)
    }
}

