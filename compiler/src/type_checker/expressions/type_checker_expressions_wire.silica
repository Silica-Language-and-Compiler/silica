    loc: { file: string, line: int64, column: int64, offset: int64 } <- type_checker_expressions_helpers@expr_loc(expr);
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 or ((ac == 3 or ac == 4) and name == "decode") of {
        false -> type_checker_core@type_check_err("E2005", loc, concat(name, " expects a format tag such as (:etf) and the value; decode may add a third argument, its limits { max_bytes: N, max_depth: D, max_length: L }"), "sect16.4");
        true -> {
            fmt: string <- format_of_argument(type_checker_expressions_helpers@expr_child_inner(expr));
            case length_bytes(fmt) == 0 of {
                true -> type_checker_core@type_check_err("E2408", loc, concat(name, "'s format must be a literal tag such as (:etf) (design §4.3)"), "sect16.4");
                false -> case transport_types@known_wire_format(fmt) of {
                    false -> type_checker_core@type_check_err("E2408", loc, concat(concat("unknown wire protocol (:", fmt), "): the language provides (:etf) (design §8)"), "sect16.4");
                    true -> case name == "encode" of {
                        true -> check_encode(expr, expected_type, context, world, check_surface);
                        false -> check_decode(expr, expected_type, context, world, check_surface)
                    }
                }
            }
        }
    }
}

fn check_encode(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: