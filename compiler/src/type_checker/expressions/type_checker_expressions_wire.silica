// Type checking of encode / decode (transport_serialization_design.md §4.3):
//   encode(F, x: T) -> string            proc[mem(normal)]
//   decode(F, frame: string) -> (:ok, T) | (:rejected, atom)
// F is a literal format tag, `(:etf)`; a variable or an unknown tag is E2408. T is the argument's
// type for encode and the binding's for decode (E2403 when the binding does not have the
// `(:ok, T) | (:rejected, atom)` shape). T is checked at each call (E2401, E2404); `decode` takes
// its limits as an optional third argument, a record literal of integer literals (E2402 when a
// variable-sized T has none or the literal is malformed). The derivation itself happens after SIR
// generation (transport_derive), one decode family per (format, type, limits).

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_expressions_actors;
use type_checker_tuple_decompose_helpers;
use transport_types;

export is_wire_builtin_name/1;
export check_wire_builtin/6;
export limits_text_of_call/1;

fn is_wire_builtin_name(n: string) -> boolean {
    n == "encode" or n == "decode" or n == "recreate"
}

// `(:etf)` as an expression: a parenthesised or one-element-tuple atom literal.
fn format_of_argument(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    k: int64 <- type_checker_expressions_helpers@expr_kind(e);
    inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(e);
    case (k == 2 or k == 9) and type_checker_expressions_helpers@expr_kind(inner) == 5 of {
        true -> transport_types@format_of_tag_text(type_checker_expressions_helpers@expr_value(inner));
        false -> case k == 5 of {
            true -> transport_types@format_of_tag_text(type_checker_expressions_helpers@expr_value(e));
            false -> ""
        }
    }
}

