            // A trait-typed receiver (a provided body's parameter, a function parameter typed with
            // the trait) has no selected implementation: the required signature applies
            // (silica-specification §3.4.12). trait_specialization makes the per-implementation
            // copies before code generation, where the receiver is concrete.
            true -> (false, parser_ast@dummy_decl());
            false -> {
                (ef: boolean, ed: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_tag0_decl_for_qualified_call_exact(decls, fn_name, arity, recv_ty, expected_ty, world);
                case ef of {
                    true -> (true, ed);
                    false -> case count_tag0_candidates(decls, fn_name, arity) > 1 of {
                        false -> find_tag0_decl_for_qualified_call_compatible(decls, fn_name, arity, recv_ty, expected_ty, world);
                        // Several implementations: select by the receiver's representation (its
                        // shape once placeholders bind; a bracket type's constructor record) before
                        // the loose fit, which picked by declaration order.
                        true -> {
                            (sf: boolean, sd: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_tag0_decl_for_qualified_call_schema(decls, fn_name, arity, recv_ty, world);
                            case sf of {
                                true -> (true, sd);
                                false -> find_tag0_decl_for_qualified_call_compatible(decls, fn_name, arity, recv_ty, expected_ty, world)
                            }
                        }
                    }
                }
            }
        }
    }
}

