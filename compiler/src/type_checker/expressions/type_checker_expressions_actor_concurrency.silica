    case eff of {
        "spawn_device" -> type_checker_expressions_actor_spawn@check_actor_spawn_call(expr, expected_type, context, world, "spawn_device", "device_actor_ref", check_surface, check_typed);
        "spawn_device_registered" -> type_checker_expressions_actor_spawn@check_actor_spawn_device_registered_call(expr, expected_type, context, world, check_surface, check_typed);
        "cast_device" -> type_checker_expressions_actor_supervision_messaging@check_actor_cast_device_builtin(expr, expected_type, context, world, check_surface, check_typed);
        "cast_device_registered" -> type_checker_expressions_actor_supervision_messaging@check_actor_cast_device_registered_builtin(expr, expected_type, context, world, check_surface, check_typed);
