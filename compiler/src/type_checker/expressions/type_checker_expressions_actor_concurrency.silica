ng) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    eff: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
    case is_device_worker_builtin(eff) of {
        true -> check_device_worker_builtin(expr, expected_type, context, world, check_surface, check_typed, eff);
        false -> case type_checker_expressions_actor_spawn@is_actor_runtime_helper_name(eff) of {
        true -> type_checker_expressions_actor_spawn@check_actor_runtime_helper_call(expr, expected_type, context, world, check_surface, check_typed);
        false -> case eff == "recv" of {
            true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "recv() is runtime-internal only; user code cannot call recv (§15.1.2)", "sect15");
            false -> case eff == "self" of {
                true -> type_checker_expressions_actor_spawn@check_actor_self_call(expr, expected_type, context);
                false -> case eff == "spawn" of {
                    true -> type_checker_expressions_actor_spawn@check_actor_spawn_call(expr, expected_type, context, world, "spawn", "actor_ref", check_surface, check_typed);
                    false -> case eff == "spawn_dangerous" of {
                        true -> type_checker_expressions_actor_spawn@check_actor_spawn_call(expr, expected_type, context, world, "spawn_dangerous", "dangerous_actor_ref", check_surface, check_typed);
                    false -> case eff == "spawn_dangerous_registered" of {
                        true -> type_checker_expressions_actor_spawn@check_actor_spawn_dangerous_registered_call(expr, expected_type, context, world, check_surface, check_typed);
                        false -> case eff == "spawn_registered" of {
                        true -> type_checker_expressions_actor_spawn@check_actor_spawn_registered_call(expr, expected_type, context, world, check_surface, check_typed);
                        false -> case eff == "spawn_registered_supervisor" of {
                            true -> type_checker_expressions_actor_spawn@check_spawn_registered_supervisor_call(expr, expected_type, context, world, check_surface, check_typed);
                            false -> case eff == "spawn_linked" of {
                                true -> type_checker_expressions_actor_spawn@check_actor_spawn_linked_call(expr, expected_type, context, world);
                                false -> case eff == "call_supervisor" of {
                                    true -> type_checker_expressions_actor_spawn@check_call_supervisor_builtin(expr, expected_type, context, world, check_surface, check_typed);
                                    false -> case eff == "link" of {
