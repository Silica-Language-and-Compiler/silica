// Actor concurrency built-in name dispatch.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_expressions_actor_spawn;
use type_checker_expressions_actor_supervision_links;
use type_checker_expressions_actor_supervision_children;
use type_checker_expressions_actor_supervision_messaging;

export check_actor_concurrency_call/6;
export is_actor_concurrency_builtin/1;

fn is_actor_concurrency_builtin(name: string) -> boolean {
    type_checker_expressions_actor_spawn@is_actor_concurrency_builtin(name)
}

fn is_device_worker_builtin(eff: string) -> boolean {
    case eff of {
        "spawn_device" -> true;
        "spawn_device_registered" -> true;
        "cast_device" -> true;
        "cast_device_registered" -> true;
        _: string -> false
    }
}

