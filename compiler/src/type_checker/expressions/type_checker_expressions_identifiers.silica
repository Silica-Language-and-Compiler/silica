// Capability: check identifier expression ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 1)
// Resolves name in symbol table, verifies type matches expected

use parser_ast;
use type_checker_core;
use type_checker_collections;
use type_checker_lists;
use type_checker_record_types;
use type_checker_tuple_decompose_helpers;
use type_checker_traits;
use type_interner;

export check_expr/4;
export normalize_fn_type_idf/1;
export find_arrow_idf/5;
export callee_outer_arrow_idf/1;
export strip_fn_keyword_prefix_idf/1;
export function_types_compatible/2;
export function_types_compatible_first_class_closure/2;
export is_lifted_lambda_symbol_name/1;
export build_function_type_for_symbol_table/2;
export ident_fallback_ok_i/2;
export fn_types_eq_i/2;

// §3.4 / §15.4.13.2: function-value types. The compiler builds call-site fn types as `(T1,T2) -> R`
// (see `build_function_type_for_decl_call`), while declared `fn(msg: T1, state: T2) -> R` annotations
// carry the `fn` keyword and parameter names. These must be unified in identifier type-checking so
// passing a plain `fn name` as a record-field or behavior-argument value type-checks.

fn trim_spaces_idf(s: string) -> string {
    trim_spaces_idf_from(s, 0)
}

fn trim_spaces_idf_from(s: string, i: int64) -> string {
    case i >= length_bytes(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_spaces_idf_from(s, i + 1);
            false -> rtrim_spaces_idf(substring(s, i, length_bytes(s)))
        }
    }
}

fn rtrim_spaces_idf(s: string) -> string {
    rtrim_spaces_idf_from(s, length_bytes(s))
}

fn rtrim_spaces_idf_from(s: string, i: int64) -> string {
    case i <= 0 of {
        true -> "";
        false -> case substring(s, i - 1, i) == " " of {
            true -> rtrim_spaces_idf_from(s, i - 1);
            false -> substring(s, 0, i)
        }
    }
}

fn assoc_placeholder_i(s: string) -> int64 {
    case type_interner@is_placeholder_surface(trim_spaces_idf(s)) of {
        true -> 1;
        false -> 0
    }
}

fn named_trait_expect_i(s: string) -> int64 {
    t: string <- trim_spaces_idf(s);
    case t == "OrderedMap" of {
        true -> 1;
        false -> case t == "OrderedSet" of {
            true -> 1;
            false -> case t == "MiniOrderedSet" of {
                true -> 1;
                false -> case t == "OrderedHeap" of {
                    true -> 1;
                    false -> 0
                }
            }
        }
    }
}

fn starts_lbrace_i(s: string) -> int64 {
    t: string <- trim_spaces_idf(s);
    case length_bytes(t) of {
        0 -> 0;
        _: int64 -> case substring(t, 0, 1) == "{" of {
            true -> 1;
            false -> 0
        }
    }
}

fn starts_with_idf_i(s: string, prefix: string) -> int64 {
    case length_bytes(s) < length_bytes(prefix) of {
        true -> 0;
        false -> case substring(s, 0, length_bytes(prefix)) == prefix of {
            true -> 1;
            false -> 0
        }
    }
}

fn trait_head_idf(s: string) -> string {
    t: string <- trim_spaces_idf(s);
    case starts_with_idf_i(t, "OrderedMap") of {
        1 -> "OrderedMap";
        _: int64 -> case starts_with_idf_i(t, "OrderedSet") of {
            1 -> "OrderedSet";
            _: int64 -> case starts_with_idf_i(t, "MiniOrderedSet") of {
                1 -> "MiniOrderedSet";
                _: int64 -> case starts_with_idf_i(t, "OrderedHeap") of {
                    1 -> "OrderedHeap";
                    _: int64 -> case starts_with_idf_i(t, "Heap") of {
                        1 -> "Heap";
                        _: int64 -> ""
                    }
                }
            }
        }
    }
}

fn same_trait_family_i(a: string, b: string) -> int64 {
    ha: string <- trait_head_idf(a);
    hb: string <- trait_head_idf(b);
    case length_bytes(ha) of {
        0 -> 0;
        _: int64 -> case ha == hb of {
            true -> 1;
            false -> 0
        }
    }
}

fn collection_bracket_i(s: string) -> int64 {
    t: string <- strip_spaces_all_idf(trim_spaces_idf(s), 0, "");
    h: string <- trait_head_idf(t);
    case length_bytes(h) of {
        0 -> 0;
        _: int64 -> case length_bytes(t) > length_bytes(h) of {
            true -> {
                // seed miscompiles length_bytes(<other var>) inline as substring's START arg
                // (yields ""); bind it first.
                hl: int64 <- length_bytes(h);
                case substring(t, hl, hl + 1) == "[" of {
                    true -> 1;
                    false -> 0
                }
            };
            false -> 0
        }
    }
}

fn strip_spaces_all_idf_run_end(s: string, j: int64, n: int64) -> int64 {
    case j >= n of {
        true -> j;
        false -> case substring(s, j, j + 1) == " " of {
            true -> j;
            false -> strip_spaces_all_idf_run_end(s, j + 1, n)
        }
    }
}

fn strip_spaces_all_idf(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> case substring(s, i, i + 1) == " " of {
            true -> strip_spaces_all_idf(s, i + 1, acc);
            false -> {
                n: int64 <- length_bytes(s);
                e: int64 <- strip_spaces_all_idf_run_end(s, i, n);
                strip_spaces_all_idf(s, e, concat(acc, substring(s, i, e)))
            }
        }
    }
}

fn contains_substr_idf_i(s: string, tok: string, i: int64) -> int64 {
    case i + length_bytes(tok) > length_bytes(s) of {
        true -> 0;
        false -> case substring(s, i, i + length_bytes(tok)) == tok of {
            true -> 1;
            false -> contains_substr_idf_i(s, tok, i + 1)
        }
    }
}

fn contains_assoc_ph_idf_i(s: string) -> int64 {
    // Was a substring probe for each placeholder name; now a DAG walk. The DAG walk builds a
    // fresh interner and parses the whole surface (10 KB signatures in the compiler), and it ran
    // for every import binding at the start of type checking (~2.6 GB transient on emitter_core).
    // Every placeholder name ends in "Type", so a surface without that substring cannot contain
    // one; probe that first (same pre-filter the call-site path already uses).
    case contains_substr_idf_i(s, "Type", 0) of {
        1 -> case type_interner@surface_contains_placeholder(s) of {
            true -> 1;
            false -> 0
        };
        _: int64 -> 0
    }
}

fn assoc_ph_pair_ok_i(resolved: string, expect: string) -> int64 {
    case assoc_placeholder_i(expect) of {
        1 -> case length_bytes(resolved) of {
            0 -> 0;
            _: int64 -> 1
        };
        _: int64 -> case assoc_placeholder_i(resolved) of {
            1 -> case length_bytes(expect) of {
                0 -> 0;
                _: int64 -> 1
            };
            _: int64 -> 0
        }
    }
}

fn record_placeholder_pair_ok_i(actual: string, formal: string) -> int64 {
    case starts_lbrace_i(actual) of {
        1 -> case starts_lbrace_i(formal) of {
            1 -> case contains_assoc_ph_idf_i(formal) of {
                1 -> 1;
                _: int64 -> contains_assoc_ph_idf_i(actual)
            };
            _: int64 -> 0
        };
        _: int64 -> case collection_bracket_i(actual) of {
            1 -> case starts_lbrace_i(formal) of {
                1 -> contains_assoc_ph_idf_i(formal);
                _: int64 -> 0
            };
            _: int64 -> 0
        }
    }
}

fn expect_is_ordering_fragment_i(expect: string) -> int64 {
    case callee_outer_arrow_idf(expect) of {
        -1 -> case contains_substr_idf_i(expect, ":equal", 0) of {
            1 -> contains_substr_idf_i(expect, ":greater", 0);
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}

fn expect_is_truncated_fn_params_i(resolved: string, expect: string) -> int64 {
    t: string <- trim_spaces_idf(expect);
    case length_bytes(t) >= 2 and substring(t, 0, 2) == "fn" of {
        false -> 0;
        true -> {
            en: string <- strip_fn_keyword_prefix_idf(t);
            case callee_outer_arrow_idf(en) of {
                -1 -> {
                    a: string <- normalize_fn_type_idf(resolved);
                    (pa: string, _: string) <- normalized_fn_params_ret(a);
                    pe: string <- unwrap_outer_parens_idf(en);
                    case length_bytes(pa) of {
                        0 -> 0;
                        _: int64 -> case strip_spaces_all_idf(pa, 0, "") == strip_spaces_all_idf(pe, 0, "") of {
                            true -> 1;
                            false -> 0
                        }
                    }
                };
                _: int64 -> 0
            }
        }
    }
}

fn comparator_formal_ok_i(resolved: string, expect: string) -> int64 {
    a: string <- normalize_fn_type_idf(resolved);
    case callee_outer_arrow_idf(a) of {
        -1 -> 0;
        _: int64 -> case ordering_ret_i(a) of {
            1 -> case expect_is_ordering_fragment_i(expect) of {
                1 -> 1;
                _: int64 -> expect_is_truncated_fn_params_i(resolved, expect)
            };
            _: int64 -> 0
        }
    }
}

fn ident_fallback_ok_i(resolved: string, expect: string) -> int64 {
    case comparator_formal_ok_i(resolved, expect) of {
        1 -> 1;
        _: int64 -> case record_placeholder_pair_ok_i(resolved, expect) of {
        1 -> 1;
        _: int64 -> case same_trait_family_i(resolved, expect) of {
            1 -> 1;
            _: int64 -> case named_trait_expect_i(expect) of {
                1 -> case starts_lbrace_i(resolved) of {
                    1 -> 1;
                    _: int64 -> case collection_bracket_i(resolved) of {
                        1 -> 1;
                        _: int64 -> assoc_ph_pair_ok_i(resolved, expect)
                    }
                };
                _: int64 -> case collection_bracket_i(resolved) of {
                    1 -> case starts_lbrace_i(expect) of {
                        1 -> 1;
                        _: int64 -> assoc_ph_pair_ok_i(resolved, expect)
                    };
                    _: int64 -> assoc_ph_pair_ok_i(resolved, expect)
                }
            }
        }
        }
    }
}

// Skip ASCII spaces only (matches trim_spaces_idf).
fn skip_spaces_idx_idf(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> i;
        false -> case substring(s, i, i + 1) == " " of {
            true -> skip_spaces_idx_idf(s, i + 1);
            false -> i
        }
    }
}

// Parser reconstructs function types with spaces between tokens (`fn (` not `fn(`); strip `fn` … `(` so arity lives only inside the parens.
fn strip_fn_keyword_prefix_idf(s: string) -> string {
    t: string <- trim_spaces_idf(s);
    case length_bytes(t) >= 2 and substring(t, 0, 2) == "fn" of {
        false -> t;
        true -> {
            after_kw: int64 <- skip_spaces_idx_idf(t, 2);
            case after_kw < length_bytes(t) and substring(t, after_kw, after_kw + 1) == "(" of {
                true -> substring(t, after_kw, length_bytes(t));
                false -> t
            }
        }
    }
}

// Last top-level "->" (paren/brace/bracket aware). Used when a callee
// signature is stored unwrapped and the first `->` belongs to a nested
// `fn(...) -> :less | :equal | :greater` parameter.
fn find_last_arrow_idf(s: string, i: int64, paren: int64, brace: int64, bracket: int64, last: int64) -> int64 {
    case i + 1 >= length_bytes(s) of {
        true -> last;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> find_last_arrow_idf(s, i + 1, paren + 1, brace, bracket, last);
                false -> case c == ")" of {
                    true -> find_last_arrow_idf(s, i + 1, paren - 1, brace, bracket, last);
                    false -> case c == "{" of {
                        true -> find_last_arrow_idf(s, i + 1, paren, brace + 1, bracket, last);
                        false -> case c == "}" of {
                            true -> find_last_arrow_idf(s, i + 1, paren, brace - 1, bracket, last);
                            false -> case c == "[" of {
                                true -> find_last_arrow_idf(s, i + 1, paren, brace, bracket + 1, last);
                                false -> case c == "]" of {
                                    true -> find_last_arrow_idf(s, i + 1, paren, brace, bracket - 1, last);
                                    false -> case paren == 0 and brace == 0 and bracket == 0 and substring(s, i, i + 2) == "->" of {
                                        true -> find_last_arrow_idf(s, i + 2, paren, brace, bracket, i);
                                        false -> find_last_arrow_idf(s, i + 1, paren, brace, bracket, last)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Outer `->` of a callee type. A comma between the first and last top-level
// arrows means the first arrow is a nested function parameter (comparator);
// curried `fn(A) -> fn(B) -> C` has no such comma and keeps the first arrow.
fn callee_outer_arrow_idf(s: string) -> int64 {
    first: int64 <- find_arrow_idf(s, 0, 0, 0, 0);
    last: int64 <- find_last_arrow_idf(s, 0, 0, 0, 0, -1);
    case first < 0 of {
        true -> -1;
        false -> case first == last of {
            true -> first;
            false -> {
                mid: string <- substring(s, first + 2, last);
                comma: int64 <- find_comma_idf(mid, 0, 0, 0, 0);
                case comma < 0 of {
                    true -> first;
                    false -> last
                }
            }
        }
    }
}

// Find top-level "->" starting from i (paren/brace/bracket aware).
fn find_arrow_idf(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i + 1 >= length_bytes(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> find_arrow_idf(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> find_arrow_idf(s, i + 1, paren - 1, brace, bracket);
                    false -> case c == "{" of {
                        true -> find_arrow_idf(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> find_arrow_idf(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> find_arrow_idf(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> find_arrow_idf(s, i + 1, paren, brace, bracket - 1);
                                    false -> case paren == 0 and brace == 0 and bracket == 0 and substring(s, i, i + 2) == "->" of {
                                        true -> i;
                                        false -> find_arrow_idf(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Find first top-level comma (paren/brace/bracket aware).
fn find_comma_idf(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> find_comma_idf(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> find_comma_idf(s, i + 1, paren - 1, brace, bracket);
                    false -> case c == "{" of {
                        true -> find_comma_idf(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> find_comma_idf(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> find_comma_idf(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> find_comma_idf(s, i + 1, paren, brace, bracket - 1);
                                    false -> case c == "," and paren == 0 and brace == 0 and bracket == 0 of {
                                        true -> i;
                                        false -> find_comma_idf(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Find first top-level ":" (paren/brace/bracket aware).
fn find_colon_idf(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> find_colon_idf(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> find_colon_idf(s, i + 1, paren - 1, brace, bracket);
                    false -> case c == "{" of {
                        true -> find_colon_idf(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> find_colon_idf(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> find_colon_idf(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> find_colon_idf(s, i + 1, paren, brace, bracket - 1);
                                    false -> case c == ":" and paren == 0 and brace == 0 and bracket == 0 of {
                                        true -> i;
                                        false -> find_colon_idf(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_non_ident_idf(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == " " or c == "(" or c == ")" or c == "{" or c == "}" or c == "[" or c == "]" or c == ":" or c == "-" or c == ">" or c == "," or c == "|" or c == "." of {
                true -> 1;
                false -> has_non_ident_idf(s, i + 1)
            }
        }
    }
}

fn is_simple_ident_idf(s: string) -> int64 {
    t: string <- trim_spaces_idf(s);
    case length_bytes(t) of {
        0 -> 0;
        _: int64 -> case has_non_ident_idf(t, 0) of {
            1 -> 0;
            _: int64 -> 1
        }
    }
}

// `name: T` → `T`. Do not treat `:less` / `fn(...) -> :less` as `name: T`.
fn strip_param_name_idf(seg: string) -> string {
    t: string <- trim_spaces_idf(seg);
    colon: int64 <- find_colon_idf(t, 0, 0, 0, 0);
    case colon < 0 of {
        true -> t;
        false -> {
            left: string <- trim_spaces_idf(substring(t, 0, colon));
            case is_simple_ident_idf(left) of {
                1 -> trim_spaces_idf(substring(t, colon + 1, length_bytes(t)));
                _: int64 -> t
            }
        }
    }
}

// Normalize `fn(a: T1, b: T2) -> R` / `fn (…) -> R` or `(T1,T2) -> R` → `(T1,T2) -> R` (names stripped). Outer declarations still count one formal per `{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }`; inner arity is only for calls on function values.
fn normalize_fn_type_idf(s: string) -> string {
    stripped: string <- strip_fn_keyword_prefix_idf(s);
    t: string <- trim_spaces_idf(stripped);
    arrow: int64 <- callee_outer_arrow_idf(t);
    case arrow < 0 of {
        true -> t;
        false -> {
            params_part: string <- trim_spaces_idf(substring(t, 0, arrow));
            ret_part: string <- trim_spaces_idf(substring(t, arrow + 2, length_bytes(t)));
            params_inner: string <- case length_bytes(params_part) >= 2 and substring(params_part, 0, 1) == "(" and substring(params_part, length_bytes(params_part) - 1, length_bytes(params_part)) == ")" of {
                true -> trim_spaces_idf(substring(params_part, 1, length_bytes(params_part) - 1));
                false -> params_part
            };
            normalized_params: string <- normalize_param_list_idf(params_inner);
            concat(concat(concat("(", normalized_params), ") -> "), ret_part)
        }
    }
}

fn normalize_param_list_idf(inner: string) -> string {
    case length_bytes(inner) == 0 of {
        true -> "";
        false -> {
            comma: int64 <- find_comma_idf(inner, 0, 0, 0, 0);
            case comma < 0 of {
                true -> strip_param_name_idf(inner);
                false -> {
                    head: string <- strip_param_name_idf(substring(inner, 0, comma));
                    rest: string <- normalize_param_list_idf(trim_spaces_idf(substring(inner, comma + 1, length_bytes(inner))));
                    concat(concat(head, ","), rest)
                }
            }
        }
    }
}

fn function_types_compatible(resolved: string, expected: string) -> boolean {
    a: string <- normalize_fn_type_idf(resolved);
    b: string <- normalize_fn_type_idf(expected);
    case a == b of {
        true -> true;
        false -> case strip_spaces_all_idf(a, 0, "") == strip_spaces_all_idf(b, 0, "") of {
            true -> true;
            false -> case find_arrow_idf(a, 0, 0, 0, 0) >= 0 and find_arrow_idf(b, 0, 0, 0, 0) >= 0 and contains_assoc_ph_idf_i(b) == 1 of {
                true -> true;
                false -> case type_checker_tuple_decompose_helpers@types_equal_surface(a, b) of {
            true -> true;
            false -> {
                // Function results are covariant.  A comparator whose result is
                // the closed atom union :less|:equal|:greater is safe wherever
                // a helper accepts an arbitrary atom result for validation.
                (pa: string, ra: string) <- normalized_fn_params_ret(a);
                (pb: string, rb: string) <- normalized_fn_params_ret(b);
                same_params: boolean <- type_checker_tuple_decompose_helpers@types_equal_surface(pa, pb);
                resolved_is_atom_union: boolean <- length_bytes(ra) > 0 and substring(ra, 0, 1) == ":";
                same_params and rb == "atom" and resolved_is_atom_union
            }
                }
            }
        }
    }
}

fn is_lifted_lambda_symbol_name(m: string) -> boolean {
    lifted_lam_sub_at(m, 0)
}

fn lifted_lam_sub_at(m: string, i: int64) -> boolean {
    case i + 6 > length_bytes(m) of {
        true -> false;
        false -> case substring(m, i, i + 6) == ".__lam" of {
            true -> true;
            false -> lifted_lam_sub_at(m, i + 1)
        }
    }
}

fn normalized_fn_params_ret(norm: string) -> (string, string) {
    arrow: int64 <- callee_outer_arrow_idf(norm);
    case arrow < 0 of {
        true -> ("", "");
        false -> {
            raw_params: string <- trim_spaces_idf(substring(norm, 0, arrow));
            ret: string <- trim_spaces_idf(substring(norm, arrow + 2, length_bytes(norm)));
            inner: string <- case length_bytes(raw_params) >= 2 and substring(raw_params, 0, 1) == "(" and substring(raw_params, length_bytes(raw_params) - 1, length_bytes(raw_params)) == ")" of {
                true -> trim_spaces_idf(substring(raw_params, 1, length_bytes(raw_params) - 1));
                false -> raw_params
            };
            (inner, ret)
        }
    }
}

fn count_top_level_param_types(inner: string) -> int64 {
    case length_bytes(inner) == 0 of {
        true -> 0;
        false -> {
            comma: int64 <- find_comma_idf(inner, 0, 0, 0, 0);
            case comma < 0 of {
                true -> 1;
                false -> 1 + count_top_level_param_types(trim_spaces_idf(substring(inner, comma + 1, length_bytes(inner))))
            }
        }
    }
}

fn first_param_type_comma_rest(inner: string) -> (string, string) {
    case length_bytes(inner) == 0 of {
        true -> ("", "");
        false -> {
            comma: int64 <- find_comma_idf(inner, 0, 0, 0, 0);
            case comma < 0 of {
                true -> (trim_spaces_idf(inner), "");
                false -> {
                    f: string <- trim_spaces_idf(substring(inner, 0, comma));
                    r: string <- trim_spaces_idf(substring(inner, comma + 1, length_bytes(inner)));
                    (f, r)
                }
            }
        }
    }
}

fn param_types_prefix_match(li_res: string, li_exp: string, remaining: int64) -> boolean {
    case remaining == 0 of {
        true -> true;
        false -> {
            (ar, r_res) <- first_param_type_comma_rest(li_res);
            (be, r_exp) <- first_param_type_comma_rest(li_exp);
            case type_checker_tuple_decompose_helpers@types_equal_surface(ar, be) of {
                false -> false;
                true -> param_types_prefix_match(r_res, r_exp, remaining - 1)
            }
        }
    }
}

fn take_first_n_param_types(inner: string, remaining: int64) -> string {
    case remaining == 0 of {
        true -> "";
        false -> case length_bytes(inner) == 0 of {
            true -> "";
            false -> {
                comma: int64 <- find_comma_idf(inner, 0, 0, 0, 0);
                case comma < 0 of {
                    true -> trim_spaces_idf(inner);
                    false -> {
                        head: string <- trim_spaces_idf(substring(inner, 0, comma));
                        rest: string <- take_first_n_param_types(trim_spaces_idf(substring(inner, comma + 1, length_bytes(inner))), remaining - 1);
                        case length_bytes(rest) == 0 of {
                            true -> head;
                            false -> concat(concat(head, ","), rest)
                        }
                    }
                }
            }
        }
    }
}

fn function_type_with_prefix_params(resolved: string, n: int64) -> string {
    a: string <- normalize_fn_type_idf(resolved);
    case find_arrow_idf(a, 0, 0, 0, 0) < 0 of {
        true -> "";
        false -> {
            (li_a, ret_a) <- normalized_fn_params_ret(a);
            prefix_li: string <- take_first_n_param_types(li_a, n);
            concat(concat(concat("(", prefix_li), ") -> "), ret_a)
        }
    }
}

fn drop_first_n_param_types(inner: string, remaining: int64) -> string {
    case remaining <= 0 of {
        true -> trim_spaces_idf(inner);
        false -> case length_bytes(inner) == 0 of {
            true -> "";
            false -> {
                comma: int64 <- find_comma_idf(inner, 0, 0, 0, 0);
                case comma < 0 of {
                    true -> "";
                    false -> drop_first_n_param_types(trim_spaces_idf(substring(inner, comma + 1, length_bytes(inner))), remaining - 1)
                }
            }
        }
    }
}

fn function_type_with_suffix_params(resolved: string, n: int64) -> string {
    a: string <- normalize_fn_type_idf(resolved);
    case find_arrow_idf(a, 0, 0, 0, 0) < 0 of {
        true -> "";
        false -> {
            (li_a, ret_a) <- normalized_fn_params_ret(a);
            na: int64 <- count_top_level_param_types(li_a);
            case na < n of {
                true -> "";
                false -> {
                    suffix_li: string <- drop_first_n_param_types(li_a, na - n);
                    concat(concat(concat("(", suffix_li), ") -> "), ret_a)
                }
            }
        }
    }
}

// Lifted lambdas append captures at the List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] deep end; param_types_str therefore emits captures
// before formals. Accept either formals-as-prefix or formals-as-suffix of the implementation arity.
fn function_types_compatible_lifted_implementation(resolved: string, expected: string) -> boolean {
    a: string <- normalize_fn_type_idf(resolved);
    b: string <- normalize_fn_type_idf(expected);
    case find_arrow_idf(a, 0, 0, 0, 0) < 0 of {
        true -> false;
        false -> case find_arrow_idf(b, 0, 0, 0, 0) < 0 of {
            true -> false;
            false -> {
                (li_a, ret_a) <- normalized_fn_params_ret(a);
                (li_b, ret_b) <- normalized_fn_params_ret(b);
                case type_checker_tuple_decompose_helpers@types_equal_surface(ret_a, ret_b) of {
                    false -> false;
                    true -> {
                        nb: int64 <- count_top_level_param_types(li_b);
                        na: int64 <- count_top_level_param_types(li_a);
                        case na >= nb of {
                            false -> false;
                            true -> case param_types_prefix_match(li_a, li_b, nb) of {
                                true -> true;
                                false -> case function_types_compatible(function_type_with_prefix_params(resolved, nb), expected) of {
                                    true -> true;
                                    false -> function_types_compatible(function_type_with_suffix_params(resolved, nb), expected)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// First-class closures: a capturing implementation may have extra trailing capture parameters.
fn function_types_compatible_first_class_closure(resolved: string, expected: string) -> boolean {
    case function_types_compatible(resolved, expected) of {
        true -> true;
        false -> function_types_compatible_lifted_implementation(resolved, expected)
    }
}

fn unwrap_outer_parens_idf(s: string) -> string {
    t: string <- trim_spaces_idf(s);
    case length_bytes(t) >= 2 and substring(t, 0, 1) == "(" and substring(t, length_bytes(t) - 1, length_bytes(t)) == ")" of {
        true -> trim_spaces_idf(substring(t, 1, length_bytes(t) - 1));
        false -> t
    }
}

fn ordering_ret_i(s: string) -> int64 {
    case contains_substr_idf_i(s, ":less", 0) of {
        1 -> case contains_substr_idf_i(s, ":equal", 0) of {
            1 -> contains_substr_idf_i(s, ":greater", 0);
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}

fn fn_ret_eq_i(ra: string, rb: string) -> int64 {
    a: string <- unwrap_outer_parens_idf(ra);
    b: string <- unwrap_outer_parens_idf(rb);
    case strip_spaces_all_idf(a, 0, "") == strip_spaces_all_idf(b, 0, "") of {
        true -> case length_bytes(a) of {
            0 -> 0;
            _: int64 -> 1
        };
        false -> case b == "atom" of {
            true -> case length_bytes(a) of {
                0 -> 0;
                _: int64 -> case substring(a, 0, 1) == ":" of {
                    true -> 1;
                    false -> 0
                }
            };
            false -> case ordering_ret_i(a) of {
                1 -> ordering_ret_i(b);
                _: int64 -> 0
            }
        }
    }
}

fn fn_types_eq_i(resolved: string, expected: string) -> int64 {
    a: string <- normalize_fn_type_idf(resolved);
    b: string <- normalize_fn_type_idf(expected);
    case strip_spaces_all_idf(a, 0, "") == strip_spaces_all_idf(b, 0, "") of {
        true -> case callee_outer_arrow_idf(a) of {
            -1 -> 0;
            _: int64 -> 1
        };
        false -> case callee_outer_arrow_idf(a) of {
            -1 -> 0;
            _: int64 -> case callee_outer_arrow_idf(b) of {
                -1 -> comparator_formal_ok_i(resolved, expected);
                _: int64 -> case contains_assoc_ph_idf_i(b) of {
                    1 -> 1;
                    _: int64 -> {
                        (pa: string, ra: string) <- normalized_fn_params_ret(a);
                        (pb: string, rb: string) <- normalized_fn_params_ret(b);
                        case strip_spaces_all_idf(pa, 0, "") == strip_spaces_all_idf(pb, 0, "") of {
                            true -> fn_ret_eq_i(ra, rb);
                            false -> comparator_formal_ok_i(resolved, expected)
                        }
                    }
                }
            }
        }
    }
}

fn param_types_str_for_decl(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case params.is_nil of {
        true -> "";
        false -> case params.tail.is_nil of {
            true -> params.head.type_name;
            false -> concat(concat(param_types_str_for_decl(params.tail), ","), params.head.type_name)
        }
    }
}

fn build_function_type_from_params(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], ret: string) -> string {
    params_str: string <- param_types_str_for_decl(params);
    case params.is_nil of {
        true -> concat("() -> ", ret);
        false -> concat(concat(concat("(", params_str), ") -> "), ret)
    }
}

fn build_function_type_surface(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> string {
    build_function_type_from_params(decl.parameters, decl.return_type_name)
}

fn list_param_len(ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_len(ps.tail)
    }
}

fn build_function_type_for_symbol_table(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, all_decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> string {
    // A lifted function literal's parameters are its formals then its captures (parser_ast
    // declaration_from_lambda_lift); a capturing literal reaches a call site only through its
    // arity wrapper (constraint_extract_hof_wrap), so its own type is the full parameter list.
    build_function_type_surface(decl)
}

fn first_at_in_identifier_name(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_identifier_name(s, i + 1)
        }
    }
}

fn lookup_symbol_found_identifier(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string) -> (boolean, int64) {
    at: int64 <- first_at_in_identifier_name(name, 0);
    case at < 0 of {
        true -> type_checker_core@lookup_symbol_found(env, name);
        false -> lookup_symbol_found_identifier_module(env, substring(name, at + 1, length_bytes(name)), substring(name, 0, at))
    }
}

fn lookup_symbol_found_identifier_module(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], fn_name: string, required_module: string) -> (boolean, int64) {
    case env.is_nil of {
        true -> (false, type_interner@invalid_type_id());
        false -> case env.head.name == fn_name and env.head.is_effect_alias == false and env.head.source_module == required_module of {
            true -> (true, env.head.type_id);
            false -> lookup_symbol_found_identifier_module(env.tail, fn_name, required_module)
        }
    }
}

fn lookup_symbol_surface_identifier(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string) -> string {
    at: int64 <- first_at_in_identifier_name(name, 0);
    case at < 0 of {
        true -> type_checker_core@lookup_symbol_surface(env, name);
        false -> lookup_symbol_surface_identifier_module(env, substring(name, at + 1, length_bytes(name)), substring(name, 0, at))
    }
}

fn lookup_symbol_surface_identifier_module(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], fn_name: string, required_module: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == fn_name and env.head.is_effect_alias == false and env.head.source_module == required_module of {
            true -> env.head.surface_type;
            false -> lookup_symbol_surface_identifier_module(env.tail, fn_name, required_module)
        }
    }
}

// Check { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 1 (identifier). Lookup in context.env, verify matches expected_type id.
fn check_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    ek: int64 <- type_interner@node_kind(context.interner, expected_type);
    case ek == type_interner@kind_discard() of {
        true -> case node.name == "performance_cores" or node.name == "efficiency_cores" of {
            true -> (type_checker_core@type_check_ok(), context);
            false -> {
                (found: boolean, _: int64) <- lookup_symbol_found_identifier(context.env, node.name);
                case found of {
                    true -> (type_checker_core@type_check_ok(), context);
                    false -> (type_checker_core@type_check_err("E2002", node.location, concat("undefined identifier: ", node.name), "sect6"), context)
                }
            }
        };
        false -> {
            (found: boolean, resolved_id: int64) <- lookup_symbol_found_identifier(context.env, node.name);
            case found of {
                false -> (type_checker_core@type_check_err("E2002", node.location, concat("undefined identifier: ", node.name), "sect6"), context);
                true -> case type_interner@node_kind(context.interner, resolved_id) == type_interner@kind_unit() of {
                    true -> (type_checker_core@type_check_err("E2006", node.location, "unit is not a valid type for variables or parameters", "sect4"), context);
                    false -> case type_interner@types_equal(resolved_id, expected_type) of {
                        true -> (type_checker_core@type_check_ok(), context);
                        false -> {
                            resolved_surf: string <- lookup_symbol_surface_identifier(context.env, node.name);
                            resolved_from_id: string <- type_checker_core@surface_for_type_id(context, resolved_id);
                            expect_surf: string <- type_checker_core@surface_for_type_id(context, expected_type);
                            case function_types_compatible_first_class_closure(resolved_surf, expect_surf) of {
                                true -> (type_checker_core@type_check_ok(), context);
                                false -> case fn_types_eq_i(resolved_from_id, expect_surf) of {
                                    1 -> (type_checker_core@type_check_ok(), context);
                                    _: int64 -> case fn_types_eq_i(resolved_surf, expect_surf) of {
                                    1 -> (type_checker_core@type_check_ok(), context);
                                    _: int64 -> case type_checker_tuple_decompose_helpers@types_equal_surface(resolved_surf, expect_surf) of {
                                    true -> (type_checker_core@type_check_ok(), context);
                                    false -> case type_checker_record_types@record_type_starts(resolved_surf) and type_checker_record_types@record_type_starts(expect_surf) of {
                                        true -> case type_checker_tuple_decompose_helpers@types_equal_surface(resolved_surf, expect_surf) of {
                                            true -> (type_checker_core@type_check_ok(), context);
                                            false -> case type_checker_collections@collection_aware_types_compatible(resolved_surf, expect_surf, world) of {
                                                true -> (type_checker_core@type_check_ok(), context);
                                                false -> (type_checker_core@type_check_err("E2003", node.location, concat("type mismatch: ", node.name), "sect6"), context)
                                            }
                                        };
                                        false -> case type_checker_lists@list_types_compatible(resolved_surf, expect_surf) of {
                                            true -> (type_checker_core@type_check_ok(), context);
                                            false -> case type_checker_collections@is_collection_trait_type(resolved_surf) and type_checker_collections@collection_type_fits_concrete_record(resolved_surf, expect_surf, world) of {
                                                true -> (type_checker_core@type_check_ok(), context);
                                                false -> case type_checker_collections@is_collection_trait_type(expect_surf) and type_checker_collections@collection_type_fits_concrete_record(expect_surf, resolved_surf, world) of {
                                                    true -> (type_checker_core@type_check_ok(), context);
                                                    false -> case type_checker_traits@actual_type_satisfies_trait_expectation(resolved_surf, expect_surf, world) of {
                                                        true -> (type_checker_core@type_check_ok(), context);
                                                        false -> case ident_fallback_ok_i(resolved_surf, expect_surf) of {
                                                            1 -> (type_checker_core@type_check_ok(), context);
                                                            // Lifetimes compare literally here: a call's lifetime names are substituted per call
                                                            // before its arguments are checked (spec 12.1.4, Q10; memory_regions lifetime_unify).
                                                            // D7: a collection bracket type inside a list / record / fn
                                                            // type (a supervisor child spec whose state is a
                                                            // PriorityQueue[...]), and fn(...) against the interner's
                                                            // (...) spelling of the same function type.
                                                            _: int64 -> case type_checker_collections@collection_aware_types_compatible(resolved_surf, expect_surf, world) of {
                                                                true -> (type_checker_core@type_check_ok(), context);
                                                                false -> (type_checker_core@type_check_err("E2003", node.location, concat("type mismatch: ", node.name), "sect6"), context)
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }
        }
    }
}
}

