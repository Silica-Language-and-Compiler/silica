    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- mk_prim(interner, sk)
                                produces
                                    pure { interner: r.interner, id: r.id, ok: true }
                                end
                            }
                        }
                    }
                }
            };
            false -> {
                sk: int64 <- space_kind_of(t);
                case sk < 0 of {
                    true -> parse_fail(interner);
                    false -> {
                        sequence
                            r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
