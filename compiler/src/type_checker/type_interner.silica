fn list_int_at_dag(xs: List[int64, mem(normal)], i: int64) -> int64 {
    case xs.is_nil of {
        true -> 0 - 1;
        false -> case i <= 0 of {
            true -> xs.head;
            false -> list_int_at_dag(xs.tail, i - 1)
        }
    }
}

fn list_int_append_dag(xs: List[int64, mem(normal)], v: int64) -> List[int64, mem(normal)] {
    case xs.is_nil of {
        true -> {
            sequence proc[mem(normal)]
                result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](v, empty_int_list())
            produces
                pure result
            end
        };
        false -> {
            sequence proc[mem(normal)]
                rest: List[int64, mem(normal)] <- list_int_append_dag(xs.tail, v);
                result: List[int64, mem(normal)] <- prepend[int64, mem(normal)](xs.head, rest)
            produces
                pure result
            end
        }
    }
}

fn remap_dag_id(remap: List[int64, mem(normal)], old_id: int64) -> int64 {
    case old_id < 0 of {
        true -> old_id;
        false -> list_int_at_dag(remap, old_id)
    }
}

// 0=literal, 1=type id, 2=name id. `which` is 0=a, 1=b, 2=c.
fn dag_arg_role(kind: int64, which: int64, buf_size_is_name: boolean) -> int64 {
    case kind of {
        1 -> 0;
        2 -> case which of { 2 -> 0; _: int64 -> 1 };
        3 -> case which of { 0 -> 2; 1 -> 1; _: int64 -> 0 };
        4 -> case which of { 0 -> 2; _: int64 -> 0 };
        100 -> case which of { 2 -> 0; _: int64 -> 1 };
        101 -> case which of { 0 -> 1; _: int64 -> 0 };
        102 -> case which of { 0 -> 1; _: int64 -> 0 };
        103 -> case which of { 2 -> 0; _: int64 -> 1 };
        104 -> case which of { 0 -> 1; _: int64 -> 0 };
        105 -> case which of { 0 -> 1; _: int64 -> 0 };
        106 -> 1;
        107 -> 1;
        108 -> case which of { 2 -> 0; _: int64 -> 1 };
        109 -> case which of {
            0 -> 1;
            1 -> case buf_size_is_name of { true -> 2; false -> 0 };
            _: int64 -> 0
        };
        110 -> 1;
        111 -> case which of { 0 -> 1; _: int64 -> 0 };
        112 -> case which of { 0 -> 2; _: int64 -> 0 };
        113 -> case which of { 0 -> 1; _: int64 -> 0 };
        120 -> case which of { 2 -> 0; _: int64 -> 1 };
        121 -> 1;
        122 -> case which of { 2 -> 0; _: int64 -> 1 };
        123 -> case which of { 2 -> 0; _: int64 -> 1 };
        124 -> case which of { 2 -> 0; _: int64 -> 1 };
        129 -> case which of { 2 -> 0; _: int64 -> 1 };
        125 -> 1;
        126 -> 1;
        127 -> case which of { 2 -> 0; _: int64 -> 1 };
        128 -> 1;
        _: int64 -> case kind >= 10 and kind <= 85 of {
            true -> 0;
            false -> case which of { 2 -> 0; _: int64 -> 1 }
        }
    }
}

fn remap_dag_arg(role: int64, value: int64, type_remap: List[int64, mem(normal)], name_remap: List[int64, mem(normal)]) -> int64 {
    case role of {
        1 -> remap_dag_id(type_remap, value);
        2 -> remap_dag_id(name_remap, value);
        _: int64 -> value
    }
}

fn intern_dag_names_loop(
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    names: List[string, mem(normal)],
    remap: List[int64, mem(normal)]
) -> {
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    remap: List[int64, mem(normal)]
} {
    case names.is_nil of {
        true -> { interner: interner, remap: remap };
        false -> {
            nr: { interner: {
                nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
                by_key: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                },
                names: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                },
                name_lexemes: List[string, mem(normal)],
                next_id: int64,
                seq_nil_id: int64
            }, id: int64 } <- intern_name(interner, names.head);
            intern_dag_names_loop(nr.interner, names.tail, list_int_append_dag(remap, nr.id))
        }
    }
}

fn intern_dag_nodes_loop(
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    type_remap: List[int64, mem(normal)],
    name_remap: List[int64, mem(normal)]
) -> {
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    remap: List[int64, mem(normal)]
} {
    case nodes.is_nil of {
        true -> { interner: interner, remap: type_remap };
        false -> {
            n: { kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean } <- nodes.head;
            a2: int64 <- remap_dag_arg(dag_arg_role(n.kind, 0, n.buf_size_is_name), n.arg_a, type_remap, name_remap);
            b2: int64 <- remap_dag_arg(dag_arg_role(n.kind, 1, n.buf_size_is_name), n.arg_b, type_remap, name_remap);
            c2: int64 <- remap_dag_arg(dag_arg_role(n.kind, 2, n.buf_size_is_name), n.arg_c, type_remap, name_remap);
            kr: { interner: {
                nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
                by_key: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                },
                names: {
                    root: ref?(L, normal, rec),
                    compare_key: fn(string, string) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater,
                    region: region(L, normal),
                    specialization_key: int64,
                    compare_key_ordering_bundle: int64,
                    compare_value_ordering_bundle: int64
                },
                name_lexemes: List[string, mem(normal)],
                next_id: int64,
                seq_nil_id: int64
            }, id: int64 } <- intern_key(interner, n.kind, a2, b2, c2, n.buf_size_is_name);
            intern_dag_nodes_loop(kr.interner, nodes.tail, list_int_append_dag(type_remap, kr.id), name_remap)
        }
    }
}

fn replay_type_dag(
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    names: List[string, mem(normal)],
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)]
) -> {
    interner: {
        nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
        by_key: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        names: {
            root: ref?(L, normal, rec),
            compare_key: fn(string, string) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        },
        name_lexemes: List[string, mem(normal)],
        next_id: int64,
        seq_nil_id: int64
    },
    remap: List[int64, mem(normal)]
} {
    nr: {
        interner: {
            nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
            by_key: {
                root: ref?(L, normal, rec),
                compare_key: fn(string, string) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            names: {
                root: ref?(L, normal, rec),
                compare_key: fn(string, string) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            name_lexemes: List[string, mem(normal)],
            next_id: int64,
            seq_nil_id: int64
        },
        remap: List[int64, mem(normal)]
    } <- intern_dag_names_loop(interner, names, empty_int_list());
    intern_dag_nodes_loop(nr.interner, nodes, empty_int_list(), nr.remap)
}


// ---------------------------------------------------------------------------
// Schema matching (Phase 2, per call site)
//
// A formal parameter type may be a *schema*: a structure containing placeholder
// kinds (KeyType, ValueType, ItemType, ...). Those are unbound, universally
// quantified type parameters -- there is no `trait KeyType` anywhere -- so trait
// dispatch can never resolve them. Matching binds each placeholder to whatever
// subtree of the actual lines up with it, and requires every later occurrence of
// that placeholder to agree.
//
// Bindings are fresh per call, so `wbt_map@size` can be used at KeyType=int64 in
// one call and KeyType=string in another.
//
// Deliberately separate from types_equal/2, which stays exact node-id equality
// (an O(1) compare, sound because the DAG is hash-consed).

fn kind_ph_first() -> int64 { 60 }
fn kind_ph_last() -> int64 { 75 }

fn is_placeholder_kind(k: int64) -> boolean {
    k >= kind_ph_first() and k <= kind_ph_last()
}

fn empty_schema_bindings() -> List[{ ph: int64, id: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ ph: int64, id: int64 }, mem(normal)] <- empty[{ ph: int64, id: int64 }, mem(normal)]()
    produces
        pure result
    end
}

fn schema_binding_lookup(bs: List[{ ph: int64, id: int64 }, mem(normal)], ph: int64) -> (boolean, int64) {
    case bs.is_nil of {
        true -> (false, invalid_type_id());
        false -> case bs.head.ph == ph of {
            true -> (true, bs.head.id);
            false -> schema_binding_lookup(bs.tail, ph)
        }
    }
}

fn schema_binding_add(bs: List[{ ph: int64, id: int64 }, mem(normal)], ph: int64, id: int64) -> List[{ ph: int64, id: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ ph: int64, id: int64 }, mem(normal)] <- prepend[{ ph: int64, id: int64 }, mem(normal)]({ ph: ph, id: id }, bs)
    produces
        pure result
    end
}

// Placeholder check comes before the identity fast path so that a placeholder
// always records a binding, even when it happens to face itself.
fn schema_match_walk(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, actual: int64, formal: int64, bs: List[{ ph: int64, id: int64 }, mem(normal)], fuel: int64) -> (boolean, List[{ ph: int64, id: int64 }, mem(normal)]) {
    case fuel <= 0 of {
        true -> (false, bs);
        false -> {
            fk: int64 <- node_kind(interner, formal);
            case is_placeholder_kind(fk) of {
                true -> {
                    (found: boolean, bound: int64) <- schema_binding_lookup(bs, fk);
                    case found of {
                        true -> (bound == actual, bs);
                        false -> (true, schema_binding_add(bs, fk, actual))
                    }
                };
                false -> case actual == formal of {
                    true -> (true, bs);
                    false -> {
                        ak: int64 <- node_kind(interner, actual);
                        case ak == fk of {
                            false -> (false, bs);
                            true -> {
                                // A slot is walked only when it holds a type id for this kind
                                // (dag_arg_role); a lexeme index or a literal is compared as a number.
                                flag_a: boolean <- nodes_at(interner.nodes, actual).buf_size_is_name;
                                flag_f: boolean <- nodes_at(interner.nodes, formal).buf_size_is_name;
                                case flag_a == flag_f of {
                                    false -> (false, bs);
                                    true -> {
                                        (oka: boolean, bsa: List[{ ph: int64, id: int64 }, mem(normal)]) <- schema_match_arg(interner, dag_arg_role(fk, 0, flag_f), node_a(interner, actual), node_a(interner, formal), bs, fuel);
                                        case oka of {
                                            false -> (false, bsa);
                                            true -> {
                                                (okb: boolean, bsb: List[{ ph: int64, id: int64 }, mem(normal)]) <- schema_match_arg(interner, dag_arg_role(fk, 1, flag_f), node_b(interner, actual), node_b(interner, formal), bsa, fuel);
                                                case okb of {
                                                    false -> (false, bsb);
                                                    true -> schema_match_arg(interner, dag_arg_role(fk, 2, flag_f), node_c(interner, actual), node_c(interner, formal), bsb, fuel)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// One argument slot of two nodes of the same kind. Role 1 (a type id) is walked; roles 0 and 2 (a
// literal such as a buf size or an unused slot's 0, or a lexeme index naming a record field, an
// atom or a buf size name) are the same slot only when the numbers agree. Before 2026-10-23 every
// slot was walked as a type id: a record field's name index was read as a node, and when that
// index happened to be the node of a placeholder the formal had already bound, the field names
// were checked against the binding and the record rejected (a record whose compare_value is
// `fn(ValueType, ValueType)` against an instantiation whose ValueType is a node type over ValueType).
fn schema_match_arg(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, role: int64, va: int64, vf: int64, bs: List[{ ph: int64, id: int64 }, mem(normal)], fuel: int64) -> (boolean, List[{ ph: int64, id: int64 }, mem(normal)]) {
    case role == 1 of {
        true -> schema_match_walk(interner, va, vf, bs, fuel - 1);
        false -> (va == vf, bs)
    }
}

fn type_matches_schema(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, actual: int64, formal: int64) -> (boolean, List[{ ph: int64, id: int64 }, mem(normal)]) {
    schema_match_walk(interner, actual, formal, empty_schema_bindings(), 4096)
}

// Convenience for the checker: parse both surfaces into one interner and match.
// Returns only the verdict; callers that need the bindings use type_matches_schema.
fn surface_matches_schema(actual_surface: string, formal_surface: string) -> boolean {
    sequence
        i0: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
} <- create_type_interner();
        ra: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- parse_type(i0, actual_surface);
        rf: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- parse_type(ra.interner, formal_surface);
        ok: boolean <- case ra.ok and rf.ok of {
            false -> false;
            true -> {
                (m: boolean, _: List[{ ph: int64, id: int64 }, mem(normal)]) <- type_matches_schema(rf.interner, ra.id, rf.id);
                m
            }
        }
    produces
        pure ok
    end
}


// ---------------------------------------------------------------------------
// Placeholder recognition for the checker.
//
// These replace the hardcoded `t == "KeyType" or t == "ValueType" or ...` lists
// that were duplicated across type_checker_collections, _identifiers and
// _literals. parse_type's name->kind table is now the single authority for what
// counts as a placeholder; adding a new one there is picked up everywhere.

// 0 when the surface is not a placeholder, else its kind_ph_* code.
fn placeholder_kind_of_surface(s: string) -> int64 {
    sequence
        i0: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
} <- create_type_interner();
        r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- parse_type(i0, s);
        k: int64 <- case r.ok of {
            false -> 0;
            true -> {
                kk: int64 <- node_kind(r.interner, r.id);
                case is_placeholder_kind(kk) of {
                    true -> kk;
                    false -> 0
                }
            }
        }
    produces
        pure k
    end
}

fn is_placeholder_surface(s: string) -> boolean {
    placeholder_kind_of_surface(s) != 0
}

// Any placeholder anywhere inside a composite type (replaces substring probes
// for "KeyType" / "ValueType" / ... inside record and fn texts).
fn dag_contains_placeholder(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, fuel: int64) -> boolean {
    case fuel <= 0 of {
        true -> false;
        false -> case id <= 0 of {
            true -> false;
            false -> {
                k: int64 <- node_kind(interner, id);
                case is_placeholder_kind(k) of {
                    true -> true;
                    false -> dag_contains_placeholder(interner, node_a(interner, id), fuel - 1)
                        or dag_contains_placeholder(interner, node_b(interner, id), fuel - 1)
                        or dag_contains_placeholder(interner, node_c(interner, id), fuel - 1)
                }
            }
        }
    }
}

fn surface_contains_placeholder(s: string) -> boolean {
    sequence
        i0: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
} <- create_type_interner();
        r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- parse_type(i0, s);
        out: boolean <- case r.ok of {
            false -> false;
            true -> dag_contains_placeholder(r.interner, r.id, 4096)
        }
    produces
        pure out
    end
}
