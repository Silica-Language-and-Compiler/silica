fn empty_string_list() -> List[string, mem(normal)] {
    empty_strings()
}

fn reverse_strings(xs: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                next: List[string, mem(normal)] <- prepend[string, mem(normal)](xs.head, acc);
                result: List[string, mem(normal)] <- reverse_strings(xs.tail, next)
            produces
                pure result
            end
        }
    }
}

fn find_top_bar(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == "(" of {
                true -> find_top_bar(s, i + 1, depth + 1);
                false -> case ch == ")" of {
                    true -> find_top_bar(s, i + 1, depth - 1);
                    false -> case depth == 0 and ch == "|" of {
                        true -> i;
                        false -> find_top_bar(s, i + 1, depth)
                    }
                }
            }
        }
    }
}

fn split_atom_parts(s: string, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    pos: int64 <- find_top_bar(s, 0, 0);
    case pos < 0 of {
        true -> {
            sequence proc[mem(normal)]
                next: List[string, mem(normal)] <- prepend[string, mem(normal)](trim_type(s), acc);
                result: List[string, mem(normal)] <- next
            produces
                pure result
            end
        };
        false -> {
            left: string <- trim_type(substring(s, 0, pos));
            right: string <- substring(s, pos + 1, length_bytes(s));
            sequence proc[mem(normal)]
                next: List[string, mem(normal)] <- prepend[string, mem(normal)](left, acc);
                result: List[string, mem(normal)] <- split_atom_parts(right, next)
            produces
                pure result
            end
        }
    }
}

fn list_string_length_bytes(xs: List[string, mem(normal)]) -> int64 {
    case xs.is_nil of { true -> 0; false -> 1 + list_string_length_bytes(xs.tail) }
}

fn parse_atom_union_or_lit(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, s: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    t: string <- trim_type(s);
    case starts_with(t, "(") of {
        true -> {
            close: int64 <- find_matching_parens(t, 0, 0);
            case close == length_bytes(t) - 1 of {
                true -> {
                    inner: string <- substring(t, 1, close);
                    case starts_with(trim_type(inner), ":") of {
                        true -> parse_atom_union_or_lit(interner, inner);
                        false -> parse_fail(interner)
                    }
                };
                false -> parse_fail(interner)
            }
        };
        false -> case starts_with(t, ":") of {
            true -> {
                parts: List[string, mem(normal)] <- split_atom_parts(t, empty_string_list());
                case list_string_length_bytes(parts) == 1 of {
                    true -> {
                        r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- mk_atom_lit(interner, parts.head);
                        parse_ok(r.interner, r.id)
                    };
                    false -> {
                        sequence
                            empty_acc: List[string, mem(normal)] <- empty_string_list();
                            fwd: List[string, mem(normal)] <- reverse_strings(parts, empty_acc);
                            r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64 } <- mk_atom_union(interner, fwd);
                            result: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- parse_ok(r.interner, r.id)
                        produces
                            pure result
                        end
                    }
                }
            };
            false -> parse_fail(interner)
        }
    }
}

fn split_type_sum_parts(s: string, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    bar: int64 <- find_top_type_sum_bar(s, 0, 0, 0, 0);
    case bar < 0 of {
        true -> {
            sequence proc[mem(normal)]
                next: List[string, mem(normal)] <- prepend[string, mem(normal)](trim_type(s), acc);
                result: List[string, mem(normal)] <- next
            produces
                pure result
            end
        };
        false -> {
            left: string <- trim_type(substring(s, 0, bar));
            right: string <- substring(s, bar + 1, length_bytes(s));
            sequence proc[mem(normal)]
                next: List[string, mem(normal)] <- prepend[string, mem(normal)](left, acc);
                result: List[string, mem(normal)] <- split_type_sum_parts(right, next)
            produces
                pure result
            end
        }
    }
}

