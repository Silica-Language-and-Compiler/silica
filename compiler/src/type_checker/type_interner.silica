    seq_nil_id: int64
}, id: int64, ok: boolean } <- type_interner_surface@parse_type(p1b.interner, "(int64, boolean) -> string");
        p3: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- type_interner_surface@parse_type(p2.interner, "fn(int64, boolean) -> string");
        e1: int64 <- case type_interner_nodes@types_equal(a.id, b.id) of { true -> 0; false -> 1 };
        e2: int64 <- case type_interner_nodes@types_equal(lst.id, lst2.id) of { true -> 0; false -> 2 };
        e3: int64 <- case p1.ok of { true -> 0; false -> 3 };
        e4: int64 <- case type_interner_nodes@types_equal(p1.id, lst.id) of { true -> 0; false -> 4 };
        e4b: int64 <- case p1b.ok and type_interner_nodes@types_equal(p1.id, p1b.id) of { true -> 0; false -> 8 };
        e5: int64 <- case p2.ok and p3.ok of { true -> 0; false -> 5 };
        e6: int64 <- case type_interner_nodes@types_equal(p2.id, p3.id) of { true -> 0; false -> 6 };
        printed: string <- type_interner_print@print_type(p3.interner, p1.id);
        expect_list: string <- surface_list_int64_normal();
        e7: int64 <- case printed == expect_list of { true -> 0; false -> 7 };
        code: int64 <- case e1 != 0 of {
            true -> e1;
            false -> case e2 != 0 of {
                true -> e2;
                false -> case e3 != 0 of {
                    true -> e3;
                    false -> case e4 != 0 of {
                        true -> e4;
                        false -> case e4b != 0 of {
                            true -> e4b;
                            false -> case e5 != 0 of {
                                true -> e5;
                                false -> case e6 != 0 of {
                                    true -> e6;
                                    false -> e7
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure code
    end
}
