fn reverse_ids(xs: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence
        empty_acc: List[int64, mem(normal)] <- empty_int_list();
        result: List[int64, mem(normal)] <- list_int_reverse(xs, empty_acc)
    produces
        pure result
    end
}

