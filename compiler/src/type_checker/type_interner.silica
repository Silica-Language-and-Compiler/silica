}, id: int64, ok: boolean } {
    sequence
        t0: string <- trim_type(s);
        rest0: string <- case starts_with(t0, "OrderedMap") of {
            true -> trim_type(substring(t0, 10, length_bytes(t0)));
            false -> ""
