fn format_list_surface(elem: string, space: string) -> string {
    concat(concat("List", ch_lbracket()), concat(elem, concat(", ", concat(space, ch_rbracket()))))
}

fn format_list_legacy_surface(elem: string) -> string {
    concat(concat("List", ch_lbracket()), concat(elem, ch_rbracket()))
}

fn print_type(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> string {
    case id < 0 of {
        true -> "<invalid>";
        false -> case id >= interner.next_id of {
            true -> "<invalid>";
            false -> print_type_node(interner, id)
        }
    }
}

fn name_lexeme(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, name_id: int64) -> string {
    case name_id < 0 of {
        true -> "?";
        false -> strings_at(interner.name_lexemes, name_id)
    }
}

fn print_name_from_name_node(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> string {
    case node_kind(interner, id) == kind_name() of {
        true -> name_lexeme(interner, node_a(interner, id));
        false -> print_type_node(interner, id)
    }
}

fn print_seq(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, seq_id: int64, sep: string) -> string {
    case node_kind(interner, seq_id) == kind_id_seq_nil() of {
        true -> "";
        false -> case node_kind(interner, seq_id) == kind_id_seq() of {
            true -> {
                head_s: string <- print_type_node(interner, node_a(interner, seq_id));
                tail_s: string <- print_seq(interner, node_b(interner, seq_id), sep);
                case length_bytes(tail_s) == 0 of {
                    true -> head_s;
                    false -> concat(head_s, concat(sep, tail_s))
                }
            };
            false -> "?"
        }
    }
}

fn print_space(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> string {
    k: int64 <- node_kind(interner, id);
    case k of {
        80 -> "normal";
        81 -> "normal_writeback";
        82 -> "normal_writethrough";
        83 -> "normal_noncacheable";
        84 -> "atomic";
        85 -> "device";
        105 -> concat("mem(", concat(print_space(interner, node_a(interner, id)), ")"));
        _: int64 -> "?"
    }
}

// Collection surfaces require mem(Space); ref/region/buf use bare space names.
fn print_space_mem(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> string {
    case node_kind(interner, id) == kind_mem() of {
        true -> print_space(interner, node_a(interner, id));
        false -> print_space(interner, id)
    }
}

fn print_record_fields(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, seq_id: int64) -> string {
    case node_kind(interner, seq_id) == kind_id_seq_nil() of {
        true -> "";
        false -> case node_kind(interner, seq_id) == kind_id_seq() of {
            true -> {
                pair: int64 <- node_a(interner, seq_id);
                fname: string <- name_lexeme(interner, node_a(interner, pair));
                fty: string <- print_type_node(interner, node_b(interner, pair));
                head: string <- concat(fname, concat(": ", fty));
                tail: string <- print_record_fields(interner, node_b(interner, seq_id));
                case length_bytes(tail) == 0 of { true -> head; false -> concat(head, concat(", ", tail)) }
            };
            false -> "?"
        }
    }
}

fn print_atom_union(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, seq_id: int64) -> string {
    case node_kind(interner, seq_id) == kind_id_seq_nil() of {
        true -> "";
        false -> case node_kind(interner, seq_id) == kind_id_seq() of {
            true -> {
                head: string <- print_type_node(interner, node_a(interner, seq_id));
                tail: string <- print_atom_union(interner, node_b(interner, seq_id));
                case length_bytes(tail) == 0 of { true -> head; false -> concat(head, concat("|", tail)) }
            };
            false -> "?"
        }
    }
}

fn print_buf(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> string {
    seq: int64 <- node_a(interner, id);
    rgn: int64 <- node_a(interner, seq);
    sp_seq: int64 <- node_b(interner, seq);
    space: int64 <- node_a(interner, sp_seq);
    pl_seq: int64 <- node_b(interner, sp_seq);
    payload: int64 <- node_a(interner, pl_seq);
    n: int64 <- node_b(interner, id);
    size_s: string <- case nodes_at(interner.nodes, id).buf_size_is_name of {
        true -> print_name_from_name_node(interner, n);
        false -> i64_to_dec(n)
    };
    concat("buf(", concat(print_name_from_name_node(interner, rgn), concat(", ", concat(print_space(interner, space), concat(", ", concat(print_type_node(interner, payload), concat(", ", concat(size_s, ")"))))))))
}

fn print_weighted(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> string {
    seq: int64 <- node_a(interner, id);
    n0: int64 <- node_a(interner, seq);
    s1: int64 <- node_b(interner, seq);
    n1: int64 <- node_a(interner, s1);
    s2: int64 <- node_b(interner, s1);
    n2: int64 <- node_a(interner, s2);
    space: int64 <- node_b(interner, id);
    concat("WeightedGraph[", concat(print_type_node(interner, n0), concat(", ", concat(print_type_node(interner, n1), concat(", ", concat(print_type_node(interner, n2), concat(", ", concat(print_space_mem(interner, space), ch_rbracket())))))))
}

// A device tag is a one-atom tuple; the interner keeps the atom itself, so its text gets the parens back.
fn device_tag_text(s: string) -> string {
    case length_bytes(s) > 0 and substring(s, 0, 1) == "(" of {
        true -> s;
        false -> concat("(", concat(s, ")"))
    }
}

fn print_type_node(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> string {
    k: int64 <- node_kind(interner, id);
    case k of {
        10 -> "unit";
        11 -> "boolean";
        12 -> "int8";
        13 -> "int16";
        14 -> "int32";
        15 -> "int64";
        16 -> "uint8";
        17 -> "uint16";
        18 -> "uint32";
        19 -> "uint64";
        20 -> "float16";
        21 -> "float32";
        22 -> "float64";
        23 -> "char";
        24 -> "string";
        25 -> "atom";
        26 -> "lifetime";
        27 -> "discard";
        28 -> "rec";
        29 -> "Collectable";
        30 -> "ActorMessage";
        40 -> "actor_ref";
        41 -> "dangerous_actor_ref";
        48 -> "device_actor_ref";
        49 -> "timer_ref";
        42 -> "supervisor_ref";
        43 -> "monitor_ref";
        44 -> "supervisor_flags";
        45 -> "failure_reason";
        46 -> "child_spec";
        47 -> "stack_policy";
        50 -> "cpu_topology";
        51 -> "core_info";
        52 -> "numa_info";
        53 -> "memory_range";
        54 -> "cache_info";
        55 -> "cache_level";
        60 -> "ItemType";
        61 -> "KeyType";
        62 -> "ValueType";
        63 -> "SpaceType";
        64 -> "SetType";
        65 -> "MapType";
        66 -> "HeapType";
        67 -> "GraphType";
        68 -> "QueueType";
        69 -> "TreeType";
        70 -> "NodeIdType";
        71 -> "EdgePayloadType";
        72 -> "EdgeDataType";
        73 -> "PriorityType";
        74 -> "WeightType";
        75 -> "AccType";
        80 -> "normal";
        81 -> "normal_writeback";
        82 -> "normal_writethrough";
        83 -> "normal_noncacheable";
        84 -> "atomic";
        85 -> "device";
        100 -> concat("(", concat(print_seq(interner, node_a(interner, id), ","), concat(") -> ", print_type_node(interner, node_b(interner, id)))));
        101 -> concat("(", concat(print_seq(interner, node_a(interner, id), ","), ")"));
        102 -> concat(ch_lbrace(), concat(print_record_fields(interner, node_a(interner, id)), ch_rbrace()));
        103 -> {
            sequence
                elem_s: string <- print_type_node(interner, node_a(interner, id));
                space_s: string <- print_space_mem(interner, node_b(interner, id));
                out_s: string <- format_list_surface(elem_s, space_s)
            produces
                pure out_s
            end
        };
        104 -> {
            sequence
                elem_s: string <- print_type_node(interner, node_a(interner, id));
                out_s: string <- format_list_legacy_surface(elem_s)
            produces
                pure out_s
            end
        };
        105 -> concat("mem(", concat(print_space(interner, node_a(interner, id)), ")"));
        106 -> concat("ref(", concat(print_name_from_name_node(interner, node_a(interner, id)), concat(", ", concat(print_space(interner, node_b(interner, id)), concat(", ", concat(print_type_node(interner, node_c(interner, id)), ")"))))));
        107 -> concat("ref?(", concat(print_name_from_name_node(interner, node_a(interner, id)), concat(", ", concat(print_space(interner, node_b(interner, id)), concat(", ", concat(print_type_node(interner, node_c(interner, id)), ")"))))));
        108 -> concat("region(", concat(print_name_from_name_node(interner, node_a(interner, id)), concat(", ", concat(print_space(interner, node_b(interner, id)), ")"))));
        114 -> concat("device_window(", concat(print_name_from_name_node(interner, node_a(interner, id)), concat(", ", concat(device_tag_text(print_type_node(interner, node_b(interner, id))), ")"))));
        109 -> print_buf(interner, id);
        110 -> concat("atomic_ref(", concat(print_name_from_name_node(interner, node_a(interner, id)), concat(", ", concat(print_space(interner, node_b(interner, id)), concat(", ", concat(print_type_node(interner, node_c(interner, id)), ")"))))));
        111 -> print_seq(interner, node_a(interner, id), " | ");
        112 -> concat(":", name_lexeme(interner, node_a(interner, id)));
        113 -> print_atom_union(interner, node_a(interner, id));
        120 -> concat("OrderedSet[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_space_mem(interner, node_b(interner, id)), "]"))));
        121 -> concat("OrderedMap[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_type_node(interner, node_b(interner, id)), concat(", ", concat(print_space_mem(interner, node_c(interner, id)), ch_rbracket()))))));
        122 -> concat("Heap[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_space_mem(interner, node_b(interner, id)), "]"))));
        123 -> concat("SearchTree[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_space_mem(interner, node_b(interner, id)), "]"))));
        124 -> concat("Tree[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_space_mem(interner, node_b(interner, id)), "]"))));
        129 -> concat("BinaryTree[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_space_mem(interner, node_b(interner, id)), "]"))));
        125 -> concat("DirectedGraph[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_type_node(interner, node_b(interner, id)), concat(", ", concat(print_space_mem(interner, node_c(interner, id)), ch_rbracket()))))));
        126 -> concat("UndirectedGraph[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_type_node(interner, node_b(interner, id)), concat(", ", concat(print_space_mem(interner, node_c(interner, id)), ch_rbracket()))))));
        127 -> print_weighted(interner, id);
        128 -> concat("PriorityQueue[", concat(print_type_node(interner, node_a(interner, id)), concat(", ", concat(print_type_node(interner, node_b(interner, id)), concat(", ", concat(print_space_mem(interner, node_c(interner, id)), ch_rbracket()))))));
        4 -> name_lexeme(interner, node_a(interner, id));
        _: int64 -> concat("<kind:", concat(i64_to_dec(k), ">"))
    }
}

