// Phase 1 type DAG interner smoke (phase1_roundtrip_smoke), kept here for the trial
// ordered_data_structures/compiler_substrate/type_interner_roundtrip. The interner was split on
// 2026-11-02 into type_interner_kinds, _nodes, _core, _surface, _print, _dag and _schema.

use type_interner_kinds;
use type_interner_nodes;
use type_interner_core;
use type_interner_surface;
use type_interner_print;

export phase1_roundtrip_smoke/0;

// Phase 1 trial entry: exercise create / mk_prim / mk_list / parse / print roundtrip inside this module


fn surface_list_int64_mem_normal() -> string {
    concat(concat("List", type_interner_core@ch_lbracket()), concat("int64, mem(normal)", type_interner_core@ch_rbracket()))
}

fn surface_list_int64_normal() -> string {
    concat(concat("List", type_interner_core@ch_lbracket()), concat("int64, normal", type_interner_core@ch_rbracket()))
}


fn phase1_roundtrip_smoke() -> int64 {
    // Full Phase 1 smoke: intern hit, List parse/print, fn scheme parse.
    sequence
        i0: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
} <- type_interner_core@create_type_interner();
        a: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))),
