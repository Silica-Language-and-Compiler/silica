fn is_space_kind(k: int64) -> boolean {
    case k of {
        80 -> true;
        81 -> true;
        82 -> true;
        83 -> true;
        84 -> true;
        85 -> true;
        _: int64 -> false
    }
}

fn unwrap_space_id(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64) -> { id: int64, ok: boolean } {
    k: int64 <- node_kind(interner, id);
    case k == kind_mem() of {
        true -> {
            inner: int64 <- node_a(interner, id);
            case is_space_kind(node_kind(interner, inner)) of {
                true -> { id: inner, ok: true };
                false -> { id: invalid_type_id(), ok: false }
            }
        };
        false -> case is_space_kind(k) of {
            true -> { id: id, ok: true };
            false -> { id: invalid_type_id(), ok: false }
        }
    }
}

fn parse_space_slot(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
