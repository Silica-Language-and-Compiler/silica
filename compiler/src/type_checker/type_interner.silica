        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- parse_type_sum_ids(interner, parts, empty_int_list())
    produces
        pure result
    end
}

fn empty_field_list() -> List[{ name: string, ty: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, ty: int64 }, mem(normal)] <- empty[{ name: string, ty: int64 }, mem(normal)]()
    produces
        pure result
    end
}

fn reverse_fields(
    xs: List[{ name: string, ty: int64 }, mem(normal)],
    acc: List[{ name: string, ty: int64 }, mem(normal)]
) -> List[{ name: string, ty: int64 }, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                next: List[{ name: string, ty: int64 }, mem(normal)] <- prepend[{ name: string, ty: int64 }, mem(normal)](xs.head, acc);
                result: List[{ name: string, ty: int64 }, mem(normal)] <- reverse_fields(xs.tail, next)
            produces
                pure result
            end
        }
    }
}

