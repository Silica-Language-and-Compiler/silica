fn parse_ref_family(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, s: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    t: string <- trim_type(s);
    case starts_with(t, "ref?(") of {
        true -> parse_ref_like(interner, t, "ref?(", 1);
        false -> case starts_with(t, "ref(") of {
            true -> parse_ref_like(interner, t, "ref(", 0);
            false -> case starts_with(t, "region(") of {
                true -> parse_region_like(interner, t);
                false -> case starts_with(t, "atomic_ref(") of {
                    true -> parse_ref_like(interner, t, "atomic_ref(", 2);
                    false -> case starts_with(t, "buf(") of {
                        true -> parse_buf_like(interner, t);
                        false -> case starts_with(t, "device_window(") of {
                            true -> parse_device_window_like(interner, t);
                            false -> parse_fail(interner)
                        }
                    }
                }
            }
        }
    }
}

fn parse_ref_like(interner: {
