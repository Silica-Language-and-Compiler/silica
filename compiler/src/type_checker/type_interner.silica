    seq_nil_id: int64
}, id: int64, ok: boolean } {
    t0: string <- trim_type(s);
    after_mem: string <- case starts_with(t0, "mem") of {
        true -> trim_type(substring(t0, 3, length_bytes(t0)));
        false -> t0
    };
    t: string <- case starts_with(t0, "mem") of {
        true -> case starts_with(after_mem, "(") of {
            true -> concat("mem", after_mem);
            false -> t0
        };
        false -> t0
    };
    case starts_with(t, "mem(") of {
            true -> {
                close: int64 <- find_matching_parens(t, 3, 0);
                case close < 0 of {
                    true -> parse_fail(interner);
                    false -> {
                        inner: string <- trim_type(substring(t, 4, close));
                        sk: int64 <- space_kind_of(inner);
                        case sk < 0 of {
                            true -> parse_fail(interner);
                            false -> {
                                sequence
                                    r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
