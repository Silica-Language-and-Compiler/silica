fn strip_fn_prefix(s: string) -> string {
    t: string <- trim_type(s);
    case starts_with(t, "fn") of {
        true -> trim_type(substring(t, 2, length_bytes(t)));
        false -> t
    }
}

fn find_colon_top(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == "(" or ch == ch_lbracket() or ch == ch_lbrace() of {
                true -> find_colon_top(s, i + 1, depth + 1);
                false -> case ch == ")" or ch == ch_rbracket() or ch == ch_rbrace() of {
                    true -> find_colon_top(s, i + 1, depth - 1);
                    false -> case depth == 0 and ch == ":" of {
                        true -> i;
                        false -> find_colon_top(s, i + 1, depth)
                    }
                }
            }
        }
    }
}

fn strip_named_params_work(s: string, acc: string) -> string {
    t: string <- trim_type(s);
    case length_bytes(t) == 0 of {
        true -> acc;
        false -> {
            cpos: int64 <- find_top_comma(t, 0, 0, 0, 0);
            piece: string <- case cpos < 0 of { true -> t; false -> substring(t, 0, cpos) };
            rest: string <- case cpos < 0 of { true -> ""; false -> substring(t, cpos + 1, length_bytes(t)) };
            colon: int64 <- find_colon_top(piece, 0, 0);
            ty: string <- case colon < 0 of {
                true -> trim_type(piece);
                false -> trim_type(substring(piece, colon + 1, length_bytes(piece)))
            };
            next_acc: string <- case length_bytes(acc) == 0 of { true -> ty; false -> concat(acc, concat(", ", ty)) };
            case cpos < 0 of {
                true -> next_acc;
                false -> strip_named_params_work(rest, next_acc)
            }
        }
    }
}

fn parse_fn_or_tuple(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
