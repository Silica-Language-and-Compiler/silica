fn trim_left(s: string) -> string {
    case length_bytes(s) == 0 of {
        true -> s;
        false -> case substring(s, 0, 1) == " " of {
            true -> trim_left(substring(s, 1, length_bytes(s)));
            false -> s
        }
    }
}

fn trim_right_type_text(s: string, end_i: int64) -> string {
    case end_i <= 0 of {
        true -> "";
        false -> case substring(s, end_i - 1, end_i) == " " of {
            true -> trim_right_type_text(s, end_i - 1);
            // No trailing space: return the string itself. This runs at EVERY parse_type_inner
            // recursion level; the unconditional substring(s, 0, end_i) copied each (already
            // stripped) sub-surface into the never-released arena once per level.
            false -> case end_i == length_bytes(s) of {
                true -> s;
                false -> substring(s, 0, end_i)
            }
        }
    }
}

fn trim_type(s: string) -> string {
    t: string <- trim_left(s);
    trim_right_type_text(t, length_bytes(t))
}

// Parser type surfaces insert spaces between tokens (`region ( L , normal )`).
// Interning prefixes require compact forms (`region(L,normal)`); strip spaces once up front.
fn type_surface_has_space(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0;
        false -> case substring(s, i, i + 1) == " " of {
            true -> 1;
            false -> type_surface_has_space(s, i + 1)
        }
    }
}

// Divide-and-conquer strip. The old loop did concat(acc, ch) once per character, so a 10 KB
// surface copied ~50 MB into the concat arena (sum of growing prefixes) on every parse; the
// arena is never released, and that was 7 GB of 4 MB chunks on emitter_core. Splitting
// recursively and concatenating the halves copies O(n log n) bytes instead: ~140 KB.
fn strip_type_spaces_from(s: string, i: int64, acc: string) -> string {
    concat(acc, strip_type_spaces_range(s, i, length_bytes(s)))
}

fn strip_type_spaces_range(s: string, lo: int64, hi: int64) -> string {
    case hi - lo <= 48 of {
        true -> strip_type_spaces_small(s, lo, hi, "");
        false -> {
            mid: int64 <- lo + (hi - lo) / 2;
            concat(strip_type_spaces_range(s, lo, mid), strip_type_spaces_range(s, mid, hi))
        }
    }
}

fn strip_type_spaces_small(s: string, i: int64, hi: int64, acc: string) -> string {
    case i >= hi of {
        true -> acc;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == " " of {
                true -> strip_type_spaces_small(s, i + 1, hi, acc);
                false -> strip_type_spaces_small(s, i + 1, hi, concat(acc, ch))
            }
        }
    }
}

fn strip_type_spaces(s: string) -> string {
    // Hot path: annotations are usually already compact — avoid O(n) rebuild.
    case type_surface_has_space(s, 0) of {
        0 -> s;
        _: int64 -> strip_type_spaces_cached(s)
    }
}

// Process-wide strip cache (see type_surface_cache): the interner's own memo is lost whenever
// the type checker discards a context, so the same spaced annotation was re-stripped
// hundreds of times into the never-released string arena.
fn strip_type_spaces_cached(s: string) -> string {
    hit: string <- type_surface_cache@stripped_for(s);
    case length_bytes(hit) > 0 of {
        true -> hit;
        false -> type_surface_cache@remember_stripped(s, strip_type_spaces_from(s, 0, ""))
    }
}

fn find_matching(s: string, i: int64, open_ch: string, close_ch: string, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == open_ch of {
                true -> find_matching(s, i + 1, open_ch, close_ch, depth + 1);
                false -> case ch == close_ch of {
                    true -> case depth == 1 of {
                        true -> i;
                        false -> find_matching(s, i + 1, open_ch, close_ch, depth - 1)
                    };
                    false -> find_matching(s, i + 1, open_ch, close_ch, depth)
                }
            }
        }
    }
}

fn find_matching_brackets(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == ch_lbracket() of {
                true -> find_matching_brackets(s, i + 1, depth + 1);
                false -> case ch == ch_rbracket() of {
                    true -> case depth == 1 of {
                        true -> i;
                        false -> find_matching_brackets(s, i + 1, depth - 1)
                    };
                    false -> find_matching_brackets(s, i + 1, depth)
                }
            }
        }
    }
}

fn find_matching_braces(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == ch_lbrace() of {
                true -> find_matching_braces(s, i + 1, depth + 1);
                false -> case ch == ch_rbrace() of {
                    true -> case depth == 1 of {
                        true -> i;
                        false -> find_matching_braces(s, i + 1, depth - 1)
                    };
                    false -> find_matching_braces(s, i + 1, depth)
                }
            }
        }
    }
}

fn find_matching_parens(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == "(" of {
                true -> find_matching_parens(s, i + 1, depth + 1);
                false -> case ch == ")" of {
                    true -> case depth == 1 of {
                        true -> i;
                        false -> find_matching_parens(s, i + 1, depth - 1)
                    };
                    false -> find_matching_parens(s, i + 1, depth)
                }
            }
        }
    }
}


fn find_top_arrow(s: string, i: int64, depth_paren: int64, depth_brack: int64, depth_brace: int64) -> int64 {
    case i >= length_bytes(s) - 1 of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == "(" of {
                true -> find_top_arrow(s, i + 1, depth_paren + 1, depth_brack, depth_brace);
                false -> case ch == ")" of {
                    true -> find_top_arrow(s, i + 1, depth_paren - 1, depth_brack, depth_brace);
                    false -> case ch == ch_lbracket() of {
                        true -> find_top_arrow(s, i + 1, depth_paren, depth_brack + 1, depth_brace);
                        false -> case ch == ch_rbracket() of {
                            true -> find_top_arrow(s, i + 1, depth_paren, depth_brack - 1, depth_brace);
                            false -> case ch == ch_lbrace() of {
                                true -> find_top_arrow(s, i + 1, depth_paren, depth_brack, depth_brace + 1);
                                false -> case ch == ch_rbrace() of {
                                    true -> find_top_arrow(s, i + 1, depth_paren, depth_brack, depth_brace - 1);
                                    false -> case depth_paren == 0 and depth_brack == 0 and depth_brace == 0 and substring(s, i, i + 2) == "->" of {
                                        true -> i;
                                        false -> find_top_arrow(s, i + 1, depth_paren, depth_brack, depth_brace)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn find_top_comma(s: string, i: int64, depth_paren: int64, depth_brack: int64, depth_brace: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == "(" of {
                true -> find_top_comma(s, i + 1, depth_paren + 1, depth_brack, depth_brace);
                false -> case ch == ")" of {
                    true -> find_top_comma(s, i + 1, depth_paren - 1, depth_brack, depth_brace);
                    false -> case ch == ch_lbracket() of {
                        true -> find_top_comma(s, i + 1, depth_paren, depth_brack + 1, depth_brace);
                        false -> case ch == ch_rbracket() of {
                            true -> find_top_comma(s, i + 1, depth_paren, depth_brack - 1, depth_brace);
                            false -> case ch == ch_lbrace() of {
                                true -> find_top_comma(s, i + 1, depth_paren, depth_brack, depth_brace + 1);
                                false -> case ch == ch_rbrace() of {
                                    true -> find_top_comma(s, i + 1, depth_paren, depth_brack, depth_brace - 1);
                                    false -> case ch == "," of {
                                        true -> case depth_paren == 0 of {
                                            true -> case depth_brack == 0 of {
                                                true -> case depth_brace == 0 of {
                                                    true -> i;
                                                    false -> find_top_comma(s, i + 1, depth_paren, depth_brack, depth_brace)
                                                };
                                                false -> find_top_comma(s, i + 1, depth_paren, depth_brack, depth_brace)
                                            };
                                            false -> find_top_comma(s, i + 1, depth_paren, depth_brack, depth_brace)
                                        };
                                        false -> find_top_comma(s, i + 1, depth_paren, depth_brack, depth_brace)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn find_top_type_sum_bar(s: string, i: int64, depth_paren: int64, depth_brack: int64, depth_brace: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == "(" of {
                true -> find_top_type_sum_bar(s, i + 1, depth_paren + 1, depth_brack, depth_brace);
                false -> case ch == ")" of {
                    true -> find_top_type_sum_bar(s, i + 1, depth_paren - 1, depth_brack, depth_brace);
                    false -> case ch == ch_lbracket() of {
                        true -> find_top_type_sum_bar(s, i + 1, depth_paren, depth_brack + 1, depth_brace);
                        false -> case ch == ch_rbracket() of {
                            true -> find_top_type_sum_bar(s, i + 1, depth_paren, depth_brack - 1, depth_brace);
                            false -> case ch == ch_lbrace() of {
                                true -> find_top_type_sum_bar(s, i + 1, depth_paren, depth_brack, depth_brace + 1);
                                false -> case ch == ch_rbrace() of {
                                    true -> find_top_type_sum_bar(s, i + 1, depth_paren, depth_brack, depth_brace - 1);
                                    false -> case ch == "|" of {
                                        true -> case depth_paren == 0 of {
                                            true -> case depth_brack == 0 of {
                                                true -> case depth_brace == 0 of {
                                                    true -> i;
                                                    false -> find_top_type_sum_bar(s, i + 1, depth_paren, depth_brack, depth_brace)
                                                };
                                                false -> find_top_type_sum_bar(s, i + 1, depth_paren, depth_brack, depth_brace)
                                            };
                                            false -> find_top_type_sum_bar(s, i + 1, depth_paren, depth_brack, depth_brace)
                                        };
                                        false -> find_top_type_sum_bar(s, i + 1, depth_paren, depth_brack, depth_brace)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn parse_type(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, surface: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    // Surface memo. Type checking the compiler re-parses the same 8-10 KB inline signatures
    // hundreds of times each; every parse copied the surface (strip_type_spaces) and sliced it
    // into the string arena, which held 7 GB of stripped surfaces on emitter_core. Composite
    // surfaces (anything with a bracket, brace, paren or arrow) are memoised in `names` keyed by
    // the RAW surface -> root node id, so a hit allocates nothing. Identifier surfaces are left
    // alone: `names` maps identifier lexemes to lexeme indices for intern_name, and an identifier
    // surface can never collide with a composite key. A hit returns exactly the id a re-parse into
    // this interner would hash-cons to, so ids and goldens are unchanged.
    case surface_is_composite(surface) of {
        false -> parse_type_inner(interner, surface);
        true -> parse_type_memo(interner, surface)
    }
}

// The memo lives in `names`, which also maps identifier lexemes to lexeme indices, and
// parse_type_into_context falls back to mk_name on a surface the parser rejects -- that stored
// the composite surface itself as a lexeme, so the next memo lookup of the same surface handed
// the lexeme index back as a type id (constructor_stub_empty_run: the second Heap[...] binding
// checked against node 0). Memo keys carry a prefix no lexeme or surface can start with.
fn memo_key(surface: string) -> string {
    concat("@memo:", surface)
}

fn surface_is_composite(s: string) -> boolean {
    contains_char_ti(s, "(") or contains_char_ti(s, "[") or contains_char_ti(s, "{") or contains_char_ti(s, "-")
}

fn contains_char_ti(s: string, c: string) -> boolean {
    contains_char_ti_from(s, c, 0)
}

fn contains_char_ti_from(s: string, c: string, i: int64) -> boolean {
    case i >= length_bytes(s) of {
        true -> false;
        false -> case substring(s, i, i + 1) == c of {
            true -> true;
            false -> contains_char_ti_from(s, c, i + 1)
        }
    }
}

fn parse_type_memo(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, surface: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    sequence
        names0: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    } <- repair_string_int_map(interner.names);
        g: { status: :not_found | :found, value: int64 } <- OrderedMap@get(names0, memo_key(surface), 0);
        out: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- case g.status of {
            :found -> { interner: { nodes: interner.nodes, by_key: interner.by_key, names: names0, name_lexemes: interner.name_lexemes, next_id: interner.next_id, seq_nil_id: interner.seq_nil_id }, id: g.value, ok: true };
            :not_found -> parse_type_remember(parse_type_inner(interner, surface), surface)
        }
    produces
        pure out
    end
}

fn parse_type_remember(parsed: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean }, surface: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    case parsed.ok of {
        false -> parsed;
        true -> {
            sequence
                names1: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    } <- repair_string_int_map(parsed.interner.names);
                r: { map: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    }, inserted: boolean, replaced: boolean } <- wbt_map@insert(names1, memo_key(surface), parsed.id);
                done: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- { interner: { nodes: parsed.interner.nodes, by_key: parsed.interner.by_key, names: r.map, name_lexemes: parsed.interner.name_lexemes, next_id: parsed.interner.next_id, seq_nil_id: parsed.interner.seq_nil_id }, id: parsed.id, ok: true }
            produces
                pure done
            end
        }
    }
}

// Structural equality between a surface type string and an interned type id.
// Parses `surface` into this interner (hash-consed) and compares the resulting id to
// `expected_id`. Structurally-equal types dedupe to the same id, so this is whitespace-
// and rendering-insensitive: "fn ( int64 ) -> int64" matches "(int64) -> int64". Mirrors
// src/ check_actor_call_builtin, which uses types_equal_type_ids for the reply check.
fn surface_equals_type_id(interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 }, surface: string, expected_id: int64) -> boolean {
    pr: { interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 }, id: int64, ok: boolean } <- parse_type(interner, surface);
    pr.ok and pr.id == expected_id
}

fn parse_type_inner(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, s: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    t: string <- strip_type_spaces(trim_type(s));
    case length_bytes(t) == 0 of {
        true -> parse_fail(interner);
        false -> {
            bar: int64 <- find_top_type_sum_bar(t, 0, 0, 0, 0);
            got: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } <- case bar >= 0 of {
                true -> parse_type_sum(interner, t);
                false -> case starts_with(t, ":") of {
                    true -> parse_atom_union_or_lit(interner, t);
                    false -> case starts_with(t, ch_lbrace()) of {
                        true -> parse_record_type(interner, t);
                        false -> case starts_with(t, "List") of {
                            true -> parse_list_type(interner, t);
                            false -> case starts_with(t, "OrderedMap") of {
                                true -> parse_ordered_map(interner, t);
                                false -> case starts_with(t, "OrderedSet") of {
                                    true -> parse_ordered_set(interner, t);
                                    false -> case starts_with(t, "mem(") of {
                                    true -> parse_mem_type(interner, t);
                                    false -> case starts_with(t, "ref") or starts_with(t, "region(") or starts_with(t, "buf(") or starts_with(t, "atomic_ref(") or starts_with(t, "device_window(") of {
                                        true -> parse_ref_family(interner, t);
                                        false -> case starts_with(t, "Heap") or starts_with(t, "Tree") or starts_with(t, "SearchTree") or starts_with(t, "DirectedGraph") or starts_with(t, "UndirectedGraph") or starts_with(t, "WeightedGraph") or starts_with(t, "PriorityQueue") or starts_with(t, "BinaryTree") of {
                                            true -> parse_collection(interner, t);
                                            false -> case starts_with(t, "fn") or starts_with(t, "(") of {
                                                true -> parse_fn_or_tuple(interner, t);
                                                false -> parse_base_name(interner, t)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            };
            { interner: got.interner, id: got.id, ok: got.ok }
        }
    }
}

fn space_kind_of(name: string) -> int64 {
    case name of {
        "normal" -> kind_space_normal();
        "normal_writeback" -> kind_space_normal_writeback();
        "normal_writethrough" -> kind_space_normal_writethrough();
        "normal_noncacheable" -> kind_space_normal_noncacheable();
        "atomic" -> kind_space_atomic();
        "device" -> kind_space_device();
        _: string -> 0 - 1
    }
}

fn base_kind_of(name: string) -> int64 {
    case name of {
        "unit" -> kind_unit();
        "boolean" -> kind_boolean();
        "bool" -> kind_boolean();
        "int8" -> kind_int8();
        "int16" -> kind_int16();
        "int32" -> kind_int32();
        "int64" -> kind_int64();
        "int" -> kind_int64();
        "uint8" -> kind_uint8();
        "uint16" -> kind_uint16();
        "uint32" -> kind_uint32();
        "uint64" -> kind_uint64();
        "float16" -> kind_float16();
        "float32" -> kind_float32();
        "float64" -> kind_float64();
        "float" -> kind_float64();
        "char" -> kind_char();
        "string" -> kind_string();
        "atom" -> kind_atom();
        "lifetime" -> kind_lifetime();
        "discard" -> kind_discard();
        "rec" -> kind_rec();
        "Collectable" -> kind_collectable();
        "ActorMessage" -> kind_actor_message();
        "actor_ref" -> kind_actor_ref();
        "dangerous_actor_ref" -> kind_dangerous_actor_ref();
        "device_actor_ref" -> kind_device_actor_ref();
        "timer_ref" -> kind_timer_ref();
        "supervisor_ref" -> kind_supervisor_ref();
        "monitor_ref" -> kind_monitor_ref();
        "supervisor_flags" -> kind_supervisor_flags();
        "failure_reason" -> kind_failure_reason();
        "child_spec" -> kind_child_spec();
        "stack_policy" -> kind_stack_policy();
        "cpu_topology" -> kind_cpu_topology();
        "core_info" -> kind_core_info();
        "numa_info" -> kind_numa_info();
        "memory_range" -> kind_memory_range();
        "cache_info" -> kind_cache_info();
        "cache_level" -> kind_cache_level();
        "ItemType" -> kind_ph_item_type();
        "KeyType" -> kind_ph_key_type();
        "ValueType" -> kind_ph_value_type();
        "SpaceType" -> kind_ph_space_type();
        "SetType" -> kind_ph_set_type();
        "MapType" -> kind_ph_map_type();
        "HeapType" -> kind_ph_heap_type();
        "GraphType" -> kind_ph_graph_type();
        "QueueType" -> kind_ph_queue_type();
        "TreeType" -> kind_ph_tree_type();
        "NodeIdType" -> kind_ph_node_id_type();
        "EdgePayloadType" -> kind_ph_edge_payload_type();
        "EdgeDataType" -> kind_ph_edge_data_type();
        "PriorityType" -> kind_ph_priority_type();
        "WeightType" -> kind_ph_weight_type();
        "AccType" -> kind_ph_acc_type();
        "normal" -> kind_space_normal();
        "normal_writeback" -> kind_space_normal_writeback();
        "normal_writethrough" -> kind_space_normal_writethrough();
        "normal_noncacheable" -> kind_space_normal_noncacheable();
        "atomic" -> kind_space_atomic();
        "device" -> kind_space_device();
        _: string -> 0 - 1
    }
}

fn parse_base_name(interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, name: string) -> { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    names: {
        root: ref?(L, normal, rec),
        compare_key: fn(string, string) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_key_ordering_bundle: int64,
        compare_value_ordering_bundle: int64
    },
    name_lexemes: List[string, mem(normal)],
    next_id: int64,
    seq_nil_id: int64
}, id: int64, ok: boolean } {
    k: int64 <- base_kind_of(name);
    case k < 0 of {
        true -> {
            r: { interner: {
    nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)],
    by_key: {
