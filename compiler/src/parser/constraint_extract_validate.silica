    (found: boolean, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_has_uncategorized_syntax_defect(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1000", err_loc, uncategorized_syntax_defect_message(), "sect3");
        false -> parser_core@parse_ok(program)
    }
}



fn validate_no_illegal_trailing_semicolon(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: boolean, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_has_illegal_trailing_semicolon(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1041", err_loc, "the last expression in this block must not be followed by ';'", "sect3");
        false -> parser_core@parse_ok(program)
    }
}



// --- E1055: local bindings must be used within their lexical scope ---

fn is_unused_scope_discard_name(nm: string) -> boolean {
    case length_bytes(nm) == 0 of {
        true -> false;
        false -> substring(nm, 0, 1) == "_"
    }
}



fn tuple_binding_names_contains(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], nm: string) -> boolean {
    case bindings.is_nil of {
        true -> false;
        false -> case bindings.head.name == nm of {
            true -> true;
            false -> tuple_binding_names_contains(bindings.tail, nm)
        }
    }
}



fn expr_contains_identifier_named(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, nm: string) -> boolean {
    case expr.root < 0 of {
        true -> false;
        false -> case parser_ast@expr_root_kind(expr) == 1 of {
            true -> parser_ast@expr_root_name(expr) == nm;
            false -> case parser_ast@expr_root_kind(expr) == 4 of {
                true -> parser_ast@expr_root_name(expr) == nm or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), nm) or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), nm);
                false -> case parser_ast@expr_root_kind(expr) == 6 of {
                true -> case parser_ast@expr_root_name(expr) == nm of {
                    // Typed call/site args (`f(x: T)`) reuse kind 6 with dummy inner; the name is the use.
                    true -> case parser_ast@expr_root_inner(expr) < 0 of {
                        true -> true;
                        false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), nm)
                    };
                    false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), nm) or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), nm)
                };
                false -> case parser_ast@expr_root_kind(expr) == 10 of {
                    true -> case tuple_binding_names_contains(parser_ast@expr_root_node(expr).pattern_bindings, nm) of {
                        true -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), nm);
                        false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), nm) or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), nm)
                    };
                    false -> case parser_ast@expr_root_kind(expr) == 991 of {
                        true -> case tuple_binding_names_contains(parser_ast@expr_root_node(expr).pattern_bindings, nm) of {
                            true -> false;
                            false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), nm)
                        };
                        false -> case parser_ast@expr_root_kind(expr) == 22 of {
                            true -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), nm);
                            false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), nm) or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), nm)
                        }
                    }
                }
            }
            }
        }
    }
}



fn tuple_bindings_find_unused(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, extra: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (boolean, string) {
    case bindings.is_nil of {
        true -> (false, "");
        false -> {
            nm: string <- bindings.head.name;
            case is_unused_scope_discard_name(nm) of {
                true -> tuple_bindings_find_unused(bindings.tail, body, extra);
                false -> case expr_contains_identifier_named(body, nm) or expr_contains_identifier_named(extra, nm) of {
                    true -> tuple_bindings_find_unused(bindings.tail, body, extra);
                    false -> (true, nm)
                }
            }
        }
    }
}



fn expr_contains_unused_binding_exempt_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr.root < 0 of {
        true -> false;
        false -> case parser_ast@expr_root_kind(expr) == 4 or parser_ast@expr_root_kind(expr) == 12 or parser_ast@expr_root_kind(expr) == 991 of {
            true -> true;
            false -> expr_contains_unused_binding_exempt_expr(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr))) or expr_contains_unused_binding_exempt_expr(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)))
        }
    }
}



fn expr_has_unused_scope_binding(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, extra_scope_result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case expr.root < 0 of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case parser_ast@expr_root_kind(expr) == 6 of {
            true -> case parser_ast@expr_root_inner(expr) < 0 of {
                // Typed call/site arg (`f(x: T)`): kind 6 with dummy inner — not a scope binding.
                true -> (false, parser_ast@zero_location(), "");
                false -> {
                    (rhs_found: boolean, rhs_loc: { file: string, line: int64, column: int64, offset: int64 }, rhs_name: string) <- expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), parser_ast@dummy_expr());
                    case rhs_found of {
                        true -> (true, rhs_loc, rhs_name);
                        false -> case is_unused_scope_discard_name(parser_ast@expr_root_name(expr)) of {
                            true -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), extra_scope_result);
                            false -> case expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), parser_ast@expr_root_name(expr)) or expr_contains_identifier_named(extra_scope_result, parser_ast@expr_root_name(expr)) of {
                                true -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), extra_scope_result);
                                false -> case expr_contains_unused_binding_exempt_expr(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr))) of {
                                    true -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), extra_scope_result);
                                    false -> (true, parser_ast@expr_root_node(expr).location, parser_ast@expr_root_name(expr))
                                }
                            }
                        }
                    }
                }
            };
            false -> case parser_ast@expr_root_kind(expr) == 10 of {
                true -> {
                    (rhs_td_found: boolean, rhs_td_loc: { file: string, line: int64, column: int64, offset: int64 }, rhs_td_name: string) <- expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), parser_ast@dummy_expr());
                    case rhs_td_found of {
                        true -> (true, rhs_td_loc, rhs_td_name);
                        false -> {
                            (unused_td: boolean, unused_td_name: string) <- tuple_bindings_find_unused(parser_ast@expr_root_node(expr).pattern_bindings, parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), extra_scope_result);
                            case unused_td of {
                                true -> case expr_contains_unused_binding_exempt_expr(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr))) of {
                                    true -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), extra_scope_result);
                                    false -> (true, parser_ast@expr_root_node(expr).location, unused_td_name)
                                };
                                false -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), extra_scope_result)
                            }
                        }
                    }
                };
                false -> case parser_ast@expr_root_kind(expr) == 11 of {
                    true -> {
                        (body_found: boolean, body_loc: { file: string, line: int64, column: int64, offset: int64 }, body_name: string) <- expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)));
                        case body_found of {
                            true -> (true, body_loc, body_name);
                            false -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), parser_ast@dummy_expr())
                        }
                    };
                    false -> {
                        (inner_found: boolean, inner_loc: { file: string, line: int64, column: int64, offset: int64 }, inner_name: string) <- expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), parser_ast@dummy_expr());
                        case inner_found of {
                            true -> (true, inner_loc, inner_name);
                            false -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), parser_ast@dummy_expr())
                        }
                    }
                }
            }
        }
    }
}



fn decl_has_unused_scope_binding(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case decl.tag == 0 of {
        true -> expr_has_unused_scope_binding(decl.body, parser_ast@dummy_expr());
        false -> (false, parser_ast@zero_location(), "")
    }
}



fn decls_has_unused_scope_binding(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> {
            (head_found: boolean, head_loc: { file: string, line: int64, column: int64, offset: int64 }, head_name: string) <- decl_has_unused_scope_binding(decls.head);
            case head_found of {
                true -> (true, head_loc, head_name);
                false -> decls_has_unused_scope_binding(decls.tail)
            }
        }
    }
}



fn validate_no_unused_scope_bindings(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: boolean, err_loc: { file: string, line: int64, column: int64, offset: int64 }, bind_name: string) <- decls_has_unused_scope_binding(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1055", err_loc, concat(concat("unused variable '", bind_name), "' in this scope; use it, pass it to a function, return it, or bind it as '_'"), "sect3");
        false -> parser_core@parse_ok(program)
    }
}



// --- E2012: tuple decomposition binding count exceeds register file capacity ---

fn count_decompose_bindings(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> int64 {
    case bindings.is_nil of {
        true -> 0;
        false -> 1 + count_decompose_bindings(bindings.tail)
    }
}



fn expr_has_too_many_decompose_bindings(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, int64) {
    case parser_ast@expr_root_kind(expr) == 10 of {
        true -> {
            n: int64 <- count_decompose_bindings(parser_ast@expr_root_node(expr).pattern_bindings);
            case n > 14 of {
                true -> (true, parser_ast@expr_root_node(expr).location, n);
                false -> {
                    (r_found: boolean, r_loc: { file: string, line: int64, column: int64, offset: int64 }, r_n: int64) <- expr_has_too_many_decompose_bindings(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)));
                    case r_found of {
                        true -> (true, r_loc, r_n);
                        false -> (false, parser_ast@zero_location(), 0)
                    }
                }
            }
        };
        false -> case expr.root < 0 of {
            true -> (false, parser_ast@zero_location(), 0);
            false -> {
                (inner_found: boolean, inner_loc: { file: string, line: int64, column: int64, offset: int64 }, inner_n: int64) <- expr_has_too_many_decompose_bindings(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)));
                case inner_found of {
                    true -> (true, inner_loc, inner_n);
                    false -> expr_has_too_many_decompose_bindings(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)))
                }
            }
        }
    }
}



fn decl_has_too_many_decompose_bindings(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, int64) {
    case decl.tag == 0 of {
        true -> expr_has_too_many_decompose_bindings(decl.body);
        false -> (false, parser_ast@zero_location(), 0)
    }
}



fn decls_has_too_many_decompose_bindings(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, int64) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location(), 0);
        false -> {
            (head_found: boolean, head_loc: { file: string, line: int64, column: int64, offset: int64 }, head_n: int64) <- decl_has_too_many_decompose_bindings(decls.head);
            case head_found of {
                true -> (true, head_loc, head_n);
                false -> decls_has_too_many_decompose_bindings(decls.tail)
            }
        }
    }
}



fn validate_max_tuple_decompose_bindings(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: boolean, err_loc: { file: string, line: int64, column: int64, offset: int64 }, n: int64) <- decls_has_too_many_decompose_bindings(program.declarations);
    case found of {
        true -> parser_core@parse_err("E2012", err_loc, concat("tuple decomposition pattern has ", concat(atom_table@int64_to_decimal_string(n), " elements; the AArch64 register file supports at most 14 simultaneous bindings (X0-X15 excluding X8, X12)")), "sect4.2");
        false -> parser_core@parse_ok(program)
    }
}


// --- Defect B7: standalone `if` (kind-994 marker set by constraint_extract_expr) ---------
fn expr_has_standalone_if(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case expr.root < 0 of {
        true -> (false, parser_ast@zero_location());
        false -> case parser_ast@expr_root_kind(expr) == 994 of {
            true -> (true, parser_ast@expr_root_node(expr).location);
            false -> case parser_ast@expr_root_kind(expr) == -1 of {
                true -> (false, parser_ast@zero_location());
                false -> case parser_ast@expr_root_kind(expr) == 12 of {
                    true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_inner(expr)) == 1 of {
                        true -> (false, parser_ast@zero_location());
                        false -> expr_has_standalone_if(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)))
                    };
                    false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_inner(expr)) == 1 of {
                        true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_right(expr)) == 1 of {
                            true -> (false, parser_ast@zero_location());
                            false -> expr_has_standalone_if(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)))
                        };
                        false -> {
                            (inner_found: boolean, inner_loc: { file: string, line: int64, column: int64, offset: int64 }) <- expr_has_standalone_if(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)));
                            case inner_found of {
                                true -> (true, inner_loc);
                                false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_right(expr)) == 1 of {
                                    true -> (false, parser_ast@zero_location());
                                    false -> expr_has_standalone_if(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn decls_has_standalone_if(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> {
            (found: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }) <- case decl_skips_body_walk(decls.head.tag, decls.head.body.root) == 1 of {
                true -> (false, parser_ast@zero_location());
                false -> expr_has_standalone_if(decls.head.body)
            };
            case found of {
                true -> (true, loc);
                false -> decls_has_standalone_if(decls.tail)
            }
        }
    }
}

fn validate_no_standalone_if(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: boolean, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_has_standalone_if(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1066", err_loc, "'if' is only valid as a case-arm guard; use case ... of { ... } for branching", "sect3.3.5");
        false -> parser_core@parse_ok(program)
    }
}

// --- E1071: a function literal declares its return type with `->` (spec 3.3.6) ---
// The literal's return type is never inferred. extract_lambda_expression records how it was
// written in the kind-992 holder's name: "__lambda_ret__" (`-> T`), "__lambda_ret_colon__" (the
// retired `: T` form) or "__lambda_ret_missing__". Without this check `fn() { 0 }` was lifted to
// main.__lam0 with an empty return type and surfaced as an E2003 "type mismatch: main.__lam0".
// Defect code: 0 none, 1 missing, 2 colon form.
fn lambda_return_type_defect(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (int64, { file: string, line: int64, column: int64, offset: int64 }) {
    case expr.root < 0 of {
        true -> (0, parser_ast@zero_location());
        false -> case parser_ast@expr_root_kind(expr) == -1 of {
            true -> (0, parser_ast@zero_location());
            false -> case parser_ast@expr_root_kind(expr) == 991 of {
                true -> {
                    holder: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, parser_ast@expr_root_right(expr));
                    holder_name: string <- case holder.root < 0 of { true -> ""; false -> parser_ast@expr_root_name(holder) };
                    holder_type: string <- case holder.root < 0 of { true -> ""; false -> parser_ast@expr_root_value(holder) };
                    case holder_name == "__lambda_ret_colon__" of {
                        true -> (2, parser_ast@expr_root_node(expr).location);
                        false -> case holder_name == "__lambda_ret_missing__" or length_bytes(holder_type) == 0 of {
                            true -> (1, parser_ast@expr_root_node(expr).location);
                            // A literal's body may hold another literal.
                            false -> lambda_return_type_defect(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)))
                        }
                    }
                };
                false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_inner(expr)) == 1 of {
                    true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_right(expr)) == 1 of {
                        true -> (0, parser_ast@zero_location());
                        false -> lambda_return_type_defect(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)))
                    };
                    false -> {
                        (inner_code: int64, inner_loc: { file: string, line: int64, column: int64, offset: int64 }) <- lambda_return_type_defect(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)));
                        case inner_code > 0 of {
                            true -> (inner_code, inner_loc);
                            false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_right(expr)) == 1 of {
                                true -> (0, parser_ast@zero_location());
                                false -> lambda_return_type_defect(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)))
                            }
                        }
                    }
                }
            }
        }
    }
}

fn decls_lambda_return_type_defect(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (int64, { file: string, line: int64, column: int64, offset: int64 }) {
    case decls.is_nil of {
        true -> (0, parser_ast@zero_location());
        false -> {
            (code: int64, loc: { file: string, line: int64, column: int64, offset: int64 }) <- case decl_skips_body_walk(decls.head.tag, decls.head.body.root) == 1 of {
                true -> (0, parser_ast@zero_location());
                false -> lambda_return_type_defect(decls.head.body)
            };
            case code > 0 of {
                true -> (code, loc);
                false -> decls_lambda_return_type_defect(decls.tail)
            }
        }
    }
}

fn validate_function_literal_return_types(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (code: int64, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_lambda_return_type_defect(program.declarations);
    case code of {
        1 -> parser_core@parse_err("E1071", err_loc, "function literal needs a return type: write fn(...) -> T { ... }", "sect3.3.6");
        2 -> parser_core@parse_err("E1071", err_loc, "function literal declares its return type with '->', not ':': write fn(...) -> T { ... }", "sect3.3.6");
        _: int64 -> parser_core@parse_ok(program)
    }
}

// --- Defect A2 (interim): a lambda that captures locals cannot be returned ---------------
// Lambdas are lifted to top-level functions whose captured locals become trailing parameters;
// there is no closure environment, so a RETURNED capturing lambda loses its captures.
fn strip_spaces_ce(t: string, i: int64, acc: string) -> string {
    case i >= length_bytes(t) of {
        true -> acc;
        false -> {
            c: string <- substring(t, i, i + 1);
            case c == " " of {
                true -> strip_spaces_ce(t, i + 1, acc);
                false -> strip_spaces_ce(t, i + 1, concat(acc, c))
            }
        }
    }
}

fn fn_type_arity_scan(t: string, i: int64, depth: int64, commas: int64, start: int64) -> int64 {
    case i >= length_bytes(t) of {
        true -> 0 - 1;
        false -> {
            c: string <- substring(t, i, i + 1);
            case c == ")" and depth == 0 of {
                true -> case i == start of { true -> 0; false -> commas + 1 };
                false -> case c == "(" or c == "[" or c == "{" of {
                    true -> fn_type_arity_scan(t, i + 1, depth + 1, commas, start);
                    false -> case c == ")" or c == "]" or c == "}" of {
                        true -> fn_type_arity_scan(t, i + 1, depth - 1, commas, start);
                        false -> case c == "," and depth == 0 of {
                            true -> fn_type_arity_scan(t, i + 1, depth, commas + 1, start);
                            false -> fn_type_arity_scan(t, i + 1, depth, commas, start)
                        }
                    }
                }
            }
        }
    }
}

fn fn_type_arity_text(t0: string) -> int64 {
    t: string <- strip_spaces_ce(t0, 0, "");
    open_i: int64 <- case length_bytes(t) >= 3 and substring(t, 0, 3) == "fn(" of { true -> 2; false -> case length_bytes(t) >= 1 and substring(t, 0, 1) == "(" of { true -> 0; false -> 0 - 1 } };
    case open_i < 0 of {
        true -> 0 - 1;
        false -> fn_type_arity_scan(t, open_i + 1, 0, 0, open_i + 1)
    }
}

fn name_has_lam_sub_at(m: string, i: int64) -> boolean {
    case i + 6 > length_bytes(m) of {
        true -> false;
        false -> case substring(m, i, i + 6) == ".__lam" of {
            true -> true;
            false -> name_has_lam_sub_at(m, i + 1)
        }
    }
}

// The body's tail expression: follows lets (6), decompositions (10) and parentheses (2).
fn body_tail_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case expr.root < 0 of {
        true -> expr;
        false -> case parser_ast@expr_root_kind(expr) == 6 or parser_ast@expr_root_kind(expr) == 10 of {
            true -> body_tail_expr(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)));
            false -> case parser_ast@expr_root_kind(expr) == 2 of {
                true -> body_tail_expr(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)));
                false -> expr
            }
        }
    }
}

// The lifted-lambda identifier a let chain binds to `name`, or "" when none does.
fn let_bound_lifted_name(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, name: string) -> string {
    case expr.root < 0 of {
        true -> "";
        false -> case parser_ast@expr_root_kind(expr) == 6 of {
            true -> {
                rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr));
                case parser_ast@expr_root_name(expr) == name and rhs.root >= 0 and parser_ast@expr_root_kind(rhs) == 1 and name_has_lam_sub_at(parser_ast@expr_root_name(rhs), 0) of {
                    true -> parser_ast@expr_root_name(rhs);
                    false -> let_bound_lifted_name(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), name)
                }
            };
            false -> case parser_ast@expr_root_kind(expr) == 10 of {
                true -> let_bound_lifted_name(parser_ast@expr_at(expr, parser_ast@expr_root_right(expr)), name);
                false -> case parser_ast@expr_root_kind(expr) == 2 of {
                    true -> let_bound_lifted_name(parser_ast@expr_at(expr, parser_ast@expr_root_inner(expr)), name);
                    false -> ""
                }
            }
        }
    }
}

fn list_param_len_ce(ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: int64) -> int64 {
    case ps.is_nil of {
        true -> acc;
        false -> list_param_len_ce(ps.tail, acc + 1)
    }
}

fn find_decl_param_count(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], name: string) -> int64 {
    case decls.is_nil of {
        true -> 0 - 1;
        false -> case decls.head.name == name of {
            true -> list_param_len_ce(decls.head.parameters, 0);
            false -> find_decl_param_count(decls.tail, name)
        }
    }
}

fn decls_has_escaping_capturing_lambda(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], all: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> {
            ret_arity: int64 <- case decls.head.tag == 0 and decls.head.body.root >= 0 of { true -> fn_type_arity_text(decls.head.return_type_name); false -> 0 - 1 };
            tail: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- case ret_arity >= 0 of { true -> body_tail_expr(decls.head.body); false -> parser_ast@dummy_expr() };
            tail_is_ident: boolean <- ret_arity >= 0 and tail.root >= 0 and parser_ast@expr_root_kind(tail) == 1;
            lifted_nm: string <- case tail_is_ident of {
                true -> case name_has_lam_sub_at(parser_ast@expr_root_name(tail), 0) of {
                    true -> parser_ast@expr_root_name(tail);
                    false -> let_bound_lifted_name(decls.head.body, parser_ast@expr_root_name(tail))
                };
                false -> ""
            };
            hit: boolean <- case length_bytes(lifted_nm) > 0 of {
                true -> find_decl_param_count(all, lifted_nm) > ret_arity;
                false -> false
            };
            case hit of {
                true -> (true, parser_ast@expr_root_node(tail).location);
                false -> decls_has_escaping_capturing_lambda(decls.tail, all)
            }
        }
    }
}

fn validate_no_escaping_capturing_lambda(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: boolean, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_has_escaping_capturing_lambda(program.declarations, program.declarations);
    case found of {
        true -> parser_core@parse_err("E1067", err_loc, "a function literal that captures local bindings cannot be returned from the function that owns them (closure environments are not supported yet); pass the values as parameters instead", "sect3.4");
        false -> parser_core@parse_ok(program)
    }
}
