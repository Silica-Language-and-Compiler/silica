// Parser capability: compiler/design_documents/recursion_implementation.md (all phases 1–6).
// Surface syntax for general recursion is already parsed by fn_decl, case, calls, return, rec, etc.
// This module wires the design doc phases into the parser build: same constraint contract as other
// capabilities, plus query helpers for tooling (phase ↔ token kind) via lexer_recursion_phases.

use lexer_token_kind;
use lexer_recursion_phases;
use constraint_core;

export constraints/0;
export initial_roles/1;
export recursion_jsonld_phase1_token_kind/1;
export recursion_jsonld_phase2_token_kind/1;
export recursion_jsonld_phase3_token_kind/1;
export recursion_jsonld_phase4_token_kind/1;
export recursion_jsonld_phase5_token_kind/1;
export recursion_jsonld_phase6_token_kind/1;
export recursion_jsonld_any_phase_token_kind/1;

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    constraint_core@empty_list_constraint()
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
    constraint_core@empty_list_int()
}

fn recursion_jsonld_phase1_token_kind(k: int64) -> boolean {
        lexer_recursion_phases@token_kind_recursion_phase1_core_representation(k)
}

fn recursion_jsonld_phase2_token_kind(k: int64) -> boolean {
        lexer_recursion_phases@token_kind_recursion_phase2_lowering_execution(k)
}

fn recursion_jsonld_phase3_token_kind(k: int64) -> boolean {
        lexer_recursion_phases@token_kind_recursion_phase3_preemption_fairness(k)
}

fn recursion_jsonld_phase4_token_kind(k: int64) -> boolean {
        lexer_recursion_phases@token_kind_recursion_phase4_debugging_observability(k)
}

fn recursion_jsonld_phase5_token_kind(k: int64) -> boolean {
        lexer_recursion_phases@token_kind_recursion_phase5_optimizations(k)
}

fn recursion_jsonld_phase6_token_kind(k: int64) -> boolean {
        lexer_recursion_phases@token_kind_recursion_phase6_fallbacks(k)
}

fn recursion_jsonld_any_phase_token_kind(k: int64) -> boolean {
        lexer_recursion_phases@token_kind_any_recursion_implementation_phase(k)
}
