// Capability: ident: type <- expr (binding with atom type and atom/call RHS)
// Example: worked:atom <- :ok  or  result:atom <- print_atom(x)

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_list;

export constraints/0;
export initial_roles/1;
export role_tuple_type_lparen/0;

// Role codes for binding (40-46). Shared: left_brace 7, right_brace 8 (fn_decl), role_stmt_sep 55 (tuple_decompose).
// Tuple type: role_tuple_type_lparen 44, role_tuple_type_rparen 45.
// Memory region: role_memory_type_start 60, role_atomic_prefix 61 (from capability_memory_region).
// Other capability roles: atom_literal 17 (expr_atom), call_name 14, role_operand 12 (expr_int64_ops).
fn role_bind_ident() -> int64 { 40 }
fn role_memory_type_start() -> int64 { 60 }
fn role_atomic_prefix() -> int64 { 61 }
fn role_stmt_sep() -> int64 { 55 }
fn role_bind_colon() -> int64 { 41 }
fn role_bind_type() -> int64 { 42 }
fn role_bind_arrow() -> int64 { 43 }
fn role_tuple_type_lparen() -> int64 { 44 }
fn role_tuple_type_rparen() -> int64 { 45 }
fn role_tuple_type_comma() -> int64 { 46 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_atom_literal() -> int64 { 17 }
fn role_call_name() -> int64 { 14 }
fn role_operand() -> int64 { 12 }
fn role_atom_union_bar() -> int64 { 29 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // left_brace can be followed by bind_ident (body can start with binding)
    c1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_left_brace(), next_token_roles: single_role(role_bind_ident()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 40 };
    // bind_ident: after left_brace or stmt_sep, before colon
    c2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_bind_ident(), next_token_roles: single_role(role_bind_colon()), prev_token_roles: two_roles(role_left_brace(), role_stmt_sep()), constraint_id: 41 };
    // bind_colon: after ident, before type (simple), tuple type (, memory region type (ref/region/buf/atomic), or inline record type {
    c3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_bind_colon(), next_token_roles: six_roles(role_bind_type(), role_tuple_type_lparen(), role_memory_type_start(), role_atomic_prefix(), capability_list@role_list_type_kw(), role_left_brace()), prev_token_roles: single_role(role_bind_ident()), constraint_id: 42 };
    // bind_type: after colon (simple) or tuple elem, before <- or comma or )
    c4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_bind_type(), next_token_roles: four_roles(role_bind_arrow(), role_tuple_type_rparen(), role_tuple_type_comma(), role_atom_union_bar()), prev_token_roles: five_roles(role_bind_colon(), role_tuple_type_lparen(), role_tuple_type_comma(), role_memory_type_start(), role_atom_union_bar()), constraint_id: 43 };
    // bind_arrow: after type or tuple ) or right_brace (inline record type), before RHS (including struct literal {)
    c5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_bind_arrow(), next_token_roles: five_roles(role_atom_literal(), role_call_name(), role_operand(), capability_list@role_list_lit_lbracket(), role_left_brace()), prev_token_roles: four_roles(role_bind_type(), role_tuple_type_rparen(), role_memory_type_start(), role_right_brace()), constraint_id: 44 };
    // atom_literal can follow bind_arrow (e.g. worked:atom <- :ok)
    c6: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_atom_literal(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: single_role(role_bind_arrow()), constraint_id: 45 };
    // tuple_type_lparen: ( starts tuple type or parametrized type (ref/region/buf), next is first type
    // Opening `(` of tuple type: after bind `:`, nested `(`, memory/atomic, or tuple-decompose `:` after pattern `)` (role_td_colon 56).
    c7: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_tuple_type_lparen(), next_token_roles: three_roles(role_bind_type(), role_tuple_type_lparen(), role_memory_type_start()), prev_token_roles: five_roles(role_bind_colon(), role_tuple_type_lparen(), role_memory_type_start(), role_atomic_prefix(), 56), constraint_id: 46 };
    // tuple_type_comma: comma in tuple type, next is type; prev can be type or ) for nested ((T1,T2),T3) or ref(R, Space, T)
    c8: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_tuple_type_comma(), next_token_roles: three_roles(role_bind_type(), role_tuple_type_lparen(), role_memory_type_start()), prev_token_roles: two_roles(role_bind_type(), role_tuple_type_rparen()), constraint_id: 47 };
    // tuple_type_rparen: ) ends tuple type or parametrized type, next is <- or comma or ) for nested
    // After tuple-type `)`, next may be `<-` for binding (bind_arrow) or tuple decompose (td_arrow 54).
    c9: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_tuple_type_rparen(), next_token_roles: four_roles(role_bind_arrow(), 54, role_tuple_type_comma(), role_tuple_type_rparen()), prev_token_roles: three_roles(role_bind_type(), role_tuple_type_rparen(), role_memory_type_start()), constraint_id: 48 };
    // role_operand (shared) can follow bind_arrow: allows <- ( tuple literal RHS
    c10: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_operand(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: single_role(role_bind_arrow()), constraint_id: 49 };
    c11: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- { trigger_role: role_atom_union_bar(), next_token_roles: single_role(role_bind_type()), prev_token_roles: single_role(role_bind_type()), constraint_id: 50 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c2, constraint_core@cons_constraint(c3, constraint_core@cons_constraint(c4, constraint_core@cons_constraint(c5, constraint_core@cons_constraint(c6, constraint_core@cons_constraint(c7, constraint_core@cons_constraint(c8, constraint_core@cons_constraint(c9, constraint_core@cons_constraint(c10, constraint_core@cons_constraint(c11, constraint_core@empty_list_constraint())))))))))))
}

fn is_type_keyword(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_int8_keyword() or token_kind == lexer_token_kind@token_kind_int16_keyword() or token_kind == lexer_token_kind@token_kind_int32_keyword() or token_kind == lexer_token_kind@token_kind_int64_keyword() or token_kind == lexer_token_kind@token_kind_uint8_keyword() or token_kind == lexer_token_kind@token_kind_uint16_keyword() or token_kind == lexer_token_kind@token_kind_uint32_keyword() or token_kind == lexer_token_kind@token_kind_uint64_keyword() or token_kind == lexer_token_kind@token_kind_float16_keyword() or token_kind == lexer_token_kind@token_kind_float32_keyword() or token_kind == lexer_token_kind@token_kind_float64_keyword() or token_kind == lexer_token_kind@token_kind_bool_keyword() or token_kind == lexer_token_kind@token_kind_char_keyword() or token_kind == lexer_token_kind@token_kind_string_keyword() or token_kind == lexer_token_kind@token_kind_bytes_keyword() or token_kind == lexer_token_kind@token_kind_unit_keyword() or token_kind == lexer_token_kind@token_kind_atom_keyword() or token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword() or token_kind == lexer_token_kind@token_kind_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_dangerous_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_device_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_timer_ref_keyword() or token_kind == lexer_token_kind@token_kind_supervisor_ref_keyword() or token_kind == lexer_token_kind@token_kind_failure_reason_keyword()
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
        true -> two_roles(role_bind_ident(), role_bind_type());
        false -> case token_kind == lexer_token_kind@token_kind_colon() of {
            true -> single_role(role_bind_colon());
            false -> case is_type_keyword(token_kind) of {
                true -> single_role(role_bind_type());
                false -> case token_kind == lexer_token_kind@token_kind_atom_literal() of {
                    true -> two_roles(role_atom_literal(), role_bind_type());
                    false -> case token_kind == lexer_token_kind@token_kind_unknown_char() of {
                        true -> single_role(role_atom_union_bar());
                        false -> case token_kind == lexer_token_kind@token_kind_left_arrow() of {
                            true -> single_role(role_bind_arrow());
                            false -> case token_kind == lexer_token_kind@token_kind_left_paren() of {
                                true -> single_role(role_tuple_type_lparen());
                                false -> case token_kind == lexer_token_kind@token_kind_comma() of {
                                    true -> single_role(role_tuple_type_comma());
                                    false -> case token_kind == lexer_token_kind@token_kind_right_paren() of {
                                        true -> single_role(role_tuple_type_rparen());
                                        false -> case token_kind == lexer_token_kind@token_kind_left_brace() of {
                                            true -> single_role(role_left_brace());
                                            false -> case token_kind == lexer_token_kind@token_kind_right_brace() of {
                                                true -> single_role(role_right_brace());
                                                false -> constraint_core@empty_list_int()
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
