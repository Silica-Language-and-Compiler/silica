// Capability: fn name ( ) -> type { body }
// Function declaration with empty params, return type, braces

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_tuple_decompose;
use capability_case;
use capability_list;
use capability_trait;

export constraints/0;
export initial_roles/1;
export role_fn_keyword/0;
export role_fn_name/0;
export role_proc_keyword/0;
export role_left_bracket/0;
export role_right_bracket/0;
export role_effect_name/0;
export role_effect_param_rparen/0;

// Role codes for fn_decl (parser design §6)
// 1 fn_keyword, 2 fn_name, 3 left_paren, 4 right_paren, 5 right_arrow
// 6 type_name, 7 left_brace, 8 right_brace, 9 body_expr (shared with expr_literal)
// 17 proc_keyword, 18 left_bracket, 19 effect_name, 20 right_bracket, 21 effect_comma
// 22 effect_param_lparen, 23 effect_param_rparen, 24 effect_param_name
// 25 param_name, 26 param_colon, 27 param_type, 28 param_comma (user-defined fn params)

fn role_fn_keyword() -> int64 { 1 }
fn role_fn_name() -> int64 { 2 }
fn role_left_paren() -> int64 { 3 }
fn role_right_paren() -> int64 { 4 }
fn role_right_arrow() -> int64 { 5 }
fn role_type_name() -> int64 { 6 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_body_expr() -> int64 { 9 }
fn role_proc_keyword() -> int64 { 17 }
fn role_left_bracket() -> int64 { 18 }
fn role_effect_name() -> int64 { 19 }
fn role_right_bracket() -> int64 { 20 }
fn role_effect_comma() -> int64 { 21 }
fn role_effect_param_lparen() -> int64 { 22 }
fn role_effect_param_rparen() -> int64 { 23 }
fn role_effect_param_name() -> int64 { 24 }
fn role_tuple_type_lparen() -> int64 { 44 }
fn role_param_name() -> int64 { 25 }
fn role_param_colon() -> int64 { 26 }
fn role_param_type() -> int64 { 27 }
fn role_param_comma() -> int64 { 28 }
fn role_atom_union_bar() -> int64 { 29 }
fn role_stmt_sep() -> int64 { 55 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn no_prev() -> List[int64, mem(normal)] {
    constraint_core@empty_list_int()
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    c1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_fn_keyword(), next_token_roles: single_role(role_fn_name()), prev_token_roles: no_prev(), constraint_id: 1 };
    c2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_fn_name(), next_token_roles: single_role(role_left_paren()), prev_token_roles: single_role(role_fn_keyword()), constraint_id: 2 };
    c3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_left_paren(), next_token_roles: three_roles(role_right_paren(), role_param_name(), capability_tuple_decompose@role_td_lparen()), prev_token_roles: single_role(role_fn_name()), constraint_id: 3 };
    c4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_right_paren(), next_token_roles: single_role(role_right_arrow()), prev_token_roles: three_roles(role_left_paren(), role_param_type(), capability_tuple_decompose@role_td_rparen()), constraint_id: 4 };
    c5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_right_arrow(), next_token_roles: two_roles(role_type_name(), capability_list@role_list_type_kw()), prev_token_roles: single_role(role_right_paren()), constraint_id: 5 };
    // proc[...] only allowed on sequence clauses (spec §9.3.1); reject proc after return type
    // Required trait methods end with `-> type ;` instead of `{` (silica-specification §3.4.8).
    c6: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_type_name(), next_token_roles: four_roles(role_left_brace(), role_tuple_type_lparen(), role_stmt_sep(), role_atom_union_bar()), prev_token_roles: two_roles(role_right_arrow(), role_atom_union_bar()), constraint_id: 6 };
    c7: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_left_brace(), next_token_roles: three_roles(role_body_expr(), role_right_brace(), capability_case@role_case_keyword()), prev_token_roles: three_roles(role_type_name(), role_right_bracket(), capability_list@role_list_type_rbracket()), constraint_id: 7 };
    c8: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_body_expr(), next_token_roles: single_role(role_right_brace()), prev_token_roles: single_role(role_left_brace()), constraint_id: 8 };
    c9: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_right_brace(), next_token_roles: no_prev(), prev_token_roles: two_roles(role_body_expr(), role_left_brace()), constraint_id: 9 };
    c10: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_proc_keyword(), next_token_roles: single_role(role_left_bracket()), prev_token_roles: single_role(role_type_name()), constraint_id: 17 };
    c11: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_left_bracket(), next_token_roles: single_role(role_effect_name()), prev_token_roles: single_role(role_proc_keyword()), constraint_id: 18 };
    c12: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_effect_name(), next_token_roles: three_roles(role_right_bracket(), role_effect_comma(), role_effect_param_lparen()), prev_token_roles: two_roles(role_left_bracket(), role_effect_comma()), constraint_id: 19 };
    c13: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_right_bracket(), next_token_roles: single_role(role_left_brace()), prev_token_roles: two_roles(role_effect_name(), role_effect_param_rparen()), constraint_id: 20 };
    c14: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_effect_comma(), next_token_roles: single_role(role_effect_name()), prev_token_roles: two_roles(role_effect_name(), role_effect_param_rparen()), constraint_id: 21 };
    c15: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_effect_param_lparen(), next_token_roles: single_role(role_effect_param_name()), prev_token_roles: single_role(role_effect_name()), constraint_id: 22 };
    c16: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_effect_param_name(), next_token_roles: single_role(role_effect_param_rparen()), prev_token_roles: single_role(role_effect_param_lparen()), constraint_id: 23 };
    c17: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_effect_param_rparen(), next_token_roles: two_roles(role_right_bracket(), role_effect_comma()), prev_token_roles: single_role(role_effect_param_name()), constraint_id: 24 };
    c18: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_param_name(), next_token_roles: single_role(role_param_colon()), prev_token_roles: two_roles(role_left_paren(), role_param_comma()), constraint_id: 25 };
    c19: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_param_colon(), next_token_roles: two_roles(role_param_type(), capability_list@role_list_type_kw()), prev_token_roles: single_role(role_param_name()), constraint_id: 26 };
    c20: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_param_type(), next_token_roles: three_roles(role_right_paren(), role_param_comma(), role_atom_union_bar()), prev_token_roles: two_roles(role_param_colon(), role_atom_union_bar()), constraint_id: 27 };
    c21: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_param_comma(), next_token_roles: single_role(role_param_name()), prev_token_roles: single_role(role_param_type()), constraint_id: 28 };
    c22: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_atom_union_bar(), next_token_roles: two_roles(role_type_name(), role_param_type()), prev_token_roles: two_roles(role_type_name(), role_param_type()), constraint_id: 29 };
    base: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c22, constraint_core@cons_constraint(c21, constraint_core@empty_list_constraint()));
    with_c20: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c20, base);
    with_c19: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c19, with_c20);
    with_c18: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c18, with_c19);
    with_c17: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c17, with_c18);
    with_c16: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c16, with_c17);
    with_c15: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c15, with_c16);
    with_c14: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c14, with_c15);
    with_c13: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c13, with_c14);
    with_c12: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c12, with_c13);
    with_c11: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c11, with_c12);
    with_c10: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c10, with_c11);
    with_c9: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c9, with_c10);
    with_c8: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c8, with_c9);
    with_c7: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c7, with_c8);
    with_c6: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c6, with_c7);
    with_c5: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c5, with_c6);
    with_c4: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c4, with_c5);
    with_c3: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c3, with_c4);
    with_c2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c2, with_c3);
    with_c1: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c1, with_c2);
    with_c1
}

fn is_type_keyword(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_int8_keyword() or token_kind == lexer_token_kind@token_kind_int16_keyword() or token_kind == lexer_token_kind@token_kind_int32_keyword() or token_kind == lexer_token_kind@token_kind_int64_keyword() or token_kind == lexer_token_kind@token_kind_uint8_keyword() or token_kind == lexer_token_kind@token_kind_uint16_keyword() or token_kind == lexer_token_kind@token_kind_uint32_keyword() or token_kind == lexer_token_kind@token_kind_uint64_keyword() or token_kind == lexer_token_kind@token_kind_float16_keyword() or token_kind == lexer_token_kind@token_kind_float32_keyword() or token_kind == lexer_token_kind@token_kind_float64_keyword() or token_kind == lexer_token_kind@token_kind_bool_keyword() or token_kind == lexer_token_kind@token_kind_char_keyword() or token_kind == lexer_token_kind@token_kind_string_keyword() or token_kind == lexer_token_kind@token_kind_bytes_keyword() or token_kind == lexer_token_kind@token_kind_unit_keyword() or token_kind == lexer_token_kind@token_kind_atom_keyword() or token_kind == lexer_token_kind@token_kind_ref_keyword() or token_kind == lexer_token_kind@token_kind_region_keyword() or token_kind == lexer_token_kind@token_kind_buf_keyword() or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword() or token_kind == lexer_token_kind@token_kind_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_dangerous_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_device_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_timer_ref_keyword() or token_kind == lexer_token_kind@token_kind_supervisor_ref_keyword() or token_kind == lexer_token_kind@token_kind_failure_reason_keyword()
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_fn_keyword() of {
        true -> single_role(role_fn_keyword());
        false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
            true -> constraint_core@cons_int(role_param_name(), four_roles(role_fn_name(), role_type_name(), role_effect_name(), role_effect_param_name()));
            false -> case is_type_keyword(token_kind) of {
                true -> two_roles(role_type_name(), role_param_type());
                false -> case token_kind == lexer_token_kind@token_kind_atom_literal() of {
                    true -> two_roles(role_type_name(), role_param_type());
                    false -> case token_kind == lexer_token_kind@token_kind_unknown_char() of {
                        true -> single_role(role_atom_union_bar());
                        false -> case token_kind == lexer_token_kind@token_kind_left_paren() of {
                            true -> two_roles(role_left_paren(), role_effect_param_lparen());
                            false -> case token_kind == lexer_token_kind@token_kind_right_paren() of {
                                true -> two_roles(role_right_paren(), role_effect_param_rparen());
                                false -> case token_kind == lexer_token_kind@token_kind_right_arrow() of {
                                    true -> single_role(role_right_arrow());
                                    false -> case token_kind == lexer_token_kind@token_kind_proc_keyword() of {
                                        true -> single_role(role_proc_keyword());
                                        false -> case token_kind == lexer_token_kind@token_kind_left_bracket() of {
                                            true -> single_role(role_left_bracket());
                                            false -> case token_kind == lexer_token_kind@token_kind_right_bracket() of {
                                                true -> single_role(role_right_bracket());
                                                false -> case token_kind == lexer_token_kind@token_kind_comma() of {
                                                    true -> two_roles(role_effect_comma(), role_param_comma());
                                                    false -> case token_kind == lexer_token_kind@token_kind_colon() of {
                                                        true -> single_role(role_param_colon());
                                                        false -> case token_kind == lexer_token_kind@token_kind_left_brace() of {
                                                            true -> three_roles(role_left_brace(), capability_trait@role_required_block_lbrace(), capability_trait@role_provided_block_lbrace());
                                                            false -> case token_kind == lexer_token_kind@token_kind_right_brace() of {
                                                                true -> single_role(role_right_brace());
                                                                false -> constraint_core@empty_list_int()
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
