                                    (rhs_expr2: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_rhs2: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(rhs_slots2);
                                    constraint_extract_expr_bindings@function_body_after_tuple_decompose(lparen_slot, td_result, rhs_expr2, rest_after_rhs2, tr.type_str, extract_function_body)
                                };
                                false -> {
                                    dummy3: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                    (dummy3, slots)
                                }
                            }
                        }
                    };
                    false -> {
                        dummy4: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                        (dummy4, slots)
                    }
                }
            }
        }
}



fn extract_tuple_decompose_for_sequence(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], stop_kind: int64) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence
        lparen_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.head;
        td_result: { pattern_str: string, bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_tuple_decompose_pattern_from_slots(slots);
        rest_after_rparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- td_result.rest_slots;
        rest_w: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_after_rparen);
        result: ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- case rest_w.is_nil of {
            true -> {
                dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                (dummy, slots)
            };
            false -> case rest_w.head.token.kind == lexer_token_kind@token_kind_left_arrow() of {
                true -> {
                    rhs_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- rest_w.tail;
                    (rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_rhs: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(rhs_slots);
                    extract_tuple_decompose_sequence_after_rhs(lparen_slot, td_result, rhs_expr, rest_after_rhs, stop_kind, "")
                };
                false -> case rest_w.head.token.kind == lexer_token_kind@token_kind_colon() of {
                    true -> {
                        after_colon: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_w.tail);
                        tr: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_tuple_type_from_slots(after_colon);
                        rest_after_ann: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(tr.rest_slots);
                        case rest_after_ann.is_nil of {
                            true -> {
                                dummy_c: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                (dummy_c, slots)
                            };
                            false -> case rest_after_ann.head.token.kind == lexer_token_kind@token_kind_left_arrow() of {
                                true -> {
                                    rhs_slots_c: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- rest_after_ann.tail;
                                    (rhs_expr_c: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_rhs_c: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(rhs_slots_c);
                                    extract_tuple_decompose_sequence_after_rhs(lparen_slot, td_result, rhs_expr_c, rest_after_rhs_c, stop_kind, tr.type_str)
                                };
                                false -> {
                                    dummy_d: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                    (dummy_d, slots)
                                }
                            }
                        }
                    };
                    false -> {
                        dummy_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                        (dummy_e, slots)
                    }
                }
            }
        }
    produces
        pure result
    end
}



fn extract_sequence(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    // Newline/space may appear between `sequence` and `proc` or `produces`; must trim before `proc` check,
    // otherwise we skip collecting proc[ε] and the body starts at `proc` (not a binding) → dummy sequence / MOV #0.
    after_seq: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
    case after_seq.is_nil of {
        true -> {
            dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
            (dummy, slots)
        };
        false -> {
            (declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], slots_before_produces: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- case after_seq.head.token.kind == lexer_token_kind@token_kind_proc_keyword() or after_seq.head.token.lexeme == "proc" of {
                true -> constraint_extract_params@collect_optional_proc_effects(after_seq);
                false -> (parser_ast@empty_effect_name_list(), after_seq)
            };
            case slots_before_produces.is_nil of {
                true -> {
                    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                    (dummy, slots)
                };
                false -> {
                    slots_for_sequence_body: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots_before_produces);
                    (body_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, slots_from_produces: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_sequence_body(slots_for_sequence_body, lexer_token_kind@token_kind_produces_keyword());
                    slots_trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots_from_produces);
                    // After "produces", newline may appear before "pure"; skip leading whitespace on each segment.
                    after_produces_or_start: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- case slots_trimmed.is_nil of {
                        true -> constraint_core@empty_list_slot();
                        false -> case slots_trimmed.head.token.kind == lexer_token_kind@token_kind_produces_keyword() or slots_trimmed.head.token.lexeme == "produces" of {
                            true -> constraint_extract_slots@skip_leading_whitespace_slots(slots_trimmed.tail);
                            false -> slots_trimmed
                        }
                    };
                    result_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- case after_produces_or_start.is_nil of {
                        true -> constraint_core@empty_list_slot();
                        false -> case after_produces_or_start.head.token.kind == lexer_token_kind@token_kind_pure_keyword() or after_produces_or_start.head.token.lexeme == "pure" of {
                            true -> constraint_extract_slots@skip_leading_whitespace_slots(after_produces_or_start.tail);
                            false -> constraint_core@empty_list_slot()
                        }
                    };
                    case result_slots.is_nil of {
                        true -> {
                            dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                            (dummy, slots)
                        };
                        false -> {
                            (result_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_result: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(result_slots);
                            rest_trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_after_result);
                            case rest_trimmed.is_nil of {
                                true -> {
                                    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                    (dummy, slots)
                                };
                                false -> case rest_trimmed.head.token.lexeme == ";" of {
                                    true -> {
                                        after_result_semis: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_semicolons_after_whitespace(rest_trimmed);
                                        after_result_w: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_result_semis);
                                        case after_result_w.is_nil of {
                                            true -> {
                                                dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                                (dummy, slots)
                                            };
                                            false -> case after_result_w.head.token.kind == lexer_token_kind@token_kind_end_keyword() or after_result_w.head.token.lexeme == "end" of {
                                                true -> {
                                                    end_kw_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- after_result_w.head;
                                                    result_marked: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- constraint_extract_params@trailing_semicolon_marker(rest_trimmed.head.token.location, result_expr);
                                                    seq_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(11, "", "", end_kw_slot.token.location, body_expr, result_marked, parser_ast@nil_tuple_decompose_bindings(), declared_effects);
                                                    (seq_expr, after_result_w.tail)
                                                };
                                                false -> {
                                                    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                                    (dummy, slots)
                                                }
                                            }
                                        }
                                    };
                                    false -> case rest_trimmed.head.token.kind == lexer_token_kind@token_kind_end_keyword() or rest_trimmed.head.token.lexeme == "end" of {
                                        true -> {
                                            end_kw_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- rest_trimmed.head;
                                            seq_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(11, "", "", end_kw_slot.token.location, body_expr, result_expr, parser_ast@nil_tuple_decompose_bindings(), declared_effects);
                                            (seq_expr, rest_trimmed.tail)
                                        };
                                        false -> {
                                            dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                            (dummy, slots)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



// Parse `{` ... `}` as a single expression block (function-body shape). Used for if/else arms.
// Returns (rest after closing `}`, body); tuple order matches bootstrap codegen for (List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }).
fn extract_braced_expr_block(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) {
    dummy_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    case constraint_extract_slots@slots_is_nil(slots) of {
        true -> (slots, dummy_e);
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
            true -> case constraint_extract_params@is_struct_literal_lbrace_fallback(slots) of {
                true -> {
                    (struct_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, after_brace: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_expr_bindings@extract_struct_literal(slots, extract_body);
                    (after_brace, struct_e)
                };
                false -> {
                    inner_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
                    (body_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_function_body(inner_slots);
                    case constraint_extract_slots@slots_is_nil(rest_after) of {
                        true -> (slots, dummy_e);
                        false -> case rest_after.head.token.kind == lexer_token_kind@token_kind_right_brace() or rest_after.head.token.lexeme == "}" or constraint_core@slot_role(rest_after.head) == constraint_extract_slots@role_right_brace() of {
                            true -> (rest_after.tail, body_expr);
                            false -> (slots, dummy_e)
                        }
                    }
                }
            };
            false -> (slots, dummy_e)
        }
    }
}



// `if` cond `{` then `}` [`else` `{` else `}`] — distinct from case-branch guards (`pattern if guard ->`).
fn extract_if_expression(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    if_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
    after_if: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    (cond_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, after_cond: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_expr_with_precedence(after_if, 0);
    (after_then: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], then_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- extract_braced_expr_block(after_cond);
    case constraint_extract_slots@slots_is_nil(after_then) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case constraint_extract_slots@slots_head(after_then).token.lexeme == "else" of {
            true -> {
                after_else_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(after_then);
                (after_else: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], else_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- extract_braced_expr_block(after_else_kw);
                tuple_exprs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(9, "", "", if_loc, then_expr, else_expr, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                if_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(19, "", "", if_loc, cond_expr, tuple_exprs, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                (if_expr, after_else)
            };
            false -> {
                dummy_else: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                tuple_exprs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(9, "", "", if_loc, then_expr, dummy_else, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                if_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(19, "", "", if_loc, cond_expr, tuple_exprs, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                (if_expr, after_then)
            }
        }
    }
}



fn extract_body(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> {
            dummy_nil: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
            (dummy_nil, trimmed)
        };
        false -> {
            first: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- trimmed.head;
            case first.token.kind == lexer_token_kind@token_kind_produces_keyword() or first.token.lexeme == "produces" of {
                true -> {
                    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                    (dummy, trimmed)
                };
                // A statement terminator is not an expression start: `name: T <- ;` has no right-hand
                // side, and the binding site reports it (E1040) from the untouched slots. Building an
                // operand node out of the `;` (the generic fallthrough) swallowed it, so a binding with
                // no value compiled whenever nothing but `produces` or `}` followed.
                false -> case first.token.lexeme == ";" of {
                    true -> {
                        dummy_semi: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                        (dummy_semi, trimmed)
                    };
                false -> case first.token.kind == lexer_token_kind@token_kind_right_paren() of {
                    true -> {
                        dummy_rp: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                        (dummy_rp, trimmed)
                    };
                    false -> case first.token.kind == lexer_token_kind@token_kind_sequence_keyword() or first.token.lexeme == "sequence" of {
                        true -> extract_sequence(trimmed);
                        false -> case first.token.kind == lexer_token_kind@token_kind_if_keyword() or first.token.lexeme == "if" of {
                            true -> {
                                // Defect B7: `if` is only a case-arm guard (spec 3.3.5). Parse it for recovery, then
                                // wrap it in a kind-994 marker that constraint_extract_validate reports as E1066.
                                (if_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, if_rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_if_expression(trimmed);
                                (parser_ast@make_expr(994, "E1066", "", parser_ast@expr_root_node(if_e).location, if_e, parser_ast@dummy_expr(), parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list()), if_rest)
                            };
                            false -> case first.token.kind == lexer_token_kind@token_kind_left_bracket() and (constraint_core@slot_role(first) == capability_list@role_list_lit_lbracket() or constraint_extract_slots@is_list_literal_lbracket_fallback(trimmed)) of {
                                true -> constraint_extract_expr_lits@extract_list_literal(trimmed, extract_body);
                                // Prefer lexeme "{" as well as lexer_token_kind@token_kind_left_brace(): TokenKinds field-access
                                // mismatches can make kind comparisons fail while lexeme stays reliable.
                                // Bare record `{ field: expr, ... }` must win as the sole/first function-body
                                // expression (otherwise fields are misread as the next statement → E1040).
                                // Non-literal `{ ... }` remains a statement block (selfhost dialect).
                                false -> case first.token.kind == lexer_token_kind@token_kind_left_brace() or first.token.lexeme == "{" of {
                                    true -> case constraint_extract_params@is_struct_literal_lbrace_fallback(trimmed) of {
                                        true -> constraint_extract_expr_bindings@extract_struct_literal(trimmed, extract_body);
                                        false -> {
                                            inner_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- trimmed.tail;
                                            (body_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_function_body(inner_slots);
                                            case constraint_extract_slots@slots_is_nil(rest_after) of {
                                                true -> (parser_ast@dummy_expr(), trimmed);
                                                false -> case rest_after.head.token.kind == lexer_token_kind@token_kind_right_brace() or rest_after.head.token.lexeme == "}" or constraint_core@slot_role(rest_after.head) == constraint_extract_slots@role_right_brace() of {
                                                    true -> (body_expr, rest_after.tail);
                                                    false -> (parser_ast@dummy_expr(), trimmed)
                                                }
                                            }
                                        }
                                    };
                                    false -> case lexer_token_kind@is_identifier_lexeme_token(first.token.kind) of {
                                        true -> case constraint_extract_params@is_binding_start(trimmed) of {
                                            true -> constraint_extract_expr_bindings@extract_binding(trimmed, extract_body, extract_function_body);
                                            false -> case parser_tuples@binding_starts_paren_tuple_type_after_colon(trimmed) of {
                                                true -> constraint_extract_expr_bindings@extract_binding(trimmed, extract_body, extract_function_body);
                                                false -> extract_expr_with_precedence(trimmed, 0)
                                            }
                                        };
                                        false -> case first.token.kind == lexer_token_kind@token_kind_left_paren() of {
                                            true -> {
                                                (td_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, td_rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_tuple_decompose(trimmed);
                                                case parser_ast@expr_root_kind(td_expr) == 10 of {
                                                    true -> (td_expr, td_rest);
                                                    false -> extract_expr_with_precedence(trimmed, 0)
                                                }
                                            };
                                            false -> extract_expr_with_precedence(trimmed, 0)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
        }
    }
}



// `List[ { stmts; result }, mem(R) ]` → sequence proc[mem(R)] named `__list_typed_block__` (E3001/E3010).
fn slots_start_list_value_block(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_list_keyword() of {
            true -> {
                after_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                case after_kw.is_nil of {
                    true -> false;
                    false -> case after_kw.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                        true -> {
                            after_lbr: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_kw.tail);
                            case after_lbr.is_nil of {
                                true -> false;
                                false -> case after_lbr.head.token.kind == lexer_token_kind@token_kind_left_brace() or after_lbr.head.token.lexeme == "{" of {
                                    true -> case constraint_extract_params@is_struct_literal_lbrace_fallback(after_lbr) of {
                                        true -> false;
                                        false -> true
                                    };
                                    false -> false
                                }
                            }
                        };
                        false -> false
                    }
                }
            };
            false -> false
        }
    }
}

// `string { stmts; result }` (and other `Type { ... }` value blocks). Without this, the
// type keyword is the whole primary and `{ ... }` is left unconsumed (dummy / placeholder `"0"`).
fn slots_start_typed_value_block(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> case constraint_extract_slots@is_type_keyword(slots.head.token.kind) or lexer_token_kind@is_identifier_lexeme_token(slots.head.token.kind) of {
            true -> {
                after_ty: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                case after_ty.is_nil of {
                    true -> false;
                    false -> case after_ty.head.token.kind == lexer_token_kind@token_kind_left_brace() or after_ty.head.token.lexeme == "{" of {
                        true -> case constraint_extract_params@is_struct_literal_lbrace_fallback(after_ty) of {
                            true -> false;
                            false -> true
                        };
                        false -> false
                    }
                }
            };
            false -> false
        }
    }
}

fn extract_case_rhs_primary_nonempty(trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    first: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- trimmed.head;
    rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- trimmed.tail;
    first_kind: int64 <- first.token.kind;
    case slots_start_list_value_block(trimmed) of {
        true -> constraint_extract_expr_lits@extract_list_value_block(trimmed, extract_function_body);
        false -> case slots_start_typed_value_block(trimmed) of {
        true -> constraint_extract_expr_lits@extract_typed_value_block(trimmed, extract_function_body);
        false -> case constraint_core@slot_role(first) == capability_case@role_case_rhs_unary_minus() of {
        true -> {
            (operand: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_with_precedence(rest, 3);
            dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
            unary_minus: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(12, "", "", first.token.location, operand, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
            (unary_minus, rest_after)
        };
        false -> case first_kind == lexer_token_kind@token_kind_bnot_keyword() or first_kind == lexer_token_kind@token_kind_not_keyword() of {
            true -> {
                (operand: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_bnot: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_with_precedence(rest, 7);
                dummy_bnot: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                bnot_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, "", unary_prefix_keyword_name(first_kind), first.token.location, operand, dummy_bnot, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                (bnot_expr, rest_after_bnot)
            };
            false -> case constraint_core@slot_role(first) == capability_case@role_case_keyword() or first_kind == lexer_token_kind@token_kind_case_keyword() of {
            true -> extract_case_expression(trimmed);
            // A function literal is an arm value like anywhere else (extract_primary's test): only
            // a bare `fn(T) -> U` with no body is the opaque function-type expression.
            false -> case parser_tuples@slots_start_fn_type(trimmed) of {
                true -> case constraint_extract_params@lambda_introduces_body_after_sig(trimmed) of {
                    true -> extract_lambda_expression(trimmed);
                    false -> constraint_extract_params@expr_fn_type_opaque_from_slots(trimmed)
                };
                false -> case first_kind == lexer_token_kind@token_kind_left_brace() or first.token.lexeme == "{" or constraint_core@slot_role(first) == capability_case@role_case_branch_lbrace() of {
            true -> case constraint_extract_params@is_struct_literal_lbrace_fallback(trimmed) of {
                true -> constraint_extract_expr_bindings@extract_struct_literal(trimmed, extract_body);
                false -> {
                    inner_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- trimmed.tail;
                    (body_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_function_body(inner_slots);
                    case rest_after.is_nil of {
                        true -> (parser_ast@dummy_expr(), trimmed);
                        false -> case rest_after.head.token.kind == lexer_token_kind@token_kind_right_brace() or rest_after.head.token.lexeme == "}" or constraint_core@slot_role(rest_after.head) == constraint_extract_slots@role_right_brace() of {
                            true -> (body_expr, rest_after.tail);
                            false -> (parser_ast@dummy_expr(), trimmed)
                        }
                    }
                }
            };
            false -> case lexer_token_kind@is_identifier_lexeme_token(first_kind) of {
                true -> case constraint_extract_slots@slots_is_nil(rest) of {
                    true -> (constraint_extract_params@extract_operand_expr(first), rest);
                    false -> case constraint_extract_slots@slots_head(rest).token.kind == lexer_token_kind@token_kind_at_sign() of {
                        true -> extract_case_rhs_module_qualified_call(trimmed);
                        false -> case constraint_extract_slots@slots_head(rest).token.kind == lexer_token_kind@token_kind_left_paren() of {
                            true -> extract_case_rhs_call(trimmed);
                            false -> case constraint_extract_slots@slots_head(rest).token.kind == lexer_token_kind@token_kind_left_bracket() of {
                                true -> case constraint_extract_params@should_extract_call_after_name(rest) of {
                                    true -> extract_case_rhs_call(trimmed);
                                    false -> (constraint_extract_params@extract_operand_expr(first), rest)
                                };
                                false -> (constraint_extract_params@extract_operand_expr(first), rest)
                            }
                        }
                    }
                };
                false -> case first_kind == lexer_token_kind@token_kind_left_bracket() and (constraint_core@slot_role(first) == capability_list@role_list_lit_lbracket() or constraint_extract_slots@is_list_literal_lbracket_fallback(trimmed)) of {
                    true -> constraint_extract_expr_lits@extract_list_literal(trimmed, extract_body);
                    false -> case first_kind == lexer_token_kind@token_kind_left_paren() of {
                        true -> constraint_extract_expr_lits@extract_parenthesized(trimmed, extract_body);
                        false -> case constraint_extract_slots@is_operand_token(first_kind) of {
                            true -> (constraint_extract_params@extract_operand_expr(first), rest);
                            false -> (constraint_extract_params@extract_body_expr(first), rest)
                        }
                    }
                }
            }
            }
            }
        }
        }
    }
    }
    }
}



fn extract_case_rhs_primary(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case constraint_extract_slots@slots_is_nil(trimmed) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> extract_case_rhs_primary_nonempty(trimmed)
    }
}



fn extract_case_rhs_binary_tail(left: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], min_prec: int64) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    case constraint_extract_slots@slots_is_nil(rest) of {
        true -> (left, rest);
        false -> case constraint_extract_slots@is_op_token(constraint_extract_slots@slots_head(rest).token.kind) or constraint_extract_slots@is_logical_op_slot(constraint_extract_slots@slots_head(rest)) of {
            false -> (left, rest);
            true -> case constraint_extract_slots@op_precedence(constraint_extract_slots@slots_head(rest).token.lexeme) < min_prec of {
                true -> (left, rest);
                false -> {
                    op_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- constraint_extract_slots@slots_head(rest);
                    rest_after_op: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(rest);
                    (right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_right: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_with_precedence(rest_after_op, constraint_extract_slots@op_precedence(op_slot.token.lexeme) + 1);
                    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                    binary: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(3, op_slot.token.lexeme, "", op_slot.token.location, left, right, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                    extract_case_rhs_binary_tail(binary, rest_after_right, min_prec)
                }
            }
        }
    }
}



fn extract_case_rhs_with_precedence(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], min_prec: int64) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence
        (primary: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_primary(slots);
        (after_post: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_post: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@extract_postfix_tail(primary, rest);
        result: ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_binary_tail(after_post, rest_post, min_prec)
    produces
        pure result
    end
}



fn extract_case_rhs_call(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    (type_args: string, at_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@extract_optional_generic_type_args_after_name(rest_after_name);
    case constraint_extract_slots@slots_is_nil(at_lparen) of {
        true -> (parser_ast@dummy_expr(), slots);
            false -> case constraint_extract_slots@slots_head(at_lparen).token.kind == lexer_token_kind@token_kind_left_paren() of {
                true -> {
                    arg_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(at_lparen);
                    arg_start: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(arg_slots);
                    call_name: string <- slots.head.token.lexeme;
                    call_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
                    case constraint_extract_slots@slots_is_nil(arg_start) of {
                        true -> (parser_ast@dummy_expr(), slots);
                        false -> case constraint_extract_slots@slots_head(arg_start).token.kind == lexer_token_kind@token_kind_right_paren() of {
                            true -> {
                                dummy_arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                dummy_rest: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                call0: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, type_args, call_name, call_loc, dummy_arg, dummy_rest, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                (call0, constraint_extract_slots@slots_tail(arg_start))
                            };
                            false -> {
                                (arg1: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_arg1: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_with_precedence(arg_start, 0);
                                (rest_after_arg1_skipped: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], _has_am_arg1: boolean) <- constraint_extract_params@skip_impl_annotation(rest_after_arg1);
                                (right_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_rparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_call_rest(rest_after_arg1_skipped, call_loc);
                                call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, type_args, call_name, call_loc, arg1, right_expr, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                (call_expr, rest_after_rparen)
                            }
                        }
                    }
                };
                false -> (parser_ast@dummy_expr(), slots)
            }
    }
}



fn extract_case_call_rest(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], call_loc: { file: string, line: int64, column: int64, offset: int64 }) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    case constraint_extract_slots@slots_is_nil(slots) of {
        true -> (dummy, slots);
        false -> case constraint_extract_slots@slots_head(slots).token.kind == lexer_token_kind@token_kind_right_paren() of {
            true -> (dummy, constraint_extract_slots@slots_tail(slots));
            false -> case constraint_extract_slots@slots_head(slots).token.kind == lexer_token_kind@token_kind_comma() of {
                true -> {
                    arg_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(slots);
                    (arg_raw: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_arg: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_with_precedence(arg_slots, 0);
                    (arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, lifted: string) <- constraint_extract_params@lift_register_marker(arg_raw);
                    (rest_skipped: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], am_after: string) <- constraint_extract_params@impl_annotation_marker(rest_after_arg);
                    am_marker: string <- call_argument_marker(arg, lifted, am_after);
                    (sub_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_final: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_call_rest(rest_skipped, call_loc);
                    pair: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, am_marker, "", call_loc, arg, sub_expr, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                    (pair, rest_final)
                };
                false -> (dummy, slots)
            }
        }
    }
}



// Spec §3.3: `expr impl ActorMessage {}` is an expression form, so it may close a case arm's value
// (`true -> 5 impl ActorMessage {};`). The arm keeps the marker in its branch node's name ("AM");
// a case used as a call/cast message operand whose every arm is marked is a marked operand
// (case_arms_all_carry_message_marker). Before this the tokens after the arm value were left
// unparsed and the whole function failed with E1069.
fn case_arm_message_marker(rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], string) {
    (after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], marker: string) <- constraint_extract_params@impl_annotation_marker(rest);
    case marker == "AM" of {
        true -> (after, "AM");
        false -> (rest, "")
    }
}

fn case_branch_list_all_marked(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr.root < 0 or parser_ast@expr_root_node(expr).kind != 17 of {
        true -> true;
        false -> {
            branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner);
            case parser_ast@expr_root_node(branch).kind == 18 and parser_ast@expr_root_node(branch).name == "AM" of {
                true -> case_branch_list_all_marked(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr));
                false -> false
            }
        }
    }
}

fn case_arms_all_carry_message_marker(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr.root >= 0 and parser_ast@expr_root_node(expr).kind == 13 of {
        false -> false;
        true -> {
            branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr);
            branches.root >= 0 and parser_ast@expr_root_node(branches).kind == 17 and case_branch_list_all_marked(branches)
        }
    }
}

// The message marker of a call argument: lifted from the argument, written after it, or carried by
// every arm of a case operand.
fn call_argument_marker(arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, lifted: string, am_after: string) -> string {
    case lifted == "" of {
        false -> lifted;
        true -> case am_after == "" and case_arms_all_carry_message_marker(arg) of {
            true -> "AM";
            false -> am_after
        }
    }
}

fn extract_one_case_branch(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    before_arrow: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@take_prefix_before_branch_arrow(slots);
    from_arrow: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@take_suffix_from_branch_arrow(slots);
    case constraint_extract_slots@slots_is_nil(from_arrow) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> {
            after_arrow: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- from_arrow.tail;
            pat_before_if: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@take_prefix_before_if_keyword(before_arrow);
            from_if: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@take_suffix_from_if_keyword(before_arrow);
            case constraint_extract_slots@slots_is_nil(from_if) of {
                true -> {
                    pat_str: string <- constraint_extract_slots@slot_lexemes_join(before_arrow);
                    dummy_g: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                    (rhs_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, after_rhs0: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_with_precedence(after_arrow, 0);
                    (after_rhs: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], arm_marker: string) <- case_arm_message_marker(after_rhs0);
                    branch_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(18, pat_str, arm_marker, slots.head.token.location, dummy_g, rhs_e, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                    after_semi: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_params@skip_case_branch_terminator(after_rhs);
                    (branch_e, after_semi)
                };
                false -> {
                    // after_if is only the guard expression (e.g. is_positive(z)); it has no `->`.
                    // The arrow before the branch RHS is the outer from_arrow (split from the full branch line).
                    after_if: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- from_if.tail;
                    pat_str: string <- constraint_extract_slots@slot_lexemes_join(pat_before_if);
                    guard_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@take_prefix_before_branch_arrow(after_if);
                    guard_rhs_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- from_arrow.tail;
                    (guard_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, _) <- extract_expr_with_precedence(guard_slots, 0);
                    (rhs_e2: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, after_rhs2_0: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_with_precedence(guard_rhs_slots, 0);
                    (after_rhs2: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], arm_marker2: string) <- case_arm_message_marker(after_rhs2_0);
                    branch_e2: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(18, pat_str, arm_marker2, slots.head.token.location, guard_e, rhs_e2, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                    after_semi2: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_params@skip_case_branch_terminator(after_rhs2);
                    (branch_e2, after_semi2)
                }
            }
        }
    }
}



fn extract_case_branches_list(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    extract_case_branches_list_impl(slots, 0)
}



// branch_depth: without this outer guard the bootstrap-built compiler overflows the stack parsing case branch lists; it also caps non-advancing extraction.
fn extract_case_branches_list_impl(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], branch_depth: int64) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case branch_depth >= 512 of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case trimmed.is_nil of {
            true -> (parser_ast@dummy_expr(), slots);
            // Match `}` by lexer kind first so we never call extract_one on a lone `}` (from_arrow empty -> infinite recursion).
            false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_brace() or trimmed.head.token.lexeme == "}" of {
                true -> (parser_ast@dummy_expr(), trimmed);
                false -> case constraint_core@slot_role(trimmed.head) == constraint_extract_slots@role_right_brace() of {
                    true -> (parser_ast@dummy_expr(), trimmed);
                    false -> {
                        (one: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, after_one: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_one_case_branch(trimmed);
                        (rest_list: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, final_rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_branches_list_impl(after_one, branch_depth + 1);
                        list_node: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(17, "", "", parser_ast@expr_root_node(one).location, one, rest_list, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                        (list_node, final_rest)
                    }
                }
            }
        }
    }
}



fn extract_case_expression(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    case_keyword_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.head;
    after_case: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    scrutinee_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@take_prefix_before_role_or_of_keyword(after_case, capability_case@role_case_of());
    at_of: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@take_suffix_from_role_or_of_keyword(after_case, capability_case@role_case_of());
    (scrutinee: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, _) <- extract_expr_with_precedence(scrutinee_slots, 0);
    case constraint_extract_slots@slots_is_nil(at_of) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> {
            after_of: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- at_of.tail;
            after_of_trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_of);
            case constraint_extract_slots@slots_is_nil(after_of_trimmed) of {
                true -> (parser_ast@dummy_expr(), slots);
                false -> case after_of_trimmed.head.token.kind == lexer_token_kind@token_kind_left_brace() or after_of_trimmed.head.token.lexeme == "{" or constraint_core@slot_role(after_of_trimmed.head) == capability_case@role_case_branch_lbrace() of {
                    true -> {
                        inner: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_of_trimmed.tail;
                        (branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, at_close: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_branches_list(inner);
                        case constraint_extract_slots@slots_is_nil(at_close) of {
                            true -> (parser_ast@dummy_expr(), slots);
                            false -> case at_close.head.token.kind == lexer_token_kind@token_kind_right_brace() or at_close.head.token.lexeme == "}" or constraint_core@slot_role(at_close.head) == constraint_extract_slots@role_right_brace() of {
                                true -> {
                                    case_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(13, "", "", case_keyword_slot.token.location, scrutinee, branches, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                    (case_e, at_close.tail)
                                };
                                false -> (parser_ast@dummy_expr(), slots)
                            }
                        }
                    };
                    false -> (parser_ast@dummy_expr(), slots)
                }
            }
        }
    }
}



// Slots after the `)` that closes the parameter list opened at depth `depth` (lexeme-balanced, like
// the other paren walkers here: kind values can collide inside nested parameter types).
fn lambda_slots_after_param_list(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.lexeme == "(" of {
            true -> lambda_slots_after_param_list(slots.tail, depth + 1);
            false -> case slots.head.token.lexeme == ")" of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> lambda_slots_after_param_list(slots.tail, depth - 1)
                };
                false -> lambda_slots_after_param_list(slots.tail, depth)
            }
        }
    }
}

// How a function literal wrote its return type: "arrow" for `fn(...) -> T {`, "colon" for the
// retired `fn(...): T {`, "missing" when `{` (or anything else) follows the parameter list.
// `after_kw` is the slot list right after the `fn` keyword.
fn lambda_return_type_form(after_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> string {
    at_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_kw);
    case at_lparen.is_nil of {
        true -> "missing";
        false -> case at_lparen.head.token.lexeme == "(" of {
            false -> "missing";
            true -> {
                after_params: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(lambda_slots_after_param_list(at_lparen.tail, 1));
                case after_params.is_nil of {
                    true -> "missing";
                    false -> case after_params.head.token.kind == lexer_token_kind@token_kind_right_arrow() or after_params.head.token.lexeme == "->" of {
                        true -> "arrow";
                        false -> case after_params.head.token.kind == lexer_token_kind@token_kind_colon() or after_params.head.token.lexeme == ":" of {
                            true -> "colon";
                            false -> "missing"
                        }
                    }
                }
            }
        }
    }
}

fn extract_lambda_expression(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    kw_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.head;
    after_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@collect_params_and_find_type_and_body(after_kw);
    (body_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_body: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_function_body(body_slots);
    bindings: List[{ name: string, path: string, type_str: string }, mem(normal)] <- constraint_extract_params@params_to_lambda_bindings(params);
    fn_ty_val: string <- constraint_extract_params@build_lambda_fn_type_value(params, ret_type);
    dumx: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    // The holder's name records how the return type was written so constraint_extract_validate can
    // reject a literal without `-> type` (E1071, spec 3.3.6): "__lambda_ret__" for `-> T`,
    // "__lambda_ret_colon__" for the old `: T` form, "__lambda_ret_missing__" when nothing precedes `{`.
    ret_form: string <- lambda_return_type_form(after_kw);
    ret_holder_name: string <- case ret_form of {
        "arrow" -> "__lambda_ret__";
        "colon" -> "__lambda_ret_colon__";
        _: string -> "__lambda_ret_missing__"
    };
    ret_holder: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(992, ret_type, ret_holder_name, ret_type_loc, dumx, dumx, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
    lam: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(991, fn_ty_val, "__lambda__", kw_slot.token.location, body_expr, ret_holder, bindings, effects);
    rest_ws: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_after_body);
    rest_after_lambda: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- case rest_ws.is_nil of {
        true -> rest_ws;
        false -> case rest_ws.head.token.kind == lexer_token_kind@token_kind_right_brace() or rest_ws.head.token.lexeme == "}" of {
            true -> rest_ws.tail;
            false -> rest_ws
        }
    };
    (lam, rest_after_lambda)
}



fn extract_primary(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    first: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.head;
    // `fn` before case probe: slot_role can mark `fn` with role_case_keyword in type/record regions,
    // which would route to extract_case_expression and misparse `(msg:...) ->` as statements (E1040).
    // Also reject `identifier`+lexeme`fn`+`(` as a call — use opaque function-type expr (kind 992).
    case slots_start_list_value_block(slots) of {
        true -> constraint_extract_expr_lits@extract_list_value_block(slots, extract_function_body);
        false -> case slots_start_typed_value_block(slots) of {
        true -> constraint_extract_expr_lits@extract_typed_value_block(slots, extract_function_body);
        false -> case parser_tuples@slots_start_fn_type(slots) of {
        true -> case constraint_extract_params@lambda_introduces_body_after_sig(slots) of {
            true -> extract_lambda_expression(slots);
            false -> constraint_extract_params@expr_fn_type_opaque_from_slots(slots)
        };
        false -> case first.token.kind == lexer_token_kind@token_kind_bnot_keyword() or first.token.kind == lexer_token_kind@token_kind_not_keyword() of {
            true -> {
                rest_bnot: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
                (operand_bnot: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_bnot: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_expr_with_precedence(rest_bnot, 7);
                dummy_bnot: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                bnot_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, "", unary_prefix_keyword_name(first.token.kind), first.token.location, operand_bnot, dummy_bnot, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                (bnot_expr, rest_after_bnot)
            };
            false -> case first.token.kind == lexer_token_kind@token_kind_case_keyword() or first.token.lexeme == "case" of {
            true -> extract_case_expression(slots);
            false -> {
                rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
                first_kind: int64 <- first.token.kind;
                case lexer_token_kind@is_identifier_lexeme_token(first_kind) or first_kind == lexer_token_kind@token_kind_buf_keyword() or first_kind == lexer_token_kind@token_kind_ref_keyword() or first_kind == lexer_token_kind@token_kind_region_keyword() or first_kind == lexer_token_kind@token_kind_device_window_keyword() or first_kind == lexer_token_kind@token_kind_atomic_keyword() or constraint_extract_slots@is_actor_callable_keyword(first_kind) of {
                    true -> case constraint_extract_slots@slots_is_nil(rest) of {
                        true -> (constraint_extract_params@extract_operand_expr(first), rest);
                        false -> case constraint_extract_slots@slots_head(rest).token.kind == lexer_token_kind@token_kind_at_sign() of {
                            true -> extract_module_qualified_value(slots);
                            false -> case constraint_extract_slots@slots_head(rest).token.kind == lexer_token_kind@token_kind_left_paren() of {
                                true -> extract_call(slots);
                                false -> case constraint_extract_slots@slots_head(rest).token.kind == lexer_token_kind@token_kind_left_bracket() of {
                                    true -> case constraint_extract_params@should_extract_call_after_name(rest) of {
                                        true -> extract_call(slots);
                                        false -> (constraint_extract_params@extract_operand_expr(first), rest)
                                    };
                                    false -> (constraint_extract_params@extract_operand_expr(first), rest)
                                }
                            }
                        }
                    };
                    false -> case first_kind == lexer_token_kind@token_kind_left_bracket() and (constraint_core@slot_role(first) == capability_list@role_list_lit_lbracket() or constraint_extract_slots@is_list_literal_lbracket_fallback(slots)) of {
                        true -> constraint_extract_expr_lits@extract_list_literal(slots, extract_body);
                        false -> case first_kind == lexer_token_kind@token_kind_left_brace() or first.token.lexeme == "{" of {
                            true -> case constraint_extract_params@is_struct_literal_lbrace_fallback(slots) of {
                                true -> constraint_extract_expr_bindings@extract_struct_literal(slots, extract_body);
                                false -> {
                                    inner_slots_p: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- rest;
                                    (body_expr_p: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_p: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_function_body(inner_slots_p);
                                    case constraint_extract_slots@slots_is_nil(rest_after_p) of {
                                        true -> (parser_ast@dummy_expr(), slots);
                                        false -> case rest_after_p.head.token.kind == lexer_token_kind@token_kind_right_brace() or rest_after_p.head.token.lexeme == "}" or constraint_core@slot_role(rest_after_p.head) == constraint_extract_slots@role_right_brace() of {
                                            true -> (body_expr_p, rest_after_p.tail);
                                            false -> (parser_ast@dummy_expr(), slots)
                                        }
                                    }
                                }
                            };
                            false -> case first_kind == lexer_token_kind@token_kind_minus() of {
                                true -> {
                                    (operand: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_expr_with_precedence(rest, 3);
                                    dummy_m: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                    unary_minus: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(12, "", "", first.token.location, operand, dummy_m, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                    (unary_minus, rest_after)
                                };
                                false -> case first_kind == lexer_token_kind@token_kind_left_paren() of {
                                    true -> constraint_extract_expr_lits@extract_parenthesized(slots, extract_body);
                                    false -> case constraint_extract_slots@is_operand_token(first_kind) of {
                                        true -> (constraint_extract_params@extract_operand_expr(first), rest);
                                        false -> (constraint_extract_params@extract_body_expr(first), rest)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }
    }
    }
}



fn extract_binary_tail(left: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], min_prec: int64) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    case constraint_extract_slots@slots_is_nil(rest) of {
        true -> (left, rest);
        false -> case constraint_extract_slots@slots_head(rest).token.lexeme == "," or constraint_extract_slots@slots_head(rest).token.lexeme == ";" or constraint_extract_slots@slots_head(rest).token.lexeme == "}" or constraint_extract_slots@slots_head(rest).token.lexeme == ")" or constraint_extract_slots@slots_head(rest).token.lexeme == ":" of {
            true -> (left, rest);
            false -> case constraint_extract_slots@is_op_token(constraint_extract_slots@slots_head(rest).token.kind) or constraint_extract_slots@is_logical_op_slot(constraint_extract_slots@slots_head(rest)) of {
            false -> (left, rest);
            true -> case constraint_extract_slots@op_precedence(constraint_extract_slots@slots_head(rest).token.lexeme) < min_prec of {
                true -> (left, rest);
                false -> {
                    op_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- constraint_extract_slots@slots_head(rest);
                    rest_after_op: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(rest);
                    (right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_right: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_expr_with_precedence(rest_after_op, constraint_extract_slots@op_precedence(op_slot.token.lexeme) + 1);
                    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                    binary: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(3, op_slot.token.lexeme, "", op_slot.token.location, left, right, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                    extract_binary_tail(binary, rest_after_right, min_prec)
                }
            }
            }
        }
    }
}



fn extract_expr_with_precedence(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], min_prec: int64) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence
        (primary: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_primary(slots);
        (after_post: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_post: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@extract_postfix_tail(primary, rest);
        result: ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_binary_tail(after_post, rest_post, min_prec)
    produces
        pure result
    end
}



// Module-qualified call (silica-spec §3.3.2): kind4 like extract_call; `name` is the function identifier; `value` is generic type-arg text only.
fn extract_module_qualified_call(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    mod_lex: string <- slots.head.token.lexeme;
    mod_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
    after_mod: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    case constraint_extract_slots@slots_is_nil(after_mod) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case after_mod.head.token.kind == lexer_token_kind@token_kind_at_sign() of {
            true -> {
                after_at_raw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_mod.tail;
                after_at: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_at_raw);
                case constraint_extract_slots@slots_is_nil(after_at) of {
                    true -> (parser_ast@dummy_expr(), slots);
                    false -> case lexer_token_kind@is_identifier_lexeme_token(after_at.head.token.kind) of {
                        true -> {
                            fn_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- after_at.head;
                            rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_at.tail;
                            (type_args: string, at_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@extract_optional_generic_type_args_after_name(rest_after_name);
                            case constraint_extract_slots@slots_is_nil(at_lparen) of {
                                true -> (parser_ast@dummy_expr(), slots);
                                false -> case constraint_extract_slots@slots_head(at_lparen).token.kind == lexer_token_kind@token_kind_left_paren() of {
                                    true -> {
                                        arg_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(at_lparen);
                                        (arg1: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_arg1: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(arg_slots);
                                        (rest_skipped: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], _has_am_arg1: boolean) <- constraint_extract_params@skip_impl_annotation(rest_after_arg1);
                                        (right_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_rparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_call_rest(rest_skipped, mod_loc);
                                        mq_name: string <- concat(concat(mod_lex, "@"), fn_slot.token.lexeme);
                                        call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, type_args, mq_name, mod_loc, arg1, right_expr, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                        (call_expr, rest_after_rparen)
                                    };
                                    false -> (parser_ast@dummy_expr(), slots)
                                }
                            }
                        };
                        false -> (parser_ast@dummy_expr(), slots)
                    }
                }
            };
            false -> (parser_ast@dummy_expr(), slots)
        }
    }
}



fn extract_module_qualified_value(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    mod_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.head;
    after_mod: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    case constraint_extract_slots@slots_is_nil(after_mod) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case after_mod.head.token.kind == lexer_token_kind@token_kind_at_sign() of {
            true -> {
                after_at_raw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_mod.tail;
                after_at: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_at_raw);
                case constraint_extract_slots@slots_is_nil(after_at) of {
                    true -> (parser_ast@dummy_expr(), slots);
                    false -> case lexer_token_kind@is_identifier_lexeme_token(after_at.head.token.kind) of {
                        true -> {
                            fn_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- after_at.head;
                            rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_at.tail;
                            (type_args: string, at_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@extract_optional_generic_type_args_after_name(rest_after_name);
                            case constraint_extract_slots@slots_is_nil(at_lparen) of {
                                true -> (constraint_extract_params@extract_module_qualified_reference(mod_slot, fn_slot), at_lparen);
                                false -> case constraint_extract_slots@slots_head(at_lparen).token.kind == lexer_token_kind@token_kind_left_paren() of {
                                    true -> extract_module_qualified_call(slots);
                                    false -> case length_bytes(type_args) == 0 of {
                                        true -> (constraint_extract_params@extract_module_qualified_reference(mod_slot, fn_slot), at_lparen);
                                        false -> (parser_ast@dummy_expr(), slots)
                                    }
                                }
                            }
                        };
                        false -> (parser_ast@dummy_expr(), slots)
                    }
                }
            };
            false -> (parser_ast@dummy_expr(), slots)
        }
    }
}



fn extract_case_rhs_module_qualified_call(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    mod_lex: string <- slots.head.token.lexeme;
    mod_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
    after_mod: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    case constraint_extract_slots@slots_is_nil(after_mod) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case after_mod.head.token.kind == lexer_token_kind@token_kind_at_sign() of {
            true -> {
                after_at_raw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_mod.tail;
                after_at: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_at_raw);
                case constraint_extract_slots@slots_is_nil(after_at) of {
                    true -> (parser_ast@dummy_expr(), slots);
                    false -> case lexer_token_kind@is_identifier_lexeme_token(after_at.head.token.kind) of {
                        true -> {
                            fn_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- after_at.head;
                            rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_at.tail;
                            (type_args: string, at_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@extract_optional_generic_type_args_after_name(rest_after_name);
                            case constraint_extract_slots@slots_is_nil(at_lparen) of {
                                true -> (parser_ast@dummy_expr(), slots);
                                false -> case constraint_extract_slots@slots_head(at_lparen).token.kind == lexer_token_kind@token_kind_left_paren() of {
                                    true -> {
                                        arg_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(at_lparen);
                                        mq_case_name: string <- concat(concat(mod_lex, "@"), fn_slot.token.lexeme);
                                        arg_start: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(arg_slots);
                                        case constraint_extract_slots@slots_is_nil(arg_start) of {
                                            true -> (parser_ast@dummy_expr(), slots);
                                            false -> case constraint_extract_slots@slots_head(arg_start).token.kind == lexer_token_kind@token_kind_right_paren() of {
                                                true -> {
                                                    dummy_arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                                    dummy_rest: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                                    call0: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, type_args, mq_case_name, mod_loc, dummy_arg, dummy_rest, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                                    (call0, constraint_extract_slots@slots_tail(arg_start))
                                                };
                                                false -> {
                                                    (arg1: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_arg1: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_rhs_with_precedence(arg_start, 0);
                                                    (right_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_rparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_case_call_rest(rest_after_arg1, mod_loc);
                                                    call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, type_args, mq_case_name, mod_loc, arg1, right_expr, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                                    (call_expr, rest_after_rparen)
                                                }
                                            }
                                        }
                                    };
                                    false -> (parser_ast@dummy_expr(), slots)
                                }
                            }
                        };
                        false -> (parser_ast@dummy_expr(), slots)
                    }
                }
            };
            false -> (parser_ast@dummy_expr(), slots)
        }
    }
}



// `extract_body` may leave leading whitespace before `)` or `,` in the remaining token stream
// (e.g., `{ field: val }` parsed from `call(..., { field: val }, next)` returns rest = `", next )"`
// where a space precedes `)`).  Trim once at the top so both the `)` and `,` checks are
// whitespace-agnostic, matching the same approach used in `extract_struct_fields_tail`.
fn extract_call_rest(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], call_loc: { file: string, line: int64, column: int64, offset: int64 }) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case constraint_extract_slots@slots_is_nil(trimmed) of {
        true -> (dummy, trimmed);
        false -> case constraint_extract_slots@slots_head(trimmed).token.kind == lexer_token_kind@token_kind_right_paren() or constraint_extract_slots@slots_head(trimmed).token.lexeme == ")" of {
            true -> (dummy, constraint_extract_slots@slots_tail(trimmed));
            false -> case constraint_extract_slots@slots_head(trimmed).token.kind == lexer_token_kind@token_kind_comma() or constraint_extract_slots@slots_head(trimmed).token.lexeme == "," of {
                true -> {
                    arg_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(trimmed);
                    (arg_raw: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_arg: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(arg_slots);
                    (arg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, lifted: string) <- constraint_extract_params@lift_register_marker(arg_raw);
                    (rest_skipped: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], am_after: string) <- constraint_extract_params@impl_annotation_marker(rest_after_arg);
                    am_marker: string <- call_argument_marker(arg, lifted, am_after);
                    (sub_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_final: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_call_rest(rest_skipped, call_loc);
                    pair: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, am_marker, "", call_loc, arg, sub_expr, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                    (pair, rest_final)
                };
                false -> (dummy, trimmed)
            }
        }
    }
}



fn extract_call(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    call_name: string <- slots.head.token.lexeme;
    call_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
    rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    (type_args: string, at_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@extract_optional_generic_type_args_after_name(rest_after_name);
    case constraint_extract_slots@slots_is_nil(at_lparen) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case constraint_extract_slots@slots_head(at_lparen).token.kind == lexer_token_kind@token_kind_left_paren() of {
            true -> {
                arg_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(at_lparen);
                (arg1: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_arg1: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(arg_slots);
                (rest_after_arg1_skipped: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], _has_am_arg1: boolean) <- constraint_extract_params@skip_impl_annotation(rest_after_arg1);
                (right_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_rparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_call_rest(rest_after_arg1_skipped, call_loc);
                call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(4, type_args, call_name, call_loc, arg1, right_expr, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                (call_expr, rest_after_rparen)
            };
            false -> (parser_ast@dummy_expr(), slots)
        }
    }
}

// Name of the unary prefix keyword operator for a token kind (spec §3.3.1 unary_operator): `not` (logical,
// §3.9 precedence 2) or `bnot` (bitwise complement). Both parse to a call-shaped node whose name is the operator.
fn unary_prefix_keyword_name(token_kind: int64) -> string {
    case token_kind == lexer_token_kind@token_kind_not_keyword() of {
        true -> "not";
        false -> "bnot"
    }
}
