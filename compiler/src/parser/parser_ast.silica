fn dummy_effect_name() -> { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    sequence
        result: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: "", parameter: "", location: zero_location() }
    produces
        pure result
    end
}

fn empty_effect_name_list() -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- empty[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]()
    produces
        pure result
    end
}

fn cons_effect_name(eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, list: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- prepend[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)](eff, list)
    produces
        pure result
    end
}

fn rebuild_effect_name_list(src: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case src.is_nil of {
        true -> empty_effect_name_list();
        false -> cons_effect_name(rebuild_effect_name(src.head.name, src.head.parameter, src.head.location), rebuild_effect_name_list(src.tail))
    }
}

fn declaration_from_lambda_lift(name: string, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], capture_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], ret_ty: string, ret_loc: { file: string, line: int64, column: int64, offset: int64 }, loc: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, seq_eff: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } {
    sequence
        formals_lp: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- rebuild_param_list_from_lambda_bindings(rebuild_tuple_decompose_binding_list(pattern_bindings));
        // Every tag-0 parameter list is stored last-source-parameter first (collect_params_loop), and
        // formals_lp already is. The lifted function's source order is (formals..., captures...), so the
        // captures, which arrive in source order, go reversed in front of the formals.
        params_lp: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- list_param_reverse_with_acc(capture_params, formals_lp);
        effs: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- rebuild_effect_name_list(seq_eff);
        result: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { tag: 0, name: name, parameters: params_lp, return_type_name: ret_ty, return_type_location: ret_loc, location: loc, body: body, declared_effects: effs }
    produces
        pure result
    end
}

