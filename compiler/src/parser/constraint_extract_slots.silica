// Slot/list navigation helpers and parser role/token classifiers.

use lexer_core;
use lexer_token_kind;
use constraint_core;

export role_right_brace/0;
export is_type_keyword/1;
export kind_to_type_name/1;
export is_op_token/1;
export is_logical_op_slot/1;
export is_operand_token/1;
export is_effect_paren_param_token/1;
export is_list_literal_lbracket_fallback/1;
export is_struct_field_name_token/1;
export skip_leading_whitespace_slots/1;
export skip_semicolons_after_whitespace/1;
export slots_after_binding_colon/1;
export rhs_slots_after_memory_region_type/1;
export slots_tail/1;
export slots_is_nil/1;
export slots_head/1;
export op_precedence/1;
export consume_optional_leading_right_brace/1;
export take_prefix_before_role_or_of_keyword/2;
export take_suffix_from_role_or_of_keyword/2;
export take_prefix_before_branch_arrow/1;
export take_suffix_from_branch_arrow/1;
export take_prefix_before_if_keyword/1;
export take_suffix_from_if_keyword/1;
export slot_lexemes_join/1;
export skip_square_bracket_group_depth/2;
export skip_square_bracket_group_depth_join/3;
export strip_trailing_rbracket_type_arg_join/1;
export is_actor_callable_keyword/1;



// Role codes (must match capabilities)
fn role_fn_keyword() -> int64 { 1 }


fn role_fn_name() -> int64 { 2 }


fn role_left_paren() -> int64 { 3 }


fn role_right_paren() -> int64 { 4 }


fn role_right_arrow() -> int64 { 5 }


fn role_type_name() -> int64 { 6 }


fn role_left_brace() -> int64 { 7 }


fn role_right_brace() -> int64 { 8 }


fn role_body_expr() -> int64 { 9 }


fn role_integer_literal() -> int64 { 10 }


fn role_identifier() -> int64 { 11 }


fn role_operand() -> int64 { 12 }


fn role_op() -> int64 { 13 }


fn role_call_name() -> int64 { 14 }


fn role_call_lparen() -> int64 { 15 }


fn role_call_rparen() -> int64 { 16 }



fn is_type_keyword(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_int8_keyword() or token_kind == lexer_token_kind@token_kind_int16_keyword() or token_kind == lexer_token_kind@token_kind_int32_keyword() or token_kind == lexer_token_kind@token_kind_int64_keyword() or token_kind == lexer_token_kind@token_kind_uint8_keyword() or token_kind == lexer_token_kind@token_kind_uint16_keyword() or token_kind == lexer_token_kind@token_kind_uint32_keyword() or token_kind == lexer_token_kind@token_kind_uint64_keyword() or token_kind == lexer_token_kind@token_kind_float16_keyword() or token_kind == lexer_token_kind@token_kind_float32_keyword() or token_kind == lexer_token_kind@token_kind_float64_keyword() or token_kind == lexer_token_kind@token_kind_bool_keyword() or token_kind == lexer_token_kind@token_kind_char_keyword() or token_kind == lexer_token_kind@token_kind_string_keyword() or token_kind == lexer_token_kind@token_kind_bytes_keyword() or token_kind == lexer_token_kind@token_kind_unit_keyword() or token_kind == lexer_token_kind@token_kind_atom_keyword() or token_kind == lexer_token_kind@token_kind_ref_keyword() or token_kind == lexer_token_kind@token_kind_region_keyword() or token_kind == lexer_token_kind@token_kind_buf_keyword() or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_lifetime_keyword() or token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword() or token_kind == lexer_token_kind@token_kind_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_dangerous_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_device_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_supervisor_ref_keyword() or token_kind == lexer_token_kind@token_kind_failure_reason_keyword() or token_kind == lexer_token_kind@token_kind_monitor_ref_keyword()
}



fn kind_to_type_name(token_kind: int64) -> string {
    case token_kind == lexer_token_kind@token_kind_failure_reason_keyword() of {
        true -> "failure_reason";
        false -> case token_kind == lexer_token_kind@token_kind_supervisor_ref_keyword() of {
            true -> "supervisor_ref";
            // monitor(target) -> monitor_ref (spec §15.4.8.6, §22.4): the keyword names a binding's type
            // like supervisor_ref does; before this a `m: monitor_ref <- monitor(p)` binding was E1000.
            false -> case token_kind == lexer_token_kind@token_kind_monitor_ref_keyword() of {
                true -> "monitor_ref";
                false -> kind_to_type_name_not_failure(token_kind)
            }
        }
    }
}



fn kind_to_type_name_not_failure(token_kind: int64) -> string {
    case token_kind == lexer_token_kind@token_kind_char_keyword() of {
        true -> "char";
        false -> case token_kind == lexer_token_kind@token_kind_actor_ref_keyword() of {
        true -> "actor_ref";
        false -> case token_kind == lexer_token_kind@token_kind_device_actor_ref_keyword() of {
            true -> "device_actor_ref";
        false -> case token_kind == lexer_token_kind@token_kind_dangerous_actor_ref_keyword() of {
            true -> "dangerous_actor_ref";
            false -> case token_kind == lexer_token_kind@token_kind_int64_keyword() of {
                true -> "int64";
                false -> case token_kind == lexer_token_kind@token_kind_int32_keyword() of {
                    true -> "int32";
                    false -> case token_kind == lexer_token_kind@token_kind_int16_keyword() of {
                        true -> "int16";
                        false -> case token_kind == lexer_token_kind@token_kind_int8_keyword() of {
                            true -> "int8";
                            false -> case token_kind == lexer_token_kind@token_kind_uint64_keyword() of {
                                true -> "uint64";
                                false -> case token_kind == lexer_token_kind@token_kind_uint32_keyword() of {
                                    true -> "uint32";
                                    false -> case token_kind == lexer_token_kind@token_kind_uint16_keyword() of {
                                        true -> "uint16";
                                        false -> case token_kind == lexer_token_kind@token_kind_uint8_keyword() of {
                                            true -> "uint8";
                                            false -> case token_kind == lexer_token_kind@token_kind_float64_keyword() of {
                                                true -> "float64";
                                                false -> case token_kind == lexer_token_kind@token_kind_float32_keyword() of {
                                                    true -> "float32";
                                                    false -> case token_kind == lexer_token_kind@token_kind_float16_keyword() of {
                                                        true -> "float16";
                                                        false -> case token_kind == lexer_token_kind@token_kind_bool_keyword() of {
                                                            true -> "boolean";
                                                            false -> case token_kind == lexer_token_kind@token_kind_unit_keyword() of {
                                                                true -> "unit";
                                                                false -> case token_kind == lexer_token_kind@token_kind_atom_keyword() of {
                                                                    true -> "atom";
                                                                    false -> case token_kind == lexer_token_kind@token_kind_string_keyword() of {
                                                                        true -> "string";
                                                                        false -> case token_kind == lexer_token_kind@token_kind_bytes_keyword() of {
                                                                            true -> "bytes";
                                                                            false -> ""
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    }
}



fn is_op_token(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_plus() or token_kind == lexer_token_kind@token_kind_minus() or token_kind == lexer_token_kind@token_kind_star() or token_kind == lexer_token_kind@token_kind_slash() or token_kind == lexer_token_kind@token_kind_percent() or token_kind == lexer_token_kind@token_kind_less_than() or token_kind == lexer_token_kind@token_kind_greater_than() or token_kind == lexer_token_kind@token_kind_less_equal() or token_kind == lexer_token_kind@token_kind_greater_equal() or token_kind == lexer_token_kind@token_kind_equal_equal() or token_kind == lexer_token_kind@token_kind_bang_equal() or token_kind == lexer_token_kind@token_kind_bor_keyword() or token_kind == lexer_token_kind@token_kind_band_keyword() or token_kind == lexer_token_kind@token_kind_shl_keyword() or token_kind == lexer_token_kind@token_kind_shr_keyword()
}



// Logical operators and/or are keywords (and_keyword, or_keyword) or identifiers (legacy); treat as binary ops.
fn is_logical_op_slot(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.kind == lexer_token_kind@token_kind_and_keyword() or slot.token.kind == lexer_token_kind@token_kind_or_keyword() or (slot.token.kind == lexer_token_kind@token_kind_identifier() and (slot.token.lexeme == "and" or slot.token.lexeme == "or"))
}



fn is_operand_token(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_integer_literal() or token_kind == lexer_token_kind@token_kind_float_literal() or lexer_token_kind@is_identifier_lexeme_token(token_kind) or token_kind == lexer_token_kind@token_kind_atom_literal() or token_kind == lexer_token_kind@token_kind_true_literal() or token_kind == lexer_token_kind@token_kind_false_literal() or token_kind == lexer_token_kind@token_kind_string_literal() or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword()
}



// mem(atomic), mem(normal), etc.: parameter is a keyword, not only a generic identifier (see collect_effects_until_right_bracket).
fn is_effect_paren_param_token(token_kind: int64) -> boolean {
    lexer_token_kind@is_identifier_lexeme_token(token_kind) or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword()
}



// True when token is a public collection trait type name with trailing `[...]` type params.
fn token_is_bracketed_collection_type_name(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_list_keyword()
}



fn token_is_list_type_name(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    token_is_bracketed_collection_type_name(tok)
}



// `[` usually has role_list_lit_lbracket after constraint propagation; if that role is missing, still treat as a
// list literal when the next token clearly starts list elements ([] or an operand or `{` struct, a `(`
// tuple or parenthesized element, a `-` negative number or an atom), so RHS and tuple elements like
// `(0, [ { a: 1 } ])` do not fall through to constraint_extract_expr@extract_expr_with_precedence(E1040).
// A leading `(` element used to be the one shape the constraint roles never covered (`(` after `[`
// has no operand role), so `[(3, 4), (1, 2)]` was not a list literal at all (E1000 at the `(`,
// E1040 at the comma): trials/list_addition/list_of_tuple_literals.
fn is_list_literal_lbracket_fallback(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> case slots.tail.is_nil of {
                true -> false;
                false -> {
                    n: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.tail.head;
                    n.token.kind == lexer_token_kind@token_kind_right_bracket() or n.token.lexeme == "]" or n.token.kind == lexer_token_kind@token_kind_integer_literal() or n.token.kind == lexer_token_kind@token_kind_float_literal() or lexer_token_kind@is_identifier_lexeme_token(n.token.kind) or n.token.kind == lexer_token_kind@token_kind_string_literal() or n.token.kind == lexer_token_kind@token_kind_true_literal() or n.token.kind == lexer_token_kind@token_kind_false_literal() or n.token.kind == lexer_token_kind@token_kind_left_bracket() or n.token.kind == lexer_token_kind@token_kind_left_brace() or n.token.lexeme == "{" or n.token.kind == lexer_token_kind@token_kind_left_paren() or n.token.lexeme == "(" or n.token.kind == lexer_token_kind@token_kind_minus() or n.token.kind == lexer_token_kind@token_kind_atom_literal()
                }
            };
            false -> false
        }
    }
}



// Field name token in struct literal `name: expr` (same head tokens as binding LHS).
// After `.`, allow `end` (lexed as end_keyword) and other keywords that are valid field names
// but not identifier tokens — otherwise `s.end` cannot parse as field access (§3.3.x).
fn is_struct_field_name_token(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    lexer_token_kind@is_identifier_lexeme_token(tok.kind) or tok.kind == lexer_token_kind@token_kind_buf_keyword() or tok.kind == lexer_token_kind@token_kind_ref_keyword() or tok.kind == lexer_token_kind@token_kind_region_keyword() or tok.kind == lexer_token_kind@token_kind_device_window_keyword() or tok.kind == lexer_token_kind@token_kind_atomic_keyword() or tok.kind == lexer_token_kind@token_kind_end_keyword()
}



fn skip_semicolons(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.lexeme == ";" of {
            true -> skip_semicolons(slots.tail);
            false -> slots
        }
    }
}



// Skip leading whitespace tokens (space, tab, newline) so " produces" becomes "produces"
fn skip_leading_whitespace_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.lexeme == " " or slots.head.token.lexeme == "\t" or slots.head.token.lexeme == "\n" or slots.head.token.lexeme == "\r" of {
            true -> skip_leading_whitespace_slots(slots.tail);
            false -> slots
        }
    }
}



// Newline may appear between the RHS and `;`; skip leading whitespace before consuming semicolons.
fn skip_semicolons_after_whitespace(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    skip_semicolons(skip_leading_whitespace_slots(slots))
}



// After `ident :`, lexer may emit space/newline before the type token or `(`/ `{`/`List`. Consumers that
// used slots.tail.tail as the immediate post-`:` stream must skip so list/tuple/struct/bindings classify
// and extract correctly ("children: \\n List[").
fn slots_after_binding_colon(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    skip_leading_whitespace_slots(slots.tail.tail)
}



// After `ident : Type <- rhs`, rest_slots after the type may have leading whitespace before `<-`;
// skip to the RHS (also used for tuple and list binding types, not only ref/region/buf).
fn rhs_slots_after_memory_region_type(rest_after_type: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(rest_after_type);
    case trimmed.is_nil of {
        true -> trimmed;
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_arrow() of {
            true -> trimmed.tail;
            false -> trimmed
        }
    }
}



fn slots_tail(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    slots.tail
}



fn slots_is_nil(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    slots.is_nil
}



fn slots_head(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } {
    slots.head
}



// Operator precedence. Higher = binds tighter.
// multiplicative (*, /, %) = 6; additive (+, -) = 5; shift = 4; band = 3; bor = 2; comparison (<, >, ...) = 1; logical (and, or) = 0.
// Comparisons must bind tighter than `and`/`or` so guards like `n >= 0 and n < 100` parse as
// `(n >= 0) and (n < 100)`, not `(n >= 0) and n` with stray `< 100`.
fn op_precedence(lexeme: string) -> int64 {
    case lexeme of {
        "*" -> 6;
        "/" -> 6;
        "%" -> 6;
        "+" -> 5;
        "-" -> 5;
        "shl" -> 4;
        "shr" -> 4;
        "band" -> 3;
        "bor" -> 2;
        "<" -> 1;
        ">" -> 1;
        "<=" -> 1;
        ">=" -> 1;
        "==" -> 1;
        "!=" -> 1;
        "and" -> 0;
        "or" -> 0;
        _: string -> 0
    }
}



// After `ident : fn(...) <- rhs` where rhs is a lambda `{ ... }`, extract_body leaves the stream at the
// lambda's closing `}`. Consume it before parsing the enclosing binding's continuation (`;` + body).
// Otherwise `}` is parsed as the next expression (bogus let _ <- `}`).
fn consume_optional_leading_right_brace(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> trimmed;
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_brace() of {
            true -> trimmed.tail;
            false -> trimmed
        }
    }
}



fn take_prefix_before_role(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], target_role: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case constraint_core@slot_role(slots.head) == target_role of {
            true -> constraint_core@empty_list_slot();
            false -> {
                tail_p: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_role(slots.tail, target_role);
                constraint_core@cons_slot(slots.head, tail_p)
            }
        }
    }
}



fn take_suffix_from_role(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], target_role: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case constraint_core@slot_role(slots.head) == target_role of {
            true -> slots;
            false -> take_suffix_from_role(slots.tail, target_role)
        }
    }
}



// Split "case" <scrutinee> "of" using only the lexer kind of `of`. Do not stop on slot_role == role_case_of():
// after constraint propagation, role_case_of can appear as the first role on the scrutinee token (e.g. true),
// which would yield an empty scrutinee slot list and segfault in extract_primary.
fn take_prefix_before_role_or_of_keyword(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], target_role: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_of_keyword() or slots.head.token.lexeme == "of" of {
            true -> constraint_core@empty_list_slot();
            false -> {
                tail_p: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_role_or_of_keyword(slots.tail, target_role);
                constraint_core@cons_slot(slots.head, tail_p)
            }
        }
    }
}



fn take_suffix_from_role_or_of_keyword(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], target_role: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_of_keyword() or slots.head.token.lexeme == "of" of {
            true -> slots;
            false -> take_suffix_from_role_or_of_keyword(slots.tail, target_role)
        }
    }
}



fn take_prefix_before_branch_arrow(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    take_prefix_before_branch_arrow_balanced(slots, 0, 0, 0)
}



fn take_suffix_from_branch_arrow(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    take_suffix_from_branch_arrow_balanced(slots, 0, 0, 0)
}



// Only treat `->` as the branch arrow at brace/paren/bracket depth 0 so `fn(...) -> T` inside patterns does not split early.
fn take_prefix_before_branch_arrow_balanced(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64, pdepth: int64, sdepth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case (slots.head.token.kind == lexer_token_kind@token_kind_right_arrow() or slots.head.token.lexeme == "->") and brace_depth == 0 and pdepth == 0 and sdepth == 0 of {
            true -> constraint_core@empty_list_slot();
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
                true -> {
                    tail_p: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_branch_arrow_balanced(slots.tail, brace_depth + 1, pdepth, sdepth);
                    constraint_core@cons_slot(slots.head, tail_p)
                };
                false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_brace() or slots.head.token.lexeme == "}" of {
                    true -> {
                        nd: int64 <- brace_depth - 1;
                        d2: int64 <- case nd < 0 of { true -> 0; false -> nd };
                        tail_p2: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_branch_arrow_balanced(slots.tail, d2, pdepth, sdepth);
                        constraint_core@cons_slot(slots.head, tail_p2)
                    };
                    false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_paren() or slots.head.token.lexeme == "(" of {
                        true -> {
                            tail_p3: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_branch_arrow_balanced(slots.tail, brace_depth, pdepth + 1, sdepth);
                            constraint_core@cons_slot(slots.head, tail_p3)
                        };
                        false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_paren() or slots.head.token.lexeme == ")" of {
                            true -> {
                                np: int64 <- case pdepth > 0 of { true -> pdepth - 1; false -> 0 };
                                tail_p4: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_branch_arrow_balanced(slots.tail, brace_depth, np, sdepth);
                                constraint_core@cons_slot(slots.head, tail_p4)
                            };
                            false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() or slots.head.token.lexeme == "[" of {
                                true -> {
                                    tail_p5: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_branch_arrow_balanced(slots.tail, brace_depth, pdepth, sdepth + 1);
                                    constraint_core@cons_slot(slots.head, tail_p5)
                                };
                                false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() or slots.head.token.lexeme == "]" of {
                                    true -> {
                                        ns: int64 <- case sdepth > 0 of { true -> sdepth - 1; false -> 0 };
                                        tail_p6: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_branch_arrow_balanced(slots.tail, brace_depth, pdepth, ns);
                                        constraint_core@cons_slot(slots.head, tail_p6)
                                    };
                                    false -> {
                                        tail_p7: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_branch_arrow_balanced(slots.tail, brace_depth, pdepth, sdepth);
                                        constraint_core@cons_slot(slots.head, tail_p7)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



fn take_suffix_from_branch_arrow_balanced(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64, pdepth: int64, sdepth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case (slots.head.token.kind == lexer_token_kind@token_kind_right_arrow() or slots.head.token.lexeme == "->") and brace_depth == 0 and pdepth == 0 and sdepth == 0 of {
            true -> slots;
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
                true -> take_suffix_from_branch_arrow_balanced(slots.tail, brace_depth + 1, pdepth, sdepth);
                false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_brace() or slots.head.token.lexeme == "}" of {
                    true -> {
                        nd: int64 <- brace_depth - 1;
                        d2: int64 <- case nd < 0 of { true -> 0; false -> nd };
                        take_suffix_from_branch_arrow_balanced(slots.tail, d2, pdepth, sdepth)
                    };
                    false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_paren() or slots.head.token.lexeme == "(" of {
                        true -> take_suffix_from_branch_arrow_balanced(slots.tail, brace_depth, pdepth + 1, sdepth);
                        false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_paren() or slots.head.token.lexeme == ")" of {
                            true -> {
                                np: int64 <- case pdepth > 0 of { true -> pdepth - 1; false -> 0 };
                                take_suffix_from_branch_arrow_balanced(slots.tail, brace_depth, np, sdepth)
                            };
                            false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() or slots.head.token.lexeme == "[" of {
                                true -> take_suffix_from_branch_arrow_balanced(slots.tail, brace_depth, pdepth, sdepth + 1);
                                false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() or slots.head.token.lexeme == "]" of {
                                    true -> {
                                        ns: int64 <- case sdepth > 0 of { true -> sdepth - 1; false -> 0 };
                                        take_suffix_from_branch_arrow_balanced(slots.tail, brace_depth, pdepth, ns)
                                    };
                                    false -> take_suffix_from_branch_arrow_balanced(slots.tail, brace_depth, pdepth, sdepth)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



// Split case-branch pattern from guard using lexer `if` (same idea as `of` / `->`): do not rely on
// role_case_guard_if being slot_role(head) after constraint merge — merged roles can order `if` last.
fn take_prefix_before_if_keyword(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_if_keyword() or slots.head.token.lexeme == "if" of {
            true -> constraint_core@empty_list_slot();
            false -> {
                tail_p: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- take_prefix_before_if_keyword(slots.tail);
                constraint_core@cons_slot(slots.head, tail_p)
            }
        }
    }
}



fn take_suffix_from_if_keyword(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_if_keyword() or slots.head.token.lexeme == "if" of {
            true -> slots;
            false -> take_suffix_from_if_keyword(slots.tail)
        }
    }
}



fn slot_lexemes_join(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> string {
    case slots.is_nil of {
        true -> "";
        false -> case slots_is_nil(slots.tail) of {
            true -> slots.head.token.lexeme;
            false -> {
                rest_s: string <- slot_lexemes_join(slots.tail);
                concat(concat(slots.head.token.lexeme, " "), rest_s)
            }
        }
    }
}



// `slots` is the token stream after the opening `[`; depth is 1 inside one pair of brackets.
fn skip_square_bracket_group_depth(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> skip_square_bracket_group_depth(slots.tail, depth + 1);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() of {
                true -> case depth == 1 of {
                    true -> slots.tail;
                    false -> skip_square_bracket_group_depth(slots.tail, depth - 1)
                };
                false -> skip_square_bracket_group_depth(slots.tail, depth)
            }
        }
    }
}



fn join_lexemes_space(acc: string, lexeme: string) -> string {
    case length_bytes(acc) == 0 of {
        true -> lexeme;
        false -> concat(acc, concat(" ", lexeme))
    }
}



// Same traversal as skip_square_bracket_group_depth; accumulates lexemes like slot_lexemes_join for tokens inside
// the matching `]` (the closing `]` that ends the group is not appended). Used for generic call `[T,S]` text so we
// do not rely on take_prefix_slots(inner, rest) — List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] `==` may not be pointer identity, yielding empty join.
fn skip_square_bracket_group_depth_join(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64, acc: string) -> (string, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    case slots.is_nil of {
        true -> (acc, slots);
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> skip_square_bracket_group_depth_join(slots.tail, depth + 1, join_lexemes_space(acc, slots.head.token.lexeme));
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() of {
                true -> case depth == 1 of {
                    true -> (acc, slots.tail);
                    false -> skip_square_bracket_group_depth_join(slots.tail, depth - 1, join_lexemes_space(acc, slots.head.token.lexeme))
                };
                false -> skip_square_bracket_group_depth_join(slots.tail, depth, join_lexemes_space(acc, slots.head.token.lexeme))
            }
        }
    }
}



// slot_lexemes_join on prefix ending at the slot after `]` still includes the `]` token; strip it so parse_generic_ts does not see "int64 , normal ]".
fn strip_trailing_rbracket_type_arg_join(s: string) -> string {
    case length_bytes(s) == 0 of {
        true -> s;
        false -> case substring(s, length_bytes(s) - 1, length_bytes(s)) == "]" of {
            true -> substring(s, 0, length_bytes(s) - 1);
            false -> s
        }
    }
}



fn is_actor_callable_keyword(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_spawn_keyword() or token_kind == lexer_token_kind@token_kind_spawn_dangerous_keyword() or token_kind == lexer_token_kind@token_kind_spawn_dangerous_registered_keyword() or token_kind == lexer_token_kind@token_kind_spawn_device_keyword() or token_kind == lexer_token_kind@token_kind_spawn_device_registered_keyword() or token_kind == lexer_token_kind@token_kind_spawn_registered_keyword() or token_kind == lexer_token_kind@token_kind_spawn_linked_keyword() or token_kind == lexer_token_kind@token_kind_spawn_registered_supervisor_keyword() or token_kind == lexer_token_kind@token_kind_call_supervisor_keyword() or token_kind == lexer_token_kind@token_kind_link_keyword() or token_kind == lexer_token_kind@token_kind_monitor_keyword() or token_kind == lexer_token_kind@token_kind_demonitor_keyword() or token_kind == lexer_token_kind@token_kind_send_keyword() or token_kind == lexer_token_kind@token_kind_cast_keyword() or token_kind == lexer_token_kind@token_kind_self_keyword() or lexer_token_kind@is_actor_runtime_helper_kind(token_kind)
}
