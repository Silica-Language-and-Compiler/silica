// --- E1072: a function literal captures a name that is not bound to an integer literal where the
// literal is written (spec 3.3.6). wrap_capture_ident marked the reference; report the first one.

fn value_has_marker(v: string) -> boolean {
    m: int64 <- length_bytes(unsupported_capture_marker());
    case length_bytes(v) >= m of {
        true -> substring(v, 0, m) == unsupported_capture_marker();
        false -> false
    }
}



fn expr_find_unsupported_capture(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (boolean, string, { file: string, line: int64, column: int64, offset: int64 }) {
    case expr.root < 0 of {
        true -> (false, "", parser_ast@zero_location());
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind == 1 and value_has_marker(node.value) of {
                true -> (true, substring(node.value, length_bytes(unsupported_capture_marker()), length_bytes(node.value)), node.location);
                false -> {
                    (f0: boolean, b0: string, l0: { file: string, line: int64, column: int64, offset: int64 }) <- expr_find_unsupported_capture(parser_ast@expr_at(expr, node.inner));
                    case f0 of {
                        true -> (f0, b0, l0);
                        false -> expr_find_unsupported_capture(parser_ast@expr_at(expr, node.right_expr))
                    }
                }
            }
        }
    }
}



fn decls_find_unsupported_capture(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (boolean, string, { file: string, line: int64, column: int64, offset: int64 }) {
    case decls.is_nil of {
        true -> (false, "", parser_ast@zero_location());
        false -> {
            (f: boolean, b: string, l: { file: string, line: int64, column: int64, offset: int64 }) <- case decls.head.tag == 0 of {
                true -> expr_find_unsupported_capture(decls.head.body);
                false -> (false, "", parser_ast@zero_location())
            };
            case f of {
                true -> (f, b, l);
                false -> decls_find_unsupported_capture(decls.tail)
            }
        }
    }
}



fn validate_function_literal_captures(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: boolean, bad: string, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- case decls_have_lifted_lambda(program.declarations) of {
        true -> decls_find_unsupported_capture(program.declarations);
        false -> (false, "", parser_ast@zero_location())
    };
    case found of {
        true -> parser_core@parse_err("E1072", err_loc, concat(concat(concat(concat("this function literal captures '", bad), "', which is not bound to an integer literal; a function literal may capture only names bound to integer literals (closure environments are not supported), so pass '"), bad), "' as a parameter instead"), "sect3.3.6");
        false -> parser_core@parse_ok(program)
    }
}
