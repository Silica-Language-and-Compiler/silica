// Capture wrappers for lifted function literals, and the capture rule (E1072).

use parser_ast;
use parser_core;
use atom_table;
use constraint_extract_decls;

export wrap_lifted_lambda_hof_calls/1;
export validate_function_literal_captures/1;



// --- A lifted function literal is <enclosing>.__lamN(formals..., captures...) (constraint_extract_lambda_lift,
// parser_ast declaration_from_lambda_lift). Whoever holds it as a function value calls it with its formals
// only, and there are no closure environments, so every reference to a capturing literal is replaced by an
// arity wrapper <enclosing>.__lwN(formals...) whose body calls __lamN with the formals and, for each capture,
// the integer literal the captured name is bound to where the literal is written. A capture bound to
// anything else (a parameter, a computed value, a non-integer literal) cannot be passed: the reference is
// marked and validate_function_literal_captures rejects it with E1072.
// Argument lists hold specs (ident or int lexeme only); { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } nodes are built last to avoid E2000 on
// { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }-in-struct lists.

fn hof_nil_arg_specs() -> List[{ is_ident: boolean, text: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ is_ident: boolean, text: string }, mem(normal)] <- empty[{ is_ident: boolean, text: string }, mem(normal)]()
    produces
        pure result
    end
}



fn hof_cons_arg_spec(s: { is_ident: boolean, text: string }, rest: List[{ is_ident: boolean, text: string }, mem(normal)]) -> List[{ is_ident: boolean, text: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ is_ident: boolean, text: string }, mem(normal)] <- prepend[{ is_ident: boolean, text: string }, mem(normal)](s, rest)
    produces
        pure result
    end
}



fn hof_spec_to_expr(s: { is_ident: boolean, text: string }, loc: { file: string, line: int64, column: int64, offset: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case s.is_ident of {
        true -> expr_ident_here(s.text, loc);
        false -> expr_int_here(s.text, loc)
    }
}



// The arguments after the first: each one a nameless kind-4 pair whose right is the rest, ending in a
// dummy (constraint_extract_expr extract_call_rest).
fn hof_arg_chain_specs(es: List[{ is_ident: boolean, text: string }, mem(normal)], loc: { file: string, line: int64, column: int64, offset: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case es.is_nil of {
        true -> parser_ast@dummy_expr();
        false -> parser_ast@make_expr(4, "", "", loc, hof_spec_to_expr(es.head, loc), hof_arg_chain_specs(es.tail, loc), parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
    }
}



// A call in the parser's shape: the first argument is the call's inner, the rest hang off its right
// (a two-argument call is call(a, pair(b, dummy)), never call(a, b)).
fn hof_call_expr_from_arg_specs(callee: string, args: List[{ is_ident: boolean, text: string }, mem(normal)], loc: { file: string, line: int64, column: int64, offset: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case args.is_nil of {
        true -> parser_ast@dummy_expr();
        false -> parser_ast@make_expr(4, "", callee, loc, hof_spec_to_expr(args.head, loc), hof_arg_chain_specs(args.tail, loc), parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
    }
}



fn lifted_name_sub_at(m: string, i: int64) -> boolean {
    case i + 6 > length_bytes(m) of {
        true -> false;
        false -> case substring(m, i, i + 6) == ".__lam" of {
            true -> true;
            false -> lifted_name_sub_at(m, i + 1)
        }
    }
}



fn name_has_lifted_lambda_sub(m: string) -> boolean {
    lifted_name_sub_at(m, 0)
}



fn find_tag0_decl_by_name(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], nm: string) -> { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } {
    case decls.is_nil of {
        true -> parser_ast@dummy_decl();
        false -> case decls.head.tag == 0 and decls.head.name == nm of {
            true -> decls.head;
            false -> find_tag0_decl_by_name(decls.tail, nm)
        }
    }
}



fn list_param_len_w(ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_len_w(ps.tail)
    }
}



fn list_param_drop_n_w(ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], n: int64) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case n <= 0 of {
        true -> ps;
        false -> case ps.is_nil of {
            true -> parser_ast@nil_list_param();
            false -> list_param_drop_n_w(ps.tail, n - 1)
        }
    }
}



// The captures of a lifted literal carry the literal's location (capture_tb_to_params); its formals carry
// the zero location. The list is last source parameter first, so the captures lead it.
fn count_capture_params(ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> case ps.head.location.line == 0 of {
            true -> 0;
            false -> 1 + count_capture_params(ps.tail)
        }
    }
}



// --- The let-environment: what each visible name is bound to where a literal is written. An entry typed
// "__silica_intlit__" holds the integer lexeme in `path`; "__silica_nonlit__" shadows an outer entry of
// the same name (a rebinding, a pattern binding, or a binding to anything that is not an integer literal).

fn let_env_cons_int_lit(nm: string, int_lex: string, tail: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(nm, int_lex, "__silica_intlit__"), tail)
}



fn let_env_cons_shadow(nm: string, tail: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(nm, "", "__silica_nonlit__"), tail)
}



fn let_env_lookup_int_lit(env: List[{ name: string, path: string, type_str: string }, mem(normal)], nm: string) -> (boolean, string) {
    case env.is_nil of {
        true -> (false, "");
        false -> case env.head.name == nm of {
            true -> case env.head.type_str == "__silica_intlit__" of {
                true -> (true, env.head.path);
                false -> (false, "")
            };
            false -> let_env_lookup_int_lit(env.tail, nm)
        }
    }
}



fn string_has_char_at(s: string, c: string, i: int64) -> boolean {
    case i >= length_bytes(s) of {
        true -> false;
        false -> case substring(s, i, i + 1) == c of {
            true -> true;
            false -> string_has_char_at(s, c, i + 1)
        }
    }
}



// An integer literal lexeme: no fraction and, unless hexadecimal, no exponent.
fn is_integer_lexeme(lex: string) -> boolean {
    n: int64 <- length_bytes(lex);
    hex: boolean <- case n >= 2 of {
        true -> substring(lex, 0, 2) == "0x" or substring(lex, 0, 2) == "0X";
        false -> false
    };
    case n == 0 or string_has_char_at(lex, ".", 0) of {
        true -> false;
        false -> case hex of {
            true -> true;
            false -> case string_has_char_at(lex, "e", 0) or string_has_char_at(lex, "E", 0) of {
                true -> false;
                false -> true
            }
        }
    }
}



fn is_integer_binding_type(ty: string) -> boolean {
    case ty of {
        "" -> true;
        "int8" -> true;
        "int16" -> true;
        "int32" -> true;
        "int64" -> true;
        "uint8" -> true;
        "uint16" -> true;
        "uint32" -> true;
        "uint64" -> true;
        _: string -> false
    }
}



// The environment after `nm: ty <- rhs;`.
fn let_env_after_let(nm: string, ty: string, rhs: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, env: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case nm == "_" or length_bytes(nm) == 0 of {
        true -> env;
        false -> case rhs.root >= 0 and parser_ast@expr_root_kind(rhs) == 0 of {
            true -> case is_integer_binding_type(ty) and is_integer_lexeme(parser_ast@expr_root_value(rhs)) of {
                true -> let_env_cons_int_lit(nm, parser_ast@expr_root_value(rhs), env);
                false -> let_env_cons_shadow(nm, env)
            };
            false -> let_env_cons_shadow(nm, env)
        }
    }
}



fn let_env_shadow_bindings(bs: List[{ name: string, path: string, type_str: string }, mem(normal)], env: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case bs.is_nil of {
        true -> env;
        false -> let_env_shadow_bindings(bs.tail, let_env_cons_shadow(bs.head.name, env))
    }
}



fn is_ident_char(c: string) -> boolean {
    string_has_char_at("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c, 0)
}



fn word_boundary_before(s: string, i: int64) -> boolean {
    case i <= 0 of {
        true -> true;
        false -> is_ident_char(substring(s, i - 1, i)) == false
    }
}



fn word_boundary_after(s: string, j: int64) -> boolean {
    case j >= length_bytes(s) of {
        true -> true;
        false -> is_ident_char(substring(s, j, j + 1)) == false
    }
}



fn word_occurs_from(s: string, w: string, i: int64) -> boolean {
    m: int64 <- length_bytes(w);
    case m == 0 or i + m > length_bytes(s) of {
        true -> false;
        false -> case substring(s, i, i + m) == w of {
            true -> case word_boundary_before(s, i) and word_boundary_after(s, i + m) of {
                true -> true;
                false -> word_occurs_from(s, w, i + 1)
            };
            false -> word_occurs_from(s, w, i + 1)
        }
    }
}



// A case branch keeps its pattern as text (kind 18 value): shadow every literal-bound name the pattern
// mentions, so a pattern binding never reads an outer literal of the same name.
fn let_env_shadow_pattern_words(pat: string, entries: List[{ name: string, path: string, type_str: string }, mem(normal)], env: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case entries.is_nil of {
        true -> env;
        false -> case entries.head.type_str == "__silica_intlit__" of {
            true -> case word_occurs_from(pat, entries.head.name, 0) of {
                true -> let_env_shadow_pattern_words(pat, entries.tail, let_env_cons_shadow(entries.head.name, env));
                false -> let_env_shadow_pattern_words(pat, entries.tail, env)
            };
            false -> let_env_shadow_pattern_words(pat, entries.tail, env)
        }
    }
}



// The environment after the statements of a sequence block, for its `produces` part.
fn fold_seq_env(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, env: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case e.root < 0 of {
        true -> env;
        false -> case parser_ast@expr_root_kind(e) == 6 of {
            true -> fold_seq_env(parser_ast@expr_at(e, parser_ast@expr_root_right(e)), let_env_after_let(parser_ast@expr_root_name(e), parser_ast@expr_root_value(e), parser_ast@expr_at(e, parser_ast@expr_root_inner(e)), env));
            false -> case parser_ast@expr_root_kind(e) == 10 of {
                true -> fold_seq_env(parser_ast@expr_at(e, parser_ast@expr_root_right(e)), let_env_shadow_bindings(parser_ast@expr_root_node(e).pattern_bindings, env));
                false -> env
            }
        }
    }
}



fn expr_ident_here(nm: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        d: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(1, "", nm, loc, d, d, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
    produces
        pure result
    end
}



fn expr_int_here(lex: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        d: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(0, lex, "", loc, d, d, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
    produces
        pure result
    end
}



// The wrapper's call arguments, in the lifted literal's source order (formals..., captures...): each formal
// by name, each capture as its integer literal. On failure the string is the first capture that is not
// bound to an integer literal.
fn build_lifted_call_arg_specs(src_ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], formal_ct: int64, idx: int64, env: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> (boolean, string, List[{ is_ident: boolean, text: string }, mem(normal)]) {
    case src_ps.is_nil of {
        true -> (true, "", hof_nil_arg_specs());
        false -> case idx < formal_ct of {
            true -> {
                (ok_f: boolean, bad_f: string, rest_f: List[{ is_ident: boolean, text: string }, mem(normal)]) <- build_lifted_call_arg_specs(src_ps.tail, formal_ct, idx + 1, env);
                case ok_f of {
                    true -> (true, "", hof_cons_arg_spec({ is_ident: true, text: src_ps.head.name }, rest_f));
                    false -> (false, bad_f, hof_nil_arg_specs())
                }
            };
            false -> {
                (okv: boolean, vx: string) <- let_env_lookup_int_lit(env, src_ps.head.name);
                case okv of {
                    false -> (false, src_ps.head.name, hof_nil_arg_specs());
                    true -> {
                        (ok_c: boolean, bad_c: string, rest_c: List[{ is_ident: boolean, text: string }, mem(normal)]) <- build_lifted_call_arg_specs(src_ps.tail, formal_ct, idx + 1, env);
                        case ok_c of {
                            true -> (true, "", hof_cons_arg_spec({ is_ident: false, text: vx }, rest_c));
                            false -> (false, bad_c, hof_nil_arg_specs())
                        }
                    }
                }
            }
        }
    }
}



fn unsupported_capture_marker() -> string {
    "__silica_unsupported_capture__:"
}



// A reference to a lifted literal: when it captures, the wrapper ident (and the wrapper), or the marked
// reference when a capture is not bound to an integer literal. The boolean says the expression changed.
fn wrap_capture_ident(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, enclosing_fn: string, all_decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], seq: int64, env: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> (int64, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], boolean) {
    nm: string <- parser_ast@expr_root_name(expr);
    lifted: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- find_tag0_decl_by_name(all_decls, nm);
    caps: int64 <- count_capture_params(lifted.parameters);
    case lifted.tag != 0 or caps == 0 of {
        true -> (seq, expr, parser_ast@empty_list_decl(), false);
        false -> {
            loc: { file: string, line: int64, column: int64, offset: int64 } <- parser_ast@expr_root_node(expr).location;
            formal_ct: int64 <- list_param_len_w(lifted.parameters) - caps;
            src_ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@list_param_reverse_with_acc(lifted.parameters, parser_ast@nil_list_param());
            (args_ok: boolean, bad: string, ale: List[{ is_ident: boolean, text: string }, mem(normal)]) <- build_lifted_call_arg_specs(src_ps, formal_ct, 0, env);
