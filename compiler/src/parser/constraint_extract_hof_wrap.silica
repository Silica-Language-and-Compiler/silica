// The environment a node's children see: its own pattern bindings and, for a case branch, the names its
// pattern mentions are shadowed (both only ever turn a capture into E1072, never into a wrong value).
fn child_env(node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, env: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    env1: List[{ name: string, path: string, type_str: string }, mem(normal)] <- let_env_shadow_bindings(node.pattern_bindings, env);
    case node.kind == 18 of {
        true -> let_env_shadow_pattern_words(node.value, env1, env1);
        false -> env1
    }
}



// The environment of a node's right child: a let's continuation sees the let, a sequence's `produces`
// part sees the statements' lets.
fn right_child_env(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, env: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case node.kind == 6 of {
        true -> let_env_after_let(node.name, node.value, parser_ast@expr_at(expr, node.inner), env);
        false -> case node.kind == 11 of {
            true -> fold_seq_env(parser_ast@expr_at(expr, node.inner), env);
            false -> env
        }
    }
}



