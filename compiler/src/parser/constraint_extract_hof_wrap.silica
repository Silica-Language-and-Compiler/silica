            case args_ok of {
                false -> (seq, parser_ast@make_expr(1, concat(unsupported_capture_marker(), bad), nm, loc, d, d, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list()), parser_ast@empty_list_decl(), true);
                true -> {
                    body_call: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- hof_call_expr_from_arg_specs(lifted.name, ale, loc);
                    wrap_nm: string <- concat(enclosing_fn, concat(".__lw", atom_table@int64_to_decimal_string(seq)));
                    wrap_decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- {
                        tag: 0,
                        name: wrap_nm,
                        parameters: list_param_drop_n_w(lifted.parameters, caps),
                        return_type_name: lifted.return_type_name,
                        return_type_location: lifted.return_type_location,
                        location: loc,
                        body: body_call,
                        declared_effects: parser_ast@empty_effect_name_list()
                    };
                    use_ident: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(1, parser_ast@expr_root_value(expr), wrap_nm, loc, d, d, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
