                                true -> parser_core@parse_err("E1059", reserved_field_loc, concat(concat("'", reserved_field_name), "' is a reserved keyword and cannot be used as a record field name; choose a different name"), "sect3");
                                false -> {
                                    (has_unbalanced: boolean, unbalanced_loc: { file: string, line: int64, column: int64, offset: int64 }, unbalanced_msg: string) <- has_unbalanced_braces(slots);
