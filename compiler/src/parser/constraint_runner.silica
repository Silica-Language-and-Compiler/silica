// Constraint runner - parse_program, all_constraints, orchestration

use lexer_core;
use lexer_token_kind;
use lexer_runner;
use constraint_core;
use constraint_extract_decls;
use constraint_extract_validate;
use constraint_extract_lambda_lift;
use constraint_extract_hof_wrap;
use parser_core;
use parser_ast;
use capability_fn_decl;
use capability_expr_literal;
use capability_expr_atom;
use capability_expr_int64_ops;
use capability_expr_float32;
use capability_effect_decl;
use capability_module;
use capability_trait;
use capability_bind;
use capability_tuple_decompose;
use capability_memory_region;
use capability_sequence;
use capability_expr_negate_builtin;
use capability_case;
use capability_list;
use capability_recursion_implementation;
use capability_supervisor_phases;
use capability_actors;
use capability_foreign;

export parse_program/1;

fn all_constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    base: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- capability_fn_decl@constraints();
    with_expr: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(base, capability_expr_literal@constraints());
    with_atom: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_expr, capability_expr_atom@constraints());
    with_ops: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_atom, capability_expr_int64_ops@constraints());
    with_float32: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_ops, capability_expr_float32@constraints());
    with_effect_decl: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_float32, capability_effect_decl@constraints());
    with_module: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_effect_decl, capability_module@constraints());
    with_foreign: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_module, capability_foreign@constraints());
    with_trait: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_foreign, capability_trait@constraints());
    with_bind: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_trait, capability_bind@constraints());
    with_td: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_bind, capability_tuple_decompose@constraints());
    with_mem: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_td, capability_memory_region@constraints());
    with_seq: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_mem, capability_sequence@constraints());
    with_neg: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_seq, capability_expr_negate_builtin@constraints());
    with_case: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_neg, capability_case@constraints());
    with_list: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_case, capability_list@constraints());
    with_recursion_jsonld: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_list, capability_recursion_implementation@constraints());
    with_supervisor_phases: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_recursion_jsonld, capability_supervisor_phases@constraints());
    with_actors: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- append_constraints(with_supervisor_phases, capability_actors@constraints());
    with_actors
}

fn append_constraints(a: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)], b: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)]) -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    constraint_core@append_list_constraint(a, b)
}

fn merge_roles(a: List[int64, mem(normal)], b: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> constraint_core@cons_int(a.head, merge_roles(a.tail, b))
    }
}

fn initial_roles_for_token(token_kind: int64) -> List[int64, mem(normal)] {
    sequence
        fd: List[int64, mem(normal)] <- capability_fn_decl@initial_roles(token_kind);
        el: List[int64, mem(normal)] <- capability_expr_literal@initial_roles(token_kind);
        atom_r: List[int64, mem(normal)] <- capability_expr_atom@initial_roles(token_kind);
        ops: List[int64, mem(normal)] <- capability_expr_int64_ops@initial_roles(token_kind);
        f32_ops: List[int64, mem(normal)] <- capability_expr_float32@initial_roles(token_kind);
        eff_decl: List[int64, mem(normal)] <- capability_effect_decl@initial_roles(token_kind);
        mod_r: List[int64, mem(normal)] <- capability_module@initial_roles(token_kind);
        foreign_r: List[int64, mem(normal)] <- capability_foreign@initial_roles(token_kind);
        trait_r: List[int64, mem(normal)] <- capability_trait@initial_roles(token_kind);
        bind: List[int64, mem(normal)] <- capability_bind@initial_roles(token_kind);
        td: List[int64, mem(normal)] <- capability_tuple_decompose@initial_roles(token_kind);
        mem_region: List[int64, mem(normal)] <- capability_memory_region@initial_roles(token_kind);
        seq: List[int64, mem(normal)] <- capability_sequence@initial_roles(token_kind);
        neg: List[int64, mem(normal)] <- capability_expr_negate_builtin@initial_roles(token_kind);
        case_r: List[int64, mem(normal)] <- capability_case@initial_roles(token_kind);
        list_r: List[int64, mem(normal)] <- capability_list@initial_roles(token_kind);
        rec_jsonld: List[int64, mem(normal)] <- capability_recursion_implementation@initial_roles(token_kind);
        sup_jsonld: List[int64, mem(normal)] <- capability_supervisor_phases@initial_roles(token_kind);
        actors_r: List[int64, mem(normal)] <- capability_actors@initial_roles(token_kind);
        m14: List[int64, mem(normal)] <- merge_roles(rec_jsonld, merge_roles(sup_jsonld, actors_r));
        m13: List[int64, mem(normal)] <- merge_roles(list_r, m14);
        m12: List[int64, mem(normal)] <- merge_roles(case_r, m13);
        m11: List[int64, mem(normal)] <- merge_roles(neg, m12);
        m10: List[int64, mem(normal)] <- merge_roles(seq, m11);
        m9: List[int64, mem(normal)] <- merge_roles(mem_region, m10);
        m8: List[int64, mem(normal)] <- merge_roles(td, m9);
        m7b: List[int64, mem(normal)] <- merge_roles(trait_r, m8);
        m7: List[int64, mem(normal)] <- merge_roles(bind, m7b);
        m6: List[int64, mem(normal)] <- merge_roles(foreign_r, merge_roles(mod_r, m7));
        m5: List[int64, mem(normal)] <- merge_roles(eff_decl, m6);
        m4: List[int64, mem(normal)] <- merge_roles(f32_ops, m5);
        m3: List[int64, mem(normal)] <- merge_roles(ops, m4);
        m2: List[int64, mem(normal)] <- merge_roles(atom_r, m3);
        m1: List[int64, mem(normal)] <- merge_roles(el, m2);
        result: List[int64, mem(normal)] <- merge_roles(fd, m1)
    produces
        pure result
    end
}

fn reverse_tokens(acc: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], list: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case list.is_nil of {
        true -> acc;
        false -> reverse_tokens(lexer_runner@cons_token(list.head, acc), list.tail)
    }
}

fn tokens_to_slots(tokens: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case tokens.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> {
            roles: List[int64, mem(normal)] <- initial_roles_for_token(tokens.head.kind);
            slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- constraint_core@make_token_slot(tokens.head, roles);
            rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- tokens_to_slots(tokens.tail);
            constraint_core@cons_slot(slot, rest)
        }
    }
}

fn is_type_keyword(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_int8_keyword() or token_kind == lexer_token_kind@token_kind_int16_keyword() or token_kind == lexer_token_kind@token_kind_int32_keyword() or token_kind == lexer_token_kind@token_kind_int64_keyword() or token_kind == lexer_token_kind@token_kind_uint8_keyword() or token_kind == lexer_token_kind@token_kind_uint16_keyword() or token_kind == lexer_token_kind@token_kind_uint32_keyword() or token_kind == lexer_token_kind@token_kind_uint64_keyword() or token_kind == lexer_token_kind@token_kind_float16_keyword() or token_kind == lexer_token_kind@token_kind_float32_keyword() or token_kind == lexer_token_kind@token_kind_float64_keyword() or token_kind == lexer_token_kind@token_kind_bool_keyword() or token_kind == lexer_token_kind@token_kind_char_keyword() or token_kind == lexer_token_kind@token_kind_string_keyword() or token_kind == lexer_token_kind@token_kind_bytes_keyword() or token_kind == lexer_token_kind@token_kind_unit_keyword() or token_kind == lexer_token_kind@token_kind_atom_keyword() or token_kind == lexer_token_kind@token_kind_ref_keyword() or token_kind == lexer_token_kind@token_kind_region_keyword() or token_kind == lexer_token_kind@token_kind_buf_keyword() or token_kind == lexer_token_kind@token_kind_atomic_keyword() or token_kind == lexer_token_kind@token_kind_normal_keyword() or token_kind == lexer_token_kind@token_kind_normal_writeback_keyword() or token_kind == lexer_token_kind@token_kind_normal_writethrough_keyword() or token_kind == lexer_token_kind@token_kind_normal_noncacheable_keyword() or token_kind == lexer_token_kind@token_kind_device_keyword() or token_kind == lexer_token_kind@token_kind_list_keyword() or token_kind == lexer_token_kind@token_kind_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_dangerous_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_device_actor_ref_keyword() or token_kind == lexer_token_kind@token_kind_timer_ref_keyword() or token_kind == lexer_token_kind@token_kind_supervisor_ref_keyword() or token_kind == lexer_token_kind@token_kind_failure_reason_keyword()
}

// Detect proc after return type: -> type_name proc[...] is invalid (spec §9.3.1)
// E3009: a function declaration's return type followed by proc[...], whatever the type. Only the
// declaration's own `->` is examined, so effects inside parameter function types and `->` in case
// arms are not; a `{` opens a record type only as the first token after the arrow, else the body.
fn has_proc_after_return_type(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case is_declaration_start(slots) of {
            true -> declaration_return_proc(skip_declaration_head(slots.tail), slots.tail);
            false -> has_proc_after_return_type(slots.tail)
        }
    }
}

fn is_declaration_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail);
    slots.head.token.kind == lexer_token_kind@token_kind_fn_keyword() and after.is_nil == false and after.head.token.kind == lexer_token_kind@token_kind_identifier()
}

// From the declaration's name: past the name and the parameter list.
fn skip_declaration_head(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(skip_leading_whitespace_slots(slots).tail);
    case after_name.is_nil == false and after_name.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
        true -> skip_leading_whitespace_slots(skip_function_parameter_list(after_name, 0));
        false -> after_name
    }
}

fn declaration_return_proc(after_params: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case after_params.is_nil == false and after_params.head.token.kind == lexer_token_kind@token_kind_right_arrow() of {
        false -> has_proc_after_return_type(rest);
        true -> {
            (found: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }) <- return_type_proc(after_params.tail, 0, true);
            case found of {
                true -> (true, loc);
                false -> has_proc_after_return_type(rest)
            }
        }
    }
}

fn return_type_token_class(lexeme: string) -> atom {
    case lexeme of {
        "proc" -> :proc;
        "{" -> :brace;
        "(" -> :open;
        "[" -> :open;
        ")" -> :close;
        "]" -> :close;
        "}" -> :close;
        ";" -> :stop;
        _: string -> :other
    }
}

fn return_type_proc(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64, first: boolean) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slot_is_whitespace(slots.head) of {
            true -> return_type_proc(slots.tail, depth, first);
            false -> return_type_proc_at(slots, depth, first, return_type_token_class(slots.head.token.lexeme))
        }
    }
}

fn return_type_proc_at(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64, first: boolean, class: atom) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case class of {
        :proc -> case depth == 0 of {
            true -> (true, slots.head.token.location);
            false -> return_type_proc(slots.tail, depth, false)
        };
        :brace -> case depth == 0 and first == false of {
            true -> (false, parser_ast@zero_location());
            false -> return_type_proc(slots.tail, depth + 1, false)
        };
        :open -> return_type_proc(slots.tail, depth + 1, false);
        :close -> return_type_proc(slots.tail, depth - 1, false);
        :stop -> case depth == 0 of {
            true -> (false, parser_ast@zero_location());
            false -> return_type_proc(slots.tail, depth, false)
        };
        _: atom -> return_type_proc(slots.tail, depth, false)
    }
}

fn skip_function_parameter_list(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
            true -> skip_function_parameter_list(slots.tail, depth + 1);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_paren() of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> skip_function_parameter_list(slots.tail, depth - 1)
                };
                false -> skip_function_parameter_list(slots.tail, depth)
            }
        }
    }
}

fn skip_optional_bracket_suffix_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> skip_optional_bracket_suffix_slots(slots.tail, depth + 1);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> skip_optional_bracket_suffix_slots(slots.tail, depth - 1)
                };
                false -> skip_optional_bracket_suffix_slots(slots.tail, depth)
            }
        }
    }
}

fn scan_function_after_params_for_return_arrow(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_arrow() or slots.head.token.lexeme == "->" of {
            true -> arrow_has_no_return_type_before_body(slots.tail, slots.head.token.location);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() of {
                true -> (true, slots.head.token.location);
                false -> case slots.head.token.kind == lexer_token_kind@token_kind_semicolon() of {
                    true -> (true, slots.head.token.location);
                    false -> scan_function_after_params_for_return_arrow(slots.tail)
                }
            }
        }
    }
}

// Skip a `{ ... }` group. `slots` begins after the opening `{`; `depth` starts at 1.
fn skip_brace_group_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.lexeme == "{" of {
            true -> skip_brace_group_slots(slots.tail, depth + 1);
            false -> case slots.head.token.lexeme == "}" of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> skip_brace_group_slots(slots.tail, depth - 1)
                };
                false -> skip_brace_group_slots(slots.tail, depth)
            }
        }
    }
}

// After a return type, optionally skip `proc[...]` before the function body `{` or trait `;`.
fn skip_optional_proc_effects_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> trimmed;
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_proc_keyword() or trimmed.head.token.lexeme == "proc" of {
            true -> {
                after_proc: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                case after_proc.is_nil of {
                    true -> trimmed;
                    false -> case after_proc.head.token.kind == lexer_token_kind@token_kind_left_bracket() or after_proc.head.token.lexeme == "[" of {
                        true -> skip_leading_whitespace_slots(skip_bracketed_slots(after_proc, 0));
                        false -> trimmed
                    }
                }
            };
            false -> trimmed
        }
    }
}

// True when `->` is present but no return type precedes the body: `fn f(...) -> { ... }`.
// Distinguishes that from a valid inline-record return type: `fn f(...) -> { a: T } { ... }` / `-> { a: T };`.
fn arrow_has_no_return_type_before_body(slots_after_arrow: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], arrow_loc: { file: string, line: int64, column: int64, offset: int64 }) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    after_arrow: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots_after_arrow);
    case after_arrow.is_nil of {
        true -> (true, arrow_loc);
        false -> case after_arrow.head.token.kind == lexer_token_kind@token_kind_left_brace() or after_arrow.head.token.lexeme == "{" of {
            true -> {
                brace_loc: { file: string, line: int64, column: int64, offset: int64 } <- after_arrow.head.token.location;
                after_group: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_brace_group_slots(after_arrow.tail, 1);
                after_proc: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_optional_proc_effects_slots(skip_sum_options_after_record_slots(after_group));
                after_final: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_proc);
                case after_final.is_nil of {
                    true -> case brace_group_starts_record_like(after_arrow.tail) of {
                        true -> (false, parser_ast@zero_location());
                        false -> (true, brace_loc)
                    };
                    false -> case after_final.head.token.kind == lexer_token_kind@token_kind_left_brace() or after_final.head.token.lexeme == "{" or after_final.head.token.kind == lexer_token_kind@token_kind_semicolon() or after_final.head.token.lexeme == ";" of {
                        true -> (false, parser_ast@zero_location());
                        false -> (true, brace_loc)
                    }
                }
            };
            false -> case after_arrow.head.token.kind == lexer_token_kind@token_kind_semicolon() or after_arrow.head.token.lexeme == ";" of {
                true -> (true, after_arrow.head.token.location);
                false -> (false, parser_ast@zero_location())
            }
        }
    }
}

// Inside `fn name ( ...`, a `{ ... }` group is a record/struct type when the next token is `,`, `)`
// or `|` (a record variant of an inline sum type, `{ id: uint32 } | :none`, silica-specification
// §3.4.2). Otherwise the function body began while the parameter list was still open (E1065).
fn brace_group_is_param_record_type(after_brace_group: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_brace_group);
    case trimmed.is_nil of {
        true -> false;
        false -> trimmed.head.token.kind == lexer_token_kind@token_kind_comma() or trimmed.head.token.lexeme == "," or trimmed.head.token.kind == lexer_token_kind@token_kind_right_paren() or trimmed.head.token.lexeme == ")" or trimmed.head.token.lexeme == "|"
    }
}

// After a record return type, the remaining options of an inline sum type (`{ id: uint32 } | :none`,
// `| (:found, uint32)`, `| { x: int64 }`), so the body `{` is found after the whole type.
fn skip_sum_options_after_record_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> trimmed;
        false -> case trimmed.head.token.lexeme == "|" of {
            false -> trimmed;
            true -> {
                option: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                case option.is_nil of {
                    true -> option;
                    false -> case option.head.token.lexeme == "{" of {
                        true -> skip_sum_options_after_record_slots(skip_brace_group_slots(option.tail, 1));
                        false -> case option.head.token.lexeme == "(" of {
                            true -> skip_sum_options_after_record_slots(skip_function_parameter_list(option, 0));
                            false -> skip_sum_options_after_record_slots(option.tail)
                        }
                    }
                }
            }
        }
    }
}

// Walk parameter tokens after the opening `(`. depth starts at 1.
// Returns (found_error, error_location).
fn scan_unclosed_function_parameter_list(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64, open_paren_loc: { file: string, line: int64, column: int64, offset: int64 }) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case slots.is_nil of {
        true -> case depth > 0 of {
            true -> (true, open_paren_loc);
            false -> (false, parser_ast@zero_location())
        };
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_paren() or slots.head.token.lexeme == "(" of {
            true -> scan_unclosed_function_parameter_list(slots.tail, depth + 1, open_paren_loc);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_paren() or slots.head.token.lexeme == ")" of {
                true -> case depth <= 1 of {
                    true -> (false, parser_ast@zero_location());
                    false -> scan_unclosed_function_parameter_list(slots.tail, depth - 1, open_paren_loc)
                };
                false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
                    true -> {
                        brace_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
                        after_group: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_brace_group_slots(slots.tail, 1);
                        case after_group.is_nil of {
                            // Unclosed `{` — leave to E1060, unless we already know params are open.
                            true -> (true, brace_loc);
                            false -> case brace_group_is_param_record_type(after_group) of {
                                true -> scan_unclosed_function_parameter_list(after_group, depth, open_paren_loc);
                                false -> (true, brace_loc)
                            }
                        }
                    };
                    false -> scan_unclosed_function_parameter_list(slots.tail, depth, open_paren_loc)
                }
            }
        }
    }
}

fn has_unclosed_function_parameter_list(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_fn_keyword() of {
            true -> case slots.tail.is_nil of {
                true -> (false, parser_ast@zero_location(), "");
                false -> case lexer_token_kind@is_identifier_lexeme_token(slots.tail.head.token.kind) of {
                    false -> has_unclosed_function_parameter_list(slots.tail);
                    true -> {
                        fn_name: string <- slots.tail.head.token.lexeme;
                        after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail.tail);
                        after_brackets: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- case after_name.is_nil of {
                            true -> after_name;
                            false -> case after_name.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                                true -> skip_optional_bracket_suffix_slots(after_name.tail, 1);
                                false -> after_name
                            }
                        };
                        after_brackets_ws: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_brackets);
                        case after_brackets_ws.is_nil of {
                            true -> has_unclosed_function_parameter_list(slots.tail);
                            false -> case after_brackets_ws.head.token.kind == lexer_token_kind@token_kind_left_paren() or after_brackets_ws.head.token.lexeme == "(" of {
                                true -> {
                                    open_loc: { file: string, line: int64, column: int64, offset: int64 } <- after_brackets_ws.head.token.location;
                                    (bad: boolean, bad_loc: { file: string, line: int64, column: int64, offset: int64 }) <- scan_unclosed_function_parameter_list(after_brackets_ws.tail, 1, open_loc);
                                    case bad == true of {
                                        true -> (true, bad_loc, fn_name);
                                        false -> has_unclosed_function_parameter_list(slots.tail)
                                    }
                                };
                                false -> has_unclosed_function_parameter_list(slots.tail)
                            }
                        }
                    }
                }
            };
            false -> has_unclosed_function_parameter_list(slots.tail)
        }
    }
}

fn has_missing_function_return_type(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_fn_keyword() of {
            true -> case slots.tail.is_nil of {
                true -> (false, parser_ast@zero_location(), "");
                false -> case lexer_token_kind@is_identifier_lexeme_token(slots.tail.head.token.kind) of {
                    false -> has_missing_function_return_type(slots.tail);
                    true -> {
                        fn_name: string <- slots.tail.head.token.lexeme;
                        after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail.tail;
                        after_brackets: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- case after_name.is_nil of {
                            true -> after_name;
                            false -> case after_name.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                                true -> skip_optional_bracket_suffix_slots(after_name.tail, 1);
                                false -> after_name
                            }
                        };
                        scan_from: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- case after_brackets.is_nil of {
                            true -> after_brackets;
                            false -> case after_brackets.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
                                true -> skip_function_parameter_list(after_brackets, 0);
                                false -> after_brackets
                            }
                        };
                        (missing: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }) <- scan_function_after_params_for_return_arrow(scan_from);
                        case missing of {
                            true -> (true, loc, fn_name);
                            false -> has_missing_function_return_type(slots.tail)
                        }
                    }
                }
            };
            false -> has_missing_function_return_type(slots.tail)
        }
    }
}

fn token_end_offset(token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> int64 {
    token.location.offset + length_bytes(token.lexeme)
}

fn is_adjacent_token_pair(left: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, right: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    token_end_offset(left) == right.location.offset
}

fn token_starts_with_colon(token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    case token.lexeme == ":" of {
        true -> true;
        false -> case length_bytes(token.lexeme) > 0 of {
            true -> substring(token.lexeme, 0, 1) == ":";
            false -> false
        }
    }
}

fn has_bind_arrow_before_statement_boundary(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], paren_depth: int64, brace_depth: int64) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.lexeme == "<-" of {
            true -> case paren_depth == 0 and brace_depth == 0 of {
                true -> true;
                false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth)
            };
            false -> case slots.head.token.lexeme == ";" or slots.head.token.lexeme == "if" or slots.head.token.lexeme == "->" of {
                true -> case paren_depth == 0 and brace_depth == 0 of {
                    true -> false;
                    false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth)
                };
                false -> case slots.head.token.lexeme == "(" of {
                    true -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth + 1, brace_depth);
                    false -> case slots.head.token.lexeme == ")" of {
                        true -> case paren_depth <= 0 of {
                            true -> false;
                            false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth - 1, brace_depth)
                        };
                        false -> case slots.head.token.lexeme == "{" of {
                            true -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth + 1);
                            false -> case slots.head.token.lexeme == "}" of {
                                true -> case brace_depth <= 0 of {
                                    true -> false;
                                    false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth - 1)
                                };
                                false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_spaced_bind_colon(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.tail.is_nil of {
            true -> (false, parser_ast@zero_location(), "");
            false -> case lexer_token_kind@is_identifier_lexeme_token(slots.head.token.kind) and token_starts_with_colon(slots.tail.head.token) and has_bind_arrow_before_statement_boundary(slots.tail.tail, 0, 0) of {
                true -> case is_adjacent_token_pair(slots.head.token, slots.tail.head.token) of {
                    true -> has_spaced_bind_colon(slots.tail);
                    false -> (true, slots.tail.head.token.location, slots.head.token.lexeme)
                };
                false -> has_spaced_bind_colon(slots.tail)
            }
        }
    }
}

// `meta` / `wrapper_meta` are FFI keywords; using them as `name: type <-` bindings is rejected early
// so the parser does not fall through to a misleading E1040 terminator error.
fn is_reserved_binding_name_keyword(token_kind: int64, lexeme: string) -> boolean {
    token_kind == lexer_token_kind@token_kind_meta_keyword() or lexeme == "meta" or token_kind == lexer_token_kind@token_kind_wrapper_meta_keyword() or lexeme == "wrapper_meta"
}

fn has_reserved_keyword_binding(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> {
            after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail);
            case is_reserved_binding_name_keyword(slots.head.token.kind, slots.head.token.lexeme) and after_name.is_nil == false and token_starts_with_colon(after_name.head.token) and has_bind_arrow_before_statement_boundary(after_name.tail, 0, 0) of {
                true -> (true, slots.head.token.location, slots.head.token.lexeme);
                false -> has_reserved_keyword_binding(slots.tail)
            }
        }
    }
}

// Trait-section keywords `required` / `provided` cannot be record field names / `.field` suffixes.
// Reject early so `{ required: … }` does not fall through to a misleading E1040 terminator error.
fn is_reserved_record_field_name_keyword(token_kind: int64, lexeme: string) -> boolean {
    token_kind == lexer_token_kind@token_kind_required_keyword() or lexeme == "required" or token_kind == lexer_token_kind@token_kind_provided_keyword() or lexeme == "provided"
}

fn has_reserved_keyword_record_field_after_dot(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> has_reserved_keyword_record_field_walk(slots, brace_depth);
        false -> case is_reserved_record_field_name_keyword(trimmed.head.token.kind, trimmed.head.token.lexeme) of {
            true -> (true, trimmed.head.token.location, trimmed.head.token.lexeme);
            false -> has_reserved_keyword_record_field_walk(trimmed, brace_depth)
        }
    }
}

fn has_reserved_keyword_record_field_after_opener(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> has_reserved_keyword_record_field_walk(slots, brace_depth);
        false -> case is_reserved_record_field_name_keyword(trimmed.head.token.kind, trimmed.head.token.lexeme) of {
            true -> {
                after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                case after_name.is_nil of {
                    true -> has_reserved_keyword_record_field_walk(trimmed.tail, brace_depth);
                    false -> case token_starts_with_colon(after_name.head.token) of {
                        true -> (true, trimmed.head.token.location, trimmed.head.token.lexeme);
                        false -> has_reserved_keyword_record_field_walk(trimmed, brace_depth)
                    }
                }
            };
            false -> has_reserved_keyword_record_field_walk(trimmed, brace_depth)
        }
    }
}

fn has_reserved_keyword_record_field_walk(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
            true -> has_reserved_keyword_record_field_after_opener(slots.tail, brace_depth + 1);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_brace() or slots.head.token.lexeme == "}" of {
                true -> case brace_depth > 0 of {
                    true -> has_reserved_keyword_record_field_walk(slots.tail, brace_depth - 1);
                    false -> has_reserved_keyword_record_field_walk(slots.tail, 0)
                };
                false -> case (slots.head.token.kind == lexer_token_kind@token_kind_comma() or slots.head.token.lexeme == ",") and brace_depth > 0 of {
                    true -> has_reserved_keyword_record_field_after_opener(slots.tail, brace_depth);
                    false -> case slots.head.token.kind == lexer_token_kind@token_kind_dot() or slots.head.token.lexeme == "." of {
                        true -> has_reserved_keyword_record_field_after_dot(slots.tail, brace_depth);
                        false -> has_reserved_keyword_record_field_walk(slots.tail, brace_depth)
                    }
                }
            }
        }
    }
}

fn has_reserved_keyword_record_field(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    has_reserved_keyword_record_field_walk(slots, 0)
}

// Unbalanced `{` / `}` falls through to a misleading E1040 terminator error; reject early.
// open_loc is the outermost still-unclosed '{'. Only update when depth goes 0→1 so E1060
// points at the real unclosed open (e.g. a function body), not the last '{' in the file.
fn has_unbalanced_braces_walk(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64, open_loc: { file: string, line: int64, column: int64, offset: int64 }) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> case brace_depth > 0 of {
            true -> (true, open_loc, "unclosed '{'; expected a matching '}' before end of file");
            false -> (false, parser_ast@zero_location(), "")
        };
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
            true -> {
                next_open: { file: string, line: int64, column: int64, offset: int64 } <- case brace_depth == 0 of {
                    true -> slots.head.token.location;
                    false -> open_loc
                };
                has_unbalanced_braces_walk(slots.tail, brace_depth + 1, next_open)
            };
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_brace() or slots.head.token.lexeme == "}" of {
                true -> case brace_depth > 0 of {
                    true -> has_unbalanced_braces_walk(slots.tail, brace_depth - 1, open_loc);
                    false -> (true, slots.head.token.location, "unexpected '}'; no matching '{' is open")
                };
                false -> has_unbalanced_braces_walk(slots.tail, brace_depth, open_loc)
            }
        }
    }
}

fn has_unbalanced_braces(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    has_unbalanced_braces_walk(slots, 0, parser_ast@zero_location())
}

fn prev_allows_atom_literal(slots_before_colon_reversed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots_before_colon_reversed.is_nil of {
        true -> true;
        false -> case slots_before_colon_reversed.head.token.lexeme == "<-" or slots_before_colon_reversed.head.token.lexeme == "->" or slots_before_colon_reversed.head.token.lexeme == "{" or slots_before_colon_reversed.head.token.lexeme == "(" or slots_before_colon_reversed.head.token.lexeme == "," or slots_before_colon_reversed.head.token.lexeme == ";" or slots_before_colon_reversed.head.token.lexeme == "==" or slots_before_colon_reversed.head.token.lexeme == "!=" of {
            true -> true;
            false -> false
        }
    }
}

fn has_spaced_atom_literal_from(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], reversed_prefix: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slots.tail.is_nil of {
            true -> (false, parser_ast@zero_location());
            false -> case slots.head.token.lexeme == ":" and lexer_token_kind@is_identifier_lexeme_token(slots.tail.head.token.kind) and prev_allows_atom_literal(reversed_prefix) of {
                true -> case is_adjacent_token_pair(slots.head.token, slots.tail.head.token) of {
                    true -> has_spaced_atom_literal_from(slots.tail, constraint_core@cons_slot(slots.head, reversed_prefix));
                    false -> (true, slots.tail.head.token.location)
                };
                false -> has_spaced_atom_literal_from(slots.tail, constraint_core@cons_slot(slots.head, reversed_prefix))
            }
        }
    }
}

fn has_spaced_atom_literal(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    has_spaced_atom_literal_from(slots, constraint_core@empty_list_slot())
}

fn slot_is_whitespace(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.lexeme == " " or slot.token.lexeme == "\t" or slot.token.lexeme == "\n" or slot.token.lexeme == "\r"
}

fn slot_is_horizontal_whitespace(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.lexeme == " " or slot.token.lexeme == "\t" or slot.token.lexeme == "\r"
}

fn skip_leading_whitespace_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slot_is_whitespace(slots.head) of {
            true -> skip_leading_whitespace_slots(slots.tail);
            false -> slots
        }
    }
}

fn skip_leading_horizontal_whitespace_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slot_is_horizontal_whitespace(slots.head) of {
            true -> skip_leading_horizontal_whitespace_slots(slots.tail);
            false -> slots
        }
    }
}

fn is_record_field_name_token(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    lexer_token_kind@is_identifier_lexeme_token(tok.kind) or tok.kind == lexer_token_kind@token_kind_buf_keyword() or tok.kind == lexer_token_kind@token_kind_ref_keyword() or tok.kind == lexer_token_kind@token_kind_region_keyword() or tok.kind == lexer_token_kind@token_kind_device_window_keyword() or tok.kind == lexer_token_kind@token_kind_atomic_keyword() or tok.kind == lexer_token_kind@token_kind_end_keyword()
}

fn brace_group_starts_record_like(slots_after_lbrace: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    first: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots_after_lbrace);
    case first.is_nil of {
        true -> false;
        false -> case is_record_field_name_token(first.head.token) of {
            true -> {
                after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(first.tail);
                case after_name.is_nil of {
                    true -> false;
                    false -> after_name.head.token.kind == lexer_token_kind@token_kind_colon()
                }
            };
            false -> false
        }
    }
}

fn token_is_invalid_after_record_last_item(tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> boolean {
    tok.kind == lexer_token_kind@token_kind_semicolon() or tok.lexeme == ";" or tok.kind == lexer_token_kind@token_kind_colon() or tok.lexeme == ":" or tok.kind == lexer_token_kind@token_kind_plus() or tok.lexeme == "+" or tok.kind == lexer_token_kind@token_kind_minus() or tok.lexeme == "-" or tok.kind == lexer_token_kind@token_kind_star() or tok.lexeme == "*" or tok.kind == lexer_token_kind@token_kind_slash() or tok.lexeme == "/" or tok.kind == lexer_token_kind@token_kind_percent() or tok.lexeme == "%" or tok.kind == lexer_token_kind@token_kind_equal() or tok.lexeme == "=" or tok.kind == lexer_token_kind@token_kind_less_than() or tok.lexeme == "<" or tok.kind == lexer_token_kind@token_kind_greater_than() or tok.lexeme == ">" or tok.kind == lexer_token_kind@token_kind_dot() or tok.lexeme == "." or tok.kind == lexer_token_kind@token_kind_at_sign() or tok.lexeme == "@" or tok.kind == lexer_token_kind@token_kind_left_paren() or tok.lexeme == "(" or tok.kind == lexer_token_kind@token_kind_right_paren() or tok.lexeme == ")" or tok.kind == lexer_token_kind@token_kind_left_bracket() or tok.lexeme == "[" or tok.kind == lexer_token_kind@token_kind_right_bracket() or tok.lexeme == "]" or tok.kind == lexer_token_kind@token_kind_unknown_char()
}

fn record_like_group_has_invalid_last_item_follower(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64, paren_depth: int64, bracket_depth: int64, has_top_level_bind_arrow: boolean) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
            true -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth + 1, paren_depth, bracket_depth, has_top_level_bind_arrow);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_brace() or slots.head.token.lexeme == "}" of {
                true -> case brace_depth <= 1 of {
                    true -> (false, parser_ast@zero_location(), "");
                    false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth - 1, paren_depth, bracket_depth, has_top_level_bind_arrow)
                };
                false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_paren() or slots.head.token.lexeme == "(" of {
                    true -> {
                        after_bad_lp: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail);
                        case brace_depth == 1 and paren_depth == 0 and bracket_depth == 0 and after_bad_lp.is_nil == false and (after_bad_lp.head.token.kind == lexer_token_kind@token_kind_right_brace() or after_bad_lp.head.token.lexeme == "}") and has_top_level_bind_arrow == false of {
                            true -> (true, slots.head.token.location, slots.head.token.lexeme);
                            false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth + 1, bracket_depth, has_top_level_bind_arrow)
                        }
                    };
                    false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_paren() or slots.head.token.lexeme == ")" of {
                        true -> case paren_depth > 0 of {
                            true -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth - 1, bracket_depth, has_top_level_bind_arrow);
                            false -> {
                                after_bad_rp: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail);
                                case brace_depth == 1 and bracket_depth == 0 and after_bad_rp.is_nil == false and (after_bad_rp.head.token.kind == lexer_token_kind@token_kind_right_brace() or after_bad_rp.head.token.lexeme == "}") and has_top_level_bind_arrow == false of {
                                    true -> (true, slots.head.token.location, slots.head.token.lexeme);
                                    false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, has_top_level_bind_arrow)
                                }
                            }
                        };
                        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() or slots.head.token.lexeme == "[" of {
                            true -> {
                                after_bad_lb: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail);
                                case brace_depth == 1 and paren_depth == 0 and bracket_depth == 0 and after_bad_lb.is_nil == false and (after_bad_lb.head.token.kind == lexer_token_kind@token_kind_right_brace() or after_bad_lb.head.token.lexeme == "}") and has_top_level_bind_arrow == false of {
                                    true -> (true, slots.head.token.location, slots.head.token.lexeme);
                                    false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth + 1, has_top_level_bind_arrow)
                                }
                            };
                            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() or slots.head.token.lexeme == "]" of {
                                true -> case bracket_depth > 0 of {
                                    true -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth - 1, has_top_level_bind_arrow);
                                    false -> {
                                        after_bad_rb: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail);
                                        case brace_depth == 1 and paren_depth == 0 and after_bad_rb.is_nil == false and (after_bad_rb.head.token.kind == lexer_token_kind@token_kind_right_brace() or after_bad_rb.head.token.lexeme == "}") and has_top_level_bind_arrow == false of {
                                            true -> (true, slots.head.token.location, slots.head.token.lexeme);
                                            false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, has_top_level_bind_arrow)
                                        }
                                    }
                                };
                                false -> case brace_depth == 1 and paren_depth == 0 and bracket_depth == 0 and slots.head.token.kind == lexer_token_kind@token_kind_left_arrow() of {
                                    true -> {
                                        record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, true)
                                    };
                                    false -> case brace_depth == 1 and paren_depth == 0 and bracket_depth == 0 and token_is_invalid_after_record_last_item(slots.head.token) of {
                                        true -> {
                                            after_bad: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail);
                                            case after_bad.is_nil of {
                                                true -> (false, parser_ast@zero_location(), "");
                                                false -> case after_bad.head.token.kind == lexer_token_kind@token_kind_right_brace() or after_bad.head.token.lexeme == "}" of {
                                                    true -> case has_top_level_bind_arrow == false of {
                                                        true -> (true, slots.head.token.location, slots.head.token.lexeme);
                                                        false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, has_top_level_bind_arrow)
                                                    };
                                                    false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, has_top_level_bind_arrow)
                                                }
                                            }
                                        };
                                        false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, has_top_level_bind_arrow)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_struct_record_invalid_last_item_follower(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
            true -> case brace_group_starts_record_like(slots.tail) of {
                true -> {
                    (found: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, bad_token: string) <- record_like_group_has_invalid_last_item_follower(slots.tail, 1, 0, 0, false);
                    case found of {
                        true -> (true, loc, bad_token);
                        false -> has_struct_record_invalid_last_item_follower(slots.tail)
                    }
                };
                false -> has_struct_record_invalid_last_item_follower(slots.tail)
            };
            false -> has_struct_record_invalid_last_item_follower(slots.tail)
        }
    }
}

fn slots_after_matching_rparen(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
            true -> slots_after_matching_rparen(slots.tail, depth + 1);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_paren() of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> slots_after_matching_rparen(slots.tail, depth - 1)
                };
                false -> slots_after_matching_rparen(slots.tail, depth)
            }
        }
    }
}

fn slots_have_function_body_lbrace_on_line(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], paren_depth: int64, bracket_depth: int64, source_line: int64) -> boolean {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_horizontal_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> false;
        false -> case trimmed.head.token.location.line != source_line of {
            true -> false;
            false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
                true -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth + 1, bracket_depth, source_line);
                false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_paren() of {
                    true -> case paren_depth <= 0 of {
                        true -> false;
                        false -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth - 1, bracket_depth, source_line)
                    };
                    false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                        true -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth, bracket_depth + 1, source_line);
                        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_bracket() of {
                            true -> case bracket_depth <= 0 of {
                                true -> false;
                                false -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth, bracket_depth - 1, source_line)
                            };
                            false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_brace() of {
                                true -> paren_depth == 0 and bracket_depth == 0;
                                false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_semicolon() of {
                                    true -> false;
                                    false -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth, bracket_depth, source_line)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn slots_start_missing_fn_signature(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> false;
        false -> case lexer_token_kind@is_identifier_lexeme_token(trimmed.head.token.kind) of {
            false -> false;
            true -> {
                after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                case after_name.is_nil of {
                    true -> false;
                    false -> case after_name.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
                        false -> false;
                        true -> {
                            after_params: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots_after_matching_rparen(after_name.tail, 1));
                            case after_params.is_nil of {
                                true -> false;
                                false -> case after_params.head.token.kind == lexer_token_kind@token_kind_right_arrow() of {
                                    true -> slots_have_function_body_lbrace_on_line(after_params.tail, 0, 0, trimmed.head.token.location.line);
                                    false -> false
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_missing_fn_prefix_at_depth(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_brace() of {
            true -> has_missing_fn_prefix_at_depth(trimmed.tail, brace_depth + 1);
            false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_brace() of {
                true -> case brace_depth <= 0 of {
                    true -> has_missing_fn_prefix_at_depth(trimmed.tail, 0);
                    false -> has_missing_fn_prefix_at_depth(trimmed.tail, brace_depth - 1)
                };
                false -> case brace_depth == 0 and slots_start_missing_fn_signature(trimmed) of {
                    true -> (true, trimmed.head.token.location, trimmed.head.token.lexeme);
                    false -> case brace_depth == 0 and trimmed.head.token.kind == lexer_token_kind@token_kind_fn_keyword() of {
                        true -> {
                            after_fn: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                            case after_fn.is_nil of {
                                true -> (false, parser_ast@zero_location(), "");
                                false -> has_missing_fn_prefix_at_depth(after_fn.tail, brace_depth)
                            }
                        };
                        false -> has_missing_fn_prefix_at_depth(trimmed.tail, brace_depth)
                    }
                }
            }
        }
    }
}

fn has_missing_fn_prefix(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    has_missing_fn_prefix_at_depth(slots, 0)
}

fn has_named_struct_declaration(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_struct_keyword() of {
            true -> {
                after_struct: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                case after_struct.is_nil of {
                    true -> (true, trimmed.head.token.location, "");
                    false -> case lexer_token_kind@is_identifier_lexeme_token(after_struct.head.token.kind) of {
                        true -> (true, trimmed.head.token.location, after_struct.head.token.lexeme);
                        false -> (true, trimmed.head.token.location, "")
                    }
                }
            };
            false -> has_named_struct_declaration(trimmed.tail)
        }
    }
}

// §3.4.2: named construction `Name { field: … }` is ill-formed; records are anonymous `{ field: … }`.
// Skip `-> Name {` (function body after a named return-type spelling).
fn slots_start_named_struct_construction(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case lexer_token_kind@is_identifier_lexeme_token(trimmed.head.token.kind) of {
            false -> (false, parser_ast@zero_location(), "");
            true -> {
                after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                case after_name.is_nil of {
                    true -> (false, parser_ast@zero_location(), "");
                    false -> case after_name.head.token.kind == lexer_token_kind@token_kind_left_brace() or after_name.head.token.lexeme == "{" of {
                        false -> (false, parser_ast@zero_location(), "");
                        true -> {
                            after_lbrace: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_name.tail);
                            case after_lbrace.is_nil of {
                                true -> (false, parser_ast@zero_location(), "");
                                false -> case lexer_token_kind@is_identifier_lexeme_token(after_lbrace.head.token.kind) of {
                                    false -> (false, parser_ast@zero_location(), "");
                                    true -> {
                                        after_field: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_lbrace.tail);
                                        case after_field.is_nil of {
                                            true -> (false, parser_ast@zero_location(), "");
                                            false -> case token_starts_with_colon(after_field.head.token) of {
                                                true -> (true, trimmed.head.token.location, trimmed.head.token.lexeme);
                                                false -> (false, parser_ast@zero_location(), "")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_named_struct_construction_walk(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], prev_was_arrow: boolean) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slot_is_whitespace(slots.head) of {
            true -> has_named_struct_construction_walk(slots.tail, prev_was_arrow);
            false -> {
                is_arrow: boolean <- slots.head.token.kind == lexer_token_kind@token_kind_right_arrow() or slots.head.token.lexeme == "->";
                case prev_was_arrow of {
                    true -> has_named_struct_construction_walk(slots.tail, is_arrow);
                    false -> {
                        (hit: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, name: string) <- slots_start_named_struct_construction(slots);
                        case hit of {
                            true -> (true, loc, name);
                            false -> has_named_struct_construction_walk(slots.tail, is_arrow)
                        }
                    }
                }
            }
        }
    }
}

fn has_named_struct_construction(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    has_named_struct_construction_walk(slots, false)
}

// After `List[`, scan for the matching `]` (nested `[` / `]` counted). False if EOF first.
fn list_bracket_group_closes(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() or slots.head.token.lexeme == "[" of {
            true -> list_bracket_group_closes(slots.tail, depth + 1);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() or slots.head.token.lexeme == "]" of {
                true -> case depth == 1 of {
                    true -> true;
                    false -> case depth > 1 of {
                        true -> list_bracket_group_closes(slots.tail, depth - 1);
                        false -> false
                    }
                };
                false -> list_bracket_group_closes(slots.tail, depth)
            }
        }
    }
}

// `List[` without a matching `]` (e.g. `List[ { … }` with no `]`) falls through to a misleading later error.
fn has_incomplete_list_bracket_walk(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_list_keyword() or slots.head.token.lexeme == "List" of {
            true -> {
                after_list: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots.tail);
                case after_list.is_nil of {
                    true -> has_incomplete_list_bracket_walk(slots.tail);
                    false -> case after_list.head.token.kind == lexer_token_kind@token_kind_left_bracket() or after_list.head.token.lexeme == "[" of {
                        true -> case list_bracket_group_closes(after_list.tail, 1) of {
                            true -> has_incomplete_list_bracket_walk(slots.tail);
                            false -> (true, after_list.head.token.location)
                        };
                        false -> has_incomplete_list_bracket_walk(slots.tail)
                    }
                }
            };
            false -> has_incomplete_list_bracket_walk(slots.tail)
        }
    }
}

fn has_incomplete_list_bracket(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    has_incomplete_list_bracket_walk(slots)
}

// `-> List {` is incomplete: List requires type arguments `List[T, mem(S)]` before the body `{`.
fn has_incomplete_list_return_type(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_arrow() or trimmed.head.token.lexeme == "->" of {
            true -> {
                after_arrow: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                case after_arrow.is_nil of {
                    true -> (false, parser_ast@zero_location());
                    false -> case after_arrow.head.token.kind == lexer_token_kind@token_kind_list_keyword() or after_arrow.head.token.lexeme == "List" of {
                        true -> {
                            after_list: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_arrow.tail);
                            case after_list.is_nil of {
                                true -> (false, parser_ast@zero_location());
                                false -> case after_list.head.token.kind == lexer_token_kind@token_kind_left_brace() or after_list.head.token.lexeme == "{" of {
                                    true -> (true, after_arrow.head.token.location);
                                    false -> has_incomplete_list_return_type(trimmed.tail)
                                }
                            }
                        };
                        false -> has_incomplete_list_return_type(trimmed.tail)
                    }
                }
            };
            false -> has_incomplete_list_return_type(trimmed.tail)
        }
    }
}

// §3.4.2: `type Name = …` introduces a custom type name and is ill-formed.
fn has_named_type_alias_declaration(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case lexer_token_kind@is_identifier_lexeme_token(trimmed.head.token.kind) of {
            true -> case trimmed.head.token.lexeme == "type" of {
                true -> {
                    after_type: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                    case after_type.is_nil of {
                        true -> has_named_type_alias_declaration(trimmed.tail);
                        false -> case lexer_token_kind@is_identifier_lexeme_token(after_type.head.token.kind) of {
                            true -> {
                                after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_type.tail);
                                case after_name.is_nil of {
                                    true -> has_named_type_alias_declaration(trimmed.tail);
                                    false -> case after_name.head.token.kind == lexer_token_kind@token_kind_equal() of {
                                        true -> (true, trimmed.head.token.location, after_type.head.token.lexeme);
                                        false -> has_named_type_alias_declaration(trimmed.tail)
                                    }
                                }
                            };
                            false -> has_named_type_alias_declaration(trimmed.tail)
                        }
                    }
                };
                false -> has_named_type_alias_declaration(trimmed.tail)
            };
            false -> has_named_type_alias_declaration(trimmed.tail)
        }
    }
}

fn skip_bracketed_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> skip_bracketed_slots(slots.tail, depth + 1);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> skip_bracketed_slots(slots.tail, depth - 1)
                };
                false -> skip_bracketed_slots(slots.tail, depth)
            }
        }
    }
}

fn sequence_has_empty_proc_effect_list(slots_after_sequence: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    after_seq: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots_after_sequence);
    case after_seq.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case after_seq.head.token.kind == lexer_token_kind@token_kind_proc_keyword() or after_seq.head.token.lexeme == "proc" of {
            true -> {
                proc_loc: { file: string, line: int64, column: int64, offset: int64 } <- after_seq.head.token.location;
                after_proc: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_seq.tail);
                case after_proc.is_nil of {
                    true -> (false, parser_ast@zero_location());
                    false -> case after_proc.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                        true -> {
                            after_lbr: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_proc.tail);
                            case after_lbr.is_nil of {
                                true -> (false, parser_ast@zero_location());
                                false -> case after_lbr.head.token.kind == lexer_token_kind@token_kind_right_bracket() of {
                                    true -> (true, proc_loc);
                                    false -> (false, parser_ast@zero_location())
                                }
                            }
                        };
                        false -> (false, parser_ast@zero_location())
                    }
                }
            };
            false -> (false, parser_ast@zero_location())
        }
    }
}

fn slots_after_sequence_prefix(slots_after_sequence: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    after_seq: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots_after_sequence);
    case after_seq.is_nil of {
        true -> after_seq;
        false -> case after_seq.head.token.kind == lexer_token_kind@token_kind_proc_keyword() or after_seq.head.token.lexeme == "proc" of {
            true -> {
                after_proc: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_seq.tail);
                case after_proc.is_nil of {
                    true -> after_proc;
                    false -> case after_proc.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                        true -> skip_leading_whitespace_slots(skip_bracketed_slots(after_proc, 0));
                        false -> after_seq
                    }
                }
            };
            false -> after_seq
        }
    }
}

// Sequence-keyword check (E1048-E1056) as a recursive descent over the token slots: a block is
// checked where its `sequence` keyword is met, braced or not, at any depth, and the scan resumes
// after that block's `end`. The enclosing block therefore never takes a nested block's `produces` /
// `end`, and a nested block never takes the enclosing block's: a nested block that runs into the
// enclosing block's `produces`, or into the `}` closing a function literal or case arm, is reported
// there. A check result carries the error (if any) and the slots the enclosing scan resumes at.
fn seq_check_ok(rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } {
    { err: false, loc: parser_ast@zero_location(), code: "", msg: "", rest: rest }
}

fn seq_check_err(loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } {
    { err: true, loc: loc, code: code, msg: msg, rest: rest }
}

fn slot_is_sequence_keyword(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.kind == lexer_token_kind@token_kind_sequence_keyword() or slot.token.lexeme == "sequence"
}

fn slot_is_produces_keyword(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.kind == lexer_token_kind@token_kind_produces_keyword() or slot.token.lexeme == "produces"
}

fn slot_is_pure_keyword(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.kind == lexer_token_kind@token_kind_pure_keyword() or slot.token.lexeme == "pure"
}

fn slot_is_end_keyword(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.kind == lexer_token_kind@token_kind_end_keyword() or slot.token.lexeme == "end"
}

fn slot_is_left_brace(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.kind == lexer_token_kind@token_kind_left_brace() or slot.token.lexeme == "{"
}

fn slot_is_right_brace(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> boolean {
    slot.token.kind == lexer_token_kind@token_kind_right_brace() or slot.token.lexeme == "}"
}

fn seq_missing_produces_msg() -> string {
    "sequence block is missing 'produces'; write 'sequence ... produces pure <expr> end'"
}

fn seq_missing_pure_msg() -> string {
    "sequence produces clause is missing 'pure'; write 'produces pure <expr> end'"
}

fn seq_missing_end_msg() -> string {
    "sequence block is missing closing 'end'; write 'sequence ... produces pure <expr> end'"
}

fn seq_stray_produces_msg() -> string {
    "'produces' appears without a preceding 'sequence'; write 'sequence ... produces pure <expr> end'"
}

// The body of a block, from after its `sequence proc[...]` prefix to its `produces` at brace depth 0.
// A nested block is checked where it starts and skipped as a whole. The result rests at `produces`.
fn scan_sequence_body(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64, seq_loc: { file: string, line: int64, column: int64, offset: int64 }) -> { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> seq_check_err(seq_loc, "E1049", seq_missing_produces_msg(), trimmed);
        false -> case slot_is_sequence_keyword(trimmed.head) of {
            true -> {
                inner: { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- check_sequence_block(trimmed);
                case inner.err of {
                    true -> inner;
                    false -> scan_sequence_body(inner.rest, brace_depth, seq_loc)
                }
            };
            false -> case slot_is_produces_keyword(trimmed.head) of {
                true -> case brace_depth == 0 of {
                    true -> seq_check_ok(trimmed);
                    false -> seq_check_err(trimmed.head.token.location, "E1048", seq_stray_produces_msg(), trimmed)
                };
                false -> case slot_is_right_brace(trimmed.head) of {
                    true -> case brace_depth <= 0 of {
                        true -> seq_check_err(seq_loc, "E1049", seq_missing_produces_msg(), trimmed);
                        false -> scan_sequence_body(trimmed.tail, brace_depth - 1, seq_loc)
                    };
                    false -> case slot_is_left_brace(trimmed.head) of {
                        true -> scan_sequence_body(trimmed.tail, brace_depth + 1, seq_loc);
                        false -> scan_sequence_body(trimmed.tail, brace_depth, seq_loc)
                    }
                }
            }
        }
    }
}

// The `pure` expression of a block, up to its `end` at brace depth 0; nested blocks as above.
// Running into a `produces` at depth 0 or into the closing `}` means this block has no `end`.
// The result rests at `end`.
fn scan_sequence_pure_expr(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], brace_depth: int64) -> { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> seq_check_err(parser_ast@zero_location(), "E1051", seq_missing_end_msg(), trimmed);
        false -> case slot_is_sequence_keyword(trimmed.head) of {
            true -> {
                inner: { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- check_sequence_block(trimmed);
                case inner.err of {
                    true -> inner;
                    false -> scan_sequence_pure_expr(inner.rest, brace_depth)
                }
            };
            false -> case slot_is_end_keyword(trimmed.head) of {
                true -> case brace_depth == 0 of {
                    true -> seq_check_ok(trimmed);
                    false -> scan_sequence_pure_expr(trimmed.tail, brace_depth)
                };
                false -> case slot_is_produces_keyword(trimmed.head) of {
                    true -> case brace_depth == 0 of {
                        true -> seq_check_err(trimmed.head.token.location, "E1051", seq_missing_end_msg(), trimmed);
                        false -> seq_check_err(trimmed.head.token.location, "E1048", seq_stray_produces_msg(), trimmed)
                    };
                    false -> case slot_is_right_brace(trimmed.head) of {
                        true -> case brace_depth <= 0 of {
                            true -> seq_check_err(trimmed.head.token.location, "E1051", seq_missing_end_msg(), trimmed);
                            false -> scan_sequence_pure_expr(trimmed.tail, brace_depth - 1)
                        };
                        false -> case slot_is_left_brace(trimmed.head) of {
                            true -> scan_sequence_pure_expr(trimmed.tail, brace_depth + 1);
                            false -> scan_sequence_pure_expr(trimmed.tail, brace_depth)
                        }
                    }
                }
            }
        }
    }
}

// After a block's `end`: a second `end` is E1054; anything else belongs to the enclosing scan.
fn check_sequence_after_end(after_end: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_end);
    case trimmed.is_nil of {
        true -> seq_check_ok(trimmed);
        false -> case slot_is_end_keyword(trimmed.head) of {
            true -> seq_check_err(trimmed.head.token.location, "E1054", "extra 'end' after sequence block; sequence blocks close with one 'end' and functions close with '}'", trimmed);
            false -> seq_check_ok(trimmed)
        }
    }
}

// `produces pure <expr> end` of a block; at_produces rests at the `produces` token.
fn check_sequence_produces_clause(at_produces: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } {
    produces_loc: { file: string, line: int64, column: int64, offset: int64 } <- at_produces.head.token.location;
    after_produces: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(at_produces.tail);
    case after_produces.is_nil of {
        true -> seq_check_err(produces_loc, "E1050", seq_missing_pure_msg(), after_produces);
        false -> case slot_is_produces_keyword(after_produces.head) of {
            true -> seq_check_err(after_produces.head.token.location, "E1053", "duplicate 'produces' keyword in sequence block; write 'produces pure <expr> end'", after_produces);
            false -> case slot_is_pure_keyword(after_produces.head) of {
                false -> seq_check_err(after_produces.head.token.location, "E1050", seq_missing_pure_msg(), after_produces);
                true -> {
                    pure_scan: { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- scan_sequence_pure_expr(after_produces.tail, 0);
                    case pure_scan.err of {
                        true -> pure_scan;
                        false -> check_sequence_after_end(pure_scan.rest.tail)
                    }
                }
            }
        }
    }
}

// One block, starting at its `sequence` keyword; the result rests after its `end`.
fn check_sequence_block(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } {
    seq_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
    (empty_proc: boolean, empty_proc_loc: { file: string, line: int64, column: int64, offset: int64 }) <- sequence_has_empty_proc_effect_list(slots.tail);
    case empty_proc of {
        true -> seq_check_err(empty_proc_loc, "E1056", "empty proc[] on a pure sequence block; omit proc when no effects are required — write 'sequence produces pure <expr> end' (spec §9.3.1)", slots.tail);
        false -> {
            after_prefix: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots_after_sequence_prefix(slots.tail);
            case after_prefix.is_nil of {
                true -> seq_check_err(seq_loc, "E1049", seq_missing_produces_msg(), after_prefix);
                false -> case slot_is_sequence_keyword(after_prefix.head) of {
                    true -> seq_check_err(after_prefix.head.token.location, "E1052", "duplicate 'sequence' keyword in sequence block; write a single 'sequence ... produces pure <expr> end'", after_prefix);
                    false -> {
                        body_scan: { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- scan_sequence_body(after_prefix, 0, seq_loc);
                        case body_scan.err of {
                            true -> body_scan;
                            false -> check_sequence_produces_clause(body_scan.rest)
                        }
                    }
                }
            }
        }
    }
}

fn has_malformed_sequence_keywords(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "", "");
        false -> case slot_is_sequence_keyword(trimmed.head) of {
            true -> {
                checked: { err: boolean, loc: { file: string, line: int64, column: int64, offset: int64 }, code: string, msg: string, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- check_sequence_block(trimmed);
                case checked.err of {
                    true -> (true, checked.loc, checked.code, checked.msg);
                    false -> has_malformed_sequence_keywords(checked.rest)
                }
            };
            false -> case slot_is_produces_keyword(trimmed.head) of {
                true -> (true, trimmed.head.token.location, "E1048", seq_stray_produces_msg());
                false -> has_malformed_sequence_keywords(trimmed.tail)
            }
        }
    }
}

fn has_sequence_keyword_error(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    has_malformed_sequence_keywords(slots)
}

// True when, starting at slots, a case-arm `->` appears at depth 0 before `;` or `}`.
fn has_case_arrow_before_semi_or_rbrace(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], paren_depth: int64, bracket_depth: int64, brace_depth: int64) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> {
            tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- slots.head.token;
            next_paren: int64 <- case tok.kind == lexer_token_kind@token_kind_left_paren() or tok.lexeme == "(" of {
                true -> paren_depth + 1;
                false -> case tok.kind == lexer_token_kind@token_kind_right_paren() or tok.lexeme == ")" of {
                    true -> case paren_depth <= 0 of { true -> 0; false -> paren_depth - 1 };
                    false -> paren_depth
                }
            };
            next_bracket: int64 <- case tok.kind == lexer_token_kind@token_kind_left_bracket() or tok.lexeme == "[" of {
                true -> bracket_depth + 1;
                false -> case tok.kind == lexer_token_kind@token_kind_right_bracket() or tok.lexeme == "]" of {
                    true -> case bracket_depth <= 0 of { true -> 0; false -> bracket_depth - 1 };
                    false -> bracket_depth
                }
            };
            next_brace: int64 <- case tok.kind == lexer_token_kind@token_kind_left_brace() or tok.lexeme == "{" of {
                true -> brace_depth + 1;
                false -> case tok.kind == lexer_token_kind@token_kind_right_brace() or tok.lexeme == "}" of {
                    true -> case brace_depth <= 0 of { true -> 0; false -> brace_depth - 1 };
                    false -> brace_depth
                }
            };
            case paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 of {
                true -> case tok.kind == lexer_token_kind@token_kind_right_arrow() or tok.lexeme == "->" of {
                    true -> true;
                    false -> case tok.kind == lexer_token_kind@token_kind_semicolon() or tok.lexeme == ";" or tok.kind == lexer_token_kind@token_kind_right_brace() or tok.lexeme == "}" of {
                        true -> false;
                        false -> has_case_arrow_before_semi_or_rbrace(slots.tail, next_paren, next_bracket, next_brace)
                    }
                };
                false -> has_case_arrow_before_semi_or_rbrace(slots.tail, next_paren, next_bracket, next_brace)
            }
        }
    }
}

// After a depth-0 `;` in an unbraced case arm: true if that `;` terminates the arm (next arm or `}`).
fn unbraced_case_semi_terminates_arm(after_semi: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_semi);
    case rest.is_nil of {
        true -> true;
        false -> case rest.head.token.kind == lexer_token_kind@token_kind_right_brace() or rest.head.token.lexeme == "}" of {
            true -> true;
            false -> has_case_arrow_before_semi_or_rbrace(rest, 0, 0, 0)
        }
    }
}

// Scan unbraced case-arm RHS for an internal `;` (multi-statement, including one line with `;` between exprs).
// Expression continuations across lines (e.g. `and` / `+`) are allowed without braces.
fn unbraced_case_rhs_has_internal_semi(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], paren_depth: int64, bracket_depth: int64, brace_depth: int64) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slot_is_whitespace(slots.head) of {
            true -> unbraced_case_rhs_has_internal_semi(slots.tail, paren_depth, bracket_depth, brace_depth);
            false -> {
                tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- slots.head.token;
                next_paren: int64 <- case tok.kind == lexer_token_kind@token_kind_left_paren() or tok.lexeme == "(" of {
                    true -> paren_depth + 1;
                    false -> case tok.kind == lexer_token_kind@token_kind_right_paren() or tok.lexeme == ")" of {
                        true -> case paren_depth <= 0 of { true -> 0; false -> paren_depth - 1 };
                        false -> paren_depth
                    }
                };
                next_bracket: int64 <- case tok.kind == lexer_token_kind@token_kind_left_bracket() or tok.lexeme == "[" of {
                    true -> bracket_depth + 1;
                    false -> case tok.kind == lexer_token_kind@token_kind_right_bracket() or tok.lexeme == "]" of {
                        true -> case bracket_depth <= 0 of { true -> 0; false -> bracket_depth - 1 };
                        false -> bracket_depth
                    }
                };
                next_brace: int64 <- case tok.kind == lexer_token_kind@token_kind_left_brace() or tok.lexeme == "{" of {
                    true -> brace_depth + 1;
                    false -> case tok.kind == lexer_token_kind@token_kind_right_brace() or tok.lexeme == "}" of {
                        true -> case brace_depth <= 0 of { true -> 0; false -> brace_depth - 1 };
                        false -> brace_depth
                    }
                };
                case paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 of {
                    true -> case tok.kind == lexer_token_kind@token_kind_semicolon() or tok.lexeme == ";" of {
                        true -> case unbraced_case_semi_terminates_arm(slots.tail) of {
                            true -> (false, parser_ast@zero_location());
                            false -> (true, tok.location)
                        };
                        false -> case tok.kind == lexer_token_kind@token_kind_right_brace() or tok.lexeme == "}" of {
                            true -> (false, parser_ast@zero_location());
                            false -> case has_case_arrow_before_semi_or_rbrace(slots, 0, 0, 0) of {
                                true -> (false, parser_ast@zero_location());
                                false -> unbraced_case_rhs_has_internal_semi(slots.tail, next_paren, next_bracket, next_brace)
                            }
                        }
                    };
                    false -> unbraced_case_rhs_has_internal_semi(slots.tail, next_paren, next_bracket, next_brace)
                }
            }
        }
    }
}

fn check_case_arm_arrow_rhs(after_arrow: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(after_arrow);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_brace() or trimmed.head.token.lexeme == "{" of {
            true -> (false, parser_ast@zero_location());
            false -> unbraced_case_rhs_has_internal_semi(trimmed, 0, 0, 0)
        }
    }
}

// Walk tokens; inside `case … of { … }`, reject unbraced multi-statement / multi-line arm RHSs (E1064).
fn has_unbraced_multiline_case_arm_walk(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], after_of: boolean, case_brace_depth: int64) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slot_is_whitespace(slots.head) of {
            true -> has_unbraced_multiline_case_arm_walk(slots.tail, after_of, case_brace_depth);
            false -> {
                tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- slots.head.token;
                case tok.kind == lexer_token_kind@token_kind_of_keyword() or tok.lexeme == "of" of {
                    true -> has_unbraced_multiline_case_arm_walk(slots.tail, true, case_brace_depth);
                    false -> case after_of and (tok.kind == lexer_token_kind@token_kind_left_brace() or tok.lexeme == "{") of {
                        true -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth + 1);
                        false -> case case_brace_depth > 0 of {
                            true -> case tok.kind == lexer_token_kind@token_kind_left_brace() or tok.lexeme == "{" of {
                                true -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth + 1);
                                false -> case tok.kind == lexer_token_kind@token_kind_right_brace() or tok.lexeme == "}" of {
                                    true -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth - 1);
                                    false -> case case_brace_depth == 1 and (tok.kind == lexer_token_kind@token_kind_right_arrow() or tok.lexeme == "->") of {
                                        true -> {
                                            (bad: boolean, bad_loc: { file: string, line: int64, column: int64, offset: int64 }) <- check_case_arm_arrow_rhs(slots.tail);
                                            case bad of {
                                                true -> (true, bad_loc);
                                                false -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth)
                                            }
                                        };
                                        false -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth)
                                    }
                                }
                            };
                            false -> has_unbraced_multiline_case_arm_walk(slots.tail, false, 0)
                        }
                    }
                }
            }
        }
    }
}

fn has_unbraced_multiline_case_arm(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    has_unbraced_multiline_case_arm_walk(slots, false, 0)
}

// Case-arm / expression `-> sequence ... produces pure ... end` is not allowed; use `-> { ... }` for pure multi-step arms.
fn has_arrow_sequence_case_rhs(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case trimmed.tail.is_nil of {
            true -> (false, parser_ast@zero_location());
            false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_arrow() or trimmed.head.token.lexeme == "->" of {
                true -> {
                    after_arrow: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- skip_leading_whitespace_slots(trimmed.tail);
                    case after_arrow.is_nil of {
                        true -> (false, parser_ast@zero_location());
                        false -> case after_arrow.head.token.kind == lexer_token_kind@token_kind_sequence_keyword() or after_arrow.head.token.lexeme == "sequence" of {
                            true -> (true, after_arrow.head.token.location);
                            false -> has_arrow_sequence_case_rhs(trimmed.tail)
                        }
                    }
                };
                false -> has_arrow_sequence_case_rhs(trimmed.tail)
            }
        }
    }
}


fn parse_program(tokens: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
