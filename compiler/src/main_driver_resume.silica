// Resume one remaining topo unit after process-per-unit reclaim.

use module_checker_core;
use main_lists;
use main_parse;
use main_unit;
use main_hygiene;
use main_crash;

export resume_compile_order/2;

fn resume_compile_order(order: List[string, mem(normal)], all_config_files: List[string, mem(normal)]) -> int64 {
    sequence
        result: int64 <- {
            case order.is_nil of {
                true -> main_hygiene@finish_batch_artifacts();
                // The compiler crashed on this unit in an earlier process of this batch: recorded, skipped.
                false -> case main_crash@is_crashed(order.head) of {
                    true -> resume_compile_order(order.tail, all_config_files);
                    false -> {
                        (ok: boolean, parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) <- main_parse@parse_use_closure_work(
                            module_checker_core@cons_string(order.head, module_checker_core@empty_list_string()),
                            all_config_files,
                            module_checker_core@empty_parsed_files()
                        );
                        case ok of {
                            false -> 1;
                            true -> {
                                (code: int64, unit_rt: boolean) <- main_unit@compile_one_sorted_unit(order.head, parsed, all_config_files);
                                case code != 0 of {
                                    true -> code;
                                    false -> main_hygiene@after_unit_compiled(order.tail, unit_rt)
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}
