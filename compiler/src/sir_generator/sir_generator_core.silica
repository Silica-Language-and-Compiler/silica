// Core sir_generator infrastructure (base)
// Entry point: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } + { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } -> { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], trait_layouts: string, required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } (internal representation)
// Core+extensions pattern: orchestrates via dispatchers; no AST construct knowledge
// §19: module name (filename stem and/or explicit `module`), `use`, `export` recorded on { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], trait_layouts: string, required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }

use parser_ast;
use type_checker_core;
use sir_ast;
use dispatcher;
use traits;
use ffi;
use sir_device_calls;
use type_checker_collections;

export emit_program/2;
export emit_program_for_unit/3;
export emit_program_for_unit_with_link_libraries/5;

fn is_actor_runtime_prim(name: string) -> boolean {
    name == "spawn" or name == "spawn_dangerous" or name == "add_child" or name == "send" or name == "actor_call" or name == "actor_call_registered" or name == "actor_cast" or name == "actor_cast_registered" or name == "actor_cast_dangerous_registered" or name == "self"
        or name == "recv"
        or name == "link" or name == "monitor" or name == "demonitor" or name == "supervision_ingress_enqueue"
        or name == "supervision_wait_and_drain_one" or name == "child_table_first_ref"
        or name == "child_table_row_ref"
        or name == "kill_abnormal"
        or name == "stop_self_normal" or name == "stop_self_explicit" or name == "fail_self"
        or name == "monotonic_time" or name == "current_time" or name == "send_after" or name == "timer_cast" or name == "cancel_timer"
        or name == "failure_reason_tag" or name == "failure_reason_atom"
        or name == "failure_agent_type" or name == "failure_release" or name == "start_child"
        or name == "supervisor_add_child" or name == "supervisor_remove_child" or name == "supervisor_restart_child"
        or name == "supervisor_terminate_child" or name == "supervisor_which_children" or name == "supervisor_count_children"
        or name == "supervisor_set_report_sink"
        or name == "supervisor_op_tag" or name == "supervisor_op_error" or name == "supervisor_op_child"
        or name == "supervisor_get_child" or name == "supervisor_get_child_info" or name == "supervisor_get_child_id" or name == "supervisor_get_child_agent_type"
        or name == "supervisor_get_child_restart"
        or name == "pin_actor_to_core" or name == "pin_actor_to_efficiency_core" or name == "pin_actor_to_performance_core"
        or name == "pin_actor_realtime" or name == "remove_actor" or name == "register_actor" or name == "get_registry_actor" or name == "get_pid_registry" or name == "pin_actor_to_numa_node"
        or name == "unpin_actor" or name == "set_actor_priority" or name == "set_scheduler_policy"
        or name == "get_cpu_topology" or name == "get_efficiency_cores" or name == "get_performance_cores"
        or name == "get_core_capabilities"
        or name == "get_actor_memory_usage"
        or name == "migrate_actor"
        or name == "register_failure_reporter"
        or name == "wait_for_exit" or name == "cast_exit"
        or name == "state_area_bytes" or name == "compact_state" or name == "actor_carrier_index"
        or name == "spawn_device" or name == "spawn_device_registered" or name == "actor_cast_device" or name == "actor_cast_device_registered"
        or name == "map_device" or name == "peek" or name == "poke"
        or name == "pin_mode" or name == "pin_pull" or name == "pin_write" or name == "pin_read"
}

fn sir_term_nodes_len_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head_local(nodes.tail, idx - 1)
        }
    }
}

fn sir_term_node_at_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len_local(nodes);
            sir_term_node_at_from_head_local(nodes, n - 1 - idx)
        }
    }
}

fn sir_term_uses_actor_runtime_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> boolean {
    case idx < 0 of {
        true -> false;
        false -> {
            term: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_node_at_local(nodes, idx);
            case term.kind < 0 of {
                true -> false;
                false -> case term.kind of {
                    6 -> is_actor_runtime_prim(term.name) or ((term.name == "div" or term.name == "rem") and (term.type_name == "int64" or term.type_name == "uint64" or term.type_name == "int32" or term.type_name == "uint32" or term.type_name == "int16" or term.type_name == "uint16" or term.type_name == "int8" or term.type_name == "uint8"));
                    2 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    3 -> true;
                    4 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    5 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    7 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    8 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    _: int64 -> false
                }
            }
        }
    }
}

fn sir_term_uses_actor_runtime(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    sir_term_uses_actor_runtime_at(term.nodes, term.root)
}

fn sir_functions_use_actor_runtime(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case sir_term_uses_actor_runtime(fns.head.body) of {
            true -> true;
            false -> sir_functions_use_actor_runtime(fns.tail)
        }
    }
}

fn runtime_dependencies_for_sir(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], sup_impls: List[string, mem(normal)]) -> List[string, mem(normal)] {
    needs_actor_runtime: boolean <- case sir_functions_use_actor_runtime(fns) of {
        true -> true;
        false -> case sup_impls.is_nil of {
            true -> false;
            false -> true
        }
    };
    case needs_actor_runtime of {
        true -> sir_ast@cons_sir_string("actor_runtime", sir_ast@nil_sir_strings());
        false -> sir_ast@nil_sir_strings()
    }
}

// Filename stem when known (§19.1.1); else "" to fall back on explicit `module` or "main"
fn module_name_for_sir(compilation_unit: string, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> string {
    case length_bytes(compilation_unit) > 0 of {
        true -> compilation_unit;
        false -> {
            ex: string <- explicit_module_decl_name(decls);
            case length_bytes(ex) > 0 of {
                true -> ex;
                false -> "main"
            }
        }
    }
}

fn explicit_module_decl_name(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> string {
    case decls.is_nil of {
        true -> "";
        false -> case decls.head.tag == 4 of {
            true -> decls.head.name;
            false -> explicit_module_decl_name(decls.tail)
        }
    }
}

fn append_sir_strings(a: List[string, mem(normal)], b: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> sir_ast@cons_sir_string(a.head, append_sir_strings(a.tail, b))
    }
}

fn params_to_used_modules(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[string, mem(normal)] {
    case params.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> sir_ast@cons_sir_string(params.head.name, params_to_used_modules(params.tail))
    }
}

fn collect_used_modules(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 2 of {
            true -> append_sir_strings(params_to_used_modules(decls.head.parameters), collect_used_modules(decls.tail));
            false -> collect_used_modules(decls.tail)
        }
    }
}

fn params_to_export_items(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ fn_name: string, arity: string }, mem(normal)] {
    case params.is_nil of {
        true -> sir_ast@nil_sir_exports();
        false -> {
            item: { fn_name: string, arity: string } <- { fn_name: params.head.name, arity: params.head.type_name };
            sir_ast@cons_sir_export(item, params_to_export_items(params.tail))
        }
    }
}

fn append_sir_exports(a: List[{ fn_name: string, arity: string }, mem(normal)], b: List[{ fn_name: string, arity: string }, mem(normal)]) -> List[{ fn_name: string, arity: string }, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> sir_ast@cons_sir_export(a.head, append_sir_exports(a.tail, b))
    }
}

fn collect_exports(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ fn_name: string, arity: string }, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_exports();
        false -> case decls.head.tag == 3 of {
            true -> append_sir_exports(params_to_export_items(decls.head.parameters), collect_exports(decls.tail));
            false -> collect_exports(decls.tail)
        }
    }
}

// Build SIR for a { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }. Returns { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], trait_layouts: string, required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } (internal representation).
// Precondition: type checking has succeeded; AST has no dummy nodes in traversed paths.
// Uses compilation unit name "" (see emit_program_for_unit).
fn emit_program(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], trait_layouts: string, required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } {
    emit_program_for_unit(program, context, "")
}

fn sir_string_list_to_csv(list: List[string, mem(normal)]) -> string {
    case list.is_nil of {
        true -> "";
        false -> case list.tail.is_nil of {
            true -> list.head;
            false -> concat(concat(list.head, ","), sir_string_list_to_csv(list.tail))
        }
    }
}

fn emit_program_for_unit(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, compilation_unit: string) -> { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], trait_layouts: string, required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } {
    emit_program_for_unit_with_link_libraries(program, context, compilation_unit, sir_ast@nil_sir_strings(), sir_device_calls@no_description_world())
}


// Project type-checker TypeContext env rows to the SIR-local simplified env
// (type_name from surface_type) expected by dispatcher@emit_declaration.
fn type_context_env_to_sir_env(env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)]) -> List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] {
    case env.is_nil of {
        true -> {
            sequence proc[mem(normal)]
                result: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- empty[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)]()
            produces
                pure result
            end
        };
        false -> {
            sequence proc[mem(normal)]
                h: { name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string } <- env.head;
                row: { name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string } <- { name: h.name, type_name: h.surface_type, declared_effects: h.declared_effects, is_effect_alias: h.is_effect_alias, source_module: h.source_module };
                rest: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- type_context_env_to_sir_env(env.tail);
                result: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- prepend[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)](row, rest)
            produces
                pure result
            end
        }
    }
}

fn type_context_to_sir_context(ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } {
    { env: type_context_env_to_sir_env(ctx.env) }
}

fn emit_program_for_unit_with_link_libraries(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, compilation_unit: string, link_libraries: List[string, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], trait_layouts: string, required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } {
    sup_impls: List[string, mem(normal)] <- traits@collect_supervisor_impl_types(program.declarations);
    sup_csv: string <- sir_string_list_to_csv(sup_impls);
    ctx_full: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@type_context_with_supervisor_types(context, sup_csv);
    ctx_emit0: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- type_context_to_sir_context(ctx_full);
    ctx_emit: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- { env: sir_device_calls@add_description_rows_from_world(sir_device_calls@add_description_rows(ctx_emit0.env, program), world) };
    fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] <- emit_declarations(program.declarations, ctx_emit, program.declarations);
    uses: List[string, mem(normal)] <- collect_used_modules(program.declarations);
    exps: List[{ fn_name: string, arity: string }, mem(normal)] <- collect_exports(program.declarations);
    trait_names: List[string, mem(normal)] <- traits@collect_export_trait_names(program.declarations);
    marker_impls: List[string, mem(normal)] <- traits@collect_marker_impl_types(program.declarations);
    sup_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)] <- traits@collect_supervisor_phase_e(program.declarations);
    fr_impls: List[string, mem(normal)] <- traits@collect_failure_reporter_impl_types(program.declarations);
    req_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)] <- traits@collect_required_trait_method_sigs(program.declarations);
    runtime_deps: List[string, mem(normal)] <- runtime_dependencies_for_sir(fns, sup_impls);
    wm_paths: List[string, mem(normal)] <- ffi@collect_wrapper_meta_paths(program.declarations);
    foreign_binds: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)] <- ffi@collect_foreign_bindings(program.declarations);
    nm: string <- module_name_for_sir(compilation_unit, program.declarations);
    // The implementing layout of every collection trait type the functions mention (tl_layouts_for_functions).
    layouts: string <- tl_layouts_for_functions(fns, world);
    is_dangerous: boolean <- ffi@module_name_is_dangerous(nm);
    { module_name: nm, used_modules: uses, exports: exps, export_trait_names: trait_names, marker_impl_types: marker_impls, supervisor_impl_types: sup_impls, supervisor_phase_e: sup_phase_e, failure_reporter_impl_types: fr_impls, trait_layouts: layouts, required_method_sigs: req_sigs, runtime_dependencies: runtime_deps, is_dangerous_module: is_dangerous, wrapper_meta_paths: wm_paths, foreign_bindings: foreign_binds, link_libraries: link_libraries, functions: fns }
}

// Traverse List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]; dispatcher delegates per { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }.tag.
// Dummy results (name == "") are skipped (e.g. non-function declarations).
fn emit_declarations(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, program_decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_functions();
        false -> {
            head_fn: { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string } <- dispatcher@emit_declaration(decls.head, context, program_decls);
            tail_fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] <- emit_declarations(decls.tail, context, program_decls);
            case length_bytes(head_fn.name) > 0 of {
                true -> sir_ast@cons_sir_functions(head_fn, tail_fns);
                false -> tail_fns
            }
        }
    }
}

// ---- trait-type layouts for the actor-boundary copier -------------------------------------------
//
// A collection trait type (`PriorityQueue[int64, string, mem(normal)]`, `OrderedMap[...]`, ...) names no
// layout, so the emitter's message and state copier (term_message_copy) cannot follow a value of it and
// refuses it (KIND 10). The value IS the record its registered construction module's constructor
// returns (type_checker_collections bracket_canonical_representation), so each trait spelling this unit's
// functions mention is recorded here with that record: the trait's parameters put for the module's
// placeholders (resolve_constructor_call_formal), and every trait spelling inside it expanded the same way.
// Entries `SPELLING=LAYOUT`, spaces removed (the emitter's prims_record@strip_spaces_rt form), `|` written
// `^` (the emitter carries the entries in its `|`-separated binding string), joined by `;`. A spelling with
// no construction module in the world, or with two modules whose records differ, gets no entry and stays
// refused. Only the emitter's descriptor builder reads the entries (trait_layouts of the SIR module).
fn tl_layouts_for_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> string {
    sps: string <- tl_collect_fns(fns, "\n");
    tl_entries(sps, 1, world, "")
}

fn tl_find(s: string, sub: string, i: int64) -> int64 {
    case i + length_bytes(sub) > length_bytes(s) of {
        true -> 0 - 1;
        false -> case substring(s, i, i + length_bytes(sub)) == sub of {
            true -> i;
            false -> tl_find(s, sub, i + 1)
        }
    }
}

// Spaces removed (prims_record@strip_spaces_rt's divide and conquer: O(n log n) bytes copied).
fn tl_strip(s: string) -> string {
    case contains(s, " ") of {
        false -> s;
        true -> tl_strip_range(s, 0, length_bytes(s))
    }
}

fn tl_strip_range(s: string, lo: int64, hi: int64) -> string {
    case hi - lo <= 48 of {
        true -> tl_strip_small(s, lo, hi, "");
        false -> {
            mid: int64 <- lo + (hi - lo) / 2;
            concat(tl_strip_range(s, lo, mid), tl_strip_range(s, mid, hi))
        }
    }
}

fn tl_strip_small(s: string, i: int64, hi: int64, acc: string) -> string {
    case i >= hi of {
        true -> acc;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == " " of {
                true -> tl_strip_small(s, i + 1, hi, acc);
                false -> tl_strip_small(s, i + 1, hi, concat(acc, ch))
            }
        }
    }
}

fn tl_escape(s: string) -> string {
    case contains(s, "|") of {
        false -> s;
        true -> tl_escape_from(s, 0, "")
    }
}

fn tl_escape_from(s: string, i: int64, acc: string) -> string {
    j: int64 <- tl_find(s, "|", i);
    case j < 0 of {
        true -> concat(acc, substring(s, i, length_bytes(s)));
        false -> tl_escape_from(s, j + 1, concat(acc, concat(substring(s, i, j), "^")))
    }
}

// A cheap filter before any scan: the text names one of the ten trait families.
fn tl_may_name_trait(t: string) -> boolean {
    contains(t, "Tree") or contains(t, "Graph") or contains(t, "Heap") or contains(t, "Queue") or contains(t, "OrderedSet") or contains(t, "OrderedMap")
}

fn tl_ident_char(c: string) -> boolean {
    length_bytes(c) == 1 and contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c)
}

// Index where the identifier ending just before j starts (j itself when none does).
fn tl_ident_start(t: string, j: int64) -> int64 {
    case j > 0 and tl_ident_char(substring(t, j - 1, j)) of {
        true -> tl_ident_start(t, j - 1);
        false -> j
    }
}

// Index of the bracket that brings the nesting depth back to zero, scanning from i at `depth`, or the length.
fn tl_close(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> length_bytes(s);
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> tl_close(s, i + 1, depth + 1);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> case depth == 1 of {
                        true -> i;
                        false -> tl_close(s, i + 1, depth - 1)
                    };
                    false -> tl_close(s, i + 1, depth)
                }
            }
        }
    }
}

// The whole bracket type whose `[` is at j (identifier included), or "" when none is spelled there.
fn tl_bracket_at(t: string, j: int64, start: int64) -> string {
    k: int64 <- tl_ident_start(t, j);
    c: int64 <- tl_close(t, j + 1, 1);
    case k < j and k >= start and c < length_bytes(t) of {
        true -> substring(t, k, c + 1);
        false -> ""
    }
}

fn tl_collect_fns(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], acc: string) -> string {
    case fns.is_nil of {
        true -> acc;
        false -> {
            a1: string <- tl_collect_type(fns.head.return_type, acc);
            a2: string <- tl_collect_type(fns.head.param_types, a1);
            a3: string <- tl_collect_nodes(fns.head.body.nodes, a2);
            tl_collect_fns(fns.tail, a3)
        }
    }
}

fn tl_collect_nodes(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], acc: string) -> string {
    case nodes.is_nil of {
        true -> acc;
        false -> tl_collect_nodes(nodes.tail, tl_collect_type(nodes.head.type_name, acc))
    }
}

// Every distinct trait spelling in one type, added to the set `acc` ("\nA\nB\n").
fn tl_collect_type(t0: string, acc: string) -> string {
    case tl_may_name_trait(t0) of {
        false -> acc;
        true -> tl_scan_collect(tl_strip(t0), 0, acc)
    }
}

fn tl_scan_collect(t: string, i: int64, acc: string) -> string {
    j: int64 <- tl_find(t, "[", i);
    case j < 0 of {
        true -> acc;
        false -> {
            sp: string <- tl_bracket_at(t, j, 0);
            nxt: string <- case length_bytes(sp) > 0 and type_checker_collections@is_collection_trait_type(sp) and contains(acc, concat("\n", concat(sp, "\n"))) == false of {
                true -> concat(acc, concat(sp, "\n"));
                false -> acc
            };
            tl_scan_collect(t, j + 1, nxt)
        }
    }
}

fn tl_entries(sps: string, i: int64, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], acc: string) -> string {
    e: int64 <- tl_find(sps, "\n", i);
    case e < 0 of {
        true -> acc;
        false -> {
            sp: string <- substring(sps, i, e);
            layout: string <- tl_resolve(sp, world, 6);
            nxt: string <- case length_bytes(layout) == 0 of {
                true -> acc;
                false -> {
                    entry: string <- concat(tl_escape(sp), concat("=", tl_escape(layout)));
                    case length_bytes(acc) == 0 of {
                        true -> entry;
                        false -> concat(acc, concat(";", entry))
                    }
                }
            };
            tl_entries(sps, e + 1, world, nxt)
        }
    }
}

// The implementing layout of one trait spelling, its nested trait spellings expanded; "" when the world
// has no construction module for it or two whose records differ.
fn tl_resolve(sp: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> string {
    case fuel <= 0 of {
        true -> "";
        false -> {
            one: string <- tl_single_line(tl_reps(sp, world, "\n", "\n"));
            case length_bytes(one) == 0 of {
                true -> "";
                false -> tl_expand(tl_strip(type_checker_collections@resolve_constructor_call_formal(sp, one)), world, fuel - 1)
            }
        }
    }
}

// The distinct constructor records ("\nR1\nR2\n") of the construction modules the family accepts, one per
// module name (a module may be in the world twice: its program and its interface stub).
fn tl_reps(sp: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], mods: string, texts: string) -> string {
    case world.is_nil of {
        true -> texts;
        false -> {
            m: string <- world.head.module_name;
            case contains(mods, concat("\n", concat(m, "\n"))) == false and type_checker_collections@collection_trait_accepts_module(sp, m) of {
                false -> tl_reps(sp, world.tail, mods, texts);
                true -> {
                    r: string <- tl_strip(tl_ctor_return(world.head.program.declarations));
                    texts2: string <- case length_bytes(r) == 0 or contains(texts, concat("\n", concat(r, "\n"))) of {
                        true -> texts;
                        false -> concat(texts, concat(r, "\n"))
                    };
                    mods2: string <- case length_bytes(r) == 0 of {
                        true -> mods;
                        false -> concat(mods, concat(m, "\n"))
                    };
                    tl_reps(sp, world.tail, mods2, texts2)
                }
            }
        }
    }
}

// The only line of a "\nR\n" set, or "" when it holds none or several.
fn tl_single_line(texts: string) -> string {
    e: int64 <- tl_find(texts, "\n", 1);
    case e > 1 and e == length_bytes(texts) - 1 of {
        true -> substring(texts, 1, e);
        false -> ""
    }
}

// The result type of a module's bracket constructor (empty / with_root), as bracket_rep_ctor_return.
fn tl_ctor_return(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> string {
    case decls.is_nil of {
        true -> "";
        false -> case decls.head.tag == 0 and (decls.head.name == "empty" or decls.head.name == "with_root") of {
            true -> decls.head.return_type_name;
            false -> tl_ctor_return(decls.tail)
        }
    }
}

// Each resolvable trait spelling inside `t` replaced by its layout; one that is not resolvable is kept and
// the scan goes on inside it.
fn tl_expand(t: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> string {
    case tl_may_name_trait(t) of {
        false -> t;
        true -> tl_expand_scan(t, 0, 0, "", world, fuel)
    }
}

fn tl_expand_scan(t: string, i: int64, start: int64, acc: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], fuel: int64) -> string {
    j: int64 <- tl_find(t, "[", i);
    case j < 0 of {
        true -> concat(acc, substring(t, start, length_bytes(t)));
        false -> {
            sp: string <- tl_bracket_at(t, j, start);
            layout: string <- case length_bytes(sp) > 0 and type_checker_collections@is_collection_trait_type(sp) of {
                true -> tl_resolve(sp, world, fuel);
                false -> ""
            };
            case length_bytes(layout) == 0 of {
                true -> tl_expand_scan(t, j + 1, start, acc, world, fuel);
                false -> {
                    k: int64 <- tl_ident_start(t, j);
                    c: int64 <- tl_close(t, j + 1, 1);
                    tl_expand_scan(t, c + 1, c + 1, concat(acc, concat(substring(t, start, k), layout)), world, fuel)
                }
            }
        }
    }
}
