    ctx_emit0: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- type_context_to_sir_context(ctx_full);
    ctx_emit: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- { env: sir_device_calls@add_description_rows_from_world(sir_device_calls@add_description_rows(ctx_emit0.env, program), world) };
    fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] <- emit_declarations(program.declarations, ctx_emit, program.declarations);
    uses: List[string, mem(normal)] <- collect_used_modules(program.declarations);
    exps: List[{ fn_name: string, arity: string }, mem(normal)] <- collect_exports(program.declarations);
    trait_names: List[string, mem(normal)] <- traits@collect_export_trait_names(program.declarations);
    marker_impls: List[string, mem(normal)] <- traits@collect_marker_impl_types(program.declarations);
    sup_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)] <- traits@collect_supervisor_phase_e(program.declarations);
    fr_impls: List[string, mem(normal)] <- traits@collect_failure_reporter_impl_types(program.declarations);
    req_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)] <- traits@collect_required_trait_method_sigs(program.declarations);
    runtime_deps: List[string, mem(normal)] <- runtime_dependencies_for_sir(fns, sup_impls);
    wm_paths: List[string, mem(normal)] <- ffi@collect_wrapper_meta_paths(program.declarations);
    foreign_binds: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)] <- ffi@collect_foreign_bindings(program.declarations);
    nm: string <- module_name_for_sir(compilation_unit, program.declarations);
