// Core sir_generator infrastructure (base)
// Entry point: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } + { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } -> { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } (internal representation)
// Core+extensions pattern: orchestrates via dispatchers; no AST construct knowledge
// §19: module name (filename stem and/or explicit `module`), `use`, `export` recorded on { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }

use parser_ast;
use type_checker_core;
use sir_ast;
use dispatcher;
use traits;
use ffi;
use sir_device_calls;

export emit_program/2;
export emit_program_for_unit/3;
export emit_program_for_unit_with_link_libraries/5;

fn is_actor_runtime_prim(name: string) -> boolean {
    name == "spawn" or name == "spawn_dangerous" or name == "add_child" or name == "send" or name == "actor_call" or name == "actor_call_registered" or name == "actor_cast" or name == "actor_cast_registered" or name == "actor_cast_dangerous_registered" or name == "self"
        or name == "recv"
        or name == "link" or name == "monitor" or name == "demonitor" or name == "supervision_ingress_enqueue"
        or name == "supervision_wait_and_drain_one" or name == "child_table_first_ref"
        or name == "child_table_row_ref"
        or name == "kill_abnormal"
        or name == "stop_self_normal" or name == "stop_self_explicit" or name == "fail_self"
        or name == "monotonic_time" or name == "current_time" or name == "send_after" or name == "timer_cast" or name == "cancel_timer"
        or name == "failure_reason_tag" or name == "failure_reason_atom"
        or name == "failure_agent_type" or name == "failure_release" or name == "start_child"
        or name == "supervisor_add_child" or name == "supervisor_remove_child" or name == "supervisor_restart_child"
        or name == "supervisor_terminate_child" or name == "supervisor_which_children" or name == "supervisor_count_children"
        or name == "supervisor_set_report_sink"
        or name == "supervisor_op_tag" or name == "supervisor_op_error" or name == "supervisor_op_child"
        or name == "supervisor_get_child" or name == "supervisor_get_child_info" or name == "supervisor_get_child_id" or name == "supervisor_get_child_agent_type"
        or name == "supervisor_get_child_restart"
        or name == "pin_actor_to_core" or name == "pin_actor_to_efficiency_core" or name == "pin_actor_to_performance_core"
        or name == "pin_actor_realtime" or name == "remove_actor" or name == "register_actor" or name == "get_registry_actor" or name == "get_pid_registry" or name == "pin_actor_to_numa_node"
        or name == "unpin_actor" or name == "set_actor_priority" or name == "set_scheduler_policy"
        or name == "get_cpu_topology" or name == "get_efficiency_cores" or name == "get_performance_cores"
        or name == "get_core_capabilities"
        or name == "get_actor_memory_usage"
        or name == "migrate_actor"
        or name == "register_failure_reporter"
        or name == "wait_for_exit" or name == "cast_exit"
        or name == "heap_used" or name == "actor_carrier_index"
        or name == "spawn_device" or name == "spawn_device_registered" or name == "actor_cast_device" or name == "actor_cast_device_registered"
        or name == "map_device" or name == "peek" or name == "poke"
}

fn sir_term_nodes_len_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head_local(nodes.tail, idx - 1)
        }
    }
}

fn sir_term_node_at_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len_local(nodes);
            sir_term_node_at_from_head_local(nodes, n - 1 - idx)
        }
    }
}

fn sir_term_uses_actor_runtime_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> boolean {
    case idx < 0 of {
        true -> false;
        false -> {
            term: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_node_at_local(nodes, idx);
            case term.kind < 0 of {
                true -> false;
                false -> case term.kind of {
                    6 -> is_actor_runtime_prim(term.name) or ((term.name == "div" or term.name == "rem") and (term.type_name == "int64" or term.type_name == "uint64" or term.type_name == "int32" or term.type_name == "uint32" or term.type_name == "int16" or term.type_name == "uint16" or term.type_name == "int8" or term.type_name == "uint8"));
                    2 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    3 -> true;
                    4 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    5 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    7 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    8 -> case sir_term_uses_actor_runtime_at(nodes, term.inner) of {
                        true -> true;
                        false -> sir_term_uses_actor_runtime_at(nodes, term.right_expr)
                    };
                    _: int64 -> false
                }
            }
        }
    }
}

fn sir_term_uses_actor_runtime(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    sir_term_uses_actor_runtime_at(term.nodes, term.root)
}

fn sir_functions_use_actor_runtime(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case sir_term_uses_actor_runtime(fns.head.body) of {
            true -> true;
            false -> sir_functions_use_actor_runtime(fns.tail)
        }
    }
}

fn runtime_dependencies_for_sir(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], sup_impls: List[string, mem(normal)]) -> List[string, mem(normal)] {
    needs_actor_runtime: boolean <- case sir_functions_use_actor_runtime(fns) of {
        true -> true;
        false -> case sup_impls.is_nil of {
            true -> false;
            false -> true
        }
    };
    case needs_actor_runtime of {
        true -> sir_ast@cons_sir_string("actor_runtime", sir_ast@nil_sir_strings());
        false -> sir_ast@nil_sir_strings()
    }
}

// Filename stem when known (§19.1.1); else "" to fall back on explicit `module` or "main"
fn module_name_for_sir(compilation_unit: string, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> string {
    case length_bytes(compilation_unit) > 0 of {
        true -> compilation_unit;
        false -> {
            ex: string <- explicit_module_decl_name(decls);
            case length_bytes(ex) > 0 of {
                true -> ex;
                false -> "main"
            }
        }
    }
}

fn explicit_module_decl_name(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> string {
    case decls.is_nil of {
        true -> "";
        false -> case decls.head.tag == 4 of {
            true -> decls.head.name;
            false -> explicit_module_decl_name(decls.tail)
        }
    }
}

fn append_sir_strings(a: List[string, mem(normal)], b: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> sir_ast@cons_sir_string(a.head, append_sir_strings(a.tail, b))
    }
}

fn params_to_used_modules(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[string, mem(normal)] {
    case params.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> sir_ast@cons_sir_string(params.head.name, params_to_used_modules(params.tail))
    }
}

fn collect_used_modules(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 2 of {
            true -> append_sir_strings(params_to_used_modules(decls.head.parameters), collect_used_modules(decls.tail));
            false -> collect_used_modules(decls.tail)
        }
    }
}

fn params_to_export_items(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ fn_name: string, arity: string }, mem(normal)] {
    case params.is_nil of {
        true -> sir_ast@nil_sir_exports();
        false -> {
            item: { fn_name: string, arity: string } <- { fn_name: params.head.name, arity: params.head.type_name };
            sir_ast@cons_sir_export(item, params_to_export_items(params.tail))
        }
    }
}

fn append_sir_exports(a: List[{ fn_name: string, arity: string }, mem(normal)], b: List[{ fn_name: string, arity: string }, mem(normal)]) -> List[{ fn_name: string, arity: string }, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> sir_ast@cons_sir_export(a.head, append_sir_exports(a.tail, b))
    }
}

fn collect_exports(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ fn_name: string, arity: string }, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_exports();
        false -> case decls.head.tag == 3 of {
            true -> append_sir_exports(params_to_export_items(decls.head.parameters), collect_exports(decls.tail));
            false -> collect_exports(decls.tail)
        }
    }
}

// Build SIR for a { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }. Returns { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } (internal representation).
// Precondition: type checking has succeeded; AST has no dummy nodes in traversed paths.
// Uses compilation unit name "" (see emit_program_for_unit).
fn emit_program(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } {
    emit_program_for_unit(program, context, "")
}

fn sir_string_list_to_csv(list: List[string, mem(normal)]) -> string {
    case list.is_nil of {
        true -> "";
        false -> case list.tail.is_nil of {
            true -> list.head;
            false -> concat(concat(list.head, ","), sir_string_list_to_csv(list.tail))
        }
    }
}

fn emit_program_for_unit(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_order