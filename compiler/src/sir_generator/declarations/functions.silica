// Function declaration to SIR ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } tag 0, extension)

use parser_ast;
use sir_ast;
use types;
use terms;
use effect_serializer;
use overload_mangle;

export emit_function/3;
export param_names_from_list/1;
export param_types_from_list/1;

// SIR-side env uses surface type_name (not type_checker interner type_id).
fn sir_env_add_symbol(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], source_module: string) -> List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] {
    sequence proc[mem(normal)]
        entry: { name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string } <- { name: name, type_name: type_name, declared_effects: declared_effects, is_effect_alias: false, source_module: source_module };
        result: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- prepend[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)](entry, env)
    produces
        pure result
    end
}

fn add_params_to_context_loop(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } {
    case params.is_nil of {
        true -> context;
        false -> {
            p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- params.head;
            new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- sir_env_add_symbol(context.env, p.name, p.type_name, parser_ast@empty_effect_name_list(), "");
            add_params_to_context_loop(params.tail, { env: new_env })
        }
    }
}

fn add_params_to_context(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } {
    add_params_to_context_loop(decl.parameters, context)
}

fn reverse_list_param_acc(lst: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case lst.is_nil of {
        true -> acc;
        false -> reverse_list_param_acc(lst.tail, parser_ast@cons_param(lst.head, acc))
    }
}

fn reverse_list_param(lst: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    reverse_list_param_acc(lst, parser_ast@nil_list_param())
}

fn param_names_from_list_loop(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: string) -> string {
    case params.is_nil of {
        true -> acc;
        false -> {
            p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- params.head;
            sep: string <- case length_bytes(acc) == 0 of { true -> ""; false -> "|" };
            next: string <- concat(acc, concat(sep, p.name));
            param_names_from_list_loop(params.tail, next)
        }
    }
}

fn param_names_from_list(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    // Parser collects params with cons_param(p, acc), so list is reversed: (x,y) -> [y,x].
    // Reverse so first param gets X0. param_names "x|y" -> %x=X0, %y=X1.
    reversed: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- reverse_list_param(params);
    param_names_from_list_loop(reversed, "")
}

fn param_types_from_list_loop(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: string) -> string {
    case params.is_nil of {
        true -> acc;
        false -> {
            p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- params.head;
            sep: string <- case length_bytes(acc) == 0 of { true -> ""; false -> "|" };
            next: string <- concat(acc, concat(sep, p.type_name));
            param_types_from_list_loop(params.tail, next)
        }
    }
}

fn param_types_from_list(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    reversed: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- reverse_list_param(params);
    param_types_from_list_loop(reversed, "")
}

// Lambda lifting (parser_ast declaration_from_lambda_lift) stores a lifted function's parameters like
// every other tag-0 declaration, last source parameter first; its source order is (formals...,
// captures...), so the formals take X0.. and the captures follow.

// Build { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string } for a { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } (tag 0)
// Uses decl.body when present (kind >= 0); otherwise placeholder for empty body
// Adds parameters to context so body can reference param names
fn emit_function(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, all_decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string } {
    case decl.tag of {
        0 -> {
            fn_name: string <- overload_mangle@sir_fn_link_name(decl, all_decls);
            ret_type: string <- types@type_name_to_sir(decl.return_type_name);
            eff_str: string <- case decl.declared_effects.is_nil of {
                true -> "";
                false -> effect_serializer@serialize_effects(decl.declared_effects)
            };
            context_with_params: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- add_params_to_context(decl, context);
            body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case parser_ast@expr_root_node(decl.body).kind >= 0 of {
                true -> terms@expr_to_sir_function_body(context_with_params, decl.body, decl.return_type_name);
                false -> placeholder_body(decl.return_type_name)
            };
            param_names_str: string <- param_names_from_list(decl.parameters);
            param_types: string <- param_types_from_list(decl.parameters);
            { name: fn_name, return_type: ret_type, effects: eff_str, body: body, param_names: param_names_str, param_types: param_types }
        };
        _: int64 -> sir_ast@dummy_sir_function()
    }
}

// Local function names: bare name; "m" → "main" (parser quirk for entry point)
fn qual_name(name: string) -> string {
    case name of {
        "m" -> "main";
        _: string -> name
    }
}

// Placeholder body when declaration has no body (per formalization spec §4.2)
fn placeholder_body(return_type_name: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(return_type_name);
    case return_type_name of {
        "unit" -> sir_ast@make_sir_term(0, "unit", "()", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "boolean" -> sir_ast@make_sir_term(0, "bool", "false", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "atom" -> sir_ast@make_sir_term(0, "atom", ":ok", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        _: string -> sir_ast@make_sir_term(0, sir_type, "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
    }
}
