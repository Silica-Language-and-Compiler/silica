// Pre-emit target check (E2220; device spec §10, peek/poke plan item 11): a prim the shared compiler
// lowered but the emitter this binary was built with cannot compile -- map_device / peek / poke on an
// OS-hosted target, file io on the bare-metal board -- is reported here with the module, the function
// and the prim, before emit_module runs and before any .sams is written. The emitter answers through
// emitter_core@unsupported_prim_reason; a lowered builtin call is kind 4/5 and a prim kind 6.

use type_checker_core;
use type_checker_links;
use emitter_core;
use transport_pack;

export verify_module_targets/2;

fn verify_module_targets(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    // The carrier declarations first (transport_links_design.md §5.2: E2410 for a kind, E2412 for a
    // link this target's pack does not provide, E2417 for a baud the pack rejects), wherever they
    // appear, including one nothing uses; then the prims of every function.
    links_r: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- verify_link_declarations(program.declarations, sir_module.module_name);
    case links_r.is_ok of {
        false -> links_r;
        true -> verify_functions(sir_module.functions, sir_module, program)
    }
}

fn verify_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case fns.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> {
            r: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- verify_nodes(fns.head.body.nodes, fns.head.body.nodes, fns.head.name, sir_module, program);
            case r.is_ok of {
                false -> r;
                true -> verify_functions(fns.tail, sir_module, program)
            }
        }
    }
}

// SIRTerm node kinds 4 (call) and 5 (tail call) carry the callee in `name` (sir_ast).
fn verify_nodes(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], all: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], fn_name: string, sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case nodes.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> {
            reason: string <- case nodes.head.kind == 4 or nodes.head.kind == 5 or nodes.head.kind == 6 of {
                true -> {
                    wire_reason: string <- wire_format_reason(nodes.head.name);
                    case length_bytes(wire_reason) > 0 of {
                        true -> wire_reason;
                        false -> emitter_core@unsupported_prim_reason(nodes.head.name)
                    }
                };
                false -> ""
            };
            code: string <- case starts_with(reason, "wire protocol") of { true -> "E2410"; false -> "E2220" };
            case reason == "" of {
                true -> {
                    rp: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case nodes.head.kind == 6 and is_pin_prim(nodes.head.name) of {
                        true -> verify_pin_literal(nodes.head, all, fn_name, sir_module, program);
                        false -> type_checker_core@type_check_ok()
                    };
                    case rp.is_ok of {
                        false -> rp;
                        true -> verify_nodes(nodes.tail, all, fn_name, sir_module, program)
                    }
                };
                false -> type_checker_core@type_check_err(code, declaration_location(program.declarations, fn_name, program.location), concat(concat(concat(concat(concat(concat(concat(concat(concat("module '", sir_module.module_name), "', function '"), fn_name), "': the prim '"), nodes.head.name), "' cannot be compiled for "), emitter_core@target_name()), ": "), reason), "sect10")
            }
        }
    }
}





// Board pin builtins with a literal pin (board_pin_builtins_design.md §5): the emitter this binary was
// built with checks the number against its board pack's pin table -- E2221 a pin the board does not
// have, E2222 a reserved pin, E2227 configuring or driving a read-only pin -- before anything is
// emitted. A computed pin is checked at run time by the board runtime (abort, status 71). On a hosted
// target the prims never get here: verify_nodes has already answered E2220. The emitter answers with
// emitter_core@pin_literal_reason ("" when the pin is fine) and pin_literal_code (the error code).
fn is_pin_prim(name: string) -> boolean {
    name == "pin_mode" or name == "pin_pull" or name == "pin_write" or name == "pin_read"
}

// A SIR body's node list holds the newest node first; node `idx` is counted from the oldest.
fn node_at(all: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    sequence proc[mem(normal)]
        n: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](all);
        r: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- case idx < 0 or idx >= n of {
            true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
            false -> {
                e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(all, n - 1 - idx);
                { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
            }
        }
    produces
        pure r
    end
}

fn verify_pin_literal(node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, all: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], fn_name: string, sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    pin_n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- node_at(all, node.inner);
    reason: string <- case pin_n.kind == 0 of {
        true -> emitter_core@pin_literal_reason(node.name, pin_n.value);
        false -> ""
    };
    case reason == "" of {
        true -> type_checker_core@type_check_ok();
        false -> {
            code: string <- emitter_core@pin_literal_code(node.name, pin_n.value);
            type_checker_core@type_check_err(code, declaration_location(program.declarations, fn_name, program.location), concat(concat(concat(concat(concat(concat("module '", sir_module.module_name), "', function '"), fn_name), "': "), node.name), concat(": ", reason)), "sect4.7")
        }
    }
}

// The declaration named like the SIR function (overload mangling only renames when a name is
// overloaded, so the plain name is the common case); the program's own location otherwise.
fn declaration_location(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string, fallback: { file: string, line: int64, column: int64, offset: int64 }) -> { file: string, line: int64, column: int64, offset: int64 } {
    case decls.is_nil of {
        true -> fallback;
        false -> case decls.head.name == fn_name of {
            true -> decls.head.location;
            false -> declaration_location(decls.tail, fn_name, fallback)
        }
    }
}

// E2410 (transport_serialization_design.md §6.0): a derived encode / decode call names its wire
// protocol in its name, `__tr_encode_<fmt>_...` / `__tr_decode_<fmt>_...`; the target's transport
// pack says whether this build provides that protocol.
fn segment_after(s: string, start: int64, i: int64) -> string {
    case i >= length_bytes(s) of {
        true -> substring(s, start, i);
        false -> case substring(s, i, i + 1) == "_" of {
            true -> substring(s, start, i);
            false -> segment_after(s, start, i + 1)
        }
    }
}

fn wire_format_reason(callee: string) -> string {
    prefix_len: int64 <- case starts_with(callee, "__tr_encode_") of {
        true -> 12;
        false -> case starts_with(callee, "__tr_decode_") of {
            true -> 12;
            false -> 0
        }
    };
    case prefix_len == 0 of {
        true -> "";
        false -> {
            fmt: string <- segment_after(callee, prefix_len, prefix_len);
            case transport_pack@provides_format(fmt) of {
                true -> "";
                false -> concat(concat("wire protocol (:", fmt), ") is not provided by this emit target: its transport pack does not list it (transport_serialization_design.md §6.0)")
            }
        }
    }
}

// E2410 / E2412 / E2417 for a `carried_on` declaration (tag 11) against this target's transport pack
// (transport_links_design.md §5.1, §5.2). The messages name the module, the carrier, the link and the
// target; the console instance of decision 17 gets the pack's note under the same code E2412.
fn link_err(code: string, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, module_name: string, msg: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    type_checker_core@type_check_err(code, decl.location, concat(concat(concat(concat("module '", module_name), "', carried_on "), decl.name), concat(": ", msg)), "sect16.4")
}

fn verify_link_declarations(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], module_name: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case decls.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case type_checker_links@is_link_declaration(decls.head) of {
            false -> verify_link_declarations(decls.tail, module_name);
            true -> {
                kind: string <- type_checker_links@link_kind_of(decls.head);
                ltag: string <- type_checker_links@link_tag_of(decls.head);
                instance: int64 <- type_checker_links@link_instance_of(decls.head);
                baud: int64 <- type_checker_links@link_baud_of(decls.head);
                ltext: string <- type_checker_links@link_text_of(decls.head);
                provided_text: string <- concat("; this target provides: ", transport_pack@provided_links());
                case transport_pack@provides_carrier(kind) of {
                    false -> link_err("E2410", decls.head, module_name, concat(concat(concat(concat("carrier kind (:", kind), ") is not provided by target "), emitter_core@target_name()), ": its transport pack does not list it (transport_serialization_design.md §6.0)"));
                    true -> case transport_pack@provides_link(ltag, instance) of {
                        false -> {
                            console: string <- transport_pack@link_console_note(ltag, instance);
                            case console == "" of {
                                false -> link_err("E2412", decls.head, module_name, concat(concat("link ", ltext), concat(console, provided_text)));
                                true -> link_err("E2412", decls.head, module_name, concat(concat(concat(concat("link ", ltext), " is not provided by target "), emitter_core@target_name()), concat(" (transport_links_design.md §5.1)", provided_text)))
                            }
                        };
                        true -> case baud == 0 or transport_pack@link_baud_ok(ltag, baud) of {
                            false -> link_err("E2417", decls.head, module_name, concat(concat(concat(concat("the baud of link ", ltext), " is not one target "), emitter_core@target_name()), " supports on that link (links design §5.2: the pack's check)"));
                            true -> verify_link_declarations(decls.tail, module_name)
                        }
                    }
                }
            }
        }
    }
}
