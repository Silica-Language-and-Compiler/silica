fn build_call_supervisor_child_info_reply(child_ref: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, child_info: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_call_supervisor_reply(
        terms_helpers@sir_atom_const(":child_info"),
        child_ref,
        terms_helpers@sir_atom_const(":ok"),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_int64_const("0"),
        child_info,
        terms_helpers@sir_atom_const(":ok")
    )
}

// The reply of :terminate_child / :remove_child / :restart_child, whose runtime operation answers
// -2 when the asking actor is a row child of the supervisor naming its own row (or, under
// :one_for_all, the group it is in; prims_actors_child_table_asm.silica): every tag field is chosen
// at run time from the answer bound to `answer` (actor_calls@build_supervisor_op_*_prim), so the
// reply is the operation's own (own_tag, own_status, the child) or the error shape (tag and status
// :error, error :language_error, child 0) with no atom added to the program.
fn build_call_supervisor_op_reply(answer: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, own_tag: string, own_status: string, child: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_call_supervisor_reply(
        actor_calls@build_supervisor_op_tag_prim(answer, terms_helpers@sir_atom_const(own_tag)),
        child,
        actor_calls@build_supervisor_op_tag_prim(answer, terms_helpers@sir_atom_const(own_status)),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_int64_const("0"),
        actor_calls@build_supervisor_op_error_prim(answer, terms_helpers@sir_atom_const(":ok"))
    )
}

fn build_call_supervisor_error_reply(reason: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_call_supervisor_reply(
        terms_helpers@sir_atom_const(":error"),
        terms_helpers@sir_actor_ref_const("0"),
        terms_helpers@sir_atom_const(":error"),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_atom_const(reason)
    )
}

fn atom_lexeme_from_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    case node.kind == 5 of {
        true -> node.value;
        false -> case node.kind == 2 of {
            true -> atom_lexeme_from_expr(parser_ast@expr_at(expr, node.inner));
            false -> ""
        }
    }
}

fn call_supervisor_op_atom(msg_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    (op_found: boolean, op_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- terms_helpers@find_struct_field_expr(msg_expr, "op");
    case op_found of {
        true -> atom_lexeme_from_expr(op_expr);
        false -> ""
    }
}

fn call_supervisor_id_atom_sir(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, msg_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> (boolean, { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) {
    (id_found: boolean, id_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- terms_helpers@find_struct_field_expr(msg_expr, "id");
    case id_found of {
        true -> (true, sir_subexpr_for_actor(context, id_expr, "atom", in_body, bound_name, bound_type, lower_expected, lower_in_body));
        false -> (false, sir_ast@dummy_sir_term())
    }
}

// Lower actor / concurrency builtins (silica-spec §15–16) to SIR prims; used from kind-4 call dispatch.

fn sir_subexpr_for_actor(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, t: string, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case in_body of {
        true -> lower_in_body(context, e, bound_name, bound_type, t);
        false -> lower_expected(context, e, t)
    }
}

// Same chain encoding as type_checker_expressions_helpers@call_third_arg_expr / call_fourth_arg_expr.

fn spawn_call_third_arg_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    type_checker_expressions_helpers@call_third_arg_expr(expr)
}

fn spawn_call_fourth_arg_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    type_checker_expressions_helpers@call_fourth_arg_expr(expr)
}

// SIR-local symbol lookup (surface type_name); mirrors identifiers.silica.

fn sir_lookup_supervisor_csv(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }) -> string {
    (found: boolean, ty: string) <- terms_helpers@sir_lookup_symbol_found(context.env, "__silica_e3b_sup_csv");
    case found of { true -> ty; false -> "" }
}

// Arena SIR helpers: root index i lives at list position (len - 1 - i).

fn spawn_value_tag_e3b_if_supervisor_state(base: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, state_t: string, context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    csv: string <- sir_lookup_supervisor_csv(context);
    // Only a spawn whose initial state names a supervisor implementation gets the trampoline. The
    // old e4a fallback also tagged every other spawn in a module that implements a supervisor, so a
    // plain worker spawned next to `impl T for Supervisor` ran T's init with its own state as the
    // supervisor state (trials/supervisors_addition/supervisor_child_tuple_state faulted in init).
    // Supervisors are created only by spawn_registered_supervisor (spec §15.4.8.1).
    case type_checker_core@type_name_in_supervisor_csv(state_t, csv) of {
        true -> terms_helpers@sir_term_with_root_value(base, concat("[concurrency]", concat("|e3b:", state_t)));
        false -> base
    }
}

fn supervisor_type_name_from_spawn_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == 1 of {
        true -> type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_inner(expr));
        false -> sir_lookup_supervisor_csv(context)
    }
}

fn lower_spawn_registered_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, in_body: boolean, bound_name: string, bound_type: string, prim_name: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    ac_sr: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac_sr == 4 or ac_sr == 5 of {
        false -> sir_ast@dummy_sir_term();
        true -> {
            init_sr_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_init_expr(expr);
            beh_sr_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_behavior_expr(expr);
            name_sr_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- spawn_call_third_arg_expr(expr);
            case type_checker_expressions_helpers@expr_kind(beh_sr_e) == 1 of {
                false -> sir_ast@dummy_sir_term();
                true -> {
                    (beh_sr_found: boolean, beh_sr_type: string) <- terms_helpers@sir_lookup_behavior_found(context.env, type_checker_expressions_helpers@expr_name(beh_sr_e));
                    case beh_sr_found of {
                        false -> sir_ast@dummy_sir_term();
                        true -> {
                            state_sr: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_sr_type);
                            init_sr_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, init_sr_e, state_sr, in_body, bound_name, bound_type, lower_expected, lower_in_body);
                            beh_sr_label: string <- user_calls@qual_name(type_checker_expressions_helpers@expr_name(beh_sr_e));
                            beh_sr_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(0, "fn_ptr", beh_sr_label, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
                            name_sr_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, name_sr_e, "atom", in_body, bound_name, bound_type, lower_expected, lower_in_body);
                            policy_sr_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- spawn_call_fourth_arg_expr(expr);
                            policy_sr_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, policy_sr_e, "stack_policy", in_body, bound_name, bound_type, lower_expected, lower_in_body);
                            pl_sr_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case ac_sr == 5 of {
                                true -> sir_subexpr_for_actor(context, type_checker_expressions_helpers@call_fifth_arg_expr(expr), "uint64", in_body, bound_name, bound_type, lower_expected, lower_in_body);
                                false -> sir_ast@dummy_sir_term()
                            };
                            case prim_name of {
                                "spawn_dangerous_registered" -> actor_calls@build_spawn_dangerous_registered_prim(init_sr_sir, beh_sr_sir, name_sr_sir, policy_sr_sir, pl_sr_sir, ac_sr == 5);
                                "spawn_device_registered" -> actor_calls@build_spawn_device_registered_prim(init_sr_sir, beh_sr_sir, name_sr_sir, policy_sr_sir, pl_sr_sir, ac_sr == 5);
                                _: string -> actor_calls@build_spawn_registered_prim(init_sr_sir, beh_sr_sir, name_sr_sir, policy_sr_sir, pl_sr_sir, ac_sr == 5)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn lower_spawn_registered_supervisor_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    init_srs_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- actor_calls@actor_call_second_arg(expr);
    name_srs_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- spawn_call_third_arg_expr(expr);
    init_srs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, init_srs_e, "discard", in_body, bound_name, bound_type, lower_expected, lower_in_body);
    name_srs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, name_srs_e, "atom", in_body, bound_name, bound_type, lower_expected, lower_in_body);
    sup_name: string <- supervisor_type_name_from_spawn_expr(context, expr);
    ac_srs: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    policy_srs_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- spawn_call_fourth_arg_expr(expr);
    policy_srs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, policy_srs_e, "stack_policy", in_body, bound_name, bound_type, lower_expected, lower_in_body);
    pl_srs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case ac_srs == 5 of {
        true -> sir_subexpr_for_actor(context, type_checker_expressions_helpers@call_fifth_arg_expr(expr), "uint64", in_body, bound_name, bound_type, lower_expected, lower_in_body);
        false -> sir_ast@dummy_sir_term()
    };
    actor_calls@build_spawn_registered_supervisor_prim(sup_name, init_srs, name_srs, policy_srs, pl_srs, ac_srs == 5)
}

fn lower_call_supervisor_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_actors@count_chain_args(expr) == 2 of {
        false -> sir_ast@dummy_sir_term();
        true -> {
            // Avoid binding `sup` to the ephemeral current X0 in deep sequence bodies.
            sup_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), "", "", "discard");
                false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "discard")
            };
            msg_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- actor_calls@actor_call_second_arg(expr);
            op_atom: string <- call_supervisor_op_atom(msg_expr);
            case op_atom == ":add_child" of {
                true -> {
                    (child_found: boolean, child_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) <- terms_helpers@find_struct_field_expr(msg_expr, "child");
                    case child_found of {
                        true -> {
                            child_spec_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, child_expr, "discard", in_body, bound_name, bound_type, lower_expected, lower_in_body);
                            child_ref_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- actor_calls@build_supervisor_add_child_prim(sup_sir, child_spec_sir);
                            build_call_supervisor_child_started_reply(child_ref_sir)
                        };
                        false -> build_call_supervisor_error_reply(":badarg")
                    }
                };
                false -> case op_atom == ":remove_child" of {
                    true -> {
                        (id_found_rc: boolean, id_sir_rc: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) <- call_supervisor_id_atom_sir(context, msg_expr, in_body, bound_name, bound_type, lower_expected, lower_in_body);
                        case id_found_rc of {
                            true -> {
                                remove_rt: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- actor_calls@build_supervisor_remove_child_prim(sup_sir, id_sir_rc);
                                removed_var: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- terms_helpers@sir_var("%_supervisor_removed_child", "atom");
                                reply_removed: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_call_supervisor_op_reply(removed_var, ":ok", ":removed", terms_helpers@sir_actor_ref_const("0"));
                                sir_ast@make_sir_term(2, types@type_name_to_sir("atom"), "", "%_supervisor_removed_child", remove_rt, reply_removed)
                            };
                            false -> build_call_supervisor_error_reply(":badarg")
                        }
                    };
                    false -> case op_atom == ":restart_child" of {
                        true -> {
                            (id_found_rs: boolean, id_sir_rs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) <- call_supervisor_id_atom_sir(context, msg_expr, in_body, bound_name, bound_type, lower_expected, lower_in_body);
                            case id_found_rs of {
                                true -> {
                                    restarted_rt: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- actor_calls@build_supervisor_restart_child_prim(sup_sir, id_sir_rs);
                                    restarted_var: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- terms_helpers@sir_var("%_supervisor_restarted_child", "actor_ref");
                                    reply_restarted: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_call_supervisor_op_reply(restarted_var, ":child_started", ":ok", actor_calls@build_supervisor_op_child_prim(restarted_var));
                                    sir_ast@make_sir_term(2, types@type_name_to_sir("actor_ref"), "", "%_supervisor_restarted_child", restarted_rt, reply_restarted)
                                };
                                false -> build_call_supervisor_error_reply(":badarg")
                            }
                        };
                        false -> case op_atom == ":terminate_child" of {
                            true -> {
                                (id_found_tc: boolean, id_sir_tc: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) <- call_supervisor_id_atom_sir(context, msg_expr, in_body, bound_name, bound_type, lower_expected, lower_in_body);
                                case id_found_tc of {
                                    true -> {
                                        terminate_rt: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- actor_calls@build_supervisor_terminate_child_prim(sup_sir, id_sir_tc);
                                        terminated_var: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- terms_helpers@sir_var("%_supervisor_terminated_child", "atom");
                                        reply_terminated: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_call_supervisor_op_reply(terminated_var, ":ok", ":terminated", terms_helpers@sir_actor_ref_const("0"));
                                        sir_ast@make_sir_term(2, types@type_name_to_sir("atom"), "", "%_supervisor_terminated_child", terminate_rt, reply_terminated)
                                    };
                                    false -> build_call_supervisor_error_reply(":badarg")
                                }
                            };
                            false -> case op_atom == ":which_children" of {
                                true -> {
                                    children_rt: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- actor_calls@build_supervisor_which_children_prim(sup_sir);
                                    children_t: string <- supervisor_children_list_type_name();
                                    children_var: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- terms_helpers@sir_var("%_supervisor_children_ref", children_t);
                                    reply_children: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_call_supervisor_children_reply(children_var);
                                    sir_ast@make_sir_term(2, types@type_name_to_sir(children_t), "", "%_supervisor_children_ref", children_rt, reply_children)
                                };
                                false -> case op_atom == ":count_children" of {
                                    true -> {
                                        count_rt: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- actor_calls@build_supervisor_count_children_prim(sup_sir);
                                        count_var: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- terms_helpers@sir_var("%_supervisor_live_count", "int64");
                                        reply_count: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_call_supervisor_count_reply(count_var);
                                        sir_ast@make_sir_term(2, types@type_name_to_sir("int64"), "", "%_supervisor_live_count", count_rt, reply_count)
                                    };
                                    false -> case op_atom == ":get_child" of {
                                        true -> {
                                            (id_found_gc: boolean, id_sir_gc: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) <- call_supervisor_id_atom_sir(context, msg_expr, in_body, bound_name, bound_type, lower_expected, lower_in_body);
                                            case id_found_gc of {
                                                true -> {
                                                    get_info_rt: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- actor_calls@build_supervisor_get_child_info_prim(sup_sir, id_sir_gc);
                                                    ci_t: string <- supervisor_child_info_type_name();
                                                    ci_var: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- terms_helpers@sir_var("%_supervisor_get_child_info", ci_t);
                                                    child_rt: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_proj_prim(types@type_name_to_sir("actor_ref"), "child", ci_var);
                                                    child_var: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- terms_helpers@sir_var("%_supervisor_get_child_ref", "actor_ref");
                                                    reply_ci: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_call_supervisor_child_info_reply(child_var, ci_var);
                                                    bind_child: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(2, types@type_name_to_sir("actor_ref"), "", "%_supervisor_get_child_ref", child_rt, reply_ci);
                                                    sir_ast@make_sir_term(2, types@type_name_to_sir(ci_t), "", "%_supervisor_get_child_info", get_info_rt, bind_child)
                                                };
                                                false -> build_call_supervisor_error_reply(":badarg")
                                            }
                                        };
                                        false -> build_call_supervisor_error_reply(":unknown_supervisor_op")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn lower_actor_builtin_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    ab: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
    case ab == "stack_policy" of {
        true -> lower_stack_policy_expr(context, expr, expected_type, in_body, bound_name, bound_type, lower_expected, lower_in_body);
        false -> lower_actor_builtin_expr_rest(context, expr, expected_type, in_body, bound_name, bound_type, lower_expected, lower_in_body)
    }
}

// stack_policy(reserve: int64, release: atom) (§15.1.2.2) -> kind-6 prim "stack_policy" with the
// reserve in the inner slot and the atom literal in the right slot; the emitter packs both into
// one word (reserve rounded to 16 | algorithm index).
fn lower_stack_policy_expr(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    reserve_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(expr);
    release_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@call_second_arg_expr(expr);
    reserve_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, reserve_e, "int64", in_body, bound_name, bound_type, lower_expected, lower_in_body);
    release_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, release_e, "atom", in_body, bound_name, bound_type, lower_expected, lower_in_body);
    actor_calls@build_stack_policy_prim(reserve_sir, release_sir)
}

fn lower_actor_builtin_expr_rest(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, in_body: boolean, bound_name: string, bound_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    ab: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
    case ab == "spawn" of {
        true -> {
            ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
            case ac == 3 or ac == 4 of {
                false -> sir_ast@dummy_sir_term();
                true -> {
                    init_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_init_expr(expr);
                    beh_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_behavior_expr(expr);
                    case type_checker_expressions_helpers@expr_kind(beh_e) == 1 of {
                        false -> sir_ast@dummy_sir_term();
                        true -> {
                            (beh_found: boolean, beh_fn_type: string) <- terms_helpers@sir_lookup_behavior_found(context.env, type_checker_expressions_helpers@expr_name(beh_e));
                            case beh_found of {
                                false -> sir_ast@dummy_sir_term();
                                true -> {
                                    state_t: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_fn_type);
                                    init_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, init_e, state_t, in_body, bound_name, bound_type, lower_expected, lower_in_body);
                                    beh_label: string <- user_calls@qual_name(type_checker_expressions_helpers@expr_name(beh_e));
                                    beh_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(0, "fn_ptr", beh_label, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
                                    policy_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_placement_expr(expr);
                                    policy_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, policy_e, "stack_policy", in_body, bound_name, bound_type, lower_expected, lower_in_body);
                                    case ac == 4 of {
                                        true -> {
                                            pl_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- spawn_call_fourth_arg_expr(expr);
                                            pl_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, pl_e, "uint64", in_body, bound_name, bound_type, lower_expected, lower_in_body);
                                            spawn_value_tag_e3b_if_supervisor_state(actor_calls@build_spawn_prim(init_sir, beh_sir, policy_sir, pl_sir, true), state_t, context)
                                        };
                                        false -> spawn_value_tag_e3b_if_supervisor_state(actor_calls@build_spawn_prim(init_sir, beh_sir, policy_sir, sir_ast@dummy_sir_term(), false), state_t, context)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        };
        false -> case ab == "spawn_dangerous" of {
            true -> {
                ac_sd: int64 <- type_checker_expressions_actors@count_chain_args(expr);
                case ac_sd == 3 or ac_sd == 4 of {
                    false -> sir_ast@dummy_sir_term();
                    true -> {
                        init_sd: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_init_expr(expr);
                        beh_sd: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_behavior_expr(expr);
                        case type_checker_expressions_helpers@expr_kind(beh_sd) == 1 of {
                            false -> sir_ast@dummy_sir_term();
                            true -> {
                                (beh_sd_found: boolean, beh_sd_type: string) <- terms_helpers@sir_lookup_behavior_found(context.env, type_checker_expressions_helpers@expr_name(beh_sd));
                                case beh_sd_found of {
                                    false -> sir_ast@dummy_sir_term();
                                    true -> {
                                        state_sd: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_sd_type);
                                        init_sd_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, init_sd, state_sd, in_body, bound_name, bound_type, lower_expected, lower_in_body);
                                        beh_sd_label: string <- user_calls@qual_name(type_checker_expressions_helpers@expr_name(beh_sd));
                                        beh_sd_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(0, "fn_ptr", beh_sd_label, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
                                        policy_sd: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_actors@spawn_placement_expr(expr);
                                        policy_sd_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, policy_sd, "stack_policy", in_body, bound_name, bound_type, lower_expected, lower_in_body);
