use types;
use user_calls;
use terms_helpers;
use type_checker_record_types;

export lower_actor_builtin_expr/8;
export lower_call_supervisor_expr/7;
export lower_spawn_registered_supervisor_expr/7;

fn actor_message_literal(msg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(msg) == 21 of {
        true -> msg;
        false -> case type_checker_expressions_helpers@expr_kind(msg) == 4 of {
            true -> {
                inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_inner(msg);
                case type_checker_expressions_helpers@expr_kind(inner) == 21 of {
                    true -> inner;
                    false -> msg
                }
            };
            false -> msg
        }
    }
}

fn actor_message_expected_type(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, msg: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    lit: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- actor_message_literal(msg);
    case type_checker_expressions_helpers@expr_kind(lit) == 21 of {
        true -> {
            rt: string <- terms_helpers@sir_infer_struct_literal_type(context, lit);
            case type_checker_record_types@record_type_starts(rt) of {
                true -> rt;
                false -> "discard"
            }
        };
        false -> "discard"
    }
}

fn supervisor_child_info_type_name() -> string {
    "{ id: atom, agent_type: atom, child: actor_ref, restart: :permanent | :temporary | :transient }"
}

fn supervisor_children_list_type_name() -> string {
    "List[{ id: atom, agent_type: atom, child: actor_ref, restart: :permanent | :temporary | :transient },mem(normal)]"
}

fn build_supervisor_child_info_record(id_atom: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, agent_type_atom: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, child_ref: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, restart_atom: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    ci_t: string <- supervisor_child_info_type_name();
    ci_sir_t: string <- types@type_name_to_sir(ci_t);
    r4: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(ci_sir_t, "restart", restart_atom, sir_ast@dummy_sir_term());
    r3: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(ci_sir_t, "child", child_ref, r4);
    r2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(ci_sir_t, "agent_type", agent_type_atom, r3);
    struct_terms@build_record_make_layer(ci_sir_t, "id", id_atom, r2)
}

fn build_supervisor_empty_child_info_record() -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_supervisor_child_info_record(
        terms_helpers@sir_atom_const(":unknown"),
        terms_helpers@sir_atom_const(":unknown"),
        terms_helpers@sir_actor_ref_const("0"),
        terms_helpers@sir_atom_const(":temporary")
    )
}

fn build_supervisor_empty_children_list() -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    ci_t: string <- supervisor_child_info_type_name();
    list_t: string <- supervisor_children_list_type_name();
    list_terms@build_list_nil(ci_t, list_t)
}

fn build_call_supervisor_reply(tag: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, child: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, status: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, children: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, count: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, child_info: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, error: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    reply_t: string <- type_checker_expressions_actors@supervisor_reply_record_type();
    reply_sir_t: string <- types@type_name_to_sir(reply_t);
    r7: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(reply_sir_t, "error", error, sir_ast@dummy_sir_term());
    r6: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(reply_sir_t, "child_info", child_info, r7);
    r5: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(reply_sir_t, "count", count, r6);
    r4: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(reply_sir_t, "children", children, r5);
    r3: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(reply_sir_t, "status", status, r4);
    r2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- struct_terms@build_record_make_layer(reply_sir_t, "child", child, r3);
    struct_terms@build_record_make_layer(reply_sir_t, "tag", tag, r2)
}

fn build_call_supervisor_child_started_reply(child_ref: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_call_supervisor_reply(
        terms_helpers@sir_atom_const(":child_started"),
        child_ref,
        terms_helpers@sir_atom_const(":ok"),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_int64_const("0"),
        terms_helpers@sir_atom_const(":ok")
    )
}

fn build_call_supervisor_ok_status_reply(status_atom: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
