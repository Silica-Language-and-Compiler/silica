        true -> case n == 1 of {
            true -> {
                sp0: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_subexpr_for_actor(context, type_checker_expressions_helpers@expr_child_inner(expr), "atom", in_body, bound_name, bound_type, lower_expected, lower_in_body);
                actor_calls@build_actor_runtime_prim(rb, ret, sp0, d, 1)
