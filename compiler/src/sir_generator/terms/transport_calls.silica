// Transport builtins (transport_serialization_design.md §9.2) to SIR: the byte, list-join,
// atom-name, float-bit and integer-width primitives the wire protocols are written with. Each
// lowers to one prim (kind 6) named tr_<op>; a three-argument prim chains its second and third
// arguments in a tr_rest node, as string_substring does. The integer widenings carry their
// operand's type in `value` so the emitter knows which extension to perform; the narrowings carry
// their width as the prim's result type. The terms.silica dispatch lowers the arguments with the
// expected types transport_arg_type names and calls build_transport_prim.

use sir_ast;
use types;

export is_transport_builtin/1;
export transport_arg_count/1;
export transport_arg_type/3;
export transport_result_type/2;
export build_transport_prim/5;

fn is_transport_builtin(name: string) -> boolean {
    case name of {
        "byte_at" -> true;
        "byte_slice" -> true;
        "bytes_of" -> true;
        "join_bytes" -> true;
        "atom_name" -> true;
        "atom_index_of_name" -> true;
        "atom_of_bits" -> true;
        "float64_bits" -> true;
        "float64_of_bits" -> true;
        "float32_bits" -> true;
        "float32_of_bits" -> true;
        "float32_to_float64" -> true;
        "float64_to_float32" -> true;
        "float16_to_float32" -> true;
        "float32_to_float16" -> true;
        "char_code" -> true;
        "char_of_code" -> true;
        "to_int64" -> true;
        "to_uint64" -> true;
        "to_int8" -> true;
        "to_int16" -> true;
        "to_int32" -> true;
        "to_uint8" -> true;
        "to_uint16" -> true;
        "to_uint32" -> true;
        _: string -> false
    }
}

fn prim_name(name: string) -> string {
    case name of {
        "byte_at" -> "tr_byte_at";
        "byte_slice" -> "tr_byte_slice";
        "bytes_of" -> "tr_bytes_of";
        "join_bytes" -> "tr_join_bytes";
        "atom_name" -> "tr_atom_name";
        "atom_index_of_name" -> "tr_atom_index";
        "atom_of_bits" -> "tr_atom_of_bits";
        "float64_bits" -> "tr_f64_bits";
        "float64_of_bits" -> "tr_f64_of_bits";
        "float32_bits" -> "tr_f32_bits";
        "float32_of_bits" -> "tr_f32_of_bits";
        "float32_to_float64" -> "tr_f32_to_f64";
        "float64_to_float32" -> "tr_f64_to_f32";
        "float16_to_float32" -> "tr_f16_to_f32";
        "float32_to_float16" -> "tr_f32_to_f16";
        "char_code" -> "tr_char_code";
        "char_of_code" -> "tr_char_of_code";
        "to_int64" -> "tr_to_int64";
        "to_uint64" -> "tr_to_uint64";
        _: string -> "tr_narrow"
    }
}

fn transport_arg_count(name: string) -> int64 {
    case name of {
        "byte_at" -> 2;
        "byte_slice" -> 3;
        _: string -> 1
    }
}

// The surface type the i-th argument (1-based) is lowered with. `operand_type` is the inferred
// type of the first argument, which to_int64 / to_uint64 take as it is.
fn transport_arg_type(name: string, i: int64, operand_type: string) -> string {
    case name of {
        "byte_at" -> case i == 1 of { true -> "string"; false -> "int64" };
        "byte_slice" -> case i == 1 of { true -> "string"; false -> "int64" };
        "bytes_of" -> "List[int64, mem(normal)]";
        "join_bytes" -> "List[string, mem(normal)]";
        "atom_name" -> "atom";
        "atom_index_of_name" -> "string";
        "atom_of_bits" -> "int64";
        "float64_bits" -> "float64";
        "float64_of_bits" -> "int64";
        "float32_bits" -> "float32";
        "float32_of_bits" -> "int64";
        "float32_to_float64" -> "float32";
        "float64_to_float32" -> "float64";
        "float16_to_float32" -> "float16";
        "float32_to_float16" -> "float32";
        "char_code" -> "char";
        "char_of_code" -> "int64";
        "to_int64" -> operand_type;
        "to_uint64" -> operand_type;
        _: string -> "int64"
    }
}

fn transport_result_type(name: string, operand_type: string) -> string {
    case name of {
        "byte_at" -> "int64";
        "byte_slice" -> "string";
        "bytes_of" -> "string";
        "join_bytes" -> "string";
        "atom_name" -> "string";
        "atom_index_of_name" -> "int64";
        "atom_of_bits" -> "atom";
        "float64_bits" -> "int64";
        "float64_of_bits" -> "float64";
        "float32_bits" -> "int64";
        "float32_of_bits" -> "float32";
        "float32_to_float64" -> "float64";
        "float64_to_float32" -> "float32";
        "float16_to_float32" -> "float32";
        "float32_to_float16" -> "float16";
        "char_code" -> "int64";
        "char_of_code" -> "char";
        "to_int64" -> "int64";
        "to_uint64" -> "uint64";
        "to_int8" -> "int8";
        "to_int16" -> "int16";
        "to_int32" -> "int32";
        "to_uint8" -> "uint8";
        "to_uint16" -> "uint16";
        "to_uint32" -> "uint32";
        _: string -> "int64"
    }
}

fn build_transport_prim(name: string, operand_type: string, a1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, a2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, a3: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    rt: string <- types@type_name_to_sir(transport_result_type(name, operand_type));
    value: string <- case name == "to_int64" or name == "to_uint64" of {
        true -> operand_type;
        false -> ""
    };
    pn: string <- prim_name(name);
    case transport_arg_count(name) of {
        1 -> sir_ast@make_sir_term(6, rt, value, pn, a1, sir_ast@dummy_sir_term());
        2 -> sir_ast@make_sir_term(6, rt, value, pn, a1, a2);
        _: int64 -> {
            rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(6, "int64", "", "tr_rest", a2, a3);
            sir_ast@make_sir_term(6, rt, value, pn, a1, rest)
        }
    }
}
