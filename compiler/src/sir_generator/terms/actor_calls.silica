// Runtime helpers (CPU affinity, topology, migration): prim name = Silica builtin, arity 0–3.
fn build_actor_runtime_prim(builtin_name: string, sir_ret: string, arg0: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, nargs: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    d: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@dummy_sir_term();
    case nargs of {
        0 -> sir_ast@make_sir_term(6, sir_ret, "[concurrency]", builtin_name, d, d);
        1 -> sir_ast@make_sir_term(6, sir_ret, "[concurrency]", builtin_name, arg0, d);
        2 -> sir_ast@make_sir_term(6, sir_ret, "[concurrency]", builtin_name, arg0, arg1);
        _: int64 -> sir_ast@dummy_sir_term()
    }
}

fn build_actor_runtime_prim_3(builtin_name: string, sir_ret: string, arg0: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    packed: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(6, "unit", "", "tuple_make", arg1, arg2);
    sir_ast@make_sir_term(6, sir_ret, "[concurrency]", builtin_name, arg0, packed)
}

// Structured topology builtins: one prim, type_name = named record per type checker (Phase F).
fn build_get_cpu_topology_prim() -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    d: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@dummy_sir_term();
    ret: string <- actor_runtime_sir_return_type("get_cpu_topology");
    build_actor_runtime_prim("get_cpu_topology", ret, d, d, 0)
}

fn build_get_core_capabilities_prim(arg0: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    d: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@dummy_sir_term();
    ret: string <- actor_runtime_sir_return_type("get_core_capabilities");
    build_actor_runtime_prim("get_core_capabilities", ret, arg0, d, 1)
}

// Phase E e3b2: start_child(child_spec_ptr) -> actor_ref (§15.4.13.3).
fn build_start_child_prim(spec: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    d: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@dummy_sir_term();
    sir_ast@make_sir_term(6, "actor_ref", "[concurrency]", "start_child", spec, d)
}
