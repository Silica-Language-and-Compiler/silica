// Parser: second argument is inner of right_expr when right is a kind-4 arg-chain pair.
// Postfix `impl ActorMessage {}` stores value "AM" on the pair (name may stay "" or become "[AM]" if a pass ran).
fn actor_call_second_arg(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    right_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, node.right_expr);
    right_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(right_e);
    case right_node.kind == 4 of {
        false -> right_e;
        true -> {
            inner_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(right_e, right_node.inner);
            inner_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(inner_e);
            case right_node.name == "" or right_node.value == "AM" or right_node.name == "[AM]" or inner_node.kind == 21 of {
                true -> inner_e;
                false -> right_e
            }
        }
    }
}

fn is_actor_sir_builtin(name: string) -> boolean {
    base: string <- case type_checker_core@call_name_is_module_qualified(name) of {
        true -> "";
        false -> name
    };
    base == "spawn" or base == "spawn_dangerous" or base == "spawn_registered" or base == "spawn_dangerous_registered" or base == "spawn_registered_supervisor" or base == "call_supervisor" or base == "add_child" or base == "send" or base == "cast" or base == "cast_registered" or base == "cast_dangerous_registered" or base == "call" or base == "call_registered" or base == "self"
        or base == "link" or base == "monitor" or base == "demonitor" or base == "supervision_ingress_enqueue"
        or base == "supervision_wait_and_drain_one" or base == "child_table_first_ref" or base == "child_table_row_ref"
        or base == "failure_reason_tag" or base == "failure_reason_atom"
        or base == "failure_agent_type" or base == "failure_release" or base == "start_child" or base == "supervisor_add_child"
        or base == "kill_abnormal" or base == "register_failure_reporter"
        or base == "wait_for_exit" or base == "cast_exit"
        or base == "heap_used"
        or base == "pin_actor_to_core" or base == "pin_actor_to_efficiency_core" or base == "pin_actor_to_performance_core"
        or base == "pin_actor_realtime" or base == "remove_actor" or base == "register_actor" or base == "get_registry_actor" or base == "get_pid_registry" or base == "pin_actor_to_numa_node"
        or base == "unpin_actor" or base == "set_actor_priority" or base == "set_scheduler_policy"
        or base == "get_cpu_topology" or base == "get_efficiency_cores" or base == "get_performance_cores"
        or base == "get_core_capabilities"
        or base == "get_actor_memory_usage"
        or base == "migrate_actor"
        or base == "stack_policy"
        or base == "spawn_device" or base == "spawn_device_registered" or base == "cast_device" or base == "cast_device_registered"
}

// SIR text type field for runtime helper return (mirrors type_checker_expressions@actor_runtime_builtin_return_type).
fn actor_runtime_sir_return_type(name: string) -> string {
    case name of {
        "pin_actor_to_core" -> "(int64,affinity_error)";
        "pin_actor_to_efficiency_core" -> "(int64,affinity_error)";
        "pin_actor_to_performance_core" -> "(int64,affinity_error)";
        "pin_actor_realtime" -> "(int64,affinity_error)";
        "remove_actor" -> "(int64,affinity_error)";
        "pin_actor_to_numa_node" -> "(int64,affinity_error)";
        "unpin_actor" -> "atom";
        "register_actor" -> "atom";
        "get_registry_actor" -> "actor_ref";
        "get_pid_registry" -> "actor_ref";
        "set_actor_priority" -> "atom";
        "set_scheduler_policy" -> "atom";
        "get_cpu_topology" -> "{ cores: List[{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 },normal], numa_nodes: List[{ id: int64, cores: List[int64,normal], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 },normal] },normal], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64,normal] },normal] } }";
        "get_efficiency_cores" -> "List[int64,normal]";
        "get_performance_cores" -> "List[int64,normal]";
        "get_core_capabilities" -> "{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 }";
        "get_actor_memory_usage" -> "{ reserved: int64, committed: int64, retained: int64, high_water: int64 }";
        "migrate_actor" -> "atom";
        "register_failure_reporter" -> "atom";
        "heap_used" -> "int64";
        _: string -> "unit"
    }
}

// spawn / spawn_dangerous: §7.9 — [concurrency]. The right slot is the flat chain
// tuple_make(behavior, stack_policy) or tuple_make(behavior, tuple_make(stack_policy, placement)):
// the emitter reads [beh, policy(, core)] at X10 (§15.1.2.2: the stack policy is required).
fn build_spawn_named_prim(init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, beh: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, four_args: boolean, prim_name: string, result_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    right_slot: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case four_args of {
        true -> sir_ast@make_sir_term(6, "unit", "", "tuple_make", beh, sir_ast@make_sir_term(6, "unit", "", "tuple_make", policy, place));
        false -> sir_ast@make_sir_term(6, "unit", "", "tuple_make", beh, policy)
    };
    sir_ast@make_sir_term(6, result_type, "[concurrency]", prim_name, init, right_slot)
}

fn build_spawn_prim(init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, beh: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, four_args: boolean) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_spawn_named_prim(init, beh, policy, place, four_args, "spawn", "actor_ref")
}

fn build_spawn_dangerous_prim(init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, beh: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, four_args: boolean) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_spawn_named_prim(init, beh, policy, place, four_args, "spawn_dangerous", "dangerous_actor_ref")
}

fn build_spawn_device_prim(init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, beh: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, four_args: boolean) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_spawn_named_prim(init, beh, policy, place, four_args, "spawn_device", "device_actor_ref")
}

// stack_policy(reserve, release) -> stack_policy (§15.1.2.2): a scalar prim, packed by the emitter.
fn build_stack_policy_prim(reserve: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, release: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(6, "stack_policy", "", "stack_policy", reserve, release)
}

// spawn_registered / spawn_dangerous_registered: init + the flat chain [behavior_fn_ptr, name_atom,
// stack_policy(, core_id)] in the right slot.
fn build_spawn_registered_named_prim(init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, beh: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, five_args: boolean, prim_name: string, result_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    tail: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case five_args of {
        true -> sir_ast@make_sir_term(6, "unit", "", "tuple_make", name_term, sir_ast@make_sir_term(6, "unit", "", "tuple_make", policy, place));
        false -> sir_ast@make_sir_term(6, "unit", "", "tuple_make", name_term, policy)
    };
    packed: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(6, "unit", "", "tuple_make", beh, tail);
    sir_ast@make_sir_term(6, result_type, "[concurrency]", prim_name, init, packed)
}

fn build_spawn_registered_prim(init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, beh: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, five_args: boolean) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_spawn_registered_named_prim(init, beh, name_term, policy, place, five_args, "spawn_registered", "actor_ref")
}

fn build_spawn_dangerous_registered_prim(init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, beh: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, five_args: boolean) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_spawn_registered_named_prim(init, beh, name_term, policy, place, five_args, "spawn_dangerous_registered", "dangerous_actor_ref")
}

fn build_spawn_device_registered_prim(init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, beh: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, five_args: boolean) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    build_spawn_registered_named_prim(init, beh, name_term, policy, place, five_args, "spawn_device_registered", "device_actor_ref")
}

// Phase C: spawn_registered_supervisor(T, initial_state, name) lowers to a runtime-managed
// supervisor actor. The implementation type is carried in `value` so the emitter can install
// _silica_supervisor_start_<T> as the first-schedule trampoline; `name` is kept as the right
// operand for the registration step.
// The right slot is the flat chain [name_atom, stack_policy(, core_id)] (§15.1.2.2).
fn build_spawn_registered_supervisor_prim(supervisor_type: string, init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, policy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, place: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, five_args: boolean) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    packed: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case five_args of {
        true -> sir_ast@make_sir_term(6, "unit", "", "tuple_make", name_term, sir_ast@make_sir_term(6, "unit", "", "tuple_make", policy, place));
        false -> sir_ast@make_sir_term(6, "unit", "", "tuple_make", name_term, policy)
    };
    sir_ast@make_sir_term(6, "supervisor_ref", concat("[concurrency]|e3b:", supervisor_type), "spawn_registered_supervisor", init, packed)
}

// spawn_linked: §15.4.8.3 — same [concurrency] prim shape; name distinguishes runtime (supervisors_implementation_development_plan Phase A).
// 3-arg: right = tuple_make(behavior_fn_ptr, agent_type_term); 4-arg: tuple_make(tuple_make(behavior, agent_type), core_id).
// link(target) -> :ok (§15.4.8.5). Phase G: idempotent link + linked exit — supervisor gets structured exit via ingress,
// non-supervisor gets linked failure reason; value stays [concurrency] (not mailbox delivery).
// monitor(target) -> monitor_ref; demonitor(ref) -> :ok (§15.4.8.6–§15.4.8.7). Phase G: DOWN only on standard mailbox —
// same SIR value tag as send/cast/call so IR consumers see the mailbox channel.
fn build_link_prim(target: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    d: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@dummy_sir_term();
    sir_ast@make_sir_term(6, "atom", "[concurrency]", "link", target, d)
}

