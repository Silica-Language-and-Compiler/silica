// Recursion implementation metadata for user calls (compiler/design_documents/recursion_implementation.md).
// Encodes phase-related hints in SIR call/tail_call value strings for downstream lowering.
//
// Phases (aligned with recursion_implementation.md):
//   p1 — explicit frame stack representation (callee, resume, locals / continuation tag+payload)
//   p2 — lowering: push/dispatch calls, pop/merge returns, defunctionalized continuations
//   p3 — preemption: fuel / checkpoints on back-edges (tail_call and loop heads)
//   p4 — observability: source offset → PC / IR node mapping for stack traces
//   p5 — optimization: native tail_call at provably tail sites
//   p6 — fallback: trampoline / frame VM when platform TCO is unavailable
// Of these only p5 (native tail calls) is implemented; p1-p4 and p6 are not implemented (compiler/design_documents/recursion_implementation.md, Implementation status).

use literals;
use parser_ast;

export user_call_effect_value/0;
export user_call_effect_value_fn/1;
export user_call_effect_value_fn_tail/1;

fn user_call_effect_value() -> string {
    "[]"
}

fn user_call_effect_value_fn(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    loc: { file: string, line: int64, column: int64, offset: int64 } <- node.location;
    off_i: int64 <- loc.offset;
    off: string <- literals@int64_to_decimal_string(off_i);
    concat(concat(concat(concat(concat("[]|sir_rec:o", off), "|sir_rec:p1_frame"), "|sir_rec:p2_lower"), "|sir_rec:p4_src"), "|sir_rec:p6_trampoline")
}

fn user_call_effect_value_fn_tail(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    base: string <- user_call_effect_value_fn(expr);
    concat(base, "|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call")
}
