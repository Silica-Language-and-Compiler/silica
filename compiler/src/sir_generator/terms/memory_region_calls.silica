// Memory region built-in calls to SIR prim terms ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 4, extension)
// alloc_region, alloc_ref, alloc_rec, read_ref, write_ref, alloc_buf, buf_load, buf_store,
// read_buf, write_buf (aliases), fresh_lifetime
// Implements sir_design_spec §7.4 Memory, §7.5 Atomic; compiler/design_documents/silica-specification.md §4.4

use sir_ast;
use types;

export is_region_builtin/1;
export build_region_prim_from_sir/5;

// Valid memory spaces per spec §4.4.1
fn is_valid_memory_space(space: string) -> boolean {
    space == "normal" or space == "normal_writeback" or space == "normal_writethrough" or space == "normal_noncacheable" or space == "atomic" or space == "device"
}

// True if call_name is a region built-in
fn is_region_builtin(call_name: string) -> boolean {
    call_name == "alloc_region" or call_name == "alloc_ref" or call_name == "alloc_rec" or call_name == "read_ref" or call_name == "write_ref" or call_name == "alloc_buf" or call_name == "buf_load" or call_name == "buf_store" or call_name == "read_buf" or call_name == "write_buf" or call_name == "fresh_lifetime" or call_name == "canonical_arena_lookup" or call_name == "canonical_arena_same" or call_name == "ref_eq" or call_name == "ref_in_region"
}

// Map source call name to SIR prim name (read_buf->buf_load, write_buf->buf_store)
fn sir_prim_name(call_name: string) -> string {
    case call_name of {
        "read_buf" -> "buf_load";
        "write_buf" -> "buf_store";
        _: string -> call_name
    }
}

// Extract Space from memory region type string (ref, region, buf)
fn extract_space_from_region_type(type_str: string) -> (boolean, string) {
    (has_type: boolean, inner: string) <- extract_region_type_inner(type_str);
    case has_type of {
        true -> {
            space: string <- trim_space(nth_param(inner, 1));
            case is_valid_memory_space(space) of {
                true -> (true, space);
                false -> (false, "")
            }
        };
        false -> (false, "")
    }
}

fn extract_region_type_inner(type_str: string) -> (boolean, string) {
    case length_bytes(type_str) >= 10 and substring(type_str, 0, 10) == "atomic_ref" of {
        true -> case length_bytes(type_str) >= 11 and substring(type_str, 10, 11) == "(" of {
            true -> (true, substring(type_str, 11, length_bytes(type_str) - 1));
            false -> (false, "")
        };
        false -> case length_bytes(type_str) >= 6 and substring(type_str, 0, 6) == "region" of {
            true -> case length_bytes(type_str) >= 7 and substring(type_str, 6, 7) == "(" of {
                true -> (true, substring(type_str, 7, length_bytes(type_str) - 1));
                false -> (false, "")
            };
            false -> case length_bytes(type_str) >= 3 and substring(type_str, 0, 3) == "buf" of {
                true -> case length_bytes(type_str) >= 4 and substring(type_str, 3, 4) == "(" of {
                    true -> (true, substring(type_str, 4, length_bytes(type_str) - 1));
                    false -> (false, "")
                };
                false -> case length_bytes(type_str) >= 3 and substring(type_str, 0, 3) == "ref" of {
                    true -> case length_bytes(type_str) >= 4 and substring(type_str, 3, 4) == "(" of {
                        true -> (true, substring(type_str, 4, length_bytes(type_str) - 1));
                        false -> (false, "")
                    };
                    false -> (false, "")
                }
            }
        }
    }
}

fn trim_space(s: string) -> string {
    trim_space_from(s, 0, length_bytes(s) - 1)
}

fn trim_space_from(s: string, start: int64, last_idx: int64) -> string {
    case start > last_idx of {
        true -> "";
        false -> case substring(s, start, start + 1) == " " of {
            true -> trim_space_from(s, start + 1, last_idx);
            false -> case substring(s, last_idx, last_idx + 1) == " " of {
                true -> trim_space_from(s, start, last_idx - 1);
                false -> substring(s, start, last_idx + 1)
            }
        }
    }
}

fn nth_param(inner: string, n: int64) -> string {
    start: int64 <- case n == 0 of { true -> 0; false -> find_nth_comma(inner, 0, 0, n) + 1 };
    end_idx: int64 <- find_nth_comma(inner, 0, 0, n + 1);
    trimmed: string <- substring(inner, start, end_idx);
    trim_space(trimmed)
}

fn find_nth_comma(s: string, i: int64, depth: int64, target: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> length_bytes(s);
        false -> case substring(s, i, i + 1) of {
            "(" -> find_nth_comma(s, i + 1, depth + 1, target);
            ")" -> find_nth_comma(s, i + 1, depth - 1, target);
            "," -> case depth == 0 of {
                true -> case target == 1 of {
                    true -> i;
                    false -> find_nth_comma(s, i + 1, 0, target - 1)
                };
                false -> find_nth_comma(s, i + 1, depth, target)
            };
            _: string -> find_nth_comma(s, i + 1, depth, target)
        }
    }
}

// Effect string for mem(Space)
fn mem_effect(space: string) -> string {
    concat("[mem(", concat(space, ")]"))
}

fn append_buf_bounds_meta(eff: string, call_name: string, buf_type: string) -> string {
    case call_name == "buf_load" or call_name == "read_buf" or call_name == "buf_store" or call_name == "write_buf" of {
        true -> {
            cap_param: string <- extract_length_from_buf_type(buf_type);
            case length_bytes(cap_param) == 0 of {
                true -> eff;
                false -> concat(eff, concat("|bounds:", cap_param))
            }
        };
        false -> eff
    }
}

fn extract_length_from_buf_type(buf_type: string) -> string {
    case length_bytes(buf_type) >= 4 and substring(buf_type, 0, 3) == "buf" of {
        true -> case length_bytes(buf_type) >= 5 and substring(buf_type, 3, 4) == "(" of {
            true -> {
                inner: string <- substring(buf_type, 4, length_bytes(buf_type) - 1);
                trim_space(nth_param(inner, 3))
            };
            false -> ""
        };
        false -> ""
    }
}

// Build SIR prim term for region built-in. context/expr_to_sir used for recursive conversion.
// expected_type: result type for effect extraction (region(R, Space), ref(R, Space, T), etc.)
// buf_type_for_bounds: full buf(R, Space, T, N) when lowering buffer access ops; else "".
fn build_region_prim_from_sir(call_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string, bounds_buf_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    prim: string <- sir_prim_name(call_name);
    eff: string <- effect_for_prim(call_name, expected_type);
    sir_value: string <- append_buf_bounds_meta(eff, call_name, bounds_buf_type);
    sir_type: string <- types@type_name_to_sir(result_type_for_prim(call_name, expected_type));
    sir_ast@make_sir_term(6, sir_type, sir_value, prim, arg1, arg2)
}

// Effect set for prim: fresh_lifetime has []; canonical_arena_same has []; else [mem(Space)]
fn effect_for_prim(call_name: string, expected_type: string) -> string {
    case call_name == "fresh_lifetime" or call_name == "canonical_arena_same" or call_name == "ref_eq" or call_name == "ref_in_region" of {
        true -> "[]";
        false -> {
            space: string <- extract_space_from_expected(expected_type);
            case space == "atomic" of {
                true -> case call_name == "alloc_ref" or call_name == "alloc_buf" or call_name == "alloc_rec" of {
                    true -> concat(concat("[mem(", space), "), atomic]");
                    false -> mem_effect(space)
                };
                false -> mem_effect(space)
            }
        }
    }
}

fn extract_space_from_expected(expected_type: string) -> string {
    (ok: boolean, space: string) <- extract_space_from_region_type(expected_type);
    case ok of {
        true -> space;
        false -> "normal"
    }
}

fn result_type_for_prim(call_name: string, expected_type: string) -> string {
    case call_name of {
        "alloc_region" -> "region(R, normal)";
        "alloc_ref" -> expected_type;
        "alloc_rec" -> expected_type;
        "read_ref" -> expected_type;
        "write_ref" -> "unit";
        "alloc_buf" -> expected_type;
        "buf_load" -> expected_type;
        "read_buf" -> expected_type;
        "buf_store" -> "unit";
        "write_buf" -> "unit";
        "fresh_lifetime" -> "lifetime";
        "canonical_arena_lookup" -> expected_type;
        "canonical_arena_same" -> "boolean";
        "ref_eq" -> "boolean";
        "ref_in_region" -> "boolean";
        _: string -> expected_type
    }
}
