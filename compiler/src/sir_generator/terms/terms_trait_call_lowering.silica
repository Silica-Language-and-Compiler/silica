    arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
        true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, "atom");
        false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "atom")
    };
