string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
        true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, "int64");
        false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "int64")
    };
    dummy: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@dummy_sir_term();
    case checked_int64_calls@is_checked_int64_unary_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
        true -> checked_int64_calls@build_checked_int64_prim_from_sir(type_checker_expressions_helpers@expr_name(expr), arg1, dummy, expected_type);
        false -> {
            arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case in_body of {
                true -> lower_in_body(context, terms_helpers@region_call_second_arg(expr), bound_name, bound_type, "int64");
                false -> lower_expected(context, terms_helpers@region_call_second_arg(expr), "int64")
            };
            checked_int64_calls@build_checked_int64_prim_from_sir(type_checker_expressions_helpers@expr_name(expr), arg1, arg2, expected_type)
        }
    }
}

