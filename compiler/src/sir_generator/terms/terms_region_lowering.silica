t64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
        true -> {
            idx: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "int64");
            val_type: string <- arg_type_for_region_prim_inferred(type_checker_expressions_helpers@expr_name(expr), 2, expected_type, expr, context);
            val: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_expected(context, buf_store_value_expr(expr), val_type);
            sir_type: string <- types@type_name_to_sir(val_type);
            sir_ast@make_sir_term(6, sir_type, "", "tuple_make", idx, val)
        };
        false -> sir_ast@dummy_sir_term()
    }
}

fn arg_type_for_region_prim(call_name: string, arg_idx: int64, expected_type: string) -> string {
    case call_name of {
        "alloc_region" -> "space";
        "alloc_ref" -> case arg_idx of { 0 -> type_checker_memory_regions@ref_type_to_region_type(expected_type); 1 -> type_checker_memory_regions@extract_element_type_from_ref(expected_type); _: int64 -> expected_type };
        "alloc_rec" -> case arg_idx of { 0 -> type_checker_memory_regions@ref_type_to_region_type(expected_type); 1 -> type_checker_memory_regions@extract_element_type_from_ref(expected_type); _: int64 -> expected_type };
        "read_ref" -> expected_type;
        "write_ref" -> case arg_idx of { 0 -> "ref(R, normal, int64)"; 1 -> expected_type; _: int64 -> "int64" };
        "alloc_buf" -> case arg_idx of { 0 -> type_checker_memory_regions@buf_type_to_region_type(expected_type); 1 -> "int64"; _: int64 -> "int64" };
        "buf_load" -> case arg_idx of { 0 -> expected_type; 1 -> "int64"; _: int64 -> "int64" };
        "read_buf" -> case arg_idx of { 0 -> expected_type; 1 -> "int64"; _: int64 -> "int64" };
        "buf_store" -> case arg_idx of { 0 -> expected_type; 1 -> "int64"; 2 -> expected_type; _: int64 -> "int64" };
        "write_buf" -> case arg_idx of { 0 -> expected_type; 1 -> "int64"; 2 -> expected_type; _: int64 -> "int64" };
        "fresh_lifetime" -> "lifetime";
        "canonical_arena_lookup" -> "int64";
        "canonical_arena_same" -> "region(R, normal)";
        "ref_eq" -> "ref(R, normal, int64)";
        "ref_in_region" -> case arg_idx of { 0 -> "ref(R, normal, int64)"; 1 -> "region(R, normal)"; _: int64 -> expected_type };
        _: string -> expected_type
    }
}

// Arg type when inference from expr is needed (buf_load, read_buf, buf_store, write_buf)

fn arg_type_for_region_prim_inferred(call_name: string, arg_idx: int64, expected_type: string, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }) -> string {
    case call_name == "canonical_arena_same" of {
        true -> case arg_idx of {
            0 -> terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
            1 -> terms_helpers@sir_infer_expr_type(context, terms_helpers@region_call_second_arg(expr));
            _: int64 -> "region(R, normal)"
        };
        false -> case call_name == "ref_eq" or call_name == "ref_in_region" of {
            true -> case arg_idx of {
                0 -> terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
                1 -> terms_helpers@sir_infer_expr_type(context, terms_helpers@region_call_second_arg(expr));
                _: int64 -> expected_type
            };
            false -> case call_name == "buf_load" or call_name == "read_buf" of {
                true -> case arg_idx of { 0 -> terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr)); 1 -> "int64"; _: int64 -> expected_type };
                false -> case call_name == "buf_store" or call_name == "write_buf" of {
                    true -> case arg_idx of {
                        0 -> terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
                        1 -> "int64";
                        2 -> type_checker_memory_regions@extract_element_type_from_buf(terms_helpers@sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr)));
                        _: int64 -> expected_type
                    };
                    false -> arg_type_for_region_prim(call_name, arg_idx, expected_type)
                }
            }
        }
    }
}

