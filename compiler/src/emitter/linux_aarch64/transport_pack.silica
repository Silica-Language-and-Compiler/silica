// The transport pack of this emit target (transport_serialization_design.md §6.0): which wire
// protocol tags and carrier tags this compiler build provides. The language's vocabulary is the
// union of every target's pack; a program that names a tag this pack does not list is rejected by
// sir_target_verify with E2410 before anything is emitted. Every emit target carries its own copy
// at emitter/<TARGET>/transport_pack.silica, read by the shared compiler like pack_descriptions.
// This OS-hosted target provides ETF (phase 3, Linux lock-step with the Apple Silicon pack); the
// carrier tags are provided as on the Mac, through compiler/stdlib/carrier.silica, not this pack.

export provides_format/1;
export provides_carrier/1;
export provides_link/2;
export provided_links/0;
export link_console_note/2;
export link_baud_ok/2;
export carrier_spawn/4;
export carrier_module/2;

fn provides_format(tag: string) -> boolean {
    case tag of {
        "etf" -> true;
        _: string -> false
    }
}

fn provides_carrier(tag: string) -> boolean {
    case tag of {
        _: string -> false
    }
}

// Carrier links (transport_links_design.md §5.1, specification §16.4.9): the shared compiler reads
// these rows for every `carried_on` declaration (E2412 in sir_target_verify and the parser's
// spawn_dangerous_carrier expansion). This target's rows are not written yet (phase A for the hosted
// targets is the Mac first, 2026-11-09): no link is provided, so a carried_on declaration compiled for
// this target is E2412, and spawn_dangerous_carrier has no expansion here.
fn provides_link(link_tag: string, instance: int64) -> boolean {
    false
}

fn provided_links() -> string {
    "(none: the carrier links of this target are not written yet)"
}

fn link_console_note(link_tag: string, instance: int64) -> string {
    ""
}

fn link_baud_ok(link_tag: string, baud: int64) -> boolean {
    true
}

fn carrier_module(kind: string, link_tag: string) -> string {
    ""
}

fn carrier_spawn(kind: string, link_tag: string, instance: int64, params: string) -> string {
    ""
}
