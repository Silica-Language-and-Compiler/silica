// Inline emission for print_float64 built-in.
// Always uses L_pf64_helper: const loads from L_f64_N, var has arg in D0.

use atom_table;
use emitter_effects;

export emit_print_float64_var/3;
export emit_print_float64_helper/0;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn emit_print_float64_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- "    BL L_pf64_helper\n";
    ok_index: int64 <- atom_table@ok_atom_index(table);
    ok_index_str: string <- atom_table@int64_to_decimal_string(ok_index);
    mov_ret: string <- concat(concat("    MOV ", dest), concat(", #", concat(ok_index_str, "\n")));
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// L_pf64_helper: D0 = float64 to print. Converts to string on stack, write(2).
// Integer part: FCVTZS, digit loop. Fractional part: frac*=10 loop (up to 15 digits).
fn emit_print_float64_helper() -> string {
    "L_pf64_helper:\n    SUB SP, SP, #64\n    STR D0, [SP, #0]\n    FCMP D0, #0.0\n    B.ge L_pf64_pos\n    MOV X0, #1\n    ADRP X1, L_pf64_minus\n    ADD X1, X1, :lo12:L_pf64_minus\n    MOV X2, #1\n    STR X8, [SP, #-16]!\n    MOV X8, #64\n    SVC #0\n    LDR X8, [SP], #16\n    LDR D0, [SP, #0]\n    FNEG D0, D0\n    STR D0, [SP, #0]\nL_pf64_pos:\n    FCVTZS X0, D0\n    MOV X10, SP\n    ADD X10, X10, #48\n    MOV X11, #0\n    CMP X0, #0\n    B.ge L_pf64_ipos\n    MOV X11, #1\n    NEG X0, X0\nL_pf64_ipos:\n    MOV X8, X10\n    CMP X0, #0\n    B.eq L_pf64_izero\n    MOV X9, #10\nL_pf64_iloop:\n    UDIV X1, X0, X9\n    MSUB X2, X1, X9, X0\n    ADD X2, X2, #48\n    SUB X8, X8, #1\n    STRB W2, [X8]\n    MOV X0, X1\n    CBNZ X0, L_pf64_iloop\n    B L_pf64_imaybe_neg\nL_pf64_izero:\n    SUB X8, X8, #1\n    MOV X1, #48\n    STRB W1, [X8]\nL_pf64_imaybe_neg:\n    CBNZ X11, L_pf64_iprepend_minus\n    B L_pf64_ido_int\nL_pf64_iprepend_minus:\n    SUB X8, X8, #1\n    MOV X1, #45\n    STRB W1, [X8]\nL_pf64_ido_int:\n    SUB X2, X10, X8\n    MOV X0, #1\n    MOV X1, X8\n    STR X8, [SP, #-16]!\n    MOV X8, #64\n    SVC #0\n    LDR X8, [SP], #16\n    LDR D0, [SP, #0]\n    FRINTZ D1, D0\n    FSUB D2, D0, D1\n    ADRP X8, L_pf64_10\n    LDR D3, [X8, :lo12:L_pf64_10]\n    MOV X12, #15\n    MOV X9, X10\n    SUB X9, X9, #15\n    MOV X8, X9\nL_pf64_frac_loop:\n    CBZ X12, L_pf64_frac_done\n    FMUL D2, D2, D3\n    FCVTZS X0, D2\n    ADD X2, X0, #48\n    STRB W2, [X8]\n    ADD X8, X8, #1\n    SCVTF D4, X0\n    FSUB D2, D2, D4\n    SUB X12, X12, #1\n    FCMP D2, #0.0\n    B.eq L_pf64_frac_done\n    B L_pf64_frac_loop\nL_pf64_frac_done:\n    SUB X9, X9, #1\n    MOV X1, #46\n    STRB W1, [X9]\n    SUB X2, X8, X9\n    MOV X0, #1\n    MOV X1, X9\n    STR X8, [SP, #-16]!\n    MOV X8, #64\n    SVC #0\n    LDR X8, [SP], #16\n    ADD SP, SP, #64\n    RET"
}
