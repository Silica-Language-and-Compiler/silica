// Checked int64 runtime helpers (Layer 1 §7.8).

export emit_checked_int64_runtime_asm/0;

fn emit_checked_int64_runtime_asm() -> string {
    add_fn: string <- "    .globl silica_rt_checked_i64_add\nsilica_rt_checked_i64_add:\n    ADDS X2, X0, X1\n    CSET W0, VC\n    CSEL X1, X2, XZR, VC\n    RET\n";
    add1_fn: string <- "    .globl silica_rt_checked_i64_add1\nsilica_rt_checked_i64_add1:\n    ADDS X2, X0, #1\n    CSET W0, VC\n    CSEL X1, X2, XZR, VC\n    RET\n";
    mul_fn: string <- "    .globl silica_rt_checked_i64_mul\nsilica_rt_checked_i64_mul:\n    MUL X2, X0, X1\n    CMP X0, #0\n    CSET W3, EQ\n    CBNZ W3, L_ci64_mul_zero\n    SDIV X4, X2, X0\n    CMP X4, X1\n    CSET W0, EQ\n    CSEL X1, X2, XZR, EQ\n    RET\nL_ci64_mul_zero:\n    MOV W0, #1\n    MOV X1, X2\n    RET\n";
    concat(concat(add_fn, add1_fn), mul_fn)
}

// linux_aarch64 runtime shims (Linux, glibc, AArch64). Linked once per executable through
// __silica_runtime.sams (prims_actors_runtime_asm@emit_actor_runtime_helpers appends this chunk).
//
// The actor runtime was written against Darwin libSystem. The apple_silicon_mac call sites survive
// unchanged in this tree except for the callee name; each Darwin-only entry point resolves here:
//
//   silica_rt_lock_lock / silica_rt_lock_unlock  <- os_unfair_lock_lock / os_unfair_lock_unlock
//       futex mutex on the same 4-byte word (0 = free, 1 = held, 2 = held with waiters).
//   silica_rt_futex_wait / silica_rt_futex_wake  <- __ulock_wait / __ulock_wake
//       futex(2) FUTEX_WAIT_PRIVATE / FUTEX_WAKE_PRIVATE(1). Same argument order as ulock:
//       wait(op, addr, expected, timeout=0), wake(op, addr, 0). One waiter is woken, as on Darwin.
//   silica_rt_sysctlbyname                       <- sysctlbyname
//       The hw.* names the topology code asks for, answered from sysconf(3), getauxval(AT_HWCAP)
//       and constants (table below). All cores report as performance cores; there is one perf level.
//       hw.logicalcpu and hw.perflevel0.logicalcpu (the carrier count and the P-core count of item N,
//       prims_actors_carrier_asm.silica) both answer sysconf(_SC_NPROCESSORS_ONLN); hw.perflevel1.logicalcpu is 0.
//   silica_rt_pthread_mach_thread_np             <- pthread_mach_thread_np   (identity)
//   silica_rt_thread_policy_set                  <- thread_policy_set
//       THREAD_AFFINITY_POLICY tag -> pthread_setaffinity_np. Tag 0 clears (all CPUs), a tag below
//       the CPU count pins to that CPU, the 'E'/'P' cluster tags are accepted and ignored.
//   silica_rt_pthread_set_qos_class_np           <- pthread_set_qos_class_np (no-op, returns 0)
//
// Linux AArch64 syscall numbers used: futex = 98. sysconf names: _SC_PAGESIZE 30,
// _SC_NPROCESSORS_ONLN 84, _SC_PHYS_PAGES 85, _SC_LEVEL1_DCACHE_SIZE 188, _SC_LEVEL2_CACHE_SIZE 191,
// _SC_LEVEL3_CACHE_SIZE 194. HWCAP bits: AES 3, SHA2 6, CRC32 7, ATOMICS (LSE) 8, SHA512 21.

export emit_linux_rt_shims_asm/0;

fn linux_shims_locks() -> string {
    "	.text
// silica_rt_lock_lock(X0 = lock word). Fast path CAS 0 -> 1; slow path swaps in 2 and futex-waits while 2.
	.globl	silica_rt_lock_lock
	.p2align	2
silica_rt_lock_lock:
	.cfi_startproc
Lsrl_fast:
	ldaxr	w9, [x0]
	cbnz	w9, Lsrl_slow
	mov	w10, #1
	stxr	w11, w10, [x0]
	cbnz	w11, Lsrl_fast
	ret
Lsrl_slow:
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
Lsrl_swap:
	ldaxr	w9, [x19]
	mov	w10, #2
	stlxr	w11, w10, [x19]
	cbnz	w11, Lsrl_swap
	cbz	w9, Lsrl_owned
	mov	x0, x19
	mov	w1, #128
	mov	w2, #2
	mov	x3, xzr
	mov	x4, xzr
	mov	x5, xzr
	mov	x8, #98
	svc	#0
	b	Lsrl_swap
Lsrl_owned:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.cfi_endproc
// silica_rt_lock_unlock(X0 = lock word). Decrement; if it was 2 (waiters), store 0 and wake one.
	.globl	silica_rt_lock_unlock
	.p2align	2
silica_rt_lock_unlock:
	.cfi_startproc
Lsru_dec:
	ldxr	w9, [x0]
	sub	w10, w9, #1
	stlxr	w11, w10, [x0]
	cbnz	w11, Lsru_dec
	cmp	w9, #1
	b.eq	Lsru_done
	stlr	wzr, [x0]
	mov	w1, #129
	mov	w2, #1
	mov	x3, xzr
	mov	x4, xzr
	mov	x5, xzr
	mov	x8, #98
	svc	#0
Lsru_done:
	ret
	.cfi_endproc
// silica_rt_futex_wait(W0 = op (ignored), X1 = addr, W2 = expected, W3 = timeout (0 only)).
	.globl	silica_rt_futex_wait
	.p2align	2
silica_rt_futex_wait:
	mov	x0, x1
	mov	w1, #128
	mov	x3, xzr
	mov	x4, xzr
	mov	x5, xzr
	mov	x8, #98
	svc	#0
	ret
// silica_rt_futex_wake(W0 = op (ignored), X1 = addr, X2 = 0). Wakes one waiter.
	.globl	silica_rt_futex_wake
	.p2align	2
silica_rt_futex_wake:
	mov	x0, x1
	mov	w1, #129
	mov	w2, #1
	mov	x3, xzr
	mov	x4, xzr
	mov	x5, xzr
	mov	x8, #98
	svc	#0
	ret
"
}

fn linux_shims_sysctl() -> string {
    "	.section .rodata
Lsys_n_pl0cpu:
	.asciz	\"hw.perflevel0.physicalcpu\"
Lsys_n_logicalcpu:
	.asciz	\"hw.logicalcpu\"
Lsys_n_pl0lcpu:
	.asciz	\"hw.perflevel0.logicalcpu\"
Lsys_n_pl1lcpu:
	.asciz	\"hw.perflevel1.logicalcpu\"
Lsys_n_pl1cpu:
	.asciz	\"hw.perflevel1.physicalcpu\"
Lsys_n_nperf:
	.asciz	\"hw.nperflevels\"
Lsys_n_memsize:
	.asciz	\"hw.memsize\"
Lsys_n_cls:
	.asciz	\"hw.cachelinesize\"
Lsys_n_l1d:
	.asciz	\"hw.l1dcachesize\"
Lsys_n_l2:
	.asciz	\"hw.l2cachesize\"
Lsys_n_l3:
	.asciz	\"hw.l3cachesize\"
Lsys_n_pl0l1d:
	.asciz	\"hw.perflevel0.l1dcachesize\"
Lsys_n_pl0l2:
	.asciz	\"hw.perflevel0.l2cachesize\"
Lsys_n_pl1l1d:
	.asciz	\"hw.perflevel1.l1dcachesize\"
Lsys_n_pl1l2:
	.asciz	\"hw.perflevel1.l2cachesize\"
Lsys_n_neon:
	.asciz	\"hw.optional.neon\"
Lsys_n_crc:
	.asciz	\"hw.optional.armv8_crc32\"
Lsys_n_arm64:
	.asciz	\"hw.optional.arm64\"
Lsys_n_lse:
	.asciz	\"hw.optional.arm.FEAT_LSE\"
Lsys_n_sha512:
	.asciz	\"hw.optional.arm.FEAT_SHA512\"
Lsys_n_sha256:
	.asciz	\"hw.optional.arm.FEAT_SHA256\"
Lsys_n_aes:
	.asciz	\"hw.optional.arm.FEAT_AES\"
Lsys_n_advsimd:
	.asciz	\"hw.optional.AdvSIMD\"
	.section .data.rel.ro,\"aw\",%progbits
	.p2align	3
// rows: name, kind (0 constant, 1 sysconf(arg), 2 HWCAP bit arg, 3 physical memory bytes), arg
Lsys_table:
	.quad	Lsys_n_pl0cpu, 1, 84
	.quad	Lsys_n_logicalcpu, 1, 84
	.quad	Lsys_n_pl0lcpu, 1, 84
	.quad	Lsys_n_pl1lcpu, 0, 0
	.quad	Lsys_n_pl1cpu, 0, 0
	.quad	Lsys_n_nperf, 0, 1
	.quad	Lsys_n_memsize, 3, 0
	.quad	Lsys_n_cls, 0, 64
	.quad	Lsys_n_l1d, 1, 188
	.quad	Lsys_n_l2, 1, 191
	.quad	Lsys_n_l3, 1, 194
	.quad	Lsys_n_pl0l1d, 1, 188
	.quad	Lsys_n_pl0l2, 1, 191
	.quad	Lsys_n_pl1l1d, 0, 0
	.quad	Lsys_n_pl1l2, 0, 0
	.quad	Lsys_n_neon, 0, 1
	.quad	Lsys_n_crc, 2, 7
	.quad	Lsys_n_arm64, 0, 1
	.quad	Lsys_n_lse, 2, 8
	.quad	Lsys_n_sha512, 2, 21
	.quad	Lsys_n_sha256, 2, 6
	.quad	Lsys_n_aes, 2, 3
	.quad	Lsys_n_advsimd, 0, 1
	.quad	0, 0, 0
	.text
// silica_rt_sysctlbyname(X0 = name, X1 = oldp, X2 = oldlenp, X3 = newp, X4 = newlen) -> W0 (0 ok, -1 unknown).
// *oldlenp is read and written as a 32-bit count (callers store it with str w0); 8-byte slots get the
// full value, 4-byte slots the low word.
	.globl	silica_rt_sysctlbyname
	.p2align	2
silica_rt_sysctlbyname:
	.cfi_startproc
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	adrp	x22, Lsys_table
	add	x22, x22, :lo12:Lsys_table
Lsys_scan:
	ldr	x0, [x22]
	cbz	x0, Lsys_fail
	mov	x1, x19
	bl	Lsys_streq
	cbnz	w0, Lsys_found
	add	x22, x22, #24
	b	Lsys_scan
Lsys_found:
	ldr	x9, [x22, #8]
	ldr	x0, [x22, #16]
	cmp	x9, #1
	b.eq	Lsys_sysconf
	cmp	x9, #2
	b.eq	Lsys_hwcap
	cmp	x9, #3
	b.eq	Lsys_memsize
	b	Lsys_store
Lsys_sysconf:
	bl	sysconf
	cmp	x0, #0
	csel	x0, x0, xzr, ge
	b	Lsys_store
Lsys_hwcap:
	mov	x19, x0
	mov	x0, #16
	bl	getauxval
	lsr	x0, x0, x19
	and	x0, x0, #1
	b	Lsys_store
Lsys_memsize:
	mov	x0, #85
	bl	sysconf
	mov	x19, x0
	mov	x0, #30
	bl	sysconf
	mul	x0, x0, x19
Lsys_store:
	cbz	x20, Lsys_ok
	cbz	x21, Lsys_fail
	ldr	w9, [x21]
	cmp	w9, #8
	b.hs	Lsys_store8
	cmp	w9, #4
	b.lo	Lsys_fail
	str	w0, [x20]
	mov	w9, #4
	str	w9, [x21]
	b	Lsys_ok
Lsys_store8:
	str	x0, [x20]
	mov	w9, #8
	str	w9, [x21]
Lsys_ok:
	mov	w0, #0
	b	Lsys_ret
Lsys_fail:
	mov	w0, #-1
Lsys_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.cfi_endproc
// Lsys_streq(X0, X1 = NUL-terminated strings) -> W0 = 1 when equal.
Lsys_streq:
	ldrb	w9, [x0], #1
	ldrb	w10, [x1], #1
	cmp	w9, w10
	b.ne	Lsys_streq_ne
	cbnz	w9, Lsys_streq
	mov	w0, #1
	ret
Lsys_streq_ne:
	mov	w0, #0
	ret
"
}

fn linux_shims_threads() -> string {
    "	.text
	.globl	silica_rt_pthread_mach_thread_np
	.p2align	2
silica_rt_pthread_mach_thread_np:
	ret
	.globl	silica_rt_pthread_set_qos_class_np
	.p2align	2
silica_rt_pthread_set_qos_class_np:
	mov	w0, #0
	ret
// silica_rt_thread_policy_set(X0 = pthread_t, W1 = flavor, X2 = &tag, W3 = count) -> W0.
// Frame: [16] x19/x20, [32..160) cpu_set_t (128 B).
	.globl	silica_rt_thread_policy_set
	.p2align	2
silica_rt_thread_policy_set:
	.cfi_startproc
	stp	x29, x30, [sp, #-160]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	ldr	w20, [x2]
	add	x0, sp, #32
	mov	x1, xzr
	mov	x2, #128
	bl	memset
	mov	x0, #84
	bl	sysconf
	cmp	x0, #1
	b.lt	Ltps_ok
	mov	x9, #1024
	cmp	x0, x9
	csel	x9, x0, x9, ls
	sxtw	x10, w20
	cbz	x10, Ltps_all
	cmp	x10, x9
	b.hs	Ltps_ok
	lsr	x11, x10, #6
	and	x12, x10, #63
	mov	x13, #1
	lsl	x13, x13, x12
	add	x14, sp, #32
	ldr	x15, [x14, x11, lsl #3]
	orr	x15, x15, x13
	str	x15, [x14, x11, lsl #3]
	b	Ltps_apply
Ltps_all:
	mov	x10, xzr
Ltps_all_loop:
	cmp	x10, x9
	b.hs	Ltps_apply
	lsr	x11, x10, #6
	and	x12, x10, #63
	mov	x13, #1
	lsl	x13, x13, x12
	add	x14, sp, #32
	ldr	x15, [x14, x11, lsl #3]
	orr	x15, x15, x13
	str	x15, [x14, x11, lsl #3]
	add	x10, x10, #1
	b	Ltps_all_loop
Ltps_apply:
	mov	x0, x19
	mov	x1, #128
	add	x2, sp, #32
	bl	pthread_setaffinity_np
	b	Ltps_ret
Ltps_ok:
	mov	w0, #0
Ltps_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #160
	ret
	.cfi_endproc
"
}

fn emit_linux_rt_shims_asm() -> string {
    concat(concat(linux_shims_locks(), linux_shims_sysctl()), linux_shims_threads())
}
