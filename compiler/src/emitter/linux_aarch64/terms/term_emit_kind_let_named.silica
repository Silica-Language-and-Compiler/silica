// Let-kind emission, named-binding arm -- first stage.
// Split at `body_bound` per tutorials_and_howtos/thin_dispatchers_for_compile_ram.md:
// one 240-line binding chain exceeded compile RAM in Type checking. Eleven scalar
// values cross the seam; the rest of the chain lives in the _tail module.

use let_dispatcher;
use prims_tuple;
use reg_conventions;
use string_parse;
use term_aggregate_helpers;
use term_let_helpers;
use term_reg_spill;
use term_sir_helpers;
use var;
use term_emit_kind_let_named_tail;

export emit_kind_let_named/5;

fn emit_kind_let_named(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
                            clean_bound: string <- var@base_reg_of(bound.bound_reg);
                            clean_outer: string <- var@base_reg_of(bound.outer_reg);
                            base_rhs: string <- let_dispatcher@compute_rhs_reg_in_let(term, dest, bound.bound_name, clean_bound, bound.outer_reg);
                            rhs_reg: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" of {
                                true -> "X0";
                                false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name == "int64" and dest == "X0" and clean_bound == "X1" of {
                                    true -> "X2";
                                    false -> base_rhs
                                }
                            };
                            outer_rhs_b: string <- term_reg_spill@outer_for_aggregate_let_rhs(term, bound.outer_reg);
                            rhs_asm: string <- case term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner).root < 0 of {
                                true -> "";
                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  rhs_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_rhs_b, debug: bound.debug })
                            };
                            spill_reg_b: string <- term_reg_spill@compute_let_rhs_spill_reg(term, rhs_reg, bound.outer_reg);
                            spill_b: boolean <- length_bytes(spill_reg_b) > 0;
                            rhs_bind_b: string <- case spill_b of { true -> spill_reg_b; false -> rhs_reg };
                            mov_spill_b: string <- case spill_b of { true -> term_reg_spill@mov_spill_from_rhs(rhs_reg, spill_reg_b); false -> "" };
                            packs_escape_b: boolean <- term_aggregate_helpers@let_stack_agg_escapes_via_tuple(term);
                            tm_adj: int64 <- case term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) of {
                                false -> 0;
                                true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" of {
                                    true -> term_aggregate_helpers@flat_tuple_nested_alloc(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), prims_tuple@count_flat_elements(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)), 0);
                                    false -> term_aggregate_helpers@flat_record_sum_nested_inners(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))
                                }
                            };
                            iap_b: string <- "";
                            va_b_tm: string <- case packs_escape_b of {
                                true -> "";
                                false -> case term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) of {
                                    // The RHS make is emitted with outer_reg = outer_rhs_b, so this
                                    // recomputes the SAME region base the make allocated. Recording the
                                    // memref (not an SP delta) is what lets projections address the
                                    // aggregate off X29 directly.
                                    true -> concat("|_va.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", term_reg_spill@frame_region_for(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), outer_rhs_b))));
                                    false -> ""
                                }
                            };
                            tp_pi_b: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_proj" and length_bytes(va_b_tm) == 0 of {
                                true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).right_expr)).value;
                                false -> ""
                            };
                            tp_eas_b: string <- case length_bytes(tp_pi_b) > 0 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) of {
                                true -> "";
                                false -> ""
                            };
                            va_b_tp: string <- case length_bytes(tp_pi_b) > 0 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) of {
                                true -> case length_bytes(tp_eas_b) > 0 of {
                                    true -> concat("|_va.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", tp_eas_b)));
                                    false -> ""
                                };
                                false -> ""
                            };
                            vr_svk_b: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 and (reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) or reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term).type_name)) and length_bytes(va_b_tm) == 0 and length_bytes(va_b_tp) == 0 of {
                                true -> concat("_va.", term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name);
                                false -> ""
                            };
                            vr_svs_b: string <- case length_bytes(vr_svk_b) > 0 of { true -> var@find_sp_binding(bound.outer_reg, vr_svk_b); false -> "" };
                            vr_adj_fb: string <- case length_bytes(vr_svs_b) == 0 and length_bytes(vr_svk_b) > 0 of {
                                true -> "";
                                false -> vr_svs_b
                            };
                            va_b_vr: string <- case length_bytes(vr_svk_b) > 0 of {
                                true -> case length_bytes(vr_adj_fb) > 0 of {
                                    true -> concat("|_va.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", vr_adj_fb)));
                                    false -> ""
                                };
                                false -> ""
                            };
                            va_b: string <- concat(va_b_tm, concat(va_b_tp, va_b_vr));
                            proj_tpv: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_proj" of {
                                true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).kind == 1 of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).name; false -> "" };
                                false -> ""
                            };
                            proj_tvs: string <- case length_bytes(proj_tpv) > 0 of { true -> var@find_sp_binding(bound.outer_reg, concat("_va.", proj_tpv)); false -> "" };
                            tp_proj_var_b: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_proj" and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).kind == 1 of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).name; false -> "" };
                            tp_ptr_reg_b: string <- case length_bytes(tp_proj_var_b) > 0 of {
                                true -> {
                                    from_outer: string <- var@find_sp_binding(bound.outer_reg, concat("_ptr.", tp_proj_var_b));
                                    case length_bytes(from_outer) > 0 of {
                                        true -> from_outer;
                                        false -> case tp_proj_var_b == bound.bound_name and length_bytes(bound.bound_reg) > 0 and substring(bound.bound_reg, 0, 1) != "[" of {
                                            true -> bound.bound_reg;
                                            false -> ""
                                        }
                                    }
                                };
                                false -> ""
                            };
                            tuple_root_gpr_b: string <- case length_bytes(tp_proj_var_b) > 0 of {
                                true -> var@find_sp_binding(bound.outer_reg, tp_proj_var_b);
                                false -> ""
                            };
                            rhs_bind_fp_prefix: string <- case length_bytes(rhs_bind_b) > 0 of {
                                true -> substring(rhs_bind_b, 0, 1);
                                false -> ""
                            };
                            rhs_is_fp_scalar_reg: boolean <- rhs_bind_fp_prefix == "S" or rhs_bind_fp_prefix == "D" or rhs_bind_fp_prefix == "H";
                            has_gpr_tuple_root_b: boolean <- length_bytes(tuple_root_gpr_b) > 0 and var@is_memory_ref(tuple_root_gpr_b) == false and rhs_is_fp_scalar_reg;
                            tp_is_reg_b: boolean <- length_bytes(tp_ptr_reg_b) > 0 or has_gpr_tuple_root_b;
                            // Prefer rhs_bind_b (post-spill) over rhs_reg. Tuple-proj lets of scalars spill
                            // X0/X1 into X19+; keeping body_bound on the caller-saved load reg made
                            // `(d, n) <- p; … + n` after a BL read a clobbered X1 (extract_function readers).
                            // No |_res= reservation. It was meant to keep a spill register taken when the binding's
                            // VALUE is a memory ref, but it was never effective (it was concatenated ahead of the base
                            // register, so is_reg_bound never matched it) and every build that passed the trial suites
                            // ran without it. Once it did take effect (2026-09-10) it starved the callee-saved chain:
                            // case arms then fell through to X29 frame slots the prologue had not budgeted, and
                            // [X29, #-16] landed on the saved X19/X20 pair (type_checker_expressions_binary_ops@
                            // check_comparison_operands). The register is already recorded by the name binding and,
                            // for aggregates, by the _ptr. binding; liveness is decided by kind (find_reg_pref_binding).
                            term_emit_kind_let_named_tail@emit_kind_let_named_tail(term, dest, bound, pools, emit_child, { rhs_reg: rhs_reg, rhs_asm: rhs_asm, rhs_bind_b: rhs_bind_b, mov_spill_b: mov_spill_b, packs_escape_b: packs_escape_b, iap_b: iap_b, va_b: va_b, proj_tvs: proj_tvs, tp_is_reg_b: tp_is_reg_b, alloc_bytes: case term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) of { true -> tm_adj; false -> 0 }, res_binding: "" })
                        }
