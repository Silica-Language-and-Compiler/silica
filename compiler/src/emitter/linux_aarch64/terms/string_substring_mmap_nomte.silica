// X8 is the Linux syscall number register and is also live scratch in these hand-written
// helpers (Darwin passed the number in X16, so the Apple original never had to care):
// the caller of the bump allocator keeps a source pointer in X8 across the call.
// Every raw syscall below saves and restores X8.

// String substring and substring_until_char helpers: non-MTE fallback for Apple Silicon (macOS ARM64).
// Per silica-specification §21.3: software-based bounds checking when MTE unavailable.
//
// L_substring_helper: X0 = ptr (literal or SilicaString), X1 = start_char (int64), X2 = end_char (int64).
// X8 = UTF-8 payload base (rodata or heap data ptr). Character-based indices.
// Returns X0 = ptr to substring [start_char, end_char). Clamps to valid range.
//
// Empty and 1-byte results are interned (no allocation). Longer results bump-allocate from
// 4MB mmap chunks. C-string length and an ASCII classification are cached per source pointer, in
// two entries (L_ss_ascii_key/flag and L_ss_ascii_key2/flag2, filled in turn): a scan that peeks
// one character of a haystack and then one of a needle, as the emitter's find_str_at does, hit
// a one-entry cache on neither string and reclassified the whole haystack per character (O(n^2)
// per scan; registry_many_names took 883 s to emit).
// A file with any UTF-8 (type_interner comments contain § — →) cannot use the ASCII fast path;
// sequential peeks then store an exclusive (char,byte) cursor so the next substring resumes
// there instead of walking from byte 0 (O(n²) lex hang). A backward step (L_ss_bwd) skips 80-BF
// bytes to the previous lead and accepts it only when that lead's forward length (the split
// L_ss_find_start uses) lands on the old position and no lead in the three bytes before it
// reaches it; ill-formed UTF-8, where the two splits can differ,
// restarts from byte 0 (before this check the cursor drifted and the lexer never reached the end).
//
// L_substring_until_char_helper: X0 = ptr, X1 = start (int64), X2 = encoded char (len<<56|packed).
// Returns X0 = ptr to substring from start until (exclusive) first occurrence of char, or rest of string.
// Full UTF-8 code-point matching: len=1..4 bytes, packed=byte0|(byte1<<8)|(byte2<<16)|(byte3<<24).
//
// The caches above, the one-character table and the bump arenas are one per compilation unit
// and shared by every actor thread, so each read or update of them is one step under L_ss_lock
// (L_suc_lock for the until-char arena): two actors building strings at once were handed the
// same bytes (book defect D12, trials/actors_addition/string_concat_cast_stress). The locked
// sections touch only these globals, never a caller's string, so a fault cannot leave a lock
// held. X18 is the Darwin platform register and is not used as a scratch (X12 is free there).
//
// Targets: Apple Silicon, macOS ARM64.

export emit_string_substring_helper/0;
export emit_string_substring_until_char_helper/0;

fn ss_helper_resolve() -> string {
    "L_substring_helper:\n    STP X19, X20, [SP, #-80]!\n    STP X21, X22, [SP, #16]\n    STP X23, X14, [SP, #32]\n    STP X15, X30, [SP, #48]\n    MOV X19, X0\n    MOV X20, X1\n    MOV X21, X2\n    CMP X20, #0\n    CSEL X20, XZR, X20, LT\n    CMP X21, #0\n    CSEL X21, XZR, X21, LT\n    LDR X10, [X19]\n    MVN X9, X10\n    CMP X9, #1\n    B.HI L_ss_bad\n    LDR X8, [X19, #8]\n    LDR X22, [X19, #16]\n    B L_ss_have_base\nL_ss_bad:\n    BRK #1\nL_ss_have_base:\n    CMP X20, X21\n    B.GE L_ss_empty\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    MOV W2, #1\nL_ss_lk_cls_spin:\n    LDAXR W3, [X1]\n    CBNZ W3, L_ss_lk_cls_wait\n    STXR W3, W2, [X1]\n    CBZ W3, L_ss_lk_cls_held\n    B L_ss_lk_cls_spin\nL_ss_lk_cls_wait:\n    CLREX\n    YIELD\n    B L_ss_lk_cls_spin\nL_ss_lk_cls_held:\n    ADRP X1, L_ss_ascii_key\n    ADD X1, X1, :lo12:L_ss_ascii_key\n    LDR X2, [X1]\n    LDR X3, [X1, #8]\n    LDR X10, [X1, #16]\n    LDR X11, [X1, #24]\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    STLR WZR, [X1]\n    CMP X2, X19\n    B.EQ L_ss_ascii_hit\n    MOV X3, X11\n    CMP X10, X19\n    B.NE L_ss_ascii_classify\nL_ss_ascii_hit:\n    CBNZ X3, L_ss_ascii_fast\n    B L_ss_utf8_slow\nL_ss_ascii_classify:\n    MOV X9, #0\n    MOV X14, #1\nL_ss_cls:\n    CMP X9, X22\n    B.GE L_ss_cls_done\n    LDRB W10, [X8, X9]\n    CMP W10, #0x80\n    CSEL X14, XZR, X14, HS\n    ADD X9, X9, #1\n    B L_ss_cls\nL_ss_cls_done:\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    MOV W2, #1\nL_ss_lk_clw_spin:\n    LDAXR W3, [X1]\n    CBNZ W3, L_ss_lk_clw_wait\n    STXR W3, W2, [X1]\n    CBZ W3, L_ss_lk_clw_held\n    B L_ss_lk_clw_spin\nL_ss_lk_clw_wait:\n    CLREX\n    YIELD\n    B L_ss_lk_clw_spin\nL_ss_lk_clw_held:\n    ADRP X1, L_ss_ascii_victim\n    ADD X1, X1, :lo12:L_ss_ascii_victim\n    LDR X2, [X1]\n    EOR X3, X2, #1\n    STR X3, [X1]\n    ADRP X1, L_ss_ascii_key\n    ADD X1, X1, :lo12:L_ss_ascii_key\n    ADD X1, X1, X2, LSL #4\n    STR X19, [X1]\n    STR X14, [X1, #8]\n    ADRP X1, L_ss_cached_len\n    ADD X1, X1, :lo12:L_ss_cached_len\n    STR X22, [X1]\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    STLR WZR, [X1]\n    CBNZ X14, L_ss_ascii_fast\n    B L_ss_utf8_slow\nL_ss_ascii_fast:\n    CMP X20, X22\n    CSEL X23, X22, X20, HI\n    CMP X21, X22\n    CSEL X9, X22, X21, HI\n    CMP X23, X9\n    CSEL X23, X9, X23, HI\n    SUB X11, X9, X23\n    B L_ss_materialize\n"
}

fn ss_helper_utf8_scan() -> string {
    "L_ss_utf8_slow:\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    MOV W2, #1\nL_ss_lk_cur_spin:\n    LDAXR W3, [X1]\n    CBNZ W3, L_ss_lk_cur_wait\n    STXR W3, W2, [X1]\n    CBZ W3, L_ss_lk_cur_held\n    B L_ss_lk_cur_spin\nL_ss_lk_cur_wait:\n    CLREX\n    YIELD\n    B L_ss_lk_cur_spin\nL_ss_lk_cur_held:\n    ADRP X1, L_ss_cur_key\n    ADD X1, X1, :lo12:L_ss_cur_key\n    LDR X2, [X1]\n    ADRP X1, L_ss_cur_char\n    ADD X1, X1, :lo12:L_ss_cur_char\n    LDR X14, [X1]\n    ADRP X1, L_ss_cur_byte\n    ADD X1, X1, :lo12:L_ss_cur_byte\n    LDR X9, [X1]\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    STLR WZR, [X1]\n    CMP X2, X19\n    B.NE L_ss_from_zero\n    CMP X9, X22\n    CSEL X9, X22, X9, HI\n    CMP X20, X14\n    B.LO L_ss_bwd\n    B L_ss_find_start\nL_ss_from_zero:\n    MOV X9, #0\n    MOV X14, #0\n    B L_ss_find_start\nL_ss_bwd:\n    CMP X14, X20\n    B.LE L_ss_start_found\n    CBZ X9, L_ss_start_found\n    MOV X12, X9\n    SUB X9, X9, #1\nL_ss_bwd_cont:\n    LDRB W10, [X8, X9]\n    LSR W11, W10, #6\n    CMP W11, #2\n    B.NE L_ss_bwd_lead\n    CBZ X9, L_ss_bwd_lead\n    SUB X9, X9, #1\n    B L_ss_bwd_cont\nL_ss_bwd_lead:\n    MOV X17, #1\n    CMP W10, #0xC2\n    B.LO L_ss_bwd_len\n    MOV X17, #2\n    CMP W10, #0xE0\n    B.LO L_ss_bwd_len\n    MOV X17, #3\n    CMP W10, #0xF0\n    B.LO L_ss_bwd_len\n    MOV X17, #4\n    CMP W10, #0xF8\n    B.LO L_ss_bwd_len\n    MOV X17, #1\nL_ss_bwd_len:\n    ADD X17, X9, X17\n    CMP X17, X22\n    CSEL X17, X22, X17, HI\n    CMP X17, X12\n    B.NE L_ss_from_zero\n    CBZ X9, L_ss_bwd_ok\n    SUB X12, X9, #1\n    LDRB W10, [X8, X12]\n    CMP W10, #0xC2\n    B.LO L_ss_bwd_p2\n    CMP W10, #0xF8\n    B.LO L_ss_from_zero\nL_ss_bwd_p2:\n    CBZ X12, L_ss_bwd_ok\n    SUB X12, X12, #1\n    LDRB W10, [X8, X12]\n    CMP W10, #0xE0\n    B.LO L_ss_bwd_p3\n    CMP W10, #0xF8\n    B.LO L_ss_from_zero\nL_ss_bwd_p3:\n    CBZ X12, L_ss_bwd_ok\n    SUB X12, X12, #1\n    LDRB W10, [X8, X12]\n    CMP W10, #0xF0\n    B.LO L_ss_bwd_ok\n    CMP W10, #0xF8\n    B.LO L_ss_from_zero\nL_ss_bwd_ok:\n    SUB X14, X14, #1\n    B L_ss_bwd\nL_ss_find_start:\n    CMP X14, X20\n    B.GE L_ss_start_found\n    CMP X9, X22\n    B.GE L_ss_start_found\n    LDRB W10, [X8, X9]\n    CMP W10, #0x80\n    B.LO L_ss_adv1\n    CMP W10, #0xC2\n    B.LO L_ss_adv1\n    CMP W10, #0xE0\n    B.LO L_ss_adv2\n    CMP W10, #0xF0\n    B.LO L_ss_adv3\n    CMP W10, #0xF8\n    B.LO L_ss_adv4\nL_ss_adv1:\n    ADD X9, X9, #1\n    ADD X14, X14, #1\n    B L_ss_find_start\nL_ss_adv2:\n    SUB X12, X22, X9\n    MOV X17, #2\n    CMP X12, #2\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X14, X14, #1\n    B L_ss_find_start\nL_ss_adv3:\n    SUB X12, X22, X9\n    MOV X17, #3\n    CMP X12, #3\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X14, X14, #1\n    B L_ss_find_start\nL_ss_adv4:\n    SUB X12, X22, X9\n    MOV X17, #4\n    CMP X12, #4\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X14, X14, #1\n    B L_ss_find_start\nL_ss_start_found:\n    MOV X23, X9\nL_ss_find_end:\n    CMP X14, X21\n    B.GE L_ss_end_found\n    CMP X9, X22\n    B.GE L_ss_end_found\n    LDRB W10, [X8, X9]\n    CMP W10, #0x80\n    B.LO L_ss_eadv1\n    CMP W10, #0xC2\n    B.LO L_ss_eadv1\n    CMP W10, #0xE0\n    B.LO L_ss_eadv2\n    CMP W10, #0xF0\n    B.LO L_ss_eadv3\n    CMP W10, #0xF8\n    B.LO L_ss_eadv4\nL_ss_eadv1:\n    ADD X9, X9, #1\n    ADD X14, X14, #1\n    B L_ss_find_end\nL_ss_eadv2:\n    SUB X12, X22, X9\n    MOV X17, #2\n    CMP X12, #2\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X14, X14, #1\n    B L_ss_find_end\nL_ss_eadv3:\n    SUB X12, X22, X9\n    MOV X17, #3\n    CMP X12, #3\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X14, X14, #1\n    B L_ss_find_end\nL_ss_eadv4:\n    SUB X12, X22, X9\n    MOV X17, #4\n    CMP X12, #4\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X14, X14, #1\n    B L_ss_find_end\nL_ss_end_found:\n    CMP X23, X22\n    CSEL X23, X22, X23, GT\n    CMP X9, X23\n    CSEL X9, X23, X9, LO\n    CMP X9, X22\n    CSEL X9, X22, X9, GT\n    SUB X11, X9, X23\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    MOV W2, #1\nL_ss_lk_cuw_spin:\n    LDAXR W3, [X1]\n    CBNZ W3, L_ss_lk_cuw_wait\n    STXR W3, W2, [X1]\n    CBZ W3, L_ss_lk_cuw_held\n    B L_ss_lk_cuw_spin\nL_ss_lk_cuw_wait:\n    CLREX\n    YIELD\n    B L_ss_lk_cuw_spin\nL_ss_lk_cuw_held:\n    ADRP X1, L_ss_cur_key\n    ADD X1, X1, :lo12:L_ss_cur_key\n    STR X19, [X1]\n    ADRP X1, L_ss_cur_char\n    ADD X1, X1, :lo12:L_ss_cur_char\n    STR X14, [X1]\n    ADRP X1, L_ss_cur_byte\n    ADD X1, X1, :lo12:L_ss_cur_byte\n    STR X9, [X1]\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    STLR WZR, [X1]\n    B L_ss_materialize\n"
}

fn ss_helper_materialize() -> string {
    "L_ss_materialize:\n    CBZ X11, L_ss_empty\n    CMP X11, #1\n    B.NE L_ss_heap\n    LDRB W13, [X8, X23]\n    ADRP X9, L_ss_lock\n    ADD X9, X9, :lo12:L_ss_lock\n    MOV W10, #1\nL_ss_lk_one_spin:\n    LDAXR W11, [X9]\n    CBNZ W11, L_ss_lk_one_wait\n    STXR W11, W10, [X9]\n    CBZ W11, L_ss_lk_one_held\n    B L_ss_lk_one_spin\nL_ss_lk_one_wait:\n    CLREX\n    YIELD\n    B L_ss_lk_one_spin\nL_ss_lk_one_held:\n    ADRP X0, L_ss_1char_ready\n    ADD X0, X0, :lo12:L_ss_1char_ready\n    LDR X1, [X0]\n    CBNZ X1, L_ss_1char_ok\n    ADRP X2, L_ss_1char_table\n    ADD X2, X2, :lo12:L_ss_1char_table\n    MOV X3, #0\n    MOV X4, #-1\nL_ss_1char_init:\n    STR X4, [X2]\n    ADD X5, X2, #24\n    STR X5, [X2, #8]\n    MOV X6, #1\n    STR X6, [X2, #16]\n    STRB W3, [X2, #24]\n    STRB WZR, [X2, #25]\n    ADD X2, X2, #32\n    ADD X3, X3, #1\n    CMP X3, #256\n    B.LO L_ss_1char_init\n    MOV X1, #1\n    STR X1, [X0]\nL_ss_1char_ok:\n    ADRP X9, L_ss_lock\n    ADD X9, X9, :lo12:L_ss_lock\n    STLR WZR, [X9]\n    ADRP X0, L_ss_1char_table\n    ADD X0, X0, :lo12:L_ss_1char_table\n    ADD X0, X0, X13, LSL #5\n    B L_ss_ret\nL_ss_empty:\n    ADRP X0, L_ss_empty_str\n    ADD X0, X0, :lo12:L_ss_empty_str\n    B L_ss_ret\nL_ss_heap:\n    ADD X0, X11, #25\n    BL L_ss_bump_alloc\n    CBZ X0, L_ss_ret\n    MOV X15, X0\n    MOV X9, #-1\n    STR X9, [X15]\n    ADD X9, X15, #24\n    STR X9, [X15, #8]\n    STR X11, [X15, #16]\n    ADD X10, X8, X23\n    MOV X12, X11\nL_ss_cp:\n    CBZ X12, L_ss_cp_done\n    LDRB W13, [X10]\n    STRB W13, [X9]\n    ADD X9, X9, #1\n    ADD X10, X10, #1\n    SUB X12, X12, #1\n    B L_ss_cp\nL_ss_cp_done:\n    STRB WZR, [X9]\n    MOV X0, X15\nL_ss_ret:\n    LDP X15, X30, [SP, #48]\n    LDP X23, X14, [SP, #32]\n    LDP X21, X22, [SP, #16]\n    LDP X19, X20, [SP], #80\n    RET\n"
}

fn ss_helper_bump_data() -> string {
    "L_ss_bump_alloc:\n    STP X19, X30, [SP, #-32]!\n    STP X20, X21, [SP, #16]\n    ADD X0, X0, #7\n    LSR X0, X0, #3\n    LSL X19, X0, #3\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    MOV W2, #1\nL_ss_lk_bump_spin:\n    LDAXR W3, [X1]\n    CBNZ W3, L_ss_lk_bump_wait\n    STXR W3, W2, [X1]\n    CBZ W3, L_ss_lk_bump_held\n    B L_ss_lk_bump_spin\nL_ss_lk_bump_wait:\n    CLREX\n    YIELD\n    B L_ss_lk_bump_spin\nL_ss_lk_bump_held:\n    ADRP X20, L_ss_arena_ptr\n    ADD X20, X20, :lo12:L_ss_arena_ptr\n    LDR X21, [X20]\n    CBZ X21, L_ss_bump_new\n    ADRP X1, L_ss_arena_end\n    ADD X1, X1, :lo12:L_ss_arena_end\n    LDR X2, [X1]\n    ADD X3, X21, X19\n    CMP X3, X2\n    B.HI L_ss_bump_new\n    STR X3, [X20]\n    MOV X0, X21\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\nL_ss_bump_new:\n    ADD X1, X19, #16\n    MOVZ X2, #0x40, LSL #16\n    CMP X1, X2\n    CSEL X1, X1, X2, HI\n    MOV X21, X1\n    MOV X0, #0\n    MOV X2, #3\n    MOV X3, #0x22\n    MOV X4, #-1\n    MOV X5, #0\n    STR X8, [SP, #-16]!\n    MOV X8, #222\n    SVC #0\n    LDR X8, [SP], #16\n    TBNZ X0, #63, L_ss_bump_fail\n    ADRP X2, L_ss_arena_head\n    ADD X2, X2, :lo12:L_ss_arena_head\n    LDR X3, [X2]\n    STR X3, [X0]\n    STR X21, [X0, #8]\n    STR X0, [X2]\n    ADD X1, X0, #16\n    ADD X3, X1, X19\n    STR X3, [X20]\n    ADRP X2, L_ss_arena_end\n    ADD X2, X2, :lo12:L_ss_arena_end\n    ADD X3, X0, X21\n    STR X3, [X2]\n    MOV X0, X1\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\nL_ss_bump_fail:\n    MOV X0, #0\n    ADRP X1, L_ss_lock\n    ADD X1, X1, :lo12:L_ss_lock\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\nL_ss_arena_release:\n    STP X19, X30, [SP, #-32]!\n    STP X20, X21, [SP, #16]\n    ADRP X20, L_ss_arena_head\n    ADD X20, X20, :lo12:L_ss_arena_head\n    LDR X19, [X20]\nL_ss_rel_loop:\n    CBZ X19, L_ss_rel_done\n    LDR X21, [X19]\n    LDR X1, [X19, #8]\n    MOV X0, X19\n    STR X8, [SP, #-16]!\n    MOV X8, #215\n    SVC #0\n    LDR X8, [SP], #16\n    MOV X19, X21\n    B L_ss_rel_loop\nL_ss_rel_done:\n    STR XZR, [X20]\n    ADRP X1, L_ss_arena_ptr\n    ADD X1, X1, :lo12:L_ss_arena_ptr\n    STR XZR, [X1]\n    ADRP X1, L_ss_arena_end\n    ADD X1, X1, :lo12:L_ss_arena_end\n    STR XZR, [X1]\n    ADRP X1, L_ss_ascii_key\n    ADD X1, X1, :lo12:L_ss_ascii_key\n    STR XZR, [X1]\n    STR XZR, [X1, #8]\n    STR XZR, [X1, #16]\n    STR XZR, [X1, #24]\n    STR XZR, [X1, #32]\n    ADRP X1, L_ss_cached_len\n    ADD X1, X1, :lo12:L_ss_cached_len\n    STR XZR, [X1]\n    ADRP X1, L_ss_cur_key\n    ADD X1, X1, :lo12:L_ss_cur_key\n    STR XZR, [X1]\n    ADRP X1, L_ss_cur_char\n    ADD X1, X1, :lo12:L_ss_cur_char\n    STR XZR, [X1]\n    ADRP X1, L_ss_cur_byte\n    ADD X1, X1, :lo12:L_ss_cur_byte\n    STR XZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\n    .bss\n    .p2align 3\nL_ss_ascii_key:\n    .space 8\nL_ss_ascii_flag:\n    .space 8\nL_ss_ascii_key2:\n    .space 8\nL_ss_ascii_flag2:\n    .space 8\nL_ss_ascii_victim:\n    .space 8\nL_ss_cached_len:\n    .space 8\nL_ss_cur_key:\n    .space 8\nL_ss_cur_char:\n    .space 8\nL_ss_cur_byte:\n    .space 8\nL_ss_lock:\n    .space 8\nL_ss_arena_ptr:\n    .space 8\nL_ss_arena_end:\n    .space 8\nL_ss_arena_head:\n    .space 8\nL_ss_1char_ready:\n    .space 8\nL_ss_1char_table:\n    .space 8192\n    .data\n    .p2align 3\nL_ss_empty_str:\n    .quad -1\n    .quad L_ss_empty_bytes\n    .quad 0\nL_ss_empty_bytes:\n    .byte 0\n    .text\n    .p2align 2\n"
}

fn emit_string_substring_helper() -> string {
    concat(concat(ss_helper_resolve(), ss_helper_utf8_scan()), concat(ss_helper_materialize(), ss_helper_bump_data()))
}

fn suc_helper_scan() -> string {
    "L_substring_until_char_helper:\n    STP X19, X20, [SP, #-80]!\n    STP X21, X22, [SP, #16]\n    STP X23, X14, [SP, #32]\n    STP X15, X30, [SP, #48]\n    MOV X19, X0\n    MOV X20, X1\n    MOV X21, X2\n    LSR X14, X21, #56\n    MOV W15, W21\n    CMP X14, #0\n    CINC X14, X14, EQ\n    LDR X9, [X19]\n    MVN X10, X9\n    CMP X10, #1\n    B.HI L_suc_bad\n    LDR X22, [X19, #16]\n    LDR X19, [X19, #8]\nL_suc_len_done:\n    CMP X20, #0\n    CSEL X20, XZR, X20, LT\n    CMP X20, X22\n    CSEL X20, X22, X20, GT\n    MOV X23, X20\n    ADD X9, X19, X20\nL_suc_scan:\n    CMP X20, X22\n    B.GE L_suc_scan_done\n    LDRB W10, [X9]\n    ADD X17, X20, X14\n    CMP X17, X22\n    B.GT L_suc_no_match\n    CMP X14, #1\n    B.EQ L_suc_cmp1\n    CMP X14, #2\n    B.EQ L_suc_cmp2\n    CMP X14, #3\n    B.EQ L_suc_cmp3\n    LDR W13, [X9]\n    CMP W13, W15\n    B.EQ L_suc_scan_done\n    B L_suc_no_match\nL_suc_cmp1:\n    LDRB W13, [X9]\n    UBFX W16, W15, #0, #8\n    CMP W13, W16\n    B.EQ L_suc_scan_done\n    B L_suc_no_match\nL_suc_cmp2:\n    LDRH W13, [X9]\n    UBFX W16, W15, #0, #16\n    CMP W13, W16\n    B.EQ L_suc_scan_done\n    B L_suc_no_match\nL_suc_cmp3:\n    LDR W13, [X9]\n    UBFX W13, W13, #0, #24\n    UBFX W16, W15, #0, #24\n    CMP W13, W16\n    B.EQ L_suc_scan_done\nL_suc_no_match:\n    CMP W10, #0x80\n    B.LO L_suc_adv1\n    CMP W10, #0xC2\n    B.LO L_suc_adv1\n    CMP W10, #0xE0\n    B.LO L_suc_adv2\n    CMP W10, #0xF0\n    B.LO L_suc_adv3\n    CMP W10, #0xF8\n    B.LO L_suc_adv4\nL_suc_adv1:\n    ADD X9, X9, #1\n    ADD X20, X20, #1\n    B L_suc_scan\nL_suc_adv2:\n    SUB X12, X22, X20\n    MOV X17, #2\n    CMP X12, #2\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X20, X20, X17\n    B L_suc_scan\nL_suc_adv3:\n    SUB X12, X22, X20\n    MOV X17, #3\n    CMP X12, #3\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X20, X20, X17\n    B L_suc_scan\nL_suc_adv4:\n    SUB X12, X22, X20\n    MOV X17, #4\n    CMP X12, #4\n    CSEL X17, X12, X17, LO\n    ADD X9, X9, X17\n    ADD X20, X20, X17\n    B L_suc_scan\n"
}

fn suc_helper_materialize() -> string {
    "L_suc_scan_done:\n    SUB X11, X20, X23\n    CBZ X11, L_suc_empty\n    ADD X10, X19, X23\n    ADD X0, X11, #25\n    BL L_suc_bump_alloc\n    CBZ X0, L_suc_ret\n    MOV X23, X0\n    MOV X9, #-1\n    STR X9, [X23]\n    ADD X9, X23, #24\n    STR X9, [X23, #8]\n    STR X11, [X23, #16]\n    MOV X12, X11\nL_suc_cp:\n    CBZ X12, L_suc_cp_done\n    LDRB W13, [X10]\n    STRB W13, [X9]\n    ADD X9, X9, #1\n    ADD X10, X10, #1\n    SUB X12, X12, #1\n    B L_suc_cp\nL_suc_cp_done:\n    STRB WZR, [X9]\n    MOV X0, X23\n    B L_suc_ret\nL_suc_empty:\n    ADRP X0, L_suc_empty_str\n    ADD X0, X0, :lo12:L_suc_empty_str\nL_suc_ret:\n    LDP X15, X30, [SP, #48]\n    LDP X23, X14, [SP, #32]\n    LDP X21, X22, [SP, #16]\n    LDP X19, X20, [SP], #80\n    RET\nL_suc_bump_alloc:\n    STP X19, X30, [SP, #-32]!\n    STP X20, X21, [SP, #16]\n    ADD X0, X0, #7\n    LSR X0, X0, #3\n    LSL X19, X0, #3\n    ADRP X1, L_suc_lock\n    ADD X1, X1, :lo12:L_suc_lock\n    MOV W2, #1\nL_suc_lk_bump_spin:\n    LDAXR W3, [X1]\n    CBNZ W3, L_suc_lk_bump_wait\n    STXR W3, W2, [X1]\n    CBZ W3, L_suc_lk_bump_held\n    B L_suc_lk_bump_spin\nL_suc_lk_bump_wait:\n    CLREX\n    YIELD\n    B L_suc_lk_bump_spin\nL_suc_lk_bump_held:\n    ADRP X20, L_suc_arena_ptr\n    ADD X20, X20, :lo12:L_suc_arena_ptr\n    LDR X21, [X20]\n    CBZ X21, L_suc_bump_new\n    ADRP X1, L_suc_arena_end\n    ADD X1, X1, :lo12:L_suc_arena_end\n    LDR X2, [X1]\n    ADD X3, X21, X19\n    CMP X3, X2\n    B.HI L_suc_bump_new\n    STR X3, [X20]\n    MOV X0, X21\n    ADRP X1, L_suc_lock\n    ADD X1, X1, :lo12:L_suc_lock\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\nL_suc_bump_new:\n    ADD X1, X19, #16\n    MOVZ X2, #0x40, LSL #16\n    CMP X1, X2\n    CSEL X1, X1, X2, HI\n    MOV X21, X1\n    MOV X0, #0\n    MOV X2, #3\n    MOV X3, #0x22\n    MOV X4, #-1\n    MOV X5, #0\n    STR X8, [SP, #-16]!\n    MOV X8, #222\n    SVC #0\n    LDR X8, [SP], #16\n    TBNZ X0, #63, L_suc_bump_fail\n    ADRP X2, L_suc_arena_head\n    ADD X2, X2, :lo12:L_suc_arena_head\n    LDR X3, [X2]\n    STR X3, [X0]\n    STR X21, [X0, #8]\n    STR X0, [X2]\n    ADD X1, X0, #16\n    ADD X3, X1, X19\n    STR X3, [X20]\n    ADRP X2, L_suc_arena_end\n    ADD X2, X2, :lo12:L_suc_arena_end\n    ADD X3, X0, X21\n    STR X3, [X2]\n    MOV X0, X1\n    ADRP X1, L_suc_lock\n    ADD X1, X1, :lo12:L_suc_lock\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\nL_suc_bump_fail:\n    MOV X0, #0\n    ADRP X1, L_suc_lock\n    ADD X1, X1, :lo12:L_suc_lock\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\n    .bss\n    .p2align 3\nL_suc_lock:\n    .space 8\nL_suc_arena_ptr:\n    .space 8\nL_suc_arena_end:\n    .space 8\nL_suc_arena_head:\n    .space 8\n    .data\n    .p2align 3\nL_suc_empty_str:\n    .quad -1\n    .quad L_suc_empty_bytes\n    .quad 0\nL_suc_empty_bytes:\n    .byte 0\n    .text\n    .p2align 2\n\nL_suc_bad:\n    BRK #1"
}

fn emit_string_substring_until_char_helper() -> string {
    concat(suc_helper_scan(), suc_helper_materialize())
}
