// call term emission ({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } kind 4)
// sir_emitter_pattern_spec §7.4: call -> BLR callee; result in X0
// Effect-aware: barriers before/after effectful calls per spec §9.1.1 Effect-to-Barrier Mapping
//   device_io: no barriers (syscall-based; kernel handles ordering)
//   register_rwr: DSB SY before, ISB after (direct mmap device access)
//   mem(atomic): DMB ISH before and after (cross-core visibility)
// term_emitter emits arg to X0 before calling; this emits barriers + BLR

use emitter_effects;
use control;
use module_linkage;
use reg_conventions;
use var;
use atom_table;
use string_parse;
use prims_tuple;

export emit_call_body/3;
export emit_call_body_effects/5;
export emit_call_body_with_callee/3;
export emit_tail_call_body/4;
export sir_call_targets_bound_callee/2;
export emit_indirect_callee_address_to_x17/2;
export sret_node_listed/3;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn sir_call_targets_bound_callee(outer_reg: string, sir_callee: string) -> boolean {
    (qmod: string, qfn: string) <- module_linkage@split_qualified_callee(sir_callee);
    case length_bytes(qmod) > 0 of {
        true -> false;
        false -> {
            b: string <- var@find_sp_binding_bare_or_percent_param(outer_reg, sir_callee);
            case length_bytes(b) == 0 of {
                true -> false;
                false -> var@binding_is_physical_int_reg(b) or var@is_memory_ref(b)
            }
        }
    }
}

fn emit_indirect_callee_address_to_x17(outer_reg: string, sir_callee: string) -> string {
    case sir_call_targets_bound_callee(outer_reg, sir_callee) of {
        false -> "";
        true -> {
            b: string <- var@find_sp_binding_bare_or_percent_param(outer_reg, sir_callee);
            case var@is_memory_ref(b) of {
                true -> concat(var@emit_ldr_mem_ref("X17", b), "\n");
                false -> case b == "X17" of {
                    true -> "";
                    false -> concat(concat(concat("    MOV X17, ", b), "\n"), "")
                }
            }
        }
    }
}

// --- sret tuple calls (reg_conventions@is_sret_tuple_type) ------------------------------------------
//
// The callee copies its result to [X8] and returns X8 in X0; X8 = 0 asks it for a fresh region block,
// which is what every tuple call got before. What the caller names:
//   - `_x8h<node>=N`: the let that destructures this call's result reserved a home at [X29, #-N]
//     (term_reg_spill@let_sret_home_off); the result is read through the projections and dies with
//     the frame, so nothing is allocated;
//   - a call on the function's return spine (`_rsp` lists the node) of an sret function passes the
//     caller's own buffer through (`_rsret=N`: X8 was saved at [X29, #-N] on entry), so the result is
//     written once, where it is finally wanted;
//   - anything else (bound to a name, an argument, an element, ...) may outlive the frame: X8 = 0.
// A call whose type is not an sret tuple but goes through a function value may still reach an sret
// function (a generic fn(T) -> T instantiated at a tuple), so it passes 0 as well.

// True when `key` (",<idx>,") occurs in `list` at or after i.
fn sret_node_listed(list: string, key: string, i: int64) -> boolean {
    case i + length_bytes(key) > length_bytes(list) of {
        true -> false;
        false -> case substring(list, i, i + length_bytes(key)) == key of {
            true -> true;
            false -> sret_node_listed(list, key, i + 1)
        }
    }
}

// X8 <- X29 - N (N a positive decimal string).
fn sret_x8_fp_sub(n: string) -> string {
    case string_parse@string_to_int64(n) <= 4095 of {
        true -> concat("    SUB X8, X29, #", concat(n, "\n"));
        false -> concat("    MOV X8, #", concat(n, "\n    SUB X8, X29, X8\n"))
    }
}

// A reply-form callee ((:reply, R, S) / (:no_reply, S)) takes its reply buffer in X<n> after its n
// arguments, not an sret pointer in X8, and with 8 parameters that is X8 itself: an indirect call
// must not zero it. See trials/compile_defects_reply_float_param_direct_call_addition.
fn reply_form_result_type(t: string) -> boolean {
    (length_bytes(t) >= 8 and substring(t, 0, 8) == "(:reply,") or (length_bytes(t) >= 11 and substring(t, 0, 11) == "(:no_reply,")
}

// X8 is the result buffer only where a call sets it on purpose: the sret paths above (a home, this
// function's own incoming buffer, or 0), a reply-form callee whose reply buffer is X<argc> (X8 itself
// with 8 parameters), and a tuple call whose slab term_emit_kind_call reserved with MOV X8, SP. Every
// other user call clears it: a callee that returns a record through X8 (emitter_core@
// fn_returns_sret_tuple) copies its result wherever a nonzero X8 points, and the caller's view of the
// type can miss that callee's convention. `m: OrderedMap[string, int64, mem(normal)] <-
// wbt_map@empty(..)` carried the trait type, no X8 was set, and the 64-byte map was copied over the
// 32-byte witness record X8 still pointed at; on linux_aarch64 that record ended an actor arena block
// mapped just below a glibc heap, and the copy overwrote the heap header (malloc arena assertion in
// gen2 compiling the tree). Clearing costs one instruction and a stale X8 can never reach a callee.
fn keeps_x8_for_callee(t: string) -> boolean {
    reply_form_result_type(t) or reg_conventions@is_tuple_type(t)
}

fn sret_x8_setup(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string, indirect: boolean) -> string {
    case prims_tuple@is_sret_aggregate_type(sir_term_root_node(term).type_name) of {
        true -> {
            home: string <- var@find_sp_binding(outer_reg, concat("_x8h", atom_table@int64_to_decimal_string(term.root)));
            case length_bytes(home) > 0 of {
                true -> sret_x8_fp_sub(home);
                false -> {
                    saved: string <- var@find_sp_binding(outer_reg, "_rsret");
                    on_spine: boolean <- length_bytes(saved) > 0 and sret_node_listed(var@find_sp_binding(outer_reg, "_rsp"), concat(",", concat(atom_table@int64_to_decimal_string(term.root), ",")), 0);
                    case on_spine of {
                        true -> concat(sret_x8_fp_sub(saved), "    LDR X8, [X8]\n");
                        false -> "    MOV X8, XZR\n"
                    }
                }
            }
        };
        false -> case keeps_x8_for_callee(sir_term_root_node(term).type_name) of {
            true -> "";
            false -> "    MOV X8, XZR\n"
        }
    }
}

// A tail call hands the callee this function's own X8 (it returns straight to our caller).
fn sret_x8_tail_setup(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string, indirect: boolean) -> string {
    case prims_tuple@is_sret_aggregate_type(sir_term_root_node(term).type_name) of {
        true -> {
            saved: string <- var@find_sp_binding(outer_reg, "_rsret");
            case length_bytes(saved) > 0 of {
                true -> concat(sret_x8_fp_sub(saved), "    LDR X8, [X8]\n");
                false -> "    MOV X8, XZR\n"
            }
        };
        false -> case keeps_x8_for_callee(sir_term_root_node(term).type_name) of {
            true -> "";
            false -> "    MOV X8, XZR\n"
        }
    }
}

fn emit_call_body_effects(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, effect_value: string, outer_reg: string, indirect_via_x9: boolean) -> string {
    call_effects: string <- effect_value;
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    adrp_line: string <- case indirect_via_x9 of {
        true -> "    BLR X17";
        false -> {
            callee: string <- module_linkage@asm_linkage_symbol_for_call(outer_reg, sir_term_root_node(term).name);
            adrp_part: string <- concat(concat(concat("    ADRP X9, ", callee), ""), "\n");
            add_part: string <- concat(concat("    ADD X9, X9, :lo12:", callee), "\n");
            concat(concat(adrp_part, add_part), "    BLR X9\n")
        }
    };
    // ARM64 AAPCS: integer returns land in W0/X0, floats in S0/D0/H0. Move into `dest`
    // unless it is already the corresponding return register. Earlier code treated any
    // W-/D-/S-/H-prefixed dest as "already in place", which corrupted every call whose
    // result had to flow into a non-zero register (e.g. W9 for a binary-op left operand).
    aggregate_return: boolean <- reg_conventions@is_aggregate_struct_or_tuple_return_type(sir_term_root_node(term).type_name);
    effective_dest: string <- case aggregate_return and length_bytes(dest) > 0 and substring(dest, 0, 1) == "W" of {
        true -> concat("X", substring(dest, 1, length_bytes(dest)));
        false -> dest
    };
    result_mov: string <- case effective_dest == "X0" or effective_dest == "W0" or effective_dest == "D0" or effective_dest == "S0" or effective_dest == "H0" of {
        true -> "";
        false -> case length_bytes(effective_dest) > 0 of {
            true -> {
                prefix: string <- substring(effective_dest, 0, 1);
                src: string <- case prefix == "D" or prefix == "S" or prefix == "H" of {
                    true -> concat(prefix, "0");
                    // Integer destinations (W, X, or anything else default): move from W0 for
                    // W-prefix destinations, X0 otherwise. This keeps the 32-bit zero-extending
                    // semantics of int32 results and preserves 64-bit moves for X-destinations.
                    false -> case prefix == "W" of {
                        true -> "W0";
                        false -> "X0"
                    }
                };
                op: string <- case prefix == "D" or prefix == "S" or prefix == "H" of {
                    true -> "FMOV";
                    false -> "MOV"
                };
                concat("\n", concat(concat(concat("    ", op), " "), concat(effective_dest, concat(", ", src))))
            };
            false -> ""
        }
    };
    with_comment: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    x8_line: string <- sret_x8_setup(term, outer_reg, indirect_via_x9);
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(with_comment, concat(pre_barrier, concat("\n", concat(x8_line, adrp_line))));
        false -> concat(with_comment, concat(x8_line, adrp_line))
    };
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_pre, concat("\n", post_barrier));
        false -> with_pre
    };
    concat(with_post, result_mov)
}

fn emit_call_body(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, outer_reg: string) -> string {
    emit_call_body_effects(term, dest, sir_term_root_node(term).value, outer_reg, false)
}

// Tail call ({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } kind 5): args already in registers — release frame, then BR (no BLR / no return to this frame).
// recursion_implementation.md Phase 5: native tail transfer; fn_effects controls DMB+LDP like epilogue (atomic release).
fn emit_tail_call_body(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, fn_effects: string, outer_reg: string, indirect_via_x9: boolean) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    br_line: string <- case indirect_via_x9 of {
        true -> "    BR X17";
        false -> {
            callee: string <- module_linkage@asm_linkage_symbol_for_call(outer_reg, sir_term_root_node(term).name);
            adrp_part: string <- concat(concat(concat("    ADRP X9, ", callee), ""), "\n");
            add_part: string <- concat(concat("    ADD X9, X9, :lo12:", callee), "\n");
            concat(concat(adrp_part, add_part), "    BR X9")
        }
    };
    frame_rel: string <- concat(sret_x8_tail_setup(term, outer_reg, indirect_via_x9), control@function_tail_frame_release(fn_effects));
    with_comment: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(with_comment, concat(pre_barrier, concat("\n", frame_rel)));
        false -> concat(with_comment, frame_rel)
    };
    concat(with_pre, concat("\n", br_line))
}

// Emit call with explicit callee symbol (e.g. silica_print_float64 for print_float64).
fn emit_call_body_with_callee(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, callee: string) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    adrp_part: string <- concat(concat(concat("    ADRP X9, ", callee), ""), "\n");
    add_part: string <- concat(concat("    ADD X9, X9, :lo12:", callee), "\n");
    adrp_line: string <- concat(concat(adrp_part, add_part), "    BLR X9\n");
    // No move when result already in dest: X0/W0 (int), D0/S0/H0 (float)
    aggregate_return: boolean <- reg_conventions@is_aggregate_struct_or_tuple_return_type(sir_term_root_node(term).type_name);
    effective_dest: string <- case aggregate_return and length_bytes(dest) > 0 and substring(dest, 0, 1) == "W" of {
        true -> concat("X", substring(dest, 1, length_bytes(dest)));
        false -> dest
    };
    result_mov: string <- case effective_dest == "X0" or effective_dest == "W0" or effective_dest == "D0" or effective_dest == "S0" or effective_dest == "H0" of {
        true -> "";
        false -> case length_bytes(effective_dest) > 0 of {
            true -> {
                prefix: string <- substring(effective_dest, 0, 1);
                src: string <- case prefix == "D" or prefix == "S" or prefix == "H" of {
                    true -> concat(prefix, "0");
                    false -> case prefix == "W" of {
                        true -> "W0";
                        false -> "X0"
                    }
                };
                op: string <- case prefix == "D" or prefix == "S" or prefix == "H" of {
                    true -> "FMOV";
                    false -> "MOV"
                };
                concat("\n", concat(concat(concat("    ", op), " "), concat(effective_dest, concat(", ", src))))
            };
            false -> ""
        }
    };
    with_comment: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(with_comment, concat(pre_barrier, concat("\n", adrp_line)));
        false -> concat(with_comment, adrp_line)
    };
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_pre, concat("\n", post_barrier));
        false -> with_pre
    };
    concat(with_post, result_mov)
}
