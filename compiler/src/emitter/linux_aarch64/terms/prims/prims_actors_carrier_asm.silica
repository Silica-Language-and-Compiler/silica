// Carrier threads (actor_memory_budget_plan.md item N; ROADMAP chunk 2, hosted part).
// linux_aarch64 port of emitter/apple_silicon_mac/terms/prims/prims_actors_carrier_asm.silica: GNU/ELF
// syntax, undecorated symbols; the locks are the futex locks of linux_rt_shims_asm.silica
// (silica_rt_lock_lock / _unlock, no owner check), the carrier's sleep is silica_rt_cv_wait_timeout's
// futex wait, and the carrier count and the core kinds come from the shim's sysctl table
// (hw.logicalcpu and hw.perflevel0.logicalcpu both answer sysconf(_SC_NPROCESSORS_ONLN): Linux
// reports every core as a performance core, so there are no efficiency carriers and
// pin_actor_to_efficiency_core moves nothing). Carrier affinity is real here: pthread_setaffinity_np
// binds carrier i to cpu i (silica_rt_carrier_main; the result is kept in the block at +224, never
// checked). A dangerous actor's thread keeps the shim's silica_rt_thread_policy_set. Everything
// else is the Apple text line for line (actor_memory_budget_plan.md, "Linux AArch64 port status").
//
// Carriers are the only execution model for actors on this target (Lee, 2026-10-19: no thread per
// actor, no opt-out). N carrier threads, one per logical core (`hw.logicalcpu`;
// `SILICA_CARRIER_COUNT=<n>` in the environment overrides the count, n >= 1; unset, 0 or not a
// number means the machine's count, at least 1), run every actor: workers from `spawn`,
// `spawn_linked` and `spawn_device`, the rows of every supervisor, supervisors themselves (their
// start trampoline, a supervisor's init and the materialisation of its children, runs in the
// actor's first dispatch, Lcar_first) and the runtime's own registry actors (the pid, dangerous
// and device registries), on the BEAM pattern the board already uses per core (rt_actors.S
// sched_loop / yield_to_sched / make_ready). The only threads besides the carriers are `main`,
// which is not an actor (it keeps its blocking futex and spin waits: wait_for_exit, a call, a
// spawn of a supervisor), and one thread per DANGEROUS actor (spawn_dangerous,
// spawn_dangerous_registered, a :dangerous row): a dangerous actor's foreign call may block, which
// would stall a carrier and every actor on it, and its guarded-FFI recovery state is per thread
// (spec §15.4.13.5, the AArch64 thread-isolation form; ffi_guarded_runtime_asm.silica), so it
// keeps the thread path of actor_thread_main (ACB #440 = 0). Until the gate was removed the
// stage 1-4 runtime kept a thread per actor by default (`SILICA_CARRIERS=1` opted in) and gave
// supervisors and the registries a thread each; that path is gone from everything but the
// dangerous actors.
//
//   - The carrier table (silica_rt_carriers): N blocks of 256 B, calloc'd at the first adoption
//     (silica_rt_carriers_ensure); a carrier's thread is created the first time an actor is bound
//     to it (silica_rt_carrier_ensure_started). A block: +0 lock (a futex lock), +8 futex word
//     the carrier sleeps on when its run queues are empty, +16 idle (1 while asleep), +24/+32
//     unused since stage 4 (the one run queue they held became the three below), +40 the actor
//     being run, +48 the carrier's base SP, +56 its 64 KB signal alternate stack, +64 pthread_t,
//     +72 started, +80 created, +88/+96 the thread's record (below), +104 the sweep list head
//     (idle :release_when_idle actors of this carrier still holding committed stack, linked
//     through ACB #456, oldest first), +112 the carrier's index, +120 the time of its last sweep;
//     +128 the three run queues, one per priority tier, 24 B each at +128 + 24 * q (q = 0 high, 1
//     normal, 2 low): head, tail (control blocks linked through ACB #456) and length; +200 the
//     weighted-fair tier being served and +208 its remaining credit; +216 the lottery's xorshift64
//     state (0 until the first draw); +224 the result of the thread's pthread_setaffinity_np (0
//     bound to cpu index, else the errno; Linux only); +232 the sweep list's tail and +240 its
//     listed bytes (the sum of ACB #288 over the listed actors; the Apple tree keeps these two at
//     +224/+232, which here is the affinity word); +248..+255 spare.
//   - Dispatch order (stage 4; the board's rt_actors.S silica_rt_rq_push / rq_pop, design in
//     design_documents/ports/esp32s3_xtensa_port.md §8.10): set_scheduler_policy chooses how the
//     READY actors of one carrier take turns. One policy word for the process
//     (silica_rt_sched_policy: 0 :priority_fifo, the default, 1 :round_robin, 2 :weighted_fair,
//     3 :lottery), applied by every carrier to its own queues, as the board applies one policy per
//     core: the call names no core and the specification's hints (§22.10, §23.1.1) are per-core
//     scheduler hints, so "per carrier" means each carrier orders its own ready set under the one
//     policy, never that a carrier has a policy of its own. The policy decides only which ready
//     actor runs next: never when a running one stops (nothing preempts between the yield points
//     of §15.1.2) and never which carrier an actor is on. Only silica_rt_rq_push (the queue an
//     actor is appended to: its priority tier, or the normal queue under :round_robin) and
//     silica_rt_rq_pop (the queue whose head runs: the highest-priority non-empty one under
//     :priority_fifo and :round_robin; deficit round robin over the tiers with quanta 4 / 2 / 1
//     and a unit cost per dispatch under :weighted_fair, an empty tier forfeiting its quantum; a
//     draw over weight x queued actors tickets, 4 / 2 / 1, under :lottery, the drawn tier's head
//     running) read the policy, both under the carrier's lock. A policy change takes effect at the
//     next push or pop on every carrier and leaves queued actors where they are (the board's rule):
//     a switch to :round_robin first drains what waits in the high and low queues, in the old
//     order; a switch away from it treats what waits in the flat queue as normal until each actor's
//     next push. An actor with more mail goes back to the tail of its queue at its dispatch
//     boundary (silica_rt_carrier_requeue), so under :priority_fifo a high actor with mail runs
//     before any normal one and a normal one before any low one, as on the board; the bound of
//     §22.10 (every actor with mail dispatched within a bounded number of dispatches) holds there
//     only while the higher tiers drain, and a program whose high actors always have mail selects
//     :weighted_fair (every tier served each round: a low actor waits at most 4 + 2 dispatches) or
//     :lottery (a low actor's expected wait is 7 draws, with no bound) for it.
//   - Priority (stage 4): set_actor_priority stores the level in ACB #520 (0 low, 1 normal, 2
//     high; every actor starts at normal, written at both calloc sites) for every actor; a carrier
//     actor's level is the tier it is pushed to and its weight class, read at its next push (a
//     queued actor stays where it is, as on the board); a thread actor's level is also mapped to a
//     pthread QoS class as before. Both calls are process-wide and lock nothing of a carrier but
//     the push and pop sites.
//   - The thread record: the pthread key (silica_actor_pthread_key) names a two-word record per
//     thread, the current actor and the carrier (0 when the thread is not a carrier's). A carrier's
//     record is in its block (+88, +96 = the block itself) and the carrier writes the current actor
//     with a plain store at each dispatch (risk R2.1: no pthread_setspecific per switch); an actor
//     thread's is in its control block (#496, #504 = 0); main gets a calloc'd record the first
//     time something installs a current actor on it (an ingress drain). Every runtime entry and
//     the fault handler read the current actor through the record (silica_rt_tls_current_actor_get),
//     and silica_rt_on_carrier_thread is the record's second word.
//   - Binding: an actor is bound at adoption to one carrier (ACB #440) and stays there until the
//     program moves it (stage 3) or it ends; the runtime never moves an actor on its own. A core
//     id given to spawn (ACB #208; a row child's spec has none) that names one of the machine's
//     logical cores (1 .. silica_rt_logical_cpu_count - 1, the count get_cpu_topology reports;
//     0 is the default) binds it to carrier `core mod N`, so a program that places on cores 1 and
//     2 lands on different carriers whenever there are two and is deterministic at every N; a
//     core the machine does not have, or no core id, takes the carriers in turn
//     (silica_rt_carrier_next, the board's rule in rt_actors.S spawn), which spreads the load
//     over the cores. With the default count N is the machine's logical core count and carrier
//     i is logical core i's; a SILICA_CARRIER_COUNT below it folds the core ids onto the
//     carriers (a trial knob). A worker and a supervisor are adopted alike; a supervisor (a
//     start trampoline, SB #48) is made ready at adoption instead of started, so its first
//     dispatch runs the trampoline and its spawner waits for the started word (#224) as before:
//     a carrier actor parks for it, main spins.
//   - Placement (stage 3; the spec's Actor Pinning Policy, §15.1.2, and §22.10): migrate_actor
//     moves a carrier actor to the carrier of the target core (silica_rt_carrier_migrate): an
//     idle actor is bound at once (one on its carrier's sweep list is unlisted and relisted on the
//     target); a ready, running or parked actor has the target left pending in ACB #512 and
//     applied at its next dispatch boundary (silica_rt_carrier_apply_pending, from
//     silica_rt_carrier_requeue and silica_rt_carrier_mark_idle), never while it runs and never
//     at a resume (a parked actor resumes on the carrier it parked on, inside the same
//     dispatch). The mailbox is the actor's own and moves with it. Codes: 0 :ok, 1
//     :invalid_target (no such logical core), 2 :actor_not_found (null or ended); 3
//     :migration_blocked is never produced here. pin_actor_to_core is that move;
//     pin_actor_to_performance_core / efficiency_core pick a carrier by core kind
//     (silica_rt_carrier_pick_kind: P carriers [0, min(P, N)), E carriers [P, N), in turn per
//     kind, no move when already on one of the kind or none exists); unpin_actor,
//     pin_actor_realtime and pin_actor_to_numa_node change nothing for a carrier actor (no
//     unpinned state; no real-time policy or NUMA domain is honoured on this target). A
//     dangerous actor (its own thread, #440 = 0) keeps the affinity path for its thread (the
//     shim's silica_rt_thread_policy_set, pthread_setaffinity_np to the core id). Each carrier
//     thread binds itself to its core with pthread_setaffinity_np (cpu = its index): on Linux
//     that is a real binding the kernel honours (not Darwin's ignored hint), but exclusivity of
//     the core is still not promised (spec §15.1.2, OS-hosted: the kernel shares the core with
//     other threads and processes); what is guaranteed is the carrier. The hosted runtime balances nothing on its
//     own; a program that wants BEAM-style balancing moves actors itself. The test-only query
//     actor_carrier_index(ref) reports the bound carrier's index (-1 for a dangerous actor).
//   - ACB fields (prims_actors_runtime_asm.silica layout): #440 the carrier (0 = a dangerous
//     actor, on a thread of its own),
//     #448 status (0 none, 1 idle, 2 ready: in a run queue, 3 running, 4 parked in a runtime
//     wait, 5 idle on the carrier's sweep list, 6 sweeping: taken off that list by its carrier's
//     sweep, which is about to release its stack under the actor's lock; on no queue or list; a
//     wake handles it like 1, a migration like 2-4), #456 run-queue, wait-list or sweep-list link, #464
//     the SP of a parked context (0 = none), #472 the actor parked in a spawn until this actor has
//     started, #480 the wait list the actor is parked on, #512 the pending migration target, #520
//     the priority level, #528 the SP of actor_thread_main's frame on a dangerous actor's own
//     thread (0 for a carrier actor), where silica_rt_thread_actor_end returns to end the thread.
//     Invariant: an actor on a carrier's run queue or sweep list has #440 = that carrier (the push
//     and the listing read #440 after any pending move is applied, and #440 changes only when the
//     actor is on neither, under its lock); so a carrier runs only actors bound to it, and every
//     path that leaves an actor re-enters the loop of the carrier the thread is, read before the
//     actor's status was published (not #440 afterwards, which a move may have changed).
//   - Dispatch: the carrier pops a ready actor (silica_rt_rq_pop, the policy's choice), writes its
//     record's current actor and enters the mailbox loop of actor_thread_main (LBB1_loop) with
//     X19 = the ACB, exactly as a dangerous actor's own thread does. An actor not yet started
//     (#224 = 0: a supervisor made ready at adoption) first runs its start trampoline (Lcar_first).
//     A behaviour runs on the actor's reservation with the carrier's SP kept in
//     ACB #368 and returns to the carrier on the dispatch boundary; the release algorithm then runs
//     on the carrier's stack. After the message the actor is re-queued when more mail waits, else
//     marked idle (silica_rt_carrier_mark_idle: on the sweep list when it is :release_when_idle
//     and holds committed stack).
//   - What runs on the actor's own stack, and so may park: the behaviour; the start trampoline;
//     a supervisor's restart of a row (maybe_restart with its :one_for_all / :rest_for_one
//     cascade, served from its own ingress at LBB1_ingress_no_beh, or by a drain from the reply
//     path, LBB1_reply_drain); and the delivering part of every exit path (LBB1_exit, badarith,
//     case_clause, the registry name-taken failure, silica_rt_actor_fail_current for an actor
//     with a supervision block): the exit of a supervisor shuts its children down last row first
//     and waits for each (silica_rt_sup_shutdown_children), and a child on the same carrier can
//     only end when this carrier runs it, so the wait must be a park, and a park needs a stack
//     the carrier loop will not reuse: the actor's own reservation, which is unmapped only after
//     that phase, on the carrier's stack. The carrier's stack is for what never waits: the
//     mailbox loop, the release algorithm, the re-queue, and the tail of an exit (stack_free,
//     the arena teardown, the final release).
//   - The idle sweep (release_when_idle_design.md, 2026-10-20): the sweep list is FIFO by the
//     actors' last-message stamps (ACB #344): silica_rt_carrier_mark_idle appends at the tail
//     (+232) in the same dispatch that stamped, and adds the actor's committed bytes (#288) to the
//     listed total (+240). silica_rt_carrier_sweep takes from the head only, in batches of at
//     most 64 per call: an actor whose stamp is the idle period old (silica_rt_stack_idle_due,
//     against ONE clock reading per batch; the period is silica_rt_idle_release_ns, spec
//     §15.1.2.2's second unless SILICA_IDLE_RELEASE_MS says otherwise), or any head while the
//     listed total exceeds the carrier's idle-stack budget (silica_rt_idle_stack_budget: oldest
//     first, whatever its age, so the committed stack idle actors hold on a carrier is bounded by
//     the budget plus one actor's stack and the batch in flight, whatever the spawn rate). The
//     walk stops at the first head not yet due, so a sweep costs O(released), never O(listed). No
//     stack is released under the carrier's lock: per actor the sweep unlinks it and marks it 6
//     (sweeping) under the carrier's lock, lets that lock go, takes the actor's own lock and, when
//     its status is still 6, releases it (silica_rt_stack_release_to, on the carrier's stack; it
//     never waits) and marks it plainly idle (1); a status of 2 found there (mail, a stop or a
//     migration's wake made it ready meanwhile) means no release: the actor is about to run and
//     will stamp and relist at its next boundary. Only one of the two locks is held at a time.
//     A carrier sweeps before it sleeps on an empty queue (batch after batch while the sweep
//     answers 1, re-checking its queues between batches, then waits with the microseconds until
//     the head is due as its timeout) and, while busy, at a dispatch when the listed total is over
//     budget (checked at every pop) or when the head is due and silica_rt_idle_sweep_ns
//     (min(250 ms, the period / 4)) has passed since the last sweep; a busy sweep that answers 1
//     is followed by ONE dispatch and then the next batch, so a burst of spawns never starves and
//     the batch bounds the dispatch latency it adds. A migration relist (Lcmg_listed) appends an
//     older stamp behind newer ones on the target: it is released when the entry before it is,
//     at most one extra period late. The list changes only under the carrier's lock (the listing
//     by mark_idle, the sweep's hand-off, and silica_rt_carrier_unlist when mail or a migration
//     takes a listed actor off); status 6 is written under the carrier's lock on the carrier's own
//     thread and read under the actor's lock.
//   - The carrier loop is re-entered afresh (SP reset to the base, current actor cleared) from every
//     path that leaves an actor: a dispatch boundary with an empty mailbox, an exit path (which runs
//     on the carrier's stack, like the board's scheduler running a faulted actor's exit), or a park.
//   - Parking: an actor that must wait inside a behaviour (a `call` awaiting its reply; a spawn
//     waiting for its child's start) saves X19-X30 and D8-D15 on its own stack, records that SP in
//     #464 and leaves for the carrier loop; the wake side (the reply, the call death, the child's
//     started store) moves it from parked to ready under the same lock the parker used and pushes
//     it on ITS carrier's run queue (silica_rt_carrier_push reads #440: the waker may be on
//     another carrier, an actor thread or main), waking that carrier when it sleeps; the carrier
//     resumes it by reloading the context. The actor's return into the carrier's dispatch code
//     reads nothing from the carrier's abandoned frame: the node being dispatched is ACB #240.
//   - Mail: every wake of a mailbox (the sites that signalled ACB+80) goes through
//     silica_rt_actor_mail_signal, which also makes an idle carrier actor ready on its own
//     carrier and wakes that carrier's futex when it sleeps; every wake of a call wrapper goes
//     through silica_rt_call_wrapper_wake.
//   - The restart protocol's primitives live here (the protocol itself is described in
//     prims_actors_child_table_asm.silica's header): silica_rt_row_wait, the one wait for a row
//     child's exit (kill_abnormal, terminate_child / remove_child / restart_child, a supervisor's
//     shutdown, a :one_for_all or :rest_for_one cascade), for one identity in the row's exit_done
//     (+56, a generation word that is never cleared); silica_rt_actor_stop, the one way another
//     actor is ended, which also ends a wait the stopped actor is parked or spinning in;
//     silica_rt_sup_restart_try / acquire / release, the supervision block's restart token
//     (#120) with one holder at a time and a wait list (+128) for carrier actors parked for it. A
//     carrier actor on its own stack parks (silica_rt_wait_park): it links itself, through ACB
//     #456, into the list (its head's address kept in ACB #480) under silica_rt_row_wait_lock,
//     which guards every wait list; the wake side (silica_rt_wait_list_wake: the child's last act,
//     silica_rt_row_exit_done_store, or a token release) holds it to take the list and never holds
//     it while it takes an actor's lock; a stop holds the actor's lock and then the wait lock to
//     unlink. The check and the push are one critical section, so no wake is lost. A wait entered
//     while the thread's current actor was another restores that actor after the resume (no
//     runtime path installs another actor any more: an ingress drain used to install the
//     supervisor, until 2026-10-20; the supervisor is passed explicitly instead, so the drainer
//     stays the current actor and every park decision is by the carrier's running actor,
//     silica_rt_carrier_self_on_own_stack). Anything that is not a carrier actor on its own stack
//     spins (main, a dangerous actor's thread). A carrier actor on the carrier's own stack that
//     would spin for another carrier actor is a runtime abort (Lrw_spin): with every waiting
//     path above moved onto the actor's own stack it is unreachable, and it is kept as the
//     assertion of that rule, since a spin there would be a silent deadlock on a shared carrier
//     (the awaited actor can only run on the stack being spun on) and a stall on any other.
//
// Lock order, with any number of carriers and with supervisors on them (an actor's lock is
// ACB+16; a supervisor's is the same lock of the supervisor's block):
//   a call wrapper's lock (+72)  >  the waiting actor's lock  >  the supervisor's lock  >
//   silica_rt_row_wait_lock  >  a carrier's lock (+0).
// A supervisor on a carrier is itself the waiting actor in its own cascade (silica_rt_row_wait
// takes its lock, then the wait lock) and in a drain of its own ingress from its reply path
// (silica_rt_sup_restart_acquire with the asking actor equal to the supervisor: the one lock is
// taken once and serves both positions); the order is then the waiting actor's lock = the
// supervisor's lock > the wait lock, the same chain with one link. A carrier's lock is a leaf:
// it is taken by the carrier loop with nothing else held, and by silica_rt_carrier_push,
// mark_idle, unlist and sweep with at most one actor's lock (and the locks above it) held; no
// path holds two carriers' locks, so a reply on carrier 2 that pushes its parked caller to
// carrier 1, a supervisor's cascade on carrier 1 that stops siblings on carriers 2 and 3, and
// two carriers waking each other's actors all take the locks in this order.
// The sweep's two sections (the hand-off under the carrier's lock, the release under the actor's)
// are taken in sequence with nothing else held, never nested. silica_rt_carriers_lock (the
// table's creation, once) and the identity table's lock (silica_rt_ref_hold, taken by every
// reference resolution with nothing of the above held) are leaves of their own. The wrapper lock sits above the actor locks on the reply path
// (LBB1_post_beh holds the wrapper while the ingress drain takes the replier's and its
// supervisor's locks) and a dying actor's mailbox lock is held while the wrappers of calls INTO
// it are signalled (silica_rt_actor_signal_pending_call_deaths): those are different wrappers
// from the one a replier holds (an actor cannot reply and die at once).
//
// Not here: time beyond send_after / cancel_timer (prims_actors_timer_asm.silica: one service thread
// per process feeds the mailboxes through silica_rt_actor_mail_signal), call_with_timeout, and any
// preemption (ROADMAP chunk 11); the
// pooled FFI worker thread of spec §15.4.13.5 (a dangerous actor is one thread today).

export emit_actor_carrier_runtime_asm/0;

fn carrier_asm_data() -> string {
    "	.bss
	.p2align	4
	.globl	silica_rt_carrier_count
silica_rt_carrier_count:
	.zero	8
	.globl	silica_rt_carriers
silica_rt_carriers:
	.zero	8
silica_rt_carrier_next:
	.zero	8
silica_rt_carriers_lock:
	.zero	8
	.globl	silica_rt_row_wait_lock
silica_rt_row_wait_lock:
	.zero	16
	.globl	silica_rt_logical_cpu_count
silica_rt_logical_cpu_count:
	.zero	8
	.globl	silica_rt_pcore_count
silica_rt_pcore_count:
	.zero	8
silica_rt_pcore_next:
	.zero	8
silica_rt_ecore_next:
	.zero	8
	.globl	silica_rt_sched_policy
silica_rt_sched_policy:
	.zero	8
	.section .rodata
L_srt_carrier_count_env:
	.asciz	\"SILICA_CARRIER_COUNT\"
L_srt_hw_logicalcpu:
	.asciz	\"hw.logicalcpu\"
L_srt_hw_perf0_logicalcpu:
	.asciz	\"hw.perflevel0.logicalcpu\"
Lrta_r_carrier_wait:
	.asciz	\"a carrier actor waited on the carrier's own stack for another actor of its carrier\"
Lrta_r_row_wake:
	.asciz	\"a row child's exit found an actor on its wait list that was not parked for it\"
Lrta_r_carrier_thread:
	.asciz	\"the carrier thread could not be created\"
Lrta_r_carrier_table:
	.asciz	\"the carrier table could not be made\"
Lrta_r_thread_record:
	.asciz	\"the thread's actor record could not be made\"
	.text
"
}

fn carrier_asm_adopt() -> string {
    "	.globl	silica_rt_carrier_adopt
	.p2align	2
silica_rt_carrier_adopt:
// X0 = a new ACB (reservation made, arena bookkeeping set), X1 = its start trampoline (0 = none),
// X2 = 1 for a dangerous actor. -> X0 = 1 when the actor was given to a carrier (no thread is to
// be made): every actor but a dangerous one, whose foreign calls may block and whose guarded-FFI
// state is per thread, so it keeps a thread of its own (X0 = 0). A supervisor or any other actor
// with a trampoline is bound and made READY (status 2, on its carrier's run queue) instead of
// started: its first dispatch runs the trampoline (Lcar_first) and then stores the started word
// (#224), which its spawner waits for; an actor without one is idle and started at once. The
// carrier: `core mod N` for a core id (#208) that names one of the machine's logical cores, 1 ..
// silica_rt_logical_cpu_count - 1 (a row child's #208 is its row pointer, no core id; 0 is the
// default; a core the machine does not have is placed in turn, the board's rule for an
// out-of-range core at spawn); else the next carrier in turn.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x22, x1
	cbnz	x2, Lcad_no
	bl	silica_rt_carriers_ensure
	mov	x21, x0
	adrp	x8, silica_rt_carrier_count
	add	x8, x8, :lo12:silica_rt_carrier_count
	ldr	x10, [x8]
	ldr	x9, [x19, #208]
	cmp	x9, #4096
	b.hs	Lcad_in_turn
	cbz	x9, Lcad_in_turn
	adrp	x8, silica_rt_logical_cpu_count
	add	x8, x8, :lo12:silica_rt_logical_cpu_count
	ldr	x11, [x8]
	cmp	x9, x11
	b.hs	Lcad_in_turn
	udiv	x11, x9, x10
	msub	x9, x11, x10, x9
	b	Lcad_have_index
Lcad_in_turn:
	adrp	x8, silica_rt_carrier_next
	add	x8, x8, :lo12:silica_rt_carrier_next
Lcad_turn_loop:
	ldaxr	x9, [x8]
	add	x11, x9, #1
	cmp	x11, x10
	b.lo	Lcad_turn_store
	mov	x11, xzr
Lcad_turn_store:
	stlxr	w12, x11, [x8]
	cbnz	w12, Lcad_turn_loop
Lcad_have_index:
	add	x20, x21, x9, lsl #8
	mov	x0, x20
	bl	silica_rt_carrier_ensure_started
	cbz	x0, Lcad_bound
// The host refused this carrier's thread (dangerous actors may hold every thread it allows, item N
// #5): the actor goes to a carrier that runs instead of its `core mod N` or in-turn one. None running
// (the first adoption only) is the runtime abort: the carrier thread could not be created.
	mov	x0, x21
	bl	silica_rt_carrier_started_any
	cbz	x0, Lcad_no_carrier
	mov	x20, x0
Lcad_bound:
	str	x20, [x19, #440]
	mov	x9, #1
	str	x9, [x19, #448]
	str	xzr, [x19, #456]
	str	xzr, [x19, #464]
	str	xzr, [x19, #472]
	str	xzr, [x19, #512]
	cbnz	x22, Lcad_ready
	mov	x0, x19
	mov	x1, #1
	bl	silica_rt_started_store
	mov	x0, #1
	b	Lcad_ret
Lcad_ready:
// A trampoline to run: ready on its carrier, under its lock (its identity resolves already, so a
// cast could race the status; a push needs the status guarded by the actor's lock).
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	silica_rt_carrier_push
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	mov	x0, #1
	b	Lcad_ret
Lcad_no_carrier:
	adrp	x0, Lrta_r_carrier_thread
	add	x0, x0, :lo12:Lrta_r_carrier_thread
	bl	silica_rt_abort_with
	b	Lcad_no_carrier
Lcad_no:
	mov	x0, xzr
Lcad_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	silica_rt_carriers_ensure
	.p2align	2
silica_rt_carriers_ensure:
// -> X0 = the carrier table, made the first time: silica_rt_carrier_count blocks of 256 B (the
// count was read by silica_rt_stack_runtime_init; 1 when it was not), each knowing itself (+96)
// and its index (+112), its weighted-fair round starting at the high tier with its quantum (+200
// = 0 from calloc, +208 = 4, as the board's core block starts). Failure to make it is a runtime
// abort.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	adrp	x19, silica_rt_carriers
	add	x19, x19, :lo12:silica_rt_carriers
	ldar	x0, [x19]
	cbnz	x0, Lcen_ret
	adrp	x0, silica_rt_carriers_lock
	add	x0, x0, :lo12:silica_rt_carriers_lock
	bl	silica_rt_lock_lock
	ldr	x0, [x19]
	cbnz	x0, Lcen_unlock
	adrp	x8, silica_rt_carrier_count
	add	x8, x8, :lo12:silica_rt_carrier_count
	ldr	x20, [x8]
	cbnz	x20, Lcen_have_count
	mov	x20, #1
	str	x20, [x8]
Lcen_have_count:
	mov	x0, x20
	mov	x1, #256
	bl	calloc
	cbz	x0, Lcen_failed
	mov	x21, x0
	mov	x9, x0
	mov	x10, xzr
	mov	x11, #4
Lcen_fill:
	cmp	x10, x20
	b.hs	Lcen_filled
	str	x9, [x9, #96]
	str	x10, [x9, #112]
	str	x11, [x9, #208]
	add	x9, x9, #256
	add	x10, x10, #1
	b	Lcen_fill
Lcen_filled:
	stlr	x21, [x19]
Lcen_unlock:
	adrp	x0, silica_rt_carriers_lock
	add	x0, x0, :lo12:silica_rt_carriers_lock
	bl	silica_rt_lock_unlock
	ldr	x0, [x19]
Lcen_ret:
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
Lcen_failed:
	adrp	x0, Lrta_r_carrier_table
	add	x0, x0, :lo12:Lrta_r_carrier_table
	bl	silica_rt_abort_with
	b	Lcen_failed
	.globl	silica_rt_carrier_ensure_started
	.p2align	2
silica_rt_carrier_ensure_started:
// X0 = carrier block. Creates its thread the first time. -> X0 = 0 when the carrier runs (it did
// already, or its thread was made now), 1 when the host refused the thread (item N #5: dangerous
// actors, each on a thread of its own, may hold every thread the host allows): the carrier stays
// without one, and the caller places the actor on a carrier that runs (silica_rt_carrier_adopt)
// or answers :migration_blocked (silica_rt_carrier_migrate).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, xzr
	add	x9, x19, #80
	ldar	x8, [x9]
	cbnz	x8, Lces_ret
	mov	x0, x19
	bl	silica_rt_lock_lock
	ldr	x8, [x19, #80]
	cbnz	x8, Lces_unlock
	add	x0, x19, #64
	mov	x1, xzr
	adrp	x2, silica_rt_carrier_main
	add	x2, x2, :lo12:silica_rt_carrier_main
	mov	x3, x19
	bl	pthread_create
	cbnz	w0, Lces_failed
	ldr	x0, [x19, #64]
	bl	pthread_detach
	mov	x8, #1
	add	x9, x19, #80
	stlr	x8, [x9]
Lces_unlock:
	mov	x0, x19
	bl	silica_rt_lock_unlock
Lces_ret:
	mov	x0, x20
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
Lces_failed:
	mov	x20, #1
	b	Lces_unlock
	.globl	silica_rt_carrier_started_any
	.p2align	2
silica_rt_carrier_started_any:
// X0 = the carrier table -> X0 = the first carrier whose thread runs (+80), or 0 when none does
// (only before the first adoption). Leaf; X9-X11.
	adrp	x9, silica_rt_carrier_count
	add	x9, x9, :lo12:silica_rt_carrier_count
	ldr	x9, [x9]
	add	x10, x0, x9, lsl #8
Lcsa_loop:
	cmp	x0, x10
	b.hs	Lcsa_none
	add	x11, x0, #80
	ldar	x11, [x11]
	cbnz	x11, Lcsa_ret
	add	x0, x0, #256
	b	Lcsa_loop
Lcsa_none:
	mov	x0, xzr
Lcsa_ret:
	ret
	.globl	silica_rt_tls_record_set
	.p2align	2
silica_rt_tls_record_set:
// X0 = this thread's record: two words, the current actor and the carrier (0 when the thread is
// not a carrier's). An actor thread's record is in its control block (#496), a carrier's in its
// block (+88); main has none until silica_rt_tls_actor_set makes it one.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	bl	silica_rt_ensure_actor_tls_key
	adrp	x8, silica_actor_pthread_key
	add	x8, x8, :lo12:silica_actor_pthread_key
	ldr	x0, [x8]
	mov	x1, x19
	bl	pthread_setspecific
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_tls_actor_set
	.p2align	2
silica_rt_tls_actor_set:
// X0 = ACB or 0: this thread's current actor, stored in the thread's record. A thread without a
// record (main) gets a calloc'd one now, never freed (one thread).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	bl	silica_rt_ensure_actor_tls_key
	adrp	x8, silica_actor_pthread_key
	add	x8, x8, :lo12:silica_actor_pthread_key
	ldr	x0, [x8]
	bl	pthread_getspecific
	cbnz	x0, Ltas_store
	mov	x0, #1
	mov	x1, #16
	bl	calloc
	cbz	x0, Ltas_failed
	mov	x20, x0
	adrp	x8, silica_actor_pthread_key
	add	x8, x8, :lo12:silica_actor_pthread_key
	ldr	x0, [x8]
	mov	x1, x20
	bl	pthread_setspecific
	mov	x0, x20
Ltas_store:
	str	x19, [x0]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
Ltas_failed:
	adrp	x0, Lrta_r_thread_record
	add	x0, x0, :lo12:Lrta_r_thread_record
	bl	silica_rt_abort_with
	b	Ltas_failed
"
}

fn carrier_asm_loop() -> string {
    "	.globl	silica_rt_carrier_main
	.p2align	2
silica_rt_carrier_main:
// Thread entry: X0 = carrier block. Never returns.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x19, x0
	str	xzr, [x19, #88]
	add	x0, x19, #88
	bl	silica_rt_tls_record_set
	add	x0, x19, #56
	bl	silica_rt_altstack_install_at
// Affinity to logical core i (the carrier's index): pthread_setaffinity_np(self, 128, cpu_set_t
// naming cpu i), a real binding on Linux (the thread runs only on that core while the kernel
// honours it; the Darwin tree can only hint). The result is recorded in the block (+224: 0 bound,
// else the errno; EINVAL when the index is no cpu of this machine, as under a SILICA_CARRIER_COUNT
// above the core count, or above 1023) and never aborts: the carrier is what is guaranteed, the
// core is best effort (spec §15.1.2, OS-hosted).
	bl	pthread_self
	mov	x20, x0
	sub	sp, sp, #128
	mov	x0, sp
	mov	x1, xzr
	mov	x2, #128
	bl	memset
	ldr	x9, [x19, #112]
	cmp	x9, #1024
	b.hs	Lcar_aff_apply
	lsr	x10, x9, #6
	and	x11, x9, #63
	mov	x12, #1
	lsl	x12, x12, x11
	mov	x13, sp
	ldr	x14, [x13, x10, lsl #3]
	orr	x14, x14, x12
	str	x14, [x13, x10, lsl #3]
Lcar_aff_apply:
	mov	x0, x20
	mov	x1, #128
	mov	x2, sp
	bl	pthread_setaffinity_np
	mov	w0, w0
	str	x0, [x19, #224]
	add	sp, sp, #128
	mov	x9, sp
	str	x9, [x19, #48]
	mov	x8, #1
	add	x9, x19, #72
	stlr	x8, [x9]
Lcar_loop:
// Entered afresh from every path that leaves an actor: the stack below the base is abandoned.
	ldr	x9, [x19, #48]
	mov	sp, x9
	str	xzr, [x19, #40]
	str	xzr, [x19, #88]
	mov	x0, x19
	bl	silica_rt_lock_lock
Lcar_pop:
	ldr	x9, [x19, #128]
	ldr	x10, [x19, #152]
	orr	x9, x9, x10
	ldr	x10, [x19, #176]
	orr	x9, x9, x10
	cbz	x9, Lcar_empty
// A busy carrier sweeps a batch of its idle :release_when_idle actors when their listed bytes are
// over the carrier's budget (every pop), or when the head is due and the sweep cadence has passed
// since the last sweep; a batch that answers 1 (more to do) is followed by one dispatch and then
// the next batch (the last-sweep time is cleared so the cadence does not delay it).
	ldr	x9, [x19, #104]
	cbz	x9, Lcar_have
	ldr	x10, [x19, #240]
	adrp	x11, silica_rt_idle_stack_budget
	add	x11, x11, :lo12:silica_rt_idle_stack_budget
	ldr	x11, [x11]
	cmp	x10, x11
	b.hi	Lcar_sweep_busy
	bl	silica_rt_stack_now_ns
	ldr	x10, [x19, #120]
	sub	x10, x0, x10
	adrp	x11, silica_rt_idle_sweep_ns
	add	x11, x11, :lo12:silica_rt_idle_sweep_ns
	ldr	x11, [x11]
	cmp	x10, x11
	b.lo	Lcar_have
	ldr	x9, [x19, #104]
	ldr	x10, [x9, #344]
	sub	x10, x0, x10
	adrp	x11, silica_rt_idle_release_ns
	add	x11, x11, :lo12:silica_rt_idle_release_ns
	ldr	x11, [x11]
	cmp	x10, x11
	b.lo	Lcar_have
Lcar_sweep_busy:
	mov	x0, x19
	bl	silica_rt_carrier_sweep
	cmp	x0, #1
	b.ne	Lcar_have
	str	xzr, [x19, #120]
	b	Lcar_have
Lcar_empty:
// Nothing to run: sweep a batch; more to do (1) means back to the top, where mail that arrived
// meanwhile is dispatched first; else, since the sweep let this lock go for each release, an actor
// pushed meanwhile (it found the carrier awake, so it did not signal) is run before any sleep;
// else sleep until mail (or a parked actor's wake) or the time the head of the list is due (0 =
// the list is empty: no timeout).
	mov	x0, x19
	bl	silica_rt_carrier_sweep
	cmp	x0, #1
	b.eq	Lcar_pop
	mov	x21, x0
	ldr	x9, [x19, #128]
	ldr	x10, [x19, #152]
	orr	x9, x9, x10
	ldr	x10, [x19, #176]
	orr	x9, x9, x10
	cbnz	x9, Lcar_have
	mov	x2, x21
	mov	x9, #1
	str	x9, [x19, #16]
	add	x0, x19, #8
	mov	x1, x19
	bl	silica_rt_cv_wait_timeout
	str	xzr, [x19, #16]
	b	Lcar_pop
Lcar_have:
// The policy's choice among the ready actors (some queue is non-empty, checked under this lock).
	mov	x0, x19
	bl	silica_rt_rq_pop
	mov	x20, x0
	mov	x0, x19
	bl	silica_rt_lock_unlock
	mov	x9, #3
	str	x9, [x20, #448]
	str	x20, [x19, #40]
	str	x20, [x19, #88]
	ldr	x9, [x20, #464]
	cbnz	x9, Lcar_resume
	ldr	x9, [x20, #224]
	cbz	x9, Lcar_first
	mov	x19, x20
	b	LBB1_loop
Lcar_first:
// Not started: the actor's start trampoline (SB #48; a supervisor's init and the
// materialisation of its children) runs first, on the actor's own stack as a behaviour does, so a
// wait inside it (a child supervisor's start) parks. The 48-byte frame is the one a resume
// rebuilds (Lcar_resume: the base less 48) and the carrier's SP is kept in #368 as a behaviour's
// dispatch keeps it; X19 = the carrier and X20 = the actor are callee-saved and survive the
// trampoline and any park. Then the started word goes to 1 (a spawner parked or spinning on it
// proceeds) and the mailbox loop begins. An actor that ends inside its trampoline (a duplicate
// child id, exhaustion, badarith) never returns here: its exit path stores 2 and enters the loop.
	ldr	x8, [x20, #216]
	cbz	x8, Lcar_started
	ldr	x8, [x8, #48]
	cbz	x8, Lcar_started
	sub	sp, sp, #48
	mov	x10, sp
	str	x10, [x20, #368]
	ldr	x9, [x20, #528]
	mov	sp, x9
	mov	x0, x20
	blr	x8
	ldr	x9, [x19, #48]
	mov	sp, x9
	str	xzr, [x20, #368]
Lcar_started:
	mov	x0, x20
	mov	x1, #1
	bl	silica_rt_started_store
	mov	x19, x20
	b	LBB1_loop
Lcar_resume:
// Parked inside a behaviour: the dispatch frame its behaviour will return into is the same 48 bytes
// below the base that its dispatch used (the post-behaviour code reads the node from ACB #240).
	ldr	x9, [x19, #48]
	sub	x9, x9, #48
	str	x9, [x20, #368]
	mov	x0, x20
	b	silica_rt_ctx_resume
	.globl	silica_rt_carrier_loop_enter
	.p2align	2
silica_rt_carrier_loop_enter:
// X0 = carrier block. An actor's exit path, run on the carrier's stack, ends here. Never returns.
	mov	x19, x0
	b	Lcar_loop
	.globl	silica_rt_carrier_requeue
	.p2align	2
silica_rt_carrier_requeue:
// X0 = a carrier actor whose message has been served (the dispatch boundary): a pending migration
// (#512) is applied first, then it is ready again when mail waits or it has been ended meanwhile
// (its exit path runs at its next dispatch), idle otherwise; then back to the loop of the carrier
// this thread is (X20, read before the move: after it the actor's #440 may name another carrier,
// whose thread may already be running the actor). Never returns.
	mov	x19, x0
	ldr	x20, [x19, #440]
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	mov	x0, x19
	bl	silica_rt_carrier_apply_pending
	ldr	w9, [x19, #152]
	cbz	w9, Lcrq_ready
	ldr	x9, [x19, #216]
	cbz	x9, Lcrq_std
	ldr	x10, [x9]
	ldr	x11, [x9, #8]
	orr	x10, x10, x11
	cbnz	x10, Lcrq_ready
Lcrq_std:
	ldr	x10, [x19, #128]
	ldr	x11, [x19, #136]
	orr	x10, x10, x11
	cbnz	x10, Lcrq_ready
	mov	x0, x19
	bl	silica_rt_carrier_mark_idle
	b	Lcrq_unlock
Lcrq_ready:
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	silica_rt_carrier_push
Lcrq_unlock:
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	mov	x0, x20
	b	silica_rt_carrier_loop_enter
	.globl	silica_rt_carrier_apply_pending
	.p2align	2
silica_rt_carrier_apply_pending:
// X0 = a carrier actor between dispatches (its message served, or dispatched with no mail), its
// lock held, not on any run queue or sweep list: a pending migration (#512, the target carrier
// block) becomes its binding (#440). The word is taken atomically, so a migrate_actor that stores
// a new target meanwhile (under the same lock today; the swap keeps it safe without) is not lost.
	add	x8, x0, #512
Lcap_swap:
	ldaxr	x9, [x8]
	stlxr	w10, xzr, [x8]
	cbnz	w10, Lcap_swap
	cbz	x9, Lcap_ret
	str	x9, [x0, #440]
Lcap_ret:
	ret
	.globl	silica_rt_carrier_push
	.p2align	2
silica_rt_carrier_push:
// X0 = a carrier actor whose status its caller has just set to ready (2), under the lock that guards
// that status. Appends it to the run queue of its own carrier (#440: the caller may be anywhere)
// that the policy chooses (silica_rt_rq_push) and wakes that carrier when it sleeps. A pending
// migration is not applied here: a parked actor resumes on the carrier it parked on, inside the
// same dispatch (spec §15.1.2, scheduler yield points), and moves at its dispatch boundary
// (silica_rt_carrier_requeue).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x20, x0
	ldr	x19, [x20, #440]
	str	xzr, [x20, #456]
	mov	x0, x19
	bl	silica_rt_lock_lock
	mov	x0, x19
	mov	x1, x20
	bl	silica_rt_rq_push
	ldr	x9, [x19, #16]
	cbz	x9, Lcpu_unlock
	add	x0, x19, #8
	bl	silica_rt_cv_signal
Lcpu_unlock:
	mov	x0, x19
	bl	silica_rt_lock_unlock
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_carrier_mark_idle
	.p2align	2
silica_rt_carrier_mark_idle:
// X0 = a carrier actor with no mail, between dispatches, its lock held: a pending migration is
// applied, then it is idle (1), or, when it is :release_when_idle (#312 = 4) and still holds
// committed stack (#288), idle on its carrier's sweep list (5): appended at the tail (+232; the
// list is ordered by the last-message stamps, #344, which this dispatch has just written), its
// committed bytes added to the listed total (+240), under that carrier's lock (the carrier may be
// the one just moved to: its list changes under its lock, and when it sleeps it is woken, as a push
// wakes it, so that it waits with the listed actor's due time as its timeout rather than the untimed
// or longer wait it chose when its list was shorter; a carrier listing on its own thread is awake,
// so the signal is never sent for it).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	bl	silica_rt_carrier_apply_pending
	ldr	x9, [x19, #312]
	cmp	x9, #4
	b.ne	Lcmi_plain
	ldr	x9, [x19, #288]
	cbz	x9, Lcmi_plain
	ldr	x20, [x19, #440]
	mov	x0, x20
	bl	silica_rt_lock_lock
	str	xzr, [x19, #456]
	ldr	x9, [x20, #232]
	cbz	x9, Lcmi_first
	str	x19, [x9, #456]
	b	Lcmi_linked
Lcmi_first:
	str	x19, [x20, #104]
Lcmi_linked:
	str	x19, [x20, #232]
	ldr	x9, [x20, #240]
	ldr	x10, [x19, #288]
	add	x9, x9, x10
	str	x9, [x20, #240]
	mov	x9, #5
	str	x9, [x19, #448]
	ldr	x9, [x20, #16]
	cbz	x9, Lcmi_unlock
	add	x0, x20, #8
	bl	silica_rt_cv_signal
Lcmi_unlock:
	mov	x0, x20
	bl	silica_rt_lock_unlock
	b	Lcmi_ret
Lcmi_plain:
	mov	x9, #1
	str	x9, [x19, #448]
Lcmi_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_carrier_unlist
	.p2align	2
silica_rt_carrier_unlist:
// X0 = a carrier actor its caller found on its carrier's sweep list (status 5), its lock held:
// taken off the list under the carrier's lock (the tail, +232, fixed up when it was the last entry;
// its committed bytes taken off the listed total, +240). Not found is fine: the sweep took it off
// meanwhile (it is 6, sweeping, or already released and 1; the caller's status write settles it).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	ldr	x20, [x19, #440]
	mov	x0, x20
	bl	silica_rt_lock_lock
	add	x9, x20, #104
	mov	x11, xzr
Lcul_find:
	ldr	x10, [x9]
	cbz	x10, Lcul_unlock
	cmp	x10, x19
	b.eq	Lcul_found
	mov	x11, x10
	add	x9, x10, #456
	b	Lcul_find
Lcul_found:
	ldr	x10, [x19, #456]
	str	x10, [x9]
	cbnz	x10, Lcul_tail_kept
	str	x11, [x20, #232]
Lcul_tail_kept:
	str	xzr, [x19, #456]
	ldr	x9, [x20, #240]
	ldr	x10, [x19, #288]
	sub	x9, x9, x10
	str	x9, [x20, #240]
Lcul_unlock:
	mov	x0, x20
	bl	silica_rt_lock_unlock
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_carrier_sweep
	.p2align	2
silica_rt_carrier_sweep:
// X0 = a carrier, its lock held, on its own thread; returns with it held. One batch of the idle
// sweep (the module header): up to 64 actors from the head of the sweep list (+104), each taken
// while it is due (silica_rt_stack_idle_due against the clock read once here) or while the listed
// bytes (+240) exceed the carrier's budget (silica_rt_idle_stack_budget). Per actor: under the
// carrier's lock it is unlinked (tail +232 and total +240 kept), marked 6 (sweeping) and the lock
// let go; then under the actor's own lock alone its stack is released (silica_rt_stack_release_to
// 0/0, on this carrier's stack: it never waits) and it is marked plainly idle (1), unless its
// status is no longer 6 (mail, a stop or a migration made it ready, 2: it keeps its stack and will
// stamp and relist at its next boundary); then the carrier's lock is taken again for the next
// head. -> X0 = 0 when the list is empty, 1 when more is to be done at once (the batch is full with
// the list not empty), else the microseconds until the head is due. Records the time of the sweep
// (+120). An actor marked 6 has #440 = this carrier and is on no queue or list, so a push by its
// wake lands on this carrier's queue, popped only after this call returns.
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	str	x23, [sp, #48]
	mov	x19, x0
	bl	silica_rt_stack_now_ns
	mov	x21, x0
	str	x21, [x19, #120]
	adrp	x23, silica_rt_idle_stack_budget
	add	x23, x23, :lo12:silica_rt_idle_stack_budget
	ldr	x23, [x23]
	mov	x22, xzr
Lcsw_next:
	ldr	x20, [x19, #104]
	cbz	x20, Lcsw_empty
	cmp	x22, #64
	b.hs	Lcsw_more
	ldr	x9, [x19, #240]
	cmp	x9, x23
	b.hi	Lcsw_take
	mov	x0, x20
	mov	x1, x21
	bl	silica_rt_stack_idle_due
	cbnz	x0, Lcsw_ret
Lcsw_take:
	ldr	x9, [x20, #456]
	str	x9, [x19, #104]
	cbnz	x9, Lcsw_tail_kept
	str	xzr, [x19, #232]
Lcsw_tail_kept:
	str	xzr, [x20, #456]
	ldr	x9, [x19, #240]
	ldr	x10, [x20, #288]
	sub	x9, x9, x10
	str	x9, [x19, #240]
	mov	x9, #6
	str	x9, [x20, #448]
	add	x22, x22, #1
	mov	x0, x19
	bl	silica_rt_lock_unlock
	add	x0, x20, #16
	bl	silica_rt_lock_lock
	ldr	x9, [x20, #448]
	cmp	x9, #6
	b.ne	Lcsw_skip
	mov	x0, x20
	mov	x1, xzr
	mov	x2, xzr
	bl	silica_rt_stack_release_to
	mov	x9, #1
	str	x9, [x20, #448]
Lcsw_skip:
	add	x0, x20, #16
	bl	silica_rt_lock_unlock
	mov	x0, x19
	bl	silica_rt_lock_lock
	b	Lcsw_next
Lcsw_empty:
	mov	x0, xzr
	b	Lcsw_ret
Lcsw_more:
	mov	x0, #1
Lcsw_ret:
	ldr	x23, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
"
}

fn carrier_asm_wakes() -> string {
    "	.globl	silica_rt_actor_mail_signal
	.p2align	2
silica_rt_actor_mail_signal:
// X0 = ACB; the caller holds ACB+16 and has enqueued mail or ended the actor. Signals the mailbox
// futex (an actor thread waits on it) and, for an idle carrier actor (plainly idle, 1; on its
// carrier's sweep list, 5, taken off it first; or being swept, 6, already off the list: the sweep
// finds 2 under this lock and keeps the stack), makes it ready on its own carrier.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	add	x0, x19, #80
	bl	silica_rt_cv_signal
	ldr	x9, [x19, #440]
	cbz	x9, Lams_ret
	ldr	x9, [x19, #448]
	cmp	x9, #1
	b.eq	Lams_ready
	cmp	x9, #6
	b.eq	Lams_ready
	cmp	x9, #5
	b.ne	Lams_ret
	mov	x0, x19
	bl	silica_rt_carrier_unlist
Lams_ready:
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	silica_rt_carrier_push
Lams_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_call_wrapper_wake
	.p2align	2
silica_rt_call_wrapper_wake:
// X0 = call wrapper; the caller holds wrapper+72 and has set reply_set. Signals the wrapper's futex
// (a thread waits on it) and makes a carrier actor parked on it (wrapper+48) ready on its carrier.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	add	x0, x19, #24
	bl	silica_rt_cv_signal
	ldr	x9, [x19, #48]
	cbz	x9, Lcww_ret
	ldr	x10, [x9, #448]
	cmp	x10, #4
	b.ne	Lcww_ret
	mov	x10, #2
	str	x10, [x9, #448]
	mov	x0, x9
	bl	silica_rt_carrier_push
Lcww_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_started_store
	.p2align	2
silica_rt_started_store:
// X0 = ACB, X1 = its started word (#224): 1 started, 2 its start trampoline failed. Stores it and
// makes a carrier actor parked in the spawn (#472) ready. The parker stores #472 and then reads #224
// under its own lock; this side stores #224 and then reads #472: with the barriers one of them sees
// the other's store, and the status check under the parker's lock settles the rest.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	add	x9, x0, #224
	stlr	x1, [x9]
	dmb	ish
	ldr	x19, [x0, #472]
	cbz	x19, Lsts_ret
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	ldr	x10, [x19, #448]
	cmp	x10, #4
	b.ne	Lsts_unlock
	mov	x10, #2
	str	x10, [x19, #448]
	mov	x0, x19
	bl	silica_rt_carrier_push
Lsts_unlock:
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
Lsts_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_spawn_wait_started
	.p2align	2
silica_rt_spawn_wait_started:
// X0 = a child just spawned. Returns once its started word (#224) is set (at adoption for a plain
// actor; after the trampoline of its first dispatch for a supervisor). A carrier actor on its own
// stack parks (the child's started store wakes it); anything else spins (main spawning a root
// supervisor, a dangerous actor's thread), as the spawn always did. The parker is the actor this
// carrier runs, on whose stack this runs (silica_rt_carrier_self_on_own_stack: carrier +40 and
// the SP), never the thread's current actor: a respawn from a drain of a supervisor's ingress on
// another actor's stack would otherwise have spun (and, with the child bound to this carrier,
// never seen it start).
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	bl	silica_rt_carrier_self_on_own_stack
	mov	x20, x0
	cbz	x20, Lsws_spin
	ldr	x21, [x20, #440]
	cbz	x21, Lsws_spin
	str	x20, [x19, #472]
	dmb	ish
Lsws_park_loop:
	add	x0, x20, #16
	bl	silica_rt_lock_lock
	add	x9, x19, #224
	ldar	x8, [x9]
	cbnz	x8, Lsws_started
	mov	x0, x20
	bl	silica_rt_ctx_save
	cbnz	x0, Lsws_park_loop
	mov	x9, #4
	str	x9, [x20, #448]
	add	x0, x20, #16
	bl	silica_rt_lock_unlock
// The loop of the carrier this thread is (X21, read while the actor still ran here): the actor's
// #440 may change once it is parked (a migration applied at its boundary elsewhere).
	mov	x0, x21
	b	silica_rt_carrier_loop_enter
Lsws_started:
	add	x0, x20, #16
	bl	silica_rt_lock_unlock
	b	Lsws_ret
Lsws_spin:
	add	x9, x19, #224
Lsws_spin_loop:
	ldar	x8, [x9]
	cbz	x8, Lsws_spin_loop
Lsws_ret:
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	silica_rt_on_carrier_thread
	.p2align	2
silica_rt_on_carrier_thread:
// -> X0 = the carrier block when this thread is a carrier's (the second word of the thread's
// record), else 0.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	silica_rt_ensure_actor_tls_key
	adrp	x8, silica_actor_pthread_key
	add	x8, x8, :lo12:silica_actor_pthread_key
	ldr	x0, [x8]
	bl	pthread_getspecific
	cbz	x0, Loct_ret
	ldr	x0, [x0, #8]
Loct_ret:
	ldp	x29, x30, [sp], #16
	ret
	.globl	silica_rt_carrier_self_on_own_stack
	.p2align	2
silica_rt_carrier_self_on_own_stack:
// -> X0 = the carrier actor this thread runs when the caller is on that actor's own stack (it can
// park), else 0: main, an actor thread, or a runtime path on the carrier's own stack. The parked
// actor is the one the carrier runs (carrier +40), not the thread's current actor: an ingress drain
// installs the supervisor as the current actor while it runs on the drainer's stack.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	silica_rt_on_carrier_thread
	cbz	x0, Lcso_ret
	ldr	x0, [x0, #40]
	cbz	x0, Lcso_ret
	mov	x9, sp
	ldr	x10, [x0, #272]
	cmp	x9, x10
	b.lo	Lcso_no
	ldr	x11, [x0, #280]
	add	x10, x10, x11
	cmp	x9, x10
	b.hs	Lcso_no
	b	Lcso_ret
Lcso_no:
	mov	x0, xzr
Lcso_ret:
	ldp	x29, x30, [sp], #16
	ret
	.globl	silica_rt_sup_on_own_dispatch
	.p2align	2
silica_rt_sup_on_own_dispatch:
// X0 = a supervisor -> X0 = 1 when this thread is the supervisor's carrier running the supervisor
// itself (carrier +40: its own dispatch, the ingress served at LBB1_ingress_no_beh or a drain
// from its reply path, or its exit path), 0 anywhere else: a drain on another actor's stack
// (which installs the supervisor as the thread's CURRENT actor, so that word cannot be the
// test), main, or a dangerous actor's thread. The one place the restart-intensity breach and the
// duplicate-child-id failure make their synchronous root report, with the children shut down
// first: that wait could otherwise wait on the drainer itself (prims_actors_child_table_asm,
// Lmr_freq_escalate). What the thread identity (pthread_self against ACB #144) answered when a
// supervisor had a thread of its own.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	bl	silica_rt_on_carrier_thread
	cbz	x0, Lsod_no
	ldr	x0, [x0, #40]
	cmp	x0, x19
	cset	x0, eq
	b	Lsod_ret
Lsod_no:
	mov	x0, xzr
Lsod_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_wait_park
	.p2align	2
silica_rt_wait_park:
// X0 = the carrier actor parking (on its own stack), X1 = the wait list it joins (the address of
// the head word: a row's +120 or a supervision block's +128; the links are ACB #456, the list is
// recorded in #480 for a stop to find), X2 = the thread's current actor to restore after the
// resume. Called with the actor's lock and the wait lock held: it publishes status 4 (parked)
// under both, releases them and leaves for the carrier loop. Returns, with no lock held, when the
// actor has been made ready again (by the list's wake or by a stop that unlinked it).
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	ldr	x22, [x19, #440]
	mov	x0, x19
	bl	silica_rt_ctx_save
	cbnz	x0, Lwpk_resumed
	ldr	x9, [x20]
	str	x9, [x19, #456]
	str	x19, [x20]
	str	x20, [x19, #480]
	mov	x9, #4
	str	x9, [x19, #448]
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_unlock
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
// The loop of the carrier this thread is (X22, read before the park was published).
	mov	x0, x22
	b	silica_rt_carrier_loop_enter
Lwpk_resumed:
// The carrier made this actor the thread's current actor at the resume; the wait was entered with
// X21 as the current actor (the actor itself since 2026-10-20: no drain installs the supervisor
// any more, prims_actors_child_table_asm.silica supervisor_handle_notice; the restore is kept
// for any future caller that parks with another actor installed).
	cmp	x21, x19
	b.eq	Lwpk_ret
	mov	x0, x21
	bl	silica_rt_tls_actor_set
Lwpk_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	silica_rt_wait_list_wake
	.p2align	2
silica_rt_wait_list_wake:
// X0 = the address of a wait list's head word: takes the whole list under the wait lock and makes
// every actor on it ready, each under its own lock, none under the wait lock. An actor on the list
// that is not parked cannot happen (it was parked under both locks, and only this wake or a stop,
// which unlinks it under the wait lock first, changes that): a runtime abort.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_lock
	ldr	x20, [x19]
	str	xzr, [x19]
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_unlock
Lwlw_wake:
	cbz	x20, Lwlw_ret
	ldr	x19, [x20, #456]
	add	x0, x20, #16
	bl	silica_rt_lock_lock
	ldr	x9, [x20, #448]
	cmp	x9, #4
	b.ne	Lwlw_not_parked
	str	xzr, [x20, #480]
	mov	x9, #2
	str	x9, [x20, #448]
	mov	x0, x20
	bl	silica_rt_carrier_push
	add	x0, x20, #16
	bl	silica_rt_lock_unlock
	mov	x20, x19
	b	Lwlw_wake
Lwlw_not_parked:
	adrp	x0, Lrta_r_row_wake
	add	x0, x0, :lo12:Lrta_r_row_wake
	bl	silica_rt_abort_with
Lwlw_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_row_wait
	.p2align	2
silica_rt_row_wait:
// X0 = a row, X1 = the identity (ACB #408) of the child whose exit is waited for, X2 = 1 when that
// child is a carrier actor (0 = unknown), X3 = the waiting actor or 0 (main, or a wait that no stop
// may end). -> X0 = 1 once the row's exit_done (+56) holds that identity, 2 when X3 was ended
// meanwhile (its supervisor's cascade stops it while it waits in kill_abnormal: the wait is over
// and the victim is dead or dying). exit_done is a generation word, never cleared: the identity of
// the last child of the row that ended; a stale value from an earlier incarnation never matches.
// A carrier actor on its own stack parks on the row's wait list (the exit_done store wakes it, so
// does a stop of the waiter); anything else spins (main, a dangerous actor's thread). A runtime
// path on a carrier's own stack never comes here (every waiting path runs on the actor's own
// stack: the module header); when the awaited child is a carrier actor that is a runtime abort
// rather than a silent deadlock (the child could never run on the stack being spun on when it is
// bound to this carrier).
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	mov	x22, x2
	mov	x23, x3
	bl	silica_rt_carrier_self_on_own_stack
	mov	x21, x0
	cbz	x21, Lrw_spin
	bl	silica_rt_tls_current_actor_get
	mov	x24, x0
Lrw_park_loop:
