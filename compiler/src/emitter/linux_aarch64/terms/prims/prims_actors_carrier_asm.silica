// (the exit side stores exit_done and takes the list under it; a stop sets the waiter's alive flag
// under the waiter's own lock), so no wake is lost.
	add	x0, x21, #16
	bl	silica_rt_lock_lock
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_lock
	ldr	x8, [x19, #56]
	cmp	x8, x20
	b.eq	Lrw_done_locked
	cbz	x23, Lrw_park
	ldr	w8, [x23, #152]
	cbz	w8, Lrw_stopped_locked
Lrw_park:
	mov	x0, x21
	add	x1, x19, #120
	mov	x2, x24
	bl	silica_rt_wait_park
	b	Lrw_park_loop
Lrw_done_locked:
	mov	x23, #1
	b	Lrw_unlock_ret
Lrw_stopped_locked:
	mov	x23, #2
Lrw_unlock_ret:
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_unlock
	add	x0, x21, #16
	bl	silica_rt_lock_unlock
	mov	x0, x23
	b	Lrw_ret
Lrw_spin:
	cbz	x22, Lrw_spin_loop
	bl	silica_rt_on_carrier_thread
	cbz	x0, Lrw_spin_loop
	adrp	x0, Lrta_r_carrier_wait
	add	x0, x0, :lo12:Lrta_r_carrier_wait
	bl	silica_rt_abort_with
Lrw_spin_loop:
	ldr	x8, [x19, #56]
	cmp	x8, x20
	b.eq	Lrw_spin_done
	cbz	x23, Lrw_spin_loop
	ldr	w8, [x23, #152]
	cbnz	w8, Lrw_spin_loop
	mov	x0, #2
	b	Lrw_ret
Lrw_spin_done:
	mov	x0, #1
Lrw_ret:
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	silica_rt_row_exit_done_store
	.p2align	2
silica_rt_row_exit_done_store:
// X0 = a row whose child has ended (silica_rt_sb_child_done, the child's last act), X1 = that
// child's identity: exit_done (+56) = the identity, under the wait lock, then every carrier actor
// parked on the row's wait list (+120) is made ready; each re-checks the identity it waits for.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_lock
	str	x20, [x19, #56]
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_unlock
	add	x0, x19, #120
	bl	silica_rt_wait_list_wake
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_actor_stop
	.p2align	2
silica_rt_actor_stop:
// X0 = an actor to end at its next dispatch boundary, X1 = the exit reason tag to give it (0 keeps
// what it has: a supervisor's own stop, reason 0 in its report), X2 = the reason atom that goes
// with a tag (#384; 0 = none). -> X0 = 1 when it is a carrier actor. The one way the runtime ends
// another actor: under the target's lock its alive flag goes, the reason (tag and atom) is set
// only while it was still alive (an actor already ending keeps its own), its
// mailbox is signalled (an idle carrier actor is made ready), and an actor parked on a wait list
// (a row's exit_done, a supervision block's restart token: #480 names the list) is unlinked under
// the wait lock and made ready, so a wait that this stop ends (kill_abnormal's) sees it at once. A
// parked actor the list's wake has already taken (not found on the list) is made ready by that wake.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	ldr	w8, [x19, #152]
	cbz	w8, Lsto_was_ended
	cbz	x20, Lsto_was_ended
	str	x20, [x19, #232]
	cbz	x21, Lsto_was_ended
	str	x21, [x19, #384]
Lsto_was_ended:
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	silica_rt_actor_mail_signal
	ldr	x22, [x19, #440]
	cbz	x22, Lsto_unlock
	ldr	x9, [x19, #448]
	cmp	x9, #4
	b.ne	Lsto_unlock
	ldr	x21, [x19, #480]
	cbz	x21, Lsto_unlock
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_lock
	ldr	x9, [x21]
	mov	x10, xzr
Lsto_find:
	cbz	x9, Lsto_not_found
	cmp	x9, x19
	b.eq	Lsto_found
	mov	x10, x9
	ldr	x9, [x9, #456]
	b	Lsto_find
Lsto_found:
	ldr	x11, [x19, #456]
	cbz	x10, Lsto_unlink_head
	str	x11, [x10, #456]
	b	Lsto_unlinked
Lsto_unlink_head:
	str	x11, [x21]
Lsto_unlinked:
	str	xzr, [x19, #480]
	str	xzr, [x19, #456]
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_unlock
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	silica_rt_carrier_push
	b	Lsto_unlock
Lsto_not_found:
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_unlock
Lsto_unlock:
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	cmp	x22, #0
	cset	x0, ne
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	silica_rt_sup_restart_try
	.p2align	2
silica_rt_sup_restart_try:
// X0 = a supervisor, X1 = the actor asking (0 = main). -> X0 = 1 when the caller now holds the
// supervisor's restart token (supervision block #120: the holder, or 1 for main), 0 when another
// holder has it, or the supervisor has no block or has ended. One holder at a time dequeues its
// ingress and runs the restarts (maybe_restart with its cascades), so no two cascades overlap.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	ldr	x8, [x19, #216]
	cbz	x8, Lsrt_no
	ldr	w9, [x19, #152]
	cbz	w9, Lsrt_no
	ldr	x9, [x8, #120]
	cbnz	x9, Lsrt_no
	mov	x9, x20
	cbnz	x9, Lsrt_take
	mov	x9, #1
Lsrt_take:
	str	x9, [x8, #120]
	mov	x20, #1
	b	Lsrt_unlock
Lsrt_no:
	mov	x20, xzr
Lsrt_unlock:
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	mov	x0, x20
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_sup_restart_release
	.p2align	2
silica_rt_sup_restart_release:
// X0 = a supervisor whose restart token the caller holds: lets it go. Notices still in the ingress
// are the supervisor's own thread's to drain (its mailbox is signalled; the thread skips the ingress
// while another holder has the token), and every actor parked for the token (block +128) is made
// ready to re-check.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	ldr	x20, [x19, #216]
	cbz	x20, Lsrr_unlock
	str	xzr, [x20, #120]
	ldr	x9, [x20]
	ldr	x10, [x20, #8]
	orr	x9, x9, x10
	cbz	x9, Lsrr_unlock
	mov	x0, x19
	bl	silica_rt_actor_mail_signal
Lsrr_unlock:
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	cbz	x20, Lsrr_ret
	add	x0, x20, #128
	bl	silica_rt_wait_list_wake
Lsrr_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_sup_restart_acquire
	.p2align	2
silica_rt_sup_restart_acquire:
// X0 = a supervisor, X1 = the actor asking (0 = main), X2 = 1 to take the restart token, 0 to wait
// until the token is free and the ingress is empty (a row child of this supervisor never takes the
// token to DRAIN: the cascade it would run could stop the child itself; it waits for the holder,
// the supervisor's own dispatch or another drainer, to finish), 2 to take the token only once the
// ingress is empty (a row child holding the token across a terminate_child / restart_child of a
// sibling, supervisor_drain_hold: it waits as with 0, then holds with nothing to drain, so no
// cascade of a pending notice runs on it; a notice that arrives while it holds the token is the
// supervisor's own dispatch's after the release). -> X0 = 1 taken / settled, 2 when X1
// was ended while it waited (its supervisor's cascade stops it: the caller's wait is over), 0 when
// the supervisor has no block or has ended (nothing to drain or wait for). A carrier actor on its
// own stack parks on the block's wait list (+128; a release wakes it, so does a stop of the
// waiter); anything else (main, a dangerous actor's thread) polls. Lock order everywhere: the
// waiting actor, then the supervisor, then the wait lock, then (in the push of a woken actor) its
// carrier's lock. The waiting actor may BE the supervisor (its reply path drains its own ingress,
// LBB1_reply_drain, on its own stack): the one lock is then taken once and serves both positions
// (os_unfair_lock is not recursive).
	stp	x29, x30, [sp, #-80]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	str	x25, [sp, #64]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	bl	silica_rt_carrier_self_on_own_stack
	mov	x22, x0
	bl	silica_rt_tls_current_actor_get
	mov	x24, x0
Lsra_loop:
	cbz	x22, Lsra_lock_sup
	cmp	x22, x19
	b.eq	Lsra_lock_sup
	add	x0, x22, #16
	bl	silica_rt_lock_lock
Lsra_lock_sup:
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	mov	x23, xzr
	ldr	x8, [x19, #216]
	cbz	x8, Lsra_unlock
	mov	x25, x8
	ldr	w9, [x19, #152]
	cbz	w9, Lsra_unlock
	cbz	x20, Lsra_self_ok
	ldr	w9, [x20, #152]
	cbnz	w9, Lsra_self_ok
	mov	x23, #2
	b	Lsra_unlock
Lsra_self_ok:
	ldr	x9, [x8, #120]
	cbnz	x9, Lsra_wait
	cbz	x21, Lsra_settle
	cmp	x21, #2
	b.ne	Lsra_take_now
// Mode 2: the token is free; take it only with an empty ingress, else wait for the supervisor's
// dispatch to serve the notices (each release wakes this actor to look again).
	ldr	x9, [x8]
	ldr	x10, [x8, #8]
	orr	x9, x9, x10
	cbnz	x9, Lsra_wait
Lsra_take_now:
	mov	x9, x20
	cbnz	x9, Lsra_take
	mov	x9, #1
Lsra_take:
	str	x9, [x8, #120]
	mov	x23, #1
	b	Lsra_unlock
Lsra_settle:
	ldr	x9, [x8]
	ldr	x10, [x8, #8]
	orr	x9, x9, x10
	cbnz	x9, Lsra_wait
	mov	x23, #1
Lsra_unlock:
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	cbz	x22, Lsra_ret
	cmp	x22, x19
	b.eq	Lsra_ret
	add	x0, x22, #16
	bl	silica_rt_lock_unlock
	b	Lsra_ret
Lsra_wait:
	cbz	x22, Lsra_poll
// Park: the wait lock is taken before the supervisor's lock goes, so a release that follows cannot
// take the list before this actor is on it. When the parker is the supervisor itself its one lock
// stays held for silica_rt_wait_park, which releases it.
	adrp	x0, silica_rt_row_wait_lock
	add	x0, x0, :lo12:silica_rt_row_wait_lock
	bl	silica_rt_lock_lock
	cmp	x22, x19
	b.eq	Lsra_park
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
Lsra_park:
	mov	x0, x22
	add	x1, x25, #128
	mov	x2, x24
	bl	silica_rt_wait_park
	b	Lsra_loop
Lsra_poll:
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	mov	w0, #50
	bl	usleep
	b	Lsra_loop
Lsra_ret:
	mov	x0, x23
	ldr	x25, [sp, #64]
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #80
	ret
"
}

// Placement on carriers (stage 3): migrate_actor and the pin_actor_* family for a carrier actor
// (their entries in prims_actors_runtime_asm.silica resolve the reference and keep the thread
// path for a thread actor), and the test-only query actor_carrier_index.
fn carrier_asm_placement() -> string {
    "	.globl	silica_rt_carrier_for_core
	.p2align	2
silica_rt_carrier_for_core:
// X0 = a core id below silica_rt_logical_cpu_count -> X0 = the carrier block for it, `core mod N`
// (the carrier the same core id binds to at spawn), the table made if need be.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	bl	silica_rt_carriers_ensure
	adrp	x8, silica_rt_carrier_count
	add	x8, x8, :lo12:silica_rt_carrier_count
	ldr	x10, [x8]
	udiv	x11, x19, x10
	msub	x9, x11, x10, x19
	add	x0, x0, x9, lsl #8
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_carrier_migrate
	.p2align	2
silica_rt_carrier_migrate:
// X0 = a carrier actor (#440 != 0), held by the caller, X1 = the target carrier block. -> X0 = 0
// (:ok, the move is requested or done) or 2 (:actor_not_found: it has ended). Under the actor's
// lock, by its status: idle (1) it is bound to the target at once (nothing of it is queued or
// listed, and mail for it takes this lock); idle on its carrier's sweep list (5) it is taken off
// that list (under the old carrier's lock), bound, and listed again on the target by
// silica_rt_carrier_mark_idle (under the target's lock; it joins the tail behind newer stamps, so
// it is released when the entry before it is, at most one idle period late); ready (2, queued on
// its carrier), running (3), parked (4, inside a dispatch) or being swept (6: its carrier's sweep
// holds it off the list and will release it or find it ready under this lock; never relisted here)
// the target is left pending in #512 and applied at the actor's next dispatch boundary
// (silica_rt_carrier_requeue, or silica_rt_carrier_mark_idle when the dispatch finds no mail),
// never while it runs and never at a resume: a parked actor resumes
// where it parked, inside the same dispatch. At most one carrier lock is held at any point, never
// with the target's and the old carrier's locks together, so the lock order of this module's
// header holds. The mailbox is the actor's own and moves with it; message order is unchanged.
// The target's thread is created first when it has none yet (nothing held); 3 (:migration_blocked)
// when the host refuses it (item N #5).
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x0, x20
	bl	silica_rt_carrier_ensure_started
	cbnz	x0, Lcmg_blocked
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	ldr	w9, [x19, #152]
	cbz	w9, Lcmg_ended
	ldr	x9, [x19, #448]
	cmp	x9, #1
	b.eq	Lcmg_idle
	cmp	x9, #5
	b.eq	Lcmg_listed
	str	x20, [x19, #512]
	b	Lcmg_ok
Lcmg_listed:
	mov	x0, x19
	bl	silica_rt_carrier_unlist
	mov	x9, #1
	str	x9, [x19, #448]
	str	x20, [x19, #440]
	mov	x0, x19
	bl	silica_rt_carrier_mark_idle
	b	Lcmg_ok
Lcmg_idle:
	str	x20, [x19, #440]
Lcmg_ok:
	mov	x21, xzr
	b	Lcmg_unlock
Lcmg_ended:
	mov	x21, #2
Lcmg_unlock:
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	mov	x0, x21
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
Lcmg_blocked:
// The target has no thread and the host refused one (nothing held yet): 3, :migration_blocked.
	mov	x0, #3
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	silica_rt_carrier_pick_kind
	.p2align	2
silica_rt_carrier_pick_kind:
// X0 = a carrier actor, X1 = 1 for a performance core, 0 for an efficiency core -> X0 = the carrier
// to move it to, or 0 when it stays: it is on a carrier of that kind already, or no carrier of
// that kind exists. Carrier i is the carrier of logical core i, and the topology the runtime
// reports (get_cpu_topology, get_performance_cores: sysctl hw.perflevel0 / 1, the shim's table on
// Linux, where every core is P and E is empty) puts the P cores at
// [0, P) and the E cores at [P, P + E), so the P carriers are [0, min(P, N)) and the E carriers
// [P, N) (none when P >= N, as under a SILICA_CARRIER_COUNT below P, or when the machine reports
// no E cores: a uniform topology is all P). Among the carriers of a kind the choice is in turn
// (silica_rt_pcore_next / ecore_next), a round robin per kind, so repeated pins spread over
// them, the hosted balance of the BEAM pattern; no exclusivity is implied.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	ldr	x9, [x0, #440]
	ldr	x9, [x9, #112]
	adrp	x8, silica_rt_carrier_count
	add	x8, x8, :lo12:silica_rt_carrier_count
	ldr	x10, [x8]
	adrp	x8, silica_rt_pcore_count
	add	x8, x8, :lo12:silica_rt_pcore_count
	ldr	x11, [x8]
	cbnz	x11, Lcpk_have_p
	mov	x11, x10
Lcpk_have_p:
	cmp	x11, x10
	b.ls	Lcpk_p_clamped
	mov	x11, x10
Lcpk_p_clamped:
// X9 = the actor's carrier index, X10 = N, X11 = P clamped to N: P carriers [0, X11), E [X11, N).
	cbz	x1, Lcpk_efficiency
	cmp	x9, x11
	b.lo	Lcpk_stay
	cbz	x11, Lcpk_stay
	adrp	x8, silica_rt_pcore_next
	add	x8, x8, :lo12:silica_rt_pcore_next
	mov	x12, xzr
	mov	x13, x11
	b	Lcpk_turn
Lcpk_efficiency:
	cmp	x9, x11
	b.hs	Lcpk_stay
	cmp	x11, x10
	b.hs	Lcpk_stay
	adrp	x8, silica_rt_ecore_next
	add	x8, x8, :lo12:silica_rt_ecore_next
	mov	x12, x11
	mov	x13, x10
Lcpk_turn:
// The next index in turn over [X12, X13): the counter at X8 counts from 0 over the range's length.
	sub	x13, x13, x12
Lcpk_turn_loop:
	ldaxr	x14, [x8]
	add	x15, x14, #1
	cmp	x15, x13
	b.lo	Lcpk_turn_store
	mov	x15, xzr
Lcpk_turn_store:
	stlxr	w16, x15, [x8]
	cbnz	w16, Lcpk_turn_loop
	cmp	x14, x13
	b.lo	Lcpk_turn_in_range
	mov	x14, xzr
Lcpk_turn_in_range:
	add	x19, x14, x12
	bl	silica_rt_carriers_ensure
	add	x0, x0, x19, lsl #8
	b	Lcpk_ret
Lcpk_stay:
	mov	x0, xzr
Lcpk_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_actor_carrier_index
	.p2align	2
silica_rt_actor_carrier_index:
// actor_carrier_index(ref) -> int64, a test-only query (trials/carriers_addition): the index of the
// carrier the actor is bound to now (#440, +112), -1 for a dangerous actor (a thread of its own)
// or a reference that names no actor. A pending migration is not reported until it is applied.
	adrp	x9, silica_rt_actor_carrier_index_acb
	add	x9, x9, :lo12:silica_rt_actor_carrier_index_acb
	b	silica_rt_ref_call
	.p2align	2
silica_rt_actor_carrier_index_acb:
	cbz	x0, Laci_none
	ldr	x9, [x0, #440]
	cbz	x9, Laci_none
	ldr	x0, [x9, #112]
	ret
Laci_none:
	mov	x0, #-1
	ret
"
}

fn carrier_asm_context() -> string {
    "	.globl	silica_rt_ctx_save
	.p2align	2
silica_rt_ctx_save:
// X0 = the current carrier actor, on its own stack. Saves X19-X30 and D8-D15 below SP and records
// that SP in #464. Returns 0 at once with SP left lowered (the frame is live until the actor leaves
// through silica_rt_carrier_leave); returns 1, with SP and the registers restored, when the
// carrier resumes the actor.
	sub	sp, sp, #176
	stp	x19, x20, [sp]
	stp	x21, x22, [sp, #16]
	stp	x23, x24, [sp, #32]
	stp	x25, x26, [sp, #48]
	stp	x27, x28, [sp, #64]
	stp	x29, x30, [sp, #80]
	stp	d8, d9, [sp, #96]
	stp	d10, d11, [sp, #112]
	stp	d12, d13, [sp, #128]
	stp	d14, d15, [sp, #144]
	mov	x9, sp
	str	x9, [x0, #464]
	mov	x0, xzr
	ret
	.globl	silica_rt_ctx_resume
	.p2align	2
silica_rt_ctx_resume:
// X0 = a carrier actor with a parked context (#464). Never returns to its caller: continues the
// actor after its silica_rt_ctx_save, with X0 = 1.
	ldr	x9, [x0, #464]
	str	xzr, [x0, #464]
	mov	sp, x9
	ldp	x19, x20, [sp]
	ldp	x21, x22, [sp, #16]
	ldp	x23, x24, [sp, #32]
	ldp	x25, x26, [sp, #48]
	ldp	x27, x28, [sp, #64]
	ldp	x29, x30, [sp, #80]
	ldp	d8, d9, [sp, #96]
	ldp	d10, d11, [sp, #112]
	ldp	d12, d13, [sp, #128]
	ldp	d14, d15, [sp, #144]
	add	sp, sp, #176
	mov	x0, #1
	ret
"
}

// The run queues and the dispatch-order policy (stage 4; the board's silica_rt_rq_push / rq_take /
// rq_pop and silica_rt_set_scheduler_policy, rt_actors.S). Every function here is entered with
// the carrier's lock held, except silica_rt_set_scheduler_policy, which holds nothing.
fn carrier_asm_run_queues() -> string {
    "	.globl	silica_rt_rq_push
	.p2align	2
silica_rt_rq_push:
// X0 = a carrier (its lock held), X1 = an actor its caller has made ready (status 2). Appends it
// to the tail of the queue the policy chooses: the actor's priority tier (ACB #520: 0 low, 1
// normal, 2 high -> queue 2 - level; a level above 2, never stored, counts as normal) or, under
// :round_robin (1), the normal queue, whatever the level, so ready actors run in arrival order.
	adrp	x8, silica_rt_sched_policy
	add	x8, x8, :lo12:silica_rt_sched_policy
	ldr	x9, [x8]
	cmp	x9, #1
	b.eq	Lrqp_normal
	ldr	x9, [x1, #520]
	cmp	x9, #2
	b.hi	Lrqp_normal
	mov	x10, #2
	sub	x9, x10, x9
	b	Lrqp_have_q
Lrqp_normal:
	mov	x9, #1
Lrqp_have_q:
	mov	x10, #24
	madd	x9, x9, x10, x0
	add	x9, x9, #128
	ldr	x10, [x9, #16]
	add	x10, x10, #1
	str	x10, [x9, #16]
	str	xzr, [x1, #456]
	ldr	x10, [x9, #8]
	cbz	x10, Lrqp_empty
	str	x1, [x10, #456]
	str	x1, [x9, #8]
	ret
Lrqp_empty:
	str	x1, [x9]
	str	x1, [x9, #8]
	ret
	.globl	silica_rt_rq_take
	.p2align	2
silica_rt_rq_take:
// X0 = a carrier (its lock held), X1 = a queue index whose queue is not empty -> X0 = that queue's
// head, taken off it (its link cleared).
	mov	x10, #24
	madd	x9, x1, x10, x0
	add	x9, x9, #128
	ldr	x0, [x9]
	ldr	x10, [x0, #456]
	str	x10, [x9]
	cbnz	x10, Lrqt_len
	str	xzr, [x9, #8]
Lrqt_len:
	ldr	x10, [x9, #16]
	sub	x10, x10, #1
	str	x10, [x9, #16]
	str	xzr, [x0, #456]
	ret
	.globl	silica_rt_rq_pop
	.p2align	2
silica_rt_rq_pop:
// X0 = a carrier (its lock held) -> X0 = the next actor to run under the policy in force, 0 when
// every queue is empty.
//   :priority_fifo (0), and :round_robin (1), whose pushes all land in the normal queue: the head
//   of the highest-priority non-empty queue.
//   :weighted_fair (2): deficit round robin. The tier being served (+200) runs its head while it
//   has credit (+208) and actors, a unit cost per dispatch; otherwise the next tier starts with
//   its quantum (high 4, normal 2, low 1), an empty tier forfeiting its turn (DRR zeroes the
//   deficit of an idle queue). Some queue is non-empty, so at most three tier changes reach a
//   tier that runs.
//   :lottery (3): tickets = weight x actors queued, per tier, the same weights; a draw in
//   [0, total) picks the tier in proportion to its tickets and the tier's head runs. The
//   generator is a xorshift64 (Marsaglia 2003: 13, 7, 17) per carrier (+216, under this lock),
//   seeded from the clock and the carrier's index at the first draw, kept non-zero; nothing of
//   cryptographic strength is needed.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	adrp	x8, silica_rt_sched_policy
	add	x8, x8, :lo12:silica_rt_sched_policy
	ldr	x9, [x8]
	cmp	x9, #2
	b.eq	Lrqo_wf
	cmp	x9, #3
	b.eq	Lrqo_lottery
	mov	x1, xzr
Lrqo_scan:
	mov	x10, #24
	madd	x9, x1, x10, x19
	ldr	x9, [x9, #128]
	cbnz	x9, Lrqo_take
	add	x1, x1, #1
	cmp	x1, #3
	b.lo	Lrqo_scan
	mov	x0, xzr
	b	Lrqo_ret
Lrqo_take:
	mov	x0, x19
	bl	silica_rt_rq_take
	b	Lrqo_ret
Lrqo_wf:
	ldr	x9, [x19, #128]
	ldr	x10, [x19, #152]
	orr	x9, x9, x10
	ldr	x10, [x19, #176]
	orr	x9, x9, x10
	cbnz	x9, Lrqo_wf_have
	mov	x0, xzr
	b	Lrqo_ret
Lrqo_wf_have:
	ldr	x1, [x19, #200]
	ldr	x2, [x19, #208]
Lrqo_wf_try:
	mov	x10, #24
	madd	x9, x1, x10, x19
	ldr	x9, [x9, #128]
	cbz	x9, Lrqo_wf_next
	cbz	x2, Lrqo_wf_next
	sub	x2, x2, #1
	str	x1, [x19, #200]
	str	x2, [x19, #208]
	b	Lrqo_take
Lrqo_wf_next:
	add	x1, x1, #1
	cmp	x1, #3
	b.lo	Lrqo_wf_quantum
	mov	x1, xzr
Lrqo_wf_quantum:
	mov	x2, #4
	cbz	x1, Lrqo_wf_try
	mov	x2, #2
	cmp	x1, #1
	b.eq	Lrqo_wf_try
	mov	x2, #1
	b	Lrqo_wf_try
Lrqo_lottery:
	ldr	x9, [x19, #216]
	cbnz	x9, Lrqo_lot_seeded
	bl	silica_rt_stack_now_ns
	ldr	x9, [x19, #112]
	add	x9, x9, #1
	eor	x0, x0, x9, lsl #32
	orr	x0, x0, #1
	str	x0, [x19, #216]
Lrqo_lot_seeded:
	ldr	x11, [x19, #144]
	lsl	x11, x11, #2
	ldr	x12, [x19, #168]
	lsl	x12, x12, #1
	ldr	x13, [x19, #192]
	add	x14, x11, x12
	add	x14, x14, x13
	cbnz	x14, Lrqo_lot_draw
	mov	x0, xzr
	b	Lrqo_ret
Lrqo_lot_draw:
	ldr	x9, [x19, #216]
	eor	x9, x9, x9, lsl #13
	eor	x9, x9, x9, lsr #7
	eor	x9, x9, x9, lsl #17
	str	x9, [x19, #216]
	udiv	x10, x9, x14
	msub	x9, x10, x14, x9
	mov	x1, xzr
	cmp	x9, x11
	b.lo	Lrqo_take
	sub	x9, x9, x11
	mov	x1, #1
	cmp	x9, x12
	b.lo	Lrqo_take
	mov	x1, #2
	b	Lrqo_take
Lrqo_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_set_scheduler_policy
	.p2align	2
silica_rt_set_scheduler_policy:
// set_scheduler_policy(policy): X0 = the policy code (0 :priority_fifo, 1 :round_robin, 2
// :weighted_fair, 3 :lottery; the emitter maps the program's atoms to the codes and the result
// back, prims_actors emit_set_scheduler_policy_with_atoms) -> X0 = 0 (:ok) or 1 (:invalid_policy:
// any other code, the policy unchanged). One word for the process, read by every carrier at its
// next push or pop (this module's header says what happens to actors already queued). A
// dangerous actor, on a thread of its own, is scheduled by the OS and takes no part.
	cmp	x0, #4
	b.hs	Lssp_invalid
	adrp	x8, silica_rt_sched_policy
	add	x8, x8, :lo12:silica_rt_sched_policy
	stlr	x0, [x8]
	mov	x0, xzr
	ret
Lssp_invalid:
	mov	x0, #1
	ret
"
}

fn emit_actor_carrier_runtime_asm() -> string {
    concat(concat(concat(concat(concat(concat(carrier_asm_data(), carrier_asm_adopt()), carrier_asm_loop()), carrier_asm_wakes()), carrier_asm_placement()), carrier_asm_run_queues()), carrier_asm_context())
}
