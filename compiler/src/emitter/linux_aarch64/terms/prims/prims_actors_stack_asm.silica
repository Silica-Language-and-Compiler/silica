// Runtime-managed actor stacks, linux_aarch64 port of emitter/apple_silicon_mac (GNU/ELF syntax, glibc,
// futex, sysconf/sysinfo) (silica-specification §15.1.2.2, revised 2026-09-17;
// actor_growable_stack_design.md §2.1, §2.2, §4.2, §4.4, §7; Phase1_TODOs/actor_stack_growth_plan.md).
//
// One contiguous inaccessible reservation per actor, made at spawn: the default is the machine's
// memory plus swap (sysconf(_SC_PHYS_PAGES) and sysinfo().totalswap, read once, page rounded) and `stack_policy(reserve, ...)`
// lowers it. Nothing is committed at spawn. The synchronous fault handler commits chunks below the
// committed run: one platform page first, doubling per fault to 1 MB, then 1 MB per fault. The committed
// run is one mapping and the untouched remainder the second; there is no guard mapping. At the message
// boundary the actor's release algorithm decides what stays committed, and a release is an anonymous
// MAP_FIXED remap to PROT_NONE (the same primitive as on Darwin; on Linux it also keeps the two
// mappings merged, which matters against vm.max_map_count).
//
// ACB fields owned by this module (the control block is 528 B; 0..271 and 392..527 are the actor runtime's,
// actor_memory_budget_plan.md items I and N):
//   #272 stack base (reservation low address; 0 = none)   #280 reservation bytes
//   #288 committed bytes (the run [top-committed, top))     #296 high-water committed bytes
//   #304 next growth chunk bytes                           #312 release algorithm 1..5
//   #320 retained bytes (what the algorithm holds now)     #328 32-entry usage ring (track_recent_peak)
//   #336 ring index                                        #344 last message time, monotonic ns
//   #352 per-thread signal alt stack (64 KB mapping; 0 for a carrier actor, whose carrier has one)
//   #360 policy as given (for children to inherit)
//   #368 runtime SP saved while a behavior runs on the actor stack   #376 1 = reservation was lowered
//   #384 pending (:explicit, atom) reason atom for the exit payload
// Release algorithms: 1 :release_on_return, 2 :keep_last_message, 3 :track_recent_peak,
// 4 :release_when_idle, 5 :keep_high_water. The packed stack_policy word is (reserve & ~15) | algorithm.
//
// Per-message usage for :keep_last_message and :track_recent_peak is measured, not guessed: the run is
// zero at the start of every message (fresh pages are zero and the runtime zeroes what a message used
// before the next one), so the lowest page holding a nonzero word after the behavior returns is the
// message's depth. The scan costs the untouched pages, which are exactly the ones about to be released.
// :release_when_idle: a carrier actor is swept by its carrier (prims_actors_carrier_asm.silica,
// silica_rt_carrier_sweep) once the idle period has passed since its last message
// (silica_rt_stack_idle_due, against one clock reading per sweep), or sooner, oldest first, while
// the idle stacks listed on its carrier exceed the carrier's idle-stack budget
// (silica_rt_idle_stack_budget; release_when_idle_design.md, 2026-10-20: the period is an upper bound
// on how long an idle stack is kept, not a promise); a dangerous actor, on a thread of its own, waits
// for mail with the period as its timeout while it holds committed stack and releases on expiry
// (silica_rt_stack_idle_check; it is outside the budget). The period is spec §15.1.2.2's one second
// unless SILICA_IDLE_RELEASE_MS=<milliseconds> in the environment says otherwise (read once by
// silica_rt_stack_runtime_init: unset, 0 or not a number keeps 1000 ms; more than 3,600,000 ms is
// clamped to that hour), kept in nanoseconds in silica_rt_idle_release_ns; a busy carrier looks at
// its list at most every silica_rt_idle_sweep_ns = min(250 ms, the period / 4). The budget is per
// carrier: SILICA_IDLE_STACK_BUDGET=<bytes> (the process total; unset, 0 or not a number means the
// default, the machine's memory plus swap over 32) split evenly over the carriers, at least 16
// platform pages each (sysconf(_SC_PAGESIZE): 16 KB on the Pi 5, 4 KB on nix, so a byte budget covers
// four times the one-page actors on a 4 KB host). It is a cap on the transient, never a reservation and
// never a per-actor limit.
//
// silica_rt_stack_runtime_init also reads the carrier count (SILICA_CARRIER_COUNT, else the machine's
// logical cores) and the machine's core counts (prims_actors_carrier_asm.silica).

use atom_table;

export emit_actor_stack_runtime_asm/1;

fn stack_asm_data(stack_exhausted_idx: string, reserve_failed_idx: string, thread_limit_idx: string) -> string {
    p0: string <- "	.bss
	.p2align	3
silica_rt_stack_page:
	.zero	8
silica_rt_stack_default_reserve:
	.zero	8
silica_rt_stack_init_done:
	.zero	8
	.globl	silica_rt_idle_release_ns
silica_rt_idle_release_ns:
	.zero	8
	.globl	silica_rt_idle_sweep_ns
silica_rt_idle_sweep_ns:
	.zero	8
	.globl	silica_rt_idle_stack_budget
silica_rt_idle_stack_budget:
	.zero	8
	.data
	.p2align	3
	.globl	silica_rt_stack_exhausted_atom
silica_rt_stack_exhausted_atom:
	.quad	";
    p1: string <- concat(concat(p0, stack_exhausted_idx), "
	.globl	silica_rt_stack_reserve_failed_atom
silica_rt_stack_reserve_failed_atom:
	.quad	");
    p2: string <- concat(concat(p1, reserve_failed_idx), "
	.globl	silica_rt_thread_limit_atom
silica_rt_thread_limit_atom:
	.quad	");
    concat(concat(p2, thread_limit_idx), "
	.section .rodata
L_srt_idle_release_env:
	.asciz	\"SILICA_IDLE_RELEASE_MS\"
L_srt_idle_budget_env:
	.asciz	\"SILICA_IDLE_STACK_BUDGET\"
")
}

fn stack_asm_init() -> string {
    "	.text
	.globl	silica_rt_stack_runtime_init
	.p2align	2
silica_rt_stack_runtime_init:
// Read the platform page and the default reservation (physical memory + swap) once; then the carrier
// count, the machine's core counts, the :release_when_idle period and the idle-stack budget (header).
// _SC_PAGESIZE = 30, _SC_PHYS_PAGES = 85; struct sysinfo: totalswap @64, mem_unit (u32) @104 (the
// struct sits at SP+48 .. SP+160; X21 is kept at SP+160).
	stp	x29, x30, [sp, #-176]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #160]
	adrp	x19, silica_rt_stack_init_done
	add	x19, x19, :lo12:silica_rt_stack_init_done
	ldr	x8, [x19]
	cbnz	x8, Lsri_done
	mov	w0, #30
	bl	sysconf
	cmp	x0, #0
	b.gt	Lsri_have_page
	mov	x0, #4096
Lsri_have_page:
	mov	x20, x0
	adrp	x8, silica_rt_stack_page
	add	x8, x8, :lo12:silica_rt_stack_page
	str	x20, [x8]
	mov	w0, #85
	bl	sysconf
	cmp	x0, #0
	csel	x0, x0, xzr, gt
	mul	x9, x0, x20
	str	x9, [sp, #32]
	add	x0, sp, #48
	bl	sysinfo
	cbz	w0, Lsri_swap_ok
	str	xzr, [sp, #112]
	mov	w8, #1
	str	w8, [sp, #152]
Lsri_swap_ok:
	ldr	x9, [sp, #32]
	ldr	x10, [sp, #112]
	ldr	w11, [sp, #152]
	cbnz	w11, Lsri_unit_ok
	mov	w11, #1
Lsri_unit_ok:
	mul	x10, x10, x11
	add	x9, x9, x10
	cbnz	x9, Lsri_have_total
	mov	x9, #1
	lsl	x9, x9, #34
Lsri_have_total:
	sub	x10, x20, #1
	add	x9, x9, x10
	bic	x9, x9, x10
	adrp	x8, silica_rt_stack_default_reserve
	add	x8, x8, :lo12:silica_rt_stack_default_reserve
	str	x9, [x8]
// The carrier count (item N): SILICA_CARRIER_COUNT=<n> in the environment (decimal, n >= 1; unset,
// 0 or anything else is ignored), else the machine's logical cores (hw.logicalcpu), at least 1.
// Carriers are the only model (prims_actors_carrier_asm.silica header): there is no gate.
	adrp	x0, L_srt_carrier_count_env
	add	x0, x0, :lo12:L_srt_carrier_count_env
	bl	getenv
	mov	x20, xzr
	cbz	x0, Lsri_count_sysctl
Lsri_count_digit:
	ldrb	w9, [x0], #1
	sub	w9, w9, #48
	cmp	w9, #9
	b.hi	Lsri_count_parsed
	mov	x10, #10
	mul	x20, x20, x10
	add	x20, x20, x9
	b	Lsri_count_digit
Lsri_count_parsed:
	cbnz	x20, Lsri_count_have
Lsri_count_sysctl:
	adrp	x0, L_srt_hw_logicalcpu
	add	x0, x0, :lo12:L_srt_hw_logicalcpu
	bl	silica_rt_sysctl_u64
	mov	x20, x0
	cbnz	x20, Lsri_count_have
	mov	x20, #1
Lsri_count_have:
	adrp	x8, silica_rt_carrier_count
	add	x8, x8, :lo12:silica_rt_carrier_count
	str	x20, [x8]
// The machine's own counts (item N stage 3), whatever the carrier count: the logical cores
// (hw.logicalcpu, at least 1), which bound the core ids placement accepts, and the performance
// cores among them (hw.perflevel0.logicalcpu: the P cores are ids [0, P) as get_cpu_topology
// reports them; a machine that does not answer is uniform, all P; the Linux shim answers the
// logical core count, so every core is a performance core here and no efficiency carrier exists).
	adrp	x0, L_srt_hw_logicalcpu
	add	x0, x0, :lo12:L_srt_hw_logicalcpu
	bl	silica_rt_sysctl_u64
	cbnz	x0, Lsri_logical_have
	mov	x0, #1
Lsri_logical_have:
	adrp	x8, silica_rt_logical_cpu_count
	add	x8, x8, :lo12:silica_rt_logical_cpu_count
	str	x0, [x8]
	adrp	x0, L_srt_hw_perf0_logicalcpu
	add	x0, x0, :lo12:L_srt_hw_perf0_logicalcpu
	bl	silica_rt_sysctl_u64
	cbnz	x0, Lsri_pcore_have
	adrp	x8, silica_rt_logical_cpu_count
	add	x8, x8, :lo12:silica_rt_logical_cpu_count
	ldr	x0, [x8]
Lsri_pcore_have:
	adrp	x8, silica_rt_pcore_count
	add	x8, x8, :lo12:silica_rt_pcore_count
	str	x0, [x8]
// The :release_when_idle period: SILICA_IDLE_RELEASE_MS=<ms> (decimal; the digits up to the first
// other character; unset, 0 or no digits keeps spec §15.1.2.2's 1000 ms; clamped to 3,600,000 ms, an
// hour), kept in nanoseconds; and a busy carrier's sweep cadence, min(250 ms, the period / 4).
	adrp	x0, L_srt_idle_release_env
	add	x0, x0, :lo12:L_srt_idle_release_env
	bl	getenv
	mov	x21, xzr
	cbz	x0, Lsri_idle_parsed
Lsri_idle_digit:
	ldrb	w9, [x0], #1
	sub	w9, w9, #48
	cmp	w9, #9
	b.hi	Lsri_idle_parsed
	mov	x10, #10
	mul	x21, x21, x10
	add	x21, x21, x9
	movz	x10, #0xEE80
	movk	x10, #0x36, lsl #16
	cmp	x21, x10
	b.lo	Lsri_idle_digit
	mov	x21, x10
Lsri_idle_parsed:
	cbnz	x21, Lsri_idle_have
	mov	x21, #1000
Lsri_idle_have:
	movz	x10, #0x4240
	movk	x10, #0xF, lsl #16
	mul	x21, x21, x10
	adrp	x8, silica_rt_idle_release_ns
	add	x8, x8, :lo12:silica_rt_idle_release_ns
	str	x21, [x8]
	lsr	x9, x21, #2
	movz	x10, #0xB280
	movk	x10, #0x0EE6, lsl #16
	cmp	x9, x10
	csel	x9, x9, x10, lo
	adrp	x8, silica_rt_idle_sweep_ns
	add	x8, x8, :lo12:silica_rt_idle_sweep_ns
	str	x9, [x8]
// The idle-stack budget per carrier: SILICA_IDLE_STACK_BUDGET=<bytes> (decimal, the process total;
// unset, 0 or no digits means the default, the memory-plus-swap reservation over 32; the digits stop
// counting once the value passes 2^60) over the carrier count (X20), at least 16 platform pages.
	adrp	x0, L_srt_idle_budget_env
	add	x0, x0, :lo12:L_srt_idle_budget_env
	bl	getenv
	mov	x21, xzr
	cbz	x0, Lsri_budget_parsed
Lsri_budget_digit:
	ldrb	w9, [x0], #1
	sub	w9, w9, #48
	cmp	w9, #9
	b.hi	Lsri_budget_parsed
	mov	x10, #10
	mul	x21, x21, x10
	add	x21, x21, x9
	lsr	x10, x21, #60
	cbz	x10, Lsri_budget_digit
Lsri_budget_parsed:
	cbnz	x21, Lsri_budget_have
	adrp	x8, silica_rt_stack_default_reserve
	add	x8, x8, :lo12:silica_rt_stack_default_reserve
	ldr	x21, [x8]
	lsr	x21, x21, #5
Lsri_budget_have:
	udiv	x21, x21, x20
	adrp	x8, silica_rt_stack_page
	add	x8, x8, :lo12:silica_rt_stack_page
	ldr	x9, [x8]
	lsl	x9, x9, #4
	cmp	x21, x9
	csel	x21, x21, x9, hs
	adrp	x8, silica_rt_idle_stack_budget
	add	x8, x8, :lo12:silica_rt_idle_stack_budget
	str	x21, [x8]
	mov	x8, #1
	str	x8, [x19]
Lsri_done:
	ldr	x21, [sp, #160]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #176
	ret
	.globl	silica_rt_stack_prefix_for
	.p2align	2
silica_rt_stack_prefix_for:
// X0 = bytes to keep -> X0 = the smallest chunk-sequence prefix sum >= X0, X1 = the chunk after it.
	adrp	x8, silica_rt_stack_page
	add	x8, x8, :lo12:silica_rt_stack_page
	ldr	x9, [x8]
	mov	x10, xzr
	movz	x11, #0x10, lsl #16
Lspf_loop:
	cmp	x10, x0
	b.hs	Lspf_done
	add	x10, x10, x9
	cmp	x9, x11
	b.hs	Lspf_loop
	lsl	x9, x9, #1
	b	Lspf_loop
Lspf_done:
	mov	x0, x10
	mov	x1, x9
	ret
	.globl	silica_rt_stack_now_ns
	.p2align	2
silica_rt_stack_now_ns:
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	mov	w0, #1
	add	x1, sp, #16
	bl	clock_gettime
	ldr	x0, [sp, #16]
	ldr	x1, [sp, #24]
	movz	x2, #0xCA00
	movk	x2, #0x3B9A, lsl #16
	mul	x0, x0, x2
	add	x0, x0, x1
	ldp	x29, x30, [sp], #32
	ret
"
}

fn stack_asm_reserve() -> string {
    "	.globl	silica_rt_actor_stack_reserve
	.p2align	2
silica_rt_actor_stack_reserve:
// X0 = ACB, X1 = packed stack_policy (0 = inherit the spawning actor's, else the default with
// :keep_last_message). Returns X0 = 0 on success, 1 when no reservation could be made.
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	bl	silica_rt_stack_runtime_init
	cbnz	x20, Lasr_have_policy
	bl	silica_rt_tls_current_actor_get
	cbz	x0, Lasr_default_policy
	ldr	x20, [x0, #360]
	cbnz	x20, Lasr_have_policy
Lasr_default_policy:
	mov	x20, #2
Lasr_have_policy:
	and	x21, x20, #0xf
	cbnz	x21, Lasr_alg_ok
	mov	x21, #2
Lasr_alg_ok:
	and	x22, x20, #0xfffffffffffffff0
	adrp	x8, silica_rt_stack_page
	add	x8, x8, :lo12:silica_rt_stack_page
	ldr	x23, [x8]
	mov	x24, xzr
	cbz	x22, Lasr_default
	mov	x24, #1
	sub	x9, x23, #1
	add	x22, x22, x9
	bic	x22, x22, x9
	b	Lasr_try
Lasr_default:
	adrp	x8, silica_rt_stack_default_reserve
	add	x8, x8, :lo12:silica_rt_stack_default_reserve
	ldr	x22, [x8]
Lasr_try:
	mov	x0, xzr
	mov	x1, x22
	mov	w2, #0
	movz	w3, #0x4022
	mov	w4, #-1
	mov	x5, xzr
	bl	mmap
	cmn	x0, #1
	b.ne	Lasr_mapped
	cbnz	x24, Lasr_fail
// The host refused the whole-machine reservation by heuristic: reserve just under it, in
// sixteenths, down to half of the default.
	adrp	x8, silica_rt_stack_default_reserve
	add	x8, x8, :lo12:silica_rt_stack_default_reserve
	ldr	x9, [x8]
	lsr	x10, x9, #4
	sub	x11, x23, #1
	add	x10, x10, x11
	bic	x10, x10, x11
	sub	x22, x22, x10
	lsr	x9, x9, #1
	cmp	x22, x9
	b.lo	Lasr_fail
	b	Lasr_try
Lasr_mapped:
	str	x0, [x19, #272]
	str	x22, [x19, #280]
	str	xzr, [x19, #288]
	str	xzr, [x19, #296]
	str	x23, [x19, #304]
	str	x21, [x19, #312]
	str	xzr, [x19, #320]
	str	xzr, [x19, #328]
	str	xzr, [x19, #336]
	str	xzr, [x19, #344]
	str	xzr, [x19, #352]
	and	x9, x20, #0xfffffffffffffff0
	orr	x9, x9, x21
	str	x9, [x19, #360]
	str	xzr, [x19, #368]
	str	x24, [x19, #376]
	str	xzr, [x19, #384]
	cmp	x21, #3
	b.ne	Lasr_no_ring
	mov	w0, #32
	mov	w1, #8
	bl	calloc
	str	x0, [x19, #328]
Lasr_no_ring:
	mov	x0, xzr
	b	Lasr_ret
Lasr_fail:
	str	xzr, [x19, #272]
	mov	x0, #1
Lasr_ret:
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	silica_rt_actor_altstack_install
	.p2align	2
silica_rt_actor_altstack_install:
// X0 = ACB. Every actor thread faults with SP inside its own inaccessible reservation, so the
// handler needs an alternate stack of its own on this thread (#352). A carrier installs one for
// its thread the same way (silica_rt_altstack_install_at, the word in its own block).
	add	x0, x0, #352
	.globl	silica_rt_altstack_install_at
	.p2align	2
silica_rt_altstack_install_at:
// X0 = the word that records the 64 KB mapping for this thread's signal alternate stack.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	mov	x0, xzr
	mov	x1, #65536
	mov	w2, #3
	mov	w3, #0x22
	mov	w4, #-1
	mov	x5, xzr
	bl	mmap
	cmn	x0, #1
	b.eq	Lsai_ret
	str	x0, [x19]
	str	x0, [sp, #24]
	str	wzr, [sp, #32]
	mov	x8, #65536
	str	x8, [sp, #40]
	add	x0, sp, #24
	mov	x1, xzr
	bl	sigaltstack
Lsai_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	silica_rt_actor_stack_free
	.p2align	2
silica_rt_actor_stack_free:
// X0 = ACB, X1 = 1 when called on the alt stack (keep it mapped). Unmaps the reservation.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	ldr	x0, [x19, #272]
	cbz	x0, Lsaf_alt
	ldr	x1, [x19, #280]
	bl	munmap
	str	xzr, [x19, #272]
Lsaf_alt:
	cbnz	x20, Lsaf_ring
	ldr	x0, [x19, #352]
	cbz	x0, Lsaf_ring
	mov	x1, #65536
	bl	munmap
	str	xzr, [x19, #352]
Lsaf_ring:
	ldr	x0, [x19, #328]
	cbz	x0, Lsaf_done
	bl	free
	str	xzr, [x19, #328]
Lsaf_done:
	str	xzr, [x19, #288]
	str	xzr, [x19, #320]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
"
}

fn stack_asm_grow_release() -> string {
    "	.globl	silica_rt_stack_grow_to
	.p2align	2
silica_rt_stack_grow_to:
// X0 = ACB, X1 = faulting address inside the reservation. Commits chunks below the committed run
// until the address is covered. X0 = 0 grown, 1 the lowered reservation is exhausted, 2 the host
// refused the commit, 3 the address was already committed (not stack growth).
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	str	x23, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	mov	x23, xzr
Lsgt_loop:
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	ldr	x10, [x19, #288]
	sub	x21, x9, x10
	cmp	x20, x21
	b.hs	Lsgt_covered
// The lowest page of the reservation is never committed: reaching it is the end of the
// reservation whatever mapping sits below (the remainder stays a second, inaccessible mapping).
	ldr	x22, [x19, #304]
	sub	x11, x21, x8
	adrp	x12, silica_rt_stack_page
	add	x12, x12, :lo12:silica_rt_stack_page
	ldr	x12, [x12]
	subs	x11, x11, x12
	b.ls	Lsgt_exhausted
	cmp	x22, x11
	csel	x22, x11, x22, hi
	sub	x0, x21, x22
	mov	x1, x22
	mov	w2, #3
	bl	mprotect
	cbnz	w0, Lsgt_commit_failed
	mov	x23, #1
	ldr	x10, [x19, #288]
	add	x10, x10, x22
	str	x10, [x19, #288]
	ldr	x11, [x19, #296]
	cmp	x10, x11
	b.ls	Lsgt_no_hw
	str	x10, [x19, #296]
Lsgt_no_hw:
	ldr	x11, [x19, #304]
	movz	x12, #0x10, lsl #16
	cmp	x11, x12
	b.hs	Lsgt_loop
	lsl	x11, x11, #1
	str	x11, [x19, #304]
	b	Lsgt_loop
Lsgt_covered:
	cbz	x23, Lsgt_not_ours
	mov	x0, xzr
	b	Lsgt_ret
Lsgt_not_ours:
	mov	x0, #3
	b	Lsgt_ret
Lsgt_exhausted:
	mov	x0, #1
	b	Lsgt_ret
Lsgt_commit_failed:
	mov	x0, #2
Lsgt_ret:
	ldr	x23, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	silica_rt_stack_measure
	.p2align	2
silica_rt_stack_measure:
// X0 = ACB -> X0 = bytes from the top down to the lowest page holding a nonzero word (0 = none).
	ldr	x8, [x0, #272]
	ldr	x9, [x0, #280]
	add	x9, x8, x9
	ldr	x10, [x0, #288]
	sub	x11, x9, x10
	adrp	x12, silica_rt_stack_page
	add	x12, x12, :lo12:silica_rt_stack_page
	ldr	x12, [x12]
Lsm_page:
	cmp	x11, x9
	b.hs	Lsm_none
	mov	x13, x11
	add	x14, x11, x12
Lsm_word:
	ldp	x15, x16, [x13], #16
	orr	x15, x15, x16
	cbnz	x15, Lsm_found
	cmp	x13, x14
	b.lo	Lsm_word
	mov	x11, x14
	b	Lsm_page
Lsm_found:
	sub	x0, x9, x11
	ret
Lsm_none:
	mov	x0, xzr
	ret
	.globl	silica_rt_stack_release_to
	.p2align	2
silica_rt_stack_release_to:
// X0 = ACB, X1 = bytes to keep, X2 = bytes at the top the last message used (zeroed if kept).
// Releases whole chunks below the smallest chunk prefix that covers X1, in the sizes they grew by.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x21, x2
	mov	x0, x1
	cbz	x0, Lsrt_zero_keep
	bl	silica_rt_stack_prefix_for
	b	Lsrt_have
Lsrt_zero_keep:
	mov	x0, xzr
	adrp	x8, silica_rt_stack_page
	add	x8, x8, :lo12:silica_rt_stack_page
	ldr	x1, [x8]
Lsrt_have:
	mov	x20, x0
	mov	x22, x1
	ldr	x10, [x19, #288]
	cmp	x20, x10
	b.hs	Lsrt_zero
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	sub	x0, x9, x10
	sub	x1, x10, x20
	mov	w2, #0
	movz	w3, #0x4032
	mov	w4, #-1
	mov	x5, xzr
	bl	mmap
	str	x20, [x19, #288]
	str	x22, [x19, #304]
	cbnz	x20, Lsrt_zero
	ldr	x0, [x19, #352]
	cbz	x0, Lsrt_zero
	mov	x1, #65536
	mov	w2, #4
	bl	madvise
Lsrt_zero:
	ldr	x10, [x19, #288]
	str	x10, [x19, #320]
	cbz	x21, Lsrt_ret
	cmp	x21, x10
	csel	x21, x10, x21, hi
	cbz	x21, Lsrt_ret
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	sub	x0, x9, x21
	mov	x1, xzr
	mov	x2, x21
	bl	memset
Lsrt_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	silica_rt_stack_on_message_return
	.p2align	2
silica_rt_stack_on_message_return:
// X0 = ACB. The behavior has returned and the stack is empty: apply the actor's release algorithm.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	ldr	x8, [x19, #272]
	cbz	x8, Lsmr_ret
	ldr	x9, [x19, #312]
	cmp	x9, #5
	b.eq	Lsmr_keep_all
	cmp	x9, #4
	b.eq	Lsmr_idle_stamp
	cmp	x9, #1
	b.eq	Lsmr_release_all
	mov	x0, x19
	bl	silica_rt_stack_measure
	mov	x20, x0
	ldr	x9, [x19, #312]
	cmp	x9, #3
	b.ne	Lsmr_keep_depth
	ldr	x10, [x19, #328]
	cbz	x10, Lsmr_keep_depth
	ldr	x11, [x19, #336]
	and	x12, x11, #31
	str	x20, [x10, x12, lsl #3]
	add	x11, x11, #1
	str	x11, [x19, #336]
	mov	x12, xzr
	mov	x21, xzr
Lsmr_ring_max:
	ldr	x13, [x10, x12, lsl #3]
	cmp	x13, x21
	csel	x21, x13, x21, hi
	add	x12, x12, #1
	cmp	x12, #32
	b.lo	Lsmr_ring_max
	b	Lsmr_release_keep
Lsmr_keep_depth:
	mov	x21, x20
Lsmr_release_keep:
	mov	x0, x19
	mov	x1, x21
	mov	x2, x20
	bl	silica_rt_stack_release_to
	b	Lsmr_ret
Lsmr_keep_all:
	ldr	x10, [x19, #288]
	str	x10, [x19, #320]
	b	Lsmr_ret
Lsmr_idle_stamp:
	ldr	x10, [x19, #288]
	str	x10, [x19, #320]
	bl	silica_rt_stack_now_ns
	str	x0, [x19, #344]
	b	Lsmr_ret
Lsmr_release_all:
	mov	x0, x19
	mov	x1, xzr
	mov	x2, xzr
	bl	silica_rt_stack_release_to
Lsmr_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	silica_rt_stack_idle_check
	.p2align	2
silica_rt_stack_idle_check:
// X0 = ACB -> X0 = mailbox wait timeout in microseconds (0 = wait without a timeout). Only
// :release_when_idle actors holding committed stack wait with a timeout; once the idle period
// (silica_rt_idle_release_ns) has passed since the last message the stack is released and the wait
// becomes untimed. A dangerous actor's thread makes this check; a carrier's sweep uses
// silica_rt_stack_idle_due below.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	ldr	x9, [x19, #312]
	cmp	x9, #4
	b.ne	Lsic_none
	ldr	x10, [x19, #288]
	cbz	x10, Lsic_none
	bl	silica_rt_stack_now_ns
	ldr	x11, [x19, #344]
	sub	x12, x0, x11
	adrp	x13, silica_rt_idle_release_ns
	add	x13, x13, :lo12:silica_rt_idle_release_ns
	ldr	x13, [x13]
	cmp	x12, x13
	b.lo	Lsic_wait
	mov	x0, x19
	mov	x1, xzr
	mov	x2, xzr
	bl	silica_rt_stack_release_to
	b	Lsic_none
Lsic_wait:
	sub	x12, x13, x12
	mov	x13, #1000
	udiv	x0, x12, x13
	add	x0, x0, #1
	b	Lsic_ret
Lsic_none:
	mov	x0, xzr
Lsic_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	silica_rt_stack_idle_due
	.p2align	2
silica_rt_stack_idle_due:
// X0 = ACB (a :release_when_idle actor holding committed stack, on its carrier's sweep list), X1 =
// the time now (monotonic ns; the sweep reads the clock once for a whole batch) -> X0 = 0 when the
// idle period (silica_rt_idle_release_ns) has passed since the actor's last message (#344), else
// the microseconds until it will have, at least 1. Leaf; X9-X10.
	ldr	x9, [x0, #344]
	sub	x9, x1, x9
	adrp	x10, silica_rt_idle_release_ns
	add	x10, x10, :lo12:silica_rt_idle_release_ns
	ldr	x10, [x10]
	cmp	x9, x10
	b.hs	Lsid_due
	sub	x9, x10, x9
	mov	x10, #1000
	udiv	x0, x9, x10
	add	x0, x0, #1
	ret
Lsid_due:
	mov	x0, xzr
	ret
	.globl	silica_rt_cv_wait_timeout
	.p2align	2
silica_rt_cv_wait_timeout:
// X0 = cv_addr, X1 = lock_addr, X2 = timeout in microseconds (0 = none). Caller holds the lock;
// the lock is held again on return, whether woken or timed out.
	stp	x29, x30, [sp, #-48]!
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	add	x29, sp, #0
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	ldr	w22, [x19]
	mov	x0, x20
	bl	silica_rt_lock_unlock
	cbz	x21, Lcwt_untimed
// futex(addr, FUTEX_WAIT_PRIVATE = 128, expected, &timespec{us / 1000000, (us % 1000000) * 1000})
	sub	sp, sp, #16
	mov	x9, #16960
	movk	x9, #15, lsl #16
	udiv	x10, x21, x9
	msub	x11, x10, x9, x21
	mov	x12, #1000
	mul	x11, x11, x12
	stp	x10, x11, [sp]
	mov	x0, x19
	mov	w1, #128
	mov	w2, w22
	mov	x3, sp
	mov	x4, xzr
	mov	x5, xzr
	mov	x8, #98
	svc	#0
	add	sp, sp, #16
	b	Lcwt_lock
Lcwt_untimed:
	mov	w0, #3
	mov	x1, x19
	mov	x2, x22
	mov	w3, #0
	bl	silica_rt_futex_wait
Lcwt_lock:
	mov	x0, x20
	bl	silica_rt_lock_lock
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
"
}

fn stack_asm_fail_and_report() -> string {
    "	.globl	silica_rt_actor_fail_current
	.p2align	2
silica_rt_actor_fail_current:
// X0 = the current actor's ACB, X1 = reason atom. Ends the actor with (:explicit, atom): wakes its
// waiters, delivers the exit to its supervisor, frees what it owns and exits the thread. For a
// dangerous actor (a thread of its own) it runs on the signal alt stack (stack exhaustion) or on
// the actor stack (a spawn whose reservation failed). For a carrier actor it is entered on the
// carrier's stack (the fault handler returns into it there, through the signal frame, so the
// carrier's alternate-stack state is intact for the next fault) or on the actor's own (a failed
// spawn inside a behaviour or a start trampoline, a duplicate child id) and ends in the carrier
// loop; the reservation is freed first, before any waiter is woken, unless the actor has a
// supervision block (X20 = 1): then its children are shut down in the delivering phase, each
// waited for, and the waits park, which needs a stack the carrier loop leaves alone: the top of
// its own reservation (every frame below it is abandoned: a fault's signal frame was unwound by
// the kernel, a failed spawn never returns), unmapped after that phase instead.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	str	x1, [x19, #384]
	ldr	x21, [x19, #440]
	mov	x20, xzr
	cbz	x21, Lafc_thread_actor
	ldr	x9, [x19, #216]
	cbz	x9, Lafc_carrier_stack
	ldr	x9, [x19, #272]
	cbz	x9, Lafc_carrier_stack
	ldr	x10, [x19, #280]
	add	x9, x9, x10
	mov	sp, x9
	mov	x20, #1
	b	Lafc_deliver
Lafc_carrier_stack:
	ldr	x9, [x21, #48]
	mov	sp, x9
	b	Lafc_on_stack
Lafc_thread_actor:
// Move onto the thread's alt stack (its top; nothing there is needed again) so the actor stack
// this may be running on can be unmapped now. On the exhaustion path we are already there.
// The stack is given back before any waiter is woken, as at a message boundary: a caller that
// wakes on the death and asks get_actor_memory_usage must already see the reservation gone.
	ldr	x9, [x19, #352]
	cbz	x9, Lafc_on_stack
	mov	x10, #65536
	add	x9, x9, x10
	mov	sp, x9
Lafc_on_stack:
	mov	x0, x19
	mov	x1, #1
	bl	silica_rt_actor_stack_free
Lafc_deliver:
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	mov	x8, #4
	str	x8, [x19, #232]
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	silica_rt_actor_mail_signal
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	ldr	x8, [x19, #216]
	cbz	x8, Lsbg_5
	ldr	x8, [x8, #40]
Lsbg_5:
	cbnz	x8, Lafc_report_done
	mov	x0, x19
	bl	silica_rt_actor_deliver_exit
	mov	x0, x19
	bl	silica_rt_actor_deliver_unwind_report
Lafc_report_done:
// The started word (#224) is set after the report so a spawner spinning on it (actor_spawn /
// spawn_linked, while this actor's start trampoline ran) proceeds: 2 = the init trampoline failed (stack exhausted, a failed spawn reservation, a duplicate child id). The ACB is
// not freed under the spawner: it goes with its last holder (silica_rt_acb_release); a row child's
// exit notice is parked at #400 until its spawner has committed it to the row.
	ldr	x8, [x19, #224]
	cbnz	x8, Lafc_started_set
	mov	x0, x19
	mov	x1, #2
	bl	silica_rt_started_store
Lafc_started_set:
	mov	x0, x19
	bl	silica_rt_actor_signal_pending_call_deaths
	mov	x0, x19
	bl	silica_rt_ffi_arena_teardown
	mov	x0, x19
	bl	silica_rt_child_table_free
// The delivering phase ran on the reservation (X20): nothing waits any more, so onto the carrier's
// stack and the reservation goes.
	cbz	x20, Lafc_stack_done
	ldr	x9, [x21, #48]
	mov	sp, x9
	mov	x0, x19
	mov	x1, xzr
	bl	silica_rt_actor_stack_free
Lafc_stack_done:
	mov	x0, x19
	bl	silica_rt_actor_dealloc_region
	cbz	x21, Lafc_thread_end
	mov	x0, x19
	bl	silica_rt_actor_final_release
	mov	x0, x21
	b	silica_rt_carrier_loop_enter
Lafc_thread_end:
// A dangerous actor's thread (on its alt stack, or the reservation): back onto its own stack, the
// alt stack goes with the holds, and the start routine returns (silica_rt_thread_actor_end; never
// pthread_exit, which force-unwinds and spins on a stack that is not the thread's).
	mov	x0, x19
	b	silica_rt_thread_actor_end
	.globl	silica_rt_spawn_reserve_failed
	.p2align	2
silica_rt_spawn_reserve_failed:
// A spawn could not make its reservation. The spawning actor fails with
// (:explicit, :stack_reserve_failed). `main` is not an actor and has no supervisor, so there the
// process ends with a runtime abort, reason stack reservation failed, status 71 (spec §15.1.2.2,
// §15.4.5.5), reported at the spawn routine's call to this function. Never returns.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	silica_rt_tls_current_actor_get
	cbz	x0, Lsrf_main
	adrp	x8, silica_rt_stack_reserve_failed_atom
	add	x8, x8, :lo12:silica_rt_stack_reserve_failed_atom
	ldr	x1, [x8]
	bl	silica_rt_actor_fail_current
Lsrf_main:
	ldp	x29, x30, [sp], #16
	b	silica_rt_abort_stack_reserve
	.globl	silica_rt_spawn_thread_failed
	.p2align	2
silica_rt_spawn_thread_failed:
// A spawn_dangerous, or the start of a :dangerous row, could not make the actor's thread: the host
// refused it (pthread_create failed; macOS caps a task at kern.num_taskthreads threads, 4096, so
// about the 4,080th dangerous actor, Linux at its thread and mapping limits). The spawn gave back
// what it had taken before coming here (actor_memory_budget_plan.md item N, #5 option C). The
// spawning actor fails with (:explicit, :thread_limit), as it does for a reservation it cannot
// make; `main` is not an actor and has no supervisor, so there the process ends with a runtime
// abort, reason the thread of a dangerous actor could not be created, status 71 (spec §15.4.5.5),
// reported at the spawn routine's call to this function. Never returns.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	silica_rt_tls_current_actor_get
	cbz	x0, Lstf_main
	adrp	x8, silica_rt_thread_limit_atom
	add	x8, x8, :lo12:silica_rt_thread_limit_atom
	ldr	x1, [x8]
	bl	silica_rt_actor_fail_current
Lstf_main:
	ldp	x29, x30, [sp], #16
	b	silica_rt_abort_dangerous_thread
	.globl	silica_rt_get_actor_memory_usage
	.p2align	2
silica_rt_get_actor_memory_usage:
// X0 = reference: resolved and held for the body (silica_rt_ref_call; an ended actor reads as zero).
	adrp	x9, silica_rt_get_actor_memory_usage_acb
	add	x9, x9, :lo12:silica_rt_get_actor_memory_usage_acb
	b	silica_rt_ref_call
	.p2align	2
silica_rt_get_actor_memory_usage_acb:
// X0 = ACB or 0 -> X0 = heap { reserved, committed, retained, high_water } (bytes; all zero once
// the actor has ended).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	mov	x0, #40
	bl	malloc
	cbz	x0, Lgmu_ret
	movz	x8, #1, lsl #16
	movk	x8, #7
	str	x8, [x0]
	cmp	x19, #4096
	b.lo	Lgmu_zero
	ldr	x8, [x19, #272]
	cbz	x8, Lgmu_zero
	ldr	x8, [x19, #280]
	str	x8, [x0, #8]
	ldr	x8, [x19, #288]
	str	x8, [x0, #16]
	ldr	x8, [x19, #320]
	str	x8, [x0, #24]
	ldr	x8, [x19, #296]
	str	x8, [x0, #32]
	b	Lgmu_ret
Lgmu_zero:
	str	xzr, [x0, #8]
	str	xzr, [x0, #16]
	str	xzr, [x0, #24]
	str	xzr, [x0, #32]
Lgmu_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
"
}

fn emit_actor_stack_runtime_asm(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    stack_exhausted_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":stack_exhausted"));
    reserve_failed_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":stack_reserve_failed"));
    thread_limit_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":thread_limit"));
    concat(concat(concat(concat(stack_asm_data(stack_exhausted_idx, reserve_failed_idx, thread_limit_idx), stack_asm_init()), stack_asm_reserve()), stack_asm_grow_release()), stack_asm_fail_and_report())
}
