// Phase 13 — Linux (glibc, AArch64) sigaltstack / sigaction guarded-FFI fault bridge.
// Ported from apple_silicon_mac: stack_t, struct sigaction, ucontext_t and siginfo_t use Linux layouts;
// SIGBUS is 7 on Linux (10 on Darwin); sa_flags = SA_SIGINFO (4) | SA_ONSTACK (0x08000000) |
// SA_NODEFER (0x40000000).
// Per-thread guarded TLS block layout (512 B, see ffi_guarded_runtime_asm.silica):
//   +0 depth, +8 actor ACB, +16 call_gen, +24 inside,
//   +32 fault_signal, +40 fault_addr, +48 fault_code, +56 fault_in_arena,
//   +64 sigjmp_buf (448 B).

export emit_ffi_fault_runtime_asm/0;

// Runtime abort (spec §15.4.5.5; design_documents/runtime_failure_reporting.md). Every runtime check
// that cannot continue calls one of the per-site entries below (or silica_rt_abort_with with its own
// reason); the report is the line "[silica] abort: <reason> at 0x<pc>", followed by " in
// <symbol>+0x<offset>" when dladdr names the address, on stderr, and the process exits with status 71.
// The pc is the call instruction of the site. Nothing is allocated, and the report does not run on the
// caller's stack: the first caller claims the report and moves onto a static 32 KB stack (the caller
// may be an actor at the end of its reservation, or the signal handler on its alternate stack); any
// later caller, on any thread, parks until the process has gone. The exit is C _exit (async-signal-safe,
// no atexit handlers), which is what the C abort() it replaces also skipped.
fn emit_abort_runtime_asm() -> string {
    "	.section .rodata
Lrta_pre:
	.asciz	\"[silica] abort: \"
Lrta_at:
	.asciz	\" at 0x\"
Lrta_r_region_overflow:
	.asciz	\"region allocation failed\"
Lrta_r_buf_invalid:
	.asciz	\"invalid buffer size\"
Lrta_r_buf_bounds:
	.asciz	\"buffer index out of bounds\"
Lrta_r_list_index:
	.asciz	\"list index out of range\"
Lrta_r_arena_key:
	.asciz	\"canonical arena key is zero\"
Lrta_r_arena_full:
	.asciz	\"canonical arena table is full\"
Lrta_r_arena_nomem:
	.asciz	\"canonical arena allocation failed\"
Lrta_r_guarded_ffi_state:
	.asciz	\"guarded FFI state could not be allocated\"
Lrta_r_ingress_full:
	.asciz	\"supervision ingress queue is full\"
Lrta_r_exit_queue_full:
	.asciz	\"supervisor ingress queue is full (exit delivery)\"
Lrta_r_stack_commit:
	.asciz	\"cannot commit memory for a growing actor stack\"
Lrta_r_stack_reserve:
	.asciz	\"stack reservation failed\"
	.text
	.globl	silica_rt_abort_with
	.p2align	2
silica_rt_abort_with:
// X0 = NUL-terminated reason. The reported address is the BL that got here (X30 - 4). Never returns.
	sub	x1, x30, #4
	b	silica_rt_abort_with_pc
	.globl	silica_rt_abort_with_pc
	.p2align	2
silica_rt_abort_with_pc:
// X0 = reason, X1 = the address to report. Never returns.
	mov	x19, x0
	mov	x20, x1
	adrp	x8, silica_rt_abort_claimed
	add	x8, x8, :lo12:silica_rt_abort_claimed
	mov	w9, #1
Lrta_claim:
	ldaxr	w10, [x8]
	cbnz	w10, Lrta_park
	stlxr	w11, w9, [x8]
	cbnz	w11, Lrta_claim
	adrp	x8, silica_rt_abort_stack_top
	add	x8, x8, :lo12:silica_rt_abort_stack_top
	mov	sp, x8
	mov	x29, xzr
	adrp	x0, Lrta_pre
	add	x0, x0, :lo12:Lrta_pre
	bl	silica_rt_fault_puts
	mov	x0, x19
	bl	silica_rt_fault_puts
	adrp	x0, Lrta_at
	add	x0, x0, :lo12:Lrta_at
	bl	silica_rt_fault_puts
	mov	x0, x20
	bl	silica_rt_fault_puthex
	mov	x0, x20
	adrp	x1, silica_rt_fault_dlinfo
	add	x1, x1, :lo12:silica_rt_fault_dlinfo
	bl	dladdr
	cbz	w0, Lrta_eol
	adrp	x21, silica_rt_fault_dlinfo
	add	x21, x21, :lo12:silica_rt_fault_dlinfo
	ldr	x22, [x21, #16]
	cbz	x22, Lrta_eol
	adrp	x0, Lpfs_in
	add	x0, x0, :lo12:Lpfs_in
	bl	silica_rt_fault_puts
	mov	x0, x22
	bl	silica_rt_fault_puts
	ldr	x1, [x21, #24]
	cbz	x1, Lrta_eol
	sub	x22, x20, x1
	adrp	x0, Lpfs_plus
	add	x0, x0, :lo12:Lpfs_plus
	bl	silica_rt_fault_puts
	mov	x0, x22
	bl	silica_rt_fault_puthex
Lrta_eol:
	adrp	x0, Lpfs_eol
	add	x0, x0, :lo12:Lpfs_eol
	bl	silica_rt_fault_puts
	mov	w0, #71
	bl	_exit
Lrta_park:
	yield
	b	Lrta_park
// Per-site entries: the reason in X0, then on to silica_rt_abort_with with X30 untouched, so the
// reported address is still the site's BL.
	.globl	silica_rt_abort_region_overflow
	.p2align	2
silica_rt_abort_region_overflow:
	adrp	x0, Lrta_r_region_overflow
	add	x0, x0, :lo12:Lrta_r_region_overflow
	b	silica_rt_abort_with
	.globl	silica_rt_abort_buf_invalid
	.p2align	2
silica_rt_abort_buf_invalid:
	adrp	x0, Lrta_r_buf_invalid
	add	x0, x0, :lo12:Lrta_r_buf_invalid
	b	silica_rt_abort_with
	.globl	silica_rt_abort_buf_bounds
	.p2align	2
silica_rt_abort_buf_bounds:
	adrp	x0, Lrta_r_buf_bounds
	add	x0, x0, :lo12:Lrta_r_buf_bounds
	b	silica_rt_abort_with
	.globl	silica_rt_abort_list_index
	.p2align	2
silica_rt_abort_list_index:
	adrp	x0, Lrta_r_list_index
	add	x0, x0, :lo12:Lrta_r_list_index
	b	silica_rt_abort_with
	.globl	silica_rt_abort_arena_key
	.p2align	2
silica_rt_abort_arena_key:
	adrp	x0, Lrta_r_arena_key
	add	x0, x0, :lo12:Lrta_r_arena_key
	b	silica_rt_abort_with
	.globl	silica_rt_abort_arena_full
	.p2align	2
silica_rt_abort_arena_full:
	adrp	x0, Lrta_r_arena_full
	add	x0, x0, :lo12:Lrta_r_arena_full
	b	silica_rt_abort_with
	.globl	silica_rt_abort_arena_nomem
	.p2align	2
silica_rt_abort_arena_nomem:
	adrp	x0, Lrta_r_arena_nomem
	add	x0, x0, :lo12:Lrta_r_arena_nomem
	b	silica_rt_abort_with
	.globl	silica_rt_abort_guarded_ffi_state
	.p2align	2
silica_rt_abort_guarded_ffi_state:
	adrp	x0, Lrta_r_guarded_ffi_state
	add	x0, x0, :lo12:Lrta_r_guarded_ffi_state
	b	silica_rt_abort_with
	.globl	silica_rt_abort_ingress_full
	.p2align	2
silica_rt_abort_ingress_full:
	adrp	x0, Lrta_r_ingress_full
	add	x0, x0, :lo12:Lrta_r_ingress_full
	b	silica_rt_abort_with
	.globl	silica_rt_abort_exit_queue_full
	.p2align	2
silica_rt_abort_exit_queue_full:
	adrp	x0, Lrta_r_exit_queue_full
	add	x0, x0, :lo12:Lrta_r_exit_queue_full
	b	silica_rt_abort_with
	.globl	silica_rt_abort_stack_reserve
	.p2align	2
silica_rt_abort_stack_reserve:
	adrp	x0, Lrta_r_stack_reserve
	add	x0, x0, :lo12:Lrta_r_stack_reserve
	b	silica_rt_abort_with
"
}

fn emit_ffi_fault_runtime_asm() -> string {
    bss: string <- "	.bss
	.p2align	3
silica_rt_ffi_altstack_mem:
	.zero	65536
silica_rt_sync_fault_handlers_installed:
	.zero	4
	.globl	silica_rt_fault_pc
silica_rt_fault_pc:
	.zero	8
silica_rt_fault_dlinfo:
	.zero	48
silica_rt_fault_hexbuf:
	.zero	32
silica_rt_fault_addr:
	.zero	8
silica_rt_fault_actor:
	.zero	8
silica_rt_fault_sbase:
	.zero	8
silica_rt_fault_ssize:
	.zero	8
	.globl	silica_rt_own_image_base
silica_rt_own_image_base:
	.zero	8
silica_rt_ffi_altstack_active:
	.zero	4
silica_rt_abort_claimed:
	.zero	4
	.p2align	4
silica_rt_abort_stack:
	.zero	32768
silica_rt_abort_stack_top:
";
    text: string <- "	.text
	.globl	silica_rt_install_sync_fault_handlers
	.p2align	2
silica_rt_install_sync_fault_handlers:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
Lloh_ifh0:
	adrp	x8, silica_rt_sync_fault_handlers_installed
Lloh_ifh1:
	add	x8, x8, :lo12:silica_rt_sync_fault_handlers_installed
	ldr	w9, [x8]
	cbnz	w9, L_ifh_done
	mov	w9, #1
	str	w9, [x8]
	sub	sp, sp, #192
// Linux stack_t: ss_sp @0, ss_flags (int) @8, ss_size @16.
Lloh_as0:
	adrp	x9, silica_rt_ffi_altstack_mem
Lloh_as1:
	add	x9, x9, :lo12:silica_rt_ffi_altstack_mem
	str	x9, [sp]
	str	wzr, [sp, #8]
	mov	x9, #65536
	str	x9, [sp, #16]
	mov	x0, sp
	mov	x1, xzr
	bl	sigaltstack
Lloh_asf0:
	adrp	x9, silica_rt_ffi_altstack_active
Lloh_asf1:
	add	x9, x9, :lo12:silica_rt_ffi_altstack_active
	mov	w10, #1
	str	w10, [x9]
// Linux/glibc AArch64 struct sigaction (152 B at sp+32): sa_handler @0, sa_mask @8 (128 B),
// sa_flags @136, sa_restorer @144. Zero it, then set handler + SA_SIGINFO|SA_ONSTACK.
	add	x8, sp, #32
	mov	x9, #152
L_ifh_zero:
	str	xzr, [x8], #8
	subs	x9, x9, #8
	b.ne	L_ifh_zero
Lloh_h0:
	adrp	x8, silica_rt_sync_fault_handler
Lloh_h1:
	add	x8, x8, :lo12:silica_rt_sync_fault_handler
	str	x8, [sp, #32]
// SA_NODEFER keeps the signal deliverable while its handler runs: a fault inside the handler must reach
// silica_rt_fault_last_resort, and a synchronous fault on a blocked signal is the default action
// (status 139) instead (spec §15.4.5.5).
	mov	w9, #4
	movk	w9, #0x4800, lsl #16
	str	w9, [sp, #168]
	mov	w0, #11
	add	x1, sp, #32
	mov	x2, xzr
	bl	sigaction
	mov	w0, #7
	add	x1, sp, #32
	mov	x2, xzr
	bl	sigaction
	mov	w0, #4
	add	x1, sp, #32
	mov	x2, xzr
	bl	sigaction
	mov	w0, #8
	add	x1, sp, #32
	mov	x2, xzr
	bl	sigaction
	add	sp, sp, #192
L_ifh_done:
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
// The startup code installs the handlers before main runs (spec §15.4.5.5): the C runtime calls every
// .init_array entry before main, so a fault in main's prologue, or in anything else that runs before
// main's body, is reported like any other. The calls from spawn and from main's prologue remain and
// return at once (the installed flag).
	.section .init_array, \"aw\"
	.p2align	3
	.quad	silica_rt_install_sync_fault_handlers
	.text
	.globl	silica_rt_ffi_fault_altstack_probed
	.p2align	2
silica_rt_ffi_fault_altstack_probed:
	.cfi_startproc
Lloh_ap0:
	adrp	x8, silica_rt_ffi_altstack_active
Lloh_ap1:
	add	x8, x8, :lo12:silica_rt_ffi_altstack_active
	ldr	w0, [x8]
	ret
	.cfi_endproc
	.globl	silica_rt_ffi_trial_arena_base
	.p2align	2
silica_rt_ffi_trial_arena_base:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x29, sp
	bl	silica_rt_tls_current_actor_get
	cbz	x0, L_tab_zero
	mov	x19, x0
	bl	silica_rt_ffi_arena_ensure
	cbz	x0, L_tab_zero
	ldr	x0, [x19, #248]
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
L_tab_zero:
	mov	x0, xzr
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
	.globl	silica_rt_sync_fault_handler
	.p2align	2
silica_rt_sync_fault_handler:
	.cfi_startproc
	stp	x24, x23, [sp, #-64]!
	stp	x22, x21, [sp, #16]
	stp	x20, x19, [sp, #32]
	stp	x29, x30, [sp, #48]
	add	x29, sp, #48
	mov	x22, x0
	mov	x23, x1
	mov	x24, x2
// A fault raised while a handler runs on this thread (the handler itself, or the runtime code it calls)
// takes the last-resort path and never re-enters the decision below (spec §15.4.5.5).
	mov	x0, x24
	bl	silica_rt_fault_in_handler
	cbnz	w0, L_sfh_last_resort
// Stack growth is established first (spec §15.1.2.2): a fault at an address inside the current
// actor's reservation is growth, and only afterwards is a guarded foreign fault considered.
// Linux siginfo_t: si_addr @16.
	bl	silica_rt_tls_current_actor_get
	mov	x20, x0
	cbz	x20, Lsfh_not_stack
	ldr	x21, [x20, #272]
	cbz	x21, Lsfh_not_stack
	ldr	x19, [x23, #16]
	cmp	x19, x21
	b.lo	Lsfh_not_stack
	ldr	x9, [x20, #280]
	add	x9, x21, x9
	cmp	x19, x9
	b.hs	Lsfh_not_stack
	mov	x0, x20
	mov	x1, x19
	bl	silica_rt_stack_grow_to
	cbz	x0, L_sfh_done
	cmp	x0, #1
	b.eq	L_sfh_exhausted
	cmp	x0, #2
	b.eq	L_sfh_unrecoverable
Lsfh_not_stack:
// The report fields are process-wide, so they are recorded only once the fault is known not to be
// stack growth: an actor taking growth faults on another thread must not overwrite them while a fatal
// fault is being reported (spec §15.4.5.5).
	adrp	x8, silica_rt_fault_pc
	add	x8, x8, :lo12:silica_rt_fault_pc
	cbz	x24, Lsfh_pc_done
// Linux AArch64 ucontext_t: uc_mcontext @176 inline; sigcontext.pc @176+264 = 440. siginfo_t si_addr @16.
	ldr	x9, [x24, #440]
	str	x9, [x8]
	ldr	x9, [x23, #16]
	adrp	x8, silica_rt_fault_addr
	add	x8, x8, :lo12:silica_rt_fault_addr
	str	x9, [x8]
	bl	silica_rt_tls_current_actor_get
	adrp	x8, silica_rt_fault_actor
	add	x8, x8, :lo12:silica_rt_fault_actor
	str	x0, [x8]
	adrp	x8, silica_rt_fault_sbase
	add	x8, x8, :lo12:silica_rt_fault_sbase
	str	xzr, [x8]
	adrp	x8, silica_rt_fault_ssize
	add	x8, x8, :lo12:silica_rt_fault_ssize
	str	xzr, [x8]
	cbz	x0, Lsfh_no_actor
	ldr	x9, [x0, #272]
	adrp	x8, silica_rt_fault_sbase
	add	x8, x8, :lo12:silica_rt_fault_sbase
	str	x9, [x8]
	ldr	x9, [x0, #280]
	adrp	x8, silica_rt_fault_ssize
	add	x8, x8, :lo12:silica_rt_fault_ssize
	str	x9, [x8]
Lsfh_no_actor:
	adrp	x0, silica_rt_sync_fault_handler
	add	x0, x0, :lo12:silica_rt_sync_fault_handler
	adrp	x1, silica_rt_fault_dlinfo
	add	x1, x1, :lo12:silica_rt_fault_dlinfo
	bl	dladdr
	adrp	x1, silica_rt_fault_dlinfo
	add	x1, x1, :lo12:silica_rt_fault_dlinfo
	ldr	x2, [x1, #8]
	adrp	x3, silica_rt_own_image_base
	add	x3, x3, :lo12:silica_rt_own_image_base
	str	x2, [x3]
// No diagnostic here: a fault inside a guarded FFI region is recovered just below and
// reported as an actor failure, so printing the site first would add a line that the
// caller never sees on a healthy recovery. The unrecoverable paths below still print it.
Lsfh_pc_done:
	mov	x0, x22
	mov	x1, x23
	bl	silica_rt_ffi_guarded_fault_handler_try
	cbnz	w0, L_sfh_done
	b	L_sfh_crash
L_sfh_exhausted:
// The end of a reservation the program lowered: (:explicit, :stack_exhausted) for this actor only.
	ldr	x9, [x20, #440]
	cbz	x9, L_sfh_exhausted_thread
// A carrier actor (item N stage 1): the exit runs on the carrier's stack, reached by returning from
// this handler into silica_rt_actor_fail_current(ACB, atom) with the signal frame unwound by the
// kernel, so the carrier thread's alternate-stack state and signal mask are those of a thread
// outside a handler when the next actor on it faults. Linux AArch64 ucontext_t (X24): uc_mcontext
// (struct sigcontext) inline at +176: fault_address +0, regs[0..30] at +8 (x0 at 184, x1 at 192),
// sp at +256 (432), pc at +264 (440, what the handler reads above), pstate at 448. The handler
// returns normally; glibc's restorer (sa_restorer, set by sigaction) runs rt_sigreturn, which
// restores the signal mask (uc_sigmask, untouched) and the registers from this frame; the next
// fault on the thread is taken on its alternate stack again because SP is then outside it.
	str	x20, [x24, #184]
	adrp	x8, silica_rt_stack_exhausted_atom
	add	x8, x8, :lo12:silica_rt_stack_exhausted_atom
	ldr	x8, [x8]
	str	x8, [x24, #192]
	ldr	x11, [x9, #48]
	str	x11, [x24, #432]
	adrp	x11, silica_rt_actor_fail_current
	add	x11, x11, :lo12:silica_rt_actor_fail_current
	str	x11, [x24, #440]
	b	L_sfh_done
L_sfh_exhausted_thread:
	mov	x0, x20
	adrp	x8, silica_rt_stack_exhausted_atom
	add	x8, x8, :lo12:silica_rt_stack_exhausted_atom
	ldr	x1, [x8]
	bl	silica_rt_actor_fail_current
	b	L_sfh_crash
L_sfh_unrecoverable:
// The host refused to commit memory for a growing actor stack. That is a runtime abort, not a
// fault (spec §15.4.10.2, §15.4.5.5): status 71, reported at the instruction that touched the stack.
	adrp	x0, Lrta_r_stack_commit
	add	x0, x0, :lo12:Lrta_r_stack_commit
	mov	x1, xzr
	cbz	x24, Lsfh_unrec_pc
	ldr	x1, [x24, #440]
Lsfh_unrec_pc:
	b	silica_rt_abort_with_pc
L_sfh_crash:
// Process-fatal: the report line, then C _exit, never exit(), which would run atexit handlers and
// flush stdio from inside the signal handler (spec §15.4.5.5).
	bl	silica_rt_print_fault_site
	mov	w0, #70
	bl	_exit
L_sfh_last_resort:
	mov	x0, x23
	mov	x1, x24
	b	silica_rt_fault_last_resort
L_sfh_done:
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
	.cfi_endproc
	.globl	silica_rt_ffi_guarded_fault_handler_try
	.p2align	2
silica_rt_ffi_guarded_fault_handler_try:
	.cfi_startproc
// X0=signum, X1=siginfo*
	stp	x21, x20, [sp, #-16]!
	stp	x19, x30, [sp, #-16]!
	mov	x21, x0
	mov	x19, x1
Lloh_gk0:
	adrp	x8, silica_guarded_ffi_pthread_key
Lloh_gk1:
	add	x8, x8, :lo12:silica_guarded_ffi_pthread_key
	ldr	x0, [x8]
// The key is zero until the first guarded region creates it. Reading a thread-specific
// value for key zero does NOT fail: on Darwin it returns a live pointer from a slot the C
// library reserves for itself. Without this check a fault raised before any guarded call
// took that pointer for the per-thread guarded state, wrote the fault record over the
// library's memory, and jumped through a sigjmp_buf made of unrelated bytes, which hung
// the process inside longjmp instead of reporting the fault and exiting.
	cbz	x0, L_gft_no
	bl	pthread_getspecific
	cbz	x0, L_gft_no
	mov	x20, x0
	ldr	x9, [x20, #24]
	cbz	x9, L_gft_no
	sxtw	x9, w21
	str	x9, [x20, #32]
	ldr	x9, [x19, #16]
	str	x9, [x20, #40]
	ldr	w10, [x19, #8]
	sxtw	x10, w10
