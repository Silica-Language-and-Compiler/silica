// Inline emission for print_string(string) built-in.
// Const arg: emit write(1) with L_str_N label from string_literal_table.
// Var arg: BL L_ps_helper (strlen + write).

use atom_table;
use string_literal_pool;
use emitter_effects;
use x86_isa;
use x86_mem;

export emit_print_string_inline/4;
export is_print_string_const_arg/2;
export emit_print_string_var/3;
export emit_print_string_helper/0;
export emit_print_string_helper_stderr/0;
export emit_print_newline_inline/3;
export emit_print_newline_stderr_inline/3;
export emit_print_string_inline_stderr/4;
export emit_print_string_var_stderr/3;
export emit_newline_rodata/0;
export emit_println_string_inline/5;
export emit_println_string_var/4;


// write(2) on Linux x86-64: syscall number 1 in eax, the arguments already in X0..X2 (rdi rsi rdx).
// The kernel clobbers rax, rcx and r11; rcx and r11 are the X3 and X10 homes, so they are saved around
// the syscall the way the AArch64 site saved X8 (nothing else is touched; the number needs no register).
fn write_syscall() -> string {
    concat(x86_mem@x86_stp("X3", "X10", "[SP, #-16]!"), concat("    mov eax, 1\n    syscall\n", x86_mem@x86_ldp("X3", "X10", "[SP], #16")))
}

// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn is_print_string_const_arg(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, _table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> boolean {
    case sir_term_root_node(term).name == "main.print_string" or sir_term_root_node(term).name == "main.print_string_stderr" of {
        false -> false;
        true -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).kind of {
            0 -> sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name == "string";
            _: int64 -> false
        }
    }
}

// Emit fully inline assembly for print_string(const string).
// Precondition: sir_term_root_node(term).name == "main.print_string" and sir_term_at(term, sir_term_root_node(term).inner) is const string.
fn emit_print_string_inline(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] }) -> string {
    idx: int64 <- string_literal_pool@string_literal_value_to_index(string_literal_table, sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).value);
    label: string <- concat("L_str_", atom_table@int64_to_decimal_string(idx));
    length: int64 <- string_literal_pool@raw_byte_length(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).value);
    length_str: string <- atom_table@int64_to_decimal_string(length);
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    mov_fd: string <- x86_isa@x86_mov("X0", "#1");
    adrp_part: string <- x86_isa@x86_adr("X1", label);
    add_part: string <- x86_mem@x86_ldr("X1", "[X1, #8]");
    mov_count: string <- x86_isa@x86_mov("X2", concat("#", length_str));
    syscall_line: string <- write_syscall();
    ok_index: int64 <- atom_table@ok_atom_index(table);
    result_line: string <- x86_isa@x86_movi(dest, ok_index);
    with_comment: string <- concat(comment_line, mov_fd);
    with_adrp: string <- concat(with_comment, concat(concat(adrp_part, add_part), concat(mov_count, syscall_line)));
    with_result: string <- concat(with_adrp, result_line);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_result, concat(concat("\n", post_barrier), "\n"));
        false -> concat(with_result, "\n")
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// Emit inline for print_string when argument is variable (e.g. var or let-bound).
// X0 holds pointer to null-terminated string. Call L_ps_helper (strlen + write).
fn emit_print_string_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- x86_isa@x86_call("L_ps_helper");
    ok_index: int64 <- atom_table@ok_atom_index(table);
    mov_ret: string <- x86_isa@x86_movi(dest, ok_index);
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// L_ps_helper: X0 (rdi) = string {tag -1, data@+8, length@+16}; write(1, data, length). A bad tag traps
// (int3 = SIGTRAP, the BRK #1 of the AArch64 body). X9 r9, X10 r10 are the tag temps.
fn emit_print_string_helper() -> string {
    concat("L_ps_helper:
    mov r9, QWORD PTR [rdi]
    mov r10, -1
    cmp r9, r10
    jne L_ps_bad
    mov rsi, QWORD PTR [rdi + 8]
    mov rdx, QWORD PTR [rdi + 16]
    mov edi, 1
    mov eax, 1
    syscall
    ret
L_ps_bad:
    int3\n", println_helper_body("L_psnl_helper", 1))
}

// Stderr mirrors (fd 2) for print_string_stderr / println_stderr built-ins.

fn emit_print_string_inline_stderr(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] }) -> string {
    idx: int64 <- string_literal_pool@string_literal_value_to_index(string_literal_table, sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).value);
    label: string <- concat("L_str_", atom_table@int64_to_decimal_string(idx));
    length: int64 <- string_literal_pool@raw_byte_length(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).value);
    length_str: string <- atom_table@int64_to_decimal_string(length);
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    mov_fd: string <- x86_isa@x86_mov("X0", "#2");
    adrp_part: string <- x86_isa@x86_adr("X1", label);
    add_part: string <- x86_mem@x86_ldr("X1", "[X1, #8]");
    mov_count: string <- x86_isa@x86_mov("X2", concat("#", length_str));
    syscall_line: string <- write_syscall();
    ok_index: int64 <- atom_table@ok_atom_index(table);
    result_line: string <- x86_isa@x86_movi(dest, ok_index);
    with_comment: string <- concat(comment_line, mov_fd);
    with_adrp: string <- concat(with_comment, concat(concat(adrp_part, add_part), concat(mov_count, syscall_line)));
    with_result: string <- concat(with_adrp, result_line);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_result, concat(concat("\n", post_barrier), "\n"));
        false -> concat(with_result, "\n")
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_print_string_var_stderr(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- x86_isa@x86_call("L_ps_helper_stderr");
    ok_index: int64 <- atom_table@ok_atom_index(table);
    mov_ret: string <- x86_isa@x86_movi(dest, ok_index);
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_print_string_helper_stderr() -> string {
    concat("L_ps_helper_stderr:
    mov r9, QWORD PTR [rdi]
    mov r10, -1
    cmp r9, r10
    jne L_ps_se_bad
    mov rsi, QWORD PTR [rdi + 8]
    mov rdx, QWORD PTR [rdi + 16]
    mov edi, 2
    mov eax, 1
    syscall
    ret
L_ps_se_bad:
    int3\n", println_helper_body("L_psnl_helper_stderr", 2))
}

// println(s) is ONE system call: writev(fd, [s bytes, "\n"], 2). Two writes (the text, then the
// newline) let another actor's write land between them, gluing lines ("L seen 5N seen 5\n\n").
// On entry X1 (rsi) = bytes, X2 (rdx) = length. X0..X2 (rdi rsi rdx) and rax change; rcx and r11
// (the X3 and X10 homes the kernel clobbers) are saved around the syscall as write_syscall does. The
// two iovecs and the newline byte live in a 48-byte block below rsp. Linux x86-64 writev is syscall 20.
fn writev_line_body(fd: int64) -> string {
    concat(concat("    sub rsp, 48\n    mov QWORD PTR [rsp], rsi\n    mov QWORD PTR [rsp + 8], rdx\n    mov QWORD PTR [rsp + 32], 10\n    lea rax, [rsp + 32]\n    mov QWORD PTR [rsp + 16], rax\n    mov QWORD PTR [rsp + 24], 1\n    mov edi, ", atom_table@int64_to_decimal_string(fd)), "\n    mov rsi, rsp\n    mov edx, 2\n    push rcx\n    push r11\n    mov eax, 20\n    syscall\n    pop r11\n    pop rcx\n    add rsp, 48\n")
}

// L_psnl_helper / L_psnl_helper_stderr: X0 (rdi) = string {tag -1, data@+8, length@+16}; one writev
// of the bytes and the newline. Emitted with L_ps_helper (the same use condition: a println whose
// argument is not a literal). A bad tag traps (int3).
fn println_helper_body(label: string, fd: int64) -> string {
    concat(concat(concat(label, ":\n    mov r9, QWORD PTR [rdi]\n    mov r10, -1\n    cmp r9, r10\n    jne "), concat(label, "_bad\n    mov rsi, QWORD PTR [rdi + 8]\n    mov rdx, QWORD PTR [rdi + 16]\n")), concat(writev_line_body(fd), concat(concat("    ret\n", label), "_bad:\n    int3")))
}

// println(const string) / println_stderr(const string): the literal and the newline in one writev.
fn emit_println_string_inline(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] }, fd: int64) -> string {
    idx: int64 <- string_literal_pool@string_literal_value_to_index(string_literal_table, sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).value);
    label: string <- concat("L_str_", atom_table@int64_to_decimal_string(idx));
    length: int64 <- string_literal_pool@raw_byte_length(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).value);
    length_str: string <- atom_table@int64_to_decimal_string(length);
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    adrp_part: string <- x86_isa@x86_adr("X1", label);
    add_part: string <- x86_mem@x86_ldr("X1", "[X1, #8]");
    mov_count: string <- x86_isa@x86_mov("X2", concat("#", length_str));
    ok_index: int64 <- atom_table@ok_atom_index(table);
    result_line: string <- x86_isa@x86_movi(dest, ok_index);
    with_adrp: string <- concat(comment_line, concat(concat(adrp_part, add_part), concat(mov_count, writev_line_body(fd))));
    with_result: string <- concat(with_adrp, result_line);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_result, concat(concat("\n", post_barrier), "\n"));
        false -> concat(with_result, "\n")
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// println(s) / println_stderr(s) with a non-literal s (string object in X0): call L_psnl_helper(_stderr).
fn emit_println_string_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, fd: int64) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- case fd == 2 of {
        true -> x86_isa@x86_call("L_psnl_helper_stderr");
        false -> x86_isa@x86_call("L_psnl_helper")
    };
    ok_index: int64 <- atom_table@ok_atom_index(table);
    mov_ret: string <- x86_isa@x86_movi(dest, ok_index);
    with_ret: string <- concat(concat(comment_line, bl_line), mov_ret);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// Emit write(1, L_newline, 1) for println. Uses dedicated L_newline label, never string literal table.
fn emit_print_newline_inline(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    mov_fd: string <- x86_isa@x86_mov("X0", "#1");
    adrp_part: string <- x86_isa@x86_adr("X1", "L_newline");
    mov_count: string <- x86_isa@x86_mov("X2", "#1");
    syscall_line: string <- write_syscall();
    ok_index: int64 <- atom_table@ok_atom_index(table);
    result_line: string <- x86_isa@x86_movi(dest, ok_index);
    with_comment: string <- concat(comment_line, mov_fd);
    with_adrp: string <- concat(with_comment, concat(adrp_part, concat(mov_count, syscall_line)));
    with_result: string <- concat(with_adrp, result_line);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_result, concat(concat("\n", post_barrier), "\n"));
        false -> concat(with_result, "\n")
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// Emit write(2, L_newline, 1) for println_stderr.
fn emit_print_newline_stderr_inline(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    mov_fd: string <- x86_isa@x86_mov("X0", "#2");
    adrp_part: string <- x86_isa@x86_adr("X1", "L_newline");
    mov_count: string <- x86_isa@x86_mov("X2", "#1");
    syscall_line: string <- write_syscall();
    ok_index: int64 <- atom_table@ok_atom_index(table);
    result_line: string <- x86_isa@x86_movi(dest, ok_index);
    with_comment: string <- concat(comment_line, mov_fd);
    with_adrp: string <- concat(with_comment, concat(adrp_part, concat(mov_count, syscall_line)));
    with_result: string <- concat(with_adrp, result_line);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_result, concat(concat("\n", post_barrier), "\n"));
        false -> concat(with_result, "\n")
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_newline_rodata() -> string {
    "L_newline:\n    .byte 10\n"
}
