// Hand-written x86-64 (Intel syntax) translation of the linux_aarch64 helper of the same name.
// Internal convention: arguments X0.. in rdi rsi rdx rcx r8 r9, result X0 in rdi (W0 in edi); a
// helper may clobber any register except rbp/rsp. Raw syscalls (mmap 9, munmap 11) clobber rcx and
// r11; the bump allocators preserve every register except rdi (their result), so their callers keep
// live values in any register across the call, as the AArch64 code kept them in X8/X11 and X19-X23.

// String concatenation helper: non-MTE fallback for Apple Silicon (macOS ARM64).
// Per silica-specification §21.3: "If MTE is not available... runtime falls back to software-based
// bounds checking... Memory safety is maintained through compiler-generated bounds checks."
//
// L_concat_helper: X0 = rdi = ptr1, X1 = rsi = ptr2 (SilicaString descriptors). Returns X0 = rdi = ptr to concatenated
// string. Empty operands return the other pointer (no allocation). Length of the most recent
// result is cached so growing concat(acc, ch) in strip_spaces is O(1) strlen. Longer results
// bump-allocate from 4MB mmap chunks. mmap-per-call used to SIGKILL type checking of
// wbt_map.silica (75GB physical footprint from char-by-char strip_spaces).
//
// The arena is one per compilation unit and shared by every actor thread, so the bump runs under
// L_sc_lock (book defect D12, trials/actors_addition/string_concat_cast_stress).
//
// Isolated module for vigorous testing. Target: Linux x86-64 (register map: X19-X23 -> rbx r12 r13
// r14 r15, X9/X10 -> r10/r11, X11 -> rax, W12 -> ecx; L_sc_arena_mark answers in rax/r11 for X16/X17).

export emit_string_concat_helper/0;

fn sc_helper_lens() -> string {
    "L_concat_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    sub rsp, 8\n    mov rbx, rdi\n    mov r12, rsi\n    mov r10, QWORD PTR [rbx]\n    not r10\n    cmp r10, 1\n    ja L_sc_bad\n    mov r13, QWORD PTR [rbx + 16]\n    mov r10, QWORD PTR [r12]\n    not r10\n    cmp r10, 1\n    ja L_sc_bad\n    mov r14, QWORD PTR [r12 + 16]\n    test r13, r13\n    jz L_sc_ret2\n    test r14, r14\n    jz L_sc_ret1\n    lea rdi, [r13 + r14]\n    add rdi, 25\n    call L_sc_bump_alloc\n    test rdi, rdi\n    jz L_sc_ret\n    mov r15, rdi\n    mov r10, -1\n    mov QWORD PTR [r15], r10\n    lea r10, [r15 + 24]\n    mov QWORD PTR [r15 + 8], r10\n    lea r11, [r13 + r14]\n    mov QWORD PTR [r15 + 16], r11\n    mov r11, QWORD PTR [rbx + 8]\n    mov rax, r13\n"
}

fn sc_helper_copy() -> string {
    "L_sc_cp1:\n    test rax, rax\n    jz L_sc_cp1_done\n    movzx ecx, BYTE PTR [r11]\n    mov BYTE PTR [r10], cl\n    add r10, 1\n    add r11, 1\n    sub rax, 1\n    jmp L_sc_cp1\nL_sc_cp1_done:\n    mov r11, QWORD PTR [r12 + 8]\n    mov rax, r14\nL_sc_cp2:\n    test rax, rax\n    jz L_sc_cp2_done\n    movzx ecx, BYTE PTR [r11]\n    mov BYTE PTR [r10], cl\n    add r10, 1\n    add r11, 1\n    sub rax, 1\n    jmp L_sc_cp2\nL_sc_cp2_done:\n    mov BYTE PTR [r10], 0\n    mov rdi, r15\n    jmp L_sc_ret\nL_sc_ret2:\n    mov rdi, r12\n    jmp L_sc_ret\nL_sc_ret1:\n    mov rdi, rbx\nL_sc_ret:\n    add rsp, 8\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\nL_sc_bad:\n    ud2\n"
}

fn sc_helper_bump() -> string {
    concat(concat("L_sc_bump_alloc:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push rsi\n    push rdx\n    push rcx\n    push r8\n    push r9\n    push r10\n    push r11\n    push rax\n    sub rsp, 8\n    add rdi, 7\n    shr rdi, 3\n    mov rbx, rdi\n    shl rbx, 3\nL_sc_lk_bump_spin:\n    mov edx, 1\n    xchg DWORD PTR [rip + L_sc_lock], edx\n    test edx, edx\n    jz L_sc_lk_bump_held\n    pause\n    jmp L_sc_lk_bump_spin\nL_sc_lk_bump_held:\n    lea r12, [rip + L_sc_arena_ptr]\n    mov r13, QWORD PTR [r12]\n    test r13, r13\n    jz L_sc_bump_new\n    lea rsi, [rip + L_sc_arena_end]\n    mov rdx, QWORD PTR [rsi]\n    lea rcx, [r13 + rbx]\n    cmp rcx, rdx\n    ja L_sc_bump_new\n    mov QWORD PTR [r12], rcx\n    mov rdi, r13\n    jmp L_sc_bump_out\nL_sc_bump_new:\n    lea rsi, [rbx + 16]\n    mov edx, 0x400000\n    cmp rsi, rdx\n    cmovbe rsi, rdx\n    mov r13, rsi\n    xor edi, edi\n    mov edx, 3\n    mov r10d, 0x22\n    mov r8, -1\n    xor r9d, r9d\n    mov eax, 9\n    syscall\n    mov rdi, rax\n    test rdi, rdi\n    js L_sc_bump_fail\n    lea rdx, [rip + L_sc_arena_head]\n    mov rcx, QWORD PTR [rdx]\n    mov QWORD PTR [rdi], rcx\n    mov QWORD PTR [rdi + 8], r13\n    mov QWORD PTR [rdx], rdi\n    lea rsi, [rdi + 16]\n    lea rcx, [rsi + rbx]\n    mov QWORD PTR [r12], rcx\n    lea rdx, [rip + L_sc_arena_end]\n    lea rcx, [rdi + r13]\n    mov QWORD PTR [rdx], rcx\n    mov rdi, rsi\n    jmp L_sc_bump_out\nL_sc_bump_fail:\n    xor edi, edi\nL_sc_bump_out:\n    mov DWORD PTR [rip + L_sc_lock], 0\n    add rsp, 8\n    pop rax\n    pop r11\n    pop r10\n    pop r9\n    pop r8\n    pop rcx\n    pop rdx\n    pop rsi\n    pop r13\n    pop r12\n", "    pop rbx\n    pop rbp\n    ret\nL_sc_arena_mark:\n    mov rax, QWORD PTR [rip + L_sc_arena_ptr]\n    mov r11, QWORD PTR [rip + L_sc_arena_head]\n    ret\nL_sc_arena_release_to:\n    push rbp\n    mov rbp, rsp\n    push rdi\n    push rsi\n    push rdx\n    push rcx\n    push rbx\n    push r12\n    mov rbx, rax\n    mov r12, r11\n    lea rcx, [rip + L_sc_arena_head]\n    mov rdx, QWORD PTR [rcx]\nL_sc_rt_loop:\n    cmp rdx, r12\n    je L_sc_rt_done\n    test rdx, rdx\n    jz L_sc_rt_done\n    mov rdi, QWORD PTR [rdx]\n    mov QWORD PTR [rcx], rdi\n    mov rsi, QWORD PTR [rdx + 8]\n    mov rdi, rdx\n    mov eax, 11\n    syscall\n    lea rcx, [rip + L_sc_arena_head]\n    mov rdx, QWORD PTR [rcx]\n    jmp L_sc_rt_loop\nL_sc_rt_done:\n    mov QWORD PTR [rip + L_sc_arena_ptr], rbx\n    test r12, r12\n    jz L_sc_rt_noend\n    mov rsi, QWORD PTR [r12 + 8]\n    add rsi, r12\n    mov QWORD PTR [rip + L_sc_arena_end], rsi\n    jmp L_sc_rt_caches\nL_sc_rt_noend:\n    mov QWORD PTR [rip + L_sc_arena_end], 0\nL_sc_rt_caches:\n    mov QWORD PTR [rip + L_sc_len_key], 0\n    mov QWORD PTR [rip + L_sc_len_val], 0\n    pop r12\n    pop rbx\n    pop rcx\n    pop rdx\n    pop rsi\n    pop rdi\n    pop rbp\n    ret\nL_sc_arena_release:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    sub rsp, 8\n    lea r12, [rip + L_sc_arena_head]\n    mov rbx, QWORD PTR [r12]\nL_sc_rel_loop:\n    test rbx, rbx\n    jz L_sc_rel_done\n"), "    mov r13, QWORD PTR [rbx]\n    mov rsi, QWORD PTR [rbx + 8]\n    mov rdi, rbx\n    mov eax, 11\n    syscall\n    mov rbx, r13\n    jmp L_sc_rel_loop\nL_sc_rel_done:\n    mov QWORD PTR [r12], 0\n    mov QWORD PTR [rip + L_sc_arena_ptr], 0\n    mov QWORD PTR [rip + L_sc_arena_end], 0\n    mov QWORD PTR [rip + L_sc_len_key], 0\n    mov QWORD PTR [rip + L_sc_len_val], 0\n    add rsp, 8\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\n    .bss\n    .p2align 3\nL_sc_len_key:\n    .space 8\nL_sc_len_val:\n    .space 8\nL_sc_lock:\n    .space 8\nL_sc_arena_ptr:\n    .space 8\nL_sc_arena_end:\n    .space 8\nL_sc_arena_head:\n    .space 8\n    .text\n    .p2align 2")
}

fn emit_string_concat_helper() -> string {
    concat(concat(sc_helper_lens(), sc_helper_copy()), sc_helper_bump())
}
