// Hand-written x86-64 (Intel syntax) translation of the linux_aarch64 helper of the same name.
// Internal convention: arguments X0.. in rdi rsi rdx rcx r8 r9, result X0 in rdi (W0 in edi).
//
// L_concat_helper: X0 = rdi = ptr1, X1 = rsi = ptr2 (SilicaString descriptors), rax = the result
// block (L_concat_size; any value when an operand is empty). Returns X0 = rdi = ptr to the
// concatenated string. Empty operands return the other pointer (no allocation). The block belongs
// to the caller's frame (chunk 15 phase 2), so a new string can land on an address an older, dead
// string had: L_str_forget drops that address from the substring helper's caches before the header
// is written. rbx and r12-r15 are kept (pushed); r10, r11, rcx and rax change.
//
// Isolated module for vigorous testing. Target: Linux x86-64 (register map: X19-X23 -> rbx r12 r13
// r14 r15, X9/X10 -> r10/r11, X11 -> rax, W12 -> ecx).

export emit_string_concat_helper/0;

fn sc_helper_lens() -> string {
    "L_concat_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    sub rsp, 8\n    mov rbx, rdi\n    mov r12, rsi\n    mov r15, rax\n    mov r10, QWORD PTR [rbx]\n    not r10\n    cmp r10, 1\n    ja L_sc_bad\n    mov r13, QWORD PTR [rbx + 16]\n    mov r10, QWORD PTR [r12]\n    not r10\n    cmp r10, 1\n    ja L_sc_bad\n    mov r14, QWORD PTR [r12 + 16]\n    test r13, r13\n    jz L_sc_ret2\n    test r14, r14\n    jz L_sc_ret1\n    mov r10, r15\n    call L_str_forget\n    mov r10, -1\n    mov QWORD PTR [r15], r10\n    lea r10, [r15 + 24]\n    mov QWORD PTR [r15 + 8], r10\n    lea r11, [r13 + r14]\n    mov QWORD PTR [r15 + 16], r11\n    mov r11, QWORD PTR [rbx + 8]\n    mov rax, r13\n"
}

fn sc_helper_copy() -> string {
    "L_sc_cp1:\n    test rax, rax\n    jz L_sc_cp1_done\n    movzx ecx, BYTE PTR [r11]\n    mov BYTE PTR [r10], cl\n    add r10, 1\n    add r11, 1\n    sub rax, 1\n    jmp L_sc_cp1\nL_sc_cp1_done:\n    mov r11, QWORD PTR [r12 + 8]\n    mov rax, r14\nL_sc_cp2:\n    test rax, rax\n    jz L_sc_cp2_done\n    movzx ecx, BYTE PTR [r11]\n    mov BYTE PTR [r10], cl\n    add r10, 1\n    add r11, 1\n    sub rax, 1\n    jmp L_sc_cp2\nL_sc_cp2_done:\n    mov BYTE PTR [r10], 0\n    mov rdi, r15\n    jmp L_sc_ret\nL_sc_ret2:\n    mov rdi, r12\n    jmp L_sc_ret\nL_sc_ret1:\n    mov rdi, rbx\nL_sc_ret:\n    add rsp, 8\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\nL_sc_bad:\n    ud2\n"
}

// L_concat_size(rdi = a, rsi = b) -> rax = the bytes of the result block (24-byte header, both byte
// runs, the NUL, rounded to 16), or 0 when either operand is empty and L_concat_helper returns the
// other. Only rax and the flags change.
fn sc_helper_size() -> string {
    "L_concat_size:\n    mov rax, QWORD PTR [rdi + 16]\n    test rax, rax\n    jz 1f\n    cmp QWORD PTR [rsi + 16], 0\n    je 2f\n    add rax, QWORD PTR [rsi + 16]\n    add rax, 40\n    and rax, -16\n1:\n    ret\n2:\n    xor eax, eax\n    ret\n"
}

// Chunk 15 phase 2 (design §3.7): the result is built in a block of the CALLER's frame. The emitted
// sequence is L_concat_size, L_dyn_alloc of that many bytes when it is not 0, then L_concat_helper with
// the block in rax; the process-wide bump arena, its lock and its mark/release are gone.
fn emit_string_concat_helper() -> string {
    concat(sc_helper_size(), concat(sc_helper_lens(), sc_helper_copy()))
}
