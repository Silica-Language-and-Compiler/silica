// Term dispatcher. Kind modules take term_to_asm_opt_bound as emit_child (no capture).
// Case/call/prim/let/compound are open-recursive kind modules.

use atom_table;
use var;
use term_reg_spill;
use string_parse;
use let_dispatcher;
use term_emit_const;
use term_emit_var;
use term_emit_kind_let;
use term_emit_kind_compound;
use term_emit_kind_case;
use term_emit_kind_call;
use term_emit_kind_prim;
use term_sir_helpers;
use x86_isa;
use x86_mem;

export emit_function_tail_user_call_root/6;
export emit_function_non_tail_user_call_root/7;
export term_to_asm/3;
export term_to_asm_debug/4;
export term_to_asm_debug_with_outer/5;

// Emit AArch64 assembly for a SIR term. dest is the virtual register for the result.
// Tables: int64, int32, int16, int8 for print_X const label lookup; pools.literal_table for large int64 const; pools.float64_literal_table for float64 const; pools.string_literal_table for string const
fn term_to_asm(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }) -> string {
    term_to_asm_opt_bound(term, dest, pools, { bound_name: "", bound_reg: "", outer_reg: "", debug: false })
}

// Debug variant: when debug is true, prints branch/register info for let and var cases

// Debug variant: when debug is true, prints branch/register info for let and var cases
fn term_to_asm_debug(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, debug: boolean) -> string {
    term_to_asm_opt_bound_debug(term, dest, pools, { bound_name: "", bound_reg: "", outer_reg: "", debug: debug })
}

// Variant with initial outer_reg (for function param bindings: %x=X0, %y=X1, etc.)

// Variant with initial outer_reg (for function param bindings: %x=X0, %y=X1, etc.)
fn term_to_asm_debug_with_outer(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, outer_reg: string, debug: boolean) -> string {
    term_to_asm_opt_bound_debug(term, dest, pools, { bound_name: "", bound_reg: "", outer_reg: outer_reg, debug: debug })
}

// `and` / `or` must short-circuit: the spec stops `and` at the first false and `or` at the first
// true. Evaluating both operands is observably wrong, not merely slower, because the codebase guards
// unsafe accesses with exactly this idiom, e.g. constraint_runner:has_reserved_keyword_binding
//   after_name.is_nil == false and token_starts_with_colon(after_name.head.token)
// where running the right operand on an empty list dereferences a null data pointer.
//
// Once the left operand settles the result, the answer IS the right operand: with left true,
// `left and right` == right, and with left false, `left or right` == right. So the branch can skip
// straight over the right operand and leave dest holding the left value. Dest often aliases a live
// parameter (X0); left's CSET dest would otherwise make the right operand read the bool as that
// param. Spill the X alias before left, restore only if right runs, release on both paths.
//
// value carries "o<source offset>" from the SIR generator (stamp_short_circuit_id) solely to name
// the label. Without it there is no unique label to emit, so those terms take the eager path rather
// than risk colliding labels; same for a dest that is not a plain GPR, which CBZ/CBNZ require.
fn is_short_circuit_bool_op(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    term_sir_helpers@sir_term_root_node(term).kind == 6 and (term_sir_helpers@sir_term_root_node(term).name == "and" or term_sir_helpers@sir_term_root_node(term).name == "or") and term_sir_helpers@sir_term_root_node(term).type_name == "bool" and length_bytes(term_sir_helpers@sir_term_root_node(term).value) > 0
}

fn short_circuit_dest_is_gpr(dest: string) -> boolean {
    (substring(dest, 0, 1) == "X" or substring(dest, 0, 1) == "W") and length_bytes(dest) <= 3
}

fn short_circuit_x_dest(dest: string) -> string {
    concat("X", substring(dest, 1, length_bytes(dest)))
}

// The short-circuit save (STR Xd, [SP, #-16]!) keeps SP 16 bytes lower for the
// whole of both operands, and it has to: the left compare's CSET overwrites dest,
// which can be a live parameter (see trials/compiler_addition/and_param_reuse --
// without the spill `k <= 65535` becomes `1 <= 65535`). A single scratch register
// cannot replace it either, because nested and/or chains need a stack.
//
// Aggregate slots are addressed off X29 (fixed-frame regions), so SP movement
// under a short circuit no longer affects them. Historically this needed an
// and/or operand is 16 bytes off: silently wrong when an integer is read, and a
// fault when a string is, because the loaded descriptor pointer is garbage.

fn sc_bound_with_slot(bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, slot: string) -> { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean } {
    // Record the slot so next_frame_spill_slot hands a nested short circuit a
    // deeper one. SP is untouched, so no displacement correction is needed at all.
    { bound_name: bound.bound_name,
      bound_reg: bound.bound_reg,
      outer_reg: concat(bound.outer_reg, concat("|_sc=", slot)),
      debug: bound.debug }
}


// The left operand's CSET overwrites dest, which can be a live parameter (see
// trials/compiler_addition/and_param_reuse), so the incoming value must be saved
// across both operands. It is saved into a FRAME SLOT rather than pushed, so SP
// does not move: aggregate slot references are frozen as [SP, #k] text at bind
// time, and any SP movement between bind and read silently mis-addresses them --
// a wrong value for an integer field, a fault for a string descriptor.
// Spill slots sit below the aggregate region area, so a function with large
// aggregates can push the slot deep into the frame (phase_e_nested_declarative_supervisor_child
// reached [X29, #-3376]). On this target a frame slot [X29, #-N] of any depth is addressed by
// x86_mem directly, so no far-slot address materialization is needed.
fn sc_slot_access(op: string, reg: string, slot: string) -> string {
    case op == "STR" of {
        true -> x86_mem@x86_str(reg, slot);
        false -> x86_mem@x86_ldr(reg, slot)
    }
}

fn short_circuit_save_dest_at(dest: string, slot: string) -> string {
    sc_slot_access("STR", short_circuit_x_dest(dest), slot)
}

fn short_circuit_restore_dest_at(dest: string, slot: string) -> string {
    sc_slot_access("LDR", short_circuit_x_dest(dest), slot)
}

fn short_circuit_release_dest() -> string {
    ""
}

fn short_circuit_skip_asm(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, done_l: string) -> string {
    case term_sir_helpers@sir_term_root_node(term).name == "and" of {
        true -> x86_isa@x86_cbz(dest, done_l);
        false -> x86_isa@x86_cbnz(dest, done_l)
    }
}

fn short_circuit_done_label(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    concat(concat("L_sc_", term_sir_helpers@sir_term_root_node(term).value), "_done")
}

fn term_to_asm_opt_bound(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string {
    case is_short_circuit_bool_op(term) and short_circuit_dest_is_gpr(dest) of {
        true -> {
            sc_slot: string <- term_reg_spill@next_frame_spill_slot(bound.outer_reg);
                concat(concat(concat(concat(concat(short_circuit_save_dest_at(dest, sc_slot), term_to_asm_opt_bound(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), dest, pools, sc_bound_with_slot(bound, sc_slot))), "\n"), short_circuit_skip_asm(term, dest, short_circuit_done_label(term))), concat(concat(short_circuit_restore_dest_at(dest, sc_slot), term_to_asm_opt_bound(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), dest, pools, sc_bound_with_slot(bound, sc_slot))), "\n")), concat(concat(short_circuit_done_label(term), ":\n"), short_circuit_release_dest()))
        };
        false -> case term_sir_helpers@sir_term_root_node(term).kind - 3 == 0 of {
        true -> term_emit_kind_case@emit_case_expression(term, dest, { table: pools.table, literal_table: pools.literal_table, float64_literal_table: pools.float64_literal_table, float32_literal_table: pools.float32_literal_table, string_literal_table: pools.string_literal_table }, bound, pools, term_to_asm_opt_bound);
        false -> case term_sir_helpers@sir_term_root_node(term).kind + 1 < 2 of {
            true -> term_emit_const@emit_const_term(term, dest, { table: pools.table, literal_table: pools.literal_table, float64_literal_table: pools.float64_literal_table, float32_literal_table: pools.float32_literal_table, string_literal_table: pools.string_literal_table }, bound.outer_reg);
            false -> case term_sir_helpers@sir_term_root_node(term).kind of {
                1 -> term_emit_var@emit_var_term(term, dest, { table: pools.table, literal_table: pools.literal_table, float64_literal_table: pools.float64_literal_table, float32_literal_table: pools.float32_literal_table, string_literal_table: pools.string_literal_table }, bound);
                2 -> term_emit_kind_let@emit_kind_let(term, dest, bound, pools, term_to_asm_opt_bound);
                4 -> term_emit_kind_prim@emit_kind_prim(term, dest, pools, bound, term_to_asm_opt_bound);
                5 -> term_emit_kind_call@emit_generic_user_call_asm_inner(term, dest, bound, pools, term_to_asm_opt_bound, { use_tail: true, fn_effects_for_tail: "[]", blr_effect_value_override: "", line_before_call_asm: "" });
                6 -> term_emit_kind_compound@emit_kind_compound(term, dest, bound, pools.table, pools, term_to_asm_opt_bound);
                _: int64 -> concat("    // unsupported term kind (dummy k)", "?")
            }
        }
    }
    }
}

// Debug variant: prints bound.bound_name, bound.bound_reg, term structure for let and var at each recursion
// When bound.debug and let: traces rhs_reg (from compute_rhs_reg_top_level or compute_rhs_reg_in_let)

// Debug variant: prints bound.bound_name, bound.bound_reg, term structure for let and var at each recursion
// When bound.debug and let: traces rhs_reg (from compute_rhs_reg_top_level or compute_rhs_reg_in_let)
fn term_to_asm_opt_bound_debug(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string {
    sequence proc[DeviceIO]
        rhs_reg_trace: string <- case bound.debug and term_sir_helpers@sir_term_root_node(term).kind == 2 of {
            true -> {
                rhs_reg: string <- case length_bytes(bound.bound_name) > 0 and length_bytes(bound.bound_reg) > 0 of {
                    true -> let_dispatcher@compute_rhs_reg_in_let(term, dest, bound.bound_name, bound.bound_reg, bound.outer_reg);
                    false -> let_dispatcher@compute_rhs_reg_top_level(term, bound.bound_reg, dest)
                };
                branch: string <- case length_bytes(bound.bound_name) > 0 and length_bytes(bound.bound_reg) > 0 of { true -> "in_let"; false -> "top_level" };
                p1: string <- concat("  [TRACE let] rhs_reg=", rhs_reg);
                p2: string <- concat(p1, " branch=");
                p3: string <- concat(p2, branch);
                p4: string <- concat(p3, " bound.bound_name=");
                p5: string <- concat(p4, bound.bound_name);
                p6: string <- concat(p5, " term_sir_helpers@sir_term_root_node(term).name=");
                p7: string <- concat(p6, term_sir_helpers@sir_term_root_node(term).name);
                p8: string <- concat(p7, " bound.bound_reg=");
                p9: string <- concat(p8, bound.bound_reg);
                p10: string <- concat(p9, " term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind=");
                kind_str: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0 of { true -> "0(const)"; false -> "non-0" };
                concat(p10, kind_str)
            };
            false -> ""
        };
        _: int64 <- case length_bytes(rhs_reg_trace) > 0 of {
            true -> { println(rhs_reg_trace); 0 };
            false -> 0
        };
        msg: string <- case length_bytes(rhs_reg_trace) == 0 and bound.debug and term_sir_helpers@sir_term_root_node(term).kind == 2 of {
            true -> {
                p1: string <- concat("  [EMITTER let] bound.bound_name=", bound.bound_name);
                p2: string <- concat(p1, " bound.bound_reg=");
                p3: string <- concat(p2, bound.bound_reg);
                concat(p3, concat(" term_sir_helpers@sir_term_root_node(term).name=", term_sir_helpers@sir_term_root_node(term).name))
            };
            false -> case bound.debug and term_sir_helpers@sir_term_root_node(term).kind == 1 of {
                true -> {
                    v1: string <- concat("  [EMITTER var] term_sir_helpers@sir_term_root_node(term).name=", term_sir_helpers@sir_term_root_node(term).name);
                    v2: string <- concat(v1, " dest=");
                    v3: string <- concat(v2, dest);
                    v4: string <- concat(v3, " bound.bound_name=");
                    v5: string <- concat(v4, bound.bound_name);
                    v6: string <- concat(v5, " bound.bound_reg=");
                    v7: string <- concat(v6, bound.bound_reg);
                    concat(v7, concat(" bound.outer_reg=", bound.outer_reg))
                };
                false -> ""
            }
        };
        _: int64 <- case length_bytes(msg) > 0 of {
            true -> { println(msg); 0 };
            false -> 0
        };
        prim_msg: string <- case bound.debug and term_sir_helpers@sir_term_root_node(term).kind == 6 of {
            true -> {
                p1: string <- concat("  [TRACE prim] ", term_sir_helpers@sir_term_root_node(term).name);
                p2: string <- concat(p1, " dest=");
                p3: string <- concat(p2, dest);
                p4: string <- concat(p3, " bound.bound_name=");
                p5: string <- concat(p4, bound.bound_name);
                p6: string <- concat(p5, " bound.bound_reg=");
                p7: string <- concat(p6, bound.bound_reg);
                left_is_prim: boolean <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6;
                right_is_prim: boolean <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6;
                bound_empty: boolean <- length_bytes(bound.bound_name) == 0;
                sub_branch: string <- case left_is_prim of {
                    true -> case right_is_prim of { true -> "both_prims"; false -> "left_prim_right_var" };
                    false -> case right_is_prim of { true -> "left_var_right_prim"; false -> "both_vars" }
                };
                top_or_let: string <- case bound_empty of { true -> "top"; false -> "in_let" };
                p8: string <- concat(p7, " branch=");
                p9: string <- concat(p8, top_or_let);
                p10: string <- concat(p9, " sub=");
                p11: string <- concat(p10, sub_branch);
                p12: string <- concat(p11, " Lkind=");
                lk: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name; false -> "prim" };
                p13: string <- concat(p12, lk);
                p14: string <- concat(p13, " Rkind=");
                rk: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 1 of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name; false -> "prim" };
                concat(p14, rk)
            };
            false -> ""
        };
        _: int64 <- case length_bytes(prim_msg) > 0 of {
            true -> { println(prim_msg); 0 };
            false -> 0
        };
        const_msg: string <- case bound.debug and term_sir_helpers@sir_term_root_node(term).kind == 0 of {
            true -> {
                p1: string <- concat("  [TRACE const] dest=", dest);
                p2: string <- concat(p1, " value=");
                concat(p2, term_sir_helpers@sir_term_root_node(term).value)
            };
            false -> ""
        };
        _: int64 <- case length_bytes(const_msg) > 0 of {
            true -> { println(const_msg); 0 };
            false -> 0
        };
        result: string <- term_to_asm_opt_bound(term, dest, pools, bound)
    produces
        pure result
    end
}

fn emit_function_tail_user_call_root(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, outer_reg: string, fn_effects: string, debug: boolean) -> string {
    term_emit_kind_call@emit_function_tail_user_call_root(term, dest, { bound_name: "", bound_reg: "", outer_reg: outer_reg, debug: debug }, fn_effects, pools, term_to_asm_opt_bound)
}

fn emit_function_non_tail_user_call_root(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, outer_reg: string, fn_effects: string, debug: boolean, line_before_call_asm: string) -> string {
    term_emit_kind_call@emit_function_non_tail_user_call_root(term, dest, { bound_name: "", bound_reg: "", outer_reg: outer_reg, debug: debug }, fn_effects, line_before_call_asm, pools, term_to_asm_opt_bound)
}
