// Per-actor FFI arena (Phase 12), Linux x86-64. ACB fields at +248 base, +256 end, +264 bump (item I).
// Routines take X0 in rdi and answer in rdi; mmap/mprotect/munmap results arrive in rax;
// X19/X20 live in frame slots [rbp-8]/[rbp-16].

export emit_ffi_arena_runtime_asm/0;

fn emit_ffi_arena_runtime_asm() -> string {
    "	.text
	.globl	silica_rt_ffi_arena_ensure
	.p2align	4
silica_rt_ffi_arena_ensure:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 248]
	test	rax, rax
	jnz	L_arena_ensure_done
	xor	edi, edi
# The arena is 256 KB followed by one inaccessible 16 KB guard page. Without the guard,
# whether a write just past the arena faults depended on whether the kernel happened to
# place another mapping directly after it; under a loaded trial run on the Pi it did, and
# the arena-bounds fault vanished. The guard is not part of the arena: [ACB+360] still
# marks the arena end, so the guard reads as past-the-end to the fault handler.
	mov	esi, 278528
	mov	edx, 3
	mov	ecx, 34
	mov	r8, -1
	xor	r9d, r9d
	call	mmap
	cmp	rax, -1
	je	L_arena_ensure_fail
	test	rax, rax
	jz	L_arena_ensure_fail
	mov	QWORD PTR [rbp - 16], rax
	lea	r10, [rax + 262144]
	mov	QWORD PTR [rbp - 24], r10
	mov	rdi, r10
	mov	esi, 16384
	xor	edx, edx
	call	mprotect
	mov	rax, QWORD PTR [rbp - 16]
	mov	r10, QWORD PTR [rbp - 24]
	mov	rdi, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rdi + 248], rax
	mov	QWORD PTR [rdi + 256], r10
	mov	QWORD PTR [rdi + 264], rax
L_arena_ensure_done:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
L_arena_ensure_fail:
	xor	edi, edi
	leave
	ret
	.globl	silica_rt_ffi_arena_bump
	.p2align	4
silica_rt_ffi_arena_bump:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	L_arena_bump_fail
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_ffi_arena_ensure
	test	rdi, rdi
	jz	L_arena_bump_fail
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 264]
	mov	r11, QWORD PTR [rax + 256]
	mov	rcx, QWORD PTR [rbp - 16]
	add	rcx, 7
	and	rcx, -8
	lea	rdx, [r10 + rcx]
	cmp	rdx, r11
	ja	L_arena_bump_fail
	mov	QWORD PTR [rax + 264], rdx
	mov	rdi, r10
	leave
	ret
L_arena_bump_fail:
	xor	edi, edi
	leave
	ret
	.globl	silica_rt_ffi_arena_reset
	.p2align	4
silica_rt_ffi_arena_reset:
	mov	rax, QWORD PTR [rdi + 248]
	test	rax, rax
	jz	L_arena_reset_done
	mov	QWORD PTR [rdi + 264], rax
L_arena_reset_done:
	ret
	.globl	silica_rt_ffi_arena_teardown
	.p2align	4
silica_rt_ffi_arena_teardown:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 248]
	test	rax, rax
	jz	L_arena_teardown_done
	mov	rdi, rax
	mov	esi, 262144
	call	munmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 248], 0
	mov	QWORD PTR [rax + 256], 0
	mov	QWORD PTR [rax + 264], 0
L_arena_teardown_done:
	leave
	ret
	.globl	silica_rt_ffi_ptr_in_active_arena
	.p2align	4
silica_rt_ffi_ptr_in_active_arena:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	L_arena_ptr_no
	mov	rax, QWORD PTR [rdi + 248]
	mov	r10, QWORD PTR [rdi + 256]
	test	rax, rax
	jz	L_arena_ptr_no
	mov	r11, QWORD PTR [rbp - 16]
	cmp	r11, rax
	jb	L_arena_ptr_no
	cmp	r11, r10
	jae	L_arena_ptr_no
	mov	edi, 1
	leave
	ret
L_arena_ptr_no:
	xor	edi, edi
	leave
	ret
"
}
