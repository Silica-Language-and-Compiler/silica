// Hand-written x86-64 (Intel syntax) translation of the linux_aarch64 helper of the same name.
// Internal convention: arguments X0.. in rdi rsi rdx rcx r8 r9, result X0 in rdi (W0 in edi); a
// helper may clobber any register except rbp/rsp. Raw syscalls (mmap 9, munmap 11) clobber rcx and
// r11; the bump allocators preserve every register except rdi (their result), so their callers keep
// live values in any register across the call, as the AArch64 code kept them in X8/X11 and X19-X23.

// String substring and substring_until_char helpers: non-MTE fallback for Apple Silicon (macOS ARM64).
// Per silica-specification §21.3: software-based bounds checking when MTE unavailable.
//
// L_substring_helper: X0 = ptr (literal or SilicaString), X1 = start_char (int64), X2 = end_char (int64).
// X8 = UTF-8 payload base (rodata or heap data ptr). Character-based indices.
// Returns X0 = ptr to substring [start_char, end_char). Clamps to valid range.
//
// Empty and 1-byte results are interned (no allocation). Longer results bump-allocate from
// 4MB mmap chunks. C-string length and an ASCII classification are cached per source pointer, in
// two entries (L_ss_ascii_key/flag and L_ss_ascii_key2/flag2, filled in turn): a scan that peeks
// one character of a haystack and then one of a needle, as the emitter's find_str_at does, hit
// a one-entry cache on neither string and reclassified the whole haystack per character (O(n^2)
// per scan; registry_many_names took 883 s to emit).
// A file with any UTF-8 (type_interner comments contain § — →) cannot use the ASCII fast path;
// sequential peeks then store an exclusive (char,byte) cursor so the next substring resumes
// there instead of walking from byte 0 (O(n²) lex hang). A backward step (L_ss_bwd) skips 80-BF
// bytes to the previous lead and accepts it only when that lead's forward length (the split
// L_ss_find_start uses) lands on the old position and no lead in the three bytes before it
// reaches it; ill-formed UTF-8, where the two splits can differ,
// restarts from byte 0 (before this check the cursor drifted and the lexer never reached the end).
//
// L_substring_until_char_helper: X0 = ptr, X1 = start (int64), X2 = encoded char (len<<56|packed).
// Returns X0 = ptr to substring from start until (exclusive) first occurrence of char, or rest of string.
// Full UTF-8 code-point matching: len=1..4 bytes, packed=byte0|(byte1<<8)|(byte2<<16)|(byte3<<24).
//
// Target: Linux x86-64. Register map in both helpers: X19-X23 -> rbx r12 r13 r14 r15, X8 -> r8,
// X9/X10 -> r10/r11, X11 -> rax, X12 -> rcx, X13 -> r8 (once the base is consumed), X14 -> r9,
// X15 -> rdx (W15 -> edx), X17 -> rcx, X18 -> rdi, X1/X2 address temps -> rsi/rdx.

export emit_string_substring_helper/0;
export emit_string_substring_until_char_helper/0;

fn ss_helper_resolve() -> string {
    concat("L_substring_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    sub rsp, 8\n    mov rbx, rdi\n    mov r12, rsi\n    mov r13, rdx\n    xor eax, eax\n    cmp r12, 0\n    cmovl r12, rax\n    cmp r13, 0\n    cmovl r13, rax\n    mov r11, QWORD PTR [rbx]\n    mov r10, -1\n    cmp r11, r10\n    jne L_ss_bad\n    mov r8, QWORD PTR [rbx + 8]\n    mov r14, QWORD PTR [rbx + 16]\n    jmp L_ss_have_base\nL_ss_bad:\n    ud2\nL_ss_have_base:\n    cmp r12, r13\n    jge L_ss_empty\nL_ss_lk_cls_spin:\n    mov edx, 1\n    xchg DWORD PTR [rip + L_ss_lock], edx\n    test edx, edx\n    jz L_ss_lk_cls_held\n    pause\n    jmp L_ss_lk_cls_spin\nL_ss_lk_cls_held:\n    mov rax, QWORD PTR [rip + L_ss_ascii_key]\n    mov rsi, QWORD PTR [rip + L_ss_ascii_flag]\n    mov r10, QWORD PTR [rip + L_ss_ascii_key2]\n    mov r11, QWORD PTR [rip + L_ss_ascii_flag2]\n    mov DWORD PTR [rip + L_ss_lock], 0\n    cmp rax, rbx\n    je L_ss_ascii_hit\n    mov rsi, r11\n    cmp r10, rbx\n    jne L_ss_ascii_classify\nL_ss_ascii_hit:\n    test rsi, rsi\n    jnz L_ss_ascii_fast\n    jmp L_ss_utf8_slow\nL_ss_ascii_classify:\n    xor r10d, r10d\n    mov r9d, 1\n    xor ecx, ecx\nL_ss_cls:\n    cmp r10, r14\n    jge L_ss_cls_done\n    movzx r11d, BYTE PTR [r8 + r10]\n    cmp r11d, 0x80\n    cmovae r9, rcx\n    add r10, 1\n    jmp L_ss_cls\nL_ss_cls_done:\nL_ss_lk_clw_spin:\n    mov edx, 1\n    xchg DWORD PTR [rip + L_ss_lock], edx\n    test edx, edx\n    jz L_ss_lk_clw_held\n    pause\n    jmp L_ss_lk_clw_spin\nL_ss_lk_clw_held:\n    mov rax, QWORD PTR [rip + L_ss_ascii_victim]\n    lea rsi, [rip + L_ss_ascii_key]\n    shl rax, 4\n    add rsi, rax\n    mov QWORD PTR [rsi], rbx\n    mov QWORD PTR [rsi + 8], r9\n    shr rax, 4\n    xor rax, 1\n    mov QWORD PTR [rip + L_ss_ascii_victim], rax\n    lea rsi, [rip + L_ss_cached_len]\n    mov QWORD PTR [rsi], r14\n    mov DWORD PTR [rip + L_ss_lock], 0\n    test r9, r9\n    jnz L_ss_ascii_fast\n    jmp L_ss_utf8_slow\nL_ss_ascii_fast:\n    mov r15, r12\n    cmp r12, r14\n    cmova r15, r14\n    mov r10, r13\n    cmp r13, r14\n    cmova r10, r14\n    cmp r15, r10\n", "    cmova r15, r10\n    mov rax, r10\n    sub rax, r15\n    jmp L_ss_materialize\n")
}

fn ss_helper_utf8_scan() -> string {
    concat(concat("L_ss_utf8_slow:\nL_ss_lk_cur_spin:\n    mov edx, 1\n    xchg DWORD PTR [rip + L_ss_lock], edx\n    test edx, edx\n    jz L_ss_lk_cur_held\n    pause\n    jmp L_ss_lk_cur_spin\nL_ss_lk_cur_held:\n    mov rax, QWORD PTR [rip + L_ss_cur_key]\n    mov r9, QWORD PTR [rip + L_ss_cur_char]\n    mov r10, QWORD PTR [rip + L_ss_cur_byte]\n    mov DWORD PTR [rip + L_ss_lock], 0\n    cmp rax, rbx\n    jne L_ss_from_zero\n    cmp r10, r14\n    cmova r10, r14\n    cmp r12, r9\n    jb L_ss_bwd\n    jmp L_ss_find_start\nL_ss_from_zero:\n    xor r10d, r10d\n    xor r9d, r9d\n    jmp L_ss_find_start\nL_ss_bwd:\n    cmp r9, r12\n    jle L_ss_start_found\n    test r10, r10\n    jz L_ss_start_found\n    mov rdi, r10\n    sub r10, 1\nL_ss_bwd_cont:\n    movzx r11d, BYTE PTR [r8 + r10]\n    mov eax, r11d\n    shr eax, 6\n    cmp eax, 2\n    jne L_ss_bwd_lead\n    test r10, r10\n    jz L_ss_bwd_lead\n    sub r10, 1\n    jmp L_ss_bwd_cont\nL_ss_bwd_lead:\n    mov ecx, 1\n    cmp r11d, 0xC2\n    jb L_ss_bwd_len\n    mov ecx, 2\n    cmp r11d, 0xE0\n    jb L_ss_bwd_len\n    mov ecx, 3\n    cmp r11d, 0xF0\n    jb L_ss_bwd_len\n    mov ecx, 4\n    cmp r11d, 0xF8\n    jb L_ss_bwd_len\n    mov ecx, 1\nL_ss_bwd_len:\n    add rcx, r10\n    cmp rcx, r14\n    cmova rcx, r14\n    cmp rcx, rdi\n    jne L_ss_from_zero\n    test r10, r10\n    jz L_ss_bwd_ok\n    lea rdi, [r10 - 1]\n    movzx r11d, BYTE PTR [r8 + rdi]\n    cmp r11d, 0xC2\n    jb L_ss_bwd_p2\n    cmp r11d, 0xF8\n    jb L_ss_from_zero\nL_ss_bwd_p2:\n    test rdi, rdi\n    jz L_ss_bwd_ok\n    sub rdi, 1\n    movzx r11d, BYTE PTR [r8 + rdi]\n    cmp r11d, 0xE0\n    jb L_ss_bwd_p3\n    cmp r11d, 0xF8\n    jb L_ss_from_zero\nL_ss_bwd_p3:\n    test rdi, rdi\n    jz L_ss_bwd_ok\n    sub rdi, 1\n    movzx r11d, BYTE PTR [r8 + rdi]\n    cmp r11d, 0xF0\n    jb L_ss_bwd_ok\n    cmp r11d, 0xF8\n    jb L_ss_from_zero\nL_ss_bwd_ok:\n    sub r9, 1\n    jmp L_ss_bwd\nL_ss_find_start:\n    cmp r9, r12\n    jge L_ss_start_found\n    cmp r10, r14\n    jge L_ss_start_found\n    movzx r11d, BYTE PTR [r8 + r10]\n    cmp r11d, 0x80\n    jb L_ss_adv1\n    cmp r11d, 0xC2\n    jb L_ss_adv1\n    cmp r11d, 0xE0\n    jb L_ss_adv2\n    cmp r11d, 0xF0\n    jb L_ss_adv3\n    cmp r11d, 0xF8\n    jb L_ss_adv4\nL_ss_adv1:\n    add r10, 1\n    add r9, 1\n    jmp L_ss_find_start\nL_ss_adv2:\n    mov rdi, r14\n    sub rdi, r10\n    mov ecx, 2\n    cmp rdi, 2\n    cmovb rcx, rdi\n    add r10, rcx\n    add r9, 1\n    jmp L_ss_find_start\nL_ss_adv3:\n    mov rdi, r14\n    sub rdi, r10\n    mov ecx, 3\n    cmp rdi, 3\n    cmovb rcx, rdi\n", "    add r10, rcx\n    add r9, 1\n    jmp L_ss_find_start\nL_ss_adv4:\n    mov rdi, r14\n    sub rdi, r10\n    mov ecx, 4\n    cmp rdi, 4\n    cmovb rcx, rdi\n    add r10, rcx\n    add r9, 1\n    jmp L_ss_find_start\nL_ss_start_found:\n    mov r15, r10\nL_ss_find_end:\n    cmp r9, r13\n    jge L_ss_end_found\n    cmp r10, r14\n    jge L_ss_end_found\n    movzx r11d, BYTE PTR [r8 + r10]\n    cmp r11d, 0x80\n    jb L_ss_eadv1\n    cmp r11d, 0xC2\n    jb L_ss_eadv1\n    cmp r11d, 0xE0\n    jb L_ss_eadv2\n    cmp r11d, 0xF0\n    jb L_ss_eadv3\n    cmp r11d, 0xF8\n    jb L_ss_eadv4\nL_ss_eadv1:\n    add r10, 1\n    add r9, 1\n    jmp L_ss_find_end\nL_ss_eadv2:\n    mov rdi, r14\n    sub rdi, r10\n    mov ecx, 2\n    cmp rdi, 2\n    cmovb rcx, rdi\n    add r10, rcx\n    add r9, 1\n    jmp L_ss_find_end\nL_ss_eadv3:\n    mov rdi, r14\n    sub rdi, r10\n    mov ecx, 3\n    cmp rdi, 3\n    cmovb rcx, rdi\n    add r10, rcx\n    add r9, 1\n    jmp L_ss_find_end\nL_ss_eadv4:\n    mov rdi, r14\n    sub rdi, r10\n    mov ecx, 4\n    cmp rdi, 4\n    cmovb rcx, rdi\n    add r10, rcx\n    add r9, 1\n    jmp L_ss_find_end\nL_ss_end_found:\n    cmp r15, r14\n    cmovg r15, r14\n    cmp r10, r15\n    cmovb r10, r15\n    cmp r10, r14\n    cmovg r10, r14\n    mov rax, r10\n    sub rax, r15\nL_ss_lk_cuw_spin:\n    mov edx, 1\n    xchg DWORD PTR [rip + L_ss_lock], edx\n    test edx, edx\n    jz L_ss_lk_cuw_held\n    pause\n    jmp L_ss_lk_cuw_spin\nL_ss_lk_cuw_held:\n    lea rsi, [rip + L_ss_cur_key]\n    mov QWORD PTR [rsi], rbx\n    lea rsi, [rip + L_ss_cur_char]\n    mov QWORD PTR [rsi], r9\n    lea rsi, [rip + L_ss_cur_byte]\n"), "    mov QWORD PTR [rsi], r10\n    mov DWORD PTR [rip + L_ss_lock], 0\n    jmp L_ss_materialize\n")
}

fn ss_helper_materialize() -> string {
    concat("L_ss_materialize:\n    test rax, rax\n    jz L_ss_empty\n    cmp rax, 1\n    jne L_ss_heap\n    movzx r8d, BYTE PTR [r8 + r15]\nL_ss_lk_one_spin:\n    mov edx, 1\n    xchg DWORD PTR [rip + L_ss_lock], edx\n    test edx, edx\n    jz L_ss_lk_one_held\n    pause\n    jmp L_ss_lk_one_spin\nL_ss_lk_one_held:\n    lea rdi, [rip + L_ss_1char_ready]\n    mov rsi, QWORD PTR [rdi]\n    test rsi, rsi\n    jnz L_ss_1char_ok\n    lea rdx, [rip + L_ss_1char_table]\n    xor ecx, ecx\n    mov r9, -1\nL_ss_1char_init:\n    mov QWORD PTR [rdx], r9\n    lea r10, [rdx + 24]\n    mov QWORD PTR [rdx + 8], r10\n    mov r11d, 1\n    mov QWORD PTR [rdx + 16], r11\n    mov BYTE PTR [rdx + 24], cl\n    mov BYTE PTR [rdx + 25], 0\n    add rdx, 32\n    add rcx, 1\n    cmp rcx, 256\n    jb L_ss_1char_init\n    mov esi, 1\n    mov QWORD PTR [rdi], rsi\nL_ss_1char_ok:\n    mov DWORD PTR [rip + L_ss_lock], 0\n    lea rdi, [rip + L_ss_1char_table]\n    shl r8, 5\n    add rdi, r8\n    jmp L_ss_ret\nL_ss_empty:\n    lea rdi, [rip + L_ss_empty_str]\n    jmp L_ss_ret\nL_ss_heap:\n    lea rdi, [rax + 25]\n    call L_ss_bump_alloc\n    test rdi, rdi\n    jz L_ss_ret\n    mov rdx, rdi\n    mov r10, -1\n    mov QWORD PTR [rdx], r10\n    lea r10, [rdx + 24]\n    mov QWORD PTR [rdx + 8], r10\n    mov QWORD PTR [rdx + 16], rax\n    lea r11, [r8 + r15]\n    mov rcx, rax\nL_ss_cp:\n    test rcx, rcx\n    jz L_ss_cp_done\n    movzx r8d, BYTE PTR [r11]\n    mov BYTE PTR [r10], r8b\n    add r10, 1\n    add r11, 1\n    sub rcx, 1\n    jmp L_ss_cp\nL_ss_cp_done:\n    mov BYTE PTR [r10], 0\n    mov rdi, rdx\nL_ss_ret:\n    add rsp, 8\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n", "    pop rbp\n    ret\n")
}

fn ss_helper_bump_data() -> string {
    concat("L_ss_bump_alloc:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push rsi\n    push rdx\n    push rcx\n    push r8\n    push r9\n    push r10\n    push r11\n    push rax\n    sub rsp, 8\n    add rdi, 7\n    shr rdi, 3\n    mov rbx, rdi\n    shl rbx, 3\nL_ss_lk_bump_spin:\n    mov edx, 1\n    xchg DWORD PTR [rip + L_ss_lock], edx\n    test edx, edx\n    jz L_ss_lk_bump_held\n    pause\n    jmp L_ss_lk_bump_spin\nL_ss_lk_bump_held:\n    lea r12, [rip + L_ss_arena_ptr]\n    mov r13, QWORD PTR [r12]\n    test r13, r13\n    jz L_ss_bump_new\n    lea rsi, [rip + L_ss_arena_end]\n    mov rdx, QWORD PTR [rsi]\n    lea rcx, [r13 + rbx]\n    cmp rcx, rdx\n    ja L_ss_bump_new\n    mov QWORD PTR [r12], rcx\n    mov rdi, r13\n    jmp L_ss_bump_out\nL_ss_bump_new:\n    lea rsi, [rbx + 16]\n    mov edx, 0x400000\n    cmp rsi, rdx\n    cmovbe rsi, rdx\n    mov r13, rsi\n    xor edi, edi\n    mov edx, 3\n    mov r10d, 0x22\n    mov r8, -1\n    xor r9d, r9d\n    mov eax, 9\n    syscall\n    mov rdi, rax\n    test rdi, rdi\n    js L_ss_bump_fail\n    lea rdx, [rip + L_ss_arena_head]\n    mov rcx, QWORD PTR [rdx]\n    mov QWORD PTR [rdi], rcx\n    mov QWORD PTR [rdi + 8], r13\n    mov QWORD PTR [rdx], rdi\n    lea rsi, [rdi + 16]\n    lea rcx, [rsi + rbx]\n    mov QWORD PTR [r12], rcx\n    lea rdx, [rip + L_ss_arena_end]\n    lea rcx, [rdi + r13]\n    mov QWORD PTR [rdx], rcx\n    mov rdi, rsi\n    jmp L_ss_bump_out\nL_ss_bump_fail:\n    xor edi, edi\nL_ss_bump_out:\n    mov DWORD PTR [rip + L_ss_lock], 0\n    add rsp, 8\n    pop rax\n    pop r11\n    pop r10\n    pop r9\n    pop r8\n    pop rcx\n    pop rdx\n    pop rsi\n    pop r13\n    pop r12\n", "    pop rbx\n    pop rbp\n    ret\nL_ss_arena_release:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    sub rsp, 8\n    lea r12, [rip + L_ss_arena_head]\n    mov rbx, QWORD PTR [r12]\nL_ss_rel_loop:\n    test rbx, rbx\n    jz L_ss_rel_done\n    mov r13, QWORD PTR [rbx]\n    mov rsi, QWORD PTR [rbx + 8]\n    mov rdi, rbx\n    mov eax, 11\n    syscall\n    mov rbx, r13\n    jmp L_ss_rel_loop\nL_ss_rel_done:\n    mov QWORD PTR [r12], 0\n    mov QWORD PTR [rip + L_ss_arena_ptr], 0\n    mov QWORD PTR [rip + L_ss_arena_end], 0\n    mov QWORD PTR [rip + L_ss_ascii_key], 0\n    mov QWORD PTR [rip + L_ss_ascii_flag], 0\n    mov QWORD PTR [rip + L_ss_ascii_key2], 0\n    mov QWORD PTR [rip + L_ss_ascii_flag2], 0\n    mov QWORD PTR [rip + L_ss_ascii_victim], 0\n    mov QWORD PTR [rip + L_ss_cached_len], 0\n    mov QWORD PTR [rip + L_ss_cur_key], 0\n    mov QWORD PTR [rip + L_ss_cur_char], 0\n    mov QWORD PTR [rip + L_ss_cur_byte], 0\n    add rsp, 8\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\n    .bss\n    .p2align 3\nL_ss_ascii_key:\n    .space 8\nL_ss_ascii_flag:\n    .space 8\nL_ss_ascii_key2:\n    .space 8\nL_ss_ascii_flag2:\n    .space 8\nL_ss_ascii_victim:\n    .space 8\nL_ss_cached_len:\n    .space 8\nL_ss_cur_key:\n    .space 8\nL_ss_cur_char:\n    .space 8\nL_ss_cur_byte:\n    .space 8\nL_ss_lock:\n    .space 8\nL_ss_arena_ptr:\n    .space 8\nL_ss_arena_end:\n    .space 8\nL_ss_arena_head:\n    .space 8\nL_ss_1char_ready:\n    .space 8\nL_ss_1char_table:\n    .space 8192\n    .data\n    .p2align 3\nL_ss_empty_str:\n    .quad -1\n    .quad L_ss_empty_bytes\n    .quad 0\nL_ss_empty_bytes:\n    .byte 0\n    .text\n    .p2align 2\n")
}

fn emit_string_substring_helper() -> string {
    concat(concat(ss_helper_resolve(), ss_helper_utf8_scan()), concat(ss_helper_materialize(), ss_helper_bump_data()))
}

fn suc_helper_scan() -> string {
    concat("L_substring_until_char_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    sub rsp, 8\n    mov rbx, rdi\n    mov r12, rsi\n    mov r13, rdx\n    mov r9, r13\n    shr r9, 56\n    mov edx, r13d\n    mov ecx, 1\n    cmp r9, 0\n    cmove r9, rcx\n    mov r10, QWORD PTR [rbx]\n    mov r11, -1\n    cmp r10, r11\n    jne L_suc_bad\n    mov r14, QWORD PTR [rbx + 16]\n    mov rbx, QWORD PTR [rbx + 8]\nL_suc_len_done:\n    xor eax, eax\n    cmp r12, 0\n    cmovl r12, rax\n    cmp r12, r14\n    cmovg r12, r14\n    mov r15, r12\n    lea r10, [rbx + r12]\nL_suc_scan:\n    cmp r12, r14\n    jge L_suc_scan_done\n    movzx r11d, BYTE PTR [r10]\n    lea rcx, [r12 + r9]\n    cmp rcx, r14\n    jg L_suc_no_match\n    cmp r9, 1\n    je L_suc_cmp1\n    cmp r9, 2\n    je L_suc_cmp2\n    cmp r9, 3\n    je L_suc_cmp3\n    mov r8d, DWORD PTR [r10]\n    cmp r8d, edx\n    je L_suc_scan_done\n    jmp L_suc_no_match\nL_suc_cmp1:\n    movzx r8d, BYTE PTR [r10]\n    movzx eax, dl\n    cmp r8d, eax\n    je L_suc_scan_done\n    jmp L_suc_no_match\nL_suc_cmp2:\n    movzx r8d, WORD PTR [r10]\n    movzx eax, dx\n    cmp r8d, eax\n    je L_suc_scan_done\n    jmp L_suc_no_match\nL_suc_cmp3:\n    mov r8d, DWORD PTR [r10]\n    and r8d, 0xFFFFFF\n    mov eax, edx\n    and eax, 0xFFFFFF\n    cmp r8d, eax\n    je L_suc_scan_done\nL_suc_no_match:\n    cmp r11d, 0x80\n    jb L_suc_adv1\n    cmp r11d, 0xC2\n    jb L_suc_adv1\n", "    cmp r11d, 0xE0\n    jb L_suc_adv2\n    cmp r11d, 0xF0\n    jb L_suc_adv3\n    cmp r11d, 0xF8\n    jb L_suc_adv4\nL_suc_adv1:\n    add r10, 1\n    add r12, 1\n    jmp L_suc_scan\nL_suc_adv2:\n    mov rdi, r14\n    sub rdi, r12\n    mov ecx, 2\n    cmp rdi, 2\n    cmovb rcx, rdi\n    add r10, rcx\n    add r12, rcx\n    jmp L_suc_scan\nL_suc_adv3:\n    mov rdi, r14\n    sub rdi, r12\n    mov ecx, 3\n    cmp rdi, 3\n    cmovb rcx, rdi\n    add r10, rcx\n    add r12, rcx\n    jmp L_suc_scan\nL_suc_adv4:\n    mov rdi, r14\n    sub rdi, r12\n    mov ecx, 4\n    cmp rdi, 4\n    cmovb rcx, rdi\n    add r10, rcx\n    add r12, rcx\n    jmp L_suc_scan\n")
}

fn suc_helper_materialize() -> string {
    concat("L_suc_scan_done:\n    mov rax, r12\n    sub rax, r15\n    test rax, rax\n    jz L_suc_empty\n    lea r11, [rbx + r15]\n    lea rdi, [rax + 25]\n    call L_suc_bump_alloc\n    test rdi, rdi\n    jz L_suc_ret\n    mov r15, rdi\n    mov r10, -1\n    mov QWORD PTR [r15], r10\n    lea r10, [r15 + 24]\n    mov QWORD PTR [r15 + 8], r10\n    mov QWORD PTR [r15 + 16], rax\n    mov rcx, rax\nL_suc_cp:\n    test rcx, rcx\n    jz L_suc_cp_done\n    movzx r8d, BYTE PTR [r11]\n    mov BYTE PTR [r10], r8b\n    add r10, 1\n    add r11, 1\n    sub rcx, 1\n    jmp L_suc_cp\nL_suc_cp_done:\n    mov BYTE PTR [r10], 0\n    mov rdi, r15\n    jmp L_suc_ret\nL_suc_empty:\n    lea rdi, [rip + L_suc_empty_str]\nL_suc_ret:\n    add rsp, 8\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\nL_suc_bump_alloc:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push rsi\n    push rdx\n    push rcx\n    push r8\n    push r9\n    push r10\n    push r11\n    push rax\n    sub rsp, 8\n    add rdi, 7\n    shr rdi, 3\n    mov rbx, rdi\n    shl rbx, 3\nL_suc_lk_bump_spin:\n    mov edx, 1\n    xchg DWORD PTR [rip + L_suc_lock], edx\n    test edx, edx\n    jz L_suc_lk_bump_held\n    pause\n    jmp L_suc_lk_bump_spin\nL_suc_lk_bump_held:\n    lea r12, [rip + L_suc_arena_ptr]\n    mov r13, QWORD PTR [r12]\n    test r13, r13\n    jz L_suc_bump_new\n    lea rsi, [rip + L_suc_arena_end]\n    mov rdx, QWORD PTR [rsi]\n    lea rcx, [r13 + rbx]\n    cmp rcx, rdx\n    ja L_suc_bump_new\n    mov QWORD PTR [r12], rcx\n    mov rdi, r13\n    jmp L_suc_bump_out\nL_suc_bump_new:\n    lea rsi, [rbx + 16]\n", "    mov edx, 0x400000\n    cmp rsi, rdx\n    cmovbe rsi, rdx\n    mov r13, rsi\n    xor edi, edi\n    mov edx, 3\n    mov r10d, 0x22\n    mov r8, -1\n    xor r9d, r9d\n    mov eax, 9\n    syscall\n    mov rdi, rax\n    test rdi, rdi\n    js L_suc_bump_fail\n    lea rdx, [rip + L_suc_arena_head]\n    mov rcx, QWORD PTR [rdx]\n    mov QWORD PTR [rdi], rcx\n    mov QWORD PTR [rdi + 8], r13\n    mov QWORD PTR [rdx], rdi\n    lea rsi, [rdi + 16]\n    lea rcx, [rsi + rbx]\n    mov QWORD PTR [r12], rcx\n    lea rdx, [rip + L_suc_arena_end]\n    lea rcx, [rdi + r13]\n    mov QWORD PTR [rdx], rcx\n    mov rdi, rsi\n    jmp L_suc_bump_out\nL_suc_bump_fail:\n    xor edi, edi\nL_suc_bump_out:\n    mov DWORD PTR [rip + L_suc_lock], 0\n    add rsp, 8\n    pop rax\n    pop r11\n    pop r10\n    pop r9\n    pop r8\n    pop rcx\n    pop rdx\n    pop rsi\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\n    .bss\n    .p2align 3\nL_suc_lock:\n    .space 8\nL_suc_arena_ptr:\n    .space 8\nL_suc_arena_end:\n    .space 8\nL_suc_arena_head:\n    .space 8\n    .data\n    .p2align 3\nL_suc_empty_str:\n    .quad -1\n    .quad L_suc_empty_bytes\n    .quad 0\nL_suc_empty_bytes:\n    .byte 0\n    .text\n    .p2align 2\n\nL_suc_bad:\n    ud2")
}

fn emit_string_substring_until_char_helper() -> string {
    concat(suc_helper_scan(), suc_helper_materialize())
}
