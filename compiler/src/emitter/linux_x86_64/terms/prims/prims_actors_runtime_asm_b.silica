// Compiler-bundled actor runtime, part B: x86-64 (Intel syntax, GNU/ELF) translations of the
// linux_aarch64 prims_actors_runtime_asm chunks 9-13. prims_actors_runtime_asm@emit_actor_runtime_helpers
// concatenates these in the same order as the AArch64 original; every chunk starts at a section
// boundary (chunk 9 .rodata, 10 .bss, 11 .text, 12 .rodata, 13 .text), so no routine straddles into
// or out of this module. All data layouts, control-block offsets and constants are those documented
// in prims_actors_runtime_asm.silica (ACB 528 B, items I and N, 152 B message nodes, mailbox pairs at #128/#136 and
// #232/#240 with the u32 depth at #248, arena fields #160..#184, region list cells [next][size]).
//
// Register model (shared by the linux_x86_64 runtime modules): X0..X7 -> rdi rsi rdx rcx r8 r9 r14 r15,
// X9/X10 -> r10/r11, X8 and the X13..X17 scratch registers -> rax (or rdx/rcx once the argument is
// consumed) because every such temporary here dies before the next call; X19..X28 -> frame slots
// [rbp-8]..[rbp-80] (never registers: calls into Silica code preserve only rbp/rsp). Prologue
// `push rbp; mov rbp, rsp; sub rsp, N` with N = 80 (the ten slots) + the routine's own [sp, #k]
// locals (now [rsp + k]) rounded to 16, epilogue `leave; ret`. Routines called from Silica or from
// other runtime routines return X0 in rdi; C library results arrive in rax and are moved to rdi.
// The Darwin-era shim names (silica_rt_lock_lock/unlock, silica_rt_sysctlbyname,
// silica_rt_pthread_mach_thread_np, silica_rt_thread_policy_set) keep their argument order and are
// expected to return X0/W0 in rdi/edi like every other runtime routine.
//
// Cross-routine register contracts kept from the AArch64 text:
//   silica_rt_tls_actor_set_from_x19: on x86-64 the ACB arrives in rdi (X0); callers load their X19
//     value into rdi before the call (the caller's [rbp-8] slot is not read: C-called routines may
//     have pushed registers there). Since item N it is silica_rt_tls_actor_set (prims_actors_carrier_asm):
//     the pthread key names a two-word thread record, the current actor and the carrier, not the ACB.
//   silica_rt_region_mark returns the mark in rax (X16) and silica_rt_region_release_to takes it
//     in rax (X16), preserving rdi/rsi (X0/X1) as the original preserved X0/X1.
//   L_bc_push (private to silica_rt_apple_build_cache_levels) now takes the list head in rdi instead
//     of reading the caller's X22, and keeps its line/assoc/shared arguments in frame slots across
//     malloc (the AArch64 text left them in X3..X5 and X1/X2 across the two malloc calls).
// silica_rt_sysctl_u64 keeps the original's order of `str w0, [sp, #8]` then `stp xzr, xzr, [sp]`
// (the length word is zeroed after being set, as in the Darwin and Linux AArch64 sources).

export actor_rt_asm_chunk_9/0;
export actor_rt_asm_chunk_10/0;
export actor_rt_asm_chunk_11/0;
export actor_rt_asm_chunk_12/0;
export actor_rt_asm_chunk_13/0;

fn actor_rt_asm_chunk_9() -> string {
    "	.section .rodata
L_hw_perf0_str:
	.asciz	\"hw.perflevel0.physicalcpu\"
L_hw_perf1_str:
	.asciz	\"hw.perflevel1.physicalcpu\"
L_hw_memsize_str:
	.asciz	\"hw.memsize\"
L_hw_cachelinesize_str:
	.asciz	\"hw.cachelinesize\"
L_hw_nperflevels_str:
	.asciz	\"hw.nperflevels\"
L_hw_l3cachesize_str:
	.asciz	\"hw.l3cachesize\"
L_hw_l1dcachesize_str:
	.asciz	\"hw.l1dcachesize\"
L_hw_l2cachesize_str:
	.asciz	\"hw.l2cachesize\"
L_hw_pl0_l1d_str:
	.asciz	\"hw.perflevel0.l1dcachesize\"
L_hw_pl0_l2_str:
	.asciz	\"hw.perflevel0.l2cachesize\"
L_hw_pl1_l1d_str:
	.asciz	\"hw.perflevel1.l1dcachesize\"
L_hw_pl1_l2_str:
	.asciz	\"hw.perflevel1.l2cachesize\"
L_sc_opt_neon:
	.asciz	\"hw.optional.neon\"
L_tok_opt_neon:
	.asciz	\"optional.neon\"
L_sc_opt_armv8crc:
	.asciz	\"hw.optional.armv8_crc32\"
L_tok_opt_armv8crc:
	.asciz	\"optional.armv8_crc32\"
L_sc_opt_arm64:
	.asciz	\"hw.optional.arm64\"
L_tok_opt_arm64:
	.asciz	\"optional.arm64\"
L_sc_opt_lse:
	.asciz	\"hw.optional.arm.FEAT_LSE\"
L_tok_opt_lse:
	.asciz	\"optional.arm.FEAT_LSE\"
L_sc_opt_sha512:
	.asciz	\"hw.optional.arm.FEAT_SHA512\"
L_tok_opt_sha512:
	.asciz	\"optional.arm.FEAT_SHA512\"
L_sc_opt_sha256:
	.asciz	\"hw.optional.arm.FEAT_SHA256\"
L_tok_opt_sha256:
	.asciz	\"optional.arm.FEAT_SHA256\"
L_sc_opt_aes:
	.asciz	\"hw.optional.arm.FEAT_AES\"
L_tok_opt_aes:
	.asciz	\"optional.arm.FEAT_AES\"
L_sc_opt_advsimd:
	.asciz	\"hw.optional.AdvSIMD\"
L_tok_opt_advsimd:
	.asciz	\"optional.AdvSIMD\"
	.text
	.p2align	2
# -- Begin function silica_rt_build_int_range_list
silica_rt_build_int_range_list:
# rdi=start rsi=count -> rdi=cons list [start..start+count-1] or nil
# frame: [rbp-8] start (X19), [rbp-16] count (X20), [rbp-24] head (X21), [rbp-32] value (X22)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], 0
	test	rsi, rsi
	jz	LBBrl_done
	lea	rax, [rdi + rsi - 1]
	mov	QWORD PTR [rbp - 32], rax
LBBrl_loop:
	mov	edi, 16
	call	malloc
	test	rax, rax
	jz	LBBrl_done
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 8], rcx
	mov	QWORD PTR [rbp - 24], rax
	mov	rcx, QWORD PTR [rbp - 32]
	sub	rcx, 1
	mov	QWORD PTR [rbp - 32], rcx
	cmp	rcx, QWORD PTR [rbp - 8]
	jge	LBBrl_loop
LBBrl_done:
	mov	rdi, QWORD PTR [rbp - 24]
	leave
	ret
# -- End function
# rdi = sysctl name cstring. Returns edi = int32 value, or -1 on failure.
	.p2align	2
silica_rt_sysctl_i32:
# frame: [rbp-8] name (X19); [rsp] value, [rsp+8] length (the AArch64 [sp], [sp, #8])
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_si32_fail
	mov	edi, DWORD PTR [rsp]
	leave
	ret
L_si32_fail:
	mov	edi, -1
	leave
	ret
# rdi = C string pointer, rsi = tail (cons list or 0). Returns rdi = new head; malloc fail returns the tail.
	.p2align	2
silica_rt_cons_cstr_list:
# frame: [rbp-8] cstring (X19), [rbp-16] tail (X20)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	edi, 16
	call	malloc
	test	rax, rax
	jz	L_ccl_fail
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 8], rcx
	mov	rdi, rax
	leave
	ret
L_ccl_fail:
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
# Machine-wide sysctl hw.optional.* flags -> cons list of cstrings (see cpu_topology_implementation_plan).
	.globl	silica_rt_apple_hw_optional_caps_list
	.p2align	2
silica_rt_apple_hw_optional_caps_list:
# frame: [rbp-8] list head (X19)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], 0
	lea	rdi, [rip + L_sc_opt_neon]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_1
	lea	rdi, [rip + L_tok_opt_neon]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_1:
	lea	rdi, [rip + L_sc_opt_armv8crc]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_2
	lea	rdi, [rip + L_tok_opt_armv8crc]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_2:
	lea	rdi, [rip + L_sc_opt_arm64]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_3
	lea	rdi, [rip + L_tok_opt_arm64]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_3:
	lea	rdi, [rip + L_sc_opt_lse]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_4
	lea	rdi, [rip + L_tok_opt_lse]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_4:
	lea	rdi, [rip + L_sc_opt_sha512]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_5
	lea	rdi, [rip + L_tok_opt_sha512]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_5:
	lea	rdi, [rip + L_sc_opt_sha256]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_6
	lea	rdi, [rip + L_tok_opt_sha256]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_6:
	lea	rdi, [rip + L_sc_opt_aes]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_7
	lea	rdi, [rip + L_tok_opt_aes]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_7:
	lea	rdi, [rip + L_sc_opt_advsimd]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_done
	lea	rdi, [rip + L_tok_opt_advsimd]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_done:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
# rdi = sysctl name cstring. Returns rdi = uint64 (0 on failure).
	.p2align	2
silica_rt_sysctl_u64:
# frame: [rbp-8] name (X19); [rsp] value, [rsp+8] length (the AArch64 [sp], [sp, #8])
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
# The value and length words are zeroed first and the length (8) stored after them: before
# 2026-10-19 the zeroing followed the length store and wiped it, so the query saw a length of 0
# and every caller got 0 (hw.memsize for get_cpu_topology among them). Same fix as apple_silicon_mac.
	mov	QWORD PTR [rsp], 0
	mov	QWORD PTR [rsp + 8], 0
	mov	DWORD PTR [rsp + 8], 8
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_s64_fail
	mov	rdi, QWORD PTR [rsp]
	leave
	ret
L_s64_fail:
	xor	edi, edi
	leave
	ret
# Apple Silicon cache_info.levels: sysctl exposes per-cluster L1D/L2 (hw.perflevel0/1.*), aggregate hw.l1d/l2/l3,
# hw.cachelinesize, hw.nperflevels. Not exposed in sysctl: SLC/unified last-level cache as a stable L3; associativity
# (we store 0). rdi=P, rsi=E, rdx=total, rcx=all-core-ids list. Returns rdi = list head (cons spine) or 0.
	.globl	silica_rt_apple_build_cache_levels
	.p2align	2
silica_rt_apple_build_cache_levels:
# frame: [rbp-8] P (X19), [rbp-16] E (X20), [rbp-24] total (X21), [rbp-32] head (X22), [rbp-40] line (X23),
# [rbp-48] P ids (X24), [rbp-56] E ids (X25), [rbp-64] all ids (X26), [rbp-72] nperflevels (X27),
# [rbp-80] all-core-ids arg (X28); [rsp] sysctl value, [rsp+8] sysctl length
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	QWORD PTR [rbp - 80], rcx
	mov	QWORD PTR [rbp - 32], 0
	lea	rdi, [rip + L_hw_cachelinesize_str]
	call	silica_rt_sysctl_u64
	mov	QWORD PTR [rbp - 40], rdi
	xor	edi, edi
	mov	esi, DWORD PTR [rbp - 8]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 48], rdi
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_no_epl
	mov	edi, DWORD PTR [rbp - 8]
	mov	esi, DWORD PTR [rbp - 16]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 56], rdi
	jmp	L_bc_have_epl
L_bc_no_epl:
	mov	QWORD PTR [rbp - 56], 0
L_bc_have_epl:
	xor	edi, edi
	mov	esi, DWORD PTR [rbp - 24]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 64], rdi
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_nperflevels_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_bc_nperf_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 72], rax
	cmp	eax, 2
	jae	L_bc_dual
	jmp	L_bc_agg
L_bc_nperf_fail:
L_bc_agg:
	lea	rdi, [rip + L_hw_l3cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_a_skip_l3
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_a_skip_l3
	mov	esi, 3
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_a_skip_l3:
	lea	rdi, [rip + L_hw_l2cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_a_skip_l2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_a_skip_l2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_a_skip_l2:
	lea	rdi, [rip + L_hw_l1dcachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_done
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_done
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
	jmp	L_bc_done
L_bc_dual:
	lea	rdi, [rip + L_hw_l3cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_l3
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_l3
	mov	esi, 3
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_l3:
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_d_skip_el2
	lea	rdi, [rip + L_hw_pl1_l2_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_el2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_el2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 56]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_el2:
	cmp	DWORD PTR [rbp - 8], 0
	je	L_bc_d_skip_pl2
	lea	rdi, [rip + L_hw_pl0_l2_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_pl2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_pl2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 48]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_pl2:
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_d_skip_el1
	lea	rdi, [rip + L_hw_pl1_l1d_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_el1
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_el1
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 56]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_el1:
	cmp	DWORD PTR [rbp - 8], 0
	je	L_bc_done
	lea	rdi, [rip + L_hw_pl0_l1d_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_done
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_done
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 48]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_done:
	mov	edi, 16
	call	malloc
	mov	rdi, QWORD PTR [rbp - 32]
	test	rax, rax
	jz	L_bc_wrapped
	mov	QWORD PTR [rax], 65541
	mov	QWORD PTR [rax + 8], rdi
	mov	rdi, rax
L_bc_wrapped:
	leave
	ret
# rdi=head rsi=level rdx=size_kb rcx=line r8=assoc r9=shared -> rdi=new head (malloc failure returns head)
L_bc_push:
# frame: [rbp-8] head (X19), [rbp-16] level (X20), [rbp-24] size_kb (X21), [rbp-32] line, [rbp-40] assoc,
# [rbp-48] shared, [rbp-56] entry pointer
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	QWORD PTR [rbp - 32], rcx
	mov	QWORD PTR [rbp - 40], r8
	mov	QWORD PTR [rbp - 48], r9
	mov	edi, 48
	call	malloc
	test	rax, rax
	jz	L_bcp_fail
	mov	QWORD PTR [rax], 65542
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 8], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 16], rcx
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 24], rcx
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 32], rcx
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 40], rcx
	mov	QWORD PTR [rbp - 56], rax
	mov	edi, 16
	call	malloc
	test	rax, rax
	jz	L_bcp_fail
	mov	rcx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 8], rcx
	mov	rdi, rax
	leave
	ret
L_bcp_fail:
