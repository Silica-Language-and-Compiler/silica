fn actor_rt_asm_chunk_11() -> string {
    "	.text
	.globl	silica_rt_ensure_actor_tls_key
	.p2align	2
silica_rt_ensure_actor_tls_key:
# frame: [rbp-16] address of silica_actor_tls_key_ready (X20)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	lea	rax, [rip + silica_actor_tls_key_ready]
	mov	QWORD PTR [rbp - 16], rax
	movzx	eax, BYTE PTR [rax]
	test	eax, eax
	jnz	L_tlse_done
	lea	rdi, [rip + silica_actor_tls_init_lock]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 16]
	movzx	eax, BYTE PTR [rax]
	test	eax, eax
	jnz	L_tlse_unlock
	lea	rdi, [rip + silica_actor_pthread_key]
	xor	esi, esi
	call	pthread_key_create
	test	eax, eax
	jnz	L_tlse_unlock
	mov	rax, QWORD PTR [rbp - 16]
	mov	BYTE PTR [rax], 1
L_tlse_unlock:
	lea	rdi, [rip + silica_actor_tls_init_lock]
	call	silica_rt_lock_unlock
L_tlse_done:
	leave
	ret
	.globl	silica_rt_tls_current_actor_get
	.p2align	2
silica_rt_tls_current_actor_get:
# -> rdi = this thread's current actor: the first word of the thread's record (the pthread key names
# it; silica_rt_tls_record_set), 0 on a thread with no record (main before any drain) or whose
# record holds none (a carrier between actors).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_ensure_actor_tls_key
	lea	rax, [rip + silica_actor_pthread_key]
	mov	rdi, QWORD PTR [rax]
	call	pthread_getspecific
	xor	edi, edi
	test	rax, rax
	jz	L_tcag_ret
	mov	rdi, QWORD PTR [rax]
L_tcag_ret:
	leave
	ret
	.globl	silica_rt_tls_actor_set_from_x19
	.p2align	2
silica_rt_tls_actor_set_from_x19:
# rdi = the ACB to install as this thread's current actor (the caller's X19 value, moved into rdi
# by the caller). The record's first word (prims_actors_carrier_asm.silica).
	jmp	silica_rt_tls_actor_set
	.p2align	2
silica_rt_actor_init_region: # arena bookkeeping for the actor's implicit heap
# rdi=actor_ptr. The arena is a chain of anonymous blocks allocated on demand by
# silica_rt_region_alloc, so nothing is mapped here: #160 newest block (header: prev, size),
# #168 bytes mapped so far, #176 bump pointer, #184 limit of the newest block.
	mov	QWORD PTR [rdi + 160], 0
	mov	QWORD PTR [rdi + 168], 0
	mov	QWORD PTR [rdi + 176], 0
	mov	QWORD PTR [rdi + 184], 0
	ret
# -- End function
	.p2align	2
silica_rt_actor_dealloc_region: # release every arena block of an actor
# rdi=actor_ptr. Walks the block chain from #160 and munmaps each block.
# frame: [rbp-8] block (X19), [rbp-16] actor (X20), [rbp-24] previous block (X21)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 32], 0
	mov	rax, QWORD PTR [rdi + 160]
	mov	QWORD PTR [rbp - 8], rax
LBBdr_loop:
	mov	rdi, QWORD PTR [rbp - 8]
	test	rdi, rdi
	jz	LBBdr_done
	mov	rax, QWORD PTR [rdi]
	mov	QWORD PTR [rbp - 24], rax
	mov	rsi, QWORD PTR [rdi + 8]
	lea	rax, [rsi - 16]
	add	QWORD PTR [rbp - 32], rax
	call	munmap
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rbp - 8], rax
	jmp	LBBdr_loop
LBBdr_done:
	mov	rax, QWORD PTR [rbp - 16]
# the newest block's untouched tail was never handed out
	mov	rcx, QWORD PTR [rax + 176]
	test	rcx, rcx
	jz	LBBdr_acc
	mov	rdx, QWORD PTR [rax + 184]
	sub	rdx, rcx
	sub	QWORD PTR [rbp - 32], rdx
LBBdr_acc:
	mov	rcx, QWORD PTR [rbp - 32]
	lock sub	QWORD PTR [rip + silica_rt_heap_in_use], rcx
	mov	QWORD PTR [rax + 160], 0
	mov	QWORD PTR [rax + 168], 0
	mov	QWORD PTR [rax + 176], 0
	mov	QWORD PTR [rax + 184], 0
	leave
	ret
# -- End function
"
}

fn actor_rt_asm_chunk_12() -> string {
    "	.section .rodata
	.p2align	2
L_silica_root_actor_exit:
	.asciz	\"[silica] root actor exited (no supervisor)\\n\"
	.text
# The root-exit note. Written under silica_rt_root_note_lock; the exit drain
# (silica_rt_report_drain_at_exit) takes that lock last and keeps it, so the process never ends
# while a note is half written (a torn \"[s\" glued to the next output through a PTY).
	.globl	silica_rt_root_note_write
	.p2align	2
silica_rt_root_note_write:
	push	rbp
	mov	rbp, rsp
	lea	rdi, [rip + silica_rt_root_note_lock]
	call	silica_rt_lock_lock
	mov	edi, 2
	lea	rsi, [rip + L_silica_root_actor_exit]
	mov	edx, 43
	call	write
	lea	rdi, [rip + silica_rt_root_note_lock]
	call	silica_rt_lock_unlock
	pop	rbp
	ret
# X0 (rdi) out: 1 when a FailureReporter is registered and the note has been written now, 0 when
# the caller writes it after the report as before. With a reporter the report is printed on the
# reporter's thread, which may call cast_exit on it, so the note must be out before the report is
# queued; without one the report is written synchronously and the note follows it.
	.globl	silica_rt_root_note_early
	.p2align	2
silica_rt_root_note_early:
	push	rbp
	mov	rbp, rsp
	xor	edi, edi
	cmp	QWORD PTR [rip + silica_rt_root_failure_reporter], 0
	je	Lrne_ret
	call	silica_rt_root_note_write
	mov	edi, 1
Lrne_ret:
	pop	rbp
	ret
# X0 (rdi) = a root actor's (or root supervisor's) control block: its failure report and the root
# note, in the order silica_rt_root_note_early gives.
	.globl	silica_rt_root_report_and_note
	.p2align	2
silica_rt_root_report_and_note:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	lock inc	QWORD PTR [rip + silica_rt_report_inflight]
	call	silica_rt_root_note_early
	mov	QWORD PTR [rbp - 16], rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_deliver_unwind_report
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lrrn_ret
	call	silica_rt_root_note_write
Lrrn_ret:
	leave
	ret
	.bss
	.p2align	2
.globl	silica_rt_root_note_lock
.comm	silica_rt_root_note_lock,4,4
	.text
	.globl	silica_rt_migrate_actor
	.p2align	2
# -- Begin function silica_rt_migrate_actor
silica_rt_migrate_actor:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_migrate_actor_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_migrate_actor_acb:
# rdi = ACB (held) or 0, rsi = target core -> rdi = 0 (:ok: the move is requested, and done at the
# actor's next dispatch boundary, at once when it is idle), 1 (:invalid_target: no logical core of
# that id on this machine, silica_rt_logical_cpu_count, the count get_cpu_topology reports),
# 2 (:actor_not_found: a null reference, or an actor that has ended); the emitter maps the code to
# the program's atom (prims_actors emit_prim_op_with_atoms). 3 (:migration_blocked) is never
# produced on this target: nothing blocks a move. A carrier actor (#144 = 0, item N stage 3) is
# moved to the carrier of the core, `core mod N` as at spawn (silica_rt_carrier_migrate, which
# says what happens per status). A dangerous actor (a thread of its own, #144) gets the thread's
# affinity hint, as every actor did before carriers; the OS may still share or move the thread
# (spec §22.10), so the hint's own result is not reported.
	test	rdi, rdi
	jz	Lmig_not_found
	cmp	DWORD PTR [rdi + 152], 0
	je	Lmig_not_found
	cmp	rsi, QWORD PTR [rip + silica_rt_logical_cpu_count]
	jae	Lmig_invalid
	cmp	QWORD PTR [rdi + 144], 0
	je	Lmig_carrier
# frame: [rbp-8] target core (X19), [rbp-16] thread (X20); [rsp] the 4-byte policy tag
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rsi
	mov	rdi, QWORD PTR [rdi + 144]
	call	silica_rt_pthread_mach_thread_np
	mov	QWORD PTR [rbp - 16], rdi
	mov	eax, DWORD PTR [rbp - 8]
	mov	DWORD PTR [rsp], eax
	mov	rdi, QWORD PTR [rbp - 16]
	mov	esi, 4
	mov	rdx, rsp
	mov	ecx, 1
	call	silica_rt_thread_policy_set
	xor	edi, edi
	leave
	ret
Lmig_carrier:
# frame: [rbp-8] ACB (X19)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	rdi, rsi
	call	silica_rt_carrier_for_core
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_carrier_migrate
	leave
	ret
Lmig_invalid:
	mov	edi, 1
	ret
Lmig_not_found:
	mov	edi, 2
	ret
# -- End function
"
}

fn actor_rt_asm_chunk_13() -> string {
    "	.text
# get_actor_memory_usage lives in prims_actors_stack_asm.silica (four-field record).
	.globl	silica_rt_region_alloc
	.p2align	2
# -- Begin function silica_rt_region_alloc
silica_rt_region_alloc:
# rdi=size. Bump-allocates from the current actor's mmap region.
# Falls back to malloc if not in actor context. Result in rdi.
# frame: [rbp-8] rounded size (X19), [rbp-16] actor (X20); [rsp] mmap length across the call
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	lea	rax, [rdi + 7]
	and	rax, -8
	mov	QWORD PTR [rbp - 8], rax
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	LBBra_fallback
	mov	rax, QWORD PTR [rdi + 176]
	test	rax, rax
	jz	LBBra_grow
	mov	r10, QWORD PTR [rdi + 184]
	mov	r11, rax
	add	r11, QWORD PTR [rbp - 8]
	cmp	r11, r10
	ja	LBBra_grow
	mov	QWORD PTR [rdi + 176], r11
	mov	r10, QWORD PTR [rbp - 8]
	lock add	QWORD PTR [rip + silica_rt_heap_in_use], r10
	mov	rdi, rax
	leave
	ret
LBBra_grow:
# New block: 64 MB, or the request plus its header when larger. Anonymous RW mappings cost
# nothing until touched, so an idle actor still holds no arena memory. The old block's tail is
# wasted from here on, so the in-use count takes it now and dealloc_region subtracts it.
	test	rax, rax
	jz	LBBra_grow_map
	mov	r10, QWORD PTR [rdi + 184]
	sub	r10, rax
	lock add	QWORD PTR [rip + silica_rt_heap_in_use], r10
LBBra_grow_map:
	mov	r10, QWORD PTR [rbp - 8]
	add	r10, 32
	mov	r11, 67108864
	mov	rsi, r11
	cmp	r10, r11
	cmova	rsi, r10
	mov	QWORD PTR [rsp], rsi
	xor	edi, edi
	mov	edx, 3
	mov	ecx, 34
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	mov	rsi, QWORD PTR [rsp]
	cmp	rax, -1
	je	LBBra_grow_failed
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rdx, QWORD PTR [rcx + 160]
	mov	QWORD PTR [rax], rdx
	mov	QWORD PTR [rax + 8], rsi
	mov	QWORD PTR [rcx + 160], rax
	lea	r10, [rax + rsi]
	mov	QWORD PTR [rcx + 184], r10
	mov	r11, QWORD PTR [rcx + 168]
	add	r11, rsi
	mov	QWORD PTR [rcx + 168], r11
	lea	rdx, [rax + 16]
	mov	r11, rdx
	add	r11, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 176], r11
	mov	r10, QWORD PTR [rbp - 8]
	lock add	QWORD PTR [rip + silica_rt_heap_in_use], r10
	mov	rdi, rdx
	leave
	ret
LBBra_grow_failed:
	xor	edi, edi
	leave
	ret
LBBra_fallback:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	malloc
	test	rax, rax
	jz	LBBra_oom
	lea	rcx, [rip + silica_rt_region_list]
	mov	r10, QWORD PTR [rcx]
	mov	QWORD PTR [rax], r10
	mov	r10, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 8], r10
	mov	QWORD PTR [rcx], rax
	lock add	QWORD PTR [rip + silica_rt_heap_in_use], r10
	add	rax, 16
LBBra_oom:
	mov	rdi, rax
	leave
	ret
	.globl	silica_rt_heap_used
silica_rt_heap_used:
# -> rdi (X0) = bytes handed out by silica_rt_region_alloc and not yet released: every arena bump
# an actor made (its blocks go back together when it ends, in silica_rt_actor_dealloc_region)
# plus every fallback allocation made outside an actor, which is never released. Requests, not
# resident pages: a block is mapped lazily. The heap_used() builtin.
	mov	rdi, QWORD PTR [rip + silica_rt_heap_in_use]
	ret
	.globl	silica_rt_raw_alloc
silica_rt_raw_alloc:
# rdi=size. malloc with a [next][size] header, NOT linked into the global region
# list. Region memory must be freeable by its owner; anything on that list can
# only be freed by unwinding to a mark, which is scope-shaped and unsound here.
# frame: [rbp-8] size (X19)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	add	rdi, 16
	call	malloc
	test	rax, rax
	jz	LBBrw_oom
	mov	QWORD PTR [rax], 0
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 8], rcx
	add	rax, 16
LBBrw_oom:
	mov	rdi, rax
	leave
	ret
	.globl	silica_rt_region_destroy
silica_rt_region_destroy:
# rdi=region handle. Frees every extension block on the [r+16] chain, then the
# region header. Blocks come from silica_rt_raw_alloc, so each malloc base is
# payload-16. Null handle is a no-op so a moved-out region is safe to skip.
# frame: [rbp-8] region (X19), [rbp-16] block (X20), [rbp-24] next block (X21)
# A canonical arena (silica_rt_canonical_arena_lookup) is process-shared and belongs to the
# canonical arena table, which hands the same base out to every lookup of its key for the life of
# the process. A function that received one as a parameter owns the handle (spec 4.4.2) and
# destroys it when it does not move on, exactly as for any region; the arena itself must survive
# that, so the table is consulted first and a registered base is left untouched (LBBrd_canonical).
# Freeing it here used to hand a non-malloc block to free (allocator abort).
	test	rdi, rdi
	jz	LBBrd_ret
	lea	rax, [rip + silica_rt_canonical_arena_table]
	mov	ecx, 512
LBBrd_cscan:
	cmp	QWORD PTR [rax + 8], rdi
	je	LBBrd_canonical
	add	rax, 16
	dec	ecx
	jnz	LBBrd_cscan
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 16]
	mov	QWORD PTR [rbp - 16], rax
LBBrd_loop:
	mov	rdi, QWORD PTR [rbp - 16]
	test	rdi, rdi
	jz	LBBrd_hdr
	mov	rax, QWORD PTR [rdi + 16]
	mov	QWORD PTR [rbp - 24], rax
	sub	rdi, 16
	call	free
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rbp - 16], rax
	jmp	LBBrd_loop
LBBrd_hdr:
	mov	rdi, QWORD PTR [rbp - 8]
	sub	rdi, 16
	call	free
	leave
LBBrd_ret:
	ret
LBBrd_canonical:
# Deliberate no-op: the canonical arena stays registered and usable by its key.
	ret
	.globl	silica_rt_region_mark
silica_rt_region_mark:
# -> rax (X16) = current head of silica_rt_region_list; nothing else touched.
	mov	rax, QWORD PTR [rip + silica_rt_region_list]
	ret
	.globl	silica_rt_region_release_to
silica_rt_region_release_to:
# rax (X16) = mark. Frees list cells down to the mark; preserves rdi/rsi (X0/X1).
# frame: [rbp-8] &silica_rt_region_list (X19), [rbp-16] cell (X20), [rbp-24] mark (X21); [rsp] rdi, [rsp+8] rsi
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rsp], rdi
	mov	QWORD PTR [rsp + 8], rsi
	mov	QWORD PTR [rbp - 24], rax
	lea	rax, [rip + silica_rt_region_list]
	mov	QWORD PTR [rbp - 8], rax
	mov	rcx, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 16], rcx
Lrrt_loop:
	mov	rcx, QWORD PTR [rbp - 16]
	cmp	rcx, QWORD PTR [rbp - 24]
	je	Lrrt_done
	test	rcx, rcx
	jz	Lrrt_done
	mov	rsi, QWORD PTR [rcx]
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], rsi
	mov	rdi, rcx
	mov	QWORD PTR [rbp - 16], rsi
	call	free
	jmp	Lrrt_loop
Lrrt_done:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax], rcx
	mov	rdi, QWORD PTR [rsp]
	mov	rsi, QWORD PTR [rsp + 8]
	leave
	ret
	.globl	silica_rt_region_list
	.comm	silica_rt_region_list,8,8
	.globl	silica_rt_heap_in_use
	.comm	silica_rt_heap_in_use,8,8
# -- End function
	.globl	silica_rt_actor_supervision_ingress_enqueue
	.p2align	2
# Phase B: synthetic exit / trial hook; bounded queue
silica_rt_actor_supervision_ingress_enqueue:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_actor_supervision_ingress_enqueue_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_actor_supervision_ingress_enqueue_acb:
# rdi=target actor_ref, rsi=int64 payload -> rdi=:ok (0). Cast-shaped 152 B node; +8 = inline int64; +24 = 1 (trial; not heap payload).
# frame: [rbp-8] actor (X19), [rbp-16] node (X20), [rbp-24] payload (X21)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 24], rsi
	test	rdi, rdi
	jz	Lsie_fail_nolock
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sb_require
	mov	r10d, DWORD PTR [rdi + 16]
	cmp	r10d, 1024
	jae	Lsie_abort
	mov	edi, 1
	mov	esi, 152
	call	calloc
	test	rax, rax
	jz	Lsie_unlock_fail
	mov	QWORD PTR [rbp - 16], rax
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 8], rcx
	mov	DWORD PTR [rax + 16], 0
	mov	DWORD PTR [rax + 24], 1
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rdi + 216]
	mov	rsi, rax
	call	silica_rt_q_enqueue_locked
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 216]
	mov	r10d, DWORD PTR [rcx + 16]
	add	r10d, 1
	mov	DWORD PTR [rcx + 16], r10d
	mov	rdi, rax
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	xor	edi, edi
	leave
	ret
Lsie_unlock_fail:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Lsie_fail_nolock:
	xor	edi, edi
	leave
	ret
Lsie_abort:
	call	silica_rt_abort_ingress_full
# -- End function
	.globl	silica_rt_sb_require
	.p2align	2
silica_rt_sb_require:
# rdi = ACB -> rdi = its supervision block (SB, 144 B: +0/+8 ingress front/rear, +16 depth u32,
# +24 child-table head, +32 len, +40 sync_failure_reported, +48 start trampoline, +56 strategy,
# +64 allowed restarts, +72 time frame, +80 restart count, +88 window start, +96/+104 unused,
# +112 references: sb_unref, +120 the holder of the restart token (0 free; the protocol in
# prims_actors_child_table_asm.silica's header), +128 the carrier actors parked for the token,
# +136 unused), made now when the
# actor had none: by spawn for an actor with a trampoline, by the ingress enqueue for any other
# actor that receives an exit notice (an add_child parent; the caller holds the target's lock),
# by the child-table paths for the running actor. Freed by its last reference (sb_unref).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	rdi, QWORD PTR [rdi + 216]
	test	rdi, rdi
	jnz	Lsbr_have
	mov	edi, 1
	mov	esi, 144
	call	calloc
	mov	rdi, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rdi + 216], rax
	mov	rdi, rax
	mov	QWORD PTR [rdi + 112], 1
Lsbr_have:
	leave
	ret
	.globl	silica_rt_actor_recv
	.p2align	2
# Phase B/C/G: ingress then standard; spec 15.4.8.6 DOWN only on standard
silica_rt_actor_recv:
# TLS current actor: dequeue next message (supervision ingress first, then standard mailbox). Return rdi = message node or 0.
# frame: [rbp-8] actor (X19), [rbp-16] node (X20)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	Lrecv_done_null
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rdi + 216]
	mov	QWORD PTR [rbp - 16], 0
	test	rdi, rdi
	jz	Lrecv_try_std
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	Lrecv_try_std
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r10d, DWORD PTR [rax + 16]
	sub	r10d, 1
	mov	DWORD PTR [rax + 16], r10d
# An exit notice handed to the program keeps no hold on the ended actor.
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 16]
	cmp	DWORD PTR [rax + 24], 0
	jne	Lrecv_ret_node
	mov	rax, QWORD PTR [rax + 8]
	test	rax, rax
	jz	Lrecv_ret_node
	mov	rdi, QWORD PTR [rax]
	call	silica_rt_acb_release
	jmp	Lrecv_ret_node
Lrecv_try_std:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 128
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
Lrecv_unlock_node:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Lrecv_ret_node:
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
Lrecv_done_null:
	xor	edi, edi
	leave
	ret
# -- End function
	.globl	silica_rt_actor_add_child
	.p2align	2
# Explicit supervisor child registration
silica_rt_actor_add_child:
# rdi = parent reference, rsi = child reference: both held for the body.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 24], rsi
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 8], rdi
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 16], rdi
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_add_child_acb
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_acb_release
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_acb_release
	xor	edi, edi
	leave
	ret
	.p2align	2
silica_rt_actor_add_child_acb:
# rdi=parent supervisor ACB, rsi=child ACB (either may be 0) -> rdi=atom :ok.
# Records the explicit parent/child relationship used by supervisor ingress teardown.
# frame: [rbp-8] parent (X19), [rbp-16] child (X20)
	test	rdi, rdi
	jz	Ladd_child_done
	test	rsi, rsi
	jz	Ladd_child_done
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	cmp	QWORD PTR [rsi + 192], rdi
	je	Ladd_child_held
# The child holds its supervisor until its exit path is done with it (silica_rt_actor_final_release).
	lock add	QWORD PTR [rdi + 392], 1
	mov	rax, rdi
	xchg	QWORD PTR [rsi + 192], rax
	mov	rdi, rax
	call	silica_rt_acb_release
Ladd_child_held:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	lea	rdi, [rax + 16]
	call	silica_rt_lock_unlock
	leave
Ladd_child_done:
	xor	edi, edi
	ret
# -- End function
	.globl	silica_rt_actor_link
	.p2align	2
# Phase G: spec 15.4.8.4-8.5
silica_rt_actor_link:
# rdi=target actor_ref -> rdi=0; the emitter answers :ok (prims_actors emit_prim_op_with_atoms). Idempotent link; dead target must enqueue exit (ingress if supervisor) -- stub.
	xor	edi, edi
	ret
# -- End function
	.globl	silica_rt_actor_monitor
	.p2align	2
# Phase G: spec 15.4.8.6
silica_rt_actor_monitor:
# rdi=target -> rdi=monitor_ref. Real runtime: DOWN (:down, ref, target, reason) to standard mailbox only, not ingress.
	ret
# -- End function
	.globl	silica_rt_actor_demonitor
	.p2align	2
# Phase G: spec 15.4.8.6-8.7
silica_rt_actor_demonitor:
# rdi=monitor_ref -> rdi=0; the emitter answers :ok
	xor	edi, edi
	ret
# -- End function
"
}
