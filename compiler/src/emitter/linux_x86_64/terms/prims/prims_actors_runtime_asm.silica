// Compiler-bundled actor runtime: x86-64 assembly text maintained here (Silica string chunks).
// linux_x86_64 port of emitter/linux_aarch64: GNU/ELF Intel syntax (`.intel_syntax noprefix` is emitted
// by the unit prelude), undecorated symbols, and Linux x86-64 syscalls (numbers per the port guide).
// Links against glibc (calloc, free, pthread_*, sigaction, dladdr, ...). Darwin-only APIs
// (os_unfair_lock, __ulock_wait/wake, sysctlbyname, thread_policy_set, pthread QoS) are routed to
// the futex / sysconf / affinity shims in linux_rt_shims_asm.silica (silica_rt_lock_*,
// silica_rt_futex_*, silica_rt_sysctlbyname, silica_rt_thread_policy_set, ...).
// Calling conventions: every silica_rt_* routine (shims included) reads its arguments in the internal
// homes X0..X7 = rdi rsi rdx rcx r8 r9 r14 r15 and returns its result in rdi (X0), never rax; only C
// library results arrive in rax. Behaviours and trampolines are entered with rdi/rsi/rdx and clobber
// every register except rbp/rsp, so the AArch64 callee-saved values x19..x28 live in frame slots
// [rbp-8]..[rbp-80] (x8 -> rbx, x9..x12 -> r10 r11 r12 r13, x13..x17 -> rax). Routines that C calls
// back (actor_thread_main as the pthread start routine) additionally preserve rbx r12-r15 below the
// slots and return in rax. Chunks 9-13 live in prims_actors_runtime_asm_b; the cv / phase_c / phase_f
// / pid_registry / phase_i / badarith / case_clause chunks live in prims_actors_runtime_asm_c.
// Thread-local current actor pointer is stored via pthread_key_t (silica_actor_pthread_key), not Mach-O TLV
// (__thread/__tlv_bootstrap), so linker TLVP_* lowering cannot break pthread entry.
// Phase E e4f: per-actor mutex + scheduler CV use a 4 B lock word + futex seq word (not pthread_mutex_t /
// pthread_cond_t) — see actor_rt_asm_cv_chunk and supervisors_implementation_development_plan.md.
// cpu_topology / cache / NUMA helpers (silica_rt_apple_*, sysctl hw.*): answered by the sysctl shim (cpuid / sysconf) on this target (see cpu_topology_implementation_plan Phase G).
// ABI: spawn(X0,X1,X2)->X0  send(X0,X1)  cast(X0,X1)->W0  call(X0,X1)->X0  self()->X0  recv()->X0
// X2=optional core_id (0 default) per §15.1.1, X4=packed stack_policy (0 = inherit the spawner's; see prims_actors_stack_asm).
// Actor control block 528 B (actor_memory_budget_plan.md item I, 2026-10-09: 512 before; 2026-10-12 +16 for
// the holder count and the parked exit notice; 2026-10-19 +32 for the carrier fields, item N, +16 for
// the wait-list word of the restart protocol, +16 for the thread record, item N stage 2, and +16 for the
// pending migration target, stage 3): +0..+215 the
// actor runtime's, +216 the supervision block pointer (SB, 144 B, only a supervisor has one; layout at
// silica_rt_sb_require in prims_actors_runtime_asm_b), +224 started flag, +232 pending exit reason_tag,
// +240 active call wrapper, +248/+256/+264 FFI arena base/end/bump (Phase 12), +272..+391 the
// runtime-managed stack fields (prims_actors_stack_asm.silica). A worker carries no supervision field.
// +392 holders of the block (_silica_rt_acb_release), +400 a row child's parked exit notice (0 not yet
// committed to its row, 1 committed or not a row child, else the notice).
// +408 the actor's identity (spec §15.1.4: position << 32 | child number; what every reference to it is),
// +416/+424 its spawner record (position + 1, 0 none yet; next child number) unless it is a row child,
// whose record is its row's +96/+104 (actor_rt_identity_chunk in prims_actors_runtime_asm_c).
// #432 the calling convention recorded at spawn (spec §16.2.6.4; silica_rt_beh_convention: 0 not
// checked, 1 call-only, 2 cast-only).
// #440..#495 the carrier fields (prims_actors_carrier_asm.silica, item N): #440 the carrier
// block (0 = a dangerous actor, which has a thread of its own; every other actor, supervisors and
// the registries included, is bound to a carrier), #448 status (1 idle, 2 ready, 3 running, 4 parked,
// 5 idle on the carrier's sweep list, 6 sweeping: off that list, its stack about to be released),
// #456 run-queue link (the link in a wait list while parked for a row
// child's exit_done, row +120, or for a supervisor's restart token, block +128), #464 the SP of a
// parked context, #472 the actor parked in a spawn waiting for this one to start, #480 the wait list
// (the address of its head word) the actor is parked on, 0 when none: a stop (silica_rt_actor_stop)
// unlinks and wakes it. #496/#504 the thread record of a dangerous actor, which has a thread of its
// own (the pthread key names it: the thread's current actor, and 0 = not a carrier's thread;
// silica_rt_tls_record_set); unused for a carrier actor, whose carrier's block holds its thread's
// record. #512 the pending migration target (a carrier block, 0 none; item N stage 3), #520 the
// priority level (item N stage 4; spec §22.10: 0 low, 1 normal, 2 high; every actor starts at normal,
// stored right after both callocs below). Control block 528 B.
// The dispatch frame of actor_thread_main ([rbp-8] the actor, [rbp-16] the node, [rbp-24] the
// reply, [rbp-32] the ingress flag, [rbp-40] the state, [rbp-56] the exit payload, [rbp-64] the
// carrier) is at a fixed place on a carrier's stack, rbp = the carrier's base - 16, and is saved
// and restored with a parked actor's context (prims_actors_carrier_asm.silica header).
// spawn_linked Phase A (supervisors_implementation_development_plan): spawn_linked(X0,X1,X2,X3,X4)->X0
// X0=init X1=beh X2=agent_type (int64) X3=row/core metadata (0 default), X4=optional supervisor trampoline.
// Offsets: #192 supervisor actor_ref (0 root), #200 agent_type atom, #208 core_id, #216 supervision block (0 for a worker),
// #224 started flag.
// Mailboxes (supervisors_implementation_development_plan §4 Phase B; §15.4.9, §16.2.7):
// Each mailbox is a two-list functional queue (front, rear). Enqueue = prepend node to `rear`; dequeue = pop from
// `front`; when `front` is empty on a dequeue, `rear` is reversed in place to become the new `front` and `rear` is
// cleared. Standard mailbox pair at (#128 front, #136 rear). Supervision ingress pair at (SB #0 front, #8 rear),
// with u32 depth at SB #16 (bounded; overflow is a runtime abort, silica_rt_abort_ingress_full).
// 152 B message nodes: #24 ingress_kind — 0 = structured child-exit heap payload ptr at #8 (Phase C; auto-restart reads #8);
// non-zero = Phase B trial hook only: #8 holds inline int64 (not a pointer; sup_beh must run; skip maybe_restart).
// Phase E e3a: child table anchors at SB #24 head ptr, #32 len (high-water row count),
// SB #40 sync_failure_reported (0/1; root restart-cap escalation reports before replying, thread exit skips duplicate);
// rows are singly-linked nodes (88 B: 80 B row + next@+80), no realloc — stable row pointers (Option B).
// Phase E e3b: SB #48 = trampoline fn ptr (silica_supervisor_start_<T>), ACB #224 = started flag (0/1, every actor).
// Phase E e3d: SB #56 = strategy atom (set by materialize from init tuple+0).
// Phase E e3e: SB #64 = allowed_restart_count (i64), #72 = restarts_time_frame (i64, seconds),
//              #80 = restart_count (current window), #88 = window_start_time (seconds, from time()).
// Phase E e4b: ACB #232 = pending_exit_reason_tag (i64; 0=:normal default, !=0=abnormal). `silica_rt_actor_kill_abnormal` writes 1; `silica_rt_actor_deliver_exit` reads → payload[+8].
// ACB #240 = active_call_wrapper (0 unless the currently-running behavior is servicing a call; used to wake callers during actor-death teardown).
// Scheduler: actor_thread_main dequeues ingress before standard mailbox each message; recv() matches.
// Phase B trial hook: silica_rt_actor_supervision_ingress_enqueue(X0 actor, X1 int64 payload) → X0 atom :ok.
// Supervisors Phase G (same plan §4 Phase G; silica-specification §15.4.8.4–8.7): link(X0), monitor(X0), demonitor(X0) —
// ABI for runtime; full idempotent link graph, dead-target handling, and DOWN → standard mailbox are implemented in the
// same symbols below (stubs return benign values until runtime fills behavior).
// Phase C (§15.4.10–§15.4.11, §16.2.7): structured exit notifications → ingress; dead supervisor drops notification
// and routes the unwind note to stderr (§15.4.10.4). Payload (32 B heap): [+0]=child_ref, [+8]=reason_tag,
// [+16]=reason_atom, [+24]=agent_type. Runtime entry: `silica_rt_actor_deliver_exit(X0=child) → X0=0 delivered
// or 1 needs stderr`. Behavior-only trial accessors (`supervision_wait_and_drain_one`, `failure_reason_tag`,
// `failure_agent_type`, `failure_release`) surface the payload for integration tests.

use prims_actors_child_table_asm;
use prims_actors_stack_asm;
use prims_actors_carrier_asm;
use atom_table;
use ffi_arena_runtime_asm;
use ffi_guarded_runtime_asm;
use ffi_fault_runtime_asm;
use canonical_arena_runtime_asm;
use ordering_identity_runtime_asm;
use checked_int64_runtime_asm;
use linux_rt_shims_asm;
use prims_actors_runtime_asm_b;
use prims_actors_runtime_asm_c;

export emit_actor_runtime_helpers/1;

fn actor_rt_asm_chunk_0() -> string {
    "	.text
	.globl	silica_rt_actor_spawn_dangerous
	.p2align	2
silica_rt_actor_spawn_dangerous:
# spawn_dangerous / spawn_dangerous_registered: X0-X4 as silica_rt_actor_spawn, X5 (r9) = 1: the
# actor keeps a thread of its own (its foreign calls may block, and its guarded-FFI state is per
# thread: spec §15.4.13.5; prims_actors_carrier_asm.silica header). Every other spawn binds to a
# carrier.
	mov	r9d, 1
	jmp	Lsp_entry
	.globl	silica_rt_actor_spawn # -- Begin function silica_rt_actor_spawn
	.p2align	2
silica_rt_actor_spawn: # @silica_rt_actor_spawn
# X0..X4 = rdi rsi rdx rcx r8. x19..x26 live in the frame: [rbp-8] acb, [rbp-16] beh, [rbp-24] init,
# [rbp-32] w22 (=1), [rbp-40] core_id / pthread_create rc, [rbp-48] trampoline, [rbp-56] stack_policy,
# [rbp-72] 1 for a dangerous actor (X5 = r9, x26).
	xor	r9d, r9d
Lsp_entry:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 72], r9
	mov	QWORD PTR [rbp - 56], r8
	mov	QWORD PTR [rbp - 48], rcx
	mov	QWORD PTR [rbp - 40], rdx
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdi
	mov	QWORD PTR [rbp - 32], 1
	mov	edi, 1
	mov	esi, 544
	call	calloc
	mov	rdi, rax
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	LBB0_4
# %bb.1:
# Every actor starts at priority :normal (#520 = 1; spec §22.10).
	mov	QWORD PTR [rdi + 520], 1
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rdi], rax
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rdi + 8], rax
# Spec §16.2.6.4: record the behaviour's calling convention; call/cast compare it before enqueuing.
	call	silica_rt_beh_convention
	mov	QWORD PTR [rdi + 432], rax
	mov	QWORD PTR [rdi + 192], 0
	mov	QWORD PTR [rdi + 200], 0
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rdi + 208], rax
# Holders of the control block (#392, silica_rt_acb_release): the actor's own thread and this
# spawner. #400 = 1: no supervisor's row will commit this actor, so its exit notice is never parked.
	mov	QWORD PTR [rdi + 392], 2
	mov	QWORD PTR [rdi + 400], 1
# Identity (§15.1.4): numbered by the spawning actor (main when there is none) and entered in the
# identity table before the thread exists. A supervisor takes its own position now, in its
# spawner's order (root supervisors: 1, 2, ... as main starts them).
	call	silica_rt_tls_current_actor_get
	call	silica_rt_spawner_rec
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_ident_assign
	test	rdi, rdi
	jnz	LBB0_ident_failed
	cmp	QWORD PTR [rbp - 48], 0
	je	Lsp0_ident_done
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 416
	call	silica_rt_spawner_position
Lsp0_ident_done:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rbp - 48]
	test	rax, rax
	jz	Lsp0_no_sb
	call	silica_rt_sb_require
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rdi + 48], rax
	mov	rdi, QWORD PTR [rbp - 8]
Lsp0_no_sb:
# Phase E e4f: ACB+16 is the 4 B lock word and ACB+80 is a 4 B futex seq word.
# Both are zero from calloc above (unlocked == 0); no init call needed.
	mov	DWORD PTR [rdi + 152], 1
# The reservation, the fault handlers and the arena bookkeeping exist before the thread does:
# its first instruction on the actor stack faults, and the handler must already be installed.
	mov	rsi, QWORD PTR [rbp - 56]
	call	silica_rt_actor_stack_reserve
	test	rdi, rdi
	jnz	LBB0_reserve_failed
	call	silica_rt_install_sync_fault_handlers
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_init_region
# Item N: the actor is bound to a carrier (idle and started; a supervisor, [rbp-48] = its
# trampoline, is made ready instead and runs the trampoline in its first dispatch). Only a
# dangerous actor ([rbp-72]) gets a thread of its own, below.
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 48]
	mov	rdx, QWORD PTR [rbp - 72]
	call	silica_rt_carrier_adopt
	test	rdi, rdi
	jnz	LBB0_adopted
	sub	rsp, 64
	mov	rdi, rsp
	call	pthread_attr_init
	mov	rdi, rsp
	mov	esi, 0x20000
	call	pthread_attr_setstacksize
	lea	rdx, [rip + actor_thread_main]
	mov	rcx, QWORD PTR [rbp - 8]
	lea	rdi, [rcx + 144]
	mov	rsi, rsp
	call	pthread_create
	mov	edi, eax
	mov	QWORD PTR [rbp - 40], rdi
	mov	rdi, rsp
	call	pthread_attr_destroy
	add	rsp, 64
	cmp	QWORD PTR [rbp - 40], 0
	je	LBB0_3
# %bb.2: the host refused the thread. What this spawn took goes back (identity, reservation,
# alternate stack, control block; nothing else was taken for a dangerous actor), then the spawner
# fails with (:explicit, :thread_limit), or main aborts: silica_rt_spawn_thread_failed
# (actor_memory_budget_plan.md item N, #5 option C). Never returns here.
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_idt_remove
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	call	silica_rt_actor_stack_free
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	call	silica_rt_spawn_thread_failed
LBB0_ident_failed:
	mov	QWORD PTR [rbp - 64], rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	mov	QWORD PTR [rbp - 8], 0
	cmp	QWORD PTR [rbp - 64], 1
	jne	LBB0_4
	call	silica_rt_identity_exhausted
LBB0_reserve_failed:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_idt_remove
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	call	silica_rt_spawn_reserve_failed
LBB0_3:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 144]
	call	pthread_detach
LBB0_adopted:
# Phase E: the supervisor trampoline (SB#48) runs in the actor's first dispatch on its carrier (or
# on the new thread of a dangerous actor); wait until #224 is set so callers see a materialized
# child table before receiving the actor_ref (a carrier actor spawning parks instead of spinning,
# main spins: silica_rt_spawn_wait_started).
	cmp	QWORD PTR [rbp - 48], 0
	je	LBB0_4
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_spawn_wait_started
# 2 = the trampoline failed and the actor has ended: the spawn returns silica_rt_dead_acb
# (silica_rt_spawner_let_go), and the actor's own block goes with its last holder.
LBB0_4:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_spawner_let_go
	mov	QWORD PTR [rbp - 8], rdi
# Phase I: wait_for_exit consults silica_rt_wait_root_acb (+#152 alive). Only top-level spawn()
# registers here; spawn_linked workers must not steal the slot (see LBBsl_4).
	mov	rax, QWORD PTR [rbp - 8]
	test	rax, rax
	jz	LBB0_wr_skip
LBB0_wr_try:
	lea	rbx, [rip + silica_rt_wait_root_acb]
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jnz	LBB0_wr_skip
	mov	QWORD PTR [rbx], rax
LBB0_wr_skip:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
                                        # -- End function
	.globl	silica_rt_actor_spawn_linked # Phase A: supervision metadata (supervisors_implementation_development_plan.md §A)
	.p2align	2
silica_rt_actor_spawn_linked: # @silica_rt_actor_spawn_linked
# X0..X4 = rdi rsi rdx rcx r8. Frame: [rbp-8] acb, [rbp-16] beh, [rbp-24] init / parent (0),
# [rbp-32] trampoline, [rbp-40] agent_type / pthread_create rc, [rbp-48] row/core metadata,
# [rbp-56] supervisor (X5 = r9 from spawn_linked_row; 0 here), [rbp-72] 1 for a dangerous actor
# (X6 = r14: spawn_dangerous_linked, a :dangerous row; it keeps a thread of its own, every other
# actor is bound to a carrier). The plain entry lets go of the child (silica_rt_spawner_let_go);
# spawn_linked_row's caller commits it to its row first.
	xor	r14d, r14d
Lsl_entry:
	xor	r9d, r9d
	push	rbp
	mov	rbp, rsp
	call	LBBsl_common
	call	silica_rt_spawner_let_go
	leave
	ret
LBBsl_common:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 72], r14
	mov	QWORD PTR [rbp - 56], r9
	mov	QWORD PTR [rbp - 40], rdx
	mov	QWORD PTR [rbp - 48], rcx
	mov	QWORD PTR [rbp - 32], r8
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdi
	mov	edi, 1
	mov	esi, 544
	call	calloc
	mov	rdi, rax
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	LBBsl_4
# Every actor starts at priority :normal (#520 = 1; spec §22.10).
	mov	QWORD PTR [rdi + 520], 1
	mov	rax, rdi
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 8], rcx
# Spec §16.2.6.4: record the behaviour's calling convention; call/cast compare it before enqueuing.
	push	rax
	mov	rax, rcx
	call	silica_rt_beh_convention
	mov	rcx, rax
	pop	rax
	mov	QWORD PTR [rax + 432], rcx
# The supervisor ([rbp-56]; 0 from a plain spawn_linked) is recorded before the child's thread
# exists: a child that ends at once must find it, and its row, on every exit path.
	mov	rcx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax + 192], rcx
	mov	QWORD PTR [rbp - 24], 0
	xor	edi, edi
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 200], rcx
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 208], rcx
# Holders (#392): the child's own thread and this spawner; the child holds its supervisor until its
# exit path is done with it. #400 = 0 for a row child (its spawner commits it to the row,
# silica_rt_supervisor_spawn_child_row_by_flavor), 1 otherwise.
	mov	QWORD PTR [rax + 392], 2
	xor	ecx, ecx
	cmp	QWORD PTR [rbp - 56], 0
	sete	cl
	mov	QWORD PTR [rax + 400], rcx
	mov	rcx, QWORD PTR [rbp - 56]
	test	rcx, rcx
	jz	Lsp1_no_parent_hold
	lock add	QWORD PTR [rcx + 392], 1
Lsp1_no_parent_hold:
# Identity (§15.1.4): a row child is numbered by its supervisor ([rbp-56]), anything else by the
# spawning actor; the row records its child's identity at +112. A supervisor takes its own position now.
	mov	rdi, QWORD PTR [rbp - 56]
	test	rdi, rdi
	jnz	Lslid_rec
	call	silica_rt_tls_current_actor_get
Lslid_rec:
	call	silica_rt_spawner_rec
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_ident_assign
	test	rdi, rdi
	jnz	LBBsl_ident_failed
	cmp	QWORD PTR [rbp - 56], 0
	je	Lslid_no_row
	mov	rcx, QWORD PTR [rbp - 48]
	cmp	rcx, 4096
	jb	Lslid_no_row
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 408]
	mov	QWORD PTR [rcx + 112], rax
Lslid_no_row:
	cmp	QWORD PTR [rbp - 32], 0
	je	Lslid_no_pos
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_spawner_rec
	call	silica_rt_spawner_position
Lslid_no_pos:
	mov	rax, QWORD PTR [rbp - 8]
	xor	edi, edi
	mov	rcx, QWORD PTR [rbp - 32]
	test	rcx, rcx
	jz	Lsp1_no_sb
	mov	rdi, rax
	call	silica_rt_sb_require
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rdi + 48], rcx
	mov	rax, QWORD PTR [rbp - 8]
	xor	edi, edi
Lsp1_no_sb:
	test	rdi, rdi
	jz	Lslp_skip_list
	sub	rsp, 16
	mov	QWORD PTR [rsp + 8], rdi
	mov	rsi, QWORD PTR [rsp + 8]
	lea	rdi, [rsi + 16]
	call	silica_rt_lock_lock
	mov	rsi, QWORD PTR [rsp + 8]
	lea	rdi, [rsi + 16]
	call	silica_rt_lock_unlock
	add	rsp, 16
Lslp_skip_list:
# Phase E e4f: ACB+16 (lock word) and ACB+80 (futex seq word) are pre-zeroed by calloc.
# Unlocked == 0, seq baseline 0; no init call required.
	mov	rax, QWORD PTR [rbp - 8]
	mov	DWORD PTR [rax + 152], 1
# Children started from child specs inherit the spawning actor's stack policy: a row child its
# supervisor's ([rbp-56], #360; the default, 2, when it has none), named here rather than read from
# the thread's current actor (rsi = 0), since a row is respawned from any actor's drain of the
# supervisor's ingress (prims_actors_child_table_asm.silica, supervisor_drain_ingress), which no
# longer installs the supervisor as the current actor; anything else the current actor's.
	mov	rdi, rax
	xor	esi, esi
	mov	rcx, QWORD PTR [rbp - 56]
	test	rcx, rcx
	jz	Lslp_policy
	mov	rsi, QWORD PTR [rcx + 360]
	test	rsi, rsi
	jnz	Lslp_policy
	mov	esi, 2
Lslp_policy:
	call	silica_rt_actor_stack_reserve
	test	rdi, rdi
	jnz	LBBsl_reserve_failed
	call	silica_rt_install_sync_fault_handlers
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_init_region
# Item N: bound to a carrier (a supervisor child, [rbp-32] = its trampoline, made ready for its
# first dispatch); a dangerous actor ([rbp-72]) gets a thread of its own, below.
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 32]
	mov	rdx, QWORD PTR [rbp - 72]
	call	silica_rt_carrier_adopt
	test	rdi, rdi
	jnz	LBBsl_adopted
	sub	rsp, 64
	mov	rdi, rsp
	call	pthread_attr_init
	mov	rdi, rsp
	mov	esi, 0x20000
	call	pthread_attr_setstacksize
	lea	rdx, [rip + actor_thread_main]
	mov	rcx, QWORD PTR [rbp - 8]
	lea	rdi, [rcx + 144]
	mov	rsi, rsp
	call	pthread_create
	mov	edi, eax
	mov	QWORD PTR [rbp - 40], rdi
	mov	rdi, rsp
	call	pthread_attr_destroy
	add	rsp, 64
	cmp	QWORD PTR [rbp - 40], 0
	je	LBBsl_3
# The host refused the thread of a :dangerous row child (or of spawn_dangerous_linked). What this
# spawn took goes back: identity, reservation, alternate stack, control block, the hold on the
# supervisor, and for a row child the reference on the supervision block that
# silica_rt_actor_spawn_linked_row took (a 0 return would have given it back there). Then the
# spawner (the supervisor in its start, a drainer at a respawn) fails with (:explicit, :thread_limit),
# or main aborts: silica_rt_spawn_thread_failed never returns.
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_idt_remove
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	call	silica_rt_actor_stack_free
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	mov	rdi, QWORD PTR [rbp - 56]
	call	silica_rt_acb_release
	cmp	QWORD PTR [rbp - 56], 0
	je	LBBsl_thread_failed
	mov	rax, QWORD PTR [rbp - 48]
	cmp	rax, 4096
	jb	LBBsl_thread_failed
	mov	rdi, QWORD PTR [rax + 88]
	call	silica_rt_sb_unref
LBBsl_thread_failed:
	call	silica_rt_spawn_thread_failed
LBBsl_ident_failed:
	mov	QWORD PTR [rbp - 64], rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	mov	rdi, QWORD PTR [rbp - 56]
	call	silica_rt_acb_release
	mov	QWORD PTR [rbp - 8], 0
	cmp	QWORD PTR [rbp - 64], 1
	jne	LBBsl_4
	call	silica_rt_identity_exhausted
LBBsl_reserve_failed:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_idt_remove
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	mov	rdi, QWORD PTR [rbp - 56]
	call	silica_rt_acb_release
	call	silica_rt_spawn_reserve_failed
LBBsl_3:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 144]
	call	pthread_detach
LBBsl_adopted:
# Phase E e4f: wait until the new actor has started (ACB #224 == 1: at adoption for a plain
# actor; after its trampoline, in its first dispatch, for a supervisor child; after the TLS
# init of its thread for a dangerous actor). Keeps spawn ordering strictly sequential: the
# supervisor never overlaps two children's startup. A carrier actor spawning parks instead of
# spinning.
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_spawn_wait_started
LBBsl_4:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
                                        # -- End function
	.globl	silica_rt_actor_spawn_dangerous_linked
	.p2align	2
silica_rt_actor_spawn_dangerous_linked:
	mov	r14d, 1
	jmp	Lsl_entry
	.globl	silica_rt_actor_spawn_linked_row
	.p2align	2
silica_rt_actor_spawn_linked_row:
# A supervisor starts the child of one of its rows: X0-X4 as spawn_linked, X3 (rcx) = the row,
# X5 (r9) = the supervisor's ACB, X6 (r14) = 1 for a :dangerous row (passed through to
# LBBsl_common untouched). The child's reference on the supervision block (the row's +88) is
# taken here, before its thread can run and end; a spawn that fails gives it back.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rcx
	mov	rax, QWORD PTR [rcx + 88]
	lock add	QWORD PTR [rax + 112], 1
	call	LBBsl_common
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jnz	Lslr_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 88]
	call	silica_rt_sb_unref
Lslr_done:
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
	.p2align	2 # -- Begin function actor_thread_main
actor_thread_main: # @actor_thread_main
"
}

fn actor_rt_asm_chunk_1() -> string {
    "# pthread start routine (SysV callee): rdi = ACB; returns rax = 0. Saves rbx r12-r15 below the
# x19..x25 frame slots ([rbp-8] acb, [rbp-16] message / exit flag, [rbp-24] w21 ingress flag / reply,
# [rbp-32] w22, [rbp-40] x23, [rbp-56] x25). Behaviours run with rdi = message, rsi = state,
# rdx = sret and return the result pointer in rdi; nothing else survives the call.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 128
	mov	QWORD PTR [rbp - 88], rbx
	mov	QWORD PTR [rbp - 96], r12
	mov	QWORD PTR [rbp - 104], r13
	mov	QWORD PTR [rbp - 112], r14
	mov	QWORD PTR [rbp - 120], r15
	mov	QWORD PTR [rbp - 8], rdi
# The thread of a dangerous actor (the only actor with one; prims_actors_carrier_asm.silica
# header). This thread's record (item N stage 2): the current actor is this actor, and it is no
# carrier's; [rbp-64] (x24, the carrier of the dispatch) is 0 for the actor's life. #528 = this
# frame's rsp (rbp - 128) on the thread's own (pthread) stack: every path that ends the actor from
# inside its behaviour (silica_rt_thread_actor_end) comes back to it and returns from here, so the
# thread ends by returning from its start routine, never by pthread_exit.
	mov	QWORD PTR [rdi + 528], rsp
	mov	QWORD PTR [rbp - 64], 0
	mov	QWORD PTR [rdi + 496], rdi
	mov	QWORD PTR [rdi + 504], 0
	add	rdi, 496
	call	silica_rt_tls_record_set
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_altstack_install
# Phase E e3b: first-schedule supervisor trampoline hook. It runs on the actor's stack, like a
# behavior: the top of the reservation is the empty stack, and the runtime keeps this thread's
# own SP in ACB+480 while user code runs there.
	mov	rax, QWORD PTR [rbp - 8]
	mov	rbx, QWORD PTR [rax + 216]
	test	rbx, rbx
	jz	LBB1_skip_tramp
	mov	rbx, QWORD PTR [rbx + 48]
	test	rbx, rbx
	jz	LBB1_skip_tramp
	mov	r10, QWORD PTR [rax + 224]
	test	r10, r10
	jnz	LBB1_skip_tramp
	mov	rdi, rax
	mov	r10, QWORD PTR [rax + 272]
	test	r10, r10
	jz	LBB1_sw_none_0
	mov	r11, QWORD PTR [rax + 280]
	add	r10, r11
	mov	r11, rsp
	mov	QWORD PTR [rax + 368], r11
	mov	rsp, r10
LBB1_sw_none_0:
	call	rbx
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 368]
	test	r11, r11
	jz	LBB1_sw_back_0
	mov	rsp, r11
	mov	QWORD PTR [rax + 368], 0
LBB1_sw_back_0:
LBB1_skip_tramp:
# Phase E e4f: mark actor as started (post TLS init + post any first-schedule trampoline) so
# spawn / spawn_linked callers can serialize on +288 == 1 for both supervisors and workers.
# This delivers the user-requested ordering: each child starts one at a time, waiting until
# the previous child's actor_thread_main has materialised before the next spawn proceeds.
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 1
	call	silica_rt_started_store
	mov	QWORD PTR [rbp - 32], 1
LBB1_loop:
# The mailbox loop. A dangerous actor's thread stays here for the actor's life; a carrier enters
# here with [rbp-8] = the actor it dispatches and [rbp-64] = itself (prims_actors_carrier_asm.silica,
# Lcar_loop) and leaves through LBB1_again or the exit path.
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
LBB1_wait:
# The ingress is this dispatch's to dequeue only while no other holder has the restart token
# (block #120; the protocol in prims_actors_child_table_asm.silica's header): the token is taken
# with the node, under this lock, and released once the node is served (LBB1_free, or the reply
# path). Another holder's release signals this mailbox when notices remain.
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rdi + 216]
	mov	QWORD PTR [rbp - 16], 0
	test	rdi, rdi
	jz	LBB1_try_std
	cmp	QWORD PTR [rdi + 120], 0
	jne	LBB1_try_std
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	LBB1_try_std
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 216]
	mov	r10d, DWORD PTR [rcx + 16]
	sub	r10d, 1
	mov	DWORD PTR [rcx + 16], r10d
	mov	QWORD PTR [rbp - 24], 1
# A Phase B trial-hook node (+24 != 0: an inline int64 the behaviour runs on, no restart) does
# not take the token: both of its result paths clear [rbp-32] so that the new state is stored, and
# neither LBB1_free nor the reply path would release it, so a token taken here stayed held for
# the rest of the actor's life. Only an exit notice (+24 == 0) takes it. rdi is still the node.
	cmp	DWORD PTR [rdi + 24], 0
	jne	LBB1_process
	mov	QWORD PTR [rcx + 120], rax
	jmp	LBB1_process
LBB1_try_std:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10d, DWORD PTR [rax + 152]
	test	r10d, r10d
	jz	LBB1_exit
	lea	rdi, [rax + 128]
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 24], 0
	test	rdi, rdi
	jnz	LBB1_process
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10d, DWORD PTR [rax + 152]
	test	r10d, r10d
	jz	LBB1_exit
# A carrier actor with no mail is idle (on its carrier's sweep list when it is :release_when_idle
# with committed stack): back to the loop of the carrier this thread is ([rbp-16], read before
# mark_idle applies a pending migration, after which #440 may name another carrier); mail makes
# the actor ready again.
	mov	rcx, QWORD PTR [rax + 440]
	mov	QWORD PTR [rbp - 16], rcx
	test	rcx, rcx
	jz	LBB1_thread_wait
	mov	rdi, rax
	call	silica_rt_carrier_mark_idle
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 16]
	jmp	silica_rt_carrier_loop_enter
LBB1_thread_wait:
# A dangerous actor's thread waits for mail here: blocking silica_rt_cv_wait (lock word +
# silica_rt_futex_wait). Earlier pthread_cond_timedwait_relative_np drove libpthread kwq malloc
# churn racing TLS instantiation (mfm_alloc SIGBUS). Wake paths hold ACB+16, signal ACB+80, then
# unlock before silica_rt_cv_wait. A :release_when_idle actor waits with a timeout while it still
# holds committed stack; the check releases it once a second has passed since its last message
# (spec §15.1.2.2; a carrier actor's release is the carrier's sweep).
	mov	rdi, rax
	call	silica_rt_stack_idle_check
	mov	rdx, rdi
	mov	rax, QWORD PTR [rbp - 8]
	lea	rdi, [rax + 80]
	lea	rsi, [rax + 16]
	call	silica_rt_cv_wait_timeout
	jmp	LBB1_wait
LBB1_process:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
"
}

fn actor_rt_asm_chunk_2() -> string {
    // The result layout follows the tuple's own tag (r11), not the message kind: a cast that reaches a
    // call-style behaviour (through a reference the type checker could not trace, a registry name, or
    // FailureReporter delivery) gets (:reply, r, s) back, and reading s at +8 installed the reply as
    // the new state. The tag words are this build's :reply / :no_reply atoms (-1 when unused);
    // runtime-internal behaviours write neither tag and keep the message-kind rule. A cast discards
    // the reply value; a call to a cast-style behaviour gets 0.
    std_no_reply_cmp: string <- "	cmp	r11, QWORD PTR [rip + silica_rt_reply_tag]
	je	LBB1_reply_result
	cmp	r11, QWORD PTR [rip + silica_rt_no_reply_tag]
	je	LBB1_no_reply_result
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 240]
	cmp	DWORD PTR [rax + 16], 0
	je	LBB1_no_reply_result
LBB1_reply_result:
";
    ingress_no_reply_cmp: string <- "	cmp	r11, QWORD PTR [rip + silica_rt_reply_tag]
	je	LBB1_ingress_reply_result
	cmp	r11, QWORD PTR [rip + silica_rt_no_reply_tag]
	je	LBB1_ingress_no_reply_result
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 240]
	cmp	DWORD PTR [rax + 16], 0
	je	LBB1_ingress_no_reply_result
LBB1_ingress_reply_result:
";
    p0: string <- "	sub	rsp, 48
	mov	rax, QWORD PTR [rbp - 16]
# ACB+240 names the node being dispatched, a cast's as well as a call's: an actor that ends inside
# its behaviour (badarith, case_clause, fail_current, a guarded FFI fault) never reaches LBB1_free,
# so its teardown (signal_pending_call_deaths) completes the call or frees the cast node. The code
# after the behaviour reads the node (and its call flag, node+16) from there, never from the
# 48-byte area below: a carrier actor parked inside the behaviour returns into a frame rebuilt by
# the carrier (the eight slots come back with its context, the area below them does not).
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 240], rax
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rbp - 32], rax
	test	rax, rax
	jnz	LBB1_ingress_check_kind
	mov	rax, QWORD PTR [rbp - 16]
	cmp	DWORD PTR [rax + 32], 0
	je	LBB1_payload_not_owned
	mov	rdi, QWORD PTR [rax + 8]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_report_begin
LBB1_payload_not_owned:
	mov	rax, QWORD PTR [rbp - 16]
	mov	rdi, QWORD PTR [rax + 8]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax]
	mov	rbx, QWORD PTR [rax + 8]
	test	rbx, rbx
	jz	LBB1_ingress_no_beh
	mov	rdx, rsp
	mov	r10, QWORD PTR [rax + 272]
	test	r10, r10
	jz	LBB1_sw_none_1
	mov	r11, QWORD PTR [rax + 280]
	add	r10, r11
	mov	r11, rsp
	mov	QWORD PTR [rax + 368], r11
	mov	rsp, r10
LBB1_sw_none_1:
	call	rbx
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 368]
	test	r11, r11
	jz	LBB1_sw_back_1
	mov	rsp, r11
	mov	QWORD PTR [rax + 368], 0
LBB1_sw_back_1:
	mov	r11, QWORD PTR [rdi]
";
    p1: string <- concat(p0, std_no_reply_cmp);
    p2: string <- concat(p1, "	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 24], rax
	mov	r10, QWORD PTR [rdi + 16]
	jmp	LBB1_post_beh
LBB1_no_reply_result:
	mov	QWORD PTR [rbp - 24], 0
	mov	r10, QWORD PTR [rdi + 8]
	jmp	LBB1_post_beh
LBB1_ingress_check_kind:
	mov	rax, QWORD PTR [rbp - 16]
	mov	r10d, DWORD PTR [rax + 24]
	test	r10d, r10d
	jnz	LBB1_ingress_user_beh
LBB1_ingress_no_beh:
# No behaviour to run. A standard message to an actor without one ([rbp-32] = 0) is dropped below.
# An exit notice ([rbp-32] = 1, +24 = 0, its heap payload at +8: Phase C) is served HERE, in the
# behaviour's place and, for a carrier actor, on the actor's own stack: maybe_restart (the row's
# restart policy, the intensity cap, a :one_for_all or :rest_for_one cascade that stops siblings
# and waits for each, the respawns and their waits for the children's start) parks a supervisor
# at every wait instead of stalling the carrier, as it would on the carrier's stack. The release
# algorithm then runs at LBB1_post_beh as after a behaviour. The payload (and its hold on the
# ended child) goes once served and +8 is cleared, so LBB1_free has only the restart token
# (taken with the node, LBB1_wait) to release. [rbp-64] = the carrier (0: a dangerous actor's
# thread, where the restart runs on the thread's own stack and its waits spin); [rbp-56] = the
# payload (x25). The carrier's SP here is rbp - 176 (the dispatch frame with its 48-byte area),
# which is what a resume rebuilds (Lcar_resume).
	mov	QWORD PTR [rbp - 24], 0
	xor	r10d, r10d
	cmp	QWORD PTR [rbp - 32], 0
	je	LBB1_post_beh
	mov	rax, QWORD PTR [rbp - 16]
	cmp	DWORD PTR [rax + 24], 0
	jne	LBB1_post_beh
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 56], rcx
	test	rcx, rcx
	jz	LBB1_post_beh
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 440]
	mov	QWORD PTR [rbp - 64], r11
	mov	rdi, QWORD PTR [rcx]
	mov	rsi, rax
	mov	rdx, QWORD PTR [rcx + 8]
	test	r11, r11
	jz	LBB1_ingress_restart_call
	mov	r10, QWORD PTR [rax + 272]
	test	r10, r10
	jz	LBB1_ingress_restart_call
	add	r10, QWORD PTR [rax + 280]
	mov	QWORD PTR [rax + 368], rsp
	mov	rsp, r10
	call	silica_rt_supervisor_maybe_restart
	lea	rsp, [rbp - 176]
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 368], 0
	jmp	LBB1_ingress_restart_done
LBB1_ingress_restart_call:
	call	silica_rt_supervisor_maybe_restart
LBB1_ingress_restart_done:
	mov	rdi, QWORD PTR [rbp - 56]
	call	silica_rt_exit_payload_free
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 8], 0
	mov	QWORD PTR [rbp - 24], 0
	xor	r10d, r10d
	jmp	LBB1_post_beh
LBB1_ingress_user_beh:
# Phase B trial: message[+8] is inline int64; run behavior like a normal dequeue.
	mov	rax, QWORD PTR [rbp - 16]
	mov	rdi, QWORD PTR [rax + 8]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax]
	mov	rbx, QWORD PTR [rax + 8]
	test	rbx, rbx
	jz	LBB1_ingress_no_beh
	mov	rdx, rsp
	mov	r10, QWORD PTR [rax + 272]
	test	r10, r10
	jz	LBB1_sw_none_2
	mov	r11, QWORD PTR [rax + 280]
	add	r10, r11
	mov	r11, rsp
	mov	QWORD PTR [rax + 368], r11
	mov	rsp, r10
LBB1_sw_none_2:
	call	rbx
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 368]
	test	r11, r11
	jz	LBB1_sw_back_2
	mov	rsp, r11
	mov	QWORD PTR [rax + 368], 0
LBB1_sw_back_2:
	mov	r11, QWORD PTR [rdi]
");
    p3: string <- concat(p2, ingress_no_reply_cmp);
    concat(p3, "	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 24], rax
	mov	r10, QWORD PTR [rdi + 16]
	mov	QWORD PTR [rbp - 32], 0
	jmp	LBB1_post_beh
LBB1_ingress_no_reply_result:
	mov	QWORD PTR [rbp - 24], 0
	mov	r10, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 32], 0
	jmp	LBB1_post_beh
LBB1_post_beh:
# Message boundary: the behavior has returned and its stack is empty, so the release algorithm
# runs now, before the reply is handed to the caller (spec §15.1.2.2).
	mov	QWORD PTR [rbp - 40], r10
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_stack_on_message_return
	mov	r10, QWORD PTR [rbp - 40]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 240]
	mov	QWORD PTR [rbp - 16], rcx
	mov	ebx, DWORD PTR [rcx + 16]
	add	rsp, 48
	mov	QWORD PTR [rax + 240], 0
	cmp	QWORD PTR [rbp - 32], 0
	jne	LBB1_skip_actor_state
	mov	QWORD PTR [rax], r10
LBB1_skip_actor_state:
	cmp	QWORD PTR [rbp - 32], 0
	jne	LBB1_ingress_restore_w21
	jmp	LBB1_after_w21
LBB1_ingress_restore_w21:
	mov	rax, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rbp - 24], rax
LBB1_after_w21:
	test	ebx, ebx
	jz	LBB1_free
# Phase E e4f: take the call wrapper lock before draining supervision ingress so the
# caller cannot complete actor_call (and free the wrapper) until every enqueued exit
# notification has been processed. kill_abnormal only signals the victim; deliver_exit
# runs on child threads while sup_beh is still finishing — without this ordering, main
# could free the wrapper concurrently with deliver_exit / LBB1_exit (SIGBUS mfm_*) on
# phase_e4f_rest_for_one.
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 72
	call	silica_rt_lock_lock
# An ingress node served with a reply ([rbp-32]) held the restart token (LBB1_wait): released first.
	cmp	QWORD PTR [rbp - 32], 0
	je	LBB1_reply_drain
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_restart_release
LBB1_reply_drain:
# The replier drains its own ingress (empty, for a worker). A supervisor's drain may run restarts
# and wait: a carrier actor ([rbp-64] = its carrier) runs it on its own stack so that its waits
# park; the SP here is rbp - 128 (the 48-byte area is gone), restored after.
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 216], 0
	je	LBB1_reply_drain_call
	mov	r10, QWORD PTR [rax + 440]
	mov	QWORD PTR [rbp - 64], r10
	test	r10, r10
	jz	LBB1_reply_drain_call
	mov	r11, QWORD PTR [rax + 272]
	test	r11, r11
	jz	LBB1_reply_drain_call
	add	r11, QWORD PTR [rax + 280]
	mov	QWORD PTR [rax + 368], rsp
	mov	rsp, r11
	mov	rdi, rax
	mov	rsi, rax
	call	silica_rt_supervisor_drain_ingress
	lea	rsp, [rbp - 128]
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 368], 0
	jmp	LBB1_reply_drain_done
LBB1_reply_drain_call:
	mov	rdi, rax
	mov	rsi, rax
	call	silica_rt_supervisor_drain_ingress
LBB1_reply_drain_done:
	mov	rax, QWORD PTR [rbp - 16]
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 144], rcx
	mov	DWORD PTR [rax + 136], 1
	mov	rdi, rax
	call	silica_rt_call_wrapper_wake
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 72
	call	silica_rt_lock_unlock
	jmp	LBB1_again
LBB1_free:
# An ingress node ([rbp-32] == 1) was served at LBB1_ingress_no_beh (an exit notice: its payload is
# gone and +8 cleared): only the restart token taken with it is left to release. A Phase B
# trial-hook node (+24 != 0, +8 an inline int64) was run by the behaviour, which cleared
# [rbp-32], and took no token at LBB1_wait.
	cmp	QWORD PTR [rbp - 32], 0
	je	LBB1_free_skip_restart
LBB1_free_release:
# The ingress node is served: the restart token taken with it (LBB1_wait) goes.
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_restart_release
LBB1_free_skip_restart:
# A payload the message owns (the FailureReporter's report string) goes back now that the
# behaviour has returned, unless the behaviour kept it (silica_rt_report_release).
	mov	rax, QWORD PTR [rbp - 16]
	cmp	DWORD PTR [rax + 32], 0
	je	LBB1_free_node
	mov	rdi, QWORD PTR [rax + 8]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_report_release
LBB1_free_node:
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
LBB1_again:
# The message is served. An actor thread goes back to its mailbox; a carrier actor is re-queued
# or marked idle by the carrier.
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 440], 0
	je	LBB1_loop
	mov	rdi, rax
	jmp	silica_rt_carrier_requeue
LBB1_exit:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
# [rbp-64] = the carrier when this is a carrier actor (read before the block can be freed below):
# its exit path ends in the carrier loop. Its delivering phase (a supervisor's shutdown of its
# children, each waited for; the exit notice; the report; the pending callers' deaths; the
# child table) runs on the actor's own reservation, where a wait parks and the carrier runs on
# (a child on this carrier can only end when it does); the carrier's stack is for what follows,
# once nothing waits (prims_actors_carrier_asm.silica header). A released reservation grows
# again on the first push. This frame is the dispatch frame on the carrier's stack: a park saves
# and restores its slots, so [rbp-8] .. [rbp-64] stay valid across the waits.
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10, QWORD PTR [rax + 440]
	mov	QWORD PTR [rbp - 64], r10
	test	r10, r10
	jz	LBB1_exit_deliver
	mov	r11, QWORD PTR [rax + 272]
	test	r11, r11
	jz	LBB1_exit_deliver
	add	r11, QWORD PTR [rax + 280]
	mov	rsp, r11
LBB1_exit_deliver:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_registry_forget_actor
	mov	rax, QWORD PTR [rbp - 8]
	mov	rbx, QWORD PTR [rax + 216]
	test	rbx, rbx
	jz	Lsbg_1
	mov	rbx, QWORD PTR [rbx + 40]
Lsbg_1:
	test	rbx, rbx
	jnz	LBB1_exit_report_already_done
	mov	rdi, rax
	call	silica_rt_actor_deliver_exit
	mov	QWORD PTR [rbp - 16], rdi
# A root actor's note goes out before its report reaches a registered FailureReporter, which may
# end the process (cast_exit) once it has the report (silica_rt_root_note_early); [rbp - 16] = 0 then.
	test	rdi, rdi
	jz	LBB1_exit_note_later
	call	silica_rt_root_note_early
	test	rdi, rdi
	jz	LBB1_exit_note_later
	mov	QWORD PTR [rbp - 16], 0
LBB1_exit_note_later:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_deliver_unwind_report
	jmp	LBB1_exit_after_report
LBB1_exit_report_already_done:
	mov	QWORD PTR [rbp - 16], 0
LBB1_exit_after_report:
# Callers parked in a call to this actor learn of its death now, before a restart drained below
# stops them (a sibling parked in a call to it, under :one_for_all).
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_signal_pending_call_deaths
# A notice parked at #400 (this row child ended before its spawner committed it) is not in the
# supervisor's ingress yet: nothing to drain. A carrier actor does not drain its supervisor's
# ingress: the supervisor's own dispatch restarts it (LBB1_ingress_no_beh), or a kill_abnormal
# caller's drain does. A dangerous actor's thread restarts itself when its own notice is first
# in the ingress (silica_rt_supervisor_drain_own_exit; the protocol in
# prims_actors_child_table_asm.silica's header) and never waits for its replacement: a caller in
# kill_abnormal waits for this row's exit_done, the last act below, and then for the restart to
# settle.
	cmp	QWORD PTR [rbp - 64], 0
	jne	LBB1_exit_no_sup_drain
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 400], 1
	jne	LBB1_exit_no_sup_drain
	mov	rax, QWORD PTR [rax + 192]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jz	LBB1_exit_no_sup_drain
	mov	rdi, rax
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_own_exit
LBB1_exit_no_sup_drain:
# Every ended actor, supervised or not, gives back what it owns; its control block goes with its
# last holder (silica_rt_actor_final_release). The child table (whose shutdown is idempotent
# and may wait) goes while still on the actor's own stack; then a carrier actor moves to the
# carrier's stack, below this frame (rsp = rbp - 192: the frame's slots stay readable), and its
# reservation is unmapped.
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_child_table_free
	cmp	QWORD PTR [rbp - 64], 0
	je	LBB1_exit_free_stack
	lea	rsp, [rbp - 192]
LBB1_exit_free_stack:
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	call	silica_rt_actor_stack_free
	cmp	QWORD PTR [rbp - 16], 0
	je	LBB1_exit_skip_legacy_root
	call	silica_rt_root_note_write
LBB1_exit_skip_legacy_root:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_ffi_arena_teardown
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_dealloc_region
# Phase E e4f: AFTER full teardown the release drops this thread's hold, then stores the
# supervisor's row.exit_done = this actor's identity and drops this child's block reference
# (sb_child_done; the reference is what keeps the row alive when the supervisor has already ended).
# A cascade or kill_abnormal waits for that identity (silica_rt_row_wait), so two teardowns never
# overlap.
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_final_release
LBB1_exit_no_row:
	cmp	QWORD PTR [rbp - 64], 0
	je	LBB1_thread_done
	mov	rdi, QWORD PTR [rbp - 64]
	jmp	silica_rt_carrier_loop_enter
LBB1_thread_done:
	xor	eax, eax
	xor	edi, edi
	mov	rbx, QWORD PTR [rbp - 88]
	mov	r12, QWORD PTR [rbp - 96]
	mov	r13, QWORD PTR [rbp - 104]
	mov	r14, QWORD PTR [rbp - 112]
	mov	r15, QWORD PTR [rbp - 120]
	leave
	ret
                                        # -- End function
	.globl	silica_rt_thread_actor_end
	.p2align	2
silica_rt_thread_actor_end:
# rdi = a dangerous actor's ACB (#440 = 0), on its own thread, after the delivering phase of an
# exit path that began inside the behaviour (silica_rt_badarith, case_clause, name_taken,
# fail_current, a guarded foreign fault): the thread is on the actor's reservation or on its
# signal alternate stack, never on its own pthread stack. Moves back to actor_thread_main's frame
# (#528 = its rsp on the pthread stack; rbp is 128 above it, the frame actor_thread_main opened),
# unmaps the reservation and the alternate stack (nothing waits any more), lets the actor's holds
# go and returns from the start routine as LBB1_thread_done does (rbx r12-r15 come back from that
# frame's slots, so rbx is free to hold the ACB across the calls here). Never returns here.
#
# Not pthread_exit: glibc ends a thread by a forced unwind (_Unwind_ForcedUnwind through every
# frame to start_thread's), and its stop function only ends the walk at a frame whose CFA has
# reached start_thread's saved SP on the thread's stack. On any other stack that never happens,
# and the walk cannot cross a stack switch anyway: at the first frame with no unwind rules (these
# runtime routines carry no CFI; a behaviour carries none) the CFA and the return address stop
# changing, so the unwinder spins in the same frame for ever, the thread at 100% CPU with the
# actor long reported ended (seen on a :dangerous row child that divided by zero). Its
# reservation and alternate stack also stayed mapped, as nothing could unmap the stack it stood on.
	mov	rbx, rdi
	mov	rax, QWORD PTR [rbx + 528]
	test	rax, rax
	jz	Ltae_no_base
	mov	rsp, rax
	lea	rbp, [rsp + 128]
	mov	rdi, rbx
	xor	esi, esi
	call	silica_rt_actor_stack_free
	mov	rdi, rbx
	call	silica_rt_actor_final_release
	jmp	LBB1_thread_done
Ltae_no_base:
# No base recorded (not reachable from a thread actor_thread_main started): the holds go and the
# thread ends the way libc can, without its stacks.
	mov	rdi, rbx
	call	silica_rt_actor_final_release
Ltae_exit:
	xor	edi, edi
	call	pthread_exit
	jmp	Ltae_exit
	.p2align	2 # functional queue dequeue; caller holds queue's lock
silica_rt_q_dequeue_locked: # X0 = &queue (pair: front, rear). Returns X0 = node or null.
	mov	rsi, QWORD PTR [rdi]
	test	rsi, rsi
	jnz	Lqd_pop
	mov	rsi, QWORD PTR [rdi + 8]
	test	rsi, rsi
	jz	Lqd_empty
	xor	edx, edx
Lqd_rev:
	mov	rcx, QWORD PTR [rsi]
	mov	QWORD PTR [rsi], rdx
	mov	rdx, rsi
	mov	rsi, rcx
	test	rsi, rsi
	jnz	Lqd_rev
	mov	QWORD PTR [rdi], rdx
	mov	QWORD PTR [rdi + 8], 0
	mov	rsi, rdx
Lqd_pop:
	mov	rcx, QWORD PTR [rsi]
	mov	QWORD PTR [rdi], rcx
	mov	rdi, rsi
	ret
Lqd_empty:
	xor	edi, edi
	ret
                                        # -- End function
	.p2align	2 # functional queue enqueue; caller holds queue's lock
silica_rt_q_enqueue_locked: # X0 = &queue (pair), X1 = node. Prepends to rear.
	mov	rdx, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rsi], rdx
	mov	QWORD PTR [rdi + 8], rsi
	ret
                                        # -- End function
	.globl	silica_rt_actor_send # -- Begin function silica_rt_actor_send
	.p2align	2
silica_rt_actor_send:
# rdi = reference, rsi = message -> rdi = 0 (:ok). It is a cast: an ended actor raises actor_not_found.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_actor_cast
	xor	edi, edi
	leave
	ret
	.p2align	2
Lsilica_rt_actor_send_unused:
# rdi = actor, rsi = message. Frame: [rbp-8] actor, [rbp-16] node, [rbp-24] message.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_report_escape_check
	test	rdi, rdi
	jz	LBB2_5
# %bb.1:
	mov	QWORD PTR [rbp - 24], rsi
# %bb.2:
	mov	QWORD PTR [rbp - 8], rdi
	mov	edi, 1
")
}

fn actor_rt_asm_chunk_3() -> string {
    "	mov	esi, 152
	call	calloc
	mov	rdi, rax
	test	rdi, rdi
	jz	LBB2_5
# %bb.3:
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rdi + 8], rax
	mov	DWORD PTR [rdi + 16], 0
	mov	DWORD PTR [rdi + 24], 1
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 128
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_q_enqueue_locked
	jmp	LBB2_7
LBB2_5:
	leave
	ret
LBB2_7:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	xor	edi, edi
	leave
	ret
                                        # -- End function
	.globl	silica_rt_actor_cast # -- Begin function silica_rt_actor_cast
	.p2align	2
silica_rt_actor_cast: # @silica_rt_actor_cast
# rdi = reference, rsi = message -> rdi = 1. An actor that has ended (or never existed) raises
# actor_not_found and the message is dropped (§16.1.2, §16.1.4).
	push	rbp
	mov	rbp, rsp
	xor	edx, edx
	lea	r10, [rip + silica_rt_actor_cast_flagged]
	call	silica_rt_ref_call
	leave
	test	rdi, rdi
	jz	Lcast_not_found
	cmp	rdi, 2
	je	Lcast_conv
	ret
Lcast_not_found:
	jmp	silica_rt_actor_not_found
Lcast_conv:
	jmp	silica_rt_convention_mismatch
	.globl	silica_rt_actor_cast_flagged
	.p2align	2
silica_rt_actor_cast_flagged:
# rdi = the target's ACB (held by the caller) or 0, rsi = message, edx = 1 when the message owns its
# payload: a runtime-built block (the FailureReporter's report string) that the receiver's dispatch
# frees once its behaviour has returned (node+32; silica_rt_report_release). Returns rdi = 1
# enqueued, 0 not (no target, an ended target, no memory), 2 not: the target is call-only (§16.2.6.4).
# Frame: [rbp-8] actor, [rbp-16] node, [rbp-24] result flag, [rbp-32] message, [rbp-40] owned flag.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 24], 0
	mov	QWORD PTR [rbp - 40], rdx
	call	silica_rt_report_escape_check
	test	rdi, rdi
	jz	LBB3_7
# %bb.1:
	mov	QWORD PTR [rbp - 32], rsi
# %bb.2:
	mov	QWORD PTR [rbp - 8], rdi
	cmp	QWORD PTR [rdi + 432], 1
	jne	LBB3_conv_ok
	mov	QWORD PTR [rbp - 24], 2
	jmp	LBB3_7
LBB3_conv_ok:
	mov	edi, 1
	mov	esi, 152
	call	calloc
	mov	rdi, rax
	test	rdi, rdi
	jz	LBB3_7
# %bb.3:
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rdi + 8], rax
	mov	DWORD PTR [rdi + 16], 0
	mov	DWORD PTR [rdi + 24], 1
	mov	rax, QWORD PTR [rbp - 40]
	mov	DWORD PTR [rdi + 32], eax
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
"
}

fn actor_rt_asm_chunk_4() -> string {
    "	mov	rax, QWORD PTR [rbp - 8]
	cmp	DWORD PTR [rax + 152], 0
	je	LBB3_dead_locked
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 128
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_q_enqueue_locked
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	QWORD PTR [rbp - 24], 1
	jmp	LBB3_7
LBB3_dead_locked:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
LBB3_7:
	mov	rdi, QWORD PTR [rbp - 24]
	leave
	ret
                                        # -- End function
	.globl	silica_rt_actor_signal_call_death
	.p2align	2
silica_rt_actor_signal_call_death:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	LBBsig_done
	add	rdi, 72
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	ebx, DWORD PTR [rax + 136]
	test	ebx, ebx
	jnz	LBBsig_unlock
	mov	QWORD PTR [rax + 144], 0
# reply_set 2: the target ended before replying; the caller raises actor_not_found (§16.1.1).
	mov	DWORD PTR [rax + 136], 2
	mov	rdi, rax
	call	silica_rt_call_wrapper_wake
LBBsig_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 72
	call	silica_rt_lock_unlock
LBBsig_done:
	leave
	ret
	.globl	silica_rt_actor_signal_pending_call_deaths
	.p2align	2
silica_rt_actor_signal_pending_call_deaths:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	LBBsigpend_done
	mov	rax, QWORD PTR [rdi + 240]
	mov	QWORD PTR [rbp - 16], rax
	mov	QWORD PTR [rdi + 240], 0
	test	rax, rax
	jz	LBBsigpend_lock_mailbox
	cmp	DWORD PTR [rax + 16], 0
	je	LBBsigpend_active_cast
	mov	rdi, rax
	call	silica_rt_actor_signal_call_death
	jmp	LBBsigpend_lock_mailbox
# The cast (or ingress) node the actor was handling when it ended: its dispatch never returned,
# so the node is freed here, once. An owned payload (the report a FailureReporter was handling)
# goes back as at a normal return, unless it was sent on (report_release keeps it then).
LBBsigpend_active_cast:
	cmp	DWORD PTR [rax + 32], 0
	je	LBBsigpend_active_free
	mov	rdi, QWORD PTR [rax + 8]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_report_release
LBBsigpend_active_free:
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
LBBsigpend_lock_mailbox:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
LBBsigpend_loop:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 128
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	LBBsigpend_unlock
	mov	ebx, DWORD PTR [rdi + 16]
	test	ebx, ebx
	jz	LBBsigpend_free_message
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_actor_signal_call_death
	jmp	LBBsigpend_loop
LBBsigpend_free_message:
	mov	rdi, QWORD PTR [rbp - 16]
	cmp	DWORD PTR [rdi + 32], 0
	je	LBBsigpend_free_node
	mov	rdi, QWORD PTR [rdi + 8]
	call	silica_rt_report_unhandled
LBBsigpend_free_node:
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
	jmp	LBBsigpend_loop
LBBsigpend_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
LBBsigpend_done:
	leave
	ret
                                        # -- End function
	.globl	silica_rt_actor_call # -- Begin function silica_rt_actor_call
	.p2align	2
silica_rt_actor_call:
# rdi = reference, rsi = message -> rdi = the reply. An actor that has ended (or never existed)
# raises actor_not_found (§16.1.1). The target is held for the call (silica_rt_ref_hold).
# Frame: [rbp-8] ACB, [rbp-16] message / reply, [rbp-24] dead flag.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 16], rsi
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	Lcallw_not_found
# Spec §16.2.6.4: a cast-only target is never sent a call; nothing is enqueued and the caller fails.
	cmp	QWORD PTR [rdi + 432], 2
	je	Lcallw_conv
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_actor_call_acb
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 24], rsi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_acb_release
	cmp	QWORD PTR [rbp - 24], 0
	jne	Lcallw_not_found
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
Lcallw_not_found:
	leave
	jmp	silica_rt_actor_not_found
Lcallw_conv:
	call	silica_rt_acb_release
	leave
	jmp	silica_rt_convention_mismatch
	.globl	silica_rt_actor_call_acb
	.p2align	2
silica_rt_actor_call_acb:
# rdi = the target's ACB (held) or 0, rsi = message -> rdi = the reply, rsi = 0; or rsi = 1 when the
# target has ended (nothing was enqueued) or ended before replying (the wrapper's reply_set is 2).
# rdi = actor, rsi = message. Frame: [rbp-8] wrapper, [rbp-16] actor / reply, [rbp-24] message, [rbp-32] w22 (=1),
# [rbp-40] the calling carrier actor when it parks (x20), [rbp-48] its carrier (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_report_escape_check
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, rdi
	xor	edi, edi
	test	rax, rax
	jz	LBB4_dead
# %bb.1:
	mov	QWORD PTR [rbp - 24], rsi
# %bb.2:
	mov	QWORD PTR [rbp - 32], 1
	mov	edi, 1
	mov	esi, 152
	call	calloc
	mov	rdi, rax
	test	rdi, rdi
	jz	LBB4_dead
# %bb.3:
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rdi + 8], rax
	mov	DWORD PTR [rdi + 16], 1
# wrapper+56: the caller (0 in main). A composite reply is copied into the caller's arena at the
# reply boundary (prims_actors@bmv_reply_asm, design region_memory_safety_design.md H4).
	call	silica_rt_tls_current_actor_get
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 56], rdi
# Phase E e4f: wrapper+72 is the 4 B lock word and wrapper+24 is a 4 B futex seq word.
# Both are pre-zeroed by calloc; no init call required.
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 16]
	mov	ebx, DWORD PTR [rax + 152]
	test	ebx, ebx
	jz	LBB4_dead_locked
	lea	rdi, [rax + 128]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_q_enqueue_locked
"
}

fn actor_rt_asm_chunk_5() -> string {
    "	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	jmp	LBB4_wait_start
LBB4_dead_locked:
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	jmp	LBB4_dead
LBB4_wait_start:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 72
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	ebx, DWORD PTR [rax + 136]
	test	ebx, ebx
	jnz	LBB4_8
# A carrier actor calling from its behaviour parks instead of blocking its carrier (item N stage
# 1): its context is saved first, then the wrapper names it (wrapper+48) and its status is parked,
# all under wrapper+72, which the reply side (silica_rt_call_wrapper_wake) also holds. When resumed
# the reply is re-checked under the lock, as a woken thread does. main (no current actor), an actor
# thread, and a runtime path running on the carrier's own stack keep the futex wait.
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 40], rdi
	test	rdi, rdi
	jz	LBB4_7
	mov	rax, QWORD PTR [rdi + 440]
	mov	QWORD PTR [rbp - 48], rax
	test	rax, rax
	jz	LBB4_7
	mov	r10, rsp
	mov	r11, QWORD PTR [rdi + 272]
	cmp	r10, r11
	jb	LBB4_7
	add	r11, QWORD PTR [rdi + 280]
	cmp	r10, r11
	jae	LBB4_7
	call	silica_rt_ctx_save
	test	rdi, rdi
	jnz	LBB4_wait_start
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 48], rcx
	mov	QWORD PTR [rcx + 448], 4
	lea	rdi, [rax + 72]
	call	silica_rt_lock_unlock
# Back to the loop of the carrier this thread is ([rbp-48], read before the park was published: once
# parked the actor may be moved at its next boundary and its #440 name another carrier).
	mov	rdi, QWORD PTR [rbp - 48]
	jmp	silica_rt_carrier_loop_enter
LBB4_7: # =>This Inner Loop Header: Depth=1
# Phase E e4f: blocking wait. Earlier 1 ms timedwait_relative_np was a missed-signal
# band-aid that, under macOS arm64 with 3+ concurrent supervised actors, drove a libpthread
# internal kwq malloc storm racing with new-actor TLS instantiation (mfm_alloc
# KERN_PROTECTION_FAILURE SIGBUS in calloc / _tlv_get_addr). All wake paths for the call
# wrapper (worker reply, supervisor cascade kill+restart, etc.) hold wrapper#72 and signal
# wrapper#24 before unlock, so a properly-locked plain wait is sufficient. We still check
# reply_set on each wake to absorb spurious wakeups.
	mov	rax, QWORD PTR [rbp - 8]
	lea	rdi, [rax + 24]
	lea	rsi, [rax + 72]
	call	silica_rt_cv_wait
	mov	rax, QWORD PTR [rbp - 8]
	mov	ebx, DWORD PTR [rax + 136]
	test	ebx, ebx
	jz	LBB4_7
LBB4_8:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 144]
	mov	QWORD PTR [rbp - 16], rcx
	mov	ecx, DWORD PTR [rax + 136]
	mov	QWORD PTR [rbp - 24], rcx
	lea	rdi, [rax + 72]
	call	silica_rt_lock_unlock
# Phase E e4f: wrapper+72 (lock word) and wrapper+24 (futex seq word) have no
# out-of-line state, so freeing the wrapper buffer reclaims everything. No destroy call needed.
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	mov	rdi, QWORD PTR [rbp - 16]
	xor	esi, esi
	cmp	QWORD PTR [rbp - 24], 2
	sete	sil
LBB4_9:
	leave
	ret
LBB4_dead:
	xor	edi, edi
	mov	esi, 1
	jmp	LBB4_9
                                        # -- End function
	.globl	silica_rt_actor_call_registered # -- Begin function silica_rt_actor_call_registered
	.p2align	2
silica_rt_actor_call_registered: # @silica_rt_actor_call_registered
# X0=atom registry key, X1=message. Resolve through the global PID registry, then tail-call actor_call.
	mov	r12, rdi
	mov	r13, rsi
	mov	rbx, QWORD PTR [rip + silica_pid_registry_ref]
	test	rbx, rbx
	jz	LBB4r_not_found
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jz	LBB4r_not_found
	cmp	r12, 0
	jl	LBB4r_not_found
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	r12, r9
	jge	LBB4r_not_found
	mov	r11, QWORD PTR [r10 + r12*8]
	cmp	r11, 1
	jne	LBB4r_not_found
	lea	r10, [r10 + r9*8]
	mov	rdi, QWORD PTR [r10 + r12*8]
	mov	rsi, r13
	jmp	silica_rt_actor_call
LBB4r_not_found:
	jmp	silica_rt_actor_not_found
                                        # -- End function
	.globl	silica_rt_actor_cast_registered # -- Begin function silica_rt_actor_cast_registered
	.p2align	2
silica_rt_actor_cast_registered: # @silica_rt_actor_cast_registered
# X0=atom registry key, X1=message. Resolve through the global PID registry, then tail-call actor_cast.
	mov	r12, rdi
	mov	r13, rsi
	mov	rbx, QWORD PTR [rip + silica_pid_registry_ref]
	test	rbx, rbx
	jz	LBB3r_not_found
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jz	LBB3r_not_found
	cmp	r12, 0
	jl	LBB3r_not_found
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	r12, r9
	jge	LBB3r_not_found
	mov	r11, QWORD PTR [r10 + r12*8]
	cmp	r11, 1
	jne	LBB3r_not_found
	lea	r10, [r10 + r9*8]
	mov	rdi, QWORD PTR [r10 + r12*8]
	mov	rsi, r13
	jmp	silica_rt_actor_cast
LBB3r_not_found:
	jmp	silica_rt_actor_not_found
                                        # -- End function
	.globl	silica_rt_actor_cast_dangerous_registered # -- Begin function silica_rt_actor_cast_dangerous_registered
	.p2align	2
silica_rt_actor_cast_dangerous_registered: # @silica_rt_actor_cast_dangerous_registered
# X0=atom registry key, X1=message. Resolve through the dangerous PID registry, then tail-call actor_cast.
	mov	r12, rdi
	mov	r13, rsi
	mov	rbx, QWORD PTR [rip + silica_dangerous_pid_registry_ref]
	test	rbx, rbx
	jz	LBB3dr_not_found
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jz	LBB3dr_not_found
	cmp	r12, 0
	jl	LBB3dr_not_found
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	r12, r9
	jge	LBB3dr_not_found
	mov	r11, QWORD PTR [r10 + r12*8]
	cmp	r11, 1
	jne	LBB3dr_not_found
	lea	r10, [r10 + r9*8]
	mov	rdi, QWORD PTR [r10 + r12*8]
	mov	rsi, r13
	jmp	silica_rt_actor_cast
LBB3dr_not_found:
	jmp	silica_rt_actor_not_found
                                        # -- End function
	.globl	silica_rt_actor_cast_device_registered # -- Begin function silica_rt_actor_cast_device_registered
	.p2align	2
silica_rt_actor_cast_device_registered: # @silica_rt_actor_cast_device_registered
# X0=atom registry key, X1=message. Resolve through the device PID registry, then tail-call actor_cast.
	mov	r12, rdi
	mov	r13, rsi
	mov	rbx, QWORD PTR [rip + silica_device_pid_registry_ref]
	test	rbx, rbx
	jz	LBB3dv_not_found
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jz	LBB3dv_not_found
	cmp	r12, 0
	jl	LBB3dv_not_found
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	r12, r9
	jge	LBB3dv_not_found
	mov	r11, QWORD PTR [r10 + r12*8]
	cmp	r11, 1
	jne	LBB3dv_not_found
	lea	r10, [r10 + r9*8]
	mov	rdi, QWORD PTR [r10 + r12*8]
	mov	rsi, r13
