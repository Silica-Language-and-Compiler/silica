	mov	rdi, QWORD PTR [rdi + 408]
	ret
Lgra_none:
	mov	rdi, -1
	ret
                                        # -- End function
# Phase E e4b: silica_rt_actor_kill_abnormal — set pending exit reason_tag to 1 (abnormal) and stop the actor.
# X0=actor_ref or atom registry key. Returns X0=0 (atom :ok). Used by trials to inject abnormal exits so :transient restart policy
# (restart iff reason_tag != 0) can be exercised. Mutex protects the alive/reason_tag transition vs
# deliver_exit reading [ACB+#336] from the actor's own thread.
	.globl	silica_rt_actor_kill_abnormal_named
	.p2align	2
silica_rt_actor_kill_abnormal_named:
# rdi = atom: kill_abnormal of the actor that holds the name in the ordinary registry (§20.3.1); no
# holder is :ok. An identity can be numerically small, so atoms have their own entry (§15.1.4).
	cmp	rdi, 0
	jl	Lkabn_none
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	rdi, r9
	jge	Lkabn_none
	mov	rbx, QWORD PTR [rip + silica_pid_registry_ref]
	test	rbx, rbx
	jz	Lkabn_none
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jz	Lkabn_none
	cmp	QWORD PTR [r10 + rdi*8], 1
	jne	Lkabn_none
	lea	r10, [r10 + r9*8]
	mov	rdi, QWORD PTR [r10 + rdi*8]
	jmp	silica_rt_actor_kill_abnormal
Lkabn_none:
	xor	edi, edi
	ret
	.globl	silica_rt_actor_kill_abnormal
	.p2align	2
silica_rt_actor_kill_abnormal:
# rdi = reference (held while the kill runs; an ended actor is :ok). Spec §15.1.2.3: kill_abnormal
# must not name the calling actor; the caller fails with :language_error and nothing is changed on
# it (a call it is serving gets no reply). The target is ended with reason tag 1
# (silica_rt_actor_stop). When it is a row child the caller waits for its row's exit_done to
# carry the target's identity (its last act), then for the restart to settle
# (silica_rt_supervisor_drain_ingress: the caller drains the supervisor's ingress itself unless
# it is a row child of that supervisor, which waits for the supervisor's dispatch to do it), so
# the replacement, when the policy makes one, exists when this returns. Both waits end at once
# when the caller itself is ended meanwhile (the target's :one_for_all or :rest_for_one cascade
# stops the caller): the target is dead or dying, :ok.
# Frame: [rbp-8] acb (x19), [rbp-16] row ptr (ACB+208, x20), [rbp-24] supervisor (ACB+192, x21),
# [rbp-32] the supervision block this call holds a reference on while it waits (0: none, x23),
# [rbp-40] the calling actor (x22), [rbp-48] 1 when the supervisor is held (x24), [rbp-56] the
# target's identity (x25).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 32], 0
	mov	QWORD PTR [rbp - 48], 0
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	Lkab_not_found
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 40], rdi
	cmp	rdi, QWORD PTR [rbp - 8]
	je	Lkab_self
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rdi + 208]
	mov	QWORD PTR [rbp - 16], rax
	mov	rax, QWORD PTR [rdi + 192]
	mov	QWORD PTR [rbp - 24], rax
	add	rdi, 16
	call	silica_rt_lock_lock
# While the target is still alive it holds its block reference and its supervisor, so ones taken
# now keep the row this call waits on and the supervisor it drains alive even if the supervisor
# ends meanwhile ([rbp-32] = the block, [rbp-48] = 1 when the supervisor is held; dropped at the
# end). A target that has ended, or has no row, is :ok with no wait.
	mov	rax, QWORD PTR [rbp - 8]
	cmp	DWORD PTR [rax + 152], 0
	je	Lkab_unlock
	cmp	QWORD PTR [rbp - 24], 0
	je	Lkab_unlock
	mov	rcx, QWORD PTR [rbp - 16]
	cmp	rcx, 4096
	jb	Lkab_unlock
	mov	rcx, QWORD PTR [rcx + 88]
	test	rcx, rcx
	jz	Lkab_unlock
	mov	QWORD PTR [rbp - 32], rcx
	lock add	QWORD PTR [rcx + 112], 1
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_acb_hold
	mov	QWORD PTR [rbp - 48], 1
Lkab_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 408]
	mov	QWORD PTR [rbp - 56], rax
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 1
	xor	edx, edx
	call	silica_rt_actor_stop
	cmp	QWORD PTR [rbp - 32], 0
	je	Lkab_done
	mov	rdx, rdi
	mov	rdi, QWORD PTR [rbp - 16]
	mov	rsi, QWORD PTR [rbp - 56]
	mov	rcx, QWORD PTR [rbp - 40]
	call	silica_rt_row_wait
	cmp	rdi, 1
	jne	Lkab_done
	mov	rdi, QWORD PTR [rbp - 24]
	mov	rsi, QWORD PTR [rbp - 40]
	call	silica_rt_supervisor_drain_ingress
Lkab_done:
	mov	rdi, QWORD PTR [rbp - 32]
	call	silica_rt_sb_unref
	cmp	QWORD PTR [rbp - 48], 0
	je	Lkab_not_found
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_acb_release
Lkab_not_found:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_acb_release
	xor	edi, edi
	leave
	ret
Lkab_self:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_acb_release
	leave
	jmp	silica_rt_language_error_current
                                        # -- End function
	.globl	silica_rt_pin_actor_to_numa_node # -- Begin function silica_rt_pin_actor_to_numa_node
	.p2align	2
silica_rt_pin_actor_to_numa_node: # @silica_rt_pin_actor_to_numa_node
# %bb.0: N/A (single NUMA domain)
	xor	edi, edi
	ret
                                        # -- End function
	.globl	silica_rt_unpin_actor # -- Begin function silica_rt_unpin_actor
	.p2align	2
silica_rt_unpin_actor:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_unpin_actor_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_unpin_actor_acb: # @silica_rt_unpin_actor
	test	rdi, rdi
	jz	Lunpin_actor_none
# unpin_actor is not part of the language (spec §22.10: an actor has no unpinned state); the
# compiler still accepts it and the emitter answers :ok. A carrier actor (#144 = 0, item N) keeps
# its binding: nothing to do. A dangerous actor's thread clears its affinity hint, as before.
	cmp	QWORD PTR [rdi + 144], 0
	je	Lunpin_actor_none
# %bb.0: X0=actor_ref; clear affinity by setting tag=0
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	rdi, QWORD PTR [rdi + 144]
	call	silica_rt_pthread_mach_thread_np
	mov	QWORD PTR [rbp - 16], rdi
	sub	rsp, 16
	mov	DWORD PTR [rsp], 0
	mov	rdi, QWORD PTR [rbp - 16]
	mov	esi, 4
	mov	rdx, rsp
	mov	ecx, 1
	call	silica_rt_thread_policy_set
	add	rsp, 16
	xor	edi, edi
	leave
	ret
Lunpin_actor_none:
	xor	edi, edi
	ret
                                        # -- End function
	.globl	silica_rt_set_actor_priority # -- Begin function silica_rt_set_actor_priority
	.p2align	2
silica_rt_set_actor_priority:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_set_actor_priority_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_set_actor_priority_acb: # @silica_rt_set_actor_priority
# %bb.0: rdi=actor_ref rsi=level (0 low, 1 normal, 2 high; the emitter maps the program's atoms, and
# any other value is normal, as on the board) -> rdi = 0 (:ok) or 1 (:actor_not_found: a null
# reference, or an actor that has ended, spec §22.10). The level is stored in ACB #520 for every
# actor (item N stage 4): for a carrier actor it is the run queue the actor is pushed to at its
# next push and its weight class under :weighted_fair and :lottery (prims_actors_carrier_asm,
# silica_rt_rq_push; an actor already queued stays where it is, the board's rule). A dangerous
# actor, on a thread of its own, keeps the level and nothing reads it: the OS schedules its thread
# (the pthread QoS mapping of the thread-per-actor runtime is gone). Leaf.
	test	rdi, rdi
	jz	Lsp_not_found
	cmp	DWORD PTR [rdi + 152], 0
	je	Lsp_not_found
	cmp	rsi, 3
	jb	Lsp_level_ok
	mov	esi, 1
Lsp_level_ok:
	mov	QWORD PTR [rdi + 520], rsi
	xor	edi, edi
	ret
Lsp_not_found:
	mov	edi, 1
	ret
"
}

