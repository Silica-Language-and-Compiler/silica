	jne	Lreg_device_named_store
	lea	r8, [r10 + r9*8]
	mov	rdi, QWORD PTR [r8 + rax*8]
	cmp	rdi, QWORD PTR [rbp - 8]
	je	Lreg_device_named_done
	call	silica_rt_ref_alive
	test	rdi, rdi
	jnz	Lreg_device_named_taken
Lreg_device_named_store:
	mov	rbx, QWORD PTR [rip + silica_device_pid_registry_ref]
	mov	r10, QWORD PTR [rbx]
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	mov	rax, QWORD PTR [rbp - 16]
	lea	r8, [r10 + r9*8]
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [r8 + rax*8], rcx
	mov	r11d, 1
	mov	QWORD PTR [r10 + rax*8], r11
Lreg_device_named_done:
	xor	edi, edi
	leave
	ret
Lreg_device_named_taken:
	mov	edi, 1
	leave
	ret
                                        # -- End function
	.globl	silica_rt_register_actor # -- Begin function silica_rt_register_actor
	.p2align	2
silica_rt_register_actor: # @silica_rt_register_actor
# Legacy unary register_actor(actor_ref). The global slot belongs to the PID registry actor;
# named insertion is handled by silica_rt_register_actor_named.
	xor	edi, edi
	ret
                                        # -- End function
	.globl	silica_rt_get_registry_actor # -- Begin function silica_rt_get_registry_actor
	.p2align	2
silica_rt_get_registry_actor: # @silica_rt_get_registry_actor
# %bb.0: Returns actor_ref stored by register_actor (or 0 if not yet initialised). X0=actor_ref.
	mov	rdi, QWORD PTR [rip + silica_pid_registry_ref]
	test	rdi, rdi
	jz	Lgra_none
	mov	rdi, QWORD PTR [rdi + 408]
	ret
Lgra_none:
	mov	rdi, -1
	ret
                                        # -- End function
# Phase E e4b: silica_rt_actor_kill_abnormal — set pending exit reason_tag to 1 (abnormal) and stop the actor.
# X0=actor_ref or atom registry key. Returns X0=0 (atom :ok). Used by trials to inject abnormal exits so :transient restart policy
# (restart iff reason_tag != 0) can be exercised. Mutex protects the alive/reason_tag transition vs
# deliver_exit reading [ACB+#336] from the actor's own thread.
	.globl	silica_rt_actor_kill_abnormal_named
	.p2align	2
silica_rt_actor_kill_abnormal_named:
# rdi = atom: kill_abnormal of the actor that holds the name in the ordinary registry (§20.3.1); no
# holder is :ok. An identity can be numerically small, so atoms have their own entry (§15.1.4).
	cmp	rdi, 0
	jl	Lkabn_none
	mov	r9, QWORD PTR [rip + silica_registry_slots]
	cmp	rdi, r9
	jge	Lkabn_none
	mov	rbx, QWORD PTR [rip + silica_pid_registry_ref]
	test	rbx, rbx
	jz	Lkabn_none
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jz	Lkabn_none
	cmp	QWORD PTR [r10 + rdi*8], 1
	jne	Lkabn_none
	lea	r10, [r10 + r9*8]
	mov	rdi, QWORD PTR [r10 + rdi*8]
	jmp	silica_rt_actor_kill_abnormal
Lkabn_none:
	xor	edi, edi
	ret
	.globl	silica_rt_actor_kill_abnormal
	.p2align	2
silica_rt_actor_kill_abnormal:
# rdi = reference (held while the kill runs; an ended actor is :ok).
# Frame: [rbp-8] acb, [rbp-16] row ptr (ACB+208), [rbp-24] supervisor (ACB+192), [rbp-32] the
# supervision block this call holds a reference on while it waits (0: none).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 32], 0
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	Lkab_not_found
# Spec §15.1.2.3: kill_abnormal must not name the calling actor; the caller fails with
# :language_error and nothing is changed on it (a call it is serving gets no reply).
	call	silica_rt_tls_current_actor_get
	cmp	rdi, QWORD PTR [rbp - 8]
	je	Lkab_self
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rdi + 208]
	mov	QWORD PTR [rbp - 16], rax
	mov	rax, QWORD PTR [rdi + 192]
	mov	QWORD PTR [rbp - 24], rax
	add	rdi, 16
	call	silica_rt_lock_lock
# While the target is still alive it holds its block reference, so one taken now keeps the row this
# call waits on alive even if the supervisor ends meanwhile (dropped at Lkab_not_found).
	mov	rax, QWORD PTR [rbp - 8]
	cmp	DWORD PTR [rax + 152], 0
	je	Lkab_no_ref
	cmp	QWORD PTR [rbp - 24], 0
	je	Lkab_no_ref
	mov	rcx, QWORD PTR [rbp - 16]
	cmp	rcx, 4096
	jb	Lkab_no_ref
	mov	rcx, QWORD PTR [rcx + 88]
	test	rcx, rcx
	jz	Lkab_no_ref
	mov	QWORD PTR [rbp - 32], rcx
	lock add	QWORD PTR [rcx + 112], 1
Lkab_no_ref:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 232], 1
	mov	DWORD PTR [rax + 152], 0
	lea	rdi, [rax + 80]
	call	silica_rt_cv_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	cmp	QWORD PTR [rbp - 16], 4096
	jb	Lkab_not_found
	call	silica_rt_tls_current_actor_get
	cmp	rdi, QWORD PTR [rbp - 8]
	je	Lkab_not_found
Lkab_wait_exit_done:
	mov	rax, QWORD PTR [rbp - 16]
	mov	rbx, QWORD PTR [rax + 56]
	test	rbx, rbx
	jz	Lkab_wait_exit_done
	mov	rdi, QWORD PTR [rbp - 24]
	test	rdi, rdi
	jz	Lkab_not_found
	call	silica_rt_supervisor_drain_ingress
Lkab_not_found:
	mov	rdi, QWORD PTR [rbp - 32]
	call	silica_rt_sb_unref
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_acb_release
	xor	edi, edi
	leave
	ret
Lkab_self:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_acb_release
	leave
	jmp	silica_rt_language_error_current
                                        # -- End function
	.globl	silica_rt_pin_actor_to_numa_node # -- Begin function silica_rt_pin_actor_to_numa_node
	.p2align	2
silica_rt_pin_actor_to_numa_node: # @silica_rt_pin_actor_to_numa_node
# %bb.0: N/A (single NUMA domain)
	xor	edi, edi
	ret
                                        # -- End function
	.globl	silica_rt_unpin_actor # -- Begin function silica_rt_unpin_actor
	.p2align	2
silica_rt_unpin_actor:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_unpin_actor_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_unpin_actor_acb: # @silica_rt_unpin_actor
	test	rdi, rdi
	jz	Lunpin_actor_none
# %bb.0: X0=actor_ref; clear affinity by setting tag=0
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	rdi, QWORD PTR [rdi + 144]
	call	silica_rt_pthread_mach_thread_np
	mov	QWORD PTR [rbp - 16], rdi
	sub	rsp, 16
	mov	DWORD PTR [rsp], 0
	mov	rdi, QWORD PTR [rbp - 16]
	mov	esi, 4
	mov	rdx, rsp
	mov	ecx, 1
	call	silica_rt_thread_policy_set
	add	rsp, 16
	xor	edi, edi
	leave
	ret
Lunpin_actor_none:
	xor	edi, edi
	ret
                                        # -- End function
	.globl	silica_rt_set_actor_priority # -- Begin function silica_rt_set_actor_priority
	.p2align	2
silica_rt_set_actor_priority:
# rdi = reference: resolved and held for the body below (silica_rt_ref_call).
	lea	r10, [rip + silica_rt_set_actor_priority_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_set_actor_priority_acb: # @silica_rt_set_actor_priority
# %bb.0: rdi=actor_ref rsi=level (0 low, 1 normal, 2 high; the emitter maps the program's atoms) -> rdi = 0
# (:ok) or 1 (:actor_not_found, a null reference); the level maps to a pthread QoS class.
	test	rdi, rdi
	jz	Lsp_not_found
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rsi
	mov	rdi, QWORD PTR [rdi + 144]
	cmp	rsi, 3
	jge	LBBsp_interactive
	cmp	rsi, 2
	je	LBBsp_initiated
	cmp	rsi, 1
	je	LBBsp_default
	cmp	rsi, 0
	je	LBBsp_utility
	mov	esi, 0x09
	jmp	LBBsp_set
LBBsp_interactive:
	mov	esi, 0x21
	jmp	LBBsp_set
LBBsp_initiated:
	mov	esi, 0x19
	jmp	LBBsp_set
LBBsp_default:
	mov	esi, 0x15
	jmp	LBBsp_set
LBBsp_utility:
	mov	esi, 0x11
LBBsp_set:
	xor	edx, edx
	call	silica_rt_pthread_set_qos_class_np
	xor	edi, edi
	leave
	ret
Lsp_not_found:
	mov	edi, 1
	ret
"
