// Phase G (cpu_topology_implementation_plan): heap layout matches expand_named_topology_type field order.
// Apple Silicon + macOS only: sysctl hw.*; numa_info/cache_info filled in silica_rt_* below (see prims_actors_runtime_asm header).
// core_info.core_type is atom index: :efficiency = 0, :performance = 1 (emitter atom_table.silica pre-seed; only these two variants).
// P-cores (indices [0,P) per hw.perflevel0) -> :performance; E-cores [P,P+E) -> :efficiency.
// core_info on success: capabilities = silica_rt_apple_hw_optional_caps_list() (shared pointer across topology.cores[]);
// frequency_mhz = 0 (sysctl does not expose core clock; hw.tbfrequency is not CPU MHz).
fn actor_rt_topology_phase_g_chunk() -> string {
    "	.globl	silica_rt_get_cpu_topology
	.p2align	2
silica_rt_get_cpu_topology:
# Frame: [rbp-8] w19 P-cores, [rbp-16] w20 E-cores, [rbp-24] w21 total, [rbp-32] x22 cores list,
# [rbp-40] x23 scratch node, [rbp-48] x24 / [rbp-80] x28 core-id range list, [rbp-56] x25 cache levels,
# [rbp-64] x26 caps / numa list, [rbp-72] x27 memsize; [rbp-88] w9 loop counter and [rbp-96] w10
# are kept in the frame because malloc clobbers r10/r11. The sysctl scratch pair lives at [rsp], [rsp+8].
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	sub	rsp, 16
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf0_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_topo_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 8], rax
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf1_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_topo_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 16], rax
	add	rsp, 16
	mov	eax, DWORD PTR [rbp - 8]
	add	eax, DWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 24], rax
	test	eax, eax
	jz	L_topo_fail_zero
