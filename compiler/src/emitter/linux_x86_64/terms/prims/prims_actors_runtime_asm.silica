// Phase G (cpu_topology_implementation_plan): heap layout matches expand_named_topology_type field order.
// Apple Silicon + macOS only: sysctl hw.*; numa_info/cache_info filled in silica_rt_* below (see prims_actors_runtime_asm header).
// core_info.core_type is atom index: :efficiency = 0, :performance = 1 (emitter atom_table.silica pre-seed; only these two variants).
// P-cores (indices [0,P) per hw.perflevel0) -> :performance; E-cores [P,P+E) -> :efficiency.
// core_info on success: capabilities = silica_rt_apple_hw_optional_caps_list() (shared pointer across topology.cores[]);
// frequency_mhz = 0 (sysctl does not expose core clock; hw.tbfrequency is not CPU MHz).
fn actor_rt_topology_phase_g_chunk() -> string {
    "	.globl	silica_rt_get_cpu_topology
	.p2align	2
silica_rt_get_cpu_topology:
# Frame: [rbp-8] w19 P-cores, [rbp-16] w20 E-cores, [rbp-24] w21 total, [rbp-32] x22 cores list,
# [rbp-40] x23 scratch node, [rbp-48] x24 / [rbp-80] x28 core-id range list, [rbp-56] x25 cache levels,
# [rbp-64] x26 caps / numa list, [rbp-72] x27 memsize; [rbp-88] w9 loop counter and [rbp-96] w10
# are kept in the frame because malloc clobbers r10/r11. The sysctl scratch pair lives at [rsp], [rsp+8].
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	sub	rsp, 16
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf0_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_topo_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 8], rax
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf1_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_topo_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 16], rax
	add	rsp, 16
	mov	eax, DWORD PTR [rbp - 8]
	add	eax, DWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 24], rax
	test	eax, eax
	jz	L_topo_fail_zero
	call	silica_rt_apple_hw_optional_caps_list
	mov	QWORD PTR [rbp - 64], rdi
# cores: one boxed core_info (40 bytes: shape word, id, core_type, capabilities, frequency_mhz) per
# id, its pointer in an id-ordered word array ([rbp-96], region), then the List[core_info] handle
# built over the array by silica_rt_build_list_from_words into [rbp-32]. The record lists
# get_cpu_topology answers (cores, numa_nodes, memory_ranges, cache levels) were 16-byte
# {record, next} cons cells until 2026-10-20, which compiled code read as a list handle:
# length(top.cores) was the first record's address and any walk of the list faulted. The loop
# index is [rbp-88], ascending.
	mov	edi, DWORD PTR [rbp - 24]
	shl	rdi, 3
	call	silica_rt_region_alloc
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 96], rdi
	mov	QWORD PTR [rbp - 88], 0
L_topo_core_loop:
	mov	rax, QWORD PTR [rbp - 88]
	cmp	eax, DWORD PTR [rbp - 24]
	jae	L_topo_after_cores
	mov	edi, 40
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 40], rdi
	mov	QWORD PTR [rdi], 65537
	mov	r11, QWORD PTR [rbp - 88]
	mov	QWORD PTR [rdi + 8], r11
	cmp	r11d, DWORD PTR [rbp - 8]
	setl	al
	movzx	eax, al
	mov	QWORD PTR [rdi + 16], rax
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rdi + 24], rax
	mov	QWORD PTR [rdi + 32], 0
	mov	rax, QWORD PTR [rbp - 96]
	mov	QWORD PTR [rax + r11*8], rdi
	add	r11, 1
	mov	QWORD PTR [rbp - 88], r11
	jmp	L_topo_core_loop
L_topo_after_cores:
	mov	rdi, QWORD PTR [rbp - 96]
	mov	esi, DWORD PTR [rbp - 24]
	call	silica_rt_build_list_from_words
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 32], rdi
	xor	edi, edi
	mov	esi, DWORD PTR [rbp - 24]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 48], rdi
	mov	QWORD PTR [rbp - 80], rdi
	lea	rdi, [rip + L_hw_memsize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 72], rdi
	mov	edi, 32
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	L_topo_fail_zero
# memory_range: one NUMA node (Apple Silicon has no multi-domain sysctl matrix). start=0 = domain origin in this layout;
# macOS sysctl does not expose physical DRAM base per node — size is real (hw.memsize bytes). latency=0 = local self-
# distance (ACPI SLIT-style relative units: same node as itself), not an OS picoseconds value.
	mov	QWORD PTR [rdi], 65540
	mov	QWORD PTR [rdi + 8], 0
	mov	rax, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rdi + 16], rax
	mov	QWORD PTR [rdi + 24], 0
# memory_ranges = [that record]: a one-word array on the stack, then the list over it.
	lea	rsp, [rsp - 16]
	mov	QWORD PTR [rsp], rdi
	mov	rdi, rsp
	mov	esi, 1
	call	silica_rt_build_list_from_words
	lea	rsp, [rsp + 16]
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 40], rdi
	mov	edi, 32
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rdi], 65539
	mov	QWORD PTR [rdi + 8], 0
	mov	rax, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rdi + 16], rax
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rdi + 24], rax
# numa_nodes = [that record], the same way.
	lea	rsp, [rsp - 16]
	mov	QWORD PTR [rsp], rdi
	mov	rdi, rsp
	mov	esi, 1
	call	silica_rt_build_list_from_words
	lea	rsp, [rsp + 16]
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rbp - 64], rdi
	mov	edi, DWORD PTR [rbp - 8]
	mov	esi, DWORD PTR [rbp - 16]
	mov	edx, DWORD PTR [rbp - 24]
	mov	rcx, QWORD PTR [rbp - 80]
	call	silica_rt_apple_build_cache_levels
	mov	QWORD PTR [rbp - 56], rdi
	mov	edi, 32
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	L_topo_fail_zero
	mov	QWORD PTR [rdi], 65538
	mov	rax, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rdi + 8], rax
	mov	rax, QWORD PTR [rbp - 64]
	mov	QWORD PTR [rdi + 16], rax
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rdi + 24], rax
	jmp	L_topo_epilogue
L_topo_sysctl_fail:
	add	rsp, 16
L_topo_fail_zero:
# OOM / sysctl / zero-core failure: still return a non-NULL 32-byte record (shape word; cores, numa_nodes, cache_hierarchy
# pointers all nil) so Silica callers can field-load and length(empty) without SIGSEGV. If malloc fails, return NULL.
	mov	edi, 32
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	L_topo_null_ret
	mov	QWORD PTR [rdi], 65538
	mov	QWORD PTR [rdi + 8], 0
	mov	QWORD PTR [rdi + 16], 0
	mov	QWORD PTR [rdi + 24], 0
	jmp	L_topo_epilogue
L_topo_null_ret:
	xor	edi, edi
L_topo_epilogue:
	leave
	ret
	.globl	silica_rt_get_core_capabilities
	.p2align	2
silica_rt_get_core_capabilities:
# Frame: [rbp-8] w19 P-cores, [rbp-16] w20 E-cores, [rbp-24] w21 total, [rbp-40] x23 record, [rbp-80] x28 requested id.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 80], rdi
	sub	rsp, 16
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf0_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_cap_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 8], rax
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_perf1_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_cap_sysctl_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 16], rax
	add	rsp, 16
	mov	eax, DWORD PTR [rbp - 8]
	add	eax, DWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 24], rax
# Only scratch registers (rax, rcx, r10, r11) are used here: compiled callers keep nothing in a
# machine register across a call on this target (regs/README.md, X19..X28 are frame slots), but
# rbx is the X8 sret home and r12 a helper scratch, so neither is touched. The AArch64 routines
# save x27/x28 for the same defect (a caller's live x28 binding read back as the core id).
	mov	rax, QWORD PTR [rbp - 80]
	cmp	rax, 0
	jl	L_cap_emit_sentinel
	mov	r11d, DWORD PTR [rbp - 24]
	cmp	rax, r11
	jae	L_cap_emit_sentinel
	mov	edi, 40
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	L_cap_emit_sentinel
	mov	QWORD PTR [rbp - 40], rdi
	mov	QWORD PTR [rdi], 65537
	mov	rax, QWORD PTR [rbp - 80]
	mov	QWORD PTR [rdi + 8], rax
	mov	r10d, DWORD PTR [rbp - 8]
	cmp	rax, r10
	setl	cl
	movzx	ecx, cl
	mov	QWORD PTR [rdi + 16], rcx
	call	silica_rt_apple_hw_optional_caps_list
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 24], rdi
	mov	QWORD PTR [rax + 32], 0
	mov	rdi, rax
	jmp	L_cap_epilogue
L_cap_sysctl_fail:
	add	rsp, 16
	jmp	L_cap_emit_sentinel
# Failure / OOM: heap core_info with id=-1 (sentinel); core_type=0 (:efficiency); caps/freq zero — distinguish from valid id>=0.
L_cap_emit_sentinel:
	mov	edi, 40
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	L_cap_sentinel_oom
	mov	QWORD PTR [rdi], 65537
	mov	QWORD PTR [rdi + 8], -1
	mov	QWORD PTR [rdi + 16], 0
	mov	QWORD PTR [rdi + 24], 0
	mov	QWORD PTR [rdi + 32], 0
	jmp	L_cap_epilogue
L_cap_sentinel_oom:
	xor	edi, edi
	jmp	L_cap_epilogue
L_cap_epilogue:
	leave
	ret
"
}

