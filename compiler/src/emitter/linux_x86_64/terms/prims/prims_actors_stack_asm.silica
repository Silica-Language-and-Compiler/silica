// Runtime-managed actor stacks, linux_x86_64 port of emitter/linux_aarch64 (GNU/ELF Intel syntax,
// glibc, futex, sysconf/sysinfo) (silica-specification §15.1.2.2, revised 2026-09-17;
// actor_growable_stack_design.md §2.1, §2.2, §4.2, §4.4, §7; Phase1_TODOs/actor_stack_growth_plan.md).
//
// One contiguous inaccessible reservation per actor, made at spawn: the default is the machine's
// memory plus swap (sysconf(_SC_PHYS_PAGES) and sysinfo().totalswap, read once, page rounded) and `stack_policy(reserve, ...)`
// lowers it. Nothing is committed at spawn. The synchronous fault handler commits chunks below the
// committed run: one platform page first, doubling per fault to 1 MB, then 1 MB per fault. The committed
// run is one mapping and the untouched remainder the second; there is no guard mapping. At the message
// boundary the actor's release algorithm decides what stays committed, and a release is an anonymous
// MAP_FIXED remap to PROT_NONE (the same primitive as on Darwin; on Linux it also keeps the two
// mappings merged, which matters against vm.max_map_count).
//
// ACB fields owned by this module (the control block is 528 B; 0..271 and 392..527 are the actor runtime's,
// actor_memory_budget_plan.md items I and N):
//   #272 stack base (reservation low address; 0 = none)   #280 reservation bytes
//   #288 committed bytes (the run [top-committed, top))     #296 high-water committed bytes
//   #304 next growth chunk bytes                           #312 release algorithm 1..5
//   #320 retained bytes (what the algorithm holds now)     #328 32-entry usage ring (track_recent_peak)
//   #336 ring index                                        #344 last message time, monotonic ns
//   #352 per-thread signal alt stack (64 KB mapping; 0 for a carrier actor, whose carrier has one)
//   #360 policy as given (for children to inherit)
//   #368 runtime SP saved while a behavior runs on the actor stack   #376 1 = reservation was lowered
//   #384 pending (:explicit, atom) reason atom for the exit payload
// Release algorithms: 1 :release_on_return, 2 :keep_last_message, 3 :track_recent_peak,
// 4 :release_when_idle, 5 :keep_high_water. The packed stack_policy word is (reserve & ~15) | algorithm.
//
// Per-message usage for :keep_last_message and :track_recent_peak is measured, not guessed: the run is
// zero at the start of every message (fresh pages are zero and the runtime zeroes what a message used
// before the next one), so the lowest page holding a nonzero word after the behavior returns is the
// message's depth. The scan costs the untouched pages, which are exactly the ones about to be released.
// :release_when_idle: a carrier actor is swept by its carrier (prims_actors_carrier_asm.silica,
// silica_rt_carrier_sweep) a second after its last message; a dangerous actor, on a thread of its own,
// waits for mail with a one-second timeout while it holds committed stack and releases on expiry
// (silica_rt_stack_idle_check, the same check the sweep makes).
//
// silica_rt_stack_runtime_init also reads the carrier count (SILICA_CARRIER_COUNT, else the machine's
// logical cores) and the machine's core counts (prims_actors_carrier_asm.silica).
//
// x86-64 conventions (RUNTIME_GUIDE.md): arguments X0..X5 arrive in rdi rsi rdx rcx r8 r9 and every
// result leaves in rdi; C library results arrive in rax and are moved to rdi. Values the AArch64 text
// kept in x19..x24 live in frame slots [rbp - 8] .. [rbp - 48] (nothing survives a call but rbp/rsp);
// x8..x13 temporaries use caller-saved registers only (rax rcx rdx r8 r9 r10 r11), never across a call.
// Every frame is `push rbp; mov rbp, rsp; sub rsp, N` with N a multiple of 16, so rsp is 16-byte
// aligned at every call; leaf routines (prefix_for, measure) have no frame.

use atom_table;

export emit_actor_stack_runtime_asm/1;

fn stack_asm_data(stack_exhausted_idx: string, reserve_failed_idx: string, thread_limit_idx: string) -> string {
    p0: string <- "	.bss
	.p2align	3
silica_rt_stack_page:
	.zero	8
silica_rt_stack_default_reserve:
	.zero	8
silica_rt_stack_init_done:
	.zero	8
	.data
	.p2align	3
	.globl	silica_rt_stack_exhausted_atom
silica_rt_stack_exhausted_atom:
	.quad	";
    p1: string <- concat(concat(p0, stack_exhausted_idx), "
	.globl	silica_rt_stack_reserve_failed_atom
silica_rt_stack_reserve_failed_atom:
	.quad	");
    p2: string <- concat(concat(p1, reserve_failed_idx), "
	.globl	silica_rt_thread_limit_atom
silica_rt_thread_limit_atom:
	.quad	");
    concat(concat(p2, thread_limit_idx), "
	.section .rodata
")
}

fn stack_asm_init() -> string {
    "	.text
	.globl	silica_rt_stack_runtime_init
	.p2align	2
silica_rt_stack_runtime_init:
# Read the platform page and the default reservation (physical memory + swap) once.
# _SC_PAGESIZE = 30, _SC_PHYS_PAGES = 85; struct sysinfo (112 B): totalswap @64, mem_unit (u32) @104.
# Frame: [rbp - 8] = &silica_rt_stack_init_done (x19), [rbp - 16] = page (x20);
# [rsp + 32] = pages * page, [rsp + 48 .. 160) = struct sysinfo.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 240
	lea	rax, [rip + silica_rt_stack_init_done]
	mov	QWORD PTR [rbp - 8], rax
	cmp	QWORD PTR [rax], 0
	jne	Lsri_done
	mov	edi, 30
	call	sysconf
	cmp	rax, 0
	jg	Lsri_have_page
	mov	eax, 4096
Lsri_have_page:
	mov	QWORD PTR [rbp - 16], rax
	lea	rcx, [rip + silica_rt_stack_page]
	mov	QWORD PTR [rcx], rax
	mov	edi, 85
	call	sysconf
	xor	ecx, ecx
	cmp	rax, 0
	cmovle	rax, rcx
	imul	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rsp + 32], rax
	lea	rdi, [rsp + 48]
	call	sysinfo
	test	eax, eax
	jz	Lsri_swap_ok
	mov	QWORD PTR [rsp + 112], 0
	mov	DWORD PTR [rsp + 152], 1
Lsri_swap_ok:
	mov	r10, QWORD PTR [rsp + 32]
	mov	r11, QWORD PTR [rsp + 112]
	mov	eax, DWORD PTR [rsp + 152]
	test	eax, eax
	jnz	Lsri_unit_ok
	mov	eax, 1
Lsri_unit_ok:
	imul	r11, rax
	add	r10, r11
	test	r10, r10
	jnz	Lsri_have_total
	mov	r10, 17179869184
Lsri_have_total:
	mov	r11, QWORD PTR [rbp - 16]
	sub	r11, 1
	add	r10, r11
	not	r11
	and	r10, r11
	lea	rax, [rip + silica_rt_stack_default_reserve]
	mov	QWORD PTR [rax], r10
# The carrier count (item N): SILICA_CARRIER_COUNT=<n> in the environment (decimal, n >= 1; unset,
# 0 or anything else is ignored), else the machine's logical cores (hw.logicalcpu through the
# sysctl shim: sysconf(_SC_NPROCESSORS_ONLN)), at least 1. Carriers are the only model
# (prims_actors_carrier_asm.silica header): there is no gate. r10 = the count being parsed.
	lea	rdi, [rip + L_srt_carrier_count_env]
	call	getenv
	xor	r10d, r10d
	test	rax, rax
	jz	Lsri_count_sysctl
Lsri_count_digit:
	movzx	ecx, BYTE PTR [rax]
	sub	ecx, 48
	cmp	ecx, 9
	ja	Lsri_count_parsed
	imul	r10, r10, 10
	add	r10, rcx
	inc	rax
	jmp	Lsri_count_digit
Lsri_count_parsed:
	test	r10, r10
	jnz	Lsri_count_have
Lsri_count_sysctl:
	lea	rdi, [rip + L_srt_hw_logicalcpu]
	call	silica_rt_sysctl_u64
	mov	r10, rdi
	test	r10, r10
	jnz	Lsri_count_have
	mov	r10d, 1
Lsri_count_have:
	mov	QWORD PTR [rip + silica_rt_carrier_count], r10
# The machine's own counts (item N stage 3), whatever the carrier count: the logical cores
# (hw.logicalcpu, at least 1), which bound the core ids placement accepts, and the performance
# cores among them (hw.perflevel0.logicalcpu: the P cores are ids [0, P) as get_cpu_topology
# reports them; on Linux the shim answers the logical count for both, every core a P core).
	lea	rdi, [rip + L_srt_hw_logicalcpu]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jnz	Lsri_logical_have
	mov	edi, 1
Lsri_logical_have:
	mov	QWORD PTR [rip + silica_rt_logical_cpu_count], rdi
	lea	rdi, [rip + L_srt_hw_perf0_logicalcpu]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jnz	Lsri_pcore_have
	mov	rdi, QWORD PTR [rip + silica_rt_logical_cpu_count]
Lsri_pcore_have:
	mov	QWORD PTR [rip + silica_rt_pcore_count], rdi
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], 1
Lsri_done:
	leave
	ret
	.globl	silica_rt_stack_prefix_for
	.p2align	2
silica_rt_stack_prefix_for:
# X0 = bytes to keep -> X0 = the smallest chunk-sequence prefix sum >= X0, X1 = the chunk after it.
# Leaf: rdx = chunk (x9), rcx = prefix (x10), r8 = 1 MB (x11).
	lea	rax, [rip + silica_rt_stack_page]
	mov	rdx, QWORD PTR [rax]
	xor	ecx, ecx
	mov	r8d, 1048576
Lspf_loop:
	cmp	rcx, rdi
	jae	Lspf_done
	add	rcx, rdx
	cmp	rdx, r8
	jae	Lspf_loop
	shl	rdx, 1
	jmp	Lspf_loop
Lspf_done:
	mov	rdi, rcx
	mov	rsi, rdx
	ret
	.globl	silica_rt_stack_now_ns
	.p2align	2
silica_rt_stack_now_ns:
# clock_gettime(CLOCK_MONOTONIC = 1, &timespec at [rsp]) -> X0 = seconds * 1e9 + nanoseconds.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	edi, 1
	mov	rsi, rsp
	call	clock_gettime
	mov	rdi, QWORD PTR [rsp]
	mov	rsi, QWORD PTR [rsp + 8]
	imul	rdi, rdi, 1000000000
	add	rdi, rsi
	leave
	ret
"
}

fn stack_asm_reserve() -> string {
    "	.globl	silica_rt_actor_stack_reserve
	.p2align	2
silica_rt_actor_stack_reserve:
# X0 = ACB, X1 = packed stack_policy (0 = inherit the spawning actor's, else the default with
# :keep_last_message). Returns X0 = 0 on success, 1 when no reservation could be made.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] policy (x20), [rbp - 24] algorithm (x21), [rbp - 32] reserve
# bytes (x22), [rbp - 40] page (x23), [rbp - 48] 1 = lowered (x24).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	call	silica_rt_stack_runtime_init
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lasr_have_policy
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lasr_default_policy
	mov	rax, QWORD PTR [rdi + 360]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jnz	Lasr_have_policy
Lasr_default_policy:
	mov	QWORD PTR [rbp - 16], 2
Lasr_have_policy:
	mov	rax, QWORD PTR [rbp - 16]
	and	rax, 15
	mov	QWORD PTR [rbp - 24], rax
	jnz	Lasr_alg_ok
	mov	QWORD PTR [rbp - 24], 2
Lasr_alg_ok:
	mov	rax, QWORD PTR [rbp - 16]
	and	rax, -16
	mov	QWORD PTR [rbp - 32], rax
	lea	rcx, [rip + silica_rt_stack_page]
	mov	rcx, QWORD PTR [rcx]
	mov	QWORD PTR [rbp - 40], rcx
	mov	QWORD PTR [rbp - 48], 0
	test	rax, rax
	jz	Lasr_default
	mov	QWORD PTR [rbp - 48], 1
	mov	r10, rcx
	sub	r10, 1
	add	rax, r10
	not	r10
	and	rax, r10
	mov	QWORD PTR [rbp - 32], rax
	jmp	Lasr_try
Lasr_default:
	lea	rax, [rip + silica_rt_stack_default_reserve]
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
Lasr_try:
# mmap(0, reserve, PROT_NONE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE = 0x4022, -1, 0)
	xor	edi, edi
	mov	rsi, QWORD PTR [rbp - 32]
	xor	edx, edx
	mov	ecx, 16418
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	mov	rdi, rax
	cmp	rdi, -1
	jne	Lasr_mapped
	cmp	QWORD PTR [rbp - 48], 0
	jne	Lasr_fail
# The host refused the whole-machine reservation by heuristic: reserve just under it, in
# sixteenths, down to half of the default.
	lea	rax, [rip + silica_rt_stack_default_reserve]
	mov	r10, QWORD PTR [rax]
	mov	r11, r10
	shr	r11, 4
	mov	rax, QWORD PTR [rbp - 40]
	sub	rax, 1
	add	r11, rax
	not	rax
	and	r11, rax
	mov	rax, QWORD PTR [rbp - 32]
	sub	rax, r11
	mov	QWORD PTR [rbp - 32], rax
	shr	r10, 1
	cmp	rax, r10
	jb	Lasr_fail
	jmp	Lasr_try
Lasr_mapped:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 272], rdi
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 280], rcx
	mov	QWORD PTR [rax + 288], 0
	mov	QWORD PTR [rax + 296], 0
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 304], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 312], rcx
	mov	QWORD PTR [rax + 320], 0
	mov	QWORD PTR [rax + 328], 0
	mov	QWORD PTR [rax + 336], 0
	mov	QWORD PTR [rax + 344], 0
	mov	QWORD PTR [rax + 352], 0
	mov	r10, QWORD PTR [rbp - 16]
	and	r10, -16
	or	r10, rcx
	mov	QWORD PTR [rax + 360], r10
	mov	QWORD PTR [rax + 368], 0
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 376], rcx
	mov	QWORD PTR [rax + 384], 0
	cmp	QWORD PTR [rbp - 24], 3
	jne	Lasr_no_ring
	mov	edi, 32
	mov	esi, 8
	call	calloc
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 328], rax
Lasr_no_ring:
	xor	edi, edi
	jmp	Lasr_ret
Lasr_fail:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 272], 0
	mov	edi, 1
Lasr_ret:
	leave
	ret
	.globl	silica_rt_actor_altstack_install
	.p2align	2
silica_rt_actor_altstack_install:
# X0 = ACB. Every actor thread faults with SP inside its own inaccessible reservation, so the
# handler needs an alternate stack of its own on this thread (#352). A carrier installs one for
# its thread the same way (silica_rt_altstack_install_at, the word in its own block).
	add	rdi, 352
	.globl	silica_rt_altstack_install_at
	.p2align	2
silica_rt_altstack_install_at:
# X0 = the word that records the 64 KB mapping for this thread's signal alternate stack.
# Frame: [rbp - 8] the word (x19); stack_t at [rsp]: ss_sp @0, ss_flags (int) @8, ss_size @16.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 112
	mov	QWORD PTR [rbp - 8], rdi
# mmap(0, 65536, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS = 0x22, -1, 0)
	xor	edi, edi
	mov	esi, 65536
	mov	edx, 3
	mov	ecx, 34
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	cmp	rax, -1
	je	Lsai_ret
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx], rax
	mov	QWORD PTR [rsp], rax
	mov	QWORD PTR [rsp + 8], 0
	mov	QWORD PTR [rsp + 16], 65536
	mov	rdi, rsp
	xor	esi, esi
	call	sigaltstack
Lsai_ret:
	leave
	ret
	.globl	silica_rt_actor_stack_free
	.p2align	2
silica_rt_actor_stack_free:
# X0 = ACB, X1 = 1 when called on the alt stack (keep it mapped). Unmaps the reservation.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] on-alt-stack flag (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rdi, QWORD PTR [rdi + 272]
	test	rdi, rdi
	jz	Lsaf_alt
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax + 280]
	call	munmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 272], 0
Lsaf_alt:
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lsaf_ring
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 352]
	test	rdi, rdi
	jz	Lsaf_ring
	mov	esi, 65536
	call	munmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 352], 0
Lsaf_ring:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 328]
	test	rdi, rdi
	jz	Lsaf_done
	call	free
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 328], 0
Lsaf_done:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 288], 0
	mov	QWORD PTR [rax + 320], 0
	leave
	ret
"
}

fn stack_asm_grow_release() -> string {
    "	.globl	silica_rt_stack_grow_to
	.p2align	2
silica_rt_stack_grow_to:
# X0 = ACB, X1 = faulting address inside the reservation. Commits chunks below the committed run
# until the address is covered. X0 = 0 grown, 1 the lowered reservation is exhausted, 2 the host
# refused the commit, 3 the address was already committed (not stack growth).
# Frame: [rbp - 8] ACB (x19), [rbp - 16] address (x20), [rbp - 24] run low address (x21),
# [rbp - 32] chunk (x22), [rbp - 40] 1 = grew (x23).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 40], 0
Lsgt_loop:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r8, QWORD PTR [rax + 272]
	mov	r10, QWORD PTR [rax + 280]
	add	r10, r8
	mov	r11, QWORD PTR [rax + 288]
	mov	rcx, r10
	sub	rcx, r11
	mov	QWORD PTR [rbp - 24], rcx
	cmp	QWORD PTR [rbp - 16], rcx
	jae	Lsgt_covered
# The lowest page of the reservation is never committed: reaching it is the end of the
# reservation whatever mapping sits below (the remainder stays a second, inaccessible mapping).
	mov	rdx, QWORD PTR [rax + 304]
	mov	QWORD PTR [rbp - 32], rdx
	mov	r11, rcx
	sub	r11, r8
	lea	rax, [rip + silica_rt_stack_page]
	mov	rax, QWORD PTR [rax]
	sub	r11, rax
	jbe	Lsgt_exhausted
	cmp	rdx, r11
	cmova	rdx, r11
	mov	QWORD PTR [rbp - 32], rdx
	mov	rdi, rcx
	sub	rdi, rdx
	mov	rsi, rdx
	mov	edx, 3
	call	mprotect
	test	eax, eax
	jnz	Lsgt_commit_failed
	mov	QWORD PTR [rbp - 40], 1
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 288]
	add	r11, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 288], r11
	cmp	r11, QWORD PTR [rax + 296]
	jbe	Lsgt_no_hw
	mov	QWORD PTR [rax + 296], r11
Lsgt_no_hw:
	mov	rcx, QWORD PTR [rax + 304]
	cmp	rcx, 1048576
	jae	Lsgt_loop
	shl	rcx, 1
	mov	QWORD PTR [rax + 304], rcx
	jmp	Lsgt_loop
Lsgt_covered:
	cmp	QWORD PTR [rbp - 40], 0
	je	Lsgt_not_ours
	xor	edi, edi
	jmp	Lsgt_ret
Lsgt_not_ours:
	mov	edi, 3
	jmp	Lsgt_ret
Lsgt_exhausted:
	mov	edi, 1
	jmp	Lsgt_ret
Lsgt_commit_failed:
	mov	edi, 2
Lsgt_ret:
	leave
	ret
	.globl	silica_rt_stack_measure
	.p2align	2
silica_rt_stack_measure:
# X0 = ACB -> X0 = bytes from the top down to the lowest page holding a nonzero word (0 = none).
# Leaf: rsi = base (x8), rdx = top (x9), rcx = committed (x10), r8 = page cursor (x11),
# r9 = page size (x12), r10 = word cursor (x13), r11 = page end (x14).
	mov	rsi, QWORD PTR [rdi + 272]
	mov	rdx, QWORD PTR [rdi + 280]
	add	rdx, rsi
	mov	rcx, QWORD PTR [rdi + 288]
	mov	r8, rdx
	sub	r8, rcx
	lea	r9, [rip + silica_rt_stack_page]
	mov	r9, QWORD PTR [r9]
Lsm_page:
	cmp	r8, rdx
	jae	Lsm_none
	mov	r10, r8
	mov	r11, r8
	add	r11, r9
Lsm_word:
	mov	rax, QWORD PTR [r10]
	or	rax, QWORD PTR [r10 + 8]
	lea	r10, [r10 + 16]
	jnz	Lsm_found
	cmp	r10, r11
	jb	Lsm_word
	mov	r8, r11
	jmp	Lsm_page
Lsm_found:
	mov	rdi, rdx
	sub	rdi, r8
	ret
Lsm_none:
	xor	edi, edi
	ret
	.globl	silica_rt_stack_release_to
	.p2align	2
silica_rt_stack_release_to:
# X0 = ACB, X1 = bytes to keep, X2 = bytes at the top the last message used (zeroed if kept).
# Releases whole chunks below the smallest chunk prefix that covers X1, in the sizes they grew by.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] keep prefix (x20), [rbp - 24] used (x21), [rbp - 32] next chunk (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 24], rdx
	mov	rdi, rsi
	test	rdi, rdi
	jz	Lsrt_zero_keep
	call	silica_rt_stack_prefix_for
	jmp	Lsrt_have
Lsrt_zero_keep:
	xor	edi, edi
	lea	rax, [rip + silica_rt_stack_page]
	mov	rsi, QWORD PTR [rax]
Lsrt_have:
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 32], rsi
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 288]
	cmp	rdi, r11
	jae	Lsrt_zero
	mov	r8, QWORD PTR [rax + 272]
	mov	r10, QWORD PTR [rax + 280]
	add	r10, r8
	mov	rdi, r10
	sub	rdi, r11
	mov	rsi, r11
	sub	rsi, QWORD PTR [rbp - 16]
# mmap(run low, committed - keep, PROT_NONE, MAP_FIXED|MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE = 0x4032, -1, 0)
	xor	edx, edx
	mov	ecx, 16434
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 288], rcx
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 304], rcx
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lsrt_zero
	mov	rdi, QWORD PTR [rax + 352]
	test	rdi, rdi
	jz	Lsrt_zero
	mov	esi, 65536
	mov	edx, 4
	call	madvise
Lsrt_zero:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 288]
	mov	QWORD PTR [rax + 320], r11
	mov	rcx, QWORD PTR [rbp - 24]
	test	rcx, rcx
	jz	Lsrt_ret
	cmp	rcx, r11
	cmova	rcx, r11
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	Lsrt_ret
	mov	r8, QWORD PTR [rax + 272]
	mov	r10, QWORD PTR [rax + 280]
	add	r10, r8
	mov	rdi, r10
	sub	rdi, rcx
	xor	esi, esi
	mov	rdx, rcx
	call	memset
Lsrt_ret:
	leave
	ret
	.globl	silica_rt_stack_on_message_return
	.p2align	2
silica_rt_stack_on_message_return:
# X0 = ACB. The behavior has returned and the stack is empty: apply the actor's release algorithm.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] measured depth (x20), [rbp - 24] bytes to keep (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	cmp	QWORD PTR [rdi + 272], 0
	je	Lsmr_ret
	mov	r10, QWORD PTR [rdi + 312]
	cmp	r10, 5
	je	Lsmr_keep_all
	cmp	r10, 4
	je	Lsmr_idle_stamp
	cmp	r10, 1
	je	Lsmr_release_all
	call	silica_rt_stack_measure
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 312], 3
	jne	Lsmr_keep_depth
	mov	r11, QWORD PTR [rax + 328]
	test	r11, r11
	jz	Lsmr_keep_depth
	mov	rcx, QWORD PTR [rax + 336]
	mov	rdx, rcx
	and	rdx, 31
	mov	QWORD PTR [r11 + rdx*8], rdi
	add	rcx, 1
	mov	QWORD PTR [rax + 336], rcx
	xor	edx, edx
	xor	r8d, r8d
Lsmr_ring_max:
	mov	r9, QWORD PTR [r11 + rdx*8]
	cmp	r9, r8
	cmova	r8, r9
	add	rdx, 1
	cmp	rdx, 32
	jb	Lsmr_ring_max
	mov	QWORD PTR [rbp - 24], r8
	jmp	Lsmr_release_keep
Lsmr_keep_depth:
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 24], rax
Lsmr_release_keep:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 24]
	mov	rdx, QWORD PTR [rbp - 16]
	call	silica_rt_stack_release_to
	jmp	Lsmr_ret
Lsmr_keep_all:
	mov	r11, QWORD PTR [rdi + 288]
	mov	QWORD PTR [rdi + 320], r11
	jmp	Lsmr_ret
Lsmr_idle_stamp:
	mov	r11, QWORD PTR [rdi + 288]
	mov	QWORD PTR [rdi + 320], r11
	call	silica_rt_stack_now_ns
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 344], rdi
	jmp	Lsmr_ret
Lsmr_release_all:
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_stack_release_to
Lsmr_ret:
	leave
	ret
	.globl	silica_rt_stack_idle_check
	.p2align	2
silica_rt_stack_idle_check:
# X0 = ACB -> X0 = mailbox wait timeout in microseconds (0 = wait without a timeout). Only
# :release_when_idle actors holding committed stack wait with a timeout; once a second has passed
# since the last message the stack is released and the wait becomes untimed.
# Frame: [rbp - 8] ACB (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	cmp	QWORD PTR [rdi + 312], 4
	jne	Lsic_none
	cmp	QWORD PTR [rdi + 288], 0
	je	Lsic_none
	call	silica_rt_stack_now_ns
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 344]
	mov	rdx, rdi
	sub	rdx, rcx
	mov	r8, 1000000000
	cmp	rdx, r8
	jb	Lsic_wait
	mov	rdi, rax
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_stack_release_to
	jmp	Lsic_none
Lsic_wait:
	sub	r8, rdx
	mov	rax, r8
	xor	edx, edx
	mov	ecx, 1000
	div	rcx
	lea	rdi, [rax + 1]
	jmp	Lsic_ret
Lsic_none:
	xor	edi, edi
Lsic_ret:
	leave
	ret
	.globl	silica_rt_cv_wait_timeout
	.p2align	2
silica_rt_cv_wait_timeout:
# X0 = cv_addr, X1 = lock_addr, X2 = timeout in microseconds (0 = none). Caller holds the lock;
# the lock is held again on return, whether woken or timed out.
# Frame: [rbp - 8] cv (x19), [rbp - 16] lock (x20), [rbp - 24] timeout (x21), [rbp - 32] cv snapshot (w22);
# struct timespec at [rsp].
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	eax, DWORD PTR [rdi]
	mov	QWORD PTR [rbp - 32], rax
	mov	rdi, rsi
	call	silica_rt_lock_unlock
	cmp	QWORD PTR [rbp - 24], 0
	je	Lcwt_untimed
# futex(addr, FUTEX_WAIT_PRIVATE = 128, expected, &timespec{us / 1000000, (us % 1000000) * 1000}, 0, 0),
# raw syscall 202 (clobbers rcx, r11).
	mov	rax, QWORD PTR [rbp - 24]
	xor	edx, edx
	mov	rcx, 1000000
	div	rcx
	imul	rdx, rdx, 1000
	mov	QWORD PTR [rsp], rax
	mov	QWORD PTR [rsp + 8], rdx
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 128
	mov	edx, DWORD PTR [rbp - 32]
	mov	r10, rsp
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
	jmp	Lcwt_lock
Lcwt_untimed:
	mov	edi, 3
	mov	rsi, QWORD PTR [rbp - 8]
	mov	edx, DWORD PTR [rbp - 32]
	xor	ecx, ecx
	call	silica_rt_futex_wait
Lcwt_lock:
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_lock_lock
	leave
	ret
"
}

fn stack_asm_fail_and_report() -> string {
    "	.globl	silica_rt_actor_fail_current
	.p2align	2
silica_rt_actor_fail_current:
# X0 = the current actor's ACB, X1 = reason atom. Ends the actor with (:explicit, atom): wakes its
# waiters, delivers the exit to its supervisor, frees what it owns and exits the thread. For a
# dangerous actor (a thread of its own) it runs on the signal alt stack (stack exhaustion) or on
# the actor stack (a spawn whose reservation failed). For a carrier actor it is entered on the
# carrier's stack (the fault handler returns into it there, through the signal frame with
# rsp = the carrier's base - 8, so the carrier's alternate-stack state is intact for the next
# fault) or on the actor's own (a failed spawn inside a behaviour or a start trampoline, a
# duplicate child id) and ends in the carrier loop; the reservation is freed first, before any
# waiter is woken, unless the actor has a supervision block ([rbp - 16] = 1): then its children
# are shut down in the delivering phase, each waited for, and the waits park, which needs a stack
# the carrier loop leaves alone: the top of its own reservation (every frame below it is
# abandoned: a fault's signal frame was unwound by the kernel, a failed spawn never returns),
# unmapped after that phase instead.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] 1 = delivering on the reservation (x20), [rbp - 24] the
# carrier (x21; 0 for a dangerous actor). Every stack switch below opens a fresh frame and
# rewrites the three slots (they are memory, not registers): this routine never returns, so the
# abandoned frames are not unwound.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rdi + 384], rsi
	mov	r11, QWORD PTR [rdi + 440]
	mov	QWORD PTR [rbp - 24], r11
	mov	QWORD PTR [rbp - 16], 0
	test	r11, r11
	jz	Lafc_thread_actor
	cmp	QWORD PTR [rdi + 216], 0
	je	Lafc_carrier_stack
	mov	r10, QWORD PTR [rdi + 272]
	test	r10, r10
	jz	Lafc_carrier_stack
	add	r10, QWORD PTR [rdi + 280]
	mov	rsp, r10
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 1
	mov	QWORD PTR [rbp - 24], r11
	jmp	Lafc_deliver
Lafc_carrier_stack:
	mov	r10, QWORD PTR [r11 + 48]
	mov	rsp, r10
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 0
	mov	QWORD PTR [rbp - 24], r11
	jmp	Lafc_on_stack
Lafc_thread_actor:
# Move onto the thread's alt stack (its top; nothing there is needed again) so the actor stack
# this may be running on can be unmapped now. On the exhaustion path we are already there.
# The stack is given back before any waiter is woken, as at a message boundary: a caller that
# wakes on the death and asks get_actor_memory_usage must already see the reservation gone.
	mov	r10, QWORD PTR [rdi + 352]
	test	r10, r10
	jz	Lafc_on_stack
	add	r10, 65536
	mov	rsp, r10
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 0
	mov	QWORD PTR [rbp - 24], 0
Lafc_on_stack:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 1
	call	silica_rt_actor_stack_free
Lafc_deliver:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 232], 4
	mov	DWORD PTR [rax + 152], 0
	mov	rdi, rax
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 216]
	test	rcx, rcx
	jz	Lsbg_afc
	mov	rcx, QWORD PTR [rcx + 40]
Lsbg_afc:
	test	rcx, rcx
	jne	Lafc_report_done
	mov	rdi, rax
	call	silica_rt_actor_deliver_exit
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_deliver_unwind_report
Lafc_report_done:
# The started word (#224) is set after the report so a spawner spinning on it (actor_spawn /
# spawn_linked, while this actor's start trampoline ran) proceeds: 2 = the init trampoline failed (stack exhausted, a failed spawn reservation, a duplicate child id). The ACB is
# not freed under the spawner: it goes with its last holder (silica_rt_acb_release); a row child's
# exit notice is parked at #400 until its spawner has committed it to the row.
	mov	r10, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [r10 + 224], 0
	jne	Lafc_started_set
	mov	rdi, r10
	mov	esi, 2
	call	silica_rt_started_store
Lafc_started_set:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_signal_pending_call_deaths
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_ffi_arena_teardown
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_child_table_free
# The delivering phase ran on the reservation ([rbp - 16]): nothing waits any more, so onto the
# carrier's stack (a fresh frame there holds the actor and the carrier) and the reservation goes.
	cmp	QWORD PTR [rbp - 16], 0
	je	Lafc_stack_done
	mov	rdi, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rbp - 24]
	mov	rsp, QWORD PTR [r11 + 48]
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], 1
	mov	QWORD PTR [rbp - 24], r11
	xor	esi, esi
	call	silica_rt_actor_stack_free
Lafc_stack_done:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_dealloc_region
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_final_release
	cmp	QWORD PTR [rbp - 24], 0
	je	Lafc_thread_exit
	mov	rdi, QWORD PTR [rbp - 24]
	jmp	silica_rt_carrier_loop_enter
Lafc_thread_exit:
	xor	edi, edi
	call	pthread_exit
	jmp	Lafc_thread_exit
	.globl	silica_rt_spawn_reserve_failed
	.p2align	2
silica_rt_spawn_reserve_failed:
# A spawn could not make its reservation. The spawning actor fails with
# (:explicit, :stack_reserve_failed). `main` is not an actor and has no supervisor, so there the
# process ends with a runtime abort, reason stack reservation failed, status 71 (spec 15.1.2.2,
# 15.4.5.5), reported at the spawn routine's call to this function. Never returns.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lsrf_main
	lea	rax, [rip + silica_rt_stack_reserve_failed_atom]
	mov	rsi, QWORD PTR [rax]
	call	silica_rt_actor_fail_current
Lsrf_main:
	pop	rbp
	jmp	silica_rt_abort_stack_reserve
	.globl	silica_rt_spawn_thread_failed
	.p2align	4
silica_rt_spawn_thread_failed:
# A spawn_dangerous, or the start of a :dangerous row, could not make the actor's thread: the host
# refused it (pthread_create failed; macOS caps a task at kern.num_taskthreads threads, 4096, so
# about the 4,080th dangerous actor, Linux at its thread and mapping limits). The spawn gave back
# what it had taken before coming here (actor_memory_budget_plan.md item N, #5 option C). The
# spawning actor fails with (:explicit, :thread_limit), as it does for a reservation it cannot
# make; `main` is not an actor and has no supervisor, so there the process ends with a runtime
# abort, reason the thread of a dangerous actor could not be created, status 71 (spec 15.4.5.5),
# reported at the spawn routine's call to this function. Never returns.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lstf_main
	lea	rax, [rip + silica_rt_thread_limit_atom]
	mov	rsi, QWORD PTR [rax]
	call	silica_rt_actor_fail_current
Lstf_main:
	pop	rbp
	jmp	silica_rt_abort_dangerous_thread
	.globl	silica_rt_get_actor_memory_usage
	.p2align	2
silica_rt_get_actor_memory_usage:
# rdi = reference: resolved and held for the body (silica_rt_ref_call; an ended actor reads as zero).
	lea	r10, [rip + silica_rt_get_actor_memory_usage_acb]
	jmp	silica_rt_ref_call
	.p2align	2
silica_rt_get_actor_memory_usage_acb:
# X0 = ACB or 0 -> X0 = heap { reserved, committed, retained, high_water } (bytes; all zero once
# the actor has ended).
# Frame: [rbp - 8] actor_ref (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	edi, 40
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	Lgmu_ret
	mov	QWORD PTR [rdi], 65543
	mov	rax, QWORD PTR [rbp - 8]
	cmp	rax, 4096
	jb	Lgmu_zero
	cmp	QWORD PTR [rax + 272], 0
	je	Lgmu_zero
	mov	rcx, QWORD PTR [rax + 280]
	mov	QWORD PTR [rdi + 8], rcx
	mov	rcx, QWORD PTR [rax + 288]
	mov	QWORD PTR [rdi + 16], rcx
	mov	rcx, QWORD PTR [rax + 320]
	mov	QWORD PTR [rdi + 24], rcx
	mov	rcx, QWORD PTR [rax + 296]
	mov	QWORD PTR [rdi + 32], rcx
	jmp	Lgmu_ret
Lgmu_zero:
	mov	QWORD PTR [rdi + 8], 0
	mov	QWORD PTR [rdi + 16], 0
	mov	QWORD PTR [rdi + 24], 0
	mov	QWORD PTR [rdi + 32], 0
Lgmu_ret:
	leave
	ret
"
}

fn emit_actor_stack_runtime_asm(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    stack_exhausted_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":stack_exhausted"));
    reserve_failed_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":stack_reserve_failed"));
    thread_limit_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":thread_limit"));
    concat(concat(concat(concat(stack_asm_data(stack_exhausted_idx, reserve_failed_idx, thread_limit_idx), stack_asm_init()), stack_asm_reserve()), stack_asm_grow_release()), stack_asm_fail_and_report())
}
