// Let-kind emission, named-binding arm -- second stage.
// Continues the binding chain from term_emit_kind_let_named; the eleven scalars
// that cross the seam arrive as parameters.

use prims_tuple;
use reg_conventions;
use string_parse;
use term_aggregate_helpers;
use term_let_helpers;
use term_reg_spill;
use term_sir_helpers;
use var;
use x86_isa;

export emit_kind_let_named_tail/6;

// The value's own home (callee-saved register or X29 frame slot) is what the body reads;
// the [SP, #k] slab alias is only for a value with no home (a spilled tuple root made
// tp_is_reg_b false and handed the body `[SP, #8]` for an element living at [X29, #-144]).
fn lnt_body_bound(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, st: { rhs_reg: string, rhs_asm: string, rhs_bind_b: string, mov_spill_b: string, packs_escape_b: boolean, iap_b: string, va_b: string, proj_tvs: string, tp_is_reg_b: boolean, alloc_bytes: int64, res_binding: string }) -> string {
    case st.packs_escape_b of {
                                true -> st.rhs_bind_b;
                                false -> case st.tp_is_reg_b of {
                                    true -> st.rhs_bind_b;
                                    false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_proj" and length_bytes(st.proj_tvs) > 0 and var@is_callee_saved_reg(st.rhs_bind_b) == false and var@is_frame_slot_ref(st.rhs_bind_b) == false of {
                                        true -> {
                                            pix_b: int64 <- string_parse@string_to_int64(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).right_expr)).value);
                                            byte_b: int64 <- prims_tuple@tuple_field_start_byte_offset(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).type_name, pix_b);
                                            var@sp_offset_for_byte(byte_b)
                                        };
                                        false -> st.rhs_bind_b
                                    }
                                }
                            }
}

fn lnt_reg_binding_inner(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, st: { rhs_reg: string, rhs_asm: string, rhs_bind_b: string, mov_spill_b: string, packs_escape_b: boolean, iap_b: string, va_b: string, proj_tvs: string, tp_is_reg_b: boolean, alloc_bytes: int64, res_binding: string }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string {
    case st.packs_escape_b of {
                                true -> concat("|", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", st.rhs_bind_b)));
                                false -> case st.tp_is_reg_b of {
                                    true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_proj" and length_bytes(st.proj_tvs) > 0 of {
                                        true -> {
                                            pix_r: int64 <- string_parse@string_to_int64(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).right_expr)).value);
                                            byte_r: int64 <- prims_tuple@tuple_field_start_byte_offset(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).type_name, pix_r);
                                            {
                                                  // Mint THROUGH THE BASE POINTER when the projected-from
                                                  // aggregate lives behind one. A static [SP, #off] is only
                                                  // valid while the aggregate occupies its original slot; once
                                                  // that slot is released the offset addresses freed memory
                                                  // below SP (decompose_nested_bare read b at [SP, #-16]).
                                                  base_nm_r: string <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).name;
                                                  base_pr_r: string <- case length_bytes(base_nm_r) > 0 of {
                                                      true -> var@find_last_sp_binding(bound.outer_reg, concat("_ptr.", base_nm_r));
                                                      false -> ""
                                                  };
                                                  base_rg_r: string <- case length_bytes(base_nm_r) > 0 of {
                                                      true -> var@find_last_sp_binding(bound.outer_reg, concat("_va.", base_nm_r));
                                                      false -> ""
                                                  };
                                                  base_rb_r: int64 <- var@parse_x29_neg_offset_bytes(base_rg_r);
                                                  // The element's own home wins when it has one: after the spill the value
                                                  // lives in a callee-saved register (or an X29 frame slot), and that is
                                                  // the binding every later reader and the register allocator must see.
                                                  // Recording only the through-pointer alias here left the home register
                                                  // invisible to liveness (a rebound %_td_0 took n's X22) and left the
                                                  // reader dependent on the base register outliving its own binding
                                                  // (b took X20, n was then read from [X20, #8]) -- decompose_nested_bare.
                                                  case var@is_callee_saved_reg(st.rhs_bind_b) or var@is_frame_slot_ref(st.rhs_bind_b) of {
                                                      true -> concat("|", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", st.rhs_bind_b)));
                                                  false -> case length_bytes(base_pr_r) > 0 and var@is_memory_ref(base_pr_r) == false and var@is_callee_saved_reg(base_pr_r) of {
                                                      true -> concat("|", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", var@reg_offset_for_byte(base_pr_r, byte_r))));
                                                      false -> case base_rb_r > 0 of {
                                                          true -> concat("|", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", var@fp_offset_for_byte(byte_r, 0, base_rb_r))));
                                                          false -> concat("|", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", var@sp_offset_for_byte(byte_r))))
                                                      }
                                                  }
                                                  }
                                              }
                                        };
                                        false -> concat("|", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", st.rhs_bind_b)))
                                    };
                                    false -> ""
                                }
                            }
}

fn emit_kind_let_named_tail(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string, st: { rhs_reg: string, rhs_asm: string, rhs_bind_b: string, mov_spill_b: string, packs_escape_b: boolean, iap_b: string, va_b: string, proj_tvs: string, tp_is_reg_b: boolean, alloc_bytes: int64, res_binding: string }) -> string {
                            body_bound: string <- lnt_body_bound(term, st);
                            tuple_elem_count_b: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term).type_name) of { true -> prims_tuple@count_type_elements(term_sir_helpers@sir_term_root_node(term).type_name); false -> 0 };
                            ptr_binding_inner: string <- case (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 or (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_proj")) and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term).type_name) and length_bytes(st.rhs_reg) > 0 and substring(st.rhs_reg, 0, 1) != "[" of {
                                true -> case tuple_elem_count_b > 2 of {
                                    true -> concat("|_ptr.", concat(term_sir_helpers@sir_term_root_node(term).name, "=X12"));
                                    false -> concat("|_ptr.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", st.rhs_bind_b)))
                                };
                                false -> ""
                            };
                            save_base_b: string <- case tuple_elem_count_b > 2 and length_bytes(st.rhs_reg) > 0 and substring(st.rhs_reg, 0, 1) != "[" of {
                                true -> x86_isa@x86_mov("X12", st.rhs_bind_b);
                                false -> ""
                            };
                            reg_binding_inner: string <- lnt_reg_binding_inner(term, st, bound);
                            new_outer_raw: string <- case st.packs_escape_b or st.tp_is_reg_b of {
                                true -> {
                                    nob_r: string <- var@base_reg_of(bound.outer_reg);
                                    nosp_r: string <- var@strip_name_family(var@extract_sp_bindings(bound.outer_reg), term_sir_helpers@sir_term_root_node(term).name);
                                    concat(nob_r, concat(nosp_r, reg_binding_inner))
                                };
                                false -> var@build_outer_with_sp(bound.bound_name, bound.bound_reg, bound.outer_reg, term_sir_helpers@sir_term_root_node(term).name, term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), st.rhs_bind_b)
                            };
                            nob: string <- var@base_reg_of(new_outer_raw);
                            nosp: string <- var@extract_sp_bindings(new_outer_raw);
                            // The base register must lead the string (base|name=reg|...): putting the
                            // |_res= reservation first glued the base onto it (|_res=X21X20|...), so the
                            // reservation never matched and base_reg_of read "" for every later let.
                            new_outer: string <- concat(nob, concat(st.res_binding, concat(st.va_b, concat(st.iap_b, concat(nosp, ptr_binding_inner)))));
                            outer_for_body_pre: string <- term_reg_spill@outer_append_id_ret_tuple_sret(term, concat(new_outer, term_let_helpers@list_cons_tail_rebind_suffix(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))), bound.outer_reg);
                            outer_for_body: string <- outer_for_body_pre;
                            body_asm: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  dest, pools,  { bound_name: term_sir_helpers@sir_term_root_node(term).name, bound_reg: body_bound, outer_reg: outer_for_body, debug: bound.debug });
                            tuple_sret_outer_n: string <- var@find_sp_binding(outer_for_body, "_tuple_sret");
                            // Phase E e4b: record_make always SUBs SP (see record_make emit comment ~line 1872) and is never written
                            // directly into the actor-reply SRET buffer. So even when _tuple_sret is set on the outer (e.g. behavior
                            // functions with an X20 reply buffer), an intermediate `spec <- { ... }` binding still needs ADD SP at
                            // body-end. Without this, a behavior fn that builds a record literal (e.g. start_child(spec)) leaves SP
                            // 48–112 B too low, corrupting the LDP that restores callee-saved registers on return.
                            base_stack_n: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" of {
                                true -> term_aggregate_helpers@aggregate_callee_return_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                false -> case length_bytes(tuple_sret_outer_n) > 0 of {
                                    // The call emitter reserves a caller sret slab for every tuple-returning
                                    // user call unless the enclosing function passes its own X8 through
                                    // (`_callee_sret`); a behaviour's `_tuple_sret` reply buffer is not that,
                                    // so the let must pop what the call pushed. Returning 0 here left the slab
                                    // under the callee-saved restores: `(status, value) <- safe_divide(100, msg)`
                                    // in a behaviour returned to a garbage LR (exit 70).
                                    // See trials/supervisors_addition/tuple_unpack_in_behaviour.
                                    true -> term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), bound.outer_reg, bound.bound_name);
                                    false -> {
                                        agg_n: int64 <- term_aggregate_helpers@aggregate_callee_return_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                        case agg_n > 0 of {
                                            true -> agg_n;
                                            false -> term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), bound.outer_reg, bound.bound_name)
                                        }
                                    }
                                }
                            };
                            // Escape promote is shallow — keep RHS slab until let-end (do not zero eff).
                            base_stack_eff_n: int64 <- case term_aggregate_helpers@let_suppress_base_stack_overlay_rec_flat(term, base_stack_n) of {
                                true -> term_aggregate_helpers@let_suppressed_base_stack_fixup(term);
                                false -> base_stack_n
                            };
                            // An aggregate built as the tail of a nested let chain (`x <- let a = .. in {..}`,
                            // the shape call_supervisor lowers to) lives in a frame region that the next
                            // aggregate make reuses. A direct aggregate RHS is promoted before its pointer
                            // is bound; the nested-let RHS was not (the inner let promotes only into X0,
                            // the return register), so get_reply pointed at a region which_reply then
                            // overwrote. Move it to the heap here, at the binding, like the direct case.
                            let_tail_agg_n: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 2 and st.rhs_reg != "X0" of {
                                true -> term_aggregate_helpers@let_tail_aggregate_promote_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                false -> 0
                            };
                            early_prom_b: string <- case st.packs_escape_b of {
                                true -> term_aggregate_helpers@let_early_heap_promote_asm(st.rhs_bind_b, term_aggregate_helpers@agg_promote_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)));
                                false -> case let_tail_agg_n > 0 of {
                                    true -> term_aggregate_helpers@let_early_heap_promote_asm(st.rhs_bind_b, let_tail_agg_n);
                                    false -> ""
                                }
                            };
                            tail_stack_raw_n: int64 <- term_aggregate_helpers@let_tail_aggregate_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
                            tail_stack_n: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 2 of {
                                true -> 0;
                                false -> case length_bytes(tuple_sret_outer_n) > 0 of {
                                    true -> 0;
                                    // No size-equality dedup: let_tail_aggregate_stack_bytes is non-zero only
                                    // for a tail that is its own tuple_make/record_make, and such a make always
                                    // emits its own SUB SP, so it never shares the RHS slab. `x <- (a,b); x`
                                    // returns 0 here because that tail is a variable. Treating equal sizes as one
                                    // slab dropped a pop whenever both were 16 bytes -- the common case -- which
                                    // also zeroed tail_ret_n and suppressed the heap promote, returning a pointer
                                    // into the popped slab.
                                    false -> tail_stack_raw_n
                                }
                            };
                            dealloc_bytes: int64 <- base_stack_eff_n + tail_stack_n;
                            dealloc: string <- case dealloc_bytes > 0 of {
                                true -> x86_isa@x86_add("SP", "SP", concat("#", term_let_helpers@dec_str(dealloc_bytes)));
                                false -> ""
                            };
                            id_ret_n: boolean <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 1 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == term_sir_helpers@sir_term_root_node(term).name and reg_conventions@is_aggregate_struct_or_tuple_return_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                            tail_promote_n: int64 <- case length_bytes(tuple_sret_outer_n) > 0 of {
                                true -> 0;
                                false -> term_aggregate_helpers@let_tail_aggregate_promote_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                            };
                            tail_ret_n: boolean <- tail_promote_n > 0;
                            promote_nbytes_n: int64 <- case tail_ret_n of {
                                true -> tail_promote_n;
                                false -> case id_ret_n of {
                                    true -> term_aggregate_helpers@aggregate_callee_return_promote_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                    false -> 0
                                }
                            };
                            promote_asm: string <- case dest == "X0" and promote_nbytes_n > 0 and (id_ret_n or tail_ret_n) and length_bytes(tuple_sret_outer_n) == 0 and term_reg_spill@sret_on_spine(bound.outer_reg, term.root) == false of {
                                true -> term_aggregate_helpers@aggregate_return_heap_promote_x0(promote_nbytes_n);
                                false -> ""
                            };
                            let_prefix_b: string <- concat(concat(concat(concat(st.rhs_asm, "\n"), st.mov_spill_b), save_base_b), early_prom_b);
                            // Ownership-based release, same rule as let_top: a region created
                            // here that never moves out is destroyed at scope end.
                            rgn_local_b: string <- case term_reg_spill@let_owns_local_region(term) of {
                                true -> term_reg_spill@emit_region_destroy_reg(st.rhs_bind_b);
                                false -> ""
                            };
                            let_tail_b: string <- concat(concat(concat("\n", promote_asm), rgn_local_b), dealloc);
                            var@strip_mov_x2_x1_then_x1_x2_at_seams(let_prefix_b, body_asm, let_tail_b)
                        }
