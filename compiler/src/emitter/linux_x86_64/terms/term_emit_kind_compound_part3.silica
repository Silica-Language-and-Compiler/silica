// Compound kind emission part3 (open-recursive via emit_child).

use atom_table;
use var;
use prims;
use prims_actors;
use term_aggregate_helpers;
use term_sir_helpers;
use term_emit_kind_compound_compare;
use x86_isa;
use x86_mem;

export emit_kind_compound_part3/5;

fn emit_kind_compound_part3(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
case prims_actors@is_actor_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> case prims_actors@actor_prim_is_nullary(term_sir_helpers@sir_term_root_node(term).name) of {
                                true -> prims_actors@emit_prim_op(term, dest);
                                false -> case prims_actors@actor_prim_is_unary(term_sir_helpers@sir_term_root_node(term).name) of {
                                    true -> {
                                        arg_asm_u: string <- case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        op_asm_u: string <- prims_actors@emit_prim_op_with_atoms(term, dest, pools.table, bound.outer_reg);
                                        // Phase E e3b2/e4b: actor prim arg may be a record_make / tuple_make literal that did
                                        // SUB SP, SP, #N (e.g. start_child(spec_literal)). Restore SP after the runtime call so
                                        // the surrounding behavior fn's saved-register restore (LDP) reads the correct stack slots.
                                        unary_sp_bytes: int64 <- term_aggregate_helpers@flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                        unary_sp_restore: string <- case unary_sp_bytes > 0 of {
                                            true -> concat("\n", x86_isa@x86_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(unary_sp_bytes))));
                                            false -> ""
                                        };
                                        concat(concat(arg_asm_u, "\n"), concat(op_asm_u, unary_sp_restore))
                                    };
                                    false -> {
                                            left_asm_a: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            spawn_three: boolean <- (term_sir_helpers@sir_term_root_node(term).name == "spawn" or term_sir_helpers@sir_term_root_node(term).name == "spawn_dangerous" or term_sir_helpers@sir_term_root_node(term).name == "spawn_device" or term_sir_helpers@sir_term_root_node(term).name == "spawn_linked") and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == "tuple_make";
                                            spawn_registered_tuple: boolean <- (term_sir_helpers@sir_term_root_node(term).name == "spawn_registered" or term_sir_helpers@sir_term_root_node(term).name == "spawn_dangerous_registered" or term_sir_helpers@sir_term_root_node(term).name == "spawn_device_registered" or term_sir_helpers@sir_term_root_node(term).name == "spawn_registered_supervisor") and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == "tuple_make";
                                            actor_msg_binary: boolean <- term_sir_helpers@sir_term_root_node(term).name == "send" or term_sir_helpers@sir_term_root_node(term).name == "actor_call" or term_sir_helpers@sir_term_root_node(term).name == "actor_call_registered" or term_sir_helpers@sir_term_root_node(term).name == "actor_cast" or term_sir_helpers@sir_term_root_node(term).name == "actor_cast_registered" or term_sir_helpers@sir_term_root_node(term).name == "actor_cast_dangerous_registered" or term_sir_helpers@sir_term_root_node(term).name == "actor_cast_device" or term_sir_helpers@sir_term_root_node(term).name == "actor_cast_device_registered" or term_sir_helpers@sir_term_root_node(term).name == "timer_cast" or term_sir_helpers@sir_term_root_node(term).name == "supervisor_add_child";
                                            init_hold_spawn: string <- case spawn_three or spawn_registered_tuple or actor_msg_binary of { true -> x86_isa@x86_mov("X11", "X9"); false -> "" };
                                            right_asm_a: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            tuple_bytes_a: int64 <- case length_bytes(var@find_sp_binding(bound.outer_reg, "_tuple_sret")) > 0 of {
                                                true -> 0;
                                                false -> term_aggregate_helpers@flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                                            };
                                            op_asm_a: string <- prims_actors@emit_prim_op_with_atoms(term, dest, pools.table, bound.outer_reg);
                                            tuple_sp_restore_a: string <- case tuple_bytes_a > 0 of {
                                                true -> x86_isa@x86_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(tuple_bytes_a)));
                                                false -> ""
                                            };
                                            // The generic two-operand prims (migrate_actor, pin_actor_to_core, set_actor_priority, ...) hand
                                            // the runtime X9 and X10. A right operand that is itself computed (arithmetic,
                                            // a call, a case) stages through X9 as well, so the actor_ref in X9 was lost:
                                            // migrate_actor(ref, 1 + i % 2) passed the core number as the ref. Park the left
                                            // operand below the right one's slab and reload it.
                                            // See trials/actors_addition/migrate_actor_expression_core.
                                            right_kind_a: int64 <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind;
                                            park_left_a: boolean <- (spawn_three or spawn_registered_tuple or actor_msg_binary) == false and right_kind_a != 0 and right_kind_a != 1 and right_kind_a >= 0;
                                            // The message prims (send, actor_call*, actor_cast*, supervisor_add_child) hold the
                                            // left operand in X11 instead, and X11 is a scratch register: a right operand that
                                            // calls anything (a user call, a nested actor prim, the region_alloc that promotes a
                                            // record literal nested in a record literal) returns with X11 overwritten.
                                            // call_supervisor :add_child with a record initial_state handed the runtime the
                                            // address of _silica_rt_heap_in_use as the supervisor and raised actor_not_found.
                                            // Park the left across any computed right operand and reload it into X11.
                                            // See trials/supervisors_addition/add_child_record_initial_state.
                                            park_hold_a: boolean <- actor_msg_binary and right_kind_a != 0 and right_kind_a != 1 and right_kind_a >= 0;
                                            reload_reg_a: string <- case park_hold_a of { true -> "X11"; false -> "X9" };
                                            left_park_a: string <- case park_left_a or park_hold_a of { true -> x86_mem@x86_str("X9", "[SP, #-16]!"); false -> "" };
                                            left_reload_a: string <- case park_left_a or park_hold_a of {
                                                true -> x86_mem@x86_ldr(reload_reg_a, concat("[SP, #", concat(atom_table@int64_to_decimal_string(tuple_bytes_a), "]")));
                                                false -> ""
                                            };
                                            left_unpark_a: string <- case park_left_a or park_hold_a of { true -> x86_isa@x86_add("SP", "SP", "#16"); false -> "" };
                                            concat(concat(concat(concat(concat(concat(left_asm_a, "\n"), concat(init_hold_spawn, left_park_a)), concat(concat(right_asm_a, "\n"), left_reload_a)), op_asm_a), "\n"), concat(tuple_sp_restore_a, left_unpark_a))
                                        }
                                }
                            };
    false -> case term_sir_helpers@sir_term_root_node(term).type_name == "int64" and (term_sir_helpers@sir_term_root_node(term).name == "string_length_bytes" or term_sir_helpers@sir_term_root_node(term).name == "string_length_chars") of {
    true -> {
                                arg_asm: string <- case bound.debug of {
                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X0", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X0", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                concat(concat(arg_asm, "\n"), op_asm)
                            };
    false -> term_emit_kind_compound_compare@emit_kind_compound_compare(term, dest, bound, pools, emit_child)
}
}
}
