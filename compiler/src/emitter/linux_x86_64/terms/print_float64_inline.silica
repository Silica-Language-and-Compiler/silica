// Inline emission for print_float64 built-in.
// Always uses L_pf64_helper: const loads from L_f64_N, var has arg in D0.

use atom_table;
use emitter_effects;
use x86_isa;

export emit_print_float64_var/3;
export emit_print_float64_helper/0;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn emit_print_float64_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- x86_isa@x86_call("L_pf64_helper");
    ok_index: int64 <- atom_table@ok_atom_index(table);
    mov_ret: string <- x86_isa@x86_movi(dest, ok_index);
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// L_pf64_helper: D0 (xmm0) = float64 to print. Converts to string on stack, write(2).
// Integer part: FCVTZS, digit loop. Fractional part: frac*=10 loop (up to 15 digits).
// Register map of the AArch64 body: X0 rdi, X1 rsi, X2 rdx, X8 r8, X9 r9, X10 r10, X11 ecx, X12 r11,
// D0..D4 xmm0..xmm4, xmm5 = 0.0 for the compares; [SP, #k] = [rsp + k] under the rbp frame. x86
// cvttsd2si yields the "integer indefinite" INT64_MIN where AArch64 FCVTZS saturates, so that one
// value is corrected to FCVTZS's result (NaN -> 0, +overflow -> INT64_MAX, -overflow stays INT64_MIN)
// before the digit loop; in the fraction loop the low byte of INT64_MIN + 48 is '0', as FCVTZS(NaN)
// = 0 prints on AArch64, and NaN - anything stays NaN, so that loop needs no correction. The FCMP
// B.eq exit is ordered-equal only (jp keeps a NaN looping, as on AArch64).
fn emit_print_float64_helper() -> string {
    "L_pf64_helper:
    push rbp
    mov rbp, rsp
    sub rsp, 64
    movsd QWORD PTR [rsp], xmm0
    xorpd xmm5, xmm5
    ucomisd xmm0, xmm5
    jae L_pf64_pos
    mov edi, 1
    lea rsi, [rip + L_pf64_minus]
    mov edx, 1
    mov eax, 1
    syscall
    mov rax, QWORD PTR [rsp]
    btc rax, 63
    mov QWORD PTR [rsp], rax
    movq xmm0, rax
L_pf64_pos:
    cvttsd2si rdi, xmm0
    mov rax, -9223372036854775808
    cmp rdi, rax
    jne L_pf64_icvt_ok
    ucomisd xmm0, xmm0
    jp L_pf64_icvt_nan
    xorpd xmm5, xmm5
    ucomisd xmm0, xmm5
    jb L_pf64_icvt_ok
    mov rdi, 9223372036854775807
    jmp L_pf64_icvt_ok
L_pf64_icvt_nan:
    xor edi, edi
L_pf64_icvt_ok:
    lea r10, [rsp + 48]
    xor ecx, ecx
    test rdi, rdi
    jns L_pf64_ipos
    mov ecx, 1
    neg rdi
L_pf64_ipos:
    mov r8, r10
    test rdi, rdi
    jz L_pf64_izero
    mov r9d, 10
L_pf64_iloop:
    mov rax, rdi
    xor edx, edx
    div r9
    mov rsi, rax
    add rdx, 48
    sub r8, 1
    mov BYTE PTR [r8], dl
    mov rdi, rsi
    test rdi, rdi
    jnz L_pf64_iloop
    jmp L_pf64_imaybe_neg
L_pf64_izero:
    sub r8, 1
    mov BYTE PTR [r8], 48
L_pf64_imaybe_neg:
    test rcx, rcx
    jnz L_pf64_iprepend_minus
    jmp L_pf64_ido_int
L_pf64_iprepend_minus:
    sub r8, 1
    mov BYTE PTR [r8], 45
L_pf64_ido_int:
    mov rdx, r10
    sub rdx, r8
    mov edi, 1
    mov rsi, r8
    mov eax, 1
    syscall
    movsd xmm0, QWORD PTR [rsp]
    roundsd xmm1, xmm0, 3
    movapd xmm2, xmm0
    subsd xmm2, xmm1
    movsd xmm3, QWORD PTR [rip + L_pf64_10]
    mov r11d, 15
    mov r9, r10
    sub r9, 15
    mov r8, r9
L_pf64_frac_loop:
    test r11, r11
    jz L_pf64_frac_done
    mulsd xmm2, xmm3
    cvttsd2si rdi, xmm2
    lea rdx, [rdi + 48]
    mov BYTE PTR [r8], dl
    add r8, 1
    cvtsi2sd xmm4, rdi
    subsd xmm2, xmm4
    sub r11, 1
    xorpd xmm5, xmm5
    ucomisd xmm2, xmm5
    jp L_pf64_frac_loop
    je L_pf64_frac_done
    jmp L_pf64_frac_loop
L_pf64_frac_done:
    sub r9, 1
    mov BYTE PTR [r9], 46
    mov rdx, r8
    sub rdx, r9
    mov edi, 1
    mov rsi, r9
    mov eax, 1
    syscall
    leave
    ret"
}
