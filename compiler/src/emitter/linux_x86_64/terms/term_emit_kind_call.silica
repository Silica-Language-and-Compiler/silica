    emit_generic_user_call_asm_inner(term, dest, bound, pools, emit_child, { use_tail: true, fn_effects_for_tail: fn_effects, blr_effect_value_override: "", line_before_call_asm: "" })
}

// Same as emit_function_tail_user_call_root but BLR + stack cleanup instead of tail BR (e.g. main returning float must FCVTZS before RET).
