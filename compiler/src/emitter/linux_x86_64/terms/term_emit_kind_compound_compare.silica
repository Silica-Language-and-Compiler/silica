index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string, sh: { is_float64: boolean, is_float32: boolean, is_float16: boolean, is_string_prim: boolean, left_type_is_string: boolean, cmp_is_eq: boolean, cmp_is_nq: boolean, cmp_is_lt: boolean, cmp_is_gt: boolean, cmp_is_le: boolean, cmp_is_ge: boolean, right_val_0: boolean, right_val_1: boolean, left_is_rp: boolean, left_proj_off: int64, left_proj_n: int64, reg_prefix: string, left_reg: string, right_reg: string, is_unary_prim: boolean }) -> { first: string, second: string } {
                                                // Left is var/call, right is prim. Arithmetic expects left in r1, right in r2.
                                                // Save left to stack; right to sh.right_reg; restore left to sh.left_reg.
                                                temp_reg: string <- case sh.is_string_prim or sh.is_float64 or sh.is_float32 or sh.is_float16 of {
                                                    true -> concat(sh.reg_prefix, "0");
                                                    // Integer prims stage the left in sh.left_reg, never X0/W0, which still holds the
                                                    // first parameter that the right prim may read (defect A7).
                                                    false -> sh.left_reg
                                                };
                                                left_asm: string <- case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                save_left: string <- case sh.is_string_prim of {
                                                    true -> x86_mem@x86_str("X0", "[SP, #-16]!");
                                                    false -> case sh.is_float64 or sh.is_float32 or sh.is_float16 of {
                                                        true -> x86_mem@x86_str(temp_reg, "[SP, #-16]!");
                                                        false -> x86_mem@x86_str(temp_reg, "[SP, #-16]!")
                                                    }
                                                };
                                                right_asm: string <- case sh.is_string_prim of {
                                                    true -> case bound.debug of {
                                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    };
                                                    false -> case bound.debug of {
                                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    }
                                                };
                                                restore_left: string <- case sh.is_string_prim of {
                                                    true -> x86_mem@x86_ldr("X0", "[SP], #16");
                                                    false -> case sh.is_float64 or sh.is_float32 or sh.is_float16 of {
                                                        true -> x86_mem@x86_ldr(sh.left_reg, "[SP], #16");
                                                        false -> x86_mem@x86_ldr(sh.left_reg, "[SP], #16")
                                                    }
                                                };
                                                combined: string <- concat(concat(concat(concat(concat(concat(left_asm, "\n"), save_left), right_asm), "\n"), restore_left), "");
                                                { first: combined, second: "" }
                                            }

