n_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string, sh: { is_float64: boolean, is_float32: boolean, is_float16: boolean, is_string_prim: boolean, left_type_is_string: boolean, cmp_is_eq: boolean, cmp_is_nq: boolean, cmp_is_lt: boolean, cmp_is_gt: boolean, cmp_is_le: boolean, cmp_is_ge: boolean, right_val_0: boolean, right_val_1: boolean, left_is_rp: boolean, left_proj_off: int64, left_proj_n: int64, reg_prefix: string, left_reg: string, right_reg: string, is_unary_prim: boolean }) -> { first: string, second: string } {
    // Float prim on the left with a compound right operand (defect A8): the left re-stages
    // through S1/S2 (D1/D2), so the right is emitted first into sh.right_reg and spilled across
    // the left, then restored before the op.
    right_f: string <- case bound.debug of {
        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
    };
    save_rf: string <- x86_mem@x86_str(sh.right_reg, "[SP, #-16]!");
    left_f: string <- case bound.debug of {
        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  sh.left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  sh.left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
    };
    restore_rf: string <- x86_mem@x86_ldr(sh.right_reg, "[SP], #16");
    comb_f: string <- concat(concat(concat(concat(concat(concat(right_f, "\n"), save_rf), left_f), "\n"), restore_rf), "");
    { first: comb_f, second: "" }
}

