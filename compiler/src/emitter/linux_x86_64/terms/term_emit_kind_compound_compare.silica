ndex_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string, sh: { is_float64: boolean, is_float32: boolean, is_float16: boolean, is_string_prim: boolean, left_type_is_string: boolean, cmp_is_eq: boolean, cmp_is_nq: boolean, cmp_is_lt: boolean, cmp_is_gt: boolean, cmp_is_le: boolean, cmp_is_ge: boolean, right_val_0: boolean, right_val_1: boolean, left_is_rp: boolean, left_proj_off: int64, left_proj_n: int64, reg_prefix: string, left_reg: string, right_reg: string, is_unary_prim: boolean }) -> string {
                                    // Both operands are prims: left prim loads into reg 0, right prim may use reg 0 (calls use X0 for args/result).
                                    // Must save left to stack before right eval; right can overwrite temp_reg (X0/D0/S0) via calls or nested prims.
                                    // Arithmetic expects left in r1, right in r2. For non-string: put right in sh.right_reg, restore left to sh.left_reg.
                                    // String concat expects X0=left, X1=right; keep original layout for sh.is_string_prim.
                                    // Important: avoid using X0 as a scratch reg for integer prims because tuple_proj may use X0
                                    // as the tuple base pointer (function param), and clobbering it breaks subsequent projections.
                                    temp_reg: string <- case sh.is_string_prim or sh.is_float64 or sh.is_float32 or sh.is_float16 of {
                                        true -> concat(sh.reg_prefix, "0");
                                        false -> sh.left_reg
                                    };
                                    left_asm: string <- case bound.debug of {
                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    save_left: string <- case sh.is_string_prim of {
                                        true -> x86_mem@x86_str("X0", "[SP, #-16]!");
                                        false -> case sh.is_float64 or sh.is_float32 or sh.is_float16 of {
                                            true -> x86_mem@x86_str(temp_reg, "[SP, #-16]!");
                                            false -> x86_mem@x86_str(temp_reg, "[SP, #-16]!")
                                        }
                                    };
                                    right_asm: string <- case sh.is_string_prim of {
                                        true -> case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        false -> case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  sh.right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        }
                                    };
                                    restore_left: string <- case sh.is_string_prim of {
                                        true -> x86_mem@x86_ldr("X0", "[SP], #16");
                                        false -> case sh.is_float64 or sh.is_float32 or sh.is_float16 of {
                                            true -> x86_mem@x86_ldr(sh.left_reg, "[SP], #16");
                                            false -> x86_mem@x86_ldr(sh.left_reg, "[SP], #16")
                                        }
                                    };
                                    op_asm: string <- prims@emit_prim_op(term, dest);
                                    part1: string <- concat(left_asm, "\n");
                                    part2: string <- concat(part1, save_left);
                                    part3: string <- concat(part2, right_asm);
                                    part4: string <- concat(part3, "\n");
                                    part5: string <- concat(part4, restore_left);
                                    concat(part5, op_asm)
                                }

