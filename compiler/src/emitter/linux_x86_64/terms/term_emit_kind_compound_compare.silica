t64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string, sh: { is_float64: boolean, is_float32: boolean, is_float16: boolean, is_string_prim: boolean, left_type_is_string: boolean, cmp_is_eq: boolean, cmp_is_nq: boolean, cmp_is_lt: boolean, cmp_is_gt: boolean, cmp_is_le: boolean, cmp_is_ge: boolean, right_val_0: boolean, right_val_1: boolean, left_is_rp: boolean, left_proj_off: int64, left_proj_n: int64, reg_prefix: string, left_reg: string, right_reg: string, is_unary_prim: boolean }) -> { first: string, second: string } {
                                                right_simple_for_left_prim: boolean <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 0 or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 1;
                                                // Any non-simple right operand may clobber the left one: the left operand of a
                                                // string concat sits in X0 and a nested concat (a builtin helper, not a user call)
                                                // returns into X0 too, so the seed preserves the left operand whenever the right
                                                // is not a plain var/const. The selfhost had narrowed this to "user call inside
                                                // the right operand", which let `concat(concat(p, s), concat(a, b))` read the
                                                // wrong left value once register pressure forced the pieces through X0
                                                // (constraint_extract_expr@extract_function, gen3 built by gen2 misparsed
                                                // everything). See trials/compiler_addition/concat_prim_right_operand.
                                                preserve_left_for_right: boolean <- right_simple_for_left_prim == false and sh.is_float64 == false and sh.is_float32 == false and sh.is_float16 == false;
                                                case preserve_left_for_right of {
                                                    true -> {
                                                        l: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), sh.left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
                                                        r: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), sh.right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
                                                        save_left_np: string <- x86_mem@x86_str(sh.left_reg, "[SP, #-16]!");
                                                        restore_left_np: string <- x86_mem@x86_ldr(sh.left_reg, "[SP], #16");
                                                        combined_np: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save_left_np), r), "\n"), restore_left_np), "");
                                                        { first: combined_np, second: "" }
                                                    };
                                                    false -> case sh.right_val_0 of {
                                                        true -> case sh.left_is_rp and sh.left_proj_n >= 0 of {
                                                            true -> { first: join_cmp_rl(x86_isa@x86_mov("X10", "#0"), emit_proj_x9(sh.left_proj_n, sh.left_proj_off)), second: "" };
                                                            // No `length(v.tail) == 0` shortcut here: the one the selfhost carried
                                                            // (emit_list_len_of_tail) assumed the list under the tail is a variable
                                                            // living in an X register and hard-coded 8/16-byte element strides, so
                                                            // `ac.tail.tail.is_nil` inside a let body emitted `MOV X9, X-1` and any
                                                            // record-element list got the wrong stride. The seed never had it; the
                                                            // generic path below is what the seed emits.
                                                            false -> { first: join_cmp_rl(x86_isa@x86_mov("X10", "#0"), emit_cmp_left_only(sh.left_reg, bound, pools, emit_child, term)), second: "" }
                                                        };
                                                        false -> case sh.right_val_1 of {
                                                            true -> case sh.left_is_rp and sh.left_proj_n >= 0 of {
                                                                true -> { first: join_cmp_rl(x86_isa@x86_mov("X10", "#1"), emit_proj_x9(sh.left_proj_n, sh.left_proj_off)), second: "" };
                                                                false -> { first: join_cmp_rl(x86_isa@x86_mov("X10", "#1"), emit_cmp_left_only(sh.left_reg, bound, pools, emit_child, term)), second: "" }
                                                            };
                                                            false -> { first: emit_cmp_left_then_right(sh.left_reg, sh.right_reg, bound, pools, emit_child, term), second: "" }
                                                        }
                                                    }
                                                }
                                            }

