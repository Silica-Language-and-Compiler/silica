// Compare/bitwise/logic compound prims (open-recursive via emit_child).
// Separate unit for process reclaim (exit 75) between typecheck chunks.

use atom_table;
use prims;
use string_parse;
use term_aggregate_helpers;
use term_sir_helpers;
use term_user_call_helpers;
use var;
use x86_isa;
use x86_mem;

export emit_kind_compound_compare/5;

fn join_cmp3(left: string, right: string, op: string) -> string {
    concat(concat(concat(left, "\n"), concat(right, "\n")), op)
}

fn join_cmp_rl(right: string, left: string) -> string {
    concat(concat(left, "\n"), concat(right, "\n"))
}

fn join_operands_op(operands: string, op: string) -> string {
    concat(concat(operands, "\n"), op)
}

fn emit_gpr_cset(dest: string, cond: string) -> string {
    x86_isa@x86_cmp_set(dest, cond, "X9", "X10")
}

fn xreg_num(reg: string) -> int64 {
    case substring(reg, 0, 1) == "X" of {
        true -> case substring(reg, 2, 3) == "" of {
            true -> string_parse@string_to_int64(substring(reg, 1, 2));
            false -> string_parse@string_to_int64(substring(reg, 1, 3))
        };
        false -> 0 - 1
    }
}

fn emit_proj_x9(n: int64, off: int64) -> string {
    x86_mem@x86_ldr("X9", concat("[X", concat(atom_table@int64_to_decimal_string(n), concat(", #", concat(atom_table@int64_to_decimal_string(off), "]")))))
}

