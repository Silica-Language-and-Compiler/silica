// ESP32-S3 port early app 14: the stdlib weight-balanced-tree map (stdlib/data_structures/wbt_map),
// compiled for the board together with the app (extra_sources.txt). Exercises ordering identity
// tokens, canonical arenas and region allocation in board/runtime/rt_ordering.S / rt_heap.S.
use wbt_map;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> atom {
    sequence proc[device_io]
        m0: OrderedMap[int64, int64, mem(normal)] <- wbt_map@empty({
            compare_key: cmp_i64,
            compare_value: cmp_i64
        });
        r1: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(m0, 5, 50);
        r2: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(r1.map, 2, 20);
        r3: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(r2.map, 9, 90);
        r4: {
            map: {
                root: ref?(L, normal, rec),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_key_ordering_bundle: int64,
                compare_value_ordering_bundle: int64
            },
            inserted: boolean,
            replaced: boolean
        } <- wbt_map@insert(r3.map, 5, 55);
        p1: atom <- print_boolean(r1.inserted);
        println();
        p2: atom <- print_boolean(r4.replaced);
        println();
        p3: atom <- print_int64(wbt_map@size(r4.map));
        println();
        g1: { status: :not_found | :found, value: int64 } <- wbt_map@get(r4.map, 5, 0);
        p4: atom <- print_int64(g1.value);
        println();
        g2: { status: :not_found | :found, value: int64 } <- wbt_map@get(r4.map, 7, -1);
        p5: atom <- print_int64(g2.value);
        println();
        print_atom(g2.status);
        println();
        p6: atom <- print_boolean(wbt_map@contains_key(r4.map, 2));
        println();
        p7: atom <- print_boolean(wbt_map@contains_key(r4.map, 3));
        println()
    produces pure :ok end
}
