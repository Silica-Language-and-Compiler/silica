// Checked int64 runtime helpers (Layer 1 §7.8).

export emit_checked_int64_runtime_asm/0;

fn emit_checked_int64_runtime_asm() -> string {
    add_fn: string <- "    .globl _silica_rt_checked_i64_add\n_silica_rt_checked_i64_add:\n    ADDS X2, X0, X1\n    CSET W0, VC\n    CSEL X1, X2, XZR, VC\n    RET\n";
    add1_fn: string <- "    .globl _silica_rt_checked_i64_add1\n_silica_rt_checked_i64_add1:\n    ADDS X2, X0, #1\n    CSET W0, VC\n    CSEL X1, X2, XZR, VC\n    RET\n";
    mul_fn: string <- "    .globl _silica_rt_checked_i64_mul\n_silica_rt_checked_i64_mul:\n    MUL X2, X0, X1\n    CMP X0, #0\n    CSET W3, EQ\n    CBNZ W3, L_ci64_mul_zero\n    SDIV X4, X2, X0\n    CMP X4, X1\n    CSET W0, EQ\n    CSEL X1, X2, XZR, EQ\n    RET\nL_ci64_mul_zero:\n    MOV W0, #1\n    MOV X1, X2\n    RET\n";
    concat(concat(add_fn, add1_fn), mul_fn)
}
