// L_string_eq_helper: pure AArch64. Matches io.rs get_string_data_and_length + silica_string_equals
// (SilicaString tag -1 at offset 0, data at +8, length at +16; else null-terminated C string, cap 1MiB).
// X0/X1 = pointers; W0 = 0/1. No external runtime.
//
// L_string_cmp_helper: same resolve rules; unsigned byte lexicographic order, then shorter prefix first.
// X0/X1 = pointers; W0 = -1 (lt) / 0 (eq) / 1 (gt). Used by string lt/gt/le/ge/eq/nq prims.

// ESP32-S3: these helpers are board runtime routines (board/runtime/rt_string.S, silica_rt_string_*);
// the emitter calls them directly, so nothing is emitted into the module.
export emit_string_eq_helper/0;
export emit_string_cmp_helper/0;

fn emit_string_eq_helper() -> string {
    ""
}

fn emit_string_cmp_helper() -> string {
    ""
}
