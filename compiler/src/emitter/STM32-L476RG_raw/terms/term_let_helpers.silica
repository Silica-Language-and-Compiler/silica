// Thin forwarders so let-emission units do not pay for three fat interfaces.
// atom_table (9.3K), term_case_patterns (6.9K) and prims_record (1.8K) were
// imported whole for 10 call sites; each is re-exported here behind a narrow
// signature. See tutorials_and_howtos/thin_dispatchers_for_compile_ram.md.

use atom_table;
use prims_record;
use term_case_patterns;

export dec_str/1;
export count_record_fields/1;
export list_cons_tail_rebind_suffix/1;

fn dec_str(n: int64) -> string {
    atom_table@int64_to_decimal_string(n)
}

fn count_record_fields(type_name: string) -> int64 {
    prims_record@count_record_fields(type_name)
}

fn list_cons_tail_rebind_suffix(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    term_case_patterns@list_cons_tail_rebind_suffix(inner)
}
