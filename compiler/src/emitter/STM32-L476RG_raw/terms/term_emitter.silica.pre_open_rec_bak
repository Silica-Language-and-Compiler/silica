                    }
                }
            }
        };
        false -> concat(arg1_asm, "\n")
        }
    };
    dealloc_bytes_call: int64 <- arg_stack_bytes_before_call
        + sret_stack_bytes
        + case save_indirect_callee_around_args of { true -> 16; false -> 0 };
    dealloc_asm_call: string <- case dealloc_bytes_call > 0 of {
