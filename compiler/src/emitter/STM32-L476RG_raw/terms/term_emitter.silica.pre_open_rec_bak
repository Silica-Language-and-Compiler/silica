                            tuple_elem_count_tl: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term).type_name) of { true -> prims_tuple@count_type_elements(term_sir_helpers@sir_term_root_node(term).type_name); false -> 0 };
                            ptr_binding_tl: string <- case is_simple_tuple_make and len(rhs_bind_tl) > 0 and substring(rhs_bind_tl, 0, 1) != "[" of {
                                true -> concat("|_ptr.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", rhs_bind_tl)));
                                false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term).type_name) and len(rhs_reg) > 0 and substring(rhs_reg, 0, 1) != "[" of {
                                    true -> case tuple_elem_count_tl > 2 of {
                                        true -> concat("|_ptr.", concat(term_sir_helpers@sir_term_root_node(term).name, "=X12"));
                                        false -> concat("|_ptr.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", rhs_bind_tl)))
                                    };
                                    false -> ""
                                }
                            };
                            save_base_tl: string <- case tuple_elem_count_tl > 2 and len(rhs_reg) > 0 and substring(rhs_reg, 0, 1) != "[" of {
                                true -> concat("    MOV X12, ", concat(rhs_bind_tl, "\n"));
                                false -> ""
                            };
                            // Top-level let: keep enclosing bindings (e.g. |%s=X19) so later prims still resolve params after rhs_reg holds the new let.
                            nob_tl: string <- case is_simple_tuple_make of {
                                true -> "SP";
                                false -> var@base_reg_of(bound.outer_reg)
                            };
                            inherit_sp_tl: string <- var@extract_sp_bindings(bound.outer_reg);
                            new_outer_tl: string <- concat(nob_tl, concat(inherit_sp_tl, concat(tp_binding_tl, concat(reg_binding_tl, concat(adj_binding_tl, concat(iap_tl, concat(vab_tl, ptr_binding_tl)))))));
                            outer_for_body_tl: string <- term_reg_spill@outer_append_id_ret_tuple_sret(term, concat(new_outer_tl, term_case_patterns@list_cons_tail_rebind_suffix(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))), bound.outer_reg);
                            body_asm: string <- case bound.debug of {
                                true -> { term_to_asm_opt_bound_debug(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), dest, pools, { bound_name: term_sir_helpers@sir_term_root_node(term).name, bound_reg: body_bound_tl, outer_reg: outer_for_body_tl, debug: true }) };
                                false -> term_to_asm_opt_bound(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), dest, pools, { bound_name: term_sir_helpers@sir_term_root_node(term).name, bound_reg: body_bound_tl, outer_reg: outer_for_body_tl, debug: false })
                            };
                            tuple_sret_outer_tl: string <- var@find_sp_binding(outer_for_body_tl, "_tuple_sret");
