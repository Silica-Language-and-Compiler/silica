fn emit_kind_let(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string {
    case len(bound.bound_name) > 0 and len(bound.bound_reg) > 0 of {
                        true -> {
                            clean_bound: string <- var@base_reg_of(bound.bound_reg);
                            clean_outer: string <- var@base_reg_of(bound.outer_reg);
                            base_rhs: string <- let_dispatcher@compute_rhs_reg_in_let(term, dest, bound.bound_name, clean_bound, bound.outer_reg);
                            rhs_reg: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" of {
                                true -> "X0";
                                false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name == "int64" and dest == "X0" and clean_bound == "X1" of {
                                    true -> "X2";
                                    false -> base_rhs
                                }
                            };
                            outer_rhs_b: string <- term_reg_spill@outer_for_aggregate_let_rhs(term, bound.outer_reg);
                            rhs_asm: string <- case term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner).root < 0 of {
                                true -> "";
                                false -> case bound.debug of {
                                    true -> { term_to_asm_opt_bound_debug(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), rhs_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_rhs_b, debug: true }) };
                                    false -> term_to_asm_opt_bound(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), rhs_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_rhs_b, debug: false })
                                }
                            };
                            spill_reg_b: string <- term_reg_spill@compute_let_rhs_spill_reg(term, rhs_reg, bound.outer_reg);
                            spill_b: bool <- len(spill_reg_b) > 0;
                            rhs_bind_b: string <- case spill_b of { true -> spill_reg_b; false -> rhs_reg };
                            mov_spill_b: string <- case spill_b of { true -> term_reg_spill@mov_spill_from_rhs(rhs_reg, spill_reg_b); false -> "" };
                            adj_str_b: string <- var@find_sp_binding(bound.outer_reg, "_adj");
                            sp_adj_b: int64 <- case len(adj_str_b) > 0 of { true -> string_parse@string_to_int64(adj_str_b); false -> 0 };
                            tm_adj: int64 <- case term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) of {
                                false -> sp_adj_b;
                                true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" of {
                                    true -> term_aggregate_helpers@flat_tuple_nested_alloc(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), prims_tuple@count_flat_elements(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)), 0);
                                    false -> term_aggregate_helpers@flat_record_sum_nested_inners(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))
                                }
                            };
                            adj_binding: string <- case tm_adj > 0 of {
                                true -> concat("|_adj=", atom_table@int64_to_decimal_string(tm_adj));
                                false -> ""
                            };
                            iap_b: string <- case term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) of {
                                true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" of {
                                    true -> {
                                        ic_b: int64 <- prims_tuple@count_flat_elements(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                        it_b: int64 <- term_aggregate_helpers@flat_tuple_nested_alloc(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), ic_b, 0);
                                        term_aggregate_helpers@compute_inner_adj_bindings(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), 0, ic_b, 0, it_b)
                                    };
                                    false -> {
                                        icr_b: int64 <- prims_record@count_record_fields(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                                        itr_b: int64 <- term_aggregate_helpers@flat_record_sum_nested_inners(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                        term_aggregate_helpers@compute_inner_adj_bindings_record(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), 0, icr_b, 0, itr_b)
                                    }
                                };
                                false -> ""
                            };
                            va_b_tm: string <- case term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) of {
                                true -> concat("|_va.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", atom_table@int64_to_decimal_string(tm_adj))));
                                false -> ""
                            };
                            tp_pi_b: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_proj" and len(va_b_tm) == 0 of {
                                true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).right_expr)).value;
                                false -> ""
                            };
                            tp_eas_b: string <- case len(tp_pi_b) > 0 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) of {
                                true -> var@find_sp_binding(bound.outer_reg, concat("_adj.", tp_pi_b));
                                false -> ""
                            };
                            va_b_tp: string <- case len(tp_pi_b) > 0 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) of {
                                true -> case len(tp_eas_b) > 0 of {
                                    true -> concat("|_va.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", tp_eas_b)));
                                    false -> ""
                                };
                                false -> ""
                            };
                            vr_svk_b: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 and (reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) or reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term).type_name)) and len(va_b_tm) == 0 and len(va_b_tp) == 0 of {
                                true -> concat("_va.", term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name);
                                false -> ""
                            };
                            vr_svs_b: string <- case len(vr_svk_b) > 0 of { true -> var@find_sp_binding(bound.outer_reg, vr_svk_b); false -> "" };
                            vr_adj_fb: string <- case len(vr_svs_b) == 0 and len(vr_svk_b) > 0 of {
                                true -> var@find_sp_binding(bound.outer_reg, "_adj");
                                false -> vr_svs_b
                            };
                            va_b_vr: string <- case len(vr_svk_b) > 0 of {
                                true -> case len(vr_adj_fb) > 0 of {
                                    true -> concat("|_va.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", vr_adj_fb)));
                                    false -> ""
                                };
                                false -> ""
                            };
