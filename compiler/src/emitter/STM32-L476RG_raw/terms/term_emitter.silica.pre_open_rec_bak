                            tail_ret_tl: bool <- tail_stack_tl > 0;
                            promote_nbytes_tl: int64 <- case tail_ret_tl of {
                                true -> tail_stack_tl;
                                false -> case id_ret_tl of {
                                    true -> term_aggregate_helpers@aggregate_callee_return_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                    false -> 0
                                }
                            };
                            promote_asm_tl: string <- case dest == "X0" and promote_nbytes_tl > 0 and (id_ret_tl or tail_ret_tl) and len(tuple_sret_outer_tl) == 0 of {
                                true -> term_aggregate_helpers@aggregate_return_heap_promote_x0(promote_nbytes_tl);
                                false -> ""
                            };
                            rhs_sep: string <- case len(rhs_asm) > 0 and substring(rhs_asm, len(rhs_asm) - 1, len(rhs_asm)) == "\n" of {
                                true -> "";
                                false -> "\n"
                            };
                            concat(concat(concat(concat(rhs_asm, rhs_sep), mov_spill_tl), save_base_tl), case len(dealloc) > 0 of {
                                true -> case len(promote_asm_tl) > 0 of {
                                    true -> concat(concat(concat(body_asm, "\n"), promote_asm_tl), dealloc);
                                    false -> concat(concat(body_asm, "\n"), dealloc)
                                };
                                false -> body_asm
                            })
                        }
                    }
}

