                                        case agg_tl > 0 of {
                                            true -> agg_tl;
                                            false -> term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))
                                        }
                                    }
                                }
                            };
                            base_stack_eff_tl: int64 <- case term_aggregate_helpers@let_suppress_base_stack_overlay_rec_flat(term, base_stack_tl) of {
                                true -> term_aggregate_helpers@let_suppressed_base_stack_fixup(term);
                                false -> base_stack_tl
                            };
                            tail_stack_raw_tl: int64 <- term_aggregate_helpers@let_tail_aggregate_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
