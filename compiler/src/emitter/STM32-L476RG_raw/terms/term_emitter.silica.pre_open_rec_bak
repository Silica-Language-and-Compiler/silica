                inner_asm: string <- emit_case_one_branch_inner(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner), { scrut_t: case_seq.scrut_t, scrut_reg: case_seq.scrut_reg, lit_reg: case_seq.lit_reg, guard_reg: case_seq.guard_reg, dest: case_seq.dest, done_l: case_seq.done_l }, fail_l, entry_l, pools, bound);
                tail_asm: string <- emit_case_branch_seq(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), { scrut_t: case_seq.scrut_t, scrut_reg: case_seq.scrut_reg, lit_reg: case_seq.lit_reg, guard_reg: case_seq.guard_reg, dest: case_seq.dest, done_l: case_seq.done_l, fb_l: case_seq.fb_l, case_name: case_seq.case_name }, idx + 1, pools, bound);
