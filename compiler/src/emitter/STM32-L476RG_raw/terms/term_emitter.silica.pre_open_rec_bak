                                true -> 0;
                                false -> case len(tuple_sret_outer_tl) > 0 of {
                                    true -> 0;
                                    false -> case base_stack_eff_tl > 0 and tail_stack_raw_tl == base_stack_eff_tl of {
                                        true -> 0;
                                        false -> tail_stack_raw_tl
                                    }
                                }
                            };
                            dealloc_bytes_tl: int64 <- base_stack_eff_tl + tail_stack_tl;
                            dealloc: string <- case dealloc_bytes_tl > 0 of {
                                true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(dealloc_bytes_tl), "\n"));
