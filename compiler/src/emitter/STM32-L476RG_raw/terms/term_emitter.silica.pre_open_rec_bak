fn emit_rest_args(rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, gpr_slot: int64, fp_slot: int64, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string {
    case term_sir_helpers@sir_term_root_node(rest).name == "user_call_rest" of {
        true -> {
            fpool_prev: string <- var@find_sp_binding(bound.outer_reg, "_fpool");
            outer_f: string <- case gpr_slot >= 1 and len(fpool_prev) == 0 of {
                true -> concat(bound.outer_reg, "|_fpool=X9");
                false -> bound.outer_reg
            };
            cur_ty: string <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner)).type_name;
            reg: string <- term_user_call_abi@user_call_arg_reg_for_type(cur_ty, gpr_slot, fp_slot);
            gpr_after_cur: int64 <- term_user_call_abi@user_call_next_gpr_slot(cur_ty, gpr_slot);
            fp_after_cur: int64 <- term_user_call_abi@user_call_next_fp_slot(cur_ty, fp_slot);
            arg_asm: string <- case bound.debug of {
                true -> { term_to_asm_opt_bound_debug(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner), reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_f, debug: true }) };
                false -> term_to_asm_opt_bound(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner), reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_f, debug: false })
            };
            rest_asm: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).kind < 0 of {
                true -> "";
                false -> emit_rest_args(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), gpr_after_cur, fp_after_cur, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_f, debug: bound.debug })
            };
            // fib_iter(n-1, b, a+b): emitting var(b)→X1 after one GPR arg clobbers a(X1) before add(a,b) can read it.
            next_ty: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).name == "user_call_rest" of {
                true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).inner)).type_name;
                false -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).type_name
            };
            next_is_add_or_mul: bool <- case gpr_slot == 1 and fp_slot == 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).kind >= 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner)).kind == 1 of {
                true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).name == "user_call_rest" of {
                    true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).inner)).kind == 6
                        and (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).inner)).name == "add" or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).inner)).name == "mul");
                    false -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).kind == 6
                        and (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).name == "add" or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).name == "mul")
                };
                false -> false
            };
            next_arg_node: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case next_is_add_or_mul of {
                true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).name == "user_call_rest" of {
                    true -> term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).inner);
                    false -> term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)
                };
                false -> term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner)
            };
            next_has_matching_var: bool <- case next_is_add_or_mul of {
                true -> (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(next_arg_node, term_sir_helpers@sir_term_root_node(next_arg_node).inner)).kind == 1 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(next_arg_node, term_sir_helpers@sir_term_root_node(next_arg_node).inner)).name == term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner)).name)
                    or (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(next_arg_node, term_sir_helpers@sir_term_root_node(next_arg_node).right_expr)).kind == 1 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(next_arg_node, term_sir_helpers@sir_term_root_node(next_arg_node).right_expr)).name == term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner)).name);
                false -> false
            };
            use_save_next_for_current: bool <- next_has_matching_var;
            next_reg: string <- term_user_call_abi@user_call_arg_reg_for_type(next_ty, gpr_after_cur, fp_after_cur);
            next_arg_asm: string <- case use_save_next_for_current of {
                true -> case bound.debug of {
                    true -> { term_to_asm_opt_bound_debug(next_arg_node, next_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_f, debug: true }) };
                    false -> term_to_asm_opt_bound(next_arg_node, next_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_f, debug: false })
                };
                false -> ""
            };
            gpr_after_next: int64 <- term_user_call_abi@user_call_next_gpr_slot(next_ty, gpr_after_cur);
            fp_after_next: int64 <- term_user_call_abi@user_call_next_fp_slot(next_ty, fp_after_cur);
                       further_rest_asm: string <- case use_save_next_for_current of {
                true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).name == "user_call_rest" and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).right_expr)).kind >= 0 of {
                    true -> emit_rest_args(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).right_expr), gpr_after_next, fp_after_next, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_f, debug: bound.debug });
                    false -> ""
                };
                false -> ""
            };
            save_src_reg: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner)).kind == 1 of {
                true -> {
                    bound: string <- var@find_sp_binding_bare_or_percent_param(outer_f, term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner)).name);
                    case len(bound) > 0 and var@binding_is_physical_int_reg(bound) of {
                        true -> bound;
                        false -> next_reg
                    }
                };
                false -> next_reg
            };
            save_next: string <- concat(concat("    STR ", save_src_reg), ", [SP, #-16]!\n");
            restore_current: string <- concat(concat("    LDR ", reg), ", [SP], #16\n");
            case use_save_next_for_current of {
                true -> concat(concat(concat(concat(save_next, next_arg_asm), "\n"), restore_current), further_rest_asm);
                false -> concat(concat(arg_asm, "\n"), rest_asm)
            }
        };
        false -> {
            fpool_prev2: string <- var@find_sp_binding(bound.outer_reg, "_fpool");
            outer_f2: string <- case gpr_slot >= 1 and len(fpool_prev2) == 0 of {
                true -> concat(bound.outer_reg, "|_fpool=X9");
                false -> bound.outer_reg
            };
            reg2: string <- term_user_call_abi@user_call_arg_reg_for_type(term_sir_helpers@sir_term_root_node(rest).type_name, gpr_slot, fp_slot);
            case bound.debug of {
                true -> { term_to_asm_opt_bound_debug(rest, reg2, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_f2, debug: true }) };
                false -> term_to_asm_opt_bound(rest, reg2, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_f2, debug: false })
            }
        }
    }
}

fn emit_case_one_branch_inner(branch: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, case_env: { scrut_t: string, scrut_reg: string, lit_reg: string, guard_reg: string, dest: string, done_l: string }, fail_l: string, entry_l: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string {
    pkind: string <- term_sir_helpers@sir_term_root_node(branch).value;
    branch_node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(branch);
    // Case patterns only need literal/atom/string pools (not intN tables).
    (pat_asm: string, list_bind_asm: string, outer_for_branch: string) <- case pkind == "record" of {
        true -> term_case_patterns@emit_record_case_pattern_asm(branch, branch_node.type_name, case_env.scrut_reg, case_env.lit_reg, fail_l, bound.outer_reg, { table: pools.table, literal_table: pools.literal_table, float64_literal_table: pools.float64_literal_table, float32_literal_table: pools.float32_literal_table, string_literal_table: pools.string_literal_table });
        false -> {
            chk: string <- term_case_patterns@emit_case_pattern_check(branch, case_env.scrut_t, case_env.scrut_reg, case_env.lit_reg, fail_l, { table: pools.table, literal_table: pools.literal_table, float64_literal_table: pools.float64_literal_table, float32_literal_table: pools.float32_literal_table, string_literal_table: pools.string_literal_table }, bound.outer_reg);
            (lb_asm: string, outer_l: string) <- case pkind == "list_cons" of {
                true -> term_case_patterns@emit_list_cons_pattern_loads(branch, case_env.scrut_reg, bound.outer_reg);
                false -> ("", bound.outer_reg)
            };
            (chk, lb_asm, outer_l)
        }
    };
    pat_full: string <- concat(pat_asm, list_bind_asm);
    br_bn: string <- case pkind == "bind" of {
        true -> case len(term_sir_helpers@sir_term_root_node(branch).name) > 1 of { true -> substring(term_sir_helpers@sir_term_root_node(branch).name, 1, len(term_sir_helpers@sir_term_root_node(branch).name)); false -> "" };
        false -> bound.bound_name
    };
    br_br: string <- case pkind == "bind" of {
        true -> case_env.scrut_reg;
        false -> bound.bound_reg
    };
    outer_body: string <- outer_for_branch;
    guard_asm: string <- case term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).inner).root < 0 of {
        true -> "";
        false -> {
            g_asm: string <- term_to_asm_opt_bound(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).inner), case_env.guard_reg, pools, { bound_name: br_bn, bound_reg: br_br, outer_reg: outer_body, debug: false });
            g_nl: string <- concat(g_asm, "\n");
            cbz_mid: string <- concat(concat(concat(g_nl, "    CBZ "), case_env.guard_reg), ", ");
            concat(cbz_mid, concat(fail_l, "\n"))
        }
    };
    body_asm: string <- term_to_asm_opt_bound(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr), case_env.dest, pools, { bound_name: br_bn, bound_reg: br_br, outer_reg: outer_body, debug: false });
    branch_stack_n: int64 <- term_aggregate_helpers@aggregate_callee_return_stack_bytes(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr));
    tuple_sret_branch: string <- var@find_sp_binding(bound.outer_reg, "_tuple_sret");
    // tuple_make can write directly into an enclosing aggregate return buffer
    // (actor behavior reply buffer, user-call sret, etc.). Keep the heap
    // promotion for the returned pointer, but only pop bytes that this branch
    // actually pushed on SP.
    branch_dealloc_n: int64 <- case len(tuple_sret_branch) > 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr)).name == "tuple_make" of {
        true -> 0;
        false -> branch_stack_n
    };
    branch_cleanup: string <- case case_env.dest == "X0" of {
        true -> case branch_stack_n > 0 of {
            true -> concat(term_aggregate_helpers@aggregate_return_heap_promote_x0(branch_stack_n), case branch_dealloc_n > 0 of {
                true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(branch_dealloc_n), "\n"));
                false -> ""
            });
            false -> ""
        };
        false -> ""
    };
    h0: string <- concat(entry_l, ":\n");
    h1: string <- concat(concat(h0, pat_full), guard_asm);
    h2: string <- concat(concat(concat(h1, body_asm), "\n"), branch_cleanup);
    br: string <- concat(concat("    B ", case_env.done_l), "\n");
    concat(h2, br)
}

