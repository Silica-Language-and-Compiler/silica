// Record layout for the emitter (silica-spec §3.3.7 / §3.4.2, sir_design_spec §7.6).
// record_make / record_proj mirror tuple flat stack layout: field order matches `{ f1: T1, ... }`.
//
// Uniform boxed layout (2026-09-18): EVERY field is one 8-byte slot. A scalar field holds its
// value; a record-, tuple-, list-, string- or function-typed field holds a pointer. A nested
// record or tuple literal is built in its own slab, heap-promoted, and its pointer is stored;
// a nested aggregate variable is copied to the region and its pointer is stored. This is the
// layout generic code (ItemType / KeyType / ValueType fields, one word each) has always used,
// so a value built in a generic unit and read in a concrete one -- or the reverse -- has the
// same shape by construction: no boundary conversion, no per-shape rule.
// Before this, a record-typed field was INLINED (its flat size, fields spliced into the outer)
// and a tuple-typed field kept a 16-byte-rounded shell around its pointer, so a generic
// `{ status, value: ItemType, path }` and its concrete instantiation disagreed on every
// offset after `value` (trials/generic_modules_addition/record_item_through_generic_result,
// record_tuple_field_then_list_read, and the *_through_generic trials beside them).
// The exceptions are the two records the actor runtime lays out by hand, and only those
// (record_type_keeps_inline_layout): the supervisor reply (96 bytes, child_info spliced inline)
// and the `start:`-form child spec, whose (state, behaviour) tuple keeps its 16-byte shell so
// restart/shutdown/flavor sit at the runtime's child-spec ABI offsets 40/48/56
// (term_child_spec@child_spec_field_abi_offset). They keep the legacy inline rules.
//
// Shape word (2026-10-02, record_shape.silica): every record value, boxed or spliced inline,
// starts with one word holding its build-wide shape number; the fields follow from offset 8.
// Every offset and size here counts that word: offset_bytes_before_field is 8 for the first
// field, record_type_value_flat_byte_size is 8 plus one slot per field, and a spliced nested
// record (the reply's child_info) carries its own shape word inside the outer slab.

use reg_conventions;

export record_type_starts/1;
export find_field_type_in_record/2;
export count_record_fields/1;
export count_record_chain/1;
export offset_bytes_before_field/2;
export slot_bytes_for_field_type/1;
export strip_spaces_rt/1;
export record_type_braces_balanced/1;
export record_case_inner_body/1;
export record_case_field_step/1;
export record_field_segment_name_sub/1;
export record_type_flat_stack_bytes/1;
export record_type_has_only_scalar_fields/1;
export record_type_value_flat_byte_size/1;
export record_type_list_cons_payload_bytes/1;
export record_type_is_supervisor_reply/1;
export record_type_keeps_inline_layout/1;
export record_type_is_start_child_spec/1;
export shape_word_bytes/0;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn record_type_has_only_scalar_fields(record_str: string) -> boolean {
    t: string <- strip_spaces_rt(record_str);
    case record_type_starts(t) of {
        false -> true;
        true -> has_only_scalar_fields_inner_loop(extract_braced_body(t))
    }
}

// True when every field type is a scalar or a (possibly nested) record whose leaves are all scalars.
fn has_only_scalar_fields_inner_loop(remaining: string) -> boolean {
    inner: string <- strip_spaces_rt(remaining);
    case length_bytes(inner) == 0 of {
        true -> true;
        false -> {
            (seg, rest) <- record_case_field_step(inner);
            (fname, fty) <- record_field_segment_name_sub(seg);
            case length_bytes(fname) == 0 of {
                true -> has_only_scalar_fields_inner_loop(rest);
                false -> case inner_field_scalar_ok_for_inline(fty) of {
                    false -> false;
                    true -> has_only_scalar_fields_inner_loop(rest)
                }
            }
        }
    }
}

// Only int/uint/bool/float leaves participate in value-flat nested records (trial 08).
// List, string, atom, tuples, etc. keep pointer/nested stack layout (trials 04, 07, 10).
fn value_flat_leaf_field_type_p(fty: string) -> boolean {
    t: string <- strip_spaces_rt(fty);
    t == "int64" or t == "int32" or t == "int16" or t == "int8" or
    t == "uint64" or t == "uint32" or t == "uint16" or t == "uint8" or
    t == "bool" or t == "float64" or t == "float32" or t == "float16"
}

fn inner_field_scalar_ok_for_inline(fty: string) -> boolean {
    t: string <- strip_spaces_rt(fty);
    case record_type_starts(t) of {
        true -> record_type_has_only_scalar_fields(t);
        false -> case length_bytes(t) > 0 and substring(t, 0, 1) == "(" of {
            true -> false;
            false -> value_flat_leaf_field_type_p(t)
        }
    }
}

// Boxed layout: one 8-byte slot per field whatever its type (see the header).
fn field_value_flat_slot_bytes(fty: string) -> int64 {
    slot_bytes_for_field_type(fty)
}

// Legacy inline slot size (nested record spliced in, tuple shell reserved): supervisor reply only.
fn field_value_flat_slot_bytes_inline(fty: string) -> int64 {
    t: string <- strip_spaces_rt(fty);
    case record_type_starts(t) of {
        true -> record_type_value_flat_byte_size_inline(t);
        false -> slot_bytes_for_field_type_inline(t)
    }
}

fn sum_field_value_flat_loop(remaining: string) -> int64 {
    inner: string <- strip_spaces_rt(remaining);
    case length_bytes(inner) == 0 of {
        true -> 0;
        false -> {
            (seg, rest) <- record_case_field_step(inner);
            (fname, fty) <- record_field_segment_name_sub(seg);
            case length_bytes(fname) == 0 of {
                true -> sum_field_value_flat_loop(rest);
                false -> field_value_flat_slot_bytes(fty) + sum_field_value_flat_loop(rest)
            }
        }
    }
}

fn sum_field_value_flat_loop_inline(remaining: string) -> int64 {
    inner: string <- strip_spaces_rt(remaining);
    case length_bytes(inner) == 0 of {
        true -> 0;
        false -> {
            (seg, rest) <- record_case_field_step(inner);
            (fname, fty) <- record_field_segment_name_sub(seg);
            case length_bytes(fname) == 0 of {
                true -> sum_field_value_flat_loop_inline(rest);
                false -> field_value_flat_slot_bytes_inline(fty) + sum_field_value_flat_loop_inline(rest)
            }
        }
    }
}

// The supervisor reply record is produced by the actor runtime's hand-written assembly with
// child_info spliced inline (80 bytes); it keeps the legacy inline rules. Same field test as
// term_child_spec@is_supervisor_reply_record_type (repeated here: that module imports this one).
fn record_type_is_supervisor_reply(record_str: string) -> boolean {
    R: string <- strip_spaces_rt(record_str);
    case record_type_starts(R) of {
        false -> false;
        true -> length_bytes(find_field_type_in_record(R, "tag")) > 0
            and length_bytes(find_field_type_in_record(R, "child")) > 0
            and length_bytes(find_field_type_in_record(R, "status")) > 0
            and length_bytes(find_field_type_in_record(R, "children")) > 0
            and length_bytes(find_field_type_in_record(R, "count")) > 0
            and length_bytes(find_field_type_in_record(R, "child_info")) > 0
            and length_bytes(find_field_type_in_record(R, "error")) > 0
    }
}

// A `start:`-form child spec ({ id, agent_type, start: (state, behaviour), restart, shutdown, ... }):
// written at the child-spec ABI offsets by record_make (term_record_layout), which the legacy inline
// sizes reproduce (the start tuple's 16-byte shell). Same field test as the start branch of
// term_child_spec@is_child_spec_record_type.
fn record_type_is_start_child_spec(record_str: string) -> boolean {
    R: string <- strip_spaces_rt(record_str);
    case record_type_starts(R) of {
        false -> false;
        true -> length_bytes(find_field_type_in_record(R, "id")) > 0
            and length_bytes(find_field_type_in_record(R, "agent_type")) > 0
            and length_bytes(find_field_type_in_record(R, "start")) > 0
            and length_bytes(find_field_type_in_record(R, "restart")) > 0
            and length_bytes(find_field_type_in_record(R, "shutdown")) > 0
    }
}

// The runtime-laid-out records that keep the legacy inline field rules (see the header).
fn record_type_keeps_inline_layout(record_str: string) -> boolean {
    record_type_is_supervisor_reply(record_str) or record_type_is_start_child_spec(record_str)
}

fn shape_word_bytes() -> int64 {
    8
}

fn record_type_value_flat_byte_size(record_str: string) -> int64 {
    t: string <- strip_spaces_rt(record_str);
    case record_type_starts(t) of {
        false -> 8;
        true -> case record_type_keeps_inline_layout(t) of {
            true -> shape_word_bytes() + sum_field_value_flat_loop_inline(extract_braced_body(t));
            false -> shape_word_bytes() + sum_field_value_flat_loop(extract_braced_body(t))
        }
    }
}

fn record_type_value_flat_byte_size_inline(record_str: string) -> int64 {
    t: string <- strip_spaces_rt(record_str);
    case record_type_starts(t) of {
        false -> 8;
        true -> shape_word_bytes() + sum_field_value_flat_loop_inline(extract_braced_body(t))
    }
}

fn record_type_is_child_spec(record_str: string) -> boolean {
    R: string <- strip_spaces_rt(record_str);
    case record_type_starts(R) of {
        false -> false;
        true -> length_bytes(find_field_type_in_record(R, "id")) > 0
            and length_bytes(find_field_type_in_record(R, "agent_type")) > 0
            and length_bytes(find_field_type_in_record(R, "initial_state")) > 0
            and length_bytes(find_field_type_in_record(R, "behavior")) > 0
            and length_bytes(find_field_type_in_record(R, "restart")) > 0
            and length_bytes(find_field_type_in_record(R, "shutdown")) > 0
            and length_bytes(find_field_type_in_record(R, "flavor")) > 0
    }
}

// Darwin AAPCS64: SP alignment at BL; matches term_emitter stack_alloc_round16.
fn list_cons_stack_round16(nbytes: int64) -> int64 {
    (nbytes + 15) / 16 * 16
}

// Bytes copied from SP into list cons cells for inline record heads. This must equal what record_make
// actually lays out, which is record_make_stack_alloc_size, i.e.
// round16(record_type_value_flat_byte_size) -- so both go through record_type_value_flat_byte_size and
// there is a single authority for the size. record_type_flat_stack_bytes must not be used: it can be
// larger (nested shell), which made list_cons copy past the record_make frame and corrupt tail pointers.
//
// Records with a non-scalar field used to get one word per field instead. That silently truncated any
// element with a nested record field, because record_make INLINES such a field rather than storing a
// pointer to it: the parser's token slot
//     { token: { kind, lexeme, location }, possible_roles: List[int64] }
// is 8 + 8 + 32 + 8 = 56 bytes rounded to 64, but two fields gave 16, so consecutive elements
// overlapped and every field past the first two was lost. slot.possible_roles then read as 0 and
// constraint_core:slot_role faulted on it, which is what hung the compiler on `fn main() { 42 }`.
// See trials/codegen_regressions/list_rec_nested.silica.
fn record_type_list_cons_payload_bytes(record_str: string) -> int64 {
    R: string <- strip_spaces_rt(record_str);
    case record_type_starts(R) of {
        false -> 8;
        true -> case record_type_is_child_spec(R) of {
            true -> 64;
            false -> list_cons_stack_round16(record_type_value_flat_byte_size(R))
        }
    }
}

// strip_spaces_rt_from appends one character at a time, so it allocates O(n^2) bytes for an
// n-character string and none of it is ever reclaimed. The emitter strips a record type once and then
// passes substrings of that stripped text down, so the overwhelmingly common case is a string that has
// no spaces left to remove -- returning it untouched costs a linear scan and no allocation at all.
// Without this, emitting the compiler's own record types (thousands of characters, five levels deep,
// re-stripped at every field of every nesting level) exhausted memory.
fn strip_spaces_rt(s: string) -> string {
    case string_has_space_rt(s, 0) of {
        true -> strip_spaces_rt_from(s, 0, "");
        false -> s
    }
}

fn string_has_space_rt(s: string, i: int64) -> boolean {
    case i >= length_bytes(s) of {
        true -> false;
        false -> case substring(s, i, i + 1) == " " of {
            true -> true;
            false -> string_has_space_rt(s, i + 1)
        }
    }
}

fn strip_spaces_rt_from_run_end(s: string, j: int64, n: int64) -> int64 {
    case j >= n of {
        true -> j;
        false -> case substring(s, j, j + 1) == " " of {
            true -> j;
            false -> strip_spaces_rt_from_run_end(s, j + 1, n)
        }
    }
}

// Divide-and-conquer strip (same fix as type_interner): the per-character concat(acc, ch)
// loop copied O(n^2) bytes of growing prefixes into the never-released concat arena for every
// 8-10 KB signature; splitting ranges and concatenating halves copies O(n log n).
fn strip_spaces_rt_from(s: string, i: int64, acc: string) -> string {
    concat(acc, strip_spaces_rt_range(s, i, length_bytes(s)))
}

fn strip_spaces_rt_range(s: string, lo: int64, hi: int64) -> string {
    case hi - lo <= 48 of {
        true -> strip_spaces_rt_small(s, lo, hi, "");
        false -> {
            mid: int64 <- lo + (hi - lo) / 2;
            concat(strip_spaces_rt_range(s, lo, mid), strip_spaces_rt_range(s, mid, hi))
        }
    }
}

fn strip_spaces_rt_small(s: string, i: int64, hi: int64, acc: string) -> string {
    case i >= hi of {
        true -> acc;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == " " of {
                true -> strip_spaces_rt_small(s, i + 1, hi, acc);
                false -> strip_spaces_rt_small(s, i + 1, hi, concat(acc, ch))
            }
        }
    }
}

// Only the first non-space character matters, so do not build a stripped copy of the whole type to
// look at it. This is asked once per field per nesting level while placing a record's fields, which on
// the compiler's own types meant stripping a multi-thousand-character string thousands of times.
fn record_type_starts(s: string) -> boolean {
    i: int64 <- first_non_space_index_rt(s, 0);
    i < length_bytes(s) and substring(s, i, i + 1) == "{"
}

fn first_non_space_index_rt(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> i;
        false -> case substring(s, i, i + 1) == " " of {
            true -> first_non_space_index_rt(s, i + 1);
            false -> i
        }
    }
}

fn extract_inner_from_brace(t: string, i: int64, depth: int64) -> string {
    case i >= length_bytes(t) of {
        true -> "";
        false -> {
            c: string <- substring(t, i, i + 1);
            case c == "{" of {
                true -> extract_inner_from_brace(t, i + 1, depth + 1);
                false -> case c == "}" of {
                    true -> case depth == 1 of {
                        true -> substring(t, 1, i);
                        false -> extract_inner_from_brace(t, i + 1, depth - 1)
                    };
                    false -> extract_inner_from_brace(t, i + 1, depth)
                }
            }
        }
    }
}

fn extract_braced_body(t: string) -> string {
    case length_bytes(t) < 2 of {
        true -> "";
        false -> extract_inner_from_brace(t, 1, 1)
    }
}

// Paren depth tracked so fn / tuple types nested in record fields (e.g. `start: (int64, fn(...) -> (:no_reply, int64))`
// for §15.4.13.2 child_spec) do not split record fields at their internal commas.
fn first_top_comma_or_end(content: string, i: int64, brace_depth: int64, bracket_depth: int64, paren_depth: int64) -> int64 {
    case i >= length_bytes(content) of {
        true -> length_bytes(content);
        false -> {
            c: string <- substring(content, i, i + 1);
            case c == "{" of {
                true -> first_top_comma_or_end(content, i + 1, brace_depth + 1, bracket_depth, paren_depth);
                false -> case c == "}" of {
                    true -> first_top_comma_or_end(content, i + 1, brace_depth - 1, bracket_depth, paren_depth);
                    false -> case c == "[" of {
                        true -> first_top_comma_or_end(content, i + 1, brace_depth, bracket_depth + 1, paren_depth);
                        false -> case c == "]" of {
                            true -> first_top_comma_or_end(content, i + 1, brace_depth, bracket_depth - 1, paren_depth);
                            false -> case c == "(" of {
                                true -> first_top_comma_or_end(content, i + 1, brace_depth, bracket_depth, paren_depth + 1);
                                false -> case c == ")" of {
                                    true -> first_top_comma_or_end(content, i + 1, brace_depth, bracket_depth, paren_depth - 1);
                                    false -> case c == "," and brace_depth == 0 and bracket_depth == 0 and paren_depth == 0 of {
                                        true -> i;
                                        false -> first_top_comma_or_end(content, i + 1, brace_depth, bracket_depth, paren_depth)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn colon_at_depth0_seg(seg: string, i: int64, brace_depth: int64, bracket_depth: int64, paren_depth: int64) -> int64 {
    case i >= length_bytes(seg) of {
        true -> -1;
        false -> {
            c: string <- substring(seg, i, i + 1);
            case c == "{" of {
                true -> colon_at_depth0_seg(seg, i + 1, brace_depth + 1, bracket_depth, paren_depth);
                false -> case c == "}" of {
                    true -> colon_at_depth0_seg(seg, i + 1, brace_depth - 1, bracket_depth, paren_depth);
                    false -> case c == "[" of {
                        true -> colon_at_depth0_seg(seg, i + 1, brace_depth, bracket_depth + 1, paren_depth);
                        false -> case c == "]" of {
                            true -> colon_at_depth0_seg(seg, i + 1, brace_depth, bracket_depth - 1, paren_depth);
                            false -> case c == "(" of {
                                true -> colon_at_depth0_seg(seg, i + 1, brace_depth, bracket_depth, paren_depth + 1);
                                false -> case c == ")" of {
                                    true -> colon_at_depth0_seg(seg, i + 1, brace_depth, bracket_depth, paren_depth - 1);
                                    false -> case c == ":" and brace_depth == 0 and bracket_depth == 0 and paren_depth == 0 of {
                                        true -> i;
                                        false -> colon_at_depth0_seg(seg, i + 1, brace_depth, bracket_depth, paren_depth)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn scan_after_comma(content: string, field: string, seg_end: int64) -> string {
    case seg_end >= length_bytes(content) of {
        true -> "";
        false -> case substring(content, seg_end, seg_end + 1) == "," of {
            true -> scan_field_in_content(content, field, seg_end + 1);
            false -> ""
        }
    }
}

fn scan_field_in_content(content: string, field: string, start: int64) -> string {
    case start > length_bytes(content) of {
        true -> "";
        false -> {
            seg_end: int64 <- first_top_comma_or_end(content, start, 0, 0, 0);
            seg: string <- strip_spaces_rt(substring(content, start, seg_end));
            case length_bytes(seg) == 0 of {
                true -> "";
                false -> {
                    colon: int64 <- colon_at_depth0_seg(seg, 0, 0, 0, 0);
                    case colon < 0 of {
                        true -> scan_after_comma(content, field, seg_end);
                        false -> {
                            fname: string <- strip_spaces_rt(substring(seg, 0, colon));
                            fty: string <- strip_spaces_rt(substring(seg, colon + 1, length_bytes(seg)));
                            case fname == field of {
                                true -> fty;
                                false -> scan_after_comma(content, field, seg_end)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn find_field_type_in_record(record_str: string, field: string) -> string {
    t: string <- strip_spaces_rt(record_str);
    case length_bytes(t) < 2 of {
        true -> "";
        false -> case substring(t, 0, 1) == "{" of {
            false -> "";
            true -> {
                content: string <- extract_braced_body(t);
                scan_field_in_content(content, field, 0)
            }
        }
    }
}

fn count_top_level_commas_from(content: string, i: int64, brace_depth: int64, bracket_depth: int64, paren_depth: int64) -> int64 {
    case i >= length_bytes(content) of {
        true -> 0;
        false -> {
            c: string <- substring(content, i, i + 1);
            case c == "{" of {
                true -> count_top_level_commas_from(content, i + 1, brace_depth + 1, bracket_depth, paren_depth);
                false -> case c == "}" of {
                    true -> count_top_level_commas_from(content, i + 1, brace_depth - 1, bracket_depth, paren_depth);
                    false -> case c == "[" of {
                        true -> count_top_level_commas_from(content, i + 1, brace_depth, bracket_depth + 1, paren_depth);
                        false -> case c == "]" of {
                            true -> count_top_level_commas_from(content, i + 1, brace_depth, bracket_depth - 1, paren_depth);
                            false -> case c == "(" of {
                                true -> count_top_level_commas_from(content, i + 1, brace_depth, bracket_depth, paren_depth + 1);
                                false -> case c == ")" of {
                                    true -> count_top_level_commas_from(content, i + 1, brace_depth, bracket_depth, paren_depth - 1);
                                    false -> case c == "," and brace_depth == 0 and bracket_depth == 0 and paren_depth == 0 of {
                                        true -> 1 + count_top_level_commas_from(content, i + 1, brace_depth, bracket_depth, paren_depth);
                                        false -> count_top_level_commas_from(content, i + 1, brace_depth, bracket_depth, paren_depth)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn tuple_shell_flat_bytes(elem_count: int64) -> int64 {
    (elem_count + 1) / 2 * 16
}

// Tuple arity / comma counting for `(T1, T2, …)` strings — mirrors prims_tuple.count_* without importing prims_tuple (cycle break).
fn count_paren_tuple_commas(s: string, i: int64, paren_depth: int64, brace_depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0;
        false -> case substring(s, i, i + 1) of {
            "(" -> count_paren_tuple_commas(s, i + 1, paren_depth + 1, brace_depth);
            ")" -> count_paren_tuple_commas(s, i + 1, paren_depth - 1, brace_depth);
            "{" -> count_paren_tuple_commas(s, i + 1, paren_depth, brace_depth + 1);
            "}" -> count_paren_tuple_commas(s, i + 1, paren_depth, brace_depth - 1);
            "[" -> count_paren_tuple_commas(s, i + 1, paren_depth, brace_depth + 1);
            "]" -> count_paren_tuple_commas(s, i + 1, paren_depth, brace_depth - 1);
            "," -> case paren_depth == 0 and brace_depth == 0 of {
                true -> 1 + count_paren_tuple_commas(s, i + 1, paren_depth, brace_depth);
                false -> count_paren_tuple_commas(s, i + 1, paren_depth, brace_depth)
            };
            _: string -> count_paren_tuple_commas(s, i + 1, paren_depth, brace_depth)
        }
    }
}

fn count_paren_tuple_type_elements(type_name: string) -> int64 {
    case length_bytes(type_name) < 2 of {
        true -> 1;
        false -> case substring(type_name, 0, 1) == "(" of {
            true -> 1 + count_paren_tuple_commas(substring(type_name, 1, length_bytes(type_name) - 1), 0, 0, 0);
            false -> 1
        }
    }
}

fn count_record_fields(record_str: string) -> int64 {
    t: string <- strip_spaces_rt(record_str);
    content: string <- extract_braced_body(t);
    inner: string <- strip_spaces_rt(content);
    case length_bytes(inner) == 0 of {
        true -> 0;
        false -> count_top_level_commas_from(inner, 0, 0, 0, 0) + 1
    }
}

// Boxed layout: every field is one 8-byte slot, aggregates included (see the header).
fn slot_bytes_for_field_type(fty: string) -> int64 {
    8
}

// Legacy inline shell sizes, used only for the supervisor reply record (runtime-laid-out).
// Fn-value types are often normalized to `(T1,T2) -> R` (same spelling as tuples). Those are
// one pointer (8 bytes), not a tuple shell — see reg_conventions@is_tuple_type.
fn slot_bytes_for_field_type_inline(fty: string) -> int64 {
    t: string <- strip_spaces_rt(fty);
    case record_type_starts(t) of {
        true -> {
            nf: int64 <- count_record_fields(t);
            tuple_shell_flat_bytes(nf)
        };
        false -> case length_bytes(t) > 0 and substring(t, 0, 1) == "(" and reg_conventions@is_tuple_type(t) of {
            true -> {
                ne: int64 <- count_paren_tuple_type_elements(t);
                tuple_shell_flat_bytes(ne)
            };
            false -> 8
        }
    }
}

// Returns -1 when `field` is not a field of this record, NOT the accumulated total.
// Returning the total made every unmatched name resolve to the same in-range offset:
// storing wbt_map's compare_key/compare_value into a wbt_set record put all four on one
// slot, left compare_item unwritten, and the stale word was called as the comparator --
// a SIGFPE and a _sigtramp loop instead of a diagnostic. Callers must treat -1 as poison
// and never do arithmetic on it; it reaches tuple_flat_memref, which emits `.err`.
fn offset_bytes_before_field_in_content(content: string, field: string, start: int64, acc: int64, inline: boolean) -> int64 {
    case start > length_bytes(content) of {
        true -> -1;
        false -> {
            seg_end: int64 <- first_top_comma_or_end(content, start, 0, 0, 0);
            seg: string <- strip_spaces_rt(substring(content, start, seg_end));
            colon: int64 <- colon_at_depth0_seg(seg, 0, 0, 0, 0);
            case colon < 0 of {
                true -> -1;
                false -> {
                    fname: string <- strip_spaces_rt(substring(seg, 0, colon));
                    fty: string <- strip_spaces_rt(substring(seg, colon + 1, length_bytes(seg)));
                    slot: int64 <- case inline of {
                        true -> field_value_flat_slot_bytes_inline(fty);
                        false -> field_value_flat_slot_bytes(fty)
                    };
                    case fname == field of {
                        true -> acc;
                        false -> offset_bytes_before_field_in_content(content, field, seg_end + 1, acc + slot, inline)
                    }
                }
            }
        }
    }
}

// -1, not 0, when the string is not a record type at all: a non-record has no fields, so
// every field offset in it is meaningless. Returning 0 aimed every such query at the first
// slot, which is a plausible-looking address and therefore silent corruption. Poison
// propagates to tuple_flat_memref, which emits `.err`. Companion to the unknown-field -1 in
// offset_bytes_before_field_in_content.
fn offset_bytes_before_field(record_str: string, field: string) -> int64 {
    t: string <- strip_spaces_rt(record_str);
    case record_type_starts(t) of {
        false -> -1;
        true -> {
            content: string <- extract_braced_body(t);
            inner: int64 <- offset_bytes_before_field_in_content(content, field, 0, 0, record_type_keeps_inline_layout(t));
            case inner < 0 of {
                true -> -1;
                false -> shape_word_bytes() + inner
            }
        }
    }
}

fn count_record_chain(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case sir_term_root_node(term).kind == 6 and sir_term_root_node(term).name == "record_make" of {
        true -> case sir_term_at(term, sir_term_root_node(term).right_expr).root < 0 of {
            true -> 1;
            false -> 1 + count_record_chain(sir_term_at(term, sir_term_root_node(term).right_expr))
        };
        false -> 0
    }
}

fn brace_walk(s: string, i: int64, depth: int64) -> boolean {
    case i >= length_bytes(s) of {
        true -> depth == 0;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "{" of {
                true -> brace_walk(s, i + 1, depth + 1);
                false -> case c == "}" of {
                    true -> case depth == 0 of {
                        true -> false;
                        false -> brace_walk(s, i + 1, depth - 1)
                    };
                    false -> brace_walk(s, i + 1, depth)
                }
            }
        }
    }
}

fn record_type_braces_balanced(s: string) -> boolean {
    t: string <- strip_spaces_rt(s);
    case length_bytes(t) < 2 of {
        true -> false;
        false -> case substring(t, 0, 1) == "{" of {
            false -> true;
            true -> brace_walk(t, 0, 0)
        }
    }
}

fn record_case_inner_body(full_pat: string) -> string {
    t: string <- strip_spaces_rt(full_pat);
    extract_braced_body(t)
}

fn record_case_field_step(remaining_inner: string) -> (string, string) {
    seg_end: int64 <- first_top_comma_or_end(remaining_inner, 0, 0, 0, 0);
    first: string <- strip_spaces_rt(substring(remaining_inner, 0, seg_end));
    rest: string <- case seg_end >= length_bytes(remaining_inner) of {
        true -> "";
        false -> case substring(remaining_inner, seg_end, seg_end + 1) == "," of {
            true -> strip_spaces_rt(substring(remaining_inner, seg_end + 1, length_bytes(remaining_inner)));
            false -> ""
        }
    };
    (first, rest)
}

fn record_field_segment_name_sub(seg: string) -> (string, string) {
    colon: int64 <- colon_at_depth0_seg(seg, 0, 0, 0, 0);
    case colon < 0 of {
        true -> ("", "");
        false -> (strip_spaces_rt(substring(seg, 0, colon)), strip_spaces_rt(substring(seg, colon + 1, length_bytes(seg))))
    }
}

// Stack bytes for a record_make of this type (shell + nested aggregate field values), for list node payload sizing.
fn nested_stack_bytes_for_field_type(fty: string) -> int64 {
    t: string <- strip_spaces_rt(fty);
    case record_type_starts(t) of {
        true -> record_type_flat_stack_bytes(t);
        false -> case length_bytes(t) > 0 and substring(t, 0, 1) == "(" and reg_conventions@is_tuple_type(t) of {
            true -> tuple_shell_flat_bytes(count_paren_tuple_type_elements(t));
            false -> 0
        }
    }
}

fn record_fields_nested_stack_bytes_loop(remaining_inner: string) -> int64 {
    inner: string <- strip_spaces_rt(remaining_inner);
    case length_bytes(inner) == 0 of {
        true -> 0;
        false -> {
            (seg, rest) <- record_case_field_step(inner);
            (fname, fty) <- record_field_segment_name_sub(seg);
            here: int64 <- case length_bytes(fname) == 0 of {
                true -> 0;
                false -> nested_stack_bytes_for_field_type(fty)
            };
            here + record_fields_nested_stack_bytes_loop(rest)
        }
    }
}

fn record_type_flat_stack_bytes(record_str: string) -> int64 {
    case record_type_starts(strip_spaces_rt(record_str)) of {
        false -> 8;
        true -> {
            R: string <- strip_spaces_rt(record_str);
            content: string <- extract_braced_body(R);
            cnt: int64 <- count_record_fields(R);
            shell: int64 <- tuple_shell_flat_bytes(cnt);
            nest: int64 <- record_fields_nested_stack_bytes_loop(content);
            shape_word_bytes() + shell + nest
        }
    }
}
