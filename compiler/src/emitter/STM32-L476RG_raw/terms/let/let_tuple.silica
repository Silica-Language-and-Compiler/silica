// Tuple let: rhs_reg computation for RHS type tuple (T1, T2, ...)
// Tuple result is a pointer (address); same register allocation as int64/uint64 (X registers)

use sir_ast;
use let_int64;

export compute_rhs_reg_in_let/5;
export compute_rhs_reg_top_level/3;

fn compute_rhs_reg_in_let(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound_name: string, bound_reg: string, outer_reg: string) -> string {
    let_int64@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg)
}

// Tuple result is pointer-sized; must use X register. When dest is W0/S0/D0 (narrow return),
// we cannot use MOV W0, SP - use X1 for the tuple RHS instead.
fn compute_rhs_reg_top_level(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, bound_reg: string, dest: string) -> string {
    case substring(dest, 0, 1) == "X" of {
        true -> let_int64@compute_rhs_reg_top_level(term, bound_reg, dest);
        false -> "X1"
    }
}
