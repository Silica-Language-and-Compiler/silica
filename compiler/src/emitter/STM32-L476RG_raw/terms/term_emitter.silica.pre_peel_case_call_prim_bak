// Case scrutinee default: dest X0/X1 -> X2 so we do not use X0 (result). If bound.outer_reg already binds X2
// (e.g. let value <- 2; case cmd of { ... } with cmd in X1), use X3+ so loading the scrutinee does not clobber value.
// term_to_asm_opt_bound passes bound.bound_reg = body_bound: the register for the enclosing let's binding in the
// case body (e.g. let value <- 2 in case cmd -> body_bound is X2 where value lives). Default scrutinee X2
// would clobber that; use X3+ when body_bound is X2 or bound.outer_reg records X2.
// If bound.outer_reg binds X1 (e.g. |%extended=X1) but we would use scrutinee X1, a prior case may have loaded
// another list into X1 — use X3+ so the scrutinee load runs in a fresh reg and reloads the right pointer.

fn emit_case_expression(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string {
    // Scrutinee register must not clobber AArch64 args still needed in branch bodies. X0/X1 are the first two
    // int64 params; placing the bool scrutinee in X1 when dest is X0 (return) breaks e.g. ack(m,n): CSET X1,EQ
    // overwrites n before the true branch can do n+1.
    scrut_reg: string <- term_case_patterns@emit_case_pick_scrut_reg(dest, bound.outer_reg, bound.bound_reg);
    lit_reg: string <- term_case_patterns@emit_case_lit_reg_for_scrut(scrut_reg);
    guard_reg: string <- term_case_patterns@emit_case_guard_reg_for_scrut(scrut_reg);
    scrut_asm: string <- term_to_asm_opt_bound(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), scrut_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false });
    case_name: string <- term_sir_helpers@sir_term_root_node(term).name;
    done_l: string <- term_case_patterns@case_emit_done_label(case_name);
    fb_l: string <- term_case_patterns@case_emit_fb_label(case_name);
    branches_asm: string <- emit_case_branch_seq(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), { scrut_t: term_sir_helpers@sir_term_root_node(term).value, scrut_reg: scrut_reg, lit_reg: lit_reg, guard_reg: guard_reg, dest: dest, done_l: done_l, fb_l: fb_l, case_name: case_name }, 0, pools, bound);
    fb_head: string <- concat(fb_l, ":\n    BL _silica_rt_case_clause\n");
    fb_tail: string <- concat(concat(concat("    MOV ", dest), ", #0\n    B "), concat(done_l, "\n"));
    fb_asm: string <- concat(fb_head, fb_tail);
    scr_nl: string <- concat(scrut_asm, "\n");
    scr_br: string <- concat(scr_nl, branches_asm);
    scr_fb: string <- concat(scr_br, fb_asm);
    done_lbl: string <- concat(done_l, ":\n");
    // Tuple-returning user-call scrutinees allocate a caller sret slab (SUB SP / MOV X8, SP).
    // Let-bound calls free that slab at let-end; case scrutinees must free after the case completes.
    scrut_sret_n: int64 <- term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
    sret_free: string <- case scrut_sret_n > 0 of {
        true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(scrut_sret_n), "\n"));
        false -> ""
    };
    concat(concat(scr_fb, done_lbl), sret_free)
}

