// String concatenation helper: non-MTE fallback for Apple Silicon (macOS ARM64).
// Per silica-specification §21.3: "If MTE is not available... runtime falls back to software-based
// bounds checking... Memory safety is maintained through compiler-generated bounds checks."
//
// L_concat_helper: X0 = ptr1, X1 = ptr2 (null-terminated UTF-8). Returns X0 = ptr to concatenated
// string. Empty operands return the other pointer (no allocation). Length of the most recent
// result is cached so growing concat(acc, ch) in strip_spaces is O(1) strlen. Longer results
// bump-allocate from 4MB mmap chunks. mmap-per-call used to SIGKILL type checking of
// wbt_map.silica (75GB physical footprint from char-by-char strip_spaces).
//
// Isolated module for vigorous testing. Targets: Apple Silicon, macOS ARM64.

// ESP32-S3: these helpers are board runtime routines (board/runtime/rt_string.S, silica_rt_string_*);
// the emitter calls them directly, so nothing is emitted into the module.
export emit_string_concat_helper/0;

fn sc_helper_lens() -> string {
    ""
}

fn sc_helper_copy() -> string {
    ""
}

fn sc_helper_bump() -> string {
    ""
}

fn emit_string_concat_helper() -> string {
    concat(concat(sc_helper_lens(), sc_helper_copy()), sc_helper_bump())
}
