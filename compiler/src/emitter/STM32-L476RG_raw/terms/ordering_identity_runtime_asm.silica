// Exact function-value ordering identity (Layer 1 §7.2).
// Tokens mix code pointer and captured-environment instance id; not forgeable from behavior alone.

export emit_ordering_identity_runtime_asm/0;

fn emit_ordering_identity_runtime_asm() -> string {
    "
	.section	__DATA,__bss
	.p2align	3
	.globl	_silica_rt_ordering_env_next
_silica_rt_ordering_env_next:
	.space	8
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_ordering_env_fresh
	.p2align	2
_silica_rt_ordering_env_fresh:
	.cfi_startproc
; -> X0 = fresh non-zero environment instance id
	adrp	x8, _silica_rt_ordering_env_next@PAGE
	add	x8, x8, _silica_rt_ordering_env_next@PAGEOFF
	ldr	x0, [x8]
	add	x1, x0, #1
	str	x1, [x8]
	cbnz	x0, Loid_ret
	mov	x0, #1
Loid_ret:
	ret
	.cfi_endproc
	.globl	_silica_rt_ordering_identity_make
	.p2align	2
_silica_rt_ordering_identity_make:
	.cfi_startproc
; X0 = code pointer, X1 = environment instance id -> X0 = opaque int64 token
	eor	x2, x0, x1, lsl #32
	movz	x3, #0x7c15
	movk	x3, #0x7f4a, lsl #16
	movk	x3, #0x9b97, lsl #32
	movk	x3, #0x9e37, lsl #48
	mul	x4, x1, x3
	eor	x0, x2, x4
	ret
	.cfi_endproc
	.globl	_silica_rt_ordering_identity_same
	.p2align	2
_silica_rt_ordering_identity_same:
	.cfi_startproc
; X0 = token A, X1 = token B -> X0 = 1 if equal else 0
	cmp	x0, x1
	cset	w0, eq
	and	x0, x0, #1
	ret
	.cfi_endproc
	.globl	_silica_rt_ordering_bundle_make
	.p2align	2
_silica_rt_ordering_bundle_make:
	.cfi_startproc
; X0 = function token, X1 = orientation atom (int64) -> X0 = bundle token
	movz	x2, #0x0a95
	movk	x2, #0x2722, lsl #16
	movk	x2, #0xc1b7, lsl #32
	movk	x2, #0x517c, lsl #48
	mul	x3, x1, x2
	eor	x0, x0, x3
	and	x0, x0, #0x7fffffffffffffff
	ret
	.cfi_endproc
"
}
