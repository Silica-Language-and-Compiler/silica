// String length helpers: byte length and UTF-8 scalar count. Pure AArch64 (same normalize as io.rs).
// Char count: for valid UTF-8, equals Rust str::chars().count() (non-continuation bytes).
// X0 = string pointer; returns length in X0.

// ESP32-S3: these helpers are board runtime routines (board/runtime/rt_string.S, silica_rt_string_*);
// the emitter calls them directly, so nothing is emitted into the module.
export emit_length_bytes_helper/0;
export emit_length_chars_helper/0;

fn emit_length_bytes_helper() -> string {
    ""
}

fn emit_length_chars_helper() -> string {
    ""
}
