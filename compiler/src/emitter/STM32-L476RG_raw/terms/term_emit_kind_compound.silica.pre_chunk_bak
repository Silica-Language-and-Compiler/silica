                                            };
                                            save_left: string <- concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                            right_inner: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
