                            off1: int64 <- off0 + 8;
                            st1: string <- concat("    STR X10, ", concat(term_aggregate_helpers@tuple_flat_memref(store_base, off1), "\n"));
                            pair_asm: string <- concat(concat(concat(concat(a0, "\n"), concat(st0, concat(a1, "\n"))), st1), "\n");
                            rest_asm: string <- emit_flat_record_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), R, sp_adjust, field_prefix, store_base, pools, bound, emit_child);
