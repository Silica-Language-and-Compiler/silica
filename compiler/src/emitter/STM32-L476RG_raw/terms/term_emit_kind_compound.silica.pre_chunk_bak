                                            };
                                            restore_left: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                            combined: string <- concat(concat(concat(concat(concat(concat(left_inner, "\n"), save_left), right_inner), "\n"), restore_left), "");
                                            (combined, "")
                                        };
                                        false -> case right_is_prim and is_string_prim == false and is_float64 == false and is_float32 == false and is_float16 == false of {
                                            true -> {
                                                temp_reg2: string <- left_reg;
                                                left_2p: string <- case bound.debug of {
