ndle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
    case idx < count - 1 and term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
        true -> {
            elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
            elem_is_agg: bool <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and (term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" or term_sir_helpers@sir_term_root_node(elem).name == "record_make");
            type_prefix: string <- reg_conventions@reg_prefix_for_type(term_sir_helpers@sir_term_root_node(elem).type_name);
            elem_prefix: string <- case elem_is_agg of {
                true -> "X";
                false -> case type_prefix == "X" and term_sir_helpers@sir_term_root_node(elem).kind == 0 and term_user_call_abi@value_has_dot(term_sir_helpers@sir_term_root_node(elem).value) of {
                    true -> "D";
                    false -> type_prefix
                }
            };
            temp_reg: string <- concat(elem_prefix, "9");
            elem_asm: string <- case bound.debug of {
                true -> { emit_child(elem, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                false -> emit_child(elem, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
            };
            nested_bytes: int64 <- case elem_is_agg of {
                true -> term_aggregate_helpers@agg_alloc_inner(elem);
                false -> 0
            };
            new_adjust: int64 <- sp_adjust + nested_bytes;
            box_f32: bool <- count > 1 and elem_is_agg == false and reg_conventions@is_float32_type(term_sir_helpers@sir_term_root_node(elem).type_name);
            case box_f32 of {
                true -> {
                    store_asm: string <- term_aggregate_helpers@emit_flat_float32_boxed_pair(store_base, byte_cursor, temp_reg);
                    rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), idx + 1, count, new_adjust, byte_cursor + 16, store_base, pools, bound, emit_child);
                    concat(concat(elem_asm, concat("\n", store_asm)), rest_asm)
                };
                false -> case elem_is_agg of {
                    true -> {
                        rec_flat: bool <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and term_sir_helpers@sir_term_root_node(elem).name == "record_make" and idx == 0 and count >= 2;
                        case rec_flat of {
                            true -> {
                                rec_R: string <- term_sir_helpers@sir_term_root_node(elem).type_name;
                                rsz: int64 <- prims_record@record_type_value_flat_byte_size(rec_R);
                                qw: int64 <- rsz / 8;
                                rec_sp_round: int64 <- term_record_layout@record_make_stack_alloc_size(rec_R);
                                dest_base: int64 <- case len(store_base) > 0 of {
                                    true -> byte_cursor;
                                    false -> byte_cursor + rec_sp_round
                                };
                                memcpy_asm: string <- term_aggregate_helpers@emit_reg_to_flat_qwords_memcpy_loop(0, qw, temp_reg, store_base, dest_base);
                                next_bc: int64 <- byte_cursor + rsz;
                                restore_rec_sp: string <- concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(rec_sp_round), "\n"));
                                rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), idx + 1, count, new_adjust, next_bc, store_base, pools, bound, emit_child);
                                concat(concat(elem_asm, concat("\n", memcpy_asm)), concat(concat("\n", restore_rec_sp), concat("\n", rest_asm)))
                            };
                            false -> {
                                store_offset: int64 <- idx * 8 + new_adjust;
                                store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, store_offset))));
                                next_bc: int64 <- store_offset + 8;
                                rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), idx + 1, count, new_adjust, next_bc, store_base, pools, bound, emit_child);
                                concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
                            }
                        }
                    };
                    false -> {
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, byte_cursor))));
                        rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), idx + 1, count, new_adjust, byte_cursor + 8, store_base, pools, bound, emit_child);
                        concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
                    }
                }
            }
        };
        false -> {
            elem_is_agg: bool <- term_sir_helpers@sir_term_root_node(term).kind == 6 and (term_sir_helpers@sir_term_root_node(term).name == "tuple_make" or term_sir_helpers@sir_term_root_node(term).name == "record_make");
            type_prefix2: string <- reg_conventions@reg_prefix_for_type(term_sir_helpers@sir_term_root_node(term).type_name);
            elem_prefix: string <- case elem_is_agg of {
                true -> "X";
                false -> case type_prefix2 == "X" and term_sir_helpers@sir_term_root_node(term).kind == 0 and term_user_call_abi@value_has_dot(term_sir_helpers@sir_term_root_node(term).value) of {
                    true -> "D";
                    false -> type_prefix2
                }
            };
            temp_reg: string <- concat(elem_prefix, "9");
            elem_asm: string <- case bound.debug of {
                true -> { emit_child(term, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                false -> emit_child(term, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
            };
            nested_bytes: int64 <- case elem_is_agg of {
                true -> term_aggregate_helpers@agg_alloc_inner(term);
                false -> 0
            };
            new_adjust: int64 <- sp_adjust + nested_bytes;
            box_f32_last: bool <- count > 1 and elem_is_agg == false and reg_conventions@is_float32_type(term_sir_helpers@sir_term_root_node(term).type_name);
            case box_f32_last of {
                true -> concat(elem_asm, concat("\n", term_aggregate_helpers@emit_flat_float32_boxed_pair(store_base, byte_cursor, temp_reg)));
                false -> case elem_is_agg of {
                    true -> {
                        store_offset: int64 <- idx * 8 + new_adjust;
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, store_offset))));
                        concat(elem_asm, concat("\n", store_asm))
                    };
                    false -> {
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, byte_cursor))));
                        concat(elem_asm, concat("\n", store_asm))
                    }
                }
            }
        }
    }
}



