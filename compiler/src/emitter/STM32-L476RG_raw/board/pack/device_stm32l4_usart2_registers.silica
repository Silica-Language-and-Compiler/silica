// Board-pack device description of USART2 (tag :stm32l4_usart2, window 0x40004400 of board_pack.silica), written by hand
// from ST RM0351 (STM32L47xxx/L48xxx/L49xxx/L4Axxx reference manual), the register map of the peripheral's
// chapter. Every register is 32 bits wide; offsets are relative to the peripheral base. The access mode is
// the register's as a whole: :read_only when every field is r, :write_only when every field is w (a read
// returns 0), :read_write otherwise. pack_descriptions.silica names this module as the only description
// of the tag (E2239 for any other).
//
// USART2 is the runtime's console (PA2/PA3, the ST-LINK virtual COM port): a program that maps it shares it
// with the runtime (board_pack window_shared_with_runtime). TXE is ISR bit 7; a byte written to TDR is sent.

use DeviceDescription;

export registers/1;

impl fn registers(device: (:stm32l4_usart2)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :cr1, offset: 0x0, width: 32, access: :read_write },
        { name: :cr2, offset: 0x4, width: 32, access: :read_write },
        { name: :cr3, offset: 0x8, width: 32, access: :read_write },
        { name: :brr, offset: 0xC, width: 32, access: :read_write },
        { name: :gtpr, offset: 0x10, width: 32, access: :read_write },
        { name: :rtor, offset: 0x14, width: 32, access: :read_write },
        { name: :rqr, offset: 0x18, width: 32, access: :write_only },
        { name: :isr, offset: 0x1C, width: 32, access: :read_only },
        { name: :icr, offset: 0x20, width: 32, access: :write_only },
        { name: :rdr, offset: 0x24, width: 32, access: :read_only },
        { name: :tdr, offset: 0x28, width: 32, access: :read_write }
    ]
}
