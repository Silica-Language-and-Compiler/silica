// Board-pack device description of GPIOB (tag :stm32l4_gpiob, window 0x48000400 of board_pack.silica), written by hand
// from ST RM0351 (STM32L47xxx/L48xxx/L49xxx/L4Axxx reference manual), the register map of the peripheral's
// chapter. Every register is 32 bits wide; offsets are relative to the peripheral base. The access mode is
// the register's as a whole: :read_only when every field is r, :write_only when every field is w (a read
// returns 0), :read_write otherwise. pack_descriptions.silica names this module as the only description
// of the tag (E2239 for any other).
//
// The port's clock is RCC AHB2ENR bit GPIOBEN; a port whose clock is off reads 0 and ignores writes.

use DeviceDescription;

export registers/1;

impl fn registers(device: (:stm32l4_gpiob)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :moder, offset: 0x0, width: 32, access: :read_write },
        { name: :otyper, offset: 0x4, width: 32, access: :read_write },
        { name: :ospeedr, offset: 0x8, width: 32, access: :read_write },
        { name: :pupdr, offset: 0xC, width: 32, access: :read_write },
        { name: :idr, offset: 0x10, width: 32, access: :read_only },
        { name: :odr, offset: 0x14, width: 32, access: :read_write },
        { name: :bsrr, offset: 0x18, width: 32, access: :write_only },
        { name: :lckr, offset: 0x1C, width: 32, access: :read_write },
        { name: :afrl, offset: 0x20, width: 32, access: :read_write },
        { name: :afrh, offset: 0x24, width: 32, access: :read_write },
        { name: :brr, offset: 0x28, width: 32, access: :write_only },
        { name: :ascr, offset: 0x2C, width: 32, access: :read_write }
    ]
}
