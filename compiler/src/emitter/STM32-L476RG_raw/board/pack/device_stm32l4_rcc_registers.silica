// Board-pack device description of RCC (reset and clock control) (tag :stm32l4_rcc, window 0x40021000 of board_pack.silica), written by hand
// from ST RM0351 (STM32L47xxx/L48xxx/L49xxx/L4Axxx reference manual), the register map of the peripheral's
// chapter. Every register is 32 bits wide; offsets are relative to the peripheral base. The access mode is
// the register's as a whole: :read_only when every field is r, :write_only when every field is w (a read
// returns 0), :read_write otherwise. pack_descriptions.silica names this module as the only description
// of the tag (E2239 for any other).
//
// The runtime drives RCC at boot (rt_start.S: the 80 MHz PLL, GPIOA and USART2 clocks); a program that maps
// it shares it with the runtime. A read-modify-write must keep the bits the runtime set.

use DeviceDescription;

export registers/1;

impl fn registers(device: (:stm32l4_rcc)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :cr, offset: 0x0, width: 32, access: :read_write },
        { name: :icscr, offset: 0x4, width: 32, access: :read_write },
        { name: :cfgr, offset: 0x8, width: 32, access: :read_write },
        { name: :pllcfgr, offset: 0xC, width: 32, access: :read_write },
        { name: :pllsai1cfgr, offset: 0x10, width: 32, access: :read_write },
        { name: :pllsai2cfgr, offset: 0x14, width: 32, access: :read_write },
        { name: :cier, offset: 0x18, width: 32, access: :read_write },
        { name: :cifr, offset: 0x1C, width: 32, access: :read_only },
        { name: :cicr, offset: 0x20, width: 32, access: :write_only },
        { name: :ahb1rstr, offset: 0x28, width: 32, access: :read_write },
        { name: :ahb2rstr, offset: 0x2C, width: 32, access: :read_write },
        { name: :ahb3rstr, offset: 0x30, width: 32, access: :read_write },
        { name: :apb1rstr1, offset: 0x38, width: 32, access: :read_write },
        { name: :apb1rstr2, offset: 0x3C, width: 32, access: :read_write },
        { name: :apb2rstr, offset: 0x40, width: 32, access: :read_write },
        { name: :ahb1enr, offset: 0x48, width: 32, access: :read_write },
        { name: :ahb2enr, offset: 0x4C, width: 32, access: :read_write },
        { name: :ahb3enr, offset: 0x50, width: 32, access: :read_write },
        { name: :apb1enr1, offset: 0x58, width: 32, access: :read_write },
        { name: :apb1enr2, offset: 0x5C, width: 32, access: :read_write },
        { name: :apb2enr, offset: 0x60, width: 32, access: :read_write },
        { name: :ahb1smenr, offset: 0x68, width: 32, access: :read_write },
        { name: :ahb2smenr, offset: 0x6C, width: 32, access: :read_write },
        { name: :ahb3smenr, offset: 0x70, width: 32, access: :read_write },
        { name: :apb1smenr1, offset: 0x78, width: 32, access: :read_write },
        { name: :apb1smenr2, offset: 0x7C, width: 32, access: :read_write },
        { name: :apb2smenr, offset: 0x80, width: 32, access: :read_write },
        { name: :ccipr, offset: 0x88, width: 32, access: :read_write },
        { name: :bdcr, offset: 0x90, width: 32, access: :read_write },
        { name: :csr, offset: 0x94, width: 32, access: :read_write }
    ]
}
