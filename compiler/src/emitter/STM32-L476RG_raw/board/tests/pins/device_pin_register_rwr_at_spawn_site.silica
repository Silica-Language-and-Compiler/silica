// expected failure E3010: the spawn site declares register_rwr; it declares only concurrency (design §3), and nothing
// there needs register_rwr (the pin builtins run in the worker).

export work/2;
export start/0;

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_write(16, true)
    produces
        pure (:no_reply, state)
    end
}

fn start() -> device_actor_ref {
    sequence proc[concurrency, register_rwr]
        w: device_actor_ref <- spawn_device(0, work, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
    produces
        pure w
    end
}
