// expected failure E2223: a client actor (spawn) declares register_rwr to cast pin work; clients declare only concurrency.

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_write(16, true)
    produces
        pure (:no_reply, state)
    end
}

fn client(msg: device_actor_ref, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, register_rwr]
        _: boolean <- cast_device(msg, 1 impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        w: device_actor_ref <- spawn_device(0, work, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        c: actor_ref <- spawn(0, client, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(c, w impl ActorMessage {})
    produces
        pure 0
    end
}
