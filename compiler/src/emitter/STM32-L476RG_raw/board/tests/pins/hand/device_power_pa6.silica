// Hand-run app, NOT a trial (see README.md here). NUCLEO-L476RG with a jumper from PA6 (flat pin 6,
// Arduino D12) to 3V3 (CN6 pin 4; NOT 5V) installed before the run and left in for the whole run.
//
// Every reading expects 1: input with pull up, pull down and no pull (3.3 V overpowers the pull-down);
// open drain released (latch HIGH) with pull up and with pull down.
//
// SAFETY: PA6 is tied to 3.3 V, so this program never drives PA6 LOW and never makes it a push-pull
// output. There is no pin_write(6, false) and no pin_mode(6, :output) in this file. The latch is written
// HIGH before the switch to open drain (pin_mode writes OTYPER before MODER, so the pin goes straight to
// "open drain, released"), and the program ends with PA6 an input, latch HIGH, no pull.
//
// LD2 (PA5): solid ON while reading and for a 5 s hold after the readings, then three slow blinks.
// Shape as device_grounded_pa6: a device worker (:device_power_pa6) makes the pin calls, an ordinary
// conductor casts the steps, waits 20 ms for the level to settle and asks for the read.
use trial_wait_int64;

// ---- the device worker -------------------------------------------------------------------------

fn configure(op: atom) -> atom {
    sequence proc[register_rwr]
        r: atom <- case op of {
            :pull_up -> {
                _: atom <- pin_write(6, true);
                _: atom <- pin_mode(6, :input);
                pin_pull(6, :up)
            };
            :pull_down -> {
                _: atom <- pin_write(6, true);
                _: atom <- pin_mode(6, :input);
                pin_pull(6, :down)
            };
            :pull_none -> {
                _: atom <- pin_write(6, true);
                _: atom <- pin_mode(6, :input);
                pin_pull(6, :none)
            };
            :od_up -> {
                _: atom <- pin_write(6, true);
                _: atom <- pin_pull(6, :up);
                pin_mode(6, :output_open_drain)
            };
            :od_down -> {
                _: atom <- pin_write(6, true);
                _: atom <- pin_pull(6, :down);
                pin_mode(6, :output_open_drain)
            };
            :idle -> {
                _: atom <- pin_write(6, true);
                _: atom <- pin_mode(6, :input);
                pin_pull(6, :none)
            };
            :led_on -> {
                _: atom <- pin_write(5, true);
                pin_mode(5, :output)
            };
            :led_off -> {
                _: atom <- pin_write(5, false);
                pin_mode(5, :output)
            };
            _: atom -> :ok
        }
    produces
        pure r
    end
}

fn measure(step: uint32, reply_to: actor_ref) -> atom {
    sequence proc[register_rwr, concurrency]
        level: boolean <- pin_read(6);
        _: boolean <- cast(reply_to, { step: step, level: level } impl ActorMessage {})
    produces
        pure :ok
    end
}

fn power_worker(msg: { op: atom, step: uint32, reply_to: actor_ref }, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- case msg.op of {
            :read -> measure(msg.step, msg.reply_to);
            _: atom -> configure(msg.op)
        }
    produces
        pure (:no_reply, state)
    end
}

// ---- the conductor ------------------------------------------------------------------------------
// Messages { step, level }: 0 start; 1..5 a step's reading; 301..305 a step's settle time is over;
// 150 the 5 s hold is over; 200 an end-blink tick (400 ms).

fn op_of(step: uint32) -> atom {
    case step of {
        1 -> :pull_up;
        2 -> :pull_down;
        3 -> :pull_none;
        4 -> :od_up;
        5 -> :od_down;
        _: uint32 -> :idle
    }
}

fn describe(step: uint32) -> string {
    case step of {
        1 -> "input + pull up";
        2 -> "input + pull down";
        3 -> "input + pull none";
        4 -> "open drain released (latch HIGH) + pull up";
        5 -> "open drain released (latch HIGH) + pull down";
        _: uint32 -> "?"
    }
}

fn level_word(b: boolean) -> uint32 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn worker_do(op: atom, step: uint32) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- cast_device_registered(:device_power_pa6, { op: op, step: step, reply_to: self() } impl ActorMessage {})
    produces
        pure sent
    end
}

fn tick_in(ms: uint64, code: uint32) -> timer_ref {
    sequence proc[concurrency]
        t: timer_ref <- send_after(ms, self(), { step: code, level: false } impl ActorMessage {})
    produces
        pure t
    end
}

// Configure, then 20 ms for the level to settle before the read.
fn start_step(step: uint32) -> atom {
    _: boolean <- worker_do(op_of(step), step);
    _: timer_ref <- tick_in(20, step + 300);
    :ok
}

fn on_start(st: { pass: uint32, fail: uint32, ticks: uint32 }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32 }) {
    sequence proc[device_io]
        _: atom <- print_string("power_pa6: pin builtins on PA6 (pin 6, D12) tied to 3V3\n");
        _: boolean <- worker_do(:idle, 0);
        _: boolean <- worker_do(:led_on, 0);
        _: atom <- print_string("jumper IN (PA6 to 3V3) for the whole run, LD2 solid ON\n");
        _: atom <- start_step(1)
    produces
        pure (:no_reply, st)
    end
}

fn finish_readings(pass: uint32, fail: uint32) -> atom {
    sequence proc[device_io]
        _: boolean <- worker_do(:idle, 0);
        _: atom <- print_string("SUMMARY: ");
        _: atom <- print_uint32(pass);
        _: atom <- print_string(" passed, ");
        _: atom <- print_uint32(fail);
        _: atom <- print_string(" failed of 5: ");
        _: atom <- case fail == 0 of {
            true -> print_string("ALL PASS\n");
            false -> print_string("FAILURES\n")
        };
        _: atom <- print_string("readings done, PA6 back to input; LD2 solid ON for 5 s, then 3 slow blinks\n");
        _: timer_ref <- tick_in(5000, 150)
    produces
        pure :ok
    end
}

fn advance(step: uint32, pass: uint32, fail: uint32) -> atom {
    case step < 5 of {
        true -> start_step(step + 1);
        false -> finish_readings(pass, fail)
    }
}

fn on_result(step: uint32, level: boolean, st: { pass: uint32, fail: uint32, ticks: uint32 }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32 }) {
    sequence proc[device_io]
        _: atom <- print_string("step ");
        _: atom <- print_uint32(step);
        _: atom <- print_string(": ");
        _: atom <- print_string(describe(step));
        _: atom <- print_string(": read ");
        _: atom <- print_uint32(level_word(level));
        _: atom <- print_string(", expect 1");
        _: atom <- case level of {
            true -> print_string(": PASS\n");
            false -> print_string(": FAIL\n")
        };
        pass: uint32 <- case level of {
            true -> st.pass + 1;
            false -> st.pass
        };
        fail: uint32 <- case level of {
            true -> st.fail;
            false -> st.fail + 1
        };
        _: atom <- advance(step, pass, fail)
    produces
        pure (:no_reply, { pass: pass, fail: fail, ticks: st.ticks })
    end
}

fn on_settled(step: uint32, st: { pass: uint32, fail: uint32, ticks: uint32 }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32 }) {
    _: boolean <- worker_do(:read, step);
    (:no_reply, st)
}

fn on_hold_done(st: { pass: uint32, fail: uint32, ticks: uint32 }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32 }) {
    _: boolean <- worker_do(:led_off, 0);
    _: timer_ref <- tick_in(400, 200);
    (:no_reply, { pass: st.pass, fail: st.fail, ticks: 0 })
}

fn on_end_tick(st: { pass: uint32, fail: uint32, ticks: uint32 }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32 }) {
    sequence proc[concurrency, device_io]
        t: uint32 <- st.ticks + 1;
        _: boolean <- case t < 7 of {
            true -> {
                odd: uint32 <- t % 2;
                led: atom <- case odd == 1 of {
                    true -> :led_on;
                    false -> :led_off
                };
                _: boolean <- worker_do(led, 0);
                _: timer_ref <- tick_in(400, 200);
                true
            };
            false -> {
                _: atom <- print_string("DONE\n");
                cast_exit(0)
            }
        }
    produces
        pure (:no_reply, { pass: st.pass, fail: st.fail, ticks: t })
    end
}

fn conductor(msg: { step: uint32, level: boolean }, st: { pass: uint32, fail: uint32, ticks: uint32 }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32 }) {
    case msg.step of {
        0 -> on_start(st);
        150 -> on_hold_done(st);
        200 -> on_end_tick(st);
        _: uint32 -> case msg.step > 300 of {
            true -> on_settled(msg.step - 300, st);
            false -> on_result(msg.step, msg.level, st)
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                _: device_actor_ref <- spawn_device_registered(0, power_worker, :device_power_pa6, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                c: actor_ref <- spawn({ pass: 0, fail: 0, ticks: 0 }, conductor, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(c, { step: 0, level: false } impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
