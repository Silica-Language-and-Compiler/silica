// STM32-L476RG_raw defect repro (2026-11-10), found by device_grounded_pa6. Correct on the Mac compiler
// (n=1..4, DONE). On the NUCLEO-L476RG the second dispatch prints a garbage state (fail=0x2000xxxx,
// ticks=268445728 = 0x10003920) and the case on st.out faults: no case arm matched. The trigger is the
// behaviour being a case whose arm returns a helper's (:no_reply, record) tuple; calling on_result directly
// as the whole behaviour body is correct on the board.
// Repro: actor record state rebuilt by a helper, while a helper re-arms a send_after timer whose
// message is a record. Each dispatch prints the state it received.
// Expected: n=1..4, pass=<n-1>, fail=7 (0 at n=1), ticks=0, out=1 from n=3, then DONE.
use trial_wait_int64;

fn next_state(step: uint32, pass: uint32, fail: uint32, ticks: uint32, out: boolean) -> { pass: uint32, fail: uint32, ticks: uint32, out: boolean } {
    { pass: pass, fail: fail, ticks: ticks, out: out }
}

fn word(b: boolean) -> uint32 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn kick(code: uint32) -> atom {
    sequence proc[concurrency]
        _: timer_ref <- send_after(20, self(), { step: code, level: false } impl ActorMessage {})
    produces
        pure :ok
    end
}

fn finish() -> atom {
    sequence proc[concurrency, device_io]
        _: atom <- print_string("DONE\n");
        _: boolean <- cast_exit(0)
    produces
        pure :ok
    end
}

fn advance(step: uint32) -> atom {
    case step < 4 of {
        true -> kick(step + 1);
        false -> finish()
    }
}

fn on_result(msg: { step: uint32, level: boolean }, st: { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) {
    sequence proc[device_io]
        _: atom <- print_string("n=");
        _: atom <- print_uint32(msg.step);
        _: atom <- print_string(" pass=");
        _: atom <- print_uint32(st.pass);
        _: atom <- print_string(" fail=");
        _: atom <- print_uint32(st.fail);
        _: atom <- print_string(" ticks=");
        _: atom <- print_uint32(st.ticks);
        _: atom <- print_string(" out=");
        _: atom <- print_uint32(word(st.out));
        _: atom <- print_string("\n");
        out: boolean <- case msg.step == 2 of {
            true -> true;
            false -> st.out
        };
        _: atom <- advance(msg.step)
    produces
        pure (:no_reply, next_state(msg.step, st.pass + 1, 7, st.ticks, out))
    end
}

fn other(st: { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) {
    (:no_reply, st)
}

fn step(msg: { step: uint32, level: boolean }, st: { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) -> (:no_reply, { pass: uint32, fail: uint32, ticks: uint32, out: boolean }) {
    case msg.step > 300 of {
        true -> other(st);
        false -> on_result(msg, st)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                c: actor_ref <- spawn({ pass: 0, fail: 0, ticks: 0, out: false }, step, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(c, { step: 1, level: false } impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
