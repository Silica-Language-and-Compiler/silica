// Board-pack device descriptions (silica_device_actor_specification.md §4.9 rule 5, §4.9.1): for each
// device tag the board pack describes, the name of the one module that is its description. The type
// checker asks this for every `impl fn registers(device: (:tag))` it validates: a tag listed here may
// be described only by the module named here (E2239); any other module, a program's or the pack's own
// for another tag, is rejected whatever its body says. A tag not listed is a programmer-described device.
//
// Every emit target carries its own copy at emitter/<TARGET>/pack_descriptions.silica with the same
// exported function; one compiler binary is built per TARGET, so the answer is always about its own
// board. This copy is the ESP32-S3_raw board pack: the modules board/tools/gen_board_pack.py writes
// into board/pack/ (its DEVICE_TAGS table; when a peripheral is added there, add its row here). Board
// windows the pack has no generated description for yet (board_pack@window_tag: rtc_cntl, timg0,
// timg1, systimer) are not listed, so a program may still describe them.
//
// The tag is the atom with its colon, as board_pack@window_tag spells it (":esp32s3_uart").

export description_module_for_tag/1;

fn description_module_for_tag(tag: string) -> string {
    case tag of {
        ":esp32s3_gpio" -> "device_esp32s3_gpio_registers";
        ":esp32s3_io_mux" -> "device_esp32s3_io_mux_registers";
        ":esp32s3_uart" -> "device_esp32s3_uart_registers";
        ":esp32s3_spi2" -> "device_esp32s3_spi2_registers";
        ":esp32s3_system" -> "device_esp32s3_system_registers";
        ":esp32s3_rmt" -> "device_esp32s3_rmt_registers";
        ":esp32s3_ledc" -> "device_esp32s3_ledc_registers";
        ":esp32s3_usb_serial_jtag" -> "device_esp32s3_usb_serial_jtag_registers";
        _: string -> ""
    }
}
