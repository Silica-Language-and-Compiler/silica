# The eBadge: an ESP32-S3 with 4 MB of flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# A blocked scheduler wakes at the next tick to poll timers and device registers: 1 ms.
CONFIG_FREERTOS_HZ=1000
# Silica runs on stacks of its own, outside its tasks' stacks, and arms both data breakpoints as its
# stack guards: only the canary check is valid for its tasks.
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=n
# The console is the Silica program's standard output between its two markers: ESP-IDF says nothing
# there unless something is wrong.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# The USB Serial/JTAG controller is a Silica device (device_esp32s3_usb_serial_jtag): ESP-IDF keeps its
# clock on and does not write its own console to it.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# The Bluetooth controller with no Bluetooth host: the Silica program speaks HCI to it.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=y
