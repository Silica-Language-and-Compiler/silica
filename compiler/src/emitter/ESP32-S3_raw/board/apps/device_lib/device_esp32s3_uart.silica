// UART0 (the ROM console, 115200 8N1 after reset) as a device worker: board_pack.silica window 0
// at 0x60000000, registers :fifo and :status (TXFIFO_CNT is bits 16-25 of :status; the runtime
// console keeps at most 120 bytes queued, board_pack uart_txfifo_max). The device specification's
// own worked example is this device (spec §4.7, §4.9).
//
// State: `:unmapped` until the :init message maps the window inside a register_rwr sequence, then
// (:mapped, window). Messages: { op: :init | :putc | :puts | :notify, byte: uint32, text: string,
// reply_to: actor_ref }. :puts walks the text one character at a time; a character's byte comes from
// a flat table, since a string has no byte accessor -- only the characters the apps print are
// listed. :notify casts `byte` to reply_to: the worker handles its mailbox in order, so the reply
// tells an app that everything it sent before has been written (an app ends itself with it).

use device_esp32s3_uart_registers;
use board_pack;
use board_pack_uart0_values;

export uart_worker/2;

fn byte_of(ch: string) -> uint32 {
    case ch of {
        " " -> 32; "\n" -> 10; "a" -> 97; "b" -> 98; "c" -> 99; "d" -> 100; "e" -> 101; "f" -> 102;
        "g" -> 103; "h" -> 104; "i" -> 105; "j" -> 106; "k" -> 107; "l" -> 108; "m" -> 109; "n" -> 110;
        "o" -> 111; "p" -> 112; "q" -> 113; "r" -> 114; "s" -> 115; "t" -> 116; "u" -> 117; "v" -> 118;
        "w" -> 119; "x" -> 120; "y" -> 121; "z" -> 122; "0" -> 48; "1" -> 49; "2" -> 50; "3" -> 51;
        "4" -> 52; "5" -> 53; "6" -> 54; "7" -> 55; "8" -> 56; "9" -> 57; "." -> 46; ":" -> 58;
        _: string -> 63
    }
}

// Waits until the transmit FIFO has room, then queues the byte. The poll is a read whose value
// matters, one peek per turn (spec §4.7 "Reads are never removed").
fn put_byte(w: device_window(L, (:esp32s3_uart)), byte: uint32) -> device_window(L, (:esp32s3_uart)) {
    sequence proc[register_rwr]
        status: uint32 <- peek(w, :status) impl Register32 {};
        cnt_shift: uint32 <- board_pack_uart0_values@uart0_txfifo_cnt_shift();
        cnt_mask: uint32 <- board_pack_uart0_values@uart0_txfifo_cnt_mask();
        fifo_max: uint32 <- board_pack@uart_txfifo_max();
        queued: uint32 <- (status band cnt_mask) shr cnt_shift;
        r: device_window(L, (:esp32s3_uart)) <- case queued < fifo_max of {
            true -> {
                _: atom <- poke(w, :fifo, byte impl Register32 {});
                w
            };
            false -> put_byte(w, byte)
        }
    produces
        pure r
    end
}

fn put_text(w: device_window(L, (:esp32s3_uart)), text: string, i: int64) -> device_window(L, (:esp32s3_uart)) {
    sequence proc[register_rwr]
        r: device_window(L, (:esp32s3_uart)) <- case i >= length_bytes(text) of {
            true -> w;
            false -> put_text(put_byte(w, byte_of(substring(text, i, i + 1))), text, i + 1)
        }
    produces
        pure r
    end
}

// Casts `value` to `reply_to` (:notify).
fn notify(w: device_window(L, (:esp32s3_uart)), reply_to: actor_ref, value: uint32) -> device_window(L, (:esp32s3_uart)) {
    sequence proc[concurrency]
        _: boolean <- cast(reply_to, value impl ActorMessage {})
    produces
        pure w
    end
}

fn uart_worker(msg: { op: atom, byte: uint32, text: string, reply_to: actor_ref }, state: :unmapped | (:mapped, device_window(L, (:esp32s3_uart)))) -> (:no_reply, :unmapped | (:mapped, device_window(L, (:esp32s3_uart)))) {
    sequence proc[register_rwr]
        next: :unmapped | (:mapped, device_window(L, (:esp32s3_uart))) <- case state of {
            :unmapped -> case msg.op of {
                :init -> {
                    w: device_window(L, (:esp32s3_uart)) <- map_device((:esp32s3_uart), 0x60000000); // board_pack window 0
                    (:mapped, w)
                };
                _: atom -> :unmapped
            };
            (:mapped, w: device_window(L, (:esp32s3_uart))) -> case msg.op of {
                :putc -> (:mapped, put_byte(w, msg.byte));
                :puts -> (:mapped, put_text(w, msg.text, 0));
                :notify -> (:mapped, notify(w, msg.reply_to, msg.byte));
                _: atom -> (:mapped, w)
            }
        }
    produces
        pure (:no_reply, next)
    end
}
