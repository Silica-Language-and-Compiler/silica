// GPIO on the ESP32-S3 port test board as a device worker (silica_device_actor_specification.md).
// The worker owns two windows, the GPIO matrix at 0x60004000 and the IO_MUX at 0x60009000
// (board_pack.silica windows 1 and 3): both are needed to make a pad an output or a pulled-up
// input, and two workers must not share a controller (spec §5.1). Only the pins the board wires
// are described: 0 (Point/BOOT, display CS), 1 (display RST), 2/4/5 (RGB), 3 (display SDA), 6 (LED),
// 7 (addressable LED data), 8/9/12..18 (pin-hunt candidates: output only), 21 (Left button),
// 10/11/47 (Right/Up/Down), 33/34 (B/A) (those five pull-up input only), 45 (display D/C),
// 46 (display SCL), 48 (buzzer). Outputs (:output) are 0..9, 12..18, 21, 45, 46 and 48; inputs
// (:input_pullup) are 0, 10, 11, 21, 33, 34 and 47 as well as the outputs; :input_buffer is for
// 1, 2, 4..7, 21 and 48; :peek names pins 6 and 21 only.
// Register names, offsets and field values are board_pack.silica's (rows 2-15, 22 and the
// io_mux_* / gpio_* constants).
//
// State: `:unmapped` until the first message; the `:init` message maps both windows inside a
// register_rwr sequence (spec §4.3: nothing maps at the spawn site) and the state becomes
// (:mapped, gpio, mux). Windows never leave the worker: helpers that touch registers take the window
// and return it, so the move-only handle stays owned here (spec §4.7 "No move", §5.1).
//
// Messages: { op: :init | :output | :input_pullup | :input_buffer | :write | :read | :peek | :route_oen | :hold | :watch | :watch_all | :square | :notify, pin: uint32,
// level: uint32, reply_to: actor_ref }. :read casts the pad level (0 or 1, uint32) to reply_to.
// :input_buffer sets FUN_IE on the pad so GPIO_IN follows an output pin. :peek casts a raw register word
// to reply_to: level 0 is IO_MUX GPIOn, 1..8 pick a GPIO matrix register (see peek_gpio).
// :route_oen writes FUNCn_OUT_SEL_CFG = OEN_SEL | `level` (route_signal; level 256 is GPIO_OUT).
// :watch polls the four direction buttons `level` rounds of about half a second, the LED (GPIO6) high
// while any is pressed (silica_20). :watch_all reads all seven buttons once per round (one peek of
// GPIO_IN, one of GPIO_IN1) for 3000 rounds about 10 ms apart (silica_25); the mask is 7 bits, bit 0 Left
// (21), 1 Right (10), 2 Down (47), 3 Up (11), 4 Point (0), 5 A (34), 6 B (33). It casts the mask to
// reply_to once at the start (the idle state) and again each time it changes, lights the LED (GPIO6)
// while the mask differs from the idle mask, then turns the LED off and casts 128 ("done"). The buttons
// must already be :input_pullup and the LED :output; `pin` and `level` are ignored. :square drives a 440 Hz square wave for 4 s on many pads at once:
// `pin` is the bank-0 pin mask (bit n = GPIOn, pins 0..31) and `level` the bank-1 mask (bit n = GPIO32+n),
// both pads already made outputs by :output; each edge is one poke of out_w1ts / out1_w1ts (high) or
// out_w1tc / out1_w1tc (low) with the masks, then a busy-wait of half a period (1136 us, 454 spins
// at about 2.5 us each, calibrated on :hold's one-tick = 400 spins = roughly 1 ms), 3520 edges in all,
// ending low (silica_28). :hold busy-waits `level` ticks in message order (one tick is spin(400), roughly a millisecond at
// the 40 MHz hand-off clock; there is no delay builtin). :notify casts `level` to reply_to, so an
// app can print in the worker's order. Pins 0..31 use the bank-0 registers, 32..48 the bank-1 ones;
// per-pin registers are chosen by a flat case on the pin, since a register name must be an atom
// literal (spec §4.7). route_signal puts a peripheral output (an SPI clock, say) on a pad through
// the GPIO matrix for a worker that owns both this window and the peripheral's.

use device_esp32s3_gpio_registers;
use device_esp32s3_io_mux_registers;
use board_pack;
use board_pack_gpio_values;
use board_pack_io_mux_values;

export gpio_worker/2;
export make_output/3;
export write_level/3;
export route_signal/3;

fn pin_mask(pin: uint32) -> uint32 {
    one: uint32 <- 1;
    one shl (pin band 31)
}

fn in_bank1(pin: uint32) -> boolean {
    pin >= 32
}

fn spin(n: int64) -> int64 {
    case n == 0 of { true -> 0; false -> spin(n - 1) }
}

fn hold_ticks(n: uint32) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            _: int64 <- spin(400);
            hold_ticks(n - 1)
        }
    }
}

// GPIO_OUT bit for the pin: set (level != 0) or clear, in the pin's bank.
fn write_level(g: device_window(L, (:esp32s3_gpio)), pin: uint32, level: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        m: uint32 <- pin_mask(pin);
        _: atom <- case in_bank1(pin) of {
            false -> case level == 0 of {
                true -> poke(g, :out_w1tc, m impl Register32 {});
                false -> poke(g, :out_w1ts, m impl Register32 {})
            };
            true -> case level == 0 of {
                true -> poke(g, :out1_w1tc, m impl Register32 {});
                false -> poke(g, :out1_w1ts, m impl Register32 {})
            }
        }
    produces
        pure g
    end
}

fn enable_output(g: device_window(L, (:esp32s3_gpio)), pin: uint32, enable: boolean) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        m: uint32 <- pin_mask(pin);
        _: atom <- case in_bank1(pin) of {
            false -> case enable of {
                true -> poke(g, :enable_w1ts, m impl Register32 {});
                false -> poke(g, :enable_w1tc, m impl Register32 {})
            };
            true -> case enable of {
                true -> poke(g, :enable1_w1ts, m impl Register32 {});
                false -> poke(g, :enable1_w1tc, m impl Register32 {})
            }
        }
    produces
        pure g
    end
}

// FUNCn_OUT_SEL_CFG: OUT_SEL (bits 0-8) is 256 for GPIO_OUT (board_pack gpio_sig_out_idx) or a
// peripheral output signal's index (ESP-IDF gpio_sig_map.h); OEN_SEL (bit 10) keeps the output
// enable on GPIO_ENABLE for a routed signal. Field positions from ESP-IDF v5.1 gpio_reg.h
// (GPIO_FUNC3_OUT_SEL_S 0, GPIO_FUNC3_OEN_SEL_S 10), TRM-unconfirmed.
fn route(g: device_window(L, (:esp32s3_gpio)), pin: uint32, sel: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        _: atom <- case pin of {
            0 -> poke(g, :func0_out_sel_cfg, sel impl Register32 {});
            1 -> poke(g, :func1_out_sel_cfg, sel impl Register32 {});
            2 -> poke(g, :func2_out_sel_cfg, sel impl Register32 {});
            3 -> poke(g, :func3_out_sel_cfg, sel impl Register32 {});
            4 -> poke(g, :func4_out_sel_cfg, sel impl Register32 {});
            5 -> poke(g, :func5_out_sel_cfg, sel impl Register32 {});
            6 -> poke(g, :func6_out_sel_cfg, sel impl Register32 {});
            7 -> poke(g, :func7_out_sel_cfg, sel impl Register32 {});
            8 -> poke(g, :func8_out_sel_cfg, sel impl Register32 {});
            9 -> poke(g, :func9_out_sel_cfg, sel impl Register32 {});
            12 -> poke(g, :func12_out_sel_cfg, sel impl Register32 {});
            13 -> poke(g, :func13_out_sel_cfg, sel impl Register32 {});
            14 -> poke(g, :func14_out_sel_cfg, sel impl Register32 {});
            15 -> poke(g, :func15_out_sel_cfg, sel impl Register32 {});
            16 -> poke(g, :func16_out_sel_cfg, sel impl Register32 {});
            17 -> poke(g, :func17_out_sel_cfg, sel impl Register32 {});
            18 -> poke(g, :func18_out_sel_cfg, sel impl Register32 {});
            21 -> poke(g, :func21_out_sel_cfg, sel impl Register32 {});
            45 -> poke(g, :func45_out_sel_cfg, sel impl Register32 {});
            46 -> poke(g, :func46_out_sel_cfg, sel impl Register32 {});
            48 -> poke(g, :func48_out_sel_cfg, sel impl Register32 {});
            _: uint32 -> :ok
        }
    produces
        pure g
    end
}

fn route_output(g: device_window(L, (:esp32s3_gpio)), pin: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        gpio_out: uint32 <- board_pack@gpio_sig_out_idx();
        r: device_window(L, (:esp32s3_gpio)) <- route(g, pin, gpio_out)
    produces
        pure r
    end
}

// A peripheral output signal on a pad that make_output has already made an output.
fn route_signal(g: device_window(L, (:esp32s3_gpio)), pin: uint32, signal: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        oen_from_enable: uint32 <- board_pack_gpio_values@gpio_func_oen_sel_mask();
        r: device_window(L, (:esp32s3_gpio)) <- route(g, pin, oen_from_enable bor signal)
    produces
        pure r
    end
}

// Bit 2 of GPIO_PINn is open drain; push-pull clears it (board_pack gpio_pin_open_drain_bit).
fn push_pull(g: device_window(L, (:esp32s3_gpio)), pin: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        open_drain: uint32 <- board_pack@gpio_pin_open_drain_bit();
        keep: uint32 <- bnot open_drain;
        _: atom <- case pin of {
            0 -> { v: uint32 <- peek(g, :pin0) impl Register32 {}; poke(g, :pin0, (v band keep) impl Register32 {}) };
            1 -> { v: uint32 <- peek(g, :pin1) impl Register32 {}; poke(g, :pin1, (v band keep) impl Register32 {}) };
            2 -> { v: uint32 <- peek(g, :pin2) impl Register32 {}; poke(g, :pin2, (v band keep) impl Register32 {}) };
            3 -> { v: uint32 <- peek(g, :pin3) impl Register32 {}; poke(g, :pin3, (v band keep) impl Register32 {}) };
            4 -> { v: uint32 <- peek(g, :pin4) impl Register32 {}; poke(g, :pin4, (v band keep) impl Register32 {}) };
            5 -> { v: uint32 <- peek(g, :pin5) impl Register32 {}; poke(g, :pin5, (v band keep) impl Register32 {}) };
            6 -> { v: uint32 <- peek(g, :pin6) impl Register32 {}; poke(g, :pin6, (v band keep) impl Register32 {}) };
            7 -> { v: uint32 <- peek(g, :pin7) impl Register32 {}; poke(g, :pin7, (v band keep) impl Register32 {}) };
            8 -> { v: uint32 <- peek(g, :pin8) impl Register32 {}; poke(g, :pin8, (v band keep) impl Register32 {}) };
            9 -> { v: uint32 <- peek(g, :pin9) impl Register32 {}; poke(g, :pin9, (v band keep) impl Register32 {}) };
            12 -> { v: uint32 <- peek(g, :pin12) impl Register32 {}; poke(g, :pin12, (v band keep) impl Register32 {}) };
            13 -> { v: uint32 <- peek(g, :pin13) impl Register32 {}; poke(g, :pin13, (v band keep) impl Register32 {}) };
            14 -> { v: uint32 <- peek(g, :pin14) impl Register32 {}; poke(g, :pin14, (v band keep) impl Register32 {}) };
            15 -> { v: uint32 <- peek(g, :pin15) impl Register32 {}; poke(g, :pin15, (v band keep) impl Register32 {}) };
            16 -> { v: uint32 <- peek(g, :pin16) impl Register32 {}; poke(g, :pin16, (v band keep) impl Register32 {}) };
            17 -> { v: uint32 <- peek(g, :pin17) impl Register32 {}; poke(g, :pin17, (v band keep) impl Register32 {}) };
            18 -> { v: uint32 <- peek(g, :pin18) impl Register32 {}; poke(g, :pin18, (v band keep) impl Register32 {}) };
            21 -> { v: uint32 <- peek(g, :pin21) impl Register32 {}; poke(g, :pin21, (v band keep) impl Register32 {}) };
            45 -> { v: uint32 <- peek(g, :pin45) impl Register32 {}; poke(g, :pin45, (v band keep) impl Register32 {}) };
            46 -> { v: uint32 <- peek(g, :pin46) impl Register32 {}; poke(g, :pin46, (v band keep) impl Register32 {}) };
            48 -> { v: uint32 <- peek(g, :pin48) impl Register32 {}; poke(g, :pin48, (v band keep) impl Register32 {}) };
            _: uint32 -> :ok
        }
    produces
        pure g
    end
}

// IO_MUX pad: MCU_SEL = 1 (GPIO), drive strength 2, no pulls, for an output; MCU_SEL = 1 with the
// input buffer and the pull-up for an input. Values from board_pack's io_mux_* constants.
fn mux_config(m: device_window(L, (:esp32s3_io_mux)), pin: uint32, as_input: boolean) -> device_window(L, (:esp32s3_io_mux)) {
    sequence proc[register_rwr]
        mcu_sel_mask: uint32 <- board_pack_io_mux_values@io_mux_mcu_sel_mask();
        drv_mask: uint32 <- board_pack_io_mux_values@io_mux_fun_drv_mask();
        pu_mask: uint32 <- board_pack_io_mux_values@io_mux_fun_pu_mask();
        pd_mask: uint32 <- board_pack_io_mux_values@io_mux_fun_pd_mask();
        ie_mask: uint32 <- board_pack_io_mux_values@io_mux_fun_ie_mask();
        mcu_gpio: uint32 <- board_pack@io_mux_mcu_sel_gpio();
        drv_20ma: uint32 <- board_pack@io_mux_fun_drv_20ma();
        clear: uint32 <- bnot (mcu_sel_mask bor drv_mask bor pu_mask bor pd_mask);
        set_out: uint32 <- mcu_gpio bor drv_20ma;
        set_in: uint32 <- mcu_gpio bor ie_mask bor pu_mask;
        set_bits: uint32 <- case as_input of { true -> set_in; false -> set_out };
        _: atom <- case pin of {
            0 -> { v: uint32 <- peek(m, :gpio0) impl Register32 {}; poke(m, :gpio0, ((v band clear) bor set_bits) impl Register32 {}) };
            1 -> { v: uint32 <- peek(m, :gpio1) impl Register32 {}; poke(m, :gpio1, ((v band clear) bor set_bits) impl Register32 {}) };
            2 -> { v: uint32 <- peek(m, :gpio2) impl Register32 {}; poke(m, :gpio2, ((v band clear) bor set_bits) impl Register32 {}) };
            3 -> { v: uint32 <- peek(m, :gpio3) impl Register32 {}; poke(m, :gpio3, ((v band clear) bor set_bits) impl Register32 {}) };
            4 -> { v: uint32 <- peek(m, :gpio4) impl Register32 {}; poke(m, :gpio4, ((v band clear) bor set_bits) impl Register32 {}) };
            5 -> { v: uint32 <- peek(m, :gpio5) impl Register32 {}; poke(m, :gpio5, ((v band clear) bor set_bits) impl Register32 {}) };
            6 -> { v: uint32 <- peek(m, :gpio6) impl Register32 {}; poke(m, :gpio6, ((v band clear) bor set_bits) impl Register32 {}) };
            7 -> { v: uint32 <- peek(m, :gpio7) impl Register32 {}; poke(m, :gpio7, ((v band clear) bor set_bits) impl Register32 {}) };
            10 -> { v: uint32 <- peek(m, :gpio10) impl Register32 {}; poke(m, :gpio10, ((v band clear) bor set_bits) impl Register32 {}) };
            11 -> { v: uint32 <- peek(m, :gpio11) impl Register32 {}; poke(m, :gpio11, ((v band clear) bor set_bits) impl Register32 {}) };
            8 -> { v: uint32 <- peek(m, :gpio8) impl Register32 {}; poke(m, :gpio8, ((v band clear) bor set_bits) impl Register32 {}) };
            9 -> { v: uint32 <- peek(m, :gpio9) impl Register32 {}; poke(m, :gpio9, ((v band clear) bor set_bits) impl Register32 {}) };
            12 -> { v: uint32 <- peek(m, :gpio12) impl Register32 {}; poke(m, :gpio12, ((v band clear) bor set_bits) impl Register32 {}) };
            13 -> { v: uint32 <- peek(m, :gpio13) impl Register32 {}; poke(m, :gpio13, ((v band clear) bor set_bits) impl Register32 {}) };
            14 -> { v: uint32 <- peek(m, :gpio14) impl Register32 {}; poke(m, :gpio14, ((v band clear) bor set_bits) impl Register32 {}) };
            15 -> { v: uint32 <- peek(m, :gpio15) impl Register32 {}; poke(m, :gpio15, ((v band clear) bor set_bits) impl Register32 {}) };
            16 -> { v: uint32 <- peek(m, :gpio16) impl Register32 {}; poke(m, :gpio16, ((v band clear) bor set_bits) impl Register32 {}) };
            17 -> { v: uint32 <- peek(m, :gpio17) impl Register32 {}; poke(m, :gpio17, ((v band clear) bor set_bits) impl Register32 {}) };
            18 -> { v: uint32 <- peek(m, :gpio18) impl Register32 {}; poke(m, :gpio18, ((v band clear) bor set_bits) impl Register32 {}) };
            21 -> { v: uint32 <- peek(m, :gpio21) impl Register32 {}; poke(m, :gpio21, ((v band clear) bor set_bits) impl Register32 {}) };
            33 -> { v: uint32 <- peek(m, :gpio33) impl Register32 {}; poke(m, :gpio33, ((v band clear) bor set_bits) impl Register32 {}) };
            34 -> { v: uint32 <- peek(m, :gpio34) impl Register32 {}; poke(m, :gpio34, ((v band clear) bor set_bits) impl Register32 {}) };
            45 -> { v: uint32 <- peek(m, :gpio45) impl Register32 {}; poke(m, :gpio45, ((v band clear) bor set_bits) impl Register32 {}) };
            46 -> { v: uint32 <- peek(m, :gpio46) impl Register32 {}; poke(m, :gpio46, ((v band clear) bor set_bits) impl Register32 {}) };
            47 -> { v: uint32 <- peek(m, :gpio47) impl Register32 {}; poke(m, :gpio47, ((v band clear) bor set_bits) impl Register32 {}) };
            48 -> { v: uint32 <- peek(m, :gpio48) impl Register32 {}; poke(m, :gpio48, ((v band clear) bor set_bits) impl Register32 {}) };
            _: uint32 -> :ok
        }
    produces
        pure m
    end
}

// FUN_IE (the pad's input buffer) on a pin that make_output configured: mux_config leaves it as it
// found it for an output, so GPIO_IN does not follow an output pad until this runs.
fn mux_input_buffer(m: device_window(L, (:esp32s3_io_mux)), pin: uint32) -> device_window(L, (:esp32s3_io_mux)) {
    sequence proc[register_rwr]
        ie_mask: uint32 <- board_pack_io_mux_values@io_mux_fun_ie_mask();
        _: atom <- case pin of {
            1 -> { v: uint32 <- peek(m, :gpio1) impl Register32 {}; poke(m, :gpio1, (v bor ie_mask) impl Register32 {}) };
            2 -> { v: uint32 <- peek(m, :gpio2) impl Register32 {}; poke(m, :gpio2, (v bor ie_mask) impl Register32 {}) };
            4 -> { v: uint32 <- peek(m, :gpio4) impl Register32 {}; poke(m, :gpio4, (v bor ie_mask) impl Register32 {}) };
            5 -> { v: uint32 <- peek(m, :gpio5) impl Register32 {}; poke(m, :gpio5, (v bor ie_mask) impl Register32 {}) };
            6 -> { v: uint32 <- peek(m, :gpio6) impl Register32 {}; poke(m, :gpio6, (v bor ie_mask) impl Register32 {}) };
            7 -> { v: uint32 <- peek(m, :gpio7) impl Register32 {}; poke(m, :gpio7, (v bor ie_mask) impl Register32 {}) };
            21 -> { v: uint32 <- peek(m, :gpio21) impl Register32 {}; poke(m, :gpio21, (v bor ie_mask) impl Register32 {}) };
            48 -> { v: uint32 <- peek(m, :gpio48) impl Register32 {}; poke(m, :gpio48, (v bor ie_mask) impl Register32 {}) };
            _: uint32 -> :ok
        }
    produces
        pure m
    end
}

// :peek, IO_MUX side: the pad register of the pin (6 and 21 are described here).
fn peek_pad(m: device_window(L, (:esp32s3_io_mux)), pin: uint32) -> (device_window(L, (:esp32s3_io_mux)), uint32) {
    sequence proc[register_rwr]
        word: uint32 <- case pin of {
            6 -> peek(m, :gpio6) impl Register32 {};
            21 -> peek(m, :gpio21) impl Register32 {};
            _: uint32 -> 0
        }
    produces
        pure (m, word)
    end
}

// :peek, GPIO matrix side. `level` names the register: 1 FUNCn_OUT_SEL_CFG and 2 GPIO_PINn (both
// per pin; 6 and 21 are described here), 3 GPIO_ENABLE, 4 GPIO_OUT, 5 GPIO_IN, 6 GPIO_ENABLE1,
// 7 GPIO_OUT1, 8 GPIO_IN1. Any other code reads 0.
fn peek_gpio(g: device_window(L, (:esp32s3_gpio)), pin: uint32, which: uint32) -> (device_window(L, (:esp32s3_gpio)), uint32) {
    sequence proc[register_rwr]
        word: uint32 <- case which of {
            1 -> case pin of {
                6 -> peek(g, :func6_out_sel_cfg) impl Register32 {};
                21 -> peek(g, :func21_out_sel_cfg) impl Register32 {};
                _: uint32 -> 0
            };
            2 -> case pin of {
                6 -> peek(g, :pin6) impl Register32 {};
                21 -> peek(g, :pin21) impl Register32 {};
                _: uint32 -> 0
            };
            3 -> peek(g, :enable) impl Register32 {};
            4 -> peek(g, :out) impl Register32 {};
            5 -> peek(g, :in) impl Register32 {};
            6 -> peek(g, :enable1) impl Register32 {};
            7 -> peek(g, :out1) impl Register32 {};
            8 -> peek(g, :in1) impl Register32 {};
            _: uint32 -> 0
        }
    produces
        pure (g, word)
    end
}

fn read_level(g: device_window(L, (:esp32s3_gpio)), pin: uint32) -> (device_window(L, (:esp32s3_gpio)), uint32) {
    sequence proc[register_rwr]
        word: uint32 <- case in_bank1(pin) of {
            false -> peek(g, :in) impl Register32 {};
            true -> peek(g, :in1) impl Register32 {}
        };
        one: uint32 <- 1;
        level: uint32 <- (word shr (pin band 31)) band one
    produces
        pure (g, level)
    end
}

// One poll of Left (21), Right (10), Down (47) and Up (11): the LED (GPIO6) is high while any of them
// is pressed (board_pack: these buttons idle low).
// The pads are read straight from GPIO_IN / GPIO_IN1 (GPIO47 is bit 15 of IN1) so a poll allocates nothing.
fn poll_buttons_once(g: device_window(L, (:esp32s3_gpio))) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        low: uint32 <- peek(g, :in) impl Register32 {};
        high: uint32 <- peek(g, :in1) impl Register32 {};
        one: uint32 <- 1;
        bank: uint32 <- 31;
        left: uint32 <- board_pack@button_pin(0);
        right: uint32 <- board_pack@button_pin(1);
        down: uint32 <- board_pack@button_pin(2);
        up: uint32 <- board_pack@button_pin(3);
        led: uint32 <- board_pack@pin_led();
        any: uint32 <- ((low shr left) bor (low shr right) bor (low shr up) bor (high shr (down band bank))) band one;
        g1: device_window(L, (:esp32s3_gpio)) <- write_level(g, led, any)
    produces
        pure g1
    end
}

// n polls about 10 ms apart. The recursion is not in tail position inside the sequence, so callers keep n small.
fn watch_buttons_inner(g: device_window(L, (:esp32s3_gpio)), n: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        r: device_window(L, (:esp32s3_gpio)) <- case n == 0 of {
            true -> g;
            false -> {
                g1: device_window(L, (:esp32s3_gpio)) <- poll_buttons_once(g);
                _: int64 <- hold_ticks(10);
                watch_buttons_inner(g1, n - 1)
            }
        }
    produces
        pure r
    end
}

// n rounds of 50 polls (about half a second each); the LED is left off at the end.
fn watch_buttons(g: device_window(L, (:esp32s3_gpio)), n: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        led: uint32 <- board_pack@pin_led();
        r: device_window(L, (:esp32s3_gpio)) <- case n == 0 of {
            true -> write_level(g, led, 0);
            false -> {
                g1: device_window(L, (:esp32s3_gpio)) <- watch_buttons_inner(g, 50);
                watch_buttons(g1, n - 1)
            }
        }
    produces
        pure r
    end
}

// One 440 Hz cycle on every pad in the masks at once: a high edge (out_w1ts / out1_w1ts), half a period,
// a low edge (out_w1tc / out1_w1tc), half a period. 1136 us is 454 spins (spin(400) is about 1 ms).
fn square_cycle(g: device_window(L, (:esp32s3_gpio)), m0: uint32, m1: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        _: atom <- poke(g, :out_w1ts, m0 impl Register32 {});
        _: atom <- poke(g, :out1_w1ts, m1 impl Register32 {});
        _: int64 <- spin(454);
        _: atom <- poke(g, :out_w1tc, m0 impl Register32 {});
        _: atom <- poke(g, :out1_w1tc, m1 impl Register32 {});
        _: int64 <- spin(454)
    produces
        pure g
    end
}

// n cycles. The recursion is not in tail position inside the sequence, so callers keep n small.
fn square_cycles(g: device_window(L, (:esp32s3_gpio)), m0: uint32, m1: uint32, n: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        r: device_window(L, (:esp32s3_gpio)) <- case n == 0 of {
            true -> g;
            false -> {
                g1: device_window(L, (:esp32s3_gpio)) <- square_cycle(g, m0, m1);
                square_cycles(g1, m0, m1, n - 1)
            }
        }
    produces
        pure r
    end
}

// rounds of 44 cycles: 40 rounds are 1760 cycles, 3520 edges, 4 s at 440 Hz.
fn square_wave(g: device_window(L, (:esp32s3_gpio)), m0: uint32, m1: uint32, rounds: uint32) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        r: device_window(L, (:esp32s3_gpio)) <- case rounds == 0 of {
            true -> g;
            false -> {
                g1: device_window(L, (:esp32s3_gpio)) <- square_cycles(g, m0, m1, 44);
                square_wave(g1, m0, m1, rounds - 1)
            }
        }
    produces
        pure r
    end
}

// All seven buttons as a 7-bit mask (bit i = button i of :watch_all's order), from one peek of GPIO_IN
// (pins 21, 10, 11, 0) and one of GPIO_IN1 (47, 34, 33 are bits 15, 2, 1).
fn read_buttons(g: device_window(L, (:esp32s3_gpio))) -> (device_window(L, (:esp32s3_gpio)), uint32) {
    sequence proc[register_rwr]
        low: uint32 <- peek(g, :in) impl Register32 {};
        high: uint32 <- peek(g, :in1) impl Register32 {};
        one: uint32 <- 1;
        left: uint32 <- (low shr 21) band one;
        right: uint32 <- (low shr 10) band one;
        down: uint32 <- (high shr 15) band one;
        up: uint32 <- (low shr 11) band one;
        point: uint32 <- low band one;
        a: uint32 <- (high shr 2) band one;
        b: uint32 <- (high shr 1) band one;
        mask: uint32 <- left bor (right shl 1) bor (down shl 2) bor (up shl 3) bor (point shl 4) bor (a shl 5) bor (b shl 6)
    produces
        pure (g, mask)
    end
}

// One round: read the mask; if it differs from the last one, cast it and set the LED (lit while the
// mask differs from the idle mask). Returns the mask just read.
fn poll_all(g: device_window(L, (:esp32s3_gpio)), idle: uint32, prev: uint32, reply: actor_ref) -> (device_window(L, (:esp32s3_gpio)), uint32) {
    sequence proc[register_rwr, concurrency]
        (g1, mask) <- read_buttons(g);
        led: uint32 <- board_pack@pin_led();
        g2: device_window(L, (:esp32s3_gpio)) <- case mask == prev of {
            true -> g1;
            false -> {
                lit: uint32 <- case mask != idle of { true -> 1; false -> 0 };
                _: boolean <- cast(reply, mask impl ActorMessage {});
                write_level(g1, led, lit)
            }
        }
    produces
        pure (g2, mask)
    end
}

// n rounds about 10 ms apart. The recursion is not in tail position, so callers keep n small.
fn watch_all_inner(g: device_window(L, (:esp32s3_gpio)), idle: uint32, prev: uint32, n: uint32, reply: actor_ref) -> (device_window(L, (:esp32s3_gpio)), uint32) {
    sequence proc[register_rwr]
        r: (device_window(L, (:esp32s3_gpio)), uint32) <- case n == 0 of {
            true -> (g, prev);
            false -> {
                (g1, p1) <- poll_all(g, idle, prev, reply);
                _: int64 <- hold_ticks(10);
                watch_all_inner(g1, idle, p1, n - 1, reply)
            }
        }
    produces
        pure r
    end
}

// n blocks of 50 rounds.
fn watch_all_rounds(g: device_window(L, (:esp32s3_gpio)), idle: uint32, prev: uint32, n: uint32, reply: actor_ref) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        r: device_window(L, (:esp32s3_gpio)) <- case n == 0 of {
            true -> g;
            false -> {
                (g1, p1) <- watch_all_inner(g, idle, prev, 50, reply);
                watch_all_rounds(g1, idle, p1, n - 1, reply)
            }
        }
    produces
        pure r
    end
}

// :watch_all: the idle mask, 60 blocks of 50 rounds (3000 rounds, about 30 s), LED off, 128 for "done".
fn watch_all(g: device_window(L, (:esp32s3_gpio)), reply: actor_ref) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr, concurrency]
        (g1, idle) <- read_buttons(g);
        _: boolean <- cast(reply, idle impl ActorMessage {});
        g2: device_window(L, (:esp32s3_gpio)) <- watch_all_rounds(g1, idle, idle, 60, reply);
        led: uint32 <- board_pack@pin_led();
        g3: device_window(L, (:esp32s3_gpio)) <- write_level(g2, led, 0);
        fin: uint32 <- 128;
        _: boolean <- cast(reply, fin impl ActorMessage {})
    produces
        pure g3
    end
}

// A pad as a push-pull output driven low: the display and LED drivers share it.
fn make_output(g: device_window(L, (:esp32s3_gpio)), m: device_window(L, (:esp32s3_io_mux)), pin: uint32) -> (device_window(L, (:esp32s3_gpio)), device_window(L, (:esp32s3_io_mux))) {
    sequence proc[register_rwr]
        g1: device_window(L, (:esp32s3_gpio)) <- route_output(g, pin);
        g2: device_window(L, (:esp32s3_gpio)) <- push_pull(g1, pin);
        g3: device_window(L, (:esp32s3_gpio)) <- write_level(g2, pin, 0);
        g4: device_window(L, (:esp32s3_gpio)) <- enable_output(g3, pin, true);
        m1: device_window(L, (:esp32s3_io_mux)) <- mux_config(m, pin, false)
    produces
        pure (g4, m1)
    end
}

// One message, both windows in hand. Order for :output: route, push-pull, low, enable, then the pad.
fn serve(g: device_window(L, (:esp32s3_gpio)), m: device_window(L, (:esp32s3_io_mux)), msg: { op: atom, pin: uint32, level: uint32, reply_to: actor_ref }) -> (device_window(L, (:esp32s3_gpio)), device_window(L, (:esp32s3_io_mux))) {
    sequence proc[register_rwr, concurrency]
        r: (device_window(L, (:esp32s3_gpio)), device_window(L, (:esp32s3_io_mux))) <- case msg.op of {
            :output -> make_output(g, m, msg.pin);
            :input_pullup -> {
                g1: device_window(L, (:esp32s3_gpio)) <- enable_output(g, msg.pin, false);
                m1: device_window(L, (:esp32s3_io_mux)) <- mux_config(m, msg.pin, true);
                (g1, m1)
            };
            :write -> {
                g1: device_window(L, (:esp32s3_gpio)) <- write_level(g, msg.pin, msg.level);
                (g1, m)
            };
            :read -> {
                (g1, level) <- read_level(g, msg.pin);
                _: boolean <- cast(msg.reply_to, level impl ActorMessage {});
                (g1, m)
            };
            :input_buffer -> {
                m1: device_window(L, (:esp32s3_io_mux)) <- mux_input_buffer(m, msg.pin);
                (g, m1)
            };
            :peek -> case msg.level == 0 of {
                true -> {
                    (m1, word) <- peek_pad(m, msg.pin);
                    _: boolean <- cast(msg.reply_to, word impl ActorMessage {});
                    (g, m1)
                };
                false -> {
                    (g1, word) <- peek_gpio(g, msg.pin, msg.level);
                    _: boolean <- cast(msg.reply_to, word impl ActorMessage {});
                    (g1, m)
                }
            };
            :route_oen -> {
                g1: device_window(L, (:esp32s3_gpio)) <- route_signal(g, msg.pin, msg.level);
                (g1, m)
            };
            :hold -> {
                _: int64 <- hold_ticks(msg.level);
                (g, m)
            };
            :watch -> {
                g1: device_window(L, (:esp32s3_gpio)) <- watch_buttons(g, msg.level);
                (g1, m)
            };
            :watch_all -> {
                g1: device_window(L, (:esp32s3_gpio)) <- watch_all(g, msg.reply_to);
                (g1, m)
            };
            :square -> {
                g1: device_window(L, (:esp32s3_gpio)) <- square_wave(g, msg.pin, msg.level, 40);
                (g1, m)
            };
            :notify -> {
                level: uint32 <- msg.level;
                _: boolean <- cast(msg.reply_to, level impl ActorMessage {});
                (g, m)
            };
            _: atom -> (g, m)
        }
    produces
        pure r
    end
}

fn gpio_worker(msg: { op: atom, pin: uint32, level: uint32, reply_to: actor_ref }, state: :unmapped | (:mapped, device_window(L, (:esp32s3_gpio)), device_window(L, (:esp32s3_io_mux)))) -> (:no_reply, :unmapped | (:mapped, device_window(L, (:esp32s3_gpio)), device_window(L, (:esp32s3_io_mux)))) {
    sequence proc[register_rwr]
        next: :unmapped | (:mapped, device_window(L, (:esp32s3_gpio)), device_window(L, (:esp32s3_io_mux))) <- case state of {
            :unmapped -> case msg.op of {
                :init -> {
                    g: device_window(L, (:esp32s3_gpio)) <- map_device((:esp32s3_gpio), 0x60004000); // board_pack window 1
                    m: device_window(L, (:esp32s3_io_mux)) <- map_device((:esp32s3_io_mux), 0x60009000); // board_pack window 3
                    (:mapped, g, m)
                };
                _: atom -> :unmapped
            };
            (:mapped, g: device_window(L, (:esp32s3_gpio)), m: device_window(L, (:esp32s3_io_mux))) -> {
                (g1, m1) <- serve(g, m, msg);
                (:mapped, g1, m1)
            }
        }
    produces
        pure (:no_reply, next)
    end
}
