// ESP32-S3 port app 30: the Silica twin of asm_06_heap. Builds a 2000-element list by prepending
// 2000, 1999, ..., 1 (so the head is 1 and element i is i + 1), then walks it and sums it, as asm_06
// links 2000 heap nodes and walks them. asm_06's "zeroed and 8-byte aligned" and "heap used" checks
// look at the allocator itself and are not observable from Silica; here a wrong or lost node shows in
// the length, the sum or the end elements. Extends silica_09_lists (100 elements) to 2000.
// The sum walks by index (list_at, tail-recursive accumulator) rather than with a `[h, t]` match: on
// the board a 2000-element `[h, t]` walk exhausts the heap until chunk 15 phase 9 frees tail handles.
// length 2000; sum 1 + ... + 2000 = 2001000; list_at 0 = 1; list_at 1999 = 2000.
// Sums list_at(xs, i) for i in 0..n-1 onto acc.
fn sum_from(xs: List[int64, mem(normal)], i: int64, n: int64, acc: int64) -> int64 {
    sequence proc[mem(normal)]
        v: int64 <- case i == n of {
            true -> acc;
            false -> sum_from(xs, i + 1, n, acc + list_at[int64, mem(normal)](xs, i))
        }
    produces pure v end
}

// Builds [1, 2, ..., n] by prepending n, n-1, ..., 1 onto acc (n >= 1).
fn count_down(n: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        next: List[int64, mem(normal)] <- prepend[int64, mem(normal)](n, acc);
        r: List[int64, mem(normal)] <- case n == 1 of {
            true -> next;
            false -> count_down(n - 1, next)
        }
    produces pure r end
}

fn main() -> atom {
    sequence proc[mem(normal), device_io]
        none: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        long: List[int64, mem(normal)] <- count_down(2000, none);
        p1: atom <- print_int64(length[int64, mem(normal)](long));
        println();
        p2: atom <- print_int64(sum_from(long, 0, length[int64, mem(normal)](long), 0));
        println();
        p3: atom <- print_int64(list_at[int64, mem(normal)](long, 0));
        println();
        p4: atom <- print_int64(list_at[int64, mem(normal)](long, 1999));
        println()
    produces pure :ok end
}
