// ESP32-S3 port app 21: the row of 24 addressable LEDs (GPIO7) through the WS2813B device worker
// (device_lib/device_ws2813b), which streams each frame from RMT transmit channel 0 where
// asm_11_addressable_leds bit-banged it. Every step is announced on the console in the worker's
// order (:notify) before the row changes: all LEDs dim white for about a second, all off for a
// second, then LED 0..23 lit one at a time for about 150 ms each with the previous one off, then
// all red, all green, all blue for a second each, then off. Brightness stays at 0x18 per channel
// (asm_11's current budget for the 5 V rail). Expected console: "white", "off", "chase", "red",
// "green", "blue", "off", "done", status 0.
// main starts the app's supervisor and casts its one worker (app_worker) the work; the announcer
// ends the program with cast_exit(0) after "done".
use device_ws2813b;
use Supervisor;

fn step_name(code: uint32) -> string {
    case code of {
        1 -> "white";
        2 -> "off";
        3 -> "chase";
        4 -> "red";
        5 -> "green";
        6 -> "blue";
        7 -> "done";
        _: uint32 -> "?"
    }
}

fn announcer(code: uint32, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        println(step_name(code));
        // "done" is the last step: the app ends here (§15.1.2.5)
        _: boolean <- case code == 7 of { true -> cast_exit(0); false -> false }
    produces
        pure (:no_reply, state)
    end
}

// A whole-row step: announce, set every LED, show, hold.
fn row_step(w: device_actor_ref, a: actor_ref, code: uint32, colour: uint32, hold: int64) -> boolean {
    sequence proc[concurrency]
        _: boolean <- cast_device(w, { op: :notify, index: 0, colour: code, reply_to: a } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :set_all, index: 0, colour: colour, reply_to: a } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :show, index: 0, colour: 0, reply_to: a } impl ActorMessage {});
        sent: boolean <- cast_device(w, { op: :hold, index: hold, colour: 0, reply_to: a } impl ActorMessage {})
    produces
        pure sent
    end
}

// LEDs i..23 one at a time: lit, shown, held, then off again before the next.
fn chase(w: device_actor_ref, a: actor_ref, i: int64, colour: uint32, hold: int64) -> boolean {
    sequence proc[concurrency]
        sent: boolean <- case i >= 24 of {
            true -> true;
            false -> {
                _: boolean <- cast_device(w, { op: :set, index: i, colour: colour, reply_to: a } impl ActorMessage {});
                _: boolean <- cast_device(w, { op: :show, index: 0, colour: 0, reply_to: a } impl ActorMessage {});
                _: boolean <- cast_device(w, { op: :hold, index: hold, colour: 0, reply_to: a } impl ActorMessage {});
                _: boolean <- cast_device(w, { op: :set, index: i, colour: 0, reply_to: a } impl ActorMessage {});
                chase(w, a, i + 1, colour, hold)
            }
        }
    produces
        pure sent
    end
}

impl AppSupervisor for Supervisor;

// The app's work, run by the supervisor's one worker (main only starts the supervisor and casts).
fn app_worker(msg: atom, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        dim_white: uint32 <- 0x181818;
        dim_red: uint32 <- 0x180000;
        dim_green: uint32 <- 0x001800;
        dim_blue: uint32 <- 0x000018;
        a: actor_ref <- spawn(0, announcer, stack_policy(0, :keep_last_message));
        w: device_actor_ref <- spawn_device(:unmapped, device_ws2813b@ws2813b_worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(w, { op: :init, index: 0, colour: 0, reply_to: a } impl ActorMessage {});
        _: boolean <- row_step(w, a, 1, dim_white, 1000);
        _: boolean <- row_step(w, a, 2, 0, 1000);
        _: boolean <- cast_device(w, { op: :notify, index: 0, colour: 3, reply_to: a } impl ActorMessage {});
        _: boolean <- chase(w, a, 0, dim_white, 150);
        _: boolean <- row_step(w, a, 4, dim_red, 1000);
        _: boolean <- row_step(w, a, 5, dim_green, 1000);
        _: boolean <- row_step(w, a, 6, dim_blue, 1000);
        _: boolean <- row_step(w, a, 2, 0, 200);
        _: boolean <- cast_device(w, { op: :notify, index: 0, colour: 7, reply_to: a } impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: atom, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 1 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: atom, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :app_worker, agent_type: :worker, initial_state: initial_state, behavior: app_worker, restart: :transient, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: supervisor_ref <- spawn_registered_supervisor(AppSupervisor, 0, :app_supervisor, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:app_worker, (:start) impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
