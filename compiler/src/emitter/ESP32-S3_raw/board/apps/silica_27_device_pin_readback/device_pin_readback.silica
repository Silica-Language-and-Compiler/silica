// ESP32-S3 port app 27: the Silica twin of asm_09_pin_readback. For each of the pins 1, 2, 4, 5, 6,
// 7 and 48 the GPIO device worker (device_lib/device_esp32s3_gpio) makes the pin an output, turns on
// its pad input buffer (:input_buffer, FUN_IE), drives it 1 then 0 (about a millisecond each) and
// :read reports the level GPIO_IN / GPIO_IN1 shows each time. Console: "pin N: <level at 1> <level at 0>"
// per pin, in that order of pins; "pin 48: 1 0" means the chip really drives the pad. The levels are
// what the hardware reports (a pad held by something else reads the same twice), so there is no
// fixed expected file. Status 0 after the 7th line.
// The printer counts the worker's replies in threes: a :notify with the pin, then the two reads.
use device_esp32s3_gpio;
use Supervisor;

fn slot_of(k: int64) -> int64 {
    case k >= 3 of { true -> slot_of(k - 3); false -> k }
}

fn printer(v: uint32, k: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        slot: int64 <- slot_of(k);
        _: atom <- case slot of {
            0 -> {
                _: atom <- print_string("pin ");
                _: atom <- print_uint32(v);
                print_string(":")
            };
            1 -> {
                _: atom <- print_string(" ");
                print_uint32(v)
            };
            _: int64 -> {
                _: atom <- print_string(" ");
                _: atom <- print_uint32(v);
                println("")
            }
        };
        _: boolean <- case k == 20 of { true -> cast_exit(0); false -> true }
    produces
        pure (:no_reply, k + 1)
    end
}

impl AppSupervisor for Supervisor;

fn app_worker(msg: atom, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        p: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message));
        w: device_actor_ref <- spawn_device(:unmapped, device_esp32s3_gpio@gpio_worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(w, { op: :init, pin: 0, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 1, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :input_buffer, pin: 1, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 1, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 1, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 1, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 1, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 2, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :input_buffer, pin: 2, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 2, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 2, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 2, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 2, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 2, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 4, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :input_buffer, pin: 4, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 4, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 4, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 4, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 4, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 4, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 5, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :input_buffer, pin: 5, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 5, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 5, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 5, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 5, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 5, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 6, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :input_buffer, pin: 6, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 6, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 6, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 6, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 6, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 6, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 7, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :input_buffer, pin: 7, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 7, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 7, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 7, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 7, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 7, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 48, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :input_buffer, pin: 48, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 48, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 48, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 48, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 48, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 48, level: 0, reply_to: p } impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: atom, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 1 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: atom, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :app_worker, agent_type: :worker, initial_state: initial_state, behavior: app_worker, restart: :transient, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: supervisor_ref <- spawn_registered_supervisor(AppSupervisor, 0, :app_supervisor, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:app_worker, (:start) impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
