// ESP32-S3 port app 28: the Silica twin of asm_10_pin_hunt. Every pin in the hunt list (2, 3, 7, 8, 9,
// 12, 13, 14, 15, 16, 17, 18, 45, 46) gets the same 440 Hz square wave (half period 1136 us) for 4 s, so
// a buzzer on any of them sounds and an LED on any of them glows. The list is asm_10's pins.inc as it
// stands, display pins (3 SDA, 45 D/C, 46 SCL) included: never add buttons, flash/PSRAM (26..32) or the
// console UART (43, 44). The GPIO device worker (device_lib/device_esp32s3_gpio) makes each pin an output
// (:output), then one :square message carries the two pin masks (bank 0 = 0x7F38C, bank 1 = 0x6000) and the
// worker toggles all pads at once with out_w1ts / out_w1tc / out1_w1ts / out1_w1tc: the timing-critical
// loop is in the worker (like :watch), not a message or a poke per pin per edge.
// Expected console: "square wave on", "done", status 0 (fixed text; the 4 s of tone is not in the console).
// The printer prints in the worker's order (:notify 1 before the wave, :notify 0 after it) and ends the
// program with cast_exit(0) after "done".
use device_esp32s3_gpio;
use Supervisor;

fn printer(level: uint32, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        label: string <- case level == 0 of { true -> "done"; false -> "square wave on" };
        println(label);
        _: boolean <- case level == 0 of { true -> cast_exit(0); false -> false }
    produces
        pure (:no_reply, state)
    end
}

impl AppSupervisor for Supervisor;

// The app's work, run by the supervisor's one worker (main only starts the supervisor and casts).
fn app_worker(msg: atom, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        p: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message));
        w: device_actor_ref <- spawn_device(:unmapped, device_esp32s3_gpio@gpio_worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(w, { op: :init, pin: 0, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 2, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 3, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 7, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 8, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 9, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 12, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 13, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 14, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 15, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 16, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 17, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 18, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 45, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 46, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :square, pin: 0x7F38C, level: 0x6000, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :notify, pin: 0, level: 0, reply_to: p } impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn init(initial_state: int64) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: atom, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 1 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: atom, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :app_worker, agent_type: :worker, initial_state: initial_state, behavior: app_worker, restart: :transient, shutdown: 0, flavor: :plain }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: supervisor_ref <- spawn_registered_supervisor(AppSupervisor, 0, :app_supervisor, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:app_worker, (:start) impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}

// FailureReporter (spec §15.4.13.4): registered before anything is started (E2236).
// region_dump_limit is called once at registration; 0 disables region dumps.
fn region_dump_limit() -> int64 {
    0
}

// True for the root supervisor's own report: no supervisor (a null pointer prints as 0x0 on
// Darwin, (nil) on glibc, 0x00000000 on the ESP32-S3 board) and frame #0 `<unknown behavior>`,
// the runtime-owned supervisor behaviour. A worker's report always names its behaviour.
fn report_is_from_root_supervisor(report: string) -> boolean {
    no_supervisor: boolean <- contains(report, "supervisor_acb:  0x0\n") or contains(report, "supervisor_acb:  (nil)\n") or contains(report, "supervisor_acb:  0x00000000\n");
    no_supervisor and contains(report, "#0  <unknown behavior>")
}

// A registered reporter receives every report the runtime would otherwise write to stderr, so it
// writes the report there itself. The root supervisor's report ends the program with status 70.
fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- println_stderr(report);
        _: boolean <- case report_is_from_root_supervisor(report) of {
            true -> cast_exit(70);
            false -> true
        }
    produces
        pure (:no_reply, state)
    end
}

// Spawns the FailureReporter and registers it.
fn start_reporter() -> atom {
    sequence proc[concurrency]
        reporter_ref: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message));
        registered: atom <- register_failure_reporter(reporter_ref)
    produces
        pure registered
    end
}
