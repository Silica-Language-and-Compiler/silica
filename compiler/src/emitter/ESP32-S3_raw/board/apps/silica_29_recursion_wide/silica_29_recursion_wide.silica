// ESP32-S3 port app 29: the Silica twin of asm_05_recursion. 1000 nested non-tail calls (a window
// overflow on almost every call, an underflow on every return) must give the right int64 sums, and the
// values bound before the calls must still be intact after them. wide_sum adds 4294967295 (0xFFFFFFFF)
// 1000 times: every addition carries into the high word, the add-with-carry idiom of asm_05.
// 1000 * 4294967295 = 4294967295000 (asm_05: hi 999, lo 4294966296); sum_to(1000) = 500500;
// the six bound values print as 17|034|051|068|085|102 in base 1000. Complements silica_07 (depth only)
// and silica_05 (carry without recursion).
fn sum_to(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> n + sum_to(n - 1)
    }
}

fn wide_sum(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> 4294967295 + wide_sum(n - 1)
    }
}

fn main() -> atom {
    sequence proc[device_io]
        s1: int64 <- 17;
        s2: int64 <- 34;
        s3: int64 <- 51;
        s4: int64 <- 68;
        s5: int64 <- 85;
        s6: int64 <- 102;
        a: int64 <- sum_to(1000);
        b: int64 <- wide_sum(1000);
        pa: atom <- print_int64(a);
        println();
        pb: atom <- print_int64(b);
        println();
        pc: atom <- print_int64(((((s1 * 1000 + s2) * 1000 + s3) * 1000 + s4) * 1000 + s5) * 1000 + s6);
        println()
    produces pure :ok end
}
