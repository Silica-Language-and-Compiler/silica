// Literal pins: every pin number is a literal, checked against the board pack's table at compile time,
// so the calls take the unchecked runtime entries (silica_rt_pin_*_lit). The worker makes GPIO16, an
// output, drives it high, reads it, drives it low, reads it, and returns it to an input.
// Minibadge note: the pass criteria are for empty minibadge slots (a fitted add-on board can load or
// drive GPIO13-GPIO18; lib/device_pin_sweep.silica).
// Expected: led 1 / led 0 / status 0.
use trial_wait_int64;

fn printer(msg: { what: atom, n: uint32 }, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case msg.what of {
            :fail -> print_string("pin ");
            :high -> print_string("high ");
            :low -> print_string("low ");
            _: atom -> print_string("led ")
        };
        _: atom <- print_uint32(msg.n);
        _: atom <- case msg.what of {
            :fail -> print_string(" failed\n");
            _: atom -> print_string("\n")
        }
    produces
        pure (:no_reply, state + 1)
    end
}

fn level_word(b: boolean) -> uint32 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn led_worker(msg: actor_ref, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr, concurrency]
        _: atom <- pin_mode(16, :output);
        _: atom <- pin_write(16, true);
        on: boolean <- pin_read(16);
        _: atom <- pin_write(16, false);
        off: boolean <- pin_read(16);
        _: atom <- pin_mode(16, :input);
        _: boolean <- cast(msg, { what: :led, n: level_word(on) } impl ActorMessage {});
        _: boolean <- cast(msg, { what: :led, n: level_word(off) } impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                p: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                w: device_actor_ref <- spawn_device(0, led_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast_device(w, p impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
