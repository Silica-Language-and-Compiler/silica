// expected failure E2223: spawn (not spawn_device) starts a behaviour that uses a pin builtin.

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_write(16, true)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        _: actor_ref <- spawn(0, work, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
    produces
        pure 0
    end
}
