// pin_read on the read-only pins (Lee, 2026-11-09): the buttons Left (21), Right (10), Down (47),
// Up (11), A (34) and B (33) are sampled by pin_read only; nothing configures, drives or pulls them, so
// the buttons keep working as they do. The joystick pins (8, 9) are read too, but their digital level at
// the analog rest position is not defined, so only the buttons are printed. Nobody presses a button
// during the run: they idle low on this board (board_pack button_idle_level).
// Expected: six lines "led 0" (the printer's level line) / status 0.
use trial_wait_int64;

fn printer(msg: { what: atom, n: uint32 }, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case msg.what of {
            :fail -> print_string("pin ");
            :high -> print_string("high ");
            :low -> print_string("low ");
            _: atom -> print_string("led ")
        };
        _: atom <- print_uint32(msg.n);
        _: atom <- case msg.what of {
            :fail -> print_string(" failed\n");
            _: atom -> print_string("\n")
        }
    produces
        pure (:no_reply, state + 1)
    end
}

fn level_word(b: boolean) -> uint32 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn reader(msg: actor_ref, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr, concurrency]
        left: boolean <- pin_read(21);
        right: boolean <- pin_read(10);
        down: boolean <- pin_read(47);
        up: boolean <- pin_read(11);
        a: boolean <- pin_read(34);
        b: boolean <- pin_read(33);
        _: boolean <- pin_read(8);
        _: boolean <- pin_read(9);
        _: boolean <- cast(msg, { what: :led, n: level_word(left) } impl ActorMessage {});
        _: boolean <- cast(msg, { what: :led, n: level_word(right) } impl ActorMessage {});
        _: boolean <- cast(msg, { what: :led, n: level_word(down) } impl ActorMessage {});
        _: boolean <- cast(msg, { what: :led, n: level_word(up) } impl ActorMessage {});
        _: boolean <- cast(msg, { what: :led, n: level_word(a) } impl ActorMessage {});
        _: boolean <- cast(msg, { what: :led, n: level_word(b) } impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                p: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                w: device_actor_ref <- spawn_device(0, reader, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast_device(w, p impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
