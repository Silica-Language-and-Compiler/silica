// expected failure E2226: :analog is not a pin_mode mode (:input, :output, :output_open_drain).

export work/2;

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_mode(16, :analog)
    produces
        pure (:no_reply, state)
    end
}
