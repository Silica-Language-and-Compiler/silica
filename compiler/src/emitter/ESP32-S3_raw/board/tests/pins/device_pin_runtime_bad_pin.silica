// A pin number that is not a literal is checked at run time (board_pin_builtins_design.md §5): the
// worker receives 23 in its message, which is not a pin of this board, and pin_write's checked entry
// ends the program with the abort report naming the builtin and the number (status 71) before any
// register is touched.
// Expected: the folded abort line and status 71.
use trial_wait_int64;

fn worker(msg: uint32, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_write(msg, true)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                w: device_actor_ref <- spawn_device(0, worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast_device(w, 23 impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
