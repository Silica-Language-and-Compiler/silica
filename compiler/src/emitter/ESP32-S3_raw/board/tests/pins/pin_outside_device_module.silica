// expected failure E2232: a pin builtin (and its register_rwr sequence) in a module without the device_ prefix.

export work/2;

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_write(16, true)
    produces
        pure (:no_reply, state)
    end
}
