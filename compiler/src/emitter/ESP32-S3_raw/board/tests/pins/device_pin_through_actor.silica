// Through an actor (board_pin_builtins_design.md §3, §7): an ordinary client actor receives :go and
// casts the pin work to the device worker (cast_device); the worker does the writes and reads and casts
// the results to the printer the request names. The client declares only concurrency. Pin 16.
// Minibadge note: the pass criteria are for empty minibadge slots (a fitted add-on board can load or
// drive GPIO13-GPIO18; lib/device_pin_sweep.silica).
// Expected: high 1 / low 1 / status 0.
use device_pin_sweep;
use trial_wait_int64;

fn printer(msg: { what: atom, n: uint32 }, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case msg.what of {
            :fail -> print_string("pin ");
            :high -> print_string("high ");
            :low -> print_string("low ");
            _: atom -> print_string("led ")
        };
        _: atom <- print_uint32(msg.n);
        _: atom <- case msg.what of {
            :fail -> print_string(" failed\n");
            _: atom -> print_string("\n")
        }
    produces
        pure (:no_reply, state + 1)
    end
}

fn client(msg: atom, state: { w: device_actor_ref, p: actor_ref }) -> (:no_reply, { w: device_actor_ref, p: actor_ref }) {
    sequence proc[concurrency]
        _: boolean <- cast_device(state.w, { op: :readback, set: :one, reply_to: state.p } impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                p: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                w: device_actor_ref <- spawn_device(0, device_pin_sweep@sweep_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                c: actor_ref <- spawn({ w: w, p: p }, client, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(c, :go impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
