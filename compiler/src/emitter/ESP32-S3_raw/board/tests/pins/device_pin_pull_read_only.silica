// expected failure E2227: GPIO10 is read-only; pin_pull is rejected (the buttons keep their own configuration).

export work/2;

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_pull(10, :up)
    produces
        pure (:no_reply, state)
    end
}
