// expected failure E2222: pin 6 is reserved on this board (board_pack pin_class); the pin builtins never touch it.

export work/2;

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_mode(6, :output)
    produces
        pure (:no_reply, state)
    end
}
