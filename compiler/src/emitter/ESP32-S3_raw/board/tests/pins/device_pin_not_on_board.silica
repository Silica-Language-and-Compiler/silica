// expected failure E2221: pin 23 is not a pin of this board (a literal pin is checked against the board pack at compile time).

export work/2;

fn work(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        _: atom <- pin_write(23, true)
    produces
        pure (:no_reply, state)
    end
}
