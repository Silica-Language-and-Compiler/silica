// Prim dispatcher: case sir_term_root_node(term).type_name -> type-specific emit_prim_op
// term_emitter emits subterms to r1, r2 before calling this
// Converts dest (X0/X1/X2) to D/S/W form for float/narrow types

use prims_float64;
use prims_float32;
use prims_float16;
use prims_int64;
use prims_uint64;
use prims_narrow;
use prims_bool;
use prims_string;
use prims_tuple;
use prims_memory;
use prims_device;
use prims_list;
use prims_atom;
use prims_ordering_identity;
use reg_conventions;

export emit_prim_op/2;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn dest_for_type(dest: string, type_name: string) -> string {
    case reg_conventions@is_float64_type(type_name) of {
        true -> case dest of {
            "X0" -> "D0";
            "X1" -> "D1";
            "X2" -> "D2";
            "D0" -> "D0";
            "D1" -> "D1";
            "D2" -> "D2";
            _: string -> case length_bytes(dest) > 0 and substring(dest, 0, 1) == "X" of {
                true -> concat("D", substring(dest, 1, length_bytes(dest)));
                false -> dest
            }
        };
        false -> case reg_conventions@is_float32_type(type_name) of {
            true -> case dest of {
                "X0" -> "S0";
                "X1" -> "S1";
                "X2" -> "S2";
                "S0" -> "S0";
                "S1" -> "S1";
                "S2" -> "S2";
                _: string -> case length_bytes(dest) > 0 and substring(dest, 0, 1) == "X" of {
                    true -> concat("S", substring(dest, 1, length_bytes(dest)));
                    false -> dest
                }
            };
            false -> case reg_conventions@is_float16_type(type_name) of {
                true -> case dest of {
                    "X0" -> "H0";
                    "X1" -> "H1";
                    "X2" -> "H2";
                    "H0" -> "H0";
                    "H1" -> "H1";
                    "H2" -> "H2";
                    _: string -> case length_bytes(dest) > 0 and substring(dest, 0, 1) == "X" of {
                        true -> concat("H", substring(dest, 1, length_bytes(dest)));
                        false -> dest
                    }
                };
                false -> case reg_conventions@is_narrow_type(type_name) of {
                    true -> case length_bytes(dest) > 0 of {
                        true -> concat("W", substring(dest, 1, length_bytes(dest)));
                        false -> dest
                    };
                    false -> dest
                }
            }
        }
    }
}

fn is_comparison_prim(name: string) -> boolean {
    name == "lt" or name == "gt" or name == "le" or name == "ge"
}

fn bool_result_compare_prim(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    sir_term_root_node(term).type_name == "bool" and (is_comparison_prim(sir_term_root_node(term).name) or sir_term_root_node(term).name == "eq" or sir_term_root_node(term).name == "nq" or sir_term_root_node(term).name == "is_nan" or sir_term_root_node(term).name == "is_inf" or sir_term_root_node(term).name == "is_finite")
}

fn emit_prim_op(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    // Tuple projection dispatches to prims_tuple (tuple_make handled by term_emitter flat layout).
    // Check before narrow/float so "(int16,...)" etc. don't match "int16".
    case prims_device@is_device_prim(sir_term_root_node(term).name) of {
        true -> concat(".error \"ESP32-S3: device prim ", concat(sir_term_root_node(term).name, " reached the type dispatcher without its atom table\"\n"));
        false -> case sir_term_root_node(term).name == "tuple_proj" of {
        true -> prims_tuple@emit_prim_op(term, dest);
        false -> case prims_list@is_list_prim(sir_term_root_node(term).name) of {
            true -> prims_list@emit_prim_op(term, dest);
            false -> case prims_memory@is_memory_prim(sir_term_root_node(term).name) of {
            true -> prims_memory@emit_prim_op(term, dest);
            false -> case prims_ordering_identity@is_ordering_identity_prim(sir_term_root_node(term).name) of {
            true -> prims_ordering_identity@emit_prim_op(term, dest);
            false -> case prims_string@is_string_predicate_prim(sir_term_root_node(term).name) of {
            true -> prims_string@emit_prim_op(term, dest);
            false -> {
    dispatch_type: string <- case bool_result_compare_prim(term) of {
        true -> sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name;
        false -> sir_term_root_node(term).type_name
    };
    dest_reg: string <- case bool_result_compare_prim(term) of {
        true -> dest;
        false -> dest_for_type(dest, dispatch_type)
    };
    case dispatch_type of {
        "float64" -> prims_float64@emit_prim_op(term, dest_reg);
        "float32" -> prims_float32@emit_prim_op(term, dest_reg);
        "float16" -> prims_float16@emit_prim_op(term, dest_reg);
        "int64" -> prims_int64@emit_prim_op(term, dest_reg);
        "uint64" -> prims_uint64@emit_prim_op(term, dest_reg);
        "bool" -> prims_bool@emit_prim_op(term, dest_reg);
        "int32" -> prims_narrow@emit_prim_op(term, dest_reg);
        "int16" -> prims_narrow@emit_prim_op(term, dest_reg);
        "int8" -> prims_narrow@emit_prim_op(term, dest_reg);
        "uint32" -> prims_narrow@emit_prim_op(term, dest_reg);
        "uint16" -> prims_narrow@emit_prim_op(term, dest_reg);
        "uint8" -> prims_narrow@emit_prim_op(term, dest_reg);
        "string" -> prims_string@emit_prim_op(term, dest_reg);
        "atom" -> prims_atom@emit_prim_op(term, dest_reg);
        // Actor reference identity compare (silica-specification 7.4, 15.1.4): the reference word is a
        // plain word holding the identity (position << 32 | child number), so every compare is the unsigned
        // 64-bit one: ordering is (position, child number).
        "actor_ref" -> prims_uint64@emit_prim_op(term, dest_reg);
        "dangerous_actor_ref" -> prims_uint64@emit_prim_op(term, dest_reg);
        "device_actor_ref" -> prims_uint64@emit_prim_op(term, dest_reg);
        "supervisor_ref" -> prims_uint64@emit_prim_op(term, dest_reg);
        // A timer reference is one unsigned word (the timer number, never reused): == and != only (spec §4.5.2).
        "timer_ref" -> prims_uint64@emit_prim_op(term, dest_reg);
        _: string -> case reg_conventions@is_atom_option_type(dispatch_type) of {
            true -> prims_atom@emit_prim_op(term, dest_reg);
            false -> concat(".error \"unsupported prim type: ", concat(dispatch_type, "\"\n"))
        }
    }
    }
    }
    }
    }
    }
    }
}
}
