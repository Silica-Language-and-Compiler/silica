// Actor / concurrency prim emission (silica-specification §4.5, §15–16; sir_generator actor_calls.silica).
// Supervisors Phase B (supervisors_implementation_development_plan.md §15.4.9, §16.2.7): ingress vs standard
// mailbox drain ordering for recv; runtime implements dequeue.
// Supervisors Phase G (same plan §15.4.8.4–§15.4.8.7): link, monitor, demonitor lower here — silica-specification
// §15.4.8.5 (link, idempotent; dead target → immediate exit path), §15.4.8.6 (DOWN only to standard mailbox);
// SIR `value` tags [concurrency] vs [concurrency, mailbox] from sir_generator match send/cast.
// Supervisors Phase C (§15.4.10–§15.4.11, §16.2.7): recv → _silica_rt_actor_recv (ingress before standard; stub in runtime chunk).
// Supervisors Phase D (same plan §15.4.13): impl_supervisor metadata is emitted in module_linkage (not here).
// Phase E e3b: SIR `value` may be \"[concurrency]|e3b:<StateT>\" (sir_generator) → store _silica_supervisor_start_<T> to the child's supervision block (SB #48 on the hosts, SB_TRAMP on the board; item I).
// Lowers SIR kind-6 prims to CALL8s of the board runtime's silica_rt_* entry points
// (board/runtime/rt_actors.S, rt_supervisors.S), through the Xtensa helper layer (shared/xt_*): the
// operand staging is the Apple Silicon dispatcher's, spelled with AArch64 virtual registers, and the
// helpers turn every line into Xtensa. xt_sym drops the leading underscore of the runtime names.
// Operands: binary prims expect inner -> X9, right_expr -> X10 (same as arithmetic).
// spawn: right_expr is the flat chain tuple_make(behavior, stack_policy[, placement]); X10 points at the flat words
// [beh, policy(, core)] and X11 holds the initial state (§15.1.2.2: the stack policy is a required argument; the
// runtime takes it in X4 as (reserve & ~15) | algorithm). stack_policy(reserve, release) itself is packed inline.
// Structured returns (cpu_topology, core_info, List[...]): the runtime returns a heap pointer in X0, in the emitter's record and list layouts (rt_actors.S).

use reg_conventions;
use atom_table;
use prims_record;
use prims_tuple;
use term_message_copy;
use term_message_regions;
use var;
use module_linkage;
use xt_isa;
use xt_mem;

export is_actor_prim/1;
export actor_prim_is_nullary/1;
export actor_prim_is_unary/1;
export emit_prim_op/2;
export emit_prim_op_with_atoms/4;
export module_uses_actor_prims/1;
export module_uses_link_monitor_prims/1;
export gpr_x_view/1;
export composite_move_bytes/1;
export composite_move_has_scalar_alt/1;
export behaviour_result_move_asm/3;
export behaviour_convention_prefix/1;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn term_has_actor_prim(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case term.root < 0 of {
        true -> false;
        false -> case sir_term_root_node(term).kind of {
            6 -> is_actor_prim(sir_term_root_node(term).name);
            2 -> case term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            3 -> case term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            4 -> case term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            5 -> case term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            7 -> case term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            8 -> case term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_actor_prim(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            _: int64 -> false
        }
    }
}

fn actor_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_actor_prim(fns.head.body) of {
            true -> true;
            false -> actor_in_functions(fns.tail)
        }
    }
}

fn module_uses_actor_prims(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> bool {
    actor_in_functions(sir_module.functions)
}

fn term_has_link_monitor_demonitor(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case term.root < 0 of {
        true -> false;
        false -> case sir_term_root_node(term).kind of {
            6 -> sir_term_root_node(term).name == "link" or sir_term_root_node(term).name == "monitor" or sir_term_root_node(term).name == "demonitor";
            2 -> case term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            3 -> case term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            4 -> case term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            5 -> case term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            7 -> case term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            8 -> case term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_link_monitor_demonitor(sir_term_at(term, sir_term_root_node(term).right_expr))
            };
            _: int64 -> false
        }
    }
}

fn link_monitor_demonitor_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_link_monitor_demonitor(fns.head.body) of {
            true -> true;
            false -> link_monitor_demonitor_in_functions(fns.tail)
        }
    }
}

// True when the module uses link, monitor, or demonitor (supervisors plan Phase G matrix / silica-spec §15.4.8.4–8.7).
fn module_uses_link_monitor_prims(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> bool {
    link_monitor_demonitor_in_functions(sir_module.functions)
}

fn is_actor_prim(name: string) -> bool {
    name == "spawn" or name == "spawn_dangerous" or name == "spawn_registered" or name == "spawn_dangerous_registered" or name == "spawn_registered_supervisor" or name == "add_child" or name == "send" or name == "actor_call" or name == "actor_call_registered" or name == "actor_cast" or name == "actor_cast_registered" or name == "actor_cast_dangerous_registered" or name == "spawn_device" or name == "spawn_device_registered" or name == "actor_cast_device" or name == "actor_cast_device_registered" or name == "self"
        or name == "recv"
        or name == "link" or name == "monitor" or name == "demonitor" or name == "supervision_ingress_enqueue"
        or name == "supervision_wait_and_drain_one" or name == "child_table_first_ref"
        or name == "child_table_row_ref"
        or name == "kill_abnormal"
        or name == "stop_self_normal" or name == "stop_self_explicit" or name == "fail_self"
        or name == "monotonic_time" or name == "current_time" or name == "send_after" or name == "timer_cast" or name == "cancel_timer"
        or name == "failure_reason_tag" or name == "failure_reason_atom"
        or name == "failure_agent_type" or name == "failure_release" or name == "start_child" or name == "supervisor_add_child"
        or name == "supervisor_remove_child" or name == "supervisor_restart_child" or name == "supervisor_terminate_child"
        or name == "supervisor_set_report_sink"
        or name == "supervisor_op_tag" or name == "supervisor_op_error" or name == "supervisor_op_child"
        or name == "supervisor_which_children" or name == "supervisor_count_children" or name == "supervisor_get_child"
        or name == "supervisor_get_child_info"
        or name == "supervisor_get_child_id" or name == "supervisor_get_child_agent_type" or name == "supervisor_get_child_restart"
        or name == "pin_actor_to_core" or name == "pin_actor_to_efficiency_core" or name == "pin_actor_to_performance_core"
        or name == "pin_actor_realtime" or name == "remove_actor" or name == "register_actor" or name == "get_registry_actor" or name == "get_pid_registry" or name == "pin_actor_to_numa_node"
        or name == "unpin_actor" or name == "set_actor_priority" or name == "set_scheduler_policy"
        or name == "get_cpu_topology" or name == "get_efficiency_cores" or name == "get_performance_cores"
        or name == "get_core_capabilities"
        or name == "get_actor_memory_usage"
        or name == "migrate_actor"
        or name == "register_failure_reporter"
        or name == "wait_for_exit" or name == "cast_exit"
        or name == "stack_policy"
        or name == "heap_used"
}

fn actor_prim_is_nullary(name: string) -> bool {
    name == "self" or name == "recv" or name == "get_cpu_topology" or name == "get_efficiency_cores" or name == "get_performance_cores"
        or name == "supervision_wait_and_drain_one" or name == "wait_for_exit" or name == "child_table_first_ref"
        or name == "get_registry_actor" or name == "get_pid_registry" or name == "heap_used"
        or name == "stop_self_normal"
        or name == "monotonic_time" or name == "current_time"
}

fn actor_prim_is_unary(name: string) -> bool {
    name == "link" or name == "monitor" or name == "demonitor"
        or name == "get_core_capabilities" or name == "pin_actor_to_efficiency_core" or name == "pin_actor_to_performance_core"
        or name == "unpin_actor" or name == "remove_actor" or name == "register_actor" or name == "get_actor_memory_usage"
        or name == "failure_reason_tag" or name == "failure_reason_atom" or name == "failure_agent_type" or name == "failure_release"
        or name == "start_child" or name == "kill_abnormal" or name == "child_table_row_ref"
        or name == "stop_self_explicit" or name == "fail_self"
        or name == "cancel_timer"
        or name == "supervisor_which_children" or name == "supervisor_count_children"
        or name == "supervisor_op_child"
        or name == "register_failure_reporter" or name == "set_scheduler_policy" or name == "cast_exit"
}

fn asm_bl(label: string) -> string {
    xt_isa@xt_call(label)
}

fn spawn_init_stack_round16(nbytes: int64) -> int64 {
    (nbytes + 15) / 16 * 16
}

fn spawn_init_stack_bytes(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case sir_term_root_node(inner).kind == 6 and sir_term_root_node(inner).name == "record_make" of {
        true -> {
            Rm: string <- sir_term_root_node(inner).type_name;
            spawn_init_stack_round16(prims_record@record_type_value_flat_byte_size(Rm))
        };
        false -> case sir_term_root_node(inner).kind == 6 and sir_term_root_node(inner).name == "tuple_make" of {
            true -> {
                cf: int64 <- prims_tuple@count_flat_elements(inner);
                prims_tuple@flat_alloc_size(cf)
            };
            false -> 0
        }
    }
}

fn spawn_init_needs_heap_copy(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    sir_term_root_node(inner).kind == 6 and (sir_term_root_node(inner).name == "record_make" or sir_term_root_node(inner).name == "tuple_make")
        and reg_conventions@is_aggregate_struct_or_tuple_return_type(sir_term_root_node(inner).type_name)
}

fn mem_off(base: string, off: int64) -> string {
    concat(concat(concat("[", base), ", #"), concat(atom_table@int64_to_decimal_string(off), "]"))
}

fn heap_promote_copy_words(idx: int64, words: int64) -> string {
    case idx >= words of {
        true -> "";
        false -> {
            off: int64 <- idx * 8;
            pair: string <- concat(xt_mem@xt_ldr("X3", mem_off("X1", off)), xt_mem@xt_str("X3", mem_off("X4", off)));
            concat(pair, heap_promote_copy_words(idx + 1, words))
        }
    }
}

// Copy stack-built initial state (or a message) to the heap so an actor never keeps a pointer into
// the caller's frame. X0 in and out; clobbers X1, X3, X4.
fn heap_promote_stack_aggregate_x0(nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> {
            words: int64 <- nbytes / 8;
            case words <= 0 of {
                true -> "";
                false -> {
                    copy_asm: string <- heap_promote_copy_words(0, words);
                    pre: string <- concat(xt_isa@xt_sub("SP", "SP", "#16"), concat(xt_mem@xt_str("X0", "[SP, #8]"), concat(xt_isa@xt_movi("X0", nbytes), concat(asm_bl("_silica_rt_region_alloc"), concat(xt_isa@xt_mov("X4", "X0"), xt_mem@xt_ldr("X1", "[SP, #8]"))))));
                    concat(concat(pre, copy_asm), concat(xt_isa@xt_mov("X0", "X4"), xt_isa@xt_add("SP", "SP", "#16")))
                }
            }
        }
    }
}

// Used by term_emitter spill path (spawn/call may assign W* dest for GPR values).
fn gpr_x_view(dest: string) -> string {
    case length_bytes(dest) > 1 and substring(dest, 0, 1) == "W" of {
        true -> concat("X", substring(dest, 1, length_bytes(dest)));
        false -> dest
    }
}

fn prim_return_uses_w32_from_x0(result_type: string) -> bool {
    result_type == "int32" or result_type == "int16" or result_type == "int8"
        or result_type == "uint32" or result_type == "uint16" or result_type == "uint8"
        or result_type == "bool"
}

// Phase E e3b: extract "<TypeName>" from SIR value "[concurrency]|e3b:<TypeName>".
// "[concurrency]" is 13 chars, so "|e3b:" starts at index 13 and the type name at 18.
fn e3b_extract_type_name(value: string) -> string {
    case length_bytes(value) > 18 and substring(value, 13, 18) == "|e3b:" of {
        true -> substring(value, 18, length_bytes(value));
        false -> ""
    }
}

// Phase E e3b: the supervisor start trampoline's address in X3 (spawn) or X4 (spawn_linked); 0
// for a plain actor.
fn e3b_trampoline_prefix(value: string, reg: string) -> string {
    tn: string <- e3b_extract_type_name(value);
    case length_bytes(tn) == 0 of {
        true -> xt_isa@xt_movi(reg, 0);
        false -> xt_isa@xt_adr(reg, concat("_silica_supervisor_start_", tn))
    }
}

fn mov_dest_from_x0_for_type(dest: string, result_type: string) -> string {
    case dest == "X0" of {
        true -> "";
        false -> case prim_return_uses_w32_from_x0(result_type) of {
            true -> case length_bytes(dest) > 0 and substring(dest, 0, 1) == "W" of {
                true -> case dest == "W0" of {
                    true -> "";
                    false -> xt_isa@xt_mov(dest, "W0")
                };
                false -> xt_isa@xt_mov(dest, "X0")
            };
            false -> xt_isa@xt_mov(gpr_x_view(dest), "X0")
        }
    }
}

// spawn_linked: X0 init, X1 beh, X2 agent atom, X3 row (0 default), X4 trampoline.
// 3-arg SIR: right = tuple_make(beh, agent); 4-arg: flat [beh, agent, core] at X10.
fn emit_spawn_linked(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    e3b_pfx: string <- e3b_trampoline_prefix(sir_term_root_node(term).value, "X4");
    four_args: bool <- sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).kind == 6 and sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).name == "tuple_make"
        and sir_term_root_node(sir_term_at(sir_term_at(term, sir_term_root_node(term).right_expr), sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).inner)).kind == 6 and sir_term_root_node(sir_term_at(sir_term_at(term, sir_term_root_node(term).right_expr), sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).inner)).name == "tuple_make";
    tail: string <- concat(asm_bl("_silica_rt_actor_spawn_linked"), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name));
    adopted_tail: string <- concat(asm_bl("_silica_rt_actor_spawn_linked"), concat(spawn_adopt_asm(sir_term_at(term, sir_term_root_node(term).inner)), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name)));
    case four_args of {
        true -> concat(concat(e3b_pfx, concat(xt_isa@xt_mov("X0", "X11"), concat(xt_mem@xt_ldr("X1", "[X10]"), concat(xt_mem@xt_ldr("X2", "[X10, #8]"), xt_mem@xt_ldr("X3", "[X10, #16]"))))), tail);
        false -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).kind == 6 and sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).name == "tuple_make" of {
            true -> concat(concat(e3b_pfx, concat(xt_isa@xt_mov("X0", "X11"), concat(xt_mem@xt_ldr("X1", "[X10]"), concat(xt_mem@xt_ldr("X2", "[X10, #8]"), xt_isa@xt_movi("X3", 0))))), tail);
            false -> {
                args_sl: string <- concat(e3b_pfx, concat(xt_isa@xt_mov("X0", "X9"), concat(xt_isa@xt_mov("X1", "X10"), concat(xt_isa@xt_movi("X2", 0), xt_isa@xt_movi("X3", 0)))));
                concat(concat(spawn_init_move_asm(sir_term_at(term, sir_term_root_node(term).inner), "X9", "X10"), args_sl), adopted_tail)
            }
        }
    }
}

fn spawn_right_is_tuple(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).kind == 6 and sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).name == "tuple_make"
}

fn spawn_right_count(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    prims_tuple@count_flat_elements(sir_term_at(term, sir_term_root_node(term).right_expr))
}

// Optional core id is the word after the policy: W2 from it, else W2 = 0 (runtime placement).
fn spawn_core_from_flat(count: int64, core_idx: int64) -> string {
    case count > core_idx of {
        true -> concat(xt_mem@xt_ldr("X12", mem_off("X10", core_idx * 8)), xt_isa@xt_mov("W2", "W12"));
        false -> xt_isa@xt_movi("W2", 0)
    }
}

// The initial state is held in X11 while the flat argument words are built into X10. A stack-built
// aggregate initial state is promoted to the heap first; the promote clobbers X1, X3, X4, so X10 is
// parked on the stack around it.
fn spawn_promote_init_x11(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    spawn_init_move_asm(sir_term_at(term, sir_term_root_node(term).inner), "X11", "X10")
}

// The initial state is MOVED from the spawner into the new actor (actor_memory_budget_plan.md item
// B): a literal is copied by its own shape, anything else -- a variable, a call result -- by the
// shell size of its type, so the actor never shares its state block with the spawner or a sibling.
// A sum type with an atom alternative is copied only when the word is an address.
fn spawn_init_move_bytes(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case spawn_init_needs_heap_copy(inner) of {
        true -> spawn_init_stack_bytes(inner);
        false -> composite_move_bytes(sir_term_root_node(inner).type_name)
    }
}

fn spawn_init_move_scalar_alt(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case spawn_init_needs_heap_copy(inner) of {
        true -> false;
        false -> composite_move_has_scalar_alt(sir_term_root_node(inner).type_name)
    }
}

// After the spawn: the actor owns the block the move made, so its end frees it. X0 is the
// actor_ref, an identity rather than the ACB, so silica_rt_state_adopt_ref resolves it (and keeps
// X0).
fn spawn_adopt_asm(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case spawn_init_move_bytes(inner) <= 0 of {
        true -> "";
        false -> asm_bl("_silica_rt_state_adopt_ref")
    }
}

// The initial state is in `reg`; `park` holds the flat argument words and is kept across the copy,
// which clobbers X1, X3 and X4.
fn spawn_init_move_asm(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, reg: string, park: string) -> string {
    nb: int64 <- spawn_init_move_bytes(inner);
    case nb <= 0 of {
        true -> "";
        false -> {
            guard: string <- case spawn_init_move_scalar_alt(inner) of {
                true -> xt_isa@xt_cmp_branch("LO", reg, "#65536", "7f");
                false -> ""
            };
            copy: string <- concat(xt_mem@xt_str(park, "[SP, #-16]!"), concat(xt_isa@xt_mov("X0", reg), concat(heap_promote_stack_aggregate_x0(nb), concat(xt_isa@xt_mov(reg, "X0"), xt_mem@xt_ldr(park, "[SP], #16")))));
            concat(guard, concat(copy, "7:\n"))
        }
    }
}

// --- The behaviour boundary (actor_memory_budget_plan.md item B) -----------------------------
//
// A behaviour's result is (:no_reply, next) or (:reply, r, next). The pair or triple is a temporary;
// `next` and a composite `r` are MOVED out of the behaviour: at the epilogue, with X0 holding the
// result tuple, a composite reply is copied into a fresh heap block the caller owns, and a state
// that is not the actor's current state object (ACB word 0, read through silica_rt_current_actor)
// is copied into a fresh heap block the actor owns, installed in the ACB and adopted
// (silica_rt_state_adopt: the actor's end frees it), and the previous state goes through
// silica_rt_state_release (rt_heap.S), which keeps a block the new state still reaches and a
// supervised child's row init. The copy is the shell -- one word per element or field -- so
// nested composites keep the heap pointers their elements already hold. A sum-typed state or
// reply with an atom alternative is moved only when its word is an address (atom indices are
// below 65536; every heap address is above). Outside an actor (main, or a helper of this shape
// called directly) nothing happens.
fn shell_move_bytes(t: string) -> int64 {
    case reg_conventions@is_inline_struct_type(t) of {
        true -> prims_record@record_type_value_flat_byte_size(t);
        false -> case reg_conventions@is_tuple_type(t) of {
            true -> prims_tuple@flat_alloc_size(prims_tuple@count_type_elements(t));
            false -> 0
        }
    }
}

fn top_level_bar_from(t: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(t) of {
        true -> 0 - 1;
        false -> {
            c: string <- substring(t, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> top_level_bar_from(t, i + 1, depth + 1);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> top_level_bar_from(t, i + 1, depth - 1);
                    false -> case c == "|" and depth == 0 of {
                        true -> i;
                        false -> top_level_bar_from(t, i + 1, depth)
                    }
                }
            }
        }
    }
}

fn max_int64(a: int64, b: int64) -> int64 {
    case a >= b of {
        true -> a;
        false -> b
    }
}

fn sum_alts_max_bytes(t: string, best: int64) -> int64 {
    bar: int64 <- top_level_bar_from(t, 0, 0);
    case bar < 0 of {
        true -> max_int64(best, shell_move_bytes(t));
        false -> sum_alts_max_bytes(substring(t, bar + 1, length_bytes(t)), max_int64(best, shell_move_bytes(substring(t, 0, bar))))
    }
}

fn sum_alts_has_scalar(t: string) -> bool {
    bar: int64 <- top_level_bar_from(t, 0, 0);
    case bar < 0 of {
        true -> shell_move_bytes(t) == 0;
        false -> case shell_move_bytes(substring(t, 0, bar)) == 0 of {
            true -> true;
            false -> sum_alts_has_scalar(substring(t, bar + 1, length_bytes(t)))
        }
    }
}

fn composite_move_bytes(type_name: string) -> int64 {
    t: string <- prims_record@strip_spaces_rt(type_name);
    case top_level_bar_from(t, 0, 0) < 0 of {
        true -> shell_move_bytes(t);
        false -> sum_alts_max_bytes(t, 0)
    }
}

fn composite_move_has_scalar_alt(type_name: string) -> bool {
    t: string <- prims_record@strip_spaces_rt(type_name);
    case top_level_bar_from(t, 0, 0) < 0 of {
        true -> false;
        false -> sum_alts_has_scalar(t)
    }
}

// X0 = result tuple; [SP, #8] = result tuple, [SP, #0] = acb. The reply at +8 is always copied,
// and its original is released through silica_rt_state_release against the state word at +soff
// (the pre-move state has the same words as its copy): a frame-region or rodata original is
// ignored there, so only a block the behaviour's own promotion left behind (a let-bound case
// arm) is returned, and one the next state packs stays.
// reply_copy: "" for the one-level promote; else the deep copy of the reply into a fresh owned
// region (term_message_copy; the descriptor rodata follows).
fn bmv_reply_asm(rbytes: int64, r_scalar: bool, sbytes: int64, soff: int64, skip_label: string, reply_copy: string) -> string {
    case rbytes <= 0 of {
        true -> "";
        false -> {
            guard: string <- case r_scalar of {
                true -> xt_isa@xt_cmp_branch("LO", "X9", "#65536", skip_label);
                false -> ""
            };
            promote: string <- case length_bytes(reply_copy) > 0 of {
                true -> reply_copy;
                false -> heap_promote_stack_aggregate_x0(rbytes)
            };
            copy: string <- concat(xt_mem@xt_str("X9", "[SP, #-16]!"), concat(xt_isa@xt_mov("X0", "X9"), concat(promote, xt_isa@xt_mov("X9", "X0"))));
            back: string <- concat(xt_mem@xt_ldr("X0", "[SP, #24]"), concat(xt_mem@xt_str("X9", "[X0, #8]"), xt_mem@xt_ldr("X9", "[SP], #16")));
            release: string <- concat(xt_mem@xt_ldr("X1", mem_off("X0", soff)), concat(xt_isa@xt_movi("X2", sbytes), concat(xt_isa@xt_mov("X0", "X9"), asm_bl("_silica_rt_state_release"))));
            concat(concat(xt_mem@xt_ldr("X9", "[X0, #8]"), guard), concat(copy, concat(back, concat(release, concat(skip_label, ":\n")))))
        }
    }
}

// The previous state is handed to silica_rt_state_release (not a heap block, still reachable
// from the new state, or a supervised child's row init: kept) and the installed copy is adopted,
// so the actor's end frees it.
fn bmv_state_asm(sbytes: int64, s_scalar: bool, soff: int64, lbl: string) -> string {
    l_install: string <- concat(lbl, "_si");
    l_end: string <- concat(lbl, "_se");
    load: string <- concat(xt_mem@xt_ldr("X0", "[SP, #8]"), concat(xt_mem@xt_ldr("X9", mem_off("X0", soff)), concat(xt_mem@xt_ldr("X10", "[SP, #0]"), xt_mem@xt_ldr("X10", "[X10, #0]"))));
    same: string <- xt_isa@xt_cmp_branch("EQ", "X9", "X10", l_end);
    atom_new: string <- case s_scalar of {
        true -> xt_isa@xt_cmp_branch("LO", "X9", "#65536", l_install);
        false -> ""
    };
    copy: string <- concat(xt_mem@xt_str("X9", "[SP, #-16]!"), concat(xt_isa@xt_mov("X0", "X9"), concat(heap_promote_stack_aggregate_x0(sbytes), concat(xt_isa@xt_mov("X9", "X0"), concat(xt_mem@xt_ldr("X0", "[SP, #24]"), concat(xt_mem@xt_str("X9", mem_off("X0", soff)), concat(xt_mem@xt_ldr("X0", "[SP], #16"), asm_bl("_silica_rt_free"))))))));
    install: string <- concat(concat(l_install, ":\n"), concat(xt_mem@xt_ldr("X10", "[SP, #0]"), concat(xt_mem@xt_ldr("X0", "[X10, #0]"), xt_mem@xt_str("X9", "[X10, #0]"))));
    release: string <- concat(xt_isa@xt_mov("X1", "X9"), concat(xt_isa@xt_movi("X2", sbytes), asm_bl("_silica_rt_state_release")));
    adopt: string <- concat(xt_mem@xt_ldr("X0", "[SP, #0]"), asm_bl("_silica_rt_state_adopt"));
    concat(concat(concat(load, same), concat(atom_new, copy)), concat(concat(install, release), concat(adopt, concat(l_end, ":\n"))))
}


// Spec §16.2.6.4: the calling convention that a spawn of this function records. The word sits
// immediately before the function's entry: 0x5C1AC0F1 call-only ((:reply, ...)), 0x5C1AC0F2
// cast-only ((:no_reply, ...)); the runtime reads it at spawn and compares it on every call/cast.
fn behaviour_convention_prefix(return_type: string) -> string {
    t: string <- prims_record@strip_spaces_rt(return_type);
    case length_bytes(t) >= 8 and substring(t, 0, 8) == "(:reply," of {
        true -> "    .align 4\n    .4byte 0x5C1AC0F1\n";
        false -> case length_bytes(t) >= 11 and substring(t, 0, 11) == "(:no_reply," of {
            true -> "    .align 4\n    .4byte 0x5C1AC0F2\n";
            false -> ""
        }
    }
}

fn behaviour_result_move_asm(return_type: string, entry_label: string, reply_copy: string) -> string {
    t: string <- prims_record@strip_spaces_rt(return_type);
    reply_form: bool <- length_bytes(t) >= 8 and substring(t, 0, 8) == "(:reply,";
    rtype: string <- case reply_form of {
        true -> prims_tuple@tuple_type_nth_element(t, 1);
        false -> ""
    };
    stype: string <- case reply_form of {
        true -> prims_tuple@tuple_type_nth_element(t, 2);
        false -> prims_tuple@tuple_type_nth_element(t, 1)
    };
    rbytes: int64 <- composite_move_bytes(rtype);
    sbytes: int64 <- composite_move_bytes(stype);
    case rbytes <= 0 and sbytes <= 0 of {
        true -> "";
        false -> {
            soff: int64 <- case reply_form of {
                true -> 16;
                false -> 8
            };
            lbl: string <- concat("L_bmv_", entry_label);
            l_end: string <- concat(lbl, "_end");
            head: string <- concat(xt_mem@xt_str("X0", "[SP, #-16]!"), concat(asm_bl("_silica_rt_current_actor"), concat(xt_isa@xt_mov("X10", "X0"), concat(xt_mem@xt_ldr("X0", "[SP, #0]"), concat(xt_isa@xt_cbz("X10", l_end), xt_mem@xt_stp("X10", "X0", "[SP, #-16]!"))))));
            reply: string <- bmv_reply_asm(rbytes, composite_move_has_scalar_alt(rtype), sbytes, soff, concat(lbl, "_rs"), reply_copy);
            state: string <- case sbytes > 0 of {
                true -> bmv_state_asm(sbytes, composite_move_has_scalar_alt(stype), soff, lbl);
                false -> ""
            };
            tail: string <- concat(xt_mem@xt_ldp("X10", "X0", "[SP], #16"), concat(concat(l_end, ":\n"), xt_isa@xt_add("SP", "SP", "#16")));
            concat(concat(head, reply), concat(state, tail))
        }
    }
}

// Spec §15.4.7.3 / §16.3.5: a message is copied at send time. A tuple or record message travels as
// a pointer, and a literal (or a let-bound value) points into the sending function's frame region,
// so its words are copied into the heap before the runtime enqueues the pointer. One level is
// enough: nested aggregates are already heap pointers. Size: one word per element or field.
fn aggregate_message_type_bytes(type_name: string) -> int64 {
    case reg_conventions@is_tuple_type(type_name) and prims_tuple@count_type_elements(type_name) >= 2 of {
        true -> prims_tuple@count_type_elements(type_name) * 8;
        false -> case reg_conventions@is_inline_struct_type(type_name) of {
            true -> prims_record@record_type_value_flat_byte_size(type_name);
            false -> 0
        }
    }
}

fn actor_message_copy_bytes(msg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(msg);
    case n.kind == 6 and n.name == "tuple_make" of {
        true -> prims_tuple@count_flat_elements(msg) * 8;
        false -> aggregate_message_type_bytes(n.type_name)
    }
}

// The message is in X10 and the target (actor ref or registry atom) in X11; X11 is parked around
// the copy. The runtime takes X2 = 1 for a copied message (MSG_PAYLOAD_OWNED, rt_actors.S) and
// frees the copy once the receiving behaviour has returned.
// Copy on send (region design Q18, term_message_copy): a message whose type reaches a region, a
// ref or a buffer is deep-copied into a fresh owned region by L_mc_root (its shell a heap block,
// which the runtime frees after the dispatch as it frees a promoted message) instead of the
// one-level promote, unless the SIR tagged the send "|mv" (`move(x)`) or emit_sir_function found
// the send to be the operand's last use ("|_mvs="). The descriptor the copy interprets follows
// the call in .rodata.
fn send_deep_copy_asm(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
    t: string <- sir_term_root_node(sir_term_at(term, n.right_expr)).type_name;
    case term_message_copy@md_prim_value_is_move(n.value) or term_message_copy@md_site_elided(outer_reg, term.root) or term_message_copy@md_type_needs_copy(t) == false of {
        true -> "";
        false -> {
            label: string <- term_message_copy@md_site_label(term_message_copy@md_fn_label_of(outer_reg), term.root);
            call: string <- concat(xt_mem@xt_str("X11", "[SP, #-16]!"), concat(xt_isa@xt_mov("X0", "X10"), concat(term_message_copy@md_copy_call_asm(label, ""), concat(xt_isa@xt_mov("X10", "X0"), xt_mem@xt_ldr("X11", "[SP], #16")))));
            concat(call, term_message_copy@md_rodata_block(term_message_copy@md_descriptor_rodata(t, label, table)))
        }
    }
}

// The initial state is in X11 and the flat argument words in X10 (parked around the copy).
fn spawn_deep_copy_asm(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
    t: string <- sir_term_root_node(sir_term_at(term, n.inner)).type_name;
    case term_message_copy@md_prim_value_is_move(n.value) or term_message_copy@md_site_elided(outer_reg, term.root) or term_message_copy@md_type_needs_copy(t) == false of {
        true -> "";
        false -> {
            label: string <- term_message_copy@md_site_label(term_message_copy@md_fn_label_of(outer_reg), term.root);
            call: string <- concat(xt_mem@xt_str("X10", "[SP, #-16]!"), concat(xt_isa@xt_mov("X0", "X11"), concat(term_message_copy@md_copy_call_asm(label, ""), concat(xt_isa@xt_mov("X11", "X0"), xt_mem@xt_ldr("X10", "[SP], #16")))));
            concat(call, term_message_copy@md_rodata_block(term_message_copy@md_descriptor_rodata(t, label, table)))
        }
    }
}

fn actor_message_copy_x10(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, deep: string) -> string {
    nb: int64 <- actor_message_copy_bytes(sir_term_at(term, sir_term_root_node(term).right_expr));
    case length_bytes(deep) > 0 of {
        true -> deep;
        false -> case nb > 0 of {
            true -> concat(xt_mem@xt_str("X11", "[SP, #-16]!"), concat(xt_isa@xt_mov("X0", "X10"), concat(heap_promote_stack_aggregate_x0(nb), concat(xt_isa@xt_mov("X10", "X0"), xt_mem@xt_ldr("X11", "[SP], #16")))));
            false -> ""
        }
    }
}

// spawn / spawn_dangerous / spawn_device: X0 init, X1 beh, W2 core (0 default), X3 supervisor trampoline, X4 stack_policy.
// `mark` runs on the returned ref in X0 before the dest move, so ahead of any message to the actor:
// spawn_device passes the ACB device-flag call, the others pass "".
fn emit_spawn(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, mark: string, init_copy: string) -> string {
    e3b_pfx: string <- e3b_trampoline_prefix(sir_term_root_node(term).value, "X3");
    tail: string <- concat(asm_bl("_silica_rt_actor_spawn"), concat(mark, mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name)));
    case spawn_right_is_tuple(term) of {
        true -> {
            count: int64 <- spawn_right_count(term);
            loads: string <- concat(xt_isa@xt_mov("X0", "X11"), concat(xt_mem@xt_ldr("X1", "[X10]"), concat(xt_mem@xt_ldr("X4", "[X10, #8]"), spawn_core_from_flat(count, 2))));
            adopted_tail: string <- concat(asm_bl("_silica_rt_actor_spawn"), concat(spawn_adopt_asm(sir_term_at(term, sir_term_root_node(term).inner)), concat(mark, mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))));
            concat(concat(concat(concat(spawn_promote_init_x11(term), init_copy), e3b_pfx), loads), adopted_tail)
        };
        // No policy word (not reachable from source: the type checker requires one). X4 = 0 inherits.
        false -> concat(concat(e3b_pfx, concat(xt_isa@xt_mov("X0", "X9"), concat(xt_isa@xt_mov("X1", "X10"), concat(xt_isa@xt_movi("W2", 0), xt_isa@xt_movi("X4", 0))))), tail)
    }
}

// spawn_registered / spawn_dangerous_registered / spawn_device_registered: X10 -> [beh, name, policy(, core)], X11 = init;
// register_label picks the registry table (ordinary, dangerous, device).
fn emit_spawn_registered(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, register_label: string, init_copy: string) -> string {
    e3b_pfx: string <- e3b_trampoline_prefix(sir_term_root_node(term).value, "X3");
    count: int64 <- spawn_right_count(term);
    save_name: string <- concat(xt_isa@xt_sub("SP", "SP", "#16"), concat(xt_mem@xt_ldr("X12", "[X10, #8]"), xt_mem@xt_str("X12", "[SP, #8]")));
    // §20.3.1: a name a live actor already holds spawns nothing; the caller fails with :language_error.
    // X10/X11 (operand block, init) are caller-saved, so they are kept across the runtime call.
    check: string <- registry_check_asm(registry_check_label(register_label), "[X10, #8]");
    loads: string <- concat(xt_isa@xt_mov("X0", "X11"), concat(xt_mem@xt_ldr("X1", "[X10]"), concat(xt_mem@xt_ldr("X4", "[X10, #16]"), spawn_core_from_flat(count, 3))));
    spawn_asm: string <- concat(concat(e3b_pfx, loads), concat(asm_bl("_silica_rt_actor_spawn"), spawn_adopt_asm(sir_term_at(term, sir_term_root_node(term).inner))));
    save_actor: string <- xt_mem@xt_str("X0", "[SP, #0]");
    reg: string <- concat(xt_mem@xt_ldr("X1", "[SP, #8]"), concat(asm_bl(register_label), concat(xt_mem@xt_ldr("X0", "[SP, #0]"), xt_isa@xt_add("SP", "SP", "#16"))));
    concat(concat(concat(concat(concat(concat(concat(spawn_promote_init_x11(term), init_copy), check), save_name), spawn_asm), save_actor), reg), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))
}

// The pre-spawn registry check that goes with a registration entry: the same table, probed before
// the spawn (silica_rt_registry_require_free{,_dangerous,_device} in board/runtime/rt_actors.S).
fn registry_check_label(register_label: string) -> string {
    case register_label == "_silica_rt_register_dangerous_actor_named" of {
        true -> "_silica_rt_registry_require_free_dangerous";
        false -> case register_label == "_silica_rt_register_device_actor_named" of {
            true -> "_silica_rt_registry_require_free_device";
            false -> "_silica_rt_registry_require_free"
        }
    }
}

// X0 <- the name at name_slot, then the check; X10 and X11 are kept on the stack across the call.
fn registry_check_asm(check_label: string, name_slot: string) -> string {
    concat(concat(xt_isa@xt_sub("SP", "SP", "#16"), concat(xt_mem@xt_str("X10", "[SP, #0]"), xt_mem@xt_str("X11", "[SP, #8]"))), concat(concat(xt_mem@xt_ldr("X0", name_slot), asm_bl(check_label)), concat(concat(xt_mem@xt_ldr("X10", "[SP, #0]"), xt_mem@xt_ldr("X11", "[SP, #8]")), xt_isa@xt_add("SP", "SP", "#16"))))
}

// Phase C runtime supervisor startup: created with the compiler-owned first-schedule trampoline in
// X3 and no user behaviour. The trampoline calls init/1 once and materializes the returned child
// specs before spawn returns to user code.
fn emit_spawn_registered_supervisor(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    e3b_pfx: string <- e3b_trampoline_prefix(sir_term_root_node(term).value, "X3");
    count: int64 <- spawn_right_count(term);
    save_name: string <- concat(xt_isa@xt_sub("SP", "SP", "#16"), concat(xt_mem@xt_ldr("X12", "[X10]"), xt_mem@xt_str("X12", "[SP, #8]")));
    // §20.3.1: a name a live actor or supervisor already holds spawns nothing; the caller fails.
    check: string <- registry_check_asm("_silica_rt_registry_require_free", "[X10]");
    loads: string <- concat(xt_isa@xt_mov("X0", "X11"), concat(xt_isa@xt_movi("X1", 0), concat(xt_mem@xt_ldr("X4", "[X10, #8]"), spawn_core_from_flat(count, 2))));
    spawn_asm: string <- concat(concat(e3b_pfx, loads), asm_bl("_silica_rt_actor_spawn"));
    save_actor: string <- xt_mem@xt_str("X0", "[SP, #0]");
    reg: string <- concat(xt_mem@xt_ldr("X1", "[SP, #8]"), concat(asm_bl("_silica_rt_register_actor_named"), concat(xt_mem@xt_ldr("X0", "[SP, #0]"), xt_isa@xt_add("SP", "SP", "#16"))));
    concat(concat(concat(concat(concat(check, save_name), spawn_asm), save_actor), reg), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))
}

// stack_policy(reserve, release) -> one word: (reserve rounded up to 16) | algorithm index. The
// release atom is a literal (the type checker requires one), so the index is fixed here.
fn release_algorithm_index(lexeme: string) -> int64 {
    case lexeme of {
        ":release_on_return" -> 1;
        "release_on_return" -> 1;
        ":keep_last_message" -> 2;
        "keep_last_message" -> 2;
        ":track_recent_peak" -> 3;
        "track_recent_peak" -> 3;
        ":release_when_idle" -> 4;
        "release_when_idle" -> 4;
        ":keep_high_water" -> 5;
        "keep_high_water" -> 5;
        _: string -> 0
    }
}

fn emit_stack_policy(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    alg: int64 <- release_algorithm_index(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).value);
    pack: string <- concat(xt_isa@xt_add("X9", "X9", "#15"), concat(xt_isa@xt_movi("X10", 0 - 16), concat(xt_isa@xt_and("X9", "X9", "X10"), concat(xt_isa@xt_movi("X10", alg), xt_isa@xt_orr("X9", "X9", "X10")))));
    case gpr_x_view(dest) == "X9" of {
        true -> pack;
        false -> concat(pack, xt_isa@xt_mov(gpr_x_view(dest), "X9"))
    }
}

// Target in X11, message in X10, W2 = 1 when the message is a copy the receiver frees.
fn emit_message_binary(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, label: string, deep: string) -> string {
    owned: int64 <- case actor_message_copy_bytes(sir_term_at(term, sir_term_root_node(term).right_expr)) > 0 or length_bytes(deep) > 0 of {
        true -> 1;
        false -> 0
    };
    concat(actor_message_copy_x10(term, deep), concat(xt_isa@xt_mov("X0", "X11"), concat(xt_isa@xt_mov("X1", "X10"), concat(xt_isa@xt_movi("W2", owned), concat(asm_bl(label), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))))))
}

fn emit_supervisor_add_child(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    concat(xt_isa@xt_mov("X0", "X11"), concat(xt_isa@xt_mov("X1", "X10"), concat(asm_bl("_silica_rt_supervisor_add_child"), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))))
}

fn runtime_label(name: string) -> string {
    case name of {
        "recv" -> "_silica_rt_actor_recv";
        "self" -> "_silica_rt_actor_self";
        "add_child" -> "_silica_rt_actor_add_child";
        "supervision_ingress_enqueue" -> "_silica_rt_actor_supervision_ingress_enqueue";
        "supervision_wait_and_drain_one" -> "_silica_rt_actor_supervision_wait_and_drain_one";
        "child_table_first_ref" -> "_silica_rt_child_table_first_ref";
        "child_table_row_ref" -> "_silica_rt_child_table_row_ref";
        "failure_reason_tag" -> "_silica_rt_actor_failure_reason_tag";
        "failure_reason_atom" -> "_silica_rt_actor_failure_reason_atom";
        "failure_agent_type" -> "_silica_rt_actor_failure_agent_type";
        "failure_release" -> "_silica_rt_actor_failure_release";
        "link" -> "_silica_rt_actor_link";
        "monitor" -> "_silica_rt_actor_monitor";
        "demonitor" -> "_silica_rt_actor_demonitor";
        "get_cpu_topology" -> "_silica_rt_get_cpu_topology";
        "get_efficiency_cores" -> "_silica_rt_get_efficiency_cores";
        "get_performance_cores" -> "_silica_rt_get_performance_cores";
        "get_core_capabilities" -> "_silica_rt_get_core_capabilities";
        "pin_actor_to_core" -> "_silica_rt_pin_actor_to_core";
        "pin_actor_to_efficiency_core" -> "_silica_rt_pin_actor_to_efficiency_core";
        "pin_actor_to_performance_core" -> "_silica_rt_pin_actor_to_performance_core";
        "pin_actor_realtime" -> "_silica_rt_pin_actor_realtime";
        "remove_actor" -> "_silica_rt_remove_actor";
        "register_actor" -> "_silica_rt_register_actor";
        "get_registry_actor" -> "_silica_rt_get_registry_actor";
        "get_pid_registry" -> "_silica_rt_get_registry_actor";
        "pin_actor_to_numa_node" -> "_silica_rt_pin_actor_to_numa_node";
        "unpin_actor" -> "_silica_rt_unpin_actor";
        "set_actor_priority" -> "_silica_rt_set_actor_priority";
        "set_scheduler_policy" -> "_silica_rt_set_scheduler_policy";
        "get_actor_memory_usage" -> "_silica_rt_get_actor_memory_usage";
        "migrate_actor" -> "_silica_rt_migrate_actor";
        "start_child" -> "_silica_rt_supervisor_start_child";
        "supervisor_add_child" -> "_silica_rt_supervisor_add_child";
        "supervisor_remove_child" -> "_silica_rt_supervisor_remove_child";
        "supervisor_restart_child" -> "_silica_rt_supervisor_restart_child";
        "supervisor_terminate_child" -> "_silica_rt_supervisor_terminate_child";
        "supervisor_set_report_sink" -> "_silica_rt_supervisor_set_report_sink";
        // The reply fields of the three operations above, chosen from the operation's answer
        // (terms_actor_lowering build_call_supervisor_op_reply; -2 = the error reply;
        // board/runtime/rt_supervisors.S).
        "supervisor_op_tag" -> "_silica_rt_sup_op_tag";
        "supervisor_op_error" -> "_silica_rt_sup_op_error";
        "supervisor_op_child" -> "_silica_rt_sup_op_child";
        "supervisor_which_children" -> "_silica_rt_supervisor_which_children";
        "supervisor_count_children" -> "_silica_rt_supervisor_count_children";
        "supervisor_get_child" -> "_silica_rt_supervisor_get_child";
        "supervisor_get_child_info" -> "_silica_rt_supervisor_get_child_info";
        "supervisor_get_child_id" -> "_silica_rt_supervisor_get_child_id";
        "supervisor_get_child_agent_type" -> "_silica_rt_supervisor_get_child_agent_type";
        "supervisor_get_child_restart" -> "_silica_rt_supervisor_get_child_restart";
        "kill_abnormal" -> "_silica_rt_actor_kill_abnormal";
        "stop_self_normal" -> "_silica_rt_stop_self_normal";
        "stop_self_explicit" -> "_silica_rt_stop_self_explicit";
        "fail_self" -> "_silica_rt_fail_self";
        "register_failure_reporter" -> "_silica_rt_failure_reporter_register";
        "wait_for_exit" -> "_silica_rt_wait_for_exit";
        "cast_exit" -> "_silica_rt_cast_exit";
        "heap_used" -> "_silica_rt_heap_used";
        // Clocks and timers (spec §22.14; prims_actors_timer_asm).
        "monotonic_time" -> "_silica_rt_monotonic_time";
        "current_time" -> "_silica_rt_current_time";
        "send_after" -> "_silica_rt_send_after";
        "timer_cast" -> "_silica_rt_timer_prepare";
        "cancel_timer" -> "_silica_rt_cancel_timer";
        _: string -> "_silica_rt_actor_unknown"
    }
}

fn emit_runtime_nullary(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    concat(asm_bl(runtime_label(sir_term_root_node(term).name)), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))
}

// The caller's module for an unqualified local call: outer_reg carries |_lm=module (emitter_core);
// `main` is the fallback, as in module_linkage@asm_linkage_symbol_for_call.
fn caller_module_from_outer_reg(outer_reg: string) -> string {
    lm: string <- var@find_sp_binding(outer_reg, "_lm");
    case length_bytes(lm) > 0 of {
        true -> lm;
        false -> "main"
    }
}

// register_failure_reporter(fr): region_dump_limit() (the FailureReporter trait method) is called
// first and cached in the runtime; X9 (the reporter) is parked around the two calls.
fn emit_register_failure_reporter(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, caller_module: string) -> string {
    rdl_label: string <- module_linkage@asm_symbol_for_definition(caller_module, "region_dump_limit");
    save: string <- concat(xt_isa@xt_sub("SP", "SP", "#16"), xt_mem@xt_str("X9", "[SP, #0]"));
    call_rdl: string <- concat(asm_bl(rdl_label), asm_bl("_silica_rt_failure_reporter_set_dump_limit"));
    restore: string <- concat(xt_mem@xt_ldr("X9", "[SP, #0]"), xt_isa@xt_add("SP", "SP", "#16"));
    reg: string <- concat(xt_isa@xt_mov("X0", "X9"), asm_bl("_silica_rt_failure_reporter_register"));
    concat(concat(concat(concat(save, call_rdl), restore), reg), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))
}

fn emit_runtime_unary(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    concat(xt_isa@xt_mov("X0", "X9"), concat(asm_bl(runtime_label(sir_term_root_node(term).name)), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name)))
}

fn emit_kill_abnormal_named(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    concat(xt_isa@xt_mov("X0", "X9"), concat(asm_bl("_silica_rt_actor_kill_abnormal_named"), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name)))
}

fn emit_runtime_binary(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    concat(xt_isa@xt_mov("X0", "X9"), concat(xt_isa@xt_mov("X1", "X10"), concat(asm_bl(runtime_label(sir_term_root_node(term).name)), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))))
}

// migrate_actor(ref, core) -> :ok | :invalid_target | :actor_not_found | :migration_blocked
// (spec §15.1.2, §22.10). The runtime returns a code, 0..3 in that order, because atom indices are
// per executable; this site maps the code to the program's own indices (an atom the program never
// names has index -1, which no case arm matches).
// The builtins whose spec result is only ever :ok (spec §15.4.8, §20.3, §22.4): link, demonitor,
// add_child, kill_abnormal, register_failure_reporter, unpin_actor, register_actor, and the trial
// hooks failure_release and supervision_ingress_enqueue. The runtime returns 0 from each; the atom
// is answered here. Before 2026-10-09 the program received that 0, which is :efficiency, the first
// atom of the fixed prefix (atoms/atom_table.silica seed_actor_runtime_atoms).
// ---- Clocks and timers (spec §22.14) ----------------------------------------------------------
// timer_cast(target, message) is the inner half of send_after: the target is in X11 and the
// message in X10, copied by the cast rules (actor_message_copy_x10 / send_deep_copy_asm, exactly
// as emit_message_binary). The runtime gets X0 = the target's identity, X1 = the message, X2 =
// (low word a6) the owned-payload flag of a copied record or tuple, as a cast passes it, and (high
// word a7) the release thunk, 0 when the message type carries no owned region; it answers the
// prepared timer record, an int64 word the outer send_after prim hands on together with the delay.
//
// The release thunk is what a cancelled or dropped timer runs instead of the receiver's dispatch:
// the behaviour would have destroyed the message record's top-level region fields at its return
// (term_message_regions, region design §18.7), so the thunk destroys the same fields. It is emitted
// in line, jumped over, and named per site; the runtime calls it with callx8 (a2 = the message).
fn timer_release_thunk_label(outer_reg: string, root: int64) -> string {
    concat("L_tr_", concat(term_message_copy@md_fn_label_of(outer_reg), concat("_", atom_table@int64_to_decimal_string(root))))
}

fn tr_find_comma(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> i;
        false -> case substring(s, i, i + 1) == "," of {
            true -> i;
            false -> tr_find_comma(s, i + 1)
        }
    }
}

// offs is ",8,24,": one load (the handle's low word) and one region destroy per boxed field offset.
fn timer_thunk_destroy_lines(offs: string, i: int64, acc: string) -> string {
    case i >= length_bytes(offs) of {
        true -> acc;
        false -> case substring(offs, i, i + 1) == "," of {
            true -> timer_thunk_destroy_lines(offs, i + 1, acc);
            false -> {
                e: int64 <- tr_find_comma(offs, i);
                timer_thunk_destroy_lines(offs, e, concat(acc, concat("    l32i a10, a2, ", concat(substring(offs, i, e), "\n    movi a11, 0\n    call8 silica_rt_region_destroy\n"))))
            }
        }
    }
}

// The thunk's address goes into a7, X2's high word, after xt_movi has set the low word (a6).
fn timer_release_thunk_asm(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string) -> string {
    t: string <- sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).type_name;
    offs: string <- term_message_regions@tmr_message_record_offsets(t);
    case length_bytes(offs) == 0 of {
        true -> "    movi a7, 0\n";
        false -> {
            lbl: string <- timer_release_thunk_label(outer_reg, term.root);
            head: string <- concat(xt_isa@xt_b(concat(lbl, "_skip")), concat("    .align 4\n", concat(lbl, ":\n    entry a1, 32\n")));
            tail: string <- concat("    retw\n", concat(lbl, concat("_skip:\n    movi a7, ", concat(lbl, "\n"))));
            concat(head, concat(timer_thunk_destroy_lines(offs, 0, ""), tail))
        }
    }
}

fn emit_timer_cast(dest: string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, deep: string, thunk: string) -> string {
    owned: int64 <- case actor_message_copy_bytes(sir_term_at(term, sir_term_root_node(term).right_expr)) > 0 or length_bytes(deep) > 0 of {
        true -> 1;
        false -> 0
    };
    concat(actor_message_copy_x10(term, deep), concat(xt_isa@xt_mov("X0", "X11"), concat(xt_isa@xt_mov("X1", "X10"), concat(xt_isa@xt_movi("W2", owned), concat(thunk, concat(asm_bl("_silica_rt_timer_prepare"), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name)))))))
}

// cancel_timer(timer) -> :cancelled | :not_found (spec §22.14.2): the runtime answers 0 or 1.
fn emit_cancel_timer(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    c_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":cancelled");
    nf_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":not_found");
    call_asm: string <- concat(xt_isa@xt_mov("X0", "X9"), asm_bl("_silica_rt_cancel_timer"));
    nf_sel: string <- case nf_idx < 0 of {
        true -> "";
        false -> xt_isa@xt_cmp_select("X12", imm_of_index(nf_idx), "X12", "EQ", "X0", "#1")
    };
    map_asm: string <- concat(xt_isa@xt_movi("X12", c_idx), nf_sel);
    concat(concat(call_asm, map_asm), xt_isa@xt_mov(gpr_x_view(dest), "X12"))
}

fn always_ok_prim(name: string) -> boolean {
    name == "link" or name == "demonitor" or name == "add_child" or name == "kill_abnormal" or name == "stop_self_normal" or name == "stop_self_explicit" or name == "register_failure_reporter" or name == "unpin_actor" or name == "register_actor" or name == "failure_release" or name == "supervision_ingress_enqueue"
}

fn imm_of_index(n: int64) -> string {
    concat("#", atom_table@int64_to_decimal_string(n))
}

// The actor-boundary operands (region design Q18): the copy decisions need the function's markers
// (outer_reg) and the atom table (sum tags and record shapes in the descriptors).
fn emit_prim_op_with_atoms(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, outer_reg: string) -> string {
    case sir_term_root_node(term).name of {
        "send" -> emit_message_binary(dest, term, "_silica_rt_actor_send", send_deep_copy_asm(term, outer_reg, table));
        "actor_call" -> emit_message_binary(dest, term, "_silica_rt_actor_call", send_deep_copy_asm(term, outer_reg, table));
        "actor_call_registered" -> emit_message_binary(dest, term, "_silica_rt_actor_call_registered", send_deep_copy_asm(term, outer_reg, table));
        "actor_cast" -> emit_message_binary(dest, term, "_silica_rt_actor_cast", send_deep_copy_asm(term, outer_reg, table));
        "timer_cast" -> emit_timer_cast(dest, term, send_deep_copy_asm(term, outer_reg, table), timer_release_thunk_asm(term, outer_reg));
        "cancel_timer" -> emit_cancel_timer(term, dest, table);
        "actor_cast_device" -> emit_message_binary(dest, term, "_silica_rt_actor_cast", send_deep_copy_asm(term, outer_reg, table));
        "actor_cast_registered" -> emit_message_binary(dest, term, "_silica_rt_actor_cast_registered", send_deep_copy_asm(term, outer_reg, table));
        "actor_cast_dangerous_registered" -> emit_message_binary(dest, term, "_silica_rt_actor_cast_dangerous_registered", send_deep_copy_asm(term, outer_reg, table));
        "actor_cast_device_registered" -> emit_message_binary(dest, term, "_silica_rt_actor_cast_device_registered", send_deep_copy_asm(term, outer_reg, table));
        "spawn" -> emit_spawn(dest, term, "", spawn_deep_copy_asm(term, outer_reg, table));
        "spawn_dangerous" -> emit_spawn(dest, term, "", spawn_deep_copy_asm(term, outer_reg, table));
        "spawn_device" -> emit_spawn(dest, term, asm_bl("silica_rt_actor_mark_device"), spawn_deep_copy_asm(term, outer_reg, table));
        "spawn_registered" -> emit_spawn_registered(dest, term, "_silica_rt_register_actor_named", spawn_deep_copy_asm(term, outer_reg, table));
        "spawn_dangerous_registered" -> emit_spawn_registered(dest, term, "_silica_rt_register_dangerous_actor_named", spawn_deep_copy_asm(term, outer_reg, table));
        "spawn_device_registered" -> emit_spawn_registered(dest, term, "_silica_rt_register_device_actor_named", spawn_deep_copy_asm(term, outer_reg, table));
        _: string -> emit_prim_op_with_atoms_rest(term, dest, table, outer_reg)
    }
}

fn emit_prim_op_with_atoms_rest(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, outer_reg: string) -> string {
    // register_failure_reporter calls the caller unit's region_dump_limit, so its label needs the
    // caller's module: outer_reg carries |_lm=module (emitter_core), as for any unqualified local call.
    case sir_term_root_node(term).name == "register_failure_reporter" of {
        true -> emit_register_failure_reporter(dest, term, caller_module_from_outer_reg(outer_reg));
        false -> case sir_term_root_node(term).name == "migrate_actor" of {
            true -> {
                ok_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":ok");
                inv_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":invalid_target");
                nf_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":actor_not_found");
                blk_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":migration_blocked");
                call_asm: string <- concat(xt_isa@xt_mov("X0", "X9"), concat(xt_isa@xt_mov("X1", "X10"), asm_bl("_silica_rt_migrate_actor")));
                map_asm: string <- concat(xt_isa@xt_movi("X12", ok_idx), concat(xt_isa@xt_cmp_select("X12", imm_of_index(inv_idx), "X12", "EQ", "X0", "#1"), concat(xt_isa@xt_cmp_select("X12", imm_of_index(nf_idx), "X12", "EQ", "X0", "#2"), xt_isa@xt_cmp_select("X12", imm_of_index(blk_idx), "X12", "EQ", "X0", "#3"))));
                concat(concat(call_asm, map_asm), xt_isa@xt_mov(gpr_x_view(dest), "X12"))
            };
            false -> case sir_term_root_node(term).name == "set_scheduler_policy" of {
                true -> emit_set_scheduler_policy(term, dest, table);
                false -> case sir_term_root_node(term).name == "set_actor_priority" of {
                    true -> emit_set_actor_priority(term, dest, table);
                    false -> case always_ok_prim(sir_term_root_node(term).name) of {
                        true -> concat(emit_prim_op(term, dest), xt_isa@xt_movi(gpr_x_view(dest), atom_table@atom_lexeme_to_index(table, ":ok")));
                        false -> emit_prim_op(term, dest)
                    }
                }
            }
        }
    }
}

// set_actor_priority(ref, level) -> :ok | :actor_not_found (spec §22.10: level is the atom type
// priority_level = :low | :normal | :high). The level atom is in X10 and the runtime wants 0 low, 1
// normal, 2 high in X1, so the program's atom indices are mapped to the levels here (an unknown atom is
// normal, as the runtime treats any other value); the runtime's 0 / 1 result is mapped back. Before
// 2026-09-28 the atom index itself went to the runtime, which clamped every index above 2 to normal.
fn level_atom_to_code(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, lexeme: string, code: int64) -> string {
    idx: int64 <- atom_table@atom_lexeme_to_index(table, lexeme);
    case idx < 0 of {
        true -> "";
        false -> xt_isa@xt_cmp_select("X1", imm_of_index(code), "X1", "EQ", "X10", imm_of_index(idx))
    }
}

fn emit_set_actor_priority(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    ok_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":ok");
    nf_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":actor_not_found");
    to_code: string <- concat(xt_isa@xt_movi("X1", 1), concat(level_atom_to_code(table, ":low", 0), level_atom_to_code(table, ":high", 2)));
    call_asm: string <- concat(xt_isa@xt_mov("X0", "X9"), asm_bl("_silica_rt_set_actor_priority"));
    map_asm: string <- concat(xt_isa@xt_movi("X12", ok_idx), xt_isa@xt_cmp_select("X12", imm_of_index(nf_idx), "X12", "EQ", "X0", "#1"));
    concat(concat(concat(to_code, call_asm), map_asm), xt_isa@xt_mov(gpr_x_view(dest), "X12"))
}

// set_scheduler_policy(policy) -> :ok | :invalid_policy: the dispatch-order policy of every core's
// ready queues (design_documents/ports/esp32s3_xtensa_port.md §8.10). The policy atom arrives in X9;
// the runtime takes a code (0 :priority_fifo, 1 :round_robin, 2 :weighted_fair, 3 :lottery, anything
// else rejected) and answers 0 :ok or 1 :invalid_policy, so this site maps the program's atom indices
// to the codes before the call and the code back to an atom after it. An atom the program never
// names has index -1 and gets no compare (X9 cannot hold it); the code then stays 4, rejected.
fn policy_atom_to_code(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, lexeme: string, code: int64) -> string {
    idx: int64 <- atom_table@atom_lexeme_to_index(table, lexeme);
    case idx < 0 of {
        true -> "";
        false -> xt_isa@xt_cmp_select("X0", imm_of_index(code), "X0", "EQ", "X9", imm_of_index(idx))
    }
}

fn emit_set_scheduler_policy(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    ok_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":ok");
    inv_idx: int64 <- atom_table@atom_lexeme_to_index(table, ":invalid_policy");
    to_code: string <- concat(xt_isa@xt_movi("X0", 4), concat(concat(policy_atom_to_code(table, ":priority_fifo", 0), policy_atom_to_code(table, ":round_robin", 1)), concat(policy_atom_to_code(table, ":weighted_fair", 2), policy_atom_to_code(table, ":lottery", 3))));
    call_asm: string <- asm_bl("_silica_rt_set_scheduler_policy");
    map_asm: string <- concat(xt_isa@xt_movi("X12", ok_idx), xt_isa@xt_cmp_select("X12", imm_of_index(inv_idx), "X12", "EQ", "X0", "#1"));
    concat(concat(concat(to_code, call_asm), map_asm), xt_isa@xt_mov(gpr_x_view(dest), "X12"))
}

fn emit_prim_op(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    case sir_term_root_node(term).name of {
        "spawn" -> emit_spawn(dest, term, "", "");
        "spawn_dangerous" -> emit_spawn(dest, term, "", "");
        "spawn_registered" -> emit_spawn_registered(dest, term, "_silica_rt_register_actor_named", "");
        "spawn_dangerous_registered" -> emit_spawn_registered(dest, term, "_silica_rt_register_dangerous_actor_named", "");
        "spawn_device" -> emit_spawn(dest, term, asm_bl("silica_rt_actor_mark_device"), "");
        "spawn_device_registered" -> emit_spawn_registered(dest, term, "_silica_rt_register_device_actor_named", "");
        "spawn_registered_supervisor" -> emit_spawn_registered_supervisor(dest, term);
        "spawn_linked" -> emit_spawn_linked(dest, term);
        "send" -> emit_message_binary(dest, term, "_silica_rt_actor_send", "");
        "actor_call" -> emit_message_binary(dest, term, "_silica_rt_actor_call", "");
        "actor_call_registered" -> emit_message_binary(dest, term, "_silica_rt_actor_call_registered", "");
        "actor_cast" -> emit_message_binary(dest, term, "_silica_rt_actor_cast", "");
        "actor_cast_device" -> emit_message_binary(dest, term, "_silica_rt_actor_cast", "");
        "actor_cast_registered" -> emit_message_binary(dest, term, "_silica_rt_actor_cast_registered", "");
        "actor_cast_dangerous_registered" -> emit_message_binary(dest, term, "_silica_rt_actor_cast_dangerous_registered", "");
        "actor_cast_device_registered" -> emit_message_binary(dest, term, "_silica_rt_actor_cast_device_registered", "");
        "self" -> emit_runtime_nullary(dest, term);
        "recv" -> emit_runtime_nullary(dest, term);
        "link" -> emit_runtime_unary(dest, term);
        "add_child" -> emit_runtime_binary(dest, term);
        "monitor" -> emit_runtime_unary(dest, term);
        "demonitor" -> emit_runtime_unary(dest, term);
        "supervision_ingress_enqueue" -> emit_runtime_binary(dest, term);
        "supervision_wait_and_drain_one" -> emit_runtime_nullary(dest, term);
        "child_table_first_ref" -> emit_runtime_nullary(dest, term);
        "child_table_row_ref" -> emit_runtime_unary(dest, term);
        "failure_reason_tag" -> emit_runtime_unary(dest, term);
        "failure_reason_atom" -> emit_runtime_unary(dest, term);
        "failure_agent_type" -> emit_runtime_unary(dest, term);
        "failure_release" -> emit_runtime_unary(dest, term);
        "get_cpu_topology" -> emit_runtime_nullary(dest, term);
        "get_efficiency_cores" -> emit_runtime_nullary(dest, term);
        "get_performance_cores" -> emit_runtime_nullary(dest, term);
        "get_core_capabilities" -> emit_runtime_unary(dest, term);
        "pin_actor_to_core" -> emit_runtime_binary(dest, term);
        "pin_actor_to_efficiency_core" -> emit_runtime_unary(dest, term);
        "pin_actor_to_performance_core" -> emit_runtime_unary(dest, term);
        "pin_actor_realtime" -> emit_runtime_binary(dest, term);
        "remove_actor" -> emit_runtime_unary(dest, term);
        "register_actor" -> emit_runtime_unary(dest, term);
        "get_registry_actor" -> emit_runtime_nullary(dest, term);
        "get_pid_registry" -> emit_runtime_nullary(dest, term);
        "pin_actor_to_numa_node" -> emit_runtime_binary(dest, term);
        "unpin_actor" -> emit_runtime_unary(dest, term);
        "set_actor_priority" -> emit_runtime_binary(dest, term);
        "set_scheduler_policy" -> emit_runtime_unary(dest, term);
        "get_actor_memory_usage" -> emit_runtime_unary(dest, term);
        "migrate_actor" -> emit_runtime_binary(dest, term);
        "start_child" -> emit_runtime_unary(dest, term);
        "supervisor_add_child" -> emit_supervisor_add_child(dest, term);
        "supervisor_remove_child" -> emit_runtime_binary(dest, term);
        "supervisor_restart_child" -> emit_runtime_binary(dest, term);
        "supervisor_terminate_child" -> emit_runtime_binary(dest, term);
        "supervisor_set_report_sink" -> emit_runtime_binary(dest, term);
        "supervisor_op_tag" -> emit_runtime_binary(dest, term);
        "supervisor_op_error" -> emit_runtime_binary(dest, term);
        "supervisor_op_child" -> emit_runtime_unary(dest, term);
        "supervisor_which_children" -> emit_runtime_unary(dest, term);
        "supervisor_count_children" -> emit_runtime_unary(dest, term);
        "supervisor_get_child" -> emit_runtime_binary(dest, term);
        "supervisor_get_child_info" -> emit_runtime_binary(dest, term);
        "supervisor_get_child_id" -> emit_runtime_binary(dest, term);
        "supervisor_get_child_agent_type" -> emit_runtime_binary(dest, term);
        "supervisor_get_child_restart" -> emit_runtime_binary(dest, term);
        // An identity can be numerically small, so the runtime can no longer tell an atom from a
        // reference by its value (spec 15.1.4): the atom form has its own entry.
        "kill_abnormal" -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name == "actor_ref" of {
            true -> emit_runtime_unary(dest, term);
            false -> emit_kill_abnormal_named(dest, term)
        };
        // §15.1.2.3: stop_self ends the calling actor at its next dispatch boundary (the runtime answers 0,
        // the atom :ok is answered above); fail_self never returns, so nothing after its call matters.
        "stop_self_normal" -> emit_runtime_nullary(dest, term);
        "stop_self_explicit" -> emit_runtime_unary(dest, term);
        "fail_self" -> emit_runtime_unary(dest, term);
        "register_failure_reporter" -> emit_register_failure_reporter(dest, term, "main");
        "wait_for_exit" -> emit_runtime_nullary(dest, term);
        "cast_exit" -> emit_runtime_unary(dest, term);
        "heap_used" -> emit_runtime_nullary(dest, term);
        // Clocks and timers (spec §22.14): the clocks are nullary, send_after takes the delay (X9) and
        // the prepared timer record (X10), timer_cast is a message prim (its atom-free form here),
        // cancel_timer is answered with atoms above.
        "monotonic_time" -> emit_runtime_nullary(dest, term);
        "current_time" -> emit_runtime_nullary(dest, term);
        "send_after" -> emit_runtime_binary(dest, term);
        "timer_cast" -> emit_timer_cast(dest, term, "", "    movi a7, 0\n");
        "cancel_timer" -> emit_runtime_unary(dest, term);
        "stack_policy" -> emit_stack_policy(dest, term);
        _: string -> concat(concat("    # unsupported actor prim: ", sir_term_root_node(term).name), "\n")
    }
}
