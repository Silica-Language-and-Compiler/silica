// Compound kind emission part2 (open-recursive via emit_child).

use atom_table;
use prims;
use prims_memory;
use prims_device;
use prims_ordering_identity;
use prims_collection_result;
use prims_checked_int64;
use prims_list;
use prims_string;
use reg_conventions;
use term_aggregate_helpers;
use term_sir_helpers;
use term_emit_kind_compound_part3;
use xt_isa;
use xt_mem;

export emit_kind_compound_part2/6;


// Removes spaces, tabs and newlines so a one-instruction operand emission can be
// recognised regardless of the surrounding formatting. Bounded by the caller to
// short strings, so the per-character walk stays shallow.
fn asm_squeeze_from(s: string, i: int64, n: int64, acc: string) -> string {
    case i >= n of {
        true -> acc;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == " " or c == "\n" or c == "\t" of {
                true -> asm_squeeze_from(s, i + 1, n, acc);
                false -> asm_squeeze_from(s, i + 1, n, concat(acc, c))
            }
        }
    }
}

fn asm_is_exactly(s: string, expect: string) -> boolean {
    case length_bytes(s) > 160 of {
        true -> false;
        false -> asm_squeeze_from(s, 0, length_bytes(s), "") == asm_squeeze_from(expect, 0, length_bytes(expect), "")
    }
}

// True when the operand emission is exactly what xt_mov("X1", Xn) produces for some n other than 1 or 2
// (the Xtensa spelling of `MOV X1, Xn`): the candidates are tried one by one.
fn asm_is_simple_mov_to_x1_from(q: string, n: int64) -> boolean {
    case n > 28 of {
        true -> false;
        false -> case n == 1 or n == 2 of {
            true -> asm_is_simple_mov_to_x1_from(q, n + 1);
            false -> {
                cand: string <- xt_isa@xt_mov("X1", concat("X", atom_table@int64_to_decimal_string(n)));
                case q == asm_squeeze_from(cand, 0, length_bytes(cand), "") of {
                    true -> true;
                    false -> asm_is_simple_mov_to_x1_from(q, n + 1)
                }
            }
        }
    }
}

fn asm_is_simple_mov_to_x1(s: string) -> boolean {
    case length_bytes(s) > 160 of {
        true -> false;
        false -> asm_is_simple_mov_to_x1_from(asm_squeeze_from(s, 0, length_bytes(s), ""), 0)
    }
}

// alloc_ref / alloc_buf / write_ref and friends take the region-or-pointer in X1
// and the value in X2, and normally emit arg1 (into X1) before arg2 (into X2).
// When the value operand is read out of X1 -- which is exactly where the ABI puts
// a second function parameter -- emitting arg1 first overwrites the value before
// arg2 copies it, and the prim stores the pointer instead of the value. In that
// shape both operands are single register moves, so emitting them in the other
// order is equivalent and safe. Same precaution list_cons takes above; the
// buf_store case below deliberately keeps arg1 first for the opposite hazard, so
// the reorder is deliberately restricted to this one recognisable pattern.
fn args_x1_x2_ordered(arg1_asm: string, arg2_asm: string) -> string {
    case asm_is_exactly(arg2_asm, xt_isa@xt_mov("X2", "X1")) and asm_is_simple_mov_to_x1(arg1_asm) of {
        true -> concat(concat(arg2_asm, "\n"), concat(arg1_asm, "\n"));
        false -> concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n"))
    }
}

// True when evaluating the term cannot disturb X1: constants, variables, and tuple_make /
// integer arithmetic over those (which stage through X9/X10/X16 only).
fn buf_store_child_is_make(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> boolean {
    case idx < 0 of {
        true -> false;
        false -> {
            c: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(t, idx));
            c.kind == 6 and (c.name == "tuple_make" or c.name == "record_make")
        }
    }
}

fn buf_store_arg_is_plain(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case t.root < 0 of {
        true -> true;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(t);
            case n.kind == 0 or n.kind == 1 of {
                true -> true;
                // An aggregate operand is not plain: the make is heap-promoted (BL
                // _silica_rt_region_alloc, then a copy through X1), so the buffer staged in X1 was
                // replaced by the value's address and write_buf(buf, 0, (7, 11)) bounds-checked
                // [value - 8] (trials/memory_region_addition/buf_flat_tuple_in_actor).
                false -> case n.kind == 6 and (n.name == "tuple_make" or n.name == "add" or n.name == "sub" or n.name == "mul") and buf_store_child_is_make(t, n.inner) == false and buf_store_child_is_make(t, n.right_expr) == false of {
                    true -> buf_store_arg_is_plain(term_sir_helpers@sir_term_at(t, n.inner)) and buf_store_arg_is_plain(term_sir_helpers@sir_term_at(t, n.right_expr));
                    false -> false
                }
            }
        }
    }
}

fn join_list_arg_op(arg: string, op: string) -> string {
    concat(concat(arg, "\n"), op)
}

fn emit_list_length_lit(dest: string) -> string {
    concat(concat(xt_isa@xt_mov("X0", "X9"), xt_isa@xt_call("silica_rt_list_length")), case dest == "X0" of {
        true -> "";
        false -> xt_isa@xt_mov(dest, "X0")
    })
}

fn emit_list_tail_lit(dest: string, es: int64, cd: int64) -> string {
    concat(xt_isa@xt_mov("X0", "X9"), concat(xt_isa@xt_mov("X1", concat("#", atom_table@int64_to_decimal_string(es))), concat(xt_isa@xt_mov("X2", concat("#", atom_table@int64_to_decimal_string(cd))), concat(xt_isa@xt_call("silica_rt_list_tail"), concat("\n", case dest == "X0" of {
        true -> "";
        false -> xt_isa@xt_mov(dest, "X0")
    })))))
}

fn emit_list_head_lit(dest: string, is_agg: boolean) -> string {
    case is_agg of {
        true -> concat(xt_mem@xt_ldr("X10", "[X9, #8]"), concat(xt_mem@xt_ldr("X11", "[X9, #16]"), concat(xt_isa@xt_add("X10", "X10", "X11"), xt_isa@xt_mov(dest, "X10"))));
        false -> concat(xt_mem@xt_ldr("X10", "[X9, #8]"), concat(xt_mem@xt_ldr("X11", "[X9, #16]"), concat(xt_isa@xt_add("X10", "X10", "X11"), xt_mem@xt_ldr(dest, "[X10]"))))
    }
}

// Device prims (prims_device): the window or a computed map_device base goes to X1, a poke value to X2.
// A constant map_device base is not emitted; the prim reads it from the SIR node. The poke value is the
// tuple_make's second element; its offset constant is read from the node, so no tuple slab is built.
// A value whose evaluation could disturb X1 is emitted with X1 parked on the stack, as buf_store does.
fn emit_device_prim(bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    name: string <- term_sir_helpers@sir_term_root_node(term).name;
    op_asm: string <- prims_device@emit_prim_op_with_atoms(term, dest, pools.table);
    case name == "map_device" and prims_device@map_device_base_is_constant(term) of {
        true -> op_asm;
        false -> {
            arg1_asm: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
            case name == "poke" of {
                false -> concat(concat(arg1_asm, "\n"), op_asm);
                true -> {
                    value_t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- prims_device@poke_value_term(term);
                    arg2_asm: string <- emit_child(value_t, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
                    case buf_store_arg_is_plain(value_t) of {
                        true -> concat(args_x1_x2_ordered(arg1_asm, arg2_asm), op_asm);
                        false -> concat(concat(concat(arg1_asm, "\n"), xt_mem@xt_str("X1", "[SP, #-16]!")), concat(concat(arg2_asm, "\n"), concat(xt_mem@xt_ldr("X1", "[SP], #16"), op_asm)))
                    }
                }
            }
        }
    }
}

fn emit_list_unary(bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greate