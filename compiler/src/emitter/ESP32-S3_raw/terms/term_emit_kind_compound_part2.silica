t: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    is_len: boolean <- term_sir_helpers@sir_term_root_node(term).name == "list_length";
    is_tail: boolean <- term_sir_helpers@sir_term_root_node(term).name == "list_remove_head";
    is_head: boolean <- term_sir_helpers@sir_term_root_node(term).name == "list_head";
    es: int64 <- prims_list@chunk_elem_slot_bytes_from_list_t(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
    cd: int64 <- prims_list@chunk_data_bytes_from_list_t(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
    // Boxed layout (prims_record header): only a child-spec element is spliced into its cell;
    // every other aggregate element is a pointer word and `.head` loads it like a scalar.
    head_is_agg: boolean <- prims_list@list_elem_is_inline_aggregate(term_sir_helpers@sir_term_root_node(term).type_name);
    join_list_arg_op(emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug }), case is_len of {
        true -> emit_list_length_lit(dest);
        false -> case is_tail of {
            true -> emit_list_tail_lit(dest, es, cd);
            false -> case is_head of {
                true -> emit_list_head_lit(dest, head_is_agg);
                false -> prims_list@emit_prim_op(term, dest)
            }
        }
    })
}

fn emit_kind_compound_part2(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
// move(x) outside a send operand (a reply element, a binding): the explicit-move marker of region
// design Q18 is the identity here; the stage-5 checker and the reply copy decision read it.
case term_sir_helpers@sir_term_root_node(term).name == "move" of {
    true -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), dest, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
    false -> case term_sir_helpers@sir_term_root_node(term).type_name == "string" and (term_sir_helpers@sir_term_root_node(term).name == "string_substring" or term_sir_helpers@sir_term_root_node(term).name == "string_substring_until_char") and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6 of {
    true -> {
                            arg1_asm: string <- case bound.debug of {
                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            arg2_asm: string <- case bound.debug of {
                                true -> { emit_child(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            arg3_asm: string <- case bound.debug of {
                                true -> { emit_child(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).right_expr),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).right_expr),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            op_asm: string <- prims@emit_prim_op(term, dest);
                            // Every argument is evaluated into X9 and parked on the stack; X0-X2 are loaded only when
                            // all three are known. Staging an argument straight into its ABI register destroyed a
                            // parameter a later argument still had to read: in `fn digit(d: int64) { substring(
                            // "0123456789", d, d + 1) }` d sits in X0 (nothing here makes it shadow), the literal
                            // went into X0 first, and the start and end were computed from its address, so every
                            // digit came back empty (trials/string_addition/substring_parameter_start). Calls inside
                            // an argument (substring(t, length_bytes(prefix), length_bytes(t)) in
                            // type_interner@parse_bracket_args) clobber X0-X2 too, and nothing is staged there now.
                            staged: string <- concat(concat(concat(arg1_asm, "\n"), xt_mem@xt_str("X9", "[SP, #-16]!")), concat(concat(concat(arg2_asm, "\n"), xt_mem@xt_str("X9", "[SP, #-16]!")), concat(concat(arg3_asm, "\n"), concat(xt_isa@xt_mov("X2", "X9"), concat(xt_mem@xt_ldr("X1", "[SP], #16"), xt_mem@xt_ldr("X0", "[SP], #16"))))));
                            concat(staged, op_asm)
                        };
    false -> case term_sir_helpers@sir_term_root_node(term).type_name == "bool" and prims_string@is_string_predicate_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> {
                            left_asm: string <- case bound.debug of {
                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X0", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X0", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            save_left: string <- xt_mem@xt_str("X0", "[SP, #-16]!");
                            right_asm: string <- case bound.debug of {
                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            restore_left: string <- xt_mem@xt_ldr("X0", "[SP], #16");
                            op_asm: string <- prims_string@emit_prim_op(term, dest);
                            concat(concat(concat(concat(concat(left_asm, "\n"), save_left), concat(right_asm, "\n")), restore_left), op_asm)
                        };
    false -> case prims_list@is_list_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> case term_sir_helpers@sir_term_root_node(term).name == "list_nil" of {
                            true -> prims_list@emit_prim_op(term, dest);
                            false -> case term_sir_helpers@sir_term_root_node(term).name == "list_cons" of {
                                true -> {
                                    // Emit tail (arg2) into X2 BEFORE head (arg1) into X1.
                                    // Evaluating arg2 first ensures that variable references bound to X1
                                    // (e.g. prepend(val, xs) where xs is in X1) are resolved before
                                    // arg1 overwrites X1 with the new head value.
                                    arg2_asm: string <- case bound.debug of {
                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    arg1_asm: string <- case bound.debug of {
                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    op_asm: string <- prims_list@emit_prim_op(term, dest);
                                    cons_dealloc: int64 <- term_aggregate_helpers@flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                    term_aggregate_helpers@list_cons_join_tail_head_op(arg2_asm, arg1_asm, op_asm, cons_dealloc)
                                };
                                false -> case term_sir_helpers@sir_term_root_node(term).name == "list_at" of {
                                    true -> {
                                        // list into X9, kept on the stack across the index evaluation; index into X10.
                                        list_asm: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
                                        idx_asm: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
                                        concat(concat(concat(list_asm, concat("\n", xt_mem@xt_str("X9", "[SP, #-16]!"))), concat(idx_asm, concat("\n", xt_mem@xt_ldr("X9", "[SP], #16")))), prims_list@emit_prim_op(term, dest))
                                    };
                                    false -> emit_list_unary(bound, pools, emit_child, term, dest)
                                }
                            }
                            };
    false -> case prims_device@is_device_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> emit_device_prim(bound, pools, emit_child, term, dest);
    false -> case prims_memory@is_memory_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> case term_sir_helpers@sir_term_root_node(term).name == "fresh_lifetime" of {
                            true -> prims@emit_prim_op(term, dest);
                            false -> case term_sir_helpers@sir_term_root_node(term).name == "alloc_region" or term_sir_helpers@sir_term_root_node(term).name == "canonical_arena_lookup" of {
                                true -> {
                                    arg_asm: string <- case term_sir_helpers@sir_term_root_node(term).name == "canonical_arena_lookup" of {
                                        true -> case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        false -> ""
                                    };
                                    op_asm: string <- prims@emit_prim_op(term, dest);
                                    case term_sir_helpers@sir_term_root_node(term).name == "canonical_arena_lookup" of {
                                        true -> concat(concat(arg_asm, "\n"), op_asm);
                                        false -> op_asm
                                    }
                                };
                                false -> case term_sir_helpers@sir_term_root_node(term).name == "read_ref" of {
                                true -> {
                                    arg_asm: string <- case bound.debug of {
                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    op_asm: string <- prims@emit_prim_op(term, dest);
                                    concat(concat(arg_asm, "\n"), op_asm)
                                };
                                false -> case term_sir_helpers@sir_term_root_node(term).name == "alloc_ref" or term_sir_helpers@sir_term_root_node(term).name == "alloc_rec" or term_sir_helpers@sir_term_root_node(term).name == "alloc_buf" or term_sir_helpers@sir_term_root_node(term).name == "write_ref" or term_sir_helpers@sir_term_root_node(term).name == "buf_load" or term_sir_helpers@sir_term_root_node(term).name == "read_buf" or term_sir_helpers@sir_term_root_node(term).name == "canonical_arena_same" or term_sir_helpers@sir_term_root_node(term).name == "ref_eq" or term_sir_helpers@sir_term_root_node(term).name == "ref_in_region" of {
                                    true -> {
                                        arg1_asm: string <- case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        arg2_asm: string <- case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        bounds_asm: string <- case term_sir_helpers@sir_term_root_node(term).name == "buf_load" or term_sir_helpers@sir_term_root_node(term).name == "read_buf" of {
                                            true -> prims_memory@emit_buf_bounds_check(term, bound.outer_reg, dest);
                                            false -> ""
                                        };
                                        op_asm: string <- prims@emit_prim_op(term, dest);
                                        // tuple_make for arg2 uses SUB SP; restore before later ops / return. write_ref leaves ref in X1; bindings expect ref in X2.
                                        tuple_stack_bytes: int64 <- term_aggregate_helpers@flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
                                        tuple_sp_restore: string <- case tuple_stack_bytes > 0 of {
                                            true -> concat("\n", xt_isa@xt_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(tuple_stack_bytes))));
                                            false -> ""
                                        };
                                        write_ref_recover: string <- case term_sir_helpers@sir_term_root_node(term).name == "write_ref" of {
                                            true -> concat("\n", xt_isa@xt_mov("X2", "X1"));
                                            false -> ""
                                        };
                                        // Same hazard as buf_store below: a second operand that calls (read_buf(b, f(i)),
                                        // write_ref(r, f(x))) does not preserve the region/pointer in X1.
                                        park_x1: boolean <- buf_store_arg_is_plain(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)) == false;
                                        x1_unpark: string <- case park_x1 of { true -> concat("\n", xt_isa@xt_add("SP", "SP", "#16")); false -> "" };
                                        after_op: string <- concat(op_asm, concat(tuple_sp_restore, concat(x1_unpark, write_ref_recover)));
                                        part_a: string <- case park_x1 of {
                                            true -> concat(concat(concat(arg1_asm, concat("\n", xt_mem@xt_str("X1", "[SP, #-16]!"))), arg2_asm), concat("\n", xt_mem@xt_ldr("X1", concat("[SP, #", concat(atom_table@int64_to_decimal_string(tuple_stack_bytes), "]")))));
                                            false -> args_x1_x2_ordered(arg1_asm, arg2_asm)
                                        };
                                        part_b: string <- concat(concat(part_a, "\n"), bounds_asm);
                                        concat(part_b, after_op)
                                    };
                                    false -> case term_sir_helpers@sir_term_root_node(term).name == "buf_store" of {
                                        true -> {
                                            // Emit arg1 (buf) to X1 before arg2 (idx/val tuple) to X2.
                                            // alloc_buf leaves the buffer pointer in X2; tuple_make ends with MOV X2, SP.
                                            // If we emitted the tuple first, X2 would be overwritten and the follow-up
                                            // buf load (e.g. MOV X1, X2) would pass the tuple pointer to buf_store.
                                            // Flat tuple emission uses per-element scratch temps (e.g. X9), not X1.
                                            arg1_asm: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            arg2_asm: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            op_asm: string <- prims_memory@emit_buf_store(term, dest, bound.outer_reg);
                                            // tuple_make did SUB SP (possibly multiple for nested tuple_make); restore SP before return / next ops.
                                            tuple_bytes: int64 <- term_aggregate_helpers@flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
                                            tuple_sp_adj: string <- xt_isa@xt_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(tuple_bytes)));
                                            // emit_buf_store leaves X1=buf; LDR X2,[X2] leaves X2=index. Bindings still expect buf in X2.
                                            recover_buf_reg: string <- xt_isa@xt_mov("X2", "X1");
                                            // The index/value tuple is evaluated after the buffer is in X1. When it computes
                                            // anything beyond plain arithmetic (a call, a case, a helper-backed prim) X1 is not
                                            // preserved, so park the buffer below the tuple and reload it: write_buf(b, 1,
                                            // low_byte(n)) stored through the callee's X1. See
                                            // trials/memory_region_addition/write_buf_call_argument.
                                            save_buf: boolean <- buf_store_arg_is_plain(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)) == false;
                                            buf_park: string <- case save_buf of { true -> xt_mem@xt_str("X1", "[SP, #-16]!"); false -> "" };
                                            buf_reload: string <- case save_buf of {
                                                true -> xt_mem@xt_ldr("X1", concat("[SP, #", concat(atom_table@int64_to_decimal_string(tuple_bytes), "]")));
                                                false -> ""
                                            };
                                            buf_unpark: string <- case save_buf of { true -> xt_isa@xt_add("SP", "SP", "#16"); false -> "" };
                                            after_store: string <- concat(op_asm, concat("\n", concat(tuple_sp_adj, concat(buf_unpark, concat("\n", recover_buf_reg)))));
                                            concat(concat(concat(concat(concat(arg1_asm, "\n"), buf_park), concat(concat(arg2_asm, "\n"), buf_reload)), "\n"), after_store)
                                        };
                                        false -> prims@emit_prim_op(term, dest)
                                    }
                                }
                                }
                            }
                        };
    false -> case prims_collection_result@is_collection_result_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> {
                            arg_asm: string <- case bound.debug of {
                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            mov_arg: string <- xt_isa@xt_mov("X0", "X1");
                            op_asm: string <- prims_collection_result@emit_prim_op_with_table(term, dest, table);
                            concat(concat(concat(arg_asm, "\n"), mov_arg), op_asm)
                        };
    false -> case prims_checked_int64@is_checked_int64_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> {
                            arg1_asm: string <- case bound.debug of {
                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            arg2_asm: string <- case prims_checked_int64@is_checked_int64_unary_prim(term_sir_helpers@sir_term_root_node(term).name) of {
                                true -> "";
                                false -> case bound.debug of {
                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                }
                            };
                            op_asm: string <- prims_checked_int64@emit_prim_op(term, dest);
                            concat(concat(concat(concat(arg1_asm, "\n"), arg2_asm), "\n"), op_asm)
                        };
    false -> case prims_ordering_identity@is_ordering_identity_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> case term_sir_helpers@sir_term_root_node(term).name == "ordering_identity_fresh_env" of {
                            true -> prims@emit_prim_op(term, dest);
                            false -> {
                                arg1_asm: string <- case bound.debug of {
                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X1", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                arg2_asm: string <- case bound.debug of {
                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X2", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                concat(concat(concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n")), "\n"), op_asm)
                            }
                        };
    false -> term_emit_kind_compound_part3@emit_kind_compound_part3(term, dest, bound, pools, emit_child)
}
}
}
}
}
}
}
}
}
}
