// Case-kind term emission (open-recursive via emit_child).

use atom_table;
use var;
use term_aggregate_helpers;
use term_case_patterns;
use term_sir_helpers;
use term_reg_spill;
use xt_isa;

export emit_case_expression/6;

fn emit_case_one_branch_inner(branch: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, case_env: { scrut_t: string, scrut_reg: string, lit_reg: string, guard_reg: string, dest: string, done_l: string }, fail_l: string, entry_l: string, pattern_pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
    pkind: string <- term_sir_helpers@sir_term_root_node(branch).value;
    branch_node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(branch);
    // Case patterns only need literal/atom/string pools (not intN tables).
    (pat_asm: string, list_bind_asm: string, outer_for_branch: string) <- case pkind == "record" of {
        true -> term_case_patterns@emit_record_case_pattern_asm(branch, branch_node.type_name, case_env.scrut_t, case_env.scrut_reg, case_env.lit_reg, fail_l, bound.outer_reg, pattern_pools);
        // A tuple pattern binds its named elements (frame slots), so it returns the arm's outer.
        false -> case pkind == "tuple" of {
        true -> term_case_patterns@emit_tuple_case_pattern_asm(branch, case_env.scrut_t, case_env.scrut_reg, case_env.lit_reg, fail_l, bound.outer_reg, pattern_pools);
        false -> {
            chk: string <- term_case_patterns@emit_case_pattern_check(branch, case_env.scrut_t, case_env.scrut_reg, case_env.lit_reg, fail_l, pattern_pools, bound.outer_reg);
            (lb_asm: string, outer_l: string) <- case pkind == "list_cons" of {
                true -> term_case_patterns@emit_list_cons_pattern_loads(branch, case_env.scrut_reg, bound.outer_reg);
                false -> ("", bound.outer_reg)
            };
            (chk, lb_asm, outer_l)
        }
        }
    };
    pat_full: string <- concat(pat_asm, list_bind_asm);
    br_bn: string <- case pkind == "bind" of {
        true -> case length_bytes(term_sir_helpers@sir_term_root_node(branch).name) > 1 of { true -> substring(term_sir_helpers@sir_term_root_node(branch).name, 1, length_bytes(term_sir_helpers@sir_term_root_node(branch).name)); false -> "" };
        false -> bound.bound_name
    };
    // A `bind` arm names the unwrapped scrutinee (e.g. `right_ref: ref(...) -> ...`).
    // It was carried only in bound_name/bound_reg, which holds ONE name and is
    // replaced as soon as the arm body nests into lets -- so a use deeper in the arm
    // did not resolve and fell through to the named-function-symbol fallback,
    // emitting `ADRP wbt_map_right_ref` for a pattern variable and failing to link.
    // Bind it in outer_reg so it survives nesting. scrut_reg is X1-X5 (caller-saved)
    // and this arm calls out before using the binding, so park it in a frame slot
    // rather than binding the register.
    bind_slot: string <- case pkind == "bind" and length_bytes(br_bn) > 0 of {
        true -> term_reg_spill@next_frame_spill_slot(bound.outer_reg);
        false -> ""
    };
    // The body's immediate bound_reg must be the same home the outer binding names: the
    // scrutinee register is caller-saved scratch that the arm's own calls and argument
    // staging reuse (brodal_okasaki link read n2 from X3 after X3 was restaged with d2).
    br_br: string <- case length_bytes(bind_slot) > 0 of {
        true -> bind_slot;
        false -> case pkind == "bind" of {
            true -> case_env.scrut_reg;
            false -> bound.bound_reg
        }
    };
    bind_save: string <- case length_bytes(bind_slot) > 0 of {
        true -> concat(var@emit_str_mem_ref(case_env.scrut_reg, bind_slot), "\n");
        false -> ""
    };
    outer_body: string <- case length_bytes(bind_slot) > 0 of {
        true -> concat(outer_for_branch, concat("|", concat(term_sir_helpers@sir_term_root_node(branch).name, concat("=", bind_slot))));
        false -> outer_for_branch
    };
    guard_asm: string <- case term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).inner).root < 0 of {
        true -> "";
        false -> {
            g_asm: string <- emit_child(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).inner),  case_env.guard_reg, pools,  { bound_name: br_bn, bound_reg: br_br, outer_reg: outer_body, debug: false });
            g_nl: string <- concat(g_asm, "\n");
            concat(g_nl, xt_isa@xt_cbz(case_env.guard_reg, fail_l))
        }
    };
    body_asm: string <- emit_child(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr),  case_env.dest, pools,  { bound_name: br_bn, bound_reg: br_br, outer_reg: outer_body, debug: false });
    branch_stack_n: int64 <- term_aggregate_helpers@aggregate_callee_return_stack_bytes(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr));
    tuple_sret_branch: string <- var@find_sp_binding(bound.outer_reg, "_tuple_sret");
    branch_body_node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr));
    arm_built_in_reply_buffer: boolean <- length_bytes(tuple_sret_branch) > 0 and branch_body_node.kind == 6 and branch_body_node.name == "tuple_make";
    arm_on_sret_spine: boolean <- length_bytes(var@find_sp_binding(bound.outer_reg, concat("_rspc", case_env.done_l))) > 0;
    branch_promote_n: int64 <- case arm_built_in_reply_buffer or arm_on_sret_spine of {
        true -> 0;
        false -> term_aggregate_helpers@aggregate_callee_return_promote_bytes(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr))
    };
    // tuple_make can write directly into an enclosing aggregate return buffer
    // (actor behavior reply buffer, user-call sret, etc.). Keep the heap
    // promotion for the returned pointer, but only pop bytes that this branch
    // actually pushed on SP.
    branch_dealloc_n: int64 <- case length_bytes(tuple_sret_branch) > 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr)).name == "tuple_make" of {
        true -> 0;
        false -> branch_stack_n
    };
    // A branch tail that is a plain (non-tail) tuple-returning call allocates a caller sret slab
    // (SUB SP / MOV X8, SP) that neither let-end nor the scrutinee free pairs with. Promote the
    // result to the heap so X0 survives the pop, then release the slab so every arm reaches the
    // join at the same SP as the tuple_make arms.
    branch_call_sret_n: int64 <- term_aggregate_helpers@branch_tail_user_call_sret_stack_bytes(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr), outer_body, br_bn);
    branch_cleanup: string <- case case_env.dest == "X0" of {
        true -> case branch_promote_n > 0 of {
            true -> concat(term_aggregate_helpers@aggregate_return_heap_promote_x0(branch_promote_n), case branch_dealloc_n > 0 of {
                true -> xt_isa@xt_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(branch_dealloc_n)));
                false -> ""
            });
            false -> case branch_call_sret_n > 0 of {
                true -> concat(term_aggregate_helpers@aggregate_return_heap_promote_x0(branch_call_sret_n), xt_isa@xt_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(branch_call_sret_n))));
                false -> ""
            }
        };
        false -> ""
    };
    h0: string <- concat(entry_l, ":\n");
    h1: string <- concat(concat(concat(h0, pat_full), bind_save), guard_asm);
    h2: string <- concat(concat(concat(h1, body_asm), "\n"), branch_cleanup);
    br: string <- xt_isa@xt_b(case_env.done_l);
    concat(h2, br)
}

fn emit_case_branch_seq(rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, case_seq: { scrut_t: string, scrut_reg: string, lit_reg: string, guard_reg: string, dest: string, done_l: string, fb_l: string, case_name: string }, idx: int64, pattern_pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: