// An offset of -1 means a record field name was not found in the record type. Emitting a
// memref for it would silently place the value at a wrong (or colliding) slot, so emit an
// assembler directive that fails the build at this exact line instead.
fn tuple_flat_memref(store_base: string, offset: int64) -> string {
    case offset < 0 of {
        true -> "[SP, #0]\n    ; silica internal error: unresolved record field offset (field not in record type)\n    .err";
        false -> tuple_flat_memref_at(store_base, offset)
    }
}

// AArch64 unscaled load/store immediates are limited to [-256, 255], so a frame
// region deeper than that cannot be reached as [X29, #-d] (we saw [X29, #-288]
// rejected by the assembler). For those, materialise the region base in X16
// (IP0, caller-saved and safe to clobber immediately before the access) and use a
// positive scaled offset, which reaches 32760. agg_addr_prefix supplies the SUB;
// every site that builds an instruction from tuple_flat_memref must prepend it.
// dest = X29 - n, valid for any n. SUB's immediate stops at 4095, so a deeper
// frame needs the displacement in a register first (phase_d supervisors reached
// 5040 bytes). No trailing newline: callers concatenate one.
fn emit_sub_from_fp(dest: string, n: int64) -> string {
    case n > 4095 of {
        true -> concat(xt_isa@xt_mov("X17", concat("#", atom_table@int64_to_decimal_string(n))), xt_isa@xt_sub(dest, "X29", "X17"));
        false -> xt_isa@xt_sub(dest, "X29", concat("#", atom_table@int64_to_decimal_string(n)))
    }
}

fn agg_far_region(store_base: string, offset: int64) -> boolean {
    fb: int64 <- var@parse_x29_neg_offset_bytes(store_base);
    case fb > 0 of {
        true -> fb - offset > 255;
        false -> false
    }
}

fn agg_addr_prefix(store_base: string, offset: int64) -> string {
    case agg_far_region(store_base, offset) of {
        true -> {
            // SUB's immediate is [0, 4095]; a frame deeper than that needs the
            // displacement in a register first (MOV covers 0..65535).
            fb2: int64 <- var@parse_x29_neg_offset_bytes(store_base);
            case fb2 > 4095 of {
                true -> concat(xt_isa@xt_mov("X16", concat("#", atom_table@int64_to_decimal_string(fb2))), concat(xt_isa@xt_sub("X16", "X29", "X16"), "\n"));
                false -> xt_isa@xt_sub("X16", "X29", concat("#", atom_table@int64_to_decimal_string(fb2)))
            }
        };
        false -> ""
    }
}

fn tuple_flat_memref_at(store_base: string, offset: int64) -> string {
    case agg_far_region(store_base, offset) of {
        true -> concat("[X16, #", concat(atom_table@int64_to_decimal_string(offset), "]"));
        false -> tuple_flat_memref_near(store_base, offset)
    }
}

fn tuple_flat_memref_near(store_base: string, offset: int64) -> string {
    case length_bytes(store_base) > 0 of {
        true -> {
            // A store_base that is itself a frame memref ("[X29, #-96]") names an
            // aggregate region allocated in the fixed frame rather than by moving SP.
            // Element k of that region is at X29-(base-k), so the address is stable
            // across calls and needs no displacement correction. int64_to_decimal_string
            // renders the sign, so offset > base (shouldn't happen) still formats.
            fb: int64 <- var@parse_x29_neg_offset_bytes(store_base);
            case fb > 0 of {
                true -> concat("[X29, #", concat(atom_table@int64_to_decimal_string(offset - fb), "]"));
                false -> tuple_flat_memref_reg(store_base, offset)
            }
        };
        false -> concat(concat("[SP, #", atom_table@int64_to_decimal_string(offset)), "]")
    }
}

fn tuple_flat_memref_reg(store_base: string, offset: int64) -> string {
    p: string <- concat("[", store_base);
    q: string <- concat(p, ", #");
    r: string <- concat(q, atom_table@int64_to_decimal_string(offset));
    concat(r, "]")
}

// Copy qword-aligned scalar fields from a stack record at src_reg into the flat tuple buffer (supervisor init:
// inline flags record so materialize sees strategy @+0, counts @+8/+16, list head @+24 — not a dangling stack pointer).

fn emit_reg_to_flat_qwords_memcpy_loop(i: int64, qwords: int64, src_reg: string, store_base: string, dest_base_off: int64) -> string {
    case i >= qwords of {
        true -> "";
        false -> {
            off: int64 <- i * 8;
            ld: string <- xt_mem@xt_ldr("X12", concat("[", concat(src_reg, concat(", #", concat(atom_table@int64_to_decimal_string(off), "]")))));
            ldr: string <- concat(ld, concat(agg_addr_prefix(store_base, dest_base_off + off), xt_mem@xt_str("X12", tuple_flat_memref(store_base, dest_base_off + off))));
            concat(ldr, emit_reg_to_flat_qwords_memcpy_loop(i + 1, qwords, src_reg, store_base, dest_base_off))
        }
    }
}

// Walk tuple_make chain, emit each element value and store at [SP, ...] or [store_base, ...].
// byte_cursor = running offset for scalar fields (one word each).
// idx/count/sp_adjust: legacy path for nested aggregate elements (idx*8 + sp_adjust).
// store_base: empty -> stack; non-empty -> sret / reply buffer register.

// Retired: nested elements are heap pointers; do not widen the outer tuple SUB for rec_flat.
fn tuple_make_memcpy_record_flat_head(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    false
}


// True when emit_flat_tuple_stores uses memcpy for a scalar record at idx 0 (rec_flat tuple head).

fn tuple_make_scalar_rec_flat_first(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, count: int64) -> boolean {
    case count < 2 of {
        true -> false;
        false -> case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
            true -> {
                first: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
                case term_sir_helpers@sir_term_root_node(first).kind == 6 and term_sir_helpers@sir_term_root_node(first).name == "record_make" of {
                    false -> false;
                    true -> prims_record@record_type_has_only_scalar_fields(term_sir_helpers@sir_term_root_node(first).type_name)
                }
            };
            false -> false
        }
    }
}

// Outer SUB SP bytes for tuple_make: flat pairing slots, widened when (record_make, …) head
// still accounts for the nested record slab in flat_tuple_total_alloc / nested_adjust (rec_flat trim).

fn tuple_make_rec_flat_outer_alloc_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, count: int64) -> int64 {
    base: int64 <- prims_tuple@flat_alloc_size(count);
    case tuple_make_memcpy_record_flat_head(term) of {
        false -> base;
        true -> {
            rsz: int64 <- prims_record@record_type_value_flat_byte_size(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
            need: int64 <- term_record_layout@stack_alloc_round16(rsz + 8 * (count - 1));
            case need > base of { true -> need; false -> base }
        }
    }
}

fn tuple_make_rec_flat_nested_trim_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, count: int64) -> int64 {
    case tuple_make_memcpy_record_flat_head(term) of {
        false -> 0;
        true -> term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name)
    }
}

fn flat_record_sum_nested_reserved_in_outer(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> 0;
        true -> case prims_record@record_type_has_only_scalar_fields(term_sir_helpers@sir_term_root_node(term).type_name) of {
            true -> 0;
            false -> {
                here: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" and prims_tuple@count_flat_elements(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) == 2 of {
                    true -> 0;
                    false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 4 or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 5 of {
                        // Boxed layout: a call's aggregate result is a heap pointer (a record
                        // callee promotes; a tuple call reclaims its own sret slab) and the field
                        // stores that pointer, so nothing is reserved or memcpy'd in this frame.
                        true -> case prims_record@record_type_keeps_inline_layout(term_sir_helpers@sir_term_root_node(term).type_name) and record_field_call_reclaims_own_sret(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) == false of {
                            // A runtime-laid-out record still memcpy's a record-returning call's result
                            // into bytes reserved here (legacy inline rules).
                            true -> term_user_call_abi@user_call_aggregate_return_alloc_bytes(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                            false -> 0
                        };
                        false -> 0
                    }
                };
                rest: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind < 0 of {
                    true -> 0;
                    false -> flat_record_sum_nested_reserved_in_outer(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                };
                here + rest
            }
        }
    }
}

// A tuple-returning call in record-field position SUBs its own caller sret slab and hands back a
// heap pointer, and the field store then reclaims that slab (tuple_elem_sret_reclaim), so the make
// is back on its own SP by the time the next field is stored. Neither the outer SUB nor the
// nested-inner sums may count those bytes: reserving them shifted every later field and left the
// callee's slab unpopped, so the frame grew by the sret size and the epilogue restored X29/X30 from
// the wrong slots -- `{ p: pair(), b: 9 }` returned to a garbage address and hung.
// An inline-struct (record) return is different: the callee heap-promotes, SP does not move, and the
// result is memcpy'd into bytes the outer SUB reserved. Those still count.
// See trials/codegen_regressions/rec_tuple_call_field.silica.
fn record_field_call_reclaims_own_sret(elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    (term_sir_helpers@sir_term_root_node(elem).kind == 4 or term_sir_helpers@sir_term_root_node(elem).kind == 5) and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(elem).type_name)
}

// Boxed layout (prims_record header): a record-typed field holds a pointer, never an inline
// copy, so no field value is ever memcpy'd into the outer slab. A variable is copied to the
// region first (record_field_nested_return_bytes); calls and projections already hand back
// heap pointers.
fn record_field_inline_pointer_value(elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, fty: string, R: string) -> boolean {
    // The runtime-laid-out records (prims_record@record_type_keeps_inline_layout) keep the legacy
    // inline copy: an inline-struct field value from a variable, call or projection is memcpy'd
    // into the outer slab (the supervisor reply's child_info).
    case prims_record@record_type_keeps_inline_layout(R) and reg_conventions@is_inline_struct_type(fty) of {
        false -> false;
        true -> case term_sir_helpers@sir_term_root_node(elem).kind == 1 of {
            true -> true;
            false -> case term_sir_helpers@sir_term_root_node(elem).kind == 4 or term_sir_helpers@sir_term_root_node(elem).kind == 5 of {
                true -> true;
                false -> term_sir_helpers@sir_term_root_node(elem).kind == 6 and term_sir_helpers@sir_term_root_node(elem).name == "record_proj"
            }
        }
    }
}

fn let_user_call_tuple_sret_stack_bytes(rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string, bound_name: string) -> int64 {
    // Keep in lockstep with sret_alloc_bytes in term_emit_kind_call. Zero for pass-through / non-tuple.
    case (term_sir_helpers@sir_term_root_node(rhs).kind == 4 or term_sir_helpers@sir_term_root_node(rhs).kind == 5) and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(rhs).type_name) of {
        false -> 0;
        true -> case length_bytes(var@find_sp_binding(outer_reg, "_callee_sret")) > 0 and (length_bytes(bound_name) == 0 or term_sir_helpers@sir_term_root_node(rhs).kind == 5) and reply_result_type_agg(term_sir_helpers@sir_term_root_node(rhs).type_name) == false of {
            true -> 0;
            false -> term_user_call_abi@user_call_aggregate_return_alloc_bytes(term_sir_helpers@sir_term_root_node(rhs).type_name)
        }
    }
}

fn branch_tail_strip_lets(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case term_sir_helpers@sir_term_root_node(t).kind == 2 of {
        true -> branch_tail_strip_lets(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).right_expr));
        false -> t
    }
}

fn branch_tail_user_call_sret_stack_bytes(rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string, bound_name: string) -> int64 {
    // `true -> { a <- …; b <- …; f(x) }` pushes the same slab as a bare `true -> f(x)`,
    // so walk the let spine to the tail before deciding (see read_hex_digits in the lexer).
    tail: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- branch_tail_strip_lets(rhs);
    tail_is_bound: boolean <- term_sir_helpers@sir_term_root_node(rhs).kind == 2 or length_bytes(bound_name) > 0;
    reply_tail: boolean <- reply_result_type_agg(term_sir_helpers@sir_term_root_node(tail).type_name);
    on_reply_spine: boolean <- reply_tail and length_bytes(var@find_sp_binding(outer_reg, "_tuple_sret")) > 0
        and node_listed_agg(var@find_sp_binding(outer_reg, "_bsp"), concat(",", concat(atom_table@int64_to_decimal_string(tail.root), ",")), 0);
    case term_sir_helpers@sir_term_root_node(tail).kind == 4 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(tail).type_name) and on_reply_spine == false of {
        false -> 0;
        true -> case length_bytes(var@find_sp_binding(outer_reg, "_callee_sret")) > 0 and tail_is_bound == false and reply_tail == false of {
            true -> 0;
            false -> term_user_call_abi@user_call_aggregate_return_alloc_bytes(term_sir_helpers@sir_term_root_node(tail).type_name)
        }
    }
}

// (:reply, ..) / (:no_reply, ..): term_emit_kind_call@behaviour_result_call_type.
fn reply_result_type_agg(t: string) -> boolean {
    reg_conventions@is_tuple_type(t) and reg_conventions@is_sret_tuple_type(t) == false
        and ((length_bytes(t) >= 8 and substring(t, 0, 8) == "(:reply,") or (length_bytes(t) >= 11 and substring(t, 0, 11) == "(:no_reply,"))
}

// True when `key` (",<idx>,") occurs in `list` at or after i.
fn node_listed_agg(list: string, key: string, i: int64) -> boolean {
    case i + length_bytes(key) > length_bytes(list) of {
        true -> false;
        false -> case substring(list, i, i + length_bytes(key)) == key of {
            true -> true;
            false -> node_listed_agg(list, key, i + 1)
        }
    }
}

// Sequence/lowering nests lets (child; children; produces tuple). The terminal tuple_make is in
// right_expr of the innermost let; count its stack slab for outer let dealloc (see supervisors e4a init).

fn deepest_let_chain_leaf(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case term_sir_helpers@sir_term_root_node(term).kind == 2 of {
        true -> deepest_let_chain_leaf(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
        false -> term
    }
}

fn let_chain_has_later_record_make_rhs(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term_sir_helpers@sir_term_root_node(term).kind == 2 of {
        false -> false;
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" of {
            true -> true;
            false -> let_chain_has_later_record_make_rhs(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
        }
    }
}

// RHS stack record + nested lets → rec_flat tuple: leaf teardown + widen accounts for tuple slab; a full parent's
// base_stack ADD would double-pop (#48 duplicate). Omitting it entirely leaves SP 16 B low before callee LDP — use +16 fixup.
// Uses tuple_make_memcpy_record_flat_head (defined above).

fn let_suppress_base_stack_overlay_rec_flat(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, base_stack: int64) -> boolean {
    case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 2 and base_stack > 0 of {
        false -> false;
        true -> {
            leaf: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- deepest_let_chain_leaf(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
            case let_chain_has_later_record_make_rhs(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)) of {
                true -> false;
                false -> tuple_make_memcpy_record_flat_head(leaf)
            }
        }
    }
}

fn let_suppressed_base_stack_fixup(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" and term_child_spec@is_child_spec_record_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) of {
        true -> term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
        false -> 16
    }
}

// Kind 2 is a let: type_name is the binding, right_expr is the body that actually has the record.
fn record_proj_skip_lets(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case term_sir_helpers@sir_term_root_node(term).kind == 2 of {
        true -> record_proj_skip_lets(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
        false -> term
    }
}

// Outermost aggregate type for record_proj chains (value-flat substruct address; trial 04). A value
// base reports the record it produced, so projecting an embedded substruct out of `slots.head` takes
// the same address-of path a variable base does.

// Boxed layout: a record-typed field holds a POINTER, so `s.end.x` is the projection `s.end`
// (a pointer, evaluated into a register like `slots.head.token.kind` already was) followed by a
// load at x's offset. Only the supervisor reply record, laid out by the actor runtime with
// child_info spliced inline, still folds its links into a single offset from the root variable.
fn record_proj_link_is_inline(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" of {
        false -> false;
        true -> prims_record@record_type_keeps_inline_layout(record_proj_root_record_type(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)))
    }
}

fn record_proj_root_record_type(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
        false -> "";
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of {
            true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name;
            false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" of {
                true -> case record_proj_link_is_inline(term) of {
                    true -> record_proj_root_record_type(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                    false -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name
                };
                false -> term_sir_helpers@sir_term_root_node(record_proj_skip_lets(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))).type_name
            }
        }
    }
}

// s.end.x lowers to record_proj(x, inner: record_proj(end, inner: var s)) — resolve root var and full byte offset.

fn record_proj_chain_root_var_name(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
        false -> "";
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of {
            true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name;
            false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" and record_proj_link_is_inline(term) of {
                true -> record_proj_chain_root_var_name(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                false -> ""
            }
        }
    }
}

fn record_proj_chain_byte_offset(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
        false -> 0;
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of {
            true -> prims_record@offset_bytes_before_field(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name, term_sir_helpers@sir_term_root_node(term).value);
            false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" and record_proj_link_is_inline(term) of {
                true -> {
                    pre: int64 <- record_proj_chain_byte_offset(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                    here: int64 <- prims_record@offset_bytes_before_field(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name, term_sir_helpers@sir_term_root_node(term).value);
                    case pre < 0 or here < 0 of {
                        true -> -1;
                        false -> pre + here
                    }
                };
                // A value base (list_head, a call, a struct literal) carries the projected record in
                // its own type_name, so its link contributes the same offset a variable base would.
                // A let wrapping that value has the binding's type_name (int64 for count_children);
                // walk to the body so `.count` lands at #32, not the tag at #0.
                false -> prims_record@offset_bytes_before_field(term_sir_helpers@sir_term_root_node(record_proj_skip_lets(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))).type_name, term_sir_helpers@sir_term_root_node(term).value)
            }
        }
    }
}

// Innermost base of a record_proj chain: `s.end.x` walks past the inner record_proj links so the
// base is classified (and evaluated) once, whatever it turns out to be.

fn record_proj_chain_base_term(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" and record_proj_link_is_inline(term) of {
        true -> record_proj_chain_base_term(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
        false -> term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)
    }
}

// True when the chain roots at a value that must be materialized in a register rather than at a
// variable whose stack slot the projection can address directly.

fn record_proj_chain_base_is_value(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
        false -> false;
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of {
            true -> false;
            false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" and record_proj_link_is_inline(term) of {
                true -> record_proj_chain_base_is_value(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                false -> true
            }
        }
    }
}

fn aggregate_heap_copy_words_unrolled(word_idx: int64, words: int64) -> string {
    case word_idx >= words of {
        true -> "";
        false -> {
            off: int64 <- word_idx * 8;
            pair: string <- concat(xt_mem@xt_ldr("X3", concat("[X1, #", concat(atom_table@int64_to_decimal_string(off), "]"))), xt_mem@xt_str("X3", concat("[X4, #", concat(atom_table@int64_to_decimal_string(off), "]"))));
            concat(pair, aggregate_heap_copy_words_unrolled(word_idx + 1, words))
        }
    }
}

fn emit_inline_record_field_copy_words(src_reg: string, store_base: string, dest_off: int64, word_idx: int64, words: int64) -> string {
    case word_idx >= words of {
        true -> "";
        false -> {
            off: int64 <- word_idx * 8;
            dst_pfx: string <- agg_addr_prefix(store_base, dest_off + off);
            dst: string <- tuple_flat_memref(store_base, dest_off + off);
            one: string <- concat(dst_pfx, concat(xt_mem@xt_ldr("X10", concat("[", concat(src_reg, concat(", #", concat(atom_table@int64_to_decimal_string(off), "]"))))), xt_mem@xt_str("X10", dst)));
            concat(one, emit_inline_record_field_copy_words(src_reg, store_base, dest_off, word_idx + 1, words))
        }
    }
}

// After a stack-built aggregate is returned in X0, copy it to the heap before ADD SP
// dealloc so the caller keeps a valid pointer. X0 holds the source pointer on entry.

// A tuple element that is an aggregate LITERAL (record_make / tuple_make) is built on its own
// stack slab and the tuple stores only a pointer to it. When the enclosing tuple is promoted to
// the heap on return, the shallow copy carries that pointer verbatim, so it outlives the slab
// the epilogue pops and the caller dereferences dead stack. Copy the element to the heap here
// so the pointer stays valid after the frame goes away.
//
// Only literals take this path: elem_is_agg is kind 6 tuple_make/record_make, so call results
// that are already heap pointers (Token*, Lexer*, ...) are untouched and tuple elements remain
// pointers with a stride of 8. That is what keeps tuple_proj readers unchanged.
// A tuple-returning call in element position leaves its caller sret slab on the stack: the post-BLR
// ADD is 0 because a let-bound call pops it at let-end, and an element has no let. Nothing else
// accounts for it -- flat_tuple_nested_alloc and emit_flat_tuple_stores only shift for elements that
// are themselves a tuple_make / record_make -- so the remaining elements were stored through an SP
// sitting inside that slab and the tuple's ADD popped less than it pushed, returning on a wrong SP.
// Copy the aggregate to the heap (the element is stored as a pointer either way) and give the slab
// back, which keeps every offset and the dealloc size authority correct.
// See trials/codegen_regressions/tup_call_elem.silica.
fn tuple_elem_sret_reclaim(reg: string, nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> concat(tuple_elem_heap_promote(reg, nbytes), xt_isa@xt_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(nbytes))))
    }
}

// Promote a frame aggregate held in `reg` to the region, preserving X0-X7: on the
// direct argument path the earlier arguments of this same call are already sitting
// in them, and region_alloc clobbers them. The promoted pointer is parked in X16
// (IP0, caller-saved scratch) across the restore, then moved back into `reg`, so
// this is correct even when `reg` is itself one of X0-X7.
fn arg_aggregate_heap_promote(reg: string, nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> {
            save: string <- concat(xt_mem@xt_stp("X0", "X1", "[SP, #-16]!"), concat(xt_mem@xt_stp("X2", "X3", "[SP, #-16]!"), concat(xt_mem@xt_stp("X4", "X5", "[SP, #-16]!"), xt_mem@xt_stp("X6", "X7", "[SP, #-16]!"))));
            restore: string <- concat(xt_mem@xt_ldp("X6", "X7", "[SP], #16"), concat(xt_mem@xt_ldp("X4", "X5", "[SP], #16"), concat(xt_mem@xt_ldp("X2", "X3", "[SP], #16"), xt_mem@xt_ldp("X0", "X1", "[SP], #16"))));
            to_x0: string <- xt_isa@xt_mov("X0", reg);
            park: string <- xt_isa@xt_mov("X16", "X0");
            back: string <- xt_isa@xt_mov(reg, "X16");
            concat(save, concat(to_x0, concat(aggregate_return_heap_promote_x0(nbytes), concat(park, concat(restore, back)))))
        }
    }
}

fn tuple_elem_heap_promote(reg: string, nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> concat(xt_isa@xt_mov("X0", reg), concat(aggregate_return_heap_promote_x0(nbytes), xt_isa@xt_mov(reg, "X0")))
    }
}

// A let-bound record or tuple lives in this function's frame region, [a1, X29) (the machine stack). Packed BY NAME into
// a tuple that outlives the frame -- returned, stored in a collection, sent -- the element pointer
// dangled: pair_sets@make_pair's `(a, b)` of two wbt_set records came back pointing into the
// popped frame and wbt_set@size faulted (trials/generic_modules_addition/
// two_generic_collections_round_trip). The element is copied to the region at the pack when, and
// only when, its pointer is inside the current frame: results of calls, parameters and projections
// are region (or caller-frame) pointers already, and copying every aggregate element on every pack
// was the per-pack promote that OOMed type checking (tuple_elem_var_aggregate_promote_bytes). A
// tuple still sitting in a caller-reserved sret slab is left to tuple_elem_sret_reclaim, which
// copies it and gives the slab back. X0-X7 are preserved (later elements may read parameters).
fn tuple_elem_frame_var_promote(reg: string, elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, sret_reclaim_bytes: int64) -> string {
    n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(elem);
    nbytes: int64 <- case n.kind == 1 and sret_reclaim_bytes == 0 of {
        true -> aggregate_type_flat_bytes(n.type_name);
        false -> 0
    };
    case nbytes > 0 of {
        true -> concat(concat(xt_isa@xt_branch_below_frame(reg, "7f"), xt_isa@xt_cmp_branch("HS", reg, "X29", "7f")), concat(arg_aggregate_heap_promote(reg, nbytes), "7:\n"));
        false -> ""
    }
}

// A let-bound record or tuple passed BY NAME as a call argument (design region_memory_safety_design.md
// H3; memory note 2026-09-08; trial region_hazards_open_addition/wbt_map_tuple_value_escapes_via_let):
// the callee may keep the pointer for good, as wbt_map@insert keeps a tuple value in its node, and the
// value lives in this function's frame region, which dies at the epilogue. The literal case (a
// tuple_make/record_make argument) is promoted by arg_aggregate_heap_promote at the call; this is the
// same promotion for a name, taken when, and only when, the pointer is inside the current frame: the
// test tuple_elem_frame_var_promote makes for a pack, whose frame bound needs no scratch register on
// this target, so it serves the tail path's X16 staging register too. X0-X7 are preserved.
fn frame_var_arg_promote(reg: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    tuple_elem_frame_var_promote(reg, arg, 0)
}

// Retired: per-pack promote OOMed typecheck. Let-emit promotes once via
// let_stack_agg_escapes_via_tuple; keep the symbol returning 0 for call sites.
fn tuple_elem_var_aggregate_promote_bytes(elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, bound_name: string) -> int64 {
    0
}

fn flat_tuple_spine_packs_var(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name: string) -> boolean {
    n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(t);
    case n.kind == 6 and n.name == "tuple_make" of {
        true -> {
            inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(t, n.inner);
            in: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(inner);
            case in.kind == 1 and in.name == name of {
                true -> true;
                false -> case expr_tuple_packs_var(inner, name) of {
                    true -> true;
                    false -> flat_tuple_spine_packs_var(term_sir_helpers@sir_term_at(t, n.right_expr), name)
                }
            }
        };
        false -> n.kind == 1 and n.name == name
    }
}

fn expr_tuple_packs_var(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name: string) -> boolean {
    n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(t);
    case n.kind == 6 and n.name == "tuple_make" of {
        true -> flat_tuple_spine_packs_var(t, name);
        false -> case n.kind == 2 of {
            true -> case expr_tuple_packs_var(term_sir_helpers@sir_term_at(t, n.inner), name) of {
                true -> true;
                false -> expr_tuple_packs_var(term_sir_helpers@sir_term_at(t, n.right_expr), name)
            };
            false -> case n.kind == 3 of {
                true -> case expr_tuple_packs_var(term_sir_helpers@sir_term_at(t, n.inner), name) of {
                    true -> true;
                    false -> expr_tuple_packs_var(term_sir_helpers@sir_term_at(t, n.right_expr), name)
                };
                false -> false
            }
        }
    }
}

// Retired: early let-promote hung selfhost typecheck (dangling nested fields after let-end).
// Pack nested record_make literals instead (see extract_function / tup_let_rec).
fn let_stack_agg_escapes_via_tuple(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    false
}

// Shallow region copy; does not ADD SP — let epilogue pops the RHS slab.
fn let_early_heap_promote_asm(rhs_bind: string, nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> {
            to_x0: string <- case rhs_bind == "X0" of {
                true -> "";
                false -> xt_isa@xt_mov("X0", rhs_bind)
            };
            from_x0: string <- case rhs_bind == "X0" of {
                true -> "";
                false -> xt_isa@xt_mov(rhs_bind, "X0")
            };
            concat(concat(to_x0, aggregate_return_heap_promote_x0(nbytes)), from_x0)
        }
    }
}

fn aggregate_return_heap_promote_x0(nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> {
            words: int64 <- nbytes / 8;
            case words <= 0 of {
                true -> "";
                false -> {
                    copy_asm: string <- aggregate_heap_copy_words_unrolled(0, words);
                    concat(xt_isa@xt_sub("SP", "SP", "#16"), concat(xt_mem@xt_str("X0", "[SP, #8]"), concat(xt_isa@xt_mov("X0", concat("#", atom_table@int64_to_decimal_string(nbytes))), concat(xt_isa@xt_call("_silica_rt_region_alloc"), concat("\n", concat(xt_isa@xt_mov("X4", "X0"), concat("\n", concat(xt_mem@xt_ldr("X1", "[SP, #8]"), concat("\n", concat(copy_asm, concat(xt_isa@xt_mov("X0", "X4"), concat("\n", concat(xt_isa@xt_add("SP", "SP", "#16"), "\n")))))))))))))
                }
            }
        }
    }
}



fn call_tuple_args_dealloc_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term.root < 0 of {
        true -> 0;
        false -> case term_sir_helpers@sir_term_root_node(term).name == "user_call_rest" of {
            true -> flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) + call_tuple_args_dealloc_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
            false -> flat_tuple_dealloc_size(term)
        }
    }
}



// [SP,#off] or [Xn,#off] when store_base is non-empty (actor behavior sret buffer in X20).


// Total stack bytes allocated by a tuple_make tree (this tuple + all nested tuple elements).

fn flat_tuple_total_alloc(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
        true -> {
            my_count: int64 <- prims_tuple@count_flat_elements(term);
            my_size: int64 <- tuple_make_rec_flat_outer_alloc_bytes(term, my_count);
            nested_raw: int64 <- flat_tuple_nested_alloc(term, my_count, 0);
            trim: int64 <- tuple_make_rec_flat_nested_trim_bytes(term, my_count);
            nested_adj: int64 <- case nested_raw >= trim of { true -> nested_raw - trim; false -> 0 };
            my_size + nested_adj
        };
        false -> 0
    }
}

// True when emit_flat_tuple_stores memcpy-copies idx-0 record_make into the tuple outer slab (`rec_flat`, arity ≥ 2).


// Bytes THIS make needs for its own shell, excluding nested aggregate makes --
// each of those is assigned its own region. agg_alloc_inner returns the TOTAL
// including nested, so using it per-make double counted every nesting level and
// inflated frames (which pushes offsets out of encodable range and makes actor
// stacks grow sooner than they need to).
fn agg_shell_bytes(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(t).kind == 6 and term_sir_helpers@sir_term_root_node(t).name == "tuple_make" of {
        true -> tuple_make_rec_flat_outer_alloc_bytes(t, prims_tuple@count_flat_elements(t));
        false -> case term_sir_helpers@sir_term_root_node(t).kind == 6 and term_sir_helpers@sir_term_root_node(t).name == "record_make" of {
            true -> term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(t).type_name) + flat_record_sum_nested_reserved_in_outer(t);
            false -> 0
        }
    }
}

// True when emit_flat_tuple_stores memcpy-copies idx-0 record_make into the tuple outer slab (`rec_flat`, arity ≥ 2).

fn agg_alloc_inner(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(inner).kind == 6 and term_sir_helpers@sir_term_root_node(inner).name == "tuple_make" of {
        true -> flat_tuple_total_alloc(inner);
        false -> case term_sir_helpers@sir_term_root_node(inner).kind == 6 and term_sir_helpers@sir_term_root_node(inner).name == "record_make" of {
            true -> flat_record_total_alloc(inner);
            false -> 0
        }
    }
}

// Sum agg_alloc_inner along a record_make chain (nested tuple/record in each field). No mutual tail with flat_record_total_alloc.
// Used for nested_adjust (ADD dest, SP, #N) and let dealloc — includes nested makes that self-SUB and user-call padding.


// Sum agg_alloc_inner along a record_make chain (nested tuple/record in each field). No mutual tail with flat_record_total_alloc.
// Used for nested_adjust (ADD dest, SP, #N) and let dealloc — includes nested makes that self-SUB and user-call padding.

fn flat_record_sum_nested_inners(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> 0;
        true -> case prims_record@record_type_has_only_scalar_fields(term_sir_helpers@sir_term_root_node(term).type_name) of {
            true -> 0;
            false -> {
                // A tuple literal field is heap-promoted by emit_flat_record_stores and holds a pointer, so it
                // adds nothing to the record's own slab (it used to be inlined for two elements and counted
                // for more, which put the record base off by the nested slab).
                // A nested record field is inlined the same way: record_make_stack_alloc_size already reserves
                // its words inside the shell (its value-flat size recurses), so counting it again over-stated
                // the slab and the branch popped SP past the saved registers. This must stay in step with
                // inline_nested_rec in emit_flat_record_stores -- the two decide the same thing.
                inner_inline_rec: boolean <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make";
                here: int64 <- case (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make") or inner_inline_rec of {
                    true -> 0;
                    false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 4 or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 5 of {
                        // Boxed layout: a call's aggregate result is a heap pointer (a record
                        // callee promotes; a tuple call reclaims its own sret slab) and the field
                        // stores that pointer, so nothing is reserved or memcpy'd in this frame.
                        true -> case prims_record@record_type_keeps_inline_layout(term_sir_helpers@sir_term_root_node(term).type_name) and record_field_call_reclaims_own_sret(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) == false of {
                            // A runtime-laid-out record still memcpy's a record-returning call's result
                            // into bytes reserved here (legacy inline rules).
                            true -> term_user_call_abi@user_call_aggregate_return_alloc_bytes(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                            false -> 0
                        };
                        false -> agg_alloc_inner(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))
                    }
                };
                rest: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind < 0 of {
                    true -> 0;
                    false -> flat_record_sum_nested_inners(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                };
                here + rest
            }
        }
    }
}

// Bytes the outer record_make SUB must reserve below the shell: user-call aggregate returns that are
// memcpy'd into this frame (from_sorted_err). Nested record_make/tuple_make emit their own SUB —
// counting them here double-subtracts SP (structs_addition/04 hang).


// Bytes the outer record_make SUB must reserve below the shell: user-call aggregate returns that are
// memcpy'd into this frame (from_sorted_err). Nested record_make/tuple_make emit their own SUB —
// counting them here double-subtracts SP (structs_addition/04 hang).

// How far SP moves while this field is emitted, which is what later fields must add to their
// SP-relative offsets. Only a nested make self-SUBs. A user-call inline return does not move SP --
// it is memcpy'd out of the returned pointer into space the outer SUB already reserved -- so it is
// counted once up front, for every field, via flat_record_sum_nested_reserved_in_outer at the
// emit_flat_record_stores call. Counting it here as well would shift the fields after it twice.
fn record_field_nested_return_bytes(elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, fty: string, elem_is_agg: boolean, R: string) -> int64 {
    case elem_is_agg of {
        true -> agg_alloc_inner(elem);
        // Boxed layout: an aggregate VARIABLE stored into a field is copied to the region first
        // (the let that bound it may still hold it in this frame, and the outer record may
        // outlive the frame) and the field holds the copy's pointer. The size comes from the
        // field type, the same authority the readers use. Calls, projections and case results
        // already hand back heap pointers and are stored as they are.
        false -> case term_sir_helpers@sir_term_root_node(elem).kind == 1 and prims_record@record_type_keeps_inline_layout(R) == false of {
            true -> aggregate_type_flat_bytes(fty);
            false -> 0
        }
    }
}

// Flat byte size of a record or tuple type (0 for anything else): what a region copy of one
// value of that type must carry.
fn aggregate_type_flat_bytes(fty: string) -> int64 {
    t: string <- prims_record@strip_spaces_rt(fty);
    case reg_conventions@is_inline_struct_type(t) of {
        true -> prims_record@record_type_value_flat_byte_size(t);
        false -> case reg_conventions@is_tuple_type(t) of {
            true -> prims_tuple@flat_alloc_size(prims_tuple@count_type_elements(t));
            false -> 0
        }
    }
}


fn flat_record_total_alloc(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        true -> case prims_record@record_type_has_only_scalar_fields(term_sir_helpers@sir_term_root_node(term).type_name) of {
            true -> term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(term).type_name);
            false -> {
                my_count: int64 <- prims_record@count_record_fields(term_sir_helpers@sir_term_root_node(term).type_name);
                case my_count < 1 of {
                    true -> 0;
                    false -> {
                        my_size: int64 <- term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(term).type_name);
                        nested: int64 <- flat_record_sum_nested_inners(term);
                        my_size + nested
                    }
                }
            }
        };
        false -> 0
    }
}

// Walk record_make chain; R is the full inline record type string on each node.
// field_prefix: byte offset of this record's fields within an outer value-flat aggregate (trial 08 nested structs).


// Darwin AAPCS64: SP must be 16-byte aligned at BL boundaries; round stack slots up.

// Nested makes self-SUB then are heap-promoted and reclaimed in emit_flat_tuple_stores —
// they must not enlarge the outer tuple SUB.
fn flat_tuple_nested_alloc(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, remaining: int64, acc: int64) -> int64 {
    case remaining <= 1 of {
        true -> acc;
        false -> case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
            true -> flat_tuple_nested_alloc(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), remaining - 1, acc);
            false -> acc
        }
    }
}


// What a direct `{...}` body actually pushed: the shell, plus the bytes the SUB reserved below it for
// user-call inline returns, plus any nested make that self-SUBs. The return type describes only the
// shell, so popping that alone leaked the reserved area; the epilogue's LDP restores then read the
// wrong slots and the function returned to a garbage address. Same authority the let path uses for
// its dealloc, and the counterpart of flat_tuple_dealloc_size for tuples.
// See trials/codegen_regressions/rec_call_field_direct.silica.
fn flat_record_dealloc_size(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    // Same rule as flat_tuple_dealloc_size: a record_make lives in a frame region
    // and pushed nothing, so popping for it leaves SP high. zero_loc() emitted an
    // unpaired "ADD SP, SP, #16", which made LDP restore a bogus X29/X30 and RET
    // jump into hyperspace -- arg_clobber hung rather than returning a value.
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and (term_sir_helpers@sir_term_root_node(term).name == "record_make" or term_sir_helpers@sir_term_root_node(term).name == "tuple_make") of {
        true -> 0;
        false -> flat_record_total_alloc(term)
    }
}

// Aggregate makes allocate in the fixed frame (see emit_tuple_make_stack), so
// there is no SP slab to pop. Every caller of this function is emitting an
// "ADD SP" for a make's slab; sizing a region or a heap-promote copy uses
// flat_tuple_total_alloc / flat_record_total_alloc instead.
fn flat_tuple_dealloc_size(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    // Only an aggregate MAKE moved to a frame region -- it has no SP slab to pop.
    // Other aggregates reaching here (notably a tuple-returning user call) still
    // own a real caller sret slab on SP and must still be popped; returning 0 for
    // those left the slab live and broke compiler_addition/repro_letcall.
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and (term_sir_helpers@sir_term_root_node(term).name == "tuple_make" or term_sir_helpers@sir_term_root_node(term).name == "record_make") of {
        true -> 0;
        false -> agg_promote_bytes(term)
    }
}

fn agg_promote_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        true -> flat_record_total_alloc(term);
        false -> flat_tuple_total_alloc(term)
    }
}

// Stack bytes for let dealloc: tuple_make/record_make use flat layout on caller SP.
// Tuple-returning user calls: caller SUB/MOV X8 is paired in let emission (see base_stack_n),
// not here — case-branch bare calls use pass-through X8 and must stay at 0 (wbt weight_subtree).
// Record-returning user calls heap-promote in the callee — no caller sret slab.


// Stack bytes for let dealloc: tuple_make/record_make use flat layout on caller SP.
// Tuple-returning user calls: caller SUB/MOV X8 is paired in let emission (see base_stack_n),
// not here — case-branch bare calls use pass-through X8 and must stay at 0 (wbt weight_subtree).
// Record-returning user calls heap-promote in the callee — no caller sret slab.
// A checked-int64 prim is also 0: emit_checked_pair_from_regs builds its (ok, value) pair in a
// 16-byte stack slab but copies it to the region and pops the slab itself, handing back a heap
// pointer, so there is nothing left for the let to own. Claiming those 16 bytes here popped a slab
// that no longer existed, and the caller then ran on an SP 16 bytes per prim too high: its next push
// landed on its own callee-saved save area and its epilogue restored X29/X30 from the wrong slots.
// wbt_map:smart_node has two such lets (+32) and it destroyed wbt_map:insert_singleton_map, which is
// where type checking hung; sum_lr_ok, sum_lr_partial, partial_add1_ok, partial_add1_size,
// weight_le_3x, weight_lt_2x and node_weight_from_ref have one each. The prim comment already warns
// against leaving that SUB live to the epilogue -- this is the other half of the same agreement.
// See trials/codegen_regressions/prim_tuple_let.silica.

// Whether a term is a checked-int64 prim, which owns its own stack slab: see the 0 case in
// aggregate_callee_return_stack_bytes for why nobody else may pop it. Exported so the epilogue can ask
// the same question about a function's return-position tail without importing the prim module.
fn term_is_checked_int64_prim(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    term_sir_helpers@sir_term_root_node(term).kind == 6 and prims_checked_int64@is_checked_int64_prim(term_sir_helpers@sir_term_root_node(term).name)
}

// A list_at result is the element's region pointer under the boxed layout (prims_list
// chunk_elem_slot_bytes); only an inline child-spec cell still needs its bytes copied out.
fn list_at_result_promote_bytes(elem_t: string) -> int64 {
    case prims_list@list_elem_is_inline_aggregate(elem_t) of {
        true -> prims_record@record_type_value_flat_byte_size(elem_t);
        false -> 0
    }
}

// Promote size counterpart of aggregate_callee_return_stack_bytes: a make in a
// frame region pops 0 bytes but still needs its real size copied to the heap
// before the pointer leaves the frame.
fn aggregate_callee_return_promote_bytes(rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case reg_conventions@is_aggregate_struct_or_tuple_return_type(term_sir_helpers@sir_term_root_node(rhs).type_name) of {
        false -> 0;
        true -> case term_sir_helpers@sir_term_root_node(rhs).kind == 6 and term_sir_helpers@sir_term_root_node(rhs).name == "list_at" of {
            // Boxed layout: list_at hands back the element's own region pointer (not an address
            // inside the list chunk), so there is nothing to promote -- except a child-spec cell,
            // still spliced inline. Copying record_type_value_flat_byte_size of a TUPLE element
            // copied one word of it.
            true -> list_at_result_promote_bytes(term_sir_helpers@sir_term_root_node(rhs).type_name);
            false -> case term_sir_helpers@sir_term_root_node(rhs).kind == 6 and (term_sir_helpers@sir_term_root_node(rhs).name == "tuple_make" or term_sir_helpers@sir_term_root_node(rhs).name == "record_make") of {
                true -> agg_promote_bytes(rhs);
                false -> 0
            }
        }
    }
}

fn aggregate_callee_return_stack_bytes(rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case reg_conventions@is_aggregate_struct_or_tuple_return_type(term_sir_helpers@sir_term_root_node(rhs).type_name) of {
        false -> 0;
        true -> case term_sir_helpers@sir_term_root_node(rhs).kind == 6 and (term_sir_helpers@sir_term_root_node(rhs).name == "tuple_make" or term_sir_helpers@sir_term_root_node(rhs).name == "record_make") of {
            true -> flat_tuple_dealloc_size(rhs);
            false -> 0
        }
    }
}

// Caller sret slab for a let-bound tuple-returning user call (paired with sret_alloc_bytes in
// emit_generic_user_call_asm_inner). Zero for pass-through / non-tuple.


// Tail is placed in X2, then head is evaluated into X1. Head is often a BL (trim, concat,
// user call) and clobbers caller-saved X2, so prepend sees a garbage list and faults
// (selfhost typecheck hang on `:plain` via split_atom_parts). Save X2 across the head.
// When the head left a tuple slab (cons_dealloc > 0), the save sits under that slab;
// restore from [SP, #N] and free slab+save together.
// See trials/compiler_addition/list_cons_head_call.silica.
fn list_cons_join_tail_head_op(arg2_asm: string, arg1_asm: string, op_asm: string, cons_dealloc: int64) -> string {
    save: string <- xt_mem@xt_str("X2", "[SP, #-16]!");
    case cons_dealloc > 0 of {
        true -> {
            n_s: string <- atom_table@int64_to_decimal_string(cons_dealloc);
            restore: string <- xt_mem@xt_ldr("X2", concat("[SP, #", concat(n_s, "]")));
            free_n: int64 <- cons_dealloc + 16;
            free_s: string <- atom_table@int64_to_decimal_string(free_n);
            free: string <- concat("\n", xt_isa@xt_add("SP", "SP", concat("#", free_s)));
            concat(concat(concat(concat(arg2_asm, "\n"), save), concat(arg1_asm, "\n")), concat(restore, concat(op_asm, free)))
        };
        false -> {
            restore: string <- xt_mem@xt_ldr("X2", "[SP], #16");
            concat(concat(concat(concat(arg2_asm, "\n"), save), concat(arg1_asm, "\n")), concat(restore, op_asm))
        }
    }
}

// Same let-spine walk as let_tail_aggregate_stack_bytes, but returning the REAL
// aggregate size rather than the SP-pop size. A tail make now lives in a frame
// region, so it pops 0 bytes -- but it must still be heap-promoted before return
// or the caller gets a pointer into a dead frame (arg_clobber faulted this way).
fn let_tail_aggregate_promote_bytes(tail: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(tail).kind == 2 of {
        true -> let_tail_aggregate_promote_bytes(term_sir_helpers@sir_term_at(tail, term_sir_helpers@sir_term_root_node(tail).right_expr));
        false -> case term_sir_helpers@sir_term_root_node(tail).kind == 6 and term_sir_helpers@sir_term_root_node(tail).name == "list_at" of {
            true -> list_at_result_promote_bytes(term_sir_helpers@sir_term_root_node(tail).type_name);
            false -> case term_sir_helpers@sir_term_root_node(tail).kind == 6 and (term_sir_helpers@sir_term_root_node(tail).name == "record_make" or term_sir_helpers@sir_term_root_node(tail).name == "tuple_make") of {
                true -> agg_promote_bytes(tail);
                false -> 0
            }
        }
    }
}

fn let_tail_aggregate_stack_bytes(tail: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(tail).kind == 2 of {
        true -> let_tail_aggregate_stack_bytes(term_sir_helpers@sir_term_at(tail, term_sir_helpers@sir_term_root_node(tail).right_expr));
        false -> case term_sir_helpers@sir_term_root_node(tail).kind == 6 and (term_sir_helpers@sir_term_root_node(tail).name == "record_make" or term_sir_helpers@sir_term_root_node(tail).name == "tuple_make") and reg_conventions@is_aggregate_struct_or_tuple_return_type(term_sir_helpers@sir_term_root_node(tail).type_name) of {
            true -> flat_tuple_dealloc_size(tail);
            false -> 0
        }
    }
}
