// Module linkage for AArch64 emission (silica-specification.md §19.3).
// Cross-module calls use module@function in source; SIR may use overload suffixes (fn__paramType) on definitions/calls.
// Trait method calls use the same qualified form (trait file = module; §3.4.8, §19.3.2).
// Local calls use a bare function name; the caller module comes from outer_reg |_lm=.
// SIR may use a legacy main.* prefix on function names; asm_symbol_for_definition maps that to {module}.{fn}.

use sir_ast;
use var;
use atom_table;
use prims_record;
use instantiated_fn_name;
use xt_isa;
use xt_mem;
use control;

export asm_symbol_for_definition/2;
export split_qualified_callee/1;
export asm_linkage_symbol_for_call/2;
export sir_name_from_export_fn_name/1;
export module_defines_program_main/1;
export format_used_modules_comment/1;
export emit_export_global_directives/3;
export format_trait_metadata_comments/1;
export emit_supervisor_start_trampolines/1;
export emit_module_stack_prefix_record/1;

fn starts_with_main_dot(s: string) -> boolean {
    length_bytes(s) >= 5 and substring(s, 0, 5) == "main."
}

// First "@" in callee name, or -1 (spec §19.3.2 module@function).
fn first_at_in_callee(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_callee(s, i + 1)
        }
    }
}

// ("", whole) if unqualified; else (module, function) for module@function.
fn split_qualified_callee(sir_callee: string) -> (string, string) {
    at: int64 <- first_at_in_callee(sir_callee, 0);
    case at < 0 of {
        true -> ("", sir_callee);
        false -> (substring(sir_callee, 0, at), substring(sir_callee, at + 1, length_bytes(sir_callee)))
    }
}

// Align with user_calls@qual_name / definition lowering: parser entry alias "m" -> "main".
fn qual_fn_name_for_linkage(name: string) -> string {
    mapped: string <- case name of {
        "m" -> "main";
        _: string -> name
    };
    instantiated_fn_name@link_name_to_asm_symbol(mapped)
}

// Mach-O / clang integrated assembler: 'L' prefixes are file-local; leading digits are invalid
// label tokens (e.g. module 01_basic_struct_creation → _01_basic_struct_creation_fn).
fn asm_decimal_digit_char(c: string) -> boolean {
    case c of {
        "0" -> true; "1" -> true; "2" -> true; "3" -> true; "4" -> true;
        "5" -> true; "6" -> true; "7" -> true; "8" -> true; "9" -> true;
        _: string -> false
    }
}

fn macho_global_sym_needs_underscore_prefix(raw: string) -> boolean {
    case length_bytes(raw) > 0 of {
        false -> false;
        true -> {
            first: string <- substring(raw, 0, 1);
            case first == "L" of {
                true -> true;
                false -> asm_decimal_digit_char(first)
            }
        }
    }
}

fn macho_escape_global_asm_symbol(raw: string) -> string {
    case raw == "main" of {
        true -> raw;
        false -> case macho_global_sym_needs_underscore_prefix(raw) of {
            true -> concat("_", raw);
            false -> raw
        }
    }
}

// { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } entry label is always `main` (spec 19.1, linker convention).
// Non-main symbols are module-prefixed so short export names (e.g. `contains`) can coexist
// when multiple generated modules link into one executable (§19.3.2 module@fn call sites).
fn asm_symbol_for_definition(module_name: string, sir_fn_name: string) -> string {
    raw: string <- case sir_fn_name == "main" or sir_fn_name == "main.main" or sir_fn_name == "main.m" of {
        true -> "main";
        false -> case starts_with_main_dot(sir_fn_name) of {
            true -> concat(module_name, concat(".", substring(sir_fn_name, 5, length_bytes(sir_fn_name))));
            false -> concat(module_name, concat("_", instantiated_fn_name@link_name_to_asm_symbol(sir_fn_name)))
        }
    };
    macho_escape_global_asm_symbol(raw)
}

// Map SIR callee string to assembly symbol. outer_reg may carry |_lm=mod from emitter_core
// (caller's module for unqualified / local calls only).
fn asm_linkage_symbol_for_call(outer_reg: string, sir_callee: string) -> string {
    (qmod: string, qfn: string) <- split_qualified_callee(sir_callee);
    case length_bytes(qmod) > 0 of {
        true -> asm_symbol_for_definition(qmod, qual_fn_name_for_linkage(qfn));
        false -> {
            lm: string <- var@find_sp_binding(outer_reg, "_lm");
            mod: string <- case length_bytes(lm) > 0 of {
                true -> lm;
                false -> "main"
            };
            asm_symbol_for_definition(mod, qual_fn_name_for_linkage(sir_callee))
        }
    }
}

// Map export surface name to the SIR / asm slug (bracket instantiations → empty_mem_normal__, etc.).
// `.global` and name_matches_export_surface must use the same spelling as sir_fn_link_name labels.
fn sir_name_from_export_fn_name(fn_name: string) -> string {
    mapped: string <- case fn_name of {
        "m" -> "main";
        _: string -> fn_name
    };
    instantiated_fn_name@link_name_to_asm_symbol(mapped)
}

// One record per compiled module: module-prefixed linker symbols (module_fn) are stripped back to
// the Silica fn name (fn) when formatting actor failure call stacks (dladdr dli_sname).
fn emit_module_stack_prefix_record(module_name: string) -> string {
    case module_name == "__silica_runtime" of {
        true -> "";
        false -> {
            prefix: string <- concat(module_name, "_");
            label: string <- concat("_silica_modpfx_", module_name);
            hdr: string <- concat("\n    .section .rodata.silica_modpfx, \"a\"\n    .p2align 3\n    .global ", label);
            body: string <- concat(hdr, concat("\n", concat(label, concat(":\n    .asciz \"", concat(prefix, "\"\n")))));
            body
        }
    }
}

fn module_defines_program_main_loop(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], module_name: string) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case asm_symbol_for_definition(module_name, fns.head.name) == "main" of {
            true -> true;
            false -> module_defines_program_main_loop(fns.tail, module_name)
        }
    }
}

fn module_defines_program_main(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    module_defines_program_main_loop(sir_module.functions, sir_module.module_name)
}

fn format_used_modules_nonempty(uses: List[string, mem(normal)]) -> string {
    case uses.tail.is_nil of {
        true -> uses.head;
        false -> concat(uses.head, concat(", ", format_used_modules_nonempty(uses.tail)))
    }
}

fn format_used_modules_comment(uses: List[string, mem(normal)]) -> string {
    case uses.is_nil of {
        true -> "";
        false -> concat("    # use ", concat(format_used_modules_nonempty(uses), "\n"))
    }
}

// When a provided trait method is monomorphized, one export surface name maps to several
// SIR function labels (e.g. `double_area` → `double_area__int32`, `double_area___width_…`).
// `.global` must name each concrete label, not the surface name, so the linker can resolve
// the mangled call-site references overload_mangle produces.
fn name_matches_export_surface(fn_name: string, surface: string) -> boolean {
    case fn_name == surface of {
        true -> true;
        false -> {
            prefix: string <- concat(surface, "__");
            case length_bytes(fn_name) < length_bytes(prefix) of {
                true -> false;
                false -> substring(fn_name, 0, length_bytes(prefix)) == prefix
            }
        }
    }
}

fn emit_globals_for_matching_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], surface: string, module_name: string, acc: string) -> string {
    case fns.is_nil of {
        true -> acc;
        false -> {
            next_acc: string <- case name_matches_export_surface(fns.head.name, surface) of {
                true -> {
                    sym: string <- asm_symbol_for_definition(module_name, fns.head.name);
                    concat(acc, concat(".global ", concat(sym, "\n")))
                };
                false -> acc
            };
            emit_globals_for_matching_functions(fns.tail, surface, module_name, next_acc)
        }
    }
}

fn emit_export_global_directives_loop(exps: List[{ fn_name: string, arity: string }, mem(normal)], fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], module_name: string, acc: string) -> string {
    case exps.is_nil of {
        true -> acc;
        false -> {
            surface: string <- sir_name_from_export_fn_name(exps.head.fn_name);
            with_matches: string <- emit_globals_for_matching_functions(fns, surface, module_name, acc);
            // Fallback: if no SIR function matches (e.g. non-function export), still emit
            // a single .global for the surface name so legacy behavior is preserved.
            next_acc: string <- case length_bytes(with_matches) == length_bytes(acc) of {
                true -> {
                    sym: string <- asm_symbol_for_definition(module_name, surface);
                    concat(acc, concat(".global ", concat(sym, "\n")))
                };
                false -> with_matches
            };
            emit_export_global_directives_loop(exps.tail, fns, module_name, next_acc)
        }
    }
}

fn emit_export_global_directives(exports: List[{ fn_name: string, arity: string }, mem(normal)], fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], module_name: string) -> string {
    emit_export_global_directives_loop(exports, fns, module_name, "")
}

// silica-specification §3.4.8: trait file surface (export trait, marker impl types, required signatures).
// Emitted as assembler comments so object text matches SIR module metadata (sir_module_to_text); no runtime effect.
// Supervisors Phase D (supervisors_implementation_development_plan.md §15.4.13): `impl_supervisor T` lines mark
// concrete actor types implementing Supervisor for runtime metadata (ingress / init table); see sir_generator traits.
// Supervisors Phase E (same plan §15.4.12–§15.4.13.2): `supervisor_phase_e T init_returns …` lines carry the SIR of
// `init`'s return type (static supervisor_flags + child_spec list) for the runtime internal child table and automatic restart.
// Supervisors Phase F (same plan §15.4.13.4): `impl_failure_reporter T` lines mark the concrete actor type for
// root FailureReporter bootstrap and unwind/handle_report delivery; pairs with `sir_module_to_text` / SIR `impl_failure_reporter`.
// Supervisors Phase G (§15.4.8.4–8.7): no extra trait lines — link / monitor / demonitor are lowered in prims_actors; see
// optional `; supervisors Phase G:` comment in emit_module_asm_prelude (emitter_core) when those prims appear.
fn format_export_trait_names_comments_loop(names: List[string, mem(normal)], acc: string) -> string {
    case names.is_nil of {
        true -> acc;
        false -> format_export_trait_names_comments_loop(names.tail, concat(acc, concat("    # export_trait ", concat(names.head, "\n"))))
    }
}

fn format_failure_reporter_impl_types_comments_loop(types: List[string, mem(normal)], acc: string) -> string {
    case types.is_nil of {
        true -> acc;
        false -> format_failure_reporter_impl_types_comments_loop(types.tail, concat(acc, concat("    # impl_failure_reporter ", concat(types.head, "\n"))))
    }
}

// Align with sir_ast@sir_supervisor_phase_e_rows_to_text: one row per `impl T for Supervisor` marker.
fn format_one_supervisor_phase_e_comment(row: { actor_type: string, init_return_sir: string, init_return_type_name: string }) -> string {
    p1: string <- concat("    # supervisor_phase_e ", row.actor_type);
    p2: string <- concat(p1, " init_returns ");
    concat(p2, concat(row.init_return_sir, "\n"))
}

fn format_supervisor_phase_e_comments_loop(rows: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], acc: string) -> string {
    case rows.is_nil of {
        true -> acc;
        false -> {
            line: string <- format_one_supervisor_phase_e_comment(rows.head);
            format_supervisor_phase_e_comments_loop(rows.tail, concat(acc, line))
        }
    }
}

fn format_one_required_sig_comment(s: { name: string, param_names: string, param_types: string, return_type: string, effects: string }) -> string {
    p1: string <- concat("    # required_fn ", s.name);
    p2: string <- concat(p1, " ");
    p3: string <- concat(p2, s.param_names);
    p4: string <- concat(p3, " ");
    p5: string <- concat(p4, s.param_types);
    p6: string <- concat(p5, " -> ");
    p7: string <- concat(p6, s.return_type);
    p8: string <- concat(p7, " ");
    concat(p8, concat(s.effects, "\n"))
}

fn format_required_trait_sigs_comments_loop(sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], acc: string) -> string {
    case sigs.is_nil of {
        true -> acc;
        false -> {
            line: string <- format_one_required_sig_comment(sigs.head);
            format_required_trait_sigs_comments_loop(sigs.tail, concat(acc, line))
        }
    }
}

// Same scan as type_checker_supervisor@supervisor_trait_top_level_comma_in_type (emitter cannot import type_checker).
fn supervisor_trampoline_top_level_comma_in_type(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case depth == 0 and substring(s, i, i + 1) == "," of {
            true -> i;
            false -> {
                c: string <- substring(s, i, i + 1);
                d2: int64 <- case c == "(" of {
                    true -> depth + 1;
                    false -> case c == ")" of {
                        true -> depth - 1;
                        false -> case c == "{" of {
                            true -> depth + 1;
                            false -> case c == "}" of {
                                true -> depth - 1;
                                false -> case c == "[" of {
                                    true -> depth + 1;
                                    false -> case c == "]" of {
                                        true -> depth - 1;
                                        false -> depth
                                    }
                                }
                            }
                        }
                    }
                };
                supervisor_trampoline_top_level_comma_in_type(s, i + 1, d2)
            }
        }
    }
}

// AArch64 aggregate return: caller allocates buffer, passes pointer in X8 (init uses |_callee_sret=X8).
// Size = value-flat supervisor_flags record + one word for List head (§15.4.13.2), rounded up to 16 B.
fn supervisor_init_sret_alloc_bytes(return_type_name: string) -> int64 {
    t: string <- prims_record@strip_spaces_rt(return_type_name);
    case length_bytes(t) < 2 of {
        true -> 0;
        false -> case substring(t, 0, 1) == "(" and substring(t, length_bytes(t) - 1, length_bytes(t)) == ")" of {
            false -> 0;
            true -> {
                inner: string <- prims_record@strip_spaces_rt(substring(t, 1, length_bytes(t) - 1));
                comma: int64 <- supervisor_trampoline_top_level_comma_in_type(inner, 0, 0);
                case comma < 0 of {
                    true -> 0;
                    false -> {
                        first: string <- prims_record@strip_spaces_rt(substring(inner, 0, comma));
                        first_b: int64 <- prims_record@record_type_value_flat_byte_size(first);
                        list_b: int64 <- 8;
                        total: int64 <- first_b + list_b;
                        (total + 15) / 16 * 16
                    }
                }
            }
        }
    }
}

// Supervisors Phase E (supervisors_implementation_development_plan §15.4.12–§15.4.13.2, tasks e2a/e2b):
// For every `impl T for Supervisor` marker in the module, emit a per-supervisor trampoline symbol
//     _silica_supervisor_start_<T>
// whose minimal body calls the module's `init` ({module}_init linkage symbol) and returns. Later phases (e3a–e3c) extend this body to walk the returned
// (supervisor_flags, List[child_spec, normal]) tuple, spawn_linked each child, record child
// table entries on the ACB, and anchor the runtime automatic-restart path.
// The trampoline is invoked once at first schedule of the supervisor actor by
// _silica_rt_supervisor_start (to be wired in a subsequent phase). Emitting the symbol now
// keeps the link graph complete and lets integration tests observe its presence.
// Phase E e3b: trampoline invoked once at first schedule (actor_thread_main hook).
// X0 in = ACB pointer. Load initial state from [ACB], call init with X8 = sret buffer, pass (ACB, tuple_ptr) to materialize.
//
// Xtensa: the trampoline is a windowed function laid out exactly like emitter_core lays out a
// compiled function. Its frame symbols are published ahead of the label (the body references one
// frame home, SVR_X19, which keeps the ACB pointer across the two CALL8s; X0/X1 are a10-a13, X8 and
// SP live in the global block and the aux VR stack, so nothing else needs frame space), the label is
// 4-byte aligned and opens with ENTRY, the ACB pointer arrives as X0 through
// control@function_prologue's a2-a7 -> a10-a15 moves, and the result goes back through
// control@function_epilogue_with_frame (RETW). The sret buffer for init is reserved on the aux VR
// stack the way term_emit_kind_call reserves it for every tuple-returning user call (SUB SP; MOV X8,
// SP; ... ADD SP). Symbols go through xt_sym like every other reference on this target, so the
// leading underscore is dropped from the trampoline's own label and from the runtime entry it calls
// (board/runtime/rt_actors_stub.S defines silica_rt_supervisor_materialize_init_children until the
// actor runtime is ported).
fn supervisor_trampoline_frame_header() -> string {
    // emitter_core@xt_frame_header arithmetic for one 8-byte home and no spill slots:
    // homes [0, 8), SFP = align16(8) = 16, SFRAME = align16(SFP + 32) = 48.
    ".set SFRAME, 48\n.set SFP, 16\n.set SVR_X19, 0\n"
}

fn format_one_supervisor_trampoline(module_name: string, actor_type: string, sret_bytes: int64) -> string {
    sym: string <- xt_isa@xt_sym(concat("_silica_supervisor_start_", actor_type));
    header: string <- concat(supervisor_trampoline_frame_header(), concat("    .globl ", concat(sym, "\n")));
    prologue: string <- concat(control@function_prologue(sym), xt_isa@xt_mov("X19", "X0"));
    init_sym: string <- asm_symbol_for_definition(module_name, "init");
    init_call: string <- concat(xt_mem@xt_ldr("X0", "[X19]"), xt_isa@xt_call(init_sym));
    mid: string <- concat(xt_isa@xt_mov("X1", "X0"), concat(xt_isa@xt_mov("X0", "X19"), xt_isa@xt_call("_silica_rt_supervisor_materialize_init_children")));
    epilogue: string <- control@function_epilogue_with_frame();
    szs: string <- atom_table@int64_to_decimal_string(sret_bytes);
    body: string <- case sret_bytes > 0 of {
        true -> concat(prologue, concat(xt_isa@xt_sub("SP", "SP", concat("#", szs)), concat(xt_isa@xt_mov("X8", "SP"), concat(init_call, concat(mid, concat(xt_isa@xt_add("SP", "SP", concat("#", szs)), epilogue))))));
        false -> concat(concat(concat(concat(prologue, xt_isa@xt_mov("X8", "XZR")), init_call), mid), epilogue)
    };
    concat(header, body)
}

// A :supervisor child whose start function sits in the same unit (`behavior: inner_start`) has
// no `impl T for Supervisor` trampoline to name: the child spec stored a zero trampoline, so the
// runtime never called the start function and the nested supervisor ran with no children
// (bugaudit nest). Each such start function gets a file-local trampoline that calls that
// function itself and materializes its children. term_child_spec@supervisor_fn_trampoline_symbol
// spells the same symbol at the child spec.
fn supervisor_fn_trampoline_symbol(fn_label: string) -> string {
    concat("_silica_supervisor_start_fn_", instantiated_fn_name@link_name_to_asm_symbol(fn_label))
}

fn format_one_supervisor_fn_trampoline(module_name: string, fn_label: string) -> string {
    sym: string <- xt_isa@xt_sym(supervisor_fn_trampoline_symbol(fn_label));
    header: string <- supervisor_trampoline_frame_header();
    prologue: string <- concat(control@function_prologue(sym), concat(xt_isa@xt_mov("X19", "X0"), xt_isa@xt_mov("X8", "XZR")));
    start_sym: string <- asm_symbol_for_definition(module_name, qual_fn_name_for_linkage(fn_label));
    start_call: string <- concat(xt_mem@xt_ldr("X0", "[X19]"), xt_isa@xt_call(start_sym));
    mid: string <- concat(xt_isa@xt_mov("X1", "X0"), concat(xt_isa@xt_mov("X0", "X19"), xt_isa@xt_call("_silica_rt_supervisor_materialize_init_children")));
    epilogue: string <- control@function_epilogue_with_frame();
    concat(header, concat(prologue, concat(start_call, concat(mid, epilogue))))
}

fn string_list_contains(xs: List[string, mem(normal)], needle: string) -> boolean {
    case xs.is_nil of {
        true -> false;
        false -> case xs.head == needle of {
            true -> true;
            false -> string_list_contains(xs.tail, needle)
        }
    }
}

// Unqualified function-pointer constants (SIR kind 0, type fn_ptr) in a body.
fn collect_local_fn_ptr_labels_from_nodes(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case nodes.is_nil of {
        true -> acc;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- nodes.head;
            acc2: List[string, mem(normal)] <- case n.kind == 0 and n.type_name == "fn_ptr" and first_at_in_callee(n.value, 0) < 0 and length_bytes(n.value) > 0 and string_list_contains(acc, n.value) == false of {
                true -> sir_ast@cons_sir_string(n.value, acc);
                false -> acc
            };
            collect_local_fn_ptr_labels_from_nodes(nodes.tail, acc2)
        }
    }
}

fn collect_local_fn_ptr_labels(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case fns.is_nil of {
        true -> acc;
        false -> collect_local_fn_ptr_labels(fns.tail, collect_local_fn_ptr_labels_from_nodes(fns.head.body.nodes, acc))
    }
}

// A supervisor start function returns (supervisor_flags, List[child_spec, ...]).
fn is_supervisor_start_return_type(return_type: string) -> boolean {
    t: string <- prims_record@strip_spaces_rt(return_type);
    length_bytes(t) > 11 and substring(t, 0, 11) == "({strategy:"
}

fn fn_with_name_is_supervisor_start(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], name: string) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case fns.head.name == name of {
            true -> is_supervisor_start_return_type(fns.head.return_type);
            false -> fn_with_name_is_supervisor_start(fns.tail, name)
        }
    }
}

fn emit_supervisor_fn_trampolines_loop(module_name: string, fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], labels: List[string, mem(normal)], acc: string) -> string {
    case labels.is_nil of {
        true -> acc;
        false -> {
            stanza: string <- case fn_with_name_is_supervisor_start(fns, labels.head) of {
                true -> format_one_supervisor_fn_trampoline(module_name, labels.head);
                false -> ""
            };
            emit_supervisor_fn_trampolines_loop(module_name, fns, labels.tail, concat(acc, stanza))
        }
    }
}

fn emit_supervisor_fn_trampolines(module_name: string, fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> string {
    body: string <- emit_supervisor_fn_trampolines_loop(module_name, fns, collect_local_fn_ptr_labels(fns, sir_ast@nil_sir_strings()), "");
    case length_bytes(body) == 0 of {
        true -> "";
        false -> concat("    # supervisor start trampolines for same-unit start functions of :supervisor children\n", body)
    }
}

fn emit_supervisor_start_trampolines_phase_e_loop(module_name: string, rows: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], acc: string) -> string {
    case rows.is_nil of {
        true -> acc;
        false -> {
            row: { actor_type: string, init_return_sir: string, init_return_type_name: string } <- rows.head;
            nb: int64 <- supervisor_init_sret_alloc_bytes(row.init_return_type_name);
            stanza: string <- format_one_supervisor_trampoline(module_name, row.actor_type, nb);
            emit_supervisor_start_trampolines_phase_e_loop(module_name, rows.tail, concat(acc, stanza))
        }
    }
}

fn emit_supervisor_start_trampolines_loop(module_name: string, types: List[string, mem(normal)], acc: string) -> string {
    case types.is_nil of {
        true -> acc;
        false -> {
            stanza: string <- format_one_supervisor_trampoline(module_name, types.head, 0);
            emit_supervisor_start_trampolines_loop(module_name, types.tail, concat(acc, stanza))
        }
    }
}

// Spawn lowering tags SIR value "[concurrency]|e3b:<T>" and the AArch64 emitter always
// ADRP/ADDs _silica_supervisor_start_<T>. If marker-impl collect missed the tag-6 decl,
// still emit the trampoline from those referenced type names so the object links.
fn e3b_type_from_sir_value(value: string) -> string {
    case length_bytes(value) > 18 and substring(value, 13, 18) == "|e3b:" of {
        true -> substring(value, 18, length_bytes(value));
        false -> ""
    }
}

fn e3b_type_list_contains(types: List[string, mem(normal)], needle: string) -> boolean {
    case types.is_nil of {
        true -> false;
        false -> case types.head == needle of {
            true -> true;
            false -> e3b_type_list_contains(types.tail, needle)
        }
    }
}

fn collect_e3b_types_from_nodes(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case nodes.is_nil of {
        true -> acc;
        false -> {
            tn: string <- e3b_type_from_sir_value(nodes.head.value);
            acc2: List[string, mem(normal)] <- case length_bytes(tn) == 0 or e3b_type_list_contains(acc, tn) of {
                true -> acc;
                false -> sir_ast@cons_sir_string(tn, acc)
            };
            collect_e3b_types_from_nodes(nodes.tail, acc2)
        }
    }
}

fn collect_e3b_types_from_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case fns.is_nil of {
        true -> acc;
        false -> collect_e3b_types_from_functions(fns.tail, collect_e3b_types_from_nodes(fns.head.body.nodes, acc))
    }
}

fn module_defines_init(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case fns.head.name == "init" of {
            true -> true;
            false -> module_defines_init(fns.tail)
        }
    }
}

fn child_start_name_suffix() -> string {
    "_child_start"
}

fn add_trampoline_type_if_new(tn: string, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case length_bytes(tn) == 0 or e3b_type_list_contains(acc, tn) of {
        true -> acc;
        false -> sir_ast@cons_sir_string(tn, acc)
    }
}

// Nested supervisor modules export `T_child_start` and do not call spawn_registered_supervisor.
// Child-spec lowering in the parent ADRPs `_silica_supervisor_start_T`; define T here.
fn type_from_child_start_name(name: string, module_name: string) -> string {
    suf: string <- child_start_name_suffix();
    ls: int64 <- length_bytes(name);
    lf: int64 <- length_bytes(suf);
    case ls > lf and substring(name, ls - lf, ls) == suf of {
        false -> "";
        true -> {
            prefix: string <- substring(name, 0, ls - lf);
            case prefix == module_name of {
                true -> prefix;
                false -> {
                    sep: string <- concat(module_name, "_");
                    sl: int64 <- length_bytes(sep);
                    case length_bytes(prefix) > sl and substring(prefix, 0, sl) == sep of {
                        true -> substring(prefix, sl, length_bytes(prefix));
                        false -> prefix
                    }
                }
            }
        }
    }
}

fn collect_child_start_types_from_exports(exps: List[{ fn_name: string, arity: string }, mem(normal)], module_name: string, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case exps.is_nil of {
        true -> acc;
        false -> collect_child_start_types_from_exports(exps.tail, module_name, add_trampoline_type_if_new(type_from_child_start_name(exps.head.fn_name, module_name), acc))
    }
}

fn collect_child_start_types_from_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], module_name: string, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case fns.is_nil of {
        true -> acc;
        false -> collect_child_start_types_from_functions(fns.tail, module_name, add_trampoline_type_if_new(type_from_child_start_name(fns.head.name, module_name), acc))
    }
}

fn emit_supervisor_start_trampolines(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> string {
    hdr: string <- "    # supervisors Phase E (e3b): per-impl start trampolines (calls init + materialize children)\n";
    mod_name: string <- sir_module.module_name;
    concat(emit_supervisor_impl_trampolines(sir_module, hdr, mod_name), emit_supervisor_fn_trampolines(mod_name, sir_module.functions))
}

fn emit_supervisor_impl_trampolines(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, hdr: string, mod_name: string) -> string {
    case sir_module.supervisor_phase_e.is_nil of {
        false -> concat(hdr, emit_supervisor_start_trampolines_phase_e_loop(mod_name, sir_module.supervisor_phase_e, ""));
        true -> case sir_module.supervisor_impl_types.is_nil of {
            false -> concat(hdr, emit_supervisor_start_trampolines_loop(mod_name, sir_module.supervisor_impl_types, ""));
            true -> {
                from_exps: List[string, mem(normal)] <- collect_child_start_types_from_exports(sir_module.exports, mod_name, sir_ast@nil_sir_strings());
                from_fns: List[string, mem(normal)] <- collect_child_start_types_from_functions(sir_module.functions, mod_name, from_exps);
                fallback_types: List[string, mem(normal)] <- collect_e3b_types_from_functions(sir_module.functions, from_fns);
                // The fallback covers a module whose own `impl T for Supervisor` the marker collect
                // missed. A module that merely SPAWNS a supervisor declared in another unit has no
                // `init` for the trampoline to call: emitting one here referenced `<this module>_init`
                // and the program failed to link. The unit holding the impl (and init) defines the
                // global `_silica_supervisor_start_<T>`; this unit only references it.
                // See trials/supervisors_addition/supervisor_init_in_other_unit.
                case fallback_types.is_nil or module_defines_init(sir_module.functions) == false of {
                    true -> "";
                    false -> concat(hdr, emit_supervisor_start_trampolines_loop(mod_name, fallback_types, ""))
                }
            }
        }
    }
}

fn format_trait_metadata_comments(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> string {
    t: string <- case sir_module.export_trait_names.is_nil of {
        true -> "";
        false -> format_export_trait_names_comments_loop(sir_module.export_trait_names, "")
    };
    phe: string <- case sir_module.supervisor_phase_e.is_nil of {
        true -> "";
        false -> concat("    # supervisors Phase E: declarative children / automatic restart (supervisor_phase_e init SIR; §15.4.12–§15.4.13.2)\n", format_supervisor_phase_e_comments_loop(sir_module.supervisor_phase_e, ""))
    };
    f: string <- case sir_module.failure_reporter_impl_types.is_nil of {
        true -> "";
        false -> concat("    # supervisors Phase F: root FailureReporter metadata (impl_failure_reporter actor type; §15.4.13.4)\n", format_failure_reporter_impl_types_comments_loop(sir_module.failure_reporter_impl_types, ""))
    };
    r: string <- case sir_module.required_method_sigs.is_nil of {
        true -> "";
        false -> format_required_trait_sigs_comments_loop(sir_module.required_method_sigs, "")
    };
    concat(concat(concat(t, phe), f), r)
}
