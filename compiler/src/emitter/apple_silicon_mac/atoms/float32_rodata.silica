// Float32/float16 print: helper rodata only (L_pf32_10, L_pf32_minus for L_pf32_helper).
// print_float32 uses L_pf32_helper directly; print_float16 widens H0 to S0 first.

export module_uses_float32_print/1;
export emit_float32_helper_rodata/0;

// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

// One walk for every "does this body call X" question: true when a call (kind 4, or 5 in tail
// position) named `a` or `b` appears anywhere in the term, with a non-literal argument when
// `need_var`. Every node's two children are searched, so a call nested in another call's argument
// (show(print_int8(v))), in a later argument, or in a case arm is found just the same. Before this
// each per-type walker stopped at the first call node it met, and a print inside a call argument
// had no helper or rodata label: trials/compile_defects_nested_print_in_call_arg_addition.
fn term_has_call_named(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, a: string, b: string, need_var: boolean) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            named: boolean <- (node.kind == 4 or node.kind == 5) and (node.name == a or node.name == b);
            hit: boolean <- case named of {
                false -> false;
                true -> case need_var of {
                    false -> true;
                    true -> sir_term_root_node(sir_term_at(term, node.inner)).kind != 0
                }
            };
            case hit of {
                true -> true;
                false -> case node.kind == 0 or node.kind == 1 of {
                    true -> false;
                    false -> case term_has_call_named(sir_term_at(term, node.inner), a, b, need_var) of {
                        true -> true;
                        false -> term_has_call_named(sir_term_at(term, node.right_expr), a, b, need_var)
                    }
                }
            }
        }
    }
}

fn term_has_float32_print(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    term_has_call_named(term, "main.print_float32", "main.print_float16", false)
}

fn float32_print_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_float32_print(fns.head.body) of {
            true -> true;
            false -> float32_print_in_functions(fns.tail)
        }
    }
}

fn module_uses_float32_print(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    float32_print_in_functions(sir_module.functions)
}

// L_pf32_10 (.single 10.0), L_pf32_minus (.byte 0x2d, 0) for L_pf32_helper
fn emit_float32_helper_rodata() -> string {
    header: string <- ".section __TEXT,__rodata\n.align\t4\n";
    ten: string <- "L_pf32_10:\n    .single 10.0\n";
    minus: string <- "L_pf32_minus:\n    .byte 0x2d, 0\n";
    concat(concat(concat(header, ten), minus), "")
}
