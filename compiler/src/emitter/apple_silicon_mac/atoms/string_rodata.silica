            case node.kind of {
            6 -> case node.type_name == "string" and node.name == "string_concat" of {
                true -> true;
                false -> case term_has_string_concat(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_has_string_concat(sir_term_at(term, node.right_expr))
                }
            };
            2 -> case term_has_string_concat(sir_term_at(term, node.inner)) of {
