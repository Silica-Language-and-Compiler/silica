            case node.kind of {
            6 -> case node.name == "string_starts_with" or node.name == "string_ends_with" or node.name == "string_contains" of {
                true -> true;
                false -> case term_has_string_predicate(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_has_string_predicate(sir_term_at(term, node.right_expr))
                }
