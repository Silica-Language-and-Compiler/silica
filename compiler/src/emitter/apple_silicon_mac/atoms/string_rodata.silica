fn is_string_compare_prim_name(name: string) -> boolean {
    name == "lt" or name == "gt" or name == "le" or name == "ge" or name == "eq" or name == "nq"
}

// Bool-result compares dispatch on operand type (sir_term_at(term, node.inner)); see prims@bool_result_compare_prim.
fn term_is_string_compare_prim(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
    case node.kind == 6 and is_string_compare_prim_name(node.name) of {
        false -> false;
        true -> case node.type_name == "bool" of {
            true -> sir_term_root_node(sir_term_at(term, node.inner)).type_name == "string";
            false -> node.type_name == "string"
        }
    }
}

fn term_has_string_compare(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case node.kind of {
            6 -> case term_is_string_compare_prim(term) of {
                true -> true;
                false -> case term_has_string_compare(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_has_string_compare(sir_term_at(term, node.right_expr))
                }
            };
            2 -> case term_has_string_compare(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_compare(sir_term_at(term, node.right_expr))
            };
            4 -> case term_has_string_compare(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_compare(sir_term_at(term, node.right_expr))
            };
            3 -> case term_has_string_compare(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_compare(sir_term_at(term, node.right_expr))
            };
            5 -> case term_has_string_compare(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_compare(sir_term_at(term, node.right_expr))
            };
            7 -> case term_has_string_compare(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_compare(sir_term_at(term, node.right_expr))
            };
            8 -> case term_has_string_compare(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_compare(sir_term_at(term, node.right_expr))
            };
            _: int64 -> false
            }
        }
    }
}

fn string_compare_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
