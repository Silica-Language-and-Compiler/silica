                false -> term_has_string_concat(sir_term_at(term, node.right_expr))
            };
            4 -> case term_has_string_concat(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_concat(sir_term_at(term, node.right_expr))
            };
            3 -> case term_has_string_concat(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_concat(sir_term_at(term, node.right_expr))
            };
            5 -> case term_has_string_concat(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_concat(sir_term_at(term, node.right_expr))
            };
            7 -> case term_has_string_concat(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_concat(sir_term_at(term, node.right_expr))
            };
            8 -> case term_has_string_concat(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_concat(sir_term_at(term, node.right_expr))
            };
            _: int64 -> false
            }
        }
    }
}

