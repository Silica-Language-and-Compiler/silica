// String rodata: detect if module uses print_string or println with var arg (needs L_ps_helper).
// String literals themselves are emitted by string_literal_pool.


export module_uses_print_string_var/1;
export module_uses_print_string_stderr_var/1;

// One walk for every "does this body call X" question: true when a call (kind 4, or 5 in tail
// position) named `a` or `b` appears anywhere in the term, with a non-literal argument when
// `need_var`. Every node's two children are searched, so a call nested in another call's argument
// (show(print_int8(v))), in a later argument, or in a case arm is found just the same. Before this
// each per-type walker stopped at the first call node it met, and a print inside a call argument
// had no helper or rodata label: trials/compile_defects_nested_print_in_call_arg_addition.
fn term_has_call_named(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, a: string, b: string, need_var: boolean) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            named: boolean <- (node.kind == 4 or node.kind == 5) and (node.name == a or node.name == b);
            hit: boolean <- case named of {
                false -> false;
                true -> case need_var of {
                    false -> true;
                    true -> sir_term_root_node(sir_term_at(term, node.inner)).kind != 0
                }
            };
            case hit of {
                true -> true;
                false -> case node.kind == 0 or node.kind == 1 of {
                    true -> false;
                    false -> case term_has_call_named(sir_term_at(term, node.inner), a, b, need_var) of {
                        true -> true;
                        false -> term_has_call_named(sir_term_at(term, node.right_expr), a, b, need_var)
                    }
                }
            }
        }
    }
}

fn term_has_print_string_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    term_has_call_named(term, "main.print_string", "main.println", true)
}

fn print_string_var_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_print_string_var(fns.head.body) of {
            true -> true;
            false -> print_string_var_in_functions(fns.tail)
        }
    }
}

fn module_uses_print_string_var(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    print_string_var_in_functions(sir_module.functions)
}

// Stderr prints (handle_report / probes): fd 2; needs L_ps_helper_stderr when argument is variable.
fn term_has_print_string_stderr_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    term_has_call_named(term, "main.print_string_stderr", "main.println_stderr", true)
}

fn print_string_stderr_var_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_print_string_stderr_var(fns.head.body) of {
            true -> true;
            false -> print_string_stderr_var_in_functions(fns.tail)
        }
