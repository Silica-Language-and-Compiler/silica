                false -> term_has_string_predicate(sir_term_at(term, node.right_expr))
            };
            4 -> case term_has_string_predicate(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_predicate(sir_term_at(term, node.right_expr))
