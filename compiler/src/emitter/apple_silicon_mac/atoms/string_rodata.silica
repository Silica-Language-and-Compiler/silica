// Case branch with string literal pattern (pk == "string") needs L_string_eq_helper: pointer
// compare is wrong when scrutinee is heap/mmap (e.g. substring) vs rodata literal.
fn pat_text_has_quoted_string_at(s: string, i: int64, n: int64) -> boolean {
    case i >= n of {
        true -> false;
        false -> case substring(s, i, i + 1) == "\"" of {
            true -> true;
            false -> pat_text_has_quoted_string_at(s, i + 1, n)
        }
    }
}

fn pat_text_has_quoted_string(s: string) -> boolean {
    n: int64 <- length_bytes(s);
    pat_text_has_quoted_string_at(s, 0, n)
}

fn term_has_string_case_pattern(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case node.kind of {
            8 -> case node.value == "string" of {
                true -> true;
                // A record or tuple pattern with no string element still has a guard and a body to
                // search (a string pattern in a case nested in the arm needs the helper as well).
                false -> case (node.value == "record" or node.value == "tuple") and pat_text_has_quoted_string(node.name) of {
                    true -> true;
                    false -> case term_has_string_case_pattern(sir_term_at(term, node.inner)) of {
                        true -> true;
                        false -> term_has_string_case_pattern(sir_term_at(term, node.right_expr))
                    }
                }
            };
            3 -> case term_has_string_case_pattern(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_case_pattern(sir_term_at(term, node.right_expr))
            };
            5 -> case term_has_string_case_pattern(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_case_pattern(sir_term_at(term, node.right_expr))
            };
            7 -> case term_has_string_case_pattern(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_case_pattern(sir_term_at(term, node.right_expr))
            };
            2 -> case term_has_string_case_pattern(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_case_pattern(sir_term_at(term, node.right_expr))
            };
            4 -> case term_has_string_case_pattern(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_case_pattern(sir_term_at(term, node.right_expr))
            };
            6 -> case term_has_string_case_pattern(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_string_case_pattern(sir_term_at(term, node.right_expr))
            };
            _: int64 -> false
            }
        }
    }
}

fn string_case_pattern_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_string_case_pattern(fns.head.body) of {
            true -> true;
            false -> string_case_pattern_in_functions(fns.tail)
        }
    }
}

