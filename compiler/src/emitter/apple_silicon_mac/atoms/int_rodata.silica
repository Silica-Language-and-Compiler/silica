fn term_has_int64_signed_print_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    term_has_call_named(term, "main.print_int64", "main.print_int64", true)
}

