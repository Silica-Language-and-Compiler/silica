fn int64_print_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_int64_print(fns.head.body) of {
            true -> true;
            false -> int64_print_in_functions(fns.tail)
        }
    }
}

