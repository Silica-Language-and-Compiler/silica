fn emit_int64_rodata_section_nonempty(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }) -> string {
    sequence
        header: string <- ".section __TEXT,__rodata\n.align\t8\n";
        in_order: List[string, mem(normal)] <- reverse_values(table.values);
        body: string <- emit_int64_values_rodata(in_order, 0, "L_pi");
        result: string <- concat(header, body)
    produces
        pure result
    end
}

fn emit_int64_rodata_section(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }) -> string {
    case table.is_empty of {
        true -> "";
        false -> emit_int64_rodata_section_nonempty(table)
    }
}

