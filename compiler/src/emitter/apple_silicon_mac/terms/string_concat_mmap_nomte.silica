// String concatenation helper: non-MTE fallback for Apple Silicon (macOS ARM64).
// Per silica-specification §21.3: "If MTE is not available... runtime falls back to software-based
// bounds checking... Memory safety is maintained through compiler-generated bounds checks."
//
// L_concat_helper: X0 = ptr1, X1 = ptr2 (null-terminated UTF-8). Returns X0 = ptr to concatenated
// string. Empty operands return the other pointer (no allocation). Length of the most recent
// result is cached so growing concat(acc, ch) in strip_spaces is O(1) strlen. Longer results
// bump-allocate from 4MB mmap chunks. mmap-per-call used to SIGKILL type checking of
// wbt_map.silica (75GB physical footprint from char-by-char strip_spaces).
//
// Every actor runs on its own thread and the arena is one per compilation unit, so the bump
// (load pointer, add, store) is taken under L_sc_lock: two actors concatenating at once were
// handed the same bytes (book defect D12, trials/actors_addition/string_concat_cast_stress).
//
// Isolated module for vigorous testing. Targets: Apple Silicon, macOS ARM64.

export emit_string_concat_helper/0;

fn sc_helper_lens() -> string {
    "L_concat_helper:\n    STP X19, X20, [SP, #-64]!\n    STP X21, X22, [SP, #16]\n    STP X23, X30, [SP, #32]\n    MOV X19, X0\n    MOV X20, X1\n    LDR X9, [X19]\n    MVN X10, X9\n    CMP X10, #1\n    B.HI L_sc_bad\n    LDR X21, [X19, #16]\n    LDR X9, [X20]\n    MVN X10, X9\n    CMP X10, #1\n    B.HI L_sc_bad\n    LDR X22, [X20, #16]\n    CBZ X21, L_sc_ret2\n    CBZ X22, L_sc_ret1\n    ADD X0, X21, X22\n    ADD X0, X0, #25\n    BL L_sc_bump_alloc\n    CBZ X0, L_sc_ret\n    MOV X23, X0\n    MOV X9, #-1\n    STR X9, [X23]\n    ADD X9, X23, #24\n    STR X9, [X23, #8]\n    ADD X10, X21, X22\n    STR X10, [X23, #16]\n    LDR X10, [X19, #8]\n    MOV X11, X21\n"
}

fn sc_helper_copy() -> string {
    "L_sc_cp1:\n    CBZ X11, L_sc_cp1_done\n    LDRB W12, [X10]\n    STRB W12, [X9]\n    ADD X9, X9, #1\n    ADD X10, X10, #1\n    SUB X11, X11, #1\n    B L_sc_cp1\nL_sc_cp1_done:\n    LDR X10, [X20, #8]\n    MOV X11, X22\nL_sc_cp2:\n    CBZ X11, L_sc_cp2_done\n    LDRB W12, [X10]\n    STRB W12, [X9]\n    ADD X9, X9, #1\n    ADD X10, X10, #1\n    SUB X11, X11, #1\n    B L_sc_cp2\nL_sc_cp2_done:\n    STRB WZR, [X9]\n    MOV X0, X23\n    B L_sc_ret\nL_sc_ret2:\n    MOV X0, X20\n    B L_sc_ret\nL_sc_ret1:\n    MOV X0, X19\nL_sc_ret:\n    LDP X23, X30, [SP, #32]\n    LDP X21, X22, [SP, #16]\n    LDP X19, X20, [SP], #64\n    RET\nL_sc_bad:\n    BRK #1\n"
}

fn sc_helper_bump() -> string {
    "L_sc_bump_alloc:\n    STP X19, X30, [SP, #-32]!\n    STP X20, X21, [SP, #16]\n    ADD X0, X0, #7\n    LSR X0, X0, #3\n    LSL X19, X0, #3\n    ADRP X1, L_sc_lock@PAGE\n    ADD X1, X1, L_sc_lock@PAGEOFF\n    MOV W2, #1\nL_sc_lock_spin:\n    LDAXR W3, [X1]\n    CBNZ W3, L_sc_lock_wait\n    STXR W3, W2, [X1]\n    CBZ W3, L_sc_lock_held\n    B L_sc_lock_spin\nL_sc_lock_wait:\n    CLREX\n    YIELD\n    B L_sc_lock_spin\nL_sc_lock_held:\n    ADRP X20, L_sc_arena_ptr@PAGE\n    ADD X20, X20, L_sc_arena_ptr@PAGEOFF\n    LDR X21, [X20]\n    CBZ X21, L_sc_bump_new\n    ADRP X1, L_sc_arena_end@PAGE\n    ADD X1, X1, L_sc_arena_end@PAGEOFF\n    LDR X2, [X1]\n    ADD X3, X21, X19\n    CMP X3, X2\n    B.HI L_sc_bump_new\n    STR X3, [X20]\n    MOV X0, X21\n    ADRP X1, L_sc_lock@PAGE\n    ADD X1, X1, L_sc_lock@PAGEOFF\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\nL_sc_bump_new:\n    ADD X1, X19, #16\n    MOVZ X2, #0x40, LSL #16\n    CMP X1, X2\n    CSEL X1, X1, X2, HI\n    MOV X21, X1\n    MOV X0, #0\n    MOV X2, #3\n    MOV X3, #0x1002\n    MOV X4, #-1\n    MOV X5, #0\n    MOVZ X16, #0xC5\n    MOVK X16, #0x200, LSL #16\n    SVC #0x80\n    CMN X0, #1\n    B.EQ L_sc_bump_fail\n    ADRP X2, L_sc_arena_head@PAGE\n    ADD X2, X2, L_sc_arena_head@PAGEOFF\n    LDR X3, [X2]\n    STR X3, [X0]\n    STR X21, [X0, #8]\n    STR X0, [X2]\n    ADD X1, X0, #16\n    ADD X3, X1, X19\n    STR X3, [X20]\n    ADRP X2, L_sc_arena_end@PAGE\n    ADD X2, X2, L_sc_arena_end@PAGEOFF\n    ADD X3, X0, X21\n    STR X3, [X2]\n    MOV X0, X1\n    ADRP X1, L_sc_lock@PAGE\n    ADD X1, X1, L_sc_lock@PAGEOFF\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\nL_sc_bump_fail:\n    MOV X0, #0\n    ADRP X1, L_sc_lock@PAGE\n    ADD X1, X1, L_sc_lock@PAGEOFF\n    STLR WZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\nL_sc_arena_mark:\n    ADRP X16, L_sc_arena_ptr@PAGE\n    ADD X16, X16, L_sc_arena_ptr@PAGEOFF\n    LDR X16, [X16]\n    ADRP X17, L_sc_arena_head@PAGE\n    ADD X17, X17, L_sc_arena_head@PAGEOFF\n    LDR X17, [X17]\n    RET\nL_sc_arena_release_to:\n    STP X29, X30, [SP, #-16]!\n    STP X0, X1, [SP, #-16]!\n    STP X2, X3, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    MOV X19, X16\n    MOV X20, X17\n    ADRP X3, L_sc_arena_head@PAGE\n    ADD X3, X3, L_sc_arena_head@PAGEOFF\n    LDR X2, [X3]\nL_sc_rt_loop:\n    CMP X2, X20\n    B.EQ L_sc_rt_done\n    CBZ X2, L_sc_rt_done\n    LDR X0, [X2]\n    STR X0, [X3]\n    LDR X1, [X2, #8]\n    MOV X0, X2\n    MOVZ X16, #73\n    MOVK X16, #0x200, LSL #16\n    SVC #0x80\n    ADRP X3, L_sc_arena_head@PAGE\n    ADD X3, X3, L_sc_arena_head@PAGEOFF\n    LDR X2, [X3]\n    B L_sc_rt_loop\nL_sc_rt_done:\n    ADRP X0, L_sc_arena_ptr@PAGE\n    ADD X0, X0, L_sc_arena_ptr@PAGEOFF\n    STR X19, [X0]\n    CBZ X20, L_sc_rt_noend\n    LDR X1, [X20, #8]\n    ADD X1, X20, X1\n    ADRP X0, L_sc_arena_end@PAGE\n    ADD X0, X0, L_sc_arena_end@PAGEOFF\n    STR X1, [X0]\n    B L_sc_rt_caches\nL_sc_rt_noend:\n    ADRP X0, L_sc_arena_end@PAGE\n    ADD X0, X0, L_sc_arena_end@PAGEOFF\n    STR XZR, [X0]\nL_sc_rt_caches:\n    ADRP X0, L_sc_len_key@PAGE\n    ADD X0, X0, L_sc_len_key@PAGEOFF\n    STR XZR, [X0]\n    ADRP X0, L_sc_len_val@PAGE\n    ADD X0, X0, L_sc_len_val@PAGEOFF\n    STR XZR, [X0]\n    LDP X19, X20, [SP], #16\n    LDP X2, X3, [SP], #16\n    LDP X0, X1, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nL_sc_arena_release:\n    STP X19, X30, [SP, #-32]!\n    STP X20, X21, [SP, #16]\n    ADRP X20, L_sc_arena_head@PAGE\n    ADD X20, X20, L_sc_arena_head@PAGEOFF\n    LDR X19, [X20]\nL_sc_rel_loop:\n    CBZ X19, L_sc_rel_done\n    LDR X21, [X19]\n    LDR X1, [X19, #8]\n    MOV X0, X19\n    MOVZ X16, #73\n    MOVK X16, #0x200, LSL #16\n    SVC #0x80\n    MOV X19, X21\n    B L_sc_rel_loop\nL_sc_rel_done:\n    STR XZR, [X20]\n    ADRP X1, L_sc_arena_ptr@PAGE\n    ADD X1, X1, L_sc_arena_ptr@PAGEOFF\n    STR XZR, [X1]\n    ADRP X1, L_sc_arena_end@PAGE\n    ADD X1, X1, L_sc_arena_end@PAGEOFF\n    STR XZR, [X1]\n    ADRP X1, L_sc_len_key@PAGE\n    ADD X1, X1, L_sc_len_key@PAGEOFF\n    STR XZR, [X1]\n    ADRP X1, L_sc_len_val@PAGE\n    ADD X1, X1, L_sc_len_val@PAGEOFF\n    STR XZR, [X1]\n    LDP X20, X21, [SP, #16]\n    LDP X19, X30, [SP], #32\n    RET\n    .section __DATA,__bss\n    .p2align 3\nL_sc_len_key:\n    .space 8\nL_sc_len_val:\n    .space 8\nL_sc_lock:\n    .space 8\nL_sc_arena_ptr:\n    .space 8\nL_sc_arena_end:\n    .space 8\nL_sc_arena_head:\n    .space 8\n    .section __TEXT,__text,regular,pure_instructions\n    .p2align 2"
}

fn emit_string_concat_helper() -> string {
    concat(concat(sc_helper_lens(), sc_helper_copy()), sc_helper_bump())
}
