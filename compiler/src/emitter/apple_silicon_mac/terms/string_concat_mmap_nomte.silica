// String concatenation helper: non-MTE fallback for Apple Silicon (macOS ARM64).
// Per silica-specification §21.3: "If MTE is not available... runtime falls back to software-based
// bounds checking... Memory safety is maintained through compiler-generated bounds checks."
//
// L_concat_helper: X0 = ptr1, X1 = ptr2, X16 = the result block (L_concat_size; any value when an operand
// is empty). Returns X0 = ptr to the concatenated string. Empty operands return the other pointer
// (no allocation). The block belongs to the caller's frame (chunk 15 phase 2), so a new string can
// land on an address an older, dead string had: L_str_forget drops that address from the substring
// helper's caches before the header is written.
//
// Isolated module for vigorous testing. Targets: Apple Silicon, macOS ARM64.

export emit_string_concat_helper/0;

fn sc_helper_lens() -> string {
    "L_concat_helper:\n    STP X19, X20, [SP, #-64]!\n    STP X21, X22, [SP, #16]\n    STP X23, X30, [SP, #32]\n    MOV X19, X0\n    MOV X20, X1\n    LDR X9, [X19]\n    MVN X10, X9\n    CMP X10, #1\n    B.HI L_sc_bad\n    LDR X21, [X19, #16]\n    LDR X9, [X20]\n    MVN X10, X9\n    CMP X10, #1\n    B.HI L_sc_bad\n    LDR X22, [X20, #16]\n    CBZ X21, L_sc_ret2\n    CBZ X22, L_sc_ret1\n    MOV X23, X16\n    MOV X9, X23\n    BL L_str_forget\n    MOV X9, #-1\n    STR X9, [X23]\n    ADD X9, X23, #24\n    STR X9, [X23, #8]\n    ADD X10, X21, X22\n    STR X10, [X23, #16]\n    LDR X10, [X19, #8]\n    MOV X11, X21\n"
}

fn sc_helper_copy() -> string {
    "L_sc_cp1:\n    CBZ X11, L_sc_cp1_done\n    LDRB W12, [X10]\n    STRB W12, [X9]\n    ADD X9, X9, #1\n    ADD X10, X10, #1\n    SUB X11, X11, #1\n    B L_sc_cp1\nL_sc_cp1_done:\n    LDR X10, [X20, #8]\n    MOV X11, X22\nL_sc_cp2:\n    CBZ X11, L_sc_cp2_done\n    LDRB W12, [X10]\n    STRB W12, [X9]\n    ADD X9, X9, #1\n    ADD X10, X10, #1\n    SUB X11, X11, #1\n    B L_sc_cp2\nL_sc_cp2_done:\n    STRB WZR, [X9]\n    MOV X0, X23\n    B L_sc_ret\nL_sc_ret2:\n    MOV X0, X20\n    B L_sc_ret\nL_sc_ret1:\n    MOV X0, X19\nL_sc_ret:\n    LDP X23, X30, [SP, #32]\n    LDP X21, X22, [SP, #16]\n    LDP X19, X20, [SP], #64\n    RET\nL_sc_bad:\n    BRK #1\n"
}


// L_concat_size(X0 = a, X1 = b) -> X16 = the bytes of the result block (24-byte header, both byte runs,
// the NUL, rounded to 16), or 0 when either operand is empty and L_concat_helper returns the other.
// Only X16 and X17 change.
fn sc_helper_size() -> string {
    "L_concat_size:\n    LDR X16, [X0, #16]\n    CBZ X16, 1f\n    LDR X17, [X1, #16]\n    CBZ X17, 2f\n    ADD X16, X16, X17\n    ADD X16, X16, #40\n    AND X16, X16, #0xfffffffffffffff0\n1:\n    RET\n2:\n    MOV X16, #0\n    RET\n"
}

// Chunk 15 phase 2 (design §3.7): the result is built in a block of the CALLER's frame. The emitted
// sequence is L_concat_size, L_dyn_alloc of that many bytes when it is not 0, then L_concat_helper with
// the block in X16; the process-wide bump arena, its lock and its mark/release are gone.
fn emit_string_concat_helper() -> string {
    concat(sc_helper_size(), concat(sc_helper_lens(), sc_helper_copy()))
}
