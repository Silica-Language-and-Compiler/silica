// Phase E e3a — linked-list child table (Option B): no contiguous buffer / realloc.
// Anchors in the supervisor's supervision block (ACB #216, _silica_rt_sb_require; item I of
// actor_memory_budget_plan.md): SB #24 head (first node ptr), #32 len (i64 row count / list length),
// #40 sync_failure_reported (0/1; root cap-breach reports synchronously, later thread exit skips duplicate).
// An actor without a block has no table; start_child and materialize make one for the running actor.
// Node size 128 B: payload 80 B (same row layout as e3a), next ptr @ +80 (0 = end), the supervision block @ +88
// (sb_child_done finds it there; the child's reference keeps the node alive), the child's spawner record
// @ +96 (position + 1) / +104 (next child number), kept across the child's restarts (spec §15.1.4,
// §15.4.12.1), the current child's identity @ +112 (what call_supervisor answers with), and @ +120 the
// carrier actors parked for this row's exit_done (linked through ACB #456; _silica_rt_row_wait_exit_done
// in prims_actors_carrier_asm.silica, emptied by the child's exit_done store).
// Offsets in row payload: +0 child_ref, +8 id atom, +16 agent_type, +24 start.0, +32 start.1, +40 restart atom,
// +48 shutdown i64, +56 exit_done / sync, +64 flavor atom (:plain | :dangerous), +72 supervisor_start_trampoline (0 for worker).
// Phase E e3f tombstone: child_ref==0 means inactive; len stays high-water for :rest_for_one ordering.

use atom_table;
use prims_list;

export emit_child_table_runtime_asm/1;

// Spine link offset for init/1 static List[child_spec] chunks; must match prims_list chunk_data_bytes.
fn child_spec_init_list_chunk_data_bytes() -> int64 {
    prims_list@chunk_data_bytes("{ id: atom, agent_type: atom, initial_state: int64, behavior: fn, restart: atom, shutdown: int64, flavor: atom }")
}

// Atoms are int64 indices (§4.1.7); strcmp on row/ACB atom fields was never valid.
// e4b: row.restart dispatch over (perm, trans). x0 = restart atom, x28 = reason_tag (0=:normal, !=0=abnormal).
//   :permanent → always restart.
//   :transient → restart iff reason_tag != 0; on :normal exit, fall through to tombstone.
//   anything else (e.g. :temporary, missing atom) → tombstone (no restart).
fn maybe_restart_policy_dispatch(perm_idx: int64, trans_idx: int64) -> string {
    perm_cmp: string <- case perm_idx < 0 of {
        true -> "";
        false -> concat(concat("	cmp	x0, #", atom_table@int64_to_decimal_string(perm_idx)), "\n	b.eq	Lmr_can_restart\n")
    };
    trans_cmp: string <- case trans_idx < 0 of {
        true -> "";
        false -> concat(concat("	cmp	x0, #", atom_table@int64_to_decimal_string(trans_idx)), "\n	b.eq	Lmr_check_transient\n")
    };
    fall: string <- "	b	Lmr_tombstone_done\n";
    trans_block: string <- case trans_idx < 0 of {
        true -> "";
        false -> "Lmr_check_transient:\n	cbz	x28, Lmr_tombstone_done\n"
    };
    label_can: string <- "Lmr_can_restart:\n";
    concat(concat(concat(concat(perm_cmp, trans_cmp), fall), trans_block), label_can)
}

fn maybe_restart_strat_eq_branch(idx: int64, dest: string) -> string {
    case idx < 0 of {
        true -> "";
        false -> concat(concat(concat("	cmp	x0, #", atom_table@int64_to_decimal_string(idx)), "\n	b.eq	"), concat(dest, "\n"))
    }
}

fn child_table_rt_asm_chunk_0() -> string {
    "	.section	__TEXT,__text,regular,pure_instructions
; --- Phase E e3a Option B: linked-list child table ---
; _silica_rt_child_table_free: X0=ACB* — walk nodes (+80 next), free each, clear anchors.
; _silica_rt_child_table_ensure_min_cap: X0=ACB*, X1=min node count — X0=0 ok, 1 OOM. Appends 88 B nodes (80 B row + next) until count >= X1.
	.globl	_silica_rt_child_table_free
	.p2align	2
_silica_rt_child_table_free:
	.cfi_startproc
	stp	x20, x19, [sp, #-32]!
	str	x30, [sp, #16]
	.cfi_def_cfa wsp, 32
	.cfi_offset w20, -32
	.cfi_offset w19, -24
	.cfi_offset w30, -16
	mov	x19, x0
	ldr	x8, [x19, #216]
	cbz	x8, Lct_free_none
	mov	x0, x19
	bl	_silica_rt_sup_shutdown_children
	mov	x0, x19
	bl	_silica_rt_sup_quiesce
; The rows and the block outlive this actor while a linked child still holds a reference: the
; child's last act is its row's exit_done store (sb_child_done), after its own teardown. This
; actor's teardown drops its reference; the last one frees the rows and the block (sb_unref).
	ldr	x0, [x19, #216]
	str	xzr, [x19, #216]
	bl	_silica_rt_sb_unref
Lct_free_none:
	ldr	x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
; Supervisor teardown vs. a dying child's wait for its replacement (actor_thread_main and the
; badarith / case_clause / name-taken ends): the child counts itself in the supervisor's block (#96)
; while it reads the row, only while the supervisor is alive and not tearing down (#104), under the
; supervisor's lock; the teardown (child_table_free) marks #104 and waits for the count to reach 0
; before the rows, the block and the ACB go.
	.globl	_silica_rt_sup_wait_enter
	.p2align	2
_silica_rt_sup_wait_enter:
; X0 = supervisor ACB -> X0 = 1 counted, 0 not (the child does not wait).
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, xzr
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	w8, [x19, #152]
	cbz	w8, Lswe_unlock
	ldr	x9, [x19, #216]
	cbz	x9, Lswe_unlock
	ldr	x10, [x9, #104]
	cbnz	x10, Lswe_unlock
	ldr	x10, [x9, #96]
	add	x10, x10, #1
	str	x10, [x9, #96]
	mov	x20, #1
Lswe_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x20
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.globl	_silica_rt_sup_wait_leave
	.p2align	2
_silica_rt_sup_wait_leave:
; X0 = supervisor ACB: the child has stopped reading its row.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x9, [x19, #216]
	ldr	x10, [x9, #96]
	sub	x10, x10, #1
	str	x10, [x9, #96]
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.globl	_silica_rt_sup_quiesce
	.p2align	2
_silica_rt_sup_quiesce:
; X0 = an ending actor with a supervision block: no child starts counting from now on, and the
; children still counted are waited for (each stops at once: this actor is no longer alive).
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x20, [x19, #216]
	mov	x9, #1
	str	x9, [x20, #104]
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
Lsq_wait:
	ldr	x9, [x20, #96]
	cbz	x9, Lsq_done
	mov	w0, #100
	bl	_usleep
	b	Lsq_wait
Lsq_done:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
; _silica_rt_sup_shutdown_children(X0 = a supervisor that has ended: alive (#152) is 0): the
; coordinated shutdown of its live children (spec §15.4.8.4, §15.4.12.2), last row first, one at a
; time. Each row is tombstoned before its child is told (maybe_restart no longer finds it, and a
; child waiting for its replacement stops waiting); a child with shutdown 0 is killed (reason tag 1,
; as kill_abnormal), one with shutdown > 0 ends with (:explicit, :shutdown). On the hosts a child
; ends at its next dispatch boundary in both cases: a dispatch in progress runs to completion, and
; the shutdown time is not enforced. The wait is for the row's exit_done, the child's last act, so
; its registered name (§20.3.1) is gone before this returns and a restarted supervisor can register
; its children again. It runs only on the supervisor's own thread (its exit path: deliver_exit, and
; again, idempotent, child_table_free; maybe_restart's synchronous root report): a wait for the
; children on another thread could wait on that thread's own actor. A row holding the running
; actor itself is skipped all the same. The block
; is held (#112) for the walk, so the rows outlive a concurrent teardown of the supervisor.
	.globl	_silica_rt_sup_shutdown_children
	.p2align	2
_silica_rt_sup_shutdown_children:
	stp	x24, x23, [sp, #-64]!
	stp	x22, x21, [sp, #16]
	stp	x20, x19, [sp, #32]
	stp	x29, x30, [sp, #48]
	add	x29, sp, #48
	mov	x19, x0
	ldr	x20, [x19, #216]
	cbz	x20, Lssc_ret
	add	x9, x20, #112
Lssc_ref:
	ldaxr	x10, [x9]
	add	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lssc_ref
	bl	_silica_rt_tls_current_actor_get
	mov	x21, x0
	mov	x22, #0
	ldr	x9, [x20, #24]
Lssc_count:
	cbz	x9, Lssc_next
	add	x22, x22, #1
	ldr	x9, [x9, #80]
	b	Lssc_count
Lssc_next:
	cbz	x22, Lssc_unref
	sub	x22, x22, #1
	ldr	x23, [x20, #24]
	mov	x10, x22
Lssc_walk:
	cbz	x10, Lssc_at
	ldr	x23, [x23, #80]
	sub	x10, x10, #1
	b	Lssc_walk
Lssc_at:
	ldr	x8, [x23]
	cbz	x8, Lssc_next
	cmp	x8, x21
	b.eq	Lssc_next
	str	xzr, [x23]
	ldr	x0, [x23, #112]
	bl	_silica_rt_ref_hold
	mov	x24, x0
	cbz	x24, Lssc_wait
	add	x0, x24, #16
	bl	_os_unfair_lock_lock
	ldr	w8, [x24, #152]
	cbz	w8, Lssc_unlock
	ldr	x8, [x23, #48]
	cmp	x8, #0
	b.le	Lssc_kill
	mov	x8, #4
	str	x8, [x24, #232]
	adrp	x8, _silica_rt_shutdown_atom@PAGE
	add	x8, x8, _silica_rt_shutdown_atom@PAGEOFF
	ldr	x8, [x8]
	str	x8, [x24, #384]
	b	Lssc_stop
Lssc_kill:
	mov	x8, #1
	str	x8, [x24, #232]
Lssc_stop:
	str	wzr, [x24, #152]
	mov	x0, x24
	bl	_silica_rt_actor_mail_signal
Lssc_unlock:
	add	x0, x24, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x24
	bl	_silica_rt_acb_release
Lssc_wait:
; A carrier actor parks for the row's exit_done (prims_actors_carrier_asm.silica); anything else
; sleeps and polls it as before.
	mov	x0, x23
	mov	x1, x24
	bl	_silica_rt_row_wait_exit_done
	cbnz	x0, Lssc_next
Lssc_poll:
	ldr	x8, [x23, #56]
	cbnz	x8, Lssc_next
	mov	w0, #50
	bl	_usleep
	b	Lssc_poll
Lssc_unref:
	mov	x0, x20
	bl	_silica_rt_sb_unref
Lssc_ret:
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
; Supervision-block lifetime. SB #112 counts references: the owning actor's (sb_require) and one per
; linked child started from a row (actor_spawn_linked_row, taken before the child's thread exists).
; Each row node keeps its block at +88. A child can outlive its supervisor, and its final row store
; comes after it has freed itself, so neither the owner's teardown nor the child may free the rows
; alone: whoever drops the last reference frees every row node and then the block.
	.globl	_silica_rt_sb_unref
	.p2align	2
_silica_rt_sb_unref:
; X0 = supervision block or 0: drop one reference.
	cbz	x0, Lsbu_ret
	add	x9, x0, #112
Lsbu_dec:
	ldaxr	x10, [x9]
	sub	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lsbu_dec
	cbnz	x10, Lsbu_ret
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
; Notices still in the ingress (front list #0, rear list #8; node +0 = next) go with the block: an
; exit notice (+24 == 0) gives back its payload and its hold on the ended child.
	ldr	x20, [x19]
	str	xzr, [x19]
Lsbu_free_ingress:
	cbnz	x20, Lsbu_free_node
	ldr	x20, [x19, #8]
	str	xzr, [x19, #8]
	cbz	x20, Lsbu_rows
Lsbu_free_node:
	ldr	w9, [x20, #24]
	cbnz	w9, Lsbu_free_node_only
	ldr	x0, [x20, #8]
	bl	_silica_rt_exit_payload_free
Lsbu_free_node_only:
	mov	x0, x20
	ldr	x20, [x20]
	bl	_free
	b	Lsbu_free_ingress
Lsbu_rows:
	ldr	x20, [x19, #24]
Lsbu_free_row:
	cbz	x20, Lsbu_free_block
	mov	x0, x20
	ldr	x20, [x20, #80]
	bl	_free
	b	Lsbu_free_row
Lsbu_free_block:
	mov	x0, x19
	bl	_free
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
Lsbu_ret:
	ret
	.globl	_silica_rt_sb_child_done
	.p2align	2
_silica_rt_sb_child_done:
; X0 = the ended child's row (0: not a row child). Its last two acts, after its ACB is gone: the
; row's exit_done = 1 (a cascade stop or kill_abnormal waits for it; a carrier actor parked for it
; is made ready: _silica_rt_row_exit_done_store), then its block reference.
	cbz	x0, Lscd_ret
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	ldr	x19, [x0, #88]
	bl	_silica_rt_row_exit_done_store
	mov	x0, x19
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	b	_silica_rt_sb_unref
Lscd_ret:
	ret
	.globl	_silica_rt_child_table_ensure_min_cap
	.p2align	2
_silica_rt_child_table_ensure_min_cap:
	.cfi_startproc
; X0=ACB* X1=min_nodes. Returns X0=0 success, 1 OOM.
	stp	x26, x25, [sp, #-80]!
	stp	x24, x23, [sp, #16]
	stp	x22, x21, [sp, #32]
	stp	x20, x19, [sp, #48]
	stp	x29, x30, [sp, #64]
	add	x29, sp, #64
	.cfi_def_cfa w29, 16
	.cfi_offset w19, -32
	.cfi_offset w20, -24
	.cfi_offset w21, -40
	.cfi_offset w22, -32
	.cfi_offset w23, -56
	.cfi_offset w24, -48
	.cfi_offset w25, -72
	.cfi_offset w26, -64
	mov	x19, x0
	mov	x20, x1
	cmp	x20, #0
	ble	Lct_ens_ok
Lct_ens_retry:
	ldr	x21, [x19, #216]
	ldr	x21, [x21, #24]
	mov	x22, #0
	mov	x23, x21
Lct_count_loop:
	cbz	x23, Lct_count_done
	add	x22, x22, #1
	ldr	x23, [x23, #80]
	b	Lct_count_loop
Lct_count_done:
	cmp	x22, x20
	b.hs	Lct_ens_ok
	mov	w0, #1
	mov	w1, #128
	bl	_calloc
	cbz	x0, Lct_ens_fail
	mov	x24, x0
	str	xzr, [x24, #80]
	ldr	x9, [x19, #216]
	str	x9, [x24, #88]
	ldr	x21, [x9, #24]
	cbnz	x21, Lct_link_at_tail
	str	x24, [x9, #24]
	b	Lct_ens_retry
Lct_link_at_tail:
	mov	x25, x21
Lct_find_tail:
	ldr	x26, [x25, #80]
	cbz	x26, Lct_found_tail
	mov	x25, x26
	b	Lct_find_tail
Lct_found_tail:
	str	x24, [x25, #80]
	b	Lct_ens_retry
Lct_ens_ok:
	mov	x0, #0
	ldp	x29, x30, [sp, #64]
	ldp	x20, x19, [sp, #48]
	ldp	x22, x21, [sp, #32]
	ldp	x24, x23, [sp, #16]
	ldp	x26, x25, [sp], #80
	ret
Lct_ens_fail:
	mov	x0, #1
	ldp	x29, x30, [sp, #64]
	ldp	x20, x19, [sp, #48]
	ldp	x22, x21, [sp, #32]
	ldp	x24, x23, [sp, #16]
	ldp	x26, x25, [sp], #80
	ret
	.cfi_endproc
"
}

fn child_table_rt_spawn_child_row_by_flavor_asm(danger_idx: int64) -> string {
    danger_cmp: string <- case danger_idx < 0 of {
        true -> "";
        false -> concat(concat("	ldr	x9, [x19, #64]\n	cmp	x9, #", atom_table@int64_to_decimal_string(danger_idx)), "\n	b.eq	Lsscr_register_dangerous\n")
    };
    // X6 of the spawn: 1 for a :dangerous row (it keeps a thread under carriers, item N stage 1).
    danger_flag: string <- case danger_idx < 0 of {
        true -> "	mov	x6, xzr\n";
        false -> concat(concat("	ldr	x9, [x19, #64]\n	cmp	x9, #", atom_table@int64_to_decimal_string(danger_idx)), "\n	cset	x6, eq\n")
    };
    danger_reg: string <- case danger_idx < 0 of {
        true -> "";
        false -> "Lsscr_register_dangerous:\n	ldr	x0, [x21, #408]\n	ldr	x1, [x19, #8]\n	bl	_silica_rt_register_dangerous_actor_named\n	b	Lsscr_register_plain\n"
    };
    pre: string <- "	.globl	_silica_rt_supervisor_spawn_child_row_by_flavor
	.p2align	2
_silica_rt_supervisor_spawn_child_row_by_flavor:
; X0 = row, X1 = supervisor ACB -> X0 = the row's new child (0 when no thread could be made). Every
; start of a row's child comes here (materialize, start_child, respawn_row). The spawn returns the
; child held for this spawner (#392). The row takes the reference; the child's id is registered
; (§20.3.1) unless the child has already ended (and dropped again if it ended meanwhile: a name never
; names an ended actor); a notice the child parked at #400, because it ended before this commit, is
; enqueued now that the row holds the child, so maybe_restart finds it. Then the spawner lets go.
	.cfi_startproc
	stp	x22, x21, [sp, #-64]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	mov	x19, x0
	mov	x20, x1
	str	xzr, [x19, #56]
	ldr	x0, [x19, #24]
	ldr	x1, [x19, #32]
	ldr	x2, [x19, #16]
	mov	x3, x19
	ldr	x4, [x19, #72]
	mov	x5, x20
";
    pre2: string <- "	bl	_silica_rt_actor_spawn_linked_row
	mov	x21, x0
	str	x21, [x19]
	cbz	x21, Lsscr_done
	ldr	w9, [x21, #152]
	cbz	w9, Lsscr_commit
";
    mid: string <- "Lsscr_register_plain:
	ldr	x0, [x21, #408]
	ldr	x1, [x19, #8]
	bl	_silica_rt_register_actor_named
	dmb	ish
	ldr	w9, [x21, #152]
	cbnz	w9, Lsscr_commit
	mov	x0, x21
	bl	_silica_rt_registry_forget_actor
Lsscr_commit:
	add	x9, x21, #400
	mov	x10, #1
Lsscr_take:
	ldaxr	x22, [x9]
	stlxr	w11, x10, [x9]
	cbnz	w11, Lsscr_take
	cmp	x22, #1
	b.ls	Lsscr_let_go
	mov	x0, x20
	mov	x1, x22
	bl	_silica_rt_sup_enqueue_exit
Lsscr_let_go:
	mov	x0, x21
	bl	_silica_rt_acb_release
Lsscr_done:
	mov	x0, x21
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #64
	ret
";
    concat(concat(concat(concat(concat(pre, danger_flag), pre2), danger_cmp), mid), concat(danger_reg, "	.cfi_endproc
"))
}

// Phase E e3b: _silica_rt_supervisor_materialize_init_children
// X0=ACB*, X1=tuple_ptr (init return: flags record pointer in slot 0 -- shape word at +0, fields at +8..+31 -- children list head at +8).
// Walks the list-literal handle of child_spec records (shape word plus 56 B of fields, then the hidden
// supervisor_start_trampoline at +64 in each child_spec element).
// Payload layout matches the emitter's record: shape@0, id@8, agent@16, start@(24,32), restart@40, shutdown@48, flavor@56.
// For each child_spec: spawn_linked(start.0, start.1, agent_type, row_ptr), append a linked row node (88 B; 80 B payload).
// Stores strategy atom, allowed_restart_count, and restarts_time_frame at SB#56/#64/#72 for
// restart strategy dispatch (e3d) and frequency cap (e3e). Current record emission returns a pointer
// to the supervisor_flags record in tuple slot 0 and the child list in slot 24; keep a flat fallback
// for older generated tuple shapes where slot 0 is the strategy atom directly.
fn child_table_rt_asm_chunk_1(danger_idx: int64, list_chunk_bytes: int64) -> string {
    pre: string <- "	.globl	_silica_rt_supervisor_materialize_init_children
	.p2align	2
_silica_rt_supervisor_materialize_init_children:
	.cfi_startproc
	stp	x28, x27, [sp, #-96]!
	stp	x26, x25, [sp, #16]
	stp	x24, x23, [sp, #32]
	stp	x22, x21, [sp, #48]
	stp	x20, x19, [sp, #64]
	stp	x29, x30, [sp, #80]
	add	x29, sp, #80
	.cfi_def_cfa w29, 16
	.cfi_offset w19, -32
	.cfi_offset w20, -24
	.cfi_offset w21, -40
	.cfi_offset w22, -32
	.cfi_offset w23, -56
	.cfi_offset w24, -48
	.cfi_offset w25, -72
	.cfi_offset w26, -64
	.cfi_offset w27, -88
	.cfi_offset w28, -80
	mov	x19, x0
	mov	x20, x1
	mov	x0, x19
	bl	_silica_rt_sb_require
	ldr	x8, [x20]
	cmp	x8, #4096
	b.lo	Lmat_pre_flags_flat
	mov	x15, #8
	ldr	x9, [x8, #8]
	str	x9, [x0, #56]
	ldr	x9, [x8, #16]
	str	x9, [x0, #64]
	ldr	x9, [x8, #24]
	str	x9, [x0, #72]
	b	Lmat_pre_flags_done
Lmat_pre_flags_flat:
	mov	x15, #24
	str	x8, [x0, #56]
	ldr	x9, [x20, #8]
	str	x9, [x0, #64]
	ldr	x9, [x20, #16]
	str	x9, [x0, #72]
Lmat_pre_flags_done:
	add	x14, x20, x15
	ldr	x20, [x14]
	cbz	x20, Lmat_done
	ldr	x21, [x20, #8]
	ldr	x14, [x20, #16]
	ldr	x20, [x20]
Lmat_loop:
	cbz	x20, Lmat_done
	cbz	x21, Lmat_done
	add	x15, x21, x14
	ldr	x22, [x15, #24]
	ldr	x23, [x15, #32]
	ldr	x24, [x15, #16]
	ldr	x25, [x15, #8]
	ldr	x26, [x15, #40]
	ldr	x27, [x15, #48]
; x15 (the child spec) is read again after the row is set up: kept on the stack across the calls
; below, which may clobber it (calloc in ensure_min_cap; a fault in materialize_init_children).
	str	x15, [sp, #-16]!
; §20.3.1: a child whose id a live actor or supervisor already holds is not started, and init
; fails with :language_error (the supervisor is the current actor while its start trampoline runs).
	mov	x0, x25
	bl	_silica_rt_registry_name_held
	cbz	x0, Lmat_id_free
	bl	_silica_rt_registry_name_taken
Lmat_id_free:
; Phase E e4f + Option B: ensure one more list node, then walk `len` links from head for stable row ptr (no realloc).
	mov	x0, x19
	ldr	x1, [x19, #216]
	ldr	x1, [x1, #32]
	add	x1, x1, #1
	bl	_silica_rt_child_table_ensure_min_cap
	ldr	x15, [sp], #16
	cbnz	x0, Lmat_done
	ldr	x9, [x19, #216]
	ldr	x28, [x9, #24]
	ldr	x9, [x9, #32]
	mov	x10, x9
Lmat_walk_row:
	cbz	x10, Lmat_walk_row_done
	ldr	x28, [x28, #80]
	sub	x10, x10, #1
	b	Lmat_walk_row
Lmat_walk_row_done:
";
    post: string <- concat("    str xzr, [x28]\n    str x25, [x28, #8]\n    str x24, [x28, #16]\n    str x22, [x28, #24]\n    str x23, [x28, #32]\n    str x26, [x28, #40]\n    str x27, [x28, #48]\n    str xzr, [x28, #56]\n    ldr x9, [x15, #56]\n    str x9, [x28, #64]\n    ldr x9, [x15, #64]\n    str x9, [x28, #72]\n", "    mov x0, x28\n    mov x1, x19\n    bl _silica_rt_supervisor_spawn_child_row_by_flavor\n");
    list_chunk_s: string <- atom_table@int64_to_decimal_string(list_chunk_bytes);
    tail_pre: string <- "	ldr	x10, [x19, #216]
	ldr	x9, [x10, #32]
	add	x9, x9, #1
	str	x9, [x10, #32]
	ldr	x21, [x21, #";
    tail_post: string <- "]
	mov	x14, #0
	sub	x20, x20, #1
	b	Lmat_loop
Lmat_done:
	ldp	x29, x30, [sp, #80]
	ldp	x20, x19, [sp, #64]
	ldp	x22, x21, [sp, #48]
	ldp	x24, x23, [sp, #32]
	ldp	x26, x25, [sp, #16]
	ldp	x28, x27, [sp], #96
	ret
	.cfi_endproc
";
    tail: string <- concat(concat(tail_pre, list_chunk_s), tail_post);
    concat(concat(pre, post), tail)
}

// Phase E e3b2: _silica_rt_supervisor_start_child
// X0 = child_spec record pointer (shape word@+0, id@+8, agent_type@+16, start.0@+24, start.1@+32, restart@+40, shutdown@+48,
// flavor@+56; hidden supervisor_start_trampoline@+64).
// Layout matches `_silica_rt_supervisor_materialize_init_children` (cons payload) so the compiler can build a single
// stack record and pass it to either path. (Earlier comment claimed +40/+48 — that 72 B layout never matched the
// emitter's value-flat record_make output; e4b corrects this to the canonical +32/+40 used elsewhere.)
// Reads current-actor TLS for supervisor ACB. spawn_linked(start.0, start.1, agent_type, row_ptr).
// Reuses the first e3f tombstone row (child_ref==0) or appends a linked row node (88 B) to the child table.
// Returns actor_ref (new child) in X0.
fn child_table_rt_asm_chunk_2(danger_idx: int64) -> string {
    pre: string <- "	.globl	_silica_rt_supervisor_start_child
	.p2align	2
_silica_rt_supervisor_start_child:
	.cfi_startproc
; Phase E e4f: extend the prologue to also save x27 (row_ptr) and x28 (appended flag) so we can
; locate / allocate the table row first, then call spawn_linked with X3 = row_ptr (callee-saved).
	stp	x28, x27, [sp, #-96]!
	stp	x26, x25, [sp, #16]
	stp	x24, x23, [sp, #32]
	stp	x22, x21, [sp, #48]
	stp	x20, x19, [sp, #64]
	stp	x29, x30, [sp, #80]
	add	x29, sp, #80
	.cfi_def_cfa w29, 16
	.cfi_offset w19, -32
	.cfi_offset w20, -24
	.cfi_offset w21, -40
	.cfi_offset w22, -32
	.cfi_offset w23, -56
	.cfi_offset w24, -48
	.cfi_offset w25, -72
	.cfi_offset w26, -64
	.cfi_offset w27, -88
	.cfi_offset w28, -80
	mov	x20, x0
	ldr	x21, [x20, #8]
	ldr	x22, [x20, #16]
	ldr	x23, [x20, #24]
	ldr	x24, [x20, #32]
	ldr	x25, [x20, #40]
	ldr	x26, [x20, #48]
	mov	x0, x21
	bl	_silica_rt_registry_name_held
	cbnz	x0, Lsc_id_taken
Lsc_tls_prep:
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
; Phase E e4f + Option B: tombstone scan / append on singly-linked row nodes (+80).
	mov	x0, x19
	bl	_silica_rt_sb_require
	ldr	x8, [x0, #24]
	ldr	x9, [x0, #32]
	mov	x10, #0
Lsc_reuse_loop:
	cmp	x10, x9
	b.hs	Lsc_append_new
	mov	x27, x8
	mov	x11, x10
Lsc_walk_reuse:
	cbz	x11, Lsc_reuse_at_row
	ldr	x27, [x27, #80]
	sub	x11, x11, #1
	b	Lsc_walk_reuse
Lsc_reuse_at_row:
	ldr	x12, [x27]
	cbz	x12, Lsc_use_reuse_row
	add	x10, x10, #1
	b	Lsc_reuse_loop
Lsc_append_new:
	mov	x0, x19
	ldr	x1, [x19, #216]
	ldr	x1, [x1, #32]
	add	x1, x1, #1
	bl	_silica_rt_child_table_ensure_min_cap
	cbnz	x0, Lsc_id_taken
	ldr	x8, [x19, #216]
	ldr	x9, [x8, #32]
	ldr	x8, [x8, #24]
	mov	x27, x8
	mov	x11, x9
Lsc_walk_append:
	cbz	x11, Lsc_append_at_row
	ldr	x27, [x27, #80]
	sub	x11, x11, #1
	b	Lsc_walk_append
Lsc_append_at_row:
	mov	x28, #1
	b	Lsc_post_row
Lsc_use_reuse_row:
	mov	x28, xzr
Lsc_post_row:
	ldr	x4, [x20, #64]
	str	x4, [x27, #72]
";
    post: string <- concat("    ldr x9, [x20, #56]\n    str xzr, [x27]\n    str x21, [x27, #8]\n    str x22, [x27, #16]\n    str x23, [x27, #24]\n    str x24, [x27, #32]\n    str x25, [x27, #40]\n    str x26, [x27, #48]\n    str xzr, [x27, #56]\n    str x9, [x27, #64]\n    str xzr, [x27, #96]\n    str xzr, [x27, #104]\n", "    mov x0, x27\n    mov x1, x19\n    bl _silica_rt_supervisor_spawn_child_row_by_flavor\n    mov x20, x0\n");
    tail: string <- "	cbz	x28, Lsc_done
	ldr	x10, [x19, #216]
	ldr	x9, [x10, #32]
	add	x9, x9, #1
	str	x9, [x10, #32]
	b	Lsc_done
Lsc_id_taken:
	mov	x20, xzr
Lsc_done:
; The answer is the new child's identity (row +112, §15.1.4); no child is the all-ones identity.
	mov	x0, #-1
	cbz	x20, Lsc_ret
	ldr	x0, [x27, #112]
Lsc_ret:
	ldp	x29, x30, [sp, #80]
	ldp	x20, x19, [sp, #64]
	ldp	x22, x21, [sp, #48]
	ldp	x24, x23, [sp, #32]
	ldp	x26, x25, [sp, #16]
	ldp	x28, x27, [sp], #96
	ret
	.cfi_endproc
";
    concat(concat(pre, post), tail)
}

// Phase D: call_supervisor(..., { op: :add_child, child: spec }) uses the same row allocation
// and supervised spawn path as start_child, but takes the supervisor ref explicitly because
// public supervisor calls are made by ordinary actors/main, not from inside the supervisor thread.
fn child_table_rt_asm_chunk_2b() -> string {
    "	.p2align	2
_silica_rt_supervisor_drain_ingress:
	.cfi_startproc
	stp	x24, x23, [sp, #-64]!
	stp	x22, x21, [sp, #16]
	stp	x20, x19, [sp, #32]
	stp	x29, x30, [sp, #48]
	add	x29, sp, #48
	mov	x19, x0
Lsdrain_loop:
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x0, [x19, #216]
	cbz	x0, Lsdrain_empty
	bl	_silica_rt_q_dequeue_locked
	mov	x20, x0
	cbz	x20, Lsdrain_empty
	ldr	x8, [x19, #216]
	ldr	w9, [x8, #16]
	cbz	w9, Lsdrain_depth_done
	sub	w9, w9, #1
	str	w9, [x8, #16]
Lsdrain_depth_done:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	w9, [x20, #24]
	cbnz	w9, Lsdrain_free_msg
	ldr	x21, [x20, #8]
	cbz	x21, Lsdrain_free_msg
	mov	x24, x19
	bl	_silica_rt_tls_current_actor_get
	mov	x23, x0
	mov	x19, x24
	bl	_silica_rt_tls_actor_set_from_x19
	ldr	x0, [x21]
	mov	x1, x24
	ldr	x2, [x21, #8]
	bl	_silica_rt_supervisor_maybe_restart
	mov	x19, x23
	bl	_silica_rt_tls_actor_set_from_x19
	mov	x19, x24
	mov	x0, x21
	bl	_silica_rt_exit_payload_free
Lsdrain_free_msg:
	mov	x0, x20
	bl	_free
	b	Lsdrain_loop
Lsdrain_empty:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
	.cfi_endproc
	.globl	_silica_rt_supervisor_add_child
	.p2align	2
_silica_rt_supervisor_add_child:
; X0 = the supervisor's reference: resolved and held for the body (_silica_rt_sup_ref_call; an ended
; supervisor raises actor_not_found).
	adrp	x9, _silica_rt_supervisor_add_child_acb@PAGE
	add	x9, x9, _silica_rt_supervisor_add_child_acb@PAGEOFF
	b	_silica_rt_sup_ref_call
	.globl	_silica_rt_supervisor_add_child_acb
	.p2align	2
_silica_rt_supervisor_add_child_acb:
	.cfi_startproc
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	mov	x20, x0
	mov	x21, x1
	bl	_silica_rt_supervisor_drain_ingress
	bl	_silica_rt_tls_current_actor_get
	mov	x22, x0
; §20.3.1: an id a live actor or supervisor already holds starts no child; the actor that asked for
; the add fails with (:explicit, :duplicate_child_id). In main (no current actor) it is the
; language-level failure of §15.4.5.5: the atom's name on standard error, exit status 1.
	ldr	x0, [x21, #8]
	bl	_silica_rt_registry_name_held
	cbnz	x0, Ladd_child_duplicate
	mov	x19, x20
	bl	_silica_rt_tls_actor_set_from_x19
	mov	x0, x21
	bl	_silica_rt_supervisor_start_child
	mov	x20, x0
	mov	x19, x22
	bl	_silica_rt_tls_actor_set_from_x19
	mov	x0, x20
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Ladd_child_duplicate:
	cbz	x22, Ladd_child_duplicate_main
	mov	x0, x22
	adrp	x8, _silica_rt_duplicate_child_id_atom@PAGE
	add	x8, x8, _silica_rt_duplicate_child_id_atom@PAGEOFF
	ldr	x1, [x8]
	bl	_silica_rt_actor_fail_current
Ladd_child_duplicate_main:
	mov	w0, #2
	adrp	x1, L_silica_duplicate_child_id_msg@PAGE
	add	x1, x1, L_silica_duplicate_child_id_msg@PAGEOFF
	mov	w2, #19
	bl	_write
	mov	w0, #1
	bl	_exit
	b	Ladd_child_duplicate_main
	.cfi_endproc
"
}

// Phase E e3d+e3e+e4b: _silica_rt_supervisor_maybe_restart
// X0 = dead child_ref, X1 = supervisor ACB, X2 = reason_tag (0=:normal default; !=0 abnormal — e4b).
// Scans linked child row list for matching child_ref. child_ref==0 is an e3f tombstone. If found, dispatches by
// row.restart policy (e4b): :permanent always restarts; :transient restarts iff reason_tag != 0; anything else
// tombstones. On restart, checks restart-frequency cap (ACB#304 max_restarts, #312 time_frame, #320 count,
// #328 window_start; if both max_restarts and time_frame are 0, cap is unlimited; max_restarts 0 with a
// non-zero frame means no restarts are allowed and the first restart attempt breaches). On cap breach, terminates
// the supervisor (alive=0 → Phase C link propagation). Otherwise dispatches by strategy (ACB#296):
//   :one_for_one  — respawn only the dead child
//   :one_for_all  — kill all other children, then respawn all
//   :rest_for_one — kill children after dead child, then respawn dead + rest
// Kill = lock mutex, alive=0, signal cond, unlock mutex on each sibling ACB.
// perm_idx / trans_idx / ofa_idx / rfo_idx: module atom table indices for :permanent, :transient, :one_for_all, :rest_for_one.
fn child_table_rt_asm_chunk_3(perm_idx: int64, trans_idx: int64, ofa_idx: int64, rfo_idx: int64) -> string {
        mr_head: string <- "	.p2align	2
_silica_rt_supervisor_drop_pending_exit:
	.cfi_startproc
	stp	x24, x23, [sp, #-64]!
	stp	x22, x21, [sp, #16]
	stp	x20, x19, [sp, #32]
	stp	x29, x30, [sp, #48]
	add	x29, sp, #48
	mov	x19, x0
	mov	x20, x1
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x23, [x19, #216]
	cbz	x23, Ldpe_not_found
	ldr	x22, [x23]
	mov	x24, xzr
Ldpe_front_loop:
	cbz	x22, Ldpe_scan_rear
	ldr	x8, [x22, #8]
	cbz	x8, Ldpe_front_next
	ldr	x9, [x8]
	cmp	x9, x20
	b.eq	Ldpe_remove
Ldpe_front_next:
	mov	x24, x22
	ldr	x22, [x22]
	b	Ldpe_front_loop
Ldpe_scan_rear:
	ldr	x23, [x19, #216]
	add	x23, x23, #8
	ldr	x22, [x23]
	mov	x24, xzr
Ldpe_rear_loop:
	cbz	x22, Ldpe_not_found
	ldr	x8, [x22, #8]
	cbz	x8, Ldpe_rear_next
	ldr	x9, [x8]
	cmp	x9, x20
	b.eq	Ldpe_remove
Ldpe_rear_next:
	mov	x24, x22
	ldr	x22, [x22]
	b	Ldpe_rear_loop
Ldpe_remove:
	ldr	x10, [x22]
	cbz	x24, Ldpe_remove_head
	str	x10, [x24]
	b	Ldpe_removed_link
Ldpe_remove_head:
	str	x10, [x23]
Ldpe_removed_link:
	mov	x21, x8
	ldr	x8, [x19, #216]
	ldr	w11, [x8, #16]
	cbz	w11, Ldpe_depth_done
	sub	w11, w11, #1
	str	w11, [x8, #16]
Ldpe_depth_done:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x21
	bl	_silica_rt_exit_payload_free
	mov	x0, x22
	bl	_free
	b	Ldpe_done
Ldpe_not_found:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
Ldpe_done:
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
	.cfi_endproc
	.globl	_silica_rt_supervisor_maybe_restart
	.p2align	2
_silica_rt_supervisor_maybe_restart:
	.cfi_startproc
	stp	x28, x27, [sp, #-96]!
	stp	x26, x25, [sp, #16]
	stp	x24, x23, [sp, #32]
	stp	x22, x21, [sp, #48]
	stp	x20, x19, [sp, #64]
	stp	x29, x30, [sp, #80]
	add	x29, sp, #80
	.cfi_def_cfa w29, 16
	.cfi_offset w19, -32
	.cfi_offset w20, -24
	.cfi_offset w21, -40
	.cfi_offset w22, -32
	.cfi_offset w23, -56
	.cfi_offset w24, -48
	.cfi_offset w25, -72
	.cfi_offset w26, -64
	.cfi_offset w27, -88
	.cfi_offset w28, -80
	mov	x19, x0
	mov	x20, x1
	mov	x28, x2
	ldr	x27, [x20, #216]
	cbz	x27, Lmr_done
; A supervisor that has ended restarts and tombstones nothing: its children are being shut down
; (_silica_rt_sup_shutdown_children) and its rows go with it.
	ldr	w8, [x20, #152]
	cbz	w8, Lmr_done
	ldr	x21, [x27, #24]
	cbz	x21, Lmr_done
	ldr	x22, [x27, #32]
	cbz	x22, Lmr_done
	mov	x23, #0
Lmr_scan:
	cmp	x23, x22
	b.hs	Lmr_done
	mov	x24, x21
	mov	x10, x23
Lmr_walk_scan:
	cbz	x10, Lmr_scan_at_row
	ldr	x24, [x24, #80]
	sub	x10, x10, #1
	b	Lmr_walk_scan
Lmr_scan_at_row:
	ldr	x8, [x24]
	cmp	x8, x19
	b.ne	Lmr_next
	ldr	x0, [x24, #40]
";
        mr_policy: string <- maybe_restart_policy_dispatch(perm_idx, trans_idx);
        mr_freq: string <- "	ldr	x8, [x27, #64]
	ldr	x9, [x27, #72]
	orr	x10, x8, x9
	cbz	x10, Lmr_freq_ok
	cbz	x8, Lmr_freq_escalate
	mov	x0, xzr
	bl	_time
	mov	x25, x0
	ldr	x8, [x27, #88]
	cbz	x8, Lmr_freq_first
	ldr	x9, [x27, #72]
	sub	x10, x25, x8
	cmp	x10, x9
	b.hi	Lmr_freq_reset
	ldr	x8, [x27, #80]
	add	x8, x8, #1
	ldr	x9, [x27, #64]
	cmp	x8, x9
	b.hi	Lmr_freq_escalate
	str	x8, [x27, #80]
	b	Lmr_freq_ok
Lmr_freq_first:
Lmr_freq_reset:
	str	x25, [x27, #88]
	mov	x8, #1
	str	x8, [x27, #80]
	ldr	x9, [x27, #64]
	cmp	x8, x9
	b.hi	Lmr_freq_escalate
	b	Lmr_freq_ok
Lmr_freq_escalate:
; The breach ends the supervisor abnormally (§15.4.13.2): reason tag 4, (:explicit, breach atom), as
; supervisor_fail_duplicate_child_id; its parent applies its own restart rules to it.
	mov	x8, #4
	str	x8, [x20, #232]
	adrp	x8, _silica_rt_restart_breach_atom@PAGE
	add	x8, x8, _silica_rt_restart_breach_atom@PAGEOFF
	ldr	x8, [x8]
	str	x8, [x20, #384]
; Claim sync_failure_reported BEFORE mark-dead+signal. Otherwise actor_thread_main can
; observe alive==0, take LBB1_exit, and emit a duplicate root failure banner/note.
	ldr	x8, [x20, #192]
	cbnz	x8, Lmr_freq_escalate_mark_dead
; The synchronous report (children shut down first) is made only on the supervisor's own thread.
; Elsewhere (a dying child draining the ingress in its exit path, a kill_abnormal or call_supervisor
; caller) the wait for the children could wait on this very thread: a child blocked in kill_abnormal
; waits for the dying child's exit_done. The supervisor is then only marked ended; its own exit path
; shuts the children down and reports (deliver_exit, as for any root actor).
; The test is the thread, not the current actor: a drain on another thread runs this with the
; supervisor installed as the current actor (supervisor_drain_ingress). ACB #144 is the thread.
	bl	_pthread_self
	ldr	x8, [x20, #144]
	cmp	x0, x8
	b.ne	Lmr_freq_escalate_mark_dead
	ldr	x8, [x27, #40]
	cbnz	x8, Lmr_freq_escalate_mark_dead
	mov	x8, #1
	str	x8, [x27, #40]
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	str	wzr, [x20, #152]
	mov	x0, x20
	bl	_silica_rt_actor_mail_signal
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
; The children are shut down before the root's report goes out, so their reports precede it (the
; FailureReporter may end the program on the root's).
	mov	x0, x20
	bl	_silica_rt_sup_shutdown_children
	mov	x0, x20
	bl	_silica_rt_root_report_and_note
	b	Lmr_done
Lmr_freq_escalate_mark_dead:
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	str	wzr, [x20, #152]
	mov	x0, x20
	bl	_silica_rt_actor_mail_signal
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	b	Lmr_done
Lmr_freq_ok:
	ldr	x0, [x27, #56]
";
        mr_ofa: string <- maybe_restart_strat_eq_branch(ofa_idx, "Lmr_ofa_kill");
        mr_rfo: string <- maybe_restart_strat_eq_branch(rfo_idx, "Lmr_rfo_kill");
        mr_b_ofo: string <- "	b	Lmr_ofo
";
        mr_tail: string <- "Lmr_ofo:
; Phase E e4f: pass row_ptr (x24) as X3 so the new child's actor_thread_main can flag
; this row's exit_done on its own teardown; clear stale exit_done from prior incarnation.
; Every restart respawns through _silica_rt_supervisor_respawn_row (§20.3.1: a name another actor
; took since the child ended fails the supervisor instead, and X0 = 1 ends the restart).
	mov	x0, x24
	mov	x1, x20
	bl	_silica_rt_supervisor_respawn_row
	b	Lmr_done
Lmr_ofa_kill:
	mov	x25, #0
Lmr_ofa_kill_loop:
	cmp	x25, x22
	b.hs	Lmr_ofa_spawn
	cmp	x25, x23
	b.eq	Lmr_ofa_kill_next
	mov	x26, x21
	mov	x10, x25
Lmr_ofa_kill_walk_idx:
	cbz	x10, Lmr_ofa_kill_at_idx
	ldr	x26, [x26, #80]
	sub	x10, x10, #1
	b	Lmr_ofa_kill_walk_idx
Lmr_ofa_kill_at_idx:
	ldr	x27, [x26]
	cbz	x27, Lmr_ofa_kill_next
	add	x0, x27, #16
	bl	_os_unfair_lock_lock
	str	wzr, [x27, #152]
	mov	x0, x27
	bl	_silica_rt_actor_mail_signal
	add	x0, x27, #16
	bl	_os_unfair_lock_unlock
; Phase E e4f: per-user-spec sequential stop — block here until this child's actor_thread_main
; has fully unwound (ACB freed) and stamped row[+56]=1. Only then proceed to the next sibling,
; so two children's teardowns never overlap (no concurrent libsystem_malloc cleanup races).
; Reset the flag once observed so a future cascade restart targeting this row can re-arm.
; A carrier actor draining the ingress parks for it (prims_actors_carrier_asm.silica).
	mov	x0, x26
	mov	x1, x27
	bl	_silica_rt_row_wait_exit_done
	cbnz	x0, Lmr_ofa_kill_exited
Lmr_ofa_kill_wait:
	ldr	x8, [x26, #56]
	cbz	x8, Lmr_ofa_kill_wait
Lmr_ofa_kill_exited:
	str	xzr, [x26, #56]
Lmr_ofa_kill_next:
	add	x25, x25, #1
	b	Lmr_ofa_kill_loop
Lmr_ofa_spawn:
	mov	x25, #0
Lmr_ofa_spawn_loop:
; Phase E e4f: per-user-spec sequential start — spawn_linked itself spins on the new
; child's ACB[+288] before returning, so iteration k cannot proceed until child k's
; thread has finished its TLS init / first-schedule. Children come up in list order,
; one at a time, after every cascaded stop has retired.
	cmp	x25, x22
	b.hs	Lmr_done
	mov	x26, x21
	mov	x10, x25
Lmr_ofa_spawn_walk_idx:
	cbz	x10, Lmr_ofa_spawn_at_idx
	ldr	x26, [x26, #80]
	sub	x10, x10, #1
	b	Lmr_ofa_spawn_walk_idx
Lmr_ofa_spawn_at_idx:
	ldr	x8, [x26]
	cbz	x8, Lmr_ofa_spawn_next
	mov	x0, x26
	mov	x1, x20
	bl	_silica_rt_supervisor_respawn_row
	cbnz	x0, Lmr_done
Lmr_ofa_spawn_next:
	add	x25, x25, #1
	b	Lmr_ofa_spawn_loop
Lmr_rfo_kill:
	add	x25, x23, #1
Lmr_rfo_kill_loop:
	cmp	x25, x22
	b.hs	Lmr_rfo_spawn
	mov	x26, x21
	mov	x10, x25
Lmr_rfo_kill_walk_idx:
	cbz	x10, Lmr_rfo_kill_at_idx
	ldr	x26, [x26, #80]
	sub	x10, x10, #1
	b	Lmr_rfo_kill_walk_idx
Lmr_rfo_kill_at_idx:
	ldr	x27, [x26]
	cbz	x27, Lmr_rfo_kill_next
	add	x0, x27, #16
	bl	_os_unfair_lock_lock
	str	wzr, [x27, #152]
	mov	x0, x27
	bl	_silica_rt_actor_mail_signal
	add	x0, x27, #16
	bl	_os_unfair_lock_unlock
; Phase E e4f: per-user-spec sequential stop — wait for this child's actor_thread_main
; to retire (row[+56]=1 set after its full ACB free) before signalling the next row.
; No two cascaded teardowns ever overlap. A carrier actor draining the ingress parks for it
; (prims_actors_carrier_asm.silica).
	mov	x0, x26
	mov	x1, x27
	bl	_silica_rt_row_wait_exit_done
	cbnz	x0, Lmr_rfo_kill_exited
Lmr_rfo_kill_wait:
	ldr	x8, [x26, #56]
	cbz	x8, Lmr_rfo_kill_wait
Lmr_rfo_kill_exited:
	mov	x0, x20
	mov	x1, x27
	bl	_silica_rt_supervisor_drop_pending_exit
	str	xzr, [x26, #56]
; Tombstone the row only after the child has fully exited so Lmr_rfo_spawn does not run
; with a stale child_ref in the slot.
	str	xzr, [x26]
Lmr_rfo_kill_next:
	add	x25, x25, #1
	b	Lmr_rfo_kill_loop
Lmr_rfo_spawn:
	mov	x25, x23
Lmr_rfo_spawn_loop:
; Phase E e4f: per-user-spec sequential start — children come up in list order, one
; at a time. spawn_linked blocks on each new child's ACB[+288] (set in actor_thread_main
; right after TLS init / trampoline) so iteration k+1 can never run alongside iteration k.
	cmp	x25, x22
	b.hs	Lmr_done
	mov	x26, x21
	mov	x10, x25
Lmr_rfo_spawn_walk_idx:
	cbz	x10, Lmr_rfo_spawn_at_idx
	ldr	x26, [x26, #80]
	sub	x10, x10, #1
	b	Lmr_rfo_spawn_walk_idx
Lmr_rfo_spawn_at_idx:
	mov	x0, x26
	mov	x1, x20
	bl	_silica_rt_supervisor_respawn_row
	cbnz	x0, Lmr_done
Lmr_rfo_spawn_next:
	add	x25, x25, #1
	b	Lmr_rfo_spawn_loop
Lmr_next:
	add	x23, x23, #1
	b	Lmr_scan
Lmr_tombstone_done:
	str	xzr, [x24]
	b	Lmr_done
Lmr_done:
	ldp	x29, x30, [sp, #80]
	ldp	x20, x19, [sp, #64]
	ldp	x22, x21, [sp, #48]
	ldp	x24, x23, [sp, #32]
	ldp	x26, x25, [sp, #16]
	ldp	x28, x27, [sp], #96
	ret
	.cfi_endproc
";
        concat(concat(concat(concat(concat(mr_head, mr_policy), mr_freq), mr_ofa), mr_rfo), concat(mr_b_ofo, mr_tail))
}

// Phase E e4a/e4b trial accessor: _silica_rt_child_table_first_ref
// Returns the actor_ref (child ACB pointer) of the first LIVE row in the current actor's linked child table.
// No arguments. Reads TLS for current actor, loads table pointer from ACB#256. e4b: skips tombstoned rows
// (child_ref==0) so callers see the next live child after a :transient/:temporary no-restart leaves a hole.
// Returns 0 if table is empty, null, or contains only tombstones.
fn child_table_rt_asm_chunk_4() -> string {
    "	.globl	_silica_rt_child_table_first_ref
	.p2align	2
_silica_rt_child_table_first_ref:
	.cfi_startproc
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	ldr	x20, [x19, #216]
	cbz	x20, Lsbh_1
	ldr	x20, [x20, #24]
Lsbh_1:
	cbz	x20, Lctfr_empty
	mov	x12, x20
Lctfr_scan:
	ldr	x0, [x12]
	cbnz	x0, Lctfr_found
	ldr	x12, [x12, #80]
	cbz	x12, Lctfr_empty
	b	Lctfr_scan
Lctfr_found:
	ldr	x0, [x12, #112]
	b	Lctfr_done
Lctfr_empty:
	mov	x0, #-1
Lctfr_done:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
"
}

// Phase E e4f: _silica_rt_child_table_row_ref — 0-based row index (list walk order).
// (materialize / start_child order). X0 = index (i64; negative or >= len ⇒ 0). Returns child_ref at that row
// (may be 0 for tombstones). Does not skip rows (trials compare stable row indices to first_ref).
fn child_table_rt_asm_chunk_5() -> string {
    "	.globl	_silica_rt_child_table_row_ref
	.p2align	2
_silica_rt_child_table_row_ref:
	.cfi_startproc
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	mov	x19, x0
	bl	_silica_rt_tls_current_actor_get
	mov	x20, x0
	ldr	x8, [x20, #216]
	cbz	x8, Lctrr_empty
	ldr	x9, [x8, #32]
	ldr	x8, [x8, #24]
	cbz	x8, Lctrr_empty
	cbz	x9, Lctrr_empty
	cmp	x19, #0
	b.lt	Lctrr_empty
	cmp	x19, x9
	b.hs	Lctrr_empty
	mov	x11, x8
	mov	x12, x19
Lctrr_walk:
	cbz	x12, Lctrr_at
	ldr	x11, [x11, #80]
	cbz	x11, Lctrr_empty
	sub	x12, x12, #1
	b	Lctrr_walk
Lctrr_at:
	ldr	x0, [x11]
	cbz	x0, Lctrr_empty
	ldr	x0, [x11, #112]
	b	Lctrr_done
Lctrr_empty:
	mov	x0, #-1
Lctrr_done:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
"
}

// Phase D runtime-backed call_supervisor helpers over linked child rows.
// All functions take supervisor ACB explicitly in X0 so ordinary actors can invoke call_supervisor.
fn child_table_rt_asm_chunk_6(ofa_idx: int64) -> string {
        ofa_branch: string <- case ofa_idx < 0 of {
            true -> "";
            false -> concat(concat("	ldr	x8, [x19, #216]\n	ldr	x8, [x8, #56]\n	cmp	x8, #", atom_table@int64_to_decimal_string(ofa_idx)), "\n	b.eq	Lsrestart_ofa\n")
        };
        concat(concat("	.globl	_silica_rt_supervisor_count_children
	.p2align	2
_silica_rt_supervisor_count_children:
; X0 = the supervisor's reference: resolved and held for the body (_silica_rt_sup_ref_call; an ended
; supervisor raises actor_not_found).
	adrp	x9, _silica_rt_supervisor_count_children_acb@PAGE
	add	x9, x9, _silica_rt_supervisor_count_children_acb@PAGEOFF
	b	_silica_rt_sup_ref_call
	.globl	_silica_rt_supervisor_count_children_acb
	.p2align	2
_silica_rt_supervisor_count_children_acb:
	.cfi_startproc
	stp	x21, x20, [sp, #-48]!
	stp	x19, x29, [sp, #16]
	str	x30, [sp, #32]
	add	x29, sp, #16
	mov	x19, x0
	bl	_silica_rt_supervisor_drain_ingress
	ldr	x20, [x19, #216]
	cbz	x20, Lsbh_2
	ldr	x20, [x20, #24]
Lsbh_2:
	mov	x21, #0
Lscount_loop:
	cbz	x20, Lscount_done
	ldr	x8, [x20]
	cbz	x8, Lscount_next
	add	x21, x21, #1
Lscount_next:
	ldr	x20, [x20, #80]
	b	Lscount_loop
Lscount_done:
	mov	x0, x21
	ldr	x30, [sp, #32]
	ldp	x19, x29, [sp, #16]
	ldp	x21, x20, [sp], #48
	ret
	.cfi_endproc
	.globl	_silica_rt_supervisor_get_child
	.p2align	2
_silica_rt_supervisor_get_child:
; X0 = the supervisor's reference: resolved and held for the body (_silica_rt_sup_ref_call; an ended
; supervisor raises actor_not_found).
	adrp	x9, _silica_rt_supervisor_get_child_acb@PAGE
	add	x9, x9, _silica_rt_supervisor_get_child_acb@PAGEOFF
	b	_silica_rt_sup_ref_call
	.globl	_silica_rt_supervisor_get_child_acb
	.p2align	2
_silica_rt_supervisor_get_child_acb:
	.cfi_startproc
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, x1
	bl	_silica_rt_supervisor_drain_ingress
	ldr	x9, [x19, #216]
	cbz	x9, Lsbh_3
	ldr	x9, [x9, #24]
Lsbh_3:
Lsget_loop:
	cbz	x9, Lsget_none
	ldr	x10, [x9]
	cbz	x10, Lsget_next
	ldr	x11, [x9, #8]
	cmp	x11, x20
	b.eq	Lsget_found
Lsget_next:
	ldr	x9, [x9, #80]
	b	Lsget_loop
Lsget_found:
	ldr	x0, [x9, #112]
	b	Lsget_done
Lsget_none:
; No live row holds the id (spec §15.4.8.3 :get_child names the child by id): no child.
	mov	x0, #-1
Lsget_done:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
	.globl	_silica_rt_supervisor_get_child_info
	.p2align	2
_silica_rt_supervisor_get_child_info:
; X0 = the supervisor's reference: resolved and held for the body (_silica_rt_sup_ref_call; an ended
; supervisor raises actor_not_found).
	adrp	x9, _silica_rt_supervisor_get_child_info_acb@PAGE
	add	x9, x9, _silica_rt_supervisor_get_child_info_acb@PAGEOFF
	b	_silica_rt_sup_ref_call
	.globl	_silica_rt_supervisor_get_child_info_acb
	.p2align	2
_silica_rt_supervisor_get_child_info_acb:
	.cfi_startproc
	stp	x21, x20, [sp, #-48]!
	stp	x19, x29, [sp, #16]
	str	x30, [sp, #32]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, x1
	bl	_silica_rt_supervisor_drain_ingress
	ldr	x9, [x19, #216]
	cbz	x9, Lsbh_5
	ldr	x9, [x9, #24]
Lsbh_5:
Lsgetinfo_loop:
	cbz	x9, Lsgetinfo_none
	ldr	x10, [x9]
	cbz	x10, Lsgetinfo_next
	ldr	x11, [x9, #8]
	cmp	x11, x20
	b.eq	Lsgetinfo_found
Lsgetinfo_next:
	ldr	x9, [x9, #80]
	b	Lsgetinfo_loop
Lsgetinfo_found:
	mov	x19, x9
	mov	x0, #40
	bl	_silica_rt_region_alloc
	mov	x21, x0
	movz	x8, #1, lsl #16
	movk	x8, #0
	str	x8, [x21]
	str	x20, [x21, #8]
	ldr	x11, [x19, #16]
	mov	x12, #7
	cmp	x11, x12
	b.ne	Lsgetinfo_agent_done
	ldr	x11, [x19, #8]
Lsgetinfo_agent_done:
	str	x11, [x21, #16]
	ldr	x8, [x19, #112]
	str	x8, [x21, #24]
	ldr	x8, [x19, #40]
	cbz	x8, Lsgetinfo_restart_default
	b	Lsgetinfo_restart_done
Lsgetinfo_restart_default:
	mov	x8, #9
Lsgetinfo_restart_done:
	str	x8, [x21, #32]
	mov	x0, x21
	b	Lsgetinfo_done
Lsgetinfo_none:
; No live row holds the id (spec §15.4.8.3 :get_child names the child by id): an empty record.
	mov	x0, #40
	bl	_silica_rt_region_alloc
	mov	x21, x0
	movz	x8, #1, lsl #16
	movk	x8, #0
	str	x8, [x21]
	str	xzr, [x21, #8]
	str	xzr, [x21, #16]
	mov	x8, #-1
	str	x8, [x21, #24]
	str	xzr, [x21, #32]
	mov	x0, x21
Lsgetinfo_done:
	ldr	x30, [sp, #32]
	ldp	x19, x29, [sp, #16]
	ldp	x21, x20, [sp], #48
	ret
	.cfi_endproc
	.globl	_silica_rt_supervisor_get_child_id
	.p2align	2
_silica_rt_supervisor_get_child_id:
; X0 = the supervisor's reference: resolved and held for the body (_silica_rt_sup_ref_call; an ended
; supervisor raises actor_not_found).
	adrp	x9, _silica_rt_supervisor_get_child_id_acb@PAGE
	add	x9, x9, _silica_rt_supervisor_get_child_id_acb@PAGEOFF
	b	_silica_rt_sup_ref_call
	.globl	_silica_rt_supervisor_get_child_id_acb
	.p2align	2
_silica_rt_supervisor_get_child_id_acb:
	.cfi_startproc
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, x1
	bl	_silica_rt_supervisor_drain_ingress
	ldr	x9, [x19, #216]
	cbz	x9, Lsbh_7
	ldr	x9, [x9, #24]
Lsbh_7:
Lsgetid_loop:
	cbz	x9, Lsgetid_none
	ldr	x10, [x9]
	cbz	x10, Lsgetid_next
	ldr	x11, [x9, #8]
	cmp	x11, x20
	b.eq	Lsgetid_found
Lsgetid_next:
	ldr	x9, [x9, #80]
	b	Lsgetid_loop
Lsgetid_found:
	ldr	x0, [x9, #8]
	b	Lsgetid_done
Lsgetid_none:
	mov	x0, #0
Lsgetid_done:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
	.globl	_silica_rt_supervisor_get_child_agent_type
	.p2align	2
_silica_rt_supervisor_get_child_agent_type:
; X0 = the supervisor's reference: resolved and held for the body (_silica_rt_sup_ref_call; an ended
