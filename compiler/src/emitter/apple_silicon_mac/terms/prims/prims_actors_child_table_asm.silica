// §20.3.1 duplicate child ids at run time. The atom :duplicate_child_id is appended to the runtime
// atom table (atom_table@build_runtime_atom_table) so it exists even when the program never spells
// it; its index is published as _silica_rt_duplicate_child_id_atom for the add_child path above.
// The atom of the failure_reason (:explicit, atom) a supervisor ends with when its restart intensity is
// exceeded (§15.4.13.2: it terminates, propagating the failure; reason tag 4). One word, loaded by
// maybe_restart (Lmr_freq_escalate); emit_child_table_runtime_asm picks the atom.
fn child_table_rt_restart_breach_atom_chunk(breach_idx: int64) -> string {
    concat(concat("	.section	__DATA,__data
	.p2align	3
	.globl	_silica_rt_restart_breach_atom
_silica_rt_restart_breach_atom:
	.quad	", atom_table@int64_to_decimal_string(breach_idx)), "
")
}

fn child_table_rt_duplicate_child_id_chunk(dup_idx: int64, shutdown_idx: int64) -> string {
    concat(concat(concat(concat("	.section	__DATA,__data
	.p2align	3
	.globl	_silica_rt_shutdown_atom
_silica_rt_shutdown_atom:
	.quad	", atom_table@int64_to_decimal_string(shutdown_idx)), "
	.globl	_silica_rt_duplicate_child_id_atom
_silica_rt_duplicate_child_id_atom:
	.quad	"), atom_table@int64_to_decimal_string(dup_idx)), "
	.section	__TEXT,__cstring,cstring_literals
L_silica_duplicate_child_id_msg:
	.asciz	\"duplicate_child_id\\n\"
	.section	__TEXT,__text,regular,pure_instructions
; _silica_rt_supervisor_fail_duplicate_child_id(X0 = supervisor ACB): a restart found the child's name
; held by another live actor or supervisor (§20.3.1). The supervisor fails with failure_reason
; (:explicit, :duplicate_child_id) the way a restart-intensity breach ends it (maybe_restart): a root
; supervisor is reported here, claiming the supervision block's sync_failure_reported so its own thread
; does not report again, and the root note follows; a supervised one is marked dead and its thread
; delivers the exit, carrying this reason, to its parent, which applies its own restart rules.
	.globl	_silica_rt_supervisor_fail_duplicate_child_id
	.p2align	2
_silica_rt_supervisor_fail_duplicate_child_id:
	.cfi_startproc
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x8, #4
	str	x8, [x19, #232]
	adrp	x8, _silica_rt_duplicate_child_id_atom@PAGE
	add	x8, x8, _silica_rt_duplicate_child_id_atom@PAGEOFF
	ldr	x8, [x8]
	str	x8, [x19, #384]
	mov	x20, #0
	ldr	x8, [x19, #192]
	cbnz	x8, Lfdc_mark_dead
; The synchronous report only on the supervisor's own thread (maybe_restart, Lmr_freq_escalate).
	bl	_pthread_self
	ldr	x8, [x19, #144]
	cmp	x0, x8
	b.ne	Lfdc_mark_dead
	ldr	x9, [x19, #216]
	cbz	x9, Lfdc_mark_dead
	ldr	x8, [x9, #40]
	cbnz	x8, Lfdc_mark_dead
	mov	x8, #1
	str	x8, [x9, #40]
	mov	x20, #1
Lfdc_mark_dead:
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	cbz	x20, Lfdc_done
	mov	x0, x19
	bl	_silica_rt_sup_shutdown_children
	mov	x0, x19
	bl	_silica_rt_root_report_and_note
Lfdc_done:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
; _silica_rt_supervisor_respawn_row(X0 = row, X1 = supervisor ACB) -> X0 = 0 when the row's child was
; started, 1 when the row's id is held by a live actor or supervisor: no child is started under a name
; it does not hold, the row is a tombstone and the supervisor has failed (above). Every restart path respawns through this;
; the first start of a child (materialize, start_child) keeps its own rule.
	.globl	_silica_rt_supervisor_respawn_row
	.p2align	2
_silica_rt_supervisor_respawn_row:
	.cfi_startproc
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, x1
	ldr	x0, [x19, #8]
	bl	_silica_rt_registry_name_held
	cbnz	x0, Lrsr_taken
	mov	x0, x19
	mov	x1, x20
	bl	_silica_rt_supervisor_spawn_child_row_by_flavor
	mov	x0, #0
	b	Lrsr_done
Lrsr_taken:
	str	xzr, [x19]
	mov	x0, x20
	bl	_silica_rt_supervisor_fail_duplicate_child_id
	mov	x0, #1
Lrsr_done:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
")
}

fn emit_child_table_runtime_asm(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
        // Match const_atoms.silica / rodata: first-added order, not bst_lookup_string alone.
        p: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":permanent");
        t: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":transient");
        o: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":one_for_all");
        r: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":rest_for_one");
        d: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":dangerous");
        dup: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":duplicate_child_id");
        // (:explicit, :shutdown): a child ended by its supervisor's orderly shutdown (§15.4.12.2).
        sd: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":shutdown");
        // The restart-intensity breach reason (§15.4.13.2). The ONE place the atom is chosen: a dedicated
        // runtime atom is this lexeme plus an add_atom in atom_table.silica build_runtime_atom_table.
        brk: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":restart_intensity_breach");
        list_chunk: int64 <- child_spec_init_list_chunk_data_bytes();
        concat(concat(concat(concat(concat(concat(concat(concat(concat(child_table_rt_asm_chunk_0(), child_table_rt_spawn_child_row_by_flavor_asm(d)), child_table_rt_asm_chunk_1(d, list_chunk)), child_table_rt_asm_chunk_2(d)), child_table_rt_asm_chunk_2b()), concat(child_table_rt_restart_breach_atom_chunk(brk), child_table_rt_duplicate_child_id_chunk(dup, sd))), child_table_rt_asm_chunk_3(p, t, o, r)), child_table_rt_asm_chunk_4()), child_table_rt_asm_chunk_5()), child_table_rt_asm_chunk_6(o))
}
