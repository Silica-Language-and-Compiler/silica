	str	x22, [x0, #8]
	str	x26, [x0, #16]
	str	x25, [x0, #24]
	b	L_topo_epilogue
L_topo_sysctl_fail:
	add	sp, sp, #16
L_topo_fail_zero:
; OOM / sysctl / zero-core failure: still return a non-NULL 32-byte record (shape word; cores, numa_nodes, cache_hierarchy
; pointers all nil) so Silica callers can field-load and length(empty) without SIGSEGV. If malloc fails, return NULL.
	mov	x0, #32
	bl	_malloc
	cbz	x0, L_topo_null_ret
	movz	x9, #1, lsl #16
	movk	x9, #2
	str	x9, [x0]
	str	xzr, [x0, #8]
	stp	xzr, xzr, [x0, #16]
	b	L_topo_epilogue
L_topo_null_ret:
	mov	x0, xzr
L_topo_epilogue:
	ldp	x27, x28, [sp, #80]
	ldp	x25, x26, [sp, #64]
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #96
	ret
	.cfi_endproc
	.globl	_silica_rt_get_core_capabilities
	.p2align	2
_silica_rt_get_core_capabilities:
	.cfi_startproc
	stp	x29, x30, [sp, #-80]!
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	stp	x25, x26, [sp, #64]
	mov	x29, sp
	mov	x28, x0
	sub	sp, sp, #16
	mov	w0, #4
	str	w0, [sp, #8]
	str	wzr, [sp]
	adrp	x0, L_hw_perf0_str@PAGE
	add	x0, x0, L_hw_perf0_str@PAGEOFF
	mov	x1, sp
