	.cfi_endproc
	.p2align	2
_silica_rt_actor_init_region:           ; arena bookkeeping for the actor's implicit heap
	.cfi_startproc
; X0=actor_ptr. The arena is a chain of anonymous blocks allocated on demand by
; _silica_rt_region_alloc, so nothing is mapped here: #160 newest block (header: prev, size),
; #168 bytes mapped so far, #176 bump pointer, #184 limit of the newest block.
	str	xzr, [x0, #160]
	str	xzr, [x0, #168]
	str	xzr, [x0, #176]
	str	xzr, [x0, #184]
	ret
	.cfi_endproc
                                        ; -- End function
	.p2align	2
_silica_rt_actor_dealloc_region:        ; release every arena block of an actor
