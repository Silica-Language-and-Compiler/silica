	str	wzr, [sp]
	adrp	x0, L_hw_perf1_str@PAGE
	add	x0, x0, L_hw_perf1_str@PAGEOFF
	mov	x1, sp
	add	x2, sp, #8
	mov	x3, xzr
	mov	x4, xzr
	bl	_sysctlbyname
	cbnz	w0, L_cap_sysctl_fail
