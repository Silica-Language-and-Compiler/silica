	add	x20, x20, _silica_actor_tls_key_ready@PAGEOFF
	ldrb	w8, [x20]
	cbnz	w8, L_tlse_done
	adrp	x0, _silica_actor_tls_init_lock@PAGE
	add	x0, x0, _silica_actor_tls_init_lock@PAGEOFF
