// Compiler-bundled actor runtime: AArch64 assembly text maintained here (Silica string chunks).
// Emitted into every module that uses actor prims (emitter_core). Links against libSystem
// (_calloc, _free, _pthread_create, _pthread_key_create, _pthread_getspecific, _pthread_setspecific,
// _os_unfair_lock_*, ___ulock_wait, ___ulock_wake, etc.).
// Thread-local current actor pointer is stored via pthread_key_t (_silica_actor_pthread_key), not Mach-O TLV
// (__thread/__tlv_bootstrap), so linker TLVP_* lowering cannot break pthread entry.
// Phase E e4f: per-actor mutex + scheduler CV use os_unfair_lock + ___ulock (not pthread_mutex_t /
// pthread_cond_t) — see actor_rt_asm_cv_chunk and supervisors_implementation_development_plan.md.
// cpu_topology / cache / NUMA helpers (_silica_rt_apple_*, sysctl hw.*): macOS Apple Silicon only (see cpu_topology_implementation_plan Phase G).
// ABI: spawn(X0,X1,X2)->X0  send(X0,X1)  cast(X0,X1)->W0  call(X0,X1)->X0  self()->X0  recv()->X0
// X2=optional core_id (0 default) per §15.1.1, X4=packed stack_policy (0 = inherit the spawner's; see prims_actors_stack_asm).
// Actor control block 528 B (actor_memory_budget_plan.md item I, 2026-10-09: 512 before; 2026-10-12 +16 for
// the holder count and the parked exit notice; 2026-10-19 +32 for the carrier fields, item N, +16 for
// the wait-list word of the restart protocol, +16 for the thread record, item N stage 2, and +16 for the
// pending migration target, stage 3): #0..#215 the
// actor runtime's, #216 the supervision block pointer (SB, 144 B, only a supervisor has one; layout at
// _silica_rt_sb_require), #224 started flag, #232 pending exit reason_tag, #240 active call wrapper,
// #248/#256/#264 FFI arena base/end/bump (Phase 12), #272..#391 the runtime-managed stack fields
// (prims_actors_stack_asm.silica). A worker carries no supervision field.
// #392 holders of the block (_silica_rt_acb_release), #400 a row child's parked exit notice (0 not yet
// committed to its row, 1 committed or not a row child, else the notice).
// #408 the actor's identity (spec §15.1.4: position << 32 | child number; what every reference to it is),
// #416/#424 its spawner record (position + 1, 0 none yet; next child number) unless it is a row child,
// whose record is its row's +96/+104 (actor_rt_identity_chunk).
// #432 the calling convention recorded at spawn (spec §16.2.6.4; _silica_rt_beh_convention: 0 not
// checked, 1 call-only, 2 cast-only).
// #440..#495 the carrier fields (prims_actors_carrier_asm.silica, item N): #440 the carrier
// block (0 = a dangerous actor, which has a thread of its own; every other actor, supervisors and
// the registries included, is bound to a carrier), #448 status (1 idle, 2 ready, 3 running, 4 parked,
// 5 idle on the carrier's sweep list, 6 sweeping: off that list, its stack about to be released),
// #456 run-queue link (the link in a wait list while parked for a row child's exit_done, row +120, or
// for a supervisor's restart token, block +128), #464 the SP of a parked context, #472 the actor parked
// in a spawn waiting for this one to start, #480 the wait list (the address of its head word) the actor
// is parked on, 0 when none: a stop (_silica_rt_actor_stop) unlinks and wakes it. #496/#504 the thread
// record of a dangerous actor, which has a thread of its own (the pthread key names it: the thread's
// current actor, and 0 = not a carrier's thread; _silica_rt_tls_record_set); unused for a carrier actor,
// whose carrier's block holds its thread's record. #512 the pending migration target (a carrier block, 0 none; item N
// stage 3: set by migrate_actor for a ready, running or parked carrier actor, applied at its next dispatch
// boundary by _silica_rt_carrier_apply_pending); #520 the priority level (item N stage 4; spec §22.10:
// 0 low, 1 normal, 2 high; every actor starts at normal, stored right after both callocs below, and
// _silica_rt_set_actor_priority changes it; a carrier actor's level is the run queue it is pushed to
// and its weight class, _silica_rt_rq_push). Control block 528 B.
// spawn_linked Phase A (supervisors_implementation_development_plan): spawn_linked(X0,X1,X2,X3,X4)->X0
// X0=init X1=beh X2=agent_type (int64) X3=row/core metadata (0 default), X4=optional supervisor trampoline.
// Offsets: #192 supervisor actor_ref (0 root), #200 agent_type atom, #208 core_id (the row pointer of a
// supervised child), #216 supervision block (0 for a worker), #224 started flag.
// Mailboxes (supervisors_implementation_development_plan §4 Phase B; §15.4.9, §16.2.7):
// Each mailbox is a two-list functional queue (front, rear). Enqueue = prepend node to `rear`; dequeue = pop from
// `front`; when `front` is empty on a dequeue, `rear` is reversed in place to become the new `front` and `rear` is
// cleared. Standard mailbox pair at (#128 front, #136 rear). Supervision ingress pair at (SB #0 front, #8 rear),
// with u32 depth at SB #16 (bounded; overflow is a runtime abort, _silica_rt_abort_ingress_full); the block is
// made by the first enqueue when the target was not spawned as a supervisor.
// 152 B message nodes: #24 ingress_kind — 0 = structured child-exit heap payload ptr at #8 (Phase C; auto-restart reads #8);
// non-zero = Phase B trial hook only: #8 holds inline int64 (not a pointer; sup_beh must run; skip maybe_restart).
// Phase E e3a: child table anchors at SB #24 head ptr, #32 len (high-water row count),
// SB #40 sync_failure_reported (0/1; root restart-cap escalation reports before replying, thread exit skips duplicate);
// rows are singly-linked nodes (88 B: 80 B row + next@+80), no realloc — stable row pointers (Option B).
// Phase E e3b: SB #48 = trampoline fn ptr (_silica_supervisor_start_<T>), ACB #224 = started flag (0/1, every actor).
// Phase E e3d: SB #56 = strategy atom (set by materialize from init tuple+0).
// Phase E e3e: SB #64 = allowed_restart_count (i64), #72 = restarts_time_frame (i64, seconds),
//              #80 = restart_count (current window), #88 = window_start_time (seconds, from time()).
// Phase E e4b: ACB #232 = pending_exit_reason_tag (i64; 0=:normal default, !=0=abnormal). `_silica_rt_actor_kill_abnormal` writes 1; `_silica_rt_actor_deliver_exit` reads → payload[+8].
// ACB #240 = active_call_wrapper (0 unless the currently-running behavior is servicing a call; used to wake callers during actor-death teardown).
// Scheduler: actor_thread_main dequeues ingress before standard mailbox each message; recv() matches.
// Phase B trial hook: _silica_rt_actor_supervision_ingress_enqueue(X0 actor, X1 int64 payload) → X0 atom :ok.
// Supervisors Phase G (same plan §4 Phase G; silica-specification §15.4.8.4–8.7): link(X0), monitor(X0), demonitor(X0) —
// ABI for runtime; full idempotent link graph, dead-target handling, and DOWN → standard mailbox are implemented in the
// same symbols below (stubs return benign values until runtime fills behavior).
// Phase C (§15.4.10–§15.4.11, §16.2.7): structured exit notifications → ingress; dead supervisor drops notification
// and routes the unwind note to stderr (§15.4.10.4). Payload (32 B heap): [+0]=child_ref, [+8]=reason_tag,
// [+16]=reason_atom, [+24]=agent_type. Runtime entry: `_silica_rt_actor_deliver_exit(X0=child) → X0=0 delivered
// or 1 needs stderr`. Behavior-only trial accessors (`supervision_wait_and_drain_one`, `failure_reason_tag`,
// `failure_agent_type`, `failure_release`) surface the payload for integration tests.

use prims_actors_child_table_asm;
use prims_actors_stack_asm;
use prims_actors_carrier_asm;
use atom_table;
use ffi_arena_runtime_asm;
use ffi_guarded_runtime_asm;
use ffi_fault_runtime_asm;
use canonical_arena_runtime_asm;
use ordering_identity_runtime_asm;
use checked_int64_runtime_asm;

export emit_actor_runtime_helpers/1;

fn actor_rt_asm_chunk_0() -> string {
    "	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_actor_spawn_dangerous
	.p2align	2
_silica_rt_actor_spawn_dangerous:
	.cfi_startproc
; spawn_dangerous / spawn_dangerous_registered: X0-X4 as _silica_rt_actor_spawn, X5 = 1: the actor
; keeps a thread of its own (its foreign calls may block, and its guarded-FFI state is per thread:
; spec §15.4.13.5; prims_actors_carrier_asm.silica header). Every other spawn binds to a carrier.
	mov	x5, #1
	b	Lsp_entry
	.cfi_endproc
	.globl	_silica_rt_actor_spawn          ; -- Begin function silica_rt_actor_spawn
	.p2align	2
_silica_rt_actor_spawn:                 ; @silica_rt_actor_spawn
	.cfi_startproc
	mov	x5, xzr
Lsp_entry:
; %bb.0:
	stp	x24, x23, [sp, #-80]!           ; 16-byte Folded Spill
	stp	x22, x21, [sp, #16]             ; 16-byte Folded Spill
	stp	x20, x19, [sp, #32]             ; 16-byte Folded Spill
	stp	x29, x30, [sp, #48]             ; 16-byte Folded Spill
	str	x25, [sp, #64]
	str	x26, [sp, #72]
	add	x29, sp, #48
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	.cfi_offset w23, -56
	.cfi_offset w24, -64
	mov	x26, x5
	mov	x25, x4
	mov	x24, x3
	mov	x23, x2
	mov	x20, x1
	mov	x21, x0
	mov	w22, #1                         ; =0x1
	mov	w0, #1                          ; =0x1
	mov	w1, #528
	bl	_calloc
	mov	x19, x0
	cbz	x0, LBB0_4
; %bb.1:
	stp	x21, x20, [x19]
; Every actor starts at priority :normal (#520 = 1; spec §22.10).
	mov	x9, #1
	str	x9, [x19, #520]
; Spec §16.2.6.4: record the behaviour's calling convention; call/cast compare it before enqueuing.
	mov	x0, x20
	bl	_silica_rt_beh_convention
	str	x0, [x19, #432]
	str	xzr, [x19, #192]
	str	xzr, [x19, #200]
	str	x23, [x19, #208]
; Holders of the control block (#392, _silica_rt_acb_release): the actor's own thread and this
; spawner. #400 = 1: no supervisor's row will commit this actor, so its exit notice is never parked.
	mov	x9, #2
	str	x9, [x19, #392]
	mov	x9, #1
	str	x9, [x19, #400]
; Identity (§15.1.4): numbered by the spawning actor (main when there is none) and entered in the
; identity table before the thread exists. A supervisor takes its own position now, in its
; spawner's order (root supervisors: 1, 2, ... as main starts them).
	bl	_silica_rt_tls_current_actor_get
	bl	_silica_rt_spawner_rec
	mov	x1, x0
	mov	x0, x19
	bl	_silica_rt_ident_assign
	cbnz	x0, LBB0_ident_failed
	cbz	x24, Lsp0_no_sb
	add	x0, x19, #416
	bl	_silica_rt_spawner_position
	cbz	x24, Lsp0_no_sb
	mov	x0, x19
	bl	_silica_rt_sb_require
	str	x24, [x0, #48]
Lsp0_no_sb:
; Phase E e4f: ACB+16 is now an os_unfair_lock (4 B) and ACB+80 is a 4 B futex seq word.
; Both are zero from calloc above (OS_UNFAIR_LOCK_INIT == 0); no init call needed.
	str	w22, [x19, #152]
; The reservation, the fault handlers and the arena bookkeeping exist before the thread does:
; its first instruction on the actor stack faults, and the handler must already be installed.
	mov	x0, x19
	mov	x1, x25
	bl	_silica_rt_actor_stack_reserve
	cbnz	x0, LBB0_reserve_failed
	bl	_silica_rt_install_sync_fault_handlers
	mov	x0, x19
	bl	_silica_rt_actor_init_region
; Item N: the actor is bound to a carrier (idle and started; a supervisor, X24 = its trampoline,
; is made ready instead and runs the trampoline in its first dispatch). Only a dangerous actor
; (X26) gets a thread of its own, below.
	mov	x0, x19
	mov	x1, x24
	mov	x2, x26
	bl	_silica_rt_carrier_adopt
	cbnz	x0, LBB0_adopted
	sub	sp, sp, #64
	mov	x0, sp
	bl	_pthread_attr_init
	mov	x0, sp
	movz	x1, #0x2, lsl #16
	bl	_pthread_attr_setstacksize
Lloh0:
	adrp	x2, _actor_thread_main@PAGE
Lloh1:
	add	x2, x2, _actor_thread_main@PAGEOFF
	add	x0, x19, #144
	mov	x1, sp
	mov	x3, x19
	bl	_pthread_create
	mov	w23, w0
	mov	x0, sp
	bl	_pthread_attr_destroy
	add	sp, sp, #64
	cbz	w23, LBB0_3
; %bb.2: the host refused the thread. What this spawn took goes back (identity, reservation,
; alternate stack, control block; nothing else was taken for a dangerous actor), then the spawner
; fails with (:explicit, :thread_limit), or main aborts: _silica_rt_spawn_thread_failed
; (actor_memory_budget_plan.md item N, #5 option C). Never returns here.
	mov	x0, x19
	bl	_silica_rt_idt_remove
	mov	x0, x19
	mov	x1, xzr
	bl	_silica_rt_actor_stack_free
	mov	x0, x19
	bl	_free
	bl	_silica_rt_spawn_thread_failed
LBB0_ident_failed:
	cmp	x0, #1
	mov	x0, x19
	b.eq	LBB0_ident_exhausted
	bl	_free
	mov	x19, #0
	b	LBB0_4
LBB0_ident_exhausted:
	bl	_free
	bl	_silica_rt_identity_exhausted
LBB0_reserve_failed:
	mov	x0, x19
	bl	_silica_rt_idt_remove
	mov	x0, x19
	bl	_free
	bl	_silica_rt_spawn_reserve_failed
LBB0_3:
	ldur	x0, [x19, #144]
	bl	_pthread_detach
LBB0_adopted:
; Phase E: the supervisor trampoline (SB#48) runs in the actor's first dispatch on its carrier (or
; on the new thread of a dangerous actor); wait until #224 is set so callers see a materialized
; child table before receiving the actor_ref (a carrier actor spawning parks instead of spinning,
; main spins: _silica_rt_spawn_wait_started).
	cbz	x24, LBB0_4
	mov	x0, x19
	bl	_silica_rt_spawn_wait_started
; 2 = the trampoline failed and the actor has ended: the spawn returns _silica_rt_dead_acb
; (_silica_rt_spawner_let_go), and the actor's own block goes with its last holder.
LBB0_4:
	mov	x0, x19
	bl	_silica_rt_spawner_let_go
	mov	x19, x0
; Phase I: wait_for_exit consults _silica_rt_wait_root_acb (+#152 alive). Only top-level spawn()
; registers here; spawn_linked workers must not steal the slot (see LBBsl_4).
	cbz	x19, LBB0_wr_skip
LBB0_wr_try:
	adrp	x8, _silica_rt_wait_root_acb@PAGE
LBB0_wr_page:
	add	x8, x8, _silica_rt_wait_root_acb@PAGEOFF
	ldr	x9, [x8]
	cbnz	x9, LBB0_wr_skip
	str	x19, [x8]
LBB0_wr_skip:
	mov	x0, x19
	ldr	x25, [sp, #64]
	ldr	x26, [sp, #72]
	ldp	x29, x30, [sp, #48]             ; 16-byte Folded Reload
	ldp	x20, x19, [sp, #32]             ; 16-byte Folded Reload
	ldp	x22, x21, [sp, #16]             ; 16-byte Folded Reload
	ldp	x24, x23, [sp], #80             ; 16-byte Folded Reload
	ret
	.loh AdrpAdd	Lloh0, Lloh1
	.loh AdrpAdd	LBB0_wr_try, LBB0_wr_page
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_spawn_linked   ; Phase A: supervision metadata (supervisors_implementation_development_plan.md §A)
	.p2align	2
_silica_rt_actor_spawn_linked:          ; @silica_rt_actor_spawn_linked
	.cfi_startproc
	mov	x6, xzr
Lsl_entry:
; X6 = 1 for a dangerous actor (spawn_dangerous_linked, a :dangerous row): it keeps a thread of its
; own; every other actor is bound to a carrier.
	mov	x5, xzr
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	LBBsl_common
	bl	_silica_rt_spawner_let_go
	ldp	x29, x30, [sp], #16
	ret
LBBsl_common:
; X0-X5 as above, X6 = 1 dangerous (kept in X26).
	stp	x26, x25, [sp, #-80]!
	stp	x24, x23, [sp, #16]
	stp	x22, x21, [sp, #32]
	stp	x20, x19, [sp, #48]
	stp	x29, x30, [sp, #64]
	add	x29, sp, #64
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	.cfi_offset w23, -56
	.cfi_offset w24, -64
	.cfi_offset w25, -72
	.cfi_offset w26, -80
	mov	x26, x6
	mov	x25, x5
	mov	x23, x2
	mov	x24, x3
	mov	x22, x4
	mov	x20, x1
	mov	x21, x0
	mov	w0, #1
	mov	w1, #528
	bl	_calloc
	mov	x19, x0
	cbz	x0, LBBsl_4
	stp	x21, x20, [x19]
; Every actor starts at priority :normal (#520 = 1; spec §22.10).
	mov	x9, #1
	str	x9, [x19, #520]
; Spec §16.2.6.4: record the behaviour's calling convention; call/cast compare it before enqueuing.
	mov	x0, x20
	bl	_silica_rt_beh_convention
	str	x0, [x19, #432]
; The supervisor (X5; 0 from a plain spawn_linked) is recorded before the child's thread exists: a
; child that ends at once must find it, and its row, on every exit path.
	str	x25, [x19, #192]
; Holders (#392): the child's own thread and this spawner; the child holds its supervisor until its
; exit path is done with it. #400 = 0 for a row child (its spawner commits it to the row,
; _silica_rt_supervisor_spawn_child_row_by_flavor), 1 otherwise.
	mov	x9, #2
	str	x9, [x19, #392]
	cmp	x25, #0
	cset	x9, eq
	str	x9, [x19, #400]
	mov	x0, x25
	bl	_silica_rt_acb_hold
	mov	x21, xzr
	mov	x0, xzr
	str	x23, [x19, #200]
	str	x24, [x19, #208]
; Identity (§15.1.4): a row child is numbered by its supervisor (X5), anything else by the spawning
; actor; the row records its child's identity at +112. A supervisor takes its own position now.
	mov	x0, x25
	cbnz	x0, Lslid_rec
	bl	_silica_rt_tls_current_actor_get
Lslid_rec:
	bl	_silica_rt_spawner_rec
	mov	x1, x0
	mov	x0, x19
	bl	_silica_rt_ident_assign
	cbnz	x0, LBBsl_ident_failed
	cbz	x25, Lslid_no_row
	cmp	x24, #4096
	b.lo	Lslid_no_row
	ldr	x9, [x19, #408]
	str	x9, [x24, #112]
Lslid_no_row:
	cbz	x22, Lslid_no_pos
	mov	x0, x19
	bl	_silica_rt_spawner_rec
	bl	_silica_rt_spawner_position
Lslid_no_pos:
	mov	x0, xzr
	cbz	x22, Lsp1_no_sb
	mov	x0, x19
	bl	_silica_rt_sb_require
	str	x22, [x0, #48]
Lsp1_no_sb:
	cbz	x0, Lslp_skip_list
	sub	sp, sp, #16
	str	x0, [sp, #8]
	ldr	x1, [sp, #8]
	add	x0, x1, #16
	bl	_os_unfair_lock_lock
	ldr	x1, [sp, #8]
	add	x0, x1, #16
	bl	_os_unfair_lock_unlock
	add	sp, sp, #16
Lslp_skip_list:
; Phase E e4f: ACB+16 (os_unfair_lock) and ACB+80 (futex seq word) are pre-zeroed by calloc.
; OS_UNFAIR_LOCK_INIT == 0, seq baseline 0; no init call required.
	mov	w8, #1
	str	w8, [x19, #152]
; Children started from child specs inherit the spawning actor's stack policy: a row child its
; supervisor's (X5, #360; the default, 2, when it has none), named here rather than read from the
; thread's current actor (X1 = 0), since a row is respawned from any actor's drain of the
; supervisor's ingress (prims_actors_child_table_asm.silica, supervisor_drain_ingress), which no
; longer installs the supervisor as the current actor; anything else the current actor's.
	mov	x0, x19
	mov	x1, xzr
	cbz	x25, Lslp_policy
	ldr	x1, [x25, #360]
	cbnz	x1, Lslp_policy
	mov	x1, #2
Lslp_policy:
	bl	_silica_rt_actor_stack_reserve
	cbnz	x0, LBBsl_reserve_failed
	bl	_silica_rt_install_sync_fault_handlers
	mov	x0, x19
	bl	_silica_rt_actor_init_region
; Item N: bound to a carrier (a supervisor child, X22 = its trampoline, made ready for its first
; dispatch); a dangerous actor (X26) gets a thread of its own, below.
	mov	x0, x19
	mov	x1, x22
	mov	x2, x26
	bl	_silica_rt_carrier_adopt
	cbnz	x0, LBBsl_adopted
	sub	sp, sp, #64
	mov	x0, sp
	bl	_pthread_attr_init
	mov	x0, sp
	movz	x1, #0x2, lsl #16
	bl	_pthread_attr_setstacksize
Lslp_tm0:
	adrp	x2, _actor_thread_main@PAGE
Lslp_tm1:
	add	x2, x2, _actor_thread_main@PAGEOFF
	add	x0, x19, #144
	mov	x1, sp
	mov	x3, x19
	bl	_pthread_create
	mov	w23, w0
	mov	x0, sp
	bl	_pthread_attr_destroy
	add	sp, sp, #64
	cbz	w23, LBBsl_3
; The host refused the thread of a :dangerous row child (or of spawn_dangerous_linked). What this
; spawn took goes back: identity, reservation, alternate stack, control block, the hold on the
; supervisor, and for a row child the reference on the supervision block that
; _silica_rt_actor_spawn_linked_row took (a 0 return would have given it back there). Then the
; spawner (the supervisor in its start, a drainer at a respawn) fails with (:explicit, :thread_limit),
; or main aborts: _silica_rt_spawn_thread_failed never returns.
	mov	x0, x19
	bl	_silica_rt_idt_remove
	mov	x0, x19
	mov	x1, xzr
	bl	_silica_rt_actor_stack_free
	mov	x0, x19
	bl	_free
	mov	x0, x25
	bl	_silica_rt_acb_release
	cbz	x25, LBBsl_thread_failed
	cmp	x24, #4096
	b.lo	LBBsl_thread_failed
	ldr	x0, [x24, #88]
	bl	_silica_rt_sb_unref
LBBsl_thread_failed:
	bl	_silica_rt_spawn_thread_failed
LBBsl_ident_failed:
	cmp	x0, #1
	mov	x0, x19
	b.eq	LBBsl_ident_exhausted
	bl	_free
	mov	x0, x25
	bl	_silica_rt_acb_release
	mov	x19, #0
	b	LBBsl_4
LBBsl_ident_exhausted:
	bl	_free
	mov	x0, x25
	bl	_silica_rt_acb_release
	bl	_silica_rt_identity_exhausted
LBBsl_reserve_failed:
	mov	x0, x19
	bl	_silica_rt_idt_remove
	mov	x0, x19
	bl	_free
	mov	x0, x25
	bl	_silica_rt_acb_release
	bl	_silica_rt_spawn_reserve_failed
LBBsl_3:
	ldur	x0, [x19, #144]
	bl	_pthread_detach
LBBsl_adopted:
; Phase E e4f: wait until the new actor has started (ACB #224 == 1: at adoption for a plain
; actor; after its trampoline, in its first dispatch, for a supervisor child; after the TLS
; init of its thread for a dangerous actor). Keeps spawn ordering strictly sequential: the
; supervisor never overlaps two children's startup. A carrier actor spawning parks instead of
; spinning.
	mov	x0, x19
	bl	_silica_rt_spawn_wait_started
LBBsl_4:
	mov	x0, x19
	ldp	x29, x30, [sp, #64]
	ldp	x20, x19, [sp, #48]
	ldp	x22, x21, [sp, #32]
	ldp	x24, x23, [sp, #16]
	ldp	x26, x25, [sp], #80
	ret
	.loh AdrpAdd	Lslp_tm0, Lslp_tm1
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_spawn_dangerous_linked
	.p2align	2
_silica_rt_actor_spawn_dangerous_linked:
	mov	x6, #1
	b	Lsl_entry
	.globl	_silica_rt_actor_spawn_linked_row
	.p2align	2
_silica_rt_actor_spawn_linked_row:
; A supervisor starts the child of one of its rows: X0-X4 as spawn_linked, X3 = the row, X5 = the
; supervisor's ACB, X6 = 1 for a :dangerous row. The child's reference on the supervision block (the
; row's +88) is taken here, before its thread can run and end; a spawn that fails gives it back.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x3
	ldr	x9, [x19, #88]
	add	x9, x9, #112
Lslr_ref:
	ldaxr	x10, [x9]
	add	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lslr_ref
	bl	LBBsl_common
	mov	x20, x0
	cbnz	x20, Lslr_done
	ldr	x0, [x19, #88]
	bl	_silica_rt_sb_unref
Lslr_done:
	mov	x0, x20
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.p2align	2                               ; -- Begin function actor_thread_main
_actor_thread_main:                     ; @actor_thread_main
"
}

fn actor_rt_asm_chunk_1() -> string {
    "	.cfi_startproc
; %bb.0:
	stp	x22, x21, [sp, #-48]!           ; 16-byte Folded Spill
	stp	x20, x19, [sp, #16]             ; 16-byte Folded Spill
	stp	x29, x30, [sp, #32]             ; 16-byte Folded Spill
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0
; The thread of a dangerous actor (the only actor with one; prims_actors_carrier_asm.silica
; header). This thread's record (item N stage 2): the current actor is this actor, and it is no
; carrier's.
	str	x19, [x19, #496]
	str	xzr, [x19, #504]
	add	x0, x19, #496
	bl	_silica_rt_tls_record_set
	mov	x0, x19
	bl	_silica_rt_actor_altstack_install
; Phase E e3b: first-schedule supervisor trampoline hook. It runs on the actor's stack, like a
; behavior: the top of the reservation is the empty stack, and the runtime keeps this thread's
; own SP in ACB+480 while user code runs there.
	ldr	x8, [x19, #216]
	cbz	x8, LBB1_skip_tramp
	ldr	x8, [x8, #48]
	cbz	x8, LBB1_skip_tramp
	ldr	x9, [x19, #224]
	cbnz	x9, LBB1_skip_tramp
	mov	x0, x19
	ldr	x9, [x19, #272]
	cbz	x9, LBB1_sw_none_0
	ldr	x10, [x19, #280]
	add	x9, x9, x10
	mov	x10, sp
	str	x10, [x19, #368]
	mov	sp, x9
LBB1_sw_none_0:
	blr	x8
	ldr	x10, [x19, #368]
	cbz	x10, LBB1_sw_back_0
	mov	sp, x10
	str	xzr, [x19, #368]
LBB1_sw_back_0:
LBB1_skip_tramp:
; Phase E e4f: mark actor as started (post TLS init + post any first-schedule trampoline) so
; spawn / spawn_linked callers can serialize on +288 == 1 for both supervisors and workers.
; This delivers the user-requested ordering: each child starts one at a time, waiting until
; the previous child's actor_thread_main has materialised before the next spawn proceeds.
	mov	x0, x19
	mov	x1, #1
	bl	_silica_rt_started_store
	mov	w22, #1                         ; =0x1
LBB1_loop:
; The mailbox loop. A dangerous actor's thread stays here for the actor's life; a carrier enters
; here with X19 = the actor it dispatches (prims_actors_carrier_asm.silica, Lcar_loop) and leaves
; through LBB1_again or the exit path.
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
LBB1_wait:
; The ingress is this dispatch's to dequeue only while no other holder has the restart token
; (block #120; the protocol in prims_actors_child_table_asm.silica's header): the token is taken
; with the node, under this lock, and released once the node is served (LBB1_free, or the reply
; path). Another holder's release signals this mailbox when notices remain.
	ldr	x0, [x19, #216]
	cbz	x0, LBB1_try_std
	ldr	x8, [x0, #120]
	cbnz	x8, LBB1_try_std
	bl	_silica_rt_q_dequeue_locked
	mov	x20, x0
	cbz	x20, LBB1_try_std
	ldr	x8, [x19, #216]
	ldr	w9, [x8, #16]
	sub	w9, w9, #1
	str	w9, [x8, #16]
	mov	w21, #1
; A Phase B trial-hook node (+24 != 0: an inline int64 the behaviour runs on, no restart) does
; not take the token: both of its result paths clear w22 so that the new state is stored, and
; neither LBB1_free nor the reply path would release it, so a token taken here stayed held for
; the rest of the actor's life. Only an exit notice (+24 == 0) takes it.
	ldr	w9, [x20, #24]
	cbnz	w9, LBB1_process
	str	x19, [x8, #120]
	b	LBB1_process
LBB1_try_std:
	ldr	w9, [x19, #152]
	cbz	w9, LBB1_exit
	add	x0, x19, #128
	bl	_silica_rt_q_dequeue_locked
	mov	x20, x0
	mov	w21, #0
	cbnz	x20, LBB1_process
	ldr	w9, [x19, #152]
	cbz	w9, LBB1_exit
; A carrier actor with no mail is idle (on its carrier's sweep list when it is :release_when_idle
; with committed stack): back to the loop of the carrier this thread is (X20, read before
; mark_idle applies a pending migration, after which #440 may name another carrier); mail makes
; the actor ready again.
	ldr	x20, [x19, #440]
	cbz	x20, LBB1_thread_wait
	mov	x0, x19
	bl	_silica_rt_carrier_mark_idle
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x20
	b	_silica_rt_carrier_loop_enter
LBB1_thread_wait:
; A dangerous actor's thread waits for mail here: blocking _silica_rt_cv_wait (os_unfair_lock +
; ___ulock_wait UL_COMPARE_AND_WAIT_SHARED). Earlier pthread_cond_timedwait_relative_np drove
; libpthread kwq malloc churn racing TLS instantiation (mfm_alloc SIGBUS). Wake paths hold ACB+16,
; signal ACB+80, then unlock before _silica_rt_cv_wait. A :release_when_idle actor waits with a
; timeout while it still holds committed stack; the check releases it once a second has passed
; since its last message (spec §15.1.2.2; a carrier actor's release is the carrier's sweep).
	mov	x0, x19
	bl	_silica_rt_stack_idle_check
	mov	x2, x0
	add	x0, x19, #80
	add	x1, x19, #16
	bl	_silica_rt_cv_wait_timeout
	b	LBB1_wait
LBB1_process:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
"
}

fn actor_rt_asm_chunk_2() -> string {
    // The result layout follows the tuple's own tag, not the message kind: a cast that reaches a
    // call-style behaviour (through a reference the type checker could not trace, a registry name, or
    // FailureReporter delivery) gets (:reply, r, s) back, and reading s at +8 installed the reply as
    // the new state. The tag words are this build's :reply / :no_reply atoms (-1 when unused);
    // runtime-internal behaviours write neither tag and keep the message-kind rule. A cast discards
    // the reply value; a call to a cast-style behaviour gets 0.
    std_no_reply_cmp: string <- "	adrp	x11, _silica_rt_reply_tag@PAGE
	ldr	x11, [x11, _silica_rt_reply_tag@PAGEOFF]
	cmp	x10, x11
	b.eq	LBB1_reply_result
	adrp	x11, _silica_rt_no_reply_tag@PAGE
	ldr	x11, [x11, _silica_rt_no_reply_tag@PAGEOFF]
	cmp	x10, x11
	b.eq	LBB1_no_reply_result
	ldr	x8, [x19, #240]
	ldr	w8, [x8, #16]
	cbz	w8, LBB1_no_reply_result
LBB1_reply_result:
";
    ingress_no_reply_cmp: string <- "	adrp	x11, _silica_rt_reply_tag@PAGE
	ldr	x11, [x11, _silica_rt_reply_tag@PAGEOFF]
	cmp	x10, x11
	b.eq	LBB1_ingress_reply_result
	adrp	x11, _silica_rt_no_reply_tag@PAGE
	ldr	x11, [x11, _silica_rt_no_reply_tag@PAGEOFF]
	cmp	x10, x11
	b.eq	LBB1_ingress_no_reply_result
	ldr	x8, [x19, #240]
	ldr	w8, [x8, #16]
	cbz	w8, LBB1_ingress_no_reply_result
LBB1_ingress_reply_result:
";
    p0: string <- "	sub	sp, sp, #48
; ACB+240 names the node being dispatched, a cast's as well as a call's: an actor that ends inside
; its behaviour (badarith, case_clause, fail_current, a guarded FFI fault) never reaches LBB1_free,
; so its teardown (signal_pending_call_deaths) completes the call or frees the cast node. The code
; after the behaviour reads the node (and its call flag, node+16) from there, never from this frame:
; a carrier actor parked inside the behaviour returns into a frame rebuilt by the carrier.
	str	x20, [x19, #240]
	mov	w22, w21
	cbnz	w22, LBB1_ingress_check_kind
	ldr	w9, [x20, #32]
	cbz	w9, LBB1_payload_not_owned
	ldr	x0, [x20, #8]
	mov	x1, x19
	bl	_silica_rt_report_begin
LBB1_payload_not_owned:
	ldr	x0, [x20, #8]
	ldp	x1, x8, [x19]
	cbz	x8, LBB1_ingress_no_beh
	mov	x2, sp
	ldr	x9, [x19, #272]
	cbz	x9, LBB1_sw_none_1
	ldr	x10, [x19, #280]
	add	x9, x9, x10
	mov	x10, sp
	str	x10, [x19, #368]
	mov	sp, x9
LBB1_sw_none_1:
	blr	x8
	ldr	x10, [x19, #368]
	cbz	x10, LBB1_sw_back_1
	mov	sp, x10
	str	xzr, [x19, #368]
LBB1_sw_back_1:
	ldr	x10, [x0]
";
    p1: string <- concat(p0, std_no_reply_cmp);
    p2: string <- concat(p1, "	ldr	x21, [x0, #8]
	ldr	x9, [x0, #16]
	b	LBB1_post_beh
LBB1_no_reply_result:
	mov	x21, xzr
	ldr	x9, [x0, #8]
	b	LBB1_post_beh
LBB1_ingress_check_kind:
	ldr	w9, [x20, #24]
	cbnz	w9, LBB1_ingress_user_beh
LBB1_ingress_no_beh:
; No behaviour to run. A standard message to an actor without one (w22 = 0) is dropped below. An
; exit notice (w22 = 1, +24 = 0, its heap payload at +8: Phase C) is served HERE, in the
; behaviour's place and, for a carrier actor, on the actor's own stack: maybe_restart (the row's
; restart policy, the intensity cap, a :one_for_all or :rest_for_one cascade that stops siblings
; and waits for each, the respawns and their waits for the children's start) parks a supervisor
; at every wait instead of stalling the carrier, as it would on the carrier's stack. The release
; algorithm then runs at LBB1_post_beh as after a behaviour. The payload (and its hold on the
; ended child) goes once served and +8 is cleared, so LBB1_free has only the restart token
; (taken with the node, LBB1_wait) to release. X24 = the carrier (0: a dangerous actor's thread,
; where the restart runs on the thread's own stack and its waits spin). The carrier's SP here is
; its base less the 48-byte dispatch frame, which is what a resume rebuilds (Lcar_resume).
	mov	x21, xzr
	mov	x9, xzr
	cbz	w22, LBB1_post_beh
	ldr	w10, [x20, #24]
	cbnz	w10, LBB1_post_beh
	ldr	x25, [x20, #8]
	cbz	x25, LBB1_post_beh
	ldr	x24, [x19, #440]
	ldr	x0, [x25]
	mov	x1, x19
	ldr	x2, [x25, #8]
	cbz	x24, LBB1_ingress_restart_call
	ldr	x9, [x19, #272]
	cbz	x9, LBB1_ingress_restart_call
	ldr	x10, [x19, #280]
	add	x9, x9, x10
	mov	x10, sp
	str	x10, [x19, #368]
	mov	sp, x9
	bl	_silica_rt_supervisor_maybe_restart
	ldr	x9, [x24, #48]
	sub	x9, x9, #48
	mov	sp, x9
	str	xzr, [x19, #368]
	b	LBB1_ingress_restart_done
LBB1_ingress_restart_call:
	bl	_silica_rt_supervisor_maybe_restart
LBB1_ingress_restart_done:
	mov	x0, x25
	bl	_silica_rt_exit_payload_free
	str	xzr, [x20, #8]
	mov	x21, xzr
	mov	x9, xzr
	b	LBB1_post_beh
LBB1_ingress_user_beh:
; Phase B trial: message[+8] is inline int64; run behavior like a normal dequeue.
	ldr	x0, [x20, #8]
	ldp	x1, x8, [x19]
	cbz	x8, LBB1_ingress_no_beh
	mov	x2, sp
	ldr	x9, [x19, #272]
	cbz	x9, LBB1_sw_none_2
	ldr	x10, [x19, #280]
	add	x9, x9, x10
	mov	x10, sp
	str	x10, [x19, #368]
	mov	sp, x9
LBB1_sw_none_2:
	blr	x8
	ldr	x10, [x19, #368]
	cbz	x10, LBB1_sw_back_2
	mov	sp, x10
	str	xzr, [x19, #368]
LBB1_sw_back_2:
	ldr	x10, [x0]
");
    p3: string <- concat(p2, ingress_no_reply_cmp);
    concat(p3, "	ldr	x21, [x0, #8]
	ldr	x9, [x0, #16]
	mov	w22, #0
	b	LBB1_post_beh
LBB1_ingress_no_reply_result:
	mov	x21, xzr
	ldr	x9, [x0, #8]
	mov	w22, #0
	b	LBB1_post_beh
LBB1_post_beh:
; Message boundary: the behavior has returned and its stack is empty, so the release algorithm
; runs now, before the reply is handed to the caller (spec §15.1.2.2).
	mov	x23, x9
	mov	x0, x19
	bl	_silica_rt_stack_on_message_return
	mov	x9, x23
	ldr	x20, [x19, #240]
	ldr	w8, [x20, #16]
	add	sp, sp, #48
	str	xzr, [x19, #240]
	cbnz	w22, LBB1_skip_actor_state
	str	x9, [x19]
LBB1_skip_actor_state:
	cbnz	w22, LBB1_ingress_restore_w21
	b	LBB1_after_w21
LBB1_ingress_restore_w21:
	mov	w21, w22
LBB1_after_w21:
	cbz	w8, LBB1_free
; Phase E e4f: take the call wrapper lock before draining supervision ingress so the
; caller cannot complete actor_call (and free the wrapper) until every enqueued exit
; notification has been processed. kill_abnormal only signals the victim; deliver_exit
; runs on child threads while sup_beh is still finishing — without this ordering, main
; could free the wrapper concurrently with deliver_exit / LBB1_exit (SIGBUS mfm_*) on
; phase_e4f_rest_for_one.
	add	x0, x20, #72
	bl	_os_unfair_lock_lock
; An ingress node served with a reply (w22) held the restart token (LBB1_wait): released first.
	cbz	w22, LBB1_reply_drain
	mov	x0, x19
	bl	_silica_rt_sup_restart_release
LBB1_reply_drain:
; The replier drains its own ingress (empty, for a worker). A supervisor's drain may run restarts
; and wait: a carrier actor (X24 = its carrier) runs it on its own stack so that its waits park;
; the SP here is the carrier's base (the dispatch frame is gone), restored after.
	mov	x0, x19
	mov	x1, x19
	ldr	x9, [x19, #216]
	cbz	x9, LBB1_reply_drain_call
	ldr	x24, [x19, #440]
	cbz	x24, LBB1_reply_drain_call
	ldr	x9, [x19, #272]
	cbz	x9, LBB1_reply_drain_call
	ldr	x10, [x19, #280]
	add	x9, x9, x10
	mov	x10, sp
	str	x10, [x19, #368]
	mov	sp, x9
	bl	_silica_rt_supervisor_drain_ingress
	ldr	x9, [x24, #48]
	mov	sp, x9
	str	xzr, [x19, #368]
	b	LBB1_reply_drain_done
LBB1_reply_drain_call:
	bl	_silica_rt_supervisor_drain_ingress
LBB1_reply_drain_done:
	str	x21, [x20, #144]
	mov	w8, #1
	str	w8, [x20, #136]
	mov	x0, x20
	bl	_silica_rt_call_wrapper_wake
	add	x0, x20, #72
	bl	_os_unfair_lock_unlock
	b	LBB1_again
LBB1_free:
; An ingress node (w22 == 1) was served at LBB1_ingress_no_beh (an exit notice: its payload is
; gone and +8 cleared): only the restart token taken with it is left to release. A Phase B
; trial-hook node (+24 != 0, +8 an inline int64) was run by the behaviour, which cleared w22,
; and took no token at LBB1_wait.
	cbz	w22, LBB1_free_skip_restart
LBB1_free_release:
; The ingress node is served: the restart token taken with it (LBB1_wait) goes.
	mov	x0, x19
	bl	_silica_rt_sup_restart_release
LBB1_free_skip_restart:
; A payload the message owns (the FailureReporter's report string) goes back now that the
; behaviour has returned, unless the behaviour kept it (_silica_rt_report_release).
	ldr	w9, [x20, #32]
	cbz	w9, LBB1_free_node
	ldr	x0, [x20, #8]
	mov	x1, x19
	bl	_silica_rt_report_release
LBB1_free_node:
	mov	x0, x20
	bl	_free
LBB1_again:
; The message is served. An actor thread goes back to its mailbox; a carrier actor is re-queued
; or marked idle by the carrier.
	ldr	x9, [x19, #440]
	cbz	x9, LBB1_loop
	mov	x0, x19
	b	_silica_rt_carrier_requeue
LBB1_exit:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
; X24 = the carrier when this is a carrier actor (read before the block can be freed below): its
; exit path ends in the carrier loop. Its delivering phase (a supervisor's shutdown of its
; children, each waited for; the exit notice; the report; the pending callers' deaths; the
; child table) runs on the actor's own reservation, where a wait parks and the carrier runs on
; (a child on this carrier can only end when it does); the carrier's stack is for what follows,
; once nothing waits (prims_actors_carrier_asm.silica header). A released reservation grows
; again on the first push.
	ldr	x24, [x19, #440]
	cbz	x24, LBB1_exit_deliver
	ldr	x9, [x19, #272]
	cbz	x9, LBB1_exit_deliver
	ldr	x10, [x19, #280]
	add	x9, x9, x10
	mov	sp, x9
LBB1_exit_deliver:
	mov	x0, x19
	bl	_silica_rt_registry_forget_actor
	ldr	x8, [x19, #216]
	cbz	x8, Lsbg_1
	ldr	x8, [x8, #40]
Lsbg_1:
	cbnz	x8, LBB1_exit_report_already_done
	mov	x0, x19
	bl	_silica_rt_actor_deliver_exit
	mov	x20, x0
; A root actor's note goes out before its report reaches a registered FailureReporter, which may
; end the process (cast_exit) once it has the report (_silica_rt_root_note_early); x20 = 0 then.
	cbz	x20, LBB1_exit_note_later
	bl	_silica_rt_root_note_early
	cbz	x0, LBB1_exit_note_later
	mov	x20, #0
LBB1_exit_note_later:
	mov	x0, x19
	bl	_silica_rt_actor_deliver_unwind_report
	b	LBB1_exit_after_report
LBB1_exit_report_already_done:
	mov	x20, #0
LBB1_exit_after_report:
; Callers parked in a call to this actor learn of its death now, before a restart drained below
; stops them (a sibling parked in a call to it, under :one_for_all).
	mov	x0, x19
	bl	_silica_rt_actor_signal_pending_call_deaths
; A notice parked at #400 (this row child ended before its spawner committed it) is not in the
; supervisor's ingress yet: nothing to drain. A carrier actor does not drain its supervisor's
; ingress: the supervisor's own dispatch restarts it (LBB1_ingress_no_beh), or a kill_abnormal
; caller's drain does. A dangerous actor's thread restarts itself when its own notice is first
; in the ingress (_silica_rt_supervisor_drain_own_exit; the protocol in
; prims_actors_child_table_asm.silica's header) and never waits for its replacement: a caller in
; kill_abnormal waits for this row's exit_done, the last act below, and then for the restart to
; settle.
