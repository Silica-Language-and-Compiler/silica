	cbz	x0, L_tcag_ret
	ldr	x0, [x0]
L_tcag_ret:
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
	.globl	_silica_rt_tls_actor_set_from_x19
	.p2align	2
_silica_rt_tls_actor_set_from_x19:
