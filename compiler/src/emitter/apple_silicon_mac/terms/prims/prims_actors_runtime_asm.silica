_silica_actor_tls_init_lock:
	.zero	4
_silica_actor_tls_key_ready:
	.zero	1
"
}

fn actor_rt_asm_chunk_11() -> string {
    "	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_ensure_actor_tls_key
	.p2align	2
_silica_rt_ensure_actor_tls_key:
	.cfi_startproc
