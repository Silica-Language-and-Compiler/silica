fn actor_rt_asm_chunk_12() -> string {
    "	.section	__TEXT,__cstring,cstring_literals
	.p2align	2
L_silica_root_actor_exit:
	.asciz	\"[silica] root actor exited (no supervisor)\\n\"
	.section	__TEXT,__text,regular,pure_instructions
; The root-exit note. Written under _silica_rt_root_note_lock; the exit drain
; (_silica_rt_report_drain_at_exit) takes that lock last and keeps it, so the process never ends
; while a note is half written (a torn \"[s\" glued to the next output through a PTY).
	.globl	_silica_rt_root_note_write
	.p2align	2
_silica_rt_root_note_write:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	adrp	x0, _silica_rt_root_note_lock@PAGE
	add	x0, x0, _silica_rt_root_note_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	mov	w0, #2
	adrp	x1, L_silica_root_actor_exit@PAGE
	add	x1, x1, L_silica_root_actor_exit@PAGEOFF
	mov	w2, #43
	bl	_write
	adrp	x0, _silica_rt_root_note_lock@PAGE
	add	x0, x0, _silica_rt_root_note_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	ldp	x29, x30, [sp], #16
	ret
; X0 out: 1 when a FailureReporter is registered and the note has been written now, 0 when the
; caller writes it after the report as before. With a reporter the report is printed on the
; reporter's thread, which may call cast_exit on it, so the note must be out before the report is
; queued; without one the report is written synchronously and the note follows it.
	.globl	_silica_rt_root_note_early
	.p2align	2
_silica_rt_root_note_early:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	adrp	x8, _silica_rt_root_failure_reporter@PAGE
	add	x8, x8, _silica_rt_root_failure_reporter@PAGEOFF
	ldr	x8, [x8]
	mov	x0, #0
	cbz	x8, Lrne_ret
	bl	_silica_rt_root_note_write
	mov	x0, #1
Lrne_ret:
	ldp	x29, x30, [sp], #16
	ret
; X0 = a root actor's (or root supervisor's) control block: its failure report and the root note,
; in the order _silica_rt_root_note_early gives.
	.globl	_silica_rt_root_report_and_note
	.p2align	2
_silica_rt_root_report_and_note:
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	adrp	x9, _silica_rt_report_inflight@PAGE
	add	x9, x9, _silica_rt_report_inflight@PAGEOFF
Lrrn_inflight_inc:
	ldaxr	x10, [x9]
	add	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lrrn_inflight_inc
	bl	_silica_rt_root_note_early
	mov	x20, x0
	mov	x0, x19
	bl	_silica_rt_actor_deliver_unwind_report
	cbnz	x20, Lrrn_ret
	bl	_silica_rt_root_note_write
Lrrn_ret:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.section	__DATA,__bss
	.p2align	2
.globl	_silica_rt_root_note_lock
.comm	_silica_rt_root_note_lock,4,2
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_migrate_actor        ; -- Begin function silica_rt_migrate_actor
	.p2align	2
_silica_rt_migrate_actor:
; X0 = reference: resolved and held for the body below (_silica_rt_ref_call).
	adrp	x9, _silica_rt_migrate_actor_acb@PAGE
	add	x9, x9, _silica_rt_migrate_actor_acb@PAGEOFF
	b	_silica_rt_ref_call
	.p2align	2
_silica_rt_migrate_actor_acb:               ; @silica_rt_migrate_actor
	.cfi_startproc
; X0 = ACB (held) or 0, X1 = target core -> X0 = 0 (:ok: the move is requested, and done at the
; actor's next dispatch boundary, at once when it is idle), 1 (:invalid_target: no logical core of
; that id on this machine, _silica_rt_logical_cpu_count, the count get_cpu_topology reports),
; 2 (:actor_not_found: a null reference, or an actor that has ended); the emitter maps the code to
; the program's atom (prims_actors emit_prim_op_with_atoms). 3 (:migration_blocked) only when the
; target carrier has no thread yet and the host refuses one (dangerous actors may hold every
; thread it allows; item N #5): nothing else blocks a move. A carrier actor (#144 = 0, item N stage 3) is
; moved to the carrier of the core, `core mod N` as at spawn (_silica_rt_carrier_migrate, which
; says what happens per status). A dangerous actor (a thread of its own, #144) gets the thread's
; affinity hint, as every actor did before carriers; the OS may still share or move the thread
; (spec §22.10), so the hint's own result is not reported.
	cbz	x0, Lmig_not_found
	ldr	w9, [x0, #152]
	cbz	w9, Lmig_not_found
	adrp	x8, _silica_rt_logical_cpu_count@PAGE
	add	x8, x8, _silica_rt_logical_cpu_count@PAGEOFF
	ldr	x9, [x8]
	cmp	x1, x9
	b.hs	Lmig_invalid
	ldr	x9, [x0, #144]
	cbz	x9, Lmig_carrier
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	mov	x19, x1
	ldr	x0, [x0, #144]
	bl	_pthread_mach_thread_np
	mov	x20, x0
	sub	sp, sp, #16
	str	w19, [sp]
	mov	x0, x20
	mov	w1, #4
	mov	x2, sp
	mov	w3, #1
	bl	_thread_policy_set
	add	sp, sp, #16
	mov	x0, #0
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
Lmig_carrier:
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	mov	x0, x1
	bl	_silica_rt_carrier_for_core
	mov	x1, x0
	mov	x0, x19
	bl	_silica_rt_carrier_migrate
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
Lmig_invalid:
	mov	x0, #1
	ret
Lmig_not_found:
	mov	x0, #2
	ret
	.cfi_endproc
                                        ; -- End function
"
}

fn actor_rt_asm_chunk_13() -> string {
    "	.section	__TEXT,__text,regular,pure_instructions
; get_actor_memory_usage lives in prims_actors_stack_asm.silica (four-field record).
	.globl	_silica_rt_region_alloc         ; -- Begin function silica_rt_region_alloc
	.p2align	2
_silica_rt_region_alloc:                ; @silica_rt_region_alloc
	.cfi_startproc
; X0=size. Bump-allocates from current actor's mmap region.
; Falls back to _malloc if not in actor context.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	add	x19, x0, #7
	and	x19, x19, #0xfffffffffffffff8
	bl	_silica_rt_tls_current_actor_get
	mov	x20, x0
	cbz	x20, LBBra_fallback
	ldr	x8, [x20, #176]
	cbz	x8, LBBra_grow
	ldr	x9, [x20, #184]
	add	x10, x8, x19
	cmp	x10, x9
	b.hi	LBBra_grow
	str	x10, [x20, #176]
	adrp	x11, _silica_rt_heap_in_use@PAGE
	add	x11, x11, _silica_rt_heap_in_use@PAGEOFF
LBBra_acc_bump:
	ldaxr	x12, [x11]
	add	x12, x12, x19
	stlxr	w13, x12, [x11]
	cbnz	w13, LBBra_acc_bump
	mov	x0, x8
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
LBBra_grow:
; New block: 64 MB, or the request plus its header when larger. Anonymous RW mappings cost
; nothing until touched, so an idle actor still holds no arena memory. The old block's tail is
; wasted from here on, so the in-use count takes it now and dealloc_region subtracts it.
	cbz	x8, LBBra_grow_map
	ldr	x9, [x20, #184]
	sub	x9, x9, x8
	adrp	x11, _silica_rt_heap_in_use@PAGE
	add	x11, x11, _silica_rt_heap_in_use@PAGEOFF
LBBra_acc_waste:
	ldaxr	x12, [x11]
	add	x12, x12, x9
	stlxr	w13, x12, [x11]
	cbnz	w13, LBBra_acc_waste
LBBra_grow_map:
	add	x9, x19, #32
	movz	x10, #0x400, lsl #16
	cmp	x9, x10
	csel	x1, x9, x10, hi
	str	x1, [sp, #-16]!
	mov	x0, xzr
	mov	w2, #3
	movz	w3, #0x1002
	mov	w4, #-1
	mov	x5, xzr
	bl	_mmap
	ldr	x1, [sp], #16
	cmn	x0, #1
	b.eq	LBBra_grow_failed
	ldr	x8, [x20, #160]
	str	x8, [x0]
	str	x1, [x0, #8]
	str	x0, [x20, #160]
	add	x9, x0, x1
	str	x9, [x20, #184]
	ldr	x10, [x20, #168]
	add	x10, x10, x1
	str	x10, [x20, #168]
	add	x8, x0, #16
	add	x10, x8, x19
	str	x10, [x20, #176]
	adrp	x11, _silica_rt_heap_in_use@PAGE
	add	x11, x11, _silica_rt_heap_in_use@PAGEOFF
LBBra_acc_grow:
	ldaxr	x12, [x11]
	add	x12, x12, x19
	stlxr	w13, x12, [x11]
	cbnz	w13, LBBra_acc_grow
	mov	x0, x8
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
LBBra_grow_failed:
	mov	x0, xzr
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
LBBra_fallback:
	add	x0, x19, #16
	bl	_malloc
	cbz	x0, LBBra_oom
	adrp	x8, _silica_rt_region_list@PAGE
	add	x8, x8, _silica_rt_region_list@PAGEOFF
	ldr	x9, [x8]
	str	x9, [x0]
	str	x19, [x0, #8]
	str	x0, [x8]
	adrp	x11, _silica_rt_heap_in_use@PAGE
	add	x11, x11, _silica_rt_heap_in_use@PAGEOFF
LBBra_acc_fallback:
	ldaxr	x12, [x11]
	add	x12, x12, x19
	stlxr	w13, x12, [x11]
	cbnz	w13, LBBra_acc_fallback
	add	x0, x0, #16
LBBra_oom:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
	.globl	_silica_rt_heap_used
_silica_rt_heap_used:
; -> X0 = bytes handed out by _silica_rt_region_alloc and not yet released: every arena bump an actor
; made (its blocks go back together when it ends, in _silica_rt_actor_dealloc_region) plus every
; fallback allocation made outside an actor, which is never released. Requests, not resident
; pages: a block is mapped lazily. The heap_used() builtin.
	adrp	x8, _silica_rt_heap_in_use@PAGE
	add	x8, x8, _silica_rt_heap_in_use@PAGEOFF
	ldar	x0, [x8]
	ret
	.globl	_silica_rt_raw_alloc
_silica_rt_raw_alloc:
; X0=size. malloc with a [next][size] header, NOT linked into the global region
; list. Region memory must be freeable by its owner; anything on that list can
; only be freed by unwinding to a mark, which is scope-shaped and unsound here.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	add	x0, x19, #16
	bl	_malloc
	cbz	x0, LBBrw_oom
	str	xzr, [x0]
	str	x19, [x0, #8]
	add	x0, x0, #16
LBBrw_oom:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.globl	_silica_rt_region_destroy
_silica_rt_region_destroy:
; X0=region handle. Frees every extension block on the [r+16] chain, then the
; region header. Blocks come from _silica_rt_raw_alloc, so each malloc base is
; payload-16. Null handle is a no-op so a moved-out region is safe to skip.
; A canonical arena (_silica_rt_canonical_arena_lookup) is process-shared and belongs to the
; canonical arena table, which hands the same base out to every lookup of its key for the life of
; the process. A function that received one as a parameter owns the handle (spec 4.4.2) and
; destroys it when it does not move on, exactly as for any region; the arena itself must survive
; that, so the table is consulted first and a registered base is left untouched (LBBrd_canonical).
; Freeing it here used to hand a non-malloc block to free (libmalloc assertion, SIGTRAP, 133).
	cbz	x0, LBBrd_ret
	adrp	x9, _silica_rt_canonical_arena_table@PAGE
	add	x9, x9, _silica_rt_canonical_arena_table@PAGEOFF
	mov	w10, #512
LBBrd_cscan:
	ldr	x11, [x9, #8]
	cmp	x11, x0
	b.eq	LBBrd_canonical
	add	x9, x9, #16
	subs	w10, w10, #1
	b.ne	LBBrd_cscan
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	str	x21, [sp, #-16]!
	mov	x19, x0
	ldr	x20, [x19, #16]
LBBrd_loop:
	cbz	x20, LBBrd_hdr
	ldr	x21, [x20, #16]
	sub	x0, x20, #16
	bl	_free
	mov	x20, x21
	b	LBBrd_loop
LBBrd_hdr:
	sub	x0, x19, #16
	bl	_free
	ldr	x21, [sp], #16
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
LBBrd_ret:
	ret
LBBrd_canonical:
; Deliberate no-op: the canonical arena stays registered and usable by its key.
	ret
	.globl	_silica_rt_region_mark
_silica_rt_region_mark:
	adrp	x16, _silica_rt_region_list@PAGE
	add	x16, x16, _silica_rt_region_list@PAGEOFF
	ldr	x16, [x16]
	ret
	.globl	_silica_rt_region_release_to
_silica_rt_region_release_to:
	stp	x29, x30, [sp, #-16]!
	stp	x0, x1, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	stp	x21, x22, [sp, #-16]!
	mov	x21, x16
	adrp	x19, _silica_rt_region_list@PAGE
	add	x19, x19, _silica_rt_region_list@PAGEOFF
	ldr	x20, [x19]
Lrrt_loop:
	cmp	x20, x21
	b.eq	Lrrt_done
	cbz	x20, Lrrt_done
	ldr	x1, [x20]
	str	x1, [x19]
	mov	x0, x20
	mov	x20, x1
	bl	_free
	b	Lrrt_loop
Lrrt_done:
	str	x21, [x19]
	ldp	x21, x22, [sp], #16
	ldp	x19, x20, [sp], #16
	ldp	x0, x1, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_region_list
	.comm	_silica_rt_region_list,8,3
	.globl	_silica_rt_heap_in_use
	.comm	_silica_rt_heap_in_use,8,3
                                        ; -- End function
	.globl	_silica_rt_actor_supervision_ingress_enqueue ; Phase B — synthetic exit / trial hook; bounded queue
	.p2align	2
_silica_rt_actor_supervision_ingress_enqueue:
; X0 = reference: resolved and held for the body below (_silica_rt_ref_call).
	adrp	x9, _silica_rt_actor_supervision_ingress_enqueue_acb@PAGE
	add	x9, x9, _silica_rt_actor_supervision_ingress_enqueue_acb@PAGEOFF
	b	_silica_rt_ref_call
	.p2align	2
_silica_rt_actor_supervision_ingress_enqueue_acb:
	.cfi_startproc
; X0=target actor_ref, X1=int64 payload → X0=:ok (0). Cast-shaped 152 B node; +8 = inline int64; +24 = 1 (trial; not heap payload).
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0
	mov	x21, x1
	cbz	x19, Lsie_fail_nolock
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x0, x19
	bl	_silica_rt_sb_require
	ldr	w9, [x0, #16]
	cmp	w9, #1024
	b.hs	Lsie_abort
	mov	w0, #1
	mov	w1, #152
	bl	_calloc
	cbz	x0, Lsie_unlock_fail
	mov	x20, x0
	str	x21, [x20, #8]
	str	wzr, [x20, #16]
	mov	w9, #1
	str	w9, [x20, #24]
	ldr	x0, [x19, #216]
	mov	x1, x20
	bl	_silica_rt_q_enqueue_locked
	ldr	x8, [x19, #216]
	ldr	w9, [x8, #16]
	add	w9, w9, #1
	str	w9, [x8, #16]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, #0
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lsie_unlock_fail:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
Lsie_fail_nolock:
	mov	x0, #0
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lsie_abort:
	bl	_silica_rt_abort_ingress_full
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_sb_require
	.p2align	2
_silica_rt_sb_require:
; X0 = ACB -> X0 = its supervision block (SB, 144 B: #0/#8 ingress front/rear, #16 depth u32,
; #24 child-table head, #32 len, #40 sync_failure_reported, #48 start trampoline, #56 strategy,
; #64 allowed restarts, #72 time frame, #80 restart count, #88 window start, #96/#104 unused,
; #112 references: sb_unref, #120 the holder of the restart token (0 free; the protocol in
; prims_actors_child_table_asm.silica's header), #128 the carrier actors parked for the token,
; #136 unused), made now when the
; actor had none: by spawn for an actor with a trampoline, by the ingress enqueue for any other
; actor that receives an exit notice (an add_child parent; the caller holds the target's lock),
; by the child-table paths for the running actor. Freed by its last reference (sb_unref).
	stp	x29, x30, [sp, #-32]!
	str	x19, [sp, #16]
	mov	x29, sp
	mov	x19, x0
	ldr	x0, [x19, #216]
	cbnz	x0, Lsbr_have
	mov	w0, #1
	mov	w1, #144
	bl	_calloc
	str	x0, [x19, #216]
	mov	x9, #1
	str	x9, [x0, #112]
Lsbr_have:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_actor_recv           ; Phase B/C/G — ingress then standard; §15.4.8.6 DOWN only on standard
	.p2align	2
_silica_rt_actor_recv:                  ; @silica_rt_actor_recv
	.cfi_startproc
; TLS current actor: dequeue next message (supervision ingress first, then standard mailbox). Return X0 = message node or 0.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	cbz	x19, Lrecv_done_null
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x0, [x19, #216]
	cbz	x0, Lrecv_try_std
	bl	_silica_rt_q_dequeue_locked
	mov	x20, x0
	cbz	x20, Lrecv_try_std
	ldr	x8, [x19, #216]
	ldr	w9, [x8, #16]
	sub	w9, w9, #1
	str	w9, [x8, #16]
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	w9, [x20, #24]
	cbnz	w9, Lrecv_ret_node
	ldr	x9, [x20, #8]
	cbz	x9, Lrecv_ret_node
	ldr	x0, [x9]
	bl	_silica_rt_acb_release
	b	Lrecv_ret_node
Lrecv_try_std:
	add	x0, x19, #128
	bl	_silica_rt_q_dequeue_locked
	mov	x20, x0
Lrecv_unlock_node:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
Lrecv_ret_node:
	mov	x0, x20
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
Lrecv_done_null:
	mov	x0, #0
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_add_child      ; Explicit supervisor child registration
	.p2align	2
_silica_rt_actor_add_child:
; X0 = parent reference, X1 = child reference: both held for the body.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x21, x1
	bl	_silica_rt_ref_hold
	mov	x19, x0
	mov	x0, x21
	bl	_silica_rt_ref_hold
	mov	x20, x0
	mov	x0, x19
	mov	x1, x20
	bl	_silica_rt_actor_add_child_acb
	mov	x0, x19
	bl	_silica_rt_acb_release
	mov	x0, x20
	bl	_silica_rt_acb_release
	mov	x0, #0
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.p2align	2
_silica_rt_actor_add_child_acb:
	.cfi_startproc
; X0=parent supervisor actor_ref, X1=child actor_ref -> X0=atom :ok.
; Records the explicit parent/child relationship used by supervisor ingress teardown.
	cbz	x0, Ladd_child_done
	cbz	x1, Ladd_child_done
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, x1
	ldr	x9, [x20, #192]
	cmp	x9, x19
	b.eq	Ladd_child_held
; The child holds its supervisor until its exit path is done with it (_silica_rt_actor_final_release).
	mov	x0, x19
	bl	_silica_rt_acb_hold
	add	x9, x20, #192
Ladd_child_swap:
	ldaxr	x0, [x9]
	stlxr	w11, x19, [x9]
	cbnz	w11, Ladd_child_swap
	bl	_silica_rt_acb_release
Ladd_child_held:
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
Ladd_child_done:
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_link           ; Phase G — §15.4.8.4–8.5
	.p2align	2
_silica_rt_actor_link:                  ; @silica_rt_actor_link
	.cfi_startproc
; X0=target actor_ref -> X0=0; the emitter answers :ok (prims_actors emit_prim_op_with_atoms). Idempotent link; dead target must enqueue exit (ingress if supervisor) — stub.
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_monitor        ; Phase G — §15.4.8.6
	.p2align	2
_silica_rt_actor_monitor:               ; @silica_rt_actor_monitor
	.cfi_startproc
; X0=target -> X0=monitor_ref. Real runtime: DOWN `(:down, ref, target, reason)` to standard mailbox only, not ingress.
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_demonitor      ; Phase G — §15.4.8.6–8.7
	.p2align	2
_silica_rt_actor_demonitor:             ; @silica_rt_actor_demonitor
	.cfi_startproc
; X0=monitor_ref -> X0=0; the emitter answers :ok
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
"
}

// Phase C (§15.4.10–§15.4.11): structured exit notification construction + ingress delivery, plus three
// behavior-only trial accessors used by `phase_c_child_exit_notification.silica` to assert payload fields.
// Payload layout (32 B, heap): [+0]=child_ref, [+8]=reason_tag (int64; 0=:normal for Phase C), [+16]=reason_atom
// (atom index; 0 when not `(:explicit, …)`), [+24]=agent_type (atom copied from child's #200 slot).
// Message node (152 B, heap) matches the standard cast shape: [+8]=payload pointer, [+16]=needs_reply=0, [+24]=ingress_kind (0 here).
// Dead-supervisor handling (§15.4.10.4): caller is signalled via X0=1 to emit the existing root-actor stderr note.
fn actor_rt_asm_phase_c_chunk(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    ok_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":ok"));
    normal_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":normal"));
    language_error_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":language_error"));
    memory_fault_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":memory_fault"));
    explicit_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":explicit"));
    unknown_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":unknown"));
    foreign_fault_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":foreign_fault"));
    p0: string <- concat("	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_actor_deliver_exit   ; Phase C — §15.4.10 unified delivery
	.p2align	2
_silica_rt_actor_deliver_exit:          ; X0=child self; X0 out: 0 delivered or dropped (dead supervisor), 1 no supervisor / OOM (root note)
	.cfi_startproc
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0
; A death is in flight from here until its failure report is listed or written
; (_silica_rt_actor_deliver_unwind_report): the supervisor can end on this exit and the
; process with it before this thread reports, so the exit drain waits for the count.
	adrp	x9, _silica_rt_report_inflight@PAGE
	add	x9, x9, _silica_rt_report_inflight@PAGEOFF
Lde_inflight_inc:
	ldaxr	x10, [x9]
	add	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lde_inflight_inc
; An ending supervisor shuts its children down first (spec §15.4.8.4, §15.4.12.2), so their
; names are free before its own exit reaches its supervisor, which may restart it at once.
	ldr	x8, [x19, #216]
	cbz	x8, Lde_no_children
	bl	_silica_rt_sup_shutdown_children
	mov	x0, x19
Lde_no_children:
; §20.3.1: the registered name goes before the exit reaches the supervisor, on every exit path.
	bl	_silica_rt_registry_forget_actor
	ldr	x20, [x19, #192]
	cbz	x20, Lde_nosup
	mov	w0, #1
	mov	w1, #32
	bl	_calloc
	cbz	x0, Lde_nosup
	mov	x21, x0
	str	x19, [x21]
	ldr	x9, [x19, #232]
	str	x9, [x21, #8]
	ldr	x9, [x19, #384]
	str	x9, [x21, #16]
	ldr	x8, [x19, #200]
	str	x8, [x21, #24]
; The notice holds this actor's control block until a supervisor has handled it
; (_silica_rt_exit_payload_free): maybe_restart matches rows by this reference.
	mov	x0, x19
	bl	_silica_rt_acb_hold
; A row child its spawner has not yet committed to the row (#400 == 0) parks the notice there; the
; spawner enqueues it once the row holds this actor (_silica_rt_supervisor_spawn_child_row_by_flavor).
	add	x9, x19, #400
Lde_park:
	ldaxr	x10, [x9]
	cbnz	x10, Lde_enqueue
	stlxr	w11, x21, [x9]
	cbnz	w11, Lde_park
	mov	x0, #0
	b	Lde_ret
Lde_enqueue:
	clrex
	mov	x0, x20
	mov	x1, x21
	bl	_silica_rt_sup_enqueue_exit
; A supervised actor whose supervisor has ended is not a root actor: its notice is dropped
; (§15.4.10.4) without the root note (a supervisor's shutdown ends every child this way).
	mov	x0, #0
	b	Lde_ret
Lde_nosup:
	mov	x0, #1
Lde_ret:
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_sup_enqueue_exit
	.p2align	2
_silica_rt_sup_enqueue_exit:
; X0 = supervisor ACB, X1 = exit notification payload -> X0 = 0 queued in its ingress, 1 dropped
; (the supervisor has ended; the payload is freed).
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	mov	x20, x0
	mov	x21, x1
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	ldr	w9, [x20, #152]
	cbz	w9, Lsee_dead
	mov	x0, x20
	bl	_silica_rt_sb_require
	ldr	w9, [x0, #16]
	cmp	w9, #1024
	b.hs	Lsee_abort
	mov	w0, #1
	mov	w1, #152
	bl	_calloc
	cbz	x0, Lsee_dead
	mov	x22, x0
	str	x21, [x22, #8]
	str	wzr, [x22, #16]
	ldr	x0, [x20, #216]
	mov	x1, x22
	bl	_silica_rt_q_enqueue_locked
	ldr	x8, [x20, #216]
	ldr	w9, [x8, #16]
	add	w9, w9, #1
	str	w9, [x8, #16]
	mov	x0, x20
	bl	_silica_rt_actor_mail_signal
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x0, #0
	b	Lsee_ret
Lsee_dead:
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x21
	bl	_silica_rt_exit_payload_free
	mov	x0, #1
Lsee_ret:
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lsee_abort:
	bl	_silica_rt_abort_exit_queue_full
	.globl	_silica_rt_actor_supervision_wait_and_drain_one ; Phase C trial accessor — behavior-only
	.p2align	2
_silica_rt_actor_supervision_wait_and_drain_one:
	.cfi_startproc
; No args; returns X0 = failure payload pointer dequeued from self's supervision ingress, blocks until one is available.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	cbz	x19, Lswd_null
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
Lswd_try:
; The restart token (block #120) is taken with the node, as LBB1_wait does, and released after.
	ldr	x0, [x19, #216]
	cbz	x0, Lswd_wait
	ldr	x8, [x0, #120]
	cbnz	x8, Lswd_wait
	bl	_silica_rt_q_dequeue_locked
	cbz	x0, Lswd_wait
	mov	x20, x0
	ldr	x8, [x19, #216]
	str	x19, [x8, #120]
	ldr	w9, [x8, #16]
	sub	w9, w9, #1
	str	w9, [x8, #16]
	ldr	x21, [x20, #8]
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
; Phase E: mirror LBB1_free (mutex must not be held — maybe_restart may spawn / take table locks). X2 = reason_tag (e4b).
	cbz	x21, Lswd_free_wrap
	ldr	x8, [x21]
	cbz	x8, Lswd_free_wrap
	mov	x0, x8
	mov	x1, x19
	ldr	x2, [x21, #8]
	bl	_silica_rt_supervisor_maybe_restart
	ldr	x0, [x21]
	bl	_silica_rt_acb_release
Lswd_free_wrap:
	mov	x0, x19
	bl	_silica_rt_sup_restart_release
	mov	x0, x20
	bl	_free
	mov	x0, x21
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lswd_wait:
; Phase E e4f: blocking pthread_cond_wait. Same rationale as in _silica_rt_actor_call /
; actor_thread_main wait paths — the 1 ms timedwait was a missed-signal band-aid that drove
; libpthread internal kwq malloc churn racing with new-actor TLS instantiation (mfm_alloc
; SIGBUS). All paths that enqueue a failure (LBB1_free's _silica_rt_actor_deliver_exit, etc.)
; signal sup#80 cond while holding sup#16 mutex, so plain cond_wait is correctly delivered.
	add	x0, x19, #80
	add	x1, x19, #16
	bl	_silica_rt_cv_wait
	b	Lswd_try
Lswd_null:
	mov	x0, #0
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_reason_tag
	.p2align	2
_silica_rt_actor_failure_reason_tag:    ; X0=payload ptr -> X0=int64 reason_tag (0 :normal)
	.cfi_startproc
	cbz	x0, Lfrt_zero
	ldr	x0, [x0, #8]
	ret
Lfrt_zero:
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_reason_atom
	.p2align	2
_silica_rt_actor_failure_reason_atom:   ; X0=payload ptr -> X0=atom failure_reason variant
	.cfi_startproc
	cbz	x0, Lfra_unknown
	ldr	x8, [x0, #8]
	cbz	x8, Lfra_normal
	cmp	x8, #2
	b.eq	Lfra_language_error
	cmp	x8, #3
	b.eq	Lfra_memory_fault
	cmp	x8, #4
	b.eq	Lfra_explicit
	cmp	x8, #5
	b.eq	Lfra_foreign_fault
	b	Lfra_unknown
Lfra_normal:
	mov	x0, #", normal_idx);
    p1: string <- concat(p0, "
	ret
Lfra_language_error:
	mov	x0, #");
    p2: string <- concat(p1, language_error_idx);
    p3: string <- concat(p2, "
	ret
Lfra_memory_fault:
	mov	x0, #");
    p4: string <- concat(p3, memory_fault_idx);
    p5: string <- concat(p4, "
	ret
Lfra_explicit:
	mov	x0, #");
    p6: string <- concat(p5, explicit_idx);
    p7: string <- concat(p6, "
	ret
Lfra_foreign_fault:
	mov	x0, #");
    p7b: string <- concat(p7, foreign_fault_idx);
    p7c: string <- concat(p7b, "
	ret
Lfra_unknown:
	mov	x0, #");
    p8: string <- concat(p7c, unknown_idx);
    p9: string <- concat(p8, "
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_agent_type
	.p2align	2
_silica_rt_actor_failure_agent_type:    ; X0=payload ptr -> X0=atom agent_type
	.cfi_startproc
	cbz	x0, Lfat_zero
	ldr	x0, [x0, #24]
	ret
Lfat_zero:
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_release
	.p2align	2
_silica_rt_actor_failure_release:       ; X0=payload ptr; frees payload; returns X0=atom :ok
	.cfi_startproc
	cbz	x0, Lfrr_zero
	stp	x29, x30, [sp, #-16]!
	add	x29, sp, #0
	bl	_free
	mov	x0, #");
    p10: string <- concat(p9, ok_idx);
    p11: string <- concat(p10, "
	ldp	x29, x30, [sp], #16
	ret
Lfrr_zero:
	mov	x0, #");
    p12: string <- concat(p11, ok_idx);
    concat(p12, "
	ret
	.cfi_endproc
                                        ; -- End function

.subsections_via_symbols
")
}

// Phase E e4f: lightweight CV primitives backed by os_unfair_lock + ___ulock_wait/___ulock_wake.
// Replaces pthread_mutex_t (~64 B) + pthread_cond_t (~48 B) embedded in heap-allocated ACBs and
// call wrappers — the previous design leaked libpthread-internal kwq accounting when ACBs were
// freed without pthread_mutex_destroy / pthread_cond_destroy (we had to skip those destroys to
// avoid _os_unfair_lock_corruption_abort SIGKILL under macOS arm64 contention). The leaked kwq
// state then trampled malloc free-list metadata, manifesting as KERN_PROTECTION_FAILURE SIGBUS
// in mfm_alloc on later TLS instantiations / call wrapper allocations.
//
// Replacement layout (same offsets so all existing code just swaps the BL targets):
//   ACB+16  : os_unfair_lock (4 B; rest of slot unused, kept zero by calloc).
//   ACB+80  : 4-byte futex sequence word (rest of slot unused).
//   wrapper+72: os_unfair_lock.
//   wrapper+24: 4-byte futex sequence word.
// No init call needed (calloc provides OS_UNFAIR_LOCK_INIT == 0 and seq == 0). No destroy needed —
// freeing the embedding buffer reclaims everything because os_unfair_lock has no out-of-line state.
//
// CV protocol (caller holds the lock):
//   wait: snapshot seq, release lock, ___ulock_wait(UL_COMPARE_AND_WAIT_SHARED, &seq, snapshot, 0).
//         re-acquire lock, return. (Spurious wakeups handled by caller's predicate re-check.)
//   signal: bump seq under lock, ___ulock_wake(UL_COMPARE_AND_WAIT_SHARED, &seq, 0).
//
// Stability — supervisor *restart under load* (keep for future hardening):
// - Flakiness (SIGBUS, hangs, garbled stdout, intermittent integrate failures) shows up under stress for
//   *all* restart strategies — :one_for_one, :one_for_all, and :rest_for_one — because they share this
//   actor runtime (ACB/wrapper locks, ___ulock CVs, ingress, child-table cascade in
//   prims_actors_child_table_asm.silica). Do not assume the bug is strategy-specific; heavier trials
//   (e.g. phase_e4e_one_for_all, phase_e4f_rest_for_one) are better repros than blaming one policy name.
// - Replacing pthread_cond dropped implicit fence behavior around the paired mutex. A plausible fix was
//   extra ARM barriers or stlr/ldar on the call-wrapper reply word (+144) and reply_set (+136). Empirical
//   A/B (hundreds–1000× runs): dmb ish/st, stlr+ldar, and waiter-side dmb all *increased* failures vs
//   plain ldr/str + existing os_unfair_lock pairing. Intermittent restart issues are *not* pinned to a
//   simple “add dmb here” bug; blind barriers are likely wrong on this Apple ulock/lock stack.
// - Do not insert even a single nop (or a global asm label) immediately after `bl ___ulock_wait` inside
//   this CFI region: llvm-as rejects labels there; a lone nop after the bl reliably SIGBUS on arm64e
//   (suspect signed return / kernel resume interaction). Use lldb: break _silica_rt_cv_wait, then
//   single-step across ___ulock_wait instead of a patch-point instruction.
// - Long clean stress batches still occasionally cluster failures; treat load / malloc / scheduling as
//   suspects before revisiting memory-order “fixes” here.
//
// The bump-then-wake order is safe because the waiter snapshots seq under the same lock before
// releasing, so a signaler that sees the lock free either races us (we still observe the bump
// before wait) or hits ulock_wake on a not-yet-waiting addr (which is a no-op the next signal
// recovers from via the next bump).
fn actor_rt_asm_cv_chunk() -> string {
    "	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_cv_signal
	.p2align	2
_silica_rt_cv_signal:                   ; X0 = cv_addr (4-byte futex word). Caller must hold the lock paired with this CV.
	.cfi_startproc
	stp	x29, x30, [sp, #-32]!
	stp	x19, x20, [sp, #16]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	mov	x19, x0
; bump seq (32-bit; wraparound after 4G signals is fine — only mismatch w/ waiter snapshot matters)
	ldr	w8, [x19]
	add	w8, w8, #1
	str	w8, [x19]
; ___ulock_wake(UL_COMPARE_AND_WAIT_SHARED=3, cv_addr, 0).
; bsd/sys/ulock.h: userland heap futex words use UL_COMPARE_AND_WAIT_SHARED (3).
	mov	w0, #3
	mov	x1, x19
	mov	x2, #0
	bl	___ulock_wake
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.cfi_endproc
	.globl	_silica_rt_cv_wait
	.p2align	2
_silica_rt_cv_wait:                     ; X0 = cv_addr, X1 = lock_addr. Caller must hold lock; lock held on return.
	.cfi_startproc
	stp	x29, x30, [sp, #-48]!
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0                         ; cv_addr (callee-saved)
	mov	x20, x1                         ; lock_addr (callee-saved)
; snapshot seq (under lock)
	ldr	w22, [x19]
; release lock
	mov	x0, x20
	bl	_os_unfair_lock_unlock
; ___ulock_wait(UL_COMPARE_AND_WAIT_SHARED=3, cv_addr, snapshot, 0 = no timeout).
	mov	w0, #3
	mov	x1, x19
	mov	x2, x22
	mov	w3, #0
	bl	___ulock_wait
; re-acquire lock
	mov	x0, x20
	bl	_os_unfair_lock_lock
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.cfi_endproc
"
}

fn actor_rt_asm_phase_f_chunk() -> string {
    "	.section	__DATA,__bss
	.p2align	3
.globl	_silica_rt_root_failure_reporter
.comm	_silica_rt_root_failure_reporter,8,3
.globl	_silica_rt_region_dump_limit
.comm	_silica_rt_region_dump_limit,8,3
; The report a FailureReporter is handling: #0 the string block (0: none), #8 escaped (the
; behaviour sent it on, so another actor holds it), #16/#24 the reporter's arena block and bump
; pointer when handling began. One root reporter handles reports, so one record serves.
.globl	_silica_rt_report_owner
.comm	_silica_rt_report_owner,32,3
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_report_begin
	.p2align	2
_silica_rt_report_begin:
; X0 = owned payload, X1 = receiving ACB, before its behaviour runs: the report is recorded as the
; one being handled, then taken off the pending list (in that order, so the exit drain never sees
; it in neither place).
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	adrp	x9, _silica_rt_report_owner@PAGE
	add	x9, x9, _silica_rt_report_owner@PAGEOFF
	str	x0, [x9]
	str	xzr, [x9, #8]
	ldr	x10, [x1, #160]
	str	x10, [x9, #16]
	ldr	x10, [x1, #176]
	str	x10, [x9, #24]
	bl	_silica_rt_report_list_take
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_report_escape_check
	.p2align	2
_silica_rt_report_escape_check:
; X1 = a message being sent, cast or called with. When it is the report being handled, the report
; has moved on to another actor and its dispatch must not free it. Leaf; x9-x10 only, X0/X1 kept.
	adrp	x9, _silica_rt_report_owner@PAGE
	add	x9, x9, _silica_rt_report_owner@PAGEOFF
	ldr	x10, [x9]
	cbz	x10, Lrec_ret
	cmp	x10, x1
	b.ne	Lrec_ret
	mov	x10, #1
	str	x10, [x9, #8]
Lrec_ret:
	ret
	.globl	_silica_rt_report_release
	.p2align	2
_silica_rt_report_release:
; X0 = owned payload, X1 = ACB whose behaviour just returned (its new state is in [X1]). Frees the
; payload unless the behaviour kept it: it sent it on (escaped), it is the new state, or a word of
; what the behaviour allocated in its arena names it or its text (the arena span since
; _silica_rt_report_begin; the block a composite state lives in). Anything uncertain keeps it: a
; missed free leaks one report, a wrong one corrupts. Leaf apart from the tail call to free.
	adrp	x9, _silica_rt_report_owner@PAGE
	add	x9, x9, _silica_rt_report_owner@PAGEOFF
	ldr	x10, [x9]
	cmp	x10, x0
	b.ne	Lrr_keep
	str	xzr, [x9]
	ldr	x10, [x9, #8]
	cbnz	x10, Lrr_keep
	add	x15, x0, #24
	ldr	x10, [x1]
	cmp	x10, x0
	b.eq	Lrr_keep
	cmp	x10, x15
	b.eq	Lrr_keep
	ldr	x11, [x9, #16]
	ldr	x12, [x1, #160]
	ldr	x13, [x9, #24]
	ldr	x14, [x1, #176]
	cmp	x11, x12
	b.eq	Lrr_scan
	cbnz	x11, Lrr_keep
	cbz	x12, Lrr_free
	add	x13, x12, #16
Lrr_scan:
	cmp	x13, x14
	b.hs	Lrr_free
	ldr	x10, [x13], #8
	cmp	x10, x0
	b.eq	Lrr_keep
	cmp	x10, x15
	b.eq	Lrr_keep
	b	Lrr_scan
Lrr_free:
	b	_free
Lrr_keep:
	ret
; Pending reports: handed to the reporter (cast) and not yet taken by its dispatch. A list node is
; 16 B: #0 next, #8 the report string. _silica_rt_report_list: #0 head (oldest first), #8 lock.
	.globl	_silica_rt_report_list_add
	.p2align	2
_silica_rt_report_list_add:
; X0 = report string -> X0 = 1 listed, 0 no memory.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x0, #16
	bl	_malloc
	cbz	x0, Lrla_ret
	mov	x20, x0
	str	xzr, [x20]
	str	x19, [x20, #8]
	adrp	x0, _silica_rt_report_list@PAGE
	add	x0, x0, _silica_rt_report_list@PAGEOFF
	add	x0, x0, #8
	bl	_os_unfair_lock_lock
	adrp	x10, _silica_rt_report_list@PAGE
	add	x10, x10, _silica_rt_report_list@PAGEOFF
Lrla_walk:
	ldr	x11, [x10]
	cbz	x11, Lrla_link
	mov	x10, x11
	b	Lrla_walk
Lrla_link:
	str	x20, [x10]
	adrp	x0, _silica_rt_report_list@PAGE
	add	x0, x0, _silica_rt_report_list@PAGEOFF
	add	x0, x0, #8
	bl	_os_unfair_lock_unlock
	mov	x0, #1
Lrla_ret:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.globl	_silica_rt_report_list_take
	.p2align	2
_silica_rt_report_list_take:
; X0 = report string -> X0 = 1 when it was listed (it is not any more), 0 when it was not (the exit
; drain printed it). X0 is the only argument; the caller's X1.. are not kept.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, xzr
	adrp	x0, _silica_rt_report_list@PAGE
	add	x0, x0, _silica_rt_report_list@PAGEOFF
	add	x0, x0, #8
	bl	_os_unfair_lock_lock
	adrp	x10, _silica_rt_report_list@PAGE
	add	x10, x10, _silica_rt_report_list@PAGEOFF
Lrlt_walk:
	ldr	x11, [x10]
	cbz	x11, Lrlt_unlock
	ldr	x12, [x11, #8]
	cmp	x12, x19
	b.eq	Lrlt_found
	mov	x10, x11
	b	Lrlt_walk
Lrlt_found:
	ldr	x12, [x11]
	str	x12, [x10]
	mov	x20, x11
Lrlt_unlock:
	adrp	x0, _silica_rt_report_list@PAGE
	add	x0, x0, _silica_rt_report_list@PAGEOFF
	add	x0, x0, #8
	bl	_os_unfair_lock_unlock
	mov	x0, xzr
	cbz	x20, Lrlt_ret
	mov	x0, x20
	bl	_free
	mov	x0, #1
Lrlt_ret:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.globl	_silica_rt_report_unhandled
	.p2align	2
_silica_rt_report_unhandled:
; X0 = a report still queued when the reporter ended: written to stderr (unless the exit drain
; already did) and freed.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	bl	_silica_rt_report_list_take
	cbz	x0, Lrun_free
	mov	w0, #2
	ldr	x1, [x19, #8]
	ldr	x2, [x19, #16]
	bl	_write
Lrun_free:
	mov	x0, x19
	bl	_free
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.globl	_silica_rt_report_drain_at_exit
	.p2align	2
_silica_rt_report_drain_at_exit:
; atexit handler. Waits (2 s at most, in 1 ms steps) while a report is pending or being handled and
; the reporter is alive, then writes every report still pending to stderr, oldest first. A report
; the reporter is handling when the wait ends is the reporter's to print.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	mov	x19, #2000
Lrd_wait:
; A death whose report is not listed yet (_silica_rt_report_inflight) is waited for first,
; reporter or not: its supervisor may have ended the process on that exit.
	adrp	x9, _silica_rt_report_inflight@PAGE
	add	x9, x9, _silica_rt_report_inflight@PAGEOFF
	ldar	x10, [x9]
	cbnz	x10, Lrd_sleep
	adrp	x9, _silica_rt_report_list@PAGE
	add	x9, x9, _silica_rt_report_list@PAGEOFF
	ldr	x10, [x9]
	adrp	x11, _silica_rt_report_owner@PAGE
	add	x11, x11, _silica_rt_report_owner@PAGEOFF
	ldr	x12, [x11]
	orr	x10, x10, x12
	cbz	x10, Lrd_print
	adrp	x11, _silica_rt_root_failure_reporter@PAGE
	add	x11, x11, _silica_rt_root_failure_reporter@PAGEOFF
	ldr	x12, [x11]
	cbz	x12, Lrd_print
Lrd_sleep:
	cbz	x19, Lrd_print
	sub	x19, x19, #1
	mov	w0, #1000
	bl	_usleep
	b	Lrd_wait
Lrd_print:
	adrp	x0, _silica_rt_report_list@PAGE
	add	x0, x0, _silica_rt_report_list@PAGEOFF
	add	x0, x0, #8
	bl	_os_unfair_lock_lock
	adrp	x20, _silica_rt_report_list@PAGE
	add	x20, x20, _silica_rt_report_list@PAGEOFF
	ldr	x21, [x20]
	str	xzr, [x20]
Lrd_loop:
	cbz	x21, Lrd_unlock
	ldr	x22, [x21, #8]
	mov	w0, #2
	ldr	x1, [x22, #8]
	ldr	x2, [x22, #16]
	bl	_write
	mov	x0, x21
	ldr	x21, [x21]
	bl	_free
	b	Lrd_loop
Lrd_unlock:
	add	x0, x20, #8
	bl	_os_unfair_lock_unlock
; Held to the end of the process: a root note being written finishes first, later ones wait.
	adrp	x0, _silica_rt_root_note_lock@PAGE
	add	x0, x0, _silica_rt_root_note_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.section	__DATA,__bss
	.p2align	3
.globl	_silica_rt_report_list
.comm	_silica_rt_report_list,16,3
; Deaths between _silica_rt_actor_deliver_exit and their listed or written failure report.
.globl	_silica_rt_report_inflight
.comm	_silica_rt_report_inflight,8,3
	.section	__TEXT,__cstring,cstring_literals
	.p2align	2
Ldup_oom_msg:
	.asciz	\"[silica] unwind report: malloc failed\\n\"
	.p2align	2
L_phase_f_unwind_fmt:
	.asciz	\"\\n=== Silica Actor Failure ===\\nactor_id:        %llu\\nagent_type_atom: %lld\\nreason_tag:      %lld\\nsupervisor_acb:  %p\\n\"
	.p2align	2
L_phase_f_cs_hdr:
	.asciz	\"call_stack:\\n\"
	.p2align	2
L_phase_f_cs_frame0_fmt:
	.asciz	\"  #0  %s\\n\"
	.p2align	2
L_phase_f_cs_frame0_unk:
	.asciz	\"  #0  <unknown behavior>\\n\"
	.p2align	2
L_phase_f_cs_frame1:
	.asciz	\"  #1  _actor_thread_main\\n\"
	.p2align	2
L_phase_f_end:
	.asciz	\"=== End Silica Actor Failure ===\\n\"
	.p2align	2
L_rdump_hdr_fmt:
	.asciz	\"\\n=== Region Dump ===\\nbase: 0x%016llx  dump_bytes: %llu  limit: %llu\\n\"
	.p2align	2
L_rdump_row_fmt:
	.asciz	\"%04llx: \"
	.p2align	2
L_rdump_foot:
	.asciz	\"=== End Region Dump ===\\n\"
	.p2align	2
L_silica_hex_nibbles:
	.asciz	\"0123456789abcdef\"
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_failure_reporter_register
	.p2align	2
_silica_rt_failure_reporter_register:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	Lfr_ra_a:
	adrp	x8, _silica_rt_root_failure_reporter@PAGE
Lfr_ra_b:
	add	x8, x8, _silica_rt_root_failure_reporter@PAGEOFF
	ldr	x9, [x8]
	cbnz	x9, Lfr_reg_done
; X0 = the reporter's reference. The marker word says one is registered; delivery resolves the
; identity (§15.1.4), so an ended reporter is never touched.
	adrp	x9, _silica_rt_root_failure_reporter_id@PAGE
	str	x0, [x9, _silica_rt_root_failure_reporter_id@PAGEOFF]
	mov	x9, #1
	str	x9, [x8]
; Reports already handed to the reporter are printed before the process ends (§15.4.13.4: one
; handle_report per actor death): exit runs _silica_rt_report_drain_at_exit, registered at
; runtime start (_silica_rt_exit_request_init).
Lfr_reg_done:
	mov	x0, #0
	ldp	x29, x30, [sp], #16
	ret
	.loh AdrpAdd	Lfr_ra_a, Lfr_ra_b
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_failure_reporter_set_dump_limit
	.p2align	2
_silica_rt_failure_reporter_set_dump_limit:
	.cfi_startproc
; X0=dump_limit (int64). Called by register_failure_reporter emission to cache region_dump_limit() result.
Lfrdl_a:
	adrp	x8, _silica_rt_region_dump_limit@PAGE
Lfrdl_b:
	add	x8, x8, _silica_rt_region_dump_limit@PAGEOFF
	str	x0, [x8]
	mov	x0, #0
	ret
	.loh AdrpAdd	Lfrdl_a, Lfrdl_b
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_unwind_behavior_display_name
	.p2align	2
_silica_rt_unwind_behavior_display_name:
; X0 = dladdr dli_sname (may include Mach-O leading '_'). Returns X0 = full linker symbol for frame #0 (module_fn), without leading '_'.
; Uses only caller-saved x8–x15 so deliver_unwind_report callee-saved registers stay intact.
	.cfi_startproc
	cbz	x0, Ludn_done
	ldrb	w8, [x0]
	cmp	w8, #95
	b.ne	Ludn_done
	add	x0, x0, #1
Ludn_done:
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_deliver_unwind_report
	.p2align	2
_silica_rt_actor_deliver_unwind_report:
	.cfi_startproc
; X0=dying actor_ptr. Formats header + call stack (via dladdr on ACB[+8] behavior fn ptr).
; Delivers to root FailureReporter via cast (transport string), or falls back to stderr.
; Frame: 128 B -- x27=total_buf_size, x28 reserved for future dumps-list construction.
	stp	x28, x27, [sp, #-128]!
	stp	x26, x25, [sp, #16]
	stp	x24, x23, [sp, #32]
	stp	x22, x21, [sp, #48]
	stp	x20, x19, [sp, #64]
	stp	x29, x30, [sp, #80]
	add	x29, sp, #80
	.cfi_def_cfa w29, 48
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	mov	x21, x0
	mov	x22, xzr
	mov	x27, #0x800
	mov	x0, #0x800
	bl	_malloc
	cbz	x0, Ldup_malloc_fail
	mov	x19, x0
	ldr	x23, [x21, #200]
	ldr	x24, [x21, #232]
	ldr	x25, [x21, #192]
	mov	x0, x19
	mov	x1, x27
	Ldup_fmt_a:
	adrp	x2, L_phase_f_unwind_fmt@PAGE
Ldup_fmt_b:
	add	x2, x2, L_phase_f_unwind_fmt@PAGEOFF
	ldr	x3, [x21, #408]
	mov	x4, x23
	mov	x5, x24
	mov	x6, x25
; arm64 Darwin: variadic callers must spill register-passed unnamed args onto the stack
; so libc snprintf/vfprintf reads coherent values from the va_list backing.
	sub	sp, sp, #32
	stp	x3, x4, [sp]
	stp	x5, x6, [sp, #16]
	bl	_snprintf
	add	sp, sp, #32
	mov	w26, w0
	cmp	w26, #0
	csel	w26, wzr, w26, lt
; --- Call stack trace ---
; Step 1: behavior fn ptr lives at ACB[+8] (set by spawn, updated by behavior return).
; Step 2: resolve it with dladdr() to produce a human-readable frame.
; Write L_phase_f_cs_hdr char by char.
Lcs_hdr_a:
	adrp	x8, L_phase_f_cs_hdr@PAGE
Lcs_hdr_b:
	add	x8, x8, L_phase_f_cs_hdr@PAGEOFF
Lcs_hdr_loop:
	ldrb	w9, [x8], #1
	cbz	w9, Lcs_dladdr
	sub	x10, x27, x26
	cbz	x10, Lcs_nul_term
	add	x10, x19, x26
	strb	w9, [x10]
	add	x26, x26, #1
	b	Lcs_hdr_loop
Lcs_dladdr:
; dladdr(behavior_fn, &Dl_info) -- Dl_info is 32 B on arm64; allocate 48 B for alignment.
	sub	sp, sp, #48
	ldr	x0, [x21, #8]
	cbz	x0, Lcs_dladdr_null_fn
	mov	x1, sp
	bl	_dladdr
	cbz	w0, Lcs_dladdr_failed
	ldr	x9, [sp, #16]
	add	sp, sp, #48
	cbz	x9, Lcs_frame0_unk
; x9 = dli_sname; skip Mach-O '_' then format frame-0 line via snprintf (full module_fn name).
	mov	x0, x9
	bl	_silica_rt_unwind_behavior_display_name
	mov	x3, x0
	sub	x1, x27, x26
	cmp	x1, #8
	b.lt	Lcs_frame1
	add	x0, x19, x26
Lcs_f0_fmt_a:
	adrp	x2, L_phase_f_cs_frame0_fmt@PAGE
Lcs_f0_fmt_b:
	add	x2, x2, L_phase_f_cs_frame0_fmt@PAGEOFF
	sub	sp, sp, #16
	str	x3, [sp]
	bl	_snprintf
	add	sp, sp, #16
	cmp	w0, #0
	b.le	Lcs_frame1
	add	x26, x26, x0
	b	Lcs_frame1
Lcs_dladdr_null_fn:
	add	sp, sp, #48
	b	Lcs_frame0_unk
Lcs_dladdr_failed:
	add	sp, sp, #48
Lcs_frame0_unk:
; Write L_phase_f_cs_frame0_unk char by char.
Lcs_unk_a:
	adrp	x8, L_phase_f_cs_frame0_unk@PAGE
Lcs_unk_b:
	add	x8, x8, L_phase_f_cs_frame0_unk@PAGEOFF
Lcs_unk_loop:
	ldrb	w9, [x8], #1
	cbz	w9, Lcs_frame1
	sub	x10, x27, x26
	cbz	x10, Lcs_nul_term
	add	x10, x19, x26
	strb	w9, [x10]
	add	x26, x26, #1
	b	Lcs_unk_loop
Lcs_frame1:
; Write L_phase_f_cs_frame1 char by char.
Lcs_f1_a:
	adrp	x8, L_phase_f_cs_frame1@PAGE
Lcs_f1_b:
	add	x8, x8, L_phase_f_cs_frame1@PAGEOFF
Lcs_f1_loop:
	ldrb	w9, [x8], #1
	cbz	w9, Lcs_end_banner
	sub	x10, x27, x26
	cbz	x10, Lcs_nul_term
	add	x10, x19, x26
	strb	w9, [x10]
	add	x26, x26, #1
	b	Lcs_f1_loop
Lcs_fault_site:
	add	x0, x19, x26
	sub	x1, x27, x26
	bl	_silica_rt_fault_site_snprint
	cmp	x0, #0
	b.le	Lcs_end_banner
	add	x26, x26, x0
Lcs_end_banner:
; Write L_phase_f_end banner char by char.
Lcs_end_a:
	adrp	x8, L_phase_f_end@PAGE
Lcs_end_b:
	add	x8, x8, L_phase_f_end@PAGEOFF
Lcs_end_loop:
	ldrb	w9, [x8], #1
	cbz	w9, Lcs_nul_term
	sub	x10, x27, x26
	cbz	x10, Lcs_nul_term
	add	x10, x19, x26
	strb	w9, [x10]
	add	x26, x26, #1
	b	Lcs_end_loop
Lcs_nul_term:
; NUL-terminate (x26 = content byte count, NUL not included in count).
	sub	x10, x27, x26
	cbz	x10, Ldup_no_dump
	add	x10, x19, x26
	strb	wzr, [x10]
Ldup_no_dump:
	Ldup_glob_a:
	adrp	x8, _silica_rt_root_failure_reporter@PAGE
Ldup_glob_b:
	add	x8, x8, _silica_rt_root_failure_reporter@PAGEOFF
	ldr	x22, [x8]
	cbz	x22, Ldup_stderr_path
	adrp	x9, _silica_rt_root_failure_reporter_id@PAGE
	ldr	x10, [x9, _silica_rt_root_failure_reporter_id@PAGEOFF]
	ldr	x11, [x21, #408]
	mov	x22, xzr
	cmp	x10, x11
	b.ne	Ldup_fr_try
	str	xzr, [x8]
	b	Ldup_stderr_path
Ldup_fr_try:
; The reporter is resolved and held for the delivery (released at Ldup_ep_ret).
	mov	x0, x10
	bl	_silica_rt_ref_hold
	mov	x22, x0
	cbz	x22, Ldup_stderr_path
	ldr	w9, [x22, #152]
	cbz	w9, Ldup_stderr_path
; The reporter's handle_report takes `report: string`: one block holds the string header
; {tag -1, bytes, length} (the layout L_ps_helper and the string prims read) and the text after it,
; as the board's silica_rt_string_from_bytes builds one. The message owns the block: the reporter's
; dispatch frees it once handle_report has returned (_silica_rt_report_release), and the text
; buffer goes back here.
	sxtw	x20, w26
	add	x0, x20, #25
	bl	_malloc
	cbz	x0, Ldup_stderr_path
	mov	x23, x0
	mov	x9, #-1
	str	x9, [x23]
	add	x0, x23, #24
	str	x0, [x23, #8]
	str	x20, [x23, #16]
	mov	x1, x19
	mov	x2, x20
	bl	_memcpy
	add	x9, x23, #24
	strb	wzr, [x9, x20]
; Listed until handle_report takes it, so process exit can still print it (_silica_rt_report_list_add).
	mov	x0, x23
	bl	_silica_rt_report_list_add
	cbz	x0, Ldup_cast_failed
	mov	x0, x22
	mov	x1, x23
	mov	w2, #1
	bl	_silica_rt_actor_cast_flagged
; F6: cast enqueue failure (OOM for 152 B node, null target, etc.) -- same stderr fallback as F5 unregistered root.
; 2: the reporter's behaviour is call-only (§16.2.6.4): nothing was enqueued, so the report falls back
; to stderr as for any failed enqueue (§15.4.13.4).
	cmp	w0, #1
	b.eq	Ldup_std_free_only
	mov	x0, x23
	bl	_silica_rt_report_list_take
Ldup_cast_failed:
	mov	x0, x23
	bl	_free
	b	Ldup_stderr_path
Ldup_stderr_path:
	cmp	w26, #1
	b.lt	Ldup_std_free_only
	mov	w0, #2
	mov	x1, x19
	sxtw	x2, w26
	bl	_write
Ldup_std_free_only:
	mov	x0, x19
	bl	_free
	b	Ldup_ep_ret
Ldup_malloc_fail:
; F5: always surface *something* on stderr when unwind text cannot be allocated (independent of ingress).
	mov	w0, #2
	Ldup_oom_a:
	adrp	x1, Ldup_oom_msg@PAGE
Ldup_oom_b:
	add	x1, x1, Ldup_oom_msg@PAGEOFF
	mov	w2, #38
	bl	_write
	b	Ldup_ep_ret
Ldup_ep_ret:
	mov	x0, x22
	bl	_silica_rt_acb_release
; The report is listed or written: this death is no longer in flight (counted by
; _silica_rt_actor_deliver_exit, or by _silica_rt_root_report_and_note for a root).
	adrp	x9, _silica_rt_report_inflight@PAGE
	add	x9, x9, _silica_rt_report_inflight@PAGEOFF
Ldup_inflight_dec:
	ldaxr	x10, [x9]
	sub	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Ldup_inflight_dec
	mov	x0, #0
	ldp	x29, x30, [sp, #80]
	ldp	x20, x19, [sp, #64]
	ldp	x22, x21, [sp, #48]
	ldp	x24, x23, [sp, #32]
	ldp	x26, x25, [sp, #16]
	ldp	x28, x27, [sp], #128
	ret
	.loh AdrpAdd	Ldup_fmt_a, Ldup_fmt_b
	.loh AdrpAdd	Lcs_hdr_a, Lcs_hdr_b
	.loh AdrpAdd	Lcs_f0_fmt_a, Lcs_f0_fmt_b
	.loh AdrpAdd	Lcs_unk_a, Lcs_unk_b
	.loh AdrpAdd	Lcs_f1_a, Lcs_f1_b
	.loh AdrpAdd	Lcs_end_a, Lcs_end_b
	.loh AdrpAdd	Ldup_glob_a, Ldup_glob_b
	.loh AdrpAdd	Ldup_oom_a, Ldup_oom_b
	.cfi_endproc
                                        ; -- End function
"
}

fn actor_rt_pid_registry_chunk(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    insert_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":insert"));
    lookup_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":lookup"));
    delete_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":delete"));
    ok_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":ok"));
    found_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":found"));
    not_found_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":not_found"));
    unknown_op_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":unknown_op"));
    name_taken_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":name_taken"));
    already_registered_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":already_registered"));
    actor_not_found_idx: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":actor_not_found"));
    slots: string <- atom_table@int64_to_decimal_string(atom_table@atom_count(table));
    reply_tag: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":reply"));
    no_reply_tag: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":no_reply"));
    // call_supervisor's error reply for an operation a row child aimed at itself (the supervisor
    // operations, prims_actors_child_table_asm.silica): the tag :error as this build spells it (-1
    // when the program never spells it: no arm of its can name that tag) and the reason atom,
    // :language_error, a fixed atom of every build (atom_table seed_actor_runtime_atoms). Published
    // words rather than SIR atom constants so that no program's atom table gains an atom.
    sup_error_tag: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":error"));
    sup_self_error_atom: string <- atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, ":language_error"));
    p0: string <- "
; The registry slot count of this image: one slot per atom of the build (atoms/atom_table.silica
; build_runtime_atom_table; actor_memory_budget_plan.md item J). Atoms are interned when the program
; is built (spec §4.1.7), so the tables never overflow. The keyed forms treat an int64 below this
; count as an atom and at or above it as an actor_ref: control blocks are calloc'd, and no hosted
; heap hands out addresses that low (macOS: above 0x1_0000_0000; Linux non-PIE: above the image).
	.section	__DATA,__const
	.p2align	3
	.globl	_silica_registry_slots
_silica_registry_slots:
	.quad	";
    // The behaviour result tags the dispatch loop reads (actor_rt_asm_chunk_2): this build's atoms.
    p0b: string <- concat(concat(concat(concat(concat(p0, slots), "
	.globl	_silica_rt_reply_tag
_silica_rt_reply_tag:
	.quad	"), reply_tag), "
	.globl	_silica_rt_no_reply_tag
_silica_rt_no_reply_tag:
	.quad	"), no_reply_tag);
    p0b2: string <- concat(concat(concat(concat(p0b, "
	.globl	_silica_rt_sup_error_tag
_silica_rt_sup_error_tag:
	.quad	"), sup_error_tag), "
	.globl	_silica_rt_sup_self_error_atom
_silica_rt_sup_self_error_atom:
	.quad	"), sup_self_error_atom);
    p0c: string <- concat(p0b2, "
	.section	__TEXT,__text,regular,pure_instructions
; The reply fields of call_supervisor's :terminate_child / :remove_child / :restart_child
; (terms_actor_lowering): the operation answers -2 when the asking actor is a row child of the
; supervisor and the operation would stop its own row (prims_actors_child_table_asm.silica,
; Lsterm_self / Lsrestart_self), and the reply is then the error shape (tag :error, status
; :error, error :language_error, child 0) instead of the operation's own.
; _silica_rt_sup_op_tag(X0 = the operation's answer, X1 = the tag or status of the operation's
; own reply) -> X0 = X1, or this build's :error for the -2 answer. Leaf.
	.globl	_silica_rt_sup_op_tag
	.p2align	2
_silica_rt_sup_op_tag:
	cmn	x0, #2
	b.ne	Lsot_own
	adrp	x8, _silica_rt_sup_error_tag@PAGE
	add	x8, x8, _silica_rt_sup_error_tag@PAGEOFF
	ldr	x1, [x8]
Lsot_own:
	mov	x0, x1
	ret
; _silica_rt_sup_op_error(X0 = the answer, X1 = the error atom of the operation's own reply,
; :ok) -> X0 = X1, or :language_error for the -2 answer. Leaf.
	.globl	_silica_rt_sup_op_error
	.p2align	2
_silica_rt_sup_op_error:
	cmn	x0, #2
	b.ne	Lsoe_own
	adrp	x8, _silica_rt_sup_self_error_atom@PAGE
	add	x8, x8, _silica_rt_sup_self_error_atom@PAGEOFF
	ldr	x1, [x8]
Lsoe_own:
	mov	x0, x1
	ret
; _silica_rt_sup_op_child(X0 = :restart_child's answer: the started child's identity, -1 for no
; child) -> X0 = the answer, or 0 (the error reply's child) for the -2 answer. Leaf.
	.globl	_silica_rt_sup_op_child
	.p2align	2
_silica_rt_sup_op_child:
	cmn	x0, #2
	b.ne	Lsoc_own
	mov	x0, xzr
Lsoc_own:
	ret
; PID registry primitive actor (spec §20.3.1).
; State layout: one calloc block of _silica_registry_slots * 16 B: occ[slots] (int64, 1 = held) at +0,
; actor_ref words[slots] at +slots*8. The same block is read directly by the keyed forms and by
; _silica_rt_register_actor_named (the store writes the ref before the occ word; a removal clears
; the occ word first).
; Message record layout follows record emission: shape word@0, op@8, name@16, pid@24.
; Behavior return layout follows actor runtime convention: tag@0, reply@8, next_state@16.
; :insert replies :ok (stored, or the actor already holds this very name), :name_taken (a live actor
; or supervisor holds the name), :already_registered (the actor holds another name in this table) or
; :actor_not_found (the actor has ended); the reply is a (status atom, actor_ref) pair.
	.globl	_silica_rt_pid_registry_beh
	.p2align	2
_silica_rt_pid_registry_beh:
	stp	x29, x30, [sp, #-64]!
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x29, sp
	mov	x19, x0
	mov	x20, x1
	ldr	x21, [x19, #8]       ; op atom index
	ldr	x22, [x19, #16]   ; name atom index
	ldr	x23, [x19, #24]  ; pid actor_ref
	mov	x0, #1
	mov	x1, #24
	bl	_calloc
	mov	x24, x0
	cbz	x24, L_pidreg_ret_null
	mov	x0, #1
	mov	x1, #16
	bl	_calloc
	cbz	x0, L_pidreg_ret_null
	str	x0, [x24, #8]
	str	x20, [x24, #16]
	adrp	x13, _silica_registry_slots@PAGE
	ldr	x13, [x13, _silica_registry_slots@PAGEOFF]
	cmp	x21, #");
    p1: string <- concat(p0c, insert_idx);
    p2: string <- concat(p1, "
	b.eq	L_pidreg_insert
	cmp	x21, #");
    p3: string <- concat(p2, lookup_idx);
    p4: string <- concat(p3, "
	b.eq	L_pidreg_lookup
	cmp	x21, #");
    p5: string <- concat(p4, delete_idx);
    p6: string <- concat(p5, "
	b.eq	L_pidreg_delete
	mov	x8, #");
    p7: string <- concat(p6, unknown_op_idx);
    p8: string <- concat(p7, "
	str	x8, [x0]
	str	x23, [x0, #8]
	b	L_pidreg_done
L_pidreg_insert:
	cmp	x22, #0
	b.lt	L_pidreg_name_taken
	cmp	x22, x13
	b.ge	L_pidreg_name_taken
; The pid is an identity (§15.1.4): liveness is the identity table's, and so is the holder's.
	mov	x0, x23
	bl	_silica_rt_ref_alive
	mov	x9, x0
	ldr	x0, [x24, #8]
	adrp	x13, _silica_registry_slots@PAGE
	ldr	x13, [x13, _silica_registry_slots@PAGEOFF]
	cbz	x9, L_pidreg_actor_not_found
	add	x8, x20, x22, lsl #3
	ldar	x8, [x8]
	cmp	x8, #1
	b.ne	L_pidreg_insert_free
	add	x9, x20, x13, lsl #3
	ldr	x9, [x9, x22, lsl #3]
	cmp	x9, x23
	b.eq	L_pidreg_insert_ok
	mov	x0, x9
	bl	_silica_rt_ref_alive
	mov	x9, x0
	ldr	x0, [x24, #8]
	cbnz	x9, L_pidreg_name_taken
L_pidreg_insert_free:
	mov	x0, x20
	mov	x1, x23
	bl	_silica_rt_registry_table_holds
	cbnz	x0, L_pidreg_already_registered
	adrp	x13, _silica_registry_slots@PAGE
	ldr	x13, [x13, _silica_registry_slots@PAGEOFF]
	add	x9, x20, x13, lsl #3
	str	x23, [x9, x22, lsl #3]
	mov	x8, #1
	add	x9, x20, x22, lsl #3
	stlr	x8, [x9]
L_pidreg_insert_ok:
	ldr	x0, [x24, #8]
	mov	x8, #");
    p9: string <- concat(p8, ok_idx);
    p10: string <- concat(p9, "
	str	x8, [x0]
	str	x23, [x0, #8]
	b	L_pidreg_done
L_pidreg_name_taken:
	mov	x8, #");
    p10b: string <- concat(p10, name_taken_idx);
    p10c: string <- concat(p10b, "
	str	x8, [x0]
	str	x23, [x0, #8]
	b	L_pidreg_done
L_pidreg_already_registered:
	ldr	x0, [x24, #8]
	mov	x8, #");
    p10d: string <- concat(p10c, already_registered_idx);
    p10e: string <- concat(p10d, "
	str	x8, [x0]
	str	x23, [x0, #8]
	b	L_pidreg_done
L_pidreg_actor_not_found:
	mov	x8, #");
    p10f: string <- concat(p10e, actor_not_found_idx);
    p10g: string <- concat(p10f, "
	str	x8, [x0]
	str	xzr, [x0, #8]
	b	L_pidreg_done
L_pidreg_lookup:
	cmp	x22, #0
	b.lt	L_pidreg_not_found
	cmp	x22, x13
	b.ge	L_pidreg_not_found
	add	x8, x20, x22, lsl #3
	ldar	x8, [x8]
	cmp	x8, #1
	b.ne	L_pidreg_not_found
	mov	x8, #");
    p11: string <- concat(p10g, found_idx);
    p12: string <- concat(p11, "
	str	x8, [x0]
	add	x9, x20, x13, lsl #3
	ldr	x10, [x9, x22, lsl #3]
	str	x10, [x0, #8]
	b	L_pidreg_done
L_pidreg_not_found:
	mov	x8, #");
    p13: string <- concat(p12, not_found_idx);
    p14: string <- concat(p13, "
	str	x8, [x0]
	str	xzr, [x0, #8]
	b	L_pidreg_done
L_pidreg_delete:
	cmp	x22, #0
	b.lt	L_pidreg_delete_ok
	cmp	x22, x13
	b.ge	L_pidreg_delete_ok
	str	xzr, [x20, x22, lsl #3]
	add	x9, x20, x13, lsl #3
	str	xzr, [x9, x22, lsl #3]
L_pidreg_delete_ok:
	mov	x8, #");
    p15: string <- concat(p14, ok_idx);
    concat(p15, "
	str	x8, [x0]
	str	x23, [x0, #8]
L_pidreg_done:
	mov	x0, x24
L_pidreg_ret_null:
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
; _silica_rt_registry_table_holds(X0 = registry state block, X1 = actor_ref) -> X0 = 1 when the
; table holds a name for the actor, else 0 (an actor holds at most one name per registry, §20.3.1).
	.globl	_silica_rt_registry_table_holds
	.p2align	2
_silica_rt_registry_table_holds:
	adrp	x9, _silica_registry_slots@PAGE
	ldr	x9, [x9, _silica_registry_slots@PAGEOFF]
	add	x10, x0, x9, lsl #3
	mov	x11, #0
Lrth_loop:
	cmp	x11, x9
	b.ge	Lrth_no
	add	x12, x0, x11, lsl #3
	ldar	x12, [x12]
	cmp	x12, #1
	b.ne	Lrth_next
	ldr	x12, [x10, x11, lsl #3]
	cmp	x12, x1
	b.eq	Lrth_yes
Lrth_next:
	add	x11, x11, #1
	b	Lrth_loop
Lrth_yes:
	mov	x0, #1
	ret
Lrth_no:
	mov	x0, #0
	ret
; _silica_rt_registry_table_forget(X0 = registry state block, X1 = actor_ref): clears every slot the
; actor holds in that table, occ word first so a reader never sees a held slot with a stale ref.
	.globl	_silica_rt_registry_table_forget
	.p2align	2
_silica_rt_registry_table_forget:
	adrp	x9, _silica_registry_slots@PAGE
	ldr	x9, [x9, _silica_registry_slots@PAGEOFF]
	add	x10, x0, x9, lsl #3
	mov	x11, #0
Lrtf_loop:
	cmp	x11, x9
	b.ge	Lrtf_done
	add	x12, x0, x11, lsl #3
	ldar	x12, [x12]
	cmp	x12, #1
	b.ne	Lrtf_next
	ldr	x12, [x10, x11, lsl #3]
	cmp	x12, x1
	b.ne	Lrtf_next
	str	xzr, [x0, x11, lsl #3]
	str	xzr, [x10, x11, lsl #3]
Lrtf_next:
	add	x11, x11, #1
	b	Lrtf_loop
Lrtf_done:
	ret
; _silica_rt_registry_forget_actor(X0 = the ending actor's ACB): removes the actor's names from the three
; registries. Runs on every exit path before the exit reaches the supervisor (§20.3.1, removal when
; an actor ends), so a restarted child finds its own name free and a recycled control block address
; never answers to an old name.
	.globl	_silica_rt_registry_forget_actor
	.p2align	2
_silica_rt_registry_forget_actor:
	stp	x29, x30, [sp, #-32]!
	stp	x19, x20, [sp, #16]
	mov	x29, sp
	ldr	x19, [x0, #408]
	adrp	x8, _silica_pid_registry_ref@PAGE
	ldr	x8, [x8, _silica_pid_registry_ref@PAGEOFF]
	cbz	x8, Lrfa_dangerous
	ldr	x0, [x8]
	cbz	x0, Lrfa_dangerous
	mov	x1, x19
	bl	_silica_rt_registry_table_forget
Lrfa_dangerous:
	adrp	x8, _silica_dangerous_pid_registry_ref@PAGE
	ldr	x8, [x8, _silica_dangerous_pid_registry_ref@PAGEOFF]
	cbz	x8, Lrfa_device
	ldr	x0, [x8]
	cbz	x0, Lrfa_device
	mov	x1, x19
	bl	_silica_rt_registry_table_forget
Lrfa_device:
	adrp	x8, _silica_device_pid_registry_ref@PAGE
	ldr	x8, [x8, _silica_device_pid_registry_ref@PAGEOFF]
	cbz	x8, Lrfa_done
	ldr	x0, [x8]
	cbz	x0, Lrfa_done
	mov	x1, x19
	bl	_silica_rt_registry_table_forget
Lrfa_done:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
; _silica_rt_registry_held_in(X0 = registry actor_ref or 0, X1 = atom) -> X0 = 1 when a live actor
; or supervisor holds the name in that registry, else 0.
	.globl	_silica_rt_registry_held_in
	.p2align	2
_silica_rt_registry_held_in:
	cbz	x0, Lrhi_no
	ldr	x9, [x0]
	cbz	x9, Lrhi_no
	cmp	x1, #0
	b.lt	Lrhi_no
	adrp	x10, _silica_registry_slots@PAGE
	ldr	x10, [x10, _silica_registry_slots@PAGEOFF]
	cmp	x1, x10
	b.ge	Lrhi_no
	add	x11, x9, x1, lsl #3
	ldar	x11, [x11]
	cmp	x11, #1
	b.ne	Lrhi_no
	add	x12, x9, x10, lsl #3
	ldr	x0, [x12, x1, lsl #3]
	b	_silica_rt_ref_alive
Lrhi_no:
	mov	x0, #0
	ret
; _silica_rt_registry_name_held(X0 = atom) -> X0 = 1 when the ordinary registry holds the name for
; a live actor or supervisor. The supervisor child paths probe a child id with it before spawning.
	.globl	_silica_rt_registry_name_held
	.p2align	2
_silica_rt_registry_name_held:
	mov	x1, x0
	adrp	x0, _silica_pid_registry_ref@PAGE
	ldr	x0, [x0, _silica_pid_registry_ref@PAGEOFF]
	b	_silica_rt_registry_held_in
; _silica_rt_registry_require_free{,_dangerous,_device}(X0 = atom): the pre-spawn check of
; spawn_registered, spawn_dangerous_registered, spawn_device_registered and
; spawn_registered_supervisor (§20.3.1): when a live actor holds the name no actor is spawned and the
; caller fails with :language_error (_silica_rt_registry_name_taken, which does not return).
	.globl	_silica_rt_registry_require_free
	.p2align	2
_silica_rt_registry_require_free:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x1, x0
	adrp	x0, _silica_pid_registry_ref@PAGE
	ldr	x0, [x0, _silica_pid_registry_ref@PAGEOFF]
	bl	_silica_rt_registry_held_in
	cbnz	x0, Lrrf_taken
	mov	x0, #0
	ldp	x29, x30, [sp], #16
	ret
Lrrf_taken:
	ldp	x29, x30, [sp], #16
	b	_silica_rt_registry_name_taken
	.globl	_silica_rt_registry_require_free_dangerous
	.p2align	2
_silica_rt_registry_require_free_dangerous:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x1, x0
	adrp	x0, _silica_dangerous_pid_registry_ref@PAGE
	ldr	x0, [x0, _silica_dangerous_pid_registry_ref@PAGEOFF]
	bl	_silica_rt_registry_held_in
	cbnz	x0, Lrrfd_taken
	mov	x0, #0
	ldp	x29, x30, [sp], #16
	ret
Lrrfd_taken:
	ldp	x29, x30, [sp], #16
	b	_silica_rt_registry_name_taken
	.globl	_silica_rt_registry_require_free_device
	.p2align	2
_silica_rt_registry_require_free_device:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x1, x0
	adrp	x0, _silica_device_pid_registry_ref@PAGE
	ldr	x0, [x0, _silica_device_pid_registry_ref@PAGEOFF]
	bl	_silica_rt_registry_held_in
	cbnz	x0, Lrrfv_taken
	mov	x0, #0
	ldp	x29, x30, [sp], #16
	ret
Lrrfv_taken:
	ldp	x29, x30, [sp], #16
	b	_silica_rt_registry_name_taken
")
}

fn actor_rt_asm_phase_i_chunk(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    concat("	.section	__DATA,__bss
	.p2align	3
.globl	_silica_rt_wait_root_acb
.comm	_silica_rt_wait_root_acb,8,3
; §15.1.2.5: the exit request. _flag is 0 until the first cast_exit wins its compare-and-swap (1 after);
; _request holds the winner's int64 value (any value, so the flag is separate), written with release ordering
; before the one byte goes down the private pipe (read end @0, write end @4) that wakes main's wait_for_exit.
.globl	_silica_rt_exit_flag
.comm	_silica_rt_exit_flag,8,3
.globl	_silica_rt_exit_request
.comm	_silica_rt_exit_request,8,3
.globl	_silica_rt_exit_pipe
.comm	_silica_rt_exit_pipe,8,3
; Global slot for the PID registry actor_ref (written by _silica_rt_register_actor / read by _silica_rt_get_registry_actor).
.globl	_silica_pid_registry_ref
.comm	_silica_pid_registry_ref,8,3
; Global slot for the dangerous PID registry actor_ref (written by _silica_rt_register_dangerous_actor_named).
.globl	_silica_dangerous_pid_registry_ref
.comm	_silica_dangerous_pid_registry_ref,8,3
; Global slot for the device PID registry actor_ref (written by _silica_rt_register_device_actor_named).
.globl	_silica_device_pid_registry_ref
.comm	_silica_device_pid_registry_ref,8,3
	.section	__TEXT,__text,regular,pure_instructions
",
concat(actor_rt_pid_registry_chunk(table),
"
; Spawn path for the global PID registry primitive actor.
	.globl	_silica_rt_pid_registry_init_spawn
	.p2align	2
_silica_rt_pid_registry_init_spawn:
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x0, #1
	adrp	x1, _silica_registry_slots@PAGE
	ldr	x1, [x1, _silica_registry_slots@PAGEOFF]
	lsl	x1, x1, #4
	bl	_calloc
	mov	x19, x0
	mov	x9, x19
	adrp	x10, _silica_rt_pid_registry_beh@PAGE
	add	x10, x10, _silica_rt_pid_registry_beh@PAGEOFF
	mov	x3, xzr
	mov	x0, x9
	mov	x1, x10
	mov	w2, wzr
	adrp	x8, _silica_rt_runtime_spawner@PAGE
	add	x8, x8, _silica_rt_runtime_spawner@PAGEOFF
	adrp	x9, _silica_rt_spawn_rec_override@PAGE
	str	x8, [x9, _silica_rt_spawn_rec_override@PAGEOFF]
	bl	_silica_rt_actor_spawn
	adrp	x9, _silica_rt_spawn_rec_override@PAGE
	str	xzr, [x9, _silica_rt_spawn_rec_override@PAGEOFF]
; The registries never end, so their ACBs are kept (not held) for the runtime's own use.
	bl	_silica_rt_ref_peek
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
; _silica_pid_registry_init: called once at program start from emitter-injected main prologue.
; Stores the spawned registry actor_ref in _silica_pid_registry_ref.
	.globl	_silica_pid_registry_init
	.p2align	2
_silica_pid_registry_init:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_exit_request_init
	bl	_silica_rt_pid_registry_init_spawn
	adrp	x1, _silica_pid_registry_ref@PAGE
	str	x0, [x1, _silica_pid_registry_ref@PAGEOFF]
	mov	x0, #0
	ldp	x29, x30, [sp], #16
	ret
; Spawn path for the global dangerous PID registry primitive actor.
	.globl	_silica_rt_dangerous_pid_registry_init_spawn
	.p2align	2
_silica_rt_dangerous_pid_registry_init_spawn:
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x0, #1
	adrp	x1, _silica_registry_slots@PAGE
	ldr	x1, [x1, _silica_registry_slots@PAGEOFF]
	lsl	x1, x1, #4
	bl	_calloc
	mov	x19, x0
	mov	x9, x19
	adrp	x10, _silica_rt_pid_registry_beh@PAGE
	add	x10, x10, _silica_rt_pid_registry_beh@PAGEOFF
	mov	x3, xzr
	mov	x0, x9
	mov	x1, x10
	mov	w2, wzr
	adrp	x8, _silica_rt_runtime_spawner@PAGE
	add	x8, x8, _silica_rt_runtime_spawner@PAGEOFF
	adrp	x9, _silica_rt_spawn_rec_override@PAGE
	str	x8, [x9, _silica_rt_spawn_rec_override@PAGEOFF]
	bl	_silica_rt_actor_spawn
	adrp	x9, _silica_rt_spawn_rec_override@PAGE
	str	xzr, [x9, _silica_rt_spawn_rec_override@PAGEOFF]
; The registries never end, so their ACBs are kept (not held) for the runtime's own use.
	bl	_silica_rt_ref_peek
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
; _silica_dangerous_pid_registry_init: called once at program start from emitter-injected main prologue.
; Stores the spawned dangerous registry actor_ref in _silica_dangerous_pid_registry_ref.
	.globl	_silica_dangerous_pid_registry_init
	.p2align	2
_silica_dangerous_pid_registry_init:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_dangerous_pid_registry_init_spawn
	adrp	x1, _silica_dangerous_pid_registry_ref@PAGE
	str	x0, [x1, _silica_dangerous_pid_registry_ref@PAGEOFF]
	mov	x0, #0
	ldp	x29, x30, [sp], #16
	ret
; Spawn path for the global device PID registry primitive actor.
	.globl	_silica_rt_device_pid_registry_init_spawn
	.p2align	2
_silica_rt_device_pid_registry_init_spawn:
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x0, #1
	adrp	x1, _silica_registry_slots@PAGE
	ldr	x1, [x1, _silica_registry_slots@PAGEOFF]
	lsl	x1, x1, #4
	bl	_calloc
	mov	x19, x0
	mov	x9, x19
	adrp	x10, _silica_rt_pid_registry_beh@PAGE
	add	x10, x10, _silica_rt_pid_registry_beh@PAGEOFF
	mov	x3, xzr
	mov	x0, x9
	mov	x1, x10
	mov	w2, wzr
	adrp	x8, _silica_rt_runtime_spawner@PAGE
	add	x8, x8, _silica_rt_runtime_spawner@PAGEOFF
	adrp	x9, _silica_rt_spawn_rec_override@PAGE
	str	x8, [x9, _silica_rt_spawn_rec_override@PAGEOFF]
	bl	_silica_rt_actor_spawn
	adrp	x9, _silica_rt_spawn_rec_override@PAGE
	str	xzr, [x9, _silica_rt_spawn_rec_override@PAGEOFF]
; The registries never end, so their ACBs are kept (not held) for the runtime's own use.
	bl	_silica_rt_ref_peek
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
; _silica_device_pid_registry_init: called once at program start from emitter-injected main prologue.
; Stores the spawned device registry actor_ref in _silica_device_pid_registry_ref.
	.globl	_silica_device_pid_registry_init
	.p2align	2
_silica_device_pid_registry_init:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_device_pid_registry_init_spawn
	adrp	x1, _silica_device_pid_registry_ref@PAGE
	str	x0, [x1, _silica_device_pid_registry_ref@PAGEOFF]
	mov	x0, #0
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_wait_for_exit
	.p2align	2
_silica_rt_wait_for_exit:               ; §15.1.2.5 - returns 0 for a stdin line e-x-i-t, or the value of the
	.cfi_startproc                      ; first recorded cast_exit; main then continues. At the end of stdin
	stp	x29, x30, [sp, #-80]!       ; only the exit pipe is watched; the wait does not end on idleness.
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
; Layout: fd_set 128 B @0, timeval 16 B @128, line buf 256 B @144, scratch @400 -- 416 B total.
; poll(2) on macOS often never signals POLLIN for tty stdin; select(2) is reliable (Phase I trial / interactive main).
; x19 = 1 while standard input is still read (0 after its end), x20 = line length, x22 = exit pipe read end.
	sub	sp, sp, #416
	mov	x20, xzr
	mov	x19, #1
	adrp	x22, _silica_rt_exit_pipe@PAGE
	add	x22, x22, _silica_rt_exit_pipe@PAGEOFF
	ldr	w22, [x22]
Lwi_loop:
	mov	x0, sp
	mov	x1, xzr
	mov	x2, #128
	bl	_memset
	cbz	x19, Lwi_set_pipe
	ldr	w8, [sp]
	orr	w8, w8, #0x1
	str	w8, [sp]
Lwi_set_pipe:
	lsr	x9, x22, #3
	and	x10, x22, #7
	mov	w11, #1
	lsl	w11, w11, w10
	add	x9, sp, x9
	ldrb	w8, [x9]
	orr	w8, w8, w11
	strb	w8, [x9]
	str	xzr, [sp, #128]
	movz	w9, #0xd090
	movk	w9, #3, lsl #16
	str	w9, [sp, #136]
	add	w0, w22, #1
	mov	x1, sp
	mov	x2, xzr
	mov	x3, xzr
	add	x4, sp, #128
	bl	_select
	cmp	w0, #-1
	b.eq	Lwi_select_sleep
	cmp	w0, #0
	b.eq	Lwi_loop
; The exit pipe is readable once a cast_exit request is recorded: return its value.
	lsr	x9, x22, #3
	and	x10, x22, #7
	add	x9, sp, x9
	ldrb	w8, [x9]
	lsr	w8, w8, w10
	tbnz	w8, #0, Lwi_cast_exit
	cbz	x19, Lwi_loop
	ldr	w8, [sp]
	tbz	w8, #0, Lwi_loop
	cmp	x20, #255
	b.hs	Lwi_overflow_discard
	add	x21, sp, #144
	add	x21, x21, x20
	mov	x0, xzr
	mov	x2, #1
	mov	x1, x21
	bl	_read
	cmp	x0, #0
	b.ne	Lwi_line_read_nz
	mov	x19, xzr
	b	Lwi_loop
Lwi_line_read_nz:
	cmp	x0, #1
	b.ne	Lwi_select_sleep
	ldrb	w9, [x21]
	cmp	w9, #10
	b.eq	Lwi_line_done
	strb	w9, [x21]
	add	x20, x20, #1
	b	Lwi_loop
Lwi_line_done:
Lwi_trim_cr:
	cmp	x20, #0
	b.le	Lwi_cmp_exit
	sub	x21, x20, #1
	add	x9, sp, #144
	ldrb	w9, [x9, x21]
	cmp	w9, #13
	b.ne	Lwi_cmp_exit
	mov	x20, x21
	b	Lwi_trim_cr
Lwi_cmp_exit:
	cmp	x20, #4
	b.ne	Lwi_line_reset
	add	x21, sp, #144
	ldrb	w9, [x21]
	cmp	w9, #101
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #1]
	cmp	w9, #120
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #2]
	cmp	w9, #105
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #3]
	cmp	w9, #116
	b.ne	Lwi_line_reset
	b	Lwi_process_exit
Lwi_line_reset:
	mov	x20, xzr
	b	Lwi_loop
Lwi_overflow_discard:
	mov	x0, xzr
	add	x1, sp, #400
	mov	x2, #1
	bl	_read
	cmp	x0, #0
	b.ne	Lwi_overflow_read_nz
	mov	x19, xzr
	b	Lwi_loop
Lwi_overflow_read_nz:
	cmp	x0, #1
	b.ne	Lwi_select_sleep
	ldrb	w9, [sp, #400]
	cmp	w9, #10
	b.eq	Lwi_overflow_reset
	b	Lwi_overflow_discard
Lwi_overflow_reset:
	mov	x20, xzr
	b	Lwi_loop
Lwi_select_sleep:
	mov	x0, xzr
	mov	w1, wzr
	mov	w2, #100
	bl	_poll
	b	Lwi_loop
Lwi_cast_exit:
	adrp	x9, _silica_rt_exit_request@PAGE
	add	x9, x9, _silica_rt_exit_request@PAGEOFF
	ldar	x0, [x9]
	b	Lwi_return
Lwi_process_exit:
; The exit line is the request cast_exit(0) would make (§15.1.2.5, the first request wins): it is recorded
; the same way, so a later cast_exit returns 0. Lost to an earlier cast_exit: that request's pipe byte is
; coming, so the loop waits for it and returns its value.
	mov	x0, xzr
	bl	_silica_rt_cast_exit
	cbz	x0, Lwi_line_reset
	mov	x0, xzr
Lwi_return:
	add	sp, sp, #416
	ldp	x19, x20, [sp, #16]
	ldp	x21, x22, [sp, #32]
	ldp	x29, x30, [sp], #80
	ret
	.cfi_endproc
; §15.1.2.5 runtime start: no exit request yet (flag 0) and a private close-on-exec pipe from cast_exit to
; wait_for_exit. Called from _silica_pid_registry_init before any actor exists.
	.globl	_silica_rt_exit_request_init
	.p2align	2
_silica_rt_exit_request_init:
	.cfi_startproc
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	adrp	x9, _silica_rt_exit_flag@PAGE
	add	x9, x9, _silica_rt_exit_flag@PAGEOFF
	str	xzr, [x9]
	adrp	x9, _silica_rt_exit_request@PAGE
	add	x9, x9, _silica_rt_exit_request@PAGEOFF
	str	xzr, [x9]
	adrp	x19, _silica_rt_exit_pipe@PAGE
	add	x19, x19, _silica_rt_exit_pipe@PAGEOFF
	mov	x0, x19
	bl	_pipe
; fcntl(fd, F_SETFD, FD_CLOEXEC) for both ends; the third argument is variadic, so Apple arm64 passes it on the stack.
	sub	sp, sp, #16
	mov	x8, #1
	str	x8, [sp]
	ldr	w0, [x19]
	mov	w1, #2
	mov	x2, #1
	bl	_fcntl
	mov	x8, #1
	str	x8, [sp]
	ldr	w0, [x19, #4]
	mov	w1, #2
	mov	x2, #1
	bl	_fcntl
	add	sp, sp, #16
; Every death is reported once (§15.4.13.4), with or without a FailureReporter: exit waits for
; reports still in flight and prints the pending ones (_silica_rt_report_drain_at_exit).
	adrp	x0, _silica_rt_report_drain_at_exit@PAGE
	add	x0, x0, _silica_rt_report_drain_at_exit@PAGEOFF
	bl	_atexit
	mov	x0, #0
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.cfi_endproc
; §15.1.2.5 cast_exit(value: int64) -> boolean. X0 = value. Compare-and-swap _silica_rt_exit_flag from 0 to 1:
; the winner stores its value in _silica_rt_exit_request (release), writes one byte to the exit pipe so main's
; wait_for_exit wakes and returns that value, and returns 1. A later request returns 0 and changes nothing. Any
; actor thread may call this; nothing here allocates.
	.globl	_silica_rt_cast_exit
	.p2align	2
_silica_rt_cast_exit:
	.cfi_startproc
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x0, [sp, #16]
	adrp	x1, _silica_rt_exit_flag@PAGE
	add	x1, x1, _silica_rt_exit_flag@PAGEOFF
	mov	x4, #1
Lce_cas:
	ldaxr	x2, [x1]
	cbnz	x2, Lce_lost
	stlxr	w3, x4, [x1]
	cbnz	w3, Lce_cas
	adrp	x1, _silica_rt_exit_request@PAGE
	add	x1, x1, _silica_rt_exit_request@PAGEOFF
	stlr	x0, [x1]
	adrp	x1, _silica_rt_exit_pipe@PAGE
	add	x1, x1, _silica_rt_exit_pipe@PAGEOFF
	ldr	w0, [x1, #4]
	add	x1, sp, #16
	mov	x2, #1
	bl	_write
	mov	x0, #1
	ldp	x29, x30, [sp], #32
	ret
Lce_lost:
	clrex
	mov	x0, #0
	ldp	x29, x30, [sp], #32
	ret
	.cfi_endproc
"))
}

fn actor_rt_emit_runtime_tail(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    concat(concat(actor_rt_asm_phase_i_chunk(table), actor_rt_asm_phase_c_chunk(table)), actor_rt_asm_phase_f_chunk())
}

fn actor_rt_asm_badarith_chunk() -> string {
    "
	.globl	_silica_rt_badarith
	.p2align	2
_silica_rt_badarith:
	.cfi_startproc
	stp	x21, x20, [sp, #-48]!
	stp	x29, x30, [sp, #16]
	str	x19, [sp, #32]
	add	x29, sp, #16
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	cbz	x19, Lbadarith_process
; X23 = the carrier (0 for a dangerous actor's thread). A carrier actor stays on its own stack
; (this is called from its behaviour or its start trampoline) for the delivering phase, so the
; shutdown of a supervisor's children (child_table_free) parks for each child; it moves to the
; carrier's stack only to unmap the reservation, and ends in the carrier loop.
	ldr	x23, [x19, #440]
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x8, #1
	str	x8, [x19, #232]
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x8, [x19, #216]
	cbz	x8, Lsbg_2
	ldr	x8, [x8, #40]
Lsbg_2:
	cbnz	x8, Lbadarith_report_already_done
	mov	x0, x19
	bl	_silica_rt_actor_deliver_exit
	mov	x20, x0
	mov	x0, x19
	bl	_silica_rt_actor_deliver_unwind_report
	b	Lbadarith_after_report
Lbadarith_report_already_done:
	mov	x20, #0
Lbadarith_after_report:
; The started word (#224) is set after the report so a spawner spinning on it (actor_spawn /
; spawn_linked, while this actor's start trampoline ran) proceeds: 2 = the init trampoline divided by zero. The ACB is
; not freed under the spawner: it goes with its last holder (_silica_rt_acb_release); a row child's
; exit notice is parked at #400 until its spawner has committed it to the row.
	mov	x0, x19
	bl	_silica_rt_actor_signal_pending_call_deaths
	ldr	x8, [x19, #224]
	cbnz	x8, Lbadarith_started_set
	mov	x0, x19
	mov	x1, #2
	bl	_silica_rt_started_store
	b	Lbadarith_no_supervisor
Lbadarith_started_set:
; A carrier actor leaves the restart to its supervisor's own dispatch (see LBB1_exit); a dangerous
; actor's thread restarts itself when its own notice is first in the ingress
; (_silica_rt_supervisor_drain_own_exit) and never waits for its replacement (a kill_abnormal
; caller waits for this row's exit_done and then for the restart to settle).
	cbnz	x23, Lbadarith_no_supervisor
	ldr	x8, [x19, #400]
	cmp	x8, #1
	b.ne	Lbadarith_no_supervisor
	ldr	x21, [x19, #192]
	cbz	x21, Lbadarith_no_supervisor
	mov	x0, x21
	mov	x1, x19
	bl	_silica_rt_supervisor_drain_own_exit
Lbadarith_no_supervisor:
	mov	x0, x19
	bl	_silica_rt_child_table_free
	mov	x0, x19
	bl	_silica_rt_ffi_arena_teardown
	mov	x0, x19
	bl	_silica_rt_actor_dealloc_region
	cbz	x23, Lbadarith_release
; Nothing of the actor waits any more: onto the carrier's stack, and the reservation is unmapped
; before the block can go.
	ldr	x9, [x23, #48]
	mov	sp, x9
	mov	x0, x19
	mov	x1, xzr
	bl	_silica_rt_actor_stack_free
Lbadarith_release:
	mov	x0, x19
	bl	_silica_rt_actor_final_release
	cbz	x23, Lbadarith_thread_exit
	mov	x0, x23
	b	_silica_rt_carrier_loop_enter
Lbadarith_thread_exit:
	mov	x0, #0
	bl	_pthread_exit
	b	Lbadarith_thread_exit
Lbadarith_process:
	mov	w0, #2
Lbadarith_msg_a:
	adrp	x1, L_silica_badarith_msg@PAGE
Lbadarith_msg_b:
	add	x1, x1, L_silica_badarith_msg@PAGEOFF
	mov	w2, #9
	bl	_write
	mov	w0, #1
	bl	_exit
	b	Lbadarith_process
	.loh AdrpAdd	Lbadarith_msg_a, Lbadarith_msg_b
	.cfi_endproc
	.section	__TEXT,__cstring,cstring_literals
L_silica_badarith_msg:
	.asciz	\"badarith\\n\"
	.section	__TEXT,__text,regular,pure_instructions
"
}

fn actor_rt_asm_case_clause_chunk() -> string {
    "
	.globl	_silica_rt_case_clause
	.p2align	2
_silica_rt_case_clause:
	.cfi_startproc
	stp	x21, x20, [sp, #-48]!
	stp	x29, x30, [sp, #16]
	str	x19, [sp, #32]
	add	x29, sp, #16
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	cbz	x19, Lcaseclause_process
; X23 = the carrier (0 for a dangerous actor's thread). A carrier actor stays on its own stack
; for the delivering phase (as _silica_rt_badarith) and moves to the carrier's stack only to
; unmap the reservation; the exit path ends in the carrier loop.
	ldr	x23, [x19, #440]
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x8, #2
	str	x8, [x19, #232]
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x8, [x19, #216]
	cbz	x8, Lsbg_3
	ldr	x8, [x8, #40]
Lsbg_3:
	cbnz	x8, Lcaseclause_report_already_done
	mov	x0, x19
	bl	_silica_rt_actor_deliver_exit
	mov	x20, x0
	mov	x0, x19
	bl	_silica_rt_actor_deliver_unwind_report
	b	Lcaseclause_after_report
Lcaseclause_report_already_done:
	mov	x20, #0
Lcaseclause_after_report:
; The started word (#224) is set after the report so a spawner spinning on it (actor_spawn /
; spawn_linked, while this actor's start trampoline ran) proceeds: 2 = the init trampoline matched no case arm. The ACB is
; not freed under the spawner: it goes with its last holder (_silica_rt_acb_release); a row child's
; exit notice is parked at #400 until its spawner has committed it to the row.
	mov	x0, x19
	bl	_silica_rt_actor_signal_pending_call_deaths
	ldr	x8, [x19, #224]
	cbnz	x8, Lcaseclause_started_set
	mov	x0, x19
	mov	x1, #2
	bl	_silica_rt_started_store
	b	Lcaseclause_no_supervisor
Lcaseclause_started_set:
; A carrier actor leaves the restart to its supervisor's own dispatch (see LBB1_exit); a dangerous
; actor's thread restarts itself when its own notice is first in the ingress
; (_silica_rt_supervisor_drain_own_exit) and never waits for its replacement (a kill_abnormal
; caller waits for this row's exit_done and then for the restart to settle).
	cbnz	x23, Lcaseclause_no_supervisor
	ldr	x8, [x19, #400]
	cmp	x8, #1
	b.ne	Lcaseclause_no_supervisor
	ldr	x21, [x19, #192]
	cbz	x21, Lcaseclause_no_supervisor
	mov	x0, x21
	mov	x1, x19
	bl	_silica_rt_supervisor_drain_own_exit
Lcaseclause_no_supervisor:
	mov	x0, x19
	bl	_silica_rt_child_table_free
	mov	x0, x19
	bl	_silica_rt_ffi_arena_teardown
	mov	x0, x19
	bl	_silica_rt_actor_dealloc_region
	cbz	x23, Lcaseclause_release
; Nothing of the actor waits any more: onto the carrier's stack, and the reservation is unmapped
; before the block can go.
	ldr	x9, [x23, #48]
	mov	sp, x9
	mov	x0, x19
	mov	x1, xzr
	bl	_silica_rt_actor_stack_free
Lcaseclause_release:
	mov	x0, x19
	bl	_silica_rt_actor_final_release
	cbz	x23, Lcaseclause_thread_exit
	mov	x0, x23
	b	_silica_rt_carrier_loop_enter
Lcaseclause_thread_exit:
	mov	x0, #0
	bl	_pthread_exit
	b	Lcaseclause_thread_exit
Lcaseclause_process:
	mov	w0, #2
Lcaseclause_msg_a:
	adrp	x1, L_silica_case_clause_msg@PAGE
Lcaseclause_msg_b:
	add	x1, x1, L_silica_case_clause_msg@PAGEOFF
	mov	w2, #12
	bl	_write
	mov	w0, #1
	bl	_exit
	b	Lcaseclause_process
	.loh AdrpAdd	Lcaseclause_msg_a, Lcaseclause_msg_b
	.cfi_endproc
	.section	__TEXT,__cstring,cstring_literals
L_silica_case_clause_msg:
	.asciz	\"case_clause\\n\"
	.section	__TEXT,__text,regular,pure_instructions
"
}

fn actor_rt_asm_name_taken_chunk(nf_idx: int64) -> string {
    concat(concat("	.section	__DATA,__data
	.p2align	3
	.globl	_silica_rt_actor_not_found_atom
_silica_rt_actor_not_found_atom:
	.quad	", atom_table@int64_to_decimal_string(nf_idx)), "
	.section	__TEXT,__cstring,cstring_literals
L_silica_actor_not_found_msg:
	.asciz	\"actor_not_found\\n\"
	.section	__TEXT,__text,regular,pure_instructions
; _silica_rt_actor_not_found: cast_registered / call_registered / cast_dangerous_registered / cast_device_registered named a
; name no live actor holds in its registry
; (spec §20.3.1: they raise actor_not_found, as cast() and call() do for an ended actor). The current
; actor fails with failure_reason (:explicit, :actor_not_found), tag 4, ended where it stands exactly as
; _silica_rt_registry_name_taken ends it (shared exit body, the tag in X20); in main (no current actor)
; it is the language-level failure of §15.4.5.5: the atom's name on standard error, exit status 1.
; The atom is appended to every runtime atom table (atom_table@build_runtime_atom_table). Never returns.
	.globl	_silica_rt_actor_not_found
	.p2align	2
_silica_rt_actor_not_found:
	.cfi_startproc
	stp	x21, x20, [sp, #-48]!
	stp	x29, x30, [sp, #16]
	str	x19, [sp, #32]
	add	x29, sp, #16
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	cbz	x19, Lnotfound_process
	adrp	x8, _silica_rt_actor_not_found_atom@PAGE
	add	x8, x8, _silica_rt_actor_not_found_atom@PAGEOFF
	ldr	x8, [x8]
	str	x8, [x19, #384]
	mov	x20, #4
	b	Lnametaken_fail_actor
Lnotfound_process:
	mov	w0, #2
	adrp	x1, L_silica_actor_not_found_msg@PAGE
	add	x1, x1, L_silica_actor_not_found_msg@PAGEOFF
	mov	w2, #16
	bl	_write
	mov	w0, #1
	bl	_exit
	b	Lnotfound_process
	.cfi_endproc

; Control-block lifetime. #392 counts the holders of an actor's ACB; the last one frees it, so it
; is freed exactly once, whichever order they finish in:
;   - the actor's own thread, to the end of its exit path (_silica_rt_actor_final_release);
;   - its spawner, until the spawn has returned it (_silica_rt_spawner_let_go) or, for a row child,
;     until the row holds it (_silica_rt_supervisor_spawn_child_row_by_flavor);
;   - each child whose #192 names it as supervisor, until that child's exit path is done with it;
;   - its exit notice, until a supervisor has handled it (_silica_rt_exit_payload_free): maybe_restart
;     matches rows by this reference, so no new actor may take the address before then.
; #400 is a row child's exit notice slot: 0 = not yet committed to its row, 1 = committed (and for
; every other actor), else a notice the child parked because it ended before the commit.
	.globl	_silica_rt_acb_hold
	.p2align	2
_silica_rt_acb_hold:
; X0 = ACB or 0: one more holder. Leaf, x9-x11.
	cbz	x0, Lacbh_ret
	add	x9, x0, #392
Lacbh_add:
	ldaxr	x10, [x9]
	add	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lacbh_add
Lacbh_ret:
	ret
	.globl	_silica_rt_acb_release
	.p2align	2
_silica_rt_acb_release:
; X0 = ACB or 0: one holder lets go; the last frees the block.
	cbz	x0, Lacbrel_ret
	add	x9, x0, #392
Lacbrel_sub:
	ldaxr	x10, [x9]
	sub	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lacbrel_sub
	cbnz	x10, Lacbrel_ret
	b	_free
Lacbrel_ret:
	ret
	.globl	_silica_rt_actor_final_release
	.p2align	2
_silica_rt_actor_final_release:
; X0 = an ended actor's ACB; the last act of its thread before it exits. Its identity stops resolving
; (§15.1.4: a reference to it is dead from here on), its own hold goes, then its row's exit_done (=
; its identity) and block reference (sb_child_done), then its hold on its supervisor.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	mov	x19, x0
	bl	_silica_rt_idt_remove
	mov	x0, x19
	ldr	x21, [x0, #408]
	ldr	x19, [x0, #192]
	ldr	x20, [x0, #208]
	cmp	x19, #0
	csel	x20, x20, xzr, ne
	bl	_silica_rt_acb_release
	mov	x0, x20
	mov	x1, x21
	bl	_silica_rt_sb_child_done
	mov	x0, x19
	bl	_silica_rt_acb_release
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.globl	_silica_rt_spawner_let_go
	.p2align	2
_silica_rt_spawner_let_go:
; X0 = the actor a spawn made (0: none) -> X0 = the reference the spawn returns: its identity
; (§15.1.4), which is dead already when the actor ended inside its start trampoline. The spawner's
; hold goes. No actor (no memory) gives the identity no actor has, all ones.
	cbz	x0, Lslg_none
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	ldr	x20, [x0, #408]
	bl	_silica_rt_acb_release
	mov	x0, x20
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
Lslg_none:
	mov	x0, #-1
	ret
	.globl	_silica_rt_exit_payload_free
	.p2align	2
_silica_rt_exit_payload_free:
; X0 = an exit notice payload or 0: frees it and drops its hold on the ended actor.
	cbz	x0, Lepf_ret
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	ldr	x19, [x0]
	bl	_free
	mov	x0, x19
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	b	_silica_rt_acb_release
Lepf_ret:
	ret
; The dead actor (never alive, never freed: its holder count can never reach 0).
	.section	__DATA,__data
	.p2align	4
	.globl	_silica_rt_dead_acb
_silica_rt_dead_acb:
	.space	392
	.quad	0x4000000000000000
	.quad	1
	.quad	-1
	.quad	0, 0
	.quad	0, 0
	.space	72
	.quad	1
	.quad	0, 0, 0, 0
	.quad	0, 0
	.quad	0, 0
	.section	__TEXT,__text,regular,pure_instructions
; _silica_rt_registry_name_taken: a registered name was already held by a live actor or supervisor
; (spec §20.3.1: spawn_registered, spawn_registered_supervisor, a supervised child id). Ends the current
; actor with failure_reason :language_error exactly as _silica_rt_case_clause does; in main (no current
; actor) it is the language-level failure of §15.4.5.5: the failure atom name on standard error, exit 1.
; The trampoline-ran word (#288) is set after the report so a spawner waiting on it proceeds.
; _silica_rt_beh_convention(X0 = behaviour entry or 0) -> X0 = 1 call-only, 2 cast-only, 0 not checked
; (spec §16.2.6.4). The emitter writes 0x5C1AC0F1 / 0x5C1AC0F2 in the word before the entry of every
; function declared to return (:reply, ...) / (:no_reply, ...); runtime-internal behaviours and
; supervisors (no behaviour) have no such word. Leaf; clobbers X9-X10 only.
	.globl	_silica_rt_beh_convention
	.p2align	2
_silica_rt_beh_convention:
	cbz	x0, Lbc_none
	ldur	w9, [x0, #-4]
	lsr	w10, w9, #4
	movz	w0, #0xAC0F
	movk	w0, #0x5C1, lsl #16
	cmp	w10, w0
	b.ne	Lbc_none
	and	x0, x9, #0xF
	cmp	x0, #3
	b.lo	Lbc_ret
Lbc_none:
	mov	x0, xzr
Lbc_ret:
	ret
; _silica_rt_convention_mismatch: a call()/cast() whose target was spawned with the other calling
; convention (spec §16.2.6.4), or kill_abnormal naming the calling actor (§15.1.2.3). Nothing was
; enqueued; the calling actor fails with :language_error (main: the message and exit 1, §15.4.5.5).
	.globl	_silica_rt_convention_mismatch
	.globl	_silica_rt_language_error_current
	.globl	_silica_rt_registry_name_taken
	.p2align	2
_silica_rt_convention_mismatch:
_silica_rt_language_error_current:
_silica_rt_registry_name_taken:
	.cfi_startproc
	stp	x21, x20, [sp, #-48]!
	stp	x29, x30, [sp, #16]
	str	x19, [sp, #32]
	add	x29, sp, #16
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	cbz	x19, Lnametaken_process
	mov	x20, #2
Lnametaken_fail_actor:
; X23 = the carrier (0 for a dangerous actor's thread). A carrier actor stays on its own stack
; for the delivering phase (as _silica_rt_badarith: a supervisor failing in its start trampoline
; after some children were started shuts them down here, parking for each) and moves to the
; carrier's stack only to unmap the reservation; the exit path ends in the carrier loop.
	ldr	x23, [x19, #440]
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	str	x20, [x19, #232]
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x8, [x19, #216]
	cbz	x8, Lsbg_4
	ldr	x8, [x8, #40]
Lsbg_4:
	cbnz	x8, Lnametaken_report_already_done
	mov	x0, x19
	bl	_silica_rt_actor_deliver_exit
	mov	x20, x0
	mov	x0, x19
	bl	_silica_rt_actor_deliver_unwind_report
	b	Lnametaken_after_report
Lnametaken_report_already_done:
	mov	x20, #0
Lnametaken_after_report:
; The started word (#224) is set after the report on both branches so a spawner waiting on it
; proceeds. Still 0 here means the start trampoline failed while its spawner spins on the word:
; 2 tells it so, and the actor skips its supervisor's drain (the spawner has not yet put it in a
; row; its exit notice is parked at #400 for the spawner) and its ACB stays until its last holder lets
; go (_silica_rt_acb_release; before, the actor freed it at once and a spawner descheduled until then
; spun on freed memory: working_registry_child_id_taken_across_supervisors hung in actor_spawn).
	mov	x0, x19
	bl	_silica_rt_actor_signal_pending_call_deaths
	ldr	x8, [x19, #224]
	cbnz	x8, Lnametaken_started_set
	mov	x0, x19
	mov	x1, #2
	bl	_silica_rt_started_store
	b	Lnametaken_no_supervisor
Lnametaken_started_set:
; A carrier actor leaves the restart to its supervisor's own dispatch (see LBB1_exit); a dangerous
; actor's thread restarts itself when its own notice is first in the ingress
; (_silica_rt_supervisor_drain_own_exit) and never waits for its replacement (a kill_abnormal
; caller waits for this row's exit_done and then for the restart to settle).
	cbnz	x23, Lnametaken_no_supervisor
	ldr	x8, [x19, #400]
	cmp	x8, #1
	b.ne	Lnametaken_no_supervisor
	ldr	x21, [x19, #192]
	cbz	x21, Lnametaken_no_supervisor
	mov	x0, x21
	mov	x1, x19
	bl	_silica_rt_supervisor_drain_own_exit
Lnametaken_no_supervisor:
	mov	x0, x19
	bl	_silica_rt_child_table_free
	mov	x0, x19
	bl	_silica_rt_ffi_arena_teardown
	mov	x0, x19
	bl	_silica_rt_actor_dealloc_region
	cbz	x23, Lnametaken_release
; Nothing of the actor waits any more: onto the carrier's stack, and the reservation is unmapped
; before the block can go.
	ldr	x9, [x23, #48]
	mov	sp, x9
	mov	x0, x19
	mov	x1, xzr
	bl	_silica_rt_actor_stack_free
Lnametaken_release:
	mov	x0, x19
	bl	_silica_rt_actor_final_release
	cbz	x23, Lnametaken_thread_exit
	mov	x0, x23
	b	_silica_rt_carrier_loop_enter
Lnametaken_thread_exit:
	mov	x0, #0
	bl	_pthread_exit
	b	Lnametaken_thread_exit
Lnametaken_process:
	mov	w0, #2
Lnametaken_msg_a:
	adrp	x1, L_silica_name_taken_msg@PAGE
Lnametaken_msg_b:
	add	x1, x1, L_silica_name_taken_msg@PAGEOFF
	mov	w2, #15
	bl	_write
	mov	w0, #1
	bl	_exit
	b	Lnametaken_process
	.loh AdrpAdd	Lnametaken_msg_a, Lnametaken_msg_b
	.cfi_endproc
	.section	__TEXT,__cstring,cstring_literals
L_silica_name_taken_msg:
	.asciz	\"language_error\\n\"
	.section	__TEXT,__text,regular,pure_instructions
")
}

// Actor identity (spec §15.1.4): the identity table, spawner records and the reference boundary.
fn actor_rt_identity_chunk(ie_idx: int64) -> string {
    concat(concat("; ---- Actor identity (spec §15.1.4) ----
; A reference is its actor's 64-bit identity, position << 32 | child number; never a pointer. The
; identity table maps identity -> ACB for every actor that has not finished ending: open addressing,
; linear probing, power-of-two capacity, grown x2 above half load, backward-shift deletion. A slot
; holds the ACB (0 empty); its key is the ACB's #408. An actor is inserted by its spawn before its
; thread exists and removed by its final release before its own hold goes, so a slot never names
; freed memory. _silica_rt_ref_hold resolves under the table lock and takes a holder (#392): the
; runtime never dereferences a reference a program hands it.
; ACB #408 identity, #416 spawner record (pos+1, 0 = none yet), #424 next child number. A row
; child's spawner record is its row's +96/+104 instead, so it survives the child's restarts (§15.4.12.1).
	.section	__DATA,__data
	.p2align	3
	.globl	_silica_rt_idt
_silica_rt_idt:
	.quad	0, 0, 0, 0
	.globl	_silica_rt_next_position
_silica_rt_next_position:
	.quad	1
	.globl	_silica_rt_main_spawner
_silica_rt_main_spawner:
	.quad	1, 0
	.globl	_silica_rt_runtime_spawner
_silica_rt_runtime_spawner:
	.quad	0x100000000, 0
	.globl	_silica_rt_spawn_rec_override
_silica_rt_spawn_rec_override:
	.quad	0
	.globl	_silica_rt_root_failure_reporter_id
_silica_rt_root_failure_reporter_id:
	.quad	0
	.globl	_silica_rt_identity_exhausted_atom
_silica_rt_identity_exhausted_atom:
	.quad	", atom_table@int64_to_decimal_string(ie_idx)), "
	.section	__TEXT,__cstring,cstring_literals
L_silica_identity_exhausted_msg:
	.asciz	\"identity_exhausted\\n\"
	.section	__TEXT,__text,regular,pure_instructions
; _silica_rt_idt_find_locked(X0 = identity) -> X0 = the slot that holds it or the empty slot where it
; would go (0: no table yet), X1 = its ACB or 0. Table lock held. Leaf; x9-x15.
	.globl	_silica_rt_idt_find_locked
	.p2align	2
_silica_rt_idt_find_locked:
	adrp	x9, _silica_rt_idt@PAGE
	add	x9, x9, _silica_rt_idt@PAGEOFF
	ldr	x11, [x9, #8]
	ldr	x12, [x9, #16]
	cbz	x11, Lidtf_none
	mov	x13, x0
	movz	x10, #0x7C15
	movk	x10, #0x7F4A, lsl #16
	movk	x10, #0x79B9, lsl #32
	movk	x10, #0x9E37, lsl #48
	mul	x14, x13, x10
	lsr	x14, x14, #32
	and	x14, x14, x12
Lidtf_loop:
	add	x0, x11, x14, lsl #3
	ldr	x1, [x0]
	cbz	x1, Lidtf_ret
	ldr	x15, [x1, #408]
	cmp	x15, x13
	b.eq	Lidtf_ret
	add	x14, x14, #1
	and	x14, x14, x12
	b	Lidtf_loop
Lidtf_none:
	mov	x0, #0
	mov	x1, #0
Lidtf_ret:
	ret
; _silica_rt_idt_grow_locked -> X0 = 0, or 1 when no memory. Table lock held.
	.p2align	2
_silica_rt_idt_grow_locked:
	stp	x24, x23, [sp, #-64]!
	stp	x22, x21, [sp, #16]
	stp	x20, x19, [sp, #32]
	stp	x29, x30, [sp, #48]
	add	x29, sp, #48
	adrp	x19, _silica_rt_idt@PAGE
	add	x19, x19, _silica_rt_idt@PAGEOFF
	ldr	x20, [x19, #8]
	ldr	x21, [x19, #16]
	mov	x23, #64
	cbz	x20, Lidtg_alloc
	add	x23, x21, #1
	lsl	x23, x23, #1
Lidtg_alloc:
	mov	x0, x23
	mov	x1, #8
	bl	_calloc
	cbz	x0, Lidtg_oom
	str	x0, [x19, #8]
	sub	x9, x23, #1
	str	x9, [x19, #16]
	cbz	x20, Lidtg_ok
	mov	x22, #0
Lidtg_move:
	ldr	x24, [x20, x22, lsl #3]
	cbz	x24, Lidtg_next
	ldr	x0, [x24, #408]
	bl	_silica_rt_idt_find_locked
	str	x24, [x0]
Lidtg_next:
	add	x22, x22, #1
	cmp	x22, x21
	b.ls	Lidtg_move
	mov	x0, x20
	bl	_free
Lidtg_ok:
	mov	x0, #0
	b	Lidtg_ret
Lidtg_oom:
	mov	x0, #1
Lidtg_ret:
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
; _silica_rt_idt_insert(X0 = ACB, its identity at #408) -> X0 = 0, or 1 when no memory.
	.globl	_silica_rt_idt_insert
	.p2align	2
_silica_rt_idt_insert:
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	adrp	x0, _silica_rt_idt@PAGE
	add	x0, x0, _silica_rt_idt@PAGEOFF
	bl	_os_unfair_lock_lock
	adrp	x9, _silica_rt_idt@PAGE
	add	x9, x9, _silica_rt_idt@PAGEOFF
	ldr	x11, [x9, #8]
	cbz	x11, Lidti_grow
	ldr	x10, [x9, #24]
	ldr	x12, [x9, #16]
	add	x10, x10, #1
	lsl	x10, x10, #1
	add	x12, x12, #1
	cmp	x10, x12
	b.ls	Lidti_put
Lidti_grow:
	bl	_silica_rt_idt_grow_locked
	mov	x20, x0
	cbnz	x20, Lidti_unlock
Lidti_put:
	ldr	x0, [x19, #408]
	bl	_silica_rt_idt_find_locked
	str	x19, [x0]
	adrp	x9, _silica_rt_idt@PAGE
	add	x9, x9, _silica_rt_idt@PAGEOFF
	ldr	x10, [x9, #24]
	add	x10, x10, #1
	str	x10, [x9, #24]
	mov	x20, #0
Lidti_unlock:
	adrp	x0, _silica_rt_idt@PAGE
	add	x0, x0, _silica_rt_idt@PAGEOFF
	bl	_os_unfair_lock_unlock
	mov	x0, x20
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
; _silica_rt_idt_remove(X0 = ACB): its identity no longer resolves. Entries after it in the probe run
; shift back into the hole when that does not move them before their home slot.
	.globl	_silica_rt_idt_remove
	.p2align	2
_silica_rt_idt_remove:
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	adrp	x0, _silica_rt_idt@PAGE
	add	x0, x0, _silica_rt_idt@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x0, [x19, #408]
	bl	_silica_rt_idt_find_locked
	cmp	x1, x19
	b.ne	Lidtr_unlock
	adrp	x9, _silica_rt_idt@PAGE
	add	x9, x9, _silica_rt_idt@PAGEOFF
	ldr	x11, [x9, #8]
	ldr	x12, [x9, #16]
	sub	x13, x0, x11
	lsr	x13, x13, #3
	mov	x14, x13
	movz	x10, #0x7C15
	movk	x10, #0x7F4A, lsl #16
	movk	x10, #0x79B9, lsl #32
	movk	x10, #0x9E37, lsl #48
Lidtr_scan:
	add	x14, x14, #1
	and	x14, x14, x12
	ldr	x1, [x11, x14, lsl #3]
	cbz	x1, Lidtr_clear
	ldr	x15, [x1, #408]
	mul	x15, x15, x10
	lsr	x15, x15, #32
	and	x15, x15, x12
	sub	x2, x14, x15
	and	x2, x2, x12
	sub	x3, x14, x13
	and	x3, x3, x12
	cmp	x2, x3
	b.lo	Lidtr_scan
	str	x1, [x11, x13, lsl #3]
	mov	x13, x14
	b	Lidtr_scan
Lidtr_clear:
	str	xzr, [x11, x13, lsl #3]
	ldr	x10, [x9, #24]
	sub	x10, x10, #1
	str	x10, [x9, #24]
Lidtr_unlock:
	adrp	x0, _silica_rt_idt@PAGE
	add	x0, x0, _silica_rt_idt@PAGEOFF
	bl	_os_unfair_lock_unlock
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
; _silica_rt_ref_hold(X0 = identity) -> X0 = its ACB with one more holder (#392; give it back with
; _silica_rt_acb_release), or 0 when no actor that has not finished ending has the identity.
	.globl	_silica_rt_ref_hold
	.p2align	2
_silica_rt_ref_hold:
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	adrp	x0, _silica_rt_idt@PAGE
	add	x0, x0, _silica_rt_idt@PAGEOFF
	bl	_os_unfair_lock_lock
	mov	x0, x19
	bl	_silica_rt_idt_find_locked
	mov	x19, x1
	cbz	x19, Lrh_unlock
	add	x9, x19, #392
Lrh_add:
	ldaxr	x10, [x9]
	add	x10, x10, #1
	stlxr	w11, x10, [x9]
	cbnz	w11, Lrh_add
Lrh_unlock:
	adrp	x0, _silica_rt_idt@PAGE
	add	x0, x0, _silica_rt_idt@PAGEOFF
	bl	_os_unfair_lock_unlock
	mov	x0, x19
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
; _silica_rt_ref_alive(X0 = identity) -> X0 = 1 when the actor is in the table and alive (#152).
; _silica_rt_ref_peek(X0 = identity) -> X0 = its ACB without a hold (only for actors that never end:
; the registries), or 0.
	.globl	_silica_rt_ref_alive
	.p2align	2
_silica_rt_ref_alive:
	mov	x9, #1
	b	Lra_common
	.globl	_silica_rt_ref_peek
	.p2align	2
_silica_rt_ref_peek:
	mov	x9, #0
Lra_common:
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, x9
	adrp	x0, _silica_rt_idt@PAGE
	add	x0, x0, _silica_rt_idt@PAGEOFF
	bl	_os_unfair_lock_lock
	mov	x0, x19
	bl	_silica_rt_idt_find_locked
	mov	x19, x1
	cbz	x20, Lra_unlock
	cbz	x19, Lra_unlock
	ldr	w19, [x19, #152]
	cmp	w19, #0
	cset	x19, ne
Lra_unlock:
	adrp	x0, _silica_rt_idt@PAGE
	add	x0, x0, _silica_rt_idt@PAGEOFF
	bl	_os_unfair_lock_unlock
	mov	x0, x19
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
; _silica_rt_ref_call(X0 = identity, X1-X3 = arguments, X9 = body): the body runs with X0 = the held
; ACB, or 0 when the reference names no actor, and its X0 is returned; the hold goes afterwards.
	.globl	_silica_rt_ref_call
	.p2align	2
_silica_rt_ref_call:
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x1, x2, [sp, #32]
	stp	x3, x9, [sp, #48]
	bl	_silica_rt_ref_hold
	mov	x19, x0
	ldp	x1, x2, [sp, #32]
	ldp	x3, x9, [sp, #48]
	blr	x9
	mov	x20, x0
	mov	x0, x19
	bl	_silica_rt_acb_release
	mov	x0, x20
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
; _silica_rt_sup_ref_call: _silica_rt_ref_call for call_supervisor; a supervisor that has ended (or
; never existed) raises actor_not_found (§16.1.1.1, as call() does).
	.globl	_silica_rt_sup_ref_call
	.p2align	2
_silica_rt_sup_ref_call:
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x1, x2, [sp, #32]
	stp	x3, x9, [sp, #48]
	bl	_silica_rt_ref_hold
	mov	x19, x0
	cbz	x19, Lsrc_not_found
	ldr	w9, [x19, #152]
	cbz	w9, Lsrc_dead
	ldp	x1, x2, [sp, #32]
	ldp	x3, x9, [sp, #48]
	blr	x9
	mov	x20, x0
	mov	x0, x19
	bl	_silica_rt_acb_release
	mov	x0, x20
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
Lsrc_dead:
	mov	x0, x19
	bl	_silica_rt_acb_release
Lsrc_not_found:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	b	_silica_rt_actor_not_found
; _silica_rt_spawner_rec(X0 = the spawning actor's ACB, or 0 for main) -> X0 = its spawner record.
	.globl	_silica_rt_spawner_rec
	.p2align	2
_silica_rt_spawner_rec:
	cbz	x0, Lsrec_main
	ldr	x9, [x0, #192]
	cbz	x9, Lsrec_own
	ldr	x9, [x0, #208]
	cmp	x9, #4096
	b.lo	Lsrec_own
	add	x0, x9, #96
	ret
Lsrec_own:
	add	x0, x0, #416
	ret
Lsrec_main:
	adrp	x0, _silica_rt_spawn_rec_override@PAGE
	ldr	x0, [x0, _silica_rt_spawn_rec_override@PAGEOFF]
	cbnz	x0, Lsrec_ret
	adrp	x0, _silica_rt_main_spawner@PAGE
	add	x0, x0, _silica_rt_main_spawner@PAGEOFF
Lsrec_ret:
	ret
; _silica_rt_spawner_position(X0 = spawner record) -> X0 = position + 1, given now from the global
; counter if the record has none, or 0 when positions are exhausted. Leaf.
	.globl	_silica_rt_spawner_position
	.p2align	2
_silica_rt_spawner_position:
	ldar	x9, [x0]
	cbnz	x9, Lspos_have
	adrp	x10, _silica_rt_next_position@PAGE
	add	x10, x10, _silica_rt_next_position@PAGEOFF
Lspos_take:
	ldaxr	x11, [x10]
	add	x12, x11, #1
	stlxr	w13, x12, [x10]
	cbnz	w13, Lspos_take
	mov	x12, #0xFFFFFFFF
	cmp	x11, x12
	b.hs	Lspos_exhausted
	add	x12, x11, #1
Lspos_cas:
	ldaxr	x9, [x0]
	cbnz	x9, Lspos_lost
	stlxr	w13, x12, [x0]
	cbnz	w13, Lspos_cas
	mov	x0, x12
	ret
Lspos_lost:
	clrex
Lspos_have:
	mov	x0, x9
	ret
Lspos_exhausted:
	mov	x0, #0
	ret
; _silica_rt_ident_assign(X0 = a new ACB, X1 = its spawner's record) -> X0 = 0 (identity at #408, in
; the table), 1 the spawner's numbers are exhausted, 2 no memory.
	.globl	_silica_rt_ident_assign
	.p2align	2
_silica_rt_ident_assign:
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	mov	x19, x0
	mov	x20, x1
	mov	x0, x20
	bl	_silica_rt_spawner_position
	cbz	x0, Lia_exhausted
	sub	x9, x0, #1
	add	x10, x20, #8
Lia_child:
	ldaxr	x11, [x10]
	add	x12, x11, #1
	stlxr	w13, x12, [x10]
	cbnz	w13, Lia_child
	lsr	x12, x11, #32
	cbnz	x12, Lia_exhausted
	orr	x11, x11, x9, lsl #32
	str	x11, [x19, #408]
	mov	x0, x19
	bl	_silica_rt_idt_insert
	cbz	x0, Lia_ret
	mov	x0, #2
	b	Lia_ret
Lia_exhausted:
	mov	x0, #1
Lia_ret:
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
; _silica_rt_identity_exhausted: the spawner ran out of child numbers or positions (§15.1.4). The
; current actor fails with (:explicit, :identity_exhausted); main (no actor) prints the atom's name
; and exits with status 1. Never returns.
	.globl	_silica_rt_identity_exhausted
	.p2align	2
_silica_rt_identity_exhausted:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, Lie_main
	adrp	x8, _silica_rt_identity_exhausted_atom@PAGE
	add	x8, x8, _silica_rt_identity_exhausted_atom@PAGEOFF
	ldr	x1, [x8]
	bl	_silica_rt_actor_fail_current
Lie_main:
	mov	w0, #2
	adrp	x1, L_silica_identity_exhausted_msg@PAGE
	add	x1, x1, L_silica_identity_exhausted_msg@PAGEOFF
	mov	w2, #19
	bl	_write
	mov	w0, #1
	bl	_exit
	b	Lie_main
")
}

fn emit_actor_runtime_helpers(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    arena_asm: string <- ffi_arena_runtime_asm@emit_ffi_arena_runtime_asm();
    guarded_asm: string <- ffi_guarded_runtime_asm@emit_guarded_ffi_runtime_asm();
    fault_asm: string <- ffi_fault_runtime_asm@emit_ffi_fault_runtime_asm();
    canonical_arena_asm: string <- canonical_arena_runtime_asm@emit_canonical_arena_runtime_asm();
    ordering_identity_asm: string <- ordering_identity_runtime_asm@emit_ordering_identity_runtime_asm();
    checked_int64_asm: string <- checked_int64_runtime_asm@emit_checked_int64_runtime_asm();
    stack_asm: string <- concat(prims_actors_stack_asm@emit_actor_stack_runtime_asm(table), prims_actors_carrier_asm@emit_actor_carrier_runtime_asm());
