; actor, on a thread of its own, keeps the level and nothing reads it: the OS schedules its thread
; (the pthread QoS mapping of the thread-per-actor runtime is gone).
	cbz	x0, Lsp_not_found
	ldr	w9, [x0, #152]
	cbz	w9, Lsp_not_found
	cmp	x1, #3
	b.lo	Lsp_level_ok
	mov	x1, #1
Lsp_level_ok:
	str	x1, [x0, #520]
	mov	x0, #0
	ret
Lsp_not_found:
	mov	x0, #1
	ret
	.cfi_endproc
"
}

