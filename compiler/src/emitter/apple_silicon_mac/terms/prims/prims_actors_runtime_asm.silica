	bl	_os_unfair_lock_unlock
L_tlse_done:
	ldp	x29, x30, [sp, #16]
	ldp	x21, x20, [sp], #32
	ret
	.cfi_endproc
	.globl	_silica_rt_tls_current_actor_get
	.p2align	2
_silica_rt_tls_current_actor_get:
	.cfi_startproc
; -> X0 = this thread's current actor: the first word of the thread's record (the pthread key names
; it; _silica_rt_tls_record_set), 0 on a thread with no record (main before any drain) or whose
; record holds none (a carrier between actors).
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
