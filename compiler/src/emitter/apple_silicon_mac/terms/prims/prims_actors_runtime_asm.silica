// Phase G (cpu_topology_implementation_plan): heap layout matches expand_named_topology_type field order.
// Apple Silicon + macOS only: sysctl hw.*; numa_info/cache_info filled in _silica_rt_* below (see prims_actors_runtime_asm header).
// core_info.core_type is atom index: :efficiency = 0, :performance = 1 (emitter atom_table.silica pre-seed; only these two variants).
// P-cores (indices [0,P) per hw.perflevel0) -> :performance; E-cores [P,P+E) -> :efficiency.
// core_info on success: capabilities = _silica_rt_apple_hw_optional_caps_list() (shared pointer across topology.cores[]);
// frequency_mhz = 0 (sysctl does not expose core clock; hw.tbfrequency is not CPU MHz).
fn actor_rt_topology_phase_g_chunk() -> string {
    "	.globl	_silica_rt_get_cpu_topology
	.p2align	2
_silica_rt_get_cpu_topology:
	.cfi_startproc
	stp	x29, x30, [sp, #-96]!
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	stp	x25, x26, [sp, #64]
	stp	x27, x28, [sp, #80]
	mov	x29, sp
	sub	sp, sp, #16
	mov	w0, #4
	str	w0, [sp, #8]
	str	wzr, [sp]
	adrp	x0, L_hw_perf0_str@PAGE
	add	x0, x0, L_hw_perf0_str@PAGEOFF
	mov	x1, sp
	add	x2, sp, #8
	mov	x3, xzr
	mov	x4, xzr
	bl	_sysctlbyname
	cbnz	w0, L_topo_sysctl_fail
	ldr	w19, [sp]
	mov	w0, #4
	str	w0, [sp, #8]
	str	wzr, [sp]
	adrp	x0, L_hw_perf1_str@PAGE
	add	x0, x0, L_hw_perf1_str@PAGEOFF
	mov	x1, sp
	add	x2, sp, #8
	mov	x3, xzr
	mov	x4, xzr
	bl	_sysctlbyname
	cbnz	w0, L_topo_sysctl_fail
	ldr	w20, [sp]
	add	sp, sp, #16
	add	w21, w19, w20
	cbz	w21, L_topo_fail_zero
	bl	_silica_rt_apple_hw_optional_caps_list
	mov	x26, x0
	mov	x22, xzr
	subs	w9, w21, #1
	b.lt	L_topo_after_cores
L_topo_core_loop:
	mov	w10, w9
	mov	x0, #40
	bl	_malloc
	cbz	x0, L_topo_fail_zero
	mov	x23, x0
	movz	x11, #1, lsl #16
	movk	x11, #1
	str	x11, [x23]
	uxtw	x10, w10
	str	x10, [x23, #8]
	cmp	w10, w19
	mov	w11, #1
	mov	w12, #0
	csel	w11, w11, w12, lt
	uxtw	x11, w11
	str	x11, [x23, #16]
	str	x26, [x23, #24]
	str	xzr, [x23, #32]
	mov	x0, #16
	bl	_malloc
	cbz	x0, L_topo_fail_zero
	mov	x1, x23
	mov	x2, x22
	str	x1, [x0]
	str	x2, [x0, #8]
	mov	x22, x0
	subs	w9, w9, #1
	b.ge	L_topo_core_loop
L_topo_after_cores:
	mov	x0, xzr
	uxtw	x1, w21
	bl	_silica_rt_build_int_range_list
	mov	x24, x0
	mov	x28, x24
	adrp	x0, L_hw_memsize_str@PAGE
	add	x0, x0, L_hw_memsize_str@PAGEOFF
	bl	_silica_rt_sysctl_u64
	cbz	x0, L_topo_fail_zero
	mov	x27, x0
	mov	x0, #32
	bl	_malloc
	cbz	x0, L_topo_fail_zero
; memory_range: one NUMA node (Apple Silicon has no multi-domain sysctl matrix). start=0 = domain origin in this layout;
; macOS sysctl does not expose physical DRAM base per node — size is real (hw.memsize bytes). latency=0 = local self-
; distance (ACPI SLIT-style relative units: same node as itself), not an OS picoseconds value.
	movz	x9, #1, lsl #16
	movk	x9, #4
	str	x9, [x0]
	str	xzr, [x0, #8]
	str	x27, [x0, #16]
	str	xzr, [x0, #24]
	mov	x23, x0
	mov	x0, #16
	bl	_malloc
	cbz	x0, L_topo_fail_zero
	str	x23, [x0]
	str	xzr, [x0, #8]
	mov	x23, x0
	mov	x0, #32
	bl	_malloc
	cbz	x0, L_topo_fail_zero
	movz	x9, #1, lsl #16
	movk	x9, #3
	str	x9, [x0]
	str	xzr, [x0, #8]
	str	x28, [x0, #16]
	str	x23, [x0, #24]
	mov	x23, x0
	mov	x0, #16
	bl	_malloc
	cbz	x0, L_topo_fail_zero
	str	x23, [x0]
	str	xzr, [x0, #8]
	mov	x26, x0
	uxtw	x0, w19
	uxtw	x1, w20
	uxtw	x2, w21
	mov	x3, x28
	bl	_silica_rt_apple_build_cache_levels
	mov	x25, x0
	mov	x0, #32
