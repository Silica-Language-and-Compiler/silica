// Memory region prim emission: alloc_region, alloc_ref, alloc_rec, read_ref, write_ref,
// alloc_buf, buf_load, buf_store, read_buf, write_buf, fresh_lifetime,
// canonical_arena_lookup, canonical_arena_same, ref_eq, ref_in_region
// sir_design_spec §7.4, §7.5; silica-specification §12.1.2
// Heap-based allocation per spec: regions are heap-allocated with scope-tied deallocation.
// Arena layout: [0:8]=bump, [8:16]=end of the block being filled, [16:24]=head of the chain of
// extension blocks, [24:32]=this block's own data end; data at offset 32. First block is 4096
// bytes of data, so 4128 in total.
//
// A region is not a fixed-size buffer. When the current block cannot satisfy an allocation,
// L_region_grow attaches another block and the allocation retries against it, so the only hard
// failure left is the underlying allocator returning nothing. This matters because the region
// holds whatever the program puts in it: the compiler's own atom table filled 4096 bytes after
// eleven atoms, and a fixed arena aborted there.
//
// The region handle is the address of the first block and never moves, so refs handed out before
// a growth stay valid. Each block records its own span at [24:32] and the next block at [16:24],
// which is what lets ref_in_region still answer for a ref allocated from an earlier block.

use prims_tuple;
use atom_table;

export is_memory_prim/1;
export emit_prim_op/2;
export emit_buf_bounds_check/3;
export emit_buf_store/3;
export module_uses_region_allocation/1;
export module_uses_alloc_region/1;
export emit_region_helpers/0;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn is_memory_prim(name: string) -> boolean {
    name == "alloc_region" or name == "alloc_ref" or name == "alloc_rec" or name == "read_ref" or name == "write_ref" or name == "alloc_buf" or name == "buf_load" or name == "buf_store" or name == "read_buf" or name == "write_buf" or name == "fresh_lifetime" or name == "canonical_arena_lookup" or name == "canonical_arena_same" or name == "ref_eq" or name == "ref_in_region"
}

// ref_eq(a, b): X1 = ref A, X2 = ref B -> boolean in dest (pointer identity).
fn emit_ref_eq(dest: string) -> string {
    cmp: string <- "    CMP X1, X2\n";
    cset: string <- "    CSET W5, EQ\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X5");
    concat(concat(cmp, cset), mov_dest)
}

// ref_in_region(ref, region): X1 = ref cell, X2 = region base -> boolean in dest.
// A region can span several blocks, so this asks the helper rather than comparing against one
// pair of bounds: testing only [region+32, end) would call a ref false as soon as the region grew
// past the block that ref came from.
fn emit_ref_in_region(dest: string) -> string {
    concat("    BL L_region_contains\n", concat(concat("    MOV ", dest), ", X5"))
}

// canonical_arena_lookup(key): X1 = int64 specialization key -> region base in dest.
fn emit_canonical_arena_lookup(dest: string) -> string {
    mov_key: string <- "    MOV X0, X1\n";
    bl_lookup: string <- "    BL _silica_rt_canonical_arena_lookup\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X0");
    concat(concat(mov_key, bl_lookup), mov_dest)
}

// canonical_arena_same(r1, r2): X1 = region A, X2 = region B -> boolean in dest.
fn emit_canonical_arena_same(dest: string) -> string {
    mov_a: string <- "    MOV X0, X1\n";
    mov_b: string <- "    MOV X1, X2\n";
    bl_same: string <- "    BL _silica_rt_canonical_arena_same\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X0");
    concat(concat(concat(concat(mov_a, mov_b), bl_same), "\n"), mov_dest)
}

// alloc_region(space): allocate arena on heap via malloc, return region base.
// Region layout: [base+0]=bump (starts at base+32), [base+8]=end, [base+16]=extensions, [base+24]=span end.
// Operands: X1 = space (unused; memory space would configure MAIR at runtime)
fn emit_alloc_region(dest: string) -> string {
    mov_size: string <- "    MOV X0, #4128\n";
    bl_malloc: string <- "    BL _silica_rt_raw_alloc\n";
    // No block: the current actor ends with (:explicit, :region_alloc_failed), main aborts (H5).
    null_check: string <- "    CBNZ X0, 1f\n    BL _silica_rt_region_alloc_failed\n1:\n";
    add_bump: string <- "    ADD X4, X0, #32\n";
    str_bump: string <- "    STR X4, [X0]\n";
    // 4128 > 4095: cannot use single ADD #imm; use reg + reg (Apple clang rejects ADD X4, X0, #4128).
    mov_arena_sz: string <- "    MOV X5, #4128\n";
    add_end: string <- "    ADD X4, X0, X5\n";
    str_end: string <- "    STR X4, [X0, #8]\n";
    // No extension blocks yet, and the first block's span ends where its bump limit does.
    str_no_ext: string <- "    STR XZR, [X0, #16]\n";
    str_span_end: string <- "    STR X4, [X0, #24]\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X0");
    part1: string <- concat(mov_size, concat(bl_malloc, null_check));
    part2: string <- concat(part1, concat(add_bump, str_bump));
    part3: string <- concat(part2, concat(mov_arena_sz, concat(add_end, str_end)));
    part4: string <- concat(part3, concat(str_no_ext, str_span_end));
    concat(part4, mov_dest)
}

// The reservation every region allocation shares. `size_math` must leave the request in bytes in
// X7 (X7-X9 are scratch in every prim sequence: alloc_buf already computes its byte count there).
// Afterwards X3 is the start of the reserved bytes, X4 the block's end and X5 the new bump, and
// the bump is already published: the sites must not store it again.
//
// The bump is moved with an exclusive pair (design region_memory_safety_design.md §9.4, H1): a
// canonical arena is process-shared, and two actors allocating in the same arena from two threads
// used to read one bump, each write bump+size, and hand out the same cell. LDAXR/STXR costs the
// uncontended path a monitor set and a store-exclusive, nothing more; the LSE LDADD would not do,
// because the bound against the block's end has to hold before the bump moves. The pair also makes
// a growth safe: L_region_grow (below) parks a sentinel in the bump before it publishes the new
// block, so a reservation that read the old bump either sees a request that cannot fit or finds the
// word changed under its STXR and starts over, and the end is read after the bump so the acquire
// orders it (the grow publishes the end before the bump with a release store).
//
// Nothing is moved into place for the grow call: L_region_grow reads the region from X1 and the
// request from X7, both of which the site set up for the reservation. Setting up argument registers
// instead would corrupt the caller on exactly the rare path that is hardest to notice -- the emitter
// stages call arguments in X0-X7, so a `MOV X6, X1` here destroys a staged argument, but only in
// the runs where the region happened to fill up.
//
// Numeric local labels, so the sites need no unique names: 2 is the retry, 3 the grow, 1 the exit.
fn emit_region_bump_check(size_math: string) -> string {
    reserve: string <- "2:\n    LDAXR X3, [X1]\n    LDR X4, [X1, #8]\n    ADD X5, X3, X7\n    CMP X5, X4\n    B.HI 3f\n    STXR W17, X5, [X1]\n    CBNZ W17, 2b\n    B 1f\n";
    grow: string <- "3:\n    BL L_region_grow\n    B 2b\n1:\n";
    concat(size_math, concat(reserve, grow))
}

fn memory_type_is_tuple(type_name: string) -> boolean {
    length_bytes(type_name) >= 2 and substring(type_name, 0, 1) == "("
}

fn memory_value_is_tuple_like(value: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(value);
    case memory_type_is_tuple(node.type_name) of {
        true -> true;
        false -> node.kind == 6 and node.name == "tuple_make"
    }
}

fn memory_tuple_word_count(value: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(value);
    case node.kind == 6 and node.name == "tuple_make" of {
        true -> prims_tuple@count_flat_elements(value);
        false -> prims_tuple@count_type_elements(node.type_name)
    }
}

// alloc_ref(region, scalar): reserve one cell in region, store value, return ref.
// Operands: X1 = region base, X2 = value. Region [X1]=bump, [X1+8]=end.
// The reservation grows the region when bump+8 > end and publishes the bump itself.
fn emit_alloc_ref_scalar(dest: string) -> string {
    mov_size: string <- "    MOV X7, #8\n";
    mov_ref: string <- "    MOV X4, X3\n";
    str_val: string <- "    STR X2, [X3]\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X4");
    check: string <- emit_region_bump_check(mov_size);
    alloc: string <- concat(concat(mov_ref, str_val), mov_dest);
    concat(check, alloc)
}

// alloc_ref(region, tuple): reserve a ref cell plus a stable copy of the
// complete tuple in the region. The ref cell contains the tuple address, so
// read_ref still uses one load and the temporary tuple stack slab does not escape.
fn emit_alloc_ref_tuple(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    emit_alloc_rec(term, dest)
}

fn emit_alloc_ref(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    case memory_type_is_tuple(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).type_name) of {
        true -> emit_alloc_ref_tuple(term, dest);
        false -> emit_alloc_ref_scalar(dest)
    }
}

// read_ref(ref): load value from ref
// Operands: X1 = ref (pointer)
fn emit_read_ref(dest: string) -> string {
    concat(concat(concat("    LDR ", dest), ", [X1]"), "")
}

fn emit_write_ref_tuple_copy_words(word_index: int64, word_count: int64) -> string {
    emit_alloc_rec_copy_words(word_index, word_count)
}

// write_ref(ref, scalar): store value at ref
// Operands: X1 = ref, X2 = value. Returns unit.
fn emit_write_ref_scalar(dest: string) -> string {
    concat("    STR X2, [X1]", "")
}

// write_ref(ref, tuple): copy the tuple words into the region-owned payload
// already referenced by the cell. This keeps read_ref's one-load representation
// and avoids publishing a transient stack tuple pointer.
fn emit_write_ref_tuple(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    tuple_count: int64 <- memory_tuple_word_count(sir_term_at(term, sir_term_root_node(term).right_expr));
    tuple_bytes: int64 <- prims_tuple@flat_alloc_size(tuple_count);
    payload: string <- "    LDR X6, [X1]\n";
    copy: string <- emit_write_ref_tuple_copy_words(0, tuple_bytes / 8);
    concat(payload, copy)
}

fn emit_write_ref(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    case memory_value_is_tuple_like(sir_term_at(term, sir_term_root_node(term).right_expr)) of {
        true -> emit_write_ref_tuple(term, dest);
        false -> emit_write_ref_scalar(dest)
    }
}

// alloc_buf(region, N): bump-allocate buffer of N elements within region.
// Operands: X1 = region, X2 = N (element count). Rejects negative N, byte-size overflow, and arena overflow.
fn elem_size_shift_from_buf_type(buf_type: string) -> int64 {
    case memory_type_contains(buf_type, "int8") of {
        true -> 0;
        false -> case memory_type_contains(buf_type, "uint8") of {
            true -> 0;
            false -> case memory_type_contains(buf_type, "int16") of {
                true -> 1;
                false -> case memory_type_contains(buf_type, "uint16") of {
                    true -> 1;
                    false -> case memory_type_contains(buf_type, "int32") of {
                        true -> 2;
                        false -> case memory_type_contains(buf_type, "uint32") of {
                            true -> 2;
                            false -> 3
                        }
                    }
                }
            }
        }
    }
}

fn elem_size_bytes_from_buf_type(buf_type: string) -> int64 {
    shift: int64 <- elem_size_shift_from_buf_type(buf_type);
    case shift of {
        0 -> 1;
        1 -> 2;
        2 -> 4;
        _: int64 -> 8
    }
}

// Layout (spec §12.3.3, §15.4.5.5): one length word, then the elements. The buffer value points at
// element 0 and the element count sits in the word just below it, so every buf_load / buf_store
// checks its index against [buf, #-8] in constant time whatever scope the buffer came from (a
// parameter's type may name its size N by an identifier that is not in scope there). The whole
// block is rounded up to 8 bytes so the next allocation in the region stays word-aligned.
fn emit_alloc_buf(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    elem_bytes: int64 <- elem_size_bytes_from_buf_type(sir_term_root_node(term).type_name);
    eb: string <- int64_to_str(elem_bytes);
    neg_check: string <- "    CMP X2, #0\n    B.LT L_buf_invalid\n";
    mov_elem: string <- concat(concat("    MOV X8, #", eb), "\n");
    mul_bytes: string <- "    MUL X7, X2, X8\n";
    mul_ov: string <- "    SDIV X9, X7, X8\n    CMP X9, X2\n    B.NE L_buf_invalid\n";
    // X7 = element bytes + 8 (the length word), rounded up to a multiple of 8: the request the
    // reservation takes.
    with_len: string <- "    ADD X7, X7, #15\n    AND X7, X7, #0xfffffffffffffff8\n";
    mov_buf: string <- "    MOV X4, X3\n";
    store_len: string <- "    STR X2, [X4], #8\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X4");
    size_calc1: string <- concat(neg_check, mov_elem);
    size_calc: string <- concat(size_calc1, concat(mul_bytes, concat(mul_ov, with_len)));
    check: string <- emit_region_bump_check(size_calc);
    alloc: string <- concat(concat(mov_buf, store_len), mov_dest);
    concat(check, alloc)
}

fn int64_to_str(n: int64) -> string {
    case n of {
        0 -> "0";
        1 -> "1";
        2 -> "2";
        3 -> "3";
        4 -> "4";
        8 -> "8";
        _: int64 -> "8"
    }
}

// Bounds check before every buf_load / buf_store (spec §12.3.3): X1 = buffer, X2 = index. The
// element count is the word below element 0 (emit_alloc_buf). One unsigned compare rejects both an
// index at or past the length and a negative index. X17 (IP1) is scratch here: nothing is live in it
// across a buffer access.
fn emit_buf_bounds_check(_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, _outer_reg: string, _label_sfx: string) -> string {
    "    LDR X17, [X1, #-8]\n    CMP X2, X17\n    B.HS L_buf_bounds\n"
}

fn memory_type_contains_from(h: string, needle: string, i: int64) -> boolean {
    case length_bytes(needle) == 0 of {
        true -> true;
        false -> case i + length_bytes(needle) > length_bytes(h) of {
            true -> false;
            false -> case substring(h, i, i + length_bytes(needle)) == needle of {
                true -> true;
                false -> memory_type_contains_from(h, needle, i + 1)
            }
        }
    }
}

fn memory_type_contains(h: string, needle: string) -> boolean {
    memory_type_contains_from(h, needle, 0)
}

fn w_reg_from_gpr(reg: string) -> string {
    case length_bytes(reg) > 0 of {
        true -> case substring(reg, 0, 1) == "X" of {
            true -> concat("W", substring(reg, 1, length_bytes(reg)));
            false -> reg
        };
        false -> reg
    }
}

// buf_load(buf, index): load from buf[index] after optional bounds check in caller wrapper.
fn emit_buf_load(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    wd: string <- w_reg_from_gpr(dest);
    case sir_term_root_node(term).type_name of {
        "int8" -> concat(concat("    LDRSB ", wd), ", [X1, X2]");
        "uint8" -> concat(concat("    LDRB ", wd), ", [X1, X2]");
        "int16" -> concat(concat("    LDRSH ", wd), ", [X1, X2, LSL #1]");
        "uint16" -> concat(concat("    LDRH ", wd), ", [X1, X2, LSL #1]");
        "int32" -> concat(concat("    LDR ", wd), ", [X1, X2, LSL #2]");
        "uint32" -> concat(concat("    LDR ", wd), ", [X1, X2, LSL #2]");
        _: string -> concat(concat("    LDR ", dest), ", [X1, X2, LSL #3]")
    }
}

fn buf_store_value_type(tuple_type: string) -> string {
    case memory_type_contains(tuple_type, "int8") of {
        true -> "int8";
        false -> case memory_type_contains(tuple_type, "uint8") of {
            true -> "uint8";
            false -> case memory_type_contains(tuple_type, "int16") of {
                true -> "int16";
                false -> case memory_type_contains(tuple_type, "uint16") of {
                    true -> "uint16";
                    false -> case memory_type_contains(tuple_type, "int32") of {
                        true -> "int32";
                        false -> case memory_type_contains(tuple_type, "uint32") of {
                            true -> "uint32";
                            false -> "int64"
                        }
                    }
                }
            }
        }
    }
}

// buf_store(buf, index, value): store value at buf[index]
// Operands: X1 = buf, X2 = pointer to tuple(index, value) from tuple_make.
fn emit_buf_store(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, outer_reg: string) -> string {
    value_type: string <- buf_store_value_type(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).type_name);
    ldr_val: string <- case value_type of {
        "int8" -> "    LDRSB W3, [X2, #8]\n";
        "uint8" -> "    LDRB W3, [X2, #8]\n";
        "int16" -> "    LDRSH W3, [X2, #8]\n";
        "uint16" -> "    LDRH W3, [X2, #8]\n";
        "int32" -> "    LDR W3, [X2, #8]\n";
        "uint32" -> "    LDR W3, [X2, #8]\n";
        _: string -> "    LDR X3, [X2, #8]\n"
    };
    ldr_idx: string <- "    LDR X2, [X2]\n";
    bounds: string <- emit_buf_bounds_check(term, outer_reg, dest);
    str_asm: string <- case value_type of {
        "int8" -> "    STRB W3, [X1, X2]";
        "uint8" -> "    STRB W3, [X1, X2]";
        "int16" -> "    STRH W3, [X1, X2, LSL #1]";
        "uint16" -> "    STRH W3, [X1, X2, LSL #1]";
        "int32" -> "    STR W3, [X1, X2, LSL #2]";
        "uint32" -> "    STR W3, [X1, X2, LSL #2]";
        _: string -> "    STR X3, [X1, X2, LSL #3]"
    };
    concat(concat(concat(ldr_val, ldr_idx), bounds), str_asm)
}

// fresh_lifetime(): returns unique lifetime value. No args.
// Stack-based: use SP as unique identifier (each call has distinct SP).
fn emit_fresh_lifetime(dest: string) -> string {
    concat(concat("    MOV ", dest), ", SP")
}

fn emit_alloc_rec_copy_words(word_index: int64, word_count: int64) -> string {
    case word_index >= word_count of {
        true -> "";
        false -> {
            offset: string <- atom_table@int64_to_decimal_string(word_index * 8);
            load: string <- concat(concat("    LDR X7, [X2, #", offset), "]\n");
            store: string <- concat(concat("    STR X7, [X6, #", offset), "]\n");
            concat(concat(load, store), emit_alloc_rec_copy_words(word_index + 1, word_count))
        }
    }
}

// alloc_rec(region, tuple_value): reserve one ref cell plus a stable copy of the
// complete tuple in the region. The ref cell contains the tuple address, so
// read_ref retains the same one-load representation as alloc_ref. tuple_value
// is a temporary stack slab and must never escape directly.
fn emit_alloc_rec(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    tuple_count: int64 <- prims_tuple@count_type_elements(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).type_name);
    tuple_bytes: int64 <- prims_tuple@flat_alloc_size(tuple_count);
    allocation_bytes: int64 <- tuple_bytes + 8;
    allocation_text: string <- atom_table@int64_to_decimal_string(allocation_bytes);
    mov_size: string <- concat(concat("    MOV X7, #", allocation_text), "\n");
    bounds: string <- emit_region_bump_check(mov_size);
    retain_ref: string <- "    MOV X4, X3\n";
    payload: string <- "    ADD X6, X3, #8\n    STR X6, [X4]\n";
    copy: string <- emit_alloc_rec_copy_words(0, tuple_bytes / 8);
    mov_dest: string <- concat(concat("    MOV ", dest), ", X4");
    concat(concat(concat(concat(bounds, retain_ref), payload), copy), mov_dest)
}

// A buffer access branches to L_buf_bounds (emit_buf_bounds_check), which emit_region_helpers
// defines, so a module whose only buffer use is reading a buffer it was passed needs the helpers too.
fn is_buf_access_prim(name: string) -> boolean {
    name == "buf_load" or name == "read_buf" or name == "buf_store" or name == "write_buf"
}

// Descends into the children of every kind rather than a list of the kinds that were expected to
// have any. It used to name kinds 2..6 and so never looked inside a case branch (kinds 7 and 8): a
// program whose only allocation sat in a case arm reported no region use, the helpers were left
// out, and the module failed to assemble on an undefined L_region_grow.
// See trials/codegen_regressions/region_grow.silica.
fn term_has_region_allocation(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> case sir_term_root_node(term).kind == 6 and (sir_term_root_node(term).name == "alloc_ref" or sir_term_root_node(term).name == "alloc_buf" or sir_term_root_node(term).name == "alloc_rec" or is_buf_access_prim(sir_term_root_node(term).name)) of {
            true -> true;
            false -> case term_has_region_allocation(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_region_allocation(sir_term_at(term, sir_term_root_node(term).right_expr))
            }
        }
    }
}

fn region_allocation_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_region_allocation(fns.head.body) of {
            true -> true;
            false -> region_allocation_in_functions(fns.tail)
        }
    }
}

fn module_uses_region_allocation(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    region_allocation_in_functions(sir_module.functions)
}

// True when emitted code calls _silica_rt_region_alloc (alloc_region prim only).
// Used to append the malloc stub; separate from module_uses_region_allocation (arena bump overflow).
fn term_has_alloc_region(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> case sir_term_root_node(term).kind == 6 and sir_term_root_node(term).name == "alloc_region" of {
            true -> true;
            false -> case term_has_alloc_region(sir_term_at(term, sir_term_root_node(term).inner)) of {
                true -> true;
                false -> term_has_alloc_region(sir_term_at(term, sir_term_root_node(term).right_expr))
            }
        }
    }
}

fn alloc_region_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_alloc_region(fns.head.body) of {
            true -> true;
            false -> alloc_region_in_functions(fns.tail)
        }
    }
}

fn module_uses_alloc_region(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    alloc_region_in_functions(sir_module.functions)
}

// L_region_grow(X1 = region, X7 = bytes wanted): attach a block that can hold the request and point
// the region's bump/end at it. Preserves every general register, because it is called from the
// middle of an allocation sequence that still holds the value being stored: the caller only
// retries its reservation afterwards. X19/X20 are saved for the same reason and are safe to use
// across _silica_rt_raw_alloc, which preserves them.
//
// A block is at least 4096 data bytes so ordinary allocation keeps amortizing over one call, and
// exactly the (16-byte rounded) request when that is larger, which is what makes a buffer bigger
// than a block work at all. L_region_overflow remains for the one failure that is still fatal:
// the allocator handing back nothing.
//
// Growth is serialized by _silica_rt_region_lock (one process-wide word in the runtime module,
// canonical_arena_runtime_asm; growth is one call per block, so one lock for every region costs
// nothing measurable). Under the lock the request is checked again, because the grower that got
// there first may already have attached a block this request fits; then a sentinel (2^62, above
// every user address, and bump + request cannot wrap) is parked in the bump so no concurrent
// reservation can land in the old block while the new one is being published, the block is
// chained and its end stored, and the bump is published last with a release store. The reservation
// loop's acquire load of the bump therefore sees the matching end. The lock is released before
// the overflow branch so an allocation failure that ends only the current actor leaves the lock
// free; the sentinel stays, and the next reservation in that region tries to grow again.
// Region release (silica-specification 12.1.2): free a region and every extension
// block chained off [base+16]. A region is a discrete malloc'd pool, so releasing
// one is independent of every other region -- no arena rewind, no ordering
// requirement. Safe because no pointer into a region may escape without the
// region itself, so at scope exit nothing outside can reference it.
fn emit_region_free_helper() -> string {
    "    .globl _silica_rt_region_free\n_silica_rt_region_free:\n    CBZ X0, L_rf_null\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    MOV X19, X0\n    LDR X20, [X19, #16]\nL_rf_loop:\n    CBZ X20, L_rf_root\n    LDR X1, [X20, #16]\n    MOV X0, X20\n    MOV X20, X1\n    BL _free\n    B L_rf_loop\nL_rf_root:\n    STR XZR, [X19, #16]\n    MOV X0, X19\n    BL _free\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\nL_rf_null:\n    RET\n"
}

fn emit_region_grow_helper() -> string {
    save1: string <- "L_region_grow:\n    STP X29, X30, [SP, #-16]!\n    MOV X29, SP\n    STP X19, X20, [SP, #-16]!\n";
    save2: string <- "    STP X0, X1, [SP, #-16]!\n    STP X2, X3, [SP, #-16]!\n    STP X4, X5, [SP, #-16]!\n    STP X6, X7, [SP, #-16]!\n";
    save3: string <- "    STP X8, X9, [SP, #-16]!\n    STP X10, X11, [SP, #-16]!\n    STP X12, X13, [SP, #-16]!\n    STP X14, X15, [SP, #-16]!\n";
    save4: string <- "    STP X16, X17, [SP, #-16]!\n    STR X18, [SP, #-16]!\n";
    size: string <- "    MOV X19, X1\n    ADD X20, X7, #15\n    BIC X20, X20, #15\n    MOV X9, #4096\n    CMP X20, X9\n    B.HS 1f\n    MOV X20, X9\n1:\n";
    lock: string <- "    ADRP X9, _silica_rt_region_lock@PAGE\n    ADD X9, X9, _silica_rt_region_lock@PAGEOFF\n    MOV W11, #1\n2:\n    LDAXR W10, [X9]\n    CBNZ W10, 2b\n    STXR W12, W11, [X9]\n    CBNZ W12, 2b\n";
    recheck: string <- "    LDR X3, [X19]\n    LDR X4, [X19, #8]\n    ADD X5, X3, X7\n    CMP X5, X4\n    B.LS 4f\n    MOV X10, #1\n    LSL X10, X10, #62\n    STLR X10, [X19]\n";
    alloc: string <- "    ADD X0, X20, #32\n    BL _silica_rt_raw_alloc\n    CBZ X0, 5f\n";
    span: string <- "    ADD X1, X0, #32\n    ADD X2, X1, X20\n    STR X2, [X0, #24]\n";
    chain: string <- "    LDR X3, [X19, #16]\n    STR X3, [X0, #16]\n    ADD X11, X19, #16\n    STLR X0, [X11]\n";
    publish: string <- "    STR X2, [X19, #8]\n    STLR X1, [X19]\n4:\n    ADRP X9, _silica_rt_region_lock@PAGE\n    ADD X9, X9, _silica_rt_region_lock@PAGEOFF\n    STLR WZR, [X9]\n";
    restore1: string <- "    LDR X18, [SP], #16\n    LDP X16, X17, [SP], #16\n";
    restore2: string <- "    LDP X14, X15, [SP], #16\n    LDP X12, X13, [SP], #16\n    LDP X10, X11, [SP], #16\n    LDP X8, X9, [SP], #16\n";
    restore3: string <- "    LDP X6, X7, [SP], #16\n    LDP X4, X5, [SP], #16\n    LDP X2, X3, [SP], #16\n    LDP X0, X1, [SP], #16\n";
    restore4: string <- "    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\n";
    failed: string <- "5:\n    ADRP X9, _silica_rt_region_lock@PAGE\n    ADD X9, X9, _silica_rt_region_lock@PAGEOFF\n    STLR WZR, [X9]\n    B L_region_overflow\n";
    saves: string <- concat(save1, concat(save2, concat(save3, save4)));
    work: string <- concat(size, concat(lock, concat(recheck, concat(alloc, concat(span, concat(chain, publish))))));
    restores: string <- concat(restore1, concat(restore2, concat(restore3, restore4)));
    concat(saves, concat(work, concat(restores, failed)))
}

// L_region_contains(X1 = ref, X2 = region) -> X5 = 0 or 1: is the ref one this region handed out?
// The first block's data starts at region+32 and the rest hang off [region+16], each carrying its
// own end at [block+24], so a ref from a block filled before the region grew still answers true.
//
// X5 is the only register this leaves changed. The walk needs two scratch registers and borrows
// X6/X7, but restores them: ref_in_region runs on every operation of a region-backed map, and the
// emitter stages a call's seventh and eighth arguments in exactly those two registers.
fn emit_region_contains_helper() -> string {
    head: string <- "L_region_contains:\n    STP X6, X7, [SP, #-16]!\n    ADD X6, X2, #32\n    LDR X7, [X2, #24]\n    CMP X1, X6\n    B.LO 2f\n    CMP X1, X7\n    B.LO 3f\n";
    walk: string <- "2:\n    LDR X6, [X2, #16]\n1:\n    CBZ X6, 4f\n    ADD X7, X6, #32\n    CMP X1, X7\n    B.LO 5f\n    LDR X7, [X6, #24]\n    CMP X1, X7\n    B.LO 3f\n5:\n    LDR X6, [X6, #16]\n    B 1b\n";
    answer: string <- "3:\n    MOV X5, #1\n    LDP X6, X7, [SP], #16\n    RET\n4:\n    MOV X5, #0\n    LDP X6, X7, [SP], #16\n    RET\n";
    concat(head, concat(walk, answer))
}

// The three failure labels end the current actor with (:explicit, :region_alloc_failed / :buf_invalid /
// :buf_bounds) and abort the process (71) in main (design region_memory_safety_design.md H5 and Q9 (a),
// runtime entries in prims_actors_stack_asm); the access or allocation was never performed.
fn emit_region_helpers() -> string {
    aborts: string <- "L_region_overflow:\n    BL _silica_rt_region_alloc_failed\nL_buf_invalid:\n    BL _silica_rt_buf_invalid_failed\nL_buf_bounds:\n    BL _silica_rt_buf_bounds_failed\n";
    concat(aborts, concat(emit_region_grow_helper(), emit_region_contains_helper()))
}

fn emit_prim_op(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string) -> string {
    case sir_term_root_node(term).name of {
        "alloc_region" -> emit_alloc_region(dest);
        "alloc_ref" -> emit_alloc_ref(term, dest);
        "alloc_rec" -> emit_alloc_rec(term, dest);
        "read_ref" -> emit_read_ref(dest);
        "write_ref" -> emit_write_ref(term, dest);
        "alloc_buf" -> emit_alloc_buf(term, dest);
        "buf_load" -> emit_buf_load(term, dest);
        "buf_store" -> emit_buf_store(term, dest, "");
        "read_buf" -> emit_buf_load(term, dest);
        "write_buf" -> emit_buf_store(term, dest, "");
        "fresh_lifetime" -> emit_fresh_lifetime(dest);
        "canonical_arena_lookup" -> emit_canonical_arena_lookup(dest);
        "canonical_arena_same" -> emit_canonical_arena_same(dest);
        "ref_eq" -> emit_ref_eq(dest);
        "ref_in_region" -> emit_ref_in_region(dest);
        _: string -> concat(concat(".error \"unsupported memory prim: ", concat(sir_term_root_node(term).name, "\"\n")), "")
    }
}
