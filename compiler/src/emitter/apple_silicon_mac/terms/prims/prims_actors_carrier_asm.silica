// Carrier threads (actor_memory_budget_plan.md item N, stages 1 and 2; ROADMAP chunk 2, hosted part).
//
// Behind a process-start gate: `SILICA_CARRIERS=1` in the environment, read once by
// _silica_rt_stack_runtime_init into _silica_rt_carriers_enabled. Off (the default), every actor is
// its own thread as before and nothing here runs. On, N carrier threads, one per logical core
// (`hw.logicalcpu`; `SILICA_CARRIER_COUNT=<n>` in the environment overrides it, n >= 1), run every
// plain actor spawned without a start trampoline (workers; supervisors keep a thread each in this
// stage, as do dangerous actors and the runtime's own registry actors), on the BEAM pattern the
// board already uses per core (rt_actors.S sched_loop / yield_to_sched / make_ready):
//
//   - The carrier table (_silica_rt_carriers): N blocks of 128 B, calloc'd at the first adoption
//     (_silica_rt_carriers_ensure); a carrier's thread is created the first time an actor is bound
//     to it (_silica_rt_carrier_ensure_started). A block: +0 lock (os_unfair_lock), +8 futex word
//     the carrier sleeps on when its run queue is empty, +16 idle (1 while asleep), +24/+32 run
//     queue head/tail (control blocks linked through ACB #456), +40 the actor being run, +48 the
//     carrier's base SP, +56 its 64 KB signal alternate stack, +64 pthread_t, +72 started, +80
//     created, +88/+96 the thread's record (below), +104 the sweep list head (idle
//     :release_when_idle actors of this carrier still holding committed stack, linked through
//     ACB #456), +112 the carrier's index, +120 the time of its last sweep.
//   - The thread record: the pthread key (_silica_actor_pthread_key) names a two-word record per
//     thread, the current actor and the carrier (0 when the thread is not a carrier's). A carrier's
//     record is in its block (+88, +96 = the block itself) and the carrier writes the current actor
//     with a plain store at each dispatch (risk R2.1: no pthread_setspecific per switch); an actor
//     thread's is in its control block (#496, #504 = 0); main gets a calloc'd record the first
//     time something installs a current actor on it (an ingress drain). Every runtime entry and
//     the fault handler read the current actor through the record (_silica_rt_tls_current_actor_get),
//     and _silica_rt_on_carrier_thread is the record's second word.
//   - Binding: an actor is bound at adoption to one carrier (ACB #440) for its life. A nonzero
//     core id given to spawn (ACB #208; a row child's spec has none) binds it to carrier
//     `core mod N`, so a program that places on cores 1 and 2 lands on different carriers whenever
//     there are two and is deterministic at every N; without a core id the carriers are taken in
//     turn (_silica_rt_carrier_next, the board's rule in rt_actors.S spawn), which spreads the load
//     over the cores. Exclusive pinning, migration and priorities are stages 3 and 4.
//   - ACB fields (prims_actors_runtime_asm.silica layout): #440 the carrier (0 = a thread actor),
//     #448 status (0 none, 1 idle, 2 ready: in the run queue, 3 running, 4 parked in a runtime
//     wait, 5 idle on the carrier's sweep list), #456 run-queue, wait-list or sweep-list link, #464
//     the SP of a parked context (0 = none), #472 the actor parked in a spawn until this actor has
//     started, #480 the wait list the actor is parked on.
//   - Dispatch: the carrier pops a ready actor, writes its record's current actor and enters the
//     mailbox loop of _actor_thread_main (LBB1_loop) with X19 = the ACB, exactly as that actor's
//     own thread would. A behaviour runs on the actor's reservation with the carrier's SP kept in
//     ACB #368 and returns to the carrier on the dispatch boundary; the release algorithm then runs
//     on the carrier's stack. After the message the actor is re-queued when more mail waits, else
//     marked idle (_silica_rt_carrier_mark_idle: on the sweep list when it is :release_when_idle
//     and holds committed stack).
//   - The idle sweep: a carrier walks its sweep list (_silica_rt_carrier_sweep) before it sleeps
//     on an empty queue, waits with the earliest due time as its timeout, and, so that a busy
//     carrier releases too, at a dispatch at most every quarter second while the list is not
//     empty; an actor a second past its last message (ACB #344) is released by
//     _silica_rt_stack_idle_check, the same check an actor thread makes in its timed wait, and
//     leaves the list. The list changes only on the carrier's own thread (listing) or under the
//     carrier's lock (the sweep, and _silica_rt_carrier_unlist when mail makes a listed actor
//     ready).
//   - The carrier loop is re-entered afresh (SP reset to the base, current actor cleared) from every
//     path that leaves an actor: a dispatch boundary with an empty mailbox, an exit path (which runs
//     on the carrier's stack, like the board's scheduler running a faulted actor's exit), or a park.
//   - Parking: an actor that must wait inside a behaviour (a `call` awaiting its reply; a spawn
//     waiting for its child's start) saves X19-X30 and D8-D15 on its own stack, records that SP in
//     #464 and leaves for the carrier loop; the wake side (the reply, the call death, the child's
//     started store) moves it from parked to ready under the same lock the parker used and pushes
//     it on ITS carrier's run queue (_silica_rt_carrier_push reads #440: the waker may be on
//     another carrier, an actor thread or main), waking that carrier when it sleeps; the carrier
//     resumes it by reloading the context. The actor's return into the carrier's dispatch code
//     reads nothing from the carrier's abandoned frame: the node being dispatched is ACB #240.
//   - Mail: every wake of a mailbox (the sites that signalled ACB+80) goes through
//     _silica_rt_actor_mail_signal, which also makes an idle carrier actor ready on its own
//     carrier and wakes that carrier's futex when it sleeps; every wake of a call wrapper goes
//     through _silica_rt_call_wrapper_wake.
//   - The restart protocol's primitives live here (the protocol itself is described in
//     prims_actors_child_table_asm.silica's header): _silica_rt_row_wait, the one wait for a row
//     child's exit (kill_abnormal, terminate_child / remove_child / restart_child, a supervisor's
//     shutdown, a :one_for_all or :rest_for_one cascade), for one identity in the row's exit_done
//     (+56, a generation word that is never cleared); _silica_rt_actor_stop, the one way another
//     actor is ended, which also ends a wait the stopped actor is parked or spinning in;
//     _silica_rt_sup_restart_try / _acquire / _release, the supervision block's restart token
//     (#120) with one holder at a time and a wait list (+128) for carrier actors parked for it. A
//     carrier actor on its own stack parks (_silica_rt_wait_park): it links itself, through ACB
//     #456, into the list (its head's address kept in ACB #480) under _silica_rt_row_wait_lock,
//     which guards every wait list; the wake side (_silica_rt_wait_list_wake: the child's last act,
//     _silica_rt_row_exit_done_store, or a token release) holds it to take the list and never holds
//     it while it takes an actor's lock; a stop holds the actor's lock and then the wait lock to
//     unlink. The check and the push are one critical section, so no wake is lost. A wait entered
//     while the thread's current actor was another (an ingress drain installs the supervisor)
//     restores that actor after the resume. Anything that is not a carrier actor on its own stack
//     spins (main, an actor thread); a carrier actor on the carrier's own stack (an exit path) that
//     would spin for another carrier actor is a runtime abort rather than a silent deadlock.
//
// Lock order, with any number of carriers (an actor's lock is ACB+16; a supervisor's is the
// same lock of the supervisor's block):
//   a call wrapper's lock (+72)  >  the waiting actor's lock  >  the supervisor's lock  >
//   _silica_rt_row_wait_lock  >  a carrier's lock (+0).
// A carrier's lock is a leaf: it is taken by the carrier loop with nothing else held, and by
// _silica_rt_carrier_push, _mark_idle, _unlist and _sweep with at most one actor's lock (and the
// locks above it) held; no path holds two carriers' locks, so a reply on carrier 2 that pushes
// its parked caller to carrier 1, a cascade on a supervisor's thread that stops siblings on two
// carriers, and two carriers waking each other's actors all take the locks in this order.
// _silica_rt_carriers_lock (the table's creation, once) is taken with nothing held. The wrapper
// lock sits above the actor locks on the reply path (LBB1_post_beh holds the wrapper while the
// ingress drain takes the replier's and its supervisor's locks) and a dying actor's mailbox lock
// is held while the wrappers of calls INTO it are signalled (_silica_rt_actor_signal_pending_call_deaths):
// those are different wrappers from the one a replier holds (an actor cannot reply and die at
// once), the order that held with one carrier and with none.
//
// Not in this stage (actor_memory_budget_plan.md §5 N, "Stage 2 status"): exclusive pinning,
// migrate_actor, scheduler policies and priorities, supervisors on carriers.

export emit_actor_carrier_runtime_asm/0;

fn carrier_asm_data() -> string {
    "	.section	__DATA,__data
	.p2align	3
	.globl	_silica_rt_carriers_enabled
_silica_rt_carriers_enabled:
	.quad	0
	.section	__DATA,__bss
	.p2align	4
	.globl	_silica_rt_carrier_count
_silica_rt_carrier_count:
	.zero	8
	.globl	_silica_rt_carriers
_silica_rt_carriers:
	.zero	8
_silica_rt_carrier_next:
	.zero	8
_silica_rt_carriers_lock:
	.zero	8
	.globl	_silica_rt_row_wait_lock
_silica_rt_row_wait_lock:
	.zero	16
	.section	__TEXT,__cstring,cstring_literals
L_srt_carriers_env:
	.asciz	\"SILICA_CARRIERS\"
L_srt_carrier_count_env:
	.asciz	\"SILICA_CARRIER_COUNT\"
L_srt_hw_logicalcpu:
	.asciz	\"hw.logicalcpu\"
Lrta_r_carrier_wait:
	.asciz	\"a carrier actor waited on the carrier's own stack for another actor of its carrier\"
Lrta_r_row_wake:
	.asciz	\"a row child's exit found an actor on its wait list that was not parked for it\"
Lrta_r_carrier_thread:
	.asciz	\"the carrier thread could not be created\"
Lrta_r_carrier_table:
	.asciz	\"the carrier table could not be made\"
Lrta_r_thread_record:
	.asciz	\"the thread's actor record could not be made\"
	.section	__TEXT,__text,regular,pure_instructions
"
}

fn carrier_asm_adopt() -> string {
    "	.globl	_silica_rt_carrier_adopt
	.p2align	2
_silica_rt_carrier_adopt:
; X0 = a new ACB (reservation made, arena bookkeeping set), X1 = its start trampoline (0 = none),
; X2 = 1 for a dangerous actor. -> X0 = 1 when the actor was given to a carrier (no thread is to
; be made; it is idle and started), 0 when it keeps a thread of its own: the gate is off, it has a
; trampoline (a supervisor, this stage), it is dangerous (its foreign calls may block), or it is one
; of the runtime's own actors (_silica_rt_spawn_rec_override is set around their spawns). The
; carrier: `core mod N` for a nonzero core id (#208; a row child's #208 is its row, no core id),
; else the next carrier in turn.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	cbnz	x1, Lcad_no
	cbnz	x2, Lcad_no
	adrp	x8, _silica_rt_carriers_enabled@PAGE
	add	x8, x8, _silica_rt_carriers_enabled@PAGEOFF
	ldr	x9, [x8]
	cbz	x9, Lcad_no
	adrp	x8, _silica_rt_spawn_rec_override@PAGE
	add	x8, x8, _silica_rt_spawn_rec_override@PAGEOFF
	ldr	x9, [x8]
	cbnz	x9, Lcad_no
	bl	_silica_rt_carriers_ensure
	mov	x21, x0
	adrp	x8, _silica_rt_carrier_count@PAGE
	add	x8, x8, _silica_rt_carrier_count@PAGEOFF
	ldr	x10, [x8]
	ldr	x9, [x19, #208]
	cmp	x9, #4096
	b.hs	Lcad_in_turn
	cbz	x9, Lcad_in_turn
	udiv	x11, x9, x10
	msub	x9, x11, x10, x9
	b	Lcad_have_index
Lcad_in_turn:
	adrp	x8, _silica_rt_carrier_next@PAGE
	add	x8, x8, _silica_rt_carrier_next@PAGEOFF
Lcad_turn_loop:
	ldaxr	x9, [x8]
	add	x11, x9, #1
	cmp	x11, x10
	b.lo	Lcad_turn_store
	mov	x11, xzr
Lcad_turn_store:
	stlxr	w12, x11, [x8]
	cbnz	w12, Lcad_turn_loop
Lcad_have_index:
	add	x20, x21, x9, lsl #7
	mov	x0, x20
	bl	_silica_rt_carrier_ensure_started
	str	x20, [x19, #440]
	mov	x9, #1
	str	x9, [x19, #448]
	str	xzr, [x19, #456]
	str	xzr, [x19, #464]
	str	xzr, [x19, #472]
	mov	x0, x19
	mov	x1, #1
	bl	_silica_rt_started_store
	mov	x0, #1
	b	Lcad_ret
Lcad_no:
	mov	x0, xzr
Lcad_ret:
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_carriers_ensure
	.p2align	2
_silica_rt_carriers_ensure:
; -> X0 = the carrier table, made the first time: _silica_rt_carrier_count blocks of 128 B (the
; count was read by _silica_rt_stack_runtime_init; 1 when it was not), each knowing itself (+96)
; and its index (+112). Failure to make it is a runtime abort.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	adrp	x19, _silica_rt_carriers@PAGE
	add	x19, x19, _silica_rt_carriers@PAGEOFF
	ldar	x0, [x19]
	cbnz	x0, Lcen_ret
	adrp	x0, _silica_rt_carriers_lock@PAGE
	add	x0, x0, _silica_rt_carriers_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x0, [x19]
	cbnz	x0, Lcen_unlock
	adrp	x8, _silica_rt_carrier_count@PAGE
	add	x8, x8, _silica_rt_carrier_count@PAGEOFF
	ldr	x20, [x8]
	cbnz	x20, Lcen_have_count
	mov	x20, #1
	str	x20, [x8]
Lcen_have_count:
	mov	x0, x20
	mov	x1, #128
	bl	_calloc
	cbz	x0, Lcen_failed
	mov	x21, x0
	mov	x9, x0
	mov	x10, xzr
Lcen_fill:
	cmp	x10, x20
	b.hs	Lcen_filled
	str	x9, [x9, #96]
	str	x10, [x9, #112]
	add	x9, x9, #128
	add	x10, x10, #1
	b	Lcen_fill
Lcen_filled:
	stlr	x21, [x19]
Lcen_unlock:
	adrp	x0, _silica_rt_carriers_lock@PAGE
	add	x0, x0, _silica_rt_carriers_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	ldr	x0, [x19]
Lcen_ret:
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
Lcen_failed:
	adrp	x0, Lrta_r_carrier_table@PAGE
	add	x0, x0, Lrta_r_carrier_table@PAGEOFF
	bl	_silica_rt_abort_with
	b	Lcen_failed
	.globl	_silica_rt_carrier_ensure_started
	.p2align	2
_silica_rt_carrier_ensure_started:
; X0 = carrier block. Creates its thread the first time.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	add	x9, x19, #80
	ldar	x8, [x9]
	cbnz	x8, Lces_ret
	mov	x0, x19
	bl	_os_unfair_lock_lock
	ldr	x8, [x19, #80]
	cbnz	x8, Lces_unlock
	add	x0, x19, #64
	mov	x1, xzr
	adrp	x2, _silica_rt_carrier_main@PAGE
	add	x2, x2, _silica_rt_carrier_main@PAGEOFF
	mov	x3, x19
	bl	_pthread_create
	cbnz	w0, Lces_failed
	ldr	x0, [x19, #64]
	bl	_pthread_detach
	mov	x8, #1
	add	x9, x19, #80
	stlr	x8, [x9]
Lces_unlock:
	mov	x0, x19
	bl	_os_unfair_lock_unlock
Lces_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
Lces_failed:
	adrp	x0, Lrta_r_carrier_thread@PAGE
	add	x0, x0, Lrta_r_carrier_thread@PAGEOFF
	bl	_silica_rt_abort_with
	b	Lces_failed
	.globl	_silica_rt_tls_record_set
	.p2align	2
_silica_rt_tls_record_set:
; X0 = this thread's record: two words, the current actor and the carrier (0 when the thread is
; not a carrier's). An actor thread's record is in its control block (#496), a carrier's in its
; block (+88); main has none until _silica_rt_tls_actor_set makes it one.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	bl	_silica_rt_ensure_actor_tls_key
	adrp	x8, _silica_actor_pthread_key@PAGE
	add	x8, x8, _silica_actor_pthread_key@PAGEOFF
	ldr	x0, [x8]
	mov	x1, x19
	bl	_pthread_setspecific
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_tls_actor_set
	.p2align	2
_silica_rt_tls_actor_set:
; X0 = ACB or 0: this thread's current actor, stored in the thread's record. A thread without a
; record (main) gets a calloc'd one now, never freed (one thread).
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	bl	_silica_rt_ensure_actor_tls_key
	adrp	x8, _silica_actor_pthread_key@PAGE
	add	x8, x8, _silica_actor_pthread_key@PAGEOFF
	ldr	x0, [x8]
	bl	_pthread_getspecific
	cbnz	x0, Ltas_store
	mov	x0, #1
	mov	x1, #16
	bl	_calloc
	cbz	x0, Ltas_failed
	mov	x20, x0
	adrp	x8, _silica_actor_pthread_key@PAGE
	add	x8, x8, _silica_actor_pthread_key@PAGEOFF
	ldr	x0, [x8]
	mov	x1, x20
	bl	_pthread_setspecific
	mov	x0, x20
Ltas_store:
	str	x19, [x0]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
Ltas_failed:
	adrp	x0, Lrta_r_thread_record@PAGE
	add	x0, x0, Lrta_r_thread_record@PAGEOFF
	bl	_silica_rt_abort_with
	b	Ltas_failed
"
}

fn carrier_asm_loop() -> string {
    "	.globl	_silica_rt_carrier_main
	.p2align	2
_silica_rt_carrier_main:
; Thread entry: X0 = carrier block. Never returns.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x19, x0
	str	xzr, [x19, #88]
	add	x0, x19, #88
	bl	_silica_rt_tls_record_set
	add	x0, x19, #56
	bl	_silica_rt_altstack_install_at
	mov	x9, sp
	str	x9, [x19, #48]
	mov	x8, #1
	add	x9, x19, #72
	stlr	x8, [x9]
Lcar_loop:
; Entered afresh from every path that leaves an actor: the stack below the base is abandoned.
	ldr	x9, [x19, #48]
	mov	sp, x9
	str	xzr, [x19, #40]
	str	xzr, [x19, #88]
	mov	x0, x19
	bl	_os_unfair_lock_lock
Lcar_pop:
	ldr	x20, [x19, #24]
	cbz	x20, Lcar_empty
; A busy carrier sweeps its idle :release_when_idle actors at most every quarter second.
	ldr	x9, [x19, #104]
	cbz	x9, Lcar_have
	bl	_silica_rt_stack_now_ns
	ldr	x9, [x19, #120]
	sub	x9, x0, x9
	movz	x10, #0xB280
	movk	x10, #0x0EE6, lsl #16
	cmp	x9, x10
	b.lo	Lcar_have
	mov	x0, x19
	bl	_silica_rt_carrier_sweep
	b	Lcar_pop
Lcar_empty:
; Nothing to run: sweep, then sleep until mail (or a parked actor's wake) or the earliest release.
	mov	x0, x19
	bl	_silica_rt_carrier_sweep
	mov	x2, x0
	mov	x9, #1
	str	x9, [x19, #16]
	add	x0, x19, #8
	mov	x1, x19
	bl	_silica_rt_cv_wait_timeout
	str	xzr, [x19, #16]
	b	Lcar_pop
Lcar_have:
	ldr	x20, [x19, #24]
	ldr	x9, [x20, #456]
	str	x9, [x19, #24]
	cbnz	x9, Lcar_have_tail
	str	xzr, [x19, #32]
Lcar_have_tail:
	str	xzr, [x20, #456]
	mov	x0, x19
	bl	_os_unfair_lock_unlock
	mov	x9, #3
	str	x9, [x20, #448]
	str	x20, [x19, #40]
	str	x20, [x19, #88]
	ldr	x9, [x20, #464]
	cbnz	x9, Lcar_resume
	mov	x19, x20
	b	LBB1_loop
Lcar_resume:
; Parked inside a behaviour: the dispatch frame its behaviour will return into is the same 48 bytes
; below the base that its dispatch used (the post-behaviour code reads the node from ACB #240).
	ldr	x9, [x19, #48]
	sub	x9, x9, #48
	str	x9, [x20, #368]
	mov	x0, x20
	b	_silica_rt_ctx_resume
	.globl	_silica_rt_carrier_loop_enter
	.p2align	2
_silica_rt_carrier_loop_enter:
; X0 = carrier block. An actor's exit path, run on the carrier's stack, ends here. Never returns.
	mov	x19, x0
	b	Lcar_loop
	.globl	_silica_rt_carrier_leave
	.p2align	2
_silica_rt_carrier_leave:
; X0 = a carrier actor that has parked (context saved, status 4 published). Never returns.
	ldr	x19, [x0, #440]
	b	Lcar_loop
	.globl	_silica_rt_carrier_requeue
	.p2align	2
_silica_rt_carrier_requeue:
; X0 = a carrier actor whose message has been served: ready again when mail waits or it has been
; ended meanwhile (its exit path runs at its next dispatch), idle otherwise; then back to the
; carrier loop. Never returns.
	mov	x19, x0
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	w9, [x19, #152]
	cbz	w9, Lcrq_ready
	ldr	x9, [x19, #216]
	cbz	x9, Lcrq_std
	ldr	x10, [x9]
	ldr	x11, [x9, #8]
	orr	x10, x10, x11
	cbnz	x10, Lcrq_ready
Lcrq_std:
	ldr	x10, [x19, #128]
	ldr	x11, [x19, #136]
	orr	x10, x10, x11
	cbnz	x10, Lcrq_ready
	mov	x0, x19
	bl	_silica_rt_carrier_mark_idle
	b	Lcrq_unlock
Lcrq_ready:
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	_silica_rt_carrier_push
Lcrq_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x0, [x19, #440]
	b	_silica_rt_carrier_loop_enter
	.globl	_silica_rt_carrier_push
	.p2align	2
_silica_rt_carrier_push:
; X0 = a carrier actor whose status its caller has just set to ready (2), under the lock that guards
; that status. Appends it to its own carrier's run queue (#440: the caller may be anywhere) and
; wakes that carrier when it sleeps.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x20, x0
	ldr	x19, [x20, #440]
	str	xzr, [x20, #456]
	mov	x0, x19
	bl	_os_unfair_lock_lock
	ldr	x9, [x19, #32]
	cbz	x9, Lcpu_empty
	str	x20, [x9, #456]
	b	Lcpu_tail
Lcpu_empty:
	str	x20, [x19, #24]
Lcpu_tail:
	str	x20, [x19, #32]
	ldr	x9, [x19, #16]
	cbz	x9, Lcpu_unlock
	add	x0, x19, #8
	bl	_silica_rt_cv_signal
Lcpu_unlock:
	mov	x0, x19
	bl	_os_unfair_lock_unlock
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_carrier_mark_idle
	.p2align	2
_silica_rt_carrier_mark_idle:
; X0 = a carrier actor with no mail, on its carrier's thread, its lock held: idle (1), or, when it
; is :release_when_idle (#312 = 4) and still holds committed stack (#288), idle on its carrier's
; sweep list (5), linked through #456 under the carrier's lock.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	ldr	x9, [x19, #312]
	cmp	x9, #4
	b.ne	Lcmi_plain
	ldr	x9, [x19, #288]
	cbz	x9, Lcmi_plain
	ldr	x20, [x19, #440]
	mov	x0, x20
	bl	_os_unfair_lock_lock
	ldr	x9, [x20, #104]
	str	x9, [x19, #456]
	str	x19, [x20, #104]
	mov	x9, #5
	str	x9, [x19, #448]
	mov	x0, x20
	bl	_os_unfair_lock_unlock
	b	Lcmi_ret
Lcmi_plain:
	mov	x9, #1
	str	x9, [x19, #448]
Lcmi_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_carrier_unlist
	.p2align	2
_silica_rt_carrier_unlist:
; X0 = a carrier actor its caller found on its carrier's sweep list (status 5), its lock held:
; taken off the list under the carrier's lock. Not found is fine: the sweep released it and took
; it off meanwhile.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	ldr	x20, [x19, #440]
	mov	x0, x20
	bl	_os_unfair_lock_lock
	add	x9, x20, #104
Lcul_find:
	ldr	x10, [x9]
	cbz	x10, Lcul_unlock
	cmp	x10, x19
	b.eq	Lcul_found
	add	x9, x10, #456
	b	Lcul_find
Lcul_found:
	ldr	x10, [x19, #456]
	str	x10, [x9]
	str	xzr, [x19, #456]
Lcul_unlock:
	mov	x0, x20
	bl	_os_unfair_lock_unlock
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_carrier_sweep
	.p2align	2
_silica_rt_carrier_sweep:
; X0 = a carrier, its lock held, on its own thread. Walks the sweep list (+104): an actor whose
; last message is a second old is released by _silica_rt_stack_idle_check (nothing of it runs: it
; is idle and off the run queue, and mail for it waits for this lock in _silica_rt_carrier_unlist)
; and becomes plainly idle (1), off the list; -> X0 = the microseconds until the earliest remaining
; one is due, 0 when the list is empty. Records the time of the sweep (+120).
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	bl	_silica_rt_stack_now_ns
	str	x0, [x19, #120]
	mov	x22, xzr
	add	x21, x19, #104
	ldr	x20, [x21]
Lcsw_next:
	cbz	x20, Lcsw_done
	mov	x0, x20
	bl	_silica_rt_stack_idle_check
	cbnz	x0, Lcsw_keep
	ldr	x9, [x20, #456]
	str	x9, [x21]
	str	xzr, [x20, #456]
	mov	x9, #1
	str	x9, [x20, #448]
	ldr	x20, [x21]
	b	Lcsw_next
Lcsw_keep:
	cbz	x22, Lcsw_set_min
	cmp	x0, x22
	b.hs	Lcsw_advance
Lcsw_set_min:
	mov	x22, x0
Lcsw_advance:
	add	x21, x20, #456
	ldr	x20, [x21]
	b	Lcsw_next
Lcsw_done:
	mov	x0, x22
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
"
}

fn carrier_asm_wakes() -> string {
    "	.globl	_silica_rt_actor_mail_signal
	.p2align	2
_silica_rt_actor_mail_signal:
; X0 = ACB; the caller holds ACB+16 and has enqueued mail or ended the actor. Signals the mailbox
; futex (an actor thread waits on it) and, for an idle carrier actor (plainly idle or on its
; carrier's sweep list), makes it ready on its own carrier.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	add	x0, x19, #80
	bl	_silica_rt_cv_signal
	ldr	x9, [x19, #440]
	cbz	x9, Lams_ret
	ldr	x9, [x19, #448]
	cmp	x9, #1
	b.eq	Lams_ready
	cmp	x9, #5
	b.ne	Lams_ret
	mov	x0, x19
	bl	_silica_rt_carrier_unlist
Lams_ready:
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	_silica_rt_carrier_push
Lams_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_call_wrapper_wake
	.p2align	2
_silica_rt_call_wrapper_wake:
; X0 = call wrapper; the caller holds wrapper+72 and has set reply_set. Signals the wrapper's futex
; (a thread waits on it) and makes a carrier actor parked on it (wrapper+48) ready on its carrier.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	add	x0, x19, #24
	bl	_silica_rt_cv_signal
	ldr	x9, [x19, #48]
	cbz	x9, Lcww_ret
	ldr	x10, [x9, #448]
	cmp	x10, #4
	b.ne	Lcww_ret
	mov	x10, #2
	str	x10, [x9, #448]
	mov	x0, x9
	bl	_silica_rt_carrier_push
Lcww_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_started_store
	.p2align	2
_silica_rt_started_store:
; X0 = ACB, X1 = its started word (#224): 1 started, 2 its start trampoline failed. Stores it and
; makes a carrier actor parked in the spawn (#472) ready. The parker stores #472 and then reads #224
; under its own lock; this side stores #224 and then reads #472: with the barriers one of them sees
; the other's store, and the status check under the parker's lock settles the rest.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	add	x9, x0, #224
	stlr	x1, [x9]
	dmb	ish
	ldr	x19, [x0, #472]
	cbz	x19, Lsts_ret
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x10, [x19, #448]
	cmp	x10, #4
	b.ne	Lsts_unlock
	mov	x10, #2
	str	x10, [x19, #448]
	mov	x0, x19
	bl	_silica_rt_carrier_push
Lsts_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
Lsts_ret:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_spawn_wait_started
	.p2align	2
_silica_rt_spawn_wait_started:
; X0 = a child just spawned. Returns once its started word (#224) is set. A carrier actor on its own
; stack parks (the child's started store wakes it); anything else spins, as the spawn always did.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	bl	_silica_rt_tls_current_actor_get
	mov	x20, x0
	cbz	x20, Lsws_spin
	ldr	x9, [x20, #440]
	cbz	x9, Lsws_spin
	mov	x9, sp
	ldr	x10, [x20, #272]
	cmp	x9, x10
	b.lo	Lsws_spin
	ldr	x11, [x20, #280]
	add	x10, x10, x11
	cmp	x9, x10
	b.hs	Lsws_spin
	str	x20, [x19, #472]
	dmb	ish
Lsws_park_loop:
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	add	x9, x19, #224
	ldar	x8, [x9]
	cbnz	x8, Lsws_started
	mov	x0, x20
	bl	_silica_rt_ctx_save
	cbnz	x0, Lsws_park_loop
	mov	x9, #4
	str	x9, [x20, #448]
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x20
	b	_silica_rt_carrier_leave
Lsws_started:
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	b	Lsws_ret
Lsws_spin:
	add	x9, x19, #224
Lsws_spin_loop:
	ldar	x8, [x9]
	cbz	x8, Lsws_spin_loop
Lsws_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_on_carrier_thread
	.p2align	2
_silica_rt_on_carrier_thread:
; -> X0 = the carrier block when this thread is a carrier's (the second word of the thread's
; record), else 0.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_ensure_actor_tls_key
	adrp	x8, _silica_actor_pthread_key@PAGE
	add	x8, x8, _silica_actor_pthread_key@PAGEOFF
	ldr	x0, [x8]
	bl	_pthread_getspecific
	cbz	x0, Loct_ret
	ldr	x0, [x0, #8]
Loct_ret:
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_carrier_self_on_own_stack
	.p2align	2
_silica_rt_carrier_self_on_own_stack:
; -> X0 = the carrier actor this thread runs when the caller is on that actor's own stack (it can
; park), else 0: main, an actor thread, or a runtime path on the carrier's own stack. The parked
; actor is the one the carrier runs (carrier +40), not the thread's current actor: an ingress drain
; installs the supervisor as the current actor while it runs on the drainer's stack.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_on_carrier_thread
	cbz	x0, Lcso_ret
	ldr	x0, [x0, #40]
	cbz	x0, Lcso_ret
	mov	x9, sp
	ldr	x10, [x0, #272]
	cmp	x9, x10
	b.lo	Lcso_no
	ldr	x11, [x0, #280]
	add	x10, x10, x11
	cmp	x9, x10
	b.hs	Lcso_no
	b	Lcso_ret
Lcso_no:
	mov	x0, xzr
Lcso_ret:
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_wait_park
	.p2align	2
_silica_rt_wait_park:
; X0 = the carrier actor parking (on its own stack), X1 = the wait list it joins (the address of
; the head word: a row's +120 or a supervision block's +128; the links are ACB #456, the list is
; recorded in #480 for a stop to find), X2 = the thread's current actor to restore after the
; resume. Called with the actor's lock and the wait lock held: it publishes status 4 (parked)
; under both, releases them and leaves for the carrier loop. Returns, with no lock held, when the
; actor has been made ready again (by the list's wake or by a stop that unlinked it).
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	mov	x0, x19
	bl	_silica_rt_ctx_save
	cbnz	x0, Lwpk_resumed
	ldr	x9, [x20]
	str	x9, [x19, #456]
	str	x19, [x20]
	str	x20, [x19, #480]
	mov	x9, #4
	str	x9, [x19, #448]
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x19
	b	_silica_rt_carrier_leave
Lwpk_resumed:
; The carrier made this actor the thread's current actor at the resume; the wait was entered with
; X21 as the current actor (the supervisor, in an ingress drain).
	cmp	x21, x19
	b.eq	Lwpk_ret
	mov	x0, x21
	bl	_silica_rt_tls_actor_set
Lwpk_ret:
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_wait_list_wake
	.p2align	2
_silica_rt_wait_list_wake:
; X0 = the address of a wait list's head word: takes the whole list under the wait lock and makes
; every actor on it ready, each under its own lock, none under the wait lock. An actor on the list
; that is not parked cannot happen (it was parked under both locks, and only this wake or a stop,
; which unlinks it under the wait lock first, changes that): a runtime abort.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x20, [x19]
	str	xzr, [x19]
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
Lwlw_wake:
	cbz	x20, Lwlw_ret
	ldr	x19, [x20, #456]
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	ldr	x9, [x20, #448]
	cmp	x9, #4
	b.ne	Lwlw_not_parked
	str	xzr, [x20, #480]
	mov	x9, #2
	str	x9, [x20, #448]
	mov	x0, x20
	bl	_silica_rt_carrier_push
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x20, x19
	b	Lwlw_wake
Lwlw_not_parked:
	adrp	x0, Lrta_r_row_wake@PAGE
	add	x0, x0, Lrta_r_row_wake@PAGEOFF
	bl	_silica_rt_abort_with
Lwlw_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_row_wait
	.p2align	2
_silica_rt_row_wait:
; X0 = a row, X1 = the identity (ACB #408) of the child whose exit is waited for, X2 = 1 when that
; child is a carrier actor (0 = unknown), X3 = the waiting actor or 0 (main, or a wait that no stop
; may end). -> X0 = 1 once the row's exit_done (+56) holds that identity, 2 when X3 was ended
; meanwhile (its supervisor's cascade stops it while it waits in kill_abnormal: the wait is over
; and the victim is dead or dying). exit_done is a generation word, never cleared: the identity of
; the last child of the row that ended; a stale value from an earlier incarnation never matches.
; A carrier actor on its own stack parks on the row's wait list (the exit_done store wakes it, so
; does a stop of the waiter); anything else spins (main, an actor thread, a runtime path on the
; carrier's own stack; the last is a runtime abort when the awaited child is a carrier actor, which
; could never run on the stack being spun on when it is bound to this carrier).
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	mov	x22, x2
	mov	x23, x3
	bl	_silica_rt_carrier_self_on_own_stack
	mov	x21, x0
	cbz	x21, Lrw_spin
	bl	_silica_rt_tls_current_actor_get
	mov	x24, x0
Lrw_park_loop:
; The check and the push onto the row's wait list are one critical section under the wait lock
; (the exit side stores exit_done and takes the list under it; a stop sets the waiter's alive flag
; under the waiter's own lock), so no wake is lost.
	add	x0, x21, #16
	bl	_os_unfair_lock_lock
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x8, [x19, #56]
	cmp	x8, x20
	b.eq	Lrw_done_locked
	cbz	x23, Lrw_park
	ldr	w8, [x23, #152]
	cbz	w8, Lrw_stopped_locked
Lrw_park:
	mov	x0, x21
	add	x1, x19, #120
	mov	x2, x24
	bl	_silica_rt_wait_park
	b	Lrw_park_loop
Lrw_done_locked:
	mov	x23, #1
	b	Lrw_unlock_ret
Lrw_stopped_locked:
	mov	x23, #2
Lrw_unlock_ret:
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	add	x0, x21, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x23
	b	Lrw_ret
Lrw_spin:
	cbz	x22, Lrw_spin_loop
	bl	_silica_rt_on_carrier_thread
	cbz	x0, Lrw_spin_loop
	adrp	x0, Lrta_r_carrier_wait@PAGE
	add	x0, x0, Lrta_r_carrier_wait@PAGEOFF
	bl	_silica_rt_abort_with
Lrw_spin_loop:
	ldr	x8, [x19, #56]
	cmp	x8, x20
	b.eq	Lrw_spin_done
	cbz	x23, Lrw_spin_loop
	ldr	w8, [x23, #152]
	cbnz	w8, Lrw_spin_loop
	mov	x0, #2
	b	Lrw_ret
Lrw_spin_done:
	mov	x0, #1
Lrw_ret:
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	_silica_rt_row_exit_done_store
	.p2align	2
_silica_rt_row_exit_done_store:
; X0 = a row whose child has ended (_silica_rt_sb_child_done, the child's last act), X1 = that
; child's identity: exit_done (+56) = the identity, under the wait lock, then every carrier actor
; parked on the row's wait list (+120) is made ready; each re-checks the identity it waits for.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	str	x20, [x19, #56]
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	add	x0, x19, #120
	bl	_silica_rt_wait_list_wake
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_actor_stop
	.p2align	2
_silica_rt_actor_stop:
; X0 = an actor to end at its next dispatch boundary, X1 = the exit reason tag to give it (0 keeps
; what it has: a supervisor's own stop, reason 0 in its report), X2 = the reason atom that goes
; with a tag (#384; 0 = none). -> X0 = 1 when it is a carrier actor. The one way the runtime ends
; another actor: under the target's lock its alive flag goes, the reason (tag and atom) is set
; only while it was still alive (an actor already ending keeps its own), its
; mailbox is signalled (an idle carrier actor is made ready), and an actor parked on a wait list
; (a row's exit_done, a supervision block's restart token: #480 names the list) is unlinked under
; the wait lock and made ready, so a wait that this stop ends (kill_abnormal's) sees it at once. A
; parked actor the list's wake has already taken (not found on the list) is made ready by that wake.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	w8, [x19, #152]
	cbz	w8, Lsto_was_ended
	cbz	x20, Lsto_was_ended
	str	x20, [x19, #232]
	cbz	x21, Lsto_was_ended
	str	x21, [x19, #384]
Lsto_was_ended:
	str	wzr, [x19, #152]
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
	ldr	x22, [x19, #440]
	cbz	x22, Lsto_unlock
	ldr	x9, [x19, #448]
	cmp	x9, #4
	b.ne	Lsto_unlock
	ldr	x21, [x19, #480]
	cbz	x21, Lsto_unlock
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	ldr	x9, [x21]
	mov	x10, xzr
Lsto_find:
	cbz	x9, Lsto_not_found
	cmp	x9, x19
	b.eq	Lsto_found
	mov	x10, x9
	ldr	x9, [x9, #456]
	b	Lsto_find
Lsto_found:
	ldr	x11, [x19, #456]
	cbz	x10, Lsto_unlink_head
	str	x11, [x10, #456]
	b	Lsto_unlinked
Lsto_unlink_head:
	str	x11, [x21]
Lsto_unlinked:
	str	xzr, [x19, #480]
	str	xzr, [x19, #456]
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
	mov	x9, #2
	str	x9, [x19, #448]
	mov	x0, x19
	bl	_silica_rt_carrier_push
	b	Lsto_unlock
Lsto_not_found:
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_unlock
Lsto_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	cmp	x22, #0
	cset	x0, ne
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_sup_restart_try
	.p2align	2
_silica_rt_sup_restart_try:
; X0 = a supervisor, X1 = the actor asking (0 = main). -> X0 = 1 when the caller now holds the
; supervisor's restart token (supervision block #120: the holder, or 1 for main), 0 when another
; holder has it, or the supervisor has no block or has ended. One holder at a time dequeues its
; ingress and runs the restarts (maybe_restart with its cascades), so no two cascades overlap.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x8, [x19, #216]
	cbz	x8, Lsrt_no
	ldr	w9, [x19, #152]
	cbz	w9, Lsrt_no
	ldr	x9, [x8, #120]
	cbnz	x9, Lsrt_no
	mov	x9, x20
	cbnz	x9, Lsrt_take
	mov	x9, #1
Lsrt_take:
	str	x9, [x8, #120]
	mov	x20, #1
	b	Lsrt_unlock
Lsrt_no:
	mov	x20, xzr
Lsrt_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x20
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_sup_restart_release
	.p2align	2
_silica_rt_sup_restart_release:
; X0 = a supervisor whose restart token the caller holds: lets it go. Notices still in the ingress
; are the supervisor's own thread's to drain (its mailbox is signalled; the thread skips the ingress
; while another holder has the token), and every actor parked for the token (block +128) is made
; ready to re-check.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	ldr	x20, [x19, #216]
	cbz	x20, Lsrr_unlock
	str	xzr, [x20, #120]
	ldr	x9, [x20]
	ldr	x10, [x20, #8]
	orr	x9, x9, x10
	cbz	x9, Lsrr_unlock
	mov	x0, x19
	bl	_silica_rt_actor_mail_signal
Lsrr_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	cbz	x20, Lsrr_ret
	add	x0, x20, #128
	bl	_silica_rt_wait_list_wake
Lsrr_ret:
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.globl	_silica_rt_sup_restart_acquire
	.p2align	2
_silica_rt_sup_restart_acquire:
; X0 = a supervisor, X1 = the actor asking (0 = main), X2 = 1 to take the restart token, 0 to wait
; until the token is free and the ingress is empty (a row child of this supervisor never takes the
; token: the cascade it would run could stop the child itself; it waits for the holder, the
; supervisor's thread, to finish). -> X0 = 1 taken / settled, 2 when X1 was ended while it waited
; (its supervisor's cascade stops it: the caller's wait is over), 0 when the supervisor has no
; block or has ended (nothing to drain or wait for). A carrier actor on its own stack parks on the
; block's wait list (+128; a release wakes it, so does a stop of the waiter); anything else polls.
; Lock order everywhere: the waiting actor, then the supervisor, then the wait lock, then (in the
; push of a woken actor) its carrier's lock.
	stp	x29, x30, [sp, #-80]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	str	x25, [sp, #64]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	bl	_silica_rt_carrier_self_on_own_stack
	mov	x22, x0
	bl	_silica_rt_tls_current_actor_get
	mov	x24, x0
Lsra_loop:
	cbz	x22, Lsra_lock_sup
	add	x0, x22, #16
	bl	_os_unfair_lock_lock
Lsra_lock_sup:
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	mov	x23, xzr
	ldr	x8, [x19, #216]
	cbz	x8, Lsra_unlock
	mov	x25, x8
	ldr	w9, [x19, #152]
	cbz	w9, Lsra_unlock
	cbz	x20, Lsra_self_ok
	ldr	w9, [x20, #152]
	cbnz	w9, Lsra_self_ok
	mov	x23, #2
	b	Lsra_unlock
Lsra_self_ok:
	ldr	x9, [x8, #120]
	cbnz	x9, Lsra_wait
	cbz	x21, Lsra_settle
	mov	x9, x20
	cbnz	x9, Lsra_take
	mov	x9, #1
Lsra_take:
	str	x9, [x8, #120]
	mov	x23, #1
	b	Lsra_unlock
Lsra_settle:
	ldr	x9, [x8]
	ldr	x10, [x8, #8]
	orr	x9, x9, x10
	cbnz	x9, Lsra_wait
	mov	x23, #1
Lsra_unlock:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	cbz	x22, Lsra_ret
	add	x0, x22, #16
	bl	_os_unfair_lock_unlock
	b	Lsra_ret
Lsra_wait:
	cbz	x22, Lsra_poll
; Park: the wait lock is taken before the supervisor's lock goes, so a release that follows cannot
; take the list before this actor is on it.
	adrp	x0, _silica_rt_row_wait_lock@PAGE
	add	x0, x0, _silica_rt_row_wait_lock@PAGEOFF
	bl	_os_unfair_lock_lock
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	x0, x22
	add	x1, x25, #128
	mov	x2, x24
	bl	_silica_rt_wait_park
	b	Lsra_loop
Lsra_poll:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	mov	w0, #50
	bl	_usleep
	b	Lsra_loop
Lsra_ret:
	mov	x0, x23
	ldr	x25, [sp, #64]
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #80
	ret
"
}

fn carrier_asm_context() -> string {
    "	.globl	_silica_rt_ctx_save
	.p2align	2
_silica_rt_ctx_save:
; X0 = the current carrier actor, on its own stack. Saves X19-X30 and D8-D15 below SP and records
; that SP in #464. Returns 0 at once with SP left lowered (the frame is live until the actor leaves
; through _silica_rt_carrier_leave); returns 1, with SP and the registers restored, when the
; carrier resumes the actor.
	sub	sp, sp, #176
	stp	x19, x20, [sp]
	stp	x21, x22, [sp, #16]
	stp	x23, x24, [sp, #32]
	stp	x25, x26, [sp, #48]
	stp	x27, x28, [sp, #64]
	stp	x29, x30, [sp, #80]
	stp	d8, d9, [sp, #96]
	stp	d10, d11, [sp, #112]
	stp	d12, d13, [sp, #128]
	stp	d14, d15, [sp, #144]
	mov	x9, sp
	str	x9, [x0, #464]
	mov	x0, xzr
	ret
	.globl	_silica_rt_ctx_resume
	.p2align	2
_silica_rt_ctx_resume:
; X0 = a carrier actor with a parked context (#464). Never returns to its caller: continues the
; actor after its _silica_rt_ctx_save, with X0 = 1.
	ldr	x9, [x0, #464]
	str	xzr, [x0, #464]
	mov	sp, x9
	ldp	x19, x20, [sp]
	ldp	x21, x22, [sp, #16]
	ldp	x23, x24, [sp, #32]
	ldp	x25, x26, [sp, #48]
	ldp	x27, x28, [sp, #64]
	ldp	x29, x30, [sp, #80]
	ldp	d8, d9, [sp, #96]
	ldp	d10, d11, [sp, #112]
	ldp	d12, d13, [sp, #128]
	ldp	d14, d15, [sp, #144]
	add	sp, sp, #176
	mov	x0, #1
	ret
"
}

fn emit_actor_carrier_runtime_asm() -> string {
    concat(concat(concat(concat(carrier_asm_data(), carrier_asm_adopt()), carrier_asm_loop()), carrier_asm_wakes()), carrier_asm_context())
}
