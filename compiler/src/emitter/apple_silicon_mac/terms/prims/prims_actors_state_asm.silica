// The state area (chunk15_stack_memory_design.md §2.1, §2.3, §4.2-§4.7, §5.4; chunk 15 phase 3b, 2026-10-29;
// phase 3c, 2026-10-30: dispatch end).
//
// An actor's state lives at the top of its own reservation: the 1,040-byte header at [top - 1040, top)
// holds 129 free-list heads (head i, i = 0..127, for nodes of 8 * (i + 1) bytes; head 128 for every size
// above 1,024), and the state area [edge, top - 1040) holds the nodes, growing down as the edge
// (ACB #528) moves. Every node has an exact size, a multiple of 8, known from its descriptor; nodes never
// move once placed (decision 21). ACB #568 counts the bytes allocated and not freed.
//
//   _silica_rt_state_alloc(X0 = ACB, X1 = bytes)           -> X0 = the node, or 0 when the reservation
//        cannot hold it. The header's page is committed first when the committed run (#288) does not reach
//        top - 1040 (the reservation is PROT_NONE with nothing committed when the spawn's install calls
//        here; a fresh commit reads as zero, so the heads are empty). n <= 1024: pop head n/8 - 1 when it is
//        not empty; n > 1024: walk head 128 for a node of exactly n bytes (its size is in its second word);
//        otherwise extend the edge by n, committing the pages below the run through _silica_rt_stack_grow_to.
//   _silica_rt_state_hole_pop(X0 = ACB, X1 = bytes)        -> X0 = a free node of exactly that size, or 0
//        when none is free (the edge is not moved): the evacuation's "an exact-size hole first" (decision 21).
//   _silica_rt_state_free(X0 = ACB, X1 = node, X2 = bytes)  : push the node on the list for its size. Leaf.
//        The release-log drain and the old root's release call it (§4.2, §4.3). Its node came from
//        _silica_rt_state_alloc, so the header is committed and the area is non-empty (never decommitted
//        while the actor lives, decision 27): the leaf needs no commit of its own.
//
// Dispatch end (phase 3c; §4.2-§4.7). The behaviour ran with SP switched to the edge, so its frame lies
// directly below the state area: nothing can be placed at the edge until the behaviour has returned and
// the runtime is back on the carrier's stack. The behaviour's epilogue therefore only records what the
// runtime needs (prims_actors@behaviour_result_move_asm: the state type's root-word descriptor at ACB
// #592, the proof flag at #560), and the runtime's dispatch loop calls, before the release algorithm:
//
//   _silica_rt_state_dispatch_end(X0 = ACB, X1 = the new state as the behaviour returned it) -> X0 = the
//        root to store at ACB #0. A scalar, or a state whose descriptor is 0 (a scalar or undescribed
//        type), is answered as given. A proven behaviour (#560 = 1) without a compaction request has its
//        new nodes evacuated (_silica_rt_state_evacuate), the old root shell freed when the root changed,
//        and its release log drained into the free lists (§4.3, the order of §4.3: holes freed by this
//        dispatch serve the next). The log holds the stdlib updaters' retires and the old buffers the
//        new state no longer keeps (retired by the behaviour epilogue, prims_actors@
//        bmv_state_buffer_retire_asm, §4.2). A proven behaviour whose described state became a scalar has
//        its old root shell freed and its log drained the same way. An unproven behaviour, or a dispatch that called compact_state() under
//        :compact_on_request (#584), has its whole live state copied into a fresh area laid over the old
//        one (_silica_rt_state_copy_all, §4.4); the log is then dropped (every retired node is unreachable
//        by the proof and the copy walks reachable nodes only; the free lists are empty afterwards). After
//        a compaction the state policy (#576, §4.7) decides the edge: :keep_state_area keeps the old edge
//        (it moves down only when the compacted state is larger than the old area); :shrink_after_compaction
//        and :compact_on_request set it to the compacted end and give the pages between the old and the new
//        edge back (_silica_rt_stack_release_to, which also zeroes the gap so the stack measurer never
//        reads old state bytes as frame depth). #584, #560, #544 and #592 are cleared at the end. A state
//        that does not fit the reservation ends the actor with (:explicit, :reservation_exceeded) when the
//        program lowered the reservation (#376) and (:explicit, :out_of_memory) otherwise (decision 39).
//   _silica_rt_state_evacuate(X0 = ACB, X1 = root, X2 = root descriptor) -> X0 = the root's final address,
//        X1 = 0 (1: no table). The copier in EVACUATION mode: a pointer into [edge, top) is an OLD state
//        node, kept and not followed (old nodes never point at new ones, §4.3 step 1); every other pointer
//        is a new node and is copied. A new node goes first into an exact-size hole (_silica_rt_state_hole_pop:
//        a hole is dead memory above the edge, written in place), else into the SCRATCH, which grows down
//        from the bottom of the committed run (below every dead frame, §2.5; pages are committed as it
//        grows) with its final address assigned at once as scratch + (edge - run bottom): the edge-bound
//        nodes therefore lie in the scratch in their final order and pass 2 is one memmove of them to
//        [edge - E, edge) (overlapping the dead frames, which is why they went through the scratch).
//        Sharing within a slot is kept by the table, keyed by source and holding FINAL addresses, so every
//        pointer written into a copy is final (the design's forwarding words are replaced by the table the
//        3b copier already has). The new edge is edge - E rounded down to 16 (the edge is an SP).
//   _silica_rt_state_copy_all(X0 = ACB, X1 = root, X2 = root descriptor) -> X0 = the new root, X1 = 0
//        (1: no table; 2: the reservation cannot hold the scratch or the area). The fallback: measure the
//        live state (every reachable node, old or new, one table per slot), copy it into a scratch block
//        below both the committed run and the new area's bottom, move the block to [top - 1040 - B, top -
//        1040), zero the 129 heads, set #528 to the compacted end and #568 to B.
//   _silica_rt_state_retire(X0 = node, X1 = bytes): the retire(r) builtin's runtime half (§4.2). Nothing
//        while #560 is 0 or the node is not in [edge, top); else appends (node, bytes) to the actor's
//        release log (#536 base, #544 count, #552 capacity; malloc'd, doubled when full, 64 entries first).
//   _silica_rt_state_log_drain(X0 = ACB): frees every logged node into its free list; count 0.
//
// The state copier (§4.4 step 1, §5.4; P5, confirmed by Lee 2026-10-24: one copier table per state SLOT).
// A slot is a node-bearing position of the state type reached from the root only through by-value
// aggregates (records, tuples, sums): a state { m: Map, cfg: { names: List, n: int64 }, h: Heap } has the
// slots m, cfg.names and h. The copy walks the root's aggregate spine with a per-copy table (source node
// -> copy) and EMPTIES the table before it enters each slot, so a node reachable from two slots is copied
// twice and two slots never share a node afterwards (the invariant decision 18's release needs, §13
// item 1); within a slot sharing is preserved. The walk is type-directed by the module's descriptors
// (term_message_copy: KIND 0 word, 1 region witness, 2 REF1, 3 REFTUP, 4 AGG, 5 SUM, 6 BUF, 7 LIST,
// 8 STRING, 9 closure), given as the ROOT-WORD form `.quad 1, -1; .quad KIND, AUX` that every spawn site
// and every child spec carries (ev_site_descriptor_rodata), so a state that is a bare ref, list or string
// is described like a record. Sizes are the message copier's (L_mc_measure): an aggregate N * 8; a REF1
// cell 8; a REFTUP cell its payload rounded to 16 plus the 8-byte cell word; a buffer its length word plus
// the elements rounded to 8; a list handle 24 and CDATA + 16 per chunk of its spine, walked from the
// handle's cursor (later chunks from their claim word) for the handle's length of elements, inline
// aggregate slots walked in place; a run-time string 24 + length + 1 rounded to 8; a literal string, an
// atom or a scalar (below 65536), a region witness and a function value are copied as words.
//
//   _silica_rt_state_measure(X0 = value, X1 = root descriptor) -> X0 = the bytes a copy occupies (0 for a
//        scalar root), or -1 when the table could not be allocated.
//   _silica_rt_state_copy(X0 = value, X1 = root descriptor, X2 = destination, X3 = destination end,
//        X4 = relocation delta) -> X0 = the copy's root word, X1 = 0; or X1 = 1 when the table could not be
//        allocated (X0 = the value as given). Nodes are laid out by a bump cursor from X2; a cursor past X3
//        is an invariant violation (the measure and the copy disagree) and aborts the process. Every pointer
//        the copy writes (and the root it answers) is the node's destination address plus X4: 0 at a spawn,
//        where the block is the node's final place; copy_all's scratch block is moved up afterwards.
//
// The copy control block (CCB), on the root routine's frame, X20 while the walkers run:
//   +0  destination end (mode 0; the bump-overrun check)        +8  mode: 0 bump up, 1 evacuate
//   +16 ACB (mode 1)                                            +24 old-node range low = the entry edge
//   +32 old-node range high = top (mode 1)                      +40 edge-bound bytes E (mode 1, running)
//   +48 the lowest committed address, kept current (mode 1)     +56 relocation delta of a bumped node
// Lstc_bump(X7 = bytes) -> X0 = where the node's bytes are written, X1 = the node's final address.
//   _silica_rt_message_measure / _silica_rt_message_copy (chunk 15 phase 4a, design §5.1): the same two
//        routines with the spine flag OFF at the root, so the table is never emptied: ONE table for the whole
//        value, every node once (the message copy keeps the sharing between any two parts of a message, R4.2;
//        a state copy keeps it only within a slot).
//   _silica_rt_message_buffer(X0 = message, X1 = root descriptor) -> X0 = the copy's root, X1 = bytes, X2 =
//        the malloc'd block (X1 = X2 = 0 and X0 = the message when it is a scalar, an atom or measures 0: it
//        stays inline). The mailbox buffer of a cast-family send: the emitter (prims_actors@send_buffer_copy_asm)
//        calls it before _silica_rt_actor_cast, which stores the words at the node's +40/+48; the receiver's
//        dispatch end frees the block (prims_actors_runtime_asm LBB1_free_user). Also the row spec buffer of
//        a supervised child (phase 4d, design §5.4 Q14): materialize and start_child copy a described
//        start.0 through it into a block the row owns (row +144, root at +24; prims_actors_child_table_asm).
//   _silica_rt_message_forward(X0 = message, X1 = root descriptor, X2 = the sending function's entry) -> the
//        same results (chunk 15 phase 4b, design §5.2, decision 32): at a forwarding site ("|_mvs") the
//        serving node's own buffer is handed on (its +40/+48 zeroed) when X2 is the behaviour being
//        dispatched (ACB #8), the node is a plain user cast node whose buffer root is X0 and ACB #600 is
//        clear; otherwise the message is copied by _silica_rt_message_buffer.
//   _silica_rt_state_install(X0 = ACB, X1 = value, X2 = root descriptor or 0) -> X0 = 0, or 1 when the
//        child's reservation cannot hold the state. Stores the value at ACB #0; when the descriptor is not 0
//        and the value is a pointer, measures, takes one block of the measured size rounded to 16 from the
//        state area (the edge is also the first SP of every dispatch, so it stays 16-byte aligned), copies
//        the value into it with the per-slot tables and stores the copy's root at ACB #0. Called by
//        _silica_rt_actor_spawn and LBBsl_common (prims_actors_runtime_asm) after the reservation is made
//        and before the actor can run, for every plain spawn, every spawn_linked and every start or
//        restart of a supervisor's row child.
//   _silica_rt_spawn_state_too_large: the spawning actor fails with (:explicit, :state_too_large)
//        (decision 39); main aborts with status 71. Never returns.
//
// Callee-saved registers of the walkers: X19 the bump cursor, X20 the copy control block, X21 the spine flag
// (1 while the walk is on the root's by-value spine, 0 inside a node), X22 the table entries, X23 the
// table capacity (a power of two), X24 the table count, X25 the measure's running total; X26-X28 are the
// walkers' per-frame scratch. Every routine clobbers X0-X17.

export emit_actor_state_runtime_asm/0;

fn state_asm_alloc_free() -> string {
    "	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_state_hole_pop
	.p2align	2
_silica_rt_state_hole_pop:
; X0 = ACB, X1 = bytes -> X0 = a free node of exactly that size, or 0 when none is free. The edge is not
; moved: the evacuation bumps its scratch instead (Lstc_bump). X22 = 1 marks the pop-only entry below.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x22, #1
	b	Lsta_common
	.globl	_silica_rt_state_alloc
	.p2align	2
_silica_rt_state_alloc:
; X0 = ACB, X1 = bytes (a multiple of 8, above 0) -> X0 = the node, 0 when the reservation cannot hold it.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	mov	x22, xzr
Lsta_common:
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x21, x8, x9
	sub	x21, x21, #1040
; The header is read below, so its page must be committed first. The reservation is made PROT_NONE
; with nothing committed (_silica_rt_actor_stack_reserve stores 0 at #288), and the first call here is
; the spawn's install, before the child has run a single instruction; a release of an EMPTY area
; (_silica_rt_stack_release_to) also leaves the header decommitted. When the committed run [top - #288,
; top) does not reach top - 1040, commit the top chunk through _silica_rt_stack_grow_to: a fresh commit
; (first mprotect, or the anonymous MAP_FIXED remap of a release) reads as zero, so the 129 heads are
; empty without initialisation (§2.3); the chunk is the same first chunk a fault would commit (#304),
; so the release algorithms' chunk sequence is unchanged. Answer 1 (a lowered reservation of one
; page: the lowest page is never committed) or 2 (the host refused) is a state the reservation cannot
; hold, 0 to the caller (decision 39). Answer 3 cannot occur here: it means the run already reaches
; the address.
	ldr	x10, [x19, #288]
	cmp	x10, #1040
	b.hs	Lsta_header_committed
	mov	x0, x19
	mov	x1, x21
	bl	_silica_rt_stack_grow_to
	cmp	x0, #1
	b.eq	Lsta_fail
	cmp	x0, #2
	b.eq	Lsta_fail
Lsta_header_committed:
	cmp	x20, #1024
	b.hi	Lsta_large
	lsr	x9, x20, #3
	sub	x9, x9, #1
	add	x9, x21, x9, lsl #3
	ldr	x10, [x9]
	cbz	x10, Lsta_extend
	ldr	x11, [x10]
	str	x11, [x9]
	mov	x0, x10
	b	Lsta_live
Lsta_large:
	add	x9, x21, #1024
Lsta_large_walk:
	ldr	x10, [x9]
	cbz	x10, Lsta_extend
	ldr	x11, [x10, #8]
	cmp	x11, x20
	b.eq	Lsta_large_hit
	mov	x9, x10
	b	Lsta_large_walk
Lsta_large_hit:
	ldr	x11, [x10]
	str	x11, [x9]
	mov	x0, x10
	b	Lsta_live
Lsta_extend:
; No hole of this size: the pop-only entry answers 0 here. Else the node is [edge - n, edge). The pages
; below the committed run are committed first; the lowest page of the reservation is never committed
; (_silica_rt_stack_grow_to), so a lowered reservation that cannot hold the node answers 0.
	cbnz	x22, Lsta_fail
	ldr	x9, [x19, #528]
	sub	x9, x9, x20
	ldr	x8, [x19, #272]
	ldr	x10, [x19, #280]
	add	x10, x8, x10
	ldr	x11, [x19, #288]
	sub	x10, x10, x11
	cmp	x9, x10
	b.hs	Lsta_committed
	mov	x0, x19
	mov	x1, x9
	bl	_silica_rt_stack_grow_to
	cmp	x0, #1
	b.eq	Lsta_fail
	cmp	x0, #2
	b.eq	Lsta_fail
	ldr	x9, [x19, #528]
	sub	x9, x9, x20
Lsta_committed:
	str	x9, [x19, #528]
	mov	x0, x9
Lsta_live:
	ldr	x9, [x19, #568]
	add	x9, x9, x20
	str	x9, [x19, #568]
	b	Lsta_ret
Lsta_fail:
	mov	x0, xzr
Lsta_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	_silica_rt_state_free
	.p2align	2
_silica_rt_state_free:
; X0 = ACB, X1 = a node of the state area, X2 = its bytes. The node's first word becomes the list link; a
; node above 1,024 bytes keeps its size in its second word. Leaf; X8-X10. The node was handed out by
; _silica_rt_state_alloc, which committed the header's page before it read a head, and a state area
; holding nodes is never decommitted (decision 27), so the header is committed here.
	ldr	x8, [x0, #272]
	ldr	x9, [x0, #280]
	add	x9, x8, x9
	sub	x9, x9, #1040
	cmp	x2, #1024
	b.hi	Lstfr_large
	lsr	x10, x2, #3
	sub	x10, x10, #1
	add	x9, x9, x10, lsl #3
	b	Lstfr_push
Lstfr_large:
	add	x9, x9, #1024
	str	x2, [x1, #8]
Lstfr_push:
	ldr	x10, [x9]
	str	x10, [x1]
	str	x1, [x9]
	ldr	x10, [x0, #568]
	sub	x10, x10, x2
	str	x10, [x0, #568]
	ret
	.globl	_silica_rt_state_retain_node
	.p2align	2
_silica_rt_state_retain_node:
; alloc_buf_retained's runtime half (chunk 15 phase 7, the pin rule; design §7). X0 = a 16-aligned block of
; X1 bytes in the running behaviour's own frame (L_dyn_alloc), X2 = the element count -> X0 = the element
; pointer, or 0 when there is no current actor or the state header cannot be committed.
; Block (X1 = round16(n + 24) bytes): the buffer NODE is the block's last round8(n + 8) bytes, laid out as
; every buffer's (the count, then the bytes, zeroed; the value points past the count), so that once
; placed it is exactly the node an alloc_buf buffer of n bytes is and the epilogue's retire
; (prims_actors@bmv_state_buffer_retire_asm: node buf - 8, length word plus elements rounded to 8) frees
; all of it. The block's first G = X1 - round8(n + 8) bytes (16 or 24) are the front gap: +0 the pending
; link, +8 G. An exact-size hole of the state area is taken when one is free (it is a state node already,
; counted by _silica_rt_state_alloc's Lsta_live): its front gap is pushed back on the free lists at once
; and the frame block is simply left to the frame. Otherwise the frame block is pushed on the PENDING
; list, whose head is the spare word of the state header at top - 8 (the 129 free-list heads end at
; top - 16), and _silica_rt_state_dispatch_end makes its node a state node in place and its front gap a
; hole. Blocks of one dispatch are taken from one frame's dynamic part, whose floor only goes down, so
; the list runs from the lowest block (the head) upwards.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x20, x0
	mov	x21, x1
	mov	x22, x2
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, Lstrn_fail
	mov	x19, x0
	mov	x1, x21
	bl	_silica_rt_state_hole_pop
	ldr	x9, [x19, #288]
	cmp	x9, #1040
	b.lo	Lstrn_fail
	add	x11, x22, #15
	and	x11, x11, #0xfffffffffffffff8
	sub	x11, x21, x11
	cbz	x0, Lstrn_pending
	mov	x20, x0
; The hole's front gap goes back on its free list (a leaf: X8-X10 only, so X11 survives).
	mov	x0, x19
	mov	x1, x20
	mov	x2, x11
	bl	_silica_rt_state_free
	b	Lstrn_fill
Lstrn_pending:
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	ldr	x10, [x9, #-8]
	str	x10, [x20]
	str	x20, [x9, #-8]
	str	x11, [x20, #8]
Lstrn_fill:
	add	x12, x20, x11
	str	x22, [x12]
	add	x0, x12, #8
	add	x10, x20, x21
	mov	x9, x0
Lstrn_zero:
	cmp	x9, x10
	b.hs	Lstrn_ret
	str	xzr, [x9], #8
	b	Lstrn_zero
Lstrn_fail:
	mov	x0, xzr
Lstrn_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
"
}

fn state_asm_install() -> string {
    "	.globl	_silica_rt_state_install
	.p2align	2
_silica_rt_state_install:
; X0 = ACB, X1 = the initial state, X2 = its root descriptor (0: a scalar type, or one the descriptors do
; not follow: the value is stored as given) -> X0 = 0, or 1 when the reservation cannot hold the state.
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	str	x23, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	str	x20, [x19]
	cbz	x21, Lsti_ok
	cmp	x20, #65536
	b.lo	Lsti_ok
	mov	x0, x20
	mov	x1, x21
	bl	_silica_rt_state_measure
	tbnz	x0, #63, Lsti_fail
	cbz	x0, Lsti_ok
; The block is rounded to 16: the edge is the SP every dispatch starts from.
	add	x22, x0, #15
	and	x22, x22, #0xfffffffffffffff0
	mov	x0, x19
	mov	x1, x22
	bl	_silica_rt_state_alloc
	cbz	x0, Lsti_fail
	mov	x23, x0
	mov	x0, x20
	mov	x1, x21
	mov	x2, x23
	add	x3, x23, x22
	mov	x4, xzr
	bl	_silica_rt_state_copy
	cbnz	x1, Lsti_fail
	str	x0, [x19]
Lsti_ok:
	mov	x0, xzr
	b	Lsti_ret
Lsti_fail:
	mov	x0, #1
Lsti_ret:
	ldr	x23, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
	.globl	_silica_rt_spawn_state_too_large
	.p2align	2
_silica_rt_spawn_state_too_large:
; A spawn's initial state does not fit the child's reservation (a lowered one; decision 39). The spawning
; actor fails with (:explicit, :state_too_large); in main the process ends with a runtime abort, status 71.
; Never returns.
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, Lstl_main
	adrp	x8, _silica_rt_state_too_large_atom@PAGE
	add	x8, x8, _silica_rt_state_too_large_atom@PAGEOFF
	ldr	x1, [x8]
	bl	_silica_rt_actor_fail_current
Lstl_main:
	ldp	x29, x30, [sp], #16
	b	_silica_rt_abort_state_too_large
	.globl	_silica_rt_message_buffer
	.p2align	2
_silica_rt_message_buffer:
; The mailbox buffer (chunk 15 phase 4a, design §5.1). X0 = the message, X1 = the root-word descriptor of
; its type -> X0 = the root of the copy, X1 = the buffer's bytes, X2 = the buffer block (malloc'd, freed by
; the receiver's dispatch end, by a failed send, or by the end-of-actor drain). A scalar or atom (below
; 65536), or a value whose measure is 0 (a literal string, a function value), is answered as given with
; X1 = X2 = 0: the message stays inline in the node, as today. The copy is _silica_rt_message_copy: one
; table for the whole message, every node once, so the root is the first node bumped and lies at the
; block's start for every kind but a bare buffer (whose root is its element pointer, block + 8; the node
; keeps the block in a word of its own for the free). No memory for the block or the table fails the
; sender as an arena growth failure does (_silica_rt_region_alloc_failed; main aborts).
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	cmp	x19, #65536
	b.lo	Lmbf_inline
	mov	x0, x19
	mov	x1, x20
	bl	_silica_rt_message_measure
	tbnz	x0, #63, Lmbf_fail
	cbz	x0, Lmbf_inline
	mov	x21, x0
	bl	_malloc
	cbz	x0, Lmbf_fail
	mov	x22, x0
	mov	x0, x19
	mov	x1, x20
	mov	x2, x22
	add	x3, x22, x21
	mov	x4, xzr
	bl	_silica_rt_message_copy
	cbnz	x1, Lmbf_fail
	mov	x1, x21
	mov	x2, x22
	b	Lmbf_ret
Lmbf_inline:
	mov	x0, x19
	mov	x1, xzr
	mov	x2, xzr
Lmbf_ret:
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
Lmbf_fail:
	bl	_silica_rt_region_alloc_failed
	.globl	_silica_rt_message_forward
	.p2align	2
_silica_rt_message_forward:
; Forwarding-only elision (chunk 15 phase 4b, design §5.2, decision 32). The arguments and results of
; _silica_rt_message_buffer, plus X2 = the entry of the function sending; called in its place at a
; cast-family site the emitter marked with the |_mvs marker (term_message_copy fn_copy_markers: the operand is the
; behaviour's whole message parameter, used for the last time, no part of it reaching the new state).
; When X2 is the behaviour this actor is dispatching (ACB #8: not a behaviour-shaped helper it called,
; whose caller may still use the message), the node being served (ACB #240) is a plain user cast node
; (+32 = 0, +16 = 0) holding a mailbox buffer (+48) whose root is the message (+8 = X0), and no shallow
; copy has run in this dispatch (ACB #600 = 0: one may hold a pointer into the buffer), the buffer itself
; is handed on: X0 = the root, X1 = the bytes (+40), X2 = the block (+48), and the node's +40/+48 are
; zeroed so that its dispatch end (LBB1_free_user) and the teardown (LBBsigpend_active_user) skip it; the
; new node takes the words through _silica_rt_actor_cast as for a fresh copy, and a dropped send frees
; the block there (LBB3_dropped). In every other case (main, an inline or runtime-cast message, a call
; node, a retained buffer) the message is copied as at any other site.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, x1
	str	x2, [sp, #-16]!
	bl	_silica_rt_tls_current_actor_get
	ldr	x10, [sp], #16
	cbz	x0, Lmfw_copy
	ldr	x9, [x0, #8]
	cmp	x9, x10
	b.ne	Lmfw_copy
	ldr	x9, [x0, #600]
	cbnz	x9, Lmfw_copy
	ldr	x8, [x0, #240]
	cbz	x8, Lmfw_copy
	ldr	w9, [x8, #32]
	cbnz	w9, Lmfw_copy
	ldr	w9, [x8, #16]
	cbnz	w9, Lmfw_copy
	ldr	x2, [x8, #48]
	cbz	x2, Lmfw_copy
	ldr	x9, [x8, #8]
	cmp	x9, x19
	b.ne	Lmfw_copy
	ldr	x1, [x8, #40]
	str	xzr, [x8, #40]
	str	xzr, [x8, #48]
	mov	x0, x19
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
Lmfw_copy:
	mov	x0, x19
	mov	x1, x20
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	b	_silica_rt_message_buffer
	.globl	_silica_rt_reply_place
	.p2align	2
_silica_rt_reply_place:
; The reply into the blocked caller's stack (chunk 15 phase 4c, design §5.3, decision 33). Called by the
; behaviour epilogue (prims_actors@bmv_reply_stack_asm) with X0 = the reply and X1 = the root-word descriptor
; of its type -> X0 = the root of its copy in the CALLER's stack, or the reply as given when nothing is
; copied: a scalar or atom (below 65536), no current actor, no node being served (ACB #240), a node that
; needs no reply (+16 = 0: a cast that reached a call-style behaviour), or a measure of 0 (a literal string).
; Otherwise the copy goes to [dest, dest + bytes), dest = (the SP the caller published at the call record's
; +152, less the bytes) rounded down to 16. When the published SP lies in the caller's managed reservation
; (node +56 names the caller; main and a path on a carrier thread's own stack need no growth) the
; reservation is grown to dest first (_silica_rt_stack_grow_to, with the caller's ACB: a foreign stack is
; committed here, never faulted in); a reply the reservation cannot take (dest below its base, or grow_to
; answering 1 exhausted or 2 refused) sets reply_set (+136) to 4 and leaves the reply as given, and the
; caller fails with (:explicit, :reservation_exceeded) on waking (LBB4_8). The bytes go to +160. Sources are
; read where they lie (the behaviour's frame, live during the epilogue; the state area; the message
; buffer) with ONE table, so sharing inside the reply is kept (R4.2). No table or an overrun fails this
; actor as a mailbox buffer's does (_silica_rt_region_alloc_failed).
	stp	x29, x30, [sp, #-64]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	mov	x19, x0
	mov	x20, x1
	cmp	x19, #65536
	b.lo	Lrpl_as_is
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, Lrpl_as_is
	ldr	x21, [x0, #240]
	cbz	x21, Lrpl_as_is
	ldr	w9, [x21, #16]
	cbz	w9, Lrpl_as_is
	mov	x0, x19
	mov	x1, x20
	bl	_silica_rt_message_measure
	tbnz	x0, #63, Lrpl_fail
	cbz	x0, Lrpl_as_is
	mov	x22, x0
	ldr	x9, [x21, #152]
	sub	x23, x9, x22
	and	x23, x23, #0xfffffffffffffff0
	ldr	x24, [x21, #56]
	cbz	x24, Lrpl_copy
	ldr	x10, [x24, #272]
	cbz	x10, Lrpl_copy
	ldr	x11, [x24, #280]
	add	x11, x10, x11
	cmp	x9, x10
	b.lo	Lrpl_copy
	cmp	x9, x11
	b.hs	Lrpl_copy
	cmp	x23, x10
	b.lo	Lrpl_too_large
	mov	x0, x24
	mov	x1, x23
	bl	_silica_rt_stack_grow_to
	cmp	x0, #1
	b.eq	Lrpl_too_large
	cmp	x0, #2
	b.eq	Lrpl_too_large
Lrpl_copy:
	mov	x0, x19
	mov	x1, x20
	mov	x2, x23
	add	x3, x23, x22
	mov	x4, xzr
	bl	_silica_rt_message_copy
	cbnz	x1, Lrpl_fail
	str	x22, [x21, #160]
	b	Lrpl_ret
Lrpl_too_large:
	mov	w9, #4
	str	w9, [x21, #136]
Lrpl_as_is:
	mov	x0, x19
Lrpl_ret:
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #64
	ret
Lrpl_fail:
	bl	_silica_rt_region_alloc_failed
"
}

// The per-copy table: open addressing over (key, value) pairs, grown at half load; emptied at every slot.
// Lstc_lookup(X0 = key) -> X0 = value or 0 (X9-X12). Lstc_insert(X0 = key, X1 = value).
// Lstc_sum_desc(X0 = value, X1 = sum table) -> X1 = the alternative's descriptor or 0; X0 kept (X9-X12).
fn state_asm_table() -> string {
    "Lstc_lookup:
	sub	x9, x23, #1
	lsr	x10, x0, #3
	and	x10, x10, x9
Lstc_lk_probe:
	add	x11, x22, x10, lsl #4
	ldr	x12, [x11]
	cbz	x12, Lstc_lk_miss
	cmp	x12, x0
	b.eq	Lstc_lk_hit
	add	x10, x10, #1
	and	x10, x10, x9
	b	Lstc_lk_probe
Lstc_lk_miss:
	mov	x0, #0
	ret
Lstc_lk_hit:
	ldr	x0, [x11, #8]
	ret
Lstc_insert:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x0, x1, [sp, #-16]!
	lsl	x9, x24, #1
	cmp	x9, x23
	b.lo	Lstc_in_room
	bl	Lstc_grow
Lstc_in_room:
	ldp	x0, x1, [sp], #16
	sub	x9, x23, #1
	lsr	x10, x0, #3
	and	x10, x10, x9
Lstc_in_probe:
	add	x11, x22, x10, lsl #4
	ldr	x12, [x11]
	cbz	x12, Lstc_in_put
	add	x10, x10, #1
	and	x10, x10, x9
	b	Lstc_in_probe
Lstc_in_put:
	stp	x0, x1, [x11]
	add	x24, x24, #1
	ldp	x29, x30, [sp], #16
	ret
Lstc_grow:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	str	x28, [sp, #-16]!
	mov	x26, x22
	mov	x27, x23
	lsl	x0, x23, #1
	mov	x1, #16
	bl	_calloc
	cbz	x0, Lstc_gr_done
	mov	x22, x0
	lsl	x23, x23, #1
	mov	x24, #0
	mov	x28, #0
Lstc_gr_loop:
	cmp	x28, x27
	b.hs	Lstc_gr_free
	add	x11, x26, x28, lsl #4
	ldr	x0, [x11]
	cbz	x0, Lstc_gr_next
	ldr	x1, [x11, #8]
	bl	Lstc_insert
Lstc_gr_next:
	add	x28, x28, #1
	b	Lstc_gr_loop
Lstc_gr_free:
	mov	x0, x26
	bl	_free
Lstc_gr_done:
	ldr	x28, [sp], #16
	ldp	x26, x27, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
Lstc_table_clear:
; A new slot begins: the table forgets every node of the previous slot (P5).
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x0, x22
	mov	x1, #0
	lsl	x2, x23, #4
	bl	_memset
	mov	x24, #0
	ldp	x29, x30, [sp], #16
	ret
Lstc_sum_desc:
	cmp	x0, #65536
	b.lo	Lstc_sd_none
	ldr	x9, [x0]
	ldr	x11, [x1]
	mvn	x11, x11
	add	x12, x1, #8
Lstc_sd_loop:
	cbz	x11, Lstc_sd_none
	ldr	x10, [x12]
	cmp	x10, x9
	b.eq	Lstc_sd_hit
	add	x12, x12, #16
	sub	x11, x11, #1
	b	Lstc_sd_loop
Lstc_sd_hit:
	ldr	x1, [x12, #8]
	ret
Lstc_sd_none:
	mov	x1, #0
	ret
"
}

// The measure: the same walk as the copy, adding each node's size to X25 once per slot.
fn state_asm_measure_root() -> string {
    "	.globl	_silica_rt_state_measure
	.p2align	2
_silica_rt_state_measure:
; X0 = value, X1 = root descriptor -> X0 = bytes (-1: no table). One table per state slot (X21 = 1 at the root).
	mov	x5, #1
	b	Lstm_root_entry
	.globl	_silica_rt_message_measure
	.p2align	2
_silica_rt_message_measure:
; X0 = value, X1 = root descriptor -> X0 = bytes (-1: no table): the same walk with ONE table for the whole
; value (the spine flag off at the root, so nothing empties it): the size of a message copy, in which two
; parts of one message that share a node share its copy (chunk 15 phase 4a, design §5.1; R4.2).
	mov	x5, xzr
Lstm_root_entry:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x19, x20, [sp, #-16]!
	stp	x21, x22, [sp, #-16]!
	stp	x23, x24, [sp, #-16]!
	stp	x25, x26, [sp, #-16]!
	stp	x27, x28, [sp, #-16]!
	mov	x19, x0
	mov	x20, x1
	mov	x21, x5
	mov	x25, #0
	mov	x0, #64
	mov	x1, #16
	bl	_calloc
	mov	x22, x0
	mov	x23, #64
	mov	x24, #0
	cbz	x22, Lstm_root_notable
	ldp	x1, x2, [x20, #16]
	mov	x0, x19
	bl	Lstm_word
	mov	x0, x22
	bl	_free
	b	Lstm_root_done
Lstm_root_notable:
	mov	x25, #-1
Lstm_root_done:
	mov	x0, x25
	ldp	x27, x28, [sp], #16
	ldp	x25, x26, [sp], #16
	ldp	x23, x24, [sp], #16
	ldp	x21, x22, [sp], #16
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
Lstm_word:
; X0 = word, X1 = kind, X2 = aux.
	cbz	x1, Lstm_w_ret
	cmp	x1, #1
	b.eq	Lstm_w_ret
	cmp	x1, #9
	b.eq	Lstm_w_ret
	cmp	x1, #4
	b.eq	Lstm_w_agg
	cmp	x1, #5
	b.eq	Lstm_w_sum
	cmp	x1, #7
	b.eq	Lstm_list
	cmp	x1, #8
	b.eq	Lstm_str
	b	Lstm_ref
Lstm_w_agg:
	mov	x1, x2
	b	Lstm_agg
Lstm_w_sum:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x1, x2
	bl	Lstc_sum_desc
	cbz	x1, Lstm_w_sum_done
	bl	Lstm_agg
Lstm_w_sum_done:
	ldp	x29, x30, [sp], #16
Lstm_w_ret:
	ret
"
}

// Lstm_agg(X0 = aggregate, X1 = descriptor): N * 8, then every word. Lstm_agg_words: the words only (an
// inline aggregate slot of a list chunk, counted with its chunk). On the spine (X21) a node-bearing word
// (kinds 2, 3, 6, 7, 8) starts a slot: the table is emptied first.
fn state_asm_measure_agg() -> string {
    "Lstm_agg:
	cmp	x0, #65536
	b.lo	Lstm_agg_ret
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	str	x28, [sp, #-16]!
	mov	x26, x0
	mov	x27, x1
	ldr	x9, [x27]
	add	x25, x25, x9, lsl #3
	b	Lstm_agg_enter
Lstm_agg_words:
	cmp	x0, #65536
	b.lo	Lstm_agg_ret
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	str	x28, [sp, #-16]!
	mov	x26, x0
	mov	x27, x1
Lstm_agg_enter:
	mov	x28, #0
Lstm_agg_loop:
	ldr	x9, [x27]
	cmp	x28, x9
	b.hs	Lstm_agg_done
	add	x10, x27, #16
	add	x10, x10, x28, lsl #4
	ldp	x1, x2, [x10]
	cbz	x21, Lstm_agg_word
	cmp	x1, #2
	b.lo	Lstm_agg_word
	cmp	x1, #3
	b.ls	Lstm_agg_slot
	cmp	x1, #6
	b.lo	Lstm_agg_word
	cmp	x1, #8
	b.hi	Lstm_agg_word
Lstm_agg_slot:
	stp	x1, x2, [sp, #-16]!
	bl	Lstc_table_clear
	ldp	x1, x2, [sp], #16
Lstm_agg_word:
	ldr	x0, [x26, x28, lsl #3]
	bl	Lstm_word
	add	x28, x28, #1
	b	Lstm_agg_loop
Lstm_agg_done:
	ldr	x28, [sp], #16
	ldp	x26, x27, [sp], #16
	ldp	x29, x30, [sp], #16
Lstm_agg_ret:
	ret
"
}

// Lstm_ref(X0 = ref / buf word, X1 = kind 2 | 3 | 6, X2 = aux): each node once. [sp] = the REFTUP payload
// word index. Inside a node the walk is off the spine (X21 = 0, restored on return).
fn state_asm_measure_ref() -> string {
    "Lstm_ref:
	cmp	x0, #65536
	b.lo	Lstm_ref_asis
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	stp	x28, x21, [sp, #-16]!
	sub	sp, sp, #16
	mov	x26, x0
	mov	x27, x1
	mov	x28, x2
	mov	x21, #0
	bl	Lstc_lookup
	cbnz	x0, Lstm_ref_done
	mov	x0, x26
	mov	x1, #1
	bl	Lstc_insert
	cmp	x27, #2
	b.eq	Lstm_ref1
	cmp	x27, #3
	b.eq	Lstm_refrec
	ldr	x9, [x26, #-8]
	mul	x9, x9, x28
	add	x9, x9, #15
	and	x9, x9, #0xfffffffffffffff8
	add	x25, x25, x9
	b	Lstm_ref_done
Lstm_ref1:
	add	x25, x25, #8
	ldr	x0, [x26]
	add	x10, x28, #16
	ldp	x1, x2, [x10]
	bl	Lstm_word
	b	Lstm_ref_done
Lstm_refrec:
	ldr	x10, [x28]
	lsl	x9, x10, #3
	add	x9, x9, #15
	and	x9, x9, #0xfffffffffffffff0
	add	x9, x9, #8
	add	x25, x25, x9
	str	xzr, [sp]
Lstm_rr_loop:
	ldr	x9, [sp]
	ldr	x10, [x28]
	cmp	x9, x10
	b.hs	Lstm_ref_done
	ldr	x11, [x26]
	ldr	x0, [x11, x9, lsl #3]
	add	x10, x28, #16
	add	x10, x10, x9, lsl #4
	ldp	x1, x2, [x10]
	bl	Lstm_word
	ldr	x9, [sp]
	add	x9, x9, #1
	str	x9, [sp]
	b	Lstm_rr_loop
Lstm_ref_done:
	add	sp, sp, #16
	ldp	x28, x21, [sp], #16
	ldp	x26, x27, [sp], #16
	ldp	x29, x30, [sp], #16
Lstm_ref_asis:
	ret
"
}

// Lstm_list(X0 = handle, X2 = aux): 24 for the handle and CDATA + 16 per chunk of the spine (CDATA =
// max(16, slot bytes), the slot bytes from the aux header); 8-byte slots of a pointer-carrying element type
// are walked, the first chunk from the handle's cursor and every later chunk from its claim word, at most the
// handle's length of them; an inline aggregate slot (above 8 bytes, element kind 4) is walked in place.
// [sp] = elements left, [sp, #8] = slot offset, [sp, #16] = CDATA.
// Lstm_str(X0 = string): a literal (marker -2) counts nothing; a run-time string 24 + length + 1 rounded
// to 8, once.
fn state_asm_measure_list_str() -> string {
    "Lstm_list:
	cbz	x0, Lstm_ml_ret
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	stp	x28, x21, [sp, #-16]!
	sub	sp, sp, #32
	mov	x26, x0
	mov	x28, x2
	mov	x21, #0
	bl	Lstc_lookup
	cbnz	x0, Lstm_ml_done
	mov	x0, x26
	mov	x1, #1
	bl	Lstc_insert
	add	x25, x25, #24
	ldr	x9, [x26]
	str	x9, [sp]
	ldr	x9, [x28, #8]
	mov	x10, #16
	cmp	x9, x10
	csel	x9, x9, x10, hi
	str	x9, [sp, #16]
	ldr	x27, [x26, #8]
	ldr	x9, [x26, #16]
	str	x9, [sp, #8]
Lstm_ml_chunk:
	cbz	x27, Lstm_ml_done
	ldr	x9, [sp, #16]
	add	x9, x9, #16
	add	x25, x25, x9
	ldr	x9, [x28, #16]
	cbz	x9, Lstm_ml_next
	cmp	x9, #1
	b.eq	Lstm_ml_next
	cmp	x9, #9
	b.eq	Lstm_ml_next
Lstm_ml_slot:
	ldr	x9, [sp]
	cbz	x9, Lstm_ml_done
	ldr	x10, [sp, #8]
	ldr	x11, [sp, #16]
	cmp	x10, x11
	b.hs	Lstm_ml_next
	ldr	x12, [x28, #8]
	add	x13, x10, x12
	str	x13, [sp, #8]
	sub	x9, x9, #1
	str	x9, [sp]
	cmp	x12, #8
	b.ne	Lstm_ml_inline
	ldr	x0, [x27, x10]
	add	x11, x28, #16
	ldp	x1, x2, [x11]
	bl	Lstm_word
	b	Lstm_ml_slot
Lstm_ml_inline:
	ldr	x1, [x28, #16]
	cmp	x1, #4
	b.ne	Lstm_ml_slot
	add	x0, x27, x10
	ldr	x1, [x28, #24]
	bl	Lstm_agg_words
	b	Lstm_ml_slot
Lstm_ml_next:
	ldr	x9, [sp, #16]
	ldr	x27, [x27, x9]
	cbz	x27, Lstm_ml_done
	add	x9, x9, #8
	ldr	x10, [x27, x9]
	str	x10, [sp, #8]
	b	Lstm_ml_chunk
Lstm_ml_done:
	add	sp, sp, #32
	ldp	x28, x21, [sp], #16
	ldp	x26, x27, [sp], #16
	ldp	x29, x30, [sp], #16
Lstm_ml_ret:
	ret
Lstm_str:
	cmp	x0, #65536
	b.lo	Lstm_str_ret
	ldr	x9, [x0]
	cmn	x9, #2
	b.eq	Lstm_str_ret
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	str	x26, [sp, #-16]!
	mov	x26, x0
	bl	Lstc_lookup
	cbnz	x0, Lstm_str_done
	mov	x0, x26
	mov	x1, #1
	bl	Lstc_insert
	ldr	x9, [x26, #16]
	add	x9, x9, #32
	and	x9, x9, #0xfffffffffffffff8
	add	x25, x25, x9
Lstm_str_done:
	ldr	x26, [sp], #16
	ldp	x29, x30, [sp], #16
Lstm_str_ret:
	ret
"
}

// The copy. Lstc_bump(X7 = bytes) -> X0 = where the node's bytes go, X1 = its final address. Mode 0 bumps
// the cursor X19 up from the destination; past the end (CCB +0) the measure and the copy disagree, which
// aborts the process (never a silent overrun of the state area). Mode 1 (evacuation) takes an exact-size
// hole first, else bumps the scratch cursor X19 DOWN, committing the pages it reaches, and counts the
// bytes in CCB +40; a reservation that cannot hold the scratch ends the actor (Lstc_fail_actor).
fn state_asm_copy_root() -> string {
    "	.globl	_silica_rt_state_copy
	.p2align	2
_silica_rt_state_copy:
; X0 = value, X1 = root descriptor, X2 = destination, X3 = destination end, X4 = relocation delta -> X0 =
; the copy's root, X1 = 0 (1: no table, X0 = the value as given). One table per state slot.
	mov	x5, #1
	b	Lstc_copy_entry
	.globl	_silica_rt_message_copy
	.p2align	2
_silica_rt_message_copy:
; The same arguments and answers with ONE table for the whole value (the spine flag off at the root): the
; copy of a message into its mailbox buffer (chunk 15 phase 4a, design §5.1), sized by
; _silica_rt_message_measure. Sharing between any two parts of the message is kept (R4.2).
	mov	x5, xzr
Lstc_copy_entry:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x19, x20, [sp, #-16]!
	stp	x21, x22, [sp, #-16]!
	stp	x23, x24, [sp, #-16]!
	stp	x25, x26, [sp, #-16]!
	stp	x27, x28, [sp, #-16]!
	sub	sp, sp, #64
	mov	x19, x2
	mov	x20, sp
	str	x3, [x20]
	str	xzr, [x20, #8]
	stp	xzr, xzr, [x20, #16]
	stp	xzr, xzr, [x20, #32]
	str	xzr, [x20, #48]
	str	x4, [x20, #56]
	mov	x26, x0
	mov	x27, x1
	cbz	x5, Lstc_copy_flat
	bl	Lstc_run
	b	Lstc_copy_ran
Lstc_copy_flat:
	bl	Lstc_run_flat
Lstc_copy_ran:
	add	sp, sp, #64
	ldp	x27, x28, [sp], #16
	ldp	x25, x26, [sp], #16
	ldp	x23, x24, [sp], #16
	ldp	x21, x22, [sp], #16
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
Lstc_run:
; X26 = value, X27 = root descriptor, X19 = the cursor, X20 = the copy control block -> X0 = the root,
; X1 = 0 (1: no table). The table is this copy's; X21 = 1 (on the spine) at the root. Lstc_run_flat is
; the same walk with the spine flag off at the root (one table for the whole value: the message copy).
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x21, #1
	b	Lstc_run_go
Lstc_run_flat:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x21, xzr
Lstc_run_go:
	mov	x0, #64
	mov	x1, #16
	bl	_calloc
	mov	x22, x0
	mov	x23, #64
	mov	x24, #0
	cbz	x22, Lstc_run_notable
	ldp	x1, x2, [x27, #16]
	mov	x0, x26
	bl	Lstc_word
	mov	x26, x0
	mov	x0, x22
	bl	_free
	mov	x0, x26
	mov	x1, #0
	b	Lstc_run_done
Lstc_run_notable:
	mov	x0, x26
	mov	x1, #1
Lstc_run_done:
	ldp	x29, x30, [sp], #16
	ret
Lstc_bump:
	ldr	x9, [x20, #8]
	cbnz	x9, Lstc_bump_evac
	mov	x0, x19
	add	x19, x19, x7
	ldr	x9, [x20]
	cmp	x19, x9
	b.hi	Lstc_bump_overrun
	ldr	x9, [x20, #56]
	add	x1, x0, x9
	ret
Lstc_bump_overrun:
	b	_silica_rt_abort_state_copy
Lstc_bump_evac:
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x7, [sp, #16]
	ldr	x0, [x20, #16]
	mov	x1, x7
	bl	_silica_rt_state_hole_pop
	cbz	x0, Lstc_bump_edge
	mov	x1, x0
	b	Lstc_bump_evac_ret
Lstc_bump_edge:
	ldr	x7, [sp, #16]
	sub	x19, x19, x7
	ldr	x9, [x20, #48]
	cmp	x19, x9
	b.hs	Lstc_bump_edge_committed
	ldr	x0, [x20, #16]
	mov	x1, x19
	bl	_silica_rt_stack_grow_to
	cmp	x0, #1
	b.eq	Lstc_bump_exhausted
	cmp	x0, #2
	b.eq	Lstc_bump_exhausted
	ldr	x0, [x20, #16]
	ldr	x8, [x0, #272]
	ldr	x9, [x0, #280]
	add	x9, x8, x9
	ldr	x10, [x0, #288]
	sub	x9, x9, x10
	str	x9, [x20, #48]
Lstc_bump_edge_committed:
	ldr	x7, [sp, #16]
	ldr	x9, [x20, #40]
	add	x9, x9, x7
	str	x9, [x20, #40]
	mov	x0, x19
	ldr	x9, [x20, #56]
	add	x1, x0, x9
Lstc_bump_evac_ret:
	ldp	x29, x30, [sp], #32
	ret
Lstc_bump_exhausted:
	ldr	x0, [x20, #16]
	b	Lstc_fail_actor
Lstc_word:
; X0 = word, X1 = kind, X2 = aux -> X0 = the copied word.
	cbz	x1, Lstc_w_ret
	cmp	x1, #1
	b.eq	Lstc_w_ret
	cmp	x1, #9
	b.eq	Lstc_w_ret
	cmp	x1, #4
	b.eq	Lstc_w_agg
	cmp	x1, #5
	b.eq	Lstc_w_sum
	cmp	x1, #7
	b.eq	Lstc_list
	cmp	x1, #8
	b.eq	Lstc_str
	b	Lstc_ref
Lstc_w_agg:
	mov	x1, x2
	b	Lstc_agg
Lstc_w_sum:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	mov	x1, x2
	bl	Lstc_sum_desc
	cbz	x1, Lstc_w_sum_done
	bl	Lstc_agg
Lstc_w_sum_done:
	ldp	x29, x30, [sp], #16
Lstc_w_ret:
	ret
"
}

// Lstc_agg(X0 = aggregate, X1 = descriptor) -> X0 = the copy: N * 8 bytes from the cursor, every word
// through Lstc_word. Lstc_agg_words(X0 = an aggregate already in the copy, X1 = descriptor): its words are
// rewritten in place (an inline aggregate slot of a copied list chunk). [sp] = where the words are written,
// [sp, #8] = the copy's final address (the answer). On the spine (X21) a node-bearing word (kinds 2, 3, 6,
// 7, 8) starts a slot: the table is emptied first (P5). In evacuation mode (CCB +8) an aggregate inside
// [edge, top) is an old state node: answered as it is, not entered.
fn state_asm_copy_agg() -> string {
    "Lstc_agg:
	cmp	x0, #65536
	b.lo	Lstc_agg_ret
	ldr	x9, [x20, #8]
	cbz	x9, Lstc_agg_new
	ldr	x10, [x20, #24]
	cmp	x0, x10
	b.lo	Lstc_agg_new
	ldr	x10, [x20, #32]
	cmp	x0, x10
	b.lo	Lstc_agg_ret
Lstc_agg_new:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	str	x28, [sp, #-16]!
	sub	sp, sp, #16
	mov	x26, x0
	mov	x27, x1
	ldr	x9, [x27]
	lsl	x7, x9, #3
	bl	Lstc_bump
	stp	x0, x1, [sp]
	b	Lstc_agg_enter
Lstc_agg_words:
	cmp	x0, #65536
	b.lo	Lstc_agg_ret
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	str	x28, [sp, #-16]!
	sub	sp, sp, #16
	mov	x26, x0
	mov	x27, x1
	stp	x0, x0, [sp]
Lstc_agg_enter:
	mov	x28, #0
Lstc_agg_loop:
	ldr	x9, [x27]
	cmp	x28, x9
	b.hs	Lstc_agg_done
	add	x10, x27, #16
	add	x10, x10, x28, lsl #4
	ldp	x1, x2, [x10]
	cbz	x21, Lstc_agg_word
	cmp	x1, #2
	b.lo	Lstc_agg_word
	cmp	x1, #3
	b.ls	Lstc_agg_slot
	cmp	x1, #6
	b.lo	Lstc_agg_word
	cmp	x1, #8
	b.hi	Lstc_agg_word
Lstc_agg_slot:
	stp	x1, x2, [sp, #-16]!
	bl	Lstc_table_clear
	ldp	x1, x2, [sp], #16
Lstc_agg_word:
	ldr	x0, [x26, x28, lsl #3]
	bl	Lstc_word
	ldr	x11, [sp]
	str	x0, [x11, x28, lsl #3]
	add	x28, x28, #1
	b	Lstc_agg_loop
Lstc_agg_done:
	ldr	x0, [sp, #8]
	add	sp, sp, #16
	ldr	x28, [sp], #16
	ldp	x26, x27, [sp], #16
	ldp	x29, x30, [sp], #16
Lstc_agg_ret:
	ret
"
}

// Lstc_ref(X0 = ref / buf word, X1 = kind 2 | 3 | 6, X2 = aux) -> X0 = the copy. A node met before answers
// its copy (the table, which holds final addresses). X26 = source, X27 = the kind and then where the copy
// is written, X28 = aux (REFTUP: the payload tuple's descriptor); [sp] = the payload word index, [sp, #8]
// = the copy's final address (the answer; what the table and the cell word hold). A REF1 cell is entered
// in the table before its content is copied (a cell can hold a ref to itself). Off the spine inside the
// node. In evacuation mode a node inside [edge, top) is old: answered as it is.
fn state_asm_copy_ref() -> string {
    "Lstc_ref:
	cmp	x0, #65536
	b.lo	Lstc_ref_asis
	ldr	x9, [x20, #8]
	cbz	x9, Lstc_ref_new
	ldr	x10, [x20, #24]
	cmp	x0, x10
	b.lo	Lstc_ref_retained
	ldr	x10, [x20, #32]
	cmp	x0, x10
	b.lo	Lstc_ref_asis
	b	Lstc_ref_new
; Below the old range: a buffer whose node is on this dispatch's pending retained list (alloc_buf_retained,
; design §7) is kept where it is, like an old node; dispatch_end has lowered the edge to it. Exact: the
; element pointer is compared with every pending node's (+24); the list holds the dispatch's retained
; buffers only.
Lstc_ref_retained:
	cmp	x1, #6
	b.ne	Lstc_ref_new
	ldr	x10, [x20, #16]
	ldr	x9, [x10, #288]
	cmp	x9, #1040
	b.lo	Lstc_ref_new
	ldr	x9, [x10, #272]
	ldr	x10, [x10, #280]
	add	x10, x9, x10
	ldr	x10, [x10, #-8]
Lstc_ref_rt_loop:
	cbz	x10, Lstc_ref_new
	ldr	x9, [x10, #8]
	add	x9, x10, x9
	add	x9, x9, #8
	cmp	x9, x0
	b.eq	Lstc_ref_asis
	ldr	x10, [x10]
	b	Lstc_ref_rt_loop
Lstc_ref_new:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	stp	x28, x21, [sp, #-16]!
	sub	sp, sp, #16
	mov	x26, x0
	mov	x27, x1
	mov	x28, x2
	mov	x21, #0
	bl	Lstc_lookup
	cbnz	x0, Lstc_ref_done
	cmp	x27, #2
	b.eq	Lstc_ref1
	cmp	x27, #3
	b.eq	Lstc_refrec
	ldr	x9, [x26, #-8]
	mul	x7, x9, x28
	add	x7, x7, #15
	and	x7, x7, #0xfffffffffffffff8
	bl	Lstc_bump
	mov	x27, x0
	str	x1, [sp, #8]
	ldr	x9, [x26, #-8]
	str	x9, [x27]
	mul	x9, x9, x28
	add	x9, x9, #7
	lsr	x9, x9, #3
	mov	x10, #0
Lstc_buf_loop:
	cmp	x10, x9
	b.hs	Lstc_buf_copied
	ldr	x11, [x26, x10, lsl #3]
	add	x12, x27, #8
	str	x11, [x12, x10, lsl #3]
	add	x10, x10, #1
	b	Lstc_buf_loop
Lstc_buf_copied:
	ldr	x27, [sp, #8]
	add	x27, x27, #8
	mov	x0, x26
	mov	x1, x27
	bl	Lstc_insert
	mov	x0, x27
	b	Lstc_ref_done
Lstc_ref1:
	mov	x7, #8
	bl	Lstc_bump
	mov	x27, x0
	str	x1, [sp, #8]
	mov	x0, x26
	ldr	x1, [sp, #8]
	bl	Lstc_insert
	ldr	x0, [x26]
	add	x10, x28, #16
	ldp	x1, x2, [x10]
	bl	Lstc_word
	str	x0, [x27]
	ldr	x0, [sp, #8]
	b	Lstc_ref_done
Lstc_refrec:
	ldr	x10, [x28]
	lsl	x7, x10, #3
	add	x7, x7, #15
	and	x7, x7, #0xfffffffffffffff0
	add	x7, x7, #8
	bl	Lstc_bump
	mov	x27, x0
	str	x1, [sp, #8]
	add	x9, x1, #8
	str	x9, [x27]
	mov	x0, x26
	ldr	x1, [sp, #8]
	bl	Lstc_insert
	str	xzr, [sp]
Lstc_rr_loop:
	ldr	x9, [sp]
	ldr	x10, [x28]
	cmp	x9, x10
	b.hs	Lstc_rr_done
	ldr	x11, [x26]
	ldr	x0, [x11, x9, lsl #3]
	add	x10, x28, #16
	add	x10, x10, x9, lsl #4
	ldp	x1, x2, [x10]
	bl	Lstc_word
	ldr	x9, [sp]
	add	x11, x27, #8
	str	x0, [x11, x9, lsl #3]
	add	x9, x9, #1
	str	x9, [sp]
	b	Lstc_rr_loop
Lstc_rr_done:
	ldr	x0, [sp, #8]
Lstc_ref_done:
	add	sp, sp, #16
	ldp	x28, x21, [sp], #16
	ldp	x26, x27, [sp], #16
	ldp	x29, x30, [sp], #16
Lstc_ref_asis:
	ret
"
}

// Lstc_list(X0 = handle, X2 = aux) -> X0 = the copy: a 24-byte handle, then every chunk of the spine copied
// whole (CDATA + 16: slots, next, claim) and linked from the copy before it, its 8-byte slots of a
// pointer-carrying element type rewritten through Lstc_word from the handle's cursor (later chunks from
// their claim word) for the handle's length of elements, inline aggregate slots rewritten in place. The
// copy's next pointer after the last element is cleared, so the copy never points into the source's memory.
// [sp] = elements left, [sp, #8] = slot offset, [sp, #16] = CDATA, [sp, #24] = the handle copy (where it is
// written), [sp, #32] = the link word the next chunk copy's FINAL address is stored to, [sp, #40] = the slot
// offset across a word copy, [sp, #48] = the handle copy's final address (the answer). X27 is the chunk
// being copied (the copy once its bytes are in place). In evacuation mode a handle inside [edge, top) is
// old: answered as it is (an old handle's chunks are old too: nothing new is reached through an old node).
// Lstc_str(X0 = string) -> X0: a literal (marker -2) as is, an old string as is; a run-time string copied
// once: the header (marker -1, the bytes pointer = the copy's FINAL address + 24, the length), then the
// bytes and their NUL. [sp] = the final address.
fn state_asm_copy_list_str() -> string {
    "Lstc_list:
	cbz	x0, Lstc_ml_ret
	ldr	x9, [x20, #8]
	cbz	x9, Lstc_ml_new
	ldr	x10, [x20, #24]
	cmp	x0, x10
	b.lo	Lstc_ml_new
	ldr	x10, [x20, #32]
	cmp	x0, x10
	b.lo	Lstc_ml_ret
Lstc_ml_new:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	stp	x28, x21, [sp, #-16]!
	sub	sp, sp, #64
	mov	x26, x0
	mov	x28, x2
	mov	x21, #0
	bl	Lstc_lookup
	cbnz	x0, Lstc_ml_exit
	mov	x7, #24
	bl	Lstc_bump
	str	x0, [sp, #24]
	str	x1, [sp, #48]
	mov	x0, x26
	ldr	x1, [sp, #48]
	bl	Lstc_insert
	ldr	x0, [sp, #24]
	ldr	x9, [x26]
	str	x9, [x0]
	str	x9, [sp]
	ldr	x9, [x26, #16]
	str	x9, [x0, #16]
	str	x9, [sp, #8]
	str	xzr, [x0, #8]
	add	x9, x0, #8
	str	x9, [sp, #32]
	ldr	x9, [x28, #8]
	mov	x10, #16
	cmp	x9, x10
	csel	x9, x9, x10, hi
	str	x9, [sp, #16]
	ldr	x27, [x26, #8]
Lstc_ml_chunk:
	cbz	x27, Lstc_ml_done
; Evacuation: an old chunk ends the walk; the copy before it links to the old chunk as it is (the rest of
; the spine is old too). Without this a cons onto the state's list would copy the whole list every
; dispatch and leave the copies as garbage above the edge.
	ldr	x9, [x20, #8]
	cbz	x9, Lstc_ml_chunk_new
	ldr	x10, [x20, #24]
	cmp	x27, x10
	b.lo	Lstc_ml_chunk_new
	ldr	x10, [x20, #32]
	cmp	x27, x10
	b.hs	Lstc_ml_chunk_new
	ldr	x11, [sp, #32]
	str	x27, [x11]
	b	Lstc_ml_done
Lstc_ml_chunk_new:
	ldr	x9, [sp, #16]
	add	x7, x9, #16
	bl	Lstc_bump
	ldr	x11, [sp, #32]
	str	x1, [x11]
	ldr	x9, [sp, #16]
	add	x9, x9, #16
	mov	x10, #0
Lstc_ml_copy:
	cmp	x10, x9
	b.hs	Lstc_ml_copied
	ldr	x11, [x27, x10]
	str	x11, [x0, x10]
	add	x10, x10, #8
	b	Lstc_ml_copy
Lstc_ml_copied:
	mov	x27, x0
	ldr	x9, [sp, #16]
	add	x9, x27, x9
	str	x9, [sp, #32]
	ldr	x9, [x28, #16]
	cbz	x9, Lstc_ml_next
	cmp	x9, #1
	b.eq	Lstc_ml_next
	cmp	x9, #9
	b.eq	Lstc_ml_next
Lstc_ml_slot:
	ldr	x9, [sp]
	cbz	x9, Lstc_ml_fin
	ldr	x10, [sp, #8]
	ldr	x11, [sp, #16]
	cmp	x10, x11
	b.hs	Lstc_ml_next
	ldr	x12, [x28, #8]
	add	x13, x10, x12
	str	x13, [sp, #8]
	sub	x9, x9, #1
	str	x9, [sp]
	cmp	x12, #8
	b.ne	Lstc_ml_inline
	ldr	x0, [x27, x10]
	add	x11, x28, #16
	ldp	x1, x2, [x11]
	str	x10, [sp, #40]
	bl	Lstc_word
	ldr	x10, [sp, #40]
	str	x0, [x27, x10]
	b	Lstc_ml_slot
Lstc_ml_inline:
	ldr	x1, [x28, #16]
	cmp	x1, #4
	b.ne	Lstc_ml_slot
	add	x0, x27, x10
	ldr	x1, [x28, #24]
	bl	Lstc_agg_words
	b	Lstc_ml_slot
Lstc_ml_next:
	ldr	x9, [sp, #16]
	ldr	x27, [x27, x9]
	cbz	x27, Lstc_ml_done
	add	x9, x9, #8
	ldr	x10, [x27, x9]
	str	x10, [sp, #8]
	b	Lstc_ml_chunk
Lstc_ml_fin:
	ldr	x11, [sp, #32]
	str	xzr, [x11]
Lstc_ml_done:
	ldr	x0, [sp, #48]
Lstc_ml_exit:
	add	sp, sp, #64
	ldp	x28, x21, [sp], #16
	ldp	x26, x27, [sp], #16
	ldp	x29, x30, [sp], #16
Lstc_ml_ret:
	ret
Lstc_str:
	cmp	x0, #65536
	b.lo	Lstc_str_ret
	ldr	x9, [x0]
	cmn	x9, #2
	b.eq	Lstc_str_ret
	ldr	x9, [x20, #8]
	cbz	x9, Lstc_str_new
	ldr	x10, [x20, #24]
	cmp	x0, x10
	b.lo	Lstc_str_new
	ldr	x10, [x20, #32]
	cmp	x0, x10
	b.lo	Lstc_str_ret
Lstc_str_new:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x26, x27, [sp, #-16]!
	sub	sp, sp, #16
	mov	x26, x0
	bl	Lstc_lookup
	cbnz	x0, Lstc_str_done
	ldr	x9, [x26, #16]
	add	x7, x9, #32
	and	x7, x7, #0xfffffffffffffff8
	bl	Lstc_bump
	mov	x27, x0
	str	x1, [sp]
	mov	x0, x26
	ldr	x1, [sp]
	bl	Lstc_insert
	mov	x9, #-1
	str	x9, [x27]
	ldr	x13, [sp]
	add	x13, x13, #24
	str	x13, [x27, #8]
	add	x9, x27, #24
	ldr	x10, [x26, #16]
	str	x10, [x27, #16]
	ldr	x11, [x26, #8]
	add	x10, x10, #1
Lstc_str_bytes:
	cbz	x10, Lstc_str_copied
	ldrb	w12, [x11], #1
	strb	w12, [x9], #1
	sub	x10, x10, #1
	b	Lstc_str_bytes
Lstc_str_copied:
	ldr	x0, [sp]
Lstc_str_done:
	add	sp, sp, #16
	ldp	x26, x27, [sp], #16
	ldp	x29, x30, [sp], #16
Lstc_str_ret:
	ret
"
}

// Dispatch end (phase 3c): the evacuation of the new nodes, the whole-state copy, the release log and the
// driver the dispatch loop calls (prims_actors_runtime_asm LBB1_post_beh). The walkers leave X25 alone, so
// the evacuation keeps the ACB there across Lstc_run.
fn state_asm_evacuate_copy_all() -> string {
    "	.globl	_silica_rt_state_evacuate
	.p2align	2
_silica_rt_state_evacuate:
; X0 = ACB, X1 = root, X2 = root descriptor, X3 = the low end of the old-node range (the entry edge)
; -> X0 = the root's final address, X1 = 0 (1: no table). The
; scratch cursor X19 starts at the bottom of the committed run and goes down; a scratch node's final address
; is its scratch address + (edge - run bottom), so the edge-bound block is moved to [edge - E, edge) by one
; memmove (the two ranges overlap when the dead frames are shallower than E). The new edge is edge - E
; rounded down to 16; #568 grows by E (hole pops counted themselves in _silica_rt_state_alloc).
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	stp	x19, x20, [sp, #-16]!
	stp	x21, x22, [sp, #-16]!
	stp	x23, x24, [sp, #-16]!
	stp	x25, x26, [sp, #-16]!
	stp	x27, x28, [sp, #-16]!
	sub	sp, sp, #64
	mov	x20, sp
	mov	x25, x0
	mov	x26, x1
	mov	x27, x2
	ldr	x8, [x25, #272]
	ldr	x9, [x25, #280]
	add	x9, x8, x9
	ldr	x10, [x25, #528]
	ldr	x11, [x25, #288]
	sub	x11, x9, x11
	mov	x19, x11
	str	xzr, [x20]
	mov	x12, #1
	str	x12, [x20, #8]
	str	x25, [x20, #16]
; The OLD range is [X3, top): X3 is the entry edge, which is #528 except after a dispatch that took
; retained buffers, where #528 is already the lowest retained block (dispatch_end, design §7).
	stp	x3, x9, [x20, #24]
	str	xzr, [x20, #40]
	str	x11, [x20, #48]
	sub	x12, x10, x11
	str	x12, [x20, #56]
	bl	Lstc_run
	cbnz	x1, Lste_done
	mov	x26, x0
	ldr	x2, [x20, #40]
	cbz	x2, Lste_placed
	ldr	x9, [x20, #56]
	add	x0, x19, x9
	mov	x1, x19
	bl	_memmove
	ldr	x10, [x25, #528]
	ldr	x2, [x20, #40]
	sub	x10, x10, x2
	and	x10, x10, #0xfffffffffffffff0
	str	x10, [x25, #528]
	ldr	x9, [x25, #568]
	add	x9, x9, x2
	str	x9, [x25, #568]
Lste_placed:
	mov	x0, x26
	mov	x1, #0
Lste_done:
	add	sp, sp, #64
	ldp	x27, x28, [sp], #16
	ldp	x25, x26, [sp], #16
	ldp	x23, x24, [sp], #16
	ldp	x21, x22, [sp], #16
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_state_copy_all
	.p2align	2
_silica_rt_state_copy_all:
; X0 = ACB, X1 = root, X2 = root descriptor -> X0 = the new root, X1 = 0 (1: no table, 2: the reservation
; cannot hold the scratch). The live state is measured (B, rounded to 16), copied into a scratch block
; just below the lower of the committed run's bottom and the new area's bottom (so the block overlaps
; neither a source nor its destination), moved to [top - 1040 - B, top - 1040), the 129 heads are zeroed,
; #528 = the compacted end, #568 = B. The caller applies the state policy to the edge (§4.7).
	stp	x29, x30, [sp, #-80]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	stp	x25, x26, [sp, #64]
	mov	x19, x0
	mov	x20, x1
	mov	x21, x2
	mov	x0, x20
	mov	x1, x21
	bl	_silica_rt_state_measure
	tbnz	x0, #63, Lsca_notable
	add	x22, x0, #15
	and	x22, x22, #0xfffffffffffffff0
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	sub	x23, x9, #1040
	sub	x23, x23, x22
	ldr	x10, [x19, #288]
	sub	x10, x9, x10
	cmp	x23, x10
	csel	x24, x23, x10, lo
	sub	x25, x24, x22
	cmp	x25, x10
	b.hs	Lsca_committed
	mov	x0, x19
	mov	x1, x25
	bl	_silica_rt_stack_grow_to
	cmp	x0, #1
	b.eq	Lsca_noroom
	cmp	x0, #2
	b.eq	Lsca_noroom
Lsca_committed:
	mov	x0, x20
	mov	x1, x21
	mov	x2, x25
	mov	x3, x24
	sub	x4, x23, x25
	bl	_silica_rt_state_copy
	cbnz	x1, Lsca_notable
	mov	x26, x0
	mov	x0, x23
	mov	x1, x25
	mov	x2, x22
	bl	_memcpy
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x0, x8, x9
	sub	x0, x0, #1040
	mov	x1, xzr
	mov	x2, #1040
	bl	_memset
	str	x23, [x19, #528]
	str	x22, [x19, #568]
	mov	x0, x26
	mov	x1, #0
	b	Lsca_ret
Lsca_notable:
	mov	x0, x20
	mov	x1, #1
	b	Lsca_ret
Lsca_noroom:
	mov	x0, x20
	mov	x1, #2
Lsca_ret:
	ldp	x25, x26, [sp, #64]
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #80
	ret
"
}

fn state_asm_retire_log() -> string {
    "	.globl	_silica_rt_state_retire
	.p2align	2
_silica_rt_state_retire:
; X0 = node, X1 = its bytes (the static size the emitter computed from the ref's type, the copier's
; sizes). Logged only while #560 is set and the node lies in [edge, top): a node in a frame or a mailbox
; buffer dies with its owner. The log doubles when full (64 entries first); a failed growth ends the actor.
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	str	x21, [sp, #32]
	mov	x19, x0
	mov	x20, x1
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, Lstr_done
	mov	x21, x0
	ldr	x9, [x21, #560]
	cbz	x9, Lstr_done
	ldr	x9, [x21, #528]
	cmp	x19, x9
	b.lo	Lstr_done
	ldr	x8, [x21, #272]
	ldr	x9, [x21, #280]
	add	x9, x8, x9
	cmp	x19, x9
	b.hs	Lstr_done
	ldr	x9, [x21, #544]
	ldr	x10, [x21, #552]
	cmp	x9, x10
	b.lo	Lstr_append
	lsl	x10, x10, #1
	mov	x11, #64
	cmp	x10, #64
	csel	x10, x10, x11, hs
	str	x10, [x21, #552]
	ldr	x0, [x21, #536]
	lsl	x1, x10, #4
	bl	_realloc
	cbz	x0, Lstr_oom
	str	x0, [x21, #536]
Lstr_append:
	ldr	x9, [x21, #544]
	ldr	x10, [x21, #536]
	add	x10, x10, x9, lsl #4
	stp	x19, x20, [x10]
	add	x9, x9, #1
	str	x9, [x21, #544]
Lstr_done:
	ldr	x21, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
Lstr_oom:
	mov	x0, x21
	b	Lstc_fail_actor
	.globl	_silica_rt_state_log_drain
	.p2align	2
_silica_rt_state_log_drain:
; X0 = ACB: every logged (node, bytes) goes on the free list of its size; the count is reset.
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	mov	x19, x0
	mov	x20, xzr
Lstd_loop:
	ldr	x9, [x19, #544]
	cmp	x20, x9
	b.hs	Lstd_done
	ldr	x10, [x19, #536]
	add	x10, x10, x20, lsl #4
	ldp	x1, x2, [x10]
	mov	x0, x19
	bl	_silica_rt_state_free
	add	x20, x20, #1
	b	Lstd_loop
Lstd_done:
	str	xzr, [x19, #544]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
"
}

fn state_asm_dispatch_end() -> string {
    "	.globl	_silica_rt_state_dispatch_end
	.p2align	2
_silica_rt_state_dispatch_end:
; X0 = ACB, X1 = the new state as the behaviour returned it -> X0 = the root to store at ACB #0. Runs on
; the carrier's stack after the behaviour returned (the actor's frames are dead) and before the release
; algorithm. X19 ACB, X20 the returned state, X21 the descriptor (#592), X22 the edge at entry, X23 the
; old root (#0), X24 compacted, X25 the answer.
	stp	x29, x30, [sp, #-80]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	stp	x23, x24, [sp, #48]
	stp	x25, x26, [sp, #64]
	mov	x19, x0
	mov	x20, x1
	ldr	x21, [x19, #592]
	ldr	x22, [x19, #528]
	ldr	x23, [x19]
	mov	x24, xzr
	mov	x25, x20
; Retained buffers (alloc_buf_retained, design §7, the pin rule): X26 = the pending list (top - 8; read only
; when the header is committed), lowest block first. The edge goes down to that block now, so the blocks
; are inside [edge, top) when the walk and the next dispatch see them; the evacuation is told the entry
; edge (X3 = X22) as the low end of the OLD range, so the frame nodes between the blocks are still copied
; (their gaps become holes at Lsde_policy), and its edge-bound block goes below the lowest retained one.
	mov	x26, xzr
	ldr	x9, [x19, #288]
	cmp	x9, #1040
	b.lo	Lsde_no_retained
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	ldr	x26, [x9, #-8]
	cbz	x26, Lsde_no_retained
	str	x26, [x19, #528]
Lsde_no_retained:
	cbz	x21, Lsde_scalar
	cmp	x20, #65536
	b.lo	Lsde_scalar
	ldr	x9, [x19, #560]
	cbz	x9, Lsde_copy_all
	ldr	x9, [x19, #584]
	cbnz	x9, Lsde_copy_all
; Proven, no compaction asked for: evacuate the new nodes, then free the old root shell when the root
; changed (a by-value record or tuple root is a node of the area that nothing in the new state can reach
; once another root replaced it: packing the old state into the new one is an alias the proof rejects),
; then drain the log (§4.3: this dispatch's holes serve the next one).
	mov	x0, x19
	mov	x1, x20
	mov	x2, x21
	mov	x3, x22
	bl	_silica_rt_state_evacuate
	cbnz	x1, Lsde_no_room
	mov	x25, x0
	cmp	x23, x25
	b.eq	Lsde_drain
Lsde_old_shell:
	cmp	x23, x22
	b.lo	Lsde_drain
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	cmp	x23, x9
	b.hs	Lsde_drain
	ldp	x1, x2, [x21, #16]
	cmp	x1, #4
	b.eq	Lsde_root_agg
	cmp	x1, #5
	b.ne	Lsde_drain
	mov	x0, x23
	mov	x1, x2
	bl	Lstc_sum_desc
	cbz	x1, Lsde_drain
	mov	x2, x1
Lsde_root_agg:
	ldr	x9, [x2]
	lsl	x2, x9, #3
	cbz	x2, Lsde_drain
	mov	x0, x19
	mov	x1, x23
	bl	_silica_rt_state_free
Lsde_drain:
; Discarded retires free nothing (Lee 2026-11-01): under the proof an update whose version reaches the
; new state makes the behaviour unproven, so every retire() logged in a proven dispatch is of an old
; node whose updated version was discarded, and the new state may still hold it. The log is drained
; only when the behaviour epilogue's buffer retire wrote it (#560 = 2: it emptied the log first and
; then logged the old buffers the new state does not keep, prims_actors@bmv_state_buffer_retire_asm);
; with #560 = 1 it is dropped.
	ldr	x9, [x19, #560]
	cmp	x9, #2
	b.eq	Lsde_drain_go
	str	xzr, [x19, #544]
	b	Lsde_policy
Lsde_drain_go:
	mov	x0, x19
	bl	_silica_rt_state_log_drain
	b	Lsde_policy
Lsde_copy_all:
; No retained-buffer test here (the pin rule): a retained buffer exists only in the behaviour
; spawn_dangerous installs (E4041), that behaviour is proven (E4037) and returns to the runtime through
; its own epilogue's flag, and its spawn's state_policy(:keep_state_area) (E4036) makes compact_state()
; a no-op, so a pinned actor never reaches the fallback.
	mov	x0, x19
	mov	x1, x20
	mov	x2, x21
	bl	_silica_rt_state_copy_all
	cbnz	x1, Lsde_no_room
	mov	x25, x0
	mov	x24, #1
	str	xzr, [x19, #544]
	b	Lsde_policy
Lsde_scalar:
; A scalar new state of a DESCRIBED type (an atom replacing a record or a buffer) reaches no node. An
; unproven behaviour, or a compaction request, takes the fallback as a pointer state does: copy_all of a
; scalar root measures 0, copies nothing and leaves an empty area (every old node, buffers included, is
; dropped; the state policy then applies as after any compaction). A proven one frees the old root shell
; as on the evacuating path, then drains the log (which holds the old buffers the epilogue retired). A
; state type with no descriptor has no nodes: only the log is drained.
	cbz	x21, Lsde_scalar_undescribed
	ldr	x9, [x19, #560]
	cbz	x9, Lsde_copy_all
	ldr	x9, [x19, #584]
	cbnz	x9, Lsde_copy_all
	cmp	x23, x25
	b.ne	Lsde_old_shell
	b	Lsde_drain
Lsde_scalar_undescribed:
	ldr	x9, [x19, #560]
	cbz	x9, Lsde_policy
	b	Lsde_drain
Lsde_policy:
	cbz	x26, Lsde_policy_go
; The pending blocks are state nodes now; the dead frame bytes between them, and between the highest one
; and the entry edge, become holes (each piece a multiple of 16: the blocks and the entry edge are
; 16-aligned). #568 grows by the whole [lowest block, entry edge) and each hole's push takes its piece
; off again, so it ends up counting the retained bytes. Then the pending list is emptied.
	ldr	x8, [x19, #568]
	sub	x9, x22, x26
	add	x8, x8, x9
	str	x8, [x19, #568]
	mov	x20, x26
Lsde_rt_loop:
; Each block's front gap G ([x20, x20 + G), the pending link and G itself, both read first) becomes a hole;
; its node [x20 + G, + round8(count + 8)) stays; the block ends where the node does.
	ldr	x21, [x20]
	ldr	x11, [x20, #8]
	add	x12, x20, x11
	ldr	x13, [x12]
	add	x13, x13, #15
	and	x13, x13, #0xfffffffffffffff8
	mov	x0, x19
	mov	x1, x20
	mov	x2, x11
	bl	_silica_rt_state_free
	add	x1, x12, x13
	sub	x2, x22, x1
	cbz	x21, Lsde_rt_piece
	sub	x2, x21, x1
Lsde_rt_piece:
	cmp	x2, #16
	b.lt	Lsde_rt_next
	mov	x0, x19
	bl	_silica_rt_state_free
Lsde_rt_next:
	mov	x20, x21
	cbnz	x20, Lsde_rt_loop
	ldr	x8, [x19, #272]
	ldr	x9, [x19, #280]
	add	x9, x8, x9
	str	xzr, [x9, #-8]
Lsde_policy_go:
	cbz	x24, Lsde_done
	ldr	x9, [x19, #576]
	cbnz	x9, Lsde_shrink
; :keep_state_area: the edge never moves up (the area keeps its largest size); it moves down only when
; the compacted state is larger than the old area. The gap above the old edge is reclaimed by the next
; compaction; it is above the edge, so the stack measurer never scans it.
	ldr	x9, [x19, #528]
	cmp	x9, x22
	csel	x9, x9, x22, lo
	str	x9, [x19, #528]
	b	Lsde_done
Lsde_shrink:
; :shrink_after_compaction / :compact_on_request: the edge is the compacted end; the pages between the
; old edge and the new one go back (keep = the committed bytes below the old edge), and the gap is zeroed
; so no old state word reads as frame depth.
	ldr	x9, [x19, #528]
	cmp	x9, x22
	b.ls	Lsde_done
	ldr	x8, [x19, #272]
	ldr	x10, [x19, #280]
	add	x10, x8, x10
	ldr	x11, [x19, #288]
	sub	x10, x10, x11
	sub	x1, x22, x10
	sub	x2, x9, x22
	mov	x0, x19
	bl	_silica_rt_stack_release_to
Lsde_done:
	str	xzr, [x19, #584]
	str	xzr, [x19, #560]
	str	xzr, [x19, #544]
	str	xzr, [x19, #592]
	mov	x0, x25
	ldp	x25, x26, [sp, #64]
	ldp	x23, x24, [sp, #48]
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #80
	ret
Lsde_no_room:
	mov	x0, x19
Lstc_fail_actor:
; X0 = ACB: the state does not fit the reservation, or the runtime's own table or log could not be
; allocated (decision 39): (:explicit, :reservation_exceeded) when the program lowered the reservation
; (#376), (:explicit, :out_of_memory) otherwise. _silica_rt_actor_fail_current leaves this stack (the
; carrier's base, or the thread's alternate stack) and never returns.
	ldr	x9, [x0, #376]
	cbz	x9, Lstc_fail_default
	adrp	x8, _silica_rt_reservation_exceeded_atom@PAGE
	add	x8, x8, _silica_rt_reservation_exceeded_atom@PAGEOFF
	ldr	x1, [x8]
	b	_silica_rt_actor_fail_current
Lstc_fail_default:
	adrp	x8, _silica_rt_out_of_memory_atom@PAGE
	add	x8, x8, _silica_rt_out_of_memory_atom@PAGEOFF
	ldr	x1, [x8]
	b	_silica_rt_actor_fail_current
"
}

fn emit_actor_state_runtime_asm() -> string {
    concat(concat(concat(concat(state_asm_alloc_free(), state_asm_install()), concat(state_asm_table(), concat(state_asm_measure_root(), state_asm_measure_agg()))), concat(concat(state_asm_measure_ref(), state_asm_measure_list_str()), concat(concat(state_asm_copy_root(), state_asm_copy_agg()), concat(state_asm_copy_ref(), state_asm_copy_list_str())))), concat(state_asm_evacuate_copy_all(), concat(state_asm_retire_log(), state_asm_dispatch_end())))
}
