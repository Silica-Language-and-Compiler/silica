// Let-kind emission, top-level arm (open-recursive via emit_child).
// Split from term_emit_kind_let to bound per-unit compile RAM.

use var;
use prims_tuple;
use string_parse;
use let_dispatcher;
use reg_conventions;
use term_aggregate_helpers;
use term_let_helpers;
use term_reg_spill;
use term_sir_helpers;

export emit_kind_let_toplevel/5;

fn emit_kind_let_toplevel(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
                            base_rhs: string <- let_dispatcher@compute_rhs_reg_top_level(term, bound.bound_reg, dest);
                            rhs_reg: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" of {
                                true -> "X0";
                                false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name == "int64" and dest == "X0" and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind != 4 of {
                                    true -> "X1";
                                    false -> base_rhs
                                }
                            };
                            outer_rhs_tl: string <- term_reg_spill@outer_for_aggregate_let_rhs(term, bound.outer_reg);
                            rhs_asm: string <- case term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner).root < 0 of {
                                true -> "";
                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  rhs_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: outer_rhs_tl, debug: bound.debug })
                            };
                            tm_adj_tl: int64 <- case term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) of {
                                false -> 0;
                                true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" of {
                                    true -> term_aggregate_helpers@flat_tuple_nested_alloc(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), prims_tuple@count_flat_elements(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)), 0);
                                    false -> term_aggregate_helpers@flat_record_sum_nested_inners(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))
                                }
                            };
                            iap_tl: string <- "";
                            // A `_dynagg` make (chunk 15 phase 2) is built in a dynamic-part block whose address its
                            // frame slot holds: the binding is that pointer, not a frame region (no `_va`).
                            packs_escape_tl: boolean <- term_aggregate_helpers@let_stack_agg_escapes_via_tuple(term)
                                or (length_bytes(var@find_sp_binding(bound.outer_reg, "_dynagg")) > 0 and term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)));
                            vab_tl: string <- case packs_escape_tl of {
                                true -> "";
                                false -> case term_reg_spill@is_aggregate_make(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) of {
                                    // Same as let_named: record the aggregate's frame REGION, recomputed
                                    // from outer_rhs_tl (the outer the make itself saw) so both agree.
                                    true -> concat("|_va.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", term_reg_spill@frame_region_for(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), outer_rhs_tl))));
                                    false -> ""
                                }
                            };
                            spill_reg_tl: string <- term_reg_spill@compute_let_rhs_spill_reg(term, rhs_reg, bound.outer_reg);
                            spill_tl: boolean <- length_bytes(spill_reg_tl) > 0;
                            rhs_bind_tl: string <- case spill_tl of { true -> spill_reg_tl; false -> rhs_reg };
                            mov_spill_tl: string <- case spill_tl of { true -> term_reg_spill@mov_spill_from_rhs(rhs_reg, spill_reg_tl); false -> "" };
                            is_simple_tuple_make: boolean <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" and tm_adj_tl == 0;
                            // Simple tuple_make leaves the value on the stack and captures its address in
                            // rhs_bind_tl (spill GPR). Bind the name to that stable pointer — never to SP.
                            // Binding to SP made later SUB SP slots invalidate the name, reused the same
                            // spill GPR for every tuple in a sequence, and made list_cons copy the wrong
                            // head (List[(K,V)] corruption across from_sorted helpers).
                            // Reserve the chosen spill register. reg_binding only records a binding
                            // whose VALUE is a register; where the value is a memory ref the register
                            // is still in use but nothing marked it taken, so spill_reg_chain_from_outer
                            // handed the same register to the next sibling -- three interfering bindings
                            // all received X21. This only ever ADDS reservations, so it cannot introduce
                            // a collision.
                            // No |_res= reservation. It was meant to keep a spill register taken when the binding's
                            // VALUE is a memory ref, but it was never effective (it was concatenated ahead of the base
                            // register, so is_reg_bound never matched it) and every build that passed the trial suites
                            // ran without it. Once it did take effect (2026-09-10) it starved the callee-saved chain:
                            // case arms then fell through to X29 frame slots the prologue had not budgeted, and
                            // [X29, #-16] landed on the saved X19/X20 pair (type_checker_expressions_binary_ops@
                            // check_comparison_operands). The register is already recorded by the name binding and,
                            // for aggregates, by the _ptr. binding; liveness is decided by kind (find_reg_pref_binding).
                            res_binding_tl: string <- "";
                            body_bound_tl: string <- rhs_bind_tl;
                            tp_binding_tl: string <- case packs_escape_tl of {
                                true -> "";
                                false -> var@new_tp_binding(term_sir_helpers@sir_term_root_node(term).name, term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), "", var@find_last_sp_binding(bound.outer_reg, concat("_va.", term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).name)))
                            };
                            reg_binding_tl: string <- case packs_escape_tl or is_simple_tuple_make of {
                                true -> concat("|", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", rhs_bind_tl)));
                                false -> var@reg_binding(term_sir_helpers@sir_term_root_node(term).name, rhs_bind_tl)
                            };
                            tuple_elem_count_tl: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term).type_name) of { true -> prims_tuple@count_type_elements(term_sir_helpers@sir_term_root_node(term).type_name); false -> 0 };
                            ptr_binding_tl: string <- case is_simple_tuple_make and length_bytes(rhs_bind_tl) > 0 and substring(rhs_bind_tl, 0, 1) != "[" of {
                                true -> concat("|_ptr.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", rhs_bind_tl)));
                                false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(term).type_name) and length_bytes(rhs_reg) > 0 and substring(rhs_reg, 0, 1) != "[" of {
                                    true -> case tuple_elem_count_tl > 2 of {
                                        true -> concat("|_ptr.", concat(term_sir_helpers@sir_term_root_node(term).name, "=X12"));
                                        false -> concat("|_ptr.", concat(term_sir_helpers@sir_term_root_node(term).name, concat("=", rhs_bind_tl)))
                                    };
                                    false -> ""
                                }
                            };
                            save_base_tl: string <- case tuple_elem_count_tl > 2 and length_bytes(rhs_reg) > 0 and substring(rhs_reg, 0, 1) != "[" of {
                                true -> concat("    MOV X12, ", concat(rhs_bind_tl, "\n"));
                                false -> ""
                            };
                            // Top-level let: keep enclosing bindings (e.g. |%s=X19) so later prims still resolve params after rhs_reg holds the new let.
                            nob_tl: string <- case is_simple_tuple_make of {
                                true -> "SP";
                                false -> var@base_reg_of(bound.outer_reg)
                            };
                            inherit_sp_tl: string <- var@strip_name_family(var@extract_sp_bindings(bound.outer_reg), term_sir_helpers@sir_term_root_node(term).name);
                            new_outer_tl: string <- concat(nob_tl, concat(res_binding_tl, concat(inherit_sp_tl, concat(reg_binding_tl, concat(tp_binding_tl, concat(iap_tl, concat(vab_tl, ptr_binding_tl)))))));
                            outer_for_body_tl_pre: string <- term_reg_spill@outer_append_id_ret_tuple_sret(term, concat(new_outer_tl, term_let_helpers@list_cons_tail_rebind_suffix(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))), bound.outer_reg);
                            // Bytes this let's RHS actually subtracted from SP. tm_adj_tl is the
                            // NESTED allocation (0 for a flat tuple), whereas emit_tuple_make_stack
                            // subtracts the OUTER slot size, so the outer figure is what the running
                            // allocation site uses, so the two cannot disagree.
                            rhs_tl: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
                            alloc_bytes_tl: int64 <- case term_reg_spill@is_aggregate_make(rhs_tl) of {
                                true -> term_aggregate_helpers@tuple_make_rec_flat_outer_alloc_bytes(rhs_tl, prims_tuple@count_flat_elements(rhs_tl)) + tm_adj_tl;
                                false -> 0
                            };
                            outer_for_body_tl: string <- outer_for_body_tl_pre;
                            spd_diag_tl: string <- "";
                            body_asm_pre: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  dest, pools,  { bound_name: term_sir_helpers@sir_term_root_node(term).name, bound_reg: body_bound_tl, outer_reg: outer_for_body_tl, debug: bound.debug });
                            body_asm: string <- concat(spd_diag_tl, body_asm_pre);
                            tuple_sret_outer_tl: string <- var@find_sp_binding(outer_for_body_tl, "_tuple_sret");
                            let_prefix_tl: string <- concat(concat(concat(rhs_asm, "\n"), mov_spill_tl), save_base_tl);
                            concat(concat(let_prefix_tl, body_asm), "\n")
                        }
